{
    "dir": "chap21/daydra/dd_ch04_21_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "21452",
        "cid": "miyabi",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "ゲームはないの？",
        "title_zh": "Extra002 额外剧情",
        "sub_title_zh": "没有游戏吗？"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "ゲームはないの？",
            "zh": "没有游戏吗？",
            "narrator_zh": ""
        },
        {
            "location": "23/TALK",
            "narrator": "ガブリエラ",
            "text": "ねえ、みやび。\n何かパーティーゲーム\nみたいなのってないの？",
            "zh": "我说，雅。\n就没有什么\n派对游戏之类的吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "25/TALK",
            "narrator": "みやび",
            "text": "そういえば、アプリで\n多人数プレイできるのが\nあったけんど…。",
            "zh": "说起来，手机上\n有个能多人玩的应用\n来着，但是……。",
            "narrator_zh": "雅"
        },
        {
            "location": "26/TALK",
            "narrator": "ガブリエラ",
            "text": "そういうのじゃなくて、\nボードゲームみたいな\nものよ。",
            "zh": "不是那种，\n是桌游\n那一类的东西哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "30/TALK",
            "narrator": "みやび",
            "text": "ガブちゃん…\nうちの家やぞ？",
            "zh": "加布……\n这可是我家咧？",
            "narrator_zh": "雅"
        },
        {
            "location": "31/TALK",
            "narrator": "みやび",
            "text": "そんな気の利いたものが\nあると思うんか？",
            "zh": "你觉得我家会有\n那么机灵的东西咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "34/TALK",
            "narrator": "神楽",
            "text": "まあ、みやびさんが\nご家族と一緒にゲームを\nする姿って――",
            "zh": "嘛，雅\n和家人一起玩游戏的\n样子——",
            "narrator_zh": "神乐"
        },
        {
            "location": "35/TALK",
            "narrator": "神楽",
            "text": "ちょっと、\n想像できませんよね？",
            "zh": "总觉得，\n实在想象不出来，对吧？",
            "narrator_zh": "神乐"
        },
        {
            "location": "38/TALK",
            "narrator": "みやび",
            "text": "花札くらいなら\nどこかにあるけんど…。",
            "zh": "花牌的话，家里\n哪里该有一副，但是……。",
            "narrator_zh": "雅"
        },
        {
            "location": "40/TALK",
            "narrator": "つばめ",
            "text": "すみません。\nルール知らないです…。",
            "zh": "不好意思。\n规则我不懂……",
            "narrator_zh": "燕"
        },
        {
            "location": "42/TALK",
            "narrator": "ガブリエラ",
            "text": "あたし、実物触ったこと\nないわ。",
            "zh": "我可没摸过\n实物哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "44/TALK",
            "narrator": "アーヤ",
            "text": "っていうか、長時間\n遊ぶのには向いてない\n気がするわ。",
            "zh": "话说回来，我觉得\n它不太适合\n长时间玩吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "45/TALK",
            "narrator": "みやび",
            "text": "それ以外にみんなで\n遊べるものいうたら――",
            "zh": "要说除此之外大家\n能一起玩的东西——",
            "narrator_zh": "雅"
        },
        {
            "location": "47/TALK",
            "narrator": "みやび",
            "text": "…あっ、そういえば。",
            "zh": "……啊，说起来。",
            "narrator_zh": "雅"
        },
        {
            "location": "48/TALK",
            "narrator": "つばめ",
            "text": "何かあるんですか？",
            "zh": "有什么东西吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "50/TALK",
            "narrator": "みやび",
            "text": "確か、物置に虫網と\n虫かごがあった気が\nするけんど…。",
            "zh": "记得储物间里\n好像有捕虫网和\n虫笼来着，但是……。",
            "narrator_zh": "雅"
        },
        {
            "location": "52/TALK",
            "narrator": "神楽",
            "text": "…最もみやびさんの家に\n合わなそうなんですけど？",
            "zh": "……只是，怎么看都不像\n雅家里会有的东西啊？",
            "narrator_zh": "神乐"
        },
        {
            "location": "54/TALK",
            "narrator": "ガブリエラ",
            "text": "お父さんが子供の頃に\n使ってた物なの？",
            "zh": "是你爸爸小时候\n用过的东西吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "56/TALK",
            "narrator": "みやび",
            "text": "いや、うちが子供の頃\n使うてたやつや。",
            "zh": "不，是我小时候\n用过的家伙咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "58/TALK",
            "narrator": "みやび",
            "text": "これでも、昔は毎日\n虫網と虫かご持って――",
            "zh": "别看我这样，以前每天\n都拿着捕虫网和虫笼——",
            "narrator_zh": "雅"
        },
        {
            "location": "59/TALK",
            "narrator": "みやび",
            "text": "セミやカブトムシ取りに\n行ってたちや。",
            "zh": "净去捉知了和独角仙\n来着滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "60/TALK",
            "narrator": "つばめ",
            "text": "えっ！\nみやびさんが！？",
            "zh": "诶！\n雅居然！？",
            "narrator_zh": "燕"
        },
        {
            "location": "62/TALK",
            "narrator": "みやび",
            "text": "つばめちゃん、\nその反応ナイスや。",
            "zh": "燕，\n这反应不错咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "63/TALK",
            "narrator": "アーヤ",
            "text": "みやびが虫取りって…\n想像つかないんだけど？",
            "zh": "雅抓虫什么的……\n实在想象不出来啊？",
            "narrator_zh": "绫水"
        },
        {
            "location": "65/TALK",
            "narrator": "みやび",
            "text": "まあ、本当に大昔の\n話やきね。",
            "zh": "嘛，真的是\n很久很久以前的事啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "67/TALK",
            "narrator": "みやび",
            "text": "よく捕まえた虫の\n観察日記をつけたり\nしちょったが。",
            "zh": "还经常给捉到的虫子\n写观察日记什么的\n来着。",
            "narrator_zh": "雅"
        },
        {
            "location": "68/TALK",
            "narrator": "神楽",
            "text": "…今、その面影まったく\n残ってませんよね？",
            "zh": "……现在，那副样子\n是一点都没留下，对吧？",
            "narrator_zh": "神乐"
        },
        {
            "location": "69/SEL",
            "narrator": "",
            "text": "久しぶりに行こうよ",
            "zh": "好久没去，去一趟吧",
            "narrator_zh": ""
        },
        {
            "location": "70/SEL",
            "narrator": "",
            "text": "何か暗い過去が！？",
            "zh": "难道有黑暗过去！？",
            "narrator_zh": ""
        },
        {
            "location": "73/TALK",
            "narrator": "ガブリエラ",
            "text": "別人に入れ替わられた\nとしか思えないわ。",
            "zh": "只能认为\n是被人掉包了呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "74/TALK",
            "narrator": "ガブリエラ",
            "text": "あんた、本当にみやび\nなんでしょうね？",
            "zh": "你，真的是雅\n本人对吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "77/TALK",
            "narrator": "みやび",
            "text": "別人やったとしても、\n今のうちしかガブちゃんは\n知らんやろ？",
            "zh": "就算换了别人，\n加布你也只认识\n现在的我，对吧？",
            "narrator_zh": "雅"
        },
        {
            "location": "79/TALK",
            "narrator": "つばめ",
            "text": "…でも、本当にどうして\n外出嫌いになっちゃっ\nたんですか？",
            "zh": "……可是，你到底\n为什么变得\n讨厌出门了呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "84/TALK",
            "narrator": "みやび",
            "text": "どうって…。",
            "zh": "你要问为什么……。",
            "narrator_zh": "雅"
        },
        {
            "location": "85/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "86/TALK",
            "narrator": "みやび",
            "text": "まあ、色々理由はある\nけんど――",
            "zh": "嘛，理由倒是\n有一堆，但是——",
            "narrator_zh": "雅"
        },
        {
            "location": "88/TALK",
            "narrator": "みやび",
            "text": "うちも女やき、いつまでも\n虫取りに夢中になるような\nことはないし――",
            "zh": "我也是女孩子嘛，\n总不会一辈子沉迷\n抓虫那种事——",
            "narrator_zh": "雅"
        },
        {
            "location": "91/TALK",
            "narrator": "みやび",
            "text": "それに…よぉ一緒に\n遊んだ子が、いなくなって\nしもうて…。",
            "zh": "而且……以前老一起\n玩的那孩子，\n后来不见了……。",
            "narrator_zh": "雅"
        },
        {
            "location": "92/TALK",
            "narrator": "アーヤ",
            "text": "…引っ越しでもしたの？",
            "zh": "……是搬走了吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "94/TALK",
            "narrator": "みやび",
            "text": "…まあ、そんなもんやと\n思うてもらえばえいよ。",
            "zh": "……嘛，你当成\n那么回事就得。",
            "narrator_zh": "雅"
        },
        {
            "location": "96/TALK",
            "narrator": "みやび",
            "text": "そういうことがあって、\n今のうちが完成した、\nちゅうことや。",
            "zh": "经历了那些事，\n才有了现在的我，\n就是这么回事咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "97/TALK",
            "narrator": "つばめ",
            "text": "そうだったんですか…。",
            "zh": "原来是这样啊……。",
            "narrator_zh": "燕"
        },
        {
            "location": "99/TALK",
            "narrator": "ガブリエラ",
            "text": "…でもまあ、確かに\n年齢も上がれば――",
            "zh": "……不过嘛，确实\n年纪上去以后——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "100/TALK",
            "narrator": "ガブリエラ",
            "text": "虫取りに興味がなくなる\nのは当然よね？",
            "zh": "对抓虫失去兴趣\n也是当然的吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "102/TALK",
            "narrator": "みやび",
            "text": "まあ、ＰＣにハマり\n始めた頃は――",
            "zh": "嘛，刚迷上ＰＣ\n那会儿——",
            "narrator_zh": "雅"
        },
        {
            "location": "103/TALK",
            "narrator": "みやび",
            "text": "クワガタやカブトムシ\n繁殖させて売ろう思うた\nことはあったけんどね。",
            "zh": "倒是想过繁殖锹形虫\n和独角仙拿去卖\n这档子事，但是呢。",
            "narrator_zh": "雅"
        },
        {
            "location": "105/TALK",
            "narrator": "神楽",
            "text": "…観察日記を付けてた\n頃の純粋さは、どこに\n行っちゃったんですか？",
            "zh": "……写观察日记\n那会儿的纯真，\n跑去哪里了呢？",
            "narrator_zh": "神乐"
        },
        {
            "location": "107/ACT",
            "narrator": "",
            "text": "久しぶりに行こうよ",
            "zh": "好久没去，去一趟吧",
            "narrator_zh": ""
        },
        {
            "location": "127/TALK",
            "narrator": "みやび",
            "text": "久しぶりレベルの話やないけんど",
            "zh": "这可不是「好久没去」那种程度的事，但是",
            "narrator_zh": "雅"
        },
        {
            "location": "128/TALK",
            "narrator": "みやび",
            "text": "…まあ、みんな暇しちょるようだし、たまには変わったことするんもえいか",
            "zh": "……嘛，看大家也都闲着，偶尔做点新鲜事也算好咯",
            "narrator_zh": "雅"
        },
        {
            "location": "140/TALK",
            "narrator": "みやび",
            "text": "よし、みんな出掛ける\n準備しぃ。",
            "zh": "好，大家准备\n出门咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "142/TALK",
            "narrator": "アーヤ",
            "text": "どこに行くつもりなの？",
            "zh": "你打算去哪里？",
            "narrator_zh": "绫水"
        },
        {
            "location": "143/TALK",
            "narrator": "みやび",
            "text": "この話の流れで行く\nところ言うたら、\n一つしかないやろ？",
            "zh": "照这话头走下去，\n要去的地方\n只有一个吧？",
            "narrator_zh": "雅"
        },
        {
            "location": "163/TALK",
            "narrator": "みやび",
            "text": "…よしっ、捕まえた！\nヒラタクワガタゲットや。",
            "zh": "……好，捉到了！\n扁锹形虫到手咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "165/TALK",
            "narrator": "アーヤ",
            "text": "上手いわね。\n今の、飛び立つ瞬間\nだったわ。",
            "zh": "好利落哦。\n刚才那下，正是\n它起飞的瞬间。",
            "narrator_zh": "绫水"
        },
        {
            "location": "168/TALK",
            "narrator": "みやび",
            "text": "久しぶりやけんど、\n身体が虫取りの動きを\n覚えちょるようやね。",
            "zh": "虽然隔了好久，\n身体倒还记得\n抓虫的动作咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "170/TALK",
            "narrator": "みやび",
            "text": "ほれ、そっちの三人。\n可愛いヒラタゲット\nしたぞね。",
            "zh": "喏，那边的三位。\n可爱的扁锹\n捉到手了咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "173/TALK",
            "narrator": "神楽",
            "text": "い、いいです！\n見せないでください\nそんなの！",
            "zh": "不、不用了！\n别给我看\n那种东西！",
            "narrator_zh": "神乐"
        },
        {
            "location": "177/TALK",
            "narrator": "ガブリエラ",
            "text": "お腹の方見せないで！\n足ワキワキしてて\n気持ち悪いから！",
            "zh": "别给我看肚子那面！\n腿还在那里晃来晃去\n看着恶心死了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "178/TALK",
            "narrator": "みやび",
            "text": "なんやそれ？\nつばめちゃん、ほれ、\nこっち見てみぃ。",
            "zh": "做驷马啊？\n燕，喏，\n看一眼这边咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "181/TALK",
            "narrator": "つばめ",
            "text": "ちょ、ちょっと、\n見るのも怖いんで…。",
            "zh": "等、等一下，\n光是看着都害怕……",
            "narrator_zh": "燕"
        },
        {
            "location": "183/TALK",
            "narrator": "みやび",
            "text": "…最近の子は、\nみんな怖がりやね。",
            "zh": "……最近的孩子，\n个个都胆小咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "184/TALK",
            "narrator": "アーヤ",
            "text": "大して年齢変わらない\nでしょ？",
            "zh": "我们年龄也\n没差多少吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "187/TALK",
            "narrator": "神楽",
            "text": "っていうか、みやびさん。\nどうして私達まで――",
            "zh": "话说回来，雅。\n为什么连我们都——",
            "narrator_zh": "神乐"
        },
        {
            "location": "188/TALK",
            "narrator": "神楽",
            "text": "虫取りに付き合わなくちゃ\nいけないんですか！？",
            "zh": "非得陪\n你抓虫才行啊！？",
            "narrator_zh": "神乐"
        },
        {
            "location": "189/TALK",
            "narrator": "みやび",
            "text": "あんたら、普段海行こう\n出掛けよう言うて、\nうちを誘うやろ？",
            "zh": "你们平时啊，\n动不动就喊去海边\n喊出门来约我，对吧？",
            "narrator_zh": "雅"
        },
        {
            "location": "190/TALK",
            "narrator": "みやび",
            "text": "それやったら、たまには\nうちの誘いに乗ってくれ\nてもえいやろ。",
            "zh": "那偶尔也该\n应一次我的邀约\n才对吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "193/TALK",
            "narrator": "つばめ",
            "text": "む、虫取り以外じゃ\nダメなんですか…？",
            "zh": "除、除了抓虫\n就不行吗……？",
            "narrator_zh": "燕"
        },
        {
            "location": "195/TALK",
            "narrator": "みやび",
            "text": "ダメやないけんど、\n急に思いついたんが\n虫取りだったんよ。",
            "zh": "不是不行，但是\n突然想到的\n是抓虫而已咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "198/TALK",
            "narrator": "アーヤ",
            "text": "…よし！\nクマゼミ捕まえたわ。",
            "zh": "……好！\n捉到熊蝉了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "201/TALK",
            "narrator": "みやび",
            "text": "素手でいったか。",
            "zh": "直接空手上了啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "203/TALK",
            "narrator": "アーヤ",
            "text": "ふふっ…昔はよく、\nこうやって捕まえて\nたっけ…。",
            "zh": "呵呵……以前也经常\n像这样捉\n来着……",
            "narrator_zh": "绫水"
        },
        {
            "location": "205/TALK",
            "narrator": "アーヤ",
            "text": "さ、もういいわ。\n逃げなさい。",
            "zh": "好了，行了。\n飞走吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "206/TALK",
            "narrator": "みやび",
            "text": "…こうして童心に\n返って遊ぶんも――",
            "zh": "……像这样找回童心\n玩一玩——",
            "narrator_zh": "雅"
        },
        {
            "location": "208/TALK",
            "narrator": "みやび",
            "text": "たまにはえいのかも\nしれんね。",
            "zh": "偶尔来一次，\n说不定也算好呢。",
            "narrator_zh": "雅"
        },
        {
            "location": "211/TALK",
            "narrator": "アーヤ",
            "text": "ええ、意外と楽しいわ。",
            "zh": "嗯，意外地开心。",
            "narrator_zh": "绫水"
        },
        {
            "location": "214/TALK",
            "narrator": "アーヤ",
            "text": "…ただ、良い年した\n女子が集まってする\n遊びではないわね…。",
            "zh": "……只是，这把年纪\n的女孩子聚在一起\n玩这个，总归……",
            "narrator_zh": "绫水"
        },
        {
            "location": "217/TALK",
            "narrator": "神楽",
            "text": "もうダメです！\nもう限界です！！",
            "zh": "不行了！\n我已经到极限了！！",
            "narrator_zh": "神乐"
        },
        {
            "location": "218/TALK",
            "narrator": "神楽",
            "text": "みやびさん！\n私、先に戻りますね！",
            "zh": "雅！\n我先回去了！",
            "narrator_zh": "神乐"
        },
        {
            "location": "228/TALK",
            "narrator": "ガブリエラ",
            "text": "あっ、卑怯よ！！\n逃げるならあたしも\n連れて行きなさい！",
            "zh": "啊，太卑鄙了！！\n要逃就连我\n一起带上！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "231/TALK",
            "narrator": "つばめ",
            "text": "わ、わたしも！\n置いてかないでぇー！",
            "zh": "我、我也要去！\n别丢下我呀——！",
            "narrator_zh": "燕"
        },
        {
            "location": "232/ACT",
            "narrator": "",
            "text": "何か暗い過去が！？",
            "zh": "难道有黑暗过去！？",
            "narrator_zh": ""
        },
        {
            "location": "252/TALK",
            "narrator": "みやび",
            "text": "ん…まあ、そうやね",
            "zh": "嗯……嘛，是啊咯",
            "narrator_zh": "雅"
        },
        {
            "location": "253/TALK",
            "narrator": "みやび",
            "text": "一緒に遊んでた子が、いなくなっちゅうて…",
            "zh": "一起玩的那孩子不见了，然后就……",
            "narrator_zh": "雅"
        },
        {
            "location": "254/TALK",
            "narrator": "みやび",
            "text": "まあ、それだけが理由じゃないんやけんどね",
            "zh": "嘛，理由也不止这一个，但是呢",
            "narrator_zh": "雅"
        },
        {
            "location": "265/TALK",
            "narrator": "みやび",
            "text": "…もしかして、うちに\n何かしら暗い過去が\nあって――",
            "zh": "……怎么，你们是不是\n觉得我身上\n有什么黑暗过去——",
            "narrator_zh": "雅"
        },
        {
            "location": "266/TALK",
            "narrator": "みやび",
            "text": "そのせいで外出嫌いに\nなった思うてたりする？",
            "zh": "觉得是因为那个\n才讨厌上出门的？",
            "narrator_zh": "雅"
        },
        {
            "location": "268/TALK",
            "narrator": "ガブリエラ",
            "text": "そうじゃないの？",
            "zh": "难道不是吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "270/TALK",
            "narrator": "神楽",
            "text": "元気に外で遊んでた子が、\nこんなに外出嫌いに\nなっちゃったんです。",
            "zh": "以前活泼爱在外面\n玩的孩子，如今\n变得这么讨厌出门。",
            "narrator_zh": "神乐"
        },
        {
            "location": "271/TALK",
            "narrator": "神楽",
            "text": "事件の香りがしても\nおかしくありません！",
            "zh": "就算闻出事件的\n味道也不奇怪！",
            "narrator_zh": "神乐"
        },
        {
            "location": "274/TALK",
            "narrator": "つばめ",
            "text": "う、卯月さん、\nワクワクしてない？",
            "zh": "卯、卯月，\n你是不是太兴奋了？",
            "narrator_zh": "燕"
        },
        {
            "location": "276/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "278/TALK",
            "narrator": "みやび",
            "text": "まあ、そうやね。\nあれは確かに、\n事件やったし…。",
            "zh": "嘛，是啊。\n那件事确实\n算得上事件……。",
            "narrator_zh": "雅"
        },
        {
            "location": "281/TALK",
            "narrator": "アーヤ",
            "text": "えっ…どういうこと？",
            "zh": "诶……什么意思？",
            "narrator_zh": "绫水"
        },
        {
            "location": "284/TALK",
            "narrator": "みやび",
            "text": "…あれは、うちがまだ\n小学生の頃やった。",
            "zh": "……那是我还在\n读小学的时候咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "286/TALK",
            "narrator": "みやび",
            "text": "あの日、うちは友達と\n一緒に、近所の林に\n遊びに行っとった。",
            "zh": "那天，我和朋友\n一起到附近的\n树林里玩来着。",
            "narrator_zh": "雅"
        },
        {
            "location": "287/TALK",
            "narrator": "みやび",
            "text": "クワガタやカブトムシ、\nバッタやら色々捕まえて\n楽しんでいたんよ。",
            "zh": "捉了锹形虫、独角仙、\n蚱蜢什么的各种虫子，\n玩得可开心咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "289/TALK",
            "narrator": "神楽",
            "text": "…そんな虫だらけの\nカゴを想像するだけでも\nホラーなんですけど…。",
            "zh": "……光是想象那\n一笼子虫子\n就已经很恐怖了……",
            "narrator_zh": "神乐"
        },
        {
            "location": "290/TALK",
            "narrator": "みやび",
            "text": "まあ、思いの外大量に\n捕れたき、上機嫌に\nなったうちは――",
            "zh": "嘛，虫子捉得\n比想象中还多啵，\n心情大好的我就——",
            "narrator_zh": "雅"
        },
        {
            "location": "291/TALK",
            "narrator": "みやび",
            "text": "一人で林の奥に\n入っていったんよ。",
            "zh": "就一个人钻进了\n树林深处咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "293/TALK",
            "narrator": "みやび",
            "text": "そこは暗くて肌寒ぅて、\nまっこと静かで――",
            "zh": "那里头又暗又\n透着凉，蛮静的——",
            "narrator_zh": "雅"
        },
        {
            "location": "294/TALK",
            "narrator": "みやび",
            "text": "…何か、臭ぅて。",
            "zh": "……还有股，怪臭的。",
            "narrator_zh": "雅"
        },
        {
            "location": "297/TALK",
            "narrator": "つばめ",
            "text": "…に、臭い、ですか？",
            "zh": "……有、有臭味，吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "300/TALK",
            "narrator": "みやび",
            "text": "…思い出すのも嫌な、\n何かが腐った臭いや。",
            "zh": "……是让人回想起来都难受的，\n什么东西烂掉了的臭味。",
            "narrator_zh": "雅"
        },
        {
            "location": "303/TALK",
            "narrator": "みやび",
            "text": "うちは最初、生ごみでも\n不法投棄されとるんか\n思うてたんやけんど――",
            "zh": "我一开始还以为，\n是有人乱倒厨余\n垃圾来着，但是——",
            "narrator_zh": "雅"
        },
        {
            "location": "304/TALK",
            "narrator": "みやび",
            "text": "大きな木の下を通り\n掛かった時、その正体が\nわかったんや。",
            "zh": "等走到一棵大树下\n经过时，才知道那\n到底是什么咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "306/TALK",
            "narrator": "ガブリエラ",
            "text": "ま、まさか！",
            "zh": "难、难道！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "308/TALK",
            "narrator": "みやび",
            "text": "そう…。",
            "zh": "没错……。",
            "narrator_zh": "雅"
        },
        {
            "location": "310/TALK",
            "narrator": "みやび",
            "text": "木の枝の先からな、\nこう、ブラーンと…。",
            "zh": "就在树枝的梢头，\n那么，晃啊晃地……。",
            "narrator_zh": "雅"
        },
        {
            "location": "313/TALK",
            "narrator": "アーヤ",
            "text": "も、もういい！！\nもういいから、ストップ！",
            "zh": "够、够了！！\n已经够了，快停下！",
            "narrator_zh": "绫水"
        },
        {
            "location": "322/TALK",
            "narrator": "アーヤ",
            "text": "もう十分よ！\n外出嫌いになった理由、\nよくわかったから！",
            "zh": "已经够了！\n你讨厌出门的理由，\n我完全明白了！",
            "narrator_zh": "绫水"
        },
        {
            "location": "324/TALK",
            "narrator": "ガブリエラ",
            "text": "…聞いててゾッとしたわ。",
            "zh": "……听得我后背发凉。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "325/TALK",
            "narrator": "ガブリエラ",
            "text": "そんなことがあったら、\nそりゃ外出嫌いにも\nなるわね。",
            "zh": "要是经历过那种事，\n会讨厌出门也是\n自然的呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "327/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "328/TALK",
            "narrator": "神楽",
            "text": "私なら、そんなの見たら\n悪夢にうなされそうです。",
            "zh": "换作是我，看到那种东西，\n估计要做噩梦了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "330/TALK",
            "narrator": "神楽",
            "text": "みやびさんはそういうの\nなかったんですか？",
            "zh": "雅你那时候就\n没做噩梦吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "332/TALK",
            "narrator": "みやび",
            "text": "なかったな。",
            "zh": "没有咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "334/TALK",
            "narrator": "みやび",
            "text": "なんちゅうても、\n今の話、全部ウソやし。",
            "zh": "毕竟说到底，\n刚才那些话全是编的嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "336/TALK",
            "narrator": "つばめ",
            "text": "え…………。",
            "zh": "诶…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "339/TALK",
            "narrator": "つばめ",
            "text": "えぇーっ！？\nぜ、全部ウソだったん\nですか！？",
            "zh": "诶——！？\n全、全部都是骗人的\n吗！？",
            "narrator_zh": "燕"
        },
        {
            "location": "341/TALK",
            "narrator": "みやび",
            "text": "うん、全部ウソや。",
            "zh": "嗯，全是骗人的。",
            "narrator_zh": "雅"
        },
        {
            "location": "344/TALK",
            "narrator": "アーヤ",
            "text": "何でそんなウソつくの！？\n本当かと思って信じちゃっ\nたじゃない！",
            "zh": "干嘛撒那种谎！？\n我还当真信了\n呢！",
            "narrator_zh": "绫水"
        },
        {
            "location": "347/TALK",
            "narrator": "みやび",
            "text": "いや、信じる方が\nどうかと思うけんど？",
            "zh": "不，我觉得\n会信的才有问题吧？",
            "narrator_zh": "雅"
        },
        {
            "location": "348/TALK",
            "narrator": "神楽",
            "text": "じゃ、じゃあ、虫取りを\nしなくなった本当の\n理由って…？",
            "zh": "那、那么，你不再\n抓虫的真正理由\n是……？",
            "narrator_zh": "神乐"
        },
        {
            "location": "351/TALK",
            "narrator": "みやび",
            "text": "年齢が上がれば、\n興味失くすんが普通やろ？",
            "zh": "年纪上去了，\n兴趣没了不是很正常吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "352/TALK",
            "narrator": "みやび",
            "text": "それだけの話や。",
            "zh": "就这么回事咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "354/TALK",
            "narrator": "ガブリエラ",
            "text": "もぉ、ウソつき！\n絶対何か凄い理由が\nあると思ったのに！",
            "zh": "真是的，骗子！\n我还以为绝对\n有什么了不得的理由呢！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "356/TALK",
            "narrator": "みやび",
            "text": "…そもそも、勝手に\n暗い過去設定とか\n付けんでほしいちや。",
            "zh": "……所以说拜托，\n别擅自给我\n加黑暗过去设定滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "21/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>8月23日　 3:27 PM</color>\n合宿中、みやびの実家でのこと",
            "zh": "<color=green>8月23日　 3:27 PM</color>\n合宿期间，发生在雅的老家的事",
            "narrator_zh": "Dialog_EventData"
        }
    ]
}
