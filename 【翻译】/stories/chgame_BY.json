        "sub_title_zh": "BY BOSS（燕）"
    },
    "entry": [
        {
            "location": "505/SCENARIO",
            "narrator": "",
            "text": "BYボス（つばめ）",
            "zh": "BY BOSS（燕）",
            "narrator_zh": ""
        },
        {
            "location": "531/TALK",
            "narrator": "つばめ",
            "text": "まさかこんなところまで\n来ちゃうなんて……。",
            "zh": "没想到你们居然\n会追到这里来……。",
            "narrator_zh": "燕"
        },
        {
            "location": "532/TALK",
            "narrator": "つばめ",
            "text": "お城への門は\n絶対に通さないから！",
            "zh": "通往城堡的门，\n我绝对不放行！",
            "narrator_zh": "燕"
        },
        {
            "location": "533/TALK",
            "narrator": "千羽鶴",
            "text": "ラスボスが現れた。",
            "zh": "最终BOSS出现了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "535/TALK",
            "narrator": "千羽鶴",
            "text": "気をつけて。\n彼女は本当に強い。",
            "zh": "小心。\n她是真的强。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "537/TALK",
            "narrator": "つばめ",
            "text": "$handle$さん、\n騙されちゃだめだよ！",
            "zh": "$handle$，\n别被骗了哦！",
            "narrator_zh": "燕"
        },
        {
            "location": "538/TALK",
            "narrator": "つばめ",
            "text": "この子は全然\nいい子なんかじゃない！",
            "zh": "这家伙才不是\n什么好孩子！",
            "narrator_zh": "燕"
        },
        {
            "location": "539/TALK",
            "narrator": "つばめ",
            "text": "わたしの方が、\nよっぽどいい子だから！\nお願い、信じて！",
            "zh": "我比她\n乖多了！\n求你，相信我！",
            "narrator_zh": "燕"
        },
        {
            "location": "540/SEL",
            "narrator": "",
            "text": "それには同意する",
            "zh": "这点我同意",
            "narrator_zh": ""
        },
        {
            "location": "541/SEL",
            "narrator": "",
            "text": "千羽鶴もいい子だよ",
            "zh": "千羽鹤也是好孩子哦",
            "narrator_zh": ""
        },
        {
            "location": "542/ACT",
            "narrator": "",
            "text": "それには同意する",
            "zh": "这点我同意",
            "narrator_zh": ""
        },
        {
            "location": "543/TALK",
            "narrator": "つばめ",
            "text": "ありがとう、えへへ……",
            "zh": "谢谢，诶嘿嘿……",
            "narrator_zh": "燕"
        },
        {
            "location": "544/TALK",
            "narrator": "つばめ",
            "text": "でも、じゃあどうして、\nその子の味方をするの？",
            "zh": "可是，那你为什么，\n要帮那孩子说话？",
            "narrator_zh": "燕"
        },
        {
            "location": "545/ACT",
            "narrator": "",
            "text": "千羽鶴もいい子だよ",
            "zh": "千羽鹤也是好孩子哦",
            "narrator_zh": ""
        },
        {
            "location": "546/TALK",
            "narrator": "つばめ",
            "text": "むーっ！",
            "zh": "唔——！",
            "narrator_zh": "燕"
        },
        {
            "location": "547/TALK",
            "narrator": "つばめ",
            "text": "どうしてわたしより\nその子の味方をするの？",
            "zh": "为什么帮那孩子\n也不帮我？",
            "narrator_zh": "燕"
        },
        {
            "location": "549/SEL",
            "narrator": "",
            "text": "「非攻略対象」の「非」を取り去るため",
            "zh": "为了去掉「非攻略对象」的「非」",
            "narrator_zh": ""
        },
        {
            "location": "550/ACT",
            "narrator": "",
            "text": "「非攻略対象」の「非」を取り去るため",
            "zh": "为了去掉「非攻略对象」的「非」",
            "narrator_zh": ""
        },
        {
            "location": "552/TALK",
            "narrator": "つばめ",
            "text": "あわわっ！\nそんなとんでもない\nことを！",
            "zh": "啊啊啊！\n怎么能说出这么\n了不得的话！",
            "narrator_zh": "燕"
        },
        {
            "location": "554/TALK",
            "narrator": "つばめ",
            "text": "ならばやっぱり\n死んでもここを\n通さないから！",
            "zh": "那我就算死，\n也绝不会\n放你们过去！",
            "narrator_zh": "燕"
        },
        {
            "location": "555/TALK",
            "narrator": "千羽鶴",
            "text": "逢瀬つばめは\n本気みたい。\n先手必勝で行く。",
            "zh": "逢濑燕\n看来是来真的。\n先下手为强。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "558/TALK",
            "narrator": "千羽鶴",
            "text": "私は\n非攻略対象！",
            "zh": "我是\n非攻略对象！",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "566/TALK",
            "narrator": "つばめ",
            "text": "むーっ！",
            "zh": "唔——！",
            "narrator_zh": "燕"
        },
        {
            "location": "569/TALK",
            "narrator": "千羽鶴",
            "text": "私は\n非攻略対象！",
            "zh": "我是\n非攻略对象！",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "577/TALK",
            "narrator": "つばめ",
            "text": "むーっ！",
            "zh": "唔——！",
            "narrator_zh": "燕"
        },
        {
            "location": "579/TALK",
            "narrator": "つばめ",
            "text": "死んでもここは\n通さないんだから！",
            "zh": "就算死也不会\n放你们过去的！",
            "narrator_zh": "燕"
        },
        {
            "location": "580/TALK",
            "narrator": "千羽鶴",
            "text": "貴方が死んだら\n普通に通れると\n思うけど？",
            "zh": "你要是死了，\n我们不是正好\n能过去吗？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "581/TALK",
            "narrator": "つばめ",
            "text": "無理だよ。\nだって――",
            "zh": "不行的哦。\n因为——",
            "narrator_zh": "燕"
        },
        {
            "location": "582/TALK",
            "narrator": "つばめ",
            "text": "死ぬときは\n貴方も一緒だもん！",
            "zh": "死的时候，\n你也要一起哦！",
            "narrator_zh": "燕"
        },
        {
            "location": "583/TALK",
            "narrator": "千羽鶴",
            "text": "…！？\nま、まさか貴方、\nあの技を……！？",
            "zh": "……！？\n你、你该不会，\n会那一招……！？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "584/TALK",
            "narrator": "つばめ",
            "text": "えーいっ！",
            "zh": "嘿——！",
            "narrator_zh": "燕"
        },
        {
            "location": "593/TALK",
            "narrator": "千羽鶴",
            "text": "たいへん。\n身構えて！",
            "zh": "不好。\n快防备！",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "594/TALK",
            "narrator": "つばめ",
            "text": "貴方を取り込んで\nわたしもろとも死ぬ！！",
            "zh": "我要把你吞进去，\n和我一起同归于尽！！",
            "narrator_zh": "燕"
        },
        {
            "location": "596/TALK",
            "narrator": "千羽鶴",
            "text": "とりこまれる！！",
            "zh": "要被吞进去了！！",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "597/SEL",
            "narrator": "",
            "text": "千羽鶴を守る！",
            "zh": "保护千羽鹤！",
            "narrator_zh": ""
        },
        {
            "location": "598/ACT",
            "narrator": "",
            "text": "千羽鶴を守る！",
            "zh": "保护千羽鹤！",
            "narrator_zh": ""
        },
        {
            "location": "606/TALK",
            "narrator": "つばめ",
            "text": "やあぁぁぁぁっ！！",
            "zh": "呀啊啊啊啊！！",
            "narrator_zh": "燕"
        },
        {
            "location": "619/TALK",
            "narrator": "つばめ",
            "text": "そ…そんな。",
            "zh": "怎…怎么会。",
            "narrator_zh": "燕"
        },
        {
            "location": "620/TALK",
            "narrator": "つばめ",
            "text": "まさか、\nとりこみが\n拒絶されるなんて…",
            "zh": "没想到，\n吞取居然\n会被拒绝……",
            "narrator_zh": "燕"
        },
        {
            "location": "621/TALK",
            "narrator": "千羽鶴",
            "text": "私だって\nレベルアップしてる。",
            "zh": "我这边\n也升级了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "622/TALK",
            "narrator": "千羽鶴",
            "text": "それに今回は\n$handle$も\nいるもの。",
            "zh": "而且这次，\n还有$handle$\n在呀。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "623/TALK",
            "narrator": "つばめ",
            "text": "どう……し…て…　…",
            "zh": "为……什…么…　…",
            "narrator_zh": "燕"
        },
        {
            "location": "636/TALK",
            "narrator": "千羽鶴",
            "text": "やったわ。\nラスボスつばめを倒した。",
            "zh": "成功了。\n打倒了最终BOSS燕。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "637/TALK",
            "narrator": "千羽鶴",
            "text": "これも全部、\n貴方のお陰。",
            "zh": "这也全是，\n你的功劳。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "638/SEL",
            "narrator": "",
            "text": "どういたしまして",
            "zh": "不客气",
            "narrator_zh": ""
        },
        {
            "location": "639/ACT",
            "narrator": "",
            "text": "どういたしまして",
            "zh": "不客气",
            "narrator_zh": ""
        },
        {
            "location": "641/TALK",
            "narrator": "千羽鶴",
            "text": "さあ、ついに伝説の秘宝\n『非消滅の宝玉』が眠る\nお城が目の前に。",
            "zh": "看，传说秘宝\n『不灭宝玉』沉睡的城堡，\n终于就在眼前。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "642/TALK",
            "narrator": "千羽鶴",
            "text": "早く行きましょ。",
            "zh": "快过去吧。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "512/DIALOG",
            "narrator": "NOTICE",
            "text": "敵が現れた！！",
            "zh": "敌人出现了！！",
            "narrator_zh": "NOTICE"
        },
        {
            "location": "557/DIALOG",
            "narrator": "INFO",
            "text": "千羽鶴のこうげき！",
            "zh": "千羽鹤的攻击！",
            "narrator_zh": "INFO"
        },
        {
            "location": "564/DIALOG",
            "narrator": "INFO",
            "text": "ラスボスつばめに\n１０ポイントのダメージ",
            "zh": "对最终BOSS燕造成\n１０点伤害",
            "narrator_zh": "INFO"
        },
        {
            "location": "567/DIALOG",
            "narrator": "INFO",
            "text": "ラスボスつばめは\nちからをためている…",
            "zh": "最终BOSS燕\n正在蓄力……",
            "narrator_zh": "INFO"
        },
        {
            "location": "568/DIALOG",
            "narrator": "INFO",
            "text": "千羽鶴のこうげき！",
            "zh": "千羽鹤的攻击！",
            "narrator_zh": "INFO"
        },
        {
            "location": "575/DIALOG",
            "narrator": "INFO",
            "text": "ラスボスつばめに\n１５ポイントのダメージ",
            "zh": "对最终BOSS燕造成\n１５点伤害",
            "narrator_zh": "INFO"
        },
        {
            "location": "578/DIALOG",
            "narrator": "INFO",
            "text": "ラスボスつばめは\nちからをためている…",
            "zh": "最终BOSS燕\n正在蓄力……",
            "narrator_zh": "INFO"
        },
        {
            "location": "589/DIALOG",
            "narrator": "INFO",
            "text": "ラスボスつばめは\n捨て身の魔法をとなえた！",
            "zh": "最终BOSS燕\n咏唱了舍身魔法！",
            "narrator_zh": "INFO"
        },
        {
            "location": "600/DIALOG",
            "narrator": "INFO",
            "text": "$handle$は\nシールドを張った！",
            "zh": "$handle$\n张开了护盾！",
            "narrator_zh": "INFO"
        },
        {
            "location": "635/DIALOG",
            "narrator": "INFO",
            "text": "<color=red>【Congraturations!!】</color>\nラスボスつばめを倒した！",
            "zh": "<color=red>【Congraturations!!】</color>\n打倒了最终BOSS燕！",
            "narrator_zh": "INFO"
        }
    ]
}
