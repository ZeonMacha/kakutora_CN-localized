{
    "dir": "chap13/daydra/dd_ch03_13_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "13356",
        "cid": "gabriella",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "ガブリエラの想い",
        "title_zh": "Extra006 额外剧情",
        "sub_title_zh": "加布里埃拉的心意"
    },
    "entry": [
        {
            "location": "579/SCENARIO",
            "narrator": "",
            "text": "ガブリエラの想い",
            "zh": "加布里埃拉的心意",
            "narrator_zh": ""
        },
        {
            "location": "600/TALK",
            "narrator": "ガブリエラ",
            "text": "…もうこんな時間かぁ。\nもう少ししたら教室に\n戻らないと。",
            "zh": "……都这个时间了啊。\n再过一会儿就得回\n教室去了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "602/TALK",
            "narrator": "つばめ",
            "text": "えっ？　戻るって…。",
            "zh": "哎？回去是指……。",
            "narrator_zh": "燕"
        },
        {
            "location": "605/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしの教室よ。\nそこ以外にないでしょ？",
            "zh": "我的教室啊。\n除此之外还能是哪儿？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "607/TALK",
            "narrator": "つばめ",
            "text": "あ、ああっ！\nそうだよね！",
            "zh": "啊、啊啊！\n是这样呢！",
            "narrator_zh": "燕"
        },
        {
            "location": "608/TALK",
            "narrator": "つばめ",
            "text": "なんか、こうして\nわたし達の教室で\n話すのに慣れちゃって――",
            "zh": "总觉得，都已经习惯像这样\n在我们的教室里\n聊天了——",
            "narrator_zh": "燕"
        },
        {
            "location": "609/TALK",
            "narrator": "つばめ",
            "text": "わたし達と同じクラス\nって、一瞬思っちゃい\nました。",
            "zh": "一瞬间还以为\n你是和我们\n同班的呢。",
            "narrator_zh": "燕"
        },
        {
            "location": "611/TALK",
            "narrator": "雛",
            "text": "それ、時々あたしも\n思うよ。",
            "zh": "这个念头，我有时候也会\n冒出来哦。",
            "narrator_zh": "雏"
        },
        {
            "location": "612/TALK",
            "narrator": "雛",
            "text": "ガブリエラちゃんが\n自分の教室戻るのって、\nなんか違和感あるよね？",
            "zh": "看到加布里埃拉要回\n自己教室的时候，\n总觉得有种违和感呢？",
            "narrator_zh": "雏"
        },
        {
            "location": "613/TALK",
            "narrator": "つばめ",
            "text": "そうそう。\nガブちゃんはどう？",
            "zh": "对对对。\n加布自己觉得呢？",
            "narrator_zh": "燕"
        },
        {
            "location": "618/TALK",
            "narrator": "ガブリエラ",
            "text": "…ま、まあ、感じない\nこともないわ。",
            "zh": "……嘛、嘛，倒也不是\n完全没有那种感觉。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "619/TALK",
            "narrator": "ガブリエラ",
            "text": "ここ、思ったよりかは\n居心地悪くないし――。",
            "zh": "这里比我想象中还要\n让人觉得自在不少——。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "620/TALK",
            "narrator": "ガブリエラ",
            "text": "正直、自分の教室より\n楽しいし。",
            "zh": "老实说，也比我自己的\n教室有意思多了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "623/TALK",
            "narrator": "雛",
            "text": "もー、ずっとここに\nいればいいのにー。",
            "zh": "真是的，干脆一直待在\n这边不就好了嘛—。",
            "narrator_zh": "雏"
        },
        {
            "location": "628/TALK",
            "narrator": "ガブリエラ",
            "text": "無理言わないでよ。",
            "zh": "别说胡话啦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "629/TALK",
            "narrator": "繭",
            "text": "…私、ガブリエラを\n年下と思ったことも\nないかも。",
            "zh": "……我啊，甚至从来没觉得\n加布里埃拉比我们\n年纪小呢。",
            "narrator_zh": "茧"
        },
        {
            "location": "630/TALK",
            "narrator": "繭",
            "text": "生意気で後輩らしく\nないからだと思う。",
            "zh": "大概是因为你太狂妄、\n一点后辈的样子都没有吧。",
            "narrator_zh": "茧"
        },
        {
            "location": "631/TALK",
            "narrator": "雛",
            "text": "ああ、それあるかも。",
            "zh": "啊啊，确实有这个原因。",
            "narrator_zh": "雏"
        },
        {
            "location": "635/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしのどこが\n生意気だっていうのよ！",
            "zh": "我到底哪里\n狂妄了啊！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "636/TALK",
            "narrator": "雛",
            "text": "つばめちゃん、\n教えてあげて。",
            "zh": "燕，\n你来告诉她吧。",
            "narrator_zh": "雏"
        },
        {
            "location": "637/TALK",
            "narrator": "つばめ",
            "text": "が、ガブちゃんは…、\nとっても可愛い良い子\nだと思いますよ？",
            "zh": "加、加布……\n我觉得她是个非常可爱\n又乖巧的好孩子哦？",
            "narrator_zh": "燕"
        },
        {
            "location": "639/TALK",
            "narrator": "ガブリエラ",
            "text": "…嘘くさいわ。",
            "zh": "……听起来好假。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "640/TALK",
            "narrator": "繭",
            "text": "…そういうところよ。",
            "zh": "……就是这种地方啊。",
            "narrator_zh": "茧"
        },
        {
            "location": "641/TALK",
            "narrator": "雛",
            "text": "でも、\n本当に何でだろうね？",
            "zh": "不过，这到底是\n为什么呢？",
            "narrator_zh": "雏"
        },
        {
            "location": "642/TALK",
            "narrator": "雛",
            "text": "教室だけじゃなくて、\n学年が違うのまで\n気にならないなんて――",
            "zh": "不只是教室，甚至连\n年级不同这种事\n都让人完全不在意——",
            "narrator_zh": "雏"
        },
        {
            "location": "643/TALK",
            "narrator": "雛",
            "text": "ちょっと不思議かも",
            "zh": "说起来还挺神奇的呢",
            "narrator_zh": "雏"
        },
        {
            "location": "646/TALK",
            "narrator": "ガブリエラ",
            "text": "そりゃ多分…。",
            "zh": "那大概是因为……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "647/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "649/TALK",
            "narrator": "繭",
            "text": "何？",
            "zh": "怎么了？",
            "narrator_zh": "茧"
        },
        {
            "location": "651/TALK",
            "narrator": "ガブリエラ",
            "text": "…な、何だろ？\n何言おうとしてたか\n忘れちゃったわ。",
            "zh": "……什、什么来着？\n我刚才想说什么来着，\n一下子给忘了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "654/TALK",
            "narrator": "ガブリエラ",
            "text": "…多分、友達だから\nよね？",
            "zh": "……大概，是因为我们是朋友\n对吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "655/SEL",
            "narrator": "",
            "text": "端末操作：つばめのスマホ",
            "zh": "终端操作：燕的手机",
            "narrator_zh": ""
        },
        {
            "location": "656/SEL",
            "narrator": "",
            "text": "僕が答えよう",
            "zh": "由我来回答吧",
            "narrator_zh": ""
        },
        {
            "location": "657/SEL",
            "narrator": "",
            "text": "一度だけ言えばいいんだよ",
            "zh": "只要说出口一次就好了哦",
            "narrator_zh": ""
        },
        {
            "location": "659/TALK",
            "narrator": "ガブリエラ",
            "text": "けど、こういうのって\n言葉にするの、\n凄く恥ずかしいかも…。",
            "zh": "不过，这种话要真\n说出口的话，\n总觉得好害羞啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "660/TALK",
            "narrator": "ガブリエラ",
            "text": "それに、あたしが\n年下なのに\n違いないし――",
            "zh": "而且，我确实\n也比你们年纪小\n这是事实——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "661/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょっと、失礼？\n親しき仲にもなんとか、\nって言うし…。",
            "zh": "那样是不是有点失礼？\n常言道熟归熟也得\n讲究个什么来着……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "666/TALK",
            "narrator": "ガブリエラ",
            "text": "…それじゃあ、戻るわ。",
            "zh": "……那我先回去了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "667/TALK",
            "narrator": "つばめ",
            "text": "うん。",
            "zh": "嗯。",
            "narrator_zh": "燕"
        },
        {
            "location": "668/TALK",
            "narrator": "雛",
            "text": "ガブリエラちゃん、\nまたねー！",
            "zh": "加布里埃拉，\n待会儿见哦—！",
            "narrator_zh": "雏"
        },
        {
            "location": "672/TALK",
            "narrator": "ガブリエラ",
            "text": "…戻りたくないなぁ。",
            "zh": "……真不想回去啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "674/ACT",
            "narrator": "",
            "text": "端末操作：つばめのスマホ",
            "zh": "终端操作：燕的手机",
            "narrator_zh": ""
        },
        {
            "location": "678/SEL",
            "narrator": "",
            "text": "友達だからだと思うよ",
            "zh": "大概是因为是朋友吧",
            "narrator_zh": ""
        },
        {
            "location": "679/SEL",
            "narrator": "",
            "text": "妹みたいなもんだしね",
            "zh": "毕竟就像妹妹一样嘛",
            "narrator_zh": ""
        },
        {
            "location": "680/ACT",
            "narrator": "",
            "text": "友達だからだと思うよ",
            "zh": "大概是因为是朋友吧",
            "narrator_zh": ""
        },
        {
            "location": "697/TALK",
            "narrator": "つばめ",
            "text": "そうだね",
            "zh": "说得也是呢",
            "narrator_zh": "燕"
        },
        {
            "location": "698/TALK",
            "narrator": "つばめ",
            "text": "だから気にならないんだね",
            "zh": "所以才不会在意呢",
            "narrator_zh": "燕"
        },
        {
            "location": "710/TALK",
            "narrator": "つばめ",
            "text": "…年の差とかが気に\nならないのは――",
            "zh": "……之所以不在意\n年龄差之类的——",
            "narrator_zh": "燕"
        },
        {
            "location": "711/TALK",
            "narrator": "つばめ",
            "text": "やっぱり、友達だから\nじゃないかな？",
            "zh": "果然，是因为我们是朋友\n对吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "713/TALK",
            "narrator": "繭",
            "text": "そうね",
            "zh": "没错",
            "narrator_zh": "茧"
        },
        {
            "location": "714/TALK",
            "narrator": "繭",
            "text": "ガブリエラは後輩属性\nゼロだから、そうなるのは\n必然だし。",
            "zh": "加布里埃拉身上后辈属性\n为零，会变成这样也是\n必然的嘛。",
            "narrator_zh": "茧"
        },
        {
            "location": "717/TALK",
            "narrator": "雛",
            "text": "やっぱり、友達ってのが\n一番しっくりくるよねー。\nつばめちゃん、ナイス！",
            "zh": "果然，“朋友”这个词\n最贴切了呢—。\n燕，说得好！",
            "narrator_zh": "雏"
        },
        {
            "location": "719/TALK",
            "narrator": "つばめ",
            "text": "えへへ…。\nガブちゃんは\nどう思う？",
            "zh": "哎嘿嘿……。\n加布觉得\n怎么样呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "721/TALK",
            "narrator": "ガブリエラ",
            "text": "ど、どうって…\nまあ、悪い気持ちは\nしないけど…。",
            "zh": "什、什么怎么样……\n嘛，心里倒是不讨厌\n就是了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "722/TALK",
            "narrator": "つばめ",
            "text": "よかったぁ…。",
            "zh": "太好了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "725/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、つばめが新人で\nあたしがせんぱいなのは\n変わらないわよ！",
            "zh": "不过，燕是新人\n而我是前辈这一点，\n可是不会变的哦！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "727/TALK",
            "narrator": "つばめ",
            "text": "ふふっ…その方が\nガブちゃんっぽくて\n好きかも。",
            "zh": "呼呼……那样才更有\n加布的感觉，\n我挺喜欢的。",
            "narrator_zh": "燕"
        },
        {
            "location": "729/TALK",
            "narrator": "ガブリエラ",
            "text": "どういう意味よ、\nまったく…。",
            "zh": "你这话什么意思啊，\n真是的……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "731/TALK",
            "narrator": "ガブリエラ",
            "text": "…あたしが言えなかった\nこと、こんな簡単に言える\nなんて…。",
            "zh": "……我没能说出口的话，\n她居然这么轻易地\n就说出来了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "734/TALK",
            "narrator": "ガブリエラ",
            "text": "…やっぱり、あたしって\nまだ子供かも。",
            "zh": "……果然，我还只是个\n小孩子吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "735/ACT",
            "narrator": "",
            "text": "妹みたいなもんだしね",
            "zh": "毕竟就像妹妹一样嘛",
            "narrator_zh": ""
        },
        {
            "location": "754/TALK",
            "narrator": "つばめ",
            "text": "妹かぁ…確かに、そんな感じかも",
            "zh": "妹妹呀……确实，有点那种感觉呢",
            "narrator_zh": "燕"
        },
        {
            "location": "766/TALK",
            "narrator": "つばめ",
            "text": "あ、わかった！",
            "zh": "啊，我明白了！",
            "narrator_zh": "燕"
        },
        {
            "location": "768/TALK",
            "narrator": "つばめ",
            "text": "妹みたいな感じが\nするからじゃない\nかな？",
            "zh": "大概是因为她给人的感觉\n就像妹妹一样，\n对吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "771/TALK",
            "narrator": "ガブリエラ",
            "text": "い、妹！？",
            "zh": "妹、妹妹！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "774/TALK",
            "narrator": "繭",
            "text": "逢瀬さん、それ、\n凄く納得したわ。",
            "zh": "逢濑同学，这个说法\n我非常认同。",
            "narrator_zh": "茧"
        },
        {
            "location": "775/TALK",
            "narrator": "繭",
            "text": "ちょっと生意気でも、\n嫌な気がしないのは\n多分それが理由。",
            "zh": "就算有点狂妄，\n却不会让人讨厌，\n多半就是这个原因。",
            "narrator_zh": "茧"
        },
        {
            "location": "776/TALK",
            "narrator": "雛",
            "text": "ガブリエラちゃん、\nお姉ちゃんって\n呼んでいいんだよー。",
            "zh": "加布里埃拉，\n叫我们一声姐姐\n也可以哦—。",
            "narrator_zh": "雏"
        },
        {
            "location": "779/TALK",
            "narrator": "ガブリエラ",
            "text": "言うかー！",
            "zh": "谁会叫啊—！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "781/TALK",
            "narrator": "ガブリエラ",
            "text": "っていうか、せんぱいの\nあたしを妹みたいとか、\n生意気よ！",
            "zh": "话说回来，把身为前辈的\n我当成妹妹什么的，\n你们才狂妄呢！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "784/TALK",
            "narrator": "繭",
            "text": "…そういう生意気な\nところが、まさに\n妹って感じ。",
            "zh": "……就是这种狂妄的\n样子，简直活脱脱\n像个妹妹。",
            "narrator_zh": "茧"
        },
        {
            "location": "787/TALK",
            "narrator": "ガブリエラ",
            "text": "納得するなー！！",
            "zh": "别自顾自认同啊——！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "790/TALK",
            "narrator": "ガブリエラ",
            "text": "…でも、みんなみたいな\nお姉ちゃんがいたら、\n毎日楽しそうかも…。",
            "zh": "……不过，要是有大家这样的\n姐姐在的话，每天说不定\n都会很开心呢……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "792/TALK",
            "narrator": "ガブリエラ",
            "text": "…つばめお姉ちゃん、\n雛お姉ちゃん、\n繭お姉ちゃん、か…。",
            "zh": "……燕姐姐、\n雏姐姐、\n茧姐姐，吗……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "794/TALK",
            "narrator": "つばめ",
            "text": "…な、なんですか？\nもしかして、怒ってます？",
            "zh": "……怎、怎么了吗？\n难道说，生气了？",
            "narrator_zh": "燕"
        },
        {
            "location": "796/TALK",
            "narrator": "ガブリエラ",
            "text": "…別に。",
            "zh": "……才没有。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "799/TALK",
            "narrator": "ガブリエラ",
            "text": "意外と、いいかも…。",
            "zh": "意外地，好像也不错……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "801/ACT",
            "narrator": "",
            "text": "僕が答えよう",
            "zh": "由我来回答吧",
            "narrator_zh": ""
        },
        {
            "location": "821/TALK",
            "narrator": "ガブリエラ",
            "text": "マルザンナは頼りになるわね",
            "zh": "玛尔赞娜真靠得住呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "822/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、やっぱりいいわ",
            "zh": "不过，还是算了吧",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "823/TALK",
            "narrator": "ガブリエラ",
            "text": "代わりに言ってもらったとしても、やっぱり恥ずかしいもの",
            "zh": "就算让你替我说，果然还是好害羞啊",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "825/SEL",
            "narrator": "",
            "text": "友達だからだよ",
            "zh": "因为是朋友呀",
            "narrator_zh": ""
        },
        {
            "location": "826/ACT",
            "narrator": "",
            "text": "友達だからだよ",
            "zh": "因为是朋友呀",
            "narrator_zh": ""
        },
        {
            "location": "828/TALK",
            "narrator": "ガブリエラ",
            "text": "表示しないで！",
            "zh": "别显示出来啊！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "829/TALK",
            "narrator": "ガブリエラ",
            "text": "本当に無理だから、恥ずかしいんだってば…",
            "zh": "真的不行啦，都说了好害羞的……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "841/TALK",
            "narrator": "つばめ",
            "text": "せんぱい、大丈夫ですか？",
            "zh": "前辈，你没事吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "843/TALK",
            "narrator": "ガブリエラ",
            "text": "何が？",
            "zh": "什么事？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "844/TALK",
            "narrator": "雛",
            "text": "凄い必死に、\nスマホ弄ってた\nけど――",
            "zh": "看你那么拼命地在\n戳手机屏幕\n嘛——",
            "narrator_zh": "雏"
        },
        {
            "location": "845/TALK",
            "narrator": "雛",
            "text": "誰からのメールだったの？",
            "zh": "是谁发来的邮件呀？",
            "narrator_zh": "雏"
        },
        {
            "location": "847/TALK",
            "narrator": "ガブリエラ",
            "text": "だ、誰って、その…。",
            "zh": "谁、谁发来的，那个……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "848/TALK",
            "narrator": "ガブリエラ",
            "text": "…Ｂｏｔのマルザンナ、\nなんて言えないわ！",
            "zh": "……总不能说是Bot的\n玛尔赞娜吧！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "851/TALK",
            "narrator": "ガブリエラ",
            "text": "…あ、あぁっ、いけない！\nもう時間だから教室\n戻らないと。",
            "zh": "……啊、啊啊，糟了！\n已经到时间了，我得回\n教室才行。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "852/TALK",
            "narrator": "ガブリエラ",
            "text": "それじゃ！",
            "zh": "那就先走了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "861/TALK",
            "narrator": "つばめ",
            "text": "あっ、ガブちゃん！",
            "zh": "啊，加布！",
            "narrator_zh": "燕"
        },
        {
            "location": "862/TALK",
            "narrator": "つばめ",
            "text": "…まだ、そんなに慌てる\n時間じゃないのに。",
            "zh": "……明明还没到需要\n这么慌慌张张回去的时间呢。",
            "narrator_zh": "燕"
        },
        {
            "location": "863/TALK",
            "narrator": "雛",
            "text": "聞かれたくない相手から\nだったのかなー？",
            "zh": "是不是不想被我们听见的\n对象发来的呀—？",
            "narrator_zh": "雏"
        },
        {
            "location": "865/TALK",
            "narrator": "繭",
            "text": "彼氏とか？",
            "zh": "男朋友之类的？",
            "narrator_zh": "茧"
        },
        {
            "location": "867/TALK",
            "narrator": "つばめ",
            "text": "彼氏がいるようには\n見えないけど…。",
            "zh": "看着也不像是有\n男朋友的样子啊……。",
            "narrator_zh": "燕"
        },
        {
            "location": "868/TALK",
            "narrator": "雛",
            "text": "…ま、まさか――",
            "zh": "……难、难道说——",
            "narrator_zh": "雏"
        },
        {
            "location": "869/TALK",
            "narrator": "雛",
            "text": "銃の腕を見込んだ\n相手からの、\n暗殺依頼とか！？",
            "zh": "是看中了她的枪法\n而找上门来的\n暗杀委托之类的！？",
            "narrator_zh": "雏"
        },
        {
            "location": "870/TALK",
            "narrator": "繭",
            "text": "美少女暗殺者！？\n何それかっこいい！",
            "zh": "美少女暗杀者！？\n那是什么，超帅的！",
            "narrator_zh": "茧"
        },
        {
            "location": "872/TALK",
            "narrator": "つばめ",
            "text": "もぉ、漫画じゃないん\nだから…。",
            "zh": "真是的，又不是漫画\n情节……。",
            "narrator_zh": "燕"
        },
        {
            "location": "873/ACT",
            "narrator": "",
            "text": "一度だけ言えばいいんだよ",
            "zh": "只要说出口一次就好了哦",
            "narrator_zh": ""
        },
        {
            "location": "893/TALK",
            "narrator": "ガブリエラ",
            "text": "わかってるけど、その一度が言えないのよ",
            "zh": "我也知道啊，可就是那一次说不出口嘛",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "894/TALK",
            "narrator": "ガブリエラ",
            "text": "凄く勇気いるし、",
            "zh": "这需要很大的勇气，",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "895/TALK",
            "narrator": "ガブリエラ",
            "text": "なんか、こう…ちょっとむず痒いんだもの",
            "zh": "而且总觉得，怎么说……浑身有点不自在嘛",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "906/TALK",
            "narrator": "ガブリエラ",
            "text": "…言い訳ばっかり\n書いてた気がするわ。",
            "zh": "……感觉我光顾着\n打些借口发过去了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "909/TALK",
            "narrator": "ガブリエラ",
            "text": "…そろそろ、教室戻るわ。",
            "zh": "……差不多，我该回教室了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "910/TALK",
            "narrator": "雛",
            "text": "また後でねー。",
            "zh": "待会儿见哦—。",
            "narrator_zh": "雏"
        },
        {
            "location": "911/TALK",
            "narrator": "繭",
            "text": "それじゃあ。",
            "zh": "回见。",
            "narrator_zh": "茧"
        },
        {
            "location": "914/TALK",
            "narrator": "ガブリエラ",
            "text": "…いつかは、言えるように\nなりたいな。",
            "zh": "……真希望总有一天，能亲口\n说出来啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "589/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>7月12日　12:55 PM</color>\nとある平日の昼休み、高等部教室でのこと。",
            "zh": "<color=green>7月12日　12:55 PM</color>\n某个平日的午休，发生在高等部教室的事。",
            "narrator_zh": "Dialog_EventData"
        }
    ]
}
