{
 "dir": "dramatics/daydra/drm_ch03_00_170.js",
 "type": "Episode",
 "info": {
  "story_id": "3017",
  "cid": "gabriella",
  "title": "らぶとーく  第17話",
  "sub_title": "知ってるんだから"
 },
 "entry": [
  {
   "location": "468/SCENARIO",
   "narrator": "",
   "text": "知ってるんだから"
  },
  {
   "location": "480/TALK",
   "narrator": "ガブリエラ",
   "text": "ふぅ…。",
   "zh": "呼……。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "481/TALK",
   "narrator": "ガブリエラ",
   "text": "…やっぱり、今日は\n変な気分かも。",
   "zh": "……果然，今天\n感觉怪怪的。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "482/TALK",
   "narrator": "ガブリエラ",
   "text": "一日中モヤモヤした\n気持ちが続いてるし――"
  },
  {
   "location": "483/TALK",
   "narrator": "ガブリエラ",
   "text": "でも、体調が悪い、って\nわけじゃないし…。",
   "zh": "不过，也不是\n身体不舒服……。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "484/TALK",
   "narrator": "ガブリエラ",
   "text": "…せっかくカフェに\n来たってのに、これじゃ\n楽しくないわ…。"
  },
  {
   "location": "486/TALK",
   "narrator": "ガブリエラ",
   "text": "はぁ…。",
   "zh": "哈啊……。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "487/SEL",
   "narrator": "",
   "text": "おーい",
   "zh": "喂——",
   "narrator_zh": ""
  },
  {
   "location": "488/ACT",
   "narrator": "",
   "text": "おーい",
   "zh": "喂——",
   "narrator_zh": ""
  },
  {
   "location": "499/TALK",
   "narrator": "ガブリエラ",
   "text": "何よ？"
  },
  {
   "location": "501/SEL",
   "narrator": "",
   "text": "退屈してるんじゃないかって",
   "zh": "还以为你会觉得无聊",
   "narrator_zh": ""
  },
  {
   "location": "502/SEL",
   "narrator": "",
   "text": "何してるの？",
   "zh": "你在做什么？",
   "narrator_zh": ""
  },
  {
   "location": "503/SEL",
   "narrator": "",
   "text": "ガブリエラのことが気になって",
   "zh": "因为在意加布里埃拉的事",
   "narrator_zh": ""
  },
  {
   "location": "504/ACT",
   "narrator": "",
   "text": "退屈してるんじゃないかって",
   "zh": "还以为你会觉得无聊",
   "narrator_zh": ""
  },
  {
   "location": "505/TALK",
   "narrator": "ガブリエラ",
   "text": "してないわよ"
  },
  {
   "location": "506/TALK",
   "narrator": "ガブリエラ",
   "text": "今、優雅にティータイムを楽しんでいるところなんだから"
  },
  {
   "location": "507/TALK",
   "narrator": "ガブリエラ",
   "text": "邪魔しないで"
  },
  {
   "location": "509/SEL",
   "narrator": "",
   "text": "怒ってる？",
   "zh": "生气了？",
   "narrator_zh": ""
  },
  {
   "location": "510/ACT",
   "narrator": "",
   "text": "怒ってる？",
   "zh": "生气了？",
   "narrator_zh": ""
  },
  {
   "location": "512/TALK",
   "narrator": "ガブリエラ",
   "text": "は？　なんで？",
   "zh": "哈？　为什么？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "514/TALK",
   "narrator": "ガブリエラ",
   "text": "っていうか、私だけに構ってていいの？",
   "zh": "话说，只关注我就好吗？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "515/TALK",
   "narrator": "ガブリエラ",
   "text": "他の子達と話すのに忙しいんでしょうし"
  },
  {
   "location": "516/TALK",
   "narrator": "ガブリエラ",
   "text": "こういうところ、まめよね？",
   "zh": "这种地方，你倒是挺细心嘛？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "519/ACT",
   "narrator": "",
   "text": "何してるの？",
   "zh": "你在做什么？",
   "narrator_zh": ""
  },
  {
   "location": "520/TALK",
   "narrator": "ガブリエラ",
   "text": "別に",
   "zh": "无所谓",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "521/TALK",
   "narrator": "ガブリエラ",
   "text": "期間限定ケーキを食べにきたのよ"
  },
  {
   "location": "522/TALK",
   "narrator": "ガブリエラ",
   "text": "それだけ",
   "zh": "就这些",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "524/SEL",
   "narrator": "",
   "text": "機嫌悪い？",
   "zh": "心情不好？",
   "narrator_zh": ""
  },
  {
   "location": "525/ACT",
   "narrator": "",
   "text": "機嫌悪い？",
   "zh": "心情不好？",
   "narrator_zh": ""
  },
  {
   "location": "527/TALK",
   "narrator": "ガブリエラ",
   "text": "は？　なんで？",
   "zh": "哈？　为什么？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "529/TALK",
   "narrator": "ガブリエラ",
   "text": "っていうか、他の子達と話すのに忙しいんでしょ？",
   "zh": "话说，你忙着跟其他孩子说话吧？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "530/TALK",
   "narrator": "ガブリエラ",
   "text": "私に気を使って話す必要、なくってよ"
  },
  {
   "location": "533/ACT",
   "narrator": "",
   "text": "ガブリエラのことが気になって",
   "zh": "因为在意加布里埃拉的事",
   "narrator_zh": ""
  },
  {
   "location": "534/TALK",
   "narrator": "ガブリエラ",
   "text": "あら、さすがねマルザンナ"
  },
  {
   "location": "535/TALK",
   "narrator": "ガブリエラ",
   "text": "口がお上手なことで"
  },
  {
   "location": "536/TALK",
   "narrator": "ガブリエラ",
   "text": "そうやって、みんなとも仲良くなったのかしら？",
   "zh": "是那样和大家处好了关系吗？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "539/SEL",
   "narrator": "",
   "text": "何のこと？",
   "zh": "什么事？",
   "narrator_zh": ""
  },
  {
   "location": "540/ACT",
   "narrator": "",
   "text": "何のこと？",
   "zh": "什么事？",
   "narrator_zh": ""
  },
  {
   "location": "542/TALK",
   "narrator": "ガブリエラ",
   "text": "何でもないわ",
   "zh": "没什么",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "543/TALK",
   "narrator": "ガブリエラ",
   "text": "私だけじゃなくって"
  },
  {
   "location": "544/TALK",
   "narrator": "ガブリエラ",
   "text": "みんなのことも気になってるくせに"
  },
  {
   "location": "552/TALK",
   "narrator": "ガブリエラ",
   "text": "はぁ…余計楽しく\nなくなってきたかも…。",
   "zh": "唉……好像变得更\n不有趣了……。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "553/TALK",
   "narrator": "ガブリエラ",
   "text": "もう、帰ろうかしら…。"
  }
 ]
}
