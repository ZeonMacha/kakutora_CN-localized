{
    "dir": "chap06/daydra/dd_ch04_06_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "6408",
        "cid": "miyabi",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "手書き嫌い",
        "title_zh": "Extra002 额外剧情",
        "sub_title_zh": "讨厌手写"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "手書き嫌い",
            "zh": "讨厌手写",
            "narrator_zh": ""
        },
        {
            "location": "24/TALK",
            "narrator": "みやび",
            "text": "はぁ…憂鬱や。",
            "zh": "唉……真郁闷。",
            "narrator_zh": "雅"
        },
        {
            "location": "26/TALK",
            "narrator": "アーヤ",
            "text": "何か嫌なことでも\nあったの？",
            "zh": "出了什么\n不痛快的事？",
            "narrator_zh": "绫水"
        },
        {
            "location": "28/TALK",
            "narrator": "みやび",
            "text": "いやな、うちは普段\nからＰＣのキーボード\n叩くんに慣れちゅう。",
            "zh": "不是，我平时\n已经习惯敲\n电脑键盘了。",
            "narrator_zh": "雅"
        },
        {
            "location": "30/TALK",
            "narrator": "みやび",
            "text": "やき、黒板の文字を\n手でノートに書くんが、\n苦行過ぎて堪らんちや。",
            "zh": "所以嘛，用手把黑板上的字\n抄到笔记本上，\n苦得受不了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "32/TALK",
            "narrator": "アーヤ",
            "text": "う～ん…まあ、みやびの\n気持ちもわからないでは\nないわ。",
            "zh": "嗯……嘛，雅的\n心情也不是\n不能理解。",
            "narrator_zh": "绫水"
        },
        {
            "location": "33/TALK",
            "narrator": "アーヤ",
            "text": "黒板から目を逸らさずに\nタッタカ打ち込んで\nいけるだろうし。",
            "zh": "眼睛不用离开黑板，\n就能嗒嗒嗒地\n打进去。",
            "narrator_zh": "绫水"
        },
        {
            "location": "35/TALK",
            "narrator": "みやび",
            "text": "それを考えると、\n本気でアホらしゅう\nなってくるんよ…。",
            "zh": "一想到这个，\n就真的觉得\n傻得慌……。",
            "narrator_zh": "雅"
        },
        {
            "location": "36/TALK",
            "narrator": "みやび",
            "text": "なのに、キーボードの\n音が授業の邪魔になる\nから禁止、やと？",
            "zh": "结果呢，键盘声\n会妨碍上课\n所以禁止，是吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "37/TALK",
            "narrator": "みやび",
            "text": "アホらしゅうて\n呆れるがよ。",
            "zh": "傻得\n让人无语。",
            "narrator_zh": "雅"
        },
        {
            "location": "38/TALK",
            "narrator": "アーヤ",
            "text": "まあ、そういうルール\nだと思って、諦める\nしかないんじゃない？",
            "zh": "嘛，就当是这种规矩，\n只能放弃了\n吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "39/TALK",
            "narrator": "みやび",
            "text": "諦められんから\n言っちゅうに…。",
            "zh": "就是放不下\n才说的……。",
            "narrator_zh": "雅"
        },
        {
            "location": "40/TALK",
            "narrator": "アーヤ",
            "text": "っと、そろそろ講義が\n始まるから、行くわ。",
            "zh": "哎呀，课快开始了，\n我走了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "44/TALK",
            "narrator": "みやび",
            "text": "…うちも、\n授業の準備せんと。",
            "zh": "……我也得\n准备上课了。",
            "narrator_zh": "雅"
        },
        {
            "location": "57/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "58/TALK",
            "narrator": "みやび",
            "text": "やっぱり、どうにも\nアナログな作業は\n合わんなぁ…。",
            "zh": "果然，这种手工活\n怎么都\n不适合……。",
            "narrator_zh": "雅"
        },
        {
            "location": "59/TALK",
            "narrator": "みやび",
            "text": "てか、先生そこに立つと\n黒板が見えんちや！",
            "zh": "而且，老师站那儿\n黑板都看不见咯！",
            "narrator_zh": "雅"
        },
        {
            "location": "60/TALK",
            "narrator": "みやび",
            "text": "はぁ…もう面倒やし、\n寝てしまうかが？",
            "zh": "唉……太麻烦了，\n干脆睡过去算了？",
            "narrator_zh": "雅"
        },
        {
            "location": "61/SEL",
            "narrator": "",
            "text": "コッソリ黒板を撮影だ",
            "zh": "偷偷拍下黑板",
            "narrator_zh": ""
        },
        {
            "location": "62/SEL",
            "narrator": "",
            "text": "美文字の練習だと思おう",
            "zh": "就当是练字",
            "narrator_zh": ""
        },
        {
            "location": "63/SEL",
            "narrator": "",
            "text": "タブレットに書こう",
            "zh": "写到平板上",
            "narrator_zh": ""
        },
        {
            "location": "64/ACT",
            "narrator": "",
            "text": "コッソリ黒板を撮影だ",
            "zh": "偷偷拍下黑板",
            "narrator_zh": ""
        },
        {
            "location": "74/TALK",
            "narrator": "みやび",
            "text": "盲点やった！",
            "zh": "这是盲点！",
            "narrator_zh": "雅"
        },
        {
            "location": "75/TALK",
            "narrator": "みやび",
            "text": "撮影ゆう手段があったちや！",
            "zh": "还有拍照这个办法咯！",
            "narrator_zh": "雅"
        },
        {
            "location": "76/TALK",
            "narrator": "みやび",
            "text": "相棒は天才やね",
            "zh": "搭档真是天才咯",
            "narrator_zh": "雅"
        },
        {
            "location": "79/TALK",
            "narrator": "みやび",
            "text": "文字認識ソフトが入った\nカメラアプリを\nダウンロードして…。",
            "zh": "下载带文字识别的\n相机应用\n……。",
            "narrator_zh": "雅"
        },
        {
            "location": "81/TALK",
            "narrator": "みやび",
            "text": "……ん？",
            "zh": "……嗯？",
            "narrator_zh": "雅"
        },
        {
            "location": "83/TALK",
            "narrator": "みやび",
            "text": "相棒、その案は却下や",
            "zh": "搭档，这个方案否决",
            "narrator_zh": "雅"
        },
        {
            "location": "84/TALK",
            "narrator": "みやび",
            "text": "シャッター音で一発で気づかれて、お説教コースへご招待の未来がお待ちや！",
            "zh": "快门声一下就会被发现，等着你的是被训话的未来！",
            "narrator_zh": "雅"
        },
        {
            "location": "86/SEL",
            "narrator": "",
            "text": "万事休すだ",
            "zh": "全完了",
            "narrator_zh": ""
        },
        {
            "location": "87/ACT",
            "narrator": "",
            "text": "万事休すだ",
            "zh": "全完了",
            "narrator_zh": ""
        },
        {
            "location": "89/TALK",
            "narrator": "みやび",
            "text": "代案はないんか？",
            "zh": "没有别的办法喃？",
            "narrator_zh": "雅"
        },
        {
            "location": "90/TALK",
            "narrator": "みやび",
            "text": "しゃあないな…諦めてアナログ作業を頑張るとするちや",
            "zh": "没办法……放弃吧，还是老老实实做手工活咯",
            "narrator_zh": "雅"
        },
        {
            "location": "93/ACT",
            "narrator": "",
            "text": "美文字の練習だと思おう",
            "zh": "就当是练字",
            "narrator_zh": ""
        },
        {
            "location": "103/TALK",
            "narrator": "みやび",
            "text": "…相棒、今えいこと言うたぞ",
            "zh": "……搭档，刚才那句要得",
            "narrator_zh": "雅"
        },
        {
            "location": "104/TALK",
            "narrator": "みやび",
            "text": "最近、ちっくと自分で\n書く文字が歪んできてたんよ",
            "zh": "最近，自己写的字\n有点歪了",
            "narrator_zh": "雅"
        },
        {
            "location": "109/TALK",
            "narrator": "みやび",
            "text": "小さい頃綺麗な文字を\n書く練習したき、\n自慢やったけんど――",
            "zh": "小时候练过写好字啵，\n还挺得意的，\n不过——",
            "narrator_zh": "雅"
        },
        {
            "location": "110/TALK",
            "narrator": "みやび",
            "text": "キーボード入力ばかり\nしちゅうたら、文字が\n歪むんは当然やね。",
            "zh": "净敲键盘的话，\n字会写歪\n也是当然的咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "111/TALK",
            "narrator": "みやび",
            "text": "リハビリやと思うて、\n頑張るとするちや。",
            "zh": "就当是复健，\n努力一下咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "112/ACT",
            "narrator": "",
            "text": "タブレットに書こう",
            "zh": "写到平板上",
            "narrator_zh": ""
        },
        {
            "location": "121/TALK",
            "narrator": "みやび",
            "text": "ノートに書くんとやることは\n変わらん気がするけんど",
            "zh": "和写在笔记本上，要做的事\n好像没变，不过",
            "narrator_zh": "雅"
        },
        {
            "location": "122/TALK",
            "narrator": "みやび",
            "text": "まあ、使い慣れた\nタブレットの方が、\n気持ち的にちっくとラクになるかもしれんね",
            "zh": "嘛，用惯了的\n平板，\n心情上也许能轻松一哈",
            "narrator_zh": "雅"
        },
        {
            "location": "123/TALK",
            "narrator": "みやび",
            "text": "その案、採用や！",
            "zh": "这个方案，采用！",
            "narrator_zh": "雅"
        },
        {
            "location": "128/TALK",
            "narrator": "みやび",
            "text": "…けんど、タッチペンは\nカツカツ音がするき、\n注意されそうやな。",
            "zh": "……不过，触控笔\n会发出咔咔的声音啵，\n好像会被提醒。",
            "narrator_zh": "雅"
        },
        {
            "location": "129/TALK",
            "narrator": "みやび",
            "text": "指で書くんは\n絶対却下とすると…",
            "zh": "用手指写\n绝对否决……",
            "narrator_zh": "雅"
        },
        {
            "location": "131/TALK",
            "narrator": "みやび",
            "text": "…タブレット案は\nなしやな。",
            "zh": "……平板方案\n算了。",
            "narrator_zh": "雅"
        },
        {
            "location": "133/TALK",
            "narrator": "みやび",
            "text": "はぁ…まっこと面倒や…。",
            "zh": "唉……的确麻烦得很……。",
            "narrator_zh": "雅"
        },
        {
            "location": "15/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>5月17日　10:02 AM</color>\nとある休み時間、学園廊下にて。",
            "zh": "<color=green>5月17日　10:02 AM</color>\n某个课间，在学园走廊。",
            "narrator_zh": "Dialog_EventData"
        }
    ]
}
