    "entry": [
        {
            "location": "286/TALK",
            "narrator": "ガブリエラ",
            "text": "この組み合わせ、私も大好きよ",
            "zh": "这个组合我也超喜欢哦",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "288/TALK",
            "narrator": "ガブリエラ",
            "text": "羊羹はポーランドにいた頃に何度か食べたことあるんだけど",
            "zh": "羊羹在波兰的时候吃过几次",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "289/TALK",
            "narrator": "ガブリエラ",
            "text": "水羊羹は、日本に来た最初の頃",
            "zh": "水羊羹是刚来日本那会儿",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "290/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤとお茶しに行った店で、初めて知ったの",
            "zh": "在和绫水去喝茶的店里，才第一次见到的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "293/SEL",
            "narrator": "",
            "text": "アーヤとはよく出掛けるの？",
            "zh": "你经常和绫水出门吗？",
            "narrator_zh": ""
        },
        {
            "location": "294/ACT",
            "narrator": "",
            "text": "アーヤとはよく出掛けるの？",
            "zh": "你经常和绫水出门吗？",
            "narrator_zh": ""
        },
        {
            "location": "297/TALK",
            "narrator": "ガブリエラ",
            "text": "時々ね",
            "zh": "偶尔啦",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "298/TALK",
            "narrator": "ガブリエラ",
            "text": "学校の帰りが一緒になったり",
            "zh": "有时放学顺路一起走",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "299/TALK",
            "narrator": "ガブリエラ",
            "text": "休みの日に何もすることがなかったりすると",
            "zh": "有时休息日没事可做",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "300/TALK",
            "narrator": "ガブリエラ",
            "text": "暇つぶしに、カフェとかに行ったりするの",
            "zh": "就会去咖啡馆什么的打发时间",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "303/SEL",
            "narrator": "",
            "text": "仲良いんだね",
            "zh": "你们关系很好嘛",
            "narrator_zh": ""
        },
        {
            "location": "304/ACT",
            "narrator": "",
            "text": "仲良いんだね",
            "zh": "你们关系很好嘛",
            "narrator_zh": ""
        },
        {
            "location": "307/TALK",
            "narrator": "ガブリエラ",
            "text": "ありえないから！",
            "zh": "怎么可能嘛！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "308/TALK",
            "narrator": "ガブリエラ",
            "text": "昔のアーヤならまだしも",
            "zh": "以前的绫水还勉强说得过去",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "309/TALK",
            "narrator": "ガブリエラ",
            "text": "今のアーヤは抜け殻でしかないんだし",
            "zh": "现在的绫水只剩一副空壳了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "310/TALK",
            "narrator": "ガブリエラ",
            "text": "まあ、ただの暇つぶし相手にしか、思ってないわ",
            "zh": "嘛，我只把她当成打发时间的对象而已",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "311/TALK",
            "narrator": "ガブリエラ",
            "text": "本当よ？",
            "zh": "我可是认真的哦？",
            "narrator_zh": "加布里埃拉"
        }
    ]
}
