{
    "dir": "chap00/daydra/twev_ch03_002.js",
    "type": "",
    "info": {
        "story_id": "31122",
        "cid": "",
        "title": "Twitter Archive 007",
        "sub_title": "卯月画廊：初詣",
        "title_zh": "推特 存档 007",
        "sub_title_zh": "卯月画廊：新年参拜"
    },
    "entry": [
        {
            "location": "164/TALK",
            "narrator": "透明神楽",
            "text": "これはお正月の時に\n描いたものですね。",
            "zh": "这是新年的时候\n画的哦。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "166/TALK",
            "narrator": "透明神楽",
            "text": "皆さんの夢が叶うよう\n願掛けしながら\n描きました♪",
            "zh": "一边许愿大家的梦想\n都能成真\n一边画了它♪",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "169/TALK",
            "narrator": "透明つばめ",
            "text": "よかった！\nお菓子の方の絵で…。",
            "zh": "太好了！\n还好是点心那幅画……。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "170/TALK",
            "narrator": "透明神楽",
            "text": "なにが\n良かったんですか？",
            "zh": "什么\n让你这么高兴呀？",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "171/TALK",
            "narrator": "透明つばめ",
            "text": "えーだって、この絵だと\n普通にお菓子とか\n思い浮かべてるけど――",
            "zh": "诶——因为这幅画，\n看起来就是在\n想点心什么的呀——",
            "narrator_zh": "透明燕"
        },
        {
            "location": "172/TALK",
            "narrator": "透明つばめ",
            "text": "最初に見せてもらった方は\n思ってもいない恥ずかしい\n絵が描かれてたから…。",
            "zh": "最早给我们看的那幅，\n画的全是意想不到的\n害羞东西……。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "174/TALK",
            "narrator": "透明神楽",
            "text": "変ですね…。",
            "zh": "真奇怪呀……。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "175/TALK",
            "narrator": "透明神楽",
            "text": "私の千里眼水晶球は、\n間違いなく皆さんの煩悩を\n見せてくれた筈ですが。",
            "zh": "我的千里眼水晶球，\n明明准确地照出了\n大家的烦恼才对。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "177/TALK",
            "narrator": "透明ガブリエラ",
            "text": "っていうか、どうして\nあたしの思っているものが\nタコなのよ？",
            "zh": "话说回来，为什么\n我心里想的\n会是章鱼啊？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "178/TALK",
            "narrator": "透明神楽",
            "text": "だって、ガブちゃんは\nたこ焼き作るのが\n大好きじゃないですか。",
            "zh": "因为加布酱\n最喜欢做\n章鱼烧了呀。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "179/TALK",
            "narrator": "透明神楽",
            "text": "きっと、千里眼水晶球は\nその想いを映し出したん\nだと思いますよ。",
            "zh": "我想一定是千里眼\n水晶球把这份心意\n照出来了哦。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "180/TALK",
            "narrator": "透明ガブリエラ",
            "text": "だとしても、たこ焼きを\nタコが笑顔で持ってる姿は\n想像してないわ。",
            "zh": "就算这样，章鱼\n笑眯眯举着章鱼烧的样子\n我也没想象过。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "182/TALK",
            "narrator": "透明ガブリエラ",
            "text": "これ、共食いでしょ？\n可愛い絵柄だけど\nかなりエグいわ…。",
            "zh": "这是同类相食吧？\n画风虽然可爱\n内容相当重口啊……。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "183/TALK",
            "narrator": "透明つばめ",
            "text": "あ、そっか。\nたこ焼きの中って、\nタコ入ってるもんね。",
            "zh": "啊，也对哦。\n章鱼烧里面，\n本来就有章鱼嘛。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "184/TALK",
            "narrator": "透明ガブリエラ",
            "text": "そういうこと…。\nそのなんとか水晶、\n壊れてるんじゃないの？",
            "zh": "原来是这样……。\n那个什么水晶，\n是不是坏掉了？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "186/TALK",
            "narrator": "透明神楽",
            "text": "でも、みやびさんのは\n大正解でしたよ？",
            "zh": "不过雅小姐的\n可是完全答对了哦？",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "188/TALK",
            "narrator": "透明神楽",
            "text": "エクセレントエレガンツ、\nって褒められましたし。",
            "zh": "“Excellent Elegance”，\n我可是被这么夸了哦。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "189/TALK",
            "narrator": "透明つばめ",
            "text": "…それって、\n褒め言葉なのかな？",
            "zh": "……那个，\n算是夸人的话吗？",
            "narrator_zh": "透明燕"
        },
        {
            "location": "190/TALK",
            "narrator": "透明ガブリエラ",
            "text": "みやびの考えてること\nなんて、水晶使わなくても\nわかるでしょ？",
            "zh": "雅在想什么，\n不用水晶也能\n知道吧？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "191/TALK",
            "narrator": "透明ガブリエラ",
            "text": "普段から煩悩駄々漏れ\nしてるんだし。",
            "zh": "毕竟她平时\n烦恼就漏得到处都是。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "192/TALK",
            "narrator": "透明ガブリエラ",
            "text": "っていうか、一枚目の\n絵を見た限りだと…。",
            "zh": "话说回来，光看\n第一幅画的话……。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "193/TALK",
            "narrator": "透明ガブリエラ",
            "text": "神楽の煩悩を\n映し出してるだけな\n気もするんだけど？",
            "zh": "总觉得只是照出了\n神乐自己的烦恼\n而已啊？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "194/TALK",
            "narrator": "透明神楽",
            "text": "そんなことないですよー。",
            "zh": "才没有那回事哟——",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "195/TALK",
            "narrator": "透明神楽",
            "text": "その証拠に、この絵の私は\nなにも思い浮かべて\nいないですし。",
            "zh": "证据就是，这幅画里的\n我什么都没有\n在想哦。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "197/TALK",
            "narrator": "透明つばめ",
            "text": "…真っ黒って、\nこれはこれでちょっと\n怖いような…。",
            "zh": "……漆黑一片，\n这反而有点\n吓人呀……。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "198/TALK",
            "narrator": "透明ガブリエラ",
            "text": "煩悩が強過ぎて\nなんとか水晶にも\n映らなかったとか？",
            "zh": "难不成是烦恼太强，\n连那个什么水晶\n都照不出来？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "199/TALK",
            "narrator": "透明神楽",
            "text": "もぅ、さっきから私が\n煩悩塗れみたいに\n言って、酷いですよ！",
            "zh": "真是的，从刚才起\n就一直把我说得\n满身烦恼，太过分了！",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "200/TALK",
            "narrator": "透明ガブリエラ",
            "text": "一枚目の絵を見たら、\n誰でもそう思うわよ…。",
            "zh": "看过第一幅画，\n谁都会这么想的……。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "202/TALK",
            "narrator": "透明ガブリエラ",
            "text": "でもまあ、全年齢版の\nこれなら文句はないわ。",
            "zh": "不过嘛，全年龄版的\n这幅倒是没得挑。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "203/TALK",
            "narrator": "透明ガブリエラ",
            "text": "…共食いはちょっと\n気になるけど。",
            "zh": "……不过同类相食\n还是有点在意啊。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "204/TALK",
            "narrator": "透明神楽",
            "text": "はぁ…千里眼水晶球、\nもう少し精度を上げる\n必要がありますね…。",
            "zh": "唉……看来千里眼水晶球\n还需要再提高一点\n精度呢……。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "206/TALK",
            "narrator": "透明ガブリエラ",
            "text": "はぁ…。",
            "zh": "唉……。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "208/TALK",
            "narrator": "ガブリエラ",
            "text": "神楽の厨二妄想だけど",
            "zh": "神乐的中二妄想",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "209/TALK",
            "narrator": "ガブリエラ",
            "text": "最近更に凄くなってる気がするわ",
            "zh": "总觉得最近又变本加厉了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "211/TALK",
            "narrator": "ガブリエラ",
            "text": "千里眼水晶球とか",
            "zh": "什么千里眼水晶球",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "212/TALK",
            "narrator": "ガブリエラ",
            "text": "そんな単語普通すぐ出てこないわよ",
            "zh": "这种词一般人可不会随口说出来哦",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "213/SEL",
            "narrator": "（選択肢）",
            "text": "ガブリエラは言わないの？",
            "zh": "加布里埃拉不说吗？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "214/SEL",
            "narrator": "（選択肢）",
            "text": "名前、覚えてるんだ？",
            "zh": "你还记得名字呀？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "215/SEL",
            "narrator": "（選択肢）",
            "text": "ちょっと尊敬するよね",
            "zh": "有点佩服呢",
            "narrator_zh": "（选项）"
        },
        {
            "location": "216/ACT",
            "narrator": "",
            "text": "ガブリエラは言わないの？",
            "zh": "加布里埃拉不说吗？",
            "narrator_zh": ""
        },
        {
            "location": "217/TALK",
            "narrator": "ガブリエラ",
            "text": "言わないわ",
            "zh": "我不说",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "218/TALK",
            "narrator": "ガブリエラ",
            "text": "だって",
            "zh": "因为",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "219/TALK",
            "narrator": "ガブリエラ",
            "text": "普通に恥ずかしいし",
            "zh": "那多丢人啊",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "220/TALK",
            "narrator": "ガブリエラ",
            "text": "でも",
            "zh": "不过",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "221/ACT",
            "narrator": "",
            "text": "名前、覚えてるんだ？",
            "zh": "你还记得名字呀？",
            "narrator_zh": ""
        },
        {
            "location": "222/TALK",
            "narrator": "ガブリエラ",
            "text": "最後ので覚えたわ",
            "zh": "最后那次记住了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "223/TALK",
            "narrator": "ガブリエラ",
            "text": "あれだけ何度も言われればね",
            "zh": "被念叨了那么多次也记住了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "224/TALK",
            "narrator": "ガブリエラ",
            "text": "それに",
            "zh": "再说",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "225/TALK",
            "narrator": "ガブリエラ",
            "text": "難しい単語の羅列でもないし",
            "zh": "也不是什么难词堆砌",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "226/TALK",
            "narrator": "ガブリエラ",
            "text": "でも",
            "zh": "不过",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "227/ACT",
            "narrator": "",
            "text": "ちょっと尊敬するよね",
            "zh": "有点佩服呢",
            "narrator_zh": ""
        },
        {
            "location": "228/TALK",
            "narrator": "ガブリエラ",
            "text": "認めたくないけど",
            "zh": "虽然不想承认",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "229/TALK",
            "narrator": "ガブリエラ",
            "text": "私も同感よ",
            "zh": "我也有同感哦",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "231/TALK",
            "narrator": "ガブリエラ",
            "text": "厨二妄想だとしても",
            "zh": "就算是中二妄想",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "232/TALK",
            "narrator": "ガブリエラ",
            "text": "それを堂々と言えるし",
            "zh": "也能堂堂正正说出口",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "233/TALK",
            "narrator": "ガブリエラ",
            "text": "絵っていう形にするんだもの",
            "zh": "还把它画成了画",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "234/TALK",
            "narrator": "ガブリエラ",
            "text": "その点に関しては",
            "zh": "在这一点上",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "236/TALK",
            "narrator": "ガブリエラ",
            "text": "素直にスゴイと思うわ",
            "zh": "我坦率觉得真厉害哦",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "237/SEL",
            "narrator": "（選択肢）",
            "text": "ガブリエラも練習しよう",
            "zh": "加布里埃拉也来练练吧",
            "narrator_zh": "（选项）"
        },
        {
            "location": "238/SEL",
            "narrator": "（選択肢）",
            "text": "ガブリエラはそうならないでね？",
            "zh": "加布里埃拉可别变成那样哦？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "239/ACT",
            "narrator": "",
            "text": "ガブリエラも練習しよう",
            "zh": "加布里埃拉也来练练吧",
            "narrator_zh": ""
        },
        {
            "location": "240/TALK",
            "narrator": "ガブリエラ",
            "text": "マルザンナが私に何を求めているのか",
            "zh": "玛尔赞娜到底想让我做什么",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "241/TALK",
            "narrator": "ガブリエラ",
            "text": "わからなくなってきたわ",
            "zh": "我已经搞不懂了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "243/TALK",
            "narrator": "ガブリエラ",
            "text": "私がそんなこと",
            "zh": "那种话",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "244/TALK",
            "narrator": "ガブリエラ",
            "text": "言うはずないでしょ？",
            "zh": "我才说不出口吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "245/SEL",
            "narrator": "（選択肢）",
            "text": "厨二ガブリエラ、見たかった",
            "zh": "想看中二加布里埃拉",
            "narrator_zh": "（选项）"
        },
        {
            "location": "246/SEL",
            "narrator": "（選択肢）",
            "text": "マルザンナって呼ぶのもどうかと…",
            "zh": "叫我玛尔赞娜也怪怪的……",
            "narrator_zh": "（选项）"
        },
        {
            "location": "247/ACT",
            "narrator": "",
            "text": "厨二ガブリエラ、見たかった",
            "zh": "想看中二加布里埃拉",
            "narrator_zh": ""
        },
        {
            "location": "248/TALK",
            "narrator": "ガブリエラ",
            "text": "見たいと思わないでちょうだい",
            "zh": "可别给我想看啊",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "249/TALK",
            "narrator": "ガブリエラ",
            "text": "そういうのが望みなら",
            "zh": "要是你想要那种东西",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "250/TALK",
            "narrator": "ガブリエラ",
            "text": "神楽と話しなさいよ",
            "zh": "就去找神乐聊去",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "251/ACT",
            "narrator": "",
            "text": "マルザンナって呼ぶのもどうかと…",
            "zh": "叫我玛尔赞娜也怪怪的……",
            "narrator_zh": ""
        },
        {
            "location": "252/TALK",
            "narrator": "ガブリエラ",
            "text": "まさか",
            "zh": "难道说",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "254/TALK",
            "narrator": "ガブリエラ",
            "text": "そんなことないわ",
            "zh": "才没有那回事",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "255/TALK",
            "narrator": "ガブリエラ",
            "text": "これは普通よ",
            "zh": "这很正常哦",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "256/TALK",
            "narrator": "ガブリエラ",
            "text": "素敵なニックネームだと思うし",
            "zh": "我觉得是个很棒的昵称",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "258/ACT",
