{
    "dir": "chap00/daydra/twev_ch04_000.js",
    "type": "",
    "info": {
        "story_id": "31100",
        "cid": "",
        "title": "Twitter Archive 000",
        "sub_title": "卯月画廊：おためし（白黒イラスト）",
        "title_zh": "推特 存档 000",
        "sub_title_zh": "卯月画廊：试看（黑白插画）"
    },
    "entry": [
        {
            "location": "25/TALK",
            "narrator": "透明みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "26/TALK",
            "narrator": "透明つばめ",
            "text": "あ、あの…どうして\n胸を揉んでるんですか？",
            "zh": "那、那个……你为什么\n在揉胸口呀？",
            "narrator_zh": "透明燕"
        },
        {
            "location": "27/TALK",
            "narrator": "透明みやび",
            "text": "うん…つばめちゃんは\n知っちょるか？",
            "zh": "嗯……燕，\n你晓得咩？",
            "narrator_zh": "透明雅"
        },
        {
            "location": "28/TALK",
            "narrator": "透明みやび",
            "text": "ここ３０年で雌象の\n９８％近くが牙を持たず\n生まれるようになった。",
            "zh": "这三十年里，母象\n有将近９８％生下来\n就不长牙了。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "29/TALK",
            "narrator": "透明みやび",
            "text": "その原因が、過酷な密漁\nから種を守るための\n進化らしいことを…。",
            "zh": "至于原因，据说是为了\n在严酷偷猎下保护种群\n而演化出来的……。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "30/TALK",
            "narrator": "透明つばめ",
            "text": "ごめんなさい。\nそれと胸に何の関係が\nあるんですか？",
            "zh": "对不起。\n那这跟胸有什么\n关系呀？",
            "narrator_zh": "透明燕"
        },
        {
            "location": "31/TALK",
            "narrator": "透明みやび",
            "text": "牙を持たぬうちの胸は、\nどうなのだろうか？",
            "zh": "不长牙的我的胸，\n究竟会怎么样呢？",
            "narrator_zh": "透明雅"
        },
        {
            "location": "32/TALK",
            "narrator": "透明みやび",
            "text": "進化論的に見た場合、\n胸の大きさはどちらへ\n向かってしまうのか。",
            "zh": "从进化论的角度看，\n胸的大小究竟会往\n哪个方向去呢。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "33/TALK",
            "narrator": "透明みやび",
            "text": "その謎が頭の中で\nグルグルしちゅうがよ。",
            "zh": "这个谜团在我脑子里\n咕噜咕噜转着咧。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "35/TALK",
            "narrator": "透明つばめ",
            "text": "え、えっと…。\nそうだ！",
            "zh": "诶、那个……。\n对了！",
            "narrator_zh": "透明燕"
        },
        {
            "location": "36/TALK",
            "narrator": "透明つばめ",
            "text": "$handle$さんなら、\n答えてくれるかも\nしれませんよ？",
            "zh": "$handle$的话，\n说不定能解答\n这个问题哟？",
            "narrator_zh": "透明燕"
        },
        {
            "location": "37/TALK",
            "narrator": "透明みやび",
            "text": "…そうやろか？\nまあ、面白そうやき、\n聞いてみるけんど…。",
            "zh": "……是咩？\n嘛，看着还算有趣啵，\n但是会去问问看……",
            "narrator_zh": "透明雅"
        },
        {
            "location": "39/TALK",
            "narrator": "みやび",
            "text": "進化論的に見た場合",
            "zh": "从进化论的角度看",
            "narrator_zh": "雅"
        },
        {
            "location": "40/TALK",
            "narrator": "みやび",
            "text": "胸の大きさはどちらへ向かうのだろうか？",
            "zh": "胸的大小究竟会往哪边去呢？",
            "narrator_zh": "雅"
        },
        {
            "location": "41/SEL",
            "narrator": "（選択肢）",
            "text": "わからないよ！",
            "zh": "我不知道啊！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "42/SEL",
            "narrator": "（選択肢）",
            "text": "大きい方",
            "zh": "大的那边",
            "narrator_zh": "（选项）"
        },
        {
            "location": "43/SEL",
            "narrator": "（選択肢）",
            "text": "小さい方",
            "zh": "小的那边",
            "narrator_zh": "（选项）"
        },
        {
            "location": "44/ACT",
            "narrator": "",
            "text": "わからないよ！",
            "zh": "我不知道啊！",
            "narrator_zh": ""
        },
        {
            "location": "45/TALK",
            "narrator": "みやび",
            "text": "簡単に諦めるとは情けない",
            "zh": "轻易就放弃，真不像话",
            "narrator_zh": "雅"
        },
        {
            "location": "46/ACT",
            "narrator": "",
            "text": "大きい方",
            "zh": "大的那边",
            "narrator_zh": ""
        },
        {
            "location": "47/TALK",
            "narrator": "みやび",
            "text": "なるほど",
            "zh": "原来如此",
            "narrator_zh": "雅"
        },
        {
            "location": "48/TALK",
            "narrator": "みやび",
            "text": "これが世に言う「おま中」というやつか",
            "zh": "这就是世间所说的「脑内限定」了啵[?]",
            "narrator_zh": "雅"
        },
        {
            "location": "49/ACT",
            "narrator": "",
            "text": "小さい方",
            "zh": "小的那边",
            "narrator_zh": ""
        },
        {
            "location": "50/TALK",
            "narrator": "みやび",
            "text": "ふむ",
            "zh": "唔",
            "narrator_zh": "雅"
        },
        {
            "location": "51/TALK",
            "narrator": "みやび",
            "text": "うちとしては生存の危機とも言える状態",
            "zh": "对我而言，这可是称得上生存危机的状态",
            "narrator_zh": "雅"
        },
        {
            "location": "52/TALK",
            "narrator": "みやび",
            "text": "まもって！$handle$！",
            "zh": "快保护我！$handle$！",
            "narrator_zh": "雅"
        },
        {
            "location": "54/TALK",
            "narrator": "みやび",
            "text": "まあ",
            "zh": "嘛",
            "narrator_zh": "雅"
        },
        {
            "location": "55/TALK",
            "narrator": "みやび",
            "text": "巨乳に需要があれば巨乳が増え",
            "zh": "巨乳有需求，巨乳就会增多",
            "narrator_zh": "雅"
        },
        {
            "location": "56/TALK",
            "narrator": "みやび",
            "text": "貧乳に需要があれば貧乳が増える",
            "zh": "贫乳有需求，贫乳就会增多",
            "narrator_zh": "雅"
        },
        {
            "location": "57/TALK",
            "narrator": "みやび",
            "text": "ということなのだろう",
            "zh": "应该就是这么回事吧",
            "narrator_zh": "雅"
        },
        {
            "location": "58/TALK",
            "narrator": "みやび",
            "text": "うちはそう思うのだが",
            "zh": "我是这么想的，不过",
            "narrator_zh": "雅"
        },
        {
            "location": "59/SEL",
            "narrator": "（選択肢）",
            "text": "大きい方が需要あるんじゃない？",
            "zh": "不是大的更有需求吗？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "60/SEL",
            "narrator": "（選択肢）",
            "text": "小さい方が需要あるでしょ",
            "zh": "明明小的更有需求吧",
            "narrator_zh": "（选项）"
        },
        {
            "location": "61/ACT",
            "narrator": "",
            "text": "大きい方が需要あるんじゃない？",
            "zh": "不是大的更有需求吗？",
            "narrator_zh": ""
        },
        {
            "location": "62/TALK",
            "narrator": "みやび",
            "text": "牙があれば",
            "zh": "要是长着牙",
            "narrator_zh": "雅"
        },
        {
            "location": "63/TALK",
            "narrator": "みやび",
            "text": "うちは密漁されていた",
            "zh": "我早就被偷猎了",
            "narrator_zh": "雅"
        },
        {
            "location": "64/TALK",
            "narrator": "みやび",
            "text": "牙がないことを感謝",
            "zh": "感谢自己没长牙",
            "narrator_zh": "雅"
        },
        {
            "location": "65/TALK",
            "narrator": "みやび",
            "text": "大きくて重いことに",
            "zh": "但对这又大又重的胸",
            "narrator_zh": "雅"
        },
        {
            "location": "66/TALK",
            "narrator": "みやび",
            "text": "恨み",
            "zh": "心怀怨恨",
            "narrator_zh": "雅"
        },
        {
            "location": "67/ACT",
            "narrator": "",
            "text": "小さいのに決まってる",
            "zh": "肯定是小的啦",
            "narrator_zh": ""
        },
        {
            "location": "68/TALK",
            "narrator": "みやび",
            "text": "それは素晴らしい",
            "zh": "那可太好了",
            "narrator_zh": "雅"
        },
        {
            "location": "70/TALK",
            "narrator": "みやび",
            "text": "需要無き巨乳は",
            "zh": "没有需求的巨乳",
            "narrator_zh": "雅"
        },
        {
            "location": "71/TALK",
            "narrator": "みやび",
            "text": "いずれ地上から",
            "zh": "迟早会被从地面上",
            "narrator_zh": "雅"
        },
        {
            "location": "72/TALK",
            "narrator": "みやび",
            "text": "排斥されることになるだろう",
            "zh": "排斥出去的吧",
            "narrator_zh": "雅"
        },
        {
            "location": "73/TALK",
            "narrator": "みやび",
            "text": "まあ",
            "zh": "嘛",
            "narrator_zh": "雅"
        },
        {
            "location": "74/TALK",
            "narrator": "みやび",
            "text": "うちの胸の大きさが",
            "zh": "不过我的胸的大小",
            "narrator_zh": "雅"
        },
        {
            "location": "75/TALK",
            "narrator": "みやび",
            "text": "変わることはないのだが",
            "zh": "是不会变的啵",
            "narrator_zh": "雅"
        },
        {
            "location": "77/TALK",
            "narrator": "みやび",
            "text": "とりあえず",
            "zh": "总之",
            "narrator_zh": "雅"
        },
        {
            "location": "78/TALK",
            "narrator": "みやび",
            "text": "そろそろ揉むのはやめよう",
            "zh": "差不多该停止揉了",
            "narrator_zh": "雅"
        },
        {
            "location": "79/TALK",
            "narrator": "みやび",
            "text": "チラ見されて気分悪い",
            "zh": "被人偷瞄，心情很差",
            "narrator_zh": "雅"
        },
        {
            "location": "82/SEL",
            "narrator": "（選択肢）",
            "text": "そりゃ見られるよ",
            "zh": "那当然会被看到啊",
            "narrator_zh": "（选项）"
        },
        {
            "location": "83/SEL",
            "narrator": "（選択肢）",
            "text": "男の人に見せないでね",
            "zh": "不要给男人看哦",
            "narrator_zh": "（选项）"
        },
        {
            "location": "84/ACT",
            "narrator": "",
            "text": "そりゃ見られるよ",
            "zh": "那当然会被看到啊",
            "narrator_zh": ""
        },
        {
            "location": "85/TALK",
            "narrator": "みやび",
            "text": "そんなに珍しいか？",
            "zh": "有那么稀奇咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "86/TALK",
            "narrator": "みやび",
            "text": "胸なんぞ",
            "zh": "胸部什么的",
            "narrator_zh": "雅"
        },
        {
            "location": "87/TALK",
            "narrator": "みやび",
            "text": "誰しも持ってるだろうに",
            "zh": "谁都有吧",
            "narrator_zh": "雅"
        },
        {
            "location": "88/TALK",
            "narrator": "みやび",
            "text": "相棒にもあるだろう？",
            "zh": "搭档也有吧？",
            "narrator_zh": "雅"
        },
        {
            "location": "89/ACT",
            "narrator": "",
            "text": "男の人に見せないでね",
            "zh": "不要给男人看哦",
            "narrator_zh": ""
        },
        {
            "location": "90/TALK",
            "narrator": "みやび",
            "text": "嫉妬か？",
            "zh": "是嫉妒咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "91/TALK",
            "narrator": "みやび",
            "text": "独占欲か？",
            "zh": "是独占欲咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "92/TALK",
            "narrator": "みやび",
            "text": "まあ",
            "zh": "嘛",
            "narrator_zh": "雅"
        },
        {
            "location": "93/TALK",
            "narrator": "みやび",
            "text": "相棒が嫌というなら",
            "zh": "要是搭档你不乐意",
            "narrator_zh": "雅"
        },
        {
            "location": "94/TALK",
            "narrator": "みやび",
            "text": "外でするのはやめよう",
            "zh": "在外面就不做了",
            "narrator_zh": "雅"
        },
        {
            "location": "98/TALK",
            "narrator": "みやび",
            "text": "しかし",
            "zh": "但是",
            "narrator_zh": "雅"
        },
        {
            "location": "99/TALK",
            "narrator": "みやび",
            "text": "何故進化論の話が",
            "zh": "为什么进化论的话题",
            "narrator_zh": "雅"
        },
        {
            "location": "100/TALK",
            "narrator": "みやび",
            "text": "胸になったのだろう？",
            "zh": "最后会拐到胸上去呢？",
            "narrator_zh": "雅"
        },
        {
            "location": "101/TALK",
            "narrator": "みやび",
            "text": "うちの思考回路は",
            "zh": "我的思考回路",
            "narrator_zh": "雅"
        },
        {
            "location": "102/TALK",
            "narrator": "みやび",
            "text": "謎に包まれている",
            "zh": "被谜团笼罩着",
            "narrator_zh": "雅"
        },
        {
            "location": "103/SEL",
            "narrator": "（選択肢）",
            "text": "話に付き合うの大変だよ",
            "zh": "陪你聊这些真够累的",
            "narrator_zh": "（选项）"
        },
        {
            "location": "104/SEL",
            "narrator": "（選択肢）",
            "text": "そこがみやびの楽しいところ",
            "zh": "那正是雅有趣的地方",
            "narrator_zh": "（选项）"
        },
        {
            "location": "105/ACT",
            "narrator": "",
            "text": "話に付き合うの大変だよ",
            "zh": "陪你聊这些真够累的",
            "narrator_zh": ""
        },
        {
            "location": "106/TALK",
            "narrator": "みやび",
            "text": "それは",
            "zh": "那还真是",
            "narrator_zh": "雅"
        },
        {
            "location": "108/TALK",
            "narrator": "みやび",
            "text": "申し訳ないことをした",
            "zh": "对不住你了",
            "narrator_zh": "雅"
        },
        {
            "location": "109/TALK",
            "narrator": "みやび",
            "text": "じゃあ今日は",
            "zh": "那今天",
            "narrator_zh": "雅"
        },
        {
            "location": "110/TALK",
            "narrator": "みやび",
            "text": "もうやめておこう",
            "zh": "就到此为止吧",
            "narrator_zh": "雅"
        },
        {
            "location": "111/ACT",
            "narrator": "",
            "text": "そこがみやびの楽しいところ",
            "zh": "那正是雅有趣的地方",
            "narrator_zh": ""
        },
        {
            "location": "112/TALK",
            "narrator": "みやび",
            "text": "それはありがたい",
            "zh": "那可帮大忙了",
            "narrator_zh": "雅"
        },
        {
            "location": "113/TALK",
            "narrator": "みやび",
            "text": "気兼ねなく",
            "zh": "不必顾虑",
            "narrator_zh": "雅"
        },
        {
            "location": "114/TALK",
            "narrator": "みやび",
            "text": "突拍子のないことを",
            "zh": "把天马行空的怪话",
            "narrator_zh": "雅"
        },
        {
            "location": "115/TALK",
            "narrator": "みやび",
            "text": "突然言う許可ゲット",
            "zh": "突然说出口的许可 get",
            "narrator_zh": "雅"
        },
        {
            "location": "116/TALK",
            "narrator": "みやび",
            "text": "前言撤回は受け付けん",
            "zh": "概不接受收回前言",
            "narrator_zh": "雅"
        },
        {
            "location": "118/TALK",
            "narrator": "みやび",
            "text": "ではまた",
            "zh": "那么再见",
            "narrator_zh": "雅"
        },
        {
            "location": "120/TALK",
            "narrator": "みやび",
            "text": "新たな謎が見つかる日に",
            "zh": "等找到新谜团的那天",
            "narrator_zh": "雅"
        },
        {
            "location": "121/TALK",
            "narrator": "みやび",
            "text": "もしくは",
            "zh": "或者",
            "narrator_zh": "雅"
        },
        {
            "location": "122/TALK",
            "narrator": "みやび",
            "text": "暇な時に",
            "zh": "闲下来的时候",
            "narrator_zh": "雅"
        },
        {
            "location": "128/DIALOG",
            "narrator": "",
            "text": "このシナリオの元になっている\nTwitterの会話ログを見ますか？",
            "zh": "要查看这个剧本\n取材的Twitter对话日志吗？",
            "narrator_zh": ""
        }
    ]
}
