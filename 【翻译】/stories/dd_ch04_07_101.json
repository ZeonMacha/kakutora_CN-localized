{
    "dir": "chap07/daydra/dd_ch04_07_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "7402",
        "cid": "miyabi",
        "title": "002 メインストーリー",
        "sub_title": "劇場の日常＜前編＞",
        "title_zh": "002 主线剧情",
        "sub_title_zh": "剧场的日常＜前篇＞"
    },
    "entry": [
        {
            "location": "8/SCENARIO",
            "narrator": "",
            "text": "劇場の日常",
            "zh": "剧场的日常",
            "narrator_zh": ""
        },
        {
            "location": "43/TALK",
            "narrator": "真幌",
            "text": "よし、開館時間だ。\n今日もよろしく\n頼むぞ。",
            "zh": "好，到开馆时间了。\n今天也拜托\n各位了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "45/TALK",
            "narrator": "つばめ",
            "text": "わかりました！",
            "zh": "知道了！",
            "narrator_zh": "燕"
        },
        {
            "location": "48/TALK",
            "narrator": "つばめ",
            "text": "よーし、お掃除\n頑張るぞー！",
            "zh": "好——打扫卫生\n加油啦——！",
            "narrator_zh": "燕"
        },
        {
            "location": "51/TALK",
            "narrator": "ガブリエラ",
            "text": "暑苦しいわね。\n何気合い入れてるん\nだか…。",
            "zh": "热得让人发闷呢。\n也不知道是在\n较什么劲……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "53/TALK",
            "narrator": "アーヤ",
            "text": "真剣な証拠でしょ？\nいいことじゃない。",
            "zh": "这说明她认真吧？\n是好事哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "54/TALK",
            "narrator": "つばめ",
            "text": "えへへ…。\nお掃除は、昔から\n結構好きなんです。",
            "zh": "诶嘿嘿……。\n打扫这种事，我从\n以前就挺喜欢的。",
            "narrator_zh": "燕"
        },
        {
            "location": "56/TALK",
            "narrator": "真幌",
            "text": "ほう、掃除好きとは\n珍しいな？",
            "zh": "哦，喜欢打扫\n倒是少见啊？",
            "narrator_zh": "真幌"
        },
        {
            "location": "58/TALK",
            "narrator": "つばめ",
            "text": "お掃除だけは、\n昔から褒められて\nたんです。",
            "zh": "唯独打扫，\n我从以前就一直\n被夸呢。",
            "narrator_zh": "燕"
        },
        {
            "location": "60/TALK",
            "narrator": "ガブリエラ",
            "text": "ふーん。",
            "zh": "哦——。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "62/TALK",
            "narrator": "ガブリエラ",
            "text": "じゃあ、掃除担当は\nこれからもあんたで\n決まりね。",
            "zh": "那打扫担当，\n以后也照样\n定成你了哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "65/TALK",
            "narrator": "つばめ",
            "text": "えぇっ！？",
            "zh": "诶！？",
            "narrator_zh": "燕"
        },
        {
            "location": "66/TALK",
            "narrator": "ガブリエラ",
            "text": "掃除好きなんだから、\n文句ないでしょ？",
            "zh": "既然喜欢打扫，\n没意见吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "67/TALK",
            "narrator": "ガブリエラ",
            "text": "それともあんたが\n映写機まわしたりとか\nするわけ？",
            "zh": "还是说，换你来\n转放映机之类的\n不成？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "69/TALK",
            "narrator": "つばめ",
            "text": "む、無理ですよぉ…。",
            "zh": "不、不行的啦……。",
            "narrator_zh": "燕"
        },
        {
            "location": "70/TALK",
            "narrator": "つばめ",
            "text": "っていうか、\nせんぱいはそういうの\nするんですか？",
            "zh": "话说回来，\n前辈你会去\n干那种活吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "73/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしは売店担当よ。\n映写室関係はアーヤの\n仕事だし。",
            "zh": "我是小卖部担当。\n放映室的活是绫水\n管的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "75/TALK",
            "narrator": "つばめ",
            "text": "みやびさんは\n何の担当なんですか？",
            "zh": "那雅是\n负责什么的？",
            "narrator_zh": "燕"
        },
        {
            "location": "78/TALK",
            "narrator": "みやび",
            "text": "まほさんが趣味で\n集めたフィルムの\n情報を――",
            "zh": "把真幌当兴趣\n收集来的胶片\n信息——",
            "narrator_zh": "雅"
        },
        {
            "location": "79/TALK",
            "narrator": "みやび",
            "text": "どんどんＰＣに\n打ち込んでいく\n作業や。",
            "zh": "一个劲往ＰＣ里\n录进去的\n活计咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "81/TALK",
            "narrator": "つばめ",
            "text": "えっと…真幌さんの\n趣味手伝い担当、って\nことですか？",
            "zh": "呃……就是负责\n帮真幌打理兴趣的\n担当吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "84/TALK",
            "narrator": "真幌",
            "text": "趣味とか言うな。\nちゃんと劇場で流す\nフィルムだぞ？",
            "zh": "别说什么兴趣。\n这可是正经要在\n剧场放的胶片啊？",
            "narrator_zh": "真幌"
        },
        {
            "location": "87/TALK",
            "narrator": "みやび",
            "text": "まあ、ＰＣ弄る作業\n担当、ってことやね。",
            "zh": "嘛，就是负责\n摆弄ＰＣ的活咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "89/TALK",
            "narrator": "みやび",
            "text": "言っとくけんど、\n掃除担当とチェンジ\nする気はないぞね？",
            "zh": "但是先说好，\n换去当打扫担当\n我可没兴趣咧？",
            "narrator_zh": "雅"
        },
        {
            "location": "91/TALK",
            "narrator": "つばめ",
            "text": "うーん…わたし、\nやっぱり掃除担当で\nいいです。",
            "zh": "唔……我，\n还是当打扫担当\n就好。",
            "narrator_zh": "燕"
        },
        {
            "location": "93/TALK",
            "narrator": "つばめ",
            "text": "機械に触るのも、\nお客さんと喋ったり\nするより――",
            "zh": "碰机器什么的，\n比起跟客人\n搭话——",
            "narrator_zh": "燕"
        },
        {
            "location": "94/TALK",
            "narrator": "つばめ",
            "text": "お掃除してる方が\n性に合ってる気が\nしますし…。",
            "zh": "还是打扫卫生\n更合我性子\n感觉……。",
            "narrator_zh": "燕"
        },
        {
            "location": "95/TALK",
            "narrator": "みやび",
            "text": "…機械関係の作業を\nいきなりするんは\nムリやろうけんど――",
            "zh": "……机器相关的活\n要她一下子就上手\n是不可能，但是——",
            "narrator_zh": "雅"
        },
        {
            "location": "98/TALK",
            "narrator": "みやび",
            "text": "客相手より掃除を\n選ぶなんて…、\nコミュ障の気あり？",
            "zh": "比起应付客人\n还选打扫……，\n是有社恐的意思？",
            "narrator_zh": "雅"
        },
        {
            "location": "101/TALK",
            "narrator": "つばめ",
            "text": "う、うーん…、\nどんなんでしょう？",
            "zh": "这、这个嘛……，\n算哪种呢？",
            "narrator_zh": "燕"
        },
        {
            "location": "102/TALK",
            "narrator": "つばめ",
            "text": "でも、知らない人と\n話すのって、ちょっと\n苦手だから――",
            "zh": "但是，跟陌生人\n说话这件事，我\n有点不擅长——",
            "narrator_zh": "燕"
        },
        {
            "location": "105/TALK",
            "narrator": "つばめ",
            "text": "やっぱり、わたしって\nコミュ障なのかも…。",
            "zh": "果然，我这家伙\n可能就是个社恐……。",
            "narrator_zh": "燕"
        },
        {
            "location": "108/TALK",
            "narrator": "アーヤ",
            "text": "そんなことないって。\n誰でも、大なり小なり\n緊張するものだから。",
            "zh": "才没有那回事。\n谁都会或多或少\n紧张的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "110/TALK",
            "narrator": "アーヤ",
            "text": "さ、それじゃみんな、\n今日も頑張りましょ。",
            "zh": "来，那么大家，\n今天也加油吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "112/TALK",
            "narrator": "ガブリエラ",
            "text": "はいはい…。\n面倒くさいけどね。",
            "zh": "是是……。\n虽然麻烦得很呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "116/TALK",
            "narrator": "みやび",
            "text": "はぁ…お仕事開始や。",
            "zh": "唉……开工咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "142/TALK",
            "narrator": "みやび",
            "text": "…まあ、こんな作業、\n三十分もあれば\n余裕で終わるき――",
            "zh": "……嘛，这种活计，\n三十分钟就\n绰绰有余干完啵——",
            "narrator_zh": "雅"
        },
        {
            "location": "143/TALK",
            "narrator": "みやび",
            "text": "ウサギとチャット\nしちょる時間の方が\n多いんやが…。",
            "zh": "可跟兔子聊天\n占掉的时间\n反倒更多嘛……。",
            "narrator_zh": "雅"
        },
        {
            "location": "147/TALK",
            "narrator": "みやび",
            "text": "…ふむ、そうかぁ。\nやはり上手くいっちょ\nらんか…。",
            "zh": "……嗯，这样啊。\n果然还是\n搞不定嘛……。",
            "narrator_zh": "雅"
        },
        {
            "location": "148/TALK",
            "narrator": "みやび",
            "text": "攻め方を変えてみる\nゆうんはどうか？",
            "zh": "要不试试\n换个打法咧？",
            "narrator_zh": "雅"
        },
        {
            "location": "152/TALK",
            "narrator": "みやび",
            "text": "…難しそう、か。",
            "zh": "……好像很难，啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "153/TALK",
            "narrator": "みやび",
            "text": "まあ、もうしばらく\n様子見しながら――",
            "zh": "嘛，那就再观察\n一阵子——",
            "narrator_zh": "雅"
        },
        {
            "location": "154/TALK",
            "narrator": "みやび",
            "text": "ちくちく攻めてくしか\nなさそうやな。",
            "zh": "看来只能一点一点\n扎着往里攻了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "158/TALK",
            "narrator": "みやび",
            "text": "…そういえば、\nつばめちゃん――",
            "zh": "……说起来，\n燕——",
            "narrator_zh": "雅"
        },
        {
            "location": "159/TALK",
            "narrator": "みやび",
            "text": "知らん人と話すんが\n苦手言うてたな。",
            "zh": "她说过自己\n不擅长跟陌生人说话来着。",
            "narrator_zh": "雅"
        },
        {
            "location": "160/TALK",
            "narrator": "みやび",
            "text": "まあ、人付き合いが\n上手そうな子では\nないけんど――",
            "zh": "嘛，虽然她也不像\n很会待人接物的\n孩子，但是——",
            "narrator_zh": "雅"
        },
        {
            "location": "161/TALK",
            "narrator": "みやび",
            "text": "とりあえず、これで\nまた一つ情報が増えた\nのは確かやな。",
            "zh": "总之，情报又\n多了一条，这是\n确实的咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "162/TALK",
            "narrator": "みやび",
            "text": "つばめちゃんは、\n色々と謎多き\n乙女やき――",
            "zh": "燕这个孩子，\n是个谜团一堆的\n少女嘛——",
            "narrator_zh": "雅"
        },
        {
            "location": "163/TALK",
            "narrator": "みやび",
            "text": "小さい情報でも、\n今はありがたく思うて\nおかんと…。",
            "zh": "再小的情报，\n现在也得心怀感激\n收下才行……。",
            "narrator_zh": "雅"
        },
        {
            "location": "167/TALK",
            "narrator": "みやび",
            "text": "…ちゅうか、よくよく\n考えると、新人さんの\nことだけやなくて――",
            "zh": "……说起来，好好\n想一想的话，不光是\n新人的事——",
            "narrator_zh": "雅"
        },
        {
            "location": "168/TALK",
            "narrator": "みやび",
            "text": "アーヤ達のことも、\nそんなに知っちょる\nわけやないか…。",
            "zh": "绫水她们的事，\n我也没了解得\n多深嘛……。",
            "narrator_zh": "雅"
        },
        {
            "location": "173/TALK",
            "narrator": "みやび",
            "text": "…管理庁のＰＣから、\n情報引っこ抜くか。",
            "zh": "……从管理厅的ＰＣ里，\n抽点情报出来……咩……。",
            "narrator_zh": "雅"
        },
        {
            "location": "174/TALK",
            "narrator": "みやび",
            "text": "それなら、\nつばめちゃんの\n情報を――",
            "zh": "那样的话，\n燕的情报\n也能——",
            "narrator_zh": "雅"
        },
        {
            "location": "175/TALK",
            "narrator": "みやび",
            "text": "手に入れる片手間に\nやれそうやし。",
            "zh": "反正顺手\n就能搞定的咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "177/TALK",
            "narrator": "みやび",
            "text": "ふむ…どうしたもん\nかなぁ？",
            "zh": "唔……到底要\n怎么搞才好咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "221/TALK",
            "narrator": "みやび",
            "text": "……　…",
            "zh": "……　…",
            "narrator_zh": "雅"
        },
        {
            "location": "235/TALK",
            "narrator": "みやび",
            "text": "ふわあっ！",
            "zh": "哇啊！",
            "narrator_zh": "雅"
        },
        {
            "location": "239/TALK",
            "narrator": "みやび",
            "text": "ひやぁぁっ！",
            "zh": "呀啊啊！",
            "narrator_zh": "雅"
        },
        {
            "location": "243/TALK",
            "narrator": "みやび",
            "text": "ふごあぁぁっ！",
            "zh": "呜咕啊啊啊！",
            "narrator_zh": "雅"
        },
        {
            "location": "250/TALK",
            "narrator": "みやび",
            "text": "キマシタワー！",
            "zh": "实装了！",
            "narrator_zh": "雅"
        },
        {
            "location": "251/SEL",
            "narrator": "",
            "text": "え…ええ？",
            "zh": "诶……诶？",
            "narrator_zh": ""
        },
        {
            "location": "252/ACT",
            "narrator": "",
            "text": "え…ええ？",
            "zh": "诶……诶？",
            "narrator_zh": ""
        },
        {
            "location": "256/TALK",
            "narrator": "みやび",
            "text": "最近うち、お前さんに\nたたき起こされる刺激に\nドキドキする17歳。",
            "zh": "最近的我，是个被\n你敲醒的刺激弄得\n心跳加速的17岁。",
            "narrator_zh": "雅"
        },
        {
            "location": "257/TALK",
            "narrator": "みやび",
            "text": "こんな身体にして\nくれちゃって、どう\n責任とってくれるのっ？",
            "zh": "把我弄成这副\n身子，你打算\n怎么负责呀？",
            "narrator_zh": "雅"
        },
        {
            "location": "258/SEL",
            "narrator": "",
            "text": "え、ええと…",
            "zh": "那、那个……",
            "narrator_zh": ""
        },
        {
            "location": "259/SEL",
            "narrator": "",
            "text": "一生添い遂げます！",
            "zh": "我会跟你一生一世！",
            "narrator_zh": ""
        },
        {
            "location": "260/ACT",
            "narrator": "",
            "text": "え、ええと…",
            "zh": "那、那个……",
            "narrator_zh": ""
        },
        {
            "location": "261/TALK",
            "narrator": "みやび",
            "text": "――っと、\nお遊びは終了。",
            "zh": "——好，\n玩闹到此为止。",
            "narrator_zh": "雅"
        },
        {
            "location": "262/TALK",
            "narrator": "みやび",
            "text": "えい暇つぶしになった。",
            "zh": "得，刚好拿来打发时间了。",
            "narrator_zh": "雅"
        },
        {
            "location": "263/ACT",
            "narrator": "",
            "text": "一生添い遂げます！",
            "zh": "我会跟你一生一世！",
            "narrator_zh": ""
        },
        {
            "location": "264/TALK",
            "narrator": "みやび",
            "text": "――っと、\nお遊びは終了。",
            "zh": "——好，\n玩闹到此为止。",
            "narrator_zh": "雅"
        },
        {
            "location": "265/TALK",
            "narrator": "みやび",
            "text": "えい暇つぶしになった。",
            "zh": "得，刚好拿来打发时间了。",
            "narrator_zh": "雅"
        },
        {
            "location": "266/SEL",
            "narrator": "",
            "text": "いや、一生添い遂げたいんですけど",
            "zh": "不是，我就是想跟你一生一世来着",
            "narrator_zh": ""
        },
        {
            "location": "267/ACT",
            "narrator": "",
            "text": "いや、一生添い遂げたいんですけど",
            "zh": "不是，我就是想跟你一生一世来着",
            "narrator_zh": ""
        },
        {
            "location": "270/TALK",
            "narrator": "みやび",
            "text": "ふむ。\nやき、それは現実の\nうちに言いや。",
            "zh": "唔。\n所以嘛，那种话\n跟现实里的我去说啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "271/TALK",
            "narrator": "みやび",
            "text": "まあ、即日切断\nやろうけんどな。",
            "zh": "嘛，虽然多半当场\n就会被切断就是了。",
            "narrator_zh": "雅"
        },
        {
            "location": "274/TALK",
            "narrator": "みやび",
            "text": "はぁ、\nほんだら仕事しますか。",
            "zh": "唉，\n那就开工啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "279/TALK",
            "narrator": "みやび",
            "text": "オープンプロセス、\n0x498番地から\n0x3BC番地へ。",
            "zh": "开放进程，\n从0x498地址\n到0x3BC地址。",
            "narrator_zh": "雅"
        },
        {
            "location": "294/TALK",
            "narrator": "みやび",
            "text": "完了。",
            "zh": "完成。",
            "narrator_zh": "雅"
        },
        {
            "location": "296/TALK",
            "narrator": "みやび",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "雅"
        },
        {
            "location": "298/TALK",
            "narrator": "みやび",
            "text": "………。",
            "zh": "………。",
            "narrator_zh": "雅"
        },
        {
            "location": "299/TALK",
            "narrator": "みやび",
            "text": "うーむ。\n今回のは割と\nガチ目やね。",
            "zh": "唔姆。\n这次这个，算是\n来真的咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "300/TALK",
            "narrator": "みやび",
            "text": "ココロファイルナンバー\n04-991-03によると――",
            "zh": "按心之档案编号\n04-991-03来说——",
            "narrator_zh": "雅"
        },
        {
            "location": "301/TALK",
            "narrator": "みやび",
            "text": "うちはトライナリーの\n中で、かなり孤立\nしちゅうと思っちゅう。",
            "zh": "我啊，觉得自己\n在三重奏里相当\n孤立着滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "302/TALK",
            "narrator": "みやび",
            "text": "自分だけが現実に対し\n正確に警戒し、具体的な\n行動に出ている。",
            "zh": "唯独自己一个人，\n对现实警戒得准确，\n还采取了具体行动。",
            "narrator_zh": "雅"
        },
        {
            "location": "303/TALK",
            "narrator": "みやび",
            "text": "けんどまた、それが\n半端ない孤独感の原因に\nなっちゅうのも事実。",
            "zh": "但是同时，它也是那\n不得了的孤独感\n的成因，这是事实。",
            "narrator_zh": "雅"
        },
        {
            "location": "304/TALK",
            "narrator": "みやび",
            "text": "まあ、誰一人信用する\nつもりはないき、\n仕方ないことやけんど。",
            "zh": "嘛，反正谁都不打算信，\n没办法的事\n就是了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "305/SEL",
            "narrator": "",
            "text": "トライナリーのメンバーは全員だめなの？",
            "zh": "三重奏的成员全都不行吗？",
            "narrator_zh": ""
        },
        {
            "location": "306/ACT",
            "narrator": "",
            "text": "トライナリーのメンバーは全員だめなの？",
            "zh": "三重奏的成员全都不行吗？",
            "narrator_zh": ""
        },
        {
            "location": "308/TALK",
            "narrator": "みやび",
            "text": "そもそも管理庁を\n疑ってる時点で、\nダメっちゃダメやね。",
            "zh": "本来嘛，光是在怀疑\n管理厅的时候，\n就不行滴不行咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "309/TALK",
            "narrator": "みやび",
            "text": "割とハマリモード。",
            "zh": "挺钻牛角尖的模式。",
            "narrator_zh": "雅"
        },
        {
            "location": "310/TALK",
            "narrator": "みやび",
            "text": "……まあしかし。",
            "zh": "……嘛，不过呢。",
            "narrator_zh": "雅"
        },
        {
            "location": "312/TALK",
            "narrator": "みやび",
            "text": "今回のうちにとって、\n１つだけ解決策があると\nするならば、それは――",
            "zh": "对这次的我来说，\n如果只有一个解决办法，\n那便是——",
            "narrator_zh": "雅"
        },
        {
            "location": "313/TALK",
            "narrator": "みやび",
            "text": "お前さんの存在やね。",
            "zh": "就是你的存在咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "314/SEL",
            "narrator": "",
            "text": "$me$？",
            "zh": "$me$？",
            "narrator_zh": ""
        },
        {
            "location": "317/TALK",
            "narrator": "みやび",
            "text": "うむ。",
            "zh": "嗯。",
            "narrator_zh": "雅"
        },
        {
            "location": "318/TALK",
            "narrator": "みやび",
            "text": "もちろんお前さんも\n管理庁の手先かもしれん\n以上、一緒やけんど。",
            "zh": "当然，你也可能是\n管理厅的手下，\n这点上是一样的，但是。",
            "narrator_zh": "雅"
        },
        {
            "location": "319/TALK",
            "narrator": "みやび",
            "text": "しかしトライナリーでは\nないが故に、彼女たち\nとは少し視点が違う。",
            "zh": "不过，正因为\n不是三重奏的成员，\n跟她们视角稍有不同。",
            "narrator_zh": "雅"
        },
        {
            "location": "320/TALK",
            "narrator": "みやび",
            "text": "こと、今回の様にトライ\nナリーに対する案件には\n協力者として参加できる。",
            "zh": "也就是说，像这次\n针对三重奏的案件，\n你就能以协助者身份参加。",
            "narrator_zh": "雅"
        },
        {
            "location": "321/SEL",
            "narrator": "",
            "text": "そういうものなの？",
            "zh": "是这样规定的吗？",
            "narrator_zh": ""
        },
        {
            "location": "322/ACT",
            "narrator": "",
            "text": "そういうものなの？",
            "zh": "是这样规定的吗？",
            "narrator_zh": ""
        },
        {
            "location": "324/TALK",
            "narrator": "みやび",
            "text": "そういうもんちや。",
            "zh": "就是这么回事滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "326/TALK",
            "narrator": "みやび",
            "text": "もっと端的に\n分かりやすく\n言っちゃろか？",
            "zh": "要不要我\n说得再简短\n易懂一点咧？",
            "narrator_zh": "雅"
        },
        {
            "location": "327/TALK",
            "narrator": "みやび",
            "text": "うちは単に、トライナリー\nについて対等に邪推できる\n茶飲み友達が欲しいんよ。",
            "zh": "我只不过是想要\n一个能对三重奏平等瞎猜的\n喝茶闲聊伙伴咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "328/SEL",
            "narrator": "",
            "text": "マジで？$me$も疑われてるのに？",
            "zh": "真的吗？$me$不也被怀疑着吗？",
            "narrator_zh": ""
        },
        {
            "location": "329/ACT",
            "narrator": "",
            "text": "マジで？$me$も疑われてるのに？",
            "zh": "真的吗？$me$不也被怀疑着吗？",
            "narrator_zh": ""
        },
        {
            "location": "331/TALK",
            "narrator": "みやび",
            "text": "それはそれ。\nこれはこれ。",
            "zh": "那是那回事。\n这是这回事。",
            "narrator_zh": "雅"
        },
        {
            "location": "332/TALK",
            "narrator": "みやび",
            "text": "もちろん、お前さんが\nターゲットになったら\n逆に排斥されるよ。",
            "zh": "当然，你要是\n成了目标，反而会\n被排斥出去哦。",
            "narrator_zh": "雅"
        },
        {
            "location": "333/TALK",
            "narrator": "みやび",
            "text": "乙女心っちゅうんは、\nワガママで理不尽で、\n自己中心的なものなんよ。",
            "zh": "所谓少女心嘛，\n就是任性、不讲理、\n自我中心的东西咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "334/TALK",
            "narrator": "みやび",
            "text": "まあこんな感じで、\n深くなればなるほど\n内容は無茶になってく。",
            "zh": "嘛，就是这样，\n关系越深，\n要求就变得越离谱。",
            "narrator_zh": "雅"
        },
        {
            "location": "335/TALK",
            "narrator": "みやび",
            "text": "それでもつき合う\nゆうなら、うちとしては\n助かるけんど……。",
            "zh": "就算这样你还愿意\n来往的话，我这边\n倒是求之不得，但是……。",
            "narrator_zh": "雅"
        },
        {
            "location": "336/TALK",
            "narrator": "みやび",
            "text": "お前さんの身が\n持たんかもしれんよ？",
            "zh": "就怕你的身子\n撑不住哦？",
            "narrator_zh": "雅"
        },
        {
            "location": "337/SEL",
            "narrator": "",
            "text": "大丈夫！",
            "zh": "没问题！",
            "narrator_zh": ""
        },
        {
            "location": "338/SEL",
            "narrator": "",
            "text": "確かにそうだね",
            "zh": "确实是这样呢",
            "narrator_zh": ""
        },
        {
            "location": "339/ACT",
            "narrator": "",
            "text": "大丈夫！",
            "zh": "没问题！",
            "narrator_zh": ""
        },
        {
            "location": "340/TALK",
            "narrator": "みやび",
            "text": "そか。\n強いね。",
            "zh": "这样啊。\n挺强的嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "341/TALK",
            "narrator": "みやび",
            "text": "まあ、目下の課題は\n今起こっちゅう停滞や。",
            "zh": "嘛，眼下的课题，\n是现在正发生的停滞咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "342/TALK",
            "narrator": "みやび",
            "text": "まずはクランを倒して\n気持ちの整理をさせや。",
            "zh": "首先，打倒库兰，\n让她把心情整理好咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "343/TALK",
            "narrator": "みやび",
            "text": "んで、次に現実世界に\nもどって、うちと\nえい感じに対話する。",
            "zh": "然后，接着回到\n现实世界，跟我\n好好谈一场。",
            "narrator_zh": "雅"
        },
        {
            "location": "344/TALK",
            "narrator": "みやび",
            "text": "えいか？",
            "zh": "得咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "345/SEL",
            "narrator": "",
            "text": "オッケー",
            "zh": "OK！",
            "narrator_zh": ""
        },
        {
            "location": "346/SEL",
            "narrator": "",
            "text": "ビックリするくらい仕事してるね！",
            "zh": "你干劲足得让人吃惊呢！",
            "narrator_zh": ""
        },
        {
            "location": "347/ACT",
            "narrator": "",
            "text": "オッケー",
            "zh": "OK！",
            "narrator_zh": ""
        },
        {
            "location": "348/TALK",
            "narrator": "みやび",
            "text": "うむ。",
            "zh": "嗯。",
            "narrator_zh": "雅"
        },
        {
            "location": "349/ACT",
            "narrator": "",
            "text": "ビックリするくらい仕事してるね！",
            "zh": "你干劲足得让人吃惊呢！",
            "narrator_zh": ""
        },
        {
            "location": "351/TALK",
            "narrator": "みやび",
            "text": "ほっとけ。",
            "zh": "少管我。",
            "narrator_zh": "雅"
        },
        {
            "location": "352/TALK",
            "narrator": "みやび",
            "text": "うちやって、\nTPOっちゅうもんは\n弁えちゅうよ。",
            "zh": "我这个人，\nTPO这种东西\n还是分得清的咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "355/TALK",
            "narrator": "みやび",
            "text": "ほんだら\n宜しく頼むで。",
            "zh": "那就\n多多关照了。",
            "narrator_zh": "雅"
        },
        {
            "location": "356/TALK",
            "narrator": "みやび",
            "text": "うちと$handle$に\nえいココロの旅を！",
            "zh": "献给我和$handle$的\n美妙的心灵之旅！",
            "narrator_zh": "雅"
        },
        {
            "location": "363/ACT",
            "narrator": "",
            "text": "確かにそうだね",
            "zh": "确实是这样呢",
            "narrator_zh": ""
        },
        {
            "location": "364/TALK",
            "narrator": "みやび",
            "text": "うむ。\nそれが普通の答えちや。",
            "zh": "嗯。\n那才是普通的回答滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "365/TALK",
            "narrator": "みやび",
            "text": "まあ、\n無理にとは言わんよ。",
            "zh": "嘛，\n我也不勉强你哦。",
            "narrator_zh": "雅"
        },
        {
            "location": "366/TALK",
            "narrator": "みやび",
            "text": "扉は開けておくき、\n気が向いたら頼むぞね。",
            "zh": "门会给你开着啵，\n愿意的话再来麻烦我咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "41/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>5月8日　11:20 AM</color>\nゴールデンウィーク最終日、神楽坂トライナリー劇場にて。",
            "zh": "<color=green>5月8日　11:20 AM</color>\n黄金周最后一天，于神乐坂三重奏剧场。",
            "narrator_zh": "Dialog_EventData"
        },
        {
            "location": "189/DIALOG",
            "narrator": "BattleInit/Dialog_BATTLE_ch04",
            "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n",
            "zh": "<color=black><size=50><b>恋之崎雅的心中\n战斗开始了。</b></size></color>\n\n\n\n\n\n她的心中，\n产生了很大的挣扎。\n\n请潜入心灵领域，\n化解恋之崎雅心中的挣扎。\n\n\n\n",
            "narrator_zh": "BattleInit/Dialog_BATTLE_ch04"
        },
        {
            "location": "226/DIALOG",
            "narrator": "INFO",
            "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n接続されました。\n\n画面をタップして相手に\n感覚を伝えましょう。",
            "zh": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\n触摸交流\n已连接。\n\n请点击画面，向对方\n传达感觉吧。",
            "narrator_zh": "INFO"
        },
        {
            "location": "248/DIALOG",
            "narrator": "NOTICE",
            "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n切断されました。",
            "zh": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\n触摸交流\n已断开。",
            "narrator_zh": "NOTICE"
        }
    ]
}
