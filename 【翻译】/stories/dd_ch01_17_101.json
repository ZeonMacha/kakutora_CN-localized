{
 "dir": "chap17/daydra/dd_ch01_17_101.js",
 "type": "MainStory",
 "info": {
  "story_id": "17102",
  "cid": "tsubame",
  "title": "002 メインストーリー",
  "sub_title": "横縞瑪瑙＜前編＞",
  "title_zh": "002 主线剧情",
  "sub_title_zh": "横纹玛瑙＜前篇＞"
 },
 "entry": [
  {
   "location": "38/TALK",
   "narrator": "透明真幌",
   "text": "すまんが、もう少し\nその場で待機して\nいてくれ。",
   "zh": "抱歉，再在原地\n待命\n一会儿。",
   "narrator_zh": "透明真幌"
  },
  {
   "location": "39/TALK",
   "narrator": "透明真幌",
   "text": "現場の最終確認に\n時間がかかってる\nらしい。",
   "zh": "现场的最终确认\n好像还要\n花点时间。",
   "narrator_zh": "透明真幌"
  },
  {
   "location": "40/TALK",
   "narrator": "透明真幌",
   "text": "異常がないことが\n確認されるまでの\n辛抱だ。",
   "zh": "到确认没有异常为止，\n再忍\n一忍。",
   "narrator_zh": "透明真幌"
  },
  {
   "location": "41/TALK",
   "narrator": "透明真幌",
   "text": "確認が終わったら\nすぐに帰還許可を\n出すからな。",
   "zh": "确认一结束，\n我就立刻下达\n返回许可。",
   "narrator_zh": "透明真幌"
  },
  {
   "location": "42/TALK",
   "narrator": "アーヤ",
   "text": "了解しました。",
   "zh": "了解。",
   "narrator_zh": "绫水"
  },
  {
   "location": "47/TALK",
   "narrator": "アーヤ",
   "text": "…ということだから、\nもうしばらくここで\n待機ね。",
   "zh": "……所以，\n再在这里\n等一会儿。",
   "narrator_zh": "绫水"
  },
  {
   "location": "49/TALK",
   "narrator": "ガブリエラ",
   "text": "まったく、さっさと\n終わらせてほしいわ。",
   "zh": "真是的，希望\n赶紧结束。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "50/TALK",
   "narrator": "つばめ",
   "text": "…………。",
   "zh": "…………。",
   "narrator_zh": "燕"
  },
  {
   "location": "51/TALK",
   "narrator": "アーヤ",
   "text": "つばめ、大丈夫？\n疲れちゃった？",
   "zh": "燕，没事吗？\n累了？",
   "narrator_zh": "绫水"
  },
  {
   "location": "53/TALK",
   "narrator": "つばめ",
   "text": "あ、いえ…、\n神楽ちゃんのこと\n考えてて…。",
   "zh": "啊，没有……\n我在想\n神乐的事……。",
   "narrator_zh": "燕"
  },
  {
   "location": "55/TALK",
   "narrator": "ガブリエラ",
   "text": "何が神楽よ？",
   "zh": "什么神乐？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "56/TALK",
   "narrator": "ガブリエラ",
   "text": "あいつは神楽じゃ\nなくて、フレイメノウ\nでしょ？",
   "zh": "那家伙不是神乐，\n是FreyMENOW\n吧？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "57/TALK",
   "narrator": "つばめ",
   "text": "それは…そうかも\nしれないけど…。",
   "zh": "那是……也许\n是这样……。",
   "narrator_zh": "燕"
  },
  {
   "location": "59/TALK",
   "narrator": "ガブリエラ",
   "text": "かもじゃなくて、\nあいつはメノウなの！",
   "zh": "不是也许，\n那家伙就是MENOW！",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "62/TALK",
   "narrator": "アーヤ",
   "text": "ほら、ギャヴィ。\nそんな怒らないで\n落ち着いて。",
   "zh": "好了，加维。\n别那么生气，\n冷静点。",
   "narrator_zh": "绫水"
  },
  {
   "location": "64/TALK",
   "narrator": "ガブリエラ",
   "text": "別に、怒ってなんか\nいないわよ…。",
   "zh": "我又没有\n在生气……。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "65/TALK",
   "narrator": "つばめ",
   "text": "…………。",
   "zh": "…………。",
   "narrator_zh": "燕"
  },
  {
   "location": "67/TALK",
   "narrator": "アーヤ",
   "text": "仕方ないわ。",
   "zh": "也没办法。",
   "narrator_zh": "绫水"
  },
  {
   "location": "68/TALK",
   "narrator": "アーヤ",
   "text": "卯月がメノウだって\n私も気付いてなかった\nもの。",
   "zh": "卯月是MENOW这件事，\n我也没\n看出来。",
   "narrator_zh": "绫水"
  },
  {
   "location": "69/TALK",
   "narrator": "アーヤ",
   "text": "今まで、そんなそぶり\n見せなかったし。",
   "zh": "她之前也没\n露过那种样子。",
   "narrator_zh": "绫水"
  },
  {
   "location": "71/TALK",
   "narrator": "アーヤ",
   "text": "…つばめは、\n本当に平気？",
   "zh": "……燕，\n真的没事？",
   "narrator_zh": "绫水"
  },
  {
   "location": "73/TALK",
   "narrator": "つばめ",
   "text": "え？　何がですか？",
   "zh": "诶？　什么事？",
   "narrator_zh": "燕"
  },
  {
   "location": "74/TALK",
   "narrator": "ガブリエラ",
   "text": "何がじゃないでしょ？",
   "zh": "还问什么事？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "76/TALK",
   "narrator": "ガブリエラ",
   "text": "神楽の正体が\nメノウってこと。",
   "zh": "神乐的真面目\n是MENOW这件事。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "77/TALK",
   "narrator": "ガブリエラ",
   "text": "あんたにとっては\n重大事件なんじゃ\nないの？",
   "zh": "对你来说\n不是大事\n吗？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "78/TALK",
   "narrator": "つばめ",
   "text": "うん。\nビックリしたよ。",
   "zh": "嗯。\n吓了一跳。",
   "narrator_zh": "燕"
  },
  {
   "location": "81/TALK",
   "narrator": "つばめ",
   "text": "メノウちゃんの曲は\n今でも毎日聞いてる\nのに。",
   "zh": "MENOW的歌\n我到现在每天都在听\n呢。",
   "narrator_zh": "燕"
  },
  {
   "location": "82/TALK",
   "narrator": "つばめ",
   "text": "神楽ちゃんと\n話してても全然気づか\nなかったんだもん。",
   "zh": "跟神乐说话的时候\n却完全\n没发现。",
   "narrator_zh": "燕"
  },
  {
   "location": "83/TALK",
   "narrator": "つばめ",
   "text": "もしかして、\n声変えたりとかも\nできるのかな？",
   "zh": "难道，\n声音什么的\n也能变吗？",
   "narrator_zh": "燕"
  },
  {
   "location": "85/TALK",
   "narrator": "ガブリエラ",
   "text": "いや、そんなこと\n聞いてるんじゃ\nないから。",
   "zh": "不是，我问的\n不是\n这个。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "88/TALK",
   "narrator": "つばめ",
   "text": "え？　そうなの？",
   "zh": "诶？　是吗？",
   "narrator_zh": "燕"
  },
  {
   "location": "90/TALK",
   "narrator": "ガブリエラ",
   "text": "だから、あたし達が\n言いたいのは！",
   "zh": "所以，我们\n想说的是！",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "91/TALK",
   "narrator": "ガブリエラ",
   "text": "…ううん、もういい。\nなんか、疲れたわ。",
   "zh": "……算了，不用了。\n有点累了。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "92/TALK",
   "narrator": "つばめ",
   "text": "えっ？　わたし、\n何か変なこと\n言ってる？",
   "zh": "诶？　我\n是不是说了\n什么奇怪的话？",
   "narrator_zh": "燕"
  },
  {
   "location": "93/TALK",
   "narrator": "アーヤ",
   "text": "気にしないで。\n特に混乱とかしてない\nなら、それでいいの。",
   "zh": "别在意。\n你没有特别混乱的话，\n这样就好。",
   "narrator_zh": "绫水"
  },
  {
   "location": "94/TALK",
   "narrator": "ガブリエラ",
   "text": "まあ、さすがは\n天然なだけあるわね。",
   "zh": "嘛，不愧是\n天然。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "96/TALK",
   "narrator": "つばめ",
   "text": "うう、天然扱いする\nなら、せめて理由を\n教えてよぉ…。",
   "zh": "呜，要说我天然，\n至少把理由\n告诉我呀……。",
   "narrator_zh": "燕"
  },
  {
   "location": "97/TALK",
   "narrator": "ガブリエラ",
   "text": "だから、卯月は\nメノウでもあるのよ。",
   "zh": "所以说，卯月\n同时也是MENOW。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "98/TALK",
   "narrator": "ガブリエラ",
   "text": "今までと同じに\n話したり\nできないでしょ？",
   "zh": "总不能还跟以前\n一样\n说话吧？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "100/TALK",
   "narrator": "つばめ",
   "text": "…え？　だって、\n神楽ちゃんは\n神楽ちゃんだし…。",
   "zh": "……诶？可是，\n神乐就是\n神乐呀……。",
   "narrator_zh": "燕"
  },
  {
   "location": "103/TALK",
   "narrator": "ガブリエラ",
   "text": "はぁ…もういいわよ。\nてか、その天然っぷり\n羨ましいわ…。",
   "zh": "唉……算了。\n话说，这份天然\n还挺让人羡慕……。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "104/TALK",
   "narrator": "つばめ",
   "text": "…………。",
   "zh": "…………。",
   "narrator_zh": "燕"
  },
  {
   "location": "105/SEL",
   "narrator": "",
   "text": "悩んだりしてないの？",
   "zh": "你没有在烦恼吗？",
   "narrator_zh": ""
  },
  {
   "location": "106/ACT",
   "narrator": "",
   "text": "悩んだりしてないの？",
   "zh": "你没有在烦恼吗？",
   "narrator_zh": ""
  },
  {
   "location": "123/TALK",
   "narrator": "つばめ",
   "text": "$handle$さんまで？",
   "zh": "连$handle$也这么说？",
   "narrator_zh": "燕"
  },
  {
   "location": "124/TALK",
   "narrator": "つばめ",
   "text": "大丈夫だよ",
   "zh": "没事的",
   "narrator_zh": "燕"
  },
  {
   "location": "126/SEL",
   "narrator": "",
   "text": "本当に別人として見れる？",
   "zh": "真的能把她当成另一个人吗？",
   "narrator_zh": ""
  },
  {
   "location": "127/ACT",
   "narrator": "",
   "text": "本当に別人として見れる？",
   "zh": "真的能把她当成另一个人吗？",
   "narrator_zh": ""
  },
  {
   "location": "130/TALK",
   "narrator": "つばめ",
   "text": "それは",
   "zh": "这个",
   "narrator_zh": "燕"
  },
  {
   "location": "133/TALK",
   "narrator": "つばめ",
   "text": "不安かも",
   "zh": "也许会不安",
   "narrator_zh": "燕"
  },
  {
   "location": "134/TALK",
   "narrator": "つばめ",
   "text": "ちょっとだけ",
   "zh": "就一点点",
   "narrator_zh": "燕"
  },
  {
   "location": "135/TALK",
   "narrator": "つばめ",
   "text": "メノウちゃんって",
   "zh": "说她是MENOW",
   "narrator_zh": "燕"
  },
  {
   "location": "136/TALK",
   "narrator": "つばめ",
   "text": "わかってから",
   "zh": "知道了之后",
   "narrator_zh": "燕"
  },
  {
   "location": "137/TALK",
   "narrator": "つばめ",
   "text": "神楽ちゃんの顔",
   "zh": "神乐的脸",
   "narrator_zh": "燕"
  },
  {
   "location": "138/TALK",
   "narrator": "つばめ",
   "text": "メノウちゃんに見ぇて",
   "zh": "看起来像MENOW",
   "narrator_zh": "燕"
  },
  {
   "location": "141/TALK",
   "narrator": "つばめ",
   "text": "今までみたぃに",
   "zh": "还能像以前那样",
   "narrator_zh": "燕"
  },
  {
   "location": "142/TALK",
   "narrator": "つばめ",
   "text": "お話しできるかな？",
   "zh": "跟她说话吗？",
   "narrator_zh": "燕"
  },
  {
   "location": "209/TALK",
   "narrator": "つばめ",
   "text": "　",
   "zh": "……",
   "narrator_zh": "燕"
  },
  {
   "location": "217/TALK",
   "narrator": "つばめ",
   "text": "こんにちは、\n$handle$さん。",
   "zh": "你好，\n$handle$。",
   "narrator_zh": "燕"
  },
  {
   "location": "218/SEL",
   "narrator": "",
   "text": "こんにちは",
   "zh": "你好",
   "narrator_zh": ""
  },
  {
   "location": "219/SEL",
   "narrator": "",
   "text": "なんでそんなに怖いんですか？",
   "zh": "为什么这么吓人？",
   "narrator_zh": ""
  },
  {
   "location": "220/ACT",
   "narrator": "",
   "text": "こんにちは",
   "zh": "你好",
   "narrator_zh": ""
  },
  {
   "location": "221/ACT",
   "narrator": "",
   "text": "なんでそんなに怖いんですか？",
   "zh": "为什么这么吓人？",
   "narrator_zh": ""
  },
  {
   "location": "222/TALK",
   "narrator": "つばめ",
   "text": "怖い、ですか？",
   "zh": "吓人，吗？",
   "narrator_zh": "燕"
  },
  {
   "location": "223/TALK",
   "narrator": "つばめ",
   "text": "…すみません。\nまだ慣れてないもので。",
   "zh": "……抱歉。\n还不太习惯。",
   "narrator_zh": "燕"
  },
  {
   "location": "224/TALK",
   "narrator": "つばめ",
   "text": "どう対応したらいいか\nわかってないんです。",
   "zh": "还不知道\n该怎么应对。",
   "narrator_zh": "燕"
  },
  {
   "location": "226/TALK",
   "narrator": "つばめ",
   "text": "では早速\n仕事をしましょう。",
   "zh": "那就马上\n开始工作吧。",
   "narrator_zh": "燕"
  },
  {
   "location": "227/SEL",
   "narrator": "",
   "text": "そうですね",
   "zh": "是啊",
   "narrator_zh": ""
  },
  {
   "location": "228/SEL",
   "narrator": "",
   "text": "その前に質問が",
   "zh": "在那之前有个问题",
   "narrator_zh": ""
  },
  {
   "location": "229/ACT",
   "narrator": "",
   "text": "そうですね",
   "zh": "是啊",
   "narrator_zh": ""
  },
  {
   "location": "230/ACT",
   "narrator": "",
   "text": "その前に質問が",
   "zh": "在那之前有个问题",
   "narrator_zh": ""
  },
  {
   "location": "231/TALK",
   "narrator": "つばめ",
   "text": "手短に。",
   "zh": "长话短说。",
   "narrator_zh": "燕"
  },
  {
   "location": "232/TALK",
   "narrator": "つばめ",
   "text": "１つの質問に答える為には\nおよそ２～３分ほど\nかかるんです。",
   "zh": "回答一个问题，\n大约要花\n2到3分钟。",
   "narrator_zh": "燕"
  },
  {
   "location": "233/TALK",
   "narrator": "つばめ",
   "text": "その分人件費が発生します\nから、つばめにとっては\nあまり良くないことです。",
   "zh": "那就会产生人工费，\n对燕来说\n不是什么好事。",
   "narrator_zh": "燕"
  },
  {
   "location": "234/TALK",
   "narrator": "つばめ",
   "text": "手短に。\n１つだけ答えます。",
   "zh": "长话短说。\n只回答一个。",
   "narrator_zh": "燕"
  },
  {
   "location": "236/TALK",
   "narrator": "つばめ",
   "text": "…といっても、前回\n答えましたから、今回は\n一択のみですね。",
   "zh": "……虽说如此，上次\n已经回答过了，这次\n只有一个选项。",
   "narrator_zh": "燕"
  },
  {
   "location": "237/SEL",
   "narrator": "",
   "text": "前の司書はどうなっちゃったの？",
   "zh": "上一任司书怎么样了？",
   "narrator_zh": ""
  },
  {
   "location": "238/ACT",
   "narrator": "",
   "text": "前の司書はどうなっちゃったの？",
   "zh": "上一任司书怎么样了？",
   "narrator_zh": ""
  },
  {
   "location": "242/TALK",
   "narrator": "つばめ",
   "text": "…といっても、前回\n答えましたから、今回は\n一択のみですね。",
   "zh": "……虽说如此，上次\n已经回答过了，这次\n只有一个选项。",
   "narrator_zh": "燕"
  },
  {
   "location": "243/SEL",
   "narrator": "",
   "text": "貴方は以前はどこにいたんですか？",
   "zh": "你以前在哪里？",
   "narrator_zh": ""
  },
  {
   "location": "244/ACT",
   "narrator": "",
   "text": "貴方は以前はどこにいたんですか？",
   "zh": "你以前在哪里？",
   "narrator_zh": ""
  },
  {
   "location": "248/TALK",
   "narrator": "つばめ",
   "text": "…といっても、前回\n答えましたから、今回は\n一択のみですね。",
   "zh": "……虽说如此，上次\n已经回答过了，这次\n只有一个选项。",
   "narrator_zh": "燕"
  },
  {
   "location": "249/SEL",
   "narrator": "",
   "text": "貴方はつばめの何を司る人格ですか？",
   "zh": "你是掌管燕的什么的人格？",
   "narrator_zh": ""
  },
  {
   "location": "250/ACT",
   "narrator": "",
   "text": "貴方はつばめの何を司る人格ですか？",
   "zh": "你是掌管燕的什么的人格？",
   "narrator_zh": ""
  },
  {
   "location": "254/TALK",
   "narrator": "つばめ",
   "text": "…といっても、前回\n答えましたから、今回は\n一択のみですね。",
   "zh": "……虽说如此，上次\n已经回答过了，这次\n只有一个选项。",
   "narrator_zh": "燕"
  },
  {
