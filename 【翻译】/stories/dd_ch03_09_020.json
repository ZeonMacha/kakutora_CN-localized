{
    "dir": "chap09/daydra/dd_ch03_09_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "9356",
        "cid": "gabriella",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "先輩以外の呼び方",
        "title_zh": "Extra006 额外剧情",
        "sub_title_zh": "前辈以外的称呼"
    },
    "entry": [
        {
            "location": "386/SCENARIO",
            "narrator": "",
            "text": "先輩以外の呼び方",
            "zh": "前辈以外的称呼",
            "narrator_zh": ""
        },
        {
            "location": "400/TALK",
            "narrator": "つばめ",
            "text": "あっ、せんぱーい！",
            "zh": "啊，前辈—！",
            "narrator_zh": "燕"
        },
        {
            "location": "405/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょ、ちょっと新入り！",
            "zh": "等、等一下新人！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "406/TALK",
            "narrator": "ガブリエラ",
            "text": "中等部で先輩って\n呼ばないでって、\n前にも言ったでしょ！？",
            "zh": "我以前不是说过，\n在初中部不许喊我\n前辈吗！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "409/TALK",
            "narrator": "つばめ",
            "text": "ああっ、\nご、ごめんなさい！",
            "zh": "啊啊，\n对、对不起！",
            "narrator_zh": "燕"
        },
        {
            "location": "410/TALK",
            "narrator": "ガブリエラ",
            "text": "…あんた、ほんっとーに\n空気が読めないわね。",
            "zh": "……你啊，真是完全\n不会看气氛呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "411/TALK",
            "narrator": "ガブリエラ",
            "text": "メチャクチャ周りから\n変な目で見られてるのに、\nどうして気づかないの？",
            "zh": "周围人都用奇怪的眼神\n一直盯着看了，\n你怎么就注意不到呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "412/TALK",
            "narrator": "ガブリエラ",
            "text": "とにかく、ここで先輩って\n呼ぶのは禁止よ。",
            "zh": "总之，在这里禁止\n叫我前辈。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "413/TALK",
            "narrator": "つばめ",
            "text": "でも、それじゃあなんて\n呼んだらいいんですか？",
            "zh": "可是，那我应该\n怎么叫你才好呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "416/TALK",
            "narrator": "ガブリエラ",
            "text": "そ、そうね…\nちょっと待ちなさい。",
            "zh": "这、这个嘛……\n你稍等一下。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "430/TALK",
            "narrator": "ガブリエラ",
            "text": "マルザンナ、質問があるの",
            "zh": "玛尔赞娜，我有问题要问",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "431/TALK",
            "narrator": "ガブリエラ",
            "text": "新入りの私の呼び方なんだけど",
            "zh": "就是新人对我的称呼",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "432/TALK",
            "narrator": "ガブリエラ",
            "text": "中等部で先輩っていうのは、変に目立つでしょう？",
            "zh": "在初中部叫我前辈，会莫名很显眼对吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "433/TALK",
            "narrator": "ガブリエラ",
            "text": "他に良い呼び方ってあるかしら？",
            "zh": "还有其他好一点的称呼吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "434/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、呼び捨てとガブちゃんは禁止よ。",
            "zh": "不过，直呼名字和叫小加布都是禁止的哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "436/SEL",
            "narrator": "",
            "text": "ガブちゃんで諦めよう",
            "zh": "干脆就叫小加布算了",
            "narrator_zh": ""
        },
        {
            "location": "437/SEL",
            "narrator": "",
            "text": "普通は呼び捨てじゃない？",
            "zh": "一般不都是直呼名字吗？",
            "narrator_zh": ""
        },
        {
            "location": "438/SEL",
            "narrator": "",
            "text": "ギャヴィは？",
            "zh": "叫加维怎么样？",
            "narrator_zh": ""
        },
        {
            "location": "439/ACT",
            "narrator": "",
            "text": "ガブちゃんで諦めよう",
            "zh": "干脆就叫小加布算了",
            "narrator_zh": ""
        },
        {
            "location": "440/TALK",
            "narrator": "ガブリエラ",
            "text": "諦められないから聞いてるのよ、もぅ！",
            "zh": "就是因为没办法接受才问你的呀，真是的！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "453/TALK",
            "narrator": "ガブリエラ",
            "text": "まったく、使えないんだから…。",
            "zh": "真是的，一点都派不上用场……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "454/TALK",
            "narrator": "ガブリエラ",
            "text": "先輩とガブちゃん以外で、\n新人があたしを呼ぶと\nしたら…。",
            "zh": "除了前辈和小加布之外，\n要是让新人叫我\n的话……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "456/TALK",
            "narrator": "ガブリエラ",
            "text": "う～ん…。",
            "zh": "唔～……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "457/TALK",
            "narrator": "つばめ",
            "text": "じゃあ中等部では、\nやっほー、とか、おーい、\nって呼ぶのは？",
            "zh": "那在初中部的时候，\n就喊“呀吼—”，或者“喂—”\n这样怎么样？",
            "narrator_zh": "燕"
        },
        {
            "location": "459/TALK",
            "narrator": "ガブリエラ",
            "text": "それ、すっごい目立ちそう\nなんだけど…。",
            "zh": "那样感觉会超级\n显眼的好吗……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "460/TALK",
            "narrator": "ガブリエラ",
            "text": "まあ、高等部のトライ\nナリーメンバーがいる、\nってだけでも――",
            "zh": "不过话说回来，光是有\n高中部的三重奏成员\n在这一点——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "461/TALK",
            "narrator": "ガブリエラ",
            "text": "普通に目立ちはすると\n思うけど。",
            "zh": "我觉得就已经\n够显眼的了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "464/TALK",
            "narrator": "つばめ",
            "text": "そっかぁ…。\nこういう時、みんなと違う\n制服って不便ですね。",
            "zh": "这样呀……。\n这种时候，跟大家不一样的\n校服真不方便呢。",
            "narrator_zh": "燕"
        },
        {
            "location": "465/TALK",
            "narrator": "ガブリエラ",
            "text": "そうね…って――",
            "zh": "是啊……不对——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "466/TALK",
            "narrator": "ガブリエラ",
            "text": "そういう話をしてるん\nじゃない！",
            "zh": "我不是在说\n这个事！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "467/TALK",
            "narrator": "ガブリエラ",
            "text": "やっぱり、あんたは\n今まで通り先輩って\n呼んでくれればいいわ。",
            "zh": "果然，你还是\n照以前那样叫我\n前辈就好了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "468/TALK",
            "narrator": "ガブリエラ",
            "text": "それ以外の呼び方されても\nしっくり来ないと思うし。",
            "zh": "被叫成别的什么，\n我觉得也怪别扭的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "470/TALK",
            "narrator": "つばめ",
            "text": "わかりました。",
            "zh": "我知道了。",
            "narrator_zh": "燕"
        },
        {
            "location": "472/TALK",
            "narrator": "つばめ",
            "text": "じゃあ、これからも\nせんぱいって呼びますね！",
            "zh": "那今后我也还是\n叫你前辈哦！",
            "narrator_zh": "燕"
        },
        {
            "location": "475/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、ここでは声の\nボリュームを下げて\n呼びなさい！",
            "zh": "不过，在这里喊的时候\n给我把音量\n放低点！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "476/ACT",
            "narrator": "",
            "text": "普通は呼び捨てじゃない？",
            "zh": "一般不都是直呼名字吗？",
            "narrator_zh": ""
        },
        {
            "location": "477/TALK",
            "narrator": "ガブリエラ",
            "text": "それはそうだけど…",
            "zh": "话是这么说没错……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "478/TALK",
            "narrator": "ガブリエラ",
            "text": "呼び捨てかぁ",
            "zh": "直呼名字啊",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "479/TALK",
            "narrator": "ガブリエラ",
            "text": "嫌だけど",
            "zh": "虽然挺讨厌的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "480/TALK",
            "narrator": "ガブリエラ",
            "text": "一度試してみるわ",
            "zh": "还是先试一次看看吧",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "492/TALK",
            "narrator": "ガブリエラ",
            "text": "よし、新人！\nあたしを呼び捨てにして\nみなさい。",
            "zh": "好，新人！\n你试着直呼我的名字\n看看。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "495/TALK",
            "narrator": "つばめ",
            "text": "ガブちゃん！\nすっごく嫌な予感しか\nしないんだけど！？",
            "zh": "小加布！\n我只有超级不妙的预感\n啊！？",
            "narrator_zh": "燕"
        },
        {
            "location": "498/TALK",
            "narrator": "ガブリエラ",
            "text": "サラッとガブちゃん\n言うな！",
            "zh": "别顺嘴就叫\n小加布啊！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "499/TALK",
            "narrator": "ガブリエラ",
            "text": "いいから早くしなさい！\n早く早く！",
            "zh": "别废话了快点叫！\n快点快点！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "501/TALK",
            "narrator": "つばめ",
            "text": "わ、わかりました…",
            "zh": "我、我知道了……",
            "narrator_zh": "燕"
        },
        {
            "location": "503/TALK",
            "narrator": "つばめ",
            "text": "ガブリエラ。",
            "zh": "加布里埃拉。",
            "narrator_zh": "燕"
        },
        {
            "location": "505/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "506/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "509/TALK",
            "narrator": "ガブリエラ",
            "text": "絶対却下ね。",
            "zh": "绝对驳回。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "510/TALK",
            "narrator": "つばめ",
            "text": "だから言ったのにー！",
            "zh": "所以我都说了嘛—！",
            "narrator_zh": "燕"
        },
        {
            "location": "512/TALK",
            "narrator": "ガブリエラ",
            "text": "やっぱり、あんたは\n今まで通り先輩って\n呼んでくれればいいわ。",
            "zh": "果然，你还是\n照以前那样叫我\n前辈就好了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "513/TALK",
            "narrator": "ガブリエラ",
            "text": "それ以外の呼び方されても\nしっくり来ないと思うし。",
            "zh": "被叫成别的什么，\n我觉得也怪别扭的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "514/TALK",
            "narrator": "つばめ",
            "text": "わかりました。",
            "zh": "我知道了。",
            "narrator_zh": "燕"
        },
        {
            "location": "516/TALK",
            "narrator": "つばめ",
            "text": "じゃあ、これからも\nせんぱいって呼びますね！",
            "zh": "那今后我也还是\n叫你前辈哦！",
            "narrator_zh": "燕"
        },
        {
            "location": "519/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、ここでは声の\nボリュームを下げて\n呼びなさい！",
            "zh": "不过，在这里喊的时候\n给我把音量\n放低点！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "520/ACT",
            "narrator": "",
            "text": "ギャヴィは？",
            "zh": "叫加维怎么样？",
            "narrator_zh": ""
        },
        {
            "location": "523/TALK",
            "narrator": "ガブリエラ",
            "text": "新入りがギャヴィ？",
            "zh": "让新人叫加维？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "524/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤや真幌ならまだしも新入りには合わないような…",
            "zh": "绫水或者真幌倒还罢了，总觉得不适合新人……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "525/TALK",
            "narrator": "ガブリエラ",
            "text": "一応試してみるけど",
            "zh": "姑且试一下看看好了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "538/TALK",
            "narrator": "ガブリエラ",
            "text": "よし、新人！\nギャヴィって呼んで\nみなさい。",
            "zh": "好，新人！\n你试着叫我加维\n看看。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "539/TALK",
            "narrator": "つばめ",
            "text": "それってアーヤさんや\n真幌さんみたいな\n呼び方ですよね？",
            "zh": "那不是像绫水前辈和\n真幌前辈那样的\n叫法吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "541/TALK",
            "narrator": "ガブリエラ",
            "text": "そうよ。\nほら、早く。",
            "zh": "没错。\n来，快点。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "543/TALK",
            "narrator": "つばめ",
            "text": "うん、ギャヴィ。",
            "zh": "嗯，加维。",
            "narrator_zh": "燕"
        },
        {
            "location": "545/TALK",
            "narrator": "ガブリエラ",
            "text": "…………？",
            "zh": "…………？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "547/TALK",
            "narrator": "ガブリエラ",
            "text": "もう一回言ってみて。",
            "zh": "你再叫一遍试试。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "548/TALK",
            "narrator": "つばめ",
            "text": "ギャヴィ。",
            "zh": "加维。",
            "narrator_zh": "燕"
        },
        {
            "location": "550/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "552/TALK",
            "narrator": "ガブリエラ",
            "text": "何かしら？\nこの、どこがどうとは\n言えないんだけど――",
            "zh": "怎么说呢？\n虽然也说不上是哪里\n不对劲——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "553/TALK",
            "narrator": "ガブリエラ",
            "text": "なんか違う感じがして\nムズムズするわ。",
            "zh": "总觉得哪里不对，\n让人心里痒痒的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "554/TALK",
            "narrator": "つばめ",
            "text": "発音が変とか？",
            "zh": "是发音奇怪之类的吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "556/TALK",
            "narrator": "ガブリエラ",
            "text": "っていうか――",
            "zh": "应该说——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "558/TALK",
            "narrator": "ガブリエラ",
            "text": "新人にギャヴィって\n呼ばれるのが、なんとなく\n気に入らないだけかも。",
            "zh": "大概只是单纯不太爽\n被新人叫加维\n而已吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "561/TALK",
            "narrator": "つばめ",
            "text": "呼べって言ったのは\nせんぱいなのにぃ…。",
            "zh": "明明是前辈自己\n让我这么叫的呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "563/TALK",
            "narrator": "ガブリエラ",
            "text": "やっぱり、あんたは\n今まで通り先輩って\n呼んでくれればいいわ。",
            "zh": "果然，你还是\n照以前那样叫我\n前辈就好了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "564/TALK",
            "narrator": "ガブリエラ",
            "text": "それ以外の呼び方されても\nしっくり来ないと思うし。",
            "zh": "被叫成别的什么，\n我觉得也怪别扭的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "566/TALK",
            "narrator": "つばめ",
            "text": "わかりました。",
            "zh": "我知道了。",
            "narrator_zh": "燕"
        },
        {
            "location": "568/TALK",
            "narrator": "つばめ",
            "text": "じゃあ、これからも\nせんぱいって呼びますね！",
            "zh": "那今后我也还是\n叫你前辈哦！",
            "narrator_zh": "燕"
        },
        {
            "location": "571/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、ここでは声の\nボリュームを下げて\n呼びなさい！",
            "zh": "不过，在这里喊的时候\n给我把音量\n放低点！",
            "narrator_zh": "加布里埃拉"
