{
    "dir": "dramatics/daydra/drm_ch02_00_570.js",
    "type": "Episode",
    "info": {
        "story_id": "2057",
        "cid": "ayami",
        "title": "らぶとーく 第56話",
        "sub_title": "スキップ気分で",
        "title_zh": "恋爱漫谈 第56话",
        "sub_title_zh": "怀着雀跃的心情"
    },
    "entry": [
        {
            "location": "151/SCENARIO",
            "narrator": "",
            "text": "スキップ気分で",
            "zh": "怀着雀跃的心情",
            "narrator_zh": ""
        },
        {
            "location": "164/TALK",
            "narrator": "ガブリエラ",
            "text": "そういえば――",
            "zh": "说起来——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "165/TALK",
            "narrator": "ガブリエラ",
            "text": "今日は学校で、\n調理実習があったの。",
            "zh": "今天在学校，\n上了烹饪实习课。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "167/TALK",
            "narrator": "アーヤ",
            "text": "へぇ…お魚でも焼いたの？",
            "zh": "欸……是烤了鱼吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "169/TALK",
            "narrator": "ガブリエラ",
            "text": "まさか。",
            "zh": "怎么会。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "171/TALK",
            "narrator": "ガブリエラ",
            "text": "これがもう、すっごい\n子供っぽくて退屈な\n内容だったのよ。",
            "zh": "这真是超级\n孩子气又无聊的\n内容呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "173/TALK",
            "narrator": "ガブリエラ",
            "text": "お米を炊くでしょ？\nそれとお味噌汁を\n作って――",
            "zh": "先煮上米饭吧？\n然后做个\n味噌汤——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "174/TALK",
            "narrator": "ガブリエラ",
            "text": "おかずに野菜炒めを\n作るだけなんだもの。",
            "zh": "毕竟只是做道炒青菜\n当配菜而已嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "177/TALK",
            "narrator": "みやび",
            "text": "ほほぅ…美味しそうやとは\n思うけんど――",
            "zh": "嚯嚯……是觉得\n应该挺好吃，但是——",
            "narrator_zh": "雅"
        },
        {
            "location": "178/TALK",
            "narrator": "みやび",
            "text": "簡単に作れる献立ばっか\nっちゅう感じやね。",
            "zh": "感觉净是\n轻松就能做的菜咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "179/TALK",
            "narrator": "ガブリエラ",
            "text": "でもね、みんな驚くほど\n料理が出来ないの。",
            "zh": "不过呢，大家做菜\n出乎意料地不行。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "180/TALK",
            "narrator": "ガブリエラ",
            "text": "野菜は上手く切れないし、\nみそ汁はグツグツ沸騰させ\nまくってるし――",
            "zh": "菜切不利索，\n味噌汤还咕嘟咕嘟\n煮个不停——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "182/TALK",
            "narrator": "ガブリエラ",
            "text": "米の研ぎ方も、水に浸して\nかき混ぜてるだけなの。",
            "zh": "淘米也是，就只是泡进水里\n搅一搅而已。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "184/TALK",
            "narrator": "ガブリエラ",
            "text": "ジャッジャッて音しないと\n研いでることにならない\nじゃない、まったく…。",
            "zh": "不发出唰唰的声音\n就不算在淘米\n嘛，真是的……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "186/TALK",
            "narrator": "アーヤ",
            "text": "あはは…ギャヴィの\n気持ちはわからなくは\nないけど――",
            "zh": "啊哈哈……加维的\n心情我不是不能\n理解——",
            "narrator_zh": "绫水"
        },
        {
            "location": "188/TALK",
            "narrator": "アーヤ",
            "text": "あんまり文句を言ったら\nかわいそうよ。",
            "zh": "抱怨太多的话\n她们也怪可怜的哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "190/TALK",
            "narrator": "ガブリエラ",
            "text": "何よ？\nアーヤはみんなの\n味方するの？",
            "zh": "干嘛？\n绫水是要\n帮她们说话吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "191/TALK",
            "narrator": "アーヤ",
            "text": "だって、ギャヴィは\nみんなと違って、\n毎日自炊してるでしょ？",
            "zh": "因为，加维跟别人\n不一样，每天都\n自己做饭吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "192/TALK",
            "narrator": "アーヤ",
            "text": "その時点で、みんなより\nずっと料理のテクニックは\n上なんだもの。",
            "zh": "在那个时候，我的厨艺\n就比大家\n高明得多。",
            "narrator_zh": "绫水"
        },
        {
            "location": "194/TALK",
            "narrator": "ガブリエラ",
            "text": "…うん…まあね…。",
            "zh": "…嗯…算是吧…。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "195/TALK",
            "narrator": "アーヤ",
            "text": "だから、ギャヴィには\n退屈な授業だったかも\nしれないけど――",
            "zh": "所以，对加维来说\n也许是很无聊的课，\n不过——",
            "narrator_zh": "绫水"
        },
        {
            "location": "196/TALK",
            "narrator": "アーヤ",
            "text": "その辺は上級者として、\nリードしてあげないと\nダメよ。",
            "zh": "那方面作为老手，\n你得主动\n带一带才行。",
            "narrator_zh": "绫水"
        },
        {
            "location": "197/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "199/TALK",
            "narrator": "アーヤ",
            "text": "…どうかした？",
            "zh": "……怎么了？",
            "narrator_zh": "绫水"
        },
        {
            "location": "201/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤさ、最近少し、\n優しくなったよね？",
            "zh": "绫水啊，最近\n是不是变温柔了一点？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "202/TALK",
            "narrator": "アーヤ",
            "text": "え？",
            "zh": "诶？",
            "narrator_zh": "绫水"
        },
        {
            "location": "203/TALK",
            "narrator": "ガブリエラ",
            "text": "だって、前までなら\nこんな話したら絶対――",
            "zh": "因为，以前说这种话\n我一定会——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "205/TALK",
            "narrator": "みやび",
            "text": "授業は授業なんだから、\n文句を言うんじゃない。",
            "zh": "课就是课，\n别发牢骚咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "207/TALK",
            "narrator": "みやび",
            "text": "…くらいのことは、\n間違いなく言うてたね。",
            "zh": "…这种话，\n以前肯定说过咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "209/TALK",
            "narrator": "ガブリエラ",
            "text": "うん、絶対言ってた！",
            "zh": "嗯，绝对说过！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "211/TALK",
            "narrator": "アーヤ",
            "text": "そ、そうかしら？",
            "zh": "是、是这样吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "213/TALK",
            "narrator": "ガブリエラ",
            "text": "…悪い物でも食べた？",
            "zh": "……吃到什么坏东西了？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "215/TALK",
            "narrator": "アーヤ",
            "text": "うーん…食べてないと\n思うけど…。",
            "zh": "唔……应该\n没吃过吧……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "216/TALK",
            "narrator": "ガブリエラ",
            "text": "ほら、今だって！",
            "zh": "看吧，现在也是！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "217/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょっと前までなら、\nそんな物食べないわよ\n失礼ね、とか言ってたし。",
            "zh": "要是放在以前，\n我会说这种东西我才不吃\n真没礼貌之类的话。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "220/TALK",
            "narrator": "みやび",
            "text": "…ははぁん、なるほど。",
            "zh": "……哈哈，原来如此。",
            "narrator_zh": "雅"
        },
        {
            "location": "221/TALK",
            "narrator": "みやび",
            "text": "これが俗に言う、\n大人の余裕ゆうやつやね。",
            "zh": "这就是俗称的\n大人的从容咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "223/TALK",
            "narrator": "アーヤ",
            "text": "何言ってるのよ。\nそんなに年が離れてる\nわけじゃないでしょ？",
            "zh": "说什么呢。\n我们年龄差没有\n那么大吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "225/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、最近のアーヤからは\nそういうの感じるかも。",
            "zh": "不过，最近的绫水\n确实有那种感觉。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "227/TALK",
            "narrator": "みやび",
            "text": "ほらな。\nうちの勘違いやないやろ？",
            "zh": "看吧。\n不是我搞错了吧？",
            "narrator_zh": "雅"
        },
        {
            "location": "229/TALK",
            "narrator": "アーヤ",
            "text": "そ、そっか…。\n自覚がなかったから、\nちょっと驚いたわ。",
            "zh": "这、这样啊……。\n我自己没意识到，\n有点吃惊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "230/TALK",
            "narrator": "アーヤ",
            "text": "…ヤバいかも。",
            "zh": "……可能不太妙。",
            "narrator_zh": "绫水"
        },
        {
            "location": "232/TALK",
            "narrator": "アーヤ",
            "text": "…そろそろ劇場開ける\n時間だから、ロビーの方に\n行ってるわ。",
            "zh": "…差不多到剧场\n开门的时间了，我去\n大厅那边了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "245/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "246/TALK",
            "narrator": "アーヤ",
            "text": "…ふふっ。",
            "zh": "……呵呵。",
            "narrator_zh": "绫水"
        },
        {
            "location": "260/SEL",
            "narrator": "",
            "text": "どうかしたの？",
            "zh": "怎么了？",
            "narrator_zh": ""
        },
        {
            "location": "261/ACT",
            "narrator": "",
            "text": "どうかしたの？",
            "zh": "怎么了？",
            "narrator_zh": ""
        },
        {
            "location": "263/TALK",
            "narrator": "アーヤ",
            "text": "$handle$さん",
            "zh": "$handle$",
            "narrator_zh": "绫水"
        },
        {
            "location": "265/TALK",
            "narrator": "アーヤ",
            "text": "聞いて(*^^*)",
            "zh": "听我说(*^^*)",
            "narrator_zh": "绫水"
        },
        {
            "location": "266/TALK",
            "narrator": "アーヤ",
            "text": "私ね",
            "zh": "我啊",
            "narrator_zh": "绫水"
        },
        {
            "location": "267/TALK",
            "narrator": "アーヤ",
            "text": "大人の余裕があるって言われたの(=^0^=)",
            "zh": "有人说我有大人的从容哦(=^0^=)",
            "narrator_zh": "绫水"
        },
        {
            "location": "268/TALK",
            "narrator": "アーヤ",
            "text": "$handle$さんもそう思う？",
            "zh": "$handle$也这么想？",
            "narrator_zh": "绫水"
        },
        {
            "location": "270/SEL",
            "narrator": "",
            "text": "思うよ",
            "zh": "我觉得是",
            "narrator_zh": ""
        },
        {
            "location": "271/SEL",
            "narrator": "",
            "text": "どこが？",
            "zh": "哪里？",
            "narrator_zh": ""
        },
        {
            "location": "272/SEL",
            "narrator": "",
            "text": "$me$の方が大人だよ",
            "zh": "$me$更成熟哦",
            "narrator_zh": ""
        },
        {
            "location": "273/ACT",
            "narrator": "",
            "text": "思うよ",
            "zh": "我觉得是",
            "narrator_zh": ""
        },
        {
            "location": "274/TALK",
            "narrator": "アーヤ",
            "text": "本当？(￣Д￣ )",
            "zh": "真的吗？(￣Д￣ )",
            "narrator_zh": "绫水"
        },
        {
            "location": "275/TALK",
            "narrator": "アーヤ",
            "text": "私",
            "zh": "我",
            "narrator_zh": "绫水"
        },
        {
            "location": "276/TALK",
            "narrator": "アーヤ",
            "text": "$handle$さんの前では",
            "zh": "在$handle$面前",
            "narrator_zh": "绫水"
        },
        {
            "location": "277/TALK",
            "narrator": "アーヤ",
            "text": "結構子供っぽいと思うけど？",
            "zh": "挺孩子气的吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "278/TALK",
            "narrator": "アーヤ",
            "text": "ちゃんと私のこと見て言ってる？( ・_・)σﾞ",
            "zh": "你有好好看着我说话吗？( ・_・)σ",
            "narrator_zh": "绫水"
        },
        {
            "location": "280/SEL",
            "narrator": "",
            "text": "言ってるよ",
            "zh": "我说着呢",
            "narrator_zh": ""
        },
        {
            "location": "281/ACT",
            "narrator": "",
            "text": "言ってるよ",
            "zh": "我说着呢",
            "narrator_zh": ""
        },
        {
            "location": "283/TALK",
            "narrator": "アーヤ",
            "text": "そうなの？",
            "zh": "是吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "284/TALK",
            "narrator": "アーヤ",
            "text": "だとしたら",
            "zh": "要是那样",
            "narrator_zh": "绫水"
        },
        {
            "location": "285/TALK",
            "narrator": "アーヤ",
            "text": "もっとちゃんと見てもらわないといけないわね(*^.^*)",
            "zh": "那得让你好好看着我不行呢(*^.^*)",
            "narrator_zh": "绫水"
        },
        {
            "location": "286/ACT",
            "narrator": "",
            "text": "どこが？",
            "zh": "哪里？",
            "narrator_zh": ""
        },
        {
            "location": "288/TALK",
            "narrator": "アーヤ",
            "text": "どこがって",
            "zh": "你说哪里",
            "narrator_zh": "绫水"
        },
        {
            "location": "289/TALK",
            "narrator": "アーヤ",
            "text": "全部よ、全部(>_<)",
            "zh": "全部哦，全部(>_<)",
            "narrator_zh": "绫水"
        },
        {
            "location": "290/TALK",
            "narrator": "アーヤ",
            "text": "$handle$さんは少し鈍感なところあるから",
            "zh": "因为$handle$有点迟钝",
            "narrator_zh": "绫水"
        },
        {
            "location": "292/TALK",
            "narrator": "アーヤ",
            "text": "気付かなかった？",
            "zh": "你没察觉到？",
            "narrator_zh": "绫水"
        },
        {
            "location": "293/ACT",
            "narrator": "",
            "text": "$me$の方が大人だよ",
            "zh": "$me$更成熟哦",
            "narrator_zh": ""
        },
        {
            "location": "294/TALK",
            "narrator": "アーヤ",
            "text": "それ聞いて気が付いたわ",
            "zh": "听你这么说我才注意到",
            "narrator_zh": "绫水"
        },
        {
            "location": "295/TALK",
            "narrator": "アーヤ",
            "text": "本当の大人は",
            "zh": "真正的大人",
            "narrator_zh": "绫水"
        },
        {
            "location": "296/TALK",
            "narrator": "アーヤ",
            "text": "自分から大人って言い出さない、って(-ω-;)",
            "zh": "是不会自己说自己是大人，的(-ω-;)",
            "narrator_zh": "绫水"
        },
        {
            "location": "297/TALK",
            "narrator": "アーヤ",
            "text": "まあ",
            "zh": "嗯",
            "narrator_zh": "绫水"
        },
        {
            "location": "298/TALK",
            "narrator": "アーヤ",
            "text": "$handle$さんのそういう子供っぽいところ",
            "zh": "$handle$那种孩子气的地方",
            "narrator_zh": "绫水"
        },
        {
            "location": "299/TALK",
            "narrator": "アーヤ",
            "text": "嫌いじゃないけど(*^^*)",
            "zh": "倒也不讨厌(*^^*)",
            "narrator_zh": "绫水"
        },
        {
            "location": "301/TALK",
            "narrator": "アーヤ",
            "text": "でも",
            "zh": "不过",
            "narrator_zh": "绫水"
        },
        {
            "location": "303/TALK",
            "narrator": "アーヤ",
            "text": "私が大人っぽいって言われたのって",
            "zh": "说起来我被人夸成熟这件事",
            "narrator_zh": "绫水"
        },
        {
            "location": "304/TALK",
            "narrator": "アーヤ",
            "text": "きっと",
            "zh": "一定",
            "narrator_zh": "绫水"
        },
        {
            "location": "305/TALK",
            "narrator": "アーヤ",
            "text": "ううん",
            "zh": "不是的",
            "narrator_zh": "绫水"
        },
        {
            "location": "306/TALK",
            "narrator": "アーヤ",
            "text": "絶対",
            "zh": "绝对",
            "narrator_zh": "绫水"
        },
        {
            "location": "307/TALK",
            "narrator": "アーヤ",
            "text": "$handle$さんのおかげだと思う(*^^*)",
            "zh": "我觉得是多亏了$handle$(*^^*)",
            "narrator_zh": "绫水"
        },
        {
            "location": "309/TALK",
            "narrator": "アーヤ",
            "text": "みんなに優しくできるのは",
            "zh": "能对大家温柔",
            "narrator_zh": "绫水"
        },
        {
            "location": "310/TALK",
            "narrator": "アーヤ",
            "text": "貴方がいてくれるだろうな、って",
            "zh": "是因为想到有你在",
            "narrator_zh": "绫水"
        },
        {
            "location": "311/TALK",
