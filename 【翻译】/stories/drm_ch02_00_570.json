{
 "dir": "dramatics/daydra/drm_ch02_00_570.js",
 "type": "Episode",
 "info": {
  "story_id": "2057",
  "cid": "ayami",
  "title": "らぶとーく 第56話",
  "sub_title": "スキップ気分で"
 },
 "entry": [
  {
   "location": "151/SCENARIO",
   "narrator": "",
   "text": "スキップ気分で"
  },
  {
   "location": "164/TALK",
   "narrator": "ガブリエラ",
   "text": "そういえば――",
   "zh": "说起来——",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "165/TALK",
   "narrator": "ガブリエラ",
   "text": "今日は学校で、\n調理実習があったの。"
  },
  {
   "location": "167/TALK",
   "narrator": "アーヤ",
   "text": "へぇ…お魚でも焼いたの？"
  },
  {
   "location": "169/TALK",
   "narrator": "ガブリエラ",
   "text": "まさか。",
   "zh": "怎么会。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "171/TALK",
   "narrator": "ガブリエラ",
   "text": "これがもう、すっごい\n子供っぽくて退屈な\n内容だったのよ。",
   "zh": "这真是超级\n孩子气又无聊的\n内容呢。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "173/TALK",
   "narrator": "ガブリエラ",
   "text": "お米を炊くでしょ？\nそれとお味噌汁を\n作って――",
   "zh": "先煮上米饭吧？\n然后做个\n味噌汤——",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "174/TALK",
   "narrator": "ガブリエラ",
   "text": "おかずに野菜炒めを\n作るだけなんだもの。",
   "zh": "毕竟只是做道炒青菜\n当配菜而已嘛。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "177/TALK",
   "narrator": "みやび",
   "text": "ほほぅ…美味しそうやとは\n思うけんど――"
  },
  {
   "location": "178/TALK",
   "narrator": "みやび",
   "text": "簡単に作れる献立ばっか\nっちゅう感じやね。"
  },
  {
   "location": "179/TALK",
   "narrator": "ガブリエラ",
   "text": "でもね、みんな驚くほど\n料理が出来ないの。",
   "zh": "不过呢，大家做菜\n出乎意料地不行。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "180/TALK",
   "narrator": "ガブリエラ",
   "text": "野菜は上手く切れないし、\nみそ汁はグツグツ沸騰させ\nまくってるし――"
  },
  {
   "location": "182/TALK",
   "narrator": "ガブリエラ",
   "text": "米の研ぎ方も、水に浸して\nかき混ぜてるだけなの。"
  },
  {
   "location": "184/TALK",
   "narrator": "ガブリエラ",
   "text": "ジャッジャッて音しないと\n研いでることにならない\nじゃない、まったく…。"
  },
  {
   "location": "186/TALK",
   "narrator": "アーヤ",
   "text": "あはは…ギャヴィの\n気持ちはわからなくは\nないけど――"
  },
  {
   "location": "188/TALK",
   "narrator": "アーヤ",
   "text": "あんまり文句を言ったら\nかわいそうよ。"
  },
  {
   "location": "190/TALK",
   "narrator": "ガブリエラ",
   "text": "何よ？\nアーヤはみんなの\n味方するの？"
  },
  {
   "location": "191/TALK",
   "narrator": "アーヤ",
   "text": "だって、ギャヴィは\nみんなと違って、\n毎日自炊してるでしょ？",
   "zh": "因为，加维跟别人\n不一样，每天都\n自己做饭吧？",
   "narrator_zh": "绫水"
  },
  {
   "location": "192/TALK",
   "narrator": "アーヤ",
   "text": "その時点で、みんなより\nずっと料理のテクニックは\n上なんだもの。",
   "zh": "在那个时候，我的厨艺\n就比大家\n高明得多。",
   "narrator_zh": "绫水"
  },
  {
   "location": "194/TALK",
   "narrator": "ガブリエラ",
   "text": "…うん…まあね…。"
  },
  {
   "location": "195/TALK",
   "narrator": "アーヤ",
   "text": "だから、ギャヴィには\n退屈な授業だったかも\nしれないけど――",
   "zh": "所以，对加维来说\n也许是很无聊的课，\n不过——",
   "narrator_zh": "绫水"
  },
  {
   "location": "196/TALK",
   "narrator": "アーヤ",
   "text": "その辺は上級者として、\nリードしてあげないと\nダメよ。",
   "zh": "那方面作为老手，\n你得主动\n带一带才行。",
   "narrator_zh": "绫水"
  },
  {
   "location": "197/TALK",
   "narrator": "ガブリエラ",
   "text": "…………。"
  },
  {
   "location": "199/TALK",
   "narrator": "アーヤ",
   "text": "…どうかした？",
   "zh": "……怎么了？",
   "narrator_zh": "绫水"
  },
  {
   "location": "201/TALK",
   "narrator": "ガブリエラ",
   "text": "アーヤさ、最近少し、\n優しくなったよね？"
  },
  {
   "location": "202/TALK",
   "narrator": "アーヤ",
   "text": "え？",
   "zh": "诶？",
   "narrator_zh": "绫水"
  },
  {
   "location": "203/TALK",
   "narrator": "ガブリエラ",
   "text": "だって、前までなら\nこんな話したら絶対――",
   "zh": "因为，以前说这种话\n我一定会——",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "205/TALK",
   "narrator": "みやび",
   "text": "授業は授業なんだから、\n文句を言うんじゃない。"
  },
  {
   "location": "207/TALK",
   "narrator": "みやび",
   "text": "…くらいのことは、\n間違いなく言うてたね。"
  },
  {
   "location": "209/TALK",
   "narrator": "ガブリエラ",
   "text": "うん、絶対言ってた！"
  },
  {
   "location": "211/TALK",
   "narrator": "アーヤ",
   "text": "そ、そうかしら？",
   "zh": "是、是这样吗？",
   "narrator_zh": "绫水"
  },
  {
   "location": "213/TALK",
   "narrator": "ガブリエラ",
   "text": "…悪い物でも食べた？",
   "zh": "……吃到什么坏东西了？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "215/TALK",
   "narrator": "アーヤ",
   "text": "うーん…食べてないと\n思うけど…。"
  },
  {
   "location": "216/TALK",
   "narrator": "ガブリエラ",
   "text": "ほら、今だって！"
  },
  {
   "location": "217/TALK",
   "narrator": "ガブリエラ",
   "text": "ちょっと前までなら、\nそんな物食べないわよ\n失礼ね、とか言ってたし。",
   "zh": "要是放在以前，\n我会说这种东西我才不吃\n真没礼貌之类的话。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "220/TALK",
   "narrator": "みやび",
   "text": "…ははぁん、なるほど。",
   "zh": "……哈哈，原来如此。",
   "narrator_zh": "雅"
  },
  {
   "location": "221/TALK",
   "narrator": "みやび",
   "text": "これが俗に言う、\n大人の余裕ゆうやつやね。",
   "zh": "这就是俗称的\n大人的从容咯。",
   "narrator_zh": "雅"
  },
  {
   "location": "223/TALK",
   "narrator": "アーヤ",
   "text": "何言ってるのよ。\nそんなに年が離れてる\nわけじゃないでしょ？"
  },
  {
   "location": "225/TALK",
   "narrator": "ガブリエラ",
   "text": "でも、最近のアーヤからは\nそういうの感じるかも。",
   "zh": "不过，最近的绫水\n确实有那种感觉。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "227/TALK",
   "narrator": "みやび",
   "text": "ほらな。\nうちの勘違いやないやろ？"
  },
  {
   "location": "229/TALK",
   "narrator": "アーヤ",
   "text": "そ、そっか…。\n自覚がなかったから、\nちょっと驚いたわ。",
   "zh": "这、这样啊……。\n我自己没意识到，\n有点吃惊。",
   "narrator_zh": "绫水"
  },
  {
   "location": "230/TALK",
   "narrator": "アーヤ",
   "text": "…ヤバいかも。",
   "zh": "……可能不太妙。",
   "narrator_zh": "绫水"
  },
  {
   "location": "232/TALK",
   "narrator": "アーヤ",
   "text": "…そろそろ劇場開ける\n時間だから、ロビーの方に\n行ってるわ。"
  },
  {
   "location": "245/TALK",
   "narrator": "アーヤ",
   "text": "…………。"
  },
  {
   "location": "246/TALK",
   "narrator": "アーヤ",
   "text": "…ふふっ。",
   "zh": "……呵呵。",
   "narrator_zh": "绫水"
  },
  {
   "location": "260/SEL",
   "narrator": "",
   "text": "どうかしたの？",
   "zh": "怎么了？",
   "narrator_zh": ""
  },
  {
   "location": "261/ACT",
   "narrator": "",
   "text": "どうかしたの？",
   "zh": "怎么了？",
   "narrator_zh": ""
  },
  {
   "location": "263/TALK",
   "narrator": "アーヤ",
   "text": "$handle$さん",
   "zh": "$handle$",
   "narrator_zh": "绫水"
  },
  {
   "location": "265/TALK",
   "narrator": "アーヤ",
   "text": "聞いて(*^^*)"
  },
  {
   "location": "266/TALK",
   "narrator": "アーヤ",
   "text": "私ね",
   "zh": "我啊",
   "narrator_zh": "绫水"
  },
  {
   "location": "267/TALK",
   "narrator": "アーヤ",
   "text": "大人の余裕があるって言われたの(=^0^=)"
  },
  {
   "location": "268/TALK",
   "narrator": "アーヤ",
   "text": "$handle$さんもそう思う？",
   "zh": "$handle$也这么想？",
   "narrator_zh": "绫水"
  },
  {
   "location": "270/SEL",
   "narrator": "",
   "text": "思うよ",
   "zh": "我觉得是",
   "narrator_zh": ""
  },
  {
   "location": "271/SEL",
   "narrator": "",
   "text": "どこが？",
   "zh": "哪里？",
   "narrator_zh": ""
  },
  {
   "location": "272/SEL",
   "narrator": "",
   "text": "$me$の方が大人だよ",
   "zh": "$me$更成熟哦",
   "narrator_zh": ""
  },
  {
   "location": "273/ACT",
   "narrator": "",
   "text": "思うよ",
   "zh": "我觉得是",
   "narrator_zh": ""
  },
  {
   "location": "274/TALK",
   "narrator": "アーヤ",
   "text": "本当？(￣Д￣ )"
  },
  {
   "location": "275/TALK",
   "narrator": "アーヤ",
   "text": "私"
  },
  {
   "location": "276/TALK",
   "narrator": "アーヤ",
   "text": "$handle$さんの前では",
   "zh": "在$handle$面前",
   "narrator_zh": "绫水"
  },
  {
   "location": "277/TALK",
   "narrator": "アーヤ",
   "text": "結構子供っぽいと思うけど？"
  },
  {
   "location": "278/TALK",
   "narrator": "アーヤ",
   "text": "ちゃんと私のこと見て言ってる？( ・_・)σﾞ",
   "zh": "你有好好看着我说话吗？( ・_・)σ",
   "narrator_zh": "绫水"
  },
  {
   "location": "280/SEL",
   "narrator": "",
   "text": "言ってるよ",
   "zh": "我说着呢",
   "narrator_zh": ""
  },
  {
   "location": "281/ACT",
   "narrator": "",
   "text": "言ってるよ",
   "zh": "我说着呢",
   "narrator_zh": ""
  },
  {
   "location": "283/TALK",
   "narrator": "アーヤ",
   "text": "そうなの？",
   "zh": "是吗？",
   "narrator_zh": "绫水"
  },
  {
   "location": "284/TALK",
   "narrator": "アーヤ",
   "text": "だとしたら",
   "zh": "要是那样",
   "narrator_zh": "绫水"
  },
  {
   "location": "285/TALK",
   "narrator": "アーヤ",
   "text": "もっとちゃんと見てもらわないといけないわね(*^.^*)"
  },
  {
   "location": "286/ACT",
   "narrator": "",
   "text": "どこが？",
   "zh": "哪里？",
   "narrator_zh": ""
  },
  {
   "location": "288/TALK",
   "narrator": "アーヤ",
   "text": "どこがって",
   "zh": "你说哪里",
   "narrator_zh": "绫水"
  },
  {
   "location": "289/TALK",
   "narrator": "アーヤ",
   "text": "全部よ、全部(>_<)"
  },
  {
   "location": "290/TALK",
   "narrator": "アーヤ",
   "text": "$handle$さんは少し鈍感なところあるから",
   "zh": "因为$handle$有点迟钝",
   "narrator_zh": "绫水"
  },
  {
   "location": "292/TALK",
   "narrator": "アーヤ",
   "text": "気付かなかった？"
  },
  {
   "location": "293/ACT",
   "narrator": "",
   "text": "$me$の方が大人だよ",
   "zh": "$me$更成熟哦",
   "narrator_zh": ""
  },
  {
   "location": "294/TALK",
   "narrator": "アーヤ",
   "text": "それ聞いて気が付いたわ",
   "zh": "听你这么说我才注意到",
   "narrator_zh": "绫水"
  },
  {
   "location": "295/TALK",
   "narrator": "アーヤ",
   "text": "本当の大人は"
  },
  {
   "location": "296/TALK",
   "narrator": "アーヤ",
   "text": "自分から大人って言い出さない、って(-ω-;)"
  },
  {
   "location": "297/TALK",
   "narrator": "アーヤ",
   "text": "まあ",
   "zh": "嗯",
   "narrator_zh": "绫水"
  },
  {
   "location": "298/TALK",
   "narrator": "アーヤ",
   "text": "$handle$さんのそういう子供っぽいところ",
   "zh": "$handle$那种孩子气的地方",
   "narrator_zh": "绫水"
  },
  {
   "location": "299/TALK",
   "narrator": "アーヤ",
   "text": "嫌いじゃないけど(*^^*)"
  },
  {
   "location": "301/TALK",
   "narrator": "アーヤ",
   "text": "でも",
   "zh": "不过",
   "narrator_zh": "绫水"
  },
  {
   "location": "303/TALK",
   "narrator": "アーヤ",
   "text": "私が大人っぽいって言われたのって"
  },
  {
   "location": "304/TALK",
   "narrator": "アーヤ",
   "text": "きっと",
   "zh": "一定",
   "narrator_zh": "绫水"
  },
  {
   "location": "305/TALK",
   "narrator": "アーヤ",
   "text": "ううん",
   "zh": "不是的",
   "narrator_zh": "绫水"
  },
  {
   "location": "306/TALK",
   "narrator": "アーヤ",
   "text": "絶対"
  },
  {
   "location": "307/TALK",
   "narrator": "アーヤ",
   "text": "$handle$さんのおかげだと思う(*^^*)",
   "zh": "我觉得是多亏了$handle$(*^^*)",
   "narrator_zh": "绫水"
  },
  {
   "location": "309/TALK",
   "narrator": "アーヤ",
   "text": "みんなに優しくできるのは"
  },
  {
   "location": "310/TALK",
   "narrator": "アーヤ",
   "text": "貴方がいてくれるだろうな、って"
  },
  {
   "location": "311/TALK",
   "narrator": "アーヤ",
   "text": "そう思うの(*^o^*)",
   "zh": "我是这么想的(*^o^*)",
   "narrator_zh": "绫水"
  },
  {
   "location": "313/SEL",
   "narrator": "",
   "text": "アーヤは初めから優しかった",
   "zh": "绫水从一开始就很温柔",
   "narrator_zh": ""
  },
  {
   "location": "314/ACT",
   "narrator": "",
   "text": "アーヤは初めから優しかった",
   "zh": "绫水从一开始就很温柔",
   "narrator_zh": ""
  },
  {
   "location": "317/TALK",
   "narrator": "アーヤ",
   "text": "それなら",
   "zh": "那样的话",
   "narrator_zh": "绫水"
  },
  {
   "location": "318/TALK",
   "narrator": "アーヤ",
   "text": "もっともっと優しくなれるように頑張る(￣∇￣*)ゞ"
  },
  {
   "location": "319/TALK",
   "narrator": "アーヤ",
   "text": "だから",
   "zh": "所以",
   "narrator_zh": "绫水"
  },
  {
   "location": "320/TALK",
   "narrator": "アーヤ",
   "text": "これからも一緒にいてね",
   "zh": "今后也要一直在我身边哦",
   "narrator_zh": "绫水"
  },
  {
   "location": "332/TALK",
   "narrator": "アーヤ",
   "text": "…………。"
  },
  {
   "location": "334/TALK",
   "narrator": "アーヤ",
   "text": "っ～～～～～～～～～！！",
   "zh": "啊～～～～～～～～～！！",
   "narrator_zh": "绫水"
  },
  {
   "location": "335/TALK",
   "narrator": "アーヤ",
   "text": "最後のは、ちょっとだけ\nやり過ぎたかも…。"
  },
  {
   "location": "163/DIALOG",
   "narrator": "Dialog_EventData",
   "text": "<color=green>某月某日　 5:12 PM</color>\nとある平日の放課後、神楽坂トライナリー楽屋でのこと"
  }
 ]
}
