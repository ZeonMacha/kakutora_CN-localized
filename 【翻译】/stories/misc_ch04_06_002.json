            "narrator_zh": "雅"
        },
        {
            "location": "116/TALK",
            "narrator": "みやび",
            "text": "どうするぞね",
            "zh": "那怎么办咧",
            "narrator_zh": "雅"
        },
        {
            "location": "119/SEL",
            "narrator": "",
            "text": "安心する",
            "zh": "放心",
            "narrator_zh": ""
        },
        {
            "location": "120/SEL",
            "narrator": "",
            "text": "戸惑う",
            "zh": "不知所措",
            "narrator_zh": ""
        },
        {
            "location": "121/SEL",
            "narrator": "",
            "text": "とりあえず寝る",
            "zh": "总之先睡",
            "narrator_zh": ""
        },
        {
            "location": "122/ACT",
            "narrator": "",
            "text": "安心する",
            "zh": "放心",
            "narrator_zh": ""
        },
        {
            "location": "123/TALK",
            "narrator": "みやび",
            "text": "油断大敵",
            "zh": "疏忽是大忌",
            "narrator_zh": "雅"
        },
        {
            "location": "124/ACT",
            "narrator": "",
            "text": "戸惑う",
            "zh": "不知所措",
            "narrator_zh": ""
        },
        {
            "location": "125/TALK",
            "narrator": "みやび",
            "text": "唖然失笑",
            "zh": "目瞪口呆，又想笑",
            "narrator_zh": "雅"
        },
        {
            "location": "126/ACT",
            "narrator": "",
            "text": "とりあえず寝る",
            "zh": "总之先睡",
            "narrator_zh": ""
        },
        {
            "location": "128/TALK",
            "narrator": "みやび",
            "text": "気宇壮大",
            "zh": "气魄不小",
            "narrator_zh": "雅"
        },
        {
            "location": "129/TALK",
            "narrator": "みやび",
            "text": "それでこそ我が相棒",
            "zh": "这才是我的搭档",
            "narrator_zh": "雅"
        },
        {
            "location": "133/TALK",
            "narrator": "みやび",
            "text": "とりあえず",
            "zh": "总之",
            "narrator_zh": "雅"
        },
        {
            "location": "134/TALK",
            "narrator": "みやび",
            "text": "人が一人増えたことは",
            "zh": "多了一个人这件事",
            "narrator_zh": "雅"
        },
        {
            "location": "135/TALK",
            "narrator": "みやび",
            "text": "プラスに働きそうだと思うのだ",
            "zh": "我觉得会往好的方向起作用",
            "narrator_zh": "雅"
        },
        {
            "location": "137/SEL",
            "narrator": "",
            "text": "よかったね",
            "zh": "太好了",
            "narrator_zh": ""
        },
        {
            "location": "138/SEL",
            "narrator": "",
            "text": "不安なことがあったの？",
            "zh": "有什么不安的事吗？",
            "narrator_zh": ""
        },
        {
            "location": "139/SEL",
            "narrator": "",
            "text": "ポジティブシンキングだね",
            "zh": "这是正向思维呢",
            "narrator_zh": ""
        },
        {
            "location": "140/ACT",
            "narrator": "",
            "text": "よかったね",
            "zh": "太好了",
            "narrator_zh": ""
        },
        {
            "location": "141/TALK",
            "narrator": "みやび",
            "text": "うむ",
            "zh": "嗯",
            "narrator_zh": "雅"
        },
        {
            "location": "142/TALK",
            "narrator": "みやび",
            "text": "まあな",
            "zh": "也是",
            "narrator_zh": "雅"
        },
        {
            "location": "143/ACT",
            "narrator": "",
            "text": "不安なことがあったの？",
            "zh": "有什么不安的事吗？",
            "narrator_zh": ""
        },
        {
            "location": "144/TALK",
            "narrator": "みやび",
            "text": "ないわけがない",
            "zh": "怎么会没有",
            "narrator_zh": "雅"
        },
        {
            "location": "145/TALK",
            "narrator": "みやび",
            "text": "そうは思わんか",
            "zh": "你不这么觉得咩",
            "narrator_zh": "雅"
        },
        {
            "location": "146/ACT",
            "narrator": "",
            "text": "ポジティブシンキングだね",
            "zh": "这是正向思维呢",
            "narrator_zh": ""
        },
        {
            "location": "147/TALK",
            "narrator": "みやび",
            "text": "闇雲なポジティブさは",
            "zh": "瞎积极",
            "narrator_zh": "雅"
        },
        {
            "location": "148/TALK",
            "narrator": "みやび",
            "text": "危険思想に迷い込むぞ",
            "zh": "会一头钻进危险的想法里咧",
            "narrator_zh": "雅"
        },
        {
            "location": "152/TALK",
            "narrator": "みやび",
            "text": "冷静に考えれば",
            "zh": "冷静想想",
            "narrator_zh": "雅"
        },
        {
            "location": "153/TALK",
            "narrator": "みやび",
            "text": "心配したり調整したりするのは",
            "zh": "操心、调整这些事",
            "narrator_zh": "雅"
        },
        {
            "location": "154/TALK",
            "narrator": "みやび",
            "text": "うちでなく、まほさんの仕事ぞね",
            "zh": "不是我的，是真幌的工作咧",
            "narrator_zh": "雅"
        },
        {
            "location": "156/TALK",
            "narrator": "みやび",
            "text": "そんなわけで",
            "zh": "所以说",
            "narrator_zh": "雅"
        },
        {
            "location": "157/TALK",
            "narrator": "みやび",
            "text": "うちの心配は杞憂に終わったぞね",
            "zh": "我的担心到头来是杞人忧天咧",
            "narrator_zh": "雅"
        }
    ]
