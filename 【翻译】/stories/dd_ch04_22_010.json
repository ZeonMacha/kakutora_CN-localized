{
    "dir": "chap22/daydra/dd_ch04_22_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "22452",
        "cid": "miyabi",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "七五三の話",
        "title_zh": "Extra002 额外剧情",
        "sub_title_zh": "七五三的故事"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "七五三の話",
            "zh": "七五三的故事",
            "narrator_zh": ""
        },
        {
            "location": "23/TALK",
            "narrator": "アーヤ",
            "text": "あの…ごめんなさい。\n入るなって言われた\n部屋に入っちゃって。",
            "zh": "那个……对不起。\n我们闯进了说好\n不能进的房间。",
            "narrator_zh": "绫水"
        },
        {
            "location": "26/TALK",
            "narrator": "ガブリエラ",
            "text": "違う、悪いのはあたしで、\nアーヤは何も悪くは――",
            "zh": "不对，错的是我，\n绫水一点错都没有——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "28/TALK",
            "narrator": "みやび",
            "text": "もう怒っちょらんよ。",
            "zh": "已经没在生气了啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "31/TALK",
            "narrator": "みやび",
            "text": "二人とも、この部屋に\n入った責任を取って――",
            "zh": "你们两个，要为闯进\n这个房间负责——",
            "narrator_zh": "雅"
        },
        {
            "location": "32/TALK",
            "narrator": "みやび",
            "text": "この部屋で一晩を\n明かしたんやき。",
            "zh": "就在这个房间\n过上一夜啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "34/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "35/TALK",
            "narrator": "アーヤ",
            "text": "けど、驚いたわ。",
            "zh": "不过，真吓了一跳哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "37/TALK",
            "narrator": "アーヤ",
            "text": "まさかみやびの家に、\n悪霊を封じ込めている\n部屋があったなんて…。",
            "zh": "没想到雅的家里，\n居然有个封印着\n恶灵的房间……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "38/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "40/TALK",
            "narrator": "ガブリエラ",
            "text": "けど、大丈夫なの？\nまたこの部屋の中に\n入ったりして――",
            "zh": "但是，没关系吗？\n要是再进到这个\n房间里——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "41/TALK",
            "narrator": "ガブリエラ",
            "text": "悪霊が何かしてきたり\nしない？",
            "zh": "恶灵不会又跑出来\n作祟吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "42/TALK",
            "narrator": "みやび",
            "text": "…その心配はないき、\n安心してえいよ。",
            "zh": "…那种担心没得啵，\n安心就得。",
            "narrator_zh": "雅"
        },
        {
            "location": "43/TALK",
            "narrator": "ガブリエラ",
            "text": "けど…。",
            "zh": "可是……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "44/TALK",
            "narrator": "みやび",
            "text": "この部屋の本当の秘密を、\n今から二人に話す。",
            "zh": "这个房间真正的秘密，\n我现在说给你们听。",
            "narrator_zh": "雅"
        },
        {
            "location": "46/TALK",
            "narrator": "みやび",
            "text": "本当は、言わんでえいかと\n思うたけんど――",
            "zh": "本来想着，不说出来\n也好，但是——",
            "narrator_zh": "雅"
        },
        {
            "location": "47/TALK",
            "narrator": "みやび",
            "text": "うちも、ちっくと\nやり過ぎたところが\nあったき――",
            "zh": "我呢，也有些\n做得过了头的\n地方啵——",
            "narrator_zh": "雅"
        },
        {
            "location": "49/TALK",
            "narrator": "みやび",
            "text": "二人には、ちゃんと\n説明しておこうと\n思うたが。",
            "zh": "所以想着要给\n你们两个好好\n说明一下来着。",
            "narrator_zh": "雅"
        },
        {
            "location": "52/TALK",
            "narrator": "アーヤ",
            "text": "…本当の秘密って？",
            "zh": "…真正的秘密是？",
            "narrator_zh": "绫水"
        },
        {
            "location": "55/TALK",
            "narrator": "みやび",
            "text": "…この部屋はな、うちの\n妹の部屋やったんよ。",
            "zh": "…这个房间啊，以前\n是我妹妹的房间哦。",
            "narrator_zh": "雅"
        },
        {
            "location": "56/TALK",
            "narrator": "ガブリエラ",
            "text": "妹？\nみやび、妹がいるの？",
            "zh": "妹妹？\n雅，你有妹妹吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "58/TALK",
            "narrator": "みやび",
            "text": "正確には、いた、やね。\n七五三（なごみ）ゆう\n妹で――",
            "zh": "准确来说，是「曾经有」咯。\n她叫七五三（Nagomi），\n是我的妹妹——",
            "narrator_zh": "雅"
        },
        {
            "location": "59/TALK",
            "narrator": "みやび",
            "text": "うちはいつも、\nなごちゃん言うてた。",
            "zh": "我平时都是\n叫她七五的。",
            "narrator_zh": "雅"
        },
        {
            "location": "61/TALK",
            "narrator": "みやび",
            "text": "…ずっと前に、\n死んでしもうたがね。",
            "zh": "…很久以前，\n就已经死掉了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "62/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "64/TALK",
            "narrator": "アーヤ",
            "text": "病気だったの？",
            "zh": "是生病了吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "66/TALK",
            "narrator": "みやび",
            "text": "…フェノメノンに\n巻き込まれたちや。",
            "zh": "…是被PhenoMENON\n卷进去的滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "67/TALK",
            "narrator": "みやび",
            "text": "あの頃は、まだうちら\nみたいな存在もいない\n時代やったき――",
            "zh": "那时候，还没有\n我们这样的存在，\n是那样的年代啵——",
            "narrator_zh": "雅"
        },
        {
            "location": "68/TALK",
            "narrator": "みやび",
            "text": "発症したら隔離し\n巻き込まれた人間は、\n全員…。",
            "zh": "一旦发病就隔离，\n被卷进去的人，\n全部……。",
            "narrator_zh": "雅"
        },
        {
            "location": "70/TALK",
            "narrator": "アーヤ",
            "text": "…覚えてるわ。",
            "zh": "…我还记得哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "71/TALK",
            "narrator": "アーヤ",
            "text": "当時は、全員を殺すしか\nなかったのよね。",
            "zh": "那时候，只能把\n所有人杀掉。",
            "narrator_zh": "绫水"
        },
        {
            "location": "72/TALK",
            "narrator": "ガブリエラ",
            "text": "じゃあ、\nみやびの妹は…。",
            "zh": "那么，\n雅的妹妹她……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "73/TALK",
            "narrator": "みやび",
            "text": "…そういうことや。",
            "zh": "…就是这么回事。",
            "narrator_zh": "雅"
        },
        {
            "location": "74/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "76/TALK",
            "narrator": "みやび",
            "text": "この部屋、見てのとおり\n人形が沢山あるやろ？",
            "zh": "这个房间，看也看得到\n摆了很多人偶吧？",
            "narrator_zh": "雅"
        },
        {
            "location": "77/TALK",
            "narrator": "みやび",
            "text": "これな…全部、うちが\n揃えたものなが。",
            "zh": "这些呢…全部都是\n我置办齐的咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "79/TALK",
            "narrator": "みやび",
            "text": "お人形遊びが\n好きな子やったきね――",
            "zh": "她是个喜欢玩\n人偶的孩子啵——",
            "narrator_zh": "雅"
        },
        {
            "location": "80/TALK",
            "narrator": "みやび",
            "text": "うちの部屋にある程度\n置いた物を――",
            "zh": "我把放在自己房间的\n一部分东西——",
            "narrator_zh": "雅"
        },
        {
            "location": "81/TALK",
            "narrator": "みやび",
            "text": "こうして、お土産に\n持ってきて並べるように\nしてるんよ。",
            "zh": "就像这样，当作伴手礼\n带过来摆好，\n一直这么做哦。",
            "narrator_zh": "雅"
        },
        {
            "location": "83/TALK",
            "narrator": "ガブリエラ",
            "text": "…そういえば、そこに\n置いてある人形、みやびの\n部屋で見たことある。",
            "zh": "…说起来，那里摆着的\n人偶，我在雅的\n房间里见过。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "85/TALK",
            "narrator": "みやび",
            "text": "人形には、想いが宿る\nいうきね。",
            "zh": "人偶这种东西，是会\n寄宿心意的啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "86/TALK",
            "narrator": "みやび",
            "text": "ちっくとでも、うちの\n想いがなごちゃんに\n届けばえいと思うてな。",
            "zh": "哪怕只有一点点，\n只要我的心意能传到\n七五那里就好。",
            "narrator_zh": "雅"
        },
        {
            "location": "88/TALK",
            "narrator": "みやび",
            "text": "…今でもな、この部屋で\nなごちゃんと話したり――",
            "zh": "…就算现在，我还会在\n这个房间和七五说话——",
            "narrator_zh": "雅"
        },
        {
            "location": "90/TALK",
            "narrator": "みやび",
            "text": "人形遊びをしたりする\nこともある。",
            "zh": "或者玩玩人偶\n什么的。",
            "narrator_zh": "雅"
        },
        {
            "location": "91/TALK",
            "narrator": "みやび",
            "text": "そういう部屋なが。\nこの部屋はな…。",
            "zh": "就是这么个房间咯。\n这个房间啊……。",
            "narrator_zh": "雅"
        },
        {
            "location": "93/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "97/TALK",
            "narrator": "アーヤ",
            "text": "…どうして？",
            "zh": "…为什么？",
            "narrator_zh": "绫水"
        },
        {
            "location": "98/TALK",
            "narrator": "アーヤ",
            "text": "どうして、そのことを\n最初に言ってくれな\nかったの？",
            "zh": "为什么，这样的事\n一开始不肯\n告诉我们呢？",
            "narrator_zh": "绫水"
        },
        {
            "location": "101/TALK",
            "narrator": "みやび",
            "text": "なんでって…\n普通そんな話聞いたら\nドン引きやろ？",
            "zh": "怎么问起这个……\n正常人听了这种话\n都会吓跑是没是？",
            "narrator_zh": "雅"
        },
        {
            "location": "102/TALK",
            "narrator": "みやび",
            "text": "普通の人には、\n理解できる話やないし。",
            "zh": "对普通人来说，\n也不是能理解的事。",
            "narrator_zh": "雅"
        },
        {
            "location": "103/TALK",
            "narrator": "ガブリエラ",
            "text": "…何言ってるのよ。",
            "zh": "…你在说什么啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "106/TALK",
            "narrator": "ガブリエラ",
            "text": "そんなことで、引いたり\nなんかしないわよ。",
            "zh": "我才不会因为这种事\n就疏远你哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "108/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "111/TALK",
            "narrator": "アーヤ",
            "text": "ごめんね、みやび…\nそんな大切な部屋だ\nなんて、知らなくて――",
            "zh": "对不起，雅……\n不知道这房间对你\n这么重要——",
            "narrator_zh": "绫水"
        },
        {
            "location": "112/TALK",
            "narrator": "アーヤ",
            "text": "あなたの大切な場所を、\n踏みにじるようなこと\nして…。",
            "zh": "却对你珍视的地方，\n做出了像践踏\n一样的事……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "115/TALK",
            "narrator": "ガブリエラ",
            "text": "…ごめんなさい。",
            "zh": "……对不起。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "118/TALK",
            "narrator": "みやび",
            "text": "…大袈裟やね。",
            "zh": "…太夸张了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "120/TALK",
            "narrator": "みやび",
            "text": "ほら、もうえいから、\n涙拭きぃ。",
            "zh": "好啦，得咯，\n快把眼泪擦一擦。",
            "narrator_zh": "雅"
        },
        {
            "location": "121/TALK",
            "narrator": "みやび",
            "text": "わかってもらえたなら、\nそれでえいよ。",
            "zh": "你们能明白的话，\n就得咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "124/TALK",
            "narrator": "アーヤ",
            "text": "…うん。",
            "zh": "…嗯。",
            "narrator_zh": "绫水"
        },
        {
            "location": "126/TALK",
            "narrator": "アーヤ",
            "text": "…あれ？",
            "zh": "…咦？",
            "narrator_zh": "绫水"
        },
        {
            "location": "128/TALK",
            "narrator": "アーヤ",
            "text": "つまり、悪霊は\nいなかった、って\nことよね？",
            "zh": "也就是说，恶灵\n根本不存在，\n是这么回事吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "129/TALK",
            "narrator": "みやび",
            "text": "もちろんや。\nなごちゃんは悪霊や\nないちや。",
            "zh": "那当然咯。\n七五才不是\n恶灵滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "132/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤ、怖がり過ぎよ。",
            "zh": "绫水，你怕得也太过头了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "134/TALK",
            "narrator": "アーヤ",
            "text": "そうじゃなくて――",
            "zh": "不是那么回事——",
            "narrator_zh": "绫水"
        },
        {
            "location": "135/TALK",
            "narrator": "アーヤ",
            "text": "私達が、悪霊が本当に\nいる、って信じたのは――",
            "zh": "我们会相信这里\n真的有恶灵，是因为——",
            "narrator_zh": "绫水"
        },
        {
            "location": "137/TALK",
            "narrator": "アーヤ",
            "text": "この部屋に入ってから、\n私達に色んな怪現象が\n起きたからなのよ？",
            "zh": "进了这个房间之后，\n我们身上发生了\n好多怪事呀？",
            "narrator_zh": "绫水"
        },
        {
            "location": "139/TALK",
            "narrator": "ガブリエラ",
            "text": "…あっ、そうよ！",
            "zh": "…啊，对哦！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "141/TALK",
            "narrator": "ガブリエラ",
            "text": "この部屋に悪霊が封じて\nあるって話がウソなら――",
            "zh": "如果封着恶灵\n这个说法是假的——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "144/TALK",
            "narrator": "ガブリエラ",
            "text": "今まであたし達に起きた\n変なことって…まさか！！",
            "zh": "我们至今碰上的\n那些怪事……难道！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "148/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "149/SEL",
            "narrator": "",
            "text": "何をやったの？",
            "zh": "你搞了什么？",
            "narrator_zh": ""
        },
        {
            "location": "150/SEL",
            "narrator": "",
            "text": "やってないことにしたら？",
            "zh": "就当没搞过？",
            "narrator_zh": ""
        },
        {
            "location": "152/TALK",
            "narrator": "みやび",
            "text": "しまった…ちっくと\n調子に乗ってイタズラ\nしまくったこと――",
            "zh": "糟了……那阵子有点\n得意忘形，恶作剧\n做过头的事——",
            "narrator_zh": "雅"
        },
        {
            "location": "153/TALK",
            "narrator": "みやび",
            "text": "すっかり忘れちょった。",
            "zh": "忘得一干二净咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "154/TALK",
            "narrator": "ガブリエラ",
            "text": "どうなのよ、みやび！？",
            "zh": "到底怎样，雅！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "162/TALK",
            "narrator": "みやび",
            "text": "正解や。\nあれは全部、うちが一人で\nやったことや。",
            "zh": "答对咯。\n那些全是我一个人\n干的事。",
            "narrator_zh": "雅"
        },
        {
            "location": "163/TALK",
            "narrator": "みやび",
            "text": "早朝や深夜に、怪奇現象に\n見えるイタズラを\n頑張って仕込んだぞね。",
            "zh": "一大早和大半夜，\n拼命布置看起来像\n灵异现象的恶作剧咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "164/TALK",
            "narrator": "みやび",
            "text": "一人でやるんは、\n結構大変だったんよ？",
            "zh": "一个人干这个，\n可是相当辛苦的哦？",
            "narrator_zh": "雅"
        },
        {
            "location": "166/TALK",
            "narrator": "アーヤ",
            "text": "あ、あのねぇ…。\nいくら何でも、ちょっと\nやり過ぎよ。",
            "zh": "那、那个我说你啊……\n再怎么说，也做得\n有点过头了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "167/TALK",
            "narrator": "みやび",
            "text": "アーヤはともかく、\nガブちゃんはオカルトを\n信じとらんき――",
            "zh": "绫水就先不论，加布\n你本来就不信这些\n灵异玩意啵——",
            "narrator_zh": "雅"
        },
        {
            "location": "168/TALK",
            "narrator": "みやび",
            "text": "徹底的にやる必要が\nある思うたがよ。",
            "zh": "所以想着必须\n干就干到底来着。",
            "narrator_zh": "雅"
        },
        {
            "location": "169/TALK",
            "narrator": "ガブリエラ",
            "text": "やり過ぎよ！",
            "zh": "就是过头了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "170/TALK",
            "narrator": "ガブリエラ",
            "text": "最初は平気だったけど――",
            "zh": "最开始我还不怕——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "171/TALK",
            "narrator": "ガブリエラ",
            "text": "何度も何度も変なこと\nばっか起きて、本気で\n怖かったんだから！",
            "zh": "怪事一次又一次\n地发生，我是真的\n吓到了啊！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "172/TALK",
            "narrator": "みやび",
            "text": "けんど、おかげで\nえいこともあったやろ？",
            "zh": "但是，托这个的福\n不也有好事嘛？",
            "narrator_zh": "雅"
        },
        {
            "location": "173/TALK",
            "narrator": "ガブリエラ",
            "text": "良いことなんて\nないわよ。",
            "zh": "好事什么的\n才没有哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "175/TALK",
            "narrator": "みやび",
            "text": "あったやないか。\nもう忘れたが？",
            "zh": "明明有啵。\n这就忘咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "176/TALK",
            "narrator": "みやび",
            "text": "一晩中、アーヤとここで\nイチャイチャできたや\nないか。",
            "zh": "不是还能和绫水\n在这里腻歪\n一整晚嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "178/TALK",
            "narrator": "アーヤ",
            "text": "えっ！？",
            "zh": "诶！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "181/TALK",
            "narrator": "ガブリエラ",
            "text": "い、イチャイチャなんか\nしてないわ！",
            "zh": "谁、谁跟她\n腻歪了啊！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "184/TALK",
            "narrator": "アーヤ",
            "text": "そ、そうよ！",
            "zh": "对、对啊！",
            "narrator_zh": "绫水"
        },
        {
            "location": "185/TALK",
            "narrator": "アーヤ",
            "text": "あれは、怖がってた\nギャヴィを落ち着かせ\nようとしてただけで…。",
            "zh": "那只是想安抚\n吓坏了的\n加维而已……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "187/TALK",
            "narrator": "ガブリエラ",
            "text": "いや、違うでしょ？\n怖がってたのは\nアーヤの方じゃん。",
            "zh": "不，不对吧？\n害怕的人明明是\n绫水你那边吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "189/TALK",
            "narrator": "アーヤ",
            "text": "はぁ！？　あの時は\n明らかにあなたの方が\n怖がってたじゃない！",
            "zh": "哈！？那时候\n明显是你怕得\n更厉害吧！",
            "narrator_zh": "绫水"
        },
        {
            "location": "190/TALK",
            "narrator": "ガブリエラ",
            "text": "た、確かに怖かったけど、\nアーヤの方が絶対怖がって\nたから！",
            "zh": "我、我确实害怕了，\n但绫水你绝对\n更害怕啊！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "192/TALK",
            "narrator": "みやび",
            "text": "ここで痴話ゲンカは\nやめてもらえるか？",
            "zh": "能不能请你们\n别在这里小两口吵架？",
            "narrator_zh": "雅"
        },
        {
            "location": "193/TALK",
            "narrator": "みやび",
            "text": "なごちゃんの教育に\n悪いきね。",
            "zh": "对七五的教育\n不好啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "195/TALK",
            "narrator": "アーヤ",
            "text": "痴話ゲンカじゃないから！",
            "zh": "才不是小两口吵架！",
            "narrator_zh": "绫水"
        },
        {
            "location": "197/TALK",
            "narrator": "ガブリエラ",
            "text": "変なこと言わないで！",
            "zh": "别说奇怪的话！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "199/TALK",
            "narrator": "みやび",
            "text": "やれやれ…。\nまあ、見てて楽しくは\nあるけんどね。",
            "zh": "哎呀哎呀……。\n不过，看着还挺\n有意思的咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "202/TALK",
            "narrator": "みやび",
            "text": "…なごちゃんも、\n楽しい思うてくれてる\nとえいな…。",
            "zh": "…要是七五也\n觉得开心就好\n了咯……。",
            "narrator_zh": "雅"
        },
        {
            "location": "203/ACT",
            "narrator": "",
            "text": "何をやったの？",
            "zh": "你搞了什么？",
            "narrator_zh": ""
        },
        {
            "location": "223/TALK",
            "narrator": "みやび",
            "text": "悪霊の存在を信じさせよう思うて",
            "zh": "想让她们相信恶灵是真的",
            "narrator_zh": "雅"
        },
        {
            "location": "224/TALK",
            "narrator": "みやび",
            "text": "それっぽいイタズラをちっくとな",
            "zh": "就搞了点像模像样的恶作剧",
            "narrator_zh": "雅"
        },
        {
            "location": "236/ACT",
            "narrator": "",
            "text": "やってないことにしたら？",
            "zh": "就当没搞过？",
            "narrator_zh": ""
        },
        {
            "location": "255/TALK",
            "narrator": "みやび",
            "text": "面白そうやけんど",
            "zh": "是蛮有意思的没错，但是",
            "narrator_zh": "雅"
        },
        {
            "location": "256/TALK",
            "narrator": "みやび",
            "text": "多分、ウソ言うてもバレると思うんよ",
            "zh": "我觉得就算撒谎，多半也会被看穿哦",
            "narrator_zh": "雅"
        },
        {
            "location": "269/TALK",
            "narrator": "ガブリエラ",
            "text": "あれって全部、\nあんたの仕業だったの！？",
            "zh": "那些全都是，\n你搞的鬼！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "270/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "273/TALK",
            "narrator": "みやび",
            "text": "うちは何もしとらんがよ。",
            "zh": "我可是什么都没干哦。",
            "narrator_zh": "雅"
        },
        {
            "location": "275/TALK",
            "narrator": "みやび",
            "text": "けんど、二人が悪いこと\nしたんは事実やき――",
            "zh": "但是，你们两个干了\n坏事是事实啵——",
            "narrator_zh": "雅"
        },
        {
            "location": "276/TALK",
            "narrator": "みやび",
            "text": "なごちゃんが怒って、\nめっ、てしに来たんかも\nしれんな。",
            "zh": "搞不好是七五生气了，\n跑来敲你们\n脑袋了啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "278/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "279/TALK",
            "narrator": "ガブリエラ",
            "text": "…ウソね。",
            "zh": "…是骗人的吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "280/TALK",
            "narrator": "アーヤ",
            "text": "バレバレよ。\n今時そんなオチ、\nホラー小説でもないわ。",
            "zh": "藏都藏不住哦。\n这种桥段，现在\n连恐怖小说都不用了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "284/TALK",
            "narrator": "みやび",
            "text": "…やっぱし、\nバレバレやったか。",
            "zh": "…果然，\n还是被看穿了咩。",
            "narrator_zh": "雅"
        },
        {
            "location": "285/TALK",
            "narrator": "アーヤ",
            "text": "まあ、いくらなんでも\n出来過ぎてるしね。",
            "zh": "毕竟，再怎么说\n也太巧了点嘛。",
            "narrator_zh": "绫水"
        },
        {
            "location": "286/TALK",
            "narrator": "ガブリエラ",
            "text": "っていうか、妹のせいに\nしてんじゃないわよ。",
            "zh": "倒是你，别把事情\n推给妹妹啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "287/TALK",
            "narrator": "ガブリエラ",
            "text": "あとで仏壇に向かって\n謝りなさいよ？",
            "zh": "待会儿要对着佛坛\n好好道歉哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "288/TALK",
            "narrator": "みやび",
            "text": "…そうやね。",
            "zh": "…是咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "289/TALK",
            "narrator": "アーヤ",
            "text": "いや、謝るのは私達も\n同じだから。",
            "zh": "不，要道歉的话\n我们也一样。",
            "narrator_zh": "绫水"
        },
        {
            "location": "290/TALK",
            "narrator": "アーヤ",
            "text": "部屋を覗いたり、\nドア破って入ったり\nしたんだから…。",
            "zh": "偷看了房间，\n还破门闯了\n进来……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "291/TALK",
            "narrator": "ガブリエラ",
            "text": "あ、あれはわざとじゃ\nないし！",
            "zh": "那、那又不是\n故意的！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "292/TALK",
            "narrator": "ガブリエラ",
            "text": "っていうか、一晩部屋で\n過ごしたんだから、\nそれで帳消しよ。",
            "zh": "再说，我们在房间里\n待了一整晚，\n这样就两清了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "294/TALK",
            "narrator": "アーヤ",
            "text": "なるわけないでしょ。",
            "zh": "怎么可能两清啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "295/TALK",
            "narrator": "みやび",
            "text": "そうやね",
            "zh": "是咯",
            "narrator_zh": "雅"
        },
        {
            "location": "297/TALK",
            "narrator": "みやび",
            "text": "二人とも、一晩中ここで\nイチャイチャしてた\nだけやし。",
            "zh": "你们两个，也只是在这里\n腻歪了一整晚\n而已咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "20/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>8月26日　 9:13 AM</color>\n合宿中、みやびの実家でのこと",
            "zh": "<color=green>8月26日　 9:13 AM</color>\n合宿期间，在雅的老家发生的事",
            "narrator_zh": "Dialog_EventData"
        }
    ]
}
