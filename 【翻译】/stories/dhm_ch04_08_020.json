        },
        {
            "location": "139/TALK",
            "narrator": "みやび",
            "text": "そういうこともある",
            "zh": "也是有这种事的",
            "narrator_zh": "雅"
        },
        {
            "location": "140/ACT",
            "narrator": "",
            "text": "映画に詳しくなった？",
