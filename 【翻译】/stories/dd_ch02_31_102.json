{
    "dir": "chap31/daydra/dd_ch02_31_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "31205",
        "cid": "ayami",
        "title": "005 メインストーリー",
        "sub_title": "生体認証媒体＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "生物识别媒介＜后篇＞"
    },
    "entry": [
        {
            "location": "586/TALK",
            "narrator": "みやび",
            "text": "調子はどうかね？\n締め付けすぎちゃあ\nせんかね。",
            "zh": "感觉怎么样咯？\n没有勒得太紧\n吧？",
            "narrator_zh": "雅"
        },
        {
            "location": "587/TALK",
            "narrator": "アーヤ",
            "text": "大丈夫よ。",
            "zh": "没问题哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "589/TALK",
            "narrator": "ガブリエラ",
            "text": "まさか、フェノメノンの\n外でトライコネクトする\nことになるなんてね。",
            "zh": "真没想到，竟然会在\nPhenoMENON的外面\n进行Tri-Connect呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "592/TALK",
            "narrator": "みやび",
            "text": "いんや、ここも\nフェノメノンの中やよ。",
            "zh": "不对，这里也\n还在PhenoMENON里面咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "594/TALK",
            "narrator": "ガブリエラ",
            "text": "あ、そっか…。\nもーっ、ややこしいわね！",
            "zh": "啊，也是哦……。\n真是的，太绕人了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "595/TALK",
            "narrator": "真幌",
            "text": "ほら、\n無駄話はお終いだ。",
            "zh": "好了，\n闲话到此为止。",
            "narrator_zh": "真幌"
        },
        {
            "location": "597/TALK",
            "narrator": "アーヤ",
            "text": "…準備完了です。",
            "zh": "……准备完成了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "598/TALK",
            "narrator": "真幌",
            "text": "首の後ろにある\nコネクタは接続したか？",
            "zh": "脖子后面的\n连接器接上了吗？",
            "narrator_zh": "真幌"
        },
        {
            "location": "600/TALK",
            "narrator": "アーヤ",
            "text": "はい…。",
            "zh": "嗯……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "601/TALK",
            "narrator": "真幌",
            "text": "よし。\n……頼んだぞ。",
            "zh": "好。\n……拜托你了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "607/TALK",
            "narrator": "ガブリエラ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "608/TALK",
            "narrator": "真幌",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "610/TALK",
            "narrator": "みやび",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "雅"
        },
        {
            "location": "611/TALK",
            "narrator": "アーヤ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "612/TALK",
            "narrator": "真幌",
            "text": "……ふう。",
            "zh": "……呼。",
            "narrator_zh": "真幌"
        },
        {
            "location": "613/TALK",
            "narrator": "真幌",
            "text": "ダイブできた\nみたいだな。",
            "zh": "看来是成功\n潜入进去了啊。",
            "narrator_zh": "真幌"
        },
        {
            "location": "614/TALK",
            "narrator": "みやび",
            "text": "……生体モニターは\n正常範囲内\nみたいですね。",
            "zh": "……生理监测仪\n看起来都在\n正常范围内呢。",
            "narrator_zh": "雅"
        },
        {
            "location": "615/TALK",
            "narrator": "みやび",
            "text": "ガブちゃん。\nこっちのモニター\n監視しといて。",
            "zh": "加布。\n帮我盯着这边的\n监测仪。",
            "narrator_zh": "雅"
        },
        {
            "location": "617/TALK",
            "narrator": "ガブリエラ",
            "text": "…えと…\n何見ればいいのかしら？",
            "zh": "……那个……\n我要看什么才好呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "619/TALK",
            "narrator": "みやび",
            "text": "大したことはないき。\n標準値から外れたら\n数値が赤くなる。",
            "zh": "没得什么难的啵。\n数值偏离标准值\n就会变红。",
            "narrator_zh": "雅"
        },
        {
            "location": "620/TALK",
            "narrator": "ガブリエラ",
            "text": "…わかったわ。",
            "zh": "……我知道了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "622/TALK",
            "narrator": "みやび",
            "text": "うちはこっちで\n中が覗けんかどうか\n試してみるきね。",
            "zh": "我在这边\n试试看能不能窥探里面\n啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "655/TALK",
            "narrator": "アーヤ",
            "text": "ダイブ成功したみたいね。",
            "zh": "看来是潜入成功了呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "656/TALK",
            "narrator": "アーヤ",
            "text": "まずはサイクロトロンの\n再起動……。",
            "zh": "首先是重启\n回旋加速器……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "659/TALK",
            "narrator": "アーヤ",
            "text": "それから音羽と\nコンタクトを\n取る……。",
            "zh": "然后是与音羽\n取得\n联系……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "661/TALK",
            "narrator": "アーヤ",
            "text": "…だけど私に音羽を\n説得することが\nできるんだろうか…。",
            "zh": "……可是我真的能\n说服音羽\n吗……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "662/SEL",
            "narrator": "",
            "text": "来たね",
            "zh": "来了呢",
            "narrator_zh": ""
        },
        {
            "location": "663/ACT",
            "narrator": "",
            "text": "来たね",
            "zh": "来了呢",
            "narrator_zh": ""
        },
        {
            "location": "666/TALK",
            "narrator": "アーヤ",
            "text": "$handle$さん？",
            "zh": "$handle$？",
            "narrator_zh": "绫水"
        },
        {
            "location": "667/SEL",
            "narrator": "",
            "text": "うん",
            "zh": "嗯",
            "narrator_zh": ""
        },
        {
            "location": "668/SEL",
            "narrator": "",
            "text": "ちゃんといるでしょ",
            "zh": "我一直都在哦",
            "narrator_zh": ""
        },
        {
            "location": "669/SEL",
            "narrator": "",
            "text": "それはどうかな…",
            "zh": "这可不好说……",
            "narrator_zh": ""
        },
        {
            "location": "670/ACT",
            "narrator": "",
            "text": "うん",
            "zh": "嗯",
            "narrator_zh": ""
        },
        {
            "location": "672/TALK",
            "narrator": "アーヤ",
            "text": "すごい！\n本当に来てくれたのね。",
            "zh": "太厉害了！\n你真的过来了呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "673/ACT",
            "narrator": "",
            "text": "ちゃんといるでしょ",
            "zh": "我一直都在哦",
            "narrator_zh": ""
        },
        {
            "location": "675/TALK",
            "narrator": "アーヤ",
            "text": "そうね。\n驚いたわ。",
            "zh": "是啊。\n真是吓了一跳。",
            "narrator_zh": "绫水"
        },
        {
            "location": "676/ACT",
            "narrator": "",
            "text": "それはどうかな…",
            "zh": "这可不好说……",
            "narrator_zh": ""
        },
        {
            "location": "677/TALK",
            "narrator": "アーヤ",
            "text": "やめてよ\nこわいから！",
            "zh": "别这样\n很吓人的！",
            "narrator_zh": "绫水"
        },
        {
            "location": "679/TALK",
            "narrator": "アーヤ",
            "text": "これから音羽を\n説得しないと\nいけないんだけど。",
            "zh": "接下来我必须\n说服音羽\n才行。",
            "narrator_zh": "绫水"
        },
        {
            "location": "680/TALK",
            "narrator": "アーヤ",
            "text": "結構プレッシャーなの。",
            "zh": "压力还挺大的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "681/SEL",
            "narrator": "",
            "text": "アーヤならできるよ",
            "zh": "绫水的话一定能做到的",
            "narrator_zh": ""
        },
        {
            "location": "682/SEL",
            "narrator": "",
            "text": "なんで？",
            "zh": "为什么？",
            "narrator_zh": ""
        },
        {
            "location": "683/SEL",
            "narrator": "",
            "text": "そうだろうね…",
            "zh": "也是呢……",
            "narrator_zh": ""
        },
        {
            "location": "684/ACT",
            "narrator": "",
            "text": "アーヤならできるよ",
            "zh": "绫水的话一定能做到的",
            "narrator_zh": ""
        },
        {
            "location": "685/TALK",
            "narrator": "アーヤ",
            "text": "そんな気がしないの。",
            "zh": "我觉得自己做不到。",
            "narrator_zh": "绫水"
        },
        {
            "location": "686/ACT",
            "narrator": "",
            "text": "なんで？",
            "zh": "为什么？",
            "narrator_zh": ""
        },
        {
            "location": "687/TALK",
            "narrator": "アーヤ",
            "text": "なんでって……。",
            "zh": "要说为什么……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "688/ACT",
            "narrator": "",
            "text": "そうだろうね…",
            "zh": "也是呢……",
            "narrator_zh": ""
        },
        {
            "location": "689/TALK",
            "narrator": "アーヤ",
            "text": "わかってくれる？",
            "zh": "你能理解我吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "691/TALK",
            "narrator": "アーヤ",
            "text": "仕方なかったとしても\n音羽を壊したのは\nトライナリーだし。",
            "zh": "哪怕当时情非得已，\n毁掉音羽的也是\n三重奏。",
            "narrator_zh": "绫水"
        },
        {
            "location": "692/TALK",
            "narrator": "アーヤ",
            "text": "その後も\n卯月のこととか\nあったし……。",
            "zh": "之后又发生了\n卯月的事\n……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "693/TALK",
            "narrator": "アーヤ",
            "text": "恨まれてても\n仕方ないでしょ。",
            "zh": "被她怨恨\n也是理所当然的吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "694/TALK",
            "narrator": "アーヤ",
            "text": "それに、\nこっちの都合ばっかり\n押し付けるみたいだし。",
            "zh": "而且，\n感觉全都是把我们这边的\n要求强加给她。",
            "narrator_zh": "绫水"
        },
        {
            "location": "697/TALK",
            "narrator": "アーヤ",
            "text": "どう言えばいいのか…。",
            "zh": "该怎么开口才好呢……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "698/SEL",
            "narrator": "",
            "text": "難しいよね",
            "zh": "确实很难呢",
            "narrator_zh": ""
        },
        {
            "location": "699/SEL",
            "narrator": "",
            "text": "大変な役だよね",
            "zh": "真是件苦差事呢",
            "narrator_zh": ""
        },
        {
            "location": "700/ACT",
            "narrator": "",
            "text": "難しいよね",
            "zh": "确实很难呢",
            "narrator_zh": ""
        },
        {
            "location": "702/TALK",
            "narrator": "アーヤ",
            "text": "そうなのよ…。",
            "zh": "是啊……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "703/ACT",
            "narrator": "",
            "text": "大変な役だよね",
            "zh": "真是件苦差事呢",
            "narrator_zh": ""
        },
        {
            "location": "705/TALK",
            "narrator": "アーヤ",
            "text": "わかってくれる？",
            "zh": "你能理解我吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "707/SEL",
            "narrator": "",
            "text": "$me$が代わろうか？",
            "zh": "要不$me$替你去说吧？",
            "narrator_zh": ""
        },
        {
            "location": "708/SEL",
            "narrator": "",
            "text": "$me$にやらせてよ",
            "zh": "交给$me$来吧",
            "narrator_zh": ""
        },
        {
            "location": "709/ACT",
            "narrator": "",
            "text": "$me$が代わろうか？",
            "zh": "要不$me$替你去说吧？",
            "narrator_zh": ""
        },
        {
            "location": "712/TALK",
            "narrator": "アーヤ",
            "text": "え？",
            "zh": "哎？",
            "narrator_zh": "绫水"
        },
        {
            "location": "713/ACT",
            "narrator": "",
            "text": "$me$にやらせてよ",
            "zh": "交给$me$来吧",
            "narrator_zh": ""
        },
        {
            "location": "716/TALK",
            "narrator": "アーヤ",
            "text": "本気で言ってる？",
            "zh": "你是认真的吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "718/SEL",
            "narrator": "",
            "text": "本気だよ",
            "zh": "我是认真的",
            "narrator_zh": ""
        },
        {
            "location": "719/SEL",
            "narrator": "",
            "text": "だってアーヤ辛いでしょ",
            "zh": "因为绫水会很难受吧",
            "narrator_zh": ""
        },
        {
            "location": "720/ACT",
            "narrator": "",
            "text": "本気だよ",
            "zh": "我是认真的",
            "narrator_zh": ""
        },
        {
            "location": "721/TALK",
            "narrator": "アーヤ",
            "text": "それは……。",
            "zh": "这……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "723/TALK",
            "narrator": "アーヤ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "725/TALK",
            "narrator": "アーヤ",
            "text": "でもやっぱり\nやめておくわね。",
            "zh": "不过果然\n还是算了吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "726/ACT",
            "narrator": "",
            "text": "だってアーヤ辛いでしょ",
            "zh": "因为绫水会很难受吧",
            "narrator_zh": ""
        },
        {
            "location": "727/TALK",
            "narrator": "アーヤ",
            "text": "……辛いわ。",
            "zh": "……是很难受。",
            "narrator_zh": "绫水"
        },
        {
            "location": "729/TALK",
            "narrator": "アーヤ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "731/TALK",
            "narrator": "アーヤ",
            "text": "当たり前よ。\nだけど大丈夫。",
            "zh": "那是当然的。\n不过没关系。",
            "narrator_zh": "绫水"
        },
        {
            "location": "733/TALK",
            "narrator": "アーヤ",
            "text": "私がリーダーだもの、\nどうにかするわ。",
            "zh": "毕竟我是队长，\n总会想到办法的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "734/TALK",
            "narrator": "アーヤ",
            "text": "ちゃんと説明して\nわかってもらう。",
            "zh": "我会好好说明，\n争取让她理解。",
            "narrator_zh": "绫水"
        },
        {
            "location": "736/TALK",
            "narrator": "アーヤ",
            "text": "でもすごく\nうれしかったわ。\n本当にありがとう。",
            "zh": "不过我真的\n很开心。\n真的谢谢你。",
            "narrator_zh": "绫水"
        },
        {
            "location": "739/TALK",
            "narrator": "アーヤ",
            "text": "如月音羽さん、\n聞こえる？",
            "zh": "如月音羽，\n能听见吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "740/TALK",
            "narrator": "アーヤ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "741/TALK",
            "narrator": "音羽",
            "text": "はい。",
            "zh": "听得见。",
            "narrator_zh": "音羽"
        },
        {
            "location": "743/TALK",
            "narrator": "アーヤ",
            "text": "…どこにいるの？",
            "zh": "……你在哪里？",
            "narrator_zh": "绫水"
        },
        {
            "location": "744/TALK",
            "narrator": "音羽",
            "text": "姿を見せるのは\n多分無理。",
            "zh": "大概没办法\n现出形态。",
            "narrator_zh": "音羽"
        },
        {
            "location": "745/TALK",
            "narrator": "アーヤ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "746/TALK",
            "narrator": "音羽",
            "text": "ああ。\n誤解しないで\nください。",
            "zh": "啊。\n请别\n误会。",
            "narrator_zh": "音羽"
        },
        {
            "location": "747/TALK",
            "narrator": "音羽",
            "text": "この空間で私は\n形になれないだけ。\nでも声は伝えられる。",
            "zh": "我只是在这片空间里\n无法成形而已。\n但声音还是能传过去的。",
            "narrator_zh": "音羽"
        },
        {
            "location": "750/TALK",
            "narrator": "アーヤ",
            "text": "無理をさせて\nごめんなさい。",
            "zh": "让你勉强自己了，\n对不起。",
            "narrator_zh": "绫水"
        },
        {
            "location": "751/TALK",
            "narrator": "音羽",
            "text": "……いえ。",
            "zh": "……没事。",
            "narrator_zh": "音羽"
        },
        {
            "location": "752/TALK",
            "narrator": "アーヤ",
            "text": "もうひとつ\n謝らないと\nいけないことがあるわ。",
            "zh": "还有一件事\n我必须向你\n道歉才行。",
            "narrator_zh": "绫水"
        },
        {
            "location": "753/TALK",
            "narrator": "アーヤ",
            "text": "あなたを壊して\nごめんなさい。",
            "zh": "毁掉了你，\n真的很对不起。",
            "narrator_zh": "绫水"
        },
        {
            "location": "754/TALK",
            "narrator": "音羽",
            "text": "…でもそれは…。",
            "zh": "……可那件事……。",
            "narrator_zh": "音羽"
        },
        {
            "location": "756/TALK",
            "narrator": "アーヤ",
            "text": "つばめがあなたを\n壊したことをリーダー\nとして謝罪するわ。",
            "zh": "燕毁掉了你的事，\n我作为队长\n向你谢罪。",
            "narrator_zh": "绫水"
        },
        {
            "location": "758/TALK",
            "narrator": "アーヤ",
            "text": "本当にごめんなさい。",
            "zh": "真的非常对不起。",
            "narrator_zh": "绫水"
        },
        {
            "location": "759/TALK",
            "narrator": "音羽",
            "text": "それについて\n謝らないといけないのは\nこちらの方です。",
            "zh": "关于那件事，\n该道歉的\n其实是我这边。",
            "narrator_zh": "音羽"
        },
        {
            "location": "760/TALK",
            "narrator": "音羽",
            "text": "あの時は神楽のために\nつばめさんを殺さないと\nいけないと信じてた。",
            "zh": "那时候我深信为了神乐，\n必须杀掉\n燕不可。",
            "narrator_zh": "音羽"
        },
        {
            "location": "761/TALK",
            "narrator": "音羽",
            "text": "でもそれは誤解だった。",
            "zh": "但那其实是个误会。",
            "narrator_zh": "音羽"
        },
        {
            "location": "762/TALK",
            "narrator": "音羽",
            "text": "今は知っています。\n千羽鶴のことも\nつばめさんの事情も。",
            "zh": "我现在已经知道了。\n千羽鹤的事，\n还有燕的苦衷。",
            "narrator_zh": "音羽"
        },
        {
            "location": "763/TALK",
            "narrator": "音羽",
            "text": "こちらこそ\nすみませんでした。",
            "zh": "我这边才是，\n真是对不起。",
            "narrator_zh": "音羽"
        },
        {
            "location": "766/TALK",
            "narrator": "アーヤ",
            "text": "…卯月のこと\n本当に大事に\n思っているのね。",
            "zh": "……你真的很在乎\n卯月\n呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "767/TALK",
            "narrator": "音羽",
            "text": "もちろん。",
            "zh": "那是当然。",
            "narrator_zh": "音羽"
        },
        {
            "location": "768/TALK",
            "narrator": "音羽",
            "text": "…聞いてくれますか？\n神楽の過去を。",
            "zh": "……你愿意听我说吗？\n关于神乐的过去。",
            "narrator_zh": "音羽"
        },
        {
            "location": "769/TALK",
            "narrator": "アーヤ",
            "text": "え…。\nでも……。",
            "zh": "哎……。\n可是……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "770/TALK",
            "narrator": "音羽",
            "text": "あの子がなぜ\n裏切らざるを\n得なかったか。",
            "zh": "那孩子为什么\n不得不选择\n背叛。",
            "narrator_zh": "音羽"
        },
        {
            "location": "771/TALK",
            "narrator": "音羽",
            "text": "その理由を\n知ってほしいんです。",
            "zh": "我希望大家能知道\n其中的理由。",
            "narrator_zh": "音羽"
        },
        {
            "location": "772/TALK",
            "narrator": "音羽",
            "text": "親友として。",
            "zh": "作为她的挚友。",
            "narrator_zh": "音羽"
        },
        {
            "location": "773/TALK",
            "narrator": "アーヤ",
            "text": "…わかったわ。",
            "zh": "……我明白了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "774/TALK",
            "narrator": "音羽",
            "text": "長い話になります。\n直接イメージを\n送ります。",
            "zh": "说来话长。\n我直接把影像\n传过去。",
            "narrator_zh": "音羽"
        },
        {
            "location": "784/TALK",
            "narrator": "アーヤ",
            "text": "…どうしてあなたが\nそんなことを\n知っているの？",
            "zh": "……为什么你\n会知道\n这些事？",
            "narrator_zh": "绫水"
        },
        {
            "location": "785/TALK",
            "narrator": "音羽",
            "text": "神楽本人から\n聞いたんです。\nライブの前に会った時に。",
            "zh": "是神乐亲口\n告诉我的。\n在演唱会前见面的时候。",
            "narrator_zh": "音羽"
        },
        {
            "location": "786/TALK",
            "narrator": "音羽",
            "text": "その時警告されたんです。\n神楽自身に。",
            "zh": "当时她警告过我。\n是神乐亲口说的。",
            "narrator_zh": "音羽"
        },
        {
            "location": "787/TALK",
            "narrator": "音羽",
            "text": "命の危険があるから\nライブには来るなって。",
            "zh": "说会有生命危险，\n叫我千万别去演唱会。",
            "narrator_zh": "音羽"
        },
        {
            "location": "788/TALK",
            "narrator": "音羽",
            "text": "でもわたしは行って。\n神楽の辛さを感じた。",
            "zh": "但我还是去了。\n感受到了神乐的痛苦。",
            "narrator_zh": "音羽"
        },
        {
            "location": "789/TALK",
            "narrator": "音羽",
            "text": "自分が代わって\nあげられたらと思った。\nそして発症した。",
            "zh": "我当时想着要是能\n替她分担就好了。\n然后就发作了。",
            "narrator_zh": "音羽"
        },
        {
            "location": "790/TALK",
            "narrator": "アーヤ",
            "text": "そうだったの…。",
            "zh": "原来是这样……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "791/TALK",
            "narrator": "音羽",
            "text": "私が警告を素直に\n聞いていたら。",
            "zh": "要是我当时老实\n听从了她的警告。",
            "narrator_zh": "音羽"
        },
        {
            "location": "792/TALK",
            "narrator": "音羽",
            "text": "今のような状態には\nなっていないはず。",
            "zh": "应该就不会变成\n现在这个样子了。",
            "narrator_zh": "音羽"
        },
        {
            "location": "793/TALK",
            "narrator": "アーヤ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "794/TALK",
            "narrator": "アーヤ",
            "text": "ひとつ、お願いしたい\nことがあるの。",
            "zh": "有一件事，\n我想拜托你。",
            "narrator_zh": "绫水"
        },
        {
            "location": "795/TALK",
            "narrator": "アーヤ",
            "text": "私たちと一緒に\n千羽鶴と\n戦ってほしい。",
            "zh": "希望你能和我们一起\n对抗\n千羽鹤。",
            "narrator_zh": "绫水"
        },
        {
            "location": "796/TALK",
            "narrator": "音羽",
            "text": "元からその\nつもりでした。",
            "zh": "我原本就是\n这么打算的。",
            "narrator_zh": "音羽"
        },
        {
            "location": "797/TALK",
            "narrator": "アーヤ",
            "text": "でもそのためには\n現実世界のあなたを\n修復する必要がある。",
            "zh": "不过为了做到这一点，\n必须先修复\n现实世界的你。",
            "narrator_zh": "绫水"
        },
        {
            "location": "798/TALK",
            "narrator": "アーヤ",
            "text": "そして修復のために\nあなたの心を一度\n全て委ねてもらう。",
            "zh": "而且为了进行修复，\n需要你暂时把心\n全部托付给我们。",
            "narrator_zh": "绫水"
        },
        {
            "location": "799/TALK",
            "narrator": "アーヤ",
            "text": "…簡単なことでは\nないはずよ。",
            "zh": "……这应该不是一件\n容易做到的事。",
            "narrator_zh": "绫水"
        },
        {
            "location": "800/TALK",
            "narrator": "音羽",
            "text": "はい。\nその通りです。",
            "zh": "是的。\n您说得没错。",
            "narrator_zh": "音羽"
        },
        {
            "location": "801/TALK",
            "narrator": "音羽",
            "text": "ただ、\n覚悟はできています。",
            "zh": "只是，\n我已经做好觉悟了。",
            "narrator_zh": "音羽"
        },
        {
            "location": "802/TALK",
            "narrator": "音羽",
            "text": "…そちらの準備は\nいかがですか？",
            "zh": "……您那边准备\n得如何了？",
            "narrator_zh": "音羽"
        },
        {
            "location": "803/TALK",
            "narrator": "アーヤ",
            "text": "……いいわ。",
            "zh": "……好了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "804/TALK",
            "narrator": "音羽",
            "text": "では……。",
            "zh": "那么……。",
            "narrator_zh": "音羽"
        },
        {
            "location": "805/TALK",
            "narrator": "アーヤ",
            "text": "！！",
            "zh": "！！",
            "narrator_zh": "绫水"
        },
        {
            "location": "827/TALK",
            "narrator": "みやび",
            "text": "お！？",
            "zh": "哦！？",
            "narrator_zh": "雅"
        },
        {
            "location": "829/TALK",
            "narrator": "ガブリエラ",
            "text": "どうしたの？",
            "zh": "怎么了？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "831/TALK",
            "narrator": "みやび",
            "text": "向こうからこちらに\n干渉があったぞね…！",
            "zh": "那边朝这边\n发来干涉了啵……！",
            "narrator_zh": "雅"
        },
        {
            "location": "833/TALK",
            "narrator": "真幌",
            "text": "何だって？",
            "zh": "你说什么？",
            "narrator_zh": "真幌"
        },
        {
            "location": "835/TALK",
            "narrator": "みやび",
            "text": "これは音羽の\nココロの場所か…？",
            "zh": "这是音羽\n心灵的位置吗……？",
            "narrator_zh": "雅"
        },
        {
            "location": "836/TALK",
            "narrator": "真幌",
            "text": "やったな！",
            "zh": "太好了！",
            "narrator_zh": "真幌"
        },
        {
            "location": "837/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤが何かしたの？",
            "zh": "是绫水做了什么吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "839/TALK",
            "narrator": "真幌",
            "text": "そうだろうな。\n音羽との交渉に\n成功したんだ。",
            "zh": "应该是吧。\n她成功说服\n音羽了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "841/TALK",
            "narrator": "みやび",
            "text": "すっと解析しちゃるきね！",
            "zh": "我马上给你解析出来啵！",
            "narrator_zh": "雅"
        },
        {
            "location": "843/TALK",
            "narrator": "真幌",
            "text": "頼んだぞ。",
            "zh": "拜托你了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "844/TALK",
            "narrator": "ガブリエラ",
            "text": "…でも…。",
            "zh": "……可是……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "845/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤは目を\n覚ましてないわ…。",
            "zh": "绫水还没有\n醒过来……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "777/DIALOG",
            "narrator": "Dialog_Black",
            "text": "全ての始まりはメノウの歌。",
            "zh": "一切的开端都是MENOW的歌。",
            "narrator_zh": "Dialog_Black"
        },
        {
            "location": "778/DIALOG",
            "narrator": "Dialog_Black",
            "text": "つばめの心の中で、\nメノウの歌は希望と優しさを育み、\nそれは世界支配層の計画していた、\n\n“つばめのフェノメノンによって\n作られる予定だった\n徹底管理社会の創成”\n\nを、食い止める原因となった。",
            "zh": "在燕的心中，\nMENOW的歌孕育了希望与温柔，\n而这成了阻止世界支配层\n\n原本计划好的“通过燕的PhenoMENON\n来打造的\n彻底管理社会的诞生”\n\n的原因。",
            "narrator_zh": "Dialog_Black"
        },
        {
            "location": "779/DIALOG",
            "narrator": "Dialog_Black",
            "text": "それは支配層にとって\n都合の悪い状態だった。\n\nメノウの歌が希望であっては\nいけない。\n優しさなどあってはいけない。",
            "zh": "那对支配层来说\n是不利的状况。\n\nMENOW的歌绝对不能\n成为希望。\n绝对不能存在温柔之类的东西。",
            "narrator_zh": "Dialog_Black"
        },
        {
            "location": "780/DIALOG",
            "narrator": "Dialog_Black",
            "text": "支配層は\n神楽の父の会社を倒産させ母を壊し、\n神楽を奪った。\n\nそして\n希望の心を破壊する歌を歌わせ、\nつばめの心を破壊しようとしている。",
            "zh": "支配层\n让神乐父亲的公司破产、毁掉了她的母亲，\n夺走了神乐。\n\n然后\n让她唱出破坏希望之心的歌，\n企图以此破坏燕的心灵。",
            "narrator_zh": "Dialog_Black"
        },
        {
            "location": "781/DIALOG",
            "narrator": "Dialog_Black",
            "text": "でも神楽はそんなことは\n一切知らない。\n\nただ単に、\nこの繭を作って日本を支配する\n極悪な支配者、\n逢瀬つばめを破壊するよう\n言われているだけ。",
            "zh": "但神乐对这些事\n一无所知。\n\n她只是单纯地，\n被告知要去破坏\n那个造出这个茧来支配日本的\n极恶支配者——\n逢濑燕而已。",
            "narrator_zh": "Dialog_Black"
        },
        {
            "location": "782/DIALOG",
            "narrator": "Dialog_Black",
            "text": "だからどうか、\nそのことだけは、\nわかってあげて欲しい。",
            "zh": "所以还请无论如何，\n至少这一点，\n希望大家能够体谅她。",
            "narrator_zh": "Dialog_Black"
        },
        {
            "location": "856/DIALOG",
            "narrator": "Dialog_chapter_ch02",
            "text": "【25 ワールド・スピード】",
            "zh": "【25 World Speed】",
            "narrator_zh": "Dialog_chapter_ch02"
        }
    ]
}
