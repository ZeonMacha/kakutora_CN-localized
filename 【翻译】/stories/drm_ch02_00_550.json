        },
        {
            "location": "514/SEL",
            "narrator": "",
            "text": "$me$の心が欲しいのかい……",
            "zh": "你想要$me$的心吗……",
            "narrator_zh": ""
        },
        {
            "location": "515/SEL",
            "narrator": "",
            "text": "愛してるよセニョリータ",
            "zh": "我爱你，小姐",
