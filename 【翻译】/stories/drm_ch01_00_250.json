{
 "dir": "dramatics/daydra/drm_ch01_00_250.js",
 "type": "Episode",
 "info": {
  "story_id": "1025",
  "cid": "tsubame",
  "title": "らぶとーく 第25話",
  "sub_title": "恋する乙女のお見本は"
 },
 "entry": [
  {
   "location": "7/SCENARIO",
   "narrator": "",
   "text": "恋する乙女のお見本は"
  },
  {
   "location": "24/TALK",
   "narrator": "雛",
   "text": "つーばめちゃん！",
   "zh": "燕——！",
   "narrator_zh": "雏"
  },
  {
   "location": "27/TALK",
   "narrator": "つばめ",
   "text": "あ、ひなこちゃん。\nこの前はありがと。"
  },
  {
   "location": "28/TALK",
   "narrator": "雛",
   "text": "あー、いいのいいの。"
  },
  {
   "location": "29/TALK",
   "narrator": "雛",
   "text": "恋のキューピッドとして、\n当然のことをしたまでよ！"
  },
  {
   "location": "31/TALK",
   "narrator": "つばめ",
   "text": "ふふっ…。",
   "zh": "呵呵……",
   "narrator_zh": "燕"
  },
  {
   "location": "32/TALK",
   "narrator": "雛",
   "text": "…それで？"
  },
  {
   "location": "33/TALK",
   "narrator": "雛",
   "text": "この前のあの話から、\n何か進展はあったの？",
   "zh": "之前那件事，\n有什么进展吗？",
   "narrator_zh": "雏"
  },
  {
   "location": "38/TALK",
   "narrator": "つばめ",
   "text": "うっ…そ、それが、\nその…。"
  },
  {
   "location": "39/TALK",
   "narrator": "雛",
   "text": "？"
  },
  {
   "location": "47/TALK",
   "narrator": "雛",
   "text": "えっ！？\n恋が何だかわからない！？",
   "zh": "诶！？\n连恋爱是什么都不知道！？",
   "narrator_zh": "雏"
  },
  {
   "location": "48/TALK",
   "narrator": "雛",
   "text": "つ、つばめちゃん。\nそれ、本当なの？",
   "zh": "燕、燕。\n那是真的吗？",
   "narrator_zh": "雏"
  },
  {
   "location": "51/TALK",
   "narrator": "つばめ",
   "text": "うん…驚くよね？"
  },
  {
   "location": "52/TALK",
   "narrator": "雛",
   "text": "そりゃ驚くよ…。",
   "zh": "那当然会吃惊啊……。",
   "narrator_zh": "雏"
  },
  {
   "location": "53/TALK",
   "narrator": "雛",
   "text": "思春期真っ盛り、\n恋愛大好き花の女子高生\nなのに――"
  },
  {
   "location": "55/TALK",
   "narrator": "雛",
   "text": "恋がわからないとか…\nつばめちゃんって、\nもしかして超ウブ？"
  },
  {
   "location": "58/TALK",
   "narrator": "つばめ",
   "text": "ご、ごめん…。\nそれもわからない…。",
   "zh": "对、对不起……。\n那我也不懂……。",
   "narrator_zh": "燕"
  },
  {
   "location": "61/TALK",
   "narrator": "雛",
   "text": "はぁ…ってことは、\n恋がどういうものかを\n教えるところからだね…。",
   "zh": "唉……也就是说，\n得从教恋爱是什么\n开始呢……。",
   "narrator_zh": "雏"
  },
  {
   "location": "63/TALK",
   "narrator": "つばめ",
   "text": "やっぱり、難しいよね？"
  },
  {
   "location": "64/TALK",
   "narrator": "雛",
   "text": "うーん…。",
   "zh": "嗯……",
   "narrator_zh": "雏"
  },
  {
   "location": "66/TALK",
   "narrator": "雛",
   "text": "…ガブリエラちゃん、\nかな？",
   "zh": "……是加布里埃拉\n吗？",
   "narrator_zh": "雏"
  },
  {
   "location": "67/TALK",
   "narrator": "つばめ",
   "text": "ガブちゃん？"
  },
  {
   "location": "68/TALK",
   "narrator": "雛",
   "text": "うん。\n多分、これが一番\nわかりやすいと思うよー。"
  },
  {
   "location": "69/TALK",
   "narrator": "雛",
   "text": "ガブリエラちゃんの\n態度を、よーく観察すれば\nわかるんじゃないかな？"
  },
  {
   "location": "71/TALK",
   "narrator": "つばめ",
   "text": "？　えっと…態度？"
  },
  {
   "location": "72/TALK",
   "narrator": "雛",
   "text": "うん、態度。"
  },
  {
   "location": "73/TALK",
   "narrator": "雛",
   "text": "あの子の態度を見てれば、\nもう一発で恋がどういう\nものかわかると思うよー。"
  },
  {
   "location": "75/TALK",
   "narrator": "つばめ",
   "text": "…………。"
  },
  {
   "location": "87/TALK",
   "narrator": "つばめ",
   "text": "ぁの",
   "zh": "那个",
   "narrator_zh": "燕"
  },
  {
   "location": "88/TALK",
   "narrator": "つばめ",
   "text": "ひなこちゃんの言ってることわかる？(´･ω･｀) "
  },
  {
   "location": "90/SEL",
   "narrator": "",
   "text": "ガブリエラの態度を見ろ、ってこと？",
   "zh": "是要我看加布里埃拉的态度？",
   "narrator_zh": ""
  },
  {
   "location": "91/ACT",
   "narrator": "",
   "text": "ガブリエラの態度を見ろ、ってこと？",
   "zh": "是要我看加布里埃拉的态度？",
   "narrator_zh": ""
  },
  {
   "location": "93/TALK",
   "narrator": "つばめ",
   "text": "うん",
   "zh": "嗯",
   "narrator_zh": "燕"
  },
  {
   "location": "94/TALK",
   "narrator": "つばめ",
   "text": "態度を見ろって言うけど"
  },
  {
   "location": "95/TALK",
   "narrator": "つばめ",
   "text": "どぅぃぅ態度を見ればぃぃのかな？(´・ω・`) ",
   "zh": "该看什么样的态度才好呢？(´·ω·`)",
   "narrator_zh": "燕"
  },
  {
   "location": "98/SEL",
   "narrator": "",
   "text": "つばめと接してる時の態度かな？",
   "zh": "大概是跟燕相处时的态度吧？",
   "narrator_zh": ""
  },
  {
   "location": "99/SEL",
   "narrator": "",
   "text": "男子に対する態度かな？",
   "zh": "是对男生的态度吧？",
   "narrator_zh": ""
  },
  {
   "location": "100/SEL",
   "narrator": "",
   "text": "乙女なところじゃないかな",
   "zh": "大概是有少女心的地方吧",
   "narrator_zh": ""
  },
  {
   "location": "101/ACT",
   "narrator": "",
   "text": "つばめと接してる時の態度かな？",
   "zh": "大概是跟燕相处时的态度吧？",
   "narrator_zh": ""
  },
  {
   "location": "102/TALK",
   "narrator": "つばめ",
   "text": "わかった！(๑･ㅂ･)و☆"
  },
  {
   "location": "103/TALK",
   "narrator": "つばめ",
   "text": "ぁりがと！(*´ω｀*)"
  },
  {
   "location": "115/TALK",
   "narrator": "つばめ",
   "text": "先輩っぽく徹しようと\nしてるよね？"
  },
  {
   "location": "117/TALK",
   "narrator": "雛",
   "text": "…つばめちゃん。\nどんな態度を思い浮かべ\nたの？"
  },
  {
   "location": "118/TALK",
   "narrator": "つばめ",
   "text": "わたしに対する\n態度だけど…。"
  },
  {
   "location": "120/TALK",
   "narrator": "つばめ",
   "text": "そっか、わたしも\n先輩っぽく振る舞えば\nいいんだ！",
   "zh": "这样啊，那我也只要\n表现得像个\n前辈就行了！",
   "narrator_zh": "燕"
  },
  {
   "location": "122/TALK",
   "narrator": "雛",
   "text": "はい、不正解ー！！"
  },
  {
   "location": "123/TALK",
   "narrator": "雛",
   "text": "っていうか、それもう\n恋じゃないじゃん！",
   "zh": "话说，那已经\n不叫恋爱了吧！",
   "narrator_zh": "雏"
  },
  {
   "location": "124/TALK",
   "narrator": "雛",
   "text": "恋だよ？　恋愛！！\nラヴ！！　アモーレ！！"
  },
  {
   "location": "125/TALK",
   "narrator": "雛",
   "text": "先輩とか関係ないじゃん！"
  },
  {
   "location": "126/TALK",
   "narrator": "つばめ",
   "text": "…そっか。\n確かにそうだよね。"
  },
  {
   "location": "127/TALK",
   "narrator": "雛",
   "text": "…………。"
  },
  {
   "location": "130/TALK",
   "narrator": "雛",
   "text": "ヤバいかも…。\nキューピッド、\n心が折れそうだよ…。"
  },
  {
   "location": "132/TALK",
   "narrator": "つばめ",
   "text": "じゃあ、ガブちゃんの\nどこを見るのが正解なの？"
  },
  {
   "location": "133/TALK",
   "narrator": "雛",
   "text": "…性格だよ、性格。",
   "zh": "……这就是性格呀，性格。",
   "narrator_zh": "雏"
  },
  {
   "location": "135/TALK",
   "narrator": "雛",
   "text": "ガブリエラちゃんはー、\n好きな人の前では\nどうなっちゃう？"
  },
  {
   "location": "137/TALK",
   "narrator": "つばめ",
   "text": "…………。"
  },
  {
   "location": "139/TALK",
   "narrator": "つばめ",
   "text": "ガブちゃん、誰にでも\nツンデレじゃないかな？"
  },
  {
   "location": "140/TALK",
   "narrator": "雛",
   "text": "…………。"
  },
  {
   "location": "142/TALK",
   "narrator": "つばめ",
   "text": "あ、あれ？\n間違ってないよね？"
  },
  {
   "location": "143/TALK",
   "narrator": "雛",
   "text": "…確かにそうだね。\nうん、ガブリエラちゃんは\nツンデレだよ。",
   "zh": "……确实是这样呢。\n嗯，加布里埃拉\n就是傲娇哦。",
   "narrator_zh": "雏"
  },
  {
   "location": "144/TALK",
   "narrator": "つばめ",
   "text": "つまり、ツンデレに\nなればわかる、って\nこと？",
   "zh": "也就是说，变得傲娇\n就能明白了，\n是这个意思？",
   "narrator_zh": "燕"
  },
  {
   "location": "145/TALK",
   "narrator": "雛",
   "text": "…………。"
  },
  {
   "location": "147/TALK",
   "narrator": "雛",
   "text": "…愛のキューピッド、\nやめようかな…。",
   "zh": "…爱之丘比特，\n我不干了吧…。",
   "narrator_zh": "雏"
  },
  {
   "location": "148/ACT",
   "narrator": "",
   "text": "男子に対する態度かな？",
   "zh": "是对男生的态度吧？",
   "narrator_zh": ""
  },
  {
   "location": "149/TALK",
   "narrator": "つばめ",
   "text": "そぅなの？〆(._.)ﾒﾓﾒﾓ",
   "zh": "这样吗？〆(._.)记笔记",
   "narrator_zh": "燕"
  },
  {
   "location": "150/TALK",
   "narrator": "つばめ",
   "text": "でもそれだと",
   "zh": "不过那样的话",
   "narrator_zh": "燕"
  },
  {
   "location": "151/TALK",
   "narrator": "つばめ",
   "text": "話せなくなっちゃぅんじゃなぃかな？(´・ω・｀)"
  },
  {
   "location": "162/TALK",
   "narrator": "つばめ",
   "text": "…見るところって、\nガブちゃんの男子に対する\n態度でいいの？",
   "zh": "……要说观察的地方，\n看加布对男生的\n态度就可以吗？",
   "narrator_zh": "燕"
  },
  {
   "location": "163/TALK",
   "narrator": "雛",
   "text": "うん、そうそう！"
  },
  {
   "location": "164/TALK",
   "narrator": "雛",
   "text": "それも、特別な男子に\n対しての態度だよー。",
   "zh": "那也是对特别的男生\n才有的态度哦。",
   "narrator_zh": "雏"
  },
  {
   "location": "165/TALK",
   "narrator": "つばめ",
   "text": "そっか…。",
   "zh": "是这样呀……。",
   "narrator_zh": "燕"
  },
  {
   "location": "167/TALK",
   "narrator": "つばめ",
   "text": "つまり、話をしなければ\nいいってことだね？",
   "zh": "也就是说，只要\n不开口就行？",
   "narrator_zh": "燕"
  },
  {
   "location": "168/TALK",
   "narrator": "雛",
   "text": "そこじゃないから！！",
   "zh": "不是那里啦！！",
   "narrator_zh": "雏"
  },
  {
   "location": "169/TALK",
   "narrator": "雛",
   "text": "特別な男子に対しての\n態度だってば！"
  },
  {
   "location": "170/TALK",
   "narrator": "雛",
   "text": "ほら…ガブリエラちゃんに\nとって特別な男子って、\n誰かわかるでしょ？"
  },
  {
   "location": "171/TALK",
   "narrator": "つばめ",
   "text": "ヒカルくんのこと？"
  },
  {
   "location": "172/TALK",
   "narrator": "雛",
   "text": "そうそう、それだよー。",
   "zh": "对对，就是那个——",
   "narrator_zh": "雏"
  },
  {
   "location": "174/TALK",
   "narrator": "つばめ",
   "text": "やっぱり話さないよね？"
  },
  {
   "location": "175/TALK",
   "narrator": "雛",
   "text": "…………。"
  },
  {
   "location": "177/ACT",
   "narrator": "",
   "text": "乙女なところじゃないかな",
   "zh": "大概是有少女心的地方吧",
   "narrator_zh": ""
  },
  {
   "location": "178/TALK",
   "narrator": "つばめ",
   "text": "それって見た目の話？",
   "zh": "那是外表的事？",
   "narrator_zh": "燕"
  },
  {
   "location": "180/SEL",
   "narrator": "",
   "text": "中身の話だよ",
   "zh": "说的是内在哦",
   "narrator_zh": ""
  },
  {
   "location": "181/ACT",
   "narrator": "",
   "text": "中身の話だよ",
   "zh": "说的是内在哦",
   "narrator_zh": ""
  },
  {
   "location": "183/TALK",
   "narrator": "つばめ",
   "text": "中身ってことは"
  },
  {
   "location": "184/TALK",
   "narrator": "つばめ",
   "text": "性格のことかな？(´・ω・`) "
  },
  {
   "location": "196/TALK",
   "narrator": "つばめ",
   "text": "それって、ガブちゃんの\n性格を見ろ、ってこと？",
   "zh": "那是叫我看加布的\n性格？",
   "narrator_zh": "燕"
  },
  {
   "location": "197/TALK",
   "narrator": "雛",
   "text": "そう！\nつばめちゃん大正解！",
   "zh": "对！\n燕完全答对了！",
   "narrator_zh": "雏"
  },
  {
   "location": "198/TALK",
   "narrator": "雛",
   "text": "そこまでわかれば、\nもうわかったも同然だね！",
   "zh": "知道到那一步，\n就基本等于懂了！",
   "narrator_zh": "雏"
  },
  {
   "location": "199/TALK",
   "narrator": "つばめ",
   "text": "えっ、そうなの？"
  },
  {
   "location": "200/TALK",
   "narrator": "つばめ",
   "text": "ガブちゃんの性格って、\nツンデレだよね？"
  },
  {
   "location": "201/TALK",
   "narrator": "雛",
   "text": "えっ？\nま、まあ、確かに\nそうだけど…。",
   "zh": "诶？\n也、也是，确实\n是这么回事……。",
   "narrator_zh": "雏"
  },
  {
   "location": "202/TALK",
   "narrator": "つばめ",
   "text": "じゃあ、わたしも\nガブちゃんみたいな――"
  },
  {
   "location": "203/TALK",
   "narrator": "つばめ",
   "text": "ツンデレになれば、\n恋がわかるようになるの\nかな？"
  },
  {
   "location": "204/TALK",
   "narrator": "雛",
   "text": "…………。"
  },
  {
   "location": "205/TALK",
   "narrator": "つばめ",
   "text": "あ、あれ？\nひなこちゃん？"
  },
  {
   "location": "207/TALK",
   "narrator": "雛",
   "text": "…愛のキューピッド、\nやめようかな…。",
   "zh": "…爱之丘比特，\n我不干了吧…。",
   "narrator_zh": "雏"
  },
  {
   "location": "14/DIALOG",
   "narrator": "Dialog_EventData",
   "text": "<color=green>某月某日　10:02 AM</color>\nとある平日の休み時間、学園廊下にて。"
  }
 ]
}
