{
    "dir": "dramatics/daydra/drm_ch01_00_250.js",
    "type": "Episode",
    "info": {
        "story_id": "1025",
        "cid": "tsubame",
        "title": "らぶとーく 第25話",
        "sub_title": "恋する乙女のお見本は",
        "title_zh": "恋爱漫谈 第25话",
        "sub_title_zh": "恋爱少女的范本是"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "恋する乙女のお見本は",
            "zh": "恋爱少女的范本是",
            "narrator_zh": ""
        },
        {
            "location": "24/TALK",
            "narrator": "雛",
            "text": "つーばめちゃん！",
            "zh": "燕——！",
            "narrator_zh": "雏"
        },
        {
            "location": "27/TALK",
            "narrator": "つばめ",
            "text": "あ、ひなこちゃん。\nこの前はありがと。",
            "zh": "啊，小雏。\n上次谢谢你啦。",
            "narrator_zh": "燕"
        },
        {
            "location": "28/TALK",
            "narrator": "雛",
            "text": "あー、いいのいいの。",
            "zh": "啊——不用谢不用谢。",
            "narrator_zh": "雏"
        },
        {
            "location": "29/TALK",
            "narrator": "雛",
            "text": "恋のキューピッドとして、\n当然のことをしたまでよ！",
            "zh": "身为恋爱丘比特，\n这不过是分内之事！",
            "narrator_zh": "雏"
        },
        {
            "location": "31/TALK",
            "narrator": "つばめ",
            "text": "ふふっ…。",
            "zh": "呵呵……",
            "narrator_zh": "燕"
        },
        {
            "location": "32/TALK",
            "narrator": "雛",
            "text": "…それで？",
            "zh": "……然后呢？",
            "narrator_zh": "雏"
        },
        {
            "location": "33/TALK",
            "narrator": "雛",
            "text": "この前のあの話から、\n何か進展はあったの？",
            "zh": "之前那件事，\n有什么进展吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "38/TALK",
            "narrator": "つばめ",
            "text": "うっ…そ、それが、\nその…。",
            "zh": "唔……那、那个，\n就是……。",
            "narrator_zh": "燕"
        },
        {
            "location": "39/TALK",
            "narrator": "雛",
            "text": "？",
            "zh": "？",
            "narrator_zh": "雏"
        },
        {
            "location": "47/TALK",
            "narrator": "雛",
            "text": "えっ！？\n恋が何だかわからない！？",
            "zh": "诶！？\n连恋爱是什么都不知道！？",
            "narrator_zh": "雏"
        },
        {
            "location": "48/TALK",
            "narrator": "雛",
            "text": "つ、つばめちゃん。\nそれ、本当なの？",
            "zh": "燕、燕。\n那是真的吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "51/TALK",
            "narrator": "つばめ",
            "text": "うん…驚くよね？",
            "zh": "嗯……很吃惊对吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "52/TALK",
            "narrator": "雛",
            "text": "そりゃ驚くよ…。",
            "zh": "那当然会吃惊啊……。",
            "narrator_zh": "雏"
        },
        {
            "location": "53/TALK",
            "narrator": "雛",
            "text": "思春期真っ盛り、\n恋愛大好き花の女子高生\nなのに――",
            "zh": "明明正值青春期、\n最爱恋爱的花季\n女高中生——",
            "narrator_zh": "雏"
        },
        {
            "location": "55/TALK",
            "narrator": "雛",
            "text": "恋がわからないとか…\nつばめちゃんって、\nもしかして超ウブ？",
            "zh": "却不懂什么是恋爱……\n燕你难道\n超级纯情吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "58/TALK",
            "narrator": "つばめ",
            "text": "ご、ごめん…。\nそれもわからない…。",
            "zh": "对、对不起……。\n那我也不懂……。",
            "narrator_zh": "燕"
        },
        {
            "location": "61/TALK",
            "narrator": "雛",
            "text": "はぁ…ってことは、\n恋がどういうものかを\n教えるところからだね…。",
            "zh": "唉……也就是说，\n得从教恋爱是什么\n开始呢……。",
            "narrator_zh": "雏"
        },
        {
            "location": "63/TALK",
            "narrator": "つばめ",
            "text": "やっぱり、難しいよね？",
            "zh": "果然，很难吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "64/TALK",
            "narrator": "雛",
            "text": "うーん…。",
            "zh": "嗯……",
            "narrator_zh": "雏"
        },
        {
            "location": "66/TALK",
            "narrator": "雛",
            "text": "…ガブリエラちゃん、\nかな？",
            "zh": "……是加布里埃拉\n吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "67/TALK",
            "narrator": "つばめ",
            "text": "ガブちゃん？",
            "zh": "加布？",
            "narrator_zh": "燕"
        },
        {
            "location": "68/TALK",
            "narrator": "雛",
            "text": "うん。\n多分、これが一番\nわかりやすいと思うよー。",
            "zh": "嗯。\n大概这样是最容易\n懂的啦——。",
            "narrator_zh": "雏"
        },
        {
            "location": "69/TALK",
            "narrator": "雛",
            "text": "ガブリエラちゃんの\n態度を、よーく観察すれば\nわかるんじゃないかな？",
            "zh": "只要仔细观察一下\n加布里埃拉的态度，\n不就明白了吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "71/TALK",
            "narrator": "つばめ",
            "text": "？　えっと…態度？",
            "zh": "？　那个……态度？",
            "narrator_zh": "燕"
        },
        {
            "location": "72/TALK",
            "narrator": "雛",
            "text": "うん、態度。",
            "zh": "嗯，态度。",
            "narrator_zh": "雏"
        },
        {
            "location": "73/TALK",
            "narrator": "雛",
            "text": "あの子の態度を見てれば、\nもう一発で恋がどういう\nものかわかると思うよー。",
            "zh": "只要看看那孩子的态度，\n一准就能立刻明白\n恋爱是怎么回事了——。",
            "narrator_zh": "雏"
        },
        {
            "location": "75/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "87/TALK",
            "narrator": "つばめ",
            "text": "ぁの",
            "zh": "那个",
            "narrator_zh": "燕"
        },
        {
            "location": "88/TALK",
            "narrator": "つばめ",
            "text": "ひなこちゃんの言ってることわかる？(´･ω･｀) ",
            "zh": "你听懂小雏在说什么了吗？(´･ω･｀)",
            "narrator_zh": "燕"
        },
        {
            "location": "90/SEL",
            "narrator": "",
            "text": "ガブリエラの態度を見ろ、ってこと？",
            "zh": "是要我看加布里埃拉的态度？",
            "narrator_zh": ""
        },
        {
            "location": "91/ACT",
            "narrator": "",
            "text": "ガブリエラの態度を見ろ、ってこと？",
            "zh": "是要我看加布里埃拉的态度？",
            "narrator_zh": ""
        },
        {
            "location": "93/TALK",
            "narrator": "つばめ",
            "text": "うん",
            "zh": "嗯",
            "narrator_zh": "燕"
        },
        {
            "location": "94/TALK",
            "narrator": "つばめ",
            "text": "態度を見ろって言うけど",
            "zh": "虽说让我看她的态度",
            "narrator_zh": "燕"
        },
        {
            "location": "95/TALK",
            "narrator": "つばめ",
            "text": "どぅぃぅ態度を見ればぃぃのかな？(´・ω・`) ",
            "zh": "该看什么样的态度才好呢？(´·ω·`)",
            "narrator_zh": "燕"
        },
        {
            "location": "98/SEL",
            "narrator": "",
            "text": "つばめと接してる時の態度かな？",
            "zh": "大概是跟燕相处时的态度吧？",
            "narrator_zh": ""
        },
        {
            "location": "99/SEL",
            "narrator": "",
            "text": "男子に対する態度かな？",
            "zh": "是对男生的态度吧？",
            "narrator_zh": ""
        },
        {
            "location": "100/SEL",
            "narrator": "",
            "text": "乙女なところじゃないかな",
            "zh": "大概是有少女心的地方吧",
            "narrator_zh": ""
        },
        {
            "location": "101/ACT",
            "narrator": "",
            "text": "つばめと接してる時の態度かな？",
            "zh": "大概是跟燕相处时的态度吧？",
            "narrator_zh": ""
        },
        {
            "location": "102/TALK",
            "narrator": "つばめ",
            "text": "わかった！(๑･ㅂ･)و☆",
            "zh": "明白了！(๑･ㅂ･)و☆",
            "narrator_zh": "燕"
        },
        {
            "location": "103/TALK",
            "narrator": "つばめ",
            "text": "ぁりがと！(*´ω｀*)",
            "zh": "谢谢啦！(*´ω｀*)",
            "narrator_zh": "燕"
        },
        {
            "location": "115/TALK",
            "narrator": "つばめ",
            "text": "先輩っぽく徹しようと\nしてるよね？",
            "zh": "她一直在努力装出\n前辈的样子对吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "117/TALK",
            "narrator": "雛",
            "text": "…つばめちゃん。\nどんな態度を思い浮かべ\nたの？",
            "zh": "……燕。\n你脑子里想的是\n哪种态度啊？",
            "narrator_zh": "雏"
        },
        {
            "location": "118/TALK",
            "narrator": "つばめ",
            "text": "わたしに対する\n態度だけど…。",
            "zh": "就是对我的\n态度啦……。",
            "narrator_zh": "燕"
        },
        {
            "location": "120/TALK",
            "narrator": "つばめ",
            "text": "そっか、わたしも\n先輩っぽく振る舞えば\nいいんだ！",
            "zh": "这样啊，那我也只要\n表现得像个\n前辈就行了！",
            "narrator_zh": "燕"
        },
        {
            "location": "122/TALK",
            "narrator": "雛",
            "text": "はい、不正解ー！！",
            "zh": "叮咚，答错啦——！！",
            "narrator_zh": "雏"
        },
        {
            "location": "123/TALK",
            "narrator": "雛",
            "text": "っていうか、それもう\n恋じゃないじゃん！",
            "zh": "话说，那已经\n不叫恋爱了吧！",
            "narrator_zh": "雏"
        },
        {
            "location": "124/TALK",
            "narrator": "雛",
            "text": "恋だよ？　恋愛！！\nラヴ！！　アモーレ！！",
            "zh": "是恋爱哦？　恋爱！！\nLove！！　Amore！！",
            "narrator_zh": "雏"
        },
        {
            "location": "125/TALK",
            "narrator": "雛",
            "text": "先輩とか関係ないじゃん！",
            "zh": "跟前辈不前辈的没关系嘛！",
            "narrator_zh": "雏"
        },
        {
            "location": "126/TALK",
            "narrator": "つばめ",
            "text": "…そっか。\n確かにそうだよね。",
            "zh": "……这样啊。\n确实是这样呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "127/TALK",
            "narrator": "雛",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雏"
        },
        {
            "location": "130/TALK",
            "narrator": "雛",
            "text": "ヤバいかも…。\nキューピッド、\n心が折れそうだよ…。",
            "zh": "大事不妙了……。\n丘比特的心\n快要碎了哦……。",
            "narrator_zh": "雏"
        },
        {
            "location": "132/TALK",
            "narrator": "つばめ",
            "text": "じゃあ、ガブちゃんの\nどこを見るのが正解なの？",
            "zh": "那该看加布的\n哪里才对呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "133/TALK",
            "narrator": "雛",
            "text": "…性格だよ、性格。",
            "zh": "……这就是性格呀，性格。",
            "narrator_zh": "雏"
        },
        {
            "location": "135/TALK",
            "narrator": "雛",
            "text": "ガブリエラちゃんはー、\n好きな人の前では\nどうなっちゃう？",
            "zh": "加布里埃拉她呀——，\n在喜欢的人面前\n会变成什么样？",
            "narrator_zh": "雏"
        },
        {
            "location": "137/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "139/TALK",
            "narrator": "つばめ",
            "text": "ガブちゃん、誰にでも\nツンデレじゃないかな？",
            "zh": "加布对谁不都是\n傲娇吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "140/TALK",
            "narrator": "雛",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雏"
        },
        {
            "location": "142/TALK",
            "narrator": "つばめ",
            "text": "あ、あれ？\n間違ってないよね？",
            "zh": "咦、咦？\n我没说错吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "143/TALK",
            "narrator": "雛",
            "text": "…確かにそうだね。\nうん、ガブリエラちゃんは\nツンデレだよ。",
            "zh": "……确实是这样呢。\n嗯，加布里埃拉\n就是傲娇哦。",
            "narrator_zh": "雏"
        },
        {
            "location": "144/TALK",
            "narrator": "つばめ",
            "text": "つまり、ツンデレに\nなればわかる、って\nこと？",
            "zh": "也就是说，变得傲娇\n就能明白了，\n是这个意思？",
            "narrator_zh": "燕"
        },
        {
            "location": "145/TALK",
            "narrator": "雛",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雏"
        },
        {
            "location": "147/TALK",
            "narrator": "雛",
            "text": "…愛のキューピッド、\nやめようかな…。",
            "zh": "…爱之丘比特，\n我不干了吧…。",
            "narrator_zh": "雏"
        },
        {
            "location": "148/ACT",
            "narrator": "",
            "text": "男子に対する態度かな？",
            "zh": "是对男生的态度吧？",
            "narrator_zh": ""
        },
        {
            "location": "149/TALK",
            "narrator": "つばめ",
            "text": "そぅなの？〆(._.)ﾒﾓﾒﾓ",
            "zh": "这样吗？〆(._.)记笔记",
            "narrator_zh": "燕"
        },
        {
            "location": "150/TALK",
            "narrator": "つばめ",
            "text": "でもそれだと",
            "zh": "不过那样的话",
            "narrator_zh": "燕"
        },
        {
            "location": "151/TALK",
            "narrator": "つばめ",
            "text": "話せなくなっちゃぅんじゃなぃかな？(´・ω・｀)",
            "zh": "那样不就没法说话了吗？(´・ω・｀)",
            "narrator_zh": "燕"
        },
        {
            "location": "162/TALK",
            "narrator": "つばめ",
            "text": "…見るところって、\nガブちゃんの男子に対する\n態度でいいの？",
            "zh": "……要说观察的地方，\n看加布对男生的\n态度就可以吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "163/TALK",
            "narrator": "雛",
            "text": "うん、そうそう！",
            "zh": "嗯，对对！",
            "narrator_zh": "雏"
        },
        {
            "location": "164/TALK",
            "narrator": "雛",
            "text": "それも、特別な男子に\n対しての態度だよー。",
            "zh": "那也是对特别的男生\n才有的态度哦。",
            "narrator_zh": "雏"
        },
        {
            "location": "165/TALK",
            "narrator": "つばめ",
            "text": "そっか…。",
            "zh": "是这样呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "167/TALK",
            "narrator": "つばめ",
            "text": "つまり、話をしなければ\nいいってことだね？",
            "zh": "也就是说，只要\n不开口就行？",
            "narrator_zh": "燕"
        },
        {
            "location": "168/TALK",
            "narrator": "雛",
            "text": "そこじゃないから！！",
            "zh": "不是那里啦！！",
            "narrator_zh": "雏"
        },
        {
            "location": "169/TALK",
            "narrator": "雛",
            "text": "特別な男子に対しての\n態度だってば！",
            "zh": "我说的是对特别\n男生的态度啦！",
            "narrator_zh": "雏"
        },
        {
            "location": "170/TALK",
            "narrator": "雛",
            "text": "ほら…ガブリエラちゃんに\nとって特別な男子って、\n誰かわかるでしょ？",
            "zh": "你看……对加布里埃拉\n来说特别的男生，\n你知道是谁的吧？",
            "narrator_zh": "雏"
        },
        {
            "location": "171/TALK",
            "narrator": "つばめ",
            "text": "ヒカルくんのこと？",
            "zh": "是指光吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "172/TALK",
            "narrator": "雛",
            "text": "そうそう、それだよー。",
            "zh": "对对，就是那个——",
            "narrator_zh": "雏"
        },
        {
            "location": "174/TALK",
            "narrator": "つばめ",
            "text": "やっぱり話さないよね？",
            "zh": "她果然不会去搭话吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "175/TALK",
            "narrator": "雛",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雏"
        },
        {
            "location": "177/ACT",
            "narrator": "",
            "text": "乙女なところじゃないかな",
            "zh": "大概是有少女心的地方吧",
            "narrator_zh": ""
        },
        {
            "location": "178/TALK",
            "narrator": "つばめ",
            "text": "それって見た目の話？",
            "zh": "那是外表的事？",
            "narrator_zh": "燕"
        },
        {
            "location": "180/SEL",
            "narrator": "",
            "text": "中身の話だよ",
            "zh": "说的是内在哦",
            "narrator_zh": ""
        },
        {
            "location": "181/ACT",
            "narrator": "",
            "text": "中身の話だよ",
            "zh": "说的是内在哦",
            "narrator_zh": ""
        },
        {
            "location": "183/TALK",
            "narrator": "つばめ",
            "text": "中身ってことは",
            "zh": "说的是内在的话",
            "narrator_zh": "燕"
        },
        {
            "location": "184/TALK",
            "narrator": "つばめ",
            "text": "性格のことかな？(´・ω・`) ",
            "zh": "是指性格吗？(´・ω・`)",
            "narrator_zh": "燕"
        },
        {
            "location": "196/TALK",
            "narrator": "つばめ",
            "text": "それって、ガブちゃんの\n性格を見ろ、ってこと？",
            "zh": "那是叫我看加布的\n性格？",
            "narrator_zh": "燕"
        },
        {
            "location": "197/TALK",
            "narrator": "雛",
            "text": "そう！\nつばめちゃん大正解！",
            "zh": "对！\n燕完全答对了！",
            "narrator_zh": "雏"
        },
        {
            "location": "198/TALK",
            "narrator": "雛",
            "text": "そこまでわかれば、\nもうわかったも同然だね！",
            "zh": "知道到那一步，\n就基本等于懂了！",
            "narrator_zh": "雏"
        },
        {
            "location": "199/TALK",
            "narrator": "つばめ",
            "text": "えっ、そうなの？",
            "zh": "诶，是这样吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "200/TALK",
            "narrator": "つばめ",
            "text": "ガブちゃんの性格って、\nツンデレだよね？",
            "zh": "加布的性格，\n是傲娇对吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "201/TALK",
            "narrator": "雛",
            "text": "えっ？\nま、まあ、確かに\nそうだけど…。",
            "zh": "诶？\n也、也是，确实\n是这么回事……。",
            "narrator_zh": "雏"
        },
        {
            "location": "202/TALK",
            "narrator": "つばめ",
            "text": "じゃあ、わたしも\nガブちゃんみたいな――",
            "zh": "那我只要也变得\n像加布那样——",
            "narrator_zh": "燕"
        },
        {
            "location": "203/TALK",
            "narrator": "つばめ",
            "text": "ツンデレになれば、\n恋がわかるようになるの\nかな？",
            "zh": "变成傲娇的话，\n就能明白\n什么是恋爱了吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "204/TALK",
            "narrator": "雛",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雏"
        },
        {
            "location": "205/TALK",
            "narrator": "つばめ",
            "text": "あ、あれ？\nひなこちゃん？",
            "zh": "咦、咦？\n小雏？",
            "narrator_zh": "燕"
        },
        {
            "location": "207/TALK",
            "narrator": "雛",
            "text": "…愛のキューピッド、\nやめようかな…。",
            "zh": "…爱之丘比特，\n我不干了吧…。",
            "narrator_zh": "雏"
        },
        {
