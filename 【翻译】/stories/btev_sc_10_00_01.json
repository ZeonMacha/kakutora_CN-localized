{
    "dir": "chap00/battle/btev_sc_10_00_01.js",
    "type": "",
    "info": {
        "story_id": "106",
        "cid": "",
        "title": "【EXストーリー】スーパーメナー",
        "sub_title": "コネクトストーリー",
        "title_zh": "【EX剧情】超级梅纳",
        "sub_title_zh": "连结剧情"
    },
    "entry": [
        {
            "location": "339/SCENARIO",
            "narrator": "",
            "text": "【導入】モーフィアス（ブー太郎）",
            "zh": "【导入】摩耳甫斯（胖太郎）",
            "narrator_zh": ""
        },
        {
            "location": "345/DIALOG",
            "narrator": "",
            "text": "<size=40>CURAN STORY. 01</size>\nKAGURA UZUKI\n\n<size=45>モーフィアス</size>\n<size=35>～エアプだけはありえない～</size>",
            "zh": "<size=40>CURAN STORY. 01</size>\nKAGURA UZUKI\n\n<size=45>摩耳甫斯</size>\n<size=35>～唯独绝不当云玩家～</size>",
            "narrator_zh": ""
        },
        {
            "location": "361/TALK",
            "narrator": "神楽",
            "text": "お帰りなさい、\n$handle$さま。",
            "zh": "欢迎回来，\n$handle$大人。",
            "narrator_zh": "神乐"
        },
        {
            "location": "362/TALK",
            "narrator": "神楽",
            "text": "ここは、私たち\nトライナリーと、\nクランたちとの交差点。",
            "zh": "这里是，我们\n三重奏与\n库兰们的交汇点。",
            "narrator_zh": "神乐"
        },
        {
            "location": "363/TALK",
            "narrator": "神楽",
            "text": "ココロとココロが\n出逢い、共鳴し、\nそして繋がりあう場所。",
            "zh": "心与心\n相遇、共鸣，\n进而相互连接的地方。",
            "narrator_zh": "神乐"
        },
        {
            "location": "371/SEL",
            "narrator": "（選択肢）",
            "text": "概要説明を飛ばす",
            "zh": "跳过概要说明",
            "narrator_zh": "（选项）"
        },
        {
            "location": "372/SEL",
            "narrator": "（選択肢）",
            "text": "もう一度聞く",
            "zh": "再听一遍",
            "narrator_zh": "（选项）"
        },
        {
            "location": "373/ACT",
            "narrator": "",
            "text": "概要説明を飛ばす",
            "zh": "跳过概要说明",
            "narrator_zh": ""
        },
        {
            "location": "374/TALK",
            "narrator": "神楽",
            "text": "というわけで、\n早速今回のクランを\n紹介しますね。",
            "zh": "那么，\n这就事不宜迟地来\n介绍这次的库兰哦。",
            "narrator_zh": "神乐"
        },
        {
            "location": "376/ACT",
            "narrator": "",
            "text": "もう一度聞く",
            "zh": "再听一遍",
            "narrator_zh": ""
        },
        {
            "location": "381/TALK",
            "narrator": "神楽",
            "text": "ここでは、普段私たちを\n助けてくれるサーバント\nクランを紹介いたします。",
            "zh": "在这里，要介绍平时\n帮助我们的\n从属库兰。",
            "narrator_zh": "神乐"
        },
        {
            "location": "382/TALK",
            "narrator": "神楽",
            "text": "そして、貴方が直接\n彼らと繋がれるよう、\n手続きをいたします。",
            "zh": "并且，为了让你能直接\n和他们连接上，\n会由我来办理手续。",
            "narrator_zh": "神乐"
        },
        {
            "location": "383/SEL",
            "narrator": "（選択肢）",
            "text": "ちょっと待って",
            "zh": "等一下",
            "narrator_zh": "（选项）"
        },
        {
            "location": "384/ACT",
            "narrator": "",
            "text": "ちょっと待って",
            "zh": "等一下",
            "narrator_zh": ""
        },
        {
            "location": "386/TALK",
            "narrator": "神楽",
            "text": "どうか\nなさいましたか。",
            "zh": "请问\n怎么了吗。",
            "narrator_zh": "神乐"
        },
        {
            "location": "387/SEL",
            "narrator": "（選択肢）",
            "text": "お帰りなさいって？",
            "zh": "你刚说“欢迎回来”？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "388/SEL",
            "narrator": "（選択肢）",
            "text": "来たことないんだけど、ここ",
            "zh": "可我根本没来过这地方啊",
            "narrator_zh": "（选项）"
        },
        {
            "location": "389/SEL",
            "narrator": "（選択肢）",
            "text": "どういう設定なの？",
            "zh": "这算什么设定啊？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "390/ACT",
            "narrator": "",
            "text": "お帰りなさいって？",
            "zh": "你刚说“欢迎回来”？",
            "narrator_zh": ""
        },
        {
            "location": "391/TALK",
            "narrator": "神楽",
            "text": "挨拶ですが、\nどうかなさいましたか？",
            "zh": "只是打个招呼而已，\n有什么不对吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "392/ACT",
            "narrator": "",
            "text": "来たことないんだけど、ここ",
            "zh": "可我根本没来过这地方啊",
            "narrator_zh": ""
        },
        {
            "location": "393/TALK",
            "narrator": "神楽",
            "text": "まさか\n憶えてらっしゃらない？",
            "zh": "莫非\n是你记不得了吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "394/ACT",
            "narrator": "",
            "text": "どういう設定なの？",
            "zh": "这算什么设定啊？",
            "narrator_zh": ""
        },
        {
            "location": "395/TALK",
            "narrator": "神楽",
            "text": "設定とは\n不思議なことを\nおっしゃいますね。",
            "zh": "说什么“设定”，\n你可真会说\n奇怪的话呢。",
            "narrator_zh": "神乐"
        },
        {
            "location": "397/TALK",
            "narrator": "神楽",
            "text": "ここで私が\n$handle$さまに\n伝えたいことは。",
            "zh": "此时此刻我想\n向$handle$大人\n传达的只有一件事。",
            "narrator_zh": "神乐"
        },
        {
            "location": "398/TALK",
            "narrator": "神楽",
            "text": "クランとの【儀式】\nによって、貴方とココロを\n繋げられるということ。",
            "zh": "那就是通过与库兰的【仪式】，\n能够将你与他的心\n连接起来。",
            "narrator_zh": "神乐"
        },
        {
            "location": "399/TALK",
            "narrator": "神楽",
            "text": "ここまでは\nご理解いただけ\nましたか？",
            "zh": "说到这里，\n你能理解\n了吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "400/SEL",
            "narrator": "（選択肢）",
            "text": "それはわかったけど",
            "zh": "那个我倒是懂了",
            "narrator_zh": "（选项）"
        },
        {
            "location": "401/SEL",
            "narrator": "（選択肢）",
            "text": "いや、そうじゃなくて",
            "zh": "不对，我不是说这个",
            "narrator_zh": "（选项）"
        },
        {
            "location": "402/SEL",
            "narrator": "（選択肢）",
            "text": "もういいやそれで",
            "zh": "算了就这样吧",
            "narrator_zh": "（选项）"
        },
        {
            "location": "403/ACT",
            "narrator": "",
            "text": "それはわかったけど",
            "zh": "那个我倒是懂了",
            "narrator_zh": ""
        },
        {
            "location": "404/TALK",
            "narrator": "神楽",
            "text": "ならば何も\n問題はございませんね。",
            "zh": "既然如此，那就没有任何\n问题了呢。",
            "narrator_zh": "神乐"
        },
        {
            "location": "405/ACT",
            "narrator": "",
            "text": "いや、そうじゃなくて",
            "zh": "不对，我不是说这个",
            "narrator_zh": ""
        },
        {
            "location": "406/TALK",
            "narrator": "神楽",
            "text": "何が違うのか\nわかりかねます。",
            "zh": "恕我难以明白\n究竟哪里不对。",
            "narrator_zh": "神乐"
        },
        {
            "location": "407/ACT",
            "narrator": "",
            "text": "もういいやそれで",
            "zh": "算了就这样吧",
            "narrator_zh": ""
        },
        {
            "location": "408/TALK",
            "narrator": "神楽",
            "text": "ご理解いただき\n感謝いたします。",
            "zh": "承蒙你的理解，\n不胜感激。",
            "narrator_zh": "神乐"
        },
        {
            "location": "411/TALK",
            "narrator": "神楽",
            "text": "ではお話を\n続けるとしましょう。",
            "zh": "那么就让我们\n继续往下讲吧。",
            "narrator_zh": "神乐"
        },
        {
            "location": "412/TALK",
            "narrator": "神楽",
            "text": "【儀式】には『コネクト』\nと『シンクロ』の２つが\nございます。",
            "zh": "【仪式】分为『连接』\n和『同步』\n这两个步骤。",
            "narrator_zh": "神乐"
        },
        {
            "location": "413/TALK",
            "narrator": "神楽",
            "text": "『コネクト』は、貴方と\nクランが物理的に繋がる\nための儀式となります。",
            "zh": "『连接』，是让你和\n库兰在物理层面上\n连接起来的仪式。",
            "narrator_zh": "神乐"
        },
        {
            "location": "414/TALK",
            "narrator": "神楽",
            "text": "バトルをして彼と貴方の\n中にある抵抗勢力を\n無力できれば完了です。",
            "zh": "只要通过战斗，使他与你体内的\n抵抗势力失效，\n就算完成了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "415/TALK",
            "narrator": "神楽",
            "text": "次の『シンクロ』では、\nクランの過去を知り、\n共感していただきます。",
            "zh": "接下来的『同步』，\n则是了解库兰的过去，\n并与之共情。",
            "narrator_zh": "神乐"
        },
        {
            "location": "416/TALK",
            "narrator": "神楽",
            "text": "クランの過去の\n物語をシェアすることで\n心を通わせるものです。",
            "zh": "这是通过分享库兰\n过去的经历，\n让彼此心意相通。",
            "narrator_zh": "神乐"
        },
        {
            "location": "418/TALK",
            "narrator": "神楽",
            "text": "ここまで、\nご理解いただけ\nましたでしょうか？",
            "zh": "说到这里，\n你能理解\n了吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "419/TALK",
            "narrator": "神楽",
            "text": "もし、入るセクターを\n間違えたという場合\n退場も可能ですが。",
            "zh": "如果觉得进错了\n区域的话，\n现在也可以退场哦。",
            "narrator_zh": "神乐"
        },
        {
            "location": "420/SEL",
            "narrator": "（選択肢）",
            "text": "大丈夫、次に行って",
            "zh": "没事，继续吧",
            "narrator_zh": "（选项）"
        },
        {
            "location": "421/SEL",
            "narrator": "（選択肢）",
            "text": "あ、退場する",
            "zh": "啊，那我退场",
            "narrator_zh": "（选项）"
        },
        {
            "location": "422/SEL",
            "narrator": "（選択肢）",
            "text": "えーと、メイドなの？",
            "zh": "呃，你是女仆吗？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "423/ACT",
            "narrator": "",
            "text": "大丈夫、次に行って",
            "zh": "没事，继续吧",
            "narrator_zh": ""
        },
        {
            "location": "424/TALK",
            "narrator": "神楽",
            "text": "承知いたしました。\nそれでは早速、今回の\nクランを紹介いたします。",
            "zh": "我明白了。\n那么事不宜迟，来介绍\n这次的库兰吧。",
            "narrator_zh": "神乐"
        },
        {
            "location": "425/ACT",
            "narrator": "",
            "text": "あ、退場する",
            "zh": "啊，那我退场",
            "narrator_zh": ""
        },
        {
            "location": "426/TALK",
            "narrator": "神楽",
            "text": "残念ですがここで\nお別れですね。",
            "zh": "虽然很遗憾，但我们只能\n在此分别了呢。",
            "narrator_zh": "神乐"
        },
        {
            "location": "428/TALK",
            "narrator": "神楽",
            "text": "お戻りになる日を\n心待ちに\nしております。",
            "zh": "我会满怀期待地\n盼望着你回来\n的那一天。",
            "narrator_zh": "神乐"
        },
        {
            "location": "429/TALK",
            "narrator": "神楽",
            "text": "$handle$さまと\n私に、\n素敵なココロの旅を。",
            "zh": "祝$handle$大人与\n我，\n有一场美好的心灵之旅。",
            "narrator_zh": "神乐"
        },
        {
            "location": "431/ACT",
            "narrator": "",
            "text": "えーと、メイドなの？",
            "zh": "呃，你是女仆吗？",
            "narrator_zh": ""
        },
        {
            "location": "432/TALK",
            "narrator": "神楽",
            "text": "え？",
            "zh": "诶？",
            "narrator_zh": "神乐"
        },
        {
            "location": "434/TALK",
            "narrator": "神楽",
            "text": "改めて聞かれると\n困ってしまいますね。",
            "zh": "被你这么一本正经地问起来，\n我还真有点为难呢。",
            "narrator_zh": "神乐"
        },
        {
            "location": "435/TALK",
            "narrator": "神楽",
            "text": "お好きに解釈\nしていただいて\n構いません。",
            "zh": "随你喜欢\n怎么理解\n都可以哦。",
            "narrator_zh": "神乐"
        },
        {
            "location": "436/TALK",
            "narrator": "神楽",
            "text": "それでは今回の\nクランを紹介\nいたしますね。",
            "zh": "那么这就来\n为你介绍\n这次的库兰哦。",
            "narrator_zh": "神乐"
        },
        {
            "location": "445/TALK",
            "narrator": "神楽",
            "text": "オープンプロセス、\n0xC4E番地から\n0xFFF番地へ。",
            "zh": "开放进程，\n从0xC4E地址\n到0xFFF地址。",
            "narrator_zh": "神乐"
        },
        {
            "location": "446/TALK",
            "narrator": "神楽",
            "text": "共通意識野を経由、\n外部スフィアへ接続。",
            "zh": "经由共通意识野，\n连接至外部领域。",
            "narrator_zh": "神乐"
        },
        {
            "location": "447/TALK",
            "narrator": "神楽",
            "text": "EXEC_SEEK_SECTOR\n=>Link() EXT_SPHERE/.",
            "zh": "EXEC_SEEK_SECTOR\n=>Link() EXT_SPHERE/.",
            "narrator_zh": "神乐"
        },
        {
            "location": "472/TALK",
            "narrator": "神楽",
            "text": "シーク完了\nいたしました。",
            "zh": "搜索\n完成了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "473/TALK",
            "narrator": "神楽",
            "text": "さて――。",
            "zh": "那么——。",
            "narrator_zh": "神乐"
        },
        {
            "location": "475/TALK",
            "narrator": "神楽",
            "text": "今回、貴方に\n紹介するクランは\n<color=red>【モーフィアス】</color>。",
            "zh": "这次要向你\n介绍的库兰是\n<color=red>【摩耳甫斯】</color>。",
            "narrator_zh": "神乐"
        },
        {
            "location": "477/TALK",
            "narrator": "神楽",
            "text": "発症者は朝倉祥太郎\n２６歳。\n江東区豊洲にて発症。",
            "zh": "发症者是朝仓祥太郎\n26岁。\n于江东区丰洲发症。",
            "narrator_zh": "神乐"
        },
        {
            "location": "478/TALK",
            "narrator": "神楽",
            "text": "ココロファイルナンバー\nE05-010-19によれば、\n今回の発症の原因は……",
            "zh": "根据心之档案编号\nE05-010-19的记载，\n这次发症的原因是……",
            "narrator_zh": "神乐"
        },
        {
            "location": "479/TALK",
            "narrator": "神楽",
            "text": "スマホゲーム\n上位ランカーからの\n没落。",
            "zh": "从手游\n上位玩家的宝座\n跌落谷底。",
            "narrator_zh": "神乐"
        },
        {
            "location": "480/TALK",
            "narrator": "神楽",
            "text": "バカみたいですね。",
            "zh": "像个白痴一样呢。",
            "narrator_zh": "神乐"
        },
        {
            "location": "483/TALK",
            "narrator": "神楽",
            "text": "でもそれまでの\n課金額は一千万を超えて\nいたそうですから。",
            "zh": "不过听说他在那之前的\n氪金总额已经超过了\n一千万。",
            "narrator_zh": "神乐"
        },
        {
            "location": "484/TALK",
            "narrator": "神楽",
            "text": "発症してしまったのも\nいたしかたないと\n言えるでしょう。",
            "zh": "会因此发症，\n也算得上是\n无可奈何吧。",
            "narrator_zh": "神乐"
        },
        {
            "location": "485/SEL",
            "narrator": "（選択肢）",
            "text": "えー……",
            "zh": "呃……",
            "narrator_zh": "（选项）"
        },
        {
            "location": "486/SEL",
            "narrator": "（選択肢）",
            "text": "何で神楽が仕切ってるの？",
            "zh": "为什么是神乐来主持啊？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "487/ACT",
            "narrator": "",
            "text": "えー……",
            "zh": "呃……",
            "narrator_zh": ""
        },
        {
            "location": "488/TALK",
            "narrator": "神楽",
            "text": "$handle$さまの\n反応はもっともかと。",
            "zh": "$handle$大人的\n反应也是合情合理。",
            "narrator_zh": "神乐"
        },
        {
            "location": "489/ACT",
            "narrator": "",
            "text": "何で神楽が仕切ってるの？",
            "zh": "为什么是神乐来主持啊？",
            "narrator_zh": ""
        },
        {
            "location": "490/TALK",
            "narrator": "神楽",
            "text": "罪をあがなって\nいただくためです。",
            "zh": "是为了让他\n好好赎罪哦。",
            "narrator_zh": "神乐"
        },
        {
            "location": "491/TALK",
            "narrator": "神楽",
            "text": "随分と酷いことを\nされてしまい\nましたから。",
            "zh": "毕竟我可是被他\n做了相当过分的\n事情呢。",
            "narrator_zh": "神乐"
        },
        {
            "location": "492/TALK",
            "narrator": "神楽",
            "text": "このゴミには。",
            "zh": "被这个垃圾。",
            "narrator_zh": "神乐"
        },
        {
            "location": "493/SEL",
            "narrator": "（選択肢）",
            "text": "えっ！？",
            "zh": "诶！？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "494/ACT",
            "narrator": "",
            "text": "えっ！？",
            "zh": "诶！？",
            "narrator_zh": ""
        },
        {
            "location": "496/TALK",
            "narrator": "神楽",
            "text": "どうか\nなさいましたか？",
            "zh": "请问\n怎么了吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "497/SEL",
            "narrator": "（選択肢）",
            "text": "…いやなんでもない",
            "zh": "……不，没什么",
            "narrator_zh": "（选项）"
        },
        {
            "location": "498/SEL",
            "narrator": "（選択肢）",
            "text": "話を続けて？",
            "zh": "请继续往下说？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "499/SEL",
            "narrator": "（選択肢）",
            "text": "気のせいだよねきっと",
            "zh": "一定是我听错了吧",
            "narrator_zh": "（选项）"
        },
        {
            "location": "500/ACT",
            "narrator": "",
            "text": "…いやなんでもない",
            "zh": "……不，没什么",
            "narrator_zh": ""
        },
        {
            "location": "501/TALK",
            "narrator": "神楽",
            "text": "ならよいのですけれど。",
            "zh": "那就好。",
            "narrator_zh": "神乐"
        },
        {
            "location": "502/ACT",
            "narrator": "",
            "text": "話を続けて？",
            "zh": "请继续往下说？",
            "narrator_zh": ""
        },
        {
            "location": "503/TALK",
            "narrator": "神楽",
            "text": "承知いたしました。",
            "zh": "我知道了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "504/ACT",
            "narrator": "",
            "text": "気のせいだよねきっと",
            "zh": "一定是我听错了吧",
            "narrator_zh": ""
        },
        {
            "location": "505/TALK",
            "narrator": "神楽",
            "text": "何のことでしょうか？",
            "zh": "你是指什么事呢？",
            "narrator_zh": "神乐"
        },
        {
            "location": "508/TALK",
            "narrator": "神楽",
            "text": "このセクタでは、クランと\n一番相性がいい\nトライナリーが参ります。",
            "zh": "在这个区域里，是由和\n这位库兰最投缘的\n三重奏队员登场。",
            "narrator_zh": "神乐"
        },
        {
            "location": "509/TALK",
            "narrator": "神楽",
            "text": "つまり他のクランは\n他のメンバーが\n語るということですね。",
            "zh": "也就是说，其他库兰\n就会由其他成员\n来讲述吧。",
            "narrator_zh": "神乐"
        },
        {
            "location": "510/TALK",
            "narrator": "神楽",
            "text": "それでは精神共有と\n参りましょうか。",
            "zh": "那么我们就来\n进行精神共享吧。",
            "narrator_zh": "神乐"
        },
        {
            "location": "511/SEL",
            "narrator": "（選択肢）",
            "text": "どうやるの？",
            "zh": "要怎么弄？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "512/ACT",
            "narrator": "",
            "text": "どうやるの？",
            "zh": "要怎么弄？",
            "narrator_zh": ""
        },
        {
            "location": "514/TALK",
            "narrator": "神楽",
            "text": "おさらいしましょうか。\nまずは『コネクト』の\nプロセスを行います。",
            "zh": "让我来复习一遍吧。\n首先要进行的\n是『连接』流程。",
            "narrator_zh": "神乐"
        },
        {
            "location": "515/TALK",
            "narrator": "神楽",
            "text": "具体的には、\n彼の抵抗する意志と\n戦うのです。",
            "zh": "具体来说，\n就是要和他那股\n抗拒的意志战斗。",
            "narrator_zh": "神乐"
        },
        {
            "location": "516/TALK",
            "narrator": "神楽",
            "text": "それが終われば、\n彼は貴方に色々\n教えてくれるでしょう。",
            "zh": "战斗结束之后，\n他就会告诉你\n各种各样的事了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "517/TALK",
            "narrator": "神楽",
            "text": "$handle$さまが\nそれを共有すれば、\n『シンクロ』完了です。",
            "zh": "只要$handle$大人把那些\n接收共享过来，\n『同步』就算完成了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "518/TALK",
            "narrator": "神楽",
            "text": "『コネクト』『シンクロ』\n両方完了することで、\n貴方と彼は繋がれます。",
            "zh": "『连接』和『同步』\n两项都完成之后，\n你就能和他连结在一起。",
            "narrator_zh": "神乐"
        },
        {
            "location": "519/SEL",
            "narrator": "（選択肢）",
            "text": "それでおしまい？",
            "zh": "然后就结束了吗？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "520/ACT",
            "narrator": "",
            "text": "それでおしまい？",
            "zh": "然后就结束了吗？",
            "narrator_zh": ""
        },
        {
            "location": "522/TALK",
            "narrator": "神楽",
            "text": "ここからが\n始まりですよ！",
            "zh": "从那之后才是\n真正的开始哦！",
            "narrator_zh": "神乐"
        },
        {
            "location": "523/TALK",
            "narrator": "神楽",
            "text": "$handle$さまは\nモーフィアスを使える\nようになるんです！",
            "zh": "$handle$大人将会\n能够使用\n摩耳甫斯！",
            "narrator_zh": "神乐"
        },
        {
            "location": "524/TALK",
            "narrator": "神楽",
            "text": "ですから、『シンクロ』\nまで完了できるように\n頑張ってください！",
            "zh": "所以，为了能顺利\n一路完成到『同步』，\n请好好加油哦！",
            "narrator_zh": "神乐"
        },
        {
            "location": "525/TALK",
            "narrator": "神楽",
            "text": "あ。",
            "zh": "啊。",
            "narrator_zh": "神乐"
        },
        {
            "location": "526/TALK",
            "narrator": "神楽",
            "text": "$handle$さまには\n頑張っていただきたく\n思っております。",
            "zh": "我可是衷心盼望着\n$handle$大人能够\n加油努力呢。",
            "narrator_zh": "神乐"
        },
        {
            "location": "527/TALK",
            "narrator": "神楽",
            "text": "それでは。\nモーフィアスの世界に\nアクセスいたします。",
            "zh": "那么，\n这就接入\n摩耳甫斯的世界。",
            "narrator_zh": "神乐"
        },
        {
            "location": "529/TALK",
            "narrator": "神楽",
            "text": "$handle$さまと\n私とモーフィアスに、\n素敵なココロの旅を！",
            "zh": "祝$handle$大人、\n我与摩耳甫斯，\n有一场美好的心灵之旅！",
            "narrator_zh": "神乐"
        }
    ]
