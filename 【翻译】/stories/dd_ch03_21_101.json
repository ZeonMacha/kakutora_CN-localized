{
    "dir": "chap21/daydra/dd_ch03_21_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "21302",
        "cid": "gabriella",
        "title": "002 メインストーリー",
        "sub_title": "胸騒ぎの鼻＜前編＞",
        "title_zh": "002 主线剧情",
        "sub_title_zh": "令人不安之鼻＜前篇＞"
    },
    "entry": [
        {
            "location": "46/TALK",
            "narrator": "アーヤ",
            "text": "のどかねぇ…。",
            "zh": "真是悠闲呀……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "47/TALK",
            "narrator": "神楽",
            "text": "そうですねぇ…。",
            "zh": "是呀……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "49/TALK",
            "narrator": "神楽",
            "text": "でも、みやびさん。\nどういうことですか？",
            "zh": "不过，雅。\n这到底是怎么回事？",
            "narrator_zh": "神乐"
        },
        {
            "location": "50/TALK",
            "narrator": "神楽",
            "text": "珍しいところに\n案内してくれる、って\n聞きましたけど。",
            "zh": "我明明听说你要带\n我们去一个很稀罕\n的地方。",
            "narrator_zh": "神乐"
        },
        {
            "location": "51/TALK",
            "narrator": "神楽",
            "text": "ただの畑道じゃない\nですか…。",
            "zh": "这不就只是一条\n田间小路嘛……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "53/TALK",
            "narrator": "みやび",
            "text": "何を言うちょる。",
            "zh": "胡说些么子。",
            "narrator_zh": "雅"
        },
        {
            "location": "54/TALK",
            "narrator": "みやび",
            "text": "この畑は三崎マグロに\n次いで有名な\n三崎キャベツ。",
            "zh": "这片田里种的可是\n仅次于三崎金枪鱼\n的著名三崎卷心菜。",
            "narrator_zh": "雅"
        },
        {
            "location": "55/TALK",
            "narrator": "みやび",
            "text": "そのキャベツ様を\n栽培している\n畑ちや。",
            "zh": "这里就是专门栽培那\n卷心菜大人的\n田地咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "56/TALK",
            "narrator": "みやび",
            "text": "世界中でここにしか\nないがよ。",
            "zh": "全世界就只有这里\n才有啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "58/TALK",
            "narrator": "つばめ",
            "text": "そ、そうだったん\nですか！？",
            "zh": "真、真的吗\n！？",
            "narrator_zh": "燕"
        },
        {
            "location": "61/TALK",
            "narrator": "ガブリエラ",
            "text": "何信じてるのよ？\n冗談に決まってる\nでしょ。",
            "zh": "你在信什么啊？\n这明显是开玩笑的\n吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "62/TALK",
            "narrator": "つばめ",
            "text": "えっ、そうなの？",
            "zh": "哎，是这样吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "64/TALK",
            "narrator": "アーヤ",
            "text": "みやび、つばめを\nからかわないの。",
            "zh": "雅，别逗燕\n玩了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "66/TALK",
            "narrator": "みやび",
            "text": "いや、到着まで\nもう少しかかるきね。",
            "zh": "没有啦，离目的地\n还要再走一会儿嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "67/TALK",
            "narrator": "みやび",
            "text": "その間、ちくっと\n場を盛り上げよう\n思うたがよ。",
            "zh": "趁这会儿，我就想着\n一哈把气氛炒热\n起来啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "69/TALK",
            "narrator": "神楽",
            "text": "でも、周り見ても\n特に珍しいものは\n見えてきませんよ？",
            "zh": "可是，环顾四周也\n没看到什么特别\n稀罕的东西呀？",
            "narrator_zh": "神乐"
        },
        {
            "location": "70/TALK",
            "narrator": "神楽",
            "text": "本当にこっちで\nいいんですか？",
            "zh": "真的走这边\n没问题吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "71/TALK",
            "narrator": "みやび",
            "text": "うちを信じぃ。\nほれ、歩いた歩いた。",
            "zh": "相信我嘛。\n来，走起来走起来。",
            "narrator_zh": "雅"
        },
        {
            "location": "74/TALK",
            "narrator": "ガブリエラ",
            "text": "…なんだか、ちょっと\n不安になってきたわ。",
            "zh": "……总觉得，有点\n开始不安起来了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "119/TALK",
            "narrator": "みやび",
            "text": "…みんな、ちくと\n元気なくなってきた\nみたいやけんど？",
            "zh": "……大家，好像一哈\n有点没精神了\n不过？",
            "narrator_zh": "雅"
        },
        {
            "location": "120/TALK",
            "narrator": "ガブリエラ",
            "text": "…当たり前でしょ？\n朝の訓練で疲れてる\nのよ！？",
            "zh": "……那不是废话吗？\n早上训练本来就已经\n很累了啊！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "122/TALK",
            "narrator": "ガブリエラ",
            "text": "それなのに\nこんな藪の中を\n歩かせるなんて…。",
            "zh": "结果你还偏偏让我们\n在这种草丛里\n走来走去……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "124/TALK",
            "narrator": "アーヤ",
            "text": "一応言っとくけど、\nこれで冗談なんて\nことはないわよね！？",
            "zh": "我姑且先说一句，\n这该不会又是\n开玩笑吧！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "125/TALK",
            "narrator": "アーヤ",
            "text": "だったら\nさすがに怒るわよ？",
            "zh": "要是那样的话\n我可真要生气了哦？",
            "narrator_zh": "绫水"
        },
        {
            "location": "126/TALK",
            "narrator": "神楽",
            "text": "ですね…。\nさすがに冗談が\n過ぎますし…。",
            "zh": "就是呀……。\n如果是玩笑的话也\n实在太过分了……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "127/TALK",
            "narrator": "みやび",
            "text": "何故仲間たちはうちを\n信じようとしないの\nだろうか？",
            "zh": "为何同伴们就是\n不肯相信我\n呢？",
            "narrator_zh": "雅"
        },
        {
            "location": "130/TALK",
            "narrator": "みやび",
            "text": "つばめちゃんは\nどう思う？",
            "zh": "燕觉得\n怎么样？",
            "narrator_zh": "雅"
        },
        {
            "location": "133/TALK",
            "narrator": "つばめ",
            "text": "え？　探検みたいで\n楽しいですよ。",
            "zh": "哎？　就像探险一样\n很开心哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "134/TALK",
            "narrator": "みやび",
            "text": "つばめちゃんは\nとってもえい子やね。",
            "zh": "燕真是个\n好得很的乖孩子咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "135/TALK",
            "narrator": "ガブリエラ",
            "text": "…あのさ、本当に\n信じていいのよね？",
            "zh": "……我说，真的\n可以相信你吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "136/TALK",
            "narrator": "ガブリエラ",
            "text": "本気で不安になって\nきてるんだけど…。",
            "zh": "我已经开始认真\n感到不安了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "139/TALK",
            "narrator": "みやび",
            "text": "口に出すから余計に\n不安になるんよ。",
            "zh": "就是因为说出口，\n才会越想越不安咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "141/TALK",
            "narrator": "みやび",
            "text": "口閉じて、うちを\n信じて付いて来ぃ。",
            "zh": "闭上嘴，相信我\n跟着走就对咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "143/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "150/TALK",
            "narrator": "ガブリエラ",
            "text": "疲れたわ",
            "zh": "好累啊",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "152/TALK",
            "narrator": "ガブリエラ",
            "text": "$marzanna$はどう思う？",
            "zh": "$marzanna$怎么想？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "153/TALK",
            "narrator": "ガブリエラ",
            "text": "こんなわけのわからないところに",
            "zh": "在这种莫名其妙的地方",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "154/TALK",
            "narrator": "ガブリエラ",
            "text": "何か",
            "zh": "难道真的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "155/TALK",
            "narrator": "ガブリエラ",
            "text": "面白いものがあるのかしら？",
            "zh": "会有什么有趣的东西吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "157/SEL",
            "narrator": "",
            "text": "みやびはそう言ってるね",
            "zh": "雅确实是这么说的呢",
            "narrator_zh": ""
        },
        {
            "location": "158/ACT",
            "narrator": "",
            "text": "みやびはそう言ってるね",
            "zh": "雅确实是这么说的呢",
            "narrator_zh": ""
        },
        {
            "location": "160/TALK",
            "narrator": "ガブリエラ",
            "text": "信じていいと思う？",
            "zh": "你觉得可以相信她吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "161/TALK",
            "narrator": "ガブリエラ",
            "text": "私にはちょっと",
            "zh": "我稍微有点",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "162/TALK",
            "narrator": "ガブリエラ",
            "text": "判断付けかねるわ",
            "zh": "拿不定主意呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "163/TALK",
            "narrator": "ガブリエラ",
            "text": "見てのとおり",
            "zh": "如你所见",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "164/TALK",
            "narrator": "ガブリエラ",
            "text": "周りがこんななんだもの",
            "zh": "周围全是这种鬼样子",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "165/TALK",
            "narrator": "ガブリエラ",
            "text": "もう帰りたいわよ",
            "zh": "我已经想回去了啦",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "167/SEL",
            "narrator": "",
            "text": "冗談でこんな疲れることしないよ",
            "zh": "她不会为了开玩笑搞这么累的事吧",
            "narrator_zh": ""
        },
        {
            "location": "168/SEL",
            "narrator": "",
            "text": "今から帰るのは遅過ぎじゃない？",
            "zh": "现在才说要回去是不是太晚了？",
            "narrator_zh": ""
        },
        {
            "location": "169/ACT",
            "narrator": "",
            "text": "冗談でこんな疲れることしないよ",
            "zh": "她不会为了开玩笑搞这么累的事吧",
            "narrator_zh": ""
        },
        {
            "location": "170/TALK",
            "narrator": "ガブリエラ",
            "text": "確かに",
            "zh": "确实",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "171/TALK",
            "narrator": "ガブリエラ",
            "text": "みやびだものね",
            "zh": "毕竟是雅嘛",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "172/TALK",
            "narrator": "ガブリエラ",
            "text": "人一倍疲れるの嫌いなんだし",
            "zh": "她比谁都讨厌累人的事",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "175/TALK",
            "narrator": "ガブリエラ",
            "text": "わかったわ",
            "zh": "我知道了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "177/TALK",
            "narrator": "ガブリエラ",
            "text": "もう少しだけ信じてみるわ",
            "zh": "我就再稍微相信她一下吧",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "178/TALK",
            "narrator": "ガブリエラ",
            "text": "もう少しだけね",
            "zh": "就再稍微一下哦",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "179/ACT",
            "narrator": "",
            "text": "今から帰るのは遅過ぎじゃない？",
            "zh": "现在才说要回去是不是太晚了？",
            "narrator_zh": ""
        },
        {
            "location": "180/TALK",
            "narrator": "ガブリエラ",
            "text": "確かに",
            "zh": "确实",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "181/TALK",
            "narrator": "ガブリエラ",
            "text": "結構歩いてきたし",
            "zh": "都已经走了这么远了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "184/TALK",
            "narrator": "ガブリエラ",
            "text": "後戻りのタイミングを見誤ったわ",
            "zh": "我错过了折返的时机呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "185/TALK",
            "narrator": "ガブリエラ",
            "text": "戻れぬところへ来てしまったって",
            "zh": "所谓“已经走到了无法回头的境地”",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "186/TALK",
            "narrator": "ガブリエラ",
            "text": "こういうことなのね",
            "zh": "指的就是现在这样吧",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "192/TALK",
            "narrator": "ガブリエラ",
            "text": "…本当にもうすぐなん\nでしょうね？",
            "zh": "……真的马上就\n要到了吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "195/TALK",
            "narrator": "みやび",
            "text": "まっことやって。\nほれ、もう見えてきた\nがよ。",
            "zh": "是真的嘛。\n看，已经能看见\n咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "196/TALK",
            "narrator": "ガブリエラ",
            "text": "え？",
            "zh": "哎？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "240/TALK",
            "narrator": "みやび",
            "text": "ほれ、到着や。",
            "zh": "好，到咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "241/TALK",
            "narrator": "アーヤ",
            "text": "へぇ…、こんな場所が\nあったんだ？",
            "zh": "唔……居然还有\n这种地方啊？",
            "narrator_zh": "绫水"
        },
        {
            "location": "243/TALK",
            "narrator": "みやび",
            "text": "ここは来るのが\n億劫な場所やきねえ。",
            "zh": "因为这地方过来挺\n麻烦的啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "244/TALK",
            "narrator": "みやび",
            "text": "見てのとおり、\nあんまし人も\nおらん穴場ぞね。",
            "zh": "如你所见，\n没得什么人来的\n冷门好地方啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "247/TALK",
            "narrator": "ガブリエラ",
            "text": "いや、穴場なのかも\nしれないけど。",
            "zh": "不，冷门好地方\n或许是没错啦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "248/TALK",
            "narrator": "ガブリエラ",
            "text": "これじゃ訓練してる\n砂浜と、ほとんど\n変わらないわよ。",
            "zh": "但这也和我们平时\n训练的那片沙滩，\n几乎没什么两样嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "251/TALK",
            "narrator": "みやび",
            "text": "はぁ…ガブちゃんは\nせっかちさんやねぇ。",
            "zh": "唉……加布还真是个\n急性子咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "253/TALK",
            "narrator": "みやび",
            "text": "うちが見せたいのは、\nこの入り江やない。",
            "zh": "我想给你们看的，\n可不是这个海湾。",
            "narrator_zh": "雅"
        },
        {
            "location": "254/TALK",
            "narrator": "みやび",
            "text": "向こうにある洞窟を\n見せたかったがよ。",
            "zh": "我想让你们看的是\n那边的洞窟啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "255/TALK",
            "narrator": "つばめ",
            "text": "えっ、そんなのが\nあるんですか？",
            "zh": "哎，还有那种地方\n吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "257/TALK",
            "narrator": "みやび",
            "text": "黒崎の鼻ゆうてな。\nま、黙ってうちに\n付いて来ぃ。",
            "zh": "叫做黑崎之鼻。\n好啦，别作声\n跟我来就是咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "301/TALK",
            "narrator": "アーヤ",
            "text": "うわっ、真っ暗！\nここって入っても\n平気なの？",
            "zh": "哇啊，黑漆漆的！\n这里真的可以\n进去吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "303/TALK",
            "narrator": "みやび",
            "text": "それなりに有名な\n場所やきね。",
            "zh": "好歹也是个颇有\n名气的地方啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "304/TALK",
            "narrator": "みやび",
            "text": "まあ、真っ暗やき\n足元に気を付けて\n進みぃ。",
            "zh": "不过里面黑得很，\n注意脚下往前\n走咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "305/TALK",
            "narrator": "ガブリエラ",
            "text": "なんだか、本当に\n探検っぽくなって\nきたわね。",
            "zh": "总觉得，真的\n越来越有探险的\n感觉了呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "307/TALK",
            "narrator": "みやび",
            "text": "宝箱もなければ\nボスもいない洞窟\nやけんどね。",
            "zh": "虽说是个既没得宝箱\n也没得Boss的\n洞窟咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "308/TALK",
            "narrator": "神楽",
            "text": "これ知ってます！\n洞窟の奥が異世界に\n続いてるんですよね？",
            "zh": "这个我知道！\n洞窟的深处是通往\n异世界的对吧？",
            "narrator_zh": "神乐"
        },
        {
            "location": "310/TALK",
            "narrator": "みやび",
            "text": "…えーと？",
            "zh": "……呃？",
            "narrator_zh": "雅"
        },
        {
            "location": "311/TALK",
            "narrator": "神楽",
            "text": "そういうラノベ\nこの前読みました！",
            "zh": "我前阵子刚看过\n那样的轻小说！",
            "narrator_zh": "神乐"
        },
        {
            "location": "314/TALK",
            "narrator": "アーヤ",
            "text": "……。\nそういう映画なら\n見たことあるわ。",
            "zh": "……。\n那种电影的话，我\n倒是看过哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "316/TALK",
            "narrator": "みやび",
            "text": "フェノメノンの中も、\n異世界みたいなもん\nやしねえ……。",
            "zh": "PhenoMENON里面，\n也跟异世界差不多的\n咯……。",
            "narrator_zh": "雅"
        },
        {
            "location": "318/TALK",
            "narrator": "神楽",
            "text": "いいえ！\nそれは違います！",
            "zh": "不对！\n那才不一样！",
            "narrator_zh": "神乐"
        },
        {
            "location": "319/TALK",
            "narrator": "神楽",
            "text": "ヒロインもいないし\nチートパワーも手に\n入らない異世界なんて！",
            "zh": "既没有女主角，也\n拿不到外挂能力\n的地方！",
            "narrator_zh": "神乐"
        },
        {
            "location": "320/TALK",
            "narrator": "神楽",
            "text": "異世界とは\n言いません！！",
            "zh": "根本不能叫\n异世界！！",
            "narrator_zh": "神乐"
        },
        {
            "location": "321/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "323/TALK",
            "narrator": "ガブリエラ",
            "text": "つばめ、どうしたの？\nさっきから全然\n話さないじゃない。",
            "zh": "燕，怎么了？\n从刚才开始就一直\n不怎么说话嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "325/TALK",
            "narrator": "つばめ",
            "text": "だ、だって、なんか\n狭くて暗いし…。",
            "zh": "因、因为，这里总觉得\n又窄又黑的……。",
            "narrator_zh": "燕"
        },
        {
            "location": "326/TALK",
            "narrator": "つばめ",
            "text": "ちょっと不気味な\n感じもするし…。",
            "zh": "还有点阴森森的\n感觉……。",
            "narrator_zh": "燕"
        },
        {
            "location": "327/TALK",
            "narrator": "ガブリエラ",
            "text": "別にお化けなんか\nでないわよ。",
            "zh": "又不会有什么幽灵\n跑出来啦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "329/TALK",
            "narrator": "つばめ",
            "text": "わかってるけど、\nあんまり雰囲気の\nいい場所じゃないし。",
            "zh": "话是这么说，可这里\n气氛实在不太好\n嘛。",
            "narrator_zh": "燕"
        },
        {
            "location": "331/TALK",
            "narrator": "神楽",
            "text": "…大丈夫ですか？\nちょっと、顔色が\n悪そうですけど。",
            "zh": "……不要紧吧？\n你的脸色，看起来\n好像不太好哦。",
            "narrator_zh": "神乐"
        },
        {
            "location": "333/TALK",
            "narrator": "みやび",
            "text": "ん、体調悪いなら、\nここまでにして\n戻るか？",
            "zh": "嗯，要是身体不舒服，\n要不就到这里先\n回去喃？",
            "narrator_zh": "雅"
        },
        {
            "location": "335/TALK",
            "narrator": "つばめ",
            "text": "あ、大丈夫です！\n行きましょう。",
            "zh": "啊，没关系的！\n我们继续走吧。",
            "narrator_zh": "燕"
        },
        {
            "location": "337/TALK",
            "narrator": "アーヤ",
            "text": "大丈夫なの？",
            "zh": "真的没问题吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "338/TALK",
            "narrator": "つばめ",
            "text": "えへへ…わたしも、\n奥がどうなってるか\n見たくて…。",
            "zh": "哎嘿嘿……其实我也，\n很想看看最里面\n是什么样的……。",
            "narrator_zh": "燕"
        },
        {
            "location": "341/TALK",
            "narrator": "みやび",
            "text": "…無理そうやったら、\nちゃんと言わんと\nあかんよ？",
            "zh": "……要是撑不住了，\n可得好好说出来\n咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "343/TALK",
            "narrator": "つばめ",
            "text": "は、はい…。",
            "zh": "好、好的……。",
            "narrator_zh": "燕"
        },
        {
            "location": "344/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "345/TALK",
            "narrator": "ガブリエラ",
            "text": "まったく、どう見ても\n強がってるのバレバレ\nじゃない。",
            "zh": "真是的，怎么看都\n明显是在硬撑\n嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "347/TALK",
            "narrator": "ガブリエラ",
            "text": "…まあ、つばめらしい\nっちゃらしいけど。",
            "zh": "……算了，倒也确实\n很像燕的风格就是了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "348/TALK",
            "narrator": "ガブリエラ",
            "text": "自分のせいで\nみんなも戻ることが\n申し訳ない。",
            "zh": "觉得要是因为自己\n害得大家也跟着回去\n会过意不去。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "349/TALK",
            "narrator": "ガブリエラ",
            "text": "多分そう思って\n我慢してるのよね…。",
            "zh": "八成是这么想着才\n一直在忍耐吧……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "350/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "352/TALK",
            "narrator": "ガブリエラ",
            "text": "…何かしてあげた方が\nいいかしら？",
            "zh": "……要不要替她做点\n什么比较好呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "353/TALK",
            "narrator": "ガブリエラ",
            "text": "話しかけるとか…、\n手をつなぐとか？",
            "zh": "比如跟她搭搭话……，\n或者牵着她的手？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "354/TALK",
            "narrator": "ガブリエラ",
            "text": "…なんか、ちょっと\n恥ずかしいかも…。",
            "zh": "……总觉得，稍微\n有点不好意思呢……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "356/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、なんかすごく\n心細そう……。",
            "zh": "可是，她看起来实在\n太没有安全感了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "358/TALK",
            "narrator": "ガブリエラ",
            "text": "う～ん…。",
            "zh": "唔～嗯……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "423/TALK",
            "narrator": "ガブリエラ",
            "text": "　",
            "zh": "　",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "437/TALK",
            "narrator": "ガブリエラ",
            "text": "あ、$handle$！\nいらっしゃい！",
            "zh": "啊，$handle$！\n欢迎光临！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "438/SEL",
            "narrator": "",
            "text": "相変わらずわかってない感じ？",
            "zh": "你好像还是一如既往地没察觉到啊？",
            "narrator_zh": ""
        },
        {
            "location": "439/ACT",
            "narrator": "",
            "text": "相変わらずわかってない感じ？",
            "zh": "你好像还是一如既往地没察觉到啊？",
            "narrator_zh": ""
        },
        {
            "location": "441/TALK",
            "narrator": "ガブリエラ",
            "text": "だから、\n何の事なのよ！",
            "zh": "所以说，\n到底是什么事嘛！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "442/SEL",
            "narrator": "",
            "text": "地獄絵図のような場所になってるよ？",
            "zh": "这里已经变得像地狱绘卷一样了哦？",
            "narrator_zh": ""
        },
        {
            "location": "443/ACT",
            "narrator": "",
            "text": "地獄絵図のような場所になってるよ？",
            "zh": "这里已经变得像地狱绘卷一样了哦？",
            "narrator_zh": ""
        },
        {
            "location": "445/TALK",
            "narrator": "ガブリエラ",
            "text": "えっ！？\nど、どこが？？",
            "zh": "哎！？\n哪、哪里呀？？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "446/TALK",
            "narrator": "ガブリエラ",
            "text": "もう！\nホントにこの前から\n一体どうしたのかしら？",
            "zh": "真是的！\n你从前阵子开始到底\n是怎么回事嘛？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "447/TALK",
            "narrator": "ガブリエラ",
            "text": "ついに\nおかしくなっちゃったの\nかしらね。",
            "zh": "该不会终于\n脑子出问题了\n吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "448/SEL",
            "narrator": "",
            "text": "それはこっちのセリフなんですけど",
            "zh": "这句话应该是我说才对吧",
            "narrator_zh": ""
        },
        {
            "location": "449/ACT",
            "narrator": "",
            "text": "それはこっちのセリフなんですけど",
            "zh": "这句话应该是我说才对吧",
            "narrator_zh": ""
        },
        {
            "location": "451/TALK",
            "narrator": "ガブリエラ",
            "text": "はいはい。\nもうそういうのは\nホントにいいから。",
            "zh": "好好好。\n这种玩笑就真的\n免了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "459/SEL",
            "narrator": "",
            "text": "！？",
            "zh": "！？",
            "narrator_zh": ""
        },
        {
            "location": "460/ACT",
            "narrator": "",
            "text": "！？",
            "zh": "！？",
            "narrator_zh": ""
        },
        {
            "location": "475/SEL",
            "narrator": "",
            "text": "ちょっ！！！",
            "zh": "等一下！！！",
            "narrator_zh": ""
        },
        {
            "location": "476/ACT",
            "narrator": "",
            "text": "ちょっ！！！",
            "zh": "等一下！！！",
            "narrator_zh": ""
        },
        {
            "location": "478/TALK",
            "narrator": "ガブリエラ",
            "text": "それじゃ、今回の悩みを\n検索するわね。",
            "zh": "那么，这次的烦恼\n就由我来检索咯。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "479/SEL",
            "narrator": "",
            "text": "ガブリエラ後ろ！後ろ！！",
            "zh": "加布里埃拉后面！后面！！",
            "narrator_zh": ""
        },
        {
            "location": "480/ACT",
            "narrator": "",
            "text": "ガブリエラ後ろ！後ろ！！",
            "zh": "加布里埃拉后面！后面！！",
            "narrator_zh": ""
        },
        {
            "location": "482/TALK",
            "narrator": "ガブリエラ",
            "text": "だから何なのよ！\nもう！！",
            "zh": "所以说到底是什么事嘛！\n真是的！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "484/TALK",
            "narrator": "ガブリエラ",
            "text": "！？",
            "zh": "！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "485/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょ、ちょっと\nあんた誰！？",
            "zh": "等、等一下，\n你是谁！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "486/TALK",
            "narrator": "？？？",
            "text": "あんたと同じ、\nガブリエラの\n人格の一人よ。",
            "zh": "和你一样，\n也是加布里埃拉的\n人格之一哦。",
            "narrator_zh": "？？？"
        },
        {
            "location": "487/TALK",
            "narrator": "？？？",
            "text": "そして、あんたを\n消しに来た。",
            "zh": "而且，我是来\n抹消你的。",
            "narrator_zh": "？？？"
        },
        {
            "location": "488/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょっ！\nど、どういうことよ！",
            "zh": "等下！\n这、这是什么意思！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "489/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしが\n何をしたって言うわけ！？",
            "zh": "我到底做了\n什么啊！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "490/TALK",
            "narrator": "？？？",
            "text": "何もしてない。けど、\n司書制度は今以降、あたし\nに牙を剥くようになる。",
            "zh": "什么都没做。不过，\n司书制度从今往后，就会\n对我露出獠牙了。",
            "narrator_zh": "？？？"
        },
        {
            "location": "491/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょっと！　意味が\n分からないんだけど！",
            "zh": "等一下！　我完全\n听不懂你在说什么！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "492/TALK",
            "narrator": "？？？",
            "text": "あたしはずっと、他の\nココロの司書の動向も含め\n観察をしていた。",
            "zh": "我一直都在观察，\n包括其他心之司书\n在内的动向。",
            "narrator_zh": "？？？"
        },
        {
            "location": "493/TALK",
            "narrator": "？？？",
            "text": "そして今、いよいよ\n他のココロの司書は、\nそれ自体が生け贄となり―",
            "zh": "而如今，终于\n其他心灵的司书，\n连自身都成了祭品――",
            "narrator_zh": "？？？"
        },
        {
            "location": "494/TALK",
            "narrator": "？？？",
            "text": "より強力な『半人格』へと\n差し替わっていっている。",
            "zh": "正在被替换成\n更加强大的『半人格』。",
            "narrator_zh": "？？？"
        },
        {
            "location": "495/TALK",
            "narrator": "？？？",
            "text": "だから、そうなる前に\nあたしのココロを外部から\nシャットアウトするの。",
            "zh": "所以，在那之前\n我要将我的心灵\n与外部彻底隔绝。",
            "narrator_zh": "？？？"
        },
        {
            "location": "496/TALK",
            "narrator": "？？？",
            "text": "その為には\n外部と繋がっている\nあんたがとても邪魔。",
            "zh": "为此，\n与外部相连的你\n实在太碍事了。",
            "narrator_zh": "？？？"
        },
        {
            "location": "497/TALK",
            "narrator": "ガブリエラ",
            "text": "……なによそれ。\n随分と身勝手じゃない？",
            "zh": "……那算什么啊。\n未免也太自私了吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "498/TALK",
            "narrator": "ガブリエラ",
            "text": "元はといえば、\nあたしを選んだのは、\nあたしたちの総意でしょ？",
            "zh": "说到底，\n选择我来当司书的，\n不正是我们的总意吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "499/TALK",
            "narrator": "ガブリエラ",
            "text": "それを、都合が悪く\nなったら、あたし一人の\nせいにするっていうの！？",
            "zh": "结果现在情况不利了，\n就要把责任全推到\n我一个人头上吗！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "500/TALK",
            "narrator": "？？？",
            "text": "不幸な事故だったと\n思うしかないわね。",
            "zh": "那也只能算作是\n不幸的意外了呢。",
            "narrator_zh": "？？？"
        },
        {
            "location": "501/TALK",
            "narrator": "？？？",
            "text": "元々貴方は\n生け贄みたいなもの\nだったんだから。",
            "zh": "毕竟原本你\n就跟祭品\n差不多。",
            "narrator_zh": "？？？"
        },
        {
            "location": "502/TALK",
            "narrator": "？？？",
            "text": "こうなることだって、\n想像していなかったとは\n言わせないわよ。",
            "zh": "可别说你从没\n预料到事情会\n变成这样哦。",
            "narrator_zh": "？？？"
        },
        {
            "location": "503/TALK",
            "narrator": "？？？",
            "text": "それに。\n総意はあくまで総意。",
            "zh": "而且。\n总意终究只是总意。",
            "narrator_zh": "？？？"
        },
        {
            "location": "504/TALK",
            "narrator": "？？？",
            "text": "あたしは最初から、\n司書の件については\n反対し続けていた。",
            "zh": "我从一开始，\n就一直在反对\n司书这件事。",
            "narrator_zh": "？？？"
        },
        {
            "location": "505/TALK",
            "narrator": "？？？",
            "text": "だから、\nあんたにとやかく\n言われる筋合いはないわ。",
            "zh": "所以，\n轮不到你对我\n说三道四。",
            "narrator_zh": "？？？"
        },
        {
            "location": "506/TALK",
            "narrator": "ガブリエラ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "507/SEL",
            "narrator": "",
            "text": "何？　どういうこと！？",
            "zh": "什么？　这是怎么回事！？",
            "narrator_zh": ""
        },
        {
            "location": "508/ACT",
            "narrator": "",
            "text": "何？　どういうこと！？",
            "zh": "什么？　这是怎么回事！？",
            "narrator_zh": ""
        },
        {
            "location": "512/TALK",
            "narrator": "ガブリエラ",
            "text": "…ごめんなさいね。\n話は後。",
            "zh": "……抱歉啊。\n话等会儿再说。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "513/TALK",
            "narrator": "ガブリエラ",
            "text": "今は、こいつを何とか\nしないと、話す以前に\nあたしが消されちゃう。",
            "zh": "现在要是放着这家伙\n不管，别说说话了，\n我都要被抹消掉了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "514/TALK",
            "narrator": "ガブリエラ",
            "text": "意味が分からない中で\n納得いかないだろうけど、\nあたしに協力して欲しい。",
            "zh": "虽然在搞不清状况时\n你可能难以接受，\n但我需要你的协助。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "515/TALK",
            "narrator": "ガブリエラ",
            "text": "目の前にいる刺客を\n一緒に倒して欲しいの。",
            "zh": "我希望你能和我一起\n打倒眼前的刺客。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "516/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしが助かったら、\nちゃんと事情を説明\nするから。それでいい？",
            "zh": "只要我得救了，\n我就会把事情原委\n好好解释清楚。可以吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "517/SEL",
            "narrator": "",
            "text": "いいよ",
            "zh": "好啊",
            "narrator_zh": ""
        },
        {
            "location": "518/SEL",
            "narrator": "",
            "text": "言われるまでも無く護るよ",
            "zh": "不用你说我也会保护你的",
            "narrator_zh": ""
        },
        {
            "location": "519/ACT",
            "narrator": "",
            "text": "いいよ",
            "zh": "好啊",
            "narrator_zh": ""
        },
        {
            "location": "520/TALK",
            "narrator": "ガブリエラ",
            "text": "ありがと。",
            "zh": "谢谢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "521/ACT",
            "narrator": "",
            "text": "言われるまでも無く護るよ",
            "zh": "不用你说我也会保护你的",
            "narrator_zh": ""
        },
        {
            "location": "523/TALK",
            "narrator": "ガブリエラ",
            "text": "ありがとう…嬉しい。",
            "zh": "谢谢……我好开心。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "525/TALK",
            "narrator": "ガブリエラ",
            "text": "やっぱりあたしは\nあんたのことが好き。",
            "zh": "我果然还是\n最喜欢你了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "527/TALK",
            "narrator": "ガブリエラ",
            "text": "それじゃ、お願いね。",
            "zh": "那么，拜托你了哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "528/TALK",
            "narrator": "ガブリエラ",
            "text": "バトルに勝ったら、\n現実に追い出されるけど、\n心配はしなくて平気よ。",
            "zh": "赢下战斗之后，\n你会被赶回现实，\n不过不用担心的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "529/SEL",
            "narrator": "",
            "text": "でもそしたら、心の葛藤は！？",
            "zh": "可是那样的话，内心的葛藤怎么办！？",
            "narrator_zh": ""
        },
        {
            "location": "530/ACT",
            "narrator": "",
            "text": "でもそしたら、心の葛藤は！？",
            "zh": "可是那样的话，内心的葛藤怎么办！？",
            "narrator_zh": ""
        },
        {
            "location": "532/TALK",
            "narrator": "ガブリエラ",
            "text": "一度や二度\n解決しなくても\n死にはしないわよ。",
            "zh": "一两次没有\n解决掉也不会\n死人的啦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "534/TALK",
            "narrator": "ガブリエラ",
            "text": "今はこっちの方が\nよっぽど危険だもの。",
            "zh": "比起那个，现在这边\n可要危险得多呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "537/TALK",
            "narrator": "ガブリエラ",
            "text": "だからお願い。\nあたしに力を貸して！",
            "zh": "所以拜托了。\n把力量借给我吧！",
            "narrator_zh": "加布里埃拉"
        },
        {
