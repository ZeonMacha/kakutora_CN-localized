{
    "dir": "chap09/daydra/dd_ch05_09_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "9505",
        "cid": "kagura",
        "title": "005 メインストーリー",
        "sub_title": "乙女と悪女＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "少女与恶女＜后篇＞"
    },
    "entry": [
        {
            "location": "2249/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2250/TALK",
            "narrator": "神楽",
            "text": "でも、せっかくこんなに\n楽しくお話ししたのに…。",
            "zh": "可是，难得\n聊得这么开心……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2251/TALK",
            "narrator": "神楽",
            "text": "最後の最後で空気を\n悪くしちゃうのは、\nイヤかも…。",
            "zh": "要是在最后关头\n把气氛搞砸，\n也许不太想……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2252/TALK",
            "narrator": "繭",
            "text": "…無理しないで、\n断ってもいいのよ？",
            "zh": "……不用勉强，\n拒绝也可以哦？",
            "narrator_zh": "茧"
        },
        {
            "location": "2254/TALK",
            "narrator": "神楽",
            "text": "え？",
            "zh": "诶？",
            "narrator_zh": "神乐"
        },
        {
            "location": "2255/TALK",
            "narrator": "繭",
            "text": "部屋は自分にとって、\n聖域と言ってもいい\nプライベートな空間。",
            "zh": "房间对自己来说，\n可以说是圣域一样的\n私人空间。",
            "narrator_zh": "茧"
        },
        {
            "location": "2256/TALK",
            "narrator": "繭",
            "text": "他人に見られたくない\nモノがあったとしても、\nそれは普通だもの。",
            "zh": "就算有不想被别人\n看到的东西，\n那也很正常。",
            "narrator_zh": "茧"
        },
        {
            "location": "2258/TALK",
            "narrator": "雛",
            "text": "あー、そっかぁ…。\nそういう場合もあるの\n考えてなかったなー。",
            "zh": "啊，这样啊……。\n还有这种情况，\n我没考虑到呢。",
            "narrator_zh": "雏"
        },
        {
            "location": "2260/TALK",
            "narrator": "神楽",
            "text": "いえ、その…。",
            "zh": "不，那个……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2261/TALK",
            "narrator": "神楽",
            "text": "見られたくない、\nという点に関しては、\n間違いじゃないけど…。",
            "zh": "不想被看到\n这一点，\n倒也没错……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2263/TALK",
            "narrator": "神楽",
            "text": "まあ、そういうことに\nしておこっと。",
            "zh": "嘛，就当成\n是这么回事吧。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2264/TALK",
            "narrator": "神楽",
            "text": "ごめんなさい。\nひなこさんの期待に\n応えられなくて…。",
            "zh": "对不起。\n没能回应小雏的\n期待……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2266/TALK",
            "narrator": "雛",
            "text": "あはは、いいのいいのー。",
            "zh": "啊哈哈，没关系没关系。",
            "narrator_zh": "雏"
        },
        {
            "location": "2267/TALK",
            "narrator": "雛",
            "text": "こっちこそ、\n無理言って困らせちゃった\nみたいで、ごめんねー。",
            "zh": "是我这边，\n好像提了无理的要求\n让你为难了，对不起。",
            "narrator_zh": "雏"
        },
        {
            "location": "2268/TALK",
            "narrator": "神楽",
            "text": "いえ、そんな…。\nまた一緒にお茶しに\n来ましょうね。",
            "zh": "没有那种事……。\n下次再一起\n来喝茶吧。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2270/TALK",
            "narrator": "繭",
            "text": "次はラノベ縛りで。",
            "zh": "下次只聊轻小说。",
            "narrator_zh": "茧"
        },
        {
            "location": "2271/TALK",
            "narrator": "神楽",
            "text": "絶対やりましょう！",
            "zh": "一定要这么做！",
            "narrator_zh": "神乐"
        },
        {
            "location": "2272/TALK",
            "narrator": "雛",
            "text": "あたしも予習して\nおくよー。",
            "zh": "我也会先预习\n一下的。",
            "narrator_zh": "雏"
        },
        {
            "location": "2294/TALK",
            "narrator": "神楽",
            "text": "はぁーっ…楽しかった♪",
            "zh": "哈啊……好开心♪",
            "narrator_zh": "神乐"
        },
        {
            "location": "2295/TALK",
            "narrator": "神楽",
            "text": "こんなに楽しい時間を\n過ごしたのって、\nすごく久しぶりかも。",
            "zh": "度过这么开心的时间，\n好像已经\n很久没有过了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2296/SEL",
            "narrator": "",
            "text": "機嫌よさそうだね",
            "zh": "看起来心情很好呢",
            "narrator_zh": ""
        },
        {
            "location": "2297/ACT",
            "narrator": "",
            "text": "機嫌よさそうだね",
            "zh": "看起来心情很好呢",
            "narrator_zh": ""
        },
        {
            "location": "2313/TALK",
            "narrator": "神楽",
            "text": "そうなんですよ",
            "zh": "是这样的",
            "narrator_zh": "神乐"
        },
        {
            "location": "2314/TALK",
            "narrator": "神楽",
            "text": "今日はとっても楽しい一日だったんです",
            "zh": "今天是非常开心的一天",
            "narrator_zh": "神乐"
        },
        {
            "location": "2315/TALK",
            "narrator": "神楽",
            "text": "ひなこさん達と放課後に",
            "zh": "放学后和小雏她们",
            "narrator_zh": "神乐"
        },
        {
            "location": "2316/TALK",
            "narrator": "神楽",
            "text": "とっても楽しい時間を過ごせたから",
            "zh": "度过了非常开心的时光",
            "narrator_zh": "神乐"
        },
        {
            "location": "2318/SEL",
            "narrator": "",
            "text": "そんなに楽しい話したっけ？",
            "zh": "有聊得那么开心吗？",
            "narrator_zh": ""
        },
        {
            "location": "2319/SEL",
            "narrator": "",
            "text": "普通の女子高生みたいだった",
            "zh": "像个普通的女高中生",
            "narrator_zh": ""
        },
        {
            "location": "2320/ACT",
            "narrator": "",
            "text": "そんなに楽しい話したっけ？",
            "zh": "有聊得那么开心吗？",
            "narrator_zh": ""
        },
        {
            "location": "2321/TALK",
            "narrator": "神楽",
            "text": "しましたよ",
            "zh": "聊过的",
            "narrator_zh": "神乐"
        },
        {
            "location": "2322/TALK",
            "narrator": "神楽",
            "text": "ちょっとだけだったけど",
            "zh": "虽然只有一点点",
            "narrator_zh": "神乐"
        },
        {
            "location": "2323/TALK",
            "narrator": "神楽",
            "text": "ラノベの話とか",
            "zh": "像是轻小说的话题",
            "narrator_zh": "神乐"
        },
        {
            "location": "2324/ACT",
            "narrator": "神楽",
            "text": "普通の女子高生みたいだった",
            "zh": "像个普通的女高中生",
            "narrator_zh": "神乐"
        },
        {
            "location": "2325/TALK",
            "narrator": "神楽",
            "text": "あの時間は",
            "zh": "那段时间里",
            "narrator_zh": "神乐"
        },
        {
            "location": "2326/TALK",
            "narrator": "神楽",
            "text": "色んな考えなければならないこと",
            "zh": "各种各样必须去想的事",
            "narrator_zh": "神乐"
        },
        {
            "location": "2327/TALK",
            "narrator": "神楽",
            "text": "全部頭の中から抜けてましたから",
            "zh": "全都从脑子里消失了",
            "narrator_zh": "神乐"
        },
        {
            "location": "2328/TALK",
            "narrator": "神楽",
            "text": "それにちょっとだけど",
            "zh": "而且虽然只有一点点",
            "narrator_zh": "神乐"
        },
        {
            "location": "2329/TALK",
            "narrator": "神楽",
            "text": "ラノベの話もできましたし",
            "zh": "也聊到了轻小说",
            "narrator_zh": "神乐"
        },
        {
            "location": "2331/TALK",
            "narrator": "神楽",
            "text": "繭さんがオンオフとダダマホを知ってたなんて",
            "zh": "没想到茧知道开关派和赖妹魔法",
            "narrator_zh": "神乐"
        },
        {
            "location": "2332/TALK",
            "narrator": "神楽",
            "text": "今度じっくり語り合いたいです",
            "zh": "下次想好好聊个够",
            "narrator_zh": "神乐"
        },
        {
            "location": "2333/TALK",
            "narrator": "神楽",
            "text": "その時はひなこさんも一緒だったらいいんですけど",
            "zh": "那时候要是小雏也在一起就好了",
            "narrator_zh": "神乐"
        },
        {
            "location": "2335/SEL",
            "narrator": "",
            "text": "本当に二人のことが気に入ったんだね",
            "zh": "真的很喜欢她们两个呢",
            "narrator_zh": ""
        },
        {
            "location": "2336/SEL",
            "narrator": "",
            "text": "$me$もラノベを読んだ方がいい？",
            "zh": "$me$也读读轻小说比较好吗？",
            "narrator_zh": ""
        },
        {
            "location": "2337/ACT",
            "narrator": "",
            "text": "本当に二人のことが気に入ったんだね",
            "zh": "真的很喜欢她们两个呢",
            "narrator_zh": ""
        },
        {
            "location": "2338/TALK",
            "narrator": "神楽",
            "text": "はい！",
            "zh": "是的！",
            "narrator_zh": "神乐"
        },
        {
            "location": "2341/TALK",
            "narrator": "神楽",
            "text": "実は話してるときに",
            "zh": "其实聊天的时候",
            "narrator_zh": "神乐"
        },
        {
            "location": "2342/TALK",
            "narrator": "神楽",
            "text": "ちょっとだけ冷たい態度を取りそうな気持ちになっちゃって",
            "zh": "差一点就想摆出冷淡的态度",
            "narrator_zh": "神乐"
        },
        {
            "location": "2343/TALK",
            "narrator": "神楽",
            "text": "でも",
            "zh": "可是",
            "narrator_zh": "神乐"
        },
        {
            "location": "2344/TALK",
            "narrator": "神楽",
            "text": "思いとどまってよかった",
            "zh": "忍住了真是太好了",
            "narrator_zh": "神乐"
        },
        {
            "location": "2345/TALK",
            "narrator": "神楽",
            "text": "言ってたら多分今頃",
            "zh": "要是说出来的话，大概现在",
            "narrator_zh": "神乐"
        },
        {
            "location": "2346/TALK",
            "narrator": "神楽",
            "text": "ずっと後悔してたと思うし",
            "zh": "会一直后悔吧",
            "narrator_zh": "神乐"
        },
        {
            "location": "2350/TALK",
            "narrator": "神楽",
            "text": "こんなに素敵なお友達ができるなんて",
            "zh": "能交到这么好的朋友",
            "narrator_zh": "神乐"
        },
        {
            "location": "2351/TALK",
            "narrator": "神楽",
            "text": "思ってませんでした",
            "zh": "我根本没想到",
            "narrator_zh": "神乐"
        },
        {
            "location": "2352/TALK",
            "narrator": "神楽",
            "text": "早くまた一緒にでかけたいです",
            "zh": "想快点再一起出去",
            "narrator_zh": "神乐"
        },
        {
            "location": "2353/ACT",
            "narrator": "",
            "text": "$me$もラノベを読んだ方がいい？",
            "zh": "$me$也读读轻小说比较好吗？",
            "narrator_zh": ""
        },
        {
            "location": "2354/TALK",
            "narrator": "神楽",
            "text": "読むべきですよ",
            "zh": "应该读的哦",
            "narrator_zh": "神乐"
        },
        {
            "location": "2355/TALK",
            "narrator": "神楽",
            "text": "面白いラノベは沢山あるんだから",
            "zh": "有趣的轻小说有很多",
            "narrator_zh": "神乐"
        },
        {
            "location": "2356/TALK",
            "narrator": "神楽",
            "text": "きっと気に入るのが見つかるはずです",
            "zh": "一定能找到喜欢的那本",
            "narrator_zh": "神乐"
        },
        {
            "location": "2357/TALK",
            "narrator": "神楽",
            "text": "$handle$さんにあった一冊が見つかるといいですね",
            "zh": "要是能找到适合$handle$的一本就好了",
            "narrator_zh": "神乐"
        },
        {
            "location": "2359/TALK",
            "narrator": "神楽",
            "text": "ごめんなさい",
            "zh": "对不起",
            "narrator_zh": "神乐"
        },
        {
            "location": "2360/TALK",
            "narrator": "神楽",
            "text": "ひなこさん達にお礼のＷＡＶＥ送らないといけないので",
            "zh": "得给小雏她们发一封道谢的WAVE",
            "narrator_zh": "神乐"
        },
        {
            "location": "2361/TALK",
            "narrator": "神楽",
            "text": "お話はまた後で",
            "zh": "聊天以后再说",
            "narrator_zh": "神乐"
        },
        {
            "location": "2365/TALK",
            "narrator": "神楽",
            "text": "えっと…先ほどはどうも\nありがとう――",
            "zh": "那个……刚才真是\n谢谢你——",
            "narrator_zh": "神乐"
        },
        {
            "location": "2366/TALK",
            "narrator": "神楽",
            "text": "うーん…これだと\nちょっと堅い感じに\nなっちゃうから…。",
            "zh": "嗯……这样的话\n感觉会有点生硬，\n所以……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2367/TALK",
            "narrator": "神楽",
            "text": "今日は楽しかったです。\nまた行きましょうね、と。",
            "zh": "今天很开心。\n下次再一起去吧，这样。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2368/TALK",
            "narrator": "神楽",
            "text": "…うん、これでよし。",
            "zh": "……嗯，这样就可以了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2371/TALK",
            "narrator": "神楽",
            "text": "ふふっ…、\n次のお休みの日が\n楽しみだなぁ…。",
            "zh": "呵呵……，\n下次的休息日\n好让人期待……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2380/DIALOG",
            "narrator": "Dialog_chapter_ch05",
            "text": "【07 愛，ロボット】",
            "zh": "【07 爱，机器人】",
            "narrator_zh": "Dialog_chapter_ch05"
        },
        {
            "location": "2392/DIALOG",
            "narrator": "Dialog_chapter_ch05",
            "text": "【07 愛，ロボット】",
            "zh": "【07 爱，机器人】",
            "narrator_zh": "Dialog_chapter_ch05"
        }
    ]
}
