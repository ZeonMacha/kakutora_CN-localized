    "type": "MainStory",
    "info": {
        "story_id": "27305",
        "cid": "gabriella",
        "title": "005 メインストーリー",
        "sub_title": "今ここにある奇跡＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "此刻就在这里的奇迹＜后篇＞"
    },
    "entry": [
        {
            "location": "403/SCENARIO",
            "narrator": "",
            "text": "今ここにある奇跡のようなもの",
            "zh": "宛如此刻就在这里的奇迹般的事物",
            "narrator_zh": ""
        },
        {
            "location": "424/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤの様子を\n見てくるわ。",
            "zh": "我去看看\n绫水的情况。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "426/TALK",
            "narrator": "みやび",
            "text": "ガブちゃんは\n落ち着いた？",
            "zh": "加布你\n冷静下来咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "427/TALK",
            "narrator": "ガブリエラ",
            "text": "…大丈夫よ。\nちょっと謝りたくて。",
            "zh": "……没事了。\n我想去道个歉。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "429/TALK",
            "narrator": "みやび",
            "text": "やったら\nいってらっしゃい。",
            "zh": "那就\n快去咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "430/TALK",
            "narrator": "ガブリエラ",
            "text": "…行ってきます。",
            "zh": "……我去了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "451/TALK",
            "narrator": "ガブリエラ",
            "text": "ここにいたのね。",
            "zh": "你在这里呀。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "453/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィ…。",
            "zh": "加维……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "456/TALK",
            "narrator": "ガブリエラ",
            "text": "…ええと…。",
            "zh": "……那个……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "457/TALK",
            "narrator": "ガブリエラ",
            "text": "さっきはごめん。",
            "zh": "刚才对不起。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "459/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしちょっと\n言い過ぎたわ。",
            "zh": "我刚才说话\n有点过分了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "460/TALK",
            "narrator": "アーヤ",
            "text": "ううん。\nいいのよ。",
            "zh": "没关系。\n不用放在心上。",
            "narrator_zh": "绫水"
        },
        {
            "location": "461/TALK",
            "narrator": "アーヤ",
            "text": "私こそ確かに\n大人げなかったわ。",
            "zh": "我才是不够成熟，\n太孩子气了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "462/TALK",
            "narrator": "アーヤ",
            "text": "なかなか整理が\n付けられないのよ\n自分の気持ちの。",
            "zh": "我自己也总是\n理不清\n自己的心情。",
            "narrator_zh": "绫水"
        },
        {
            "location": "463/TALK",
            "narrator": "アーヤ",
            "text": "姉がらみだとね。",
            "zh": "只要一牵扯到姐姐呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "464/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "465/TALK",
            "narrator": "アーヤ",
            "text": "ねえギャヴィ。\nバタフライエフェクトって\n知ってる？",
            "zh": "我说加维。\n你知道\n“蝴蝶效应”吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "466/TALK",
            "narrator": "ガブリエラ",
            "text": "確か映画のタイトルに\nあったわ。",
            "zh": "记得以前有部电影\n就叫这个名字。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "468/TALK",
            "narrator": "アーヤ",
            "text": "そうね。",
            "zh": "是啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "469/TALK",
            "narrator": "アーヤ",
            "text": "些細な出来事の変化で\n未来が変わるって\nＳＦ映画。",
            "zh": "讲述一个微小的事件变化\n导致未来发生巨变的\n科幻电影。",
            "narrator_zh": "绫水"
        },
        {
            "location": "471/TALK",
            "narrator": "アーヤ",
            "text": "元々は気象学者の\n言葉だったらしいけど。",
            "zh": "虽然原本似乎是\n气象学家提出的话。",
            "narrator_zh": "绫水"
        },
        {
            "location": "472/TALK",
            "narrator": "アーヤ",
            "text": "…今の状態ってまさに\nバタフライエフェクトだと\n思わない？",
            "zh": "……不觉得现在的状况，\n简直就是\n蝴蝶效应吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "473/TALK",
            "narrator": "ガブリエラ",
            "text": "…確かにね。",
            "zh": "……确实呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "474/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしがアーヤの実家に\n行くことになるとか。",
            "zh": "像我居然会去\n绫水的老家什么的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "475/TALK",
            "narrator": "ガブリエラ",
            "text": "世界選手権でアーヤを\n見た時には考えも\nしなかったわ。",
            "zh": "在世界锦标赛上看到\n绫水的时候，我可是\n想都没想过呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "476/TALK",
            "narrator": "アーヤ",
            "text": "ね？",
            "zh": "是吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "477/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしにとっては\nそれは奇跡みたいな\nものだけど。",
            "zh": "对我来说，\n这简直就像是\n奇迹一样的事。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "478/TALK",
            "narrator": "ガブリエラ",
            "text": "きっとつばめはメノウが\n神楽だったことが\n奇跡だったりするのよね。",
            "zh": "而对燕来说，MENOW\n竟然就是神乐这件事，\n大概也是奇迹吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "479/TALK",
            "narrator": "アーヤ",
            "text": "…そうかもね。",
            "zh": "……或许吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "481/TALK",
            "narrator": "アーヤ",
            "text": "私にとっては神社の娘に\n生まれて、いまここに\nいることが奇跡なのかも。",
            "zh": "对我来说，生为神社的女儿，\n如今能站在这里，\n或许就是奇迹吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "482/TALK",
            "narrator": "ガブリエラ",
            "text": "そうなの？",
            "zh": "是这样吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "483/TALK",
            "narrator": "アーヤ",
            "text": "…おかしい？",
            "zh": "……很奇怪吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "484/SEL",
            "narrator": "",
            "text": "そのことで話がある",
            "zh": "关于这件事我有话要说",
            "narrator_zh": ""
        },
        {
            "location": "485/SEL",
            "narrator": "",
            "text": "ちゃんと話せるのかな",
            "zh": "还能好好说话吗",
            "narrator_zh": ""
        },
        {
            "location": "486/SEL",
            "narrator": "",
            "text": "バグは勘弁",
            "zh": "可别再出Bug了啊",
            "narrator_zh": ""
        },
        {
            "location": "487/SEL",
            "narrator": "",
            "text": "ガブリエラと$me$の出会いも奇跡",
            "zh": "加布里埃拉和$me$的相遇也是奇迹",
            "narrator_zh": ""
        },
        {
            "location": "488/ACT",
            "narrator": "",
            "text": "そのことで話がある",
            "zh": "关于这件事我有话要说",
            "narrator_zh": ""
        },
        {
            "location": "506/TALK",
            "narrator": "ガブリエラ",
            "text": "何かしら",
            "zh": "怎么了吗",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "508/ACT",
            "narrator": "",
            "text": "ちゃんと話せるのかな",
            "zh": "还能好好说话吗",
            "narrator_zh": ""
        },
        {
            "location": "526/TALK",
            "narrator": "ガブリエラ",
            "text": "ええと？",
            "zh": "那个？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "528/TALK",
            "narrator": "ガブリエラ",
            "text": "いつだって",
            "zh": "不是一直都",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "529/TALK",
            "narrator": "ガブリエラ",
            "text": "お話ししているでしょう？",
            "zh": "在好好说着话吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "531/ACT",
            "narrator": "",
            "text": "バグは勘弁",
            "zh": "可别再出Bug了啊",
            "narrator_zh": ""
        },
        {
            "location": "549/TALK",
            "narrator": "ガブリエラ",
            "text": "え",
            "zh": "诶",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "550/TALK",
            "narrator": "ガブリエラ",
            "text": "何を言ってるの",
            "zh": "你在说什么呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "551/TALK",
            "narrator": "ガブリエラ",
            "text": "突然",
            "zh": "突然之间",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "553/ACT",
            "narrator": "",
            "text": "ガブリエラと$me$の出会いも奇跡",
            "zh": "加布里埃拉和$me$的相遇也是奇迹",
            "narrator_zh": ""
        },
        {
            "location": "571/TALK",
            "narrator": "ガブリエラ",
            "text": "確かにｖｖｖ",
            "zh": "确实ｖｖｖ",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "573/TALK",
            "narrator": "ガブリエラ",
            "text": "そうかもしれないわ////////////",
            "zh": "也许真是那样呢////////////",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "576/SEL",
            "narrator": "",
            "text": "正常っぽい？",
            "zh": "看起来还算正常？",
            "narrator_zh": ""
        },
        {
            "location": "577/SEL",
            "narrator": "",
            "text": "念には念を入れて",
            "zh": "以防万一还是再确认一下",
            "narrator_zh": ""
        },
        {
            "location": "578/SEL",
            "narrator": "",
            "text": "要点だけ伝えれば大丈夫か",
            "zh": "只传达要点的话应该没问题吧",
            "narrator_zh": ""
        },
        {
            "location": "579/ACT",
            "narrator": "",
            "text": "正常っぽい？",
            "zh": "看起来还算正常？",
            "narrator_zh": ""
        },
        {
            "location": "580/TALK",
            "narrator": "ガブリエラ",
            "text": "何の話？",
            "zh": "你在说什么呀？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "582/ACT",
            "narrator": "",
            "text": "念には念を入れて",
            "zh": "以防万一还是再确认一下",
            "narrator_zh": ""
        },
        {
            "location": "583/TALK",
            "narrator": "ガブリエラ",
            "text": "何かあるのかしら？",
            "zh": "是有什么事吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "585/ACT",
            "narrator": "",
            "text": "要点だけ伝えれば大丈夫か",
            "zh": "只传达要点的话应该没问题吧",
            "narrator_zh": ""
        },
        {
            "location": "586/TALK",
            "narrator": "ガブリエラ",
            "text": "ええと？",
            "zh": "那个？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "590/SEL",
            "narrator": "",
            "text": "実家でアーヤの話し相手になってあげて",
            "zh": "在老家的时候多陪绫水聊聊天吧",
            "narrator_zh": ""
        },
        {
            "location": "591/ACT",
            "narrator": "",
            "text": "実家でアーヤの話し相手になってあげて",
            "zh": "在老家的时候多陪绫水聊聊天吧",
            "narrator_zh": ""
        },
        {
            "location": "593/TALK",
            "narrator": "ガブリエラ",
            "text": "なんで急に",
            "zh": "怎么突然",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "594/TALK",
            "narrator": "ガブリエラ",
            "text": "そんなこと言うの？",
            "zh": "说起这种事？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "596/SEL",
            "narrator": "",
            "text": "今は言えない",
            "zh": "现在还不能说",
            "narrator_zh": ""
        },
        {
            "location": "597/SEL",
            "narrator": "",
            "text": "後でわかる",
            "zh": "之后就会明白了",
            "narrator_zh": ""
        },
        {
            "location": "598/SEL",
            "narrator": "",
            "text": "ガブリエラにしかできないことだから",
            "zh": "因为这是只有加布里埃拉才能做到的事",
            "narrator_zh": ""
        },
        {
            "location": "599/ACT",
            "narrator": "",
            "text": "今は言えない",
            "zh": "现在还不能说",
            "narrator_zh": ""
        },
        {
            "location": "600/TALK",
            "narrator": "ガブリエラ",
            "text": "何よそれ？",
            "zh": "什么呀那是？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "602/ACT",
            "narrator": "",
            "text": "後でわかる",
            "zh": "之后就会明白了",
            "narrator_zh": ""
        },
        {
            "location": "603/TALK",
            "narrator": "ガブリエラ",
            "text": "なんで今じゃないの？",
            "zh": "为什么现在不行？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "605/ACT",
            "narrator": "",
            "text": "ガブリエラにしかできないことだから",
            "zh": "因为这是只有加布里埃拉才能做到的事",
            "narrator_zh": ""
        },
        {
            "location": "606/TALK",
            "narrator": "ガブリエラ",
            "text": "それは",
            "zh": "那倒",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "607/TALK",
            "narrator": "ガブリエラ",
            "text": "そうかもしれないけど",
            "zh": "也不是不可能啦",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "610/SEL",
            "narrator": "",
            "text": "<size=22>e38182e38284e381aee38182e381ade381a0e38191e381a9e38195e38195e38188e381a6e38182e38192e381a6</size>",
            "zh": "<size=22>e38182e38284e381aee38182e381ade381a0e38191e381a9e38195e38195e38188e381a6e38182e38192e381a6</size>",
            "narrator_zh": ""
        },
        {
            "location": "613/TALK",
            "narrator": "ガブリエラ",
            "text": "え",
            "zh": "诶",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "614/TALK",
            "narrator": "ガブリエラ",
            "text": "何これ",
            "zh": "这是什么",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "615/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょっと！",
            "zh": "喂！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "627/TALK",
            "narrator": "ガブリエラ",
            "text": "文字化けかしら？\nそれとも入力ミス？\n変なの…。",
            "zh": "难道是乱码吗？\n还是打错字了？\n真奇怪……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "628/TALK",
            "narrator": "アーヤ",
            "text": "とりあえず先を\n急ぎましょう。",
            "zh": "总之我们先\n继续赶路吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "629/TALK",
            "narrator": "ガブリエラ",
            "text": "そうね。",
            "zh": "说得也是。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "630/TALK",
            "narrator": "アーヤ",
            "text": "うちの実家、本当に\n山奥の田舎だから\nびっくりしないでね。",
            "zh": "我老家真的是\n深山里的乡下，\n到时候别吓到哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "631/TALK",
            "narrator": "ガブリエラ",
            "text": "それは逆に楽しみかも。",
            "zh": "这么一说我反而更期待了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "632/TALK",
            "narrator": "アーヤ",
            "text": "本当に何もないからね。",
            "zh": "真的什么都没有哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "634/TALK",
            "narrator": "ガブリエラ",
            "text": "そんなに\n強調しなくても…。",
            "zh": "也不用这么\n反复强调啦……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "645/DIALOG",
            "narrator": "Dialog_chapter_ch03",
            "text": "【22 トークン・リング】",
            "zh": "【22 令牌环网】",
            "narrator_zh": "Dialog_chapter_ch03"
        }
    ]
}
