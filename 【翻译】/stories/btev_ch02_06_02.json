{
    "dir": "chap06/battle/btev_ch02_06_02.js",
    "type": "",
    "info": {
        "story_id": "22009",
        "cid": "",
        "title": "009 ココロスフィアストーリー【Lv03】",
        "sub_title": "姉妹の隔絶Ⅰ＜帰結＞",
        "title_zh": "009 心灵领域故事【Lv03】",
        "sub_title_zh": "姐妹间的隔阂Ⅰ＜归结＞"
    },
    "entry": [
        {
            "location": "122/SCENARIO",
            "narrator": "",
            "text": "姉妹の隔絶・前編２",
            "zh": "姐妹间的隔阂·前篇2",
            "narrator_zh": ""
        },
        {
            "location": "131/TALK",
            "narrator": "表層アーヤ",
            "text": "見かけによらず、\n随分と根性が\nあるのね……。",
            "zh": "人不可貌相，\n骨气倒还\n挺硬的嘛……。",
            "narrator_zh": "表层绫水"
        },
        {
            "location": "132/TALK",
            "narrator": "潜在アーヤ",
            "text": "当然じゃない。",
            "zh": "那不是当然的嘛。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "133/TALK",
            "narrator": "潜在アーヤ",
            "text": "それくらいもう、\n私にはどうでも\nいいことなの。",
            "zh": "那种程度的念头，\n对我来说早就\n无所谓了。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "135/TALK",
            "narrator": "表層アーヤ",
            "text": "……あり得ない。",
            "zh": "……不可能。",
            "narrator_zh": "表层绫水"
        },
        {
            "location": "136/TALK",
            "narrator": "表層アーヤ",
            "text": "まあいいわ。\nここは一時退却。",
            "zh": "算了。\n这次就先暂时撤退。",
            "narrator_zh": "表层绫水"
        },
        {
            "location": "137/TALK",
            "narrator": "表層アーヤ",
            "text": "でも、私の想いだって\n今の攻撃程度じゃ\n消えはしない。",
            "zh": "不过，我的这份心意\n凭刚才那点攻击\n是不可能消失的。",
            "narrator_zh": "表层绫水"
        },
        {
            "location": "138/TALK",
            "narrator": "表層アーヤ",
            "text": "立て直してまた来る\nから、首を洗って\n待ってらっしゃい。",
            "zh": "等我重整旗鼓还会再来的，\n洗干净脖子\n等着吧。",
            "narrator_zh": "表层绫水"
        },
        {
            "location": "148/TALK",
            "narrator": "潜在アーヤ",
            "text": "全く、しぶといわね。",
            "zh": "真是的，好难缠啊。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "157/TALK",
            "narrator": "潜在アーヤ",
            "text": "ね、首を洗って\n待ってらっしゃい、\nとか――",
            "zh": "我说，“洗干净脖子\n等着吧”\n之类的——",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "159/TALK",
            "narrator": "潜在アーヤ",
            "text": "いまどき\nダサいと思わない？",
            "zh": "不觉得这年头说这种话\n超土的吗？",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "160/SEL",
            "narrator": "（選択肢）",
            "text": "確かに、笑える",
            "zh": "确实，好笑死了",
            "narrator_zh": "（选项）"
        },
        {
            "location": "161/SEL",
            "narrator": "（選択肢）",
            "text": "そういうところ、好きだけどな",
            "zh": "我倒是挺喜欢那样的",
            "narrator_zh": "（选项）"
        },
        {
            "location": "162/ACT",
            "narrator": "",
            "text": "確かに、笑える",
            "zh": "确实，好笑死了",
            "narrator_zh": ""
        },
        {
            "location": "163/TALK",
            "narrator": "潜在アーヤ",
            "text": "ね。",
            "zh": "对吧。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "164/TALK",
            "narrator": "潜在アーヤ",
            "text": "私はそういう、\nイケてない自分を\n変えていきたいの。",
            "zh": "我就是想改变那样\n一点也不帅气的\n自己。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "165/TALK",
            "narrator": "潜在アーヤ",
            "text": "だから、これからも\n是非協力してね。",
            "zh": "所以，今后也\n请务必帮我哦。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "166/ACT",
            "narrator": "",
            "text": "そういうところ、好きだけどな",
            "zh": "我倒是挺喜欢那样的",
            "narrator_zh": ""
        },
        {
            "location": "167/TALK",
            "narrator": "潜在アーヤ",
            "text": "ふふ、そうなのね。",
            "zh": "呵呵，这样啊。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "169/TALK",
            "narrator": "潜在アーヤ",
            "text": "お気遣いさん？\nそれとも古風なのが\n好きなのかしら。",
            "zh": "你这是在安慰我？\n还是说你本来就\n喜欢古风的类型呢。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "170/TALK",
            "narrator": "潜在アーヤ",
            "text": "そんな趣味が合わない\n私の味方をしてくれて\nありがとう。",
            "zh": "就算品味不合，\n也谢谢你愿意站在\n我这边。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "174/TALK",
            "narrator": "潜在アーヤ",
            "text": "さて、と。\n戦いもまだこれから\nみたいだし。",
            "zh": "好啦。\n看样子战斗\n也才刚刚开始。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "175/TALK",
            "narrator": "潜在アーヤ",
            "text": "やっぱり姉のことは\nちゃんと教えておいた\n方がいいみたいね。",
            "zh": "果然还是把姐姐的事\n好好告诉你\n比较好吧。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "176/TALK",
            "narrator": "潜在アーヤ",
            "text": "全部見せてあげる。\n私と姉の関係を。",
            "zh": "我全给你看。\n我和姐姐之间的关系。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "195/DIALOG",
            "narrator": "",
            "text": "私の姉はとても変な人で\n言動も行動も、とても\n普通の女の子とは思えないものだった。",
            "zh": "我姐姐是个非常奇怪的人，\n无论言谈还是举止，\n都完全不像个普通的女孩子。",
            "narrator_zh": ""
        },
        {
            "location": "196/DIALOG",
            "narrator": "",
            "text": "姉は科学や工学が大好きで、\nいつだって変なものを作っては\nそれを家の外で試したり、\n学校に持っていったりしていたわ。",
            "zh": "姐姐特别喜欢科学和工学，\n动不动就做出些稀奇古怪的东西，\n然后拿到屋外去做实验，\n甚至带到学校里来。",
            "narrator_zh": ""
        },
        {
            "location": "197/DIALOG",
            "narrator": "",
            "text": "田舎ではそういうの\nすごい変な目で見られるから、\n私は外ではなるべく\n姉と接触しないようにしていたの。",
            "zh": "在乡下那种做派\n会招来很奇怪的目光，\n所以我在外面都是尽量\n避免和姐姐有接触。",
            "narrator_zh": ""
        },
        {
            "location": "198/TALK",
            "narrator": "女子高校生Ａ",
            "text": "あ、國政さん！",
            "zh": "啊，国政同学！",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "199/TALK",
            "narrator": "高校生アーヤ",
            "text": "あ、立川先輩。\nおはようございます！",
            "zh": "啊，立川学姐。\n早上好！",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "200/TALK",
            "narrator": "女子高校生Ａ",
            "text": "國政さん、おめでと！",
            "zh": "国政同学，恭喜你啊！",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "201/TALK",
            "narrator": "高校生アーヤ",
            "text": "え？",
            "zh": "诶？",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "202/TALK",
            "narrator": "女子高校生Ａ",
            "text": "今度の剣道県大会、\n貴方が副将だって、\n顧問が！",
            "zh": "顾问老师刚才说了，\n下次的剑道县大赛，\n由你担任副将！",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "203/TALK",
            "narrator": "高校生アーヤ",
            "text": "ええっ！\n本当ですか！？",
            "zh": "诶诶！\n真的吗！？",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "204/TALK",
            "narrator": "女子高校生Ａ",
            "text": "ホントよぉ。\n初めてだってよ？\n一年で副将って。",
            "zh": "真的哦。\n听说还是头一回呢，\n一年级就当上副将。",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "205/TALK",
            "narrator": "高校生アーヤ",
            "text": "…嬉しいです！",
            "zh": "……我好高兴！",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "206/TALK",
            "narrator": "女子高校生Ａ",
            "text": "マジ頑張ってよ。\n長野一高のホープ！",
            "zh": "真的要加油啊。\n长野一高的希望之星！",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "207/TALK",
            "narrator": "高校生アーヤ",
            "text": "あ、ありがとう\nございます！",
            "zh": "谢、谢谢\n学姐！",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "208/TALK",
            "narrator": "女子高校生Ａ",
            "text": "じゃね。\n放課後部活で！",
            "zh": "回头见。\n放学社团见咯！",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "209/TALK",
            "narrator": "高校生アーヤ",
            "text": "はいっ！！",
            "zh": "好！！",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "211/TALK",
            "narrator": "高校生アーヤ",
            "text": "すごい！　嬉しいっ！\nまさか副将だなんて。",
            "zh": "太棒了！　好开心！\n真没想到能当上副将。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "212/TALK",
            "narrator": "高校生アーヤ",
            "text": "でも……\nこれは責任重大ね。\nもっと精進しなくちゃ。",
            "zh": "不过……\n这下责任重大了。\n必须更加刻苦精进才行。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "213/TALK",
            "narrator": "高校生アーヤ",
            "text": "これからは朝練、\n１時間早くして――",
            "zh": "从今往后晨练\n也要提前一小时——",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "215/TALK",
            "narrator": "姉",
            "text": "綾ちゃーん！",
            "zh": "小绫——！",
            "narrator_zh": "姐姐"
        },
        {
            "location": "216/TALK",
            "narrator": "高校生アーヤ",
            "text": "…っ！？",
            "zh": "……唔！？",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "219/TALK",
            "narrator": "姉",
            "text": "綾ちゃんおはよー。",
            "zh": "小绫早上好呀——。",
            "narrator_zh": "姐姐"
        },
        {
            "location": "220/TALK",
            "narrator": "高校生アーヤ",
            "text": "…ちょっ…\n学校で話しかけて\nこないでよっ！",
            "zh": "……喂……\n别在学校里\n跟我搭话啦！",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "221/TALK",
            "narrator": "姉",
            "text": "もー、つれないなぁ。\n家ではいつもお話\nしてるじゃない。",
            "zh": "真是的——好冷淡呀。\n在家里明明天天\n都在说话嘛。",
            "narrator_zh": "姐姐"
        },
        {
            "location": "222/TALK",
            "narrator": "姉",
            "text": "あのね、綾ちゃんに\n見せたいものがあって\n声かけたんだ～。",
            "zh": "那个呀，我有东西\n想给小绫看，\n才叫住你的呀～。",
            "narrator_zh": "姐姐"
        },
        {
            "location": "223/TALK",
            "narrator": "高校生アーヤ",
            "text": "うわ、やばっ！",
            "zh": "哇，不妙！",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "225/TALK",
            "narrator": "高校生アーヤ",
            "text": "お姉ちゃん、\nちょっと後で――",
            "zh": "姐姐，\n有什么事等会儿再——",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "226/TALK",
            "narrator": "姉",
            "text": "ぱぱーん！\nわたしの新発明！\nクモ型にゃボット～！",
            "zh": "登登登——！\n我的新发明！\n蜘蛛型喵Bot～！",
            "narrator_zh": "姐姐"
        },
        {
            "location": "227/TALK",
            "narrator": "高校生アーヤ",
            "text": "あぁぁぁぁ……\n今日のはいつもに\n増して強烈だわ…",
            "zh": "啊啊啊啊……\n今天这个比平时\n还要劲爆啊……",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "228/TALK",
            "narrator": "高校生アーヤ",
            "text": "なんで猫に足が\n８本も付いてるのよ！\nしかも気持ち悪い…。",
            "zh": "为什么猫身上\n长了足足8条腿啊！\n而且好恶心……。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "229/TALK",
            "narrator": "姉",
            "text": "よくぞ\n聞いてくれました！",
            "zh": "问得\n太好了！",
            "narrator_zh": "姐姐"
        },
        {
            "location": "230/TALK",
            "narrator": "姉",
            "text": "何で足が８本ついて\nいるかって？\nそれはね～！",
            "zh": "为什么要装上\n8条腿呢？\n那是因为呀～！",
            "narrator_zh": "姐姐"
        },
        {
            "location": "231/TALK",
            "narrator": "高校生アーヤ",
            "text": "いや、\n聞いてないから！！",
            "zh": "不是，\n我根本没问！！",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "232/TALK",
            "narrator": "女子高校生Ｂ",
            "text": "なにあれ、キモイ！",
            "zh": "那是什么啊，好恶心！",
            "narrator_zh": "女高中生B"
        },
        {
            "location": "234/TALK",
            "narrator": "男子高校生Ａ",
            "text": "お、マッドサイエン\nティスト國政博士\nじゃん。",
            "zh": "哦，这不是\n疯狂科学家\n国政博士嘛。",
            "narrator_zh": "男高中生A"
        },
        {
            "location": "237/TALK",
            "narrator": "男子高校生Ｂ",
            "text": "國政の姉さんって\nちょっと変わってる\nよな。",
            "zh": "国政她姐\n还真是有点\n古怪啊。",
            "narrator_zh": "男高中生B"
        },
        {
            "location": "239/TALK",
            "narrator": "男子高校生Ａ",
            "text": "ちょっとどころじゃ\nないって…",
            "zh": "哪止有点\n啊……",
            "narrator_zh": "男高中生A"
        },
        {
            "location": "240/TALK",
            "narrator": "女子高校生Ａ",
            "text": "妹さんは成績優秀で\n剣道も凄いし、非の\n打ち所がないけど――",
            "zh": "妹妹明明成绩优秀，\n剑道也厉害，\n挑不出一点毛病——",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "243/TALK",
            "narrator": "女子高校生Ｂ",
            "text": "お姉さんがあれじゃあ\nね～。",
            "zh": "摊上那样一个姐姐\n也是够呛呢～。",
            "narrator_zh": "女高中生B"
        },
        {
            "location": "244/TALK",
            "narrator": "姉",
            "text": "今から動かすから、\nちょっとそっちの足\n持ってくれる？",
            "zh": "现在我要启动了，\n帮我扶一下\n那边的腿好吗？",
            "narrator_zh": "姐姐"
        },
        {
            "location": "245/TALK",
            "narrator": "高校生アーヤ",
            "text": "っ！！",
            "zh": "！！",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "247/TALK",
            "narrator": "姉",
            "text": "あ、ちょっと\n綾ちゃーん！",
            "zh": "啊，等一下，\n小绫——！",
            "narrator_zh": "姐姐"
        },
        {
            "location": "249/TALK",
            "narrator": "姉",
            "text": "待って～～！",
            "zh": "等等～～！",
            "narrator_zh": "姐姐"
        },
        {
            "location": "260/TALK",
            "narrator": "潜在アーヤ",
            "text": "とまあ、毎日こんな\n感じだったから、\n色々と大変だったわ。",
            "zh": "总之呢，每天都是\n这种感觉，\n当时可真是够折腾的。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "261/SEL",
            "narrator": "（選択肢）",
            "text": "いや、寧ろ楽しそう！",
            "zh": "不，反而感觉挺好玩的！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "262/SEL",
            "narrator": "（選択肢）",
            "text": "確かに恥ずかしいけど、許せないって程じゃ…",
            "zh": "确实有点丢脸，但也算不上不能原谅吧……",
            "narrator_zh": "（选项）"
        },
        {
            "location": "263/SEL",
            "narrator": "（選択肢）",
            "text": "確かにこれは許せん！アーヤがかわいそう！",
            "zh": "这确实不能忍！绫水太可怜了！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "264/ACT",
            "narrator": "",
            "text": "いや、寧ろ楽しそう！",
            "zh": "不，反而感觉挺好玩的！",
            "narrator_zh": ""
        },
        {
            "location": "265/TALK",
            "narrator": "潜在アーヤ",
            "text": "へぇ、それは意外。\n姉と気が合うかもね。",
            "zh": "诶，那还挺意外。\n说不定你和姐姐挺合得来。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "266/ACT",
            "narrator": "",
            "text": "確かに恥ずかしいけど、許せないって程じゃ…",
            "zh": "确实有点丢脸，但也算不上不能原谅吧……",
            "narrator_zh": ""
        },
        {
            "location": "267/TALK",
            "narrator": "潜在アーヤ",
            "text": "でしょ？",
            "zh": "对吧？",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "268/TALK",
            "narrator": "潜在アーヤ",
            "text": "だからもう、過去の\nことなんて水に流せば\nいいと思うの。",
            "zh": "所以我也觉得，过去的事\n早就该一笔勾销\n才对。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "269/ACT",
            "narrator": "",
            "text": "確かにこれは許せん！アーヤがかわいそう！",
            "zh": "这确实不能忍！绫水太可怜了！",
            "narrator_zh": ""
        },
        {
            "location": "271/TALK",
            "narrator": "潜在アーヤ",
            "text": "そこまで！？",
            "zh": "有那么严重吗！？",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "272/TALK",
            "narrator": "潜在アーヤ",
            "text": "まあ確かに高校時代\nとか肩身が狭かった\nのは事実だけど――",
            "zh": "嘛，确实高中时代\n感觉挺抬不起头的\n也是事实——",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "273/TALK",
            "narrator": "潜在アーヤ",
            "text": "まあ姉も、あれは\nあれで悪気がある\nわけじゃないし。",
            "zh": "不过姐姐她啊，\n那样倒也不是\n出于什么恶意。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "275/TALK",
            "narrator": "潜在アーヤ",
            "text": "そんなわけだから、\n頑固に過去のことに\nしがみついてないで―",
            "zh": "既然这样，我觉得\n没必要死抓着过去的\n小事不放——",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "276/TALK",
            "narrator": "潜在アーヤ",
            "text": "姉と和解して\n連絡とればいいって\n思うのよ。",
            "zh": "应该和姐姐和解、\n重新联系起来\n才对呀。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "277/SEL",
            "narrator": "（選択肢）",
            "text": "同感",
            "zh": "同感",
            "narrator_zh": "（选项）"
        },
        {
            "location": "278/SEL",
            "narrator": "（選択肢）",
            "text": "難しいと思うな",
            "zh": "我觉得挺难的吧",
            "narrator_zh": "（选项）"
        },
        {
            "location": "279/ACT",
            "narrator": "",
            "text": "同感",
            "zh": "同感",
            "narrator_zh": ""
        },
        {
            "location": "280/TALK",
            "narrator": "潜在アーヤ",
            "text": "でしょ？",
            "zh": "对吧？",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "281/TALK",
            "narrator": "潜在アーヤ",
            "text": "だから、また\n力を貸してね？",
            "zh": "所以，下次还要\n再借我力量哦？",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "282/TALK",
            "narrator": "潜在アーヤ",
            "text": "現実世界の\n私の為にも。",
            "zh": "也是为了\n现实世界的我。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "283/ACT",
            "narrator": "",
            "text": "難しいと思うな",
            "zh": "我觉得挺难的吧",
            "narrator_zh": ""
        },
        {
            "location": "284/TALK",
            "narrator": "潜在アーヤ",
            "text": "あら、そう？",
            "zh": "哎呀，这样吗？",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "285/TALK",
            "narrator": "潜在アーヤ",
            "text": "まあ、無理強いは\nできないものね。",
            "zh": "嘛，毕竟这种事\n也没法强求呢。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "286/TALK",
            "narrator": "潜在アーヤ",
            "text": "気が向いたら\nまたつき合って\nくれると嬉しいかな。",
            "zh": "要是你心血来潮了，\n能再陪陪我，\n我会很高兴的。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "290/SEL",
            "narrator": "（選択肢）",
            "text": "ところで、デートは？",
            "zh": "话说回来，约会呢？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "291/ACT",
            "narrator": "",
            "text": "ところで、デートは？",
            "zh": "话说回来，约会呢？",
            "narrator_zh": ""
        },
        {
            "location": "293/TALK",
            "narrator": "潜在アーヤ",
            "text": "ああ、そうね。\n約束してたわね。",
            "zh": "啊啊，对哦。\n是约定过呢。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "294/TALK",
            "narrator": "潜在アーヤ",
            "text": "でもそれは、もう\nちょっと今回の件が\n落ち着いてからかな。",
            "zh": "不过那个嘛，大概要等\n这次的事再稍微\n告一段落之后了。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "295/TALK",
            "narrator": "潜在アーヤ",
            "text": "でも、絶対に\n約束は守るわ。\nだから安心してね？",
            "zh": "但是，我绝对会\n遵守约定的。\n所以放心吧？",
            "narrator_zh": "潜在绫水"
        }
    ]
}
