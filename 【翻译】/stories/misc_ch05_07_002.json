        },
        {
            "location": "1144/ACT",
            "narrator": "",
            "text": "それはどうだろう…",
            "zh": "这可不好说……",
            "narrator_zh": ""
        },
        {
            "location": "1145/TALK",
            "narrator": "神楽",
            "text": "いやしてるし！！！",
            "zh": "不，就是在关注！！！",
            "narrator_zh": "神乐"
        },
        {
            "location": "1146/TALK",
            "narrator": "神楽",
            "text": "否定するなし！！！",
            "zh": "不许否定！！！",
            "narrator_zh": "神乐"
        },
        {
            "location": "1147/ACT",
            "narrator": "",
            "text": "$me$は常に神楽に注目してる",
            "zh": "$me$一直关注的是神乐",
            "narrator_zh": ""
        },
        {
            "location": "1149/TALK",
            "narrator": "神楽",
            "text": "やだ（トゥンク…）",
