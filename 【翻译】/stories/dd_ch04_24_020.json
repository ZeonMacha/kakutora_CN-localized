{
    "dir": "chap24/daydra/dd_ch04_24_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "24456",
        "cid": "miyabi",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "偽りの平穏",
        "title_zh": "Extra006 额外剧情",
        "sub_title_zh": "虚假的平静"
    },
    "entry": [
        {
            "location": "382/SCENARIO",
            "narrator": "",
            "text": "偽りの平穏",
            "zh": "虚假的平静",
            "narrator_zh": ""
        },
        {
            "location": "395/TALK",
            "narrator": "ガブリエラ",
            "text": "あーあ…何にも面白い\nテレビやってないわね…。",
            "zh": "唉……电视上都没什么\n有意思的节目呢……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "396/TALK",
            "narrator": "みやび",
            "text": "夕方はほとんどニュースが\n独占してるきね。",
            "zh": "傍晚基本都被新闻\n霸占咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "400/TALK",
            "narrator": "アーヤ",
            "text": "あら、ニュースだって\n面白いわよ。",
            "zh": "哎呀，新闻也有\n有意思的哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "401/TALK",
            "narrator": "アーヤ",
            "text": "暗いのばっかりじゃなくて、\n色んな特集もやってるし。",
            "zh": "又不全是阴暗的，\n也会做各种专题。",
            "narrator_zh": "绫水"
        },
        {
            "location": "402/TALK",
            "narrator": "つばめ",
            "text": "あ、たい焼き特集する\nニュースがありますよ！",
            "zh": "啊，有要做鲷鱼烧专题\n的新闻哦！",
            "narrator_zh": "燕"
        },
        {
            "location": "404/TALK",
            "narrator": "ガブリエラ",
            "text": "たい焼きって、\nそんなテレビで特集する\nようなものなの？",
            "zh": "鲷鱼烧这种东西，\n值得电视专门做\n专题吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "406/TALK",
            "narrator": "みやび",
            "text": "またなにか新しいのが\n出るんかもしれんぞね。",
            "zh": "说不定又要出什么\n新花样咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "410/TALK",
            "narrator": "つばめ",
            "text": "見たいなぁ…。\nチャンネル変えて\nいいですか？",
            "zh": "好想看呀……。\n我可以换台\n吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "412/TALK",
            "narrator": "アーヤ",
            "text": "ええ、どうぞ。",
            "zh": "好啊，请便。",
            "narrator_zh": "绫水"
        },
        {
            "location": "414/TALK",
            "narrator": "つばめ",
            "text": "やった！\nそれじゃ…。",
            "zh": "太好了！\n那就……。",
            "narrator_zh": "燕"
        },
        {
            "location": "415/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "433/TALK",
            "narrator": "アーヤ",
            "text": "施錠よし、と。\nさ、みんな帰るわよ。",
            "zh": "锁门确认。好。\n来，大家回家吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "435/TALK",
            "narrator": "ガブリエラ",
            "text": "あ、みんな直帰？\nあたしはお風呂入ってから\n帰るから。",
            "zh": "咦，大家都直接回家？\n我要洗完澡\n再回去。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "437/TALK",
            "narrator": "みやび",
            "text": "ガブちゃん、まっこと\nテルマエ好きやねぇ。",
            "zh": "加布，真是\n真爱浴场呀。",
            "narrator_zh": "雅"
        },
        {
            "location": "440/TALK",
            "narrator": "ガブリエラ",
            "text": "足伸ばせるのが好きなのよ。",
            "zh": "喜欢的是能把腿伸直。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "441/TALK",
            "narrator": "つばめ",
            "text": "そういえば、\n最近忙しくて全然\n行ってませんでしたね。",
            "zh": "说起来，最近忙得\n一直都没去\n过了呢。",
            "narrator_zh": "燕"
        },
        {
            "location": "442/TALK",
            "narrator": "アーヤ",
            "text": "言われてみると確かに…。",
            "zh": "被你一说还真是……",
            "narrator_zh": "绫水"
        },
        {
            "location": "445/TALK",
            "narrator": "アーヤ",
            "text": "私も、今日はテルマエ\n寄ってこうかしら？",
            "zh": "我今天要不要也\n顺路去趟浴场呢？",
            "narrator_zh": "绫水"
        },
        {
            "location": "446/TALK",
            "narrator": "つばめ",
            "text": "じゃあ、みんなで\n行きましょう。",
            "zh": "那就大家一起\n去吧。",
            "narrator_zh": "燕"
        },
        {
            "location": "448/TALK",
            "narrator": "つばめ",
            "text": "みやびさんもいいですか？",
            "zh": "雅也一起去吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "450/TALK",
            "narrator": "つばめ",
            "text": "って、あれ？\nみやびさん？",
            "zh": "咦，怪了？\n雅呢？",
            "narrator_zh": "燕"
        },
        {
            "location": "451/TALK",
            "narrator": "みやび",
            "text": "先に入ってるぞねー。",
            "zh": "我先下去泡着咧——",
            "narrator_zh": "雅"
        },
        {
            "location": "453/TALK",
            "narrator": "つばめ",
            "text": "って、早っ！？\nいつの間に…。",
            "zh": "也太快了吧！？\n什么时候……。",
            "narrator_zh": "燕"
        },
        {
            "location": "456/TALK",
            "narrator": "ガブリエラ",
            "text": "もぅ、ほんとみやびって\nマイペースなんだから…。",
            "zh": "真是的，雅这人\n就是太我行我素了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "458/TALK",
            "narrator": "アーヤ",
            "text": "私達も行きましょ。\n早くお湯に浸かりたいわ。",
            "zh": "我们也去吧。\n想早点泡进热水里。",
            "narrator_zh": "绫水"
        },
        {
            "location": "479/TALK",
            "narrator": "ガブリエラ",
            "text": "ふぅ…やっぱり一日の\n終わりは、お風呂が\n一番よねー。",
            "zh": "呼……一天的结尾，\n果然还是泡澡\n最棒呀——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "481/TALK",
            "narrator": "アーヤ",
            "text": "一番若いのに、\nちょっと年寄臭いわよ？",
            "zh": "明明最年轻，\n口气却有点老气哦？",
            "narrator_zh": "绫水"
        },
        {
            "location": "483/TALK",
            "narrator": "ガブリエラ",
            "text": "う、うるさいわね。\nいいでしょ？",
            "zh": "闭、闭嘴啦。\n不行吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "484/TALK",
            "narrator": "つばめ",
            "text": "扇風機、扇風機。",
            "zh": "电风扇，电风扇。",
            "narrator_zh": "燕"
        },
        {
            "location": "486/TALK",
            "narrator": "みやび",
            "text": "せっかく温まったのに、\nそれじゃ意味ないやろ？",
            "zh": "好不容易才暖和过来，\n那样不就白泡了啵？",
            "narrator_zh": "雅"
        },
        {
            "location": "489/TALK",
            "narrator": "つばめ",
            "text": "でも、このままじゃ\n汗が止まりませんよぉ…。",
            "zh": "可是这样下去，\n汗一直止不住呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "492/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしも、ちょっと\n身体冷まさないと。",
            "zh": "我也得稍微\n让身体降降温。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "493/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィも扇風機使う？",
            "zh": "加维也要用电风扇？",
            "narrator_zh": "绫水"
        },
        {
            "location": "495/TALK",
            "narrator": "ガブリエラ",
            "text": "ううん、あたしはもちろん、\n冷えたフルーツ牛乳を\n飲むわ。",
            "zh": "不，我当然是要\n喝冰镇的水果\n牛奶。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "497/TALK",
            "narrator": "つばめ",
            "text": "えっ！？　わ、わたしも\nそっちがいい！",
            "zh": "诶！？　我、我也\n要那个！",
            "narrator_zh": "燕"
        },
        {
            "location": "498/TALK",
            "narrator": "ガブリエラ",
            "text": "ふふっ、お風呂上がりの\n牛乳って美味しいのよね。",
            "zh": "呵呵，泡完澡的\n牛奶最好喝了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "500/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤもフルーツ？",
            "zh": "绫水也喝水果的？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "502/TALK",
            "narrator": "アーヤ",
            "text": "ううん、コーヒー牛乳で。",
            "zh": "不了，我要咖啡牛奶。",
            "narrator_zh": "绫水"
        },
        {
            "location": "504/TALK",
            "narrator": "つばめ",
            "text": "わたしもコーヒーで――",
            "zh": "我也要咖啡的——",
            "narrator_zh": "燕"
        },
        {
            "location": "505/TALK",
            "narrator": "ガブリエラ",
            "text": "イチゴ牛乳あるけど？",
            "zh": "还有草莓牛奶哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "506/TALK",
            "narrator": "つばめ",
            "text": "イチゴ牛乳にするよ。",
            "zh": "那我喝草莓牛奶。",
            "narrator_zh": "燕"
        },
        {
            "location": "507/TALK",
            "narrator": "ガブリエラ",
            "text": "本当、つばめって\nイチゴ好きよね。",
            "zh": "真是的，燕\n就是喜欢草莓呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "508/TALK",
            "narrator": "つばめ",
            "text": "えへへ…。",
            "zh": "嘿嘿……。",
            "narrator_zh": "燕"
        },
        {
            "location": "510/TALK",
            "narrator": "みやび",
            "text": "うちは普通のでー。",
            "zh": "我要普通款——",
            "narrator_zh": "雅"
        },
        {
            "location": "512/TALK",
            "narrator": "ガブリエラ",
            "text": "あら？\n普通の売り切れみたい。",
            "zh": "哎呀？\n普通款好像卖完了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "514/TALK",
            "narrator": "みやび",
            "text": "しょんぼりやね…。\nじゃ、フルーツでえいか。",
            "zh": "蔫了咯……。\n那就水果味的吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "516/TALK",
            "narrator": "ガブリエラ",
            "text": "仕方なさそうに\n言わないでよ。\nあたしは飲むんだから。",
            "zh": "别说得像\n勉强的样子。\n我可是要喝的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "530/TALK",
            "narrator": "みやび",
            "text": "ただいま…今日も一日、\nお疲れさん、っと…。",
            "zh": "我回来了……今天一天，\n也辛苦了，嗯……。",
            "narrator_zh": "雅"
        },
        {
            "location": "532/TALK",
            "narrator": "みやび",
            "text": "ふぅ…。",
            "zh": "呼……",
            "narrator_zh": "雅"
        },
        {
            "location": "533/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "534/TALK",
            "narrator": "みやび",
            "text": "なーんか、\n変な一日やったなぁ…。",
            "zh": "总觉得，\n是奇怪的一天咯……。",
            "narrator_zh": "雅"
        },
        {
            "location": "535/TALK",
            "narrator": "みやび",
            "text": "まるで、今までと変わらん\n普通の日みたいやった。",
            "zh": "简直就像和之前\n没两样的普通日子。",
            "narrator_zh": "雅"
        },
        {
            "location": "536/TALK",
            "narrator": "みやび",
            "text": "…あれだけ話して、\n卯月の名前が一度も\n出てこんとは。",
            "zh": "……聊了那么多，\n卯月的名字却一次\n都没提过。",
            "narrator_zh": "雅"
        },
        {
            "location": "538/TALK",
            "narrator": "みやび",
            "text": "もう、今更話すことなんぞ\nないっちゅうことか？",
            "zh": "还是说，如今\n已经没什么好谈的了咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "539/TALK",
            "narrator": "みやび",
            "text": "それとも、揉めるんが\nイヤで敢えて避けた？",
            "zh": "又或者是怕吵起来，\n刻意避开了？",
            "narrator_zh": "雅"
        },
        {
            "location": "540/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "541/TALK",
            "narrator": "みやび",
            "text": "吹っ切れた…っちゅうのは\nありえんか…。",
            "zh": "彻底想开了……这种事，\n不可能咯……。",
            "narrator_zh": "雅"
        },
        {
            "location": "542/TALK",
            "narrator": "みやび",
            "text": "うちらならまだしも、\nつばめちゃんには\n絶対無理や。",
            "zh": "我们几个还说不定，\n燕那家伙\n绝对做不到咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "543/TALK",
            "narrator": "みやび",
            "text": "アーヤとガブちゃんも、\nちくっともピリピリした\n感じせんかったし…。",
            "zh": "绫水和加布，\n也一点剑拔弩张\n的感觉都没有……。",
            "narrator_zh": "雅"
        },
        {
            "location": "544/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "545/TALK",
            "narrator": "みやび",
            "text": "わからん…。\nみんな、なに考えちゅうん\nやろか？",
            "zh": "没懂……。\n大家到底在想\n什么咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "546/SEL",
            "narrator": "",
            "text": "みやびと同じだよ",
            "zh": "跟雅想的一样",
            "narrator_zh": ""
        },
        {
            "location": "548/TALK",
            "narrator": "みやび",
            "text": "もっとピリピリして、\n重い空気になるんが\n普通やないが？",
            "zh": "气氛更紧张、\n变得更沉，\n才正常啵？",
            "narrator_zh": "雅"
        },
        {
            "location": "549/TALK",
            "narrator": "みやび",
            "text": "なのに、どうしてみんな…。",
            "zh": "可为什么大家……",
            "narrator_zh": "雅"
        },
        {
            "location": "553/TALK",
            "narrator": "みやび",
            "text": "…いや、違うな。\nうちがおかしいだけか。",
            "zh": "……不，不对。\n只是我有问题咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "554/TALK",
            "narrator": "みやび",
            "text": "裏切り者のことで、\nいつまでもうじうじ\n考える方が変なんやし…。",
            "zh": "为一个叛徒，\n一直纠结个没完\n才不正常嘛……",
            "narrator_zh": "雅"
        },
        {
            "location": "555/TALK",
            "narrator": "みやび",
            "text": "とにかく、ピリピリせんで\n普通の状態に戻れたんは、\nえいことや。",
            "zh": "总之，能不剑拔弩张、\n回到普通状态，\n算好事咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "556/TALK",
            "narrator": "みやび",
            "text": "…多分、えいことや。",
            "zh": "……大概，算好事咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "557/ACT",
            "narrator": "",
            "text": "みやびと同じだよ",
            "zh": "跟雅想的一样",
            "narrator_zh": ""
        },
        {
            "location": "560/TALK",
            "narrator": "みやび",
            "text": "ん…？",
            "zh": "嗯……？",
            "narrator_zh": "雅"
        },
        {
            "location": "574/TALK",
            "narrator": "みやび",
            "text": "どういうことか",
            "zh": "这是什么意思",
            "narrator_zh": "雅"
        },
        {
            "location": "575/TALK",
            "narrator": "みやび",
            "text": "簡潔に説明せよ",
            "zh": "简洁说明一下",
            "narrator_zh": "雅"
        },
        {
            "location": "577/SEL",
            "narrator": "",
            "text": "みやびと同じで悩んでるはず",
            "zh": "应该和雅一样在烦恼",
            "narrator_zh": ""
        },
        {
            "location": "578/ACT",
            "narrator": "",
            "text": "みやびと同じで悩んでるはず",
            "zh": "应该和雅一样在烦恼",
            "narrator_zh": ""
        },
        {
            "location": "580/TALK",
            "narrator": "みやび",
            "text": "変であろう？",
            "zh": "很奇怪，对吧？",
            "narrator_zh": "雅"
        },
        {
            "location": "581/TALK",
            "narrator": "みやび",
            "text": "ならば何故",
            "zh": "那么为什么",
            "narrator_zh": "雅"
        },
        {
            "location": "583/TALK",
            "narrator": "みやび",
            "text": "誰も卯月の名前を出さなかった？",
            "zh": "没人提起卯月的名字？",
            "narrator_zh": "雅"
        },
        {
            "location": "585/SEL",
            "narrator": "",
            "text": "出したくなかったんじゃない？",
            "zh": "是不是不想提？",
            "narrator_zh": ""
        },
        {
            "location": "586/ACT",
            "narrator": "",
            "text": "出したくなかったんじゃない？",
            "zh": "是不是不想提？",
            "narrator_zh": ""
        },
        {
            "location": "588/TALK",
            "narrator": "みやび",
            "text": "大切な部分が抜け過ぎている",
            "zh": "关键的部分漏得太多",
            "narrator_zh": "雅"
        },
        {
            "location": "589/TALK",
            "narrator": "みやび",
            "text": "理解できん",
            "zh": "无法理解",
            "narrator_zh": "雅"
        },
        {
            "location": "590/TALK",
            "narrator": "みやび",
            "text": "なぜか説明求む",
            "zh": "说明理由",
            "narrator_zh": "雅"
        },
        {
            "location": "592/SEL",
            "narrator": "",
            "text": "楽しい時間を壊したくなかった",
            "zh": "不想破坏快乐的时光",
            "narrator_zh": ""
        },
        {
            "location": "593/ACT",
            "narrator": "",
            "text": "楽しい時間を壊したくなかった",
            "zh": "不想破坏快乐的时光",
            "narrator_zh": ""
        },
        {
            "location": "596/TALK",
            "narrator": "みやび",
            "text": "なるほど",
            "zh": "原来如此",
            "narrator_zh": "雅"
        },
        {
            "location": "597/TALK",
            "narrator": "みやび",
            "text": "理解できなくはない",
            "zh": "不是不能理解",
            "narrator_zh": "雅"
        },
        {
            "location": "598/TALK",
            "narrator": "みやび",
            "text": "確かに",
            "zh": "确实",
            "narrator_zh": "雅"
        },
        {
            "location": "599/TALK",
            "narrator": "みやび",
            "text": "楽しかった",
            "zh": "很开心",
            "narrator_zh": "雅"
        },
        {
            "location": "602/TALK",
            "narrator": "みやび",
            "text": "だがそれだけで",
            "zh": "但仅凭这个",
            "narrator_zh": "雅"
        },
        {
            "location": "603/TALK",
            "narrator": "みやび",
            "text": "抑えられるものか？",
            "zh": "就能压得下去吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "604/TALK",
            "narrator": "みやび",
            "text": "卯月に対する",
            "zh": "对卯月的",
            "narrator_zh": "雅"
        },
        {
            "location": "607/TALK",
            "narrator": "みやび",
            "text": "気持ちを",
            "zh": "那份心情",
            "narrator_zh": "雅"
        },
        {
            "location": "610/SEL",
            "narrator": "",
            "text": "暗いままじゃ気がめいるよ",
            "zh": "一直消沉下去可不行哦",
            "narrator_zh": ""
        },
        {
            "location": "611/ACT",
            "narrator": "",
            "text": "暗いままじゃ気がめいるよ",
            "zh": "一直消沉下去可不行哦",
            "narrator_zh": ""
        },
        {
            "location": "613/TALK",
            "narrator": "みやび",
            "text": "わからなくはない",
            "zh": "不是不懂",
            "narrator_zh": "雅"
        },
        {
            "location": "614/TALK",
            "narrator": "みやび",
            "text": "気がめいれば",
            "zh": "一旦消沉",
            "narrator_zh": "雅"
        },
        {
            "location": "615/TALK",
            "narrator": "みやび",
            "text": "これから先の面倒ごと",
            "zh": "往后那些麻烦事",
            "narrator_zh": "雅"
        },
        {
            "location": "616/TALK",
            "narrator": "みやび",
            "text": "確実に乗り越えられん",
            "zh": "肯定过不去",
            "narrator_zh": "雅"
        },
        {
            "location": "617/TALK",
            "narrator": "みやび",
            "text": "無理ゲー積みゲークソゲー状態",
            "zh": "等于地狱难度加吃灰加烂游戏状态",
            "narrator_zh": "雅"
        },
        {
            "location": "618/TALK",
            "narrator": "みやび",
            "text": "まあ",
            "zh": "嘛",
            "narrator_zh": "雅"
        },
        {
            "location": "619/TALK",
            "narrator": "みやび",
            "text": "今もそうやけんど",
            "zh": "虽然现在也是这样啵",
            "narrator_zh": "雅"
        },
        {
            "location": "622/TALK",
            "narrator": "みやび",
            "text": "みんなで話して",
            "zh": "大家一起谈了",
            "narrator_zh": "雅"
        },
        {
            "location": "623/TALK",
            "narrator": "みやび",
            "text": "これからのことを決めた",
            "zh": "决定了今后的事",
            "narrator_zh": "雅"
        },
        {
            "location": "624/TALK",
            "narrator": "みやび",
            "text": "つまり",
            "zh": "也就是说",
            "narrator_zh": "雅"
        },
        {
            "location": "625/TALK",
            "narrator": "みやび",
            "text": "ここから先は",
            "zh": "从这往后",
            "narrator_zh": "雅"
        },
        {
            "location": "626/TALK",
            "narrator": "みやび",
            "text": "個人で悩む時期ということか？",
            "zh": "是各自烦恼的时期咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "629/TALK",
            "narrator": "みやび",
            "text": "自信はないが",
            "zh": "虽没什么自信",
            "narrator_zh": "雅"
        },
        {
            "location": "630/TALK",
            "narrator": "みやび",
            "text": "そうだと願う",
            "zh": "但愿如此",
            "narrator_zh": "雅"
        },
        {
            "location": "641/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "642/TALK",
            "narrator": "みやび",
            "text": "アーヤにでも、ＷＡＶＥで\n確認しとくか…？",
            "zh": "要不要用ＷＡＶＥ跟\n绫水确认一下……？",
            "narrator_zh": "雅"
        },
        {
            "location": "643/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "644/TALK",
            "narrator": "みやび",
            "text": "いや…そうやな。",
            "zh": "不……也是咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "645/TALK",
            "narrator": "みやび",
            "text": "みんな、\nきっと考えちょるはずや。",
            "zh": "大家，\n肯定都在琢磨咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "646/TALK",
            "narrator": "みやび",
            "text": "何故、誰も卯月の名を\n出さなかったのかを…。",
            "zh": "为什么，谁都没提\n卯月的名字……。",
            "narrator_zh": "雅"
        },
        {
            "location": "647/TALK",
            "narrator": "みやび",
            "text": "…ま、うち自身も\n答えは出ちょらんけんどな。",
            "zh": "……嘛，虽然我自己\n也没得出答案啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "648/TALK",
            "narrator": "みやび",
            "text": "はぁ…しっかし、\n久しぶりにみんなと\n普通に話せて楽し――",
            "zh": "唉……不过，\n好久没和大家正常\n聊天了，真开——",
            "narrator_zh": "雅"
        },
        {
            "location": "649/TALK",
            "narrator": "みやび",
            "text": "……あ。",
            "zh": "……啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "650/TALK",
            "narrator": "みやび",
            "text": "…うちも、楽しい時間を\n壊したくない思うてた\n一人、っちゅうことか…。",
            "zh": "……原来我也是，\n不想破坏快乐时光的\n一人咯……",
            "narrator_zh": "雅"
        },
        {
            "location": "652/TALK",
            "narrator": "みやび",
            "text": "…早く、普通に疑問を\n抱かんでえい日が\n来てほしいもんやなぁ…。",
            "zh": "……真希望早点，\n迎来不用冒出\n这种疑问的日子咯……",
            "narrator_zh": "雅"
        },
        {
            "location": "394/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>8月31日　 5:23 PM</color>\n夏休み最後の日、神楽坂トライナリー楽屋にて",
            "zh": "<color=green>8月31日　 5:23 PM</color>\n暑假最后一天，神乐坂三重奏化妆间。",
            "narrator_zh": "Dialog_EventData"
        }
    ]
}
