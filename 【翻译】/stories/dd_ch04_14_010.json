{
    "dir": "chap14/daydra/dd_ch04_14_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "14452",
        "cid": "miyabi",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "國政綾水は大忙し",
        "title_zh": "Extra002 额外剧情",
        "sub_title_zh": "国政绫水忙得不可开交"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "アーヤＭＶ回１",
            "zh": "绫水ＭＶ第１回",
            "narrator_zh": ""
        },
        {
            "location": "20/TALK",
            "narrator": "アーヤ",
            "text": "えっと、こっちの\n資料は確か…。",
            "zh": "那个，这边的\n资料好像是……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "21/TALK",
            "narrator": "アーヤ",
            "text": "あ、タブレットに\n保存してあるん\nだったかしら？",
            "zh": "啊，是不是\n存在平板里\n了来着？",
            "narrator_zh": "绫水"
        },
        {
            "location": "23/TALK",
            "narrator": "みやび",
            "text": "…ん？　アーヤか？",
            "zh": "…嗯？　是绫水啊？",
            "narrator_zh": "雅"
        },
        {
            "location": "25/TALK",
            "narrator": "アーヤ",
            "text": "えーっと…、\n確か資料ファイルに\nまとめたような…。",
            "zh": "呃……，\n好像整理进资料\n文件夹里了……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "26/TALK",
            "narrator": "みやび",
            "text": "…昼飯食いながらの\nレポート作り…。\n大学生は大変やねぇ。",
            "zh": "…一边吃午饭\n一边写报告……。\n大学生真辛苦咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "31/TALK",
            "narrator": "アーヤ",
            "text": "うーん…。",
            "zh": "唔……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "44/TALK",
            "narrator": "みやび",
            "text": "…平和や。",
            "zh": "…真太平咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "45/TALK",
            "narrator": "みやび",
            "text": "客の来ない劇場で、\nぼんやり過ごすこの\n時間を――",
            "zh": "在没人来的剧场里，\n就这么发呆\n度过的这段时间——",
            "narrator_zh": "雅"
        },
        {
            "location": "47/TALK",
            "narrator": "みやび",
            "text": "平和以外の言葉で\n何と表現できる\nやろうか？",
            "zh": "还能拿和平以外的\n驷马词来形容\n咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "50/TALK",
            "narrator": "アーヤ",
            "text": "サボり、ね。\nお客さんがいなくても\n仕事はあるのよ？",
            "zh": "偷懒，吧。\n就算没有客人，\n工作也是有的哦？",
            "narrator_zh": "绫水"
        },
        {
            "location": "53/TALK",
            "narrator": "みやび",
            "text": "今日やる予定の\n作業はとっくに\n終わらせたがよ。",
            "zh": "今天预定要做的\n活早就\n干完了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "55/TALK",
            "narrator": "みやび",
            "text": "…って、アーヤは\n何やってるが？",
            "zh": "…话说，绫水你\n在搞驷马咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "58/TALK",
            "narrator": "アーヤ",
            "text": "チラシの整理よ。\nみんな適当に\n置くから――",
            "zh": "整理传单。\n大家都乱放，\n所以——",
            "narrator_zh": "绫水"
        },
        {
            "location": "59/TALK",
            "narrator": "アーヤ",
            "text": "名前順に並べて\nおこうと思ってね。",
            "zh": "想着按名字\n顺序排好。",
            "narrator_zh": "绫水"
        },
        {
            "location": "60/TALK",
            "narrator": "みやび",
            "text": "結構な量あるなぁ。\nちゅうか、別に今日\nやらんでもえいやろ？",
            "zh": "量还挺多的啊。\n话说，又不是非得\n今天做才行嘛？",
            "narrator_zh": "雅"
        },
        {
            "location": "61/TALK",
            "narrator": "アーヤ",
            "text": "時間が余った時じゃ\nないと、中々手が\n回らないでしょ？",
            "zh": "只有闲下来的时候，\n才腾得出手来\n吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "63/TALK",
            "narrator": "アーヤ",
            "text": "…そういえば、\n倉庫の奥に――",
            "zh": "…说起来，\n仓库最里面——",
            "narrator_zh": "绫水"
        },
        {
            "location": "64/TALK",
            "narrator": "アーヤ",
            "text": "チラシが大量に\n入った段ボールが\nあったような…。",
            "zh": "好像有一箱\n塞满传单的\n纸箱……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "67/TALK",
            "narrator": "アーヤ",
            "text": "…怖いけど。\nちょっと見てくるわ。",
            "zh": "…虽然有点吓人。\n我去看看。",
            "narrator_zh": "绫水"
        },
        {
            "location": "71/TALK",
            "narrator": "みやび",
            "text": "…働きもんやねぇ。",
            "zh": "…真是个勤快人咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "88/TALK",
            "narrator": "アーヤ",
            "text": "――というわけで、\n現場での民間人の\n誘導人員を――",
            "zh": "——所以，\n现场引导平民的\n人员——",
            "narrator_zh": "绫水"
        },
        {
            "location": "89/TALK",
            "narrator": "アーヤ",
            "text": "もう少し増やすよう、\n上に報告して頂けると\n助かります。",
            "zh": "希望您能向上面报告一声，\n请他们再增加一些，\n那就太好了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "90/TALK",
            "narrator": "真幌",
            "text": "なるほど…。\n確かにそれは伝えて\nおく必要があるな。",
            "zh": "原来如此……。\n确实有必要\n转达上去。",
            "narrator_zh": "真幌"
        },
        {
            "location": "91/TALK",
            "narrator": "アーヤ",
            "text": "はい…顔バレだけは、\n最も避けなければ\nいけないことなので。",
            "zh": "是……唯独被认出脸来，\n是最需要\n避免的事。",
            "narrator_zh": "绫水"
        },
        {
            "location": "92/TALK",
            "narrator": "真幌",
            "text": "そうだな。\n報告書にはその部分を\n強調して――",
            "zh": "说得对。\n报告书里把这部分\n强调——",
            "narrator_zh": "真幌"
        },
        {
            "location": "96/TALK",
            "narrator": "みやび",
            "text": "まほさーん。\nうち、そろそろ寮に\n戻りますがよ。",
            "zh": "真幌——。\n我差不多要\n回宿舍了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "98/TALK",
            "narrator": "真幌",
            "text": "ん？　おお、そうか。\nお疲れさん。",
            "zh": "嗯？　哦，是嘛。\n辛苦了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "100/TALK",
            "narrator": "みやび",
            "text": "アーヤも、\nもう終わりやろ？",
            "zh": "绫水也\n差不多收工了吧？",
            "narrator_zh": "雅"
        },
        {
            "location": "104/TALK",
            "narrator": "アーヤ",
            "text": "ごめん、私は館長と\n話があるから…。",
            "zh": "抱歉，我还要\n和馆长谈……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "105/TALK",
            "narrator": "みやび",
            "text": "そうか…。\nじゃ、お先に。",
            "zh": "这样啊……。\n那我先走了。",
            "narrator_zh": "雅"
        },
        {
            "location": "106/TALK",
            "narrator": "アーヤ",
            "text": "お疲れ様。",
            "zh": "辛苦了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "108/TALK",
            "narrator": "真幌",
            "text": "…で？　他に何か\n気になったことは\nなかったか？",
            "zh": "…然后呢？\n还有别的在意的\n事吗？",
            "narrator_zh": "真幌"
        },
        {
            "location": "111/TALK",
            "narrator": "アーヤ",
            "text": "もう一点、大したこと\nではないんですが、\n現場で――",
            "zh": "还有一点，虽然\n不是什么大事，\n在现场——",
            "narrator_zh": "绫水"
        },
        {
            "location": "114/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "132/TALK",
            "narrator": "みやび",
            "text": "…あ、いかん。\n醤油が切れてたん\nやった。",
            "zh": "…啊，糟了。\n酱油用完了\n来着。",
            "narrator_zh": "雅"
        },
        {
            "location": "134/TALK",
            "narrator": "ガブリエラ",
            "text": "仕方ないわね…。\nあたしの部屋から\n持ってきてあげるわ。",
            "zh": "真拿你没办法……。\n我从自己房间\n拿来给你吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "136/TALK",
            "narrator": "つばめ",
            "text": "いいよ、ガブちゃん。\n醤油ならわたしの\n部屋にもあるし。",
            "zh": "不用啦，加布。\n我房间也有\n酱油。",
            "narrator_zh": "燕"
        },
        {
            "location": "139/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょっと前に、\nとっても香りのいい\n醤油を見つけて――",
            "zh": "不久之前，我\n找到一瓶香味特别\n好的酱油——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "140/TALK",
            "narrator": "ガブリエラ",
            "text": "今はそれ以外\n使いたくないのよ。",
            "zh": "现在我不想用\n别的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "143/TALK",
            "narrator": "みやび",
            "text": "…醤油にまでこだわり\n持つようになったか。",
            "zh": "…连酱油都开始\n讲究起来了啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "144/TALK",
            "narrator": "みやび",
            "text": "ガブちゃんの\n日本人化が\n急加速しちょるな。",
            "zh": "加布的\n日本人化\n正在急加速啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "147/TALK",
            "narrator": "アーヤ",
            "text": "ただいま…。",
            "zh": "我回来了……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "148/TALK",
            "narrator": "つばめ",
            "text": "あ、おかえりなさい。\nずいぶん遅かった\nですね？",
            "zh": "啊，欢迎回来。\n今天回来得很晚\n呢？",
            "narrator_zh": "燕"
        },
        {
            "location": "150/TALK",
            "narrator": "アーヤ",
            "text": "ちょっと、館長と\n話があってね。",
            "zh": "和馆长谈了\n点事。",
            "narrator_zh": "绫水"
        },
        {
            "location": "151/TALK",
            "narrator": "つばめ",
            "text": "そうだったん\nですか…。",
            "zh": "是这样\n啊……。",
            "narrator_zh": "燕"
        },
        {
            "location": "153/TALK",
            "narrator": "つばめ",
            "text": "あの、これからお夕飯\nみんなで作ろう、って\n話してて――",
            "zh": "那个，我们正商量\n等下大家一起做\n晚饭——",
            "narrator_zh": "燕"
        },
        {
            "location": "154/TALK",
            "narrator": "つばめ",
            "text": "アーヤさんも一緒に\nどうですか？",
            "zh": "绫水也一起来\n怎么样？",
            "narrator_zh": "燕"
        },
        {
            "location": "156/TALK",
            "narrator": "アーヤ",
            "text": "ごめんなさい。\nお誘いは嬉しいん\nだけど――",
            "zh": "抱歉。\n很高兴你们\n邀请我——",
            "narrator_zh": "绫水"
        },
        {
            "location": "157/TALK",
            "narrator": "アーヤ",
            "text": "今夜はちょっと、\n勉強しようと\n思ってるの…。",
            "zh": "今晚打算\n学习一下\n……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "158/TALK",
            "narrator": "みやび",
            "text": "勉強って…、\nそんな遅れてるが？",
            "zh": "学习……，\n你落后那么多咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "159/TALK",
            "narrator": "アーヤ",
            "text": "ちょっとね…、\n最近、復習とかあまり\nできてなくて。",
            "zh": "有一点吧……，\n最近复习什么的\n做得不多。",
            "narrator_zh": "绫水"
        },
        {
            "location": "161/TALK",
            "narrator": "アーヤ",
            "text": "だから、また今度ね。",
            "zh": "所以，下次再约吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "165/TALK",
            "narrator": "つばめ",
            "text": "…残念ですね。",
            "zh": "…好遗憾呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "167/TALK",
            "narrator": "みやび",
            "text": "まあ、アーヤらしい\n理由やけんどね。",
            "zh": "嘛，虽然是很绫水风格的\n理由咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "170/TALK",
            "narrator": "ガブリエラ",
            "text": "お待たせ。\n今、アーヤが\n帰って来なかった？",
            "zh": "久等了。\n绫水刚才是不是\n回来了？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "171/TALK",
            "narrator": "つばめ",
            "text": "うん。食事一緒に\nどうですか、って\n誘ったんだけど――",
            "zh": "嗯。我邀请她\n一起吃饭\n来着——",
            "narrator_zh": "燕"
        },
        {
            "location": "172/TALK",
            "narrator": "つばめ",
            "text": "お勉強が忙しくて、\n断られちゃった…。",
            "zh": "结果她忙着学习，\n把我拒绝了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "173/SEL",
            "narrator": "",
            "text": "夜食でも作ってあげれば？",
            "zh": "要不给她做点夜宵？",
            "narrator_zh": ""
        },
        {
            "location": "175/TALK",
            "narrator": "ガブリエラ",
            "text": "ふーん…別に、\n今日じゃなくても\nいいのに…。",
            "zh": "哼——……明明\n不是今天\n也可以的……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "178/TALK",
            "narrator": "みやび",
            "text": "気になったことを\n後回しに出来ん\n性格なんやろうね。",
            "zh": "她这人啊，是在意的\n事没法往后拖的\n性格咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "179/TALK",
            "narrator": "みやび",
            "text": "…まあ、頑張り過ぎ\nちょる気もする\nけんど…。",
            "zh": "…嘛，虽然也觉得\n她努力得\n有点过头……。",
            "narrator_zh": "雅"
        },
        {
            "location": "182/TALK",
            "narrator": "みやび",
            "text": "まあ、うちらは\nとりあえず夕食に\nするがよ。",
            "zh": "嘛，我们先\n去吃晚饭\n咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "184/TALK",
            "narrator": "つばめ",
            "text": "あ、そうですね。\nじゃあ、わたしの\n部屋に来てください。",
            "zh": "啊，是呢。\n那就请来\n我房间吧。",
            "narrator_zh": "燕"
        },
        {
            "location": "186/TALK",
            "narrator": "ガブリエラ",
            "text": "もうお腹ペコペコよ。\nさっさと作って、\n食べたいわ…。",
            "zh": "肚子已经饿扁了哦。\n想赶紧做好\n开吃……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "188/ACT",
            "narrator": "",
            "text": "夜食でも作ってあげれば？",
            "zh": "要不给她做点夜宵？",
            "narrator_zh": ""
        },
        {
            "location": "204/TALK",
            "narrator": "みやび",
            "text": "いや",
            "zh": "不",
            "narrator_zh": "雅"
        },
        {
            "location": "205/TALK",
            "narrator": "みやび",
            "text": "それは却下",
            "zh": "这个驳回",
            "narrator_zh": "雅"
        },
        {
            "location": "206/TALK",
            "narrator": "みやび",
            "text": "うち的に面倒くさい",
            "zh": "对我来说太麻烦",
            "narrator_zh": "雅"
        },
        {
            "location": "207/TALK",
            "narrator": "みやび",
            "text": "問答無用の大却下！",
            "zh": "不容分说的大驳回！",
            "narrator_zh": "雅"
        },
        {
            "location": "219/TALK",
            "narrator": "みやび",
            "text": "…ん？",
            "zh": "…嗯？",
            "narrator_zh": "雅"
        },
        {
            "location": "222/TALK",
            "narrator": "つばめ",
            "text": "あ、えと…、\nごめんなさい。",
            "zh": "啊，那个……，\n对不起。",
            "narrator_zh": "燕"
        },
        {
            "location": "223/TALK",
            "narrator": "つばめ",
            "text": "スマホの画面、\n見えちゃって…。",
            "zh": "手机屏幕，\n不小心看到了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "226/TALK",
            "narrator": "みやび",
            "text": "構わん構わん。\n大した話しちょらん\nかったし。",
            "zh": "没事没事。\n反正也没聊什么\n要紧的咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "227/TALK",
            "narrator": "つばめ",
            "text": "あ、でもわたしも$handle$さんに\n賛成です！",
            "zh": "啊，不过我也同意\n$handle$的意见！",
            "narrator_zh": "燕"
        },
        {
            "location": "228/TALK",
            "narrator": "つばめ",
            "text": "ガブちゃん。\nあとでアーヤさんの\nところに――",
            "zh": "加布。\n待会去\n绫水那里——",
            "narrator_zh": "燕"
        },
        {
            "location": "229/TALK",
            "narrator": "つばめ",
            "text": "お夜食持って行って\nあげようよ。",
            "zh": "给她送夜宵\n去吧。",
            "narrator_zh": "燕"
        },
        {
            "location": "231/TALK",
            "narrator": "ガブリエラ",
            "text": "夜食ねぇ…。",
            "zh": "夜宵啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "232/TALK",
            "narrator": "つばめ",
            "text": "うん、いいでしょ？",
            "zh": "嗯，可以吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "233/TALK",
            "narrator": "ガブリエラ",
            "text": "うーん…そうね…。",
            "zh": "唔……也是……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "234/TALK",
            "narrator": "ガブリエラ",
            "text": "最近のアーヤって、\nいつも疲れた\n顔してるし…。",
            "zh": "最近的绫水，\n总是一脸\n疲惫……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "237/TALK",
            "narrator": "ガブリエラ",
            "text": "仕方ないわね…。\nあたしも協力して\nあげるわ。",
            "zh": "真拿你们没办法……。\n我也来\n帮忙吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "238/SEL",
            "narrator": "",
            "text": "みやびも作ってあげて",
            "zh": "雅也来做啊",
            "narrator_zh": ""
        },
        {
            "location": "239/TALK",
            "narrator": "つばめ",
            "text": "うん。アーヤさんも、\nきっと喜んでくれる\nと思うよ。",
            "zh": "嗯。我想绫水\n也一定会\n高兴的。",
            "narrator_zh": "燕"
        },
        {
            "location": "241/TALK",
            "narrator": "ガブリエラ",
            "text": "べ、別に、アーヤを\n喜ばせたいわけじゃ\nなくて――",
            "zh": "才、才不是想\n让绫水高兴\n什么的——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "242/TALK",
            "narrator": "ガブリエラ",
            "text": "変に疲れた顔された\nままでいられるのが、\n嫌なだけよ！",
            "zh": "只是看不惯\n她一直摆着那副\n疲惫的脸而已！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "245/TALK",
            "narrator": "みやび",
            "text": "あ～、すまんけんど、\nうちは夜食に関しては\nノータッチや。",
            "zh": "啊——，没好意思，\n夜宵这事\n我一概不沾咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "247/TALK",
            "narrator": "つばめ",
            "text": "…$handle$さんにも\n言ってましたよね。",
            "zh": "…你对$handle$\n也这么说过吧。",
            "narrator_zh": "燕"
        },
        {
            "location": "248/TALK",
            "narrator": "みやび",
            "text": "うむ、うちの気は\nまったく変わっちょ\nらんきね。",
            "zh": "嗯，我的心思\n一点都没变\n啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "249/TALK",
            "narrator": "みやび",
            "text": "作るなら、\n二人で作りぃ。",
            "zh": "要做的话，\n就你们俩去做咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "252/TALK",
            "narrator": "ガブリエラ",
            "text": "まったく…、\nチームワークってのを\n知らないんだから…。",
            "zh": "真是的……，\n根本不懂什么叫\n团队合作……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "254/TALK",
            "narrator": "ガブリエラ",
            "text": "それじゃ、お夕飯が\n終わったら――",
            "zh": "那就等吃完\n晚饭——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "255/TALK",
            "narrator": "ガブリエラ",
            "text": "つばめはあたしと\n夜食を作る。\nそれでＯＫ？",
            "zh": "燕和我一起\n做夜宵。\n这样OK？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "258/TALK",
            "narrator": "つばめ",
            "text": "うん。\n頑張って美味しいの\n作ろうね。",
            "zh": "嗯。\n努力做出好吃的\n吧。",
            "narrator_zh": "燕"
        },
        {
            "location": "259/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "272/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "273/TALK",
            "narrator": "みやび",
            "text": "…ん？\n０時過ぎたか…。",
            "zh": "…嗯？\n过０点了啊……。",
            "narrator_zh": "雅"
        },
        {
            "location": "274/TALK",
            "narrator": "みやび",
            "text": "そろそろやな。",
            "zh": "差不多了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "285/TALK",
            "narrator": "アーヤ",
            "text": "…ふぁ～。",
            "zh": "…哈啊～。",
            "narrator_zh": "绫水"
        },
        {
            "location": "286/TALK",
            "narrator": "アーヤ",
            "text": "…眠い。\nああ、でももう少し\n勉強進めたいし…。",
            "zh": "…困了。\n啊，不过还想再\n学一会儿……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "287/TALK",
            "narrator": "アーヤ",
            "text": "…ギャヴィ達の夜食、\nやっぱり量が多かった\nみたい。",
            "zh": "…加维她们的夜宵，\n果然分量\n太多了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "288/TALK",
            "narrator": "アーヤ",
            "text": "…どうしよう。\nちょっと仮眠を\nとって…。",
            "zh": "…怎么办。\n稍微打个盹\n的话……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "290/TALK",
            "narrator": "アーヤ",
            "text": "いやいや、無理よ。\n絶対起きられないわ。",
            "zh": "不行不行，没戏。\n绝对起不来的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "296/TALK",
            "narrator": "アーヤ",
            "text": "誰？\nあいてるわよ。",
            "zh": "谁呀？\n开着呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "301/TALK",
            "narrator": "みやび",
            "text": "お邪魔するぞね。",
            "zh": "打扰了咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "303/TALK",
            "narrator": "アーヤ",
            "text": "こんな時間に来る\nなんて、\nどうかしたの？",
            "zh": "这个点过来，\n是有什么\n事吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "304/TALK",
            "narrator": "みやび",
            "text": "…眠そうな顔やね。",
            "zh": "…一脸没睡醒的样子咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "305/TALK",
            "narrator": "みやび",
            "text": "あれか？\nガブちゃん達の\n持って来た夜食――",
            "zh": "是那个吧？\n加布她们\n送来的夜宵——",
            "narrator_zh": "雅"
        },
        {
            "location": "306/TALK",
            "narrator": "みやび",
            "text": "律儀に平らげて、\n腹いっぱいでネムネム\nコース爆進中やろ？",
            "zh": "老实吃个精光，\n正沿着吃饱犯困路线\n全速狂奔吧咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "308/TALK",
            "narrator": "アーヤ",
            "text": "あはは…。\nよくわかったわね？",
            "zh": "啊哈哈……。\n猜得真准呀？",
            "narrator_zh": "绫水"
        },
        {
            "location": "309/TALK",
            "narrator": "みやび",
            "text": "ちくっと考えれば\nわかることやき。",
            "zh": "稍微想一下\n就懂的事啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "310/TALK",
            "narrator": "みやび",
            "text": "やけんど、断っても\nよかったと思うがよ。",
            "zh": "但是我觉得，你当时拒绝掉\n也行的咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "311/TALK",
            "narrator": "みやび",
            "text": "寝てしまう言えば、\n二人とも納得したと\n思うし。",
            "zh": "只要说困得要睡了，\n她们俩应该也会\n理解的。",
            "narrator_zh": "雅"
        },
        {
            "location": "312/TALK",
            "narrator": "アーヤ",
            "text": "食べたかったのは\n本当よ。\nお腹も空いてたし。",
            "zh": "想吃是真的。\n肚子也是\n真的饿了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "313/TALK",
            "narrator": "アーヤ",
            "text": "それに、とっても\n美味しかったから\n残せなかったのよ。",
            "zh": "而且，实在太\n好吃了，\n舍不得剩。",
            "narrator_zh": "绫水"
        },
        {
            "location": "314/TALK",
            "narrator": "みやび",
            "text": "…なるほど。\nなら、よかった\nっちゅうことか？",
            "zh": "…原来如此。\n那就是说，\n来对了咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "316/TALK",
            "narrator": "アーヤ",
            "text": "ええ…ふぁ～…。",
            "zh": "是啊……哈啊～……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "317/TALK",
            "narrator": "みやび",
            "text": "…ちくっとでも、\n仮眠とった方が\nえいと思うよ。",
            "zh": "…哪怕眯一会，\n我觉得也还是\n打个盹比较好哦。",
            "narrator_zh": "雅"
        },
        {
            "location": "318/TALK",
            "narrator": "みやび",
            "text": "うちはまだしばらく\n起きてるき――",
            "zh": "我还要再\n醒一阵子啵——",
            "narrator_zh": "雅"
        },
        {
            "location": "320/TALK",
            "narrator": "みやび",
            "text": "二時間くらいしたら\n起こすけんど、\nどうする？",
            "zh": "过两个钟头左右\n我会叫你，\n怎么样？",
            "narrator_zh": "雅"
        },
        {
            "location": "321/TALK",
            "narrator": "アーヤ",
            "text": "…お願いできる？\n正直、ちょっと\n限界なの…。",
            "zh": "…能拜托你吗？\n说实话，我\n快到极限了……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "322/TALK",
            "narrator": "みやび",
            "text": "あい、了解や。",
            "zh": "好嘞，了解咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "323/TALK",
            "narrator": "みやび",
            "text": "そうと決まれば、\nすっとベッド入りぃ。",
            "zh": "那就这么定了，\n利落地上床去咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "325/TALK",
            "narrator": "アーヤ",
            "text": "ありがとう…。\nそれじゃ、おやすみ。",
            "zh": "谢谢……。\n那，晚安。",
            "narrator_zh": "绫水"
        },
        {
            "location": "327/TALK",
            "narrator": "みやび",
            "text": "ん…おやすみ。",
            "zh": "嗯…晚安。",
            "narrator_zh": "雅"
        },
        {
            "location": "328/TALK",
            "narrator": "みやび",
            "text": "…喜んでもらえた\nみたいやし、\n来て正解やったな。",
            "zh": "…看来她挺高兴的，\n来这一趟\n来对了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "329/ACT",
            "narrator": "",
            "text": "みやびも作ってあげて",
            "zh": "雅也来做啊",
            "narrator_zh": ""
        },
        {
            "location": "344/TALK",
            "narrator": "みやび",
            "text": "イジワルで作らん言うとるわけじゃない",
            "zh": "不是故意使坏说不做",
            "narrator_zh": "雅"
        },
        {
            "location": "345/TALK",
            "narrator": "みやび",
            "text": "が！！",
            "zh": "但是！！",
            "narrator_zh": "雅"
        },
        {
            "location": "346/TALK",
            "narrator": "みやび",
            "text": "そうまで言うなら",
            "zh": "既然都这么说了",
            "narrator_zh": "雅"
        },
        {
            "location": "347/TALK",
            "narrator": "みやび",
            "text": "作っちゃる",
            "zh": "我做给你咧",
            "narrator_zh": "雅"
        },
        {
            "location": "348/TALK",
            "narrator": "みやび",
            "text": "冷たい人間と思われるんは",
            "zh": "被人当成冷血动物",
            "narrator_zh": "雅"
        },
        {
            "location": "349/TALK",
            "narrator": "みやび",
            "text": "マジ心外",
            "zh": "真心不爽",
            "narrator_zh": "雅"
        },
        {
            "location": "350/TALK",
            "narrator": "みやび",
            "text": "けんど",
            "zh": "但是",
            "narrator_zh": "雅"
        },
        {
            "location": "351/TALK",
            "narrator": "みやび",
            "text": "責任は取らん！",
            "zh": "后果概不负责！",
            "narrator_zh": "雅"
        },
        {
            "location": "362/TALK",
            "narrator": "みやび",
            "text": "…じゃあ、何を作るか\n考えんとね。",
            "zh": "…那就得想想\n做驷马咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "363/TALK",
            "narrator": "ガブリエラ",
            "text": "夜食なんだし、\n身体が温まるものが\nいいと思うわ。",
            "zh": "反正是夜宵，\n我觉得吃点\n暖身子的好。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "365/TALK",
            "narrator": "つばめ",
            "text": "夜食のラーメンは\nとっても美味しい！",
            "zh": "夜宵吃拉面\n特别好吃！",
            "narrator_zh": "燕"
        },
        {
            "location": "366/TALK",
            "narrator": "つばめ",
            "text": "って、キリトくんが\n言ってたよ。",
            "zh": "——这是圣翔\n说的哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "369/TALK",
            "narrator": "ガブリエラ",
            "text": "ラーメンなんて\nダメよ。",
            "zh": "拉面什么的\n不行哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "370/TALK",
            "narrator": "ガブリエラ",
            "text": "手軽に食べれるのを\n重視したいから、\n例えば――",
            "zh": "我想优先做方便\n吃的，\n比如说——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "371/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "387/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "388/TALK",
            "narrator": "アーヤ",
            "text": "ふぅ……。",
            "zh": "呼……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "389/TALK",
            "narrator": "アーヤ",
            "text": "やっぱり、\n復習サボり過ぎてた\nみたい。",
            "zh": "果然，\n复习拖欠得\n太多了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "390/TALK",
            "narrator": "アーヤ",
            "text": "忙しくても、\n勉強の時間だけは\n作らないと…。",
            "zh": "再忙，\n学习的时间还是得\n挤出来……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "395/TALK",
            "narrator": "アーヤ",
            "text": "あ、はーい。\n開いてるわよ。",
            "zh": "啊，来了。\n开着呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "400/TALK",
            "narrator": "ガブリエラ",
            "text": "お邪魔するわ。",
            "zh": "打扰了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "404/TALK",
            "narrator": "つばめ",
            "text": "お疲れ様です。\nお勉強、どうですか？",
            "zh": "辛苦了。\n学习进展怎么样？",
            "narrator_zh": "燕"
        },
        {
            "location": "405/TALK",
            "narrator": "アーヤ",
            "text": "ぼちぼちかしら…。\nでも、こんな時間に\nどうしたの？",
            "zh": "还行吧……。\n这个点你们\n怎么了？",
            "narrator_zh": "绫水"
        },
        {
            "location": "408/TALK",
            "narrator": "みやび",
            "text": "勉強頑張っちょる\nアーヤのために、\n夜食作ってきたがよ。",
            "zh": "为了正在努力\n学习的绫水，\n做了夜宵送来咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "409/TALK",
            "narrator": "アーヤ",
            "text": "本当！？\n嬉しいわ、ちょっと\nお腹も空いてて――",
            "zh": "真的！？\n好高兴，正好\n肚子也饿了——",
            "narrator_zh": "绫水"
        },
        {
            "location": "412/TALK",
            "narrator": "アーヤ",
            "text": "って…なんか、\n量多くない？",
            "zh": "话说……这\n是不是有点多？",
            "narrator_zh": "绫水"
        },
        {
            "location": "413/TALK",
            "narrator": "つばめ",
            "text": "お腹が減ってたら\n頭が働かないと\n思って――",
            "zh": "我想着肚子饿了\n脑子就转不动\n了——",
            "narrator_zh": "燕"
        },
        {
            "location": "414/TALK",
            "narrator": "つばめ",
            "text": "おにぎりと\nサンドイッチを\n沢山作ったんです。",
            "zh": "就做了好多\n饭团和\n三明治。",
            "narrator_zh": "燕"
        },
        {
            "location": "416/TALK",
            "narrator": "ガブリエラ",
            "text": "体育会系なんだから、\nこれくらい少ない方\nでしょ？",
            "zh": "你是体育系的，\n这点算少的\n了吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "418/TALK",
            "narrator": "アーヤ",
            "text": "そ、それにしても\nちょっと多い気が\nするけど…。",
            "zh": "可、可是就算这样，\n还是觉得\n有点多……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "419/TALK",
            "narrator": "みやび",
            "text": "温かいスープも\n作ったき、これ飲んで\n身体温めるちや。",
            "zh": "热汤也做了啵，\n喝了把这个\n暖暖身子滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "421/TALK",
            "narrator": "アーヤ",
            "text": "…食べられないことは\nない量だけど――",
            "zh": "…也不是吃不完的\n分量——",
            "narrator_zh": "绫水"
        },
        {
            "location": "422/TALK",
            "narrator": "アーヤ",
            "text": "今こんなに食べたら、\nお腹いっぱいになって\n眠くなっちゃう…。",
            "zh": "现在吃这么多，\n肚子一饱\n就该犯困了……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "423/TALK",
            "narrator": "アーヤ",
            "text": "でも、私のために\n作ってくれたものを\n残せないし…。",
            "zh": "可是，大家为我\n做的，又不能\n剩下……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "424/TALK",
            "narrator": "アーヤ",
            "text": "そうだ！\nせめておにぎりか\nサンドイッチかに――",
            "zh": "对了！\n至少在饭团和\n三明治里挑一样——",
            "narrator_zh": "绫水"
        },
        {
            "location": "425/TALK",
            "narrator": "つばめ",
            "text": "このおにぎり、\nわたしが作ったん\nですよ。",
            "zh": "这个饭团，\n是我做的\n哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "426/TALK",
            "narrator": "つばめ",
            "text": "卵焼きが入ってて、\nわたしも大好きで\nよく食べるんです。",
            "zh": "里面有煎蛋卷，\n我自己也超喜欢，\n经常吃。",
            "narrator_zh": "燕"
        },
        {
            "location": "427/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、食べるのは\nサンドイッチからに\nしなさいよ？",
            "zh": "但是，要吃\n得先从三明治\n吃起哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "428/TALK",
            "narrator": "ガブリエラ",
            "text": "まずは軽い物から\n食べないとね。",
            "zh": "得先从清淡的\n吃起嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "429/TALK",
            "narrator": "つばめ",
            "text": "えーっ、ズルいよ\nガブちゃん。",
            "zh": "诶——，加布\n好狡猾呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "431/TALK",
            "narrator": "アーヤ",
            "text": "…どっちかなんて、\n言い出せる空気じゃ\nないわ！",
            "zh": "…这种气氛下，\n哪说得出口\n挑哪个啊！",
            "narrator_zh": "绫水"
        },
        {
            "location": "432/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "434/TALK",
            "narrator": "アーヤ",
            "text": "…あ、ありがとう。\nいただきます…。",
            "zh": "…谢、谢谢。\n我开动了……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "435/TALK",
            "narrator": "ガブリエラ",
            "text": "夜中まで勉強する\nつもりなんでしょ？",
            "zh": "你打算学到\n半夜吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "436/TALK",
            "narrator": "ガブリエラ",
            "text": "それなら、しっかり\n食べないとダメよ。",
            "zh": "那就必须\n好好吃才行。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "437/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "450/TALK",
            "narrator": "みやび",
            "text": "ほれ見たことか",
            "zh": "瞧，都说了吧",
            "narrator_zh": "雅"
        },
        {
            "location": "452/TALK",
            "narrator": "みやび",
            "text": "これでアーヤが寝落ちしたとしても",
            "zh": "这样就算绫水睡死过去",
            "narrator_zh": "雅"
        },
        {
            "location": "453/TALK",
            "narrator": "みやび",
            "text": "うちは知らんぞ",
            "zh": "我也不管咯",
            "narrator_zh": "雅"
        },
        {
            "location": "19/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>7月6日　0:33 PM</color>\nとある昼休み、学園内の学食にて。",
            "zh": "<color=green>7月6日　0:33 PM</color>\n某个午休，在学园的食堂。",
            "narrator_zh": "Dialog_EventData"
        }
    ]
}
