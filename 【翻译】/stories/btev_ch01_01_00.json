  },
  {
   "location": "165/TALK",
   "narrator": "つばめ",
   "text": "後悔とか、自責とか\n決められないこととか、\nいろいろあるの。",
   "zh": "后悔呀，自责呀，\n定不下来的事呀，\n各种各样都有。",
   "narrator_zh": "燕"
  },
  {
   "location": "166/SEL",
   "narrator": "（選択肢）",
   "text": "なるほど",
   "zh": "原来如此",
   "narrator_zh": "（选项）"
  },
  {
   "location": "167/ACT",
   "narrator": "",
   "text": "なるほど",
   "zh": "原来如此",
   "narrator_zh": ""
  },
  {
   "location": "169/TALK",
   "narrator": "つばめ",
   "text": "わたしもそういった\nことを抱え込んでる\n人格の一人なんだ。",
   "zh": "我也是把这些事\n憋在心里的\n人格之一。",
   "narrator_zh": "燕"
  },
  {
   "location": "170/SEL",
   "narrator": "（選択肢）",
   "text": "相談してみて？",
   "zh": "要不要说说看？",
   "narrator_zh": "（选项）"
  },
  {
   "location": "171/ACT",
   "narrator": "",
   "text": "相談してみて？",
   "zh": "要不要说说看？",
   "narrator_zh": ""
  },
  {
   "location": "173/TALK",
   "narrator": "つばめ",
   "text": "え？　いいの？",
   "zh": "诶？　可以吗？",
   "narrator_zh": "燕"
  },
  {
   "location": "174/TALK",
   "narrator": "つばめ",
   "text": "そんなこと言ってくれた人\n始めてだから、\nちょっとドキドキするよ。",
   "zh": "说这种话的人\n还是第一次，\n心跳有点快呀。",
   "narrator_zh": "燕"
  },
  {
   "location": "175/TALK",
   "narrator": "つばめ",
   "text": "あのね――",
   "zh": "那个呀——",
   "narrator_zh": "燕"
  },
  {
   "location": "176/TALK",
   "narrator": "つばめ",
   "text": "わたし、なし崩し的に\n東京に住むように\nなっちゃったでしょ？",
   "zh": "我呀，稀里糊涂地\n就住到\n东京来了，对吧？",
   "narrator_zh": "燕"
  },
  {
   "location": "177/TALK",
   "narrator": "つばめ",
   "text": "それで、その事を責める\nわたしがいて……",
   "zh": "然后，还有一个责怪这件事的\n我……",
   "narrator_zh": "燕"
  },
  {
   "location": "178/TALK",
   "narrator": "つばめ",
   "text": "お母さんも入院中だし、\nお父さんもまだちゃんと\n納得してないし……。",
   "zh": "妈妈也还在住院，\n爸爸也还没有\n真正接受……。",
   "narrator_zh": "燕"
  },
  {
   "location": "179/TALK",
   "narrator": "つばめ",
   "text": "普通に考えて、こんな\n状態で東京に居残るとか、\nおかしいでしょ？",
   "zh": "正常想想，这种\n状态下还留在东京，\n很奇怪吧？",
   "narrator_zh": "燕"
  },
  {
   "location": "180/TALK",
   "narrator": "つばめ",
   "text": "だからこのままだとわたし\n突然「静岡に帰る」とか\n言い出しちゃいそうなの。",
   "zh": "所以再这样下去，我\n说不定会突然说出\n“回静冈”之类的话。",
   "narrator_zh": "燕"
  },
  {
   "location": "181/SEL",
   "narrator": "（選択肢）",
   "text": "素直に帰るってのはダメなの？",
   "zh": "老老实实回去不行吗？",
   "narrator_zh": "（选项）"
  },
  {
   "location": "182/SEL",
   "narrator": "（選択肢）",
   "text": "そんなに軽い気持ちで決めたの？",
   "zh": "你是用这么随便的心情决定的吗？",
   "narrator_zh": "（选项）"
  },
  {
   "location": "183/ACT",
   "narrator": "",
   "text": "素直に帰るってのはダメなの？",
   "zh": "老老实实回去不行吗？",
   "narrator_zh": ""
  },
  {
   "location": "185/TALK",
   "narrator": "つばめ",
   "text": "だ、ダメだよ！！",
   "zh": "不、不行的！！",
   "narrator_zh": "燕"
  },
  {
   "location": "186/TALK",
   "narrator": "つばめ",
   "text": "トライナリーだって、\nわたしの中ではちゃんと\n考えて決めたんだもん。",
   "zh": "三重奏这件事，\n在我心里也是认真\n想过才决定的。",
   "narrator_zh": "燕"
  },
  {
   "location": "187/TALK",
   "narrator": "つばめ",
   "text": "わかんないかも\nしれないけど、すごく\n固い決意だったんだよ！",
   "zh": "你也许\n不明白，但这是\n非常坚定的决心呀！",
   "narrator_zh": "燕"
  },
  {
   "location": "188/ACT",
   "narrator": "",
   "text": "そんなに軽い気持ちで決めたの？",
   "zh": "你是用这么随便的心情决定的吗？",
   "narrator_zh": ""
  },
  {
   "location": "189/TALK",
   "narrator": "つばめ",
   "text": "ち、違うよ！\nわたしの中では、すごく\n固い決意だったんだよ！",
   "zh": "不、不是的！\n在我心里，这是\n非常坚定的决心呀！",
   "narrator_zh": "燕"
  },
  {
   "location": "191/TALK",
   "narrator": "つばめ",
   "text": "志願したのは、もちろん\n純粋にやってみたかった\nってのもあるけど……。",
   "zh": "去志愿，当然\n也有纯粹想试试看\n的心情……。",
   "narrator_zh": "燕"
  },
  {
   "location": "192/TALK",
   "narrator": "つばめ",
   "text": "それ以上に大切な\n理由があったんだ。",
   "zh": "还有比这更重要的\n理由。",
   "narrator_zh": "燕"
  },
  {
   "location": "193/TALK",
   "narrator": "つばめ",
   "text": "だから、今からやめて\n帰るなんてできないよ。",
   "zh": "所以，现在放弃\n回去，我做不到。",
   "narrator_zh": "燕"
  },
  {
   "location": "194/SEL",
   "narrator": "（選択肢）",
   "text": "どんな理由なの？",
   "zh": "是什么样的理由？",
   "narrator_zh": "（选项）"
  },
  {
   "location": "195/ACT",
   "narrator": "",
   "text": "どんな理由なの？",
   "zh": "是什么样的理由？",
   "narrator_zh": ""
  },
  {
   "location": "197/TALK",
   "narrator": "つばめ",
   "text": "そ、それは……",
   "zh": "那、那个……",
   "narrator_zh": "燕"
  },
  {
   "location": "198/TALK",
   "narrator": "つばめ",
   "text": "えっとね…",
   "zh": "那个呀……",
   "narrator_zh": "燕"
  },
  {
   "location": "203/SEL",
   "narrator": "（選択肢）",
   "text": "なんだ？",
   "zh": "什么事？",
   "narrator_zh": "（选项）"
  },
  {
   "location": "204/ACT",
   "narrator": "",
   "text": "なんだ？",
   "zh": "什么事？",
   "narrator_zh": ""
  },
  {
   "location": "206/TALK",
   "narrator": "つばめ",
   "text": "……っ。\nもしかして……",
   "zh": "……。\n难道说……",
   "narrator_zh": "燕"
  },
  {
   "location": "210/TALK",
   "narrator": "つばめ",
   "text": "やっぱり……！",
   "zh": "果然……！",
   "narrator_zh": "燕"
  },
  {
   "location": "212/TALK",
   "narrator": "つばめ",
   "text": "大変だよ。\n[クラン]がこっちに\n向かってきてる！",
   "zh": "糟了。\n[库兰]正朝\n这边过来！",
   "narrator_zh": "燕"
  },
  {
   "location": "213/SEL",
   "narrator": "（選択肢）",
   "text": "クランが？",
   "zh": "库兰？",
   "narrator_zh": "（选项）"
  },
  {
   "location": "214/ACT",
   "narrator": "",
   "text": "クランが？",
   "zh": "库兰？",
   "narrator_zh": ""
  },
  {
   "location": "216/TALK",
   "narrator": "つばめ",
   "text": "うん。",
   "zh": "嗯。",
   "narrator_zh": "燕"
  },
  {
   "location": "217/TALK",
   "narrator": "つばめ",
   "text": "わたしのココロの中に\n巣くう、色んな想いが\n実体化したものなの。",
   "zh": "是寄居在我心里、\n各种心意\n化为实体的东西。",
   "narrator_zh": "燕"
  },
  {
   "location": "218/TALK",
   "narrator": "つばめ",
   "text": "[クラン]たちはいつも\n自分と違う考えを持つ\nクランと戦ってる。",
   "zh": "[库兰]们总是在\n和想法不同的\n库兰战斗。",
   "narrator_zh": "燕"
  },
  {
   "location": "219/TALK",
   "narrator": "つばめ",
   "text": "きっと、今回わたしが\n行動を起こそうと\nしたから――",
   "zh": "一定是因为，这次\n我想要\n采取行动——",
   "narrator_zh": "燕"
  },
  {
   "location": "220/TALK",
   "narrator": "つばめ",
   "text": "それに反対する\n[クラン]が、攻撃しに\n来たんだと思う。",
   "zh": "反对这件事的\n[库兰]，就来\n攻击了。",
   "narrator_zh": "燕"
  },
  {
   "location": "225/TALK",
   "narrator": "つばめ",
   "text": "きゃあっ！！",
   "zh": "呀啊！！",
   "narrator_zh": "燕"
  },
  {
   "location": "226/SEL",
   "narrator": "（選択肢）",
   "text": "大丈夫！？",
   "zh": "没事吧！？",
   "narrator_zh": "（选项）"
  },
  {
   "location": "227/ACT",
   "narrator": "",
   "text": "大丈夫！？",
   "zh": "没事吧！？",
   "narrator_zh": ""
  },
  {
   "location": "229/TALK",
   "narrator": "つばめ",
   "text": "うん、ありがとう。",
   "zh": "嗯，谢谢你。",
   "narrator_zh": "燕"
  },
  {
   "location": "230/TALK",
   "narrator": "つばめ",
   "text": "ねえ、お願いがあるの！\nわたしと一緒に戦って！",
   "zh": "我说，我有个请求！\n和我一起战斗！",
   "narrator_zh": "燕"
  },
  {
   "location": "231/TALK",
   "narrator": "つばめ",
   "text": "わたし、どうしても\nトライナリーやりたくて、\nだからっ…！！",
   "zh": "我无论如何\n都想做三重奏，\n所以……！！",
   "narrator_zh": "燕"
  },
  {
   "location": "232/SEL",
   "narrator": "（選択肢）",
   "text": "もちろん！",
   "zh": "当然！",
   "narrator_zh": "（选项）"
  },
  {
   "location": "233/SEL",
   "narrator": "（選択肢）",
   "text": "それはどうかな",
   "zh": "这可不好说",
   "narrator_zh": "（选项）"
  },
  {
   "location": "234/ACT",
   "narrator": "",
   "text": "もちろん！",
   "zh": "当然！",
   "narrator_zh": ""
  },
  {
   "location": "236/TALK",
   "narrator": "つばめ",
   "text": "え！？　ほんとに？\nありがとう！！！",
   "zh": "诶！？　真的吗？\n谢谢你！！！",
   "narrator_zh": "燕"
  },
  {
   "location": "237/TALK",
   "narrator": "つばめ",
   "text": "それじゃお言葉に甘えて、\nよろしくお願いしますっ！",
   "zh": "那就承你的情，\n请多关照！",
   "narrator_zh": "燕"
  },
  {
   "location": "238/ACT",
   "narrator": "",
   "text": "それはどうかな",
   "zh": "这可不好说",
   "narrator_zh": ""
  },
  {
   "location": "240/TALK",
   "narrator": "つばめ",
   "text": "えええええっ！！",
   "zh": "诶诶诶诶诶！！",
   "narrator_zh": "燕"
  },
  {
   "location": "241/TALK",
   "narrator": "つばめ",
   "text": "で、でももう\n[クラン]が来ちゃうよ！",
   "zh": "可、可是\n[库兰]马上就要来了呀！",
   "narrator_zh": "燕"
  },
  {
   "location": "242/TALK",
   "narrator": "つばめ",
   "text": "無理矢理になっちゃって\nごめんなさい！\nでも――",
   "zh": "变成硬拉你了，\n对不起！\n但是——",
   "narrator_zh": "燕"
  },
  {
   "location": "243/TALK",
   "narrator": "つばめ",
   "text": "お願いだから\n一緒に来てっ！",
   "zh": "拜托了，\n跟我一起来！",
   "narrator_zh": "燕"
  },
  {
   "location": "255/DIALOG",
   "narrator": "",
   "text": "<color=black><size=50><b>トライナリー志願を否定する\nもう１つの想いを撃破せよ！</b></size></color>\n\n\n\n逢瀬つばめは、確固たる理由があって\nトライナリーを志願し、東京に残った。\n\nだが、それを良しとしない気持ちもまた\n彼女のココロの中には存在しているのだ。\n\nこのままでは、その気持ちが勝ってしまい\nトライナリーをやめたいと言い出しかねない。\n\nそんな彼女の「恐れの感情」を抑制して、\n彼女が本当にやりたいことへの想いを支援しよう！",
   "zh": "<color=black><size=50><b>击破否定三重奏志愿的\n另一份心意！</b></size></color>\n\n\n\n逢濑燕有确凿的理由，\n志愿加入三重奏，留在了东京。\n\n但是，不认同这件事的心情，\n也同样存在于她的心里。\n\n再这样下去，那份心情就会占上风，\n她说不定会说出想退出三重奏。\n\n抑制她这份“恐惧的感情”，\n去支持她对真正想做之事的心意吧！",
   "narrator_zh": ""
  }
 ]
}
