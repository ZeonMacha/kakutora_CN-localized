   "narrator_zh": "燕"
  },
  {
   "location": "159/SEL",
   "narrator": "（選択肢）",
   "text": "つばめのココロを支えに来たよ",
   "zh": "我是来支撑燕的心的",
   "narrator_zh": "（选项）"
  },
  {
   "location": "160/ACT",
   "narrator": "",
   "text": "つばめのココロを支えに来たよ",
   "zh": "我是来支撑燕的心的",
   "narrator_zh": ""
  },
  {
   "location": "163/TALK",
   "narrator": "つばめ",
   "text": "そうなんだ。",
   "zh": "是这样呀。",
   "narrator_zh": "燕"
  },
  {
   "location": "164/TALK",
   "narrator": "つばめ",
   "text": "確かにわたしのココロの\n中には、いつも何かの\n悩みがあるよ。",
