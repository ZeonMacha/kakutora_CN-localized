{
    "dir": "chap27/daydra/dd_ch02_27_010.js",
    "type": "",
    "info": {
        "story_id": "50003",
        "cid": "",
        "title": "SideStory003 ストーリー",
        "sub_title": "FILE02.先輩",
        "title_zh": "SideStory003 剧情",
        "sub_title_zh": "FILE02.前辈"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "東京編２話",
            "zh": "东京篇 第2话",
            "narrator_zh": ""
        },
        {
            "location": "15/DIALOG",
            "narrator": "",
            "text": "<color=green>9月4日　 11:16 AM</color>\nとある日曜、付属学園大学の部室棟にて",
            "zh": "<color=green>9月4日　 11:16 AM</color>\n某个周日，于附属学园大学的社团活动楼",
            "narrator_zh": ""
        },
        {
            "location": "22/TALK",
            "narrator": "小夜",
            "text": "さて、と。\n今日はもう予定もないし、\nさっさと帰って――",
            "zh": "好啦，\n今天也没有其他安排了，\n早点回去——",
            "narrator_zh": "小夜"
        },
        {
            "location": "23/TALK",
            "narrator": "雛",
            "text": "小夜さーん！",
            "zh": "小夜前辈——！",
            "narrator_zh": "雏"
        },
        {
            "location": "25/TALK",
            "narrator": "小夜",
            "text": "…あれ？",
            "zh": "……哎？",
            "narrator_zh": "小夜"
        },
        {
            "location": "28/TALK",
            "narrator": "雛",
            "text": "よかったぁ…。\nまだ帰ってなくて…。",
            "zh": "太好了……。\n您还没有回去……。",
            "narrator_zh": "雏"
        },
        {
            "location": "29/TALK",
            "narrator": "小夜",
            "text": "ひなこちゃん。\nそんな走って、私に急用？",
            "zh": "小雏。\n跑得这么急，找我有急事吗？",
            "narrator_zh": "小夜"
        },
        {
            "location": "31/TALK",
            "narrator": "雛",
            "text": "は、はい…。\n聞きたいことが\nあるんです！",
            "zh": "是、是的……。\n我有件事\n想向您打听！",
            "narrator_zh": "雏"
        },
        {
            "location": "45/TALK",
            "narrator": "小夜",
            "text": "…劇場の襲撃。\nつばめちゃんが\n管理庁に捕まる。",
            "zh": "……剧场遭到袭击。\n燕被\n管理厅抓走了。",
            "narrator_zh": "小夜"
        },
        {
            "location": "46/TALK",
            "narrator": "小夜",
            "text": "しかも、アーヤ達は\n逃亡して行方不明…。",
            "zh": "而且，绫水她们还\n在逃亡中，下落不明……。",
            "narrator_zh": "小夜"
        },
        {
            "location": "47/TALK",
            "narrator": "小夜",
            "text": "…なんか、凄過ぎて\n映画の話を聞いてる\nみたいな気になるわ…。",
            "zh": "……总觉得太离谱了，\n听起来简直像在讲\n电影里的故事一样……。",
            "narrator_zh": "小夜"
        },
        {
            "location": "49/TALK",
            "narrator": "雛",
            "text": "ウソじゃないんです。\n本当に大変なことに\nなってるんです！",
            "zh": "不是骗人的。\n现在真的出了\n天大的事了！",
            "narrator_zh": "雏"
        },
        {
            "location": "51/TALK",
            "narrator": "キリト",
            "text": "逢瀬が捕まったのも\n本当っすよ。",
            "zh": "逢濑被抓走的事\n也是真的呀。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "52/TALK",
            "narrator": "キリト",
            "text": "俺とヒカルは、\nそれを現場で\n見たんだから…。",
            "zh": "我和光\n当时就在现场\n亲眼看到了……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "55/TALK",
            "narrator": "小夜",
            "text": "あ、ごめんごめん。\n疑ってるわけじゃないの。",
            "zh": "啊，抱歉抱歉。\n我不是在怀疑你们啦。",
            "narrator_zh": "小夜"
        },
        {
            "location": "56/TALK",
            "narrator": "小夜",
            "text": "私も、昨日からアーヤに\nずっと連絡してるん\nだけど。",
            "zh": "其实我从昨天起\n也一直在联系\n绫水。",
            "narrator_zh": "小夜"
        },
        {
            "location": "57/TALK",
            "narrator": "小夜",
            "text": "帰ってこないから、\n何かあったのかなぁ、って\n心配してたのよ。",
            "zh": "她一直没回来，\n我还担心是不是\n出什么事了呢。",
            "narrator_zh": "小夜"
        },
        {
            "location": "58/TALK",
            "narrator": "ヒカル",
            "text": "そうだったんですか…。",
            "zh": "原来是这样啊……。",
            "narrator_zh": "光"
        },
        {
            "location": "59/TALK",
            "narrator": "小夜",
            "text": "うん…本当に、\n誰とも連絡が\n取れないの？",
            "zh": "嗯……真的\n谁都联系\n不上吗？",
            "narrator_zh": "小夜"
        },
        {
            "location": "60/TALK",
            "narrator": "ヒカル",
            "text": "ＷＡＶＥはもちろん、\nメールも電話も\n通じませんでした…。",
            "zh": "别说 WAVE 了，\n就连邮件和电话\n也全都打不通……。",
            "narrator_zh": "光"
        },
        {
            "location": "61/TALK",
            "narrator": "繭",
            "text": "ＰＣの方のメールや、\n別のチャットソフトも\n試しましたが、結果は…。",
            "zh": "电脑上的邮箱，\n还有其他聊天软件\n我也都试过了，结果还是……。",
            "narrator_zh": "茧"
        },
        {
            "location": "64/TALK",
            "narrator": "小夜",
            "text": "応答なし、か…。",
            "zh": "无人应答，是吗……。",
            "narrator_zh": "小夜"
        },
        {
            "location": "66/TALK",
            "narrator": "雛",
            "text": "…それ以外の方法で\n綾水様達と連絡を\n取る方法。",
            "zh": "……除此之外，\n还有没有办法能联系上\n绫水大人她们呢。",
            "narrator_zh": "雏"
        },
        {
            "location": "67/TALK",
            "narrator": "雛",
            "text": "なにか、心当たりは\nありませんか？",
            "zh": "您有什么\n头绪吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "68/TALK",
            "narrator": "小夜",
            "text": "そう言われても…。\n普段はＷＡＶＥでしか\n連絡取ってないし。",
            "zh": "就算你这么问……。\n平时我们也只用\nWAVE 联系啊。",
            "narrator_zh": "小夜"
        },
        {
            "location": "70/TALK",
            "narrator": "キリト",
            "text": "そうっすよね…。\n俺達だって、それ以外で\n連絡取りあわないし。",
            "zh": "说的也是呢……。\n我们平时也只用\n那个互相联系。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "72/TALK",
            "narrator": "ヒカル",
            "text": "ＷＡＶＥって、\n便利過ぎるよね。",
            "zh": "WAVE 这软件，\n实在是太方便了嘛。",
            "narrator_zh": "光"
        },
        {
            "location": "73/TALK",
            "narrator": "小夜",
            "text": "う～ん…ＷＡＶＥ以外で\nアーヤと連絡を取れそうな\n方法…。",
            "zh": "唔～……除了 WAVE 之外\n还能联系上绫水的\n办法……。",
            "narrator_zh": "小夜"
        },
        {
            "location": "74/TALK",
            "narrator": "小夜",
            "text": "…………あっ。",
            "zh": "…………啊。",
            "narrator_zh": "小夜"
        },
        {
            "location": "75/TALK",
            "narrator": "雛",
            "text": "えっ？",
            "zh": "哎？",
            "narrator_zh": "雏"
        },
        {
            "location": "77/TALK",
            "narrator": "繭",
            "text": "なにか、心当たりが\nあるんですか？",
            "zh": "您想到什么\n线索了吗？",
            "narrator_zh": "茧"
        },
        {
            "location": "80/TALK",
            "narrator": "小夜",
            "text": "心当たりっていうか…、\nアーヤ達って今、\n逃亡中よね？",
            "zh": "与其说是线索……\n绫水她们现在\n正在逃亡对吧？",
            "narrator_zh": "小夜"
        },
        {
            "location": "85/TALK",
            "narrator": "小夜",
            "text": "もしかしたらだけど…。\nちょっと待ってて。",
            "zh": "说不定是这样……。\n稍等一下。",
            "narrator_zh": "小夜"
        },
        {
            "location": "86/TALK",
            "narrator": "小夜",
            "text": "えっと…確かアドレス帳の\nアーヤのところに…。",
            "zh": "那个……我记得通讯录里\n绫水那一栏好像有……。",
            "narrator_zh": "小夜"
        },
        {
            "location": "103/TALK",
            "narrator": "みやび",
            "text": "ふぅ…。",
            "zh": "呼……。",
            "narrator_zh": "雅"
        },
        {
            "location": "105/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤのお姉さんから\n送られてきたデータ、\n確認終わったの？",
            "zh": "绫水姐姐\n发过来的数据，\n确认完了吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "106/TALK",
            "narrator": "みやび",
            "text": "いや、もうちくっと\n掛かりそうやけんど…。",
            "zh": "还没，还要一哈\n才搞得完不过……。",
            "narrator_zh": "雅"
        },
        {
            "location": "107/TALK",
            "narrator": "みやび",
            "text": "さすがに疲れた。\n休憩せんと、頭が働かん。",
            "zh": "到底是累了。\n不歇一哈的话，脑壳转不动咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "109/TALK",
            "narrator": "ガブリエラ",
            "text": "…手伝えるもんなら、\n手伝いたいけど。",
            "zh": "……要是我能帮上忙的话，\n倒是很想搭把手。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "112/TALK",
            "narrator": "みやび",
            "text": "気持ちだけで十分やき、\n気にせんでえいがよ。",
            "zh": "有这份心意就够了啵，\n不用在意的咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "114/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "117/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "120/TALK",
            "narrator": "みやび",
            "text": "どないしたん？\n暗い顔しちゅうけんど…。",
            "zh": "搞么子了？\n脸色这么沉不过……。",
            "narrator_zh": "雅"
        },
        {
            "location": "121/TALK",
            "narrator": "アーヤ",
            "text": "…家の方に、\n小夜から電話があった\nみたいなの。",
            "zh": "……小夜好像\n往我家里\n打过电话了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "124/TALK",
            "narrator": "ガブリエラ",
            "text": "えっ、小夜さんから！？",
            "zh": "哎，小夜小姐吗！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "125/TALK",
            "narrator": "みやび",
            "text": "なんや、実家の番号\n教えちょったが？",
            "zh": "么子嘛，你连老家的号码\n都告诉过她啊？",
            "narrator_zh": "雅"
        },
        {
            "location": "126/TALK",
            "narrator": "アーヤ",
            "text": "なにかあった時のために、\n一応ね…。",
            "zh": "为了以防万一，\n姑且留过……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "128/TALK",
            "narrator": "アーヤ",
            "text": "まさか、こんな形で\nかけてくるとは\n思わなかったけど…。",
            "zh": "只是没想到，\n她会以这种方式\n打过来……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "129/TALK",
            "narrator": "ガブリエラ",
            "text": "それで、小夜さんに\nあたし達がここにいること\nバレちゃったの？",
            "zh": "那，小夜小姐\n是不是已经发现\n我们在这里了？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "131/TALK",
            "narrator": "アーヤ",
            "text": "大丈夫よ。\n母が出たんだけど、\n誤魔化してくれたから…。",
            "zh": "没事。\n是我母亲接的，\n她帮忙敷衍过去了……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "133/TALK",
            "narrator": "ガブリエラ",
            "text": "そう…。",
            "zh": "这样啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "135/TALK",
            "narrator": "アーヤ",
            "text": "…ただ、問題があってね。",
            "zh": "……不过，有个问题。",
            "narrator_zh": "绫水"
        },
        {
            "location": "136/TALK",
            "narrator": "アーヤ",
            "text": "小夜がうちに電話を\nかけてきたのって。",
            "zh": "小夜之所以会\n打电话到我家里，",
            "narrator_zh": "绫水"
        },
        {
            "location": "137/TALK",
            "narrator": "アーヤ",
            "text": "日向さん達に\nお願いされたから\nみたいなの…。",
            "zh": "好像是因为\n日向她们\n拜托了她……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "140/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ！？",
            "zh": "哈啊！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "142/TALK",
            "narrator": "アーヤ",
            "text": "後輩の子達も心配して\n連絡取りたがってるって、\n母に言ったらしいわ…。",
            "zh": "她好像跟母亲说，\n后辈的孩子们也很担心，\n想跟我们取得联系……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "144/TALK",
            "narrator": "みやび",
            "text": "…まあ、予想はしてた\nけんどな。",
            "zh": "……嘛，虽然早就料到了\n不过。",
            "narrator_zh": "雅"
        },
        {
            "location": "145/TALK",
            "narrator": "みやび",
            "text": "あの子達が大人しく\nしちゅうとは思えん\nかったし。",
            "zh": "我也没觉得那几个娃\n会乖乖\n待着不动嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "146/TALK",
            "narrator": "ガブリエラ",
            "text": "…あのさ。",
            "zh": "……那个啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "147/TALK",
            "narrator": "ガブリエラ",
            "text": "あたし達が無事ってこと\nだけでも、伝えることって\nできないの？",
            "zh": "至少告诉她们一声\n我们都平安无事，\n这也不行吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "148/TALK",
            "narrator": "アーヤ",
            "text": "…気持ちはわかるけど、\n得策とは言えないわ。",
            "zh": "……我明白你的心情，\n但这算不上什么好主意。",
            "narrator_zh": "绫水"
        },
        {
            "location": "149/TALK",
            "narrator": "アーヤ",
            "text": "下手に連絡を取れば、\n私達の居場所が管理庁に\nバレるかもしれないの…。",
            "zh": "要是贸然联系，\n我们的位置说不定\n会被管理厅发现的……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "151/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "154/TALK",
            "narrator": "アーヤ",
            "text": "…心苦しいけど、\n仕方ないわ。",
            "zh": "……虽然于心不忍，\n但也是没办法的事。",
            "narrator_zh": "绫水"
        },
        {
            "location": "155/TALK",
            "narrator": "アーヤ",
            "text": "日向さん達まで、\n管理庁との争いに巻き込む\nわけにはいかないし…。",
            "zh": "总不能连日向她们，\n也卷进我们跟管理厅的\n争端里吧……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "156/SEL",
            "narrator": "（選択肢）",
            "text": "本当に連絡しないの？",
            "zh": "真的不联系吗？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "157/SEL",
            "narrator": "（選択肢）",
            "text": "キリト達はもう被害者だよ",
            "zh": "圣翔他们已经是受害者了哦",
            "narrator_zh": "（选项）"
        },
        {
            "location": "158/ACT",
            "narrator": "",
            "text": "本当に連絡しないの？",
            "zh": "真的不联系吗？",
            "narrator_zh": ""
        },
        {
            "location": "174/TALK",
            "narrator": "アーヤ",
            "text": "しないわ(￣Д￣ )",
            "zh": "不联系(￣Д￣ )",
            "narrator_zh": "绫水"
        },
        {
            "location": "175/TALK",
            "narrator": "アーヤ",
            "text": "そんなことしたら",
            "zh": "要是那么做了",
            "narrator_zh": "绫水"
        },
        {
            "location": "176/TALK",
            "narrator": "アーヤ",
            "text": "日向さん達",
            "zh": "会把日向她们",
            "narrator_zh": "绫水"
        },
        {
            "location": "177/TALK",
            "narrator": "アーヤ",
            "text": "巻き込むことになるし(>_<)",
            "zh": "也牵连进来的(>_<)",
            "narrator_zh": "绫水"
        },
        {
            "location": "179/SEL",
            "narrator": "（選択肢）",
            "text": "でも、みんな心配してるよ？",
            "zh": "可是，大家都很担心哦？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "180/SEL",
            "narrator": "（選択肢）",
            "text": "でも、キリト達は謹慎になったよ？",
            "zh": "可是，圣翔他们被停课处分了哦？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "181/ACT",
            "narrator": "",
            "text": "でも、みんな心配してるよ？",
            "zh": "可是，大家都很担心哦？",
            "narrator_zh": ""
        },
        {
            "location": "182/TALK",
            "narrator": "アーヤ",
            "text": "わかってる(-.-;)",
            "zh": "我知道(-.-;)",
            "narrator_zh": "绫水"
        },
        {
            "location": "183/TALK",
            "narrator": "アーヤ",
            "text": "それでも",
            "zh": "即便如此",
