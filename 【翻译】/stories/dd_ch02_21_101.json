{
    "dir": "chap21/daydra/dd_ch02_21_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "21202",
        "cid": "ayami",
        "title": "002 メインストーリー",
        "sub_title": "初めての夜＜前編＞",
        "title_zh": "002 主线剧情",
        "sub_title_zh": "最初的夜晚＜前篇＞"
    },
    "entry": [
        {
            "location": "48/TALK",
            "narrator": "神楽",
            "text": "きゃーっ！！\n素敵です、\n最高過ぎます！",
            "zh": "呀——！！\n太棒了，\n简直太赞了！",
            "narrator_zh": "神乐"
        },
        {
            "location": "49/TALK",
            "narrator": "神楽",
            "text": "パジャマ姿の\nつばめさん、\n最高にキュートです！",
            "zh": "穿着睡衣的\n燕，\n简直可爱到极点！",
            "narrator_zh": "神乐"
        },
        {
            "location": "51/TALK",
            "narrator": "つばめ",
            "text": "そ、そうかな？\nそんなこと言われたの\n初めてだよ…。",
            "zh": "是、是吗？\n还是第一次有人\n对我这么说呢……。",
            "narrator_zh": "燕"
        },
        {
            "location": "52/TALK",
            "narrator": "みやび",
            "text": "よく言われるゆうたら\nちっくと問題ありやと\n思うけんどね？",
            "zh": "要是常被人这么说，\n我倒觉得有点\n问题咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "53/TALK",
            "narrator": "ガブリエラ",
            "text": "あら、そうかしら？",
            "zh": "哎呀，是吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "55/TALK",
            "narrator": "みやび",
            "text": "そりゃ、パジャマ\n見せ合う関係の奴が\nおるゆうことやし。",
            "zh": "那不就是说，\n有互相给对方看睡衣\n的人在咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "58/TALK",
            "narrator": "アーヤ",
            "text": "ちょっと、みやび！\nギャヴィは中学生\nなのよ。",
            "zh": "喂，雅！\n加维还是初中生\n哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "59/TALK",
            "narrator": "アーヤ",
            "text": "そういう話は控えて。",
            "zh": "这种话题收着点。",
            "narrator_zh": "绫水"
        },
        {
            "location": "61/TALK",
            "narrator": "ガブリエラ",
            "text": "こ、子ども扱いしない\nでよね！？",
            "zh": "别、别把我当小孩子\n好不好！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "62/TALK",
            "narrator": "ガブリエラ",
            "text": "それくらいの意味、\n中学生にもなれば\nわかるんだから。",
            "zh": "这点意思，\n到了初中生年纪\n谁都懂的好吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "64/TALK",
            "narrator": "みやび",
            "text": "さすが今の子は\n進んどるね。",
            "zh": "不愧是现在的孩子，\n思想蛮前卫咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "66/TALK",
            "narrator": "つばめ",
            "text": "？　パジャマを\n見せ合う関係の人…。",
            "zh": "？　互相给对方看\n睡衣的人……。",
            "narrator_zh": "燕"
        },
        {
            "location": "68/TALK",
            "narrator": "つばめ",
            "text": "あ、お父さんとかの\nことかな？",
            "zh": "啊，是指爸爸之类的\n人吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "70/TALK",
            "narrator": "みやび",
            "text": "…人それぞれやね。",
            "zh": "……人各有各咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "72/TALK",
            "narrator": "神楽",
            "text": "仲良し親子の話じゃ\nないんですよ、\nつばめさん。",
            "zh": "不是说感情很好的\n父女啦，\n燕。",
            "narrator_zh": "神乐"
        },
        {
            "location": "75/TALK",
            "narrator": "つばめ",
            "text": "そうなの？\nねえガブちゃん、\nどういうことなの？",
            "zh": "是这样吗？\n呐加布，\n到底是什么意思呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "77/TALK",
            "narrator": "ガブリエラ",
            "text": "い、いいのよ！\nわからないなら\n気にしなくたって…。",
            "zh": "好、好了啦！\n不懂的话\n就别在意了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "80/TALK",
            "narrator": "つばめ",
            "text": "えーっ、\nでも気になるよぉ…。",
            "zh": "诶——\n可是我很在意嘛……。",
            "narrator_zh": "燕"
        },
        {
            "location": "82/TALK",
            "narrator": "ガブリエラ",
            "text": "気にしなくていいの！",
            "zh": "别在意就行了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "84/TALK",
            "narrator": "ガブリエラ",
            "text": "それより、みやび。",
            "zh": "话说回来，雅。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "85/TALK",
            "narrator": "ガブリエラ",
            "text": "この辺って海以外で\n出かけるような\nところははいの？",
            "zh": "这附近除了海以外，\n难道就没有别的\n地方可以去逛逛吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "86/TALK",
            "narrator": "みやび",
            "text": "海で十分やろ？",
            "zh": "去海边不就够了啵？",
            "narrator_zh": "雅"
        },
        {
            "location": "87/TALK",
            "narrator": "ガブリエラ",
            "text": "海だけなんて嫌よ。\nすぐ飽きるわ。",
            "zh": "光去海边才不要呢。\n很快就会腻的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "89/TALK",
            "narrator": "みやび",
            "text": "贅沢な…。\nだとすると、\nそうやな…。",
            "zh": "真挑剔……。\n要是那样的话，\n我想想咯……。",
            "narrator_zh": "雅"
        },
        {
            "location": "90/TALK",
            "narrator": "みやび",
            "text": "…鼻は好きか？",
            "zh": "……你喜欢“鼻”吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "91/TALK",
            "narrator": "ガブリエラ",
            "text": "お花畑ってこと？",
            "zh": "你是说花田吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "92/TALK",
            "narrator": "みやび",
            "text": "フラワーやなくて\nノウズの方や。",
            "zh": "不是 Flower 那个“花”，\n是 Nose 那个“鼻”咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "93/TALK",
            "narrator": "ガブリエラ",
            "text": "は？\n意味わからないん\nだけど…。",
            "zh": "哈？\n完全听不懂你在说什么\n……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "95/TALK",
            "narrator": "つばめ",
            "text": "大きな鼻の形した\n遺跡があるんですか？",
            "zh": "难道有什么大鼻子形状的\n遗迹吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "96/TALK",
            "narrator": "みやび",
            "text": "三戸浜はイースター島\nやないんやぞ？",
            "zh": "三户滨可不是复活节岛\n啵？",
            "narrator_zh": "雅"
        },
        {
            "location": "98/TALK",
            "narrator": "アーヤ",
            "text": "…あ、いけない。\nもうこんな時間…。",
            "zh": "……啊，糟了。\n都这个时间了……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "99/TALK",
            "narrator": "アーヤ",
            "text": "明日は\n朝から模擬戦だし。",
            "zh": "明天\n一早还有模拟战呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "100/TALK",
            "narrator": "アーヤ",
            "text": "いい加減、そろそろ\n寝ないといけない\nけど…。",
            "zh": "差不多也该\n去睡觉了才行\n不过……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "103/TALK",
            "narrator": "神楽",
            "text": "あ、つばめさんの\n隣の布団は私が\n予約済みですよ。",
            "zh": "啊，燕旁边的\n被褥我已经\n提前预订好了哦。",
            "narrator_zh": "神乐"
        },
        {
            "location": "105/TALK",
            "narrator": "ガブリエラ",
            "text": "はいはい、そんなの\n言われなくても\nわかってるわよ。",
            "zh": "好好好，那种事\n不用你说我也\n知道啦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "107/TALK",
            "narrator": "つばめ",
            "text": "あ、それじゃあ\n逆の方にガブちゃんが\n来ればいいよね。",
            "zh": "啊，那另一边\n就让加布\n来睡吧。",
            "narrator_zh": "燕"
        },
        {
            "location": "109/TALK",
            "narrator": "ガブリエラ",
            "text": "えーっ、つばめって\n寝相悪そうだし…。",
            "zh": "诶——，燕你的睡相\n看起来很差嘛……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "110/TALK",
            "narrator": "アーヤ",
            "text": "…寝るように\n言った方が\nいいのかも…。",
            "zh": "……还是提醒她们\n早点睡觉\n比较好吧……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "111/TALK",
            "narrator": "アーヤ",
            "text": "でも、せっかく\nこんなに楽しそうに\nしてるんだし…。",
            "zh": "可是，难得大家\n玩得这么开心\n……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "113/TALK",
            "narrator": "アーヤ",
            "text": "なんて。",
            "zh": "什么的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "114/TALK",
            "narrator": "アーヤ",
            "text": "実は\n私も楽しんでるから、\n悩んじゃうのよね。",
            "zh": "其实\n我自己也很开心，\n所以才犯难呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "117/TALK",
            "narrator": "アーヤ",
            "text": "…どうしよう？",
            "zh": "……怎么办好呢？",
            "narrator_zh": "绫水"
        },
        {
            "location": "181/TALK",
            "narrator": "アーヤ",
            "text": "　",
            "zh": "　",
            "narrator_zh": "绫水"
        },
        {
            "location": "204/TALK",
            "narrator": "アーヤ",
            "text": "[ココロゲート]へ\nいらっしゃい。\n$handle$さん。",
            "zh": "欢迎来到\n[心之扉]。\n$handle$。",
            "narrator_zh": "绫水"
        },
        {
            "location": "206/SEL",
            "narrator": "",
            "text": "なんでまた水着！？",
            "zh": "为什么又穿泳装！？",
            "narrator_zh": ""
        },
        {
            "location": "207/SEL",
            "narrator": "",
            "text": "サービスサービス♪",
            "zh": "福利时间到♪",
            "narrator_zh": ""
        },
        {
            "location": "208/ACT",
            "narrator": "",
            "text": "なんでまた水着！？",
            "zh": "为什么又穿泳装！？",
            "narrator_zh": ""
        },
        {
            "location": "209/TALK",
            "narrator": "アーヤ",
            "text": "…別に？",
            "zh": "……没什么特别理由？",
            "narrator_zh": "绫水"
        },
        {
            "location": "210/SEL",
            "narrator": "",
            "text": "やっぱり挑発してるんでしょ？",
            "zh": "果然是在故意撩人吧？",
            "narrator_zh": ""
        },
        {
            "location": "211/ACT",
            "narrator": "",
            "text": "やっぱり挑発してるんでしょ？",
            "zh": "果然是在故意撩人吧？",
            "narrator_zh": ""
        },
        {
            "location": "214/TALK",
            "narrator": "アーヤ",
            "text": "ま、まさか。",
            "zh": "怎、怎么可能。",
            "narrator_zh": "绫水"
        },
        {
            "location": "215/ACT",
            "narrator": "",
            "text": "サービスサービス♪",
            "zh": "福利时间到♪",
            "narrator_zh": ""
        },
        {
            "location": "217/TALK",
            "narrator": "アーヤ",
            "text": "サービスとかじゃないから。",
            "zh": "才不是什么福利呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "220/TALK",
            "narrator": "アーヤ",
            "text": "今回も海にいるでしょ？\nだからよ。",
            "zh": "这次不也是在海边吗？\n所以才这样。",
            "narrator_zh": "绫水"
        },
        {
            "location": "221/TALK",
            "narrator": "アーヤ",
            "text": "さあ、仕事仕事。",
            "zh": "好了，干活干活。",
            "narrator_zh": "绫水"
        },
        {
            "location": "223/TALK",
            "narrator": "アーヤ",
            "text": "今回の悩みは\n一体何かしらね。",
            "zh": "这次的烦恼\n究竟是什么呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "228/TALK",
            "narrator": "アーヤ",
            "text": "オープンプロセス、\n0x559番地から\n0xC3D番地へ。",
            "zh": "开放进程，\n从0x559号地址\n到0xC3D号地址。",
            "narrator_zh": "绫水"
        },
        {
            "location": "247/TALK",
            "narrator": "アーヤ",
            "text": "シーク完了。",
            "zh": "搜索完毕。",
            "narrator_zh": "绫水"
        },
        {
            "location": "250/TALK",
            "narrator": "アーヤ",
            "text": "さて、と。\n今回は……",
            "zh": "那么，\n这次是……",
            "narrator_zh": "绫水"
        },
        {
            "location": "252/TALK",
            "narrator": "アーヤ",
            "text": "…あら？\nここは―――",
            "zh": "……哎呀？\n这里是———",
            "narrator_zh": "绫水"
        },
        {
            "location": "253/SEL",
            "narrator": "",
            "text": "扉にダイブする",
            "zh": "向门内潜入",
            "narrator_zh": ""
        },
        {
            "location": "254/ACT",
            "narrator": "",
            "text": "扉にダイブする",
            "zh": "向门内潜入",
            "narrator_zh": ""
        },
        {
            "location": "257/TALK",
            "narrator": "アーヤ",
            "text": "えっ！？",
            "zh": "诶！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "269/TALK",
            "narrator": "アーヤ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "272/TALK",
            "narrator": "アーヤ",
            "text": "…誘導されたようです。",
            "zh": "……看来是被诱导了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "286/TALK",
            "narrator": "アーヤ",
            "text": "来てくれたのね！",
            "zh": "你真的来了呢！",
            "narrator_zh": "绫水"
        },
        {
            "location": "287/SEL",
            "narrator": "",
            "text": "前の司書のアーヤ？",
            "zh": "你是前任司书绫水吗？",
            "narrator_zh": ""
        },
        {
            "location": "288/ACT",
            "narrator": "",
            "text": "前の司書のアーヤ？",
            "zh": "你是前任司书绫水吗？",
            "narrator_zh": ""
        },
        {
            "location": "290/TALK",
            "narrator": "アーヤ",
            "text": "そうよ。",
            "zh": "是我哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "291/SEL",
            "narrator": "",
            "text": "無事で良かった",
            "zh": "你没事真是太好了",
            "narrator_zh": ""
        },
        {
            "location": "292/ACT",
            "narrator": "",
            "text": "無事で良かった",
            "zh": "你没事真是太好了",
            "narrator_zh": ""
        },
        {
            "location": "294/TALK",
            "narrator": "アーヤ",
            "text": "貴方もね。",
            "zh": "你也是呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "295/TALK",
            "narrator": "アーヤ",
            "text": "どうやらわたし、\n幽閉されてるみたいなの。",
            "zh": "看来我啊，\n好像是被幽禁起来了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "296/TALK",
            "narrator": "アーヤ",
            "text": "貴方に連絡取れたのは\nみやびのココロの司書の\nおかげ。",
            "zh": "能联系上你，\n多亏了雅的\n心之司书。",
            "narrator_zh": "绫水"
        },
        {
            "location": "297/TALK",
            "narrator": "アーヤ",
            "text": "彼女も幽閉されちゃってる\nらしいんだけど、一体\nどうなってるのかしらね。",
            "zh": "听说她似乎也遭到了幽禁，\n这到底是怎么\n一回事呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "298/SEL",
            "narrator": "",
            "text": "どうしてこんなことに",
            "zh": "怎么会变成这样",
            "narrator_zh": ""
        },
        {
            "location": "299/ACT",
            "narrator": "",
            "text": "どうしてこんなことに",
            "zh": "怎么会变成这样",
            "narrator_zh": ""
        },
        {
            "location": "301/TALK",
            "narrator": "アーヤ",
            "text": "理由はわかってる。",
            "zh": "原因我很清楚。",
            "narrator_zh": "绫水"
        },
        {
            "location": "302/TALK",
            "narrator": "アーヤ",
            "text": "私が貴方に、\n規約違反を犯しかけたから。",
            "zh": "因为我差点对你\n犯下违反规约的举动。",
            "narrator_zh": "绫水"
        },
        {
            "location": "303/SEL",
            "narrator": "",
            "text": "話があるって言ってたアレ？",
            "zh": "就是你之前说有话要讲的那个？",
            "narrator_zh": ""
        },
        {
            "location": "304/SEL",
            "narrator": "",
            "text": "司書は恋愛禁止だったということか",
            "zh": "难道说司书是禁止恋爱的吗",
            "narrator_zh": ""
        },
        {
            "location": "305/ACT",
            "narrator": "",
            "text": "話があるって言ってたアレ？",
            "zh": "就是你之前说有话要讲的那个？",
            "narrator_zh": ""
        },
        {
            "location": "306/TALK",
            "narrator": "アーヤ",
            "text": "そう。",
            "zh": "对。",
            "narrator_zh": "绫水"
        },
        {
            "location": "307/ACT",
            "narrator": "",
            "text": "司書は恋愛禁止だったということか",
            "zh": "难道说司书是禁止恋爱的吗",
            "narrator_zh": ""
        },
        {
            "location": "308/TALK",
            "narrator": "アーヤ",
            "text": "えっと…\nどういうことかしら？",
            "zh": "那个……\n这是什么意思呀？",
            "narrator_zh": "绫水"
        },
        {
            "location": "309/TALK",
            "narrator": "アーヤ",
            "text": "あー、もしかしてアレ？",
            "zh": "啊——，难道说是那个？",
            "narrator_zh": "绫水"
        },
        {
            "location": "310/TALK",
            "narrator": "アーヤ",
            "text": "私が貴方に惚れちゃって\nそれが発覚したから、幽閉\nされたとでも言いたいの？",
            "zh": "你是想说因为我爱上了你，\n事情败露之后\n才被幽禁起来的吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "311/TALK",
            "narrator": "アーヤ",
            "text": "まあ、好きではあるけど、\n幽閉される理由じゃ\nないわね。",
            "zh": "嘛，虽然确实很喜欢你，\n但这可不是被幽禁的\n理由哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "312/TALK",
            "narrator": "アーヤ",
            "text": "この前話があるって\n言ったでしょ？\nアレがまずかったのよ。",
            "zh": "我之前不是说过\n有话要跟你说吗？\n是那件事惹了麻烦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "314/TALK",
            "narrator": "アーヤ",
            "text": "でもかえって好都合かも。\nここなら誰にも邪魔されずに\n貴方に伝えられる。",
            "zh": "不过这样反而正好。\n在这里谁也打扰不到，\n可以把话传达给你。",
            "narrator_zh": "绫水"
        },
        {
            "location": "315/SEL",
            "narrator": "",
            "text": "話って、司書のこととか？",
            "zh": "有话要说，是指司书的事吗？",
            "narrator_zh": ""
        },
        {
            "location": "316/ACT",
            "narrator": "",
            "text": "話って、司書のこととか？",
            "zh": "有话要说，是指司书的事吗？",
            "narrator_zh": ""
        },
        {
            "location": "318/TALK",
            "narrator": "アーヤ",
            "text": "そうよ。",
            "zh": "没错。",
            "narrator_zh": "绫水"
        },
        {
            "location": "319/TALK",
            "narrator": "アーヤ",
            "text": "今から司書とはなんなのか\n貴方に真実を伝えます。",
            "zh": "现在我就把司书究竟是什么，\n把真相告诉你。",
            "narrator_zh": "绫水"
        },
        {
            "location": "320/TALK",
            "narrator": "アーヤ",
            "text": "私が司書だった頃、いつも\nくだらない悩みばかり\n扱ってたのは覚えてる？",
            "zh": "我还担任司书的时候，\n总是只处理些鸡毛蒜皮的烦恼，\n你还记得吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "321/SEL",
            "narrator": "",
            "text": "ツッコミ入れたくらいだしね",
            "zh": "我还吐槽过这事呢",
            "narrator_zh": ""
        },
        {
            "location": "322/SEL",
            "narrator": "",
            "text": "そうだっけ？",
            "zh": "是这样吗？",
            "narrator_zh": ""
        },
        {
            "location": "323/ACT",
            "narrator": "",
            "text": "ツッコミ入れたくらいだしね",
            "zh": "我还吐槽过这事呢",
            "narrator_zh": ""
        },
        {
            "location": "324/TALK",
            "narrator": "アーヤ",
            "text": "そうよね。\n貴方は鋭いから。",
            "zh": "是啊。\n毕竟你很敏锐嘛。",
            "narrator_zh": "绫水"
        },
        {
            "location": "325/ACT",
            "narrator": "",
            "text": "そうだっけ？",
            "zh": "是这样吗？",
            "narrator_zh": ""
        },
        {
            "location": "326/TALK",
            "narrator": "アーヤ",
            "text": "そうよ。\nもう忘れちゃった？",
            "zh": "是啊。\n已经忘了吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "328/TALK",
            "narrator": "アーヤ",
            "text": "その理由なんだけど――",
            "zh": "至于这么做的理由——",
            "narrator_zh": "绫水"
        },
        {
            "location": "329/TALK",
            "narrator": "アーヤ",
            "text": "理由は、少なくとも\n私にとって、必ずしもいい\n影響を与えないから。",
            "zh": "理由就是，那至少\n对我而言，未必会带来\n好的影响。",
            "narrator_zh": "绫水"
        },
        {
            "location": "330/SEL",
            "narrator": "",
            "text": "どういうこと？",
            "zh": "什么意思？",
            "narrator_zh": ""
        },
        {
            "location": "331/ACT",
            "narrator": "",
            "text": "どういうこと？",
            "zh": "什么意思？",
            "narrator_zh": ""
        },
        {
            "location": "333/TALK",
            "narrator": "アーヤ",
            "text": "私たち司書は、\nとある存在と契約してる。",
            "zh": "我们司书，\n与某个存在签有契约。",
            "narrator_zh": "绫水"
        },
        {
            "location": "334/TALK",
            "narrator": "アーヤ",
            "text": "それは契約と言うより\nギアスという方が\n近いかも。",
            "zh": "与其说是契约，\n不如说是 Geass\n可能更贴切。",
            "narrator_zh": "绫水"
        },
        {
            "location": "335/TALK",
            "narrator": "アーヤ",
            "text": "例えば……",
            "zh": "比如说……",
            "narrator_zh": "绫水"
        },
        {
            "location": "336/TALK",
            "narrator": "アーヤ",
            "text": "悪魔と契約するとき、\nその絶大な力と引き替えに\n何かを奪われたりする。",
            "zh": "与恶魔签约的时候，\n作为换取那份强大力量的代价，\n总会被夺走些什么。",
            "narrator_zh": "绫水"
        },
        {
            "location": "337/TALK",
            "narrator": "アーヤ",
            "text": "神の力を授かろうとする時\nその代償として、生け贄が\n必要になる。",
            "zh": "向神明祈求赐予力量时，\n作为代价，也需要献上\n祭品。",
            "narrator_zh": "绫水"
        },
        {
            "location": "338/TALK",
            "narrator": "アーヤ",
            "text": "誤解を恐れずに言うなら、\n私たち司書は\nその生け贄ね。",
            "zh": "若不怕产生误解直白地说，\n我们司书就是\n那个祭品哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "339/TALK",
            "narrator": "アーヤ",
            "text": "契約主は、いち個人の力を\n超越した判断によって、私\nたちの能力を引き出す。",
            "zh": "契约主会以超越单一个体\n能力的判断，来引出\n我们的力量。",
            "narrator_zh": "绫水"
        },
        {
            "location": "340/TALK",
            "narrator": "アーヤ",
            "text": "そして私の総体は、契約に\nよって無意識的に\nその判断を受け入れる。",
            "zh": "而我的本体，会基于契约\n在无意识中\n接受那个判断。",
            "narrator_zh": "绫水"
        },
        {
            "location": "341/TALK",
            "narrator": "アーヤ",
            "text": "その際の\nインターフェイス的な\n役割を担うのが司書。",
            "zh": "在那个过程中，\n承担着类似于接口职责的，\n便是司书。",
            "narrator_zh": "绫水"
        },
        {
            "location": "342/TALK",
            "narrator": "アーヤ",
            "text": "とはいっても、\n苦しい仕事をさせられて\nいるわけじゃない。",
            "zh": "话虽如此，\n倒也不是被强迫去做\n什么痛苦的工作。",
            "narrator_zh": "绫水"
        },
        {
            "location": "343/TALK",
            "narrator": "アーヤ",
            "text": "契約主の意向に従って、\nごく自然な決定操作をする。\nただそれだけの役割を担う。",
            "zh": "只是遵照契约主的意向，\n做出极其自然的决定操作。\n仅仅承担着这样的职责。",
            "narrator_zh": "绫水"
        },
        {
            "location": "344/TALK",
            "narrator": "アーヤ",
            "text": "ただ、それは必ずしも\n自分自身のためであるとは\n言い難いでしょ？",
            "zh": "只是，那未必总是\n为了自己本身着想，\n这很难说得通吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "345/TALK",
            "narrator": "アーヤ",
            "text": "もちろん、基本的には良い\n結果をもたらす事が殆ど。\nそういう契約だもの。",
            "zh": "当然，基本上绝大多数时候\n都会带来好结果。\n毕竟就是这样的契约嘛。",
            "narrator_zh": "绫水"
        },
        {
            "location": "346/TALK",
            "narrator": "アーヤ",
            "text": "事実、私に送られてくる\n判断は、私自身にとって\n良い結果を生み出している。",
            "zh": "事实上，传递到我这里的\n判断，对我自身而言\n也确实产生了好的结果。",
            "narrator_zh": "绫水"
        },
        {
            "location": "347/TALK",
            "narrator": "アーヤ",
            "text": "けど、根源的な事として、\nそれは必ずしも私の為では\n無い事も知っていた。",
            "zh": "但是，从根本上来说，\n我也知道那未必\n是为了我好。",
            "narrator_zh": "绫水"
        },
        {
            "location": "348/TALK",
            "narrator": "アーヤ",
            "text": "だから私はずっと、\n今の状態はたまたま利害が\n一致してるだけだと――",
            "zh": "所以我一直觉得，\n现在的状态只不过是\n恰巧利害一致罢了——",
            "narrator_zh": "绫水"
        },
        {
            "location": "349/TALK",
            "narrator": "アーヤ",
            "text": "もし利害にズレが出たら、\n一瞬にして自己破滅に追い\nやられる状況だと思ってた。",
            "zh": "一旦利害出现偏差，\n瞬间就会沦为被逼入\n自我毁灭的处境。",
            "narrator_zh": "绫水"
        },
        {
            "location": "350/TALK",
            "narrator": "アーヤ",
            "text": "そして、それを最小限に\n食い止める為に、小さな\n悩みしか選抜しなかった。",
            "zh": "而为了将这种风险\n抑制到最低限度，\n我才只挑选微小的烦恼。",
            "narrator_zh": "绫水"
        },
        {
            "location": "351/TALK",
            "narrator": "アーヤ",
            "text": "……とまあ、\nこういうこと。",
            "zh": "……嘛，\n就是这么回事。",
            "narrator_zh": "绫水"
        },
        {
            "location": "352/TALK",
            "narrator": "アーヤ",
            "text": "これが\n私の伝えたかった全て。\nどう？　びっくりした？",
            "zh": "这就是\n我想传达给你的一切。\n怎么样？　吓到了吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "353/SEL",
            "narrator": "",
            "text": "ビックリした…",
            "zh": "吓了一跳……",
            "narrator_zh": ""
        },
        {
            "location": "354/SEL",
            "narrator": "",
            "text": "そんなに話したらアーヤ消されるよ！！",
            "zh": "说这么多的话绫水你会被抹消掉的！！",
            "narrator_zh": ""
        },
        {
            "location": "355/ACT",
            "narrator": "",
            "text": "ビックリした…",
            "zh": "吓了一跳……",
            "narrator_zh": ""
        },
        {
            "location": "356/TALK",
            "narrator": "アーヤ",
            "text": "でしょうね。\nそれはわかってた。",
            "zh": "是吧。\n这点我早就料到了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "357/TALK",
            "narrator": "アーヤ",
            "text": "そして、こんな話をしてる\nことは、もう契約主には\n察知されてると思う。",
            "zh": "而且，我正在说这些话的事，\n我想契约主应该已经\n察觉到了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "358/ACT",
            "narrator": "",
            "text": "そんなに話したらアーヤ消されるよ！！",
            "zh": "说这么多的话绫水你会被抹消掉的！！",
            "narrator_zh": ""
        },
        {
            "location": "359/TALK",
            "narrator": "アーヤ",
            "text": "そうね。\nそうかもしれない。",
            "zh": "是呢。\n说不定会那样。",
            "narrator_zh": "绫水"
        },
        {
            "location": "360/TALK",
            "narrator": "アーヤ",
            "text": "ううん。\nそれは覚悟の上……",
            "zh": "不。\n我已经做好觉悟了……",
            "narrator_zh": "绫水"
        },
        {
            "location": "361/TALK",
            "narrator": "アーヤ",
            "text": "なんて。その覚悟ができず\nモタモタしてたから、\n先手打たれたんだけど。",
            "zh": "开玩笑的。就是因为下不了决心\n一直磨磨蹭蹭的，\n才会被对方抢先一步。",
            "narrator_zh": "绫水"
        },
        {
            "location": "363/TALK",
            "narrator": "アーヤ",
            "text": "でも、これで\n私たちの勝ちよ。",
            "zh": "不过，这样一来\n就是我们赢了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "364/TALK",
            "narrator": "アーヤ",
            "text": "例え私たちが消されても、\nこの情報は\n貴方に伝わった。",
            "zh": "就算我们被抹消了，\n这些情报也已经\n传达给你了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "365/TALK",
            "narrator": "アーヤ",
            "text": "貴方はこの世界の住人では\nないから、そう簡単には\n消せないと思う。",
            "zh": "你并不是这个世界的居民，\n我想对方没那么容易\n抹消掉你。",
            "narrator_zh": "绫水"
        },
        {
            "location": "366/SEL",
            "narrator": "",
            "text": "アーヤ…",
            "zh": "绫水……",
            "narrator_zh": ""
        },
        {
            "location": "367/ACT",
            "narrator": "",
            "text": "アーヤ…",
            "zh": "绫水……",
            "narrator_zh": ""
        },
        {
            "location": "369/TALK",
            "narrator": "アーヤ",
            "text": "心配しないで。\n万一私が消えることに\nなっても総体は消えない。",
            "zh": "别担心。\n万一我真的被抹消了，\n本体也不会消失。",
            "narrator_zh": "绫水"
        },
        {
            "location": "370/TALK",
            "narrator": "アーヤ",
            "text": "大事な情報は全て\n貴方に託したし。",
            "zh": "重要的情报也全都\n托付给你了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "371/TALK",
            "narrator": "アーヤ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "372/TALK",
            "narrator": "アーヤ",
            "text": "確かに、\n消されるのは怖い。",
            "zh": "确实，\n被抹消是很可怕。",
            "narrator_zh": "绫水"
        },
        {
            "location": "373/TALK",
            "narrator": "アーヤ",
            "text": "でも、もうこのまま\nシラを切り続けることは\nできなかったの。",
            "zh": "但事到如今，\n我已经没法再继续\n装傻下去了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "374/TALK",
            "narrator": "アーヤ",
            "text": "私の良心が許さなくて。",
            "zh": "我的良心不允许我这么做。",
            "narrator_zh": "绫水"
        },
        {
            "location": "375/SEL",
            "narrator": "",
            "text": "必ず助けるから！",
            "zh": "我一定会救你的！",
            "narrator_zh": ""
        },
        {
            "location": "376/SEL",
            "narrator": "",
            "text": "アーヤの事は守る",
            "zh": "我会保护绫水的",
            "narrator_zh": ""
        },
        {
            "location": "377/ACT",
            "narrator": "",
            "text": "必ず助けるから！",
            "zh": "我一定会救你的！",
            "narrator_zh": ""
        },
        {
            "location": "378/TALK",
            "narrator": "アーヤ",
            "text": "ありがと。",
            "zh": "谢谢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "379/ACT",
            "narrator": "",
            "text": "アーヤの事は守る",
            "zh": "我会保护绫水的",
            "narrator_zh": ""
        },
        {
            "location": "380/TALK",
            "narrator": "アーヤ",
            "text": "宜しくお願いね。\n信じてるから。",
            "zh": "那就拜托你了。\n我相信你。",
            "narrator_zh": "绫水"
        },
        {
            "location": "386/SEL",
            "narrator": "",
            "text": "これは！？",
            "zh": "这是！？",
            "narrator_zh": ""
        },
        {
            "location": "387/ACT",
            "narrator": "",
            "text": "これは！？",
            "zh": "这是！？",
            "narrator_zh": ""
        },
        {
            "location": "389/TALK",
            "narrator": "アーヤ",
            "text": "早速お出ましみたいね。",
            "zh": "看来马上就找上门来了呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "392/TALK",
            "narrator": "アーヤ",
            "text": "私を消しに、契約主の\n眷属のクランがここに\n来ているみたい。",
            "zh": "为了抹消我，\n契约主的眷属库兰\n好像已经来到这里了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "394/TALK",
            "narrator": "アーヤ",
            "text": "ここは私が対応するから\n貴方は早く現実に戻って。",
            "zh": "这里由我来应付，\n你快点回到现实去吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "395/SEL",
            "narrator": "",
            "text": "さすがにそれは…",
            "zh": "话虽如此这怎么能……",
            "narrator_zh": ""
        },
        {
            "location": "396/SEL",
            "narrator": "",
            "text": "アーヤを守るんだ！",
            "zh": "我要保护绫水！",
            "narrator_zh": ""
        },
        {
            "location": "397/ACT",
            "narrator": "",
            "text": "さすがにそれは…",
            "zh": "话虽如此这怎么能……",
            "narrator_zh": ""
        },
        {
            "location": "398/TALK",
            "narrator": "アーヤ",
            "text": "…そう？\nそれじゃ、もしよかったら\n手伝ってくれる？",
            "zh": "……是吗？\n那如果可以的话，\n能帮帮我吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "399/ACT",
            "narrator": "",
            "text": "アーヤを守るんだ！",
            "zh": "我要保护绫水！",
            "narrator_zh": ""
        },
        {
            "location": "400/TALK",
            "narrator": "アーヤ",
            "text": "ふふ…ありがと。\nとっても嬉しい。",
            "zh": "呵呵……谢谢。\n我真的很开心。",
            "narrator_zh": "绫水"
        },
        {
            "location": "401/TALK",
            "narrator": "アーヤ",
            "text": "それじゃ、もしよかったら\n手伝ってくれる？",
            "zh": "那如果可以的话，\n能帮帮我吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "403/TALK",
            "narrator": "アーヤ",
            "text": "カッコイイ事言ったけど\n本当はとても怖い。\n震えが止まらないの。",
            "zh": "虽然刚才说得很帅气，\n其实我真的害怕极了。\n抖得停不下来。",
            "narrator_zh": "绫水"
        },
        {
            "location": "404/TALK",
            "narrator": "アーヤ",
            "text": "だから、貴方がいてくれて\n本当に嬉しい。",
            "zh": "所以，有你在身边\n我真的很高兴。",
            "narrator_zh": "绫水"
        },
        {
            "location": "405/TALK",
            "narrator": "アーヤ",
            "text": "今攻めてきているクランを\n撃退するのだけ、手伝って\nくれると嬉しいかな。",
            "zh": "只要帮我击退\n现在攻过来的库兰，\n我就很满足了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "406/TALK",
            "narrator": "アーヤ",
            "text": "それ以上は、貴方に迷惑を\nかけられない。",
            "zh": "除此之外，不能再给你\n添更多麻烦了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "407/TALK",
            "narrator": "アーヤ",
            "text": "貴方には、私の総体を\nずっと護り続けて\n欲しいから。",
            "zh": "因为我希望你，\n能一直守护着\n我的本体。",
            "narrator_zh": "绫水"
        },
        {
            "location": "408/SEL",
            "narrator": "",
            "text": "もちろん",
            "zh": "当然",
            "narrator_zh": ""
        },
        {
            "location": "409/SEL",
            "narrator": "",
            "text": "できる限りは",
            "zh": "我会尽我所能",
            "narrator_zh": ""
        },
        {
            "location": "410/ACT",
            "narrator": "",
            "text": "もちろん",
            "zh": "当然",
            "narrator_zh": ""
        },
        {
            "location": "411/ACT",
            "narrator": "",
            "text": "できる限りは",
            "zh": "我会尽我所能",
            "narrator_zh": ""
        },
        {
            "location": "413/TALK",
            "narrator": "アーヤ",
            "text": "…嬉しい。\n本当に何から何まで……。",
            "zh": "……好开心。\n真的从头到尾都……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "414/TALK",
            "narrator": "アーヤ",
            "text": "大好きよ。\n$handle$…。",
            "zh": "最喜欢你了。\n$handle$……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "415/TALK",
            "narrator": "アーヤ",
            "text": "最後に１つ。\n私の名前だけ、どうか\n覚えていって欲しい。",
            "zh": "最后还有一件事。\n只希望你，\n能记住我的名字。",
            "narrator_zh": "绫水"
        },
        {
            "location": "416/TALK",
            "narrator": "アーヤ",
            "text": "私の名前は、\nエヴェレット・\nクラウスナー。",
            "zh": "我的名字是，\n艾弗雷特·\n克劳斯纳。",
            "narrator_zh": "绫水"
        },
        {
            "location": "417/TALK",
            "narrator": "アーヤ",
            "text": "どうか、忘れないで。",
            "zh": "请务必，不要忘记。",
            "narrator_zh": "绫水"
        },
        {
            "location": "418/TALK",
            "narrator": "アーヤ",
            "text": "それじゃ、\n準備はいい？",
            "zh": "那么，\n准备好了吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "419/SEL",
