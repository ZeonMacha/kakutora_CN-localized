            "location": "396/TALK",
            "narrator": "アーヤの新司書　",
            "text": "契約主の用意した人格。",
            "zh": "契约主准备的人格。",
            "narrator_zh": "绫水的新司书"
        },
        {
            "location": "397/TALK",
            "narrator": "アーヤの新司書　",
            "text": "まあ、なんだか契約主は\n突然いなくなっちゃった\nらしいけど。",
            "zh": "嘛，不过契约主好像\n突然不见了\n的样子就是了。",
            "narrator_zh": "绫水的新司书"
        },
        {
            "location": "398/TALK",
            "narrator": "アーヤの新司書　",
            "text": "それでかどうか、\nその半分がスッと抜けて、\n今は前に戻った感じ。",
            "zh": "不知是不是这个缘故，\n那一半嗖地一下抽离了，\n现在感觉又变回以前那样了。",
            "narrator_zh": "绫水的新司书"
        },
        {
            "location": "399/TALK",
            "narrator": "アーヤの新司書　",
            "text": "まあ、たぶん\n機能停止してるだけ\nなんでしょうけどね。",
            "zh": "嘛，大概也只是\n机能停止了\n而已吧。",
            "narrator_zh": "绫水的新司书"
        },
        {
            "location": "401/TALK",
            "narrator": "アーヤの新司書　",
            "text": "いずれにせよ、\nあまり警戒しないで。",
            "zh": "不管怎样，\n别那么戒备了。",
            "narrator_zh": "绫水的新司书"
        },
        {
            "location": "402/TALK",
            "narrator": "アーヤの新司書　",
            "text": "腐っても一人格だから、\n自分に害のあることは\nしないわ。",
            "zh": "瘦死的骆驼比马大，我好歹也是一个人格，\n对自己有害的事\n我是不会做的。",
            "narrator_zh": "绫水的新司书"
        },
        {
            "location": "403/TALK",
            "narrator": "アーヤの新司書　",
            "text": "エヴェレットほど、\n貴方にベタベタしたりは\nしないけどね。",
            "zh": "虽然我可不会像艾弗雷特那样，\n对你黏糊糊地\n撒娇就是了。",
            "narrator_zh": "绫水的新司书"
        },
        {
            "location": "404/TALK",
            "narrator": "アーヤの新司書　",
            "text": "そういうの\nホントにもう\n疲れちゃうから。",
            "zh": "那种事\n真的太让人\n累得慌了。",
            "narrator_zh": "绫水的新司书"
        },
        {
            "location": "405/TALK",
            "narrator": "アーヤの新司書　",
            "text": "それじゃ、\n回すわね。",
            "zh": "那么，\n我要转动了哦。",
            "narrator_zh": "绫水的新司书"
        },
        {
            "location": "412/TALK",
            "narrator": "アーヤの新司書　",
            "text": "オープンプロセス――",
            "zh": "开放进程——",
            "narrator_zh": "绫水的新司书"
        },
        {
            "location": "413/TALK",
            "narrator": "アーヤの新司書　",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "绫水的新司书"
        },
        {
            "location": "414/TALK",
            "narrator": "アーヤの新司書　",
            "text": "…？",
            "zh": "……？",
            "narrator_zh": "绫水的新司书"
        },
        {
            "location": "415/TALK",
            "narrator": "アーヤの新司書　",
            "text": "何も降ってこないわね。",
            "zh": "什么都没传下来呢。",
            "narrator_zh": "绫水的新司书"
        },
        {
            "location": "417/TALK",
            "narrator": "エヴェレット",
            "text": "$handle$さん、その人格に勝手なことさせないで",
            "zh": "$handle$，别让那个人格胡来",
            "narrator_zh": "艾弗雷特"
        },
        {
            "location": "418/TALK",
            "narrator": "エヴェレット",
            "text": "おねがい",
            "zh": "拜托了",
            "narrator_zh": "艾弗雷特"
        },
        {
            "location": "419/SEL",
            "narrator": "",
            "text": "エヴェレットが情報とめてるの？",
            "zh": "是艾弗雷特把情报截住了吗？",
            "narrator_zh": ""
        },
        {
            "location": "420/ACT",
            "narrator": "",
            "text": "エヴェレットが情報とめてるの？",
            "zh": "是艾弗雷特把情报截住了吗？",
            "narrator_zh": ""
        },
        {
            "location": "422/TALK",
            "narrator": "エヴェレット",
            "text": "とめてる？",
            "zh": "截住？",
            "narrator_zh": "艾弗雷特"
        },
        {
            "location": "423/TALK",
            "narrator": "エヴェレット",
            "text": "なんのこと？",
            "zh": "你在说什么呀？",
            "narrator_zh": "艾弗雷特"
        },
        {
            "location": "424/SEL",
            "narrator": "",
            "text": "謎のおねえさんから情報が届くはずなんだけど",
            "zh": "本来应该有神秘的大姐姐把情报送过来的",
            "narrator_zh": ""
        },
        {
            "location": "425/ACT",
            "narrator": "",
            "text": "謎のおねえさんから情報が届くはずなんだけど",
            "zh": "本来应该有神秘的大姐姐把情报送过来的",
            "narrator_zh": ""
        },
        {
            "location": "427/TALK",
            "narrator": "エヴェレット",
            "text": "とにかく",
            "zh": "总之",
            "narrator_zh": "艾弗雷特"
        },
        {
            "location": "430/TALK",
            "narrator": "アーヤの新司書　",
            "text": "またエヴェレットさん？",
            "zh": "又是艾弗雷特吗？",
            "narrator_zh": "绫水的新司书"
        },
        {
            "location": "433/TALK",
            "narrator": "アーヤの新司書　",
            "text": "文句があるなら、\nこっちに戻って来たら\nいくらでも――",
            "zh": "要是有意见的话，\n等回到这边来\n多少都可以——",
            "narrator_zh": "绫水的新司书"
        },
        {
            "location": "440/TALK",
            "narrator": "アーヤの新司書　",
            "text": "え！？",
            "zh": "哎！？",
            "narrator_zh": "绫水的新司书"
        },
        {
            "location": "28/DIALOG",
