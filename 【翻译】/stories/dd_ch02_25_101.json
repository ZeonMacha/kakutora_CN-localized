    "entry": [
        {
            "location": "8/SCENARIO",
            "narrator": "",
            "text": "想定外の想定値",
            "zh": "意料之外的预设值",
            "narrator_zh": ""
        },
        {
            "location": "29/TALK",
            "narrator": "アーヤ",
            "text": "…つばめ、\n遅いわね…。",
            "zh": "……燕，\n好慢啊……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "31/TALK",
            "narrator": "ガブリエラ",
            "text": "みやびもまだ\n来てないわよ。",
            "zh": "雅也还没\n过来哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "33/TALK",
            "narrator": "アーヤ",
            "text": "みやびは寮に\n戻ったんだもの。",
            "zh": "雅是因为\n回宿舍了嘛。",
            "narrator_zh": "绫水"
        },
        {
            "location": "35/TALK",
            "narrator": "アーヤ",
            "text": "時間がかかるのは\n仕方ないわ。",
            "zh": "花点时间\n也是没办法的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "36/TALK",
            "narrator": "ガブリエラ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "37/TALK",
            "narrator": "ガブリエラ",
            "text": "あたし少し\n見てこようか。",
            "zh": "要不我稍微\n去看看情况吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "38/TALK",
            "narrator": "アーヤ",
            "text": "みやびなら\nいざとなれば\n迎えに行けるわ。",
            "zh": "雅的话，\n真到万不得已\n还可以去接她。",
            "narrator_zh": "绫水"
        },
        {
            "location": "39/TALK",
            "narrator": "ガブリエラ",
            "text": "…つばめは…。",
            "zh": "……那燕呢……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "40/TALK",
            "narrator": "アーヤ",
            "text": "ダメよ。\n危険すぎるわ。",
            "zh": "不行。\n太危险了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "41/TALK",
            "narrator": "ガブリエラ",
            "text": "でも…。",
            "zh": "可是……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "42/TALK",
            "narrator": "アーヤ",
            "text": "待ちましょう。\n今はそれが最善策。",
            "zh": "再等等吧。\n现在这是最稳妥的办法。",
            "narrator_zh": "绫水"
        },
        {
            "location": "44/TALK",
            "narrator": "ガブリエラ",
            "text": "…でも…。",
            "zh": "……可是……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "45/TALK",
            "narrator": "アーヤ",
            "text": "とはいうものの\nあまり遅くなりすぎたら\nここも危険になる……。",
            "zh": "话虽这么说，\n要是拖得太晚，\n这里也会变得危险……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "46/TALK",
            "narrator": "アーヤ",
            "text": "でもギャヴィに\n行かせるのが\n危険なのも事実…。",
            "zh": "但让加维去\n确实太危险了，\n这也是事实……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "47/SEL",
            "narrator": "",
            "text": "おーい",
            "zh": "喂——",
            "narrator_zh": ""
        },
        {
            "location": "48/ACT",
            "narrator": "",
            "text": "おーい",
            "zh": "喂——",
            "narrator_zh": ""
        },
        {
            "location": "63/TALK",
            "narrator": "プレイヤー",
            "text": "おーい",
            "zh": "喂——",
            "narrator_zh": "玩家"
        },
        {
            "location": "65/TALK",
            "narrator": "アーヤ",
            "text": "ごめんね",
            "zh": "抱歉",
            "narrator_zh": "绫水"
        },
        {
            "location": "66/TALK",
            "narrator": "アーヤ",
            "text": "今取り込み中",
            "zh": "现在有点忙",
            "narrator_zh": "绫水"
        },
        {
            "location": "78/TALK",
            "narrator": "アーヤ",
            "text": "……音羽の\n様子はどう？",
            "zh": "……音羽的\n情况怎么样？",
            "narrator_zh": "绫水"
        },
        {
            "location": "79/TALK",
            "narrator": "ガブリエラ",
            "text": "特に問題は\nないと思うわ。",
            "zh": "我觉得应该\n没什么问题。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "81/TALK",
            "narrator": "ガブリエラ",
            "text": "本人に聞いた\nわけじゃないけど。",
            "zh": "虽然不是听她本人\n亲口说的就是了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "82/TALK",
            "narrator": "アーヤ",
            "text": "……そう。",
            "zh": "……这样啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "84/TALK",
            "narrator": "アーヤ",
            "text": "音羽は必ず\n連れて行く。",
            "zh": "一定要把音羽\n一起带走。",
            "narrator_zh": "绫水"
        },
        {
            "location": "85/TALK",
            "narrator": "アーヤ",
            "text": "つばめったら\n何をしているの…？\nまさか……もう…。",
            "zh": "燕这孩子\n到底在干什么啊……？\n难道说……已经……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "86/SEL",
            "narrator": "",
            "text": "アーヤってば",
            "zh": "我说绫水",
            "narrator_zh": ""
        },
        {
            "location": "87/ACT",
            "narrator": "",
            "text": "アーヤってば",
            "zh": "我说绫水",
            "narrator_zh": ""
        },
        {
            "location": "102/TALK",
            "narrator": "プレイヤー",
            "text": "アーヤってば",
            "zh": "我说绫水",
            "narrator_zh": "玩家"
        },
        {
            "location": "104/TALK",
            "narrator": "アーヤ",
            "text": "何？",
            "zh": "什么事？",
            "narrator_zh": "绫水"
        },
        {
            "location": "107/SEL",
            "narrator": "",
            "text": "つばめを待ってるの？",
            "zh": "你在等燕吗？",
            "narrator_zh": ""
        },
        {
            "location": "108/SEL",
            "narrator": "",
            "text": "ガブリエラに探しに行かせれば？",
            "zh": "让加布里埃拉去找不就好了？",
            "narrator_zh": ""
        },
        {
            "location": "109/SEL",
            "narrator": "",
            "text": "みやびは心配してないの？",
            "zh": "不担心雅吗？",
            "narrator_zh": ""
        },
        {
            "location": "110/ACT",
            "narrator": "",
            "text": "つばめを待ってるの？",
            "zh": "你在等燕吗？",
            "narrator_zh": ""
        },
        {
            "location": "111/TALK",
            "narrator": "アーヤ",
            "text": "そうよ",
            "zh": "是啊",
            "narrator_zh": "绫水"
        },
        {
            "location": "112/ACT",
            "narrator": "",
            "text": "ガブリエラに探しに行かせれば？",
            "zh": "让加布里埃拉去找不就好了？",
            "narrator_zh": ""
        },
        {
            "location": "113/TALK",
            "narrator": "アーヤ",
            "text": "危険すぎるわ",
            "zh": "太危险了",
            "narrator_zh": "绫水"
        },
        {
            "location": "114/ACT",
            "narrator": "",
            "text": "みやびは心配してないの？",
            "zh": "不担心雅吗？",
            "narrator_zh": ""
        },
        {
            "location": "115/TALK",
            "narrator": "アーヤ",
            "text": "してないわけないでしょ",
            "zh": "怎么可能不担心",
            "narrator_zh": "绫水"
        },
        {
            "location": "117/TALK",
            "narrator": "アーヤ",
            "text": "つばめ",
            "zh": "你觉得",
            "narrator_zh": "绫水"
        },
        {
            "location": "118/TALK",
            "narrator": "アーヤ",
            "text": "探しに行った方がいいと思う？",
            "zh": "还是去找燕比较好吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "119/SEL",
            "narrator": "",
            "text": "むしろ、早く離れた方がいいんじゃない？",
            "zh": "倒不如说，早点离开这里不是更好吗？",
            "narrator_zh": ""
        },
        {
            "location": "120/SEL",
            "narrator": "",
            "text": "いや、ここで待っていた方がいいよ",
            "zh": "不，还是在这里等比较好哦",
            "narrator_zh": ""
        },
        {
            "location": "121/ACT",
            "narrator": "",
            "text": "探しに行った方がいいと思う",
            "zh": "我觉得去找比较好",
            "narrator_zh": ""
        },
        {
            "location": "123/TALK",
            "narrator": "アーヤ",
            "text": "やっぱそうよね",
            "zh": "果然还是这样对吧",
            "narrator_zh": "绫水"
        },
        {
            "location": "124/TALK",
            "narrator": "アーヤ",
            "text": "ありがと",
            "zh": "谢谢",
            "narrator_zh": "绫水"
        },
        {
            "location": "125/ACT",
            "narrator": "",
            "text": "さすがチームメイト想いのリーダーだね",
            "zh": "不愧是替队友着想的领队呢",
            "narrator_zh": ""
        },
        {
            "location": "126/TALK",
            "narrator": "アーヤ",
            "text": "そんなの",
            "zh": "这种事",
            "narrator_zh": "绫水"
        },
        {
            "location": "127/TALK",
            "narrator": "アーヤ",
            "text": "普通よ",
            "zh": "很正常吧",
            "narrator_zh": "绫水"
        },
        {
            "location": "139/TALK",
            "narrator": "アーヤ",
            "text": "…つばめ…。",
            "zh": "……燕……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "141/TALK",
            "narrator": "アーヤ",
            "text": "ねえギャヴィ。",
            "zh": "我说，加维。",
            "narrator_zh": "绫水"
        },
        {
            "location": "142/TALK",
            "narrator": "ガブリエラ",
            "text": "何？",
            "zh": "怎么了？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "143/TALK",
            "narrator": "アーヤ",
            "text": "あなたはここに\nいてくれる？",
            "zh": "你能留在这里\n等着吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "144/TALK",
            "narrator": "アーヤ",
            "text": "私はつばめを\n探しに行ってくるわ。",
            "zh": "我去把燕\n找回来。",
            "narrator_zh": "绫水"
        },
        {
            "location": "146/TALK",
            "narrator": "ガブリエラ",
            "text": "えっ！？",
            "zh": "哎！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "147/SEL",
            "narrator": "",
            "text": "ちょっと待って！",
            "zh": "等一下！",
            "narrator_zh": ""
        },
        {
            "location": "148/SEL",
            "narrator": "",
            "text": "今バグってた",
            "zh": "刚才出Bug了",
            "narrator_zh": ""
        },
        {
            "location": "149/SEL",
            "narrator": "",
            "text": "なんかおかしいんだけど",
            "zh": "总觉得哪里怪怪的",
            "narrator_zh": ""
        },
        {
            "location": "150/SEL",
            "narrator": "",
            "text": "それがいいと思う",
            "zh": "我觉得这样挺好",
            "narrator_zh": ""
        },
        {
            "location": "151/ACT",
            "narrator": "",
            "text": "それがいいと思う",
            "zh": "我觉得这样挺好",
            "narrator_zh": ""
        },
        {
            "location": "152/ACT",
            "narrator": "",
            "text": "それがいいと思う",
            "zh": "我觉得这样挺好",
            "narrator_zh": ""
        },
        {
            "location": "153/ACT",
            "narrator": "",
            "text": "それがいいと思う",
            "zh": "我觉得这样挺好",
            "narrator_zh": ""
        },
        {
            "location": "154/ACT",
            "narrator": "",
            "text": "それがいいと思う",
            "zh": "我觉得这样挺好",
            "narrator_zh": ""
        },
        {
            "location": "169/TALK",
            "narrator": "プレイヤー",
            "text": "それがいいと思う",
            "zh": "我觉得这样挺好",
            "narrator_zh": "玩家"
        },
        {
            "location": "171/SEL",
            "narrator": "",
            "text": "そんなこと言ってないし",
            "zh": "我才没说过这种话",
            "narrator_zh": ""
        },
        {
            "location": "172/SEL",
            "narrator": "",
            "text": "何これ！？",
            "zh": "这什么啊！？",
            "narrator_zh": ""
        },
        {
            "location": "173/SEL",
            "narrator": "",
            "text": "どうなってるの？",
            "zh": "这是怎么回事？",
            "narrator_zh": ""
        },
        {
            "location": "174/SEL",
            "narrator": "",
            "text": "武運を祈る",
            "zh": "祝你武运昌隆",
            "narrator_zh": ""
        },
        {
            "location": "175/ACT",
            "narrator": "",
            "text": "武運を祈る",
            "zh": "祝你武运昌隆",
            "narrator_zh": ""
        },
        {
            "location": "176/ACT",
            "narrator": "",
            "text": "武運を祈る",
            "zh": "祝你武运昌隆",
            "narrator_zh": ""
        },
        {
            "location": "177/ACT",
            "narrator": "",
            "text": "武運を祈る",
            "zh": "祝你武运昌隆",
            "narrator_zh": ""
        },
        {
            "location": "178/ACT",
            "narrator": "",
            "text": "武運を祈る",
            "zh": "祝你武运昌隆",
            "narrator_zh": ""
        },
        {
            "location": "180/TALK",
            "narrator": "アーヤ",
            "text": "そうね",
            "zh": "是啊",
            "narrator_zh": "绫水"
        },
        {
            "location": "181/TALK",
            "narrator": "アーヤ",
            "text": "祈ってて",
            "zh": "替我祈祷吧",
            "narrator_zh": "绫水"
        },
        {
            "location": "192/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィは絶対に\nここにいてね。",
            "zh": "加维你绝对要\n留在这里哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "193/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょっと待って！\nさっきと言うことが\n矛盾してるわよ！？",
            "zh": "等一下！\n这跟刚才说的话\n自相矛盾了吧！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "194/TALK",
            "narrator": "アーヤ",
            "text": "…してないわ。",
            "zh": "……没有矛盾。",
            "narrator_zh": "绫水"
        },
        {
            "location": "195/TALK",
            "narrator": "アーヤ",
            "text": "ここはまだ安全だから\nギャヴィにはここに\nいてほしい。",
            "zh": "这里还算安全，\n我希望加维\n能留在这里。",
            "narrator_zh": "绫水"
        },
        {
            "location": "196/TALK",
            "narrator": "アーヤ",
            "text": "劇場はとても危険。\nだからギャヴィには\n行かせられない。",
            "zh": "剧场非常危险。\n所以我不能让加维\n过去。",
            "narrator_zh": "绫水"
        },
        {
            "location": "198/TALK",
            "narrator": "アーヤ",
            "text": "でもつばめも\n私にとっては\n妹みたいなもの。",
            "zh": "但是燕对我来说，\n也像是妹妹一样\n的存在。",
            "narrator_zh": "绫水"
        },
        {
            "location": "199/TALK",
            "narrator": "アーヤ",
            "text": "だから私が\n劇場に行くの。",
            "zh": "所以我要\n回剧场去。",
            "narrator_zh": "绫水"
        },
        {
            "location": "200/TALK",
            "narrator": "ガブリエラ",
            "text": "だからそれなら\nあたしが…！",
            "zh": "所以我才说，\n既然这样那就由我……！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "201/TALK",
            "narrator": "アーヤ",
            "text": "ねえギャヴィ。",
            "zh": "我说，加维。",
            "narrator_zh": "绫水"
        },
        {
            "location": "202/TALK",
            "narrator": "アーヤ",
            "text": "本気にして\nもらえないかも\nしれないけど。",
            "zh": "也许你不会\n把我的话\n当真就是了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "203/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィのことは\nかわいくて生意気な\n本当の妹だと思ってる。",
            "zh": "我一直把加维\n当成可爱又有点傲气的\n亲妹妹看待。",
            "narrator_zh": "绫水"
        },
        {
            "location": "204/TALK",
            "narrator": "ガブリエラ",
            "text": "…え…。",
            "zh": "……哎……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "205/TALK",
            "narrator": "アーヤ",
            "text": "末っ子だった私に\nかわいい妹が\nできた喜びがわかる？",
            "zh": "你能明白一直作为老小的我\n突然有了一个可爱妹妹时的\n那种喜悦吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "206/TALK",
            "narrator": "ガブリエラ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "207/TALK",
            "narrator": "アーヤ",
            "text": "何もかもかわいくて\nお姉ちゃんはずるいって\n何度も思ったわ。",
            "zh": "一举一动都那么可爱，\n让我无数次觉得\n做姐姐真是太好了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "208/TALK",
            "narrator": "ガブリエラ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "209/TALK",
            "narrator": "アーヤ",
            "text": "だからね、ギャヴィ。",
            "zh": "所以啊，加维。",
            "narrator_zh": "绫水"
        },
        {
            "location": "210/TALK",
            "narrator": "アーヤ",
            "text": "姉として妹には\n危険な目に\n遭って欲しくないの。",
            "zh": "作为姐姐，\n我不希望妹妹\n去涉险。",
            "narrator_zh": "绫水"
        },
        {
            "location": "211/TALK",
            "narrator": "アーヤ",
            "text": "だからここにいて。",
            "zh": "所以留在这里。",
