{
    "dir": "chap16/daydra/anime_05_16.js",
    "type": "MainStory",
    "info": {
        "story_id": "16501",
        "cid": "kagura",
        "title": "001 アニメーション",
        "sub_title": "ピクルス",
        "title_zh": "001 动画",
        "sub_title_zh": "酸黄瓜"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "アニメ第16話",
            "zh": "动画第16话",
            "narrator_zh": ""
        },
        {
            "location": "20/TALK",
            "narrator": "エリカ",
            "text": "コーンコン。",
            "zh": "空——空。",
            "narrator_zh": "领火"
        },
        {
            "location": "21/TALK",
            "narrator": "エリカ",
            "text": "いらっしゃい\n$handle$さん。",
            "zh": "欢迎过来，\n$handle$。",
            "narrator_zh": "领火"
        },
        {
            "location": "22/TALK",
            "narrator": "エリカ",
            "text": "もう一度お話聞く？\nそれとも、省略する？",
            "zh": "要再听一遍吗？\n还是说，跳过呢？",
            "narrator_zh": "领火"
        },
        {
            "location": "23/SEL",
            "narrator": "",
            "text": "もう一度聞く",
            "zh": "再听一遍",
            "narrator_zh": ""
        },
        {
            "location": "24/SEL",
            "narrator": "",
            "text": "飛ばす",
            "zh": "跳过",
            "narrator_zh": ""
        },
        {
            "location": "25/ACT",
            "narrator": "",
            "text": "もう一度聞く",
            "zh": "再听一遍",
            "narrator_zh": ""
        },
        {
            "location": "26/TALK",
            "narrator": "エリカ",
            "text": "うん、わかったよ。",
            "zh": "嗯，我知道了。",
            "narrator_zh": "领火"
        },
        {
            "location": "28/ACT",
            "narrator": "",
            "text": "飛ばす",
            "zh": "跳过",
            "narrator_zh": ""
        },
        {
            "location": "29/TALK",
            "narrator": "エリカ",
            "text": "そっかー。\nそれじゃ、またね。",
            "zh": "这样啊——。\n那拜拜啦。",
            "narrator_zh": "领火"
        },
        {
            "location": "36/TALK",
            "narrator": "エリカ",
            "text": "コーンコン。",
            "zh": "空——空。",
            "narrator_zh": "领火"
        },
        {
            "location": "37/TALK",
            "narrator": "エリカ",
            "text": "こんにちは、\n$handle$さん。",
            "zh": "你好呀，\n$handle$。",
            "narrator_zh": "领火"
        },
        {
            "location": "38/TALK",
            "narrator": "エリカ",
            "text": "前回はリプレイス1回目\n試験運用に参加してくれて\nありがとう。",
            "zh": "上次谢谢你参与\n替换第1次的\n试验运行。",
            "narrator_zh": "领火"
        },
        {
            "location": "39/TALK",
            "narrator": "エリカ",
            "text": "お陰様で、今のところ\n特に問題は無さそうだよ。",
            "zh": "托你的福，目前为止\n看起来没什么特别的问题哦。",
            "narrator_zh": "领火"
        },
        {
            "location": "40/TALK",
            "narrator": "エリカ",
            "text": "あと数エピソード分の\n様子を見て問題なければ、\n本番に入ろうと思うの。",
            "zh": "再观察几话看看，\n如果没问题的话，\n就打算进入正式阶段了。",
            "narrator_zh": "领火"
        },
        {
            "location": "41/TALK",
            "narrator": "エリカ",
            "text": "時期的にもそろそろ\nターゲットに入ってくる\nみたいだからね。",
            "zh": "因为从时间点来看，\n也差不多快要进入\n目标范围了嘛。",
            "narrator_zh": "领火"
        },
        {
            "location": "42/SEL",
            "narrator": "",
            "text": "それは千羽鶴の言葉？",
            "zh": "那是千羽鹤的话吗？",
            "narrator_zh": ""
        },
        {
            "location": "43/SEL",
            "narrator": "",
            "text": "本番はお試しと何か違うの？",
            "zh": "正式阶段和试运行有什么不同吗？",
            "narrator_zh": ""
        },
        {
            "location": "44/ACT",
            "narrator": "",
            "text": "それは千羽鶴の言葉？",
            "zh": "那是千羽鹤的话吗？",
            "narrator_zh": ""
        },
        {
            "location": "45/TALK",
            "narrator": "エリカ",
            "text": "うん、そうだよ。",
            "zh": "嗯，是啊。",
            "narrator_zh": "领火"
        },
        {
            "location": "46/ACT",
            "narrator": "",
            "text": "本番はお試しと何か違うの？",
            "zh": "正式阶段和试运行有什么不同吗？",
            "narrator_zh": ""
        },
        {
            "location": "47/TALK",
            "narrator": "エリカ",
            "text": "やることは\n殆ど同じだよ。",
            "zh": "要做的事情\n几乎是一样的哦。",
            "narrator_zh": "领火"
        },
        {
            "location": "48/TALK",
            "narrator": "エリカ",
            "text": "あなたが誰かに対して\n一押しすることで、\n僅かに軸をずらす。",
            "zh": "由你对着某个人\n轻推一把，让轴线\n稍微偏移一点。",
            "narrator_zh": "领火"
        },
        {
            "location": "49/TALK",
            "narrator": "エリカ",
            "text": "そのずらし方次第で、\n上手くいったり\nいかなかったり――",
            "zh": "视那个偏移的方式，\n可能会顺利，\n也可能不顺利——",
            "narrator_zh": "领火"
        },
        {
            "location": "50/TALK",
            "narrator": "エリカ",
            "text": "そんな感じかな。",
            "zh": "大概就是那种感觉吧。",
            "narrator_zh": "领火"
        },
        {
            "location": "52/TALK",
            "narrator": "エリカ",
            "text": "今のところ、\n外の世界からの侵入も\n検知されてないし――",
            "zh": "到目前为止，\n来自外界的入侵\n也没有检测到——",
            "narrator_zh": "领火"
        },
        {
            "location": "53/TALK",
            "narrator": "エリカ",
            "text": "ちょっと怖いくらい\n順風満帆だね。",
            "zh": "顺利得都有点\n让人害怕了呢。",
            "narrator_zh": "领火"
        },
        {
            "location": "54/SEL",
            "narrator": "",
            "text": "上手くいってるうちにできる限り事を進めよう",
            "zh": "趁着还顺利，尽量把能推进的事推进下去吧",
            "narrator_zh": ""
        },
        {
            "location": "55/SEL",
            "narrator": "",
            "text": "外の世界からの侵入が無い件だけど",
            "zh": "关于没有来自外界的入侵这件事",
            "narrator_zh": ""
        },
        {
            "location": "56/ACT",
            "narrator": "",
            "text": "上手くいってるうちにできる限り事を進めよう",
            "zh": "趁着还顺利，尽量把能推进的事推进下去吧",
            "narrator_zh": ""
        },
        {
            "location": "57/TALK",
            "narrator": "エリカ",
            "text": "そうだね！",
            "zh": "说得也是！",
            "narrator_zh": "领火"
        },
        {
            "location": "58/ACT",
            "narrator": "",
            "text": "外の世界からの侵入が無い件だけど",
            "zh": "关于没有来自外界的入侵这件事",
            "narrator_zh": ""
        },
        {
            "location": "59/TALK",
            "narrator": "エリカ",
            "text": "どうしたの？",
            "zh": "怎么了？",
            "narrator_zh": "领火"
        },
        {
            "location": "60/SEL",
            "narrator": "",
            "text": "元々はどこかで侵入してきていたってことは、今回も必ず侵入してくるんだよね？",
            "zh": "原本既然在某个节点入侵过，那这次也一定会入侵进来的吧？",
            "narrator_zh": ""
        },
        {
            "location": "61/SEL",
            "narrator": "",
            "text": "今回は侵入してこないんじゃないの？",
            "zh": "这次是不是不会入侵过来了？",
            "narrator_zh": ""
        },
        {
            "location": "62/ACT",
            "narrator": "",
            "text": "元々はどこかで侵入してきていたってことは、今回も必ず侵入してくるんだよね？",
            "zh": "原本既然在某个节点入侵过，那这次也一定会入侵进来的吧？",
            "narrator_zh": ""
        },
        {
            "location": "63/TALK",
            "narrator": "エリカ",
            "text": "理論上はそうだね。",
            "zh": "理论上来说是这样呢。",
            "narrator_zh": "领火"
        },
        {
            "location": "64/TALK",
            "narrator": "エリカ",
            "text": "外の現実世界自体の\nリプレイスをすることは\n実質不可能。",
            "zh": "对外部的现实世界本身\n进行替换，\n实质上是不可能的。",
            "narrator_zh": "领火"
        },
        {
            "location": "65/TALK",
            "narrator": "エリカ",
            "text": "ということは、もし\n違和感を感じるとしても、\nそれは一度試行してから。",
            "zh": "也就是说，就算对方\n感到违和，那也是在\n先尝试过一次之后。",
            "narrator_zh": "领火"
        },
        {
            "location": "66/TALK",
            "narrator": "エリカ",
            "text": "必ず一度は\n侵入を試みると断言しても\nいいと思う。",
            "zh": "我觉得甚至可以断言，\n他们一定会至少尝试\n入侵一次。",
            "narrator_zh": "领火"
        },
        {
            "location": "67/ACT",
            "narrator": "",
            "text": "今回は侵入してこないんじゃないの？",
            "zh": "这次是不是不会入侵过来了？",
            "narrator_zh": ""
        },
        {
            "location": "68/TALK",
            "narrator": "エリカ",
            "text": "え？\nどうして？",
            "zh": "咦？\n为什么？",
            "narrator_zh": "领火"
        },
        {
            "location": "69/SEL",
            "narrator": "",
            "text": "えっと、何となく",
            "zh": "那个，总觉得",
            "narrator_zh": ""
        },
        {
            "location": "70/SEL",
            "narrator": "",
            "text": "神楽が同化してるわけでしょ？",
            "zh": "神乐不是正在同化吗？",
            "narrator_zh": ""
        },
        {
            "location": "71/ACT",
            "narrator": "",
            "text": "えっと、何となく",
            "zh": "那个，总觉得",
            "narrator_zh": ""
        },
        {
            "location": "72/TALK",
            "narrator": "エリカ",
            "text": "もー。\n適当なことを\n言わないでね？",
            "zh": "真是的——。\n不要随便\n乱说啦？",
            "narrator_zh": "领火"
        },
        {
            "location": "73/ACT",
            "narrator": "",
            "text": "神楽が同化してるわけでしょ？",
            "zh": "神乐不是正在同化吗？",
            "narrator_zh": ""
        },
        {
            "location": "74/TALK",
            "narrator": "エリカ",
            "text": "うん、そうだね。",
            "zh": "嗯，是这样没错。",
            "narrator_zh": "领火"
        },
        {
            "location": "75/SEL",
            "narrator": "",
            "text": "原因は何だと言ってたっけ？",
            "zh": "当时说过的原因是什么来着？",
            "narrator_zh": ""
        },
        {
            "location": "76/ACT",
            "narrator": "",
            "text": "原因は何だと言ってたっけ？",
            "zh": "当时说过的原因是什么来着？",
            "narrator_zh": ""
        },
        {
            "location": "78/TALK",
            "narrator": "エリカ",
            "text": "つばめちゃんの世界を\n経由して、外に繋いでる\nわけだけど――",
            "zh": "本来是经由燕的世界\n连接到外面的\n来着——",
            "narrator_zh": "领火"
        },
        {
            "location": "79/TALK",
            "narrator": "エリカ",
            "text": "それが外されちゃって、\n外の世界とは\n繋がってないかも……",
            "zh": "但那条线被拔掉了，\n说不定已经没和外面的\n世界连在一起了……",
            "narrator_zh": "领火"
        },
        {
            "location": "80/TALK",
            "narrator": "エリカ",
            "text": "あ――",
            "zh": "啊——",
            "narrator_zh": "领火"
        },
        {
            "location": "81/SEL",
            "narrator": "",
            "text": "それって、どんな形で切断されてるのかな。外からはどう見える？",
            "zh": "那是以什么样的形式被切断的呢。从外面看来会是什么样？",
            "narrator_zh": ""
        },
        {
            "location": "82/ACT",
            "narrator": "",
            "text": "それって、どんな形で切断されてるのかな。外からはどう見える？",
            "zh": "那是以什么样的形式被切断的呢。从外面看来会是什么样？",
            "narrator_zh": ""
        },
        {
            "location": "84/TALK",
            "narrator": "エリカ",
            "text": "うーん……\n仮説は色々\n立てられるけど――",
            "zh": "唔——……\n假说倒是可以\n提出好几种——",
            "narrator_zh": "领火"
        },
        {
            "location": "85/TALK",
            "narrator": "エリカ",
            "text": "最も小規模なものだと、\n神楽ちゃんのRedinessを\n個別に切断してる仮説。",
            "zh": "规模最小的一种假说，\n是神乐的Rediness\n被个别切断了。",
            "narrator_zh": "领火"
        },
        {
            "location": "86/TALK",
            "narrator": "エリカ",
            "text": "この場合、中と外との\n関係性は変わらないから、\n外からの侵入は可能。",
            "zh": "这种情况下，里外的\n关系性没有改变，\n从外面还是可以入侵的。",
            "narrator_zh": "领火"
        },
        {
            "location": "87/TALK",
            "narrator": "エリカ",
            "text": "そして、\n最も大規模なものだと――",
            "zh": "而如果是最为\n大规模的假说——",
            "narrator_zh": "领火"
        },
        {
            "location": "88/TALK",
            "narrator": "エリカ",
            "text": "つばめちゃんの世界が\n元の世界から、完全に\n切り離された仮説。",
            "zh": "就是燕的世界\n从原本的世界里，\n被彻底切离出去了。",
            "narrator_zh": "领火"
        },
        {
            "location": "89/SEL",
            "narrator": "",
            "text": "それって要するに日本の外には世界が無いってこと？",
            "zh": "那岂不是等于日本外面就没有世界了？",
            "narrator_zh": ""
        },
        {
            "location": "90/SEL",
            "narrator": "",
            "text": "なにそれまた新しい設定クルー？",
            "zh": "什么鬼那又是新设定来啦？",
            "narrator_zh": ""
        },
        {
            "location": "91/ACT",
            "narrator": "",
            "text": "それって要するに日本の外には世界が無いってこと？",
            "zh": "那岂不是等于日本外面就没有世界了？",
            "narrator_zh": ""
        },
        {
            "location": "92/TALK",
            "narrator": "エリカ",
            "text": "厳密にはあるけど、\nそれはわたしたちが\n住んでいた世界じゃない。",
            "zh": "严格来说还是有的，\n但那已经不是我们\n原本居住的世界了。",
            "narrator_zh": "领火"
        },
        {
            "location": "93/TALK",
            "narrator": "エリカ",
            "text": "――のかもしれない、\nという仮説だよ。",
            "zh": "——说不定是这样，\n只是个假说啦。",
            "narrator_zh": "领火"
        },
        {
            "location": "94/ACT",
            "narrator": "",
            "text": "なにそれまた新しい設定クルー？",
            "zh": "什么鬼那又是新设定来啦？",
            "narrator_zh": ""
        },
        {
            "location": "95/TALK",
            "narrator": "エリカ",
            "text": "設定？",
            "zh": "设定？",
            "narrator_zh": "领火"
        },
        {
            "location": "96/TALK",
            "narrator": "エリカ",
            "text": "まあ確かに、にわかに\n信じられないかも\nしれないけど――",
            "zh": "嘛确实，可能一时间\n让人难以置信\n吧——",
            "narrator_zh": "领火"
        },
        {
            "location": "98/TALK",
            "narrator": "エリカ",
            "text": "一応、ちゃんとした理屈は\nあるから、わたしの\n妄想とかじゃないよ？",
            "zh": "不过好歹是有正经\n理论依据的，并不是\n我的妄想之类的哦？",
            "narrator_zh": "领火"
        },
        {
            "location": "99/TALK",
            "narrator": "エリカ",
            "text": "そもそも、フェノメノンの\n中と外って、本来何の\n繋がりも無い２つなの。",
            "zh": "说到底，PhenoMENON的\n里面和外面，本来就是\n毫无关联的两个存在。",
            "narrator_zh": "领火"
        },
        {
            "location": "100/TALK",
            "narrator": "エリカ",
            "text": "それを辛うじて\n繋いでるのは――",
            "zh": "好不容易把它们\n连在一起的——",
            "narrator_zh": "领火"
        },
        {
            "location": "101/TALK",
            "narrator": "エリカ",
            "text": "ついさっきまで一つの\n世界に共存していた、\nという、量子の持つ記憶。",
            "zh": "是直到刚才为止还\n共存于同一个世界里的\n量子所拥有的记忆。",
            "narrator_zh": "领火"
        },
        {
            "location": "102/TALK",
            "narrator": "エリカ",
            "text": "すなわち、\nエンタングルの\nお陰なんだよ。",
            "zh": "也就是说，\n多亏了\n纠缠哦。",
            "narrator_zh": "领火"
        },
        {
            "location": "103/SEL",
            "narrator": "",
            "text": "なるほど",
            "zh": "原来如此",
            "narrator_zh": ""
        },
        {
            "location": "104/SEL",
            "narrator": "",
            "text": "企業？？？",
            "zh": "企业？？？",
            "narrator_zh": ""
        },
        {
            "location": "105/ACT",
            "narrator": "",
            "text": "なるほど",
            "zh": "原来如此",
            "narrator_zh": ""
        },
        {
            "location": "106/ACT",
            "narrator": "",
            "text": "企業？？？",
            "zh": "企业？？？",
            "narrator_zh": ""
        },
        {
            "location": "107/TALK",
            "narrator": "エリカ",
            "text": "あ、ここで言う\nエンタングルは、\n物理用語の方ね。",
            "zh": "啊，这里说的\n纠缠，\n是物理学术语啦。",
            "narrator_zh": "领火"
        },
        {
            "location": "108/TALK",
            "narrator": "エリカ",
            "text": "量子もつれのこと。",
            "zh": "指的是量子纠缠。",
            "narrator_zh": "领火"
        },
        {
            "location": "110/TALK",
            "narrator": "エリカ",
            "text": "エンタングルは、その\nもつれ方の規則性によって\n世界の相対位置を定義する",
            "zh": "纠缠会通过其\n纠缠方式的规律性，\n定义世界的相对位置。",
            "narrator_zh": "领火"
        },
        {
            "location": "111/TALK",
            "narrator": "エリカ",
            "text": "時間、空間、重力、\nその他様々な次元の形状は\nエンタングルで決まる。",
            "zh": "时间、空间、重力、\n以及其他各种维度的形状\n都是由纠缠决定的。",
            "narrator_zh": "领火"
        },
        {
            "location": "112/TALK",
            "narrator": "エリカ",
            "text": "だからその規則性が、\n意図的に破壊されれば――",
            "zh": "所以如果那种规律性\n被刻意破坏了的话——",
            "narrator_zh": "领火"
        },
        {
            "location": "113/TALK",
            "narrator": "エリカ",
            "text": "別々になってしまった\n世界は、その戻り先を\n見失ってしまう。",
            "zh": "已经分隔开来的\n世界，就会迷失\n原本该回去的地方。",
            "narrator_zh": "领火"
        },
        {
            "location": "114/SEL",
            "narrator": "",
            "text": "ラッキーじゃん",
            "zh": "那不是走运嘛",
            "narrator_zh": ""
        },
        {
            "location": "115/SEL",
            "narrator": "",
            "text": "ヤバイじゃん",
            "zh": "那不是糟透了嘛",
            "narrator_zh": ""
        },
        {
            "location": "116/ACT",
            "narrator": "",
            "text": "ラッキーじゃん",
            "zh": "那不是走运嘛",
            "narrator_zh": ""
        },
        {
            "location": "117/TALK",
            "narrator": "エリカ",
            "text": "見方によっては\nそういう面も\nあるのかもしれない。",
            "zh": "从某种角度看，\n或许也有那样的一面\n吧。",
            "narrator_zh": "领火"
        },
        {
            "location": "118/TALK",
            "narrator": "エリカ",
            "text": "けど、多分\n失うものの方が\n多いとは思う。",
            "zh": "不过，我觉得大概\n失去的东西会比得到的\n更多哦。",
            "narrator_zh": "领火"
        },
        {
            "location": "119/ACT",
            "narrator": "",
            "text": "ヤバイじゃん",
            "zh": "那不是糟透了嘛",
            "narrator_zh": ""
        },
        {
            "location": "120/TALK",
            "narrator": "エリカ",
            "text": "そうだね。",
            "zh": "是啊。",
            "narrator_zh": "领火"
        },
        {
            "location": "122/TALK",
            "narrator": "エリカ",
            "text": "あ、でもこれはもちろん、\nあくまで科学者としての\n仮説だから。",
            "zh": "啊，不过这当然\n只是作为科学家的\n假说而已。",
            "narrator_zh": "领火"
        },
        {
            "location": "123/TALK",
            "narrator": "エリカ",
            "text": "実際に今、\nそうなってるっていう\nわけじゃないよ。",
            "zh": "并不是说现在\n实际上就已经变成\n那样了哦。",
            "narrator_zh": "领火"
        },
        {
            "location": "124/TALK",
            "narrator": "エリカ",
            "text": "むしろそんなことに\nなってる可能性は、\nかなり少ないと思う。",
            "zh": "倒不如说，变成那样的\n可能性我觉得是\n相当低的。",
            "narrator_zh": "领火"
        },
        {
            "location": "129/SEL",
            "narrator": "",
            "text": "それで、同化に関しては何か原因わかったの？",
            "zh": "那么，关于同化，查出什么原因了吗？",
            "narrator_zh": ""
        },
        {
            "location": "130/ACT",
            "narrator": "",
            "text": "それで、同化に関しては何か原因わかったの？",
            "zh": "那么，关于同化，查出什么原因了吗？",
            "narrator_zh": ""
        },
        {
            "location": "132/TALK",
            "narrator": "エリカ",
            "text": "残念ながら\nまだかな。",
            "zh": "遗憾的是\n还没呢。",
            "narrator_zh": "领火"
        },
        {
            "location": "133/TALK",
            "narrator": "エリカ",
            "text": "$handle$さんの\n方は、何か変わったこと\nとかあった？",
            "zh": "$handle$那边\n有没有遇到什么\n奇怪的事？",
            "narrator_zh": "领火"
        },
        {
            "location": "134/SEL",
            "narrator": "",
            "text": "特にない",
            "zh": "没什么特别的",
            "narrator_zh": ""
        },
        {
            "location": "135/SEL",
            "narrator": "",
            "text": "共通意識野に行ったら、同化した方が良いのだという声が聞こえた",
            "zh": "去了共通意识野，结果听到了说还是同化了比较好的声音",
            "narrator_zh": ""
        },
        {
            "location": "136/ACT",
            "narrator": "",
            "text": "特にない",
            "zh": "没什么特别的",
            "narrator_zh": ""
        },
        {
            "location": "137/TALK",
            "narrator": "エリカ",
            "text": "そっか。",
            "zh": "这样啊。",
            "narrator_zh": "领火"
        },
        {
            "location": "138/ACT",
            "narrator": "",
            "text": "共通意識野に行ったら、同化した方が良いのだという声が聞こえた",
            "zh": "去了共通意识野，结果听到了说还是同化了比较好的声音",
            "narrator_zh": ""
        },
        {
            "location": "139/TALK",
            "narrator": "エリカ",
            "text": "えっ！？\n何それ…。",
            "zh": "咦！？\n什么情况……。",
            "narrator_zh": "领火"
        },
        {
            "location": "140/TALK",
            "narrator": "エリカ",
            "text": "誰なの？",
            "zh": "是谁呀？",
            "narrator_zh": "领火"
        },
        {
            "location": "141/SEL",
            "narrator": "",
            "text": "わからない",
            "zh": "不知道",
            "narrator_zh": ""
        },
        {
            "location": "142/SEL",
            "narrator": "",
            "text": "神楽じゃない？",
            "zh": "难道是神乐？",
            "narrator_zh": ""
        },
        {
            "location": "143/SEL",
            "narrator": "",
            "text": "つばめじゃない？",
            "zh": "难道是燕？",
            "narrator_zh": ""
        },
        {
            "location": "144/SEL",
            "narrator": "",
            "text": "エリカじゃない？",
            "zh": "难道是领火？",
            "narrator_zh": ""
        },
        {
            "location": "145/SEL",
            "narrator": "",
            "text": "千羽鶴じゃない？",
            "zh": "难道是千羽鹤？",
            "narrator_zh": ""
        },
        {
            "location": "146/ACT",
            "narrator": "",
            "text": "わからない",
            "zh": "不知道",
            "narrator_zh": ""
        },
        {
            "location": "148/TALK",
            "narrator": "エリカ",
            "text": "だよねー…。",
            "zh": "也是呢……。",
            "narrator_zh": "领火"
        },
        {
            "location": "149/ACT",
            "narrator": "",
            "text": "神楽じゃない？",
            "zh": "难道是神乐？",
            "narrator_zh": ""
        },
        {
            "location": "151/TALK",
            "narrator": "エリカ",
            "text": "そうかなぁ。",
            "zh": "会是这样吗。",
            "narrator_zh": "领火"
        },
        {
            "location": "152/ACT",
            "narrator": "",
            "text": "つばめじゃない？",
            "zh": "难道是燕？",
            "narrator_zh": ""
        },
        {
            "location": "154/TALK",
            "narrator": "エリカ",
            "text": "つばめちゃん？\nうーん……",
            "zh": "燕？\n唔——……",
            "narrator_zh": "领火"
        },
        {
            "location": "155/ACT",
            "narrator": "",
            "text": "エリカじゃない？",
            "zh": "难道是领火？",
            "narrator_zh": ""
        },
        {
            "location": "157/TALK",
            "narrator": "エリカ",
            "text": "ええっ！？\nわたしじゃないよ？",
            "zh": "咦咦！？\n才不是我呀？",
            "narrator_zh": "领火"
        },
        {
            "location": "158/ACT",
            "narrator": "",
            "text": "千羽鶴じゃない？",
            "zh": "难道是千羽鹤？",
            "narrator_zh": ""
        },
        {
            "location": "160/TALK",
            "narrator": "エリカ",
            "text": "いや、それは……\n無いと思うけど……。",
            "zh": "不，这个……\n我觉得应该不是……。",
            "narrator_zh": "领火"
        },
        {
            "location": "162/TALK",
            "narrator": "エリカ",
            "text": "ちょっと今のわたしには\nわからないかも……。",
            "zh": "现在的我可能还\n搞不太明白……。",
            "narrator_zh": "领火"
        },
        {
            "location": "163/TALK",
            "narrator": "エリカ",
            "text": "わたしも調べてみて、\n何かわかったらすぐに\n教えるから。",
            "zh": "我也会再调查一下，\n一有发现就会\n立刻告诉你的。",
            "narrator_zh": "领火"
        },
        {
            "location": "164/TALK",
            "narrator": "エリカ",
            "text": "いつも全然\n役に立たなくて\nごめんね？",
            "zh": "总是完全派不上\n用场，\n对不起啦？",
            "narrator_zh": "领火"
        },
        {
            "location": "166/TALK",
            "narrator": "エリカ",
            "text": "今回わたしからの話は\nこれくらいかな。",
            "zh": "这次我要说的\n差不多就这些啦。",
            "narrator_zh": "领火"
        },
        {
            "location": "167/TALK",
            "narrator": "エリカ",
            "text": "最後に、\n記録映像を見ていく？",
            "zh": "最后，\n要看记录影像吗？",
            "narrator_zh": "领火"
        },
        {
            "location": "169/SEL",
            "narrator": "",
            "text": "映像を見る\n<color=green>【高画質/116MB 7:17】</color>",
            "zh": "观看影像\n<color=green>【高画质/116MB 7:17】</color>",
            "narrator_zh": ""
        },
        {
            "location": "170/SEL",
            "narrator": "",
            "text": "映像を見る\n<color=green>【標準画質/37MB 7:17】</color>",
            "zh": "观看影像\n<color=green>【标准画质/37MB 7:17】</color>",
            "narrator_zh": ""
        },
        {
            "location": "171/SEL",
            "narrator": "",
            "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>",
            "zh": "改为剧情梗概报告\n<color=green>【文字汇总】</color>",
            "narrator_zh": ""
        },
        {
            "location": "172/ACT",
            "narrator": "",
            "text": "映像を見る\n<color=green>【高画質/116MB 7:17】</color>",
            "zh": "观看影像\n<color=green>【高画质/116MB 7:17】</color>",
            "narrator_zh": ""
        },
        {
            "location": "173/TALK",
            "narrator": "エリカ",
            "text": "わかったよ。",
            "zh": "我知道了。",
            "narrator_zh": "领火"
        },
        {
            "location": "179/ACT",
            "narrator": "",
            "text": "映像を見る\n<color=green>【標準画質/37MB 7:17】</color>",
            "zh": "观看影像\n<color=green>【标准画质/37MB 7:17】</color>",
            "narrator_zh": ""
        },
        {
            "location": "180/TALK",
            "narrator": "エリカ",
            "text": "わかったよ。",
            "zh": "我知道了。",
            "narrator_zh": "领火"
        },
        {
            "location": "186/ACT",
            "narrator": "",
            "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>",
            "zh": "改为剧情梗概报告\n<color=green>【文字汇总】</color>",
            "narrator_zh": ""
        },
        {
            "location": "187/TALK",
            "narrator": "エリカ",
            "text": "あらら。",
            "zh": "哎呀呀。",
            "narrator_zh": "领火"
        },
        {
            "location": "220/TALK",
            "narrator": "エリカ",
            "text": "時期的には、\n神楽ちゃんにとっての\n重大事件があった日だね。",
            "zh": "从时间点来看，\n这一天正是对神乐来说\n发生重大事件的日子呢。",
            "narrator_zh": "领火"
        },
        {
            "location": "221/TALK",
            "narrator": "エリカ",
            "text": "この時期の神楽ちゃんは\nものすごい精神的に\n辛い時期だと思うから――",
            "zh": "这段时期的神乐\n在精神上应该是处于\n非常痛苦的时期——",
            "narrator_zh": "领火"
        },
        {
            "location": "222/TALK",
            "narrator": "エリカ",
            "text": "どうか、あなたの想いで\n神楽ちゃんを支えてあげて\nくださいね。",
            "zh": "请务必用你的心意\n去支撑起\n神乐哦。",
            "narrator_zh": "领火"
        },
        {
            "location": "223/SEL",
            "narrator": "",
            "text": "もちろん",
            "zh": "那是当然",
            "narrator_zh": ""
        },
        {
            "location": "224/SEL",
            "narrator": "",
            "text": "あんたにお願いされる筋合いはない",
            "zh": "轮不到你来求我",
            "narrator_zh": ""
        },
        {
            "location": "225/ACT",
            "narrator": "",
            "text": "もちろん",
            "zh": "那是当然",
            "narrator_zh": ""
        },
        {
            "location": "226/TALK",
            "narrator": "エリカ",
            "text": "よかった！",
            "zh": "太好了！",
            "narrator_zh": "领火"
        },
        {
            "location": "227/ACT",
            "narrator": "",
            "text": "あんたにお願いされる筋合いはない",
            "zh": "轮不到你来求我",
            "narrator_zh": ""
        },
        {
            "location": "228/TALK",
            "narrator": "エリカ",
            "text": "ごめんね…。",
            "zh": "对不起……。",
            "narrator_zh": "领火"
        },
        {
            "location": "230/TALK",
            "narrator": "エリカ",
            "text": "そうそう！",
            "zh": "对了对了！",
            "narrator_zh": "领火"
        },
        {
            "location": "231/TALK",
            "narrator": "エリカ",
            "text": "そういえば１つ、\nあなたに伝えておく\nことがあったんだ。",
            "zh": "说起来有1件事，\n我忘记告诉你\n了呢。",
            "narrator_zh": "领火"
        },
        {
            "location": "232/SEL",
            "narrator": "",
            "text": "なに？？",
            "zh": "什么事？？",
            "narrator_zh": ""
        },
        {
            "location": "233/ACT",
            "narrator": "",
            "text": "なに？？",
            "zh": "什么事？？",
            "narrator_zh": ""
        },
        {
            "location": "235/TALK",
            "narrator": "エリカ",
            "text": "前に、綾ちゃんたち\nみんなが使ってる\nスタンプを送ったでしょ？",
            "zh": "之前，我不是把\n绫水她们大家都在用的\n表情包发过去了嘛？",
            "narrator_zh": "领火"
        },
        {
            "location": "236/TALK",
            "narrator": "エリカ",
            "text": "でも、その時神楽ちゃんの\nスタンプは送ることが\n出来なくて……。",
            "zh": "不过那时候，神乐的\n表情包没能\n发过去……。",
            "narrator_zh": "领火"
        },
        {
            "location": "241/TALK",
            "narrator": "エリカ",
            "text": "それを今回は、\nやっと送ることが\nできたの！",
            "zh": "那些表情包这次，\n终于成功\n发过去了哦！",
            "narrator_zh": "领火"
        },
        {
            "location": "242/TALK",
            "narrator": "エリカ",
            "text": "遅くなっちゃって\nごめんね？",
            "zh": "弄得这么晚才发，\n对不起啦？",
            "narrator_zh": "领火"
        },
        {
            "location": "243/TALK",
            "narrator": "エリカ",
            "text": "でも、本当に神楽ちゃん\nらしい、面白いスタンプが\n沢山入ってるから。",
            "zh": "不过，里面真的有\n好多很有神乐风格的、\n很有趣的表情包呢。",
            "narrator_zh": "领火"
        },
        {
            "location": "244/TALK",
            "narrator": "エリカ",
            "text": "もしかしたらまだ\n見たことがないものも\nあるかもしれないけど――",
            "zh": "说不定里面也有\n你还没见过的\n款式呢——",
            "narrator_zh": "领火"
        },
        {
            "location": "245/TALK",
            "narrator": "エリカ",
            "text": "そっちに届いたら、\n是非使ってみて欲しいな！",
            "zh": "送到你那边之后，\n请一定要试着用用看！",
            "narrator_zh": "领火"
        },
        {
            "location": "250/TALK",
            "narrator": "エリカ",
            "text": "神楽ちゃんのスタンプで、\n二人の心の距離が\nより近づきますように。",
            "zh": "愿神乐的表情包，\n能让你们两颗心的距离\n更加贴近。",
            "narrator_zh": "领火"
        },
        {
            "location": "251/TALK",
            "narrator": "エリカ",
            "text": "それじゃ、\n今回もよろしく\nお願いします！",
            "zh": "那么，\n这一次也请多\n关照啦！",
            "narrator_zh": "领火"
        },
        {
