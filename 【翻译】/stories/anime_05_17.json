            "text": "映像を見る\n<color=green>【高画質/74MB 4:36】</color>",
            "zh": "观看影像\n<color=green>【高画质/74MB 4:36】</color>",
            "narrator_zh": ""
        },
        {
            "location": "390/TALK",
            "narrator": "千羽鶴",
            "text": "わかった。",
            "zh": "好。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "396/ACT",
            "narrator": "",
            "text": "映像を見る\n<color=green>【標準画質/24MB 4:36】</color>",
            "zh": "观看影像\n<color=green>【标准画质/24MB 4:36】</color>",
            "narrator_zh": ""
        },
        {
            "location": "397/TALK",
            "narrator": "千羽鶴",
            "text": "わかった。",
            "zh": "好。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "403/ACT",
            "narrator": "",
            "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>",
            "zh": "改为剧情梗概报告\n<color=green>【文字汇总】</color>",
            "narrator_zh": ""
        },
        {
            "location": "404/TALK",
            "narrator": "千羽鶴",
            "text": "そう……。",
            "zh": "这样……。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "437/TALK",
            "narrator": "千羽鶴",
            "text": "ところで。",
            "zh": "话说回来。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "438/TALK",
            "narrator": "千羽鶴",
            "text": "エリカは信頼できる？",
            "zh": "领火值得信赖吗？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "439/TALK",
            "narrator": "千羽鶴",
            "text": "現時点での気持ちとして。",
            "zh": "就你目前的心情来说。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "440/SEL",
            "narrator": "",
            "text": "できる",
            "zh": "值得",
            "narrator_zh": ""
        },
        {
            "location": "441/SEL",
            "narrator": "",
            "text": "できない",
            "zh": "不值得",
            "narrator_zh": ""
        },
        {
            "location": "442/ACT",
            "narrator": "",
            "text": "できる",
            "zh": "值得",
            "narrator_zh": ""
        },
        {
            "location": "445/TALK",
            "narrator": "千羽鶴",
            "text": "よかった。",
            "zh": "太好了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "446/ACT",
            "narrator": "",
            "text": "できない",
            "zh": "不值得",
            "narrator_zh": ""
        },
        {
            "location": "449/TALK",
            "narrator": "千羽鶴",
            "text": "そう。",
            "zh": "是吗。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "451/TALK",
            "narrator": "千羽鶴",
            "text": "じゃあ同じく、\n私は信頼できる？",
            "zh": "那同样地，\n我值得信赖吗？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "452/SEL",
            "narrator": "",
            "text": "できる",
            "zh": "值得",
            "narrator_zh": ""
        },
        {
            "location": "453/SEL",
            "narrator": "",
            "text": "できない",
            "zh": "不值得",
            "narrator_zh": ""
        },
        {
            "location": "454/ACT",
            "narrator": "",
            "text": "できる",
            "zh": "值得",
            "narrator_zh": ""
        },
        {
            "location": "457/TALK",
            "narrator": "千羽鶴",
            "text": "よかった。",
            "zh": "太好了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "458/ACT",
            "narrator": "",
            "text": "できない",
            "zh": "不值得",
            "narrator_zh": ""
        },
        {
            "location": "461/TALK",
            "narrator": "千羽鶴",
            "text": "そう…。",
            "zh": "是吗……。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "467/TALK",
            "narrator": "千羽鶴",
            "text": "ここからのリプレイスは\n信頼こそが命。",
            "zh": "从这里开始的替换，\n信赖就是生命线。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "468/TALK",
            "narrator": "千羽鶴",
            "text": "貴方が私やエリカを\n信頼してくれているのは\n本当に心強い。",
            "zh": "你能信赖我和领火，\n真的让人\n很安心。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "469/TALK",
            "narrator": "千羽鶴",
            "text": "そして、それは\n成功に向けて\nとても重要なこと。",
            "zh": "而且，这对走向成功\n来说是\n非常重要的事。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "470/TALK",
            "narrator": "千羽鶴",
            "text": "私もエリカも、\n常軌を逸したヘンな子だし\n理解不能だと思うのに――",
            "zh": "我和领火都是\n偏离常轨的怪孩子，\n应该让人无法理解——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "471/TALK",
            "narrator": "千羽鶴",
            "text": "そんな二人を\n信頼してくれて\n本当にありがとう。",
            "zh": "真的非常感谢你\n愿意信赖这样的\n我们两个人。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "475/TALK",
            "narrator": "千羽鶴",
            "text": "貴方がエリカを\n信頼できない事については\n私にも責任がある。",
            "zh": "至于你无法信赖\n领火这件事，\n我也有责任。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "476/SEL",
            "narrator": "",
            "text": "千羽鶴は悪くないよ",
            "zh": "不是千羽鹤的错哦",
            "narrator_zh": ""
        },
        {
            "location": "477/SEL",
            "narrator": "",
            "text": "千羽鶴は優しいね",
            "zh": "千羽鹤好温柔呢",
            "narrator_zh": ""
        },
        {
            "location": "478/SEL",
            "narrator": "",
            "text": "確かに連帯責任だと思う",
            "zh": "确实是连带责任呢",
            "narrator_zh": ""
        },
        {
            "location": "479/ACT",
            "narrator": "",
            "text": "千羽鶴は悪くないよ",
            "zh": "不是千羽鹤的错哦",
            "narrator_zh": ""
        },
        {
            "location": "480/TALK",
            "narrator": "千羽鶴",
            "text": "貴方は優しいのね。",
            "zh": "你真温柔呢。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "481/TALK",
            "narrator": "千羽鶴",
            "text": "けれども、私の結論は\n決して感情的なものでは\nなく、理屈の上にある。",
            "zh": "但是，我的结论\n绝不是出于感情，\n而是建立在道理上的。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "482/ACT",
            "narrator": "",
            "text": "千羽鶴は優しいね",
            "zh": "千羽鹤好温柔呢",
            "narrator_zh": ""
        },
        {
            "location": "483/TALK",
            "narrator": "千羽鶴",
            "text": "私は単に、可能な限り\n第三者的視点から感情\n抜きで判断してるだけ。",
            "zh": "我只是尽可能\n站在第三方视角，\n不带感情地判断而已。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "484/ACT",
            "narrator": "",
            "text": "確かに連帯責任だと思う",
            "zh": "确实是连带责任呢",
            "narrator_zh": ""
        },
        {
            "location": "485/TALK",
            "narrator": "千羽鶴",
            "text": "そう。その通り。\n貴方には、物事を冷静に\n見る力があると思う。",
            "zh": "是的。正如你所说。\n我觉得你有冷静\n看待事物的能力。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "487/TALK",
            "narrator": "千羽鶴",
            "text": "私がどうしてそう思うのか\n説明しておこうと思う。",
            "zh": "我想说明一下我为什么会\n这么认为。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "488/TALK",
            "narrator": "千羽鶴",
            "text": "彼女が今の行動を\n起こしていることに\nついては――",
            "zh": "她之所以\n会采取现在的行动\n这件事——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "489/TALK",
            "narrator": "千羽鶴",
            "text": "その動機の殆どは、\n私の行動に紐付いてる。",
            "zh": "其动机绝大多数，\n都与我的行动紧密相连。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "490/TALK",
            "narrator": "千羽鶴",
            "text": "人の出逢いと繋がりは、\n巡り合わせによって\n敵にも味方にもなる。",
            "zh": "人与人的相遇和联系，\n会因机缘巧合\n变成敌人或同伴。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "491/TALK",
            "narrator": "千羽鶴",
            "text": "もし私とエリカが\n一度も袂を分かつこと無く\n共同戦線を張っていたら。",
            "zh": "如果我和领火\n从来没有分道扬镳，\n一直结成统一战线的话。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "492/TALK",
            "narrator": "千羽鶴",
            "text": "貴方はエリカを\n信頼していた\n可能性もある。",
            "zh": "你也有可能\n会信赖领火\n的。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "493/TALK",
            "narrator": "千羽鶴",
            "text": "そのこともまた、\nちょっと考えてみると\nいいかもしれない。",
            "zh": "这一点，或许也\n稍微思考一下\n比较好。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "494/SEL",
            "narrator": "",
            "text": "確かにそれはあるよね",
            "zh": "确实有这种可能呢",
            "narrator_zh": ""
        },
        {
            "location": "495/SEL",
            "narrator": "",
            "text": "単にエリカの性格の問題だよ",
            "zh": "单纯只是领火的性格问题吧",
            "narrator_zh": ""
        },
        {
            "location": "496/ACT",
            "narrator": "",
            "text": "確かにそれはあるよね",
            "zh": "确实有这种可能呢",
            "narrator_zh": ""
        },
        {
            "location": "498/TALK",
            "narrator": "千羽鶴",
            "text": "そう。",
            "zh": "是的。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "499/ACT",
            "narrator": "",
            "text": "単にエリカの性格の問題だよ",
            "zh": "单纯只是领火的性格问题吧",
            "narrator_zh": ""
        },
        {
            "location": "501/TALK",
            "narrator": "千羽鶴",
            "text": "なるほど。",
            "zh": "原来如此。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "502/TALK",
            "narrator": "千羽鶴",
            "text": "そこまで貴方が、\n自分の中で原因をわかって\nいるならそれでいい。",
            "zh": "既然你自己心里\n已经明白原因到这种\n程度，那就好。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "503/TALK",
            "narrator": "千羽鶴",
            "text": "ただ、そうなると――",
            "zh": "只是，那样的话——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "504/TALK",
            "narrator": "千羽鶴",
            "text": "仕事として割り切って\nもらうか、何とかして\n気持ちを切り替えるか。",
            "zh": "要么当作工作来公事公办，\n要么想办法\n转换一下心情。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "505/TALK",
            "narrator": "千羽鶴",
            "text": "貴方は、自分の気持ちを\nいずれかで整理する\n必要がある。",
            "zh": "你必须在两者之中\n选一个来整理好\n自己的心情。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "506/TALK",
            "narrator": "千羽鶴",
            "text": "もちろん、やめるという\n選択肢もある。\n私は望まないけど。",
            "zh": "当然，也有退出\n这个选项。\n虽然我不希望那样。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "510/TALK",
            "narrator": "千羽鶴",
            "text": "私が貴方に\n信頼されないのは、\n仕方ないことだと思う。",
            "zh": "我不被你信赖，\n我觉得也是\n无可奈何的事。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "511/TALK",
            "narrator": "千羽鶴",
            "text": "客観的に見て、私は\n貴方にとって不利益になる\nことをしてきたと思う。",
            "zh": "客观来看，我确实\n一直都在做对你\n不利的事情。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "512/TALK",
            "narrator": "千羽鶴",
            "text": "一度書き込まれた事実を\n消すことはできない。",
            "zh": "一旦写下的事实\n是无法抹去的。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "513/TALK",
            "narrator": "千羽鶴",
            "text": "そして、私自身は今でも、\nリプレイス前の行動は\n間違ってたとは思わない。",
            "zh": "而且，我自己直到现在\n也依然不认为替换前的\n行动是错的。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "514/TALK",
            "narrator": "千羽鶴",
            "text": "その理由は、あの時の\n情報と制限時間等から、\n最大限考えた結果であり。",
            "zh": "理由在于，那是根据\n当时的情报和时限等，\n最大限度思考的结果。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "515/TALK",
            "narrator": "千羽鶴",
            "text": "それは何度やっても、\n大枠としては変わらないと\n今でも思っているから。",
            "zh": "而且不管重来多少次，\n我觉得大方向上\n都不会改变。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "516/SEL",
            "narrator": "",
            "text": "わかってるから$me$も割り切ってるし、信頼してないけど最後まで協力はする",
            "zh": "我明白，所以$me$也看开了，虽然不信赖但还是会配合到最后",
            "narrator_zh": ""
        },
        {
            "location": "517/SEL",
            "narrator": "",
            "text": "そういうとこですよ、反省して",
            "zh": "就是这一点啊，反省一下吧",
            "narrator_zh": ""
        },
        {
            "location": "518/SEL",
            "narrator": "",
            "text": "そういう部分じゃなくて、むしろやり方とか性格の問題",
            "zh": "不是那种部分，倒不如说是做法和性格的问题",
            "narrator_zh": ""
        },
        {
            "location": "519/ACT",
            "narrator": "",
            "text": "わかってるから$me$も割り切ってるし、信頼してないけど最後まで協力はする",
            "zh": "我明白，所以$me$也看开了，虽然不信赖但还是会配合到最后",
            "narrator_zh": ""
        },
        {
            "location": "521/TALK",
            "narrator": "千羽鶴",
            "text": "ありがと。\nそうしてもらえると\n助かる。",
            "zh": "谢谢。\n你能这样的话\n帮大忙了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "522/ACT",
            "narrator": "",
            "text": "そういうとこですよ、反省して",
            "zh": "就是这一点啊，反省一下吧",
            "narrator_zh": ""
        },
        {
            "location": "524/TALK",
            "narrator": "千羽鶴",
            "text": "反省しているか否かと、\n信頼できるか否かは、\n厳密には軸が違う。",
            "zh": "有没有在反省，和\n能不能被信赖，严格\n来说轴线是不一样的。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "525/TALK",
            "narrator": "千羽鶴",
            "text": "私は貴方や彼女たちに\n不快な気持ちや苦痛を\n与えたという自覚はある。",
            "zh": "我有自觉，知道自己\n让你和她们感到了\n不快与痛苦。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "526/TALK",
            "narrator": "千羽鶴",
            "text": "だから、その点については\n本当に申し訳ないと\n思ってはいるけど――",
            "zh": "所以关于这一点，\n我是真的觉得\n很抱歉——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "527/TALK",
            "narrator": "千羽鶴",
            "text": "だからといって、今までの\n行動が間違っていた、と\n私が言うことは絶対ない。",
            "zh": "但话虽如此，我绝不会\n说出至今为止的行动\n是错误的这种话。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "528/TALK",
            "narrator": "千羽鶴",
            "text": "なぜなら、それは嘘で\nあり、それこそ誠実さに\n欠ける行為だから。",
            "zh": "因为那是谎言，\n那才是真正缺乏\n诚实的行为。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "529/TALK",
            "narrator": "千羽鶴",
            "text": "私は、そういう人こそ\n信頼できない人だと\n思っている。",
            "zh": "我觉得，那样的人\n才是最不能信赖\n的人。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "530/ACT",
            "narrator": "",
            "text": "そういう部分じゃなくて、むしろやり方とか性格の問題",
            "zh": "不是那种部分，倒不如说是做法和性格的问题",
            "narrator_zh": ""
        },
        {
            "location": "532/TALK",
            "narrator": "千羽鶴",
            "text": "それは信頼の問題と\nいうよりも、好みの問題？",
            "zh": "那与其说是信赖的问题，\n不如说是喜好的问题？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "533/TALK",
            "narrator": "千羽鶴",
            "text": "もちろん、人と人との\n関係には、好き嫌いは\n相当に影響する。",
            "zh": "当然，在人与人的\n关系里，喜恶会产生\n相当大的影响。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "534/TALK",
            "narrator": "千羽鶴",
            "text": "だから、そのことを\n信頼出来るか否かと\n混同するのもわかる。",
            "zh": "所以，会把那件事和\n能不能信赖混为一谈\n我也能理解。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "535/TALK",
            "narrator": "千羽鶴",
            "text": "仕事をしていても、\n学校に通っていても――",
            "zh": "不管是上班工作，\n还是上学读书——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "536/TALK",
            "narrator": "千羽鶴",
            "text": "信頼は出来るけど\n嫌いな上司、先生。",
            "zh": "值得信赖但讨厌的\n上司、老师。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "537/TALK",
            "narrator": "千羽鶴",
            "text": "信頼はできないけど、\n好きな上司、先生。",
            "zh": "不值得信赖但喜欢的\n上司、老师。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "538/TALK",
            "narrator": "千羽鶴",
            "text": "そういう人も\nいると思う。",
            "zh": "我觉得这样的人\n也是有的。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "539/TALK",
            "narrator": "千羽鶴",
            "text": "ちょっと思い返してみて\n整理してみると\nいいかもしれない。",
            "zh": "稍微回想一下，\n试着整理一下\n或许比较好。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "543/TALK",
            "narrator": "千羽鶴",
            "text": "ならば貴方は、\nどんな信念に基づいて\n私やエリカと対話してる？",
            "zh": "那么你又是\n基于什么样的信念，\n在和我及领火对话呢？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "544/SEL",
            "narrator": "",
            "text": "貴方たちをコロシテでも$me$の大切な彼女を幸せにしたいから今は従ってる",
            "zh": "就算要干掉你们，$me$也想让我珍视的她幸福，所以现在才听你们的",
            "narrator_zh": ""
        },
        {
            "location": "545/SEL",
            "narrator": "",
            "text": "基本的には千羽鶴は信頼してるけど、エリカを信頼する千羽鶴は信頼できない",
            "zh": "基本上是信赖千羽鹤的，但无法信赖信任着领火的千羽鹤",
            "narrator_zh": ""
        },
        {
            "location": "546/SEL",
            "narrator": "",
            "text": "基本的にはエリカは信頼してるけど、千羽鶴に協力するエリカには失望してる",
            "zh": "基本上是信赖领火的，但对协助千羽鹤的领火感到失望",
            "narrator_zh": ""
        },
        {
            "location": "547/ACT",
            "narrator": "",
            "text": "貴方たちをコロシテでも$me$の大切な彼女を幸せにしたいから今は従ってる",
            "zh": "就算要干掉你们，$me$也想让我珍视的她幸福，所以现在才听你们的",
            "narrator_zh": ""
        },
        {
            "location": "549/TALK",
            "narrator": "千羽鶴",
            "text": "そう、わかった。\nとてもいい答え。",
            "zh": "是吗，我知道了。\n非常好的回答。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "550/TALK",
            "narrator": "千羽鶴",
            "text": "私は今回の計画について、\n私とエリカ、貴方の信頼\n関係が重要だと考える。",
            "zh": "关于这次的计划，\n我认为我、领火与你的\n信赖关系很重要。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "551/TALK",
            "narrator": "千羽鶴",
            "text": "けれども、貴方がそれ\n以上の想いで大切な彼女を\n守る意志があるなら――",
            "zh": "但是，如果你有着\n超越那之上的心意，\n决心守护珍视的她——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "552/TALK",
            "narrator": "千羽鶴",
            "text": "それはそれで、\nもう１つの成功への\n道なのかもしれない。",
            "zh": "那也不失为\n通往成功的另一条\n道路吧。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "553/TALK",
            "narrator": "千羽鶴",
            "text": "成功への道筋は、\n想いの力が握ってる。",
            "zh": "通往成功的道路，\n掌握在心意的力量手里。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "554/TALK",
            "narrator": "千羽鶴",
            "text": "例えその想いが\n水と油のように相反する\nものであっても――",
            "zh": "哪怕那份心意\n如同水火般\n彼此相悖——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "555/TALK",
            "narrator": "千羽鶴",
            "text": "その力が同じ方向を\n向いているのなら、それは\n成功する可能性に繋がる。",
            "zh": "只要那股力量朝向\n同一个方向，那就会\n化作通往成功的可能。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "556/TALK",
            "narrator": "千羽鶴",
            "text": "私としては、\nそれならそれでも\n構わないと思ってる。",
            "zh": "就我而言，\n那样也\n无所谓。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "557/ACT",
            "narrator": "",
            "text": "基本的には千羽鶴は信頼してるけど、エリカを信頼する千羽鶴は信頼できない",
            "zh": "基本上是信赖千羽鹤的，但无法信赖信任着领火的千羽鹤",
            "narrator_zh": ""
        },
        {
            "location": "559/TALK",
            "narrator": "千羽鶴",
            "text": "なるほど。",
            "zh": "原来如此。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "561/ACT",
            "narrator": "",
            "text": "基本的にはエリカは信頼してるけど、千羽鶴に協力するエリカには失望してる",
            "zh": "基本上是信赖领火的，但对协助千羽鹤的领火感到失望",
            "narrator_zh": ""
        },
        {
            "location": "563/TALK",
            "narrator": "千羽鶴",
            "text": "なるほど。",
            "zh": "原来如此。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "569/TALK",
            "narrator": "千羽鶴",
            "text": "いずれにせよ、貴方は\n自分の真摯な気持ちを\n正直に言ってくれた。",
            "zh": "不管怎样，你坦率地\n说出了自己真挚的\n心情。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "570/TALK",
            "narrator": "千羽鶴",
            "text": "感謝すると共に、\n真摯に受けとめたいと\n思う。",
            "zh": "在感谢的同时，\n我也想真挚地\n接纳这份心意。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "571/TALK",
            "narrator": "千羽鶴",
            "text": "けれども、最終的に\nこの計画は――",
            "zh": "但是，归根结底，\n这个计划——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "572/TALK",
            "narrator": "千羽鶴",
            "text": "私とエリカ、そして貴方が\n三位一体となって、初めて\n成果が出ると思ってる。",
            "zh": "只有我、领火还有你\n三位一体，才能够\n产生出成果。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "573/TALK",
            "narrator": "千羽鶴",
            "text": "だから、貴方が彼女を\n信頼出来ないというなら―",
            "zh": "所以，如果你说\n无法信赖她的话—",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "574/TALK",
            "narrator": "千羽鶴",
            "text": "その原因を見つけ出して\n潰していかねばならない。",
            "zh": "我就必须找出那个原因，\n然后把它彻底消除才行。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "575/TALK",
            "narrator": "千羽鶴",
            "text": "今回は、私の方から\n『無理ならやめていい』\nとは言いたくない。",
            "zh": "这一次，我不想由我\n这边说出『勉强的话\n可以放弃哦』。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "576/TALK",
            "narrator": "千羽鶴",
            "text": "もちろん貴方が限界を感じ\nやめていくのは自由だし、\nそれを尊重するけど――",
            "zh": "当然，你感到极限而\n选择退出是你的自由，\n我也会尊重——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "577/TALK",
            "narrator": "千羽鶴",
            "text": "私はそれを解決すべく、\n動いていこうと思ってる。",
            "zh": "但我还是打算为了解决这个问题\n而采取行动。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "579/TALK",
            "narrator": "千羽鶴",
            "text": "わかってると思うけど、\n今回の作戦に正解はない。",
            "zh": "我想你应该明白，\n这次的作战没有正确答案。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "580/TALK",
            "narrator": "千羽鶴",
            "text": "ゲームみたいに、\nトゥルーエンドが予め\n用意されてるわけもない。",
            "zh": "也不可能像游戏那样，\n预先就准备好\nTrue End。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "581/TALK",
            "narrator": "千羽鶴",
            "text": "だからこそ、私も、\n貴方も、そしてエリカも。",
            "zh": "正因如此，无论是我、\n是你，还是领火。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "582/TALK",
            "narrator": "千羽鶴",
            "text": "最大にして唯一の大切な\n事項は、自分が自分を\n最後まで信じられたか。",
            "zh": "最大也是唯一重要的\n事项，就是自己能否\n相信自己直到最后。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "583/TALK",
            "narrator": "千羽鶴",
            "text": "そして、どんな結果に\nなったとしても、自分が\nやり切ったと思えるか。",
            "zh": "以及，无论迎来\n怎样的结果，自己能否\n觉得已经竭尽全力。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "584/TALK",
            "narrator": "千羽鶴",
            "text": "大切なものが何かを、\n選択するとき、常にそれを\n忘れずにしてきたか。",
            "zh": "什么是重要的事物，\n在做选择的时候，是否\n时刻没有忘记这一点。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "585/TALK",
            "narrator": "千羽鶴",
            "text": "それこそが、\n作戦を遂行する上で、\n最も大切なことだと思う。",
            "zh": "我觉得这才是\n在执行作战时\n最重要的一点。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "587/TALK",
            "narrator": "千羽鶴",
            "text": "今回はちょっと真面目で\n重い話になったけど、\n大事な事なのでお話した。",
            "zh": "这次聊了点比较严肃\n沉重的话题，但因为\n很重要所以还是说了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "588/SEL",
            "narrator": "",
            "text": "いい話だったよ",
            "zh": "是很棒的一番话哦",
            "narrator_zh": ""
        },
        {
            "location": "589/SEL",
            "narrator": "",
            "text": "退屈だった",
            "zh": "好无聊",
            "narrator_zh": ""
        },
        {
            "location": "590/ACT",
            "narrator": "",
            "text": "いい話だったよ",
            "zh": "是很棒的一番话哦",
            "narrator_zh": ""
        },
        {
            "location": "591/TALK",
            "narrator": "千羽鶴",
            "text": "よかった。",
            "zh": "太好了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "592/ACT",
            "narrator": "",
            "text": "退屈だった",
            "zh": "好无聊",
            "narrator_zh": ""
        },
        {
            "location": "593/TALK",
            "narrator": "千羽鶴",
            "text": "それは残念。",
            "zh": "那真是遗憾。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "595/TALK",
            "narrator": "千羽鶴",
            "text": "次回から、本格的に\nリプレイス作戦が\n開始される。",
            "zh": "从下一次开始，\n替换作战就要\n正式开始了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "596/TALK",
            "narrator": "千羽鶴",
            "text": "それまでに、貴方は\n貴方自身の関わり方を\n決めておくといいかも。",
            "zh": "在那之前，你自己\n也可以先决定好\n要如何参与其中。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "597/TALK",
            "narrator": "千羽鶴",
            "text": "それじゃ、\n今回はこの辺で。",
            "zh": "那么，\n这次就到这里。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "598/TALK",
            "narrator": "千羽鶴",
            "text": "今回も、卯月神楽と\n過去の私のサポートを\nどうかよろしく。",
            "zh": "这一次，卯月神乐与\n过去的我的支援，\n也拜托你了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "305/DIALOG",
