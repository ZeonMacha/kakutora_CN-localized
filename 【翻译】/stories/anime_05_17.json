    "entry": [
        {
            "location": "264/SCENARIO",
            "narrator": "",
            "text": "アニメ第17話",
            "zh": "动画第17话",
            "narrator_zh": ""
        },
        {
            "location": "277/TALK",
            "narrator": "千羽鶴",
            "text": "ごきげんよう、\n$handle$。",
            "zh": "贵安，\n$handle$。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "278/TALK",
            "narrator": "千羽鶴",
            "text": "もう一度\n私との会話を\n再現する？",
            "zh": "要再一次\n重现与我的\n对话吗？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "279/SEL",
            "narrator": "",
            "text": "はい",
            "zh": "是",
            "narrator_zh": ""
        },
        {
            "location": "280/SEL",
            "narrator": "",
            "text": "いいえ",
            "zh": "否",
            "narrator_zh": ""
        },
        {
            "location": "281/ACT",
            "narrator": "",
            "text": "はい",
            "zh": "是",
            "narrator_zh": ""
        },
        {
            "location": "282/TALK",
            "narrator": "千羽鶴",
            "text": "わかった。",
            "zh": "好。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "284/ACT",
            "narrator": "",
            "text": "いいえ",
            "zh": "否",
            "narrator_zh": ""
        },
        {
            "location": "285/TALK",
            "narrator": "千羽鶴",
            "text": "そう。",
            "zh": "是的。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "293/TALK",
            "narrator": "千羽鶴",
            "text": "<size=40>ごめん！</size>",
            "zh": "<size=40>对不起！</size>",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "294/SEL",
            "narrator": "",
            "text": "どうしたの！？",
            "zh": "怎么了！？",
            "narrator_zh": ""
        },
        {
            "location": "295/SEL",
            "narrator": "",
            "text": "ちゅうで許す！",
            "zh": "亲一口就原谅你！",
            "narrator_zh": ""
        },
        {
            "location": "296/ACT",
            "narrator": "",
            "text": "どうしたの！？",
            "zh": "怎么了！？",
            "narrator_zh": ""
        },
        {
            "location": "297/ACT",
            "narrator": "",
            "text": "ちゅうで許す！",
            "zh": "亲一口就原谅你！",
            "narrator_zh": ""
        },
        {
            "location": "312/TALK",
            "narrator": "千羽鶴",
            "text": "…っ！！",
            "zh": "……唔！！",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "313/TALK",
            "narrator": "千羽鶴",
            "text": "よし！\n許された！",
            "zh": "好！\n被原谅了！",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "316/TALK",
            "narrator": "千羽鶴",
            "text": "…っ！！",
            "zh": "……唔！！",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "317/TALK",
            "narrator": "千羽鶴",
            "text": "よし！\n許された！",
            "zh": "好！\n被原谅了！",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "326/TALK",
            "narrator": "千羽鶴",
            "text": "やっぱナシ。",
            "zh": "还是算了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "329/TALK",
            "narrator": "千羽鶴",
            "text": "調子にノリ夫！",
            "zh": "得意忘形夫！",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "332/TALK",
            "narrator": "千羽鶴",
            "text": "ちーは１つ\n間違えていた。",
            "zh": "小千搞错了\n1件事。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "333/TALK",
            "narrator": "千羽鶴",
            "text": "前に、次々回から\n本気出す、と私は\n貴方に言った。",
            "zh": "之前我曾\n对你说过，下下回\n开始要动真格。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "334/TALK",
            "narrator": "千羽鶴",
            "text": "そして今回がその\n「次々回」に当たる\nわけだけど――",
            "zh": "而这次本来该是\n那个「下下回」\n才对——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "337/TALK",
            "narrator": "千羽鶴",
            "text": "本気出すのは\n次回からだった！",
            "zh": "要动真格的\n其实是从下回开始！",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "338/SEL",
            "narrator": "",
            "text": "エー",
            "zh": "咦——",
            "narrator_zh": ""
        },
        {
            "location": "339/SEL",
            "narrator": "",
            "text": "じゃあ今回も遊ぼう",
            "zh": "那这次也继续玩吧",
            "narrator_zh": ""
        },
        {
            "location": "340/SEL",
            "narrator": "",
            "text": "またドヤ顔してる…",
            "zh": "又在摆得意脸了……",
            "narrator_zh": ""
        },
        {
            "location": "341/ACT",
            "narrator": "",
            "text": "エー",
            "zh": "咦——",
            "narrator_zh": ""
        },
        {
            "location": "343/TALK",
            "narrator": "千羽鶴",
            "text": "ちーだって\n生き物だから\nたまには間違える。",
            "zh": "毕竟小千也是\n活生生的存在，\n偶尔也会搞错的。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "345/ACT",
            "narrator": "",
            "text": "じゃあ今回も遊ぼう",
            "zh": "那这次也继续玩吧",
            "narrator_zh": ""
        },
        {
            "location": "346/TALK",
            "narrator": "千羽鶴",
            "text": "んー……。",
            "zh": "唔——……。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "347/TALK",
            "narrator": "千羽鶴",
            "text": "わりと良い考えかも\nしれないとは思う。",
            "zh": "我觉得这说不定\n是个挺不错的主意。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "348/ACT",
            "narrator": "",
            "text": "またドヤ顔してる…",
            "zh": "又在摆得意脸了……",
            "narrator_zh": ""
        },
        {
            "location": "349/TALK",
            "narrator": "千羽鶴",
            "text": "ドヤ顔しないちーは\nちーに非ず！",
            "zh": "不摆得意脸的小千\n就不是小千！",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "350/SEL",
            "narrator": "",
            "text": "かわったねー",
            "zh": "变了呢——",
            "narrator_zh": ""
        },
        {
            "location": "351/SEL",
            "narrator": "",
            "text": "かわらないねー",
            "zh": "没变呢——",
            "narrator_zh": ""
        },
        {
            "location": "352/ACT",
            "narrator": "",
            "text": "かわったねー",
            "zh": "变了呢——",
            "narrator_zh": ""
        },
        {
            "location": "353/ACT",
            "narrator": "",
            "text": "かわらないねー",
            "zh": "没变呢——",
            "narrator_zh": ""
        },
        {
            "location": "355/TALK",
            "narrator": "千羽鶴",
            "text": "黙れ。",
            "zh": "闭嘴。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "357/TALK",
            "narrator": "千羽鶴",
            "text": "というわけで。",
            "zh": "于是乎。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "358/TALK",
            "narrator": "千羽鶴",
            "text": "今日は何の日？\n覚えていたら貴方は\n千羽鶴マスター。",
            "zh": "今天是什么日子？\n要是还记得，你就是\n千羽鹤大师。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "359/TALK",
            "narrator": "千羽鶴",
            "text": "そう、今日はあの\n悪名高きクソゲー――",
            "zh": "没错，今天就是那款\n臭名昭著的粪作——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "360/TALK",
            "narrator": "千羽鶴",
            "text": "ちーちゃんと\nラブラブRPGゲームの\nリリース日。",
            "zh": "和小千甜甜蜜蜜\nRPG游戏的\n发售日。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "361/TALK",
            "narrator": "千羽鶴",
            "text": "ああっ。\nついに一周まわって\nあの日に戻って来たのね。",
            "zh": "啊啊。\n终于转了一圈，\n回到那一天了呢。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "362/TALK",
            "narrator": "千羽鶴",
            "text": "というわけで！",
            "zh": "于是乎！",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "363/TALK",
            "narrator": "千羽鶴",
            "text": "せっかくなので、\nクソゲーリリース回\n周回記念として――",
            "zh": "机会难得，作为\n粪作发售回\n轮回纪念——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "364/TALK",
            "narrator": "千羽鶴",
            "text": "ディレクターズコメントを\n作ってみた！",
            "zh": "我试着做了\n导演解说音轨！",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "365/SEL",
            "narrator": "",
            "text": "なにそれｗｗ",
            "zh": "什么鬼哈哈",
            "narrator_zh": ""
        },
        {
            "location": "366/ACT",
            "narrator": "",
            "text": "なにそれｗｗ",
            "zh": "什么鬼哈哈",
            "narrator_zh": ""
        },
        {
            "location": "368/TALK",
            "narrator": "千羽鶴",
            "text": "例のRPGマップを使い、\nそのポイントごとに\nちーがコメントしていく。",
            "zh": "用上那张RPG地图，\n在每个节点上\n由小千来进行解说。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "371/TALK",
            "narrator": "千羽鶴",
            "text": "前代未聞の\nRPGゲーム本編を使った\nゲームコメンタリー！",
            "zh": "史无前例的\n使用RPG游戏正篇的\n游戏评论解说！",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "372/SEL",
            "narrator": "",
            "text": "見たい！！",
            "zh": "想看！！",
            "narrator_zh": ""
        },
        {
            "location": "373/SEL",
            "narrator": "",
            "text": "遠慮します",
            "zh": "还是免了",
            "narrator_zh": ""
        },
        {
            "location": "374/ACT",
            "narrator": "",
            "text": "見たい！！",
            "zh": "想看！！",
            "narrator_zh": ""
        },
        {
            "location": "375/TALK",
            "narrator": "千羽鶴",
            "text": "わかった。",
            "zh": "好。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "381/ACT",
            "narrator": "",
            "text": "遠慮します",
            "zh": "还是免了",
            "narrator_zh": ""
        },
        {
            "location": "382/TALK",
            "narrator": "千羽鶴",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "386/SEL",
            "narrator": "",
            "text": "映像を見る\n<color=green>【高画質/74MB 4:36】</color>",
            "zh": "观看影像\n<color=green>【高画质/74MB 4:36】</color>",
            "narrator_zh": ""
        },
        {
