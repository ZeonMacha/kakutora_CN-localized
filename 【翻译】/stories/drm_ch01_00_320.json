{
 "dir": "dramatics/daydra/drm_ch01_00_320.js",
 "type": "Episode",
 "info": {
  "story_id": "1032",
  "cid": "tsubame",
  "title": "らぶとーく 第32話",
  "sub_title": "悪く言わないで"
 },
 "entry": [
  {
   "location": "146/SCENARIO",
   "narrator": "",
   "text": "悪く言わないで"
  },
  {
   "location": "159/TALK",
   "narrator": "ガブリエラ",
   "text": "はぁ！？\nまだ来てないの！？",
   "zh": "哈！？\n还没来！？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "161/TALK",
   "narrator": "つばめ",
   "text": "わっ！？\nな、何、どうしたの？"
  },
  {
   "location": "164/TALK",
   "narrator": "みやび",
   "text": "いや、今日のシフトは\n卯月も入ってるんや\nけんど――"
  },
  {
   "location": "165/TALK",
   "narrator": "みやび",
   "text": "まだ劇場に来とらんがよ。"
  },
  {
   "location": "166/TALK",
   "narrator": "つばめ",
   "text": "えっ…。",
   "zh": "诶……。",
   "narrator_zh": "燕"
  },
  {
   "location": "168/TALK",
   "narrator": "つばめ",
   "text": "お母さんのことで、\n何かあったのかな？",
   "zh": "妈妈的事，\n是不是发生了什么？",
   "narrator_zh": "燕"
  },
  {
   "location": "169/TALK",
   "narrator": "アーヤ",
   "text": "ＷＡＶＥにも反応が\n無いみたいだし…。"
  },
  {
   "location": "173/TALK",
   "narrator": "アーヤ",
   "text": "何かあったのかしら…。\nつばめは何か知ってる？"
  },
  {
   "location": "176/TALK",
   "narrator": "つばめ",
   "text": "え、えっと…。",
   "zh": "诶、那个……。",
   "narrator_zh": "燕"
  },
  {
   "location": "178/TALK",
   "narrator": "つばめ",
   "text": "あ、ちょっと待って\nください！\n今、ＷＡＶＥが…。"
  },
  {
   "location": "192/TALK",
   "narrator": "つばめ",
   "text": "どぅしよぅ|ﾟДﾟ)))",
   "zh": "怎么办啊（|| Д）",
   "narrator_zh": "燕"
  },
  {
   "location": "193/TALK",
   "narrator": "つばめ",
   "text": "卯月さんのこと"
  },
  {
   "location": "194/TALK",
   "narrator": "つばめ",
   "text": "なんて説明すればぃぃかな？(；´Д｀)",
   "zh": "该怎么说明才好呢？(；´Д｀)",
   "narrator_zh": "燕"
  },
  {
   "location": "196/SEL",
   "narrator": "",
   "text": "月に帰ったって言えば",
   "zh": "你就说她回月亮上去了",
   "narrator_zh": ""
  },
  {
   "location": "197/SEL",
   "narrator": "",
   "text": "しらを切れ"
  },
  {
   "location": "198/SEL",
   "narrator": "",
   "text": "こっちが聞きたいって言えば",
   "zh": "要说这边才想问你呢",
   "narrator_zh": ""
  },
  {
   "location": "199/ACT",
   "narrator": "",
   "text": "月に帰ったって言えば",
   "zh": "你就说她回月亮上去了",
   "narrator_zh": ""
  },
  {
   "location": "200/TALK",
   "narrator": "つばめ",
   "text": "それって冗談でしょ？",
   "zh": "那是开玩笑吧？",
   "narrator_zh": "燕"
  },
  {
   "location": "201/TALK",
   "narrator": "つばめ",
   "text": "冗談言ってぃぃ雰囲気じゃなぃよ(；´Д｀)"
  },
  {
   "location": "213/TALK",
   "narrator": "つばめ",
   "text": "え、えっと…。",
   "zh": "诶、那个……。",
   "narrator_zh": "燕"
  },
  {
   "location": "216/TALK",
   "narrator": "つばめ",
   "text": "多分、体調を崩したとか\nだと思いますよ？",
   "zh": "大概是身体不舒服\n之类的吧？",
   "narrator_zh": "燕"
  },
  {
   "location": "218/TALK",
   "narrator": "ガブリエラ",
   "text": "適当過ぎでしょ、それ。",
   "zh": "那也太随便了吧。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "221/TALK",
   "narrator": "アーヤ",
   "text": "まあ、しっかりした子\nだから、理由なくサボる\nことはないと思うし――"
  },
  {
   "location": "222/TALK",
   "narrator": "アーヤ",
   "text": "来るのを待ちましょう。"
  },
  {
   "location": "224/TALK",
   "narrator": "ガブリエラ",
   "text": "もういいわよ。"
  },
  {
   "location": "225/TALK",
   "narrator": "ガブリエラ",
   "text": "来ないようなヤツを\n待つ必要なんてないわ。"
  },
  {
   "location": "227/TALK",
   "narrator": "ガブリエラ",
   "text": "待ってる間にも、\nやらなきゃいけない\n仕事は沢山あるんだし。"
  },
  {
   "location": "229/TALK",
   "narrator": "つばめ",
   "text": "が、ガブちゃん。\nそんな言い方しなく\nても…。",
   "zh": "加、加布酱。\n不用那么\n说也……。",
   "narrator_zh": "燕"
  },
  {
   "location": "231/TALK",
   "narrator": "みやび",
   "text": "…このまま来なかったら、\nどうする？"
  },
  {
   "location": "234/TALK",
   "narrator": "つばめ",
   "text": "え？",
   "zh": "诶？",
   "narrator_zh": "燕"
  },
  {
   "location": "237/TALK",
   "narrator": "みやび",
   "text": "いや、卯月もスパイいう\n可能性、捨てきれんし…。"
  },
  {
   "location": "238/TALK",
   "narrator": "つばめ",
   "text": "やめてください！\n冗談でも、ちょっと\n酷過ぎます！"
  },
  {
   "location": "239/TALK",
   "narrator": "つばめ",
   "text": "卯月さんのこと、\n悪く言わないでください！"
  },
  {
   "location": "240/TALK",
   "narrator": "ガブリエラ",
   "text": "な、何ムキになってん\nのよ？",
   "zh": "你、你较什么劲\n啊？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "242/TALK",
   "narrator": "つばめ",
   "text": "だ、だって…。",
   "zh": "可、可是……。",
   "narrator_zh": "燕"
  },
  {
   "location": "243/TALK",
   "narrator": "みやび",
   "text": "…つばめちゃん。\n本当は卯月のこと、\n何か知ってるんやないが？"
  },
  {
   "location": "244/TALK",
   "narrator": "つばめ",
   "text": "っ！？",
   "zh": "！？",
   "narrator_zh": "燕"
  },
  {
   "location": "246/TALK",
   "narrator": "アーヤ",
   "text": "そうなの、つばめ？",
   "zh": "是这样啊，燕？",
   "narrator_zh": "绫水"
  },
  {
   "location": "248/TALK",
   "narrator": "つばめ",
   "text": "…し、知りません。\nわたしは、何も…。"
  },
  {
   "location": "249/TALK",
   "narrator": "みやび",
   "text": "…そうか。",
   "zh": "……这样啊。",
   "narrator_zh": "雅"
  },
  {
   "location": "252/TALK",
   "narrator": "みやび",
   "text": "まあ、何にせよ仕事は\n待ってくれんき――"
  },
  {
   "location": "253/TALK",
   "narrator": "みやび",
   "text": "すっと仕事始めるちや。"
  },
  {
   "location": "258/TALK",
   "narrator": "ガブリエラ",
   "text": "はぁ…面倒くさい。\n勝手にサボられると\n本当迷惑よね…。",
   "zh": "唉……真麻烦。\n擅自偷懒真的\n很困扰呢……。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "261/TALK",
   "narrator": "つばめ",
   "text": "…………。"
  },
  {
   "location": "262/TALK",
   "narrator": "アーヤ",
   "text": "…ほら、元気出して。",
   "zh": "……好啦，打起精神来。",
   "narrator_zh": "绫水"
  },
  {
   "location": "263/TALK",
   "narrator": "アーヤ",
   "text": "卯月がいない分、\n私達が頑張らないと\nいけないんだから…ね？"
  },
  {
   "location": "265/TALK",
   "narrator": "つばめ",
   "text": "…はい。",
   "zh": "……是的。",
   "narrator_zh": "燕"
  },
  {
   "location": "266/ACT",
   "narrator": "",
   "text": "しらをきれ"
  },
  {
   "location": "267/TALK",
   "narrator": "つばめ",
   "text": "しらをきるもなにも"
  },
  {
   "location": "268/TALK",
   "narrator": "つばめ",
   "text": "わたしだってちゃんとした理由は知らなぃよ(´･ω･｀) "
  },
  {
   "location": "269/TALK",
   "narrator": "つばめ",
   "text": "おかぁさんのことかなとは思ったけど",
   "zh": "我本来就觉得是不是妈妈的事",
   "narrator_zh": "燕"
  },
  {
   "location": "270/TALK",
   "narrator": "つばめ",
   "text": "でも",
   "zh": "不过",
   "narrator_zh": "燕"
  },
  {
   "location": "271/TALK",
   "narrator": "つばめ",
   "text": "その話はしたくなぃし",
   "zh": "那件事我不想说",
   "narrator_zh": "燕"
  },
  {
   "location": "282/TALK",
   "narrator": "つばめ",
   "text": "え、えっと…。",
   "zh": "诶、那个……。",
   "narrator_zh": "燕"
  },
  {
   "location": "283/TALK",
   "narrator": "つばめ",
   "text": "多分、体調を崩したとか\nだと思いますよ？",
   "zh": "大概是身体不舒服\n之类的吧？",
   "narrator_zh": "燕"
  },
  {
   "location": "284/TALK",
   "narrator": "ガブリエラ",
   "text": "適当過ぎでしょ、それ。",
   "zh": "那也太随便了吧。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "286/ACT",
   "narrator": "",
   "text": "こっちが聞きたいって言えば",
   "zh": "要说这边才想问你呢",
   "narrator_zh": ""
  },
  {
   "location": "287/TALK",
   "narrator": "つばめ",
   "text": "ぅん",
   "zh": "嗯",
   "narrator_zh": "燕"
  },
  {
   "location": "288/TALK",
   "narrator": "つばめ",
   "text": "その通りだもんね",
   "zh": "确实是这样呢",
   "narrator_zh": "燕"
  },
  {
   "location": "299/TALK",
   "narrator": "つばめ",
   "text": "卯月さんのことは、\nわたしの方が聞きたい\nくらいです。"
  },
  {
   "location": "300/TALK",
   "narrator": "ガブリエラ",
   "text": "つばめも知らないの？\n卯月とあんなに\n仲良いのに？",
   "zh": "燕也不知道吗？\n明明跟卯月\n那么好？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "302/TALK",
   "narrator": "つばめ",
   "text": "…でも、全部知ってる\nわけじゃないから。"
  }
 ]
}
