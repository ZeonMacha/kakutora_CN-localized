{
    "dir": "chap10/daydra/dd_ch03_10_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "10356",
        "cid": "gabriella",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "レイティング",
        "title_zh": "Extra006 额外剧情",
        "sub_title_zh": "分级"
    },
    "entry": [
        {
            "location": "206/SCENARIO",
            "narrator": "",
            "text": "レイティング",
            "zh": "分级",
            "narrator_zh": ""
        },
        {
            "location": "222/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ！？\nあの映画、映画館に\n見に行ったの！？",
            "zh": "哈啊！？\n那部电影，你去电影院\n看了吗！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "225/TALK",
            "narrator": "つばめ",
            "text": "はい。すっごく面白くて\n二回も見ちゃいました。",
            "zh": "是的。超级有意思，\n我都去看了两遍啦。",
            "narrator_zh": "燕"
        },
        {
            "location": "228/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、あれって公開したの\n五年くらい前でしょ？",
            "zh": "可是，那部片子上映\n大概是五年前的事了吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "230/TALK",
            "narrator": "ガブリエラ",
            "text": "あんた小学生じゃない！\n高校生未満は見れない\nはずでしょ？",
            "zh": "你那会儿还是小学生吧！\n未满高中生应该\n不能看的吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "233/TALK",
            "narrator": "アーヤ",
            "text": "え？　特に年齢制限は\nなかったと思うけど…。",
            "zh": "咦？我记得好像没有\n特别的年龄限制啊……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "235/TALK",
            "narrator": "みやび",
            "text": "『クライシス・ジュピ\nター』は年齢制限付いて\nないぞね。",
            "zh": "《危机・木星》\n是没有加年龄限制\n的啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "237/TALK",
            "narrator": "ガブリエラ",
            "text": "そんな…あたしの国じゃ\n高校生未満はダメって\nなってるのに…。",
            "zh": "怎么这样……明明在我老家\n未满高中生是不准\n看的说……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "239/TALK",
            "narrator": "神楽",
            "text": "レイティングが\n違ったんですね。",
            "zh": "原来是分级制度\n不一样呢。",
            "narrator_zh": "神乐"
        },
        {
            "location": "241/TALK",
            "narrator": "みやび",
            "text": "日本では小学生でも\n見られるちや。",
            "zh": "在日本连小学生\n也能看咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "242/TALK",
            "narrator": "ガブリエラ",
            "text": "あ、あたしが、高校生に\nなるまでずっと我慢してる\n映画なのに…。",
            "zh": "明、明明是我一直忍到\n上高中才能看的\n电影说……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "245/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、日本のレイティング\nだと見ても良いのよね？",
            "zh": "不过，按日本的分级\n来看的话，是可以看的对吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "246/TALK",
            "narrator": "ガブリエラ",
            "text": "つまり、見ようと思えば\n今日にでも見ることが\nできるんじゃ…。",
            "zh": "也就是说，只要我想看，\n今天之内就能\n看得到……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "258/TALK",
            "narrator": "ガブリエラ",
            "text": "ねえ、マルザンナ",
            "zh": "喂，玛尔赞娜",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "259/TALK",
            "narrator": "ガブリエラ",
            "text": "私の国では年齢制限のあった映画が",
            "zh": "在我老家有年龄限制的电影",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "260/TALK",
            "narrator": "ガブリエラ",
            "text": "日本では年齢制限がなくて、誰でも見れるらしいの",
            "zh": "在日本好像没有年龄限制，谁都能看",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "262/SEL",
            "narrator": "",
            "text": "なるほど",
            "zh": "原来如此",
            "narrator_zh": ""
        },
        {
            "location": "263/ACT",
            "narrator": "",
            "text": "なるほど",
            "zh": "原来如此",
            "narrator_zh": ""
        },
        {
            "location": "265/TALK",
            "narrator": "ガブリエラ",
            "text": "だからね",
            "zh": "所以呀",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "266/TALK",
            "narrator": "ガブリエラ",
            "text": "今は日本にいるんだから",
            "zh": "我现在既然人在日本",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "267/TALK",
            "narrator": "ガブリエラ",
            "text": "私も見て良いのかな、って…",
            "zh": "是不是也可以看看呢，我在想……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "269/SEL",
            "narrator": "",
            "text": "絶対に見た方が良い",
            "zh": "绝对看比较好",
            "narrator_zh": ""
        },
        {
            "location": "270/SEL",
            "narrator": "",
            "text": "不良になっちゃうよ？",
            "zh": "会变成不良少女哦？",
            "narrator_zh": ""
        },
        {
            "location": "271/ACT",
            "narrator": "",
            "text": "絶対に見た方が良い",
            "zh": "绝对看比较好",
            "narrator_zh": ""
        },
        {
            "location": "273/TALK",
            "narrator": "ガブリエラ",
            "text": "マルザンナもそう思う？",
            "zh": "玛尔赞娜也这么觉得吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "274/TALK",
            "narrator": "ガブリエラ",
            "text": "よかった",
            "zh": "太好了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "275/TALK",
            "narrator": "ガブリエラ",
            "text": "あなたがそう言ってくれるなら、見てみようかしら",
            "zh": "既然你都这么说了，那我就看看好了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "286/TALK",
            "narrator": "ガブリエラ",
            "text": "誰か、ＤＶＤ持ってる？",
            "zh": "谁手里有ＤＶＤ吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "287/TALK",
            "narrator": "みやび",
            "text": "うちが持っとるき、\n寮に戻ったら貸すがよ。",
            "zh": "我手里有啵，\n回宿舍就借给你咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "290/TALK",
            "narrator": "神楽",
            "text": "良かったですね。\nポーランドにいたら、\nあと一年お預けでしたよ？",
            "zh": "太好了呢。\n要是在波兰的话，\n还得再等一年才能看哦？",
            "narrator_zh": "神乐"
        },
        {
            "location": "291/TALK",
            "narrator": "アーヤ",
            "text": "もうすぐ続編もやるみたい\nだし、その前に見られ\nそうで良かったわね。",
            "zh": "好像很快就要出续集了，\n能在那之前看到\n真是太好了呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "292/TALK",
            "narrator": "ガブリエラ",
            "text": "贅沢を言うなら、もう少し\n早く知りたかったけど。",
            "zh": "要说贪心点的话，真想\n再早点知道这件事呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "293/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、思ってたより一年\n早く見られるなんて、\n凄く嬉しいわ。",
            "zh": "不过，能比预想中\n提前一年看到，\n我真的超开心的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "295/TALK",
            "narrator": "ガブリエラ",
            "text": "それに、ちょっとだけ\n悪いことしてるみたいで\nドキドキもするし…。",
            "zh": "而且，感觉好像在做\n一点点坏事似的，\n心跳也加速了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "296/TALK",
            "narrator": "ガブリエラ",
            "text": "早く夜にならないかしら？",
            "zh": "怎么还不快点到晚上呀？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "314/ACT",
            "narrator": "",
            "text": "不良になっちゃうよ？",
            "zh": "会变成不良少女哦？",
            "narrator_zh": ""
        },
        {
            "location": "315/TALK",
            "narrator": "ガブリエラ",
            "text": "わ、私が不良に！？",
            "zh": "我、我会变成不良少女！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "316/TALK",
            "narrator": "ガブリエラ",
            "text": "そんなの絶対ダメよ！",
            "zh": "那种事绝对不行！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "318/TALK",
            "narrator": "ガブリエラ",
            "text": "私は不良とは縁遠い存在なんだから！",
            "zh": "我可是跟不良少女八竿子打不着的存在啊！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "319/TALK",
            "narrator": "ガブリエラ",
            "text": "やっぱり、あと一年我慢するわ",
            "zh": "我还是再忍一年好了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "320/TALK",
            "narrator": "ガブリエラ",
            "text": "止めてくれてありがとう、\nマルザンナ",
            "zh": "谢谢你拦住我，\n玛尔赞娜",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "331/TALK",
            "narrator": "みやび",
            "text": "見たいならうちのＤＶＤ\n貸すけんど、どうする？",
            "zh": "想看的话我把ＤＶＤ\n借你，不过你看不？",
            "narrator_zh": "雅"
        },
        {
            "location": "332/TALK",
            "narrator": "ガブリエラ",
            "text": "…あと一年、我慢するわ。\nまだ不良にはなりたく\nないし。",
            "zh": "……我还是再忍一年吧。\n我还不想变成\n不良少女呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "333/TALK",
            "narrator": "アーヤ",
            "text": "不良にはならないって。\n日本は誰でも見られる\n映画なんだし――",
            "zh": "都说了不会变成不良的。\n这在日本是所有人都能\n看的电影嘛——",
            "narrator_zh": "绫水"
        },
        {
            "location": "334/TALK",
            "narrator": "アーヤ",
            "text": "内容だって、卑猥だったり\nグロテスクだったりする\nわけじゃないのよ？",
            "zh": "内容也不是什么\n低俗或者血腥猎奇\n的东西哦？",
            "narrator_zh": "绫水"
        },
        {
            "location": "336/TALK",
            "narrator": "つばめ",
            "text": "登場人物の台詞が、\nちょっとだけ汚かった\nですけど…。",
            "zh": "虽然登场人物的台词，\n稍微有一点点\n粗俗啦……。",
            "narrator_zh": "燕"
        },
        {
            "location": "337/TALK",
            "narrator": "ガブリエラ",
            "text": "いいんだってば。\n日本にいても、あたしは\nポーランド人なんだし。",
            "zh": "不用了啦。\n就算身在日本，我也还是\n波兰人嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "338/TALK",
            "narrator": "ガブリエラ",
            "text": "自分の国のルールに\n従って、あと一年だけ\n我慢するわ。",
            "zh": "我要遵守自己国家的\n规定，就再忍\n一年好了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "340/TALK",
            "narrator": "アーヤ",
            "text": "もぉ、変なところで\nマジメなんだから。",
            "zh": "真是的，偏偏在这种\n奇怪的地方这么认真。",
            "narrator_zh": "绫水"
        },
        {
            "location": "342/TALK",
            "narrator": "ガブリエラ",
            "text": "…あたしだって、できれば\nすぐにでも見たいわよ！",
            "zh": "……我当然也想，\n可以的话现在就想看啊！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "343/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、あたしは不良じゃ\nないんだし。\nもう少しの我慢よ！",
            "zh": "不过，我又不是\n不良少女。\n再忍一忍就好了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "219/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>6月14日　12:38 PM</color>\nとある昼休み、学食横の自販機コーナーにて。",
            "zh": "<color=green>6月14日　12:38 PM</color>\n某个午休时间，在食堂旁边的自动售货机角。",
            "narrator_zh": "Dialog_EventData"
        },
        {
            "location": "308/DIALOG",
            "narrator": "Dialog_GEThimegoto_ch03",
            "text": "【クライシス・クライシス】",
            "zh": "【危机·危机】",
            "narrator_zh": "Dialog_GEThimegoto_ch03"
        }
    ]
}
