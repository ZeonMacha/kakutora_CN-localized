{
    "dir": "chap31/daydra/dd_ch03_31_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "31305",
        "cid": "gabriella",
        "title": "005 メインストーリー",
        "sub_title": "兎穴の入り口で＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "在兔洞入口＜后篇＞"
    },
    "entry": [
        {
            "location": "659/SCENARIO",
            "narrator": "",
            "text": "その底には",
            "zh": "在那深处",
            "narrator_zh": ""
        },
        {
            "location": "674/TALK",
            "narrator": "ガブリエラ",
            "text": "……ん……。",
            "zh": "……唔……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "677/TALK",
            "narrator": "ガブリエラ",
            "text": "ダイブ成功\nしたのかしら…？",
            "zh": "潜入成功\n了吗……？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "678/SEL",
            "narrator": "",
            "text": "おつかれさま",
            "zh": "辛苦啦",
            "narrator_zh": ""
        },
        {
            "location": "679/ACT",
            "narrator": "",
            "text": "おつかれさま",
            "zh": "辛苦啦",
            "narrator_zh": ""
        },
        {
            "location": "683/TALK",
            "narrator": "ガブリエラ",
            "text": "$handle$？\nってことはこれ\n成功したのよね？",
            "zh": "$handle$？\n也就是说这下\n是成功了呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "684/SEL",
            "narrator": "",
            "text": "一応",
            "zh": "姑且算是",
            "narrator_zh": ""
        },
        {
            "location": "685/SEL",
            "narrator": "",
            "text": "当然",
            "zh": "那当然",
            "narrator_zh": ""
        },
        {
            "location": "686/ACT",
            "narrator": "",
            "text": "一応",
            "zh": "姑且算是",
            "narrator_zh": ""
        },
        {
            "location": "687/TALK",
            "narrator": "ガブリエラ",
            "text": "そうよね。",
            "zh": "也是呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "688/ACT",
            "narrator": "",
            "text": "当然",
            "zh": "那当然",
            "narrator_zh": ""
        },
        {
            "location": "690/TALK",
            "narrator": "ガブリエラ",
            "text": "強気ね。",
            "zh": "口气真大呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "693/TALK",
            "narrator": "ガブリエラ",
            "text": "それにしてもアーヤは\nどこにいるのかしら。",
            "zh": "话说回来，绫水\n到底在哪里呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "694/SEL",
            "narrator": "",
            "text": "その前に会わせたい人が",
            "zh": "在那之前有个人想介绍给你",
            "narrator_zh": ""
        },
        {
            "location": "695/SEL",
            "narrator": "",
            "text": "スペシャルゲストが\nいるんだ",
            "zh": "有特别嘉宾\n在这里哦",
            "narrator_zh": ""
        },
        {
            "location": "696/SEL",
            "narrator": "",
            "text": "すごい人に会えるよ",
            "zh": "能见到厉害的人哦",
            "narrator_zh": ""
        },
        {
            "location": "697/ACT",
            "narrator": "",
            "text": "その前に会わせたい人が",
            "zh": "在那之前有个人想介绍给你",
            "narrator_zh": ""
        },
        {
            "location": "700/TALK",
            "narrator": "ガブリエラ",
            "text": "誰？\nまさか音羽？",
            "zh": "谁呀？\n该不会是音羽？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "701/ACT",
            "narrator": "",
            "text": "スペシャルゲストが\nいるんだ",
            "zh": "有特别嘉宾\n在这里哦",
            "narrator_zh": ""
        },
        {
            "location": "704/TALK",
            "narrator": "ガブリエラ",
            "text": "スペシャル？\nどういうこと？",
            "zh": "特别？\n是什么意思？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "705/ACT",
            "narrator": "",
            "text": "すごい人に会えるよ",
            "zh": "能见到厉害的人哦",
            "narrator_zh": ""
        },
        {
            "location": "708/TALK",
            "narrator": "ガブリエラ",
            "text": "誰のこと？",
            "zh": "你指的是谁啊？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "716/TALK",
            "narrator": "エリカ",
            "text": "こんにちは？",
            "zh": "你好呀？",
            "narrator_zh": "领火"
        },
        {
            "location": "719/TALK",
            "narrator": "ガブリエラ",
            "text": "！！",
            "zh": "！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "720/TALK",
            "narrator": "エリカ",
            "text": "あなたアヤちゃんの\nお友達よね？",
            "zh": "你是绫水的\n朋友对吧？",
            "narrator_zh": "领火"
        },
        {
            "location": "722/TALK",
            "narrator": "ガブリエラ",
            "text": "ガブリエラ・\nロタルィンスカよ。",
            "zh": "我是加布里埃拉·\n洛塔琳斯卡。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "723/TALK",
            "narrator": "ガブリエラ",
            "text": "あなたは？",
            "zh": "请问你是？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "724/TALK",
            "narrator": "エリカ",
            "text": "エリカです。\nアヤちゃんの姉です。",
            "zh": "我是领火。\n是绫水的姐姐哦。",
            "narrator_zh": "领火"
        },
        {
            "location": "725/TALK",
            "narrator": "ガブリエラ",
            "text": "あ…！",
            "zh": "啊……！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "726/SEL",
            "narrator": "",
            "text": "びっくりした？",
            "zh": "吓了一跳吧？",
            "narrator_zh": ""
        },
        {
            "location": "727/ACT",
            "narrator": "",
            "text": "びっくりした？",
            "zh": "吓了一跳吧？",
            "narrator_zh": ""
        },
        {
            "location": "730/TALK",
            "narrator": "ガブリエラ",
            "text": "したわよ！\n当たり前じゃない！",
            "zh": "吓了一跳好吗！\n这不是废话吗！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "732/TALK",
            "narrator": "ガブリエラ",
            "text": "そうだ。\nあたしアーヤを\n迎えに来て…。",
            "zh": "对了。\n我是来接\n绫水的……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "734/TALK",
            "narrator": "エリカ",
            "text": "アヤちゃん、\nちょっと取り込み中\nなんだけど。",
            "zh": "绫水她呀，\n现在有点\n脱不开身呢。",
            "narrator_zh": "领火"
        },
        {
            "location": "735/TALK",
            "narrator": "エリカ",
            "text": "行ってみましょうか。",
            "zh": "我们过去看看吧。",
            "narrator_zh": "领火"
        },
        {
            "location": "759/TALK",
            "narrator": "アーヤ",
            "text": "問題はそこよね。",
            "zh": "问题就在那里呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "767/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤ？\n何一人で話してるの？",
            "zh": "绫水？\n干嘛一个人在自言自语？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "770/TALK",
            "narrator": "エリカ",
            "text": "確かにそう\n見えるかも。",
            "zh": "确实看起来\n像那样呢。",
            "narrator_zh": "领火"
        },
        {
            "location": "773/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィ？\nと、お姉ちゃん！",
            "zh": "加维？\n还有，姐姐！",
            "narrator_zh": "绫水"
        },
        {
            "location": "774/TALK",
            "narrator": "ガブリエラ",
            "text": "あんまり遅いから\n迎えに来たのよ。",
            "zh": "看你迟迟不出来，\n我才过来接你的啦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "777/TALK",
            "narrator": "エリカ",
            "text": "お姉ちゃん知ってる。\nこういうのツンデレって\n言うんでしょ。",
            "zh": "姐姐我知道哦。\n这种就叫\n傲娇对吧。",
            "narrator_zh": "领火"
        },
        {
            "location": "781/TALK",
            "narrator": "ガブリエラ",
            "text": "…！？！？",
            "zh": "……！？！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "782/TALK",
            "narrator": "アーヤ",
            "text": "独り言じゃないわ。\n音羽と話してたの。",
            "zh": "不是自言自语。\n我是在和音羽说话。",
            "narrator_zh": "绫水"
        },
        {
            "location": "784/TALK",
            "narrator": "ガブリエラ",
            "text": "…お姉さんの発言\n完全にスルーしたわ\nアーヤったら…。",
            "zh": "……把姐姐的话\n完全无视掉了啊，\n绫水真是的……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "788/TALK",
            "narrator": "音羽",
            "text": "この空間で私は\n形になれないの。\n声だけでごめんなさい。",
            "zh": "在这个空间里，\n我无法成形。\n只能用声音对话，抱歉。",
            "narrator_zh": "音羽"
        },
        {
            "location": "791/TALK",
            "narrator": "ガブリエラ",
            "text": "そういうことなの…。",
            "zh": "原来是这么回事……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "792/TALK",
            "narrator": "音羽",
            "text": "アーヤさんが戻るのが\n遅くなったのも\n理由があるの。",
            "zh": "绫水之所以\n回来得这么晚，\n也是有原因的。",
            "narrator_zh": "音羽"
        },
        {
            "location": "793/TALK",
            "narrator": "音羽",
            "text": "近いうちに\n神楽はつばめさんの\nいる場所で歌を歌う。",
            "zh": "在不久之后，\n神乐会在燕所在的\n地方唱歌。",
            "narrator_zh": "音羽"
        },
        {
            "location": "794/TALK",
            "narrator": "音羽",
            "text": "希望の心を破壊する歌を。",
            "zh": "唱出破坏希望之心的歌。",
            "narrator_zh": "音羽"
        },
        {
            "location": "795/TALK",
            "narrator": "音羽",
            "text": "そうなったら\nこの世界は終わる。\n書き換えられてしまう。",
            "zh": "一旦那样，\n这个世界就会终结。\n被彻底改写。",
            "narrator_zh": "音羽"
        },
        {
            "location": "796/TALK",
            "narrator": "音羽",
            "text": "その歌を無効化する\nには私が神楽に\nコネクトする必要がある。",
            "zh": "为了将那首歌无效化，\n我必须与神乐\n进行连接。",
            "narrator_zh": "音羽"
        },
        {
            "location": "797/TALK",
            "narrator": "音羽",
            "text": "でも今神楽は敵陣にいる。",
            "zh": "但如今神乐身在敌阵。",
            "narrator_zh": "音羽"
        },
        {
            "location": "798/TALK",
            "narrator": "音羽",
            "text": "それにガードも\nされてるだろうし。",
            "zh": "而且想必\n也设有重重防护。",
            "narrator_zh": "音羽"
        },
        {
            "location": "799/TALK",
            "narrator": "音羽",
            "text": "コネクトが\n可能なのか\nどうか……。",
            "zh": "究竟还能不能\n进行连接\n都未可知……。",
            "narrator_zh": "音羽"
        },
        {
            "location": "800/TALK",
            "narrator": "アーヤ",
            "text": "…せっかく音羽が\n協力してくれるって\n言ってくれたのに…。",
            "zh": "……好不容易音羽\n都说愿意\n协助我们了……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "802/TALK",
            "narrator": "エリカ",
            "text": "大丈夫よ。\n方法はある。",
            "zh": "没关系哦。\n办法还是有的。",
            "narrator_zh": "领火"
        },
        {
            "location": "805/TALK",
            "narrator": "ガブリエラ",
            "text": "！",
            "zh": "！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "806/TALK",
            "narrator": "アーヤ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "808/TALK",
            "narrator": "エリカ",
            "text": "まほちゃんが普段\n劇場で使っている\n司令塔システムあるよね。",
            "zh": "真幌平时在剧场\n不是有用那个\n司令塔系统吗。",
            "narrator_zh": "领火"
        },
        {
            "location": "809/TALK",
            "narrator": "エリカ",
            "text": "劇場のスクリーン\nホロが沢山出る、\nアレのことなんだけど。",
            "zh": "就是那个会在剧场\n屏幕上投出好多全息影像\n的玩意儿啦。",
            "narrator_zh": "领火"
        },
        {
            "location": "810/TALK",
            "narrator": "エリカ",
            "text": "あのシステムは、特定の\nトライガジェットに対し\nクランをコネクトできる。",
            "zh": "那个系统可以对\n特定的Tri-Gadget\n连接库兰哦。",
            "narrator_zh": "领火"
        },
        {
            "location": "811/TALK",
            "narrator": "ガブリエラ",
            "text": "そうね。普段まほが\nあたしたちにやってる\nアレよね。",
            "zh": "是啊。平时真幌\n就是用那个\n对我们那样做的嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "813/TALK",
            "narrator": "エリカ",
            "text": "うん。一応あのシステム、\nまほちゃん名義のトライ\nガジェットなんだよ？",
            "zh": "嗯。其实那个系统，\n姑且也是真幌名下的\nTri-Gadget哦？",
            "narrator_zh": "领火"
        },
        {
            "location": "815/TALK",
            "narrator": "ガブリエラ",
            "text": "ええっ！？　あれも\nトライガジェットなの！？",
            "zh": "哎哎！？　那个也是\nTri-Gadget吗！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "816/TALK",
            "narrator": "エリカ",
            "text": "うん。家のパソコンも\nサーバー機も、中身は\n同じでしょ？",
            "zh": "嗯。家里的电脑和\n服务器主机，本质上\n都是一样的对吧？",
            "narrator_zh": "领火"
        },
        {
            "location": "817/TALK",
            "narrator": "エリカ",
            "text": "そんな感じ。",
            "zh": "就是那种感觉啦。",
            "narrator_zh": "领火"
        },
        {
            "location": "819/TALK",
            "narrator": "アーヤ",
            "text": "…？？？",
            "zh": "……？？？",
            "narrator_zh": "绫水"
        },
        {
            "location": "822/TALK",
            "narrator": "エリカ",
            "text": "でね、今まで神楽ちゃんに\nコネクトをしていたなら、\n今もまだ理論上はできる。",
            "zh": "然后呢，既然以前曾经\n和神乐连接过，\n那现在理论上也还行得通。",
            "narrator_zh": "领火"
        },
        {
            "location": "824/TALK",
            "narrator": "エリカ",
            "text": "音羽ちゃんの修復を完了\nさせた後で、劇場の\nシステムに登録すれば――",
            "zh": "等把音羽的修复\n完成之后，再登录到\n剧场的系统里——",
            "narrator_zh": "领火"
        },
        {
            "location": "825/TALK",
            "narrator": "エリカ",
            "text": "いつもまほちゃんが\nやってるのと同じ方法で、\nコネクト可能ってわけ。",
            "zh": "用真幌平时\n一直在做的那种方法，\n就能实现连接了。",
            "narrator_zh": "领火"
        },
        {
            "location": "826/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、そもそも神楽が\nガジェット起動して\nいなかったら無理でしょ？",
            "zh": "可是，要是神乐\n根本没启动Gadget的话，\n那不还是办不到吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "828/TALK",
            "narrator": "エリカ",
            "text": "普段はね。でもそこは、\n一部のプログラムを\n書き換えればできる。",
            "zh": "平时确实是这样啦。但那点，\n只要改写掉一部分\n程序就能办到哦。",
            "narrator_zh": "领火"
        },
        {
            "location": "832/TALK",
            "narrator": "アーヤ",
            "text": "え……嘘でしょ！？",
            "zh": "哎……不会吧！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "834/TALK",
            "narrator": "ガブリエラ",
            "text": "怖すぎるんですけど！！",
            "zh": "这也太可怕了吧！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "835/TALK",
            "narrator": "エリカ",
            "text": "気持ちはわかるけど、\n機械的見地から見ると\n普通のことだよ……。",
            "zh": "我能理解你们的心情，但从\n机械角度来看，这其实是\n很普通的事哦……。",
            "narrator_zh": "领火"
        },
        {
            "location": "836/TALK",
            "narrator": "エリカ",
            "text": "例えば、エレベーターは\n本気出せば人を挟んで\n殺すことができるし――",
            "zh": "比方说，电梯要是\n动真格的话，也是能把人\n夹死在里面的——",
            "narrator_zh": "领火"
        },
        {
            "location": "837/TALK",
            "narrator": "エリカ",
            "text": "もっと極端な例だと、\n車を運転する人は、\n今すぐ人をひけるよね？",
            "zh": "再举个更极端的例子，\n开车的人随时都能\n把人撞飞对吧？",
            "narrator_zh": "领火"
        },
        {
            "location": "838/TALK",
            "narrator": "エリカ",
            "text": "世の中の殆どのものは、\nルールとセキュリティで\n惨事を防いでるだけ。",
            "zh": "这世上的绝大多数东西，\n都只是靠规则和安防\n在防止惨剧发生而已。",
            "narrator_zh": "领火"
        },
        {
            "location": "839/TALK",
            "narrator": "エリカ",
            "text": "トライガジェットも同じ。\nやろうと思えば出来る\nことを規制してるだけ。",
            "zh": "Tri-Gadget也一样。\n只是把真想做就能做到的事\n给限制住了而已。",
            "narrator_zh": "领火"
        },
        {
            "location": "842/TALK",
            "narrator": "ガブリエラ",
            "text": "まあ、確かに\n言われてみればそうよね。",
            "zh": "嘛，听你这么一说，\n确实是这样呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "844/TALK",
            "narrator": "アーヤ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "845/TALK",
            "narrator": "エリカ",
            "text": "ただ、プログラムの\n書き換えには、みやび\nちゃんの手を借りたい。",
            "zh": "只不过，改写程序\n这件事，我想借用一下\n雅的力量。",
            "narrator_zh": "领火"
        },
        {
            "location": "846/TALK",
            "narrator": "エリカ",
            "text": "みやびちゃん、\nそういうの得意だよね。",
            "zh": "雅她很擅长\n这种活儿对吧。",
            "narrator_zh": "领火"
        },
        {
            "location": "849/TALK",
            "narrator": "ガブリエラ",
            "text": "この話聞いたら、\nみやび、すっごい\n喜びそうだわね……。",
            "zh": "要是听到这件事，\n雅肯定会高兴得\n不得了吧……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "851/TALK",
            "narrator": "エリカ",
            "text": "ここまでの準備ができたら\nあとは神楽ちゃんを\n目視できる所に行くだけ。",
            "zh": "做好这些准备之后，\n剩下的就只是去到\n能目视神乐的地方而已。",
            "narrator_zh": "领火"
        },
        {
            "location": "852/TALK",
            "narrator": "エリカ",
            "text": "劇場のシステムで\nガジェットを捕捉すれば、\nコネクトは可能なはず。",
            "zh": "只要剧场的系统\n捕捉到了Gadget，\n应该就能成功连接。",
            "narrator_zh": "领火"
        },
        {
            "location": "854/TALK",
            "narrator": "エリカ",
            "text": "もちろん、全ては\n机上の空論だから、\nどこかに穴があるかも。",
            "zh": "当然，这一切都只是\n纸上谈兵，说不定\n哪里还存在漏洞。",
            "narrator_zh": "领火"
        },
        {
            "location": "855/TALK",
            "narrator": "エリカ",
            "text": "それに、\n一度ミスしたらもう\n次はないかもしれない。",
            "zh": "而且，\n一旦失手一次，可能就\n再也没有下一次机会了。",
            "narrator_zh": "领火"
        },
        {
            "location": "857/TALK",
            "narrator": "アーヤ",
            "text": "失敗はしないわ。",
            "zh": "我不会失手的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "858/TALK",
            "narrator": "音羽",
            "text": "…どうやってでも\n成功させる。",
            "zh": "……无论用什么办法，\n我都会让它成功。",
            "narrator_zh": "音羽"
        },
        {
            "location": "860/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしも\nフォローするわ。",
            "zh": "我也会\n全力掩护的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "861/SEL",
            "narrator": "",
            "text": "$me$も",
            "zh": "$me$也是",
            "narrator_zh": ""
        },
        {
            "location": "862/ACT",
            "narrator": "",
            "text": "$me$も",
            "zh": "$me$也是",
            "narrator_zh": ""
        },
        {
            "location": "867/TALK",
            "narrator": "ガブリエラ",
            "text": "そうね",
            "zh": "是啊",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "868/TALK",
            "narrator": "ガブリエラ",
            "text": "頼りにしてる",
            "zh": "我可指望着你呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "870/TALK",
            "narrator": "ガブリエラ",
            "text": "世界で一番",
            "zh": "在这个世界上最指望你",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "871/TALK",
            "narrator": "ガブリエラ",
            "text": "本当に",
            "zh": "真心的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "882/DIALOG",
            "narrator": "Dialog_chapter_ch03",
            "text": "【25 ワールド・スピード】",
            "zh": "【25 World Speed】",
            "narrator_zh": "Dialog_chapter_ch03"
        }
    ]
}
