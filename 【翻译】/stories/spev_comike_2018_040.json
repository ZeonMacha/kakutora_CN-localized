{
    "dir": "chap00/daydra/spev_comike_2018_040.js",
    "type": "",
    "info": {
        "story_id": "91074",
        "cid": "",
        "title": "がすとちゃんサマー大作戦♪",
        "sub_title": "作戦４：オモテウラ拡張のご案内",
        "title_zh": "GUST酱的夏日大作战♪",
        "sub_title_zh": "作战4：表里扩展指南"
    },
    "entry": [
        {
            "location": "969/SCENARIO",
            "narrator": "",
            "text": "ウラオモテ",
            "zh": "里表",
            "narrator_zh": ""
        },
        {
            "location": "1018/TALK",
            "narrator": "がすとちゃん",
            "text": "アイルビーバック！\nですの！",
            "zh": "I'll be back！\n的说！",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1023/TALK",
            "narrator": "がすとちゃん",
            "text": "皆さんの声に応えて\nまたしても登場する\nがすとちゃんですの。",
            "zh": "响应大家的呼声\n再度登场的\nGUST酱的说。",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1028/TALK",
            "narrator": "がすとちゃん",
            "text": "今回もまた、\n夏の一大イベント情報を\nお届けするですのー！",
            "zh": "这一次也要再次\n为各位送上夏季大型活动的\n情报的说——！",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1030/TALK",
            "narrator": "がすとちゃん",
            "text": "$handle$も、\n全力でレジに並ぶ準備は\nできてるですの？",
            "zh": "$handle$也已经做好\n全力冲去收银台排队的\n准备了吗的说？",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1031/SEL",
            "narrator": "（選択肢）",
            "text": "言われなくとも",
            "zh": "不用你说",
            "narrator_zh": "（选项）"
        },
        {
            "location": "1032/SEL",
            "narrator": "（選択肢）",
            "text": "出たな守銭奴！",
            "zh": "出现了，守财奴！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "1033/SEL",
            "narrator": "（選択肢）",
            "text": "レジに行くとお前ボコれるの？",
            "zh": "去收银台就能把你揍一顿吗？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "1034/ACT",
            "narrator": "",
            "text": "言われなくとも",
            "zh": "不用你说",
            "narrator_zh": ""
        },
        {
            "location": "1036/TALK",
            "narrator": "がすとちゃん",
            "text": "それでこそ\nがすとが見込んだ\n$handle$ですの。",
            "zh": "不愧是\nGUST酱看中的\n$handle$的说。",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1037/TALK",
            "narrator": "がすとちゃん",
            "text": "こちらも全力で\n$handle$の\nお越しを待ってるですの！",
            "zh": "这边也会全力以赴地\n等待着$handle$\n大驾光临的说！",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1038/ACT",
            "narrator": "",
            "text": "出たな守銭奴！",
            "zh": "出现了，守财奴！",
            "narrator_zh": ""
        },
        {
            "location": "1056/TALK",
            "narrator": "がすとちゃん",
            "text": "だーかーらー！\n純粋な商売人に向かって\n守銭奴とは何ですの！！",
            "zh": "都—说—了—！\n对着纯粹的商人\n叫什么守财奴的说！！",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1057/TALK",
            "narrator": "がすとちゃん",
            "text": "がすとは皆さんの\nハッピーな散財を\n願っているだけですの。",
            "zh": "GUST酱只不过是\n祝愿大家都能快乐散财\n而已的说。",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1058/ACT",
            "narrator": "",
            "text": "レジに行くとお前ボコれるの？",
            "zh": "去收银台就能把你揍一顿吗？",
            "narrator_zh": ""
        },
        {
            "location": "1068/TALK",
            "narrator": "がすとちゃん",
            "text": "おっ、やるですの？",
            "zh": "哦，要单挑吗的说？",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1069/TALK",
            "narrator": "がすとちゃん",
            "text": "$handle$は\nもしかしたら\n知らないかもですけど──",
            "zh": "$handle$\n说不定还不清楚，\n不过——",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1070/TALK",
            "narrator": "がすとちゃん",
            "text": "じつは超ド級の強さを誇る\nがすとちゃんに向かって\nいい度胸してるですの。",
            "zh": "对着其实拥有超弩级实力的\nGUST酱敢说这种话，\n胆子倒是不小的说。",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1072/TALK",
            "narrator": "がすとちゃん",
            "text": "レジで会えたら\n真心込めてお相手する\nですの！！",
            "zh": "要是在收银台见了面，\n定会怀着一颗真心陪你过招\n的说！！",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1075/TALK",
            "narrator": "がすとちゃん",
            "text": "…というわけで、\nさっそく今回の商品を\n紹介するですの。",
            "zh": "……于是乎，\n这就马上来介绍\n本次的商品的说。",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1078/DIALOG",
            "narrator": "",
            "text": "オモテウラ拡張グッズセット",
            "zh": "表里扩展周边套装",
            "narrator_zh": ""
        },
        {
            "location": "1081/TALK",
            "narrator": "がすとちゃん",
            "text": "はい、ジャジャーン！",
            "zh": "来，锵锵——！",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1082/TALK",
            "narrator": "がすとちゃん",
            "text": "「トライナリーの\nオモテウラ拡張グッズ\nセット」ですの！！",
            "zh": "正是「三重奏的\n表里扩展周边\n套装」的说！！",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1084/TALK",
            "narrator": "がすとちゃん",
            "text": "これも、前回紹介した\n『ソラノキヲク』の\n異世界限定版と同様──",
            "zh": "这也和上次介绍过的\n《天空的记忆》\n异世界限定版一样——",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1085/TALK",
            "narrator": "がすとちゃん",
            "text": "KADOKAWAブースで\n販売される新商品ですの。",
            "zh": "是在KADOKAWA展位\n贩售的新商品的说。",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1086/TALK",
            "narrator": "がすとちゃん",
            "text": "コーエーテクモゲームスの\nブースでは売ってないから\n注意してほしいですの。",
            "zh": "光荣特库摩游戏的\n展位可买不到，\n请注意的说。",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1087/TALK",
            "narrator": "がすとちゃん",
            "text": "内容は、\nオモテウラ拡張グッズ\nという名前の通り…",
            "zh": "套装内容，\n正如“表里扩展周边”\n这个名字所示……",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1089/TALK",
            "narrator": "がすとちゃん",
            "text": "トライナリーの\n表と裏が見れちゃう\nグッズのセットですの。",
            "zh": "是能同时看到三重奏的\n“表”与“里”两面的\n周边套装的说。",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1095/DIALOG",
            "narrator": "",
            "text": "日めくりカレンダー",
            "zh": "撕页日历",
            "narrator_zh": ""
        },
        {
            "location": "1097/TALK",
            "narrator": "がすとちゃん",
            "text": "表のグッズは、\nヒロインのコメント入り\n日めくりカレンダー！",
            "zh": "“表”的周边，\n是附带女主角评论的\n撕页日历！",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1098/TALK",
            "narrator": "がすとちゃん",
            "text": "月の始まりから終わりまで\nヒロインのメッセージや\nイラストが拝めるですの。",
            "zh": "从月初直到月末，\n天天都能拜读到女主角们的\n寄语和插画的说。",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1100/TALK",
            "narrator": "がすとちゃん",
            "text": "これを毎日めくって、\n日々の元気を貰うですの♪",
            "zh": "每天撕下一页这个，\n就能收获每日的元气了的说♪",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1101/TALK",
            "narrator": "がすとちゃん",
            "text": "表紙と、締めくくりの\n31日のイラストも\n描き下ろしですから──",
            "zh": "封面以及收尾第31天的\n插画也都是\n全新绘制的——",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1102/TALK",
            "narrator": "がすとちゃん",
            "text": "そこに書かれている\nメッセージとあわせて\n現物を要チェックですの！",
            "zh": "连同上面写着的\n寄语一起，\n实物务必一查到底的说！",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1108/SEL",
            "narrator": "（選択肢）",
            "text": "ちょっと見せてよ",
            "zh": "稍微给我看看嘛",
            "narrator_zh": "（选项）"
        },
        {
            "location": "1109/ACT",
            "narrator": "",
            "text": "ちょっと見せてよ",
            "zh": "稍微给我看看嘛",
            "narrator_zh": ""
        },
        {
            "location": "1119/TALK",
            "narrator": "がすとちゃん",
            "text": "ダメですの。",
            "zh": "不行的说。",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1120/TALK",
            "narrator": "がすとちゃん",
            "text": "がすとはそういう\n無益なネタバレは\nしないですの。",
            "zh": "GUST酱可不会干那种\n毫无意义的剧透\n勾当的说。",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1123/TALK",
            "narrator": "がすとちゃん",
            "text": "そして、\n裏側のグッズがこちら！",
            "zh": "然后，\n“里”侧的周边在这里！",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1129/DIALOG",
            "narrator": "",
            "text": "初期設定内部資料・裏",
            "zh": "初始设定内部资料·里",
            "narrator_zh": ""
        },
        {
            "location": "1131/TALK",
            "narrator": "がすとちゃん",
            "text": "ジャジャーン！！",
            "zh": "锵锵——！！",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1132/TALK",
            "narrator": "がすとちゃん",
            "text": "拡張少女系トライナリー\n初期設定内部資料・裏\nですの♪",
            "zh": "正是《扩张少女系三重奏\n初始设定内部资料·里》\n的说♪",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1134/TALK",
            "narrator": "がすとちゃん",
            "text": "トライナリーの裏情報が\nたっぷり入ってる\n1冊ですから──",
            "zh": "这里面满满收录了\n三重奏的幕后情报，\n整整一册书——",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1135/TALK",
            "narrator": "がすとちゃん",
            "text": "読めば更なる深淵に\n引き込まれること\n必至らしいですの！",
            "zh": "听说只要读了，\n就必定会被拖入\n更深的深渊的说！",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1141/SEL",
            "narrator": "（選択肢）",
            "text": "中身を見せて！",
            "zh": "让我看看里面！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "1142/SEL",
            "narrator": "（選択肢）",
            "text": "「必至らしい」って適当だな…",
            "zh": "“听说必定”，真敷衍啊……",
            "narrator_zh": "（选项）"
        },
        {
            "location": "1143/ACT",
            "narrator": "",
            "text": "中身を見せて！",
            "zh": "让我看看里面！",
            "narrator_zh": ""
        },
        {
            "location": "1157/TALK",
            "narrator": "がすとちゃん",
            "text": "だからダメですの。",
            "zh": "都说了不行的说。",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1158/TALK",
            "narrator": "がすとちゃん",
            "text": "どのページを見ても\nがすとには難しくて理解\nできなかったですけど…",
            "zh": "虽然不管翻哪一页\n对GUST酱来说都太高深了\n完全看不懂……",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1159/TALK",
            "narrator": "がすとちゃん",
            "text": "どのページも\n迂闊に晒すとヤバそうな\n雰囲気を感じたですの。",
            "zh": "但每一页都能让人感受到\n一旦贸然晒出来就大事不妙的\n气息的说。",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1160/ACT",
            "narrator": "",
            "text": "「必至らしい」って適当だな…",
            "zh": "“听说必定”，真敷衍啊……",
            "narrator_zh": ""
        },
        {
            "location": "1162/TALK",
            "narrator": "がすとちゃん",
            "text": "仕方ないですの。",
            "zh": "那也没办法的说。",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1163/TALK",
            "narrator": "がすとちゃん",
            "text": "がすとには\n詳しいことは分からない\nですけど…",
            "zh": "GUST酱本来就\n搞不懂那些深奥的细节\n啦……",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1164/TALK",
            "narrator": "がすとちゃん",
            "text": "普段はbotをやっている\nとある関係者さんが\n裏の資料を見て、",
            "zh": "听说平时也当bot玩的\n某位相关人士\n看了这份里侧资料后，",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1186/TALK",
            "narrator": "がすとちゃん",
            "text": "フギャァアーーー！！！",
            "zh": "呼嘎啊啊啊———！！！",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1188/TALK",
            "narrator": "がすとちゃん",
            "text": "…って\n叫んでたらしいですの。",
            "zh": "……像这样\n惨叫出声了的说。",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1191/TALK",
            "narrator": "がすとちゃん",
            "text": "あー怖いコワい、ですの。",
            "zh": "啊—好吓人好吓人，的说。",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1192/TALK",
            "narrator": "がすとちゃん",
            "text": "あ、でも。",
            "zh": "啊，不过呢。",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1194/TALK",
            "narrator": "がすとちゃん",
            "text": "いちおう補足しておくと、\n裏情報とは言っても\n「初期設定」ですから…",
            "zh": "姑且补充说明一下，\n虽说是幕后情报，\n但毕竟是“初始设定”嘛……",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1195/TALK",
            "narrator": "がすとちゃん",
            "text": "実際にbotさんが観測した\n世界や彼女たちとは\n異なる部分も多いですの。",
            "zh": "和bot们实际观测到的\n世界以及她们本人之间\n也有很多不同之处的说。",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1196/TALK",
            "narrator": "がすとちゃん",
            "text": "だから、これを読んで\n「答え」を知るのが怖い\nとか思っている人も──",
            "zh": "所以，哪怕是担心读了\n这个就会害怕知道“答案”\n的人——",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1197/TALK",
            "narrator": "がすとちゃん",
            "text": "むしろ考察や想像の幅が\nいっそう膨らむ資料として\n読んでみるといいですの。",
            "zh": "倒不如把它当作能让\n考察和想象空间更加开阔的资料\n来读一读的说。",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1199/TALK",
            "narrator": "がすとちゃん",
            "text": "…みたいなことが\nこの本の前置きから\n読み取れたですの！",
            "zh": "……大致就是这样的意思，\nGUST酱从这本书的序言里\n读出来这么多的说！",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1200/TALK",
            "narrator": "がすとちゃん",
            "text": "だから安心して\nゲットするですのー！",
            "zh": "所以就放心大胆地\n去入手吧的说——！",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1201/SEL",
            "narrator": "（選択肢）",
            "text": "はいはい",
            "zh": "好好好",
            "narrator_zh": "（选项）"
        },
        {
            "location": "1202/ACT",
            "narrator": "",
            "text": "はいはい",
            "zh": "好好好",
            "narrator_zh": ""
        },
        {
            "location": "1208/TALK",
            "narrator": "がすとちゃん",
            "text": "うむ。いい返事ですの。",
            "zh": "嗯，很好的回答的说。",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1210/TALK",
            "narrator": "がすとちゃん",
            "text": "それでは\n$handle$よ、\n戦場でシーユーアゲイン！",
            "zh": "那么\n$handle$啊，\n战场上 See you again！",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1224/TALK",
            "narrator": "がすとちゃん",
            "text": "…。",
            "zh": "……。",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1225/TALK",
            "narrator": "がすとちゃん",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1227/TALK",
            "narrator": "がすとちゃん",
            "text": "……あれ？",
            "zh": "……咦？",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1228/TALK",
            "narrator": "がすとちゃん",
            "text": "まだ続くですの？",
            "zh": "还要继续的说？",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1229/TALK",
            "narrator": "がすとちゃん",
            "text": "というか、\nこの背景は何ですの？",
            "zh": "话说回来，\n这个背景是什么鬼的说？",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1230/TALK",
            "narrator": "がすとちゃん",
            "text": "しかも何処からか\n真面目な感じのBGMが\n流れてきたですの…！？",
            "zh": "而且不知道从哪里\n流淌出一股气氛好严肃的\nBGM的说……！？",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1232/TALK",
            "narrator": "がすとちゃん",
            "text": "何ですの！\nがすとにはこういうの\n似合わないですのー！",
            "zh": "什么啊的说！\nGUST酱跟这种画风\n一点也不搭的说——！",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1233/TALK",
            "narrator": "がすとちゃん",
            "text": "もしかして\nバグって……。",
            "zh": "难道说是\n出Bug了……。",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1234/TALK",
            "narrator": "がすとちゃん",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1241/TALK",
            "narrator": "がすとちゃん",
            "text": "…。",
            "zh": "……。",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1243/TALK",
            "narrator": "がすとちゃん",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1244/TALK",
            "narrator": "がすとちゃん",
            "text": "こんにちは。",
            "zh": "大家好。",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1245/TALK",
            "narrator": "がすとちゃん",
            "text": "唐突に失礼いたします。",
            "zh": "突然冒昧打扰，还请见谅。",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1246/TALK",
            "narrator": "がすとちゃん",
            "text": "この一連のイベントは\n今回が最後となります\nので──",
            "zh": "这一连串的活动剧情\n本次就是最后一回了，\n因此——",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1247/TALK",
            "narrator": "がすとちゃん",
            "text": "この場を借りて、\n地下室からご挨拶を\nさせていただきます。",
            "zh": "请容我借此机会，\n从地下室向各位\n致以问候。",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1249/TALK",
            "narrator": "がすとちゃん",
            "text": "今日に至るまで、\nトライナリーへのご支援\n誠に有難うございます。",
            "zh": "一路走来直至今日，\n诚挚感谢各位对\n三重奏的长期支持。",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1250/TALK",
            "narrator": "がすとちゃん",
            "text": "この夏は、\n皆さんとともに最後まで\n駆け抜けられますよう──",
            "zh": "这个夏天，\n为了能与大家一起\n全力冲刺到最后——",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1251/TALK",
            "narrator": "がすとちゃん",
            "text": "グッズやイベントなど、\nさまざまなものを用意\nさせていただきました。",
            "zh": "我们准备了\n周边与活动等等\n各式各样的内容。",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1252/TALK",
            "narrator": "がすとちゃん",
            "text": "願わくば、\n来たる日まで皆さんと\nともに歩み続け──",
            "zh": "但愿能与各位\n一同持续前行，\n直至那一天的到来——",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1253/TALK",
            "narrator": "がすとちゃん",
            "text": "見届けてもらえたら、\nとても嬉しく思います。",
            "zh": "若能由各位亲眼见证到最后，\n我将感到无比欣慰。",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1255/TALK",
            "narrator": "がすとちゃん",
            "text": "さて、まずグッズに関して\nですが、今回は全ての\nグッズに想いがあります。",
            "zh": "那么，首先关于周边，\n这一次的每一件周边\n都倾注了心意。",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1256/TALK",
            "narrator": "がすとちゃん",
            "text": "それらの想いは、どれ１つ\n重なるものはなく、\n存在する目的があります。",
            "zh": "那些心意没有哪怕一件\n是重复的，\n各自都拥有存在的意义。",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1257/TALK",
            "narrator": "がすとちゃん",
            "text": "ココロの旅チャームは、\n皆さんと共に選んだ、\n皆さんが主役のアイテム。",
            "zh": "心之旅挂饰，\n是与大家一同选出的、\n以各位为主角的商品。",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1258/TALK",
            "narrator": "がすとちゃん",
            "text": "タペストリーは、大判の\n記念写真。ずっと彼女たち\nと共にいられるように。",
            "zh": "挂毯，则是大幅面的\n纪念照片。只为让大家能\n一直陪伴在她们身边。",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1259/TALK",
            "narrator": "がすとちゃん",
            "text": "ソラノキヲクは、\nずっと彼女たちの心に\n寄り添っていられるよう。",
            "zh": "《天空的记忆》，\n是希望能一直\n贴近她们的心灵。",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1260/TALK",
            "narrator": "がすとちゃん",
            "text": "タペストリーが姿で\nソラノキヲクが心。\n対極を成す作りです。",
            "zh": "挂毯承载的是身姿，\n《天空的记忆》承载的是心。\n是互为对照的设计。",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1261/TALK",
            "narrator": "がすとちゃん",
            "text": "そして最後に\nウラオモテセット。",
            "zh": "而最后的便是\n里表套装。",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1262/TALK",
            "narrator": "がすとちゃん",
            "text": "表は毎日彼女たちから\n今日の言葉をもらえる\n日めくりカレンダー。",
            "zh": "表，是每天都能从她们那里\n收到今日寄语的\n撕页日历。",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1263/TALK",
            "narrator": "がすとちゃん",
            "text": "そして裏は、あちらの\n世界の全貌を、余すこと\nなく描ききった文書です。",
            "zh": "而里，则是将彼侧世界的\n全貌毫无保留地\n描绘殆尽的文书。",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1264/TALK",
            "narrator": "がすとちゃん",
            "text": "どれ一つとっても、\n無駄なものはないと\n考えて制作致しました。",
            "zh": "无论哪一件，\n我们都是抱着“绝无多余”的\n信念去制作出来的。",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1266/TALK",
            "narrator": "がすとちゃん",
            "text": "また、今回はコミケ会場\n購入特典として、世界観\nステッカーを用意しました",
            "zh": "另外，本次作为Comiket会场\n购买特典，我们还准备了\n世界观贴纸",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1267/TALK",
            "narrator": "がすとちゃん",
            "text": "実は今回、世界観ロゴは\nかなり予算を使って本気で\n作っているのですが――",
            "zh": "其实这一次，世界观Logo\n我们是花了相当多预算\n认真去设计的——",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1268/TALK",
            "narrator": "がすとちゃん",
            "text": "それは、このステッカーを\n作りたかったから、という\n理由もあったりします。",
            "zh": "这其中也包含着\n“就是想做出这张贴纸”\n这样的理由在里面。",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1270/TALK",
            "narrator": "がすとちゃん",
            "text": "是非、ノートPCや\nスマートフォンに\n貼っていただければ。",
            "zh": "请务必试着贴在\n笔记本电脑或者\n智能手机上吧。",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1283/TALK",
            "narrator": "がすとちゃん",
            "text": "PowerdByRedinessの\n端末なんて、最高じゃ\nありませんか！？",
            "zh": "一台PowerdByRediness的\n终端什么的，岂不是\n棒极了吗！？",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1285/TALK",
            "narrator": "がすとちゃん",
            "text": "と、すみません。\n一人熱くなって\nしまいました。",
            "zh": "咳，抱歉。\n一不小心自己\n激昂起来了。",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1286/TALK",
            "narrator": "がすとちゃん",
            "text": "……先を続けますね。",
            "zh": "……那我继续往下说吧。",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1288/TALK",
            "narrator": "がすとちゃん",
            "text": "コミケの後ですが、\nラストストーリーの\nリリースが控えています。",
            "zh": "Comiket结束之后，\n紧接着便是最终剧情\n即将上线了。",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1289/TALK",
            "narrator": "がすとちゃん",
            "text": "……一応念のため。\nアプリ更新の話ですよ？",
            "zh": "……以防万一说明一下。\n这是指应用更新的事哦？",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1290/TALK",
            "narrator": "がすとちゃん",
            "text": "こちらは、全6本の構成で\nトライナリー一人ずつ＋\nナビたちのイベントです。",
            "zh": "这一篇由全6条剧情构成，\n分别是三重奏每人各一篇\n加上导航员们的剧情。",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1291/TALK",
            "narrator": "がすとちゃん",
            "text": "このラストストーリーは、\n誰でもお楽しみいただける\n作りではありますが――",
            "zh": "这段最终剧情虽说无论谁\n都能够乐在其中，\n不过——",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1293/TALK",
            "narrator": "がすとちゃん",
            "text": "実は神楽チャンネルの\nEP31をクリアしているか\n否かで内容が変わります。",
            "zh": "其实内容会根据是否通关了\n神乐频道的EP31\n而有所变化。",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1294/TALK",
            "narrator": "がすとちゃん",
            "text": "具体的には、神楽EP31を\nクリアしている方なら\n誰でも――",
            "zh": "具体来说，只要是通关了\n神乐EP31的各位，\n无论谁都能够——",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1295/TALK",
            "narrator": "がすとちゃん",
            "text": "その到達未来のうち、\n最大多数の未来１つの\n続きを見られるのです。",
            "zh": "在所到达的诸多未来之中，\n看到人数最多的那一个未来的\n后续故事。",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1296/TALK",
            "narrator": "がすとちゃん",
            "text": "ソイルトンが言っていた\n通りですから、クリアした\n方はご存知かと思います。",
            "zh": "正如索伊尔顿所说，\n通关过的各位\n应该都已经知道了。",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1297/TALK",
            "narrator": "がすとちゃん",
            "text": "そうで無い方も、彼女との\n一時を過ごし、ブロマイド\nまでゲット出来るという―",
            "zh": "尚未通关的各位，也能和她\n共度一段时光，甚至还能\nGET到写真卡——",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1298/TALK",
            "narrator": "がすとちゃん",
            "text": "かなり大サービスな\nイベントなのですが。",
            "zh": "算是相当大放送的\n活动了。",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1299/TALK",
            "narrator": "がすとちゃん",
            "text": "EP31をクリアしていると\nそこに更にプラスして、",
            "zh": "而若通关了EP31，\n在此基础之上还能额外，",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1300/TALK",
            "narrator": "がすとちゃん",
            "text": "１つの未来のエピローグが\n見られる、そんな作りに\nなっているんですね。",
            "zh": "看到某一个未来的尾声，\n它是做成了这样的\n结构呢。",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1302/TALK",
            "narrator": "がすとちゃん",
            "text": "ですから是非、まだ\nクリアしていない方は、\n最後まで到達してください",
            "zh": "因此还没通关的各位，\n请务必试着一路推进到\n最后吧",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1303/TALK",
            "narrator": "がすとちゃん",
            "text": "もちろん、到達して\nいなくても、十分彼女達と\n交流はできます。",
            "zh": "当然，即便尚未到达那里，\n也依然足够和她们\n好好交流互动。",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1304/TALK",
            "narrator": "がすとちゃん",
            "text": "ですが、EP31をクリア\nしていれば――",
            "zh": "只是，如果通关了\nEP31的话——",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1306/TALK",
            "narrator": "がすとちゃん",
            "text": "貴方が彼女に対して\n抱いている、幾つかの\n心配事は解決する筈です。",
            "zh": "你心中对她\n所怀抱着的那些牵挂与担忧，\n应当都能迎刃而解。",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1307/TALK",
            "narrator": "がすとちゃん",
            "text": "どうか、彼女たちの\n頑張りを、最後まで\n見届けてあげてください。",
            "zh": "还请一定守望着\n她们的努力，一直陪伴\n见证到最后。",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1308/TALK",
            "narrator": "がすとちゃん",
            "text": "そして、貴方と彼女とで\n最高の思い出を、\n作り上げて欲しいのです。",
            "zh": "然后，衷心希望你与她\n能够一同创造出\n最棒的回忆。",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1310/TALK",
            "narrator": "がすとちゃん",
            "text": "突然の乱入にて\n失礼いたしました。",
            "zh": "如此唐突地插话进来，\n实在失礼了。",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1311/TALK",
            "narrator": "がすとちゃん",
            "text": "また、長話に最後まで\nお付き合いくださり\n有難うございました。",
            "zh": "也感谢各位耐心地\n听我把这番长话\n听到最后。",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1312/TALK",
            "narrator": "がすとちゃん",
            "text": "猛暑が予想されますから、\n会場にお越しの場合は\n何卒お気をつけください。",
            "zh": "预计届时将会酷暑难耐，\n若要前往活动会场，\n请各位务必保重小心。",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1314/TALK",
            "narrator": "がすとちゃん",
            "text": "これからも、皆さんに、\n素敵なココロの旅を！",
            "zh": "今后也愿各位，\n拥有一段美好的心灵之旅！",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1327/TALK",
            "narrator": "がすとちゃん",
            "text": "…。",
            "zh": "……。",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1329/TALK",
            "narrator": "がすとちゃん",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1330/TALK",
            "narrator": "がすとちゃん",
            "text": "……はっ！",
            "zh": "……哈！",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1331/TALK",
            "narrator": "がすとちゃん",
            "text": "今のは何ですの？",
            "zh": "刚才那是什么的说？",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1332/TALK",
            "narrator": "がすとちゃん",
            "text": "がすとは一体何を\n喋っていたですの…？",
            "zh": "GUST酱刚刚究竟都在\n说些什么东西的说……？",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1334/TALK",
            "narrator": "がすとちゃん",
            "text": "まるで自分が\n自分じゃなかった\nみたいですの！",
            "zh": "简直就像自己\n不再是自己了\n一样的说！",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1335/TALK",
            "narrator": "がすとちゃん",
            "text": "もしや、これが噂の\nインターなんちゃら…！？",
            "zh": "难道说，这就是传说中的\nInter什么来着……！？",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1352/TALK",
            "narrator": "がすとちゃん",
            "text": "がすとを何だと\n思ってるですのー！！",
            "zh": "究竟把GUST酱当成什么了\n的说——！！",
            "narrator_zh": "GUST酱"
        },
        {
            "location": "1357/DIALOG",
            "narrator": "",
            "text": "KADOKAWAブース\nオモテウラ拡張グッズセットの\n詳細情報を見ますか？",
            "zh": "要查看KADOKAWA展位\n表里扩展周边套装的\n详细信息吗？",
            "narrator_zh": ""
        }
    ]
}
