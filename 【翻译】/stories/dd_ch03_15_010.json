{
    "dir": "chap15/daydra/dd_ch03_15_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "15352",
        "cid": "gabriella",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "プチホームシック",
        "title_zh": "Extra002 额外剧情",
        "sub_title_zh": "小小思乡病"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "プチホームシック",
            "zh": "小小思乡病",
            "narrator_zh": ""
        },
        {
            "location": "20/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…。",
            "zh": "唉……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "22/TALK",
            "narrator": "つばめ",
            "text": "…ガブちゃん、さっきから\nどうかしたんですか？",
            "zh": "……加布，你刚才起\n就怎么了吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "24/TALK",
            "narrator": "ガブリエラ",
            "text": "何が？",
            "zh": "什么怎么了？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "26/TALK",
            "narrator": "雛",
            "text": "ため息だよ、ため息。\nさっきからずーっとだよ？",
            "zh": "叹气呀，叹气。\n刚才开始就一直叹个不停哦？",
            "narrator_zh": "雏"
        },
        {
            "location": "27/TALK",
            "narrator": "繭",
            "text": "気付いてなかったの？",
            "zh": "你没发现吗？",
            "narrator_zh": "茧"
        },
        {
            "location": "30/TALK",
            "narrator": "ガブリエラ",
            "text": "…気付かなかったわ。\n悪かったわね。",
            "zh": "……没发现。\n真不好意思啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "31/TALK",
            "narrator": "つばめ",
            "text": "…何かあったんですか？",
            "zh": "……发生什么事了吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "33/TALK",
            "narrator": "ガブリエラ",
            "text": "…まあ、心配かけた\nみたいだから話すけど――",
            "zh": "……算了，看你们好像\n挺担心的我就说说吧——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "34/TALK",
            "narrator": "ガブリエラ",
            "text": "さっき、地理の授業で\nポーランドの話題が\n出たの。",
            "zh": "刚才地理课上，\n讲到波兰的\n话题了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "35/TALK",
            "narrator": "雛",
            "text": "ポーランドって、\nガブリエラちゃんの\n国だよね？",
            "zh": "波兰不就是\n加布里埃拉的\n祖国吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "36/TALK",
            "narrator": "雛",
            "text": "ホームシックに\nなっちゃったとか？",
            "zh": "莫非是\n犯思乡病了？",
            "narrator_zh": "雏"
        },
        {
            "location": "38/TALK",
            "narrator": "ガブリエラ",
            "text": "そんなんじゃないわ。",
            "zh": "才不是那样。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "41/TALK",
            "narrator": "ガブリエラ",
            "text": "ただ、ちょっとだけ\n懐かしい気持ちになった\nだけよ…。",
            "zh": "只不过稍微\n觉得有点怀念\n罢了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "42/SEL",
            "narrator": "",
            "text": "まだまだ子供だね",
            "zh": "还真是个小孩子呢",
            "narrator_zh": ""
        },
        {
            "location": "43/SEL",
            "narrator": "",
            "text": "たまには帰りたい？",
            "zh": "偶尔会想回去吗？",
            "narrator_zh": ""
        },
        {
            "location": "44/SEL",
            "narrator": "",
            "text": "端末検索：面白画像",
            "zh": "终端搜索：搞笑图片",
            "narrator_zh": ""
        },
        {
            "location": "48/TALK",
            "narrator": "つばめ",
            "text": "…それ、ホームシック\nなんじゃ…？",
            "zh": "……那不就是\n思乡病吗……？",
            "narrator_zh": "燕"
        },
        {
            "location": "50/TALK",
            "narrator": "ガブリエラ",
            "text": "だから、そういうのじゃ\nないんだってば。",
            "zh": "都说了，才不是\n那种东西啦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "51/TALK",
            "narrator": "ガブリエラ",
            "text": "懐かしい名前を聞いて、\n地元のこと、色々と\n思い出しただけよ。",
            "zh": "只是听到熟悉的名字，\n想起了老家的\n各种事情而已。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "52/TALK",
            "narrator": "ガブリエラ",
            "text": "…今、どうなってるの\nかな、とか。",
            "zh": "……比如现在变成\n什么样了之类的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "53/ACT",
            "narrator": "",
            "text": "まだまだ子供だね",
            "zh": "还真是个小孩子呢",
            "narrator_zh": ""
        },
        {
            "location": "74/TALK",
            "narrator": "ガブリエラ",
            "text": "…今日の$marzanna$は、ちょっとトゲがあるわね？",
            "zh": "……今天的$marzanna$，说话有点带刺啊？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "75/TALK",
            "narrator": "ガブリエラ",
            "text": "っていうか、私はまだ中学生よ！",
            "zh": "而且说到底，我也还是初中生呀！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "88/TALK",
            "narrator": "ガブリエラ",
            "text": "もう、$marzanna$の\nバカ…。",
            "zh": "真是的，$marzanna$个\n大笨蛋……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "90/TALK",
            "narrator": "つばめ",
            "text": "…せんぱいって、\n日本に来てからは\nまだ一度も――",
            "zh": "……前辈，你来日本之后\n还一次都\n没有——",
            "narrator_zh": "燕"
        },
        {
            "location": "91/TALK",
            "narrator": "つばめ",
            "text": "ポーランドに帰って\nないんですか？",
            "zh": "回过波兰\n吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "94/TALK",
            "narrator": "ガブリエラ",
            "text": "…まあね。\nそう簡単に帰れるような\n立場でもないし。",
            "zh": "……是啊。\n我也不是能这么轻易\n回去的身份。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "95/TALK",
            "narrator": "つばめ",
            "text": "一度くらい帰らないと、\n家族が心配するんじゃ…。",
            "zh": "一次都不回去的话，\n家人会担心的吧……。",
            "narrator_zh": "燕"
        },
        {
            "location": "96/TALK",
            "narrator": "ガブリエラ",
            "text": "あんたに言われたく\nないわよ。",
            "zh": "才轮不到你\n来说我呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "97/TALK",
            "narrator": "ガブリエラ",
            "text": "新幹線一本で実家に\n帰れるのに、一度も\n帰ったことないくせに。",
            "zh": "明明坐一趟新干线\n就能回老家，自己却\n一次都没回去过。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "100/TALK",
            "narrator": "つばめ",
            "text": "うっ…、\nそれを言われると\n何も言えないです…。",
            "zh": "唔……，\n被你这么一说\n我都没话反驳了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "101/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしはもう慣れたし、\n親もあたしがいないのに\n慣れてるだろうけど――",
            "zh": "我已经习惯了，\n爸妈大概也习惯\n我不在身边了吧——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "102/TALK",
            "narrator": "ガブリエラ",
            "text": "あんたのとこは日が\n浅いんだから、日帰りでも\n帰ってあげなさいよ。",
            "zh": "你那边才分开没多久，\n哪怕当天往返也\n回去看看他们吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "105/TALK",
            "narrator": "雛",
            "text": "あはは、つばめちゃん、\n逆に言われちゃったね。",
            "zh": "啊哈哈，燕，\n反过来被说教了呢。",
            "narrator_zh": "雏"
        },
        {
            "location": "107/TALK",
            "narrator": "つばめ",
            "text": "うう…でも、お父さんから\nたまには帰るように\n言われてるし――",
            "zh": "呜呜……不过，爸爸也\n叫我偶尔回家\n看看就是了——",
            "narrator_zh": "燕"
        },
        {
            "location": "109/TALK",
            "narrator": "つばめ",
            "text": "そのうち、真幌さんに\n相談してみようかなぁ？",
            "zh": "过阵子，找真幌\n商量一下看看好不好呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "110/ACT",
            "narrator": "",
            "text": "たまには帰りたい？",
            "zh": "偶尔会想回去吗？",
            "narrator_zh": ""
        },
        {
            "location": "132/TALK",
            "narrator": "ガブリエラ",
            "text": "そうね…里帰りも悪くないかも",
            "zh": "是啊……回趟老家或许也不错",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "133/TALK",
            "narrator": "ガブリエラ",
            "text": "けど、今はまだ帰りたくないわ",
            "zh": "不过，现在还不想回去",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "144/TALK",
            "narrator": "ガブリエラ",
            "text": "…まあ、帰りたいとは\n思うけど、今はいいわ。",
            "zh": "……嘛，想是挺想\n回去的，但现在还是算了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "146/TALK",
            "narrator": "ガブリエラ",
            "text": "別に急がなくたって、\nいずれは帰るつもりだし。",
            "zh": "反正也不用急，\n迟早我是打算回去的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "148/TALK",
            "narrator": "雛",
            "text": "えっ…そうなの？",
            "zh": "咦……是这样吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "150/TALK",
            "narrator": "ガブリエラ",
            "text": "そりゃそうよ。\nだって、ポーランドは\n生まれ故郷だもの。",
            "zh": "那当然了。\n毕竟波兰可是我\n出生长大的故乡呀。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "151/TALK",
            "narrator": "ガブリエラ",
            "text": "一生離れて暮らすなんて、\nさすがにできないわ",
            "zh": "要我一辈子背井离乡，\n那果然还是做不到啊",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "154/TALK",
            "narrator": "つばめ",
            "text": "…それ、嫌です。",
            "zh": "……我不要那样。",
            "narrator_zh": "燕"
        },
        {
            "location": "156/TALK",
            "narrator": "ガブリエラ",
            "text": "ただでさえ少ない\nトライナリーが、\n更に少なくなるしね。",
            "zh": "本来人就少的\n三重奏，\n还会变得更少呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "157/TALK",
            "narrator": "つばめ",
            "text": "そうじゃなくて、\nガブちゃんがいなくなる\nのが嫌なんですよ…。",
            "zh": "不是那个意思，\n我是讨厌加布\n离开不见啊……。",
            "narrator_zh": "燕"
        },
        {
            "location": "161/TALK",
            "narrator": "ガブリエラ",
            "text": "は、はぁ！？\n何言いだすのよ！",
            "zh": "啊、啊！？\n你在胡说什么呀！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "162/TALK",
            "narrator": "雛",
            "text": "そう思って当然だよ。",
            "zh": "会这么想很正常嘛。",
            "narrator_zh": "雏"
        },
        {
            "location": "163/TALK",
            "narrator": "雛",
            "text": "ガブリエラちゃんが\nいなくなっちゃうの、\nあたしだって嫌だもん。",
            "zh": "加布里埃拉要是\n不在了的话，\n连我也会舍不得呀。",
            "narrator_zh": "雏"
        },
        {
            "location": "166/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょ、な、なんなのよ\nあんた達は！？\n気持ち悪いわね…。",
            "zh": "等、你、你们这是\n怎么回事啊！？\n肉麻死了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "168/TALK",
            "narrator": "ガブリエラ",
            "text": "…例えの話だってば。\n別に、今帰るつもりは\nないわよ。",
            "zh": "……都说是打比方了。\n我又没打算\n现在就回去。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "169/TALK",
            "narrator": "雛",
            "text": "でも、いつかは帰っちゃ\nうんでしょ？",
            "zh": "不过，总有一天还是\n会回去的吧？",
            "narrator_zh": "雏"
        },
        {
            "location": "173/TALK",
            "narrator": "ガブリエラ",
            "text": "少なくとも、学生の間は\nこっちにいるって。",
            "zh": "至少在读书期间\n我会留在这边的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "174/TALK",
            "narrator": "繭",
            "text": "…なら、学生を終えても\nそんな気持ちにならない\nように――",
            "zh": "……那为了让你毕业后\n也不会生出\n这种念头——",
            "narrator_zh": "茧"
        },
        {
            "location": "175/TALK",
            "narrator": "繭",
            "text": "もっと、日本の楽しい\nところを教えた方が\n良いかも。",
            "zh": "或许得多教你一些\n日本好玩的地方\n才行。",
            "narrator_zh": "茧"
        },
        {
            "location": "178/TALK",
            "narrator": "つばめ",
            "text": "まゆちん、\nナイスアイデアです！",
            "zh": "小茧，\n这主意太棒了！",
            "narrator_zh": "燕"
        },
        {
            "location": "181/TALK",
            "narrator": "雛",
            "text": "ガブリエラちゃんの\n知らない楽しいことを\nいっぱい教えて――",
            "zh": "把加布里埃拉不知道的\n有趣事情全都\n教给你——",
            "narrator_zh": "雏"
        },
        {
            "location": "182/TALK",
            "narrator": "雛",
            "text": "日本に永住したい、って\n気持ちにさせちゃおー！",
            "zh": "让你产生想要一直\n长住日本的想法吧—！",
            "narrator_zh": "雏"
        },
        {
            "location": "183/TALK",
            "narrator": "ガブリエラ",
            "text": "勝手に決めるなー！！",
            "zh": "别擅自替我决定啊—！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "187/TALK",
            "narrator": "ガブリエラ",
            "text": "…まあ、嫌な気分じゃ\nないけど…。",
            "zh": "……嘛，倒也不让人\n讨厌就是了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "188/ACT",
            "narrator": "",
            "text": "端末検索：面白画像",
            "zh": "终端搜索：搞笑图片",
            "narrator_zh": ""
        },
        {
            "location": "195/TALK",
            "narrator": "ガブリエラ",
            "text": "あら、何かしら…",
            "zh": "哎呀，这是什么呀……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "197/TALK",
            "narrator": "ガブリエラ",
            "text": "ぶっ！？",
            "zh": "噗！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "200/TALK",
            "narrator": "つばめ",
            "text": "ど、どうしたんですか？",
            "zh": "怎、怎么了吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "203/TALK",
            "narrator": "ガブリエラ",
            "text": "あはっ、あはははは！\nこ、これ…何これぇ！？",
            "zh": "啊哈、啊哈哈哈哈！\n这、这是……什么鬼呀！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "205/TALK",
            "narrator": "雛",
            "text": "えっ、どれどれ？",
            "zh": "咦，我看看我看看？",
            "narrator_zh": "雏"
        },
        {
            "location": "208/TALK",
            "narrator": "雛",
            "text": "ぶふっ！！\nひ、ひどい、これひどい！\n面白いけど超ひどい！！",
            "zh": "噗嗤！！\n太、太离谱了，这太惨了！\n虽然很好笑但超级离谱！！",
            "narrator_zh": "雏"
        },
        {
            "location": "209/TALK",
            "narrator": "つばめ",
            "text": "これって、もしかして\nわたし達のコスプレ\nですか！？",
            "zh": "这难道说，\n是在COSPLAY\n我们吗！？",
            "narrator_zh": "燕"
        },
        {
            "location": "213/TALK",
            "narrator": "繭",
            "text": "そ、そうみたい…。\nそれも、ちょ…超、\n低クオリティの…。",
            "zh": "好、好像是这样……。\n而且还是，超……超级\n低劣还原度的……。",
            "narrator_zh": "茧"
        },
        {
            "location": "214/TALK",
            "narrator": "繭",
            "text": "く、くくっ…\nま、待って、見せないで。\nお腹が、お腹が…！！",
            "zh": "噗、噗噗……\n等、等一下，别给我看。\n肚子、肚子好痛……！！",
            "narrator_zh": "茧"
        },
        {
            "location": "217/TALK",
            "narrator": "雛",
            "text": "まゆちん、\nツボ入ったみたい。",
            "zh": "小茧好像\n被戳中笑穴了。",
            "narrator_zh": "雏"
        },
        {
            "location": "218/TALK",
            "narrator": "ガブリエラ",
            "text": "で、でもこれ、\nある意味凄いわ。",
            "zh": "不、不过这个，\n某种意义上挺厉害的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "219/TALK",
            "narrator": "ガブリエラ",
            "text": "普通のオッサンが、\n特殊攻撃隊、って\n書いてある――",
            "zh": "一个普通大叔，\n只是顶着个写有\n特殊攻击队的——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "220/TALK",
            "narrator": "ガブリエラ",
            "text": "ただの段ボール被った\nだけなんて…。",
            "zh": "破纸箱子\n而已啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "224/TALK",
            "narrator": "雛",
            "text": "特殊攻撃隊の情報って、\n一般の人達には\n極秘扱いだからね。",
            "zh": "因为特殊攻击队的情报，\n对一般民众来说\n属于绝密嘛。",
            "narrator_zh": "雏"
        },
        {
            "location": "227/TALK",
            "narrator": "繭",
            "text": "でも、これ…これ、ぶっ！\nだ、ダメ…みせ…\n見せないで！！",
            "zh": "可是，这……这个，噗！\n不、不行……别拿……\n别给我看！！",
            "narrator_zh": "茧"
        },
        {
            "location": "228/TALK",
            "narrator": "雛",
            "text": "っていうか、どこでそんな\n画像拾ってきたの？",
            "zh": "话说回来，你从哪儿\n翻出这种图的？",
            "narrator_zh": "雏"
        },
        {
            "location": "232/TALK",
            "narrator": "ガブリエラ",
            "text": "えっと…\nどこかの画像掲示板？\nよく覚えてないわ。",
            "zh": "那个……\n某个贴图论坛？\n我也记不太清了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "235/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "241/TALK",
            "narrator": "ガブリエラ",
            "text": "もう、$marzanna$！！",
            "zh": "真是的，$marzanna$！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "242/TALK",
            "narrator": "ガブリエラ",
            "text": "いくらなんでも、いきなりあの画像は破壊力あり過ぎよ",
            "zh": "不管怎么说，突然发那种图破坏力也太强了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "243/TALK",
            "narrator": "ガブリエラ",
            "text": "繭なんて、まだうずくまって震えてるし",
            "zh": "你看茧到现在还蹲在地上发抖呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "244/SEL",
            "narrator": "",
            "text": "元気出してほしかった",
            "zh": "想让你打起精神来",
            "narrator_zh": ""
        },
        {
            "location": "245/ACT",
            "narrator": "",
            "text": "元気出してほしかった",
            "zh": "想让你打起精神来",
            "narrator_zh": ""
        },
        {
            "location": "247/TALK",
            "narrator": "ガブリエラ",
            "text": "そうだったの？",
            "zh": "是这样啊？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "248/TALK",
            "narrator": "ガブリエラ",
            "text": "心配かけてごめんね",
            "zh": "让你担心真不好意思",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "249/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、おもいっきり笑ったから元気出たわ",
            "zh": "不过，痛快笑了一场已经打起精神啦",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "18/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>7月11日　10:04 AM</color>\nとある平日の休み時間、附属学園高等部廊下にて。",
