{
    "dir": "chap00/daydra/spev_ch01_012.js",
    "type": "",
    "info": {
        "story_id": "1012",
        "cid": "",
        "title": "スペシャルエピソード",
        "sub_title": "襲来、はらぺこ狼女の恐怖",
        "title_zh": "特别篇",
        "sub_title_zh": "来袭，饿肚子狼女的恐怖"
    },
    "entry": [
        {
            "location": "26/TALK",
            "narrator": "透明つばめ",
            "text": "がおーっ！！",
            "zh": "嗷呜——！！",
            "narrator_zh": "透明燕"
        },
        {
            "location": "30/TALK",
            "narrator": "透明つばめ",
            "text": "食べちゃうぞー！！",
            "zh": "要把你吃掉哦——！！",
            "narrator_zh": "透明燕"
        },
        {
            "location": "32/SEL",
            "narrator": "（選択肢）",
            "text": "…………",
            "zh": "…………",
            "narrator_zh": "（选项）"
        },
        {
            "location": "33/ACT",
            "narrator": "",
            "text": "…………",
            "zh": "…………",
            "narrator_zh": ""
        },
        {
            "location": "36/TALK",
            "narrator": "透明つばめ",
            "text": "あ、あれ？",
            "zh": "咦、咦？",
            "narrator_zh": "透明燕"
        },
        {
            "location": "39/TALK",
            "narrator": "透明つばめ",
            "text": "がおがおーっ！！\n食べられたくなかったら\n食べ物を出せー！！",
            "zh": "嗷呜嗷呜——！！\n不想被吃掉的话\n就把吃的交出来——！！",
            "narrator_zh": "透明燕"
        },
        {
            "location": "40/SEL",
            "narrator": "（選択肢）",
            "text": "何をやってるの？",
            "zh": "你在干什么？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "41/SEL",
            "narrator": "（選択肢）",
            "text": "あはは、かわいいなぁ",
            "zh": "啊哈哈，好可爱",
            "narrator_zh": "（选项）"
        },
        {
            "location": "42/ACT",
            "narrator": "",
            "text": "何をやってるの？",
            "zh": "你在干什么？",
            "narrator_zh": ""
        },
        {
            "location": "45/TALK",
            "narrator": "透明つばめ",
            "text": "えぇっ！！\nこ、怖くないの？",
            "zh": "诶诶！！\n不、不可怕吗？",
            "narrator_zh": "透明燕"
        },
        {
            "location": "46/TALK",
            "narrator": "透明つばめ",
            "text": "わたし、狼だよ？\n狼女だよ！？\nがおがおがおーっ！！",
            "zh": "我是狼哦？\n是狼女哦！？\n嗷呜嗷呜嗷呜——！！",
            "narrator_zh": "透明燕"
        },
        {
            "location": "47/ACT",
            "narrator": "",
            "text": "あはは、かわいいなぁ",
            "zh": "啊哈哈，好可爱",
            "narrator_zh": ""
        },
        {
            "location": "49/TALK",
            "narrator": "透明つばめ",
            "text": "えっ…そ、そうかな？\nえへへ…。",
            "zh": "诶……是、是吗？\n诶嘿嘿……",
            "narrator_zh": "透明燕"
        },
        {
            "location": "51/TALK",
            "narrator": "透明つばめ",
            "text": "じゃなくって！\n怖くないの！？",
            "zh": "不对不对！\n不可怕吗！？",
            "narrator_zh": "透明燕"
        },
        {
            "location": "53/TALK",
            "narrator": "透明つばめ",
            "text": "ほら、狼だよ？\n狼女なんだよ！？\nがおーがおーっ！！",
            "zh": "你看，是狼哦？\n是狼女哦！？\n嗷呜——嗷呜——！！",
            "narrator_zh": "透明燕"
        },
        {
            "location": "60/TALK",
            "narrator": "透明つばめ",
            "text": "あわわっ！？",
            "zh": "哇哇！？",
            "narrator_zh": "透明燕"
        },
        {
            "location": "62/TALK",
            "narrator": "透明つばめ",
            "text": "うぅぅ…、\nお、お腹空いたよぉ…。",
            "zh": "呜呜呜……\n肚、肚子饿了……",
            "narrator_zh": "透明燕"
        },
        {
            "location": "63/TALK",
            "narrator": "透明つばめ",
            "text": "さっきのカレー、\n我慢してでも食べれば\nよかったかも…。",
            "zh": "刚才的咖喱，\n忍一忍也该\n吃掉的……",
            "narrator_zh": "透明燕"
        },
        {
            "location": "64/SEL",
            "narrator": "（選択肢）",
            "text": "好き嫌いはダメ！",
            "zh": "挑食可不行！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "65/SEL",
            "narrator": "（選択肢）",
            "text": "美味しかったよ",
            "zh": "很好吃哦",
            "narrator_zh": "（选项）"
        },
        {
            "location": "66/ACT",
            "narrator": "",
            "text": "好き嫌いはダメ！",
            "zh": "挑食可不行！",
            "narrator_zh": ""
        },
        {
            "location": "68/TALK",
            "narrator": "透明つばめ",
            "text": "好き嫌いとかいう\n問題じゃないよ！",
            "zh": "这不是挑食\n那种问题！",
            "narrator_zh": "透明燕"
        },
        {
            "location": "69/TALK",
            "narrator": "透明つばめ",
            "text": "魔物除けを狼女の\nわたしが食べたら、\nお腹痛くなっちゃうの！",
            "zh": "驱魔的东西，狼女的我\n要是吃了，\n肚子会疼的！",
            "narrator_zh": "透明燕"
        },
        {
            "location": "70/ACT",
            "narrator": "",
            "text": "美味しかったよ",
            "zh": "很好吃哦",
            "narrator_zh": ""
        },
        {
            "location": "72/TALK",
            "narrator": "透明つばめ",
            "text": "わたしが逃げた後、\n普通に食べてたの！？",
            "zh": "我逃走之后，\n你就普通地吃掉了！？",
            "narrator_zh": "透明燕"
        },
        {
            "location": "73/TALK",
            "narrator": "透明つばめ",
            "text": "うぅぅぅぅ…ズルい！！",
            "zh": "呜呜呜呜……太赖了！！",
            "narrator_zh": "透明燕"
        },
        {
            "location": "75/TALK",
            "narrator": "透明つばめ",
            "text": "わたしだって狼女じゃ\nなかったら、あのカレー\n食べれたのに…。",
            "zh": "我要不是狼女，\n那个咖喱\n也能吃的……",
            "narrator_zh": "透明燕"
        },
        {
            "location": "83/TALK",
            "narrator": "透明つばめ",
            "text": "よ、余計なお喋りは\nここまでだよ！",
            "zh": "多、多余的话\n到此为止！",
            "narrator_zh": "透明燕"
        },
        {
            "location": "84/TALK",
            "narrator": "透明つばめ",
            "text": "さあ、美味しいご飯を\nくれないと、あなたを\n食べちゃうぞー！",
            "zh": "来，不把好吃的饭\n交出来，就把你\n吃掉哦——！",
            "narrator_zh": "透明燕"
        },
        {
            "location": "85/SEL",
            "narrator": "（選択肢）",
            "text": "どうぞどうぞ",
            "zh": "请请",
            "narrator_zh": "（选项）"
        },
        {
            "location": "86/SEL",
            "narrator": "（選択肢）",
            "text": "どうやって食べるの？",
            "zh": "你要怎么吃？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "87/ACT",
            "narrator": "",
            "text": "どうぞどうぞ",
            "zh": "请请",
            "narrator_zh": ""
        },
        {
            "location": "90/TALK",
            "narrator": "透明つばめ",
            "text": "えっ、いいの！？\nやったー！",
            "zh": "诶，可以吗！？\n太好了！",
            "narrator_zh": "透明燕"
        },
        {
            "location": "91/TALK",
            "narrator": "透明つばめ",
            "text": "それじゃあ遠慮なく――",
            "zh": "那我就不客气了——",
            "narrator_zh": "透明燕"
        },
        {
            "location": "92/TALK",
            "narrator": "透明つばめ",
            "text": "って、あれ？",
            "zh": "咦，奇怪？",
            "narrator_zh": "透明燕"
        },
        {
            "location": "93/ACT",
            "narrator": "",
            "text": "どうやって食べるの？",
            "zh": "你要怎么吃？",
            "narrator_zh": ""
        },
        {
            "location": "95/TALK",
            "narrator": "透明つばめ",
            "text": "どうやってって、\nもちろん――",
            "zh": "怎么吃，\n当然是——",
            "narrator_zh": "透明燕"
        },
        {
            "location": "96/TALK",
            "narrator": "透明つばめ",
            "text": "…あ、あれ？",
            "zh": "……咦、咦？",
            "narrator_zh": "透明燕"
        },
        {
            "location": "99/TALK",
            "narrator": "透明つばめ",
            "text": "そういえば、\nわたしって人間食べたこと\nまだなかったんだ…。",
            "zh": "说起来，\n我还没吃过\n人……",
            "narrator_zh": "透明燕"
        },
        {
            "location": "100/TALK",
            "narrator": "透明つばめ",
            "text": "お父さんは、人間なんて\n頭からガブッといけば\nいい、って言ってたけど。",
            "zh": "爸爸说，人这种东西\n从头一口咬下去\n就行。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "101/TALK",
            "narrator": "透明つばめ",
            "text": "でも…どう考えても\nわたしの口に入る\n大きさじゃないし…。",
            "zh": "可是……怎么想\n都不是能进我嘴里的\n大小……",
            "narrator_zh": "透明燕"
        },
        {
            "location": "102/TALK",
            "narrator": "透明つばめ",
            "text": "食べやすい方法って、\nどんなのがあるのかな？",
            "zh": "好下口的吃法，\n有哪些呢？",
            "narrator_zh": "透明燕"
        },
        {
            "location": "103/SEL",
            "narrator": "（選択肢）",
            "text": "$me$に聞いてどうする？",
            "zh": "问$me$要怎么办？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "104/ACT",
            "narrator": "",
            "text": "$me$に聞いてどうする？",
            "zh": "问$me$要怎么办？",
            "narrator_zh": ""
        },
        {
            "location": "106/TALK",
            "narrator": "透明つばめ",
            "text": "そ、そうだよね…。\nうう、どうしよう…。",
            "zh": "说、说得也是……\n呜呜，怎么办……",
            "narrator_zh": "透明燕"
        },
        {
            "location": "107/TALK",
            "narrator": "透明つばめ",
            "text": "っていうか、そもそも\nこんなところで食べるのも\nお行儀悪いし…。",
            "zh": "说起来，在这种地方吃\n本来就\n没规矩……",
            "narrator_zh": "透明燕"
        },
        {
            "location": "109/TALK",
            "narrator": "透明つばめ",
            "text": "あ、そうだ！\n今からうちに来ない？",
            "zh": "啊，对了！\n现在要不要来我家？",
            "narrator_zh": "透明燕"
        },
        {
            "location": "111/TALK",
            "narrator": "透明つばめ",
            "text": "お父さんもいるから、\nきっと美味しい料理に\nしてくれると思うよ！",
            "zh": "爸爸也在，\n一定会做成\n好吃的菜！",
            "narrator_zh": "透明燕"
        },
        {
            "location": "112/SEL",
            "narrator": "（選択肢）",
            "text": "行きません",
            "zh": "我不去",
            "narrator_zh": "（选项）"
        },
        {
            "location": "113/ACT",
            "narrator": "",
            "text": "行きません",
            "zh": "我不去",
            "narrator_zh": ""
        },
        {
            "location": "117/TALK",
            "narrator": "透明つばめ",
            "text": "だ、だよねぇ…。",
            "zh": "也、也是呢……",
            "narrator_zh": "透明燕"
        },
        {
            "location": "118/TALK",
            "narrator": "透明つばめ",
            "text": "はぁ…お腹空きすぎて\n頭働かないみたい…。",
            "zh": "唉……肚子太饿，\n脑子好像转不动了……",
            "narrator_zh": "透明燕"
        },
        {
            "location": "119/TALK",
            "narrator": "透明つばめ",
            "text": "わたし、もしかして\n狼女向いてないのかなぁ？",
            "zh": "我该不会\n不适合当狼女吧？",
            "narrator_zh": "透明燕"
        },
        {
            "location": "120/SEL",
            "narrator": "（選択肢）",
            "text": "お菓子あるけど、食べる？",
            "zh": "我有点心，要吃吗？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "121/ACT",
            "narrator": "",
            "text": "お菓子あるけど、食べる？",
            "zh": "我有点心，要吃吗？",
            "narrator_zh": ""
        },
        {
            "location": "124/TALK",
            "narrator": "透明つばめ",
            "text": "えっ、\nお菓子持ってるの！？",
            "zh": "诶，\n你带着点心！？",
            "narrator_zh": "透明燕"
        },
        {
            "location": "125/SEL",
            "narrator": "（選択肢）",
            "text": "$me$を食べないならあげる",
            "zh": "不吃$me$的话就给你",
            "narrator_zh": "（选项）"
        },
        {
            "location": "126/SEL",
            "narrator": "（選択肢）",
            "text": "食べたいならあげるよ",
            "zh": "想吃的话就给你",
            "narrator_zh": "（选项）"
        },
        {
            "location": "127/ACT",
            "narrator": "",
            "text": "$me$を食べないならあげる",
            "zh": "不吃$me$的话就给你",
            "narrator_zh": ""
        },
        {
            "location": "128/TALK",
            "narrator": "透明つばめ",
            "text": "う、うん！\n約束するよ！",
            "zh": "嗯、嗯！\n我答应！",
            "narrator_zh": "透明燕"
        },
        {
            "location": "129/TALK",
            "narrator": "透明つばめ",
            "text": "食べたことない人間より、\nお菓子の方がいいもん！",
            "zh": "比起没吃过的人，\n点心更好！",
            "narrator_zh": "透明燕"
        },
        {
            "location": "130/ACT",
            "narrator": "",
            "text": "食べたいならあげるよ",
            "zh": "想吃的话就给你",
            "narrator_zh": ""
        },
        {
            "location": "131/TALK",
            "narrator": "透明つばめ",
            "text": "いいの！？\nありがとー！！",
            "zh": "可以吗！？\n谢谢——！！",
            "narrator_zh": "透明燕"
        },
        {
            "location": "133/TALK",
            "narrator": "透明つばめ",
            "text": "あむっ…。",
            "zh": "啊呜……",
            "narrator_zh": "透明燕"
        },
        {
            "location": "134/TALK",
            "narrator": "透明つばめ",
            "text": "わぁ、美味しい！",
            "zh": "哇，好吃！",
            "narrator_zh": "透明燕"
        },
        {
            "location": "135/TALK",
            "narrator": "透明つばめ",
            "text": "こんなに美味しいお菓子、\n久しぶりに食べたかも。",
            "zh": "这么好吃的点心，\n也许好久没吃到了。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "136/TALK",
            "narrator": "透明つばめ",
            "text": "…こんなに美味しい\nお菓子持ってるなら…。",
            "zh": "……既然带着\n这么好吃的点心……",
            "narrator_zh": "透明燕"
        },
        {
            "location": "137/TALK",
            "narrator": "透明つばめ",
            "text": "あなたを食べるより、\nあなたからお菓子を\nもらう方がいいかも。",
            "zh": "比起吃掉你，\n向你要点心\n也许更好。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "138/TALK",
            "narrator": "透明つばめ",
            "text": "人間より、お菓子の方が\n美味しいと思うし。",
            "zh": "我觉得点心\n比人更好吃。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "139/SEL",
            "narrator": "（選択肢）",
            "text": "それがいいよ",
            "zh": "那样就好",
            "narrator_zh": "（选项）"
        },
        {
            "location": "140/ACT",
            "narrator": "",
            "text": "それがいいよ",
            "zh": "那样就好",
            "narrator_zh": ""
        },
        {
            "location": "142/TALK",
            "narrator": "透明つばめ",
            "text": "うん、そうだよね！",
            "zh": "嗯，说得也是！",
            "narrator_zh": "透明燕"
        },
        {
            "location": "143/TALK",
            "narrator": "透明つばめ",
            "text": "それじゃ、今日から\nあなたとわたしは\nお友達だよ。",
            "zh": "那么，从今天起\n你和我就是\n朋友了。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "145/TALK",
            "narrator": "透明つばめ",
            "text": "えへへ…、\nお菓子のこと、\nよろしくね。",
            "zh": "诶嘿嘿……\n点心的事，\n就拜托你了。",
            "narrator_zh": "透明燕"
        }
    ]
}
