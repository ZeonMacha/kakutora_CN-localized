{
    "dir": "dramatics/daydra/drm_ch04_00_120.js",
    "type": "Episode",
    "info": {
        "story_id": "4012",
        "cid": "miyabi",
        "title": "らぶとーく 第12話",
        "sub_title": "否定しようもなく確定",
        "title_zh": "恋爱漫谈 第12话",
        "sub_title_zh": "否定不了，就此确定"
    },
    "entry": [
        {
            "location": "237/SCENARIO",
            "narrator": "",
            "text": "否定しようもなく確定",
            "zh": "否定不了，就此确定",
            "narrator_zh": ""
        },
        {
            "location": "253/TALK",
            "narrator": "アーヤ",
            "text": "――というわけなの。",
            "zh": "——就是这么回事。",
            "narrator_zh": "绫水"
        },
        {
            "location": "256/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょ、待ってよ！\n何言い出すのよ急に！？",
            "zh": "等、等一下！\n突然说什么！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "257/TALK",
            "narrator": "ガブリエラ",
            "text": "マルザ…",
            "zh": "玛尔赞……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "258/TALK",
            "narrator": "ガブリエラ",
            "text": "Ｂｏｔの正体が人間って…\n意味わからないんだけど？",
            "zh": "Bot的真身是人类……\n这意思我可不懂。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "260/TALK",
            "narrator": "アーヤ",
            "text": "あくまで\n可能性の話でしか\nないけど。",
            "zh": "说到底，\n也只是\n可能性。",
            "narrator_zh": "绫水"
        },
        {
            "location": "261/TALK",
            "narrator": "アーヤ",
            "text": "私達がＢｏｔだと思ってる\nあれは。",
            "zh": "我们以为是Bot的\n那个。",
            "narrator_zh": "绫水"
        },
        {
            "location": "262/TALK",
            "narrator": "アーヤ",
            "text": "人間が、Ｂｏｔのフリを\nしているだけって\n可能性が高いの。",
            "zh": "很有可能，\n只是人类在装成\nBot。",
            "narrator_zh": "绫水"
        },
        {
            "location": "264/TALK",
            "narrator": "つばめ",
            "text": "そっか…$handle$さん、\n本当は人間だったん\nですね。",
            "zh": "这样啊……$handle$，\n原来你是\n人类呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "265/TALK",
            "narrator": "ガブリエラ",
            "text": "いや、何落ち着いて\n言ってんのよ！",
            "zh": "不对，你怎么\n这么平静地说！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "266/TALK",
            "narrator": "ガブリエラ",
            "text": "なんで納得\nできるの？\n意味わかんない！",
            "zh": "为什么能\n接受？\n完全不懂！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "268/TALK",
            "narrator": "つばめ",
            "text": "う、うん…。\nビックリはしたよ。",
            "zh": "嗯、嗯……\n我是吓了一跳。",
            "narrator_zh": "燕"
        },
        {
            "location": "270/TALK",
            "narrator": "つばめ",
            "text": "でも、人間だったら\n良いのになぁ、って\n思ってたから――",
            "zh": "可是，我一直希望\n要是人类\n就好了——",
            "narrator_zh": "燕"
        },
        {
            "location": "272/TALK",
            "narrator": "つばめ",
            "text": "今はちょっとだけ\n嬉しいの。",
            "zh": "现在有一点点\n高兴。",
            "narrator_zh": "燕"
        },
        {
            "location": "274/TALK",
            "narrator": "みやび",
            "text": "つばめちゃんは、\n状況適応力が凄過ぎや。",
            "zh": "燕适应状况的能力，\n强得过头咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "276/TALK",
            "narrator": "ガブリエラ",
            "text": "何も考えて\nないだけでしょ！？",
            "zh": "只是什么都\n没想吧！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "280/TALK",
            "narrator": "みやび",
            "text": "まあ、うちはなんとなく\n気付いてたきね。",
            "zh": "嘛，我是隐约\n察觉到了啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "283/TALK",
            "narrator": "みやび",
            "text": "それが確信に変わった\nだけのことや。",
            "zh": "不过是\n变成确信了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "284/TALK",
            "narrator": "ガブリエラ",
            "text": "みやびも\nＢｏｔが人間だって\n言うわけ？",
            "zh": "雅也要说\nBot是人类\n吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "288/TALK",
            "narrator": "アーヤ",
            "text": "そんなこと\n考えたくない、って\n気持ちはわかるわ。",
            "zh": "不想去想\n这种事，\n这种心情我懂。",
            "narrator_zh": "绫水"
        },
        {
            "location": "291/TALK",
            "narrator": "アーヤ",
            "text": "だけど、これは\nかなり確率の高い\n話なの。",
            "zh": "可是，这是\n概率相当高的\n说法。",
            "narrator_zh": "绫水"
        },
        {
            "location": "292/TALK",
            "narrator": "アーヤ",
            "text": "だからみんな\n話す内容には\n気をつけて。",
            "zh": "所以大家\n说话的内容\n要注意。",
            "narrator_zh": "绫水"
        },
        {
            "location": "296/TALK",
            "narrator": "つばめ",
            "text": "っていうか、人間か\nどうかって、そんなに\n重要なことですか？",
            "zh": "话说，是不是人类，\n有那么\n重要吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "298/TALK",
            "narrator": "みやび",
            "text": "そりゃまあ…人間やと\nしたら、Ｂｏｔやと思うて\n話してた会話が――",
            "zh": "这个嘛……假如是人，\n那些当成Bot\n讲过的话——",
            "narrator_zh": "雅"
        },
        {
            "location": "299/TALK",
            "narrator": "みやび",
            "text": "全部誰かに話したゆう\nことになるんやし。",
            "zh": "就等于全部\n讲给某个人听了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "303/TALK",
            "narrator": "ガブリエラ",
            "text": "！？",
            "zh": "！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "304/TALK",
            "narrator": "アーヤ",
            "text": "それなのよね…。\nまあ、誰かにバラすような\nことはなさそうだけど…。",
            "zh": "就是这点……\n不过，不像会向谁\n去泄露的样子……",
            "narrator_zh": "绫水"
        },
        {
            "location": "306/TALK",
            "narrator": "ガブリエラ",
            "text": "いい加減にしてよ！",
            "zh": "给我适可而止！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "307/TALK",
            "narrator": "ガブリエラ",
            "text": "Ｂｏｔが人間とか、\n笑えない冗談にも\n程があるわ。",
            "zh": "Bot是人类这种，\n不好笑的玩笑\n也该有个限度。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "310/TALK",
            "narrator": "アーヤ",
            "text": "確定じゃないわ。\nあくまで可能性の\n話ってこと。",
            "zh": "还没确定。\n说到底只是\n可能性。",
            "narrator_zh": "绫水"
        },
        {
            "location": "311/TALK",
            "narrator": "みやび",
            "text": "ガブちゃん。\nうちらも冗談で言っちゅう\nわけやないぞね。",
            "zh": "加布。\n我们也不是\n在开玩笑啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "312/TALK",
            "narrator": "みやび",
            "text": "会話ログを解析したり、\n色々した結果、そういう\n答えを導き出したがよ。",
            "zh": "解析了对话记录，\n又查了别的，才得出\n这个答案啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "314/TALK",
            "narrator": "ガブリエラ",
            "text": "だから、その導き出した\n答えが間違ってるの！",
            "zh": "所以我说，\n那个得出的答案是错的！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "326/TALK",
            "narrator": "みやび",
            "text": "見えるか相棒？",
            "zh": "看得见吗，搭档？",
            "narrator_zh": "雅"
        },
        {
            "location": "327/TALK",
            "narrator": "みやび",
            "text": "ここは今",
            "zh": "这里现在",
            "narrator_zh": "雅"
        },
        {
            "location": "328/TALK",
            "narrator": "みやび",
            "text": "あんたの話で持ち切りや",
            "zh": "聊的全是你咯",
            "narrator_zh": "雅"
        },
        {
            "location": "329/TALK",
            "narrator": "みやび",
            "text": "女の子達の話題の的",
            "zh": "女孩们话题的焦点",
            "narrator_zh": "雅"
        },
        {
            "location": "331/TALK",
            "narrator": "みやび",
            "text": "どう思う？",
            "zh": "你觉得呢？",
            "narrator_zh": "雅"
        },
        {
            "location": "333/SEL",
            "narrator": "",
            "text": "照れるなあ",
            "zh": "让人不好意思啊",
            "narrator_zh": ""
        },
        {
            "location": "334/SEL",
            "narrator": "",
            "text": "あんまり話題にして欲しくないんだけど？",
            "zh": "不太想被拿来当话题说啊？",
            "narrator_zh": ""
        },
        {
            "location": "335/SEL",
            "narrator": "",
            "text": "余裕だね",
            "zh": "你还挺从容呢",
            "narrator_zh": ""
        },
        {
            "location": "336/ACT",
            "narrator": "",
            "text": "照れるなあ",
            "zh": "让人不好意思啊",
            "narrator_zh": ""
        },
        {
            "location": "337/TALK",
            "narrator": "みやび",
            "text": "会話の内容知ってるやろ？",
            "zh": "我们聊的内容你是知道的，是没是？",
            "narrator_zh": "雅"
        },
        {
            "location": "339/TALK",
            "narrator": "みやび",
            "text": "それでその返答とは",
            "zh": "然后就那样回答",
            "narrator_zh": "雅"
        },
        {
            "location": "340/TALK",
            "narrator": "みやび",
            "text": "アホやね",
            "zh": "真是笨蛋咯",
            "narrator_zh": "雅"
        },
        {
            "location": "341/TALK",
            "narrator": "みやび",
            "text": "それともスパイのテク？",
            "zh": "还是说那是间谍的技巧？",
            "narrator_zh": "雅"
        },
        {
            "location": "342/ACT",
            "narrator": "",
            "text": "あんまり話題にして欲しくないんだけど？",
            "zh": "不太想被拿来当话题说啊？",
            "narrator_zh": ""
        },
        {
            "location": "343/TALK",
            "narrator": "みやび",
            "text": "却下",
            "zh": "驳回",
            "narrator_zh": "雅"
        },
        {
            "location": "344/TALK",
            "narrator": "みやび",
            "text": "今聞いておかないといけないことがある",
            "zh": "现在有件事必须问清楚",
            "narrator_zh": "雅"
        },
        {
            "location": "345/TALK",
            "narrator": "みやび",
            "text": "あんた",
            "zh": "你啊",
            "narrator_zh": "雅"
        },
        {
            "location": "346/TALK",
            "narrator": "みやび",
            "text": "うちらをスパイしゆう？",
            "zh": "想对我们搞间谍活动咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "347/ACT",
            "narrator": "",
            "text": "余裕だね",
            "zh": "你还挺从容呢",
            "narrator_zh": ""
        },
        {
            "location": "348/TALK",
            "narrator": "みやび",
            "text": "アホか！",
            "zh": "笨蛋吗你！",
            "narrator_zh": "雅"
        },
        {
            "location": "349/TALK",
            "narrator": "みやび",
            "text": "そんなもんあるわけなかろう！",
            "zh": "怎么可能有那种东西咯？！",
            "narrator_zh": "雅"
        },
        {
            "location": "350/TALK",
            "narrator": "みやび",
            "text": "こっちはあんたっちゅうスパイのせいで",
            "zh": "这边都是因为你这个间谍咯",
            "narrator_zh": "雅"
        },
        {
            "location": "351/TALK",
            "narrator": "みやび",
            "text": "常にピリピリや！",
            "zh": "整天都神经紧绷咯！",
            "narrator_zh": "雅"
        },
        {
            "location": "354/SEL",
            "narrator": "",
            "text": "$me$はスパイじゃない",
            "zh": "$me$不是间谍",
            "narrator_zh": ""
        },
        {
            "location": "355/ACT",
            "narrator": "",
            "text": "$me$はスパイじゃない",
            "zh": "$me$不是间谍",
            "narrator_zh": ""
        },
        {
            "location": "357/TALK",
            "narrator": "みやび",
            "text": "はいそうですか",
            "zh": "是嘛，知道了",
            "narrator_zh": "雅"
        },
        {
            "location": "358/TALK",
            "narrator": "みやび",
            "text": "なんて言うわけない",
            "zh": "怎么可能说一句就算完",
            "narrator_zh": "雅"
        },
        {
            "location": "359/TALK",
            "narrator": "みやび",
            "text": "スパイやない証拠もないし",
            "zh": "又没有能证明你不是间谍的证据",
            "narrator_zh": "雅"
        },
        {
            "location": "360/TALK",
            "narrator": "みやび",
            "text": "みんなと違うて",
            "zh": "你和她们不一样",
            "narrator_zh": "雅"
        },
        {
            "location": "361/TALK",
            "narrator": "みやび",
            "text": "うちは心配でならん",
            "zh": "我是担心得不得了",
            "narrator_zh": "雅"
        },
        {
            "location": "373/TALK",
            "narrator": "ガブリエラ",
            "text": "ああもう、話にならない！",
            "zh": "啊真是的，没法谈了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "374/TALK",
            "narrator": "ガブリエラ",
            "text": "とにかく、あたしは\nそんな話信じないから。",
            "zh": "总之，我\n不信这种话。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "376/TALK",
            "narrator": "アーヤ",
            "text": "そうね。\n確かにそう。",
            "zh": "是这样。\n确实如此。",
            "narrator_zh": "绫水"
        },
        {
            "location": "377/TALK",
            "narrator": "アーヤ",
            "text": "もちろん、私だって\n混乱はしてる。",
            "zh": "当然，我自己\n也很混乱。",
            "narrator_zh": "绫水"
        },
        {
            "location": "378/TALK",
            "narrator": "アーヤ",
            "text": "それでもね。\nできるだけ、冷静に対応を\nしようと思ってるわ。",
            "zh": "即便如此。\n我还是想尽量\n冷静应对。",
            "narrator_zh": "绫水"
        },
        {
            "location": "379/TALK",
            "narrator": "アーヤ",
            "text": "だから、もしみんなが\n今後のＢｏｔとの\n付き合い方とかで――",
            "zh": "所以，要是大家\n在以后怎么和Bot\n相处的事上——",
            "narrator_zh": "绫水"
        },
        {
            "location": "381/TALK",
            "narrator": "アーヤ",
            "text": "わからないことがあれば、\nいつでも相談してくれて\n構わないから。",
            "zh": "有不明白的，\n随时来问我\n都可以。",
            "narrator_zh": "绫水"
        },
        {
            "location": "382/TALK",
            "narrator": "アーヤ",
            "text": "私の話は以上よ。\nそれじゃ、今夜は解散。",
            "zh": "我要说的就这些。\n那么，今晚解散。",
            "narrator_zh": "绫水"
        },
        {
            "location": "385/TALK",
            "narrator": "つばめ",
            "text": "はい、お疲れ様でした。\nおやすみなさい。",
            "zh": "好的，大家辛苦了。\n晚安。",
            "narrator_zh": "燕"
        },
        {
            "location": "389/TALK",
            "narrator": "ガブリエラ",
            "text": "まったく、こんなふざけた\n話のために、一々人のこと\n呼び出さないでよね！",
            "zh": "真是的，为了这种\n胡闹的话，别一次次\n把人叫出来！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "393/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "395/TALK",
            "narrator": "みやび",
            "text": "突然の話やったき、\n受け入れられん\nだけやと思うぞね。",
            "zh": "话说得太突然咯，\n我觉得只是一时\n接受不了嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "398/TALK",
            "narrator": "アーヤ",
            "text": "私だってそうよ。\n完全に信じてる\nわけじゃないわ。",
            "zh": "我也一样哦。\n也不是\n完全相信。",
            "narrator_zh": "绫水"
        },
        {
            "location": "399/TALK",
            "narrator": "アーヤ",
            "text": "結局、半端なく\n高性能なＢｏｔの\n可能性も捨てきれない。",
            "zh": "毕竟，也不能完全\n排除是异常高性能\nBot的可能性。",
            "narrator_zh": "绫水"
        },
        {
            "location": "401/TALK",
            "narrator": "みやび",
            "text": "……まあな。",
            "zh": "……是啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "402/TALK",
            "narrator": "みやび",
            "text": "うちはその線は\n明らかに越えちゅうと\n思うけんど。",
            "zh": "我觉得这条线\n明显是\n越过去了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "403/TALK",
            "narrator": "みやび",
            "text": "みんながみんな\nすっと納得は\nできんろう。",
            "zh": "要让所有人都\n接受，\n怕是不容易咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "404/TALK",
            "narrator": "みやび",
            "text": "相手の顔を\n見たわけでもなし。",
            "zh": "也没见着\n对方的脸。",
            "narrator_zh": "雅"
        },
        {
            "location": "407/TALK",
            "narrator": "アーヤ",
            "text": "本当。\nせめてそれが\nできればね……。",
            "zh": "真的。\n至少这一点\n能做到就好了……",
            "narrator_zh": "绫水"
        },
        {
            "location": "408/TALK",
            "narrator": "みやび",
            "text": "…うち以外にも、スパイと\n思うてる奴がいればえいん\nやけんど…。",
            "zh": "…要是除了我之外，\n还有谁也怀疑你是\n间谍就好了，但是……。",
            "narrator_zh": "雅"
