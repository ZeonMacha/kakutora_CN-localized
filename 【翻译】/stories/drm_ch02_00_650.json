{
 "dir": "dramatics/daydra/drm_ch02_00_650.js",
 "type": "Episode",
 "info": {
  "story_id": "2065",
  "cid": "ayami",
  "title": "らぶとーく 第64話",
  "sub_title": "ダイアログ・イン・ザ・ブラックボックス"
 },
 "entry": [
  {
   "location": "151/SCENARIO",
   "narrator": "",
   "text": "ダイアログ・イン・ザ・ブラックボックス"
  },
  {
   "location": "166/TALK",
   "narrator": "みやび",
   "text": "そうそう。\nそういうことぞね。",
   "zh": "对对。\n就是这么回事咯。",
   "narrator_zh": "雅"
  },
  {
   "location": "169/TALK",
   "narrator": "アーヤ",
   "text": "誰と話してるの？\nさっきから。"
  },
  {
   "location": "170/TALK",
   "narrator": "みやび",
   "text": "トライナリーの\nシフト管理システム\nぞね。"
  },
  {
   "location": "172/TALK",
   "narrator": "アーヤ",
   "text": "え？",
   "zh": "诶？",
   "narrator_zh": "绫水"
  },
  {
   "location": "175/TALK",
   "narrator": "みやび",
   "text": "学生は勉学が\n第一やき。"
  },
  {
   "location": "176/TALK",
   "narrator": "みやび",
   "text": "小テストの予定が\n入った時点で\nシフトを組み替える。"
  },
  {
   "location": "177/TALK",
   "narrator": "みやび",
   "text": "そういう機能を\n追加しようと\nしちゅう。",
   "zh": "那种功能\n打算\n加上去咯。",
   "narrator_zh": "雅"
  },
  {
   "location": "178/TALK",
   "narrator": "アーヤ",
   "text": "それって…。",
   "zh": "那个……。",
   "narrator_zh": "绫水"
  },
  {
   "location": "179/TALK",
   "narrator": "アーヤ",
   "text": "プログラミング\nしてるってことで\nいいの？"
  },
  {
   "location": "180/TALK",
   "narrator": "みやび",
   "text": "一般的な表現では\nそうなるか。"
  },
  {
   "location": "181/TALK",
   "narrator": "アーヤ",
   "text": "…普通に表現\nしてほしいわ。",
   "zh": "……希望你说得\n正常一点。",
   "narrator_zh": "绫水"
  },
  {
   "location": "182/TALK",
   "narrator": "みやび",
   "text": "うちにとっては\nプログラムより\n会話と言う方が自然。"
  },
  {
   "location": "183/TALK",
   "narrator": "みやび",
   "text": "この場合は\nどっちを普通と\n定義すればえいかね。",
   "zh": "这种时候\n该把哪个定义成\n普通呢。",
   "narrator_zh": "雅"
  },
  {
   "location": "184/TALK",
   "narrator": "アーヤ",
   "text": "え…？"
  },
  {
   "location": "185/TALK",
   "narrator": "みやび",
   "text": "この話を\nアーヤに\n置き換えると。",
   "zh": "把这话\n换成绫水\n来说的话。",
   "narrator_zh": "雅"
  },
  {
   "location": "186/TALK",
   "narrator": "みやび",
   "text": "人形劇の人形は\n人形だけど\n感情がある。"
  },
  {
   "location": "187/TALK",
   "narrator": "みやび",
   "text": "少なくとも\nそう見せようと\n演じるはず。"
  },
  {
   "location": "188/TALK",
   "narrator": "みやび",
   "text": "子供がそれを見て\n生きてるみたいだったと\n感想を言うろう？"
  },
  {
   "location": "190/TALK",
   "narrator": "みやび",
   "text": "その時アーヤは\nどう答える？",
   "zh": "那时绫水\n会怎么回答？",
   "narrator_zh": "雅"
  },
  {
   "location": "191/TALK",
   "narrator": "アーヤ",
   "text": "…………。"
  },
  {
   "location": "192/TALK",
   "narrator": "みやび",
   "text": "ただの人形が\n生きている\nわけがない。",
   "zh": "普通的人偶\n不可能\n活着。",
   "narrator_zh": "雅"
  },
  {
   "location": "193/TALK",
   "narrator": "アーヤ",
   "text": "そんなこと\n言うわけ\nないでしょ！",
   "zh": "那种话我\n怎么可能\n说出口！",
   "narrator_zh": "绫水"
  },
  {
   "location": "194/TALK",
   "narrator": "みやび",
   "text": "な？",
   "zh": "对吧？",
   "narrator_zh": "雅"
  },
  {
   "location": "195/TALK",
   "narrator": "アーヤ",
   "text": "…言いたいことは\nわかったわよ。",
   "zh": "……你想说的\n我明白了。",
   "narrator_zh": "绫水"
  },
  {
   "location": "196/TALK",
   "narrator": "みやび",
   "text": "わかってくれて\nうれしいぞね。"
  },
  {
   "location": "197/TALK",
   "narrator": "みやび",
   "text": "これは信念に\nつながる話やき。",
   "zh": "这是关系到\n信念的事咯。",
   "narrator_zh": "雅"
  },
  {
   "location": "198/TALK",
   "narrator": "アーヤ",
   "text": "信念…。"
  },
  {
   "location": "199/TALK",
   "narrator": "みやび",
   "text": "そう言って悪ければ\n哲学かねえ。",
   "zh": "说得那么难听的话，\n那都成哲学了咯。",
   "narrator_zh": "雅"
  },
  {
   "location": "200/TALK",
   "narrator": "みやび",
   "text": "他人から見たら\nおかしいことかも\nしれん。"
  },
  {
   "location": "201/TALK",
   "narrator": "みやび",
   "text": "でも自分には\n何にも替えられん\n大事なこと。",
   "zh": "不过对自己来说\n没有任何东西能替代的\n重要的事。",
   "narrator_zh": "雅"
  },
  {
   "location": "203/TALK",
   "narrator": "みやび",
   "text": "誰にでも\nそういうものは\nあるんと違うかね。"
  },
  {
   "location": "206/TALK",
   "narrator": "アーヤ",
   "text": "……。"
  },
  {
   "location": "207/SEL",
   "narrator": "",
   "text": "おつかれー",
   "zh": "辛苦啦——",
   "narrator_zh": ""
  },
  {
   "location": "208/ACT",
   "narrator": "",
   "text": "おつかれー",
   "zh": "辛苦啦——",
   "narrator_zh": ""
  },
  {
   "location": "213/TALK",
   "narrator": "みやび",
   "text": "着信、\n鳴ったみたい\nやけど。"
  },
  {
   "location": "215/TALK",
   "narrator": "アーヤ",
   "text": "そうね。",
   "zh": "是啊。",
   "narrator_zh": "绫水"
  },
  {
   "location": "223/TALK",
   "narrator": "アーヤ",
   "text": "また後で連絡するね"
  },
  {
   "location": "225/SEL",
   "narrator": "",
   "text": "わかった",
   "zh": "知道了",
   "narrator_zh": ""
  },
  {
   "location": "226/SEL",
   "narrator": "",
   "text": "今話したいのに",
   "zh": "明明现在就想聊",
   "narrator_zh": ""
  },
  {
   "location": "227/ACT",
   "narrator": "",
   "text": "わかった",
   "zh": "知道了",
   "narrator_zh": ""
  },
  {
   "location": "228/TALK",
   "narrator": "アーヤ",
   "text": "うん",
   "zh": "嗯",
   "narrator_zh": "绫水"
  },
  {
   "location": "229/TALK",
   "narrator": "アーヤ",
   "text": "待ってて"
  },
  {
   "location": "230/ACT",
   "narrator": "",
   "text": "今話したいのに",
   "zh": "明明现在就想聊",
   "narrator_zh": ""
  },
  {
   "location": "231/TALK",
   "narrator": "アーヤ",
   "text": "ごめんね",
   "zh": "对不起呀",
   "narrator_zh": "绫水"
  },
  {
   "location": "232/TALK",
   "narrator": "アーヤ",
   "text": "今はちょっと"
  },
  {
   "location": "240/TALK",
   "narrator": "みやび",
   "text": "あれ？\nもうえいかね？"
  },
  {
   "location": "242/TALK",
   "narrator": "アーヤ",
   "text": "大丈夫。"
  },
  {
   "location": "243/TALK",
   "narrator": "アーヤ",
   "text": "それよりちょっと\n考えたいわ。\nさっきの話。",
   "zh": "比起那个，我想\n先想想。\n刚才那件事。",
   "narrator_zh": "绫水"
  },
  {
   "location": "245/TALK",
   "narrator": "みやび",
   "text": "…アーヤは悩みが\n絶えんねえ。",
   "zh": "……绫水真是\n烦恼没个完呢。",
   "narrator_zh": "雅"
  },
  {
   "location": "247/TALK",
   "narrator": "アーヤ",
   "text": "考えてみたから"
  },
  {
   "location": "248/TALK",
   "narrator": "アーヤ",
   "text": "ちょっとだけ聞いて",
   "zh": "就听我说一点",
   "narrator_zh": "绫水"
  },
  {
   "location": "251/TALK",
   "narrator": "ボイスメール",
   "text": "それは哲学にも似て",
   "zh": "那也像哲学",
   "narrator_zh": "语音信箱"
  },
  {
   "location": "263/DIALOG",
   "narrator": "Dialog_GETVoice",
   "text": "<color=green>【アーヤ】</color>のボイスメール\n<color=red>【それは哲学にも似て】</color>\nをゲットしました！"
  }
 ]
}
