            "narrator_zh": "燕"
        },
        {
            "location": "109/TALK",
            "narrator": "つばめ",
            "text": "ストのこと",
            "zh": "罢工的事",
            "narrator_zh": "燕"
        },
        {
            "location": "111/TALK",
            "narrator": "つばめ",
            "text": "外部に言うの禁止って言われてるから(o´Д`)=з",
            "zh": "说了不许告诉外面的人(o´Д`)=з",
            "narrator_zh": "燕"
        },
        {
            "location": "113/SEL",
            "narrator": "",
            "text": "普通に話すのはいいんでしょ？",
            "zh": "普通聊天可以的吧？",
            "narrator_zh": ""
        },
        {
            "location": "114/SEL",
            "narrator": "",
            "text": "堅苦しいなぁ…",
            "zh": "好死板呀……",
            "narrator_zh": ""
        },
        {
            "location": "115/ACT",
            "narrator": "",
            "text": "普通に話すのも禁止なの？",
            "zh": "普通聊天也禁止吗？",
            "narrator_zh": ""
        },
        {
            "location": "116/TALK",
            "narrator": "つばめ",
            "text": "そぅじゃなぃけど",
            "zh": "不是那样",
            "narrator_zh": "燕"
        },
        {
            "location": "117/ACT",
            "narrator": "",
