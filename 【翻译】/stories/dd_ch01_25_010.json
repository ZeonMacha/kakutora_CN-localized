            "text": "でも",
            "zh": "可是",
            "narrator_zh": "燕"
        },
        {
            "location": "145/TALK",
            "narrator": "つばめ",
            "text": "心配させちゃぅし(o´Д`)=з",
            "zh": "会让她们担心的(o´Д`)=з",
            "narrator_zh": "燕"
        },
        {
            "location": "146/TALK",
            "narrator": "つばめ",
            "text": "手伝ぅって言ぅかも",
