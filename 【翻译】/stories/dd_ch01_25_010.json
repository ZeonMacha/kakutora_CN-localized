    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "襲撃前夜～つばめ編～",
            "zh": "袭击前夜～燕篇～",
            "narrator_zh": ""
        },
        {
            "location": "26/TALK",
            "narrator": "アーヤ",
            "text": "――というわけで、\n館長からいつ連絡が\n来るかわからない。",
            "zh": "――就是这么回事，\n馆长什么时候来联络，\n谁也说不准。",
            "narrator_zh": "绫水"
        },
        {
            "location": "27/TALK",
            "narrator": "アーヤ",
            "text": "だから、今夜はみんな、\n劇場に泊まってもらうわ。",
            "zh": "所以，今晚大家\n就都住到剧场里了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "29/TALK",
            "narrator": "みやび",
            "text": "やっぱそうなるかぁ…。\nまあ、しゃあないな。",
            "zh": "果然要这样咯……。\n算了，没办法咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "30/TALK",
            "narrator": "アーヤ",
            "text": "それと、外部と連絡を\nする場合は、間違っても\nストの話はしないこと。",
            "zh": "还有，跟外界联络的时候，\n千万记住\n不能提罢工的事。",
            "narrator_zh": "绫水"
        },
        {
            "location": "31/TALK",
            "narrator": "アーヤ",
            "text": "みんな、いい？",
            "zh": "大家都清楚了吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "32/TALK",
            "narrator": "みやび",
            "text": "りょーかい。",
            "zh": "收到～。",
            "narrator_zh": "雅"
        },
        {
            "location": "34/TALK",
            "narrator": "つばめ",
            "text": "わかりました…。",
            "zh": "我知道了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "36/TALK",
            "narrator": "ガブリエラ",
            "text": "言うわけないでしょ？\n機密漏えいに\nなっちゃうし…。",
            "zh": "怎么可能说出去？\n那可就成\n泄露机密了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "37/TALK",
            "narrator": "アーヤ",
            "text": "うん…それじゃみんな、\nよろしくね。",
            "zh": "嗯……那么大家，\n就麻烦各位了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "39/TALK",
            "narrator": "つばめ",
            "text": "…わたしたち、\nどうなっちゃうんだろ？",
            "zh": "……我们，\n会变成什么样呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "41/TALK",
            "narrator": "ガブリエラ",
            "text": "まったく、情けない声\n出して…頼りないわねぇ。",
            "zh": "真是的，发出这么没出息的\n声音……真靠不住呀。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "42/TALK",
            "narrator": "つばめ",
            "text": "ガブちゃんは\n不安じゃないの？",
            "zh": "加布\n就不担心吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "43/TALK",
            "narrator": "ガブリエラ",
            "text": "不安に決まってるでしょ？",
            "zh": "当然担心了啊？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "44/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、不安だからって\n暗くなってても\n仕方ないじゃない。",
            "zh": "但是，光因为担心\n就板着一张脸\n也没用呀。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "46/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "47/TALK",
            "narrator": "つばめ",
            "text": "ガブちゃんは、\nやっぱり強いなぁ…。",
            "zh": "加布，\n果然好强呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "49/TALK",
            "narrator": "つばめ",
            "text": "わたしも、いつまでも\n新人じゃないんだから、\nしっかりしなきゃ…。",
            "zh": "我也不是\n永远的新人了，\n得打起精神……。",
            "narrator_zh": "燕"
        },
        {
            "location": "55/TALK",
            "narrator": "つばめ",
            "text": "あっ…。",
            "zh": "啊……。",
            "narrator_zh": "燕"
        },
        {
            "location": "56/TALK",
            "narrator": "つばめ",
            "text": "…ひなこちゃんだ。",
            "zh": "……是小雏。",
            "narrator_zh": "燕"
        },
        {
            "location": "63/TALK",
            "narrator": "雛",
            "text": "つばめちゃーん",
            "zh": "燕——",
            "narrator_zh": "雏"
        },
        {
            "location": "65/TALK",
            "narrator": "雛",
            "text": "ちょっとお話ししたいんだけど",
            "zh": "想跟你说说话",
            "narrator_zh": "雏"
        },
        {
            "location": "66/TALK",
            "narrator": "雛",
            "text": "今って平気？",
            "zh": "现在方便吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "67/TALK",
            "narrator": "雛",
            "text": "なんか",
            "zh": "就是",
            "narrator_zh": "雏"
        },
        {
            "location": "68/TALK",
            "narrator": "雛",
            "text": "ちょっと暇なんだー",
            "zh": "有点闲呀——",
            "narrator_zh": "雏"
        },
        {
            "location": "71/TALK",
            "narrator": "雛",
            "text": "つばめちゃーん",
            "zh": "燕——",
            "narrator_zh": "雏"
        },
        {
            "location": "72/TALK",
            "narrator": "雛",
            "text": "きづいてー",
            "zh": "注意到我呀——",
            "narrator_zh": "雏"
        },
        {
            "location": "83/TALK",
            "narrator": "つばめ",
            "text": "…ごめん、ひなこちゃん。",
            "zh": "……对不起，小雏。",
            "narrator_zh": "燕"
        },
        {
            "location": "84/TALK",
            "narrator": "つばめ",
            "text": "今は…どうしても\nダメなの…。",
            "zh": "现在……怎么都\n不行……。",
            "narrator_zh": "燕"
        },
        {
            "location": "85/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "86/SEL",
            "narrator": "",
            "text": "返事はいいの？",
            "zh": "回消息好吗？",
            "narrator_zh": ""
        },
        {
            "location": "87/ACT",
            "narrator": "",
            "text": "返事はいいの？",
            "zh": "回消息好吗？",
            "narrator_zh": ""
        },
        {
            "location": "91/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "105/TALK",
            "narrator": "つばめ",
            "text": "ぅん(´･ω･｀) ",
