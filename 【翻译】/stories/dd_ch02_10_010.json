{
    "dir": "chap10/daydra/dd_ch02_10_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "10252",
        "cid": "ayami",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "いい香り",
        "title_zh": "Extra002 额外剧情",
        "sub_title_zh": "好闻的香气"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "いい香り",
            "zh": "好闻的香气",
            "narrator_zh": ""
        },
        {
            "location": "20/TALK",
            "narrator": "つばめ",
            "text": "…あれ？",
            "zh": "……咦？",
            "narrator_zh": "燕"
        },
        {
            "location": "22/TALK",
            "narrator": "アーヤ",
            "text": "どうかしたの？",
            "zh": "怎么了？",
            "narrator_zh": "绫水"
        },
        {
            "location": "23/TALK",
            "narrator": "つばめ",
            "text": "はい、なんだか凄く良い\n香りがして…。",
            "zh": "嗯，总觉得有股特别好闻的\n香味……",
            "narrator_zh": "燕"
        },
        {
            "location": "24/TALK",
            "narrator": "つばめ",
            "text": "あっ、わかりました！\nアーヤさんの髪です。",
            "zh": "啊，我知道了！\n是绫水头发上的。",
            "narrator_zh": "燕"
        },
        {
            "location": "25/TALK",
            "narrator": "アーヤ",
            "text": "ああ…朝、シャワー\n浴びてきたからかしら？",
            "zh": "啊……大概是因为早上\n冲了个澡再来的吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "26/TALK",
            "narrator": "つばめ",
            "text": "甘くて、ちょっと大人な\n香りですね。",
            "zh": "甜丝丝的，是有点成熟的\n香味呢。",
            "narrator_zh": "燕"
        },
        {
            "location": "27/TALK",
            "narrator": "アーヤ",
            "text": "気付いてくれた？\n実は、少し前にコンディ\nショナーを買い替えたの。",
            "zh": "你注意到了？\n其实，前阵子我换了款\n新的护发素。",
            "narrator_zh": "绫水"
        },
        {
            "location": "28/TALK",
            "narrator": "アーヤ",
            "text": "サンプルの香りが\n凄く気に入っちゃってね。",
            "zh": "试用装的香味\n我很喜欢来着。",
            "narrator_zh": "绫水"
        },
        {
            "location": "29/TALK",
            "narrator": "つばめ",
            "text": "そうだったんですかぁ…。\nなんだか、凄く良さそうな\nコンディショナーですね。",
            "zh": "原来是这样呀……\n总觉得，像是很高级的\n护发素呢。",
            "narrator_zh": "燕"
        },
        {
            "location": "32/TALK",
            "narrator": "アーヤ",
            "text": "そう思うでしょ？",
            "zh": "你也这么觉得吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "33/TALK",
            "narrator": "アーヤ",
            "text": "でも、ドラッグストアで\n１０００円しないものよ。",
            "zh": "不过，在药妆店\n不到1000日元哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "35/TALK",
            "narrator": "つばめ",
            "text": "えっ！？\nこんないい香りなのに！？",
            "zh": "咦！？\n明明这么好闻！？",
            "narrator_zh": "燕"
        },
        {
            "location": "36/TALK",
            "narrator": "アーヤ",
            "text": "ふふっ、その値段で\nこんなにいい香りも\nするし――",
            "zh": "呵呵，这个价钱\n能有这么好闻的\n香味——",
            "narrator_zh": "绫水"
        },
        {
            "location": "37/TALK",
            "narrator": "アーヤ",
            "text": "褒めてももらえたから、\n良い買い物だったわ。",
            "zh": "还被你夸奖了，\n真是一笔划算的买卖。",
            "narrator_zh": "绫水"
        },
        {
            "location": "38/TALK",
            "narrator": "つばめ",
            "text": "そう思います。",
            "zh": "我也这么觉得。",
            "narrator_zh": "燕"
        },
        {
            "location": "39/TALK",
            "narrator": "つばめ",
            "text": "…わたしも、同じの\n買ってみようかな？",
            "zh": "……我也买一瓶\n一样的试试看吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "40/TALK",
            "narrator": "アーヤ",
            "text": "…本当に気に入った\nみたいね。",
            "zh": "……看来你是真的\n很喜欢呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "42/TALK",
            "narrator": "アーヤ",
            "text": "けど…イメージ的に\nつばめには合わない気が\nするかも…。",
            "zh": "不过……从印象上来说\n感觉好像不太适合\n燕呢……",
            "narrator_zh": "绫水"
        },
        {
            "location": "43/SEL",
            "narrator": "",
            "text": "すぐ慣れるよ",
            "zh": "很快就会习惯的",
            "narrator_zh": ""
        },
        {
            "location": "44/SEL",
            "narrator": "",
            "text": "今の香りが良いと褒めよう",
            "zh": "夸她现在的香味就很好",
            "narrator_zh": ""
        },
        {
            "location": "46/TALK",
            "narrator": "アーヤ",
            "text": "今みたいな石鹸の香りが、\nつばめのイメージには\nピッタリ――",
            "zh": "像现在这样的肥皂香，\n才最符合燕给人的\n印象——",
            "narrator_zh": "绫水"
        },
        {
            "location": "47/TALK",
            "narrator": "アーヤ",
            "text": "なんて言ったら、\n気を悪くしちゃう\nかしら？",
            "zh": "要是我这么说，\n她会不会觉得\n不开心呢？",
            "narrator_zh": "绫水"
        },
        {
            "location": "51/TALK",
            "narrator": "つばめ",
            "text": "あ…でも、大人っぽい\n香りだから――",
            "zh": "啊……不过，因为是很成熟的\n香味——",
            "narrator_zh": "燕"
        },
        {
            "location": "52/TALK",
            "narrator": "つばめ",
            "text": "わたしにはちょっと、\n早過ぎるかも…。",
            "zh": "对我来说可能还有点\n太早了吧……",
            "narrator_zh": "燕"
        },
        {
            "location": "53/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "54/TALK",
            "narrator": "アーヤ",
            "text": "ううん、そんなこと\nないんじゃない？",
            "zh": "不会，没那回事\n吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "57/TALK",
            "narrator": "アーヤ",
            "text": "もう高校生なんだから、\nこういう香りだって、\nきっと似合うわよ。",
            "zh": "都已经高中生了，\n这种香味，\n肯定也适合你的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "58/TALK",
            "narrator": "つばめ",
            "text": "そ、そうですか？",
            "zh": "是、是吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "59/TALK",
            "narrator": "アーヤ",
            "text": "そうよ。",
            "zh": "是啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "60/TALK",
            "narrator": "アーヤ",
            "text": "今度銭湯行ったときに\n持っていくから――",
            "zh": "下次去钱汤的时候\n我带过去——",
            "narrator_zh": "绫水"
        },
        {
            "location": "61/TALK",
            "narrator": "アーヤ",
            "text": "その時に試してみて、\n気に入ったら買えば\nいいんじゃない？",
            "zh": "到时候你试试看，\n喜欢的话再买\n不就好了？",
            "narrator_zh": "绫水"
        },
        {
            "location": "63/TALK",
            "narrator": "つばめ",
            "text": "ありがとうございます。\n今から試すのが\n楽しみです！",
            "zh": "谢谢！\n从现在就开始\n期待试用啦！",
            "narrator_zh": "燕"
        },
        {
            "location": "65/ACT",
            "narrator": "",
            "text": "すぐ慣れるよ",
            "zh": "很快就会习惯的",
            "narrator_zh": ""
        },
        {
            "location": "84/TALK",
            "narrator": "アーヤ",
            "text": "まあ、いい香りなのは間違いないし",
            "zh": "嘛，好闻是肯定没错啦",
            "narrator_zh": "绫水"
        },
        {
            "location": "85/TALK",
            "narrator": "アーヤ",
            "text": "最初はちょっと、違和感あるだろうけど",
            "zh": "虽然一开始可能会有点不习惯",
            "narrator_zh": "绫水"
        },
        {
            "location": "97/TALK",
            "narrator": "アーヤ",
            "text": "じゃあ、今度銭湯\n行ったときに\n持っていくから――",
            "zh": "那，下次去钱汤\n的时候\n我带过去——",
            "narrator_zh": "绫水"
        },
        {
            "location": "99/TALK",
            "narrator": "アーヤ",
            "text": "一度使って、\n試してみるのはどう？",
            "zh": "先用一次，\n试试看怎么样？",
            "narrator_zh": "绫水"
        },
        {
            "location": "100/TALK",
            "narrator": "つばめ",
            "text": "いいんですか？",
            "zh": "可以吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "101/TALK",
            "narrator": "アーヤ",
            "text": "ええ、実際に使って\nからの方が、感じが\nわかっていいでしょ？",
            "zh": "嗯，实际用过\n之后才能知道\n感觉嘛，对吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "102/TALK",
            "narrator": "つばめ",
            "text": "ありがとうございます！\nわぁ、早く使って\nみたいなぁ…。",
            "zh": "谢谢！\n哇，好想快点\n用用看呀……",
            "narrator_zh": "燕"
        },
        {
            "location": "103/TALK",
            "narrator": "アーヤ",
            "text": "…今の香りも、本当に\nつばめにピッタリなんだ\nけどなぁ。",
            "zh": "……明明现在的香味，\n就已经很适合燕\n了说。",
            "narrator_zh": "绫水"
        },
        {
            "location": "104/ACT",
            "narrator": "",
            "text": "今の香りが良いと褒めよう",
            "zh": "夸她现在的香味就很好",
            "narrator_zh": ""
        },
        {
            "location": "124/TALK",
            "narrator": "アーヤ",
            "text": "伝えるくらいは大丈夫よね？",
            "zh": "只是告诉她的话应该没关系吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "125/TALK",
            "narrator": "アーヤ",
            "text": "だって、",
            "zh": "因为，",
            "narrator_zh": "绫水"
        },
        {
            "location": "126/TALK",
            "narrator": "アーヤ",
            "text": "本当にいい香りだと思ってるし",
            "zh": "我是真的觉得很好闻嘛",
            "narrator_zh": "绫水"
        },
        {
            "location": "138/TALK",
            "narrator": "アーヤ",
            "text": "でも、今のつばめの\n香りもいいと思うわ。",
            "zh": "不过，我觉得燕现在的\n香味也很好哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "139/TALK",
            "narrator": "つばめ",
            "text": "えっ…そうですか？",
            "zh": "咦……是吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "141/TALK",
            "narrator": "アーヤ",
            "text": "ええ…これって、\n石鹸の香りよね？",
            "zh": "嗯……这个，\n是肥皂的香味吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "142/TALK",
            "narrator": "つばめ",
            "text": "はい。\n石鹸の香りのする\nシャンプーです。",
            "zh": "是的。\n是有肥皂香味的\n洗发水。",
            "narrator_zh": "燕"
        },
        {
            "location": "143/TALK",
            "narrator": "つばめ",
            "text": "わたし、石鹸の香りが\n好きだから、それでずっと\n使ってるんです。",
            "zh": "因为我喜欢\n肥皂的香味，所以\n一直在用这款。",
            "narrator_zh": "燕"
        },
        {
            "location": "144/TALK",
            "narrator": "アーヤ",
            "text": "そうなんだ？",
            "zh": "这样啊？",
            "narrator_zh": "绫水"
        },
        {
            "location": "146/TALK",
            "narrator": "アーヤ",
            "text": "隣にいると、いい感じに\nフワッと香ってくるから、\n凄く良いと思うわ。",
            "zh": "待在旁边的时候，会恰到好处地\n飘来一阵清香，\n我觉得特别好哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "147/TALK",
            "narrator": "つばめ",
            "text": "…そう言ってもらえると、\nちょっと嬉しいです。",
            "zh": "……听你这么说，\n我有点开心。",
            "narrator_zh": "燕"
        },
        {
            "location": "148/TALK",
            "narrator": "つばめ",
            "text": "アーヤさんのコンディ\nショナー使ったら――",
            "zh": "要是用了绫水的\n护发素——",
            "narrator_zh": "燕"
        },
        {
            "location": "149/TALK",
            "narrator": "つばめ",
            "text": "やっぱり、この香り\nしなくなっちゃうと\n思いますか？",
            "zh": "你觉得，是不是\n就会闻不到这股\n香味了？",
            "narrator_zh": "燕"
        },
        {
            "location": "150/TALK",
            "narrator": "アーヤ",
            "text": "多分ね。\nこれ、付けた時はもっと\n甘い香りがするし。",
            "zh": "大概吧。\n我这款抹上去之后\n甜味会更浓。",
            "narrator_zh": "绫水"
        },
        {
            "location": "152/TALK",
            "narrator": "つばめ",
            "text": "う～ん…それじゃあ、\nコンディショナーは\nやめておきます…。",
            "zh": "唔～……那，\n护发素我就\n先不用了……",
            "narrator_zh": "燕"
        },
        {
            "location": "155/TALK",
            "narrator": "アーヤ",
            "text": "ふふっ…まあ、どうしても\n気になるなら――",
            "zh": "呵呵……嘛，要是实在\n在意的话——",
            "narrator_zh": "绫水"
        },
        {
            "location": "156/TALK",
            "narrator": "アーヤ",
            "text": "今度銭湯行くときに\n持っていくから、\nその時に試してみたら？",
            "zh": "下次去钱汤的时候\n我带过去，\n你到时候试试看？",
            "narrator_zh": "绫水"
        },
        {
            "location": "158/TALK",
            "narrator": "つばめ",
            "text": "わぁ、楽しみです。\n早く使ってみたいなぁ。",
            "zh": "哇，好期待。\n好想快点试试看呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "17/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>6月9日　12:11 PM</color>\nとある昼休み、学食横の自販機コーナーにて。",
            "zh": "<color=green>6月9日　12:11 PM</color>\n某个午休，在食堂旁的自动贩卖机角。",
            "narrator_zh": "Dialog_EventData"
        }
    ]
}
