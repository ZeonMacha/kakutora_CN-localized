{
    "dir": "chap19/daydra/dd_ch02_19_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "19252",
        "cid": "ayami",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "夏は特に",
        "title_zh": "Extra002 额外剧情",
        "sub_title_zh": "尤其是夏天"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "夏は特に…",
            "zh": "尤其是夏天……",
            "narrator_zh": ""
        },
        {
            "location": "29/TALK",
            "narrator": "透明つばめ",
            "text": "はぁ、はぁ…。",
            "zh": "哈啊、哈啊……。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "33/TALK",
            "narrator": "透明ガブリエラ",
            "text": "つばめ、大丈夫？\n大分息が上がってるわよ？",
            "zh": "燕，没事吧？\n喘得很厉害哦？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "35/TALK",
            "narrator": "透明つばめ",
            "text": "う、うん…疲れたけど、\nまだ平気…。",
            "zh": "嗯、嗯……虽然有点累，\n不过还撑得住……。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "39/TALK",
            "narrator": "透明神楽",
            "text": "みやびさんは？",
            "zh": "雅呢？",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "42/TALK",
            "narrator": "透明みやび",
            "text": "…ちっくと、\n辛くなってきたがよ…。",
            "zh": "……稍微有点、\n开始吃力咯……。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "44/TALK",
            "narrator": "透明つばめ",
            "text": "ゴール…真幌さんのとこ、\nまだ遠い？",
            "zh": "终点……真幌那里，\n还远吗？",
            "narrator_zh": "透明燕"
        },
        {
            "location": "48/TALK",
            "narrator": "透明神楽",
            "text": "まだ大分先ですから、\n辛いなら少しペース\n落としますか？",
            "zh": "还远得很呢，\n要是难受的话要不要稍微\n放慢点速度？",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "50/TALK",
            "narrator": "透明つばめ",
            "text": "う、ううん…頑張る！",
            "zh": "不、不用……我加油！",
            "narrator_zh": "透明燕"
        },
        {
            "location": "54/TALK",
            "narrator": "透明アーヤ",
            "text": "みんな、遅れ気味よ。\nお喋りしてないで\n走って。",
            "zh": "大家，有点掉队了哦。\n别光顾着说话\n快跑。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "58/TALK",
            "narrator": "透明ガブリエラ",
            "text": "あ、アーヤはちょっと、\n元気過ぎよ！",
            "zh": "啊、绫水你未免也、\n太有精神了吧！",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "61/TALK",
            "narrator": "透明つばめ",
            "text": "疲れてないんですか？",
            "zh": "你不累吗？",
            "narrator_zh": "透明燕"
        },
        {
            "location": "64/TALK",
            "narrator": "透明アーヤ",
            "text": "まさか。\nさっきから足が重くて、\n結構辛いわ。",
            "zh": "怎么可能。\n刚才起腿就沉得很，\n其实挺吃力的。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "66/TALK",
            "narrator": "透明みやび",
            "text": "全然そうには見えんぞ？\nまだまだ走り足りない\n感じやないか。",
            "zh": "看着完全不像啵？\n倒像还远远没跑够\n的样子嘛。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "70/TALK",
            "narrator": "透明アーヤ",
            "text": "ふふっ…こういうの、\n昔から憧れてたの。",
            "zh": "呵呵……这种训练，\n我从以前就很向往了。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "72/TALK",
            "narrator": "透明アーヤ",
            "text": "朝の誰もいない砂浜で、\n走り込みする特訓って――",
            "zh": "在清晨空无一人的沙滩上，\n长跑特训什么的——",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "74/TALK",
            "narrator": "透明アーヤ",
            "text": "青春ドラマみたいで、\nワクワクしない？",
            "zh": "像青春剧一样，\n不觉得很让人兴奋吗？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "76/TALK",
            "narrator": "透明ガブリエラ",
            "text": "今時、そんな汗臭い\n青春ドラマやってんの？",
            "zh": "这年头，还有那种满是汗臭味的\n青春剧在播吗？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "79/TALK",
            "narrator": "透明みやび",
            "text": "わからんけんど、\nうちの好みやないき、\n見る気はせんな。",
            "zh": "不晓得，不过\n不合我胃口啵，\n没兴趣看。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "82/TALK",
            "narrator": "透明つばめ",
            "text": "み、見たとしても、\n真似したいとは\n思えません…。",
            "zh": "就、就算看了，\n也不会想跟着\n学啊……。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "86/TALK",
            "narrator": "透明アーヤ",
            "text": "はい、お喋りはそこまで。\n卯月、そろそろペース\n上げたらどう？",
            "zh": "好了，闲聊到此为止。\n卯月，差不多该提提\n速度了吧？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "90/TALK",
            "narrator": "透明神楽",
            "text": "…様子を見てそうします。",
            "zh": "……我看情况提速。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "94/TALK",
            "narrator": "透明アーヤ",
            "text": "わかったわ。\nじゃあ、先行ってるわ。",
            "zh": "知道了。\n那我先往前跑了。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "100/TALK",
            "narrator": "透明ガブリエラ",
            "text": "うわっ、\nスピード上げたし！？",
            "zh": "哇，\n居然还加速了！？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "103/TALK",
            "narrator": "透明神楽",
            "text": "…あれ、\n絶対疲れてませんよね？",
            "zh": "……那样，\n绝对一点都不累吧？",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "104/TALK",
            "narrator": "透明神楽",
            "text": "砂浜なのに、フォームも\n凄い綺麗ですし…。",
            "zh": "明明是在沙滩上，跑姿也\n漂亮得不得了……。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "106/TALK",
            "narrator": "透明みやび",
            "text": "体育会系は凄いな…。\nうちから見たら、\n化け物や。",
            "zh": "体育社团的人真厉害啊……。\n在我看来，\n简直是怪物咯。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "110/TALK",
            "narrator": "透明みやび",
            "text": "卯月はえいが？\nうちら置いて、先行っても\nえいんよ？",
            "zh": "卯月要紧吗？\n丢下我们，自己先跑\n也要得哦？",
            "narrator_zh": "透明雅"
        },
        {
            "location": "113/TALK",
            "narrator": "透明神楽",
            "text": "もう少ししたら行きます。\n今は、アーヤさんのペースに\n引っ張られて――",
            "zh": "再过一会儿我就去。\n现在要是被绫水的节奏\n带过去——",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "114/TALK",
            "narrator": "透明神楽",
            "text": "自分のペース配分を\n崩しそうなので…。",
            "zh": "感觉会把自己的节奏分配\n搞乱……。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "116/TALK",
            "narrator": "透明ガブリエラ",
            "text": "…あっ！",
            "zh": "……啊！",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "120/TALK",
            "narrator": "透明ガブリエラ",
            "text": "ちょ、アーヤ！\nシャツ、シャツが！！",
            "zh": "等、绫水！\n衬衫、衬衫！！",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "124/TALK",
            "narrator": "透明神楽",
            "text": "汗で身体に張り付いて、\nちょっと透けちゃって\nますね。",
            "zh": "被汗水贴在身上了，\n变得有点透了\n呢。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "127/TALK",
            "narrator": "透明みやび",
            "text": "あの様子だと、前の方も\nピッチリ張り付いちょり\nそうやけんど――",
            "zh": "看那样子，前面估计也\n紧贴在身上\n了不过——",
            "narrator_zh": "透明雅"
        },
        {
            "location": "129/TALK",
            "narrator": "透明みやび",
            "text": "本人、まったく気付い\nとらんようやね。",
            "zh": "她本人好像完全\n没察觉咯。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "132/TALK",
            "narrator": "透明つばめ",
            "text": "あ、アーヤさ…んっ！\nけほっ、けほっ！",
            "zh": "绫、绫水……！\n咳、咳咳！",
            "narrator_zh": "透明燕"
        },
        {
            "location": "137/TALK",
            "narrator": "透明ガブリエラ",
            "text": "バカ！　息上がってん\nだから、大声出せるはず\nないでしょ？",
            "zh": "笨蛋！都喘成这样了\n怎么可能喊得出\n大声嘛？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "139/TALK",
            "narrator": "透明つばめ",
            "text": "で、でも、アーヤさんに\n教えないと…。",
            "zh": "可、可是，不告诉绫水的\n话……。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "141/TALK",
            "narrator": "透明みやび",
            "text": "大丈夫や。\nこの砂浜はうちら以外、\n滅多に人は来んき――",
            "zh": "没事咯。\n这片沙滩除了我们以外，\n很少有人来的啵——",
            "narrator_zh": "透明雅"
        },
        {
            "location": "142/TALK",
            "narrator": "透明みやび",
            "text": "運悪く誰かに見られたと\nしても、数人程度や。",
            "zh": "就算倒霉被谁看见了，\n顶多也就几个人而已。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "146/TALK",
            "narrator": "透明つばめ",
            "text": "人数の問題じゃないです！",
            "zh": "这不是人数的问题！",
            "narrator_zh": "透明燕"
        },
        {
            "location": "149/TALK",
            "narrator": "透明神楽",
            "text": "でも、もう私たちには\n何もできませんよ。",
            "zh": "可是，我们已经\n什么都做不了啦。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "150/TALK",
            "narrator": "透明神楽",
            "text": "アーヤさん、あんなに\n先に行っちゃってますし。",
            "zh": "绫水都已经跑得\n那么远了。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "159/TALK",
            "narrator": "透明アーヤ",
            "text": "…なんだか、高校時代を\n思い出すなぁ。",
            "zh": "……总觉得，让人想起\n高中时代了啊。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "160/SEL",
            "narrator": "",
            "text": "つばめが何か言いたそう",
            "zh": "燕好像有话要说",
            "narrator_zh": ""
        },
        {
            "location": "161/SEL",
            "narrator": "",
            "text": "アーヤ、シャツが！",
            "zh": "绫水，衬衫！",
            "narrator_zh": ""
        },
        {
            "location": "162/SEL",
            "narrator": "",
            "text": "端末操作：連続振動",
            "zh": "终端操作：连续震动",
            "narrator_zh": ""
        },
        {
            "location": "165/TALK",
            "narrator": "透明アーヤ",
            "text": "剣道部の先輩に初めて\n褒められた時――",
            "zh": "第一次被剑道部前辈\n夸奖的时候——",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "166/TALK",
            "narrator": "透明アーヤ",
            "text": "あの日は、嬉しくて\n疲れがあまり気にならない\n感じだったっけ。",
            "zh": "那天高兴得\n都不怎么在意累不累\n来着。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "168/TALK",
            "narrator": "透明アーヤ",
            "text": "なんか、逆に疲れが\n気持ちよく感じて――",
            "zh": "总觉得，反而连疲惫都\n觉得很舒畅——",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "169/TALK",
            "narrator": "透明アーヤ",
            "text": "今の私、あの時と\n同じ状態かも。",
            "zh": "现在的我，说不定就和\n那时一样呢。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "173/TALK",
            "narrator": "透明アーヤ",
            "text": "…ラストスパート！",
            "zh": "……最后冲刺！",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "175/ACT",
            "narrator": "",
            "text": "つばめが何か言いたそう",
            "zh": "燕好像有话要说",
            "narrator_zh": ""
        },
        {
            "location": "181/TALK",
            "narrator": "透明アーヤ",
            "text": "…今、震えた？\nＷＡＶＥかしら？",
            "zh": "……刚才，震了一下？\n是ＷＡＶＥ吗？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "183/TALK",
            "narrator": "透明アーヤ",
            "text": "けど、今は走るのに\n集中しなくちゃ！",
            "zh": "不过，现在得专心\n跑步才行！",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "185/ACT",
            "narrator": "",
            "text": "アーヤ、シャツが！",
            "zh": "绫水，衬衫！",
            "narrator_zh": ""
        },
        {
            "location": "191/TALK",
            "narrator": "透明アーヤ",
            "text": "…今、震えた？\nＷＡＶＥかしら？",
            "zh": "……刚才，震了一下？\n是ＷＡＶＥ吗？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "193/TALK",
            "narrator": "透明アーヤ",
            "text": "けど、今は走るのに\n集中しなくちゃ！",
            "zh": "不过，现在得专心\n跑步才行！",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "214/TALK",
            "narrator": "真幌",
            "text": "最後まで足を止めるな！\nもうゴールは目の前だぞ！",
            "zh": "到最后都别停下脚步！\n终点就在眼前了！",
            "narrator_zh": "真幌"
        },
        {
            "location": "217/TALK",
            "narrator": "アーヤ",
            "text": "みんな、頑張って！",
            "zh": "大家，加油！",
            "narrator_zh": "绫水"
        },
        {
            "location": "220/TALK",
            "narrator": "神楽",
            "text": "ラストスパートですよ！",
            "zh": "要最后冲刺咯！",
            "narrator_zh": "神乐"
        },
        {
            "location": "224/TALK",
            "narrator": "ガブリエラ",
            "text": "っ、ご…ゴール…。\nはぁ、はぁ…\nも、もう、走れない…。",
            "zh": "唔、终……终点……。\n哈啊、哈啊……\n再、再也跑不动了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "229/TALK",
            "narrator": "つばめ",
            "text": "はぁ、はぁ…ううっ、\nあ、足が重いよぉ…。",
            "zh": "哈啊、哈啊……呜呜，\n腿、腿好沉呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "231/TALK",
            "narrator": "みやび",
            "text": "ま、まほさん…砂浜での\n走り込みは、ちっくと\nキツいと思うがですよ。",
            "zh": "真、真幌……在沙滩上\n长跑训练，稍微有点\n太吃力了啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "233/TALK",
            "narrator": "真幌",
            "text": "合宿の訓練なんだ。\nキツいのは当然だろう？",
            "zh": "这可是集训的训练。\n吃力不是理所当然的吗？",
            "narrator_zh": "真幌"
        },
        {
            "location": "234/TALK",
            "narrator": "真幌",
            "text": "それに、ちゃんと効果は\n出ているぞ。",
            "zh": "而且，确实也见效\n了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "238/TALK",
            "narrator": "アーヤ",
            "text": "初日よりも、タイムが\n随分上がりましたね。",
            "zh": "比起第一天，用时\n提升了不少呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "240/TALK",
            "narrator": "真幌",
            "text": "そういうことだ。\nとにかく、今日もよく\n頑張ったな。",
            "zh": "就是这么回事。\n总之，今天也\n很努力了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "241/TALK",
            "narrator": "真幌",
            "text": "後は自由時間にするから、\nとりあえずシャワーでも\n浴びて、ゆっくり休め。",
            "zh": "接下来就作为自由时间，\n先去冲个澡什么的，\n好好休息吧。",
            "narrator_zh": "真幌"
        },
        {
            "location": "246/TALK",
            "narrator": "アーヤ",
            "text": "お疲れ様でした！",
            "zh": "辛苦了！",
            "narrator_zh": "绫水"
        },
        {
            "location": "248/TALK",
            "narrator": "アーヤ",
            "text": "さあ、みんな。\n少し休んだらみやびの家に\n戻りましょ。",
            "zh": "好了，大家。\n稍微休息一下就回雅家里\n去吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "251/TALK",
            "narrator": "つばめ",
            "text": "そ、それより、\nシャツが…。",
            "zh": "那、那个先不说，\n衬衫……。",
            "narrator_zh": "燕"
        },
        {
            "location": "254/TALK",
            "narrator": "アーヤ",
            "text": "シャツがどうかした？",
            "zh": "衬衫怎么了吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "255/TALK",
            "narrator": "つばめ",
            "text": "…あ、あれ？",
            "zh": "……咦、咦？",
            "narrator_zh": "燕"
        },
        {
            "location": "258/TALK",
            "narrator": "神楽",
            "text": "もう大丈夫ですよ。",
            "zh": "已经没事了哦。",
            "narrator_zh": "神乐"
        },
        {
            "location": "259/TALK",
            "narrator": "神楽",
            "text": "私が到着した時には、\nほぼ乾いてましたから…。",
            "zh": "我跑到的时候，\n就已经差不多干了……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "260/TALK",
            "narrator": "みやび",
            "text": "それだけ、うちらより\n早く到着しちょった\nゆうことか…。",
            "zh": "也就是说，比我们\n早到了那么多\n吗……。",
            "narrator_zh": "雅"
        },
        {
            "location": "262/TALK",
            "narrator": "みやび",
            "text": "恐ろしい話や…。",
            "zh": "真是吓人咯……。",
            "narrator_zh": "雅"
        },
        {
            "location": "265/TALK",
            "narrator": "アーヤ",
            "text": "よくわからないけど、\nみんなはもう少し体力を\nつけた方が良さそうね。",
            "zh": "虽然不太明白，不过\n大家还是多练练体力\n比较好哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "267/TALK",
            "narrator": "ガブリエラ",
            "text": "…アーヤは、もう少し\n自分の状態に気を配れる\nようになった方がいいわ。",
            "zh": "……绫水你啊，还是学会\n多留心一点自己的状态\n比较好。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "270/TALK",
            "narrator": "つばめ",
            "text": "うん…本当、誰もいなくて\n良かったよ…。",
            "zh": "嗯……真的，幸好没人\n在场呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "274/TALK",
            "narrator": "アーヤ",
            "text": "？　何のことよ？",
            "zh": "？你在说什么啊？",
            "narrator_zh": "绫水"
        },
        {
            "location": "276/TALK",
            "narrator": "ガブリエラ",
            "text": "…ううん、何でもない。\n気にしないで…。",
            "zh": "……不，没什么。\n别在意……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "277/ACT",
            "narrator": "",
            "text": "端末操作：連続振動",
            "zh": "终端操作：连续震动",
            "narrator_zh": ""
        },
        {
            "location": "284/TALK",
            "narrator": "透明アーヤ",
            "text": "…電話かしら？",
            "zh": "……是电话吗？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "285/TALK",
            "narrator": "透明アーヤ",
            "text": "仕方ないわね。\n一度止まらないと。",
            "zh": "真没办法。\n得先停下来一次了。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "305/TALK",
            "narrator": "アーヤ",
            "text": "電話じゃなかったみたい。",
            "zh": "好像不是电话。",
            "narrator_zh": "绫水"
        },
        {
            "location": "306/TALK",
            "narrator": "アーヤ",
            "text": "もしかして、タイマーでも\n掛かってたのかしら？",
            "zh": "难道说，是定时闹钟\n之类的响了吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "307/TALK",
            "narrator": "つばめ",
            "text": "あ、アーヤさーん！",
            "zh": "绫、绫水——！",
            "narrator_zh": "燕"
        },
        {
            "location": "315/TALK",
            "narrator": "アーヤ",
            "text": "あっ、追いつかれ\nちゃった…。",
            "zh": "啊，被追上\n了……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "318/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤ、シャツ！\n超透けてるから！",
            "zh": "绫水，衬衫！\n超透的啊！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "323/TALK",
            "narrator": "アーヤ",
            "text": "えっ…きゃっ！？",
            "zh": "哎……呀！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "325/TALK",
            "narrator": "みやび",
            "text": "…気付いてなかった\nみたいやね。",
            "zh": "……看来是完全\n没察觉咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "330/TALK",
            "narrator": "神楽",
            "text": "パタパタしてください！\nパタパタして、シャツに\n空気入れてください！",
            "zh": "快抖一抖！\n快抖一抖，往衬衫里\n透点空气进去！",
            "narrator_zh": "神乐"
        },
        {
            "location": "333/TALK",
            "narrator": "アーヤ",
            "text": "う、うん…ありがと、\n教えてくれて…。",
            "zh": "嗯、嗯……谢谢，\n告诉我……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "335/TALK",
            "narrator": "ガブリエラ",
            "text": "気付かなかったの？\nあんなくっついてたら\n気持ち悪いと思うのに…。",
            "zh": "居然没发现吗？\n贴得那么紧\n应该会觉得难受才对……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "337/TALK",
            "narrator": "アーヤ",
            "text": "感じなかったわ。\n多分、走るのに夢中に\nなってて…。",
            "zh": "我没感觉到。\n大概是跑得太投入\n了吧……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "339/TALK",
            "narrator": "神楽",
            "text": "…アーヤさんって、\nスポーツしてる時は――",
            "zh": "……绫水，\n做运动的时候——",
            "narrator_zh": "神乐"
        },
        {
            "location": "340/TALK",
            "narrator": "神楽",
            "text": "凄い無防備になっちゃうん\nですね？",
            "zh": "会变得非常毫无防备\n呢？",
            "narrator_zh": "神乐"
        },
        {
            "location": "341/TALK",
            "narrator": "みやび",
            "text": "意外な一面やね。",
            "zh": "真是意外的一面咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "344/TALK",
            "narrator": "アーヤ",
            "text": "もう、恥ずかしいから\nあまり言わないでよ…。",
            "zh": "真是的，好害羞的\n别老是提了啦……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "25/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>8月21日　 8:25 AM</color>\n合宿中、午前の訓練にて",
            "zh": "<color=green>8月21日　 8:25 AM</color>\n集训中，上午的训练时",
            "narrator_zh": "Dialog_EventData"
        }
    ]
