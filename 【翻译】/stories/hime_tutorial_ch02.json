            "narrator_zh": ""
        },
        {
            "location": "189/TALK",
            "narrator": "アーヤ",
            "text": "そうよね",
            "zh": "是吧",
            "narrator_zh": "绫水"
        },
        {
            "location": "190/TALK",
            "narrator": "アーヤ",
            "text": "私だって食べてもらいたいわ",
            "zh": "我也想让人吃到",
            "narrator_zh": "绫水"
        },
        {
            "location": "191/TALK",
            "narrator": "アーヤ",
            "text": "$handle$さんに",
            "zh": "给$handle$",
            "narrator_zh": "绫水"
        },
        {
            "location": "192/TALK",
            "narrator": "アーヤ",
            "text": "あーん",
            "zh": "啊——",
            "narrator_zh": "绫水"
        },
        {
            "location": "193/TALK",
            "narrator": "アーヤ",
            "text": "なんてね",
