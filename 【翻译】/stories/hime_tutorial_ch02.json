            "narrator_zh": "绫水"
        },
        {
            "location": "198/TALK",
            "narrator": "アーヤ",
            "text": "タブーリっていう",
            "zh": "叫塔布勒",
            "narrator_zh": "绫水"
        },
        {
            "location": "199/TALK",
            "narrator": "アーヤ",
            "text": "レバノン料理",
            "zh": "黎巴嫩菜",
            "narrator_zh": "绫水"
        },
        {
            "location": "200/TALK",
            "narrator": "アーヤ",
            "text": "食べたことあったっけ？",
            "zh": "你吃过吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "202/SEL",
            "narrator": "",
            "text": "もうちょっと説明して",
            "zh": "再讲讲",
            "narrator_zh": ""
        },
        {
            "location": "203/SEL",
            "narrator": "",
            "text": "ないかな……",
            "zh": "好像没有……",
            "narrator_zh": ""
        },
        {
            "location": "204/SEL",
            "narrator": "",
            "text": "あれ美味しいよね",
            "zh": "那个很好吃吧",
            "narrator_zh": ""
        },
        {
            "location": "205/ACT",
            "narrator": "",
            "text": "もうちょっと説明して",
            "zh": "再讲讲",
            "narrator_zh": ""
        },
        {
            "location": "206/TALK",
            "narrator": "アーヤ",
            "text": "みじん切りのパセリのサラダ",
            "zh": "把欧芹切成碎末的沙拉",
            "narrator_zh": "绫水"
        },
        {
            "location": "207/TALK",
            "narrator": "アーヤ",
            "text": "トマトとタマネギも入るの",
            "zh": "还有番茄和洋葱",
            "narrator_zh": "绫水"
        },
        {
            "location": "208/TALK",
            "narrator": "アーヤ",
            "text": "パセリが主役ってとこがポイントみたいね(・・。)ゞ",
            "zh": "欧芹当主角，这点好像是关键(・・。)ゞ",
            "narrator_zh": "绫水"
        },
        {
            "location": "209/ACT",
            "narrator": "",
            "text": "ないかな……",
            "zh": "好像没有……",
            "narrator_zh": ""
        },
        {
            "location": "210/TALK",
            "narrator": "アーヤ",
            "text": "そうだったわね",
            "zh": "是啊",
            "narrator_zh": "绫水"
        },
        {
            "location": "211/TALK",
            "narrator": "アーヤ",
            "text": "機会があったら",
            "zh": "有机会的话",
            "narrator_zh": "绫水"
        },
        {
            "location": "212/TALK",
            "narrator": "アーヤ",
            "text": "試してみて",
            "zh": "尝尝看",
            "narrator_zh": "绫水"
        },
        {
            "location": "213/ACT",
            "narrator": "",
            "text": "あれ美味しいよね",
            "zh": "那个很好吃吧",
            "narrator_zh": ""
        },
        {
            "location": "214/TALK",
            "narrator": "アーヤ",
            "text": "そうよね",
            "zh": "是吧",
            "narrator_zh": "绫水"
        },
        {
            "location": "215/TALK",
            "narrator": "アーヤ",
            "text": "パセリだらけなのにちゃんとサラダだし",
            "zh": "明明全是欧芹，也还是沙拉",
            "narrator_zh": "绫水"
        },
        {
            "location": "216/TALK",
            "narrator": "アーヤ",
            "text": "見た目もちょっとおしゃれだし",
            "zh": "样子也有点精致",
            "narrator_zh": "绫水"
        },
        {
            "location": "218/TALK",
            "narrator": "アーヤ",
            "text": "ただやっぱり問題は",
            "zh": "不过问题还是在",
            "narrator_zh": "绫水"
        },
        {
            "location": "219/TALK",
            "narrator": "アーヤ",
            "text": "確信を持ってこれが正しい味って言い切れないところね",
            "zh": "没法确信，这就是对的味道",
            "narrator_zh": "绫水"
        },
        {
            "location": "220/TALK",
            "narrator": "アーヤ",
            "text": "だからちゃんと言い切れるようになったら",
            "zh": "等我说得准的时候",
            "narrator_zh": "绫水"
        },
        {
            "location": "221/TALK",
            "narrator": "アーヤ",
            "text": "食べてもらいたいわ",
            "zh": "想让你吃",
            "narrator_zh": "绫水"
        },
        {
            "location": "222/TALK",
            "narrator": "アーヤ",
            "text": "あなたにも",
            "zh": "也给你吃",
            "narrator_zh": "绫水"
        },
        {
            "location": "169/DIALOG",
            "narrator": "Tutorial/Dialog_Tutorial_Candy",
            "text": "彼女たちとの会話では\n<color=red>【ココロキャンディ】</color>という\nものを消費して先へ進む。\n\n足りない場合、ジュエルで買うか、\nバトル等で貯めてからストーリーを\n再挑戦することになるから注意。\n\n<color=green>今回だけは使っても減らないから、\n好きな選択肢を選んでみて。</color>",
            "zh": "和她们聊天时，\n会消耗<color=red>【心之糖果】</color>，\n才能继续往下。\n\n不够的话，就用珠宝买，\n或者靠战斗之类攒够，\n再重打这段剧情。注意。\n\n<color=green>只有这一次，用了也不会减少，\n挑你想选的就行。</color>",
            "narrator_zh": "Tutorial/Dialog_Tutorial_Candy"
        },
        {
            "location": "187/DIALOG",
            "narrator": "Tutorial/Dialog_Tutorial_Love2",
            "text": "<color=red>【親密度】</color>を沢山貯めると\n彼女との関係性が変化していく。\n\n<color=green>【友達】</color>になり<color=orange>【恋人】</color>になり…\n更にその先まで発展するかも。\n頑張ってハートを集めて欲しい。\n\n集めたハートは<color=red>【PROFILE】</color>で\n確認できるわ。",
            "zh": "<color=red>【亲密度】</color>攒得多了，\n和她的关系就会变化。\n\n会变成<color=green>【朋友】</color>，再变成<color=orange>【恋人】</color>……\n也许还能再往前走。\n好好把爱心攒起来吧。\n\n攒下的爱心，在<color=red>【PROFILE】</color>\n里就能看到。",
            "narrator_zh": "Tutorial/Dialog_Tutorial_Love2"
        },
        {
            "location": "196/DIALOG",
            "narrator": "Tutorial/Dialog_Tutorial_Camera",
            "text": "そうそう、ひとつお得情報。\n<color=red>カメラボタンを押すことで、\n彼女を見守る視点を変えられる。</color>\n\n今回はお試しでカメラを５つ\n用意しておいた。\n実際には<color=green>ゴキゲンポイント</color>で\n交換して増やしていくことに\nなるから、今のうちにいっぱい\n堪能しておくといいと思う。",
            "zh": "对了，告诉你一件有用的。\n<color=red>按下相机按钮，\n就能换一个看着她的视角。</color>\n\n这次试用，准备了5个\n相机。\n实际上要用<color=green>心情点数</color>\n来兑换，再慢慢增加。\n所以趁现在，\n多看个够就好。",
            "narrator_zh": "Tutorial/Dialog_Tutorial_Camera"
        }
    ]
}
