{
    "dir": "dramatics/daydra/drm_ch01_00_500.js",
    "type": "Episode",
    "info": {
        "story_id": "1050",
        "cid": "tsubame",
        "title": "らぶとーく 第50話",
        "sub_title": "優先順位",
        "title_zh": "恋爱漫谈 第50话",
        "sub_title_zh": "优先顺序"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "優先順位",
            "zh": "优先顺序",
            "narrator_zh": ""
        },
        {
            "location": "21/TALK",
            "narrator": "アーヤ",
            "text": "…ここよね、卯月が\nヘリに乗って消えたの\nって。",
            "zh": "……就是这里吧，卯月\n坐直升机消失的\n地方。",
            "narrator_zh": "绫水"
        },
        {
            "location": "25/TALK",
            "narrator": "みやび",
            "text": "間違いないちや。",
            "zh": "错不了滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "28/TALK",
            "narrator": "みやび",
            "text": "そしてここが、\nつばめちゃんが卯月に\n殺されかけてた場所ちや。",
            "zh": "然后这里，就是燕\n差点被卯月\n杀掉的地方咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "30/TALK",
            "narrator": "つばめ",
            "text": "…やっぱり、この場所に\n戻ってくるのは、\nちょっと辛いかも。",
            "zh": "……果然，再回到\n这个地方，\n还是有点难受。",
            "narrator_zh": "燕"
        },
        {
            "location": "31/TALK",
            "narrator": "ガブリエラ",
            "text": "…つばめ、あんたは\n帰っていいのよ？",
            "zh": "……燕，你可以先\n回去的哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "33/TALK",
            "narrator": "つばめ",
            "text": "だ、大丈夫だよ。\n心配してくれて\nありがと。",
            "zh": "没、没事的。\n谢谢你\n担心我。",
            "narrator_zh": "燕"
        },
        {
            "location": "35/TALK",
            "narrator": "ガブリエラ",
            "text": "ち、違うわよ！",
            "zh": "不、不是的！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "36/TALK",
            "narrator": "ガブリエラ",
            "text": "そんな暗い顔で隣に\nいられると、気が散って\n仕方がないだけだから！",
            "zh": "你顶着一脸阴沉待在我旁边，\n我只会分心\n得不行！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "37/TALK",
            "narrator": "ガブリエラ",
            "text": "…っていうか、わざわざ\n検証しに戻ってくる\n必要あったの？",
            "zh": "……话说回来，我们真有必要\n特意跑回来\n勘察吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "38/TALK",
            "narrator": "ガブリエラ",
            "text": "神楽が裏切ったのは\n事実なんだし――",
            "zh": "神乐背叛大家是\n不争的事实——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "40/TALK",
            "narrator": "ガブリエラ",
            "text": "連れ去ったのが管理庁\nだっていうのもわかって\nるのに…。",
            "zh": "而且带走她的是管理厅\n这件事也已经\n很清楚了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "42/TALK",
            "narrator": "アーヤ",
            "text": "つばめの言う通り、\n卯月に何かしらの理由が\nあるんだとしたら――",
            "zh": "要是像燕说的那样，\n卯月那边有什么\n理由的话——",
            "narrator_zh": "绫水"
        },
        {
            "location": "43/TALK",
            "narrator": "アーヤ",
            "text": "もしかしたら、手掛かりに\nなるような物をわざと\n落としていって――",
            "zh": "说不定，她故意\n留下了能当线索的\n东西——",
            "narrator_zh": "绫水"
        },
        {
            "location": "44/TALK",
            "narrator": "アーヤ",
            "text": "私達に何かを伝えようと\nしてる可能性もある\nでしょ？",
            "zh": "也有可能想向我们\n传达些什么，\n不是吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "47/TALK",
            "narrator": "ガブリエラ",
            "text": "…アーヤも、神楽のことを\n信じてるの？",
            "zh": "……绫水也相信\n神乐吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "49/TALK",
            "narrator": "アーヤ",
            "text": "…わからない。",
            "zh": "……不懂。",
            "narrator_zh": "绫水"
        },
        {
            "location": "51/TALK",
            "narrator": "アーヤ",
            "text": "けど、つばめのことは\n信じてるから――",
            "zh": "可是，我相信\n燕——",
            "narrator_zh": "绫水"
        },
        {
            "location": "52/TALK",
            "narrator": "アーヤ",
            "text": "一度検証してみても\nいいと思ったのよ。",
            "zh": "我觉得还是回来\n验证一次比较好哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "53/TALK",
            "narrator": "みやび",
            "text": "けんど、何も残っては\nなさそうやね。",
            "zh": "不过，好像什么都没\n留下来咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "55/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "58/TALK",
            "narrator": "ガブリエラ",
            "text": "そういえばさ、どうしても\nわからないことがあるん\nだけど――",
            "zh": "说起来，有件事我\n怎么都想不通，\n就是——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "59/TALK",
            "narrator": "ガブリエラ",
            "text": "つばめ、あの時神楽に\n対して、無抵抗だった\nように見えたけど――",
            "zh": "燕，那时候你对神乐\n好像完全没有抵抗，\n不过——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "60/TALK",
            "narrator": "ガブリエラ",
            "text": "あれ、どういうこと？",
            "zh": "那时候，是怎么回事？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "61/TALK",
            "narrator": "つばめ",
            "text": "えっ…。",
            "zh": "诶……。",
            "narrator_zh": "燕"
        },
        {
            "location": "62/SEL",
            "narrator": "",
            "text": "暴力が嫌いだから？",
            "zh": "因为你讨厌暴力？",
            "narrator_zh": ""
        },
        {
            "location": "63/SEL",
            "narrator": "",
            "text": "抵抗できなかった？",
            "zh": "没法反抗吗？",
            "narrator_zh": ""
        },
        {
            "location": "64/SEL",
            "narrator": "",
            "text": "死にたかったってことはないよね",
            "zh": "并不是想死吧",
            "narrator_zh": ""
        },
        {
            "location": "67/TALK",
            "narrator": "みやび",
            "text": "そういえば、まったく\n抵抗してる感じが\nしなかった気がするちや。",
            "zh": "说起来，完全\n感觉不到\n抵抗咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "68/TALK",
            "narrator": "みやび",
            "text": "ちっくとは暴れるくらい\nするんが普通やないが？",
            "zh": "有点的话，差不多\n会闹起来才正常啵？",
            "narrator_zh": "雅"
        },
        {
            "location": "69/TALK",
            "narrator": "アーヤ",
            "text": "そうね。\n手足を抑えられていた\nわけでもないんだし…。",
            "zh": "是啊。\n手脚也没被\n按着嘛……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "72/TALK",
            "narrator": "ガブリエラ",
            "text": "…まさかつばめ、\n死にたかった、なんて\n言わないわよね？",
            "zh": "……该不会，燕其实\n想说自己也\n不想活了吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "74/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "75/TALK",
            "narrator": "ガブリエラ",
            "text": "…あんた、まさか！",
            "zh": "……你，该不会！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "77/TALK",
            "narrator": "つばめ",
            "text": "ち、違うよ！\n死にたいなんて、\n一度も思ったことないよ。",
            "zh": "不、不是的！\n想死什么的，\n我一次都没想过。",
            "narrator_zh": "燕"
        },
        {
            "location": "78/TALK",
            "narrator": "つばめ",
            "text": "ただ、あの時は――",
            "zh": "只是，那时候——",
            "narrator_zh": "燕"
        },
        {
            "location": "79/TALK",
            "narrator": "つばめ",
            "text": "このまま殺されても、\nいいかも、って…。",
            "zh": "就算就这样被杀掉，\n也许也挺好，你这么说……。",
            "narrator_zh": "燕"
        },
        {
            "location": "82/TALK",
            "narrator": "ガブリエラ",
            "text": "バカ！！",
            "zh": "笨蛋！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "83/TALK",
            "narrator": "ガブリエラ",
            "text": "あんた、自分が何言って\nるかわかってんの！？",
            "zh": "你到底知不知道\n自己在说什么啊！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "84/TALK",
            "narrator": "ガブリエラ",
            "text": "殺されてもいいなんて\nこと、あるわけない\nでしょ！！",
            "zh": "就算被杀也无所谓\n这种事，怎么可能\n有啊！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "87/TALK",
            "narrator": "つばめ",
            "text": "で、でもあの時は、\n本当に…。",
            "zh": "可、可是那时候，\n真的……。",
            "narrator_zh": "燕"
        },
        {
            "location": "88/TALK",
            "narrator": "ガブリエラ",
            "text": "それがおかしいって\n言ってんのよ！！",
            "zh": "我说那个\n很奇怪啊！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "89/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィの言う通りよ。",
            "zh": "加维说得对。",
            "narrator_zh": "绫水"
        },
        {
            "location": "90/TALK",
            "narrator": "アーヤ",
            "text": "何で殺されてもいいとか\n思ったの？",
            "zh": "你为什么会觉得\n被杀也无所谓？",
            "narrator_zh": "绫水"
        },
        {
            "location": "91/TALK",
            "narrator": "アーヤ",
            "text": "そんなに自分の命を\n軽く思ってるわけ？",
            "zh": "你就那么不把自己的命\n当回事？",
            "narrator_zh": "绫水"
        },
        {
            "location": "92/TALK",
            "narrator": "つばめ",
            "text": "そ、そういうわけじゃ…。",
            "zh": "也、也不是那个意思……。",
            "narrator_zh": "燕"
        },
        {
            "location": "93/TALK",
            "narrator": "みやび",
            "text": "そうとしか聞こえん\nかったよ。",
            "zh": "我只能听成\n那样了啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "94/TALK",
            "narrator": "みやび",
            "text": "つばめちゃん、今の発言は\n誰が聞いてもおかしいと\n思うぞね。",
            "zh": "燕，刚才的发言\n谁听了都会觉得\n奇怪咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "96/TALK",
            "narrator": "つばめ",
            "text": "で、でも、神楽ちゃんが…。",
            "zh": "可、可是，神乐她……。",
            "narrator_zh": "燕"
        },
        {
            "location": "98/TALK",
            "narrator": "みやび",
            "text": "えい加減にしぃ！！",
            "zh": "都适可而止咧！！",
            "narrator_zh": "雅"
        },
        {
            "location": "100/TALK",
            "narrator": "みやび",
            "text": "神楽神楽言う前に、\n自分のことをもっと\n大切にしぃ！！",
            "zh": "整天神乐神乐的，\n你先给我把自己的\n命多当回事咧！！",
            "narrator_zh": "雅"
        },
        {
            "location": "101/TALK",
            "narrator": "アーヤ",
            "text": "つばめは、卯月のこと\n以外はどうでもいいと\n思ってるわけ？",
            "zh": "你是说除了卯月\n以外什么都\n无所谓？",
            "narrator_zh": "绫水"
        },
        {
            "location": "102/TALK",
            "narrator": "アーヤ",
            "text": "あなたが死んだら、\n私達や日向さん達は\nもちろん――",
            "zh": "你要是死了，\n我们和日向她们\n自不用说——",
            "narrator_zh": "绫水"
        },
        {
            "location": "103/TALK",
            "narrator": "アーヤ",
            "text": "あなたのお父さんや\nお母さんも、凄く悲しむ\nのよ？",
            "zh": "你的爸爸和\n妈妈也会非常伤心\n的哦？",
            "narrator_zh": "绫水"
        },
        {
            "location": "104/TALK",
            "narrator": "アーヤ",
            "text": "そのことを、少しも\n考えなかったの！？",
            "zh": "这件事，你\n一点都没想过吗！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "107/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "108/TALK",
            "narrator": "ガブリエラ",
            "text": "あんたにとっては、\n神楽以外の人間は、\nどうだっていいのね？",
            "zh": "对你来说，\n除了神乐以外的人，\n怎样都无所谓吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "110/TALK",
            "narrator": "つばめ",
            "text": "そ、そんなことない！\nそうじゃないんだけど、\nただ…。",
            "zh": "不、不是那样！\n也不是那个意思，\n只是……。",
            "narrator_zh": "燕"
        },
        {
            "location": "111/TALK",
            "narrator": "ガブリエラ",
            "text": "だったら！",
            "zh": "那不就得了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "112/TALK",
            "narrator": "ガブリエラ",
            "text": "殺されても良いなんて、\n軽々しく思わないでよ！",
            "zh": "别把“被杀也无所谓”这种话，\n随便挂在嘴边想啊！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "114/TALK",
            "narrator": "ガブリエラ",
            "text": "そうじゃなきゃ、\nつばめの言うこと…\n何も信用できない。",
            "zh": "不这样的话，\n燕说的话……\n我全都无法相信。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "116/TALK",
            "narrator": "ガブリエラ",
            "text": "どうせ卯月のことしか\n考えてない言葉なんだ、\nって…。",
            "zh": "反正那些话只想着\n卯月，\n我是说……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "118/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "119/TALK",
            "narrator": "アーヤ",
            "text": "私とみやびも、ギャヴィと\n同じ気持ちよ。",
            "zh": "我和雅，也跟加维\n是一个想法哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "120/TALK",
            "narrator": "アーヤ",
            "text": "つばめ…お願いだから、\nもっと自分の命を\n大切に想って。",
            "zh": "燕……求你了，\n多把自己的命\n当回事。",
            "narrator_zh": "绫水"
        },
        {
            "location": "121/TALK",
            "narrator": "みやび",
            "text": "それだけやない。",
            "zh": "不只是这些咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "122/TALK",
            "narrator": "みやび",
            "text": "つばめちゃんのことを\n大切に想っちゅう――",
            "zh": "很珍视\n燕嘛——",
            "narrator_zh": "雅"
        },
        {
            "location": "123/TALK",
            "narrator": "みやび",
            "text": "うちらのことも、\nちっくとでえいき、\n考えてほしいが…。",
            "zh": "也稍微哪怕一点也好，\n替我们想想\n咯……。",
            "narrator_zh": "雅"
        },
        {
            "location": "124/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "126/ACT",
            "narrator": "",
            "text": "暴力が嫌いだから？",
            "zh": "因为你讨厌暴力？",
            "narrator_zh": ""
        },
        {
            "location": "143/TALK",
            "narrator": "つばめ",
            "text": "それはそぅかもしれなぃんだけど(´･ω･｀) ",
            "zh": "那个也许是那样(´･ω･｀)",
            "narrator_zh": "燕"
        },
        {
            "location": "144/TALK",
            "narrator": "つばめ",
            "text": "でも",
            "zh": "不过",
            "narrator_zh": "燕"
        },
        {
            "location": "145/TALK",
            "narrator": "つばめ",
            "text": "あの時はそれだけじゃなかったの",
            "zh": "那时候不止是因为那个",
            "narrator_zh": "燕"
        },
        {
            "location": "158/TALK",
            "narrator": "つばめ",
            "text": "…あの時――",
            "zh": "……那时候——",
            "narrator_zh": "燕"
        },
        {
            "location": "159/TALK",
            "narrator": "つばめ",
            "text": "わたし、思ったんです…。",
            "zh": "我心里想的是……。",
            "narrator_zh": "燕"
        },
        {
            "location": "160/TALK",
            "narrator": "つばめ",
            "text": "神楽ちゃんになら、\nこのまま殺されても\nいいかも、って…。",
            "zh": "如果是神乐的话，\n就这样被她杀掉，\n也许也可以……。",
            "narrator_zh": "燕"
        },
        {
            "location": "162/ACT",
            "narrator": "",
            "text": "抵抗できなかった",
            "zh": "没法反抗",
            "narrator_zh": ""
        },
        {
            "location": "179/TALK",
            "narrator": "つばめ",
            "text": "ぅぅん",
            "zh": "唔唔",
            "narrator_zh": "燕"
        },
        {
            "location": "180/TALK",
            "narrator": "つばめ",
            "text": "しよぅと思えばできたけど",
            "zh": "真想反抗的话其实做得到的",
            "narrator_zh": "燕"
        },
        {
            "location": "181/TALK",
            "narrator": "つばめ",
            "text": "あの時はそぅ思わなかったの",
            "zh": "但那时候我没那么想",
            "narrator_zh": "燕"
        },
        {
            "location": "194/TALK",
            "narrator": "つばめ",
            "text": "…あの時は、抵抗しよう\nって気持ち、まったく\nなかったんです…。",
            "zh": "……那时候，想要反抗\n的想法，我一点也\n没有过……。",
            "narrator_zh": "燕"
        },
        {
            "location": "195/TALK",
            "narrator": "アーヤ",
            "text": "…どういうこと？",
