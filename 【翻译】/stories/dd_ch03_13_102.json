{
    "dir": "chap13/daydra/dd_ch03_13_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "13305",
        "cid": "gabriella",
        "title": "005 メインストーリー",
        "sub_title": "チェイス？＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "追踪？＜后篇＞"
    },
    "entry": [
        {
            "location": "254/SCENARIO",
            "narrator": "",
            "text": "アーヤを追え",
            "zh": "追踪绫水",
            "narrator_zh": ""
        },
        {
            "location": "269/TALK",
            "narrator": "ガブリエラ",
            "text": "…やっぱ気になるし、\n行ってみよう。",
            "zh": "……还是好在意啊，\n去看看吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "270/TALK",
            "narrator": "ガブリエラ",
            "text": "こんな気持ちで\n展示会に行ったって、\n楽しめないもの。",
            "zh": "带着这种心情\n去逛展览会，\n也根本没法好好欣赏嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "271/TALK",
            "narrator": "ガブリエラ",
            "text": "それに、アーヤが\n非行に走ってる\n可能性もあるし！",
            "zh": "而且，绫水也有可能\n是误入歧途\n去干坏事了嘛！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "272/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしがしっかり\n見張る必要が\nあるわね。",
            "zh": "我有必要\n好好盯紧她\n才行呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "274/TALK",
            "narrator": "ガブリエラ",
            "text": "さて、\n区民センターか。",
            "zh": "那么，\n区民中心吗。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "290/TALK",
            "narrator": "ガブリエラ",
            "text": "…アーヤってば、\nこんなところに\n何の用事かしら？",
            "zh": "……绫水这家伙，\n来这种地方\n究竟有什么事啊？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "292/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤ達が集まって\n勉強するような\n場所っぽくないし。",
            "zh": "看着也不像是绫水她们\n会聚在一起\n学习的地方呀。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "295/TALK",
            "narrator": "ガブリエラ",
            "text": "…つまり、あたしの\n勘が正しかった、って\nことね。",
            "zh": "……也就是说，我的\n直觉猜对了，\n没错吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "296/SEL",
            "narrator": "",
            "text": "ちょっとドキドキするね",
            "zh": "有点让人心跳加速呢",
            "narrator_zh": ""
        },
        {
            "location": "297/ACT",
            "narrator": "",
            "text": "ちょっとドキドキするね",
            "zh": "有点让人心跳加速呢",
            "narrator_zh": ""
        },
        {
            "location": "314/TALK",
            "narrator": "ガブリエラ",
            "text": "あら、マルザンナもそうなの？",
            "zh": "哎呀，玛尔赞娜也是吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "315/TALK",
            "narrator": "ガブリエラ",
            "text": "私も、ちょっとドキドキしているわ",
            "zh": "我其实也有点心跳加速呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "316/TALK",
            "narrator": "ガブリエラ",
            "text": "この辺りって、私もあまり来ない場所だし",
            "zh": "这附近我也没怎么来过呀",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "317/TALK",
            "narrator": "ガブリエラ",
            "text": "そういえば、マルザンナは知っているの？",
            "zh": "说起来，玛尔赞娜你知道吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "318/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤが今日どこで何をしているのか？",
            "zh": "绫水今天在这里究竟在做什么？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "320/SEL",
            "narrator": "",
            "text": "いや、知らない",
            "zh": "不，不知道",
            "narrator_zh": ""
        },
        {
            "location": "321/SEL",
            "narrator": "",
            "text": "言ったら来た意味なくなっちゃう",
            "zh": "说出来的话来这里就没意义啦",
            "narrator_zh": ""
        },
        {
            "location": "322/ACT",
            "narrator": "",
            "text": "いや、知らない",
            "zh": "不，不知道",
            "narrator_zh": ""
        },
        {
            "location": "323/TALK",
            "narrator": "ガブリエラ",
            "text": "そうなの？",
            "zh": "这样啊？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "324/TALK",
            "narrator": "ガブリエラ",
            "text": "じゃあ、私が一番に知るってことね",
            "zh": "那我就是第一个知道的人咯",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "325/ACT",
            "narrator": "",
            "text": "言ったら来た意味なくなっちゃう",
            "zh": "说出来的话来这里就没意义啦",
            "narrator_zh": ""
        },
        {
            "location": "326/TALK",
            "narrator": "ガブリエラ",
            "text": "そうだった、うっかりしていたわ",
            "zh": "说得也是，我一时疏忽了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "327/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、そう言うってことは、マルザンナはアーヤの秘密を知っているの？",
            "zh": "不过，你这么说就说明，玛尔赞娜你知道绫水的秘密咯？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "329/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょっと悔しいわね",
            "zh": "感觉有点不甘心呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "330/TALK",
            "narrator": "ガブリエラ",
            "text": "もういいわ",
            "zh": "算了，随它去吧",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "343/TALK",
            "narrator": "ガブリエラ",
            "text": "…えっと、\n区民センターの\n隣だから…。",
            "zh": "……那个，是在\n区民中心的\n隔壁，所以……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "345/TALK",
            "narrator": "ガブリエラ",
            "text": "…ここ？\nやっぱり幼稚園\nだけど――",
            "zh": "……这里？\n果然是幼儿园\n没错啊——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "346/TALK",
            "narrator": "ガブリエラ",
            "text": "間違いないみたい。\nアーヤのバイクも\n止まってるし。",
            "zh": "看来没错了。\n绫水的摩托车也\n停在外面呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "348/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "349/TALK",
            "narrator": "ガブリエラ",
            "text": "ま、ちょっとした\n潜入ミッションね。",
            "zh": "嘛，算是个小小的\n潜入任务吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "374/TALK",
            "narrator": "ガブリエラ",
            "text": "…随分賑やかね。\nおやすみなのに、\n何かあるのかしら？",
            "zh": "……里面挺热闹的呢。\n明明是休息日，\n难道有什么活动吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "375/TALK",
            "narrator": "アーヤ",
            "text": "はーい、みんな。\nそろそろ始めるから\n座ってねー。",
            "zh": "好啦，小朋友们。\n差不多要开始了，\n都坐好哦—。",
            "narrator_zh": "绫水"
        },
        {
            "location": "376/TALK",
            "narrator": "ガブリエラ",
            "text": "えっ？\n今の声って…。",
            "zh": "哎？\n刚才那个声音是……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "377/TALK",
            "narrator": "アーヤ",
            "text": "むかーしむかし、\n森の奥にある\n動物の国に――",
            "zh": "很久很久以前，\n在森林深处的\n动物王国里——",
            "narrator_zh": "绫水"
        },
        {
            "location": "378/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤ！？\n何で人形劇なんて\nやってるの！？",
            "zh": "绫水！？\n她为什么在演\n人偶剧啊！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "379/TALK",
            "narrator": "アーヤ",
            "text": "ネコさんがクマさんと\n一緒に遊んでいると、\nウサギさんが――",
            "zh": "小猫正和小熊\n一起玩耍的时候，\n小兔走过来——",
            "narrator_zh": "绫水"
        },
        {
            "location": "380/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "392/TALK",
            "narrator": "ガブリエラ",
            "text": "どうしたらいいのかしら、マルザンナ",
            "zh": "这下该怎么办才好呀，玛尔赞娜",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "393/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤの秘密を覗き見しようと思って、ここまで来たけど",
            "zh": "我本来是想偷窥绫水的秘密才跟到这里来的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "394/TALK",
            "narrator": "ガブリエラ",
            "text": "何ていうか",
            "zh": "怎么说呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "395/TALK",
            "narrator": "ガブリエラ",
            "text": "思っていた以上に、覗き見したらいけないプライベートな一面を見てしまったわ",
            "zh": "好像撞见了比想象中更不该偷看的私人一面啊",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "396/TALK",
            "narrator": "ガブリエラ",
            "text": "なんだか",
            "zh": "总觉得",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "397/TALK",
            "narrator": "ガブリエラ",
            "text": "凄く悪いことをしてしまった気分よ",
            "zh": "自己好像干了件特别缺德的事呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "400/SEL",
            "narrator": "",
            "text": "バレる前に帰ろう",
            "zh": "趁没被发现赶紧回去吧",
            "narrator_zh": ""
        },
        {
            "location": "401/SEL",
            "narrator": "",
            "text": "人形劇見たいなぁ",
            "zh": "好想看人偶剧呀",
            "narrator_zh": ""
        },
        {
            "location": "402/ACT",
            "narrator": "",
            "text": "バレる前に帰ろう",
            "zh": "趁没被发现赶紧回去吧",
            "narrator_zh": ""
        },
        {
            "location": "403/TALK",
            "narrator": "ガブリエラ",
            "text": "そうね",
            "zh": "说得对",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "404/TALK",
            "narrator": "ガブリエラ",
            "text": "バレたら怒られると思うし",
            "zh": "被发现的话肯定要挨骂的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "405/TALK",
            "narrator": "ガブリエラ",
            "text": "気付かれないように、撤退するわ",
            "zh": "趁着还没被察觉，赶紧撤退",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "416/ACT",
            "narrator": "",
            "text": "人形劇見たいなぁ",
            "zh": "好想看人偶剧呀",
            "narrator_zh": ""
        },
        {
            "location": "417/TALK",
            "narrator": "ガブリエラ",
            "text": "何悠長なことを言っているの！？",
            "zh": "你在说什么不紧不慢的闲话啊！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "418/TALK",
            "narrator": "ガブリエラ",
            "text": "本当、頼りないんだから",
            "zh": "真是的，真靠不住",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "429/TALK",
            "narrator": "ガブリエラ",
            "text": "まったく、\nマルザンナってば…。",
            "zh": "真是的，\n玛尔赞娜你这家伙……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "430/TALK",
            "narrator": "ガブリエラ",
            "text": "…あたしだって、\nできればもっと\n見てたいわよ。",
            "zh": "……其实我自己，\n可以的话也想\n再多看一会儿啦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "431/TALK",
            "narrator": "アーヤ",
            "text": "お腹がいっぱいに\nなったネコさん達は、\nぐっすりと眠り――",
            "zh": "吃得饱饱的\n小猫们，\n呼呼地睡着了——",
            "narrator_zh": "绫水"
        },
        {
            "location": "432/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "434/TALK",
            "narrator": "ガブリエラ",
            "text": "バレたらマズいし、\nやっぱり帰ろうかしら。",
            "zh": "要是被发现就糟了，\n果然还是赶紧回去吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "436/TALK",
            "narrator": "ガブリエラ",
            "text": "そーっと、そーっと。",
            "zh": "悄悄地、悄悄地。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "437/TALK",
            "narrator": "子供たち",
            "text": "あ、不審者だー。",
            "zh": "啊，有可疑人员—。",
            "narrator_zh": "孩子们"
        },
        {
            "location": "439/TALK",
            "narrator": "子供たち",
            "text": "不審者だ―！",
            "zh": "是可疑人员—！",
            "narrator_zh": "孩子们"
        },
        {
            "location": "441/TALK",
            "narrator": "ガブリエラ",
            "text": "えぇっ！？\nちょ、あたしは\n別に！",
            "zh": "哎哎！？\n等、我才\n不是！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "445/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィ！？",
            "zh": "加维！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "446/TALK",
            "narrator": "ガブリエラ",
            "text": "あちゃー、\nバレちゃった…。",
            "zh": "哎呀—，\n还是被发现了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "471/TALK",
            "narrator": "アーヤ",
            "text": "こんなところで\n何やってるの！？",
            "zh": "你跑到这种地方\n在干什么啊！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "473/TALK",
            "narrator": "ガブリエラ",
            "text": "え、えっと、\nそれは…。",
            "zh": "那、那个，\n其实是……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "474/TALK",
            "narrator": "ガブリエラ",
            "text": "しまったぁ…。\nさっさと逃げてれば\nよかったわ…。",
            "zh": "糟了啊……。\n刚才直接跑掉\n就好了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "475/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "476/TALK",
            "narrator": "アーヤ",
            "text": "はぁ…まあ、いつか\nバレちゃうとは\n思ってたけど……。",
            "zh": "唉……算了，反正\n我也早料到迟早会\n被发现的……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "477/TALK",
            "narrator": "ガブリエラ",
            "text": "あ、あの…、黙って\n付いてきちゃって、\nごめん…。",
            "zh": "那、那个……，没打招呼\n就偷偷跟过来了，\n对不起……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "478/TALK",
            "narrator": "アーヤ",
            "text": "…ううん。\n別に怒ってないから。",
            "zh": "……没事。\n我并没有生气。",
            "narrator_zh": "绫水"
        },
        {
            "location": "479/TALK",
            "narrator": "アーヤ",
            "text": "とにかく、あなたも一緒に\n子供たちのところに来て。",
            "zh": "总之，你也跟我一起\n到小朋友们那边去吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "481/TALK",
            "narrator": "ガブリエラ",
            "text": "あ、あたしも！？",
            "zh": "我、我也要去！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "482/TALK",
            "narrator": "アーヤ",
            "text": "ちゃんと説明しないと\nお話の続きを聞いて\nもらえないでしょ？",
            "zh": "不好好向大家解释清楚，\n他们可没法安心听我\n讲后面的故事对吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "483/TALK",
            "narrator": "アーヤ",
            "text": "大丈夫だから、\n一緒に来て。",
            "zh": "没关系的，\n一起过来吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "484/TALK",
            "narrator": "ガブリエラ",
            "text": "う、うん…。",
            "zh": "嗯、嗯……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "488/TALK",
            "narrator": "ガブリエラ",
            "text": "…何だか、思ったより\n面倒なことに\nなっちゃったっぽい？",
            "zh": "……总觉得，好像比\n预想中还要麻烦\n了一点？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "489/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤやみんなにも、\n迷惑掛けちゃってる\nみたいだし…。",
            "zh": "好像也给绫水和\n大家都添了\n不少麻烦……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "490/TALK",
            "narrator": "ガブリエラ",
            "text": "…でも、アーヤの\n秘密が知れたのは、\nちょっと嬉しいかも。",
            "zh": "……不过，能够知道\n绫水的秘密，\n心里还是有点小开心呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "491/TALK",
