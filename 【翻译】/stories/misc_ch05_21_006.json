    "entry": [
        {
            "location": "6970/SCENARIO",
            "narrator": "",
            "text": "セイラーの企て",
            "zh": "水手的盘算",
            "narrator_zh": ""
        },
        {
            "location": "6997/TALK",
            "narrator": "神楽",
            "text": "日本でセーラー服っていえば",
            "zh": "在日本说到水手服",
            "narrator_zh": "神乐"
        },
        {
            "location": "6998/TALK",
            "narrator": "神楽",
            "text": "女学生の制服だよね？",
            "zh": "就是女学生的制服吧？",
            "narrator_zh": "神乐"
        },
        {
            "location": "7000/SEL",
            "narrator": "",
            "text": "長崎の女子校が最古参らしい",
            "zh": "好像长崎的女校是最早的",
            "narrator_zh": ""
        },
        {
            "location": "7001/SEL",
            "narrator": "",
            "text": "三つ編みに三つ折りソックス！",
            "zh": "三股辫配三折袜！",
            "narrator_zh": ""
        },
        {
            "location": "7002/SEL",
            "narrator": "",
            "text": "神楽も着て欲しいな～",
            "zh": "也想让神乐穿啊～",
            "narrator_zh": ""
        },
        {
            "location": "7003/ACT",
            "narrator": "",
            "text": "長崎の女子校が最古参らしい",
            "zh": "好像长崎的女校是最早的",
            "narrator_zh": ""
        },
        {
            "location": "7004/TALK",
            "narrator": "神楽",
            "text": "マジで？",
            "zh": "真的？",
            "narrator_zh": "神乐"
        },
        {
            "location": "7006/TALK",
            "narrator": "神楽",
            "text": "長崎グッジョブ！",
            "zh": "长崎干得好！",
            "narrator_zh": "神乐"
        },
        {
            "location": "7007/ACT",
            "narrator": "",
            "text": "三つ編みに三つ折りソックス！",
            "zh": "三股辫配三折袜！",
            "narrator_zh": ""
        },
        {
            "location": "7008/TALK",
            "narrator": "神楽",
            "text": "古の女学生！！！",
            "zh": "古代的女学生！！！",
            "narrator_zh": "神乐"
        },
        {
            "location": "7009/ACT",
            "narrator": "",
            "text": "神楽も着て欲しいな～",
            "zh": "也想让神乐穿啊～",
            "narrator_zh": ""
        },
        {
            "location": "7011/TALK",
            "narrator": "神楽",
            "text": "ぴょんこに！？",
            "zh": "给蹦子！？",
            "narrator_zh": "神乐"
        },
        {
            "location": "7013/TALK",
            "narrator": "神楽",
            "text": "そんなことしたらぴょんこ一人だけ超絶かわいい感じになっちゃうしー",
            "zh": "那样做的话，就蹦子一个人会变得超级可爱——",
            "narrator_zh": "神乐"
        },
        {
            "location": "7014/TALK",
            "narrator": "神楽",
            "text": "平たく言うと無理じゃね？",
            "zh": "直白说，不行吧？",
            "narrator_zh": "神乐"
        },
        {
            "location": "7016/TALK",
            "narrator": "神楽",
            "text": "でもセーラーって元々は海軍の制服だったわけじゃないですかー",
            "zh": "可水手原本是海军的制服吧",
            "narrator_zh": "神乐"
        },
        {
            "location": "7017/TALK",
            "narrator": "神楽",
            "text": "方向性違いすぎ！",
            "zh": "方向差太多了！",
            "narrator_zh": "神乐"
        },
        {
            "location": "7019/SEL",
            "narrator": "",
            "text": "バンドだったら解散する事態",
            "zh": "要是乐队的话就是解散的事态",
            "narrator_zh": ""
        },
        {
            "location": "7020/SEL",
            "narrator": "",
            "text": "不思議だよね",
            "zh": "很不可思议呢",
            "narrator_zh": ""
        },
        {
            "location": "7021/SEL",
            "narrator": "",
            "text": "神楽が可愛かったら何でもいい",
            "zh": "神乐可爱的话什么都行",
            "narrator_zh": ""
        },
        {
            "location": "7022/ACT",
            "narrator": "",
            "text": "バンドだったら解散する事態",
            "zh": "要是乐队的话就是解散的事态",
            "narrator_zh": ""
        },
        {
            "location": "7023/TALK",
            "narrator": "神楽",
            "text": "ほんそれ！",
            "zh": "就是这个！",
            "narrator_zh": "神乐"
        },
        {
            "location": "7024/ACT",
            "narrator": "",
            "text": "不思議だよね",
            "zh": "很不可思议呢",
            "narrator_zh": ""
        },
        {
            "location": "7025/TALK",
            "narrator": "神楽",
            "text": "なんでこうなったｗ",
            "zh": "为什么变成这样哈哈",
            "narrator_zh": "神乐"
        },
        {
            "location": "7026/ACT",
            "narrator": "",
            "text": "神楽が可愛かったら何でもいい",
            "zh": "神乐可爱的话什么都行",
            "narrator_zh": ""
        },
        {
            "location": "7028/TALK",
            "narrator": "神楽",
            "text": "いつもいつも同じ反応されても～～～",
            "zh": "每次都是同样的反应的话——",
            "narrator_zh": "神乐"
        },
        {
            "location": "7029/TALK",
            "narrator": "神楽",
            "text": "反応に困っちゃうぴょん",
            "zh": "反应都会困扰pyon",
            "narrator_zh": "神乐"
        },
        {
            "location": "7031/TALK",
            "narrator": "神楽",
            "text": "愛の言葉はもっとひねってくれないとー！",
            "zh": "爱的话不拐个弯可不行——！",
            "narrator_zh": "神乐"
        },
        {
            "location": "7032/TALK",
            "narrator": "神楽",
            "text": "月が綺麗ですねみたいに！！！",
            "zh": "要像「月亮真美」那样！！！",
            "narrator_zh": "神乐"
        },
        {
            "location": "7033/TALK",
            "narrator": "神楽",
            "text": "やぼなひとねもう！",
            "zh": "真是不解风情的人！",
            "narrator_zh": "神乐"
        },
        {
            "location": "7035/TALK",
            "narrator": "神楽",
            "text": "そんでもってセーラー服は持ってってもいいらしいぴょん",
            "zh": "而且水手服好像可以带走pyon",
            "narrator_zh": "神乐"
        },
        {
            "location": "7036/TALK",
            "narrator": "神楽",
            "text": "もらっとけー！",
            "zh": "就收下吧——！",
            "narrator_zh": "神乐"
        }
    ]
}
