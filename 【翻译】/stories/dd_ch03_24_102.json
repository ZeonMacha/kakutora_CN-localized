{
    "dir": "chap24/daydra/dd_ch03_24_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "24305",
        "cid": "gabriella",
        "title": "005 メインストーリー",
        "sub_title": "貴方に焦がれる手紙＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "思念你的信＜后篇＞"
    },
    "entry": [
        {
            "location": "613/TALK",
            "narrator": "ガブリエラ",
            "text": "…そっか。",
            "zh": "……这样啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "614/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしが許せないのって、\n神楽だけじゃない…。",
            "zh": "我无法原谅的，\n不只是神乐而已……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "615/TALK",
            "narrator": "ガブリエラ",
            "text": "神楽をいつまでも信じる\nつばめに対しても、\n怒ってたんだ…。",
            "zh": "对不管什么时候都相信\n神乐的燕，\n我也在生气啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "616/TALK",
            "narrator": "繭",
            "text": "…やっと気づいた？",
            "zh": "……终于意识到了？",
            "narrator_zh": "茧"
        },
        {
            "location": "617/TALK",
            "narrator": "ガブリエラ",
            "text": "…繭は気づいてたの？",
            "zh": "……茧早就察觉到了吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "619/TALK",
            "narrator": "雛",
            "text": "まゆちんだけじゃないよ。",
            "zh": "不只是小茧哦。",
            "narrator_zh": "雏"
        },
        {
            "location": "620/TALK",
            "narrator": "雛",
            "text": "っていうか、\nガブリエラちゃん\nわかりやす過ぎー。",
            "zh": "倒不如说，\n加布里埃拉你表现得\n太明显了啦—。",
            "narrator_zh": "雏"
        },
        {
            "location": "621/TALK",
            "narrator": "繭",
            "text": "むしろ、今まで\n気づかなかったのが\n不思議でならない。",
            "zh": "不如说，你至今为止\n一直没察觉到才更让人\n觉得不可思议。",
            "narrator_zh": "茧"
        },
        {
            "location": "624/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "625/TALK",
            "narrator": "雛",
            "text": "…でも\nガブリエラちゃんも\n大変だよね。",
            "zh": "……不过\n加布里埃拉也\n挺不容易的呢。",
            "narrator_zh": "雏"
        },
        {
            "location": "626/TALK",
            "narrator": "雛",
            "text": "手のかかる\n後輩の面倒\n見なきゃいけなくて。",
            "zh": "得照顾那么\n让人操心的\n学妹才行。",
            "narrator_zh": "雏"
        },
        {
            "location": "629/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "630/TALK",
            "narrator": "ガブリエラ",
            "text": "でも…、\nわかってるから。",
            "zh": "可是……，\n我其实明白的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "632/TALK",
            "narrator": "ガブリエラ",
            "text": "つばめはそういう子だ、\nって…。",
            "zh": "燕她就是那样的孩子，\n我明白的……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "633/TALK",
            "narrator": "繭",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "茧"
        },
        {
            "location": "634/TALK",
            "narrator": "雛",
            "text": "…大丈夫だよ。",
            "zh": "……没关系的。",
            "narrator_zh": "雏"
        },
        {
            "location": "635/TALK",
            "narrator": "雛",
            "text": "ガブリエラちゃんは、\n今はちょっと、\n混乱してるだけ。",
            "zh": "加布里埃拉你现在\n只是稍微有点\n混乱罢了。",
            "narrator_zh": "雏"
        },
        {
            "location": "636/TALK",
            "narrator": "雛",
            "text": "この数日で色んなこと\nあって、気持ちの整理が\nついてないだけだよ。",
            "zh": "这几天发生了那么多事，\n只是还没能理清自己的\n心情而已啦。",
            "narrator_zh": "雏"
        },
        {
            "location": "638/TALK",
            "narrator": "ガブリエラ",
            "text": "…そうかもしれない。",
            "zh": "……或许是这样吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "639/TALK",
            "narrator": "繭",
            "text": "…珍しく素直？",
            "zh": "……难得这么坦率？",
            "narrator_zh": "茧"
        },
        {
            "location": "640/TALK",
            "narrator": "ガブリエラ",
            "text": "珍しくっていうのは\n余計よ！",
            "zh": "“难得”这两个字\n太多余了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "641/TALK",
            "narrator": "ガブリエラ",
            "text": "…でも、よかったわ。",
            "zh": "……不过，太好了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "642/TALK",
            "narrator": "ガブリエラ",
            "text": "二人と話して、\n自分の気持ちに\n気づけた。",
            "zh": "和你们俩聊过之后，\n我总算察觉到\n自己的心情了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "643/TALK",
            "narrator": "ガブリエラ",
            "text": "おかげで、これから\nどうするかの答えが、\n一つだけ出た気がするわ。",
            "zh": "多亏了这番话，接下来\n该怎么做，我好像得出\n一个答案了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "644/TALK",
            "narrator": "雛",
            "text": "え？　でもあたし達、\n普通に話してただけ\nなんだけど…。",
            "zh": "诶？ 可是我们刚才\n也就只是普通地\n聊天而已啊……。",
            "narrator_zh": "雏"
        },
        {
            "location": "646/TALK",
            "narrator": "ガブリエラ",
            "text": "そんなことないわ。",
            "zh": "才不是呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "647/TALK",
            "narrator": "ガブリエラ",
            "text": "さっきまで感じてた\n胸のモヤモヤ、\nもう感じなくなったし。",
            "zh": "刚才心里一直感觉到的\n那股闷堵，\n现在已经消失了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "648/TALK",
            "narrator": "雛",
            "text": "そっか…。\n少しでも力になれたなら、\nこっちも嬉しいよ。",
            "zh": "这样啊……。\n哪怕能帮上一点忙，\n我这边也很高兴哦。",
            "narrator_zh": "雏"
        },
        {
            "location": "651/TALK",
            "narrator": "ガブリエラ",
            "text": "ええ…、\nか、感謝するわ…。",
            "zh": "嗯……，\n感、感谢你们……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "652/TALK",
            "narrator": "繭",
            "text": "ありがとう、で\nいいのよ？",
            "zh": "直接说“谢谢”\n不就好了？",
            "narrator_zh": "茧"
        },
        {
            "location": "654/TALK",
            "narrator": "ガブリエラ",
            "text": "か、感謝の言葉に\n変わりないんだから、\nいいでしょ！",
            "zh": "反、反正都是表达\n感谢的话，\n没差吧！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "655/TALK",
            "narrator": "雛",
            "text": "あはは、本当に\n調子戻ってきた\nみたいだねー。",
            "zh": "啊哈哈，看来真的\n恢复平时状态\n了呢—。",
            "narrator_zh": "雏"
        },
        {
            "location": "657/TALK",
            "narrator": "雛",
            "text": "…あっ、いけない。\nもうこんな時間！",
            "zh": "……啊，糟糕。\n都这个时间了！",
            "narrator_zh": "雏"
        },
        {
            "location": "659/TALK",
            "narrator": "雛",
            "text": "あたしそろそろ\n帰らないと…。",
            "zh": "我差不多\n得回去了……。",
            "narrator_zh": "雏"
        },
        {
            "location": "661/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしはもう少し残るわ。",
            "zh": "我再稍微待一会儿。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "662/TALK",
            "narrator": "ガブリエラ",
            "text": "もう少し、\n考えを整理したいし…。",
            "zh": "我还想再多整理一下\n自己的思绪……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "664/TALK",
            "narrator": "雛",
            "text": "わかった…。",
            "zh": "我知道了……。",
            "narrator_zh": "雏"
        },
        {
            "location": "665/TALK",
            "narrator": "雛",
            "text": "もし話し相手が必要なら、\nいつでもＷＡＶＥ\n送ってきてね。",
            "zh": "要是需要找人聊聊，\n随时用WAVE\n发消息过来哦。",
            "narrator_zh": "雏"
        },
        {
            "location": "666/TALK",
            "narrator": "ガブリエラ",
            "text": "気が向いたらね。",
            "zh": "看心情吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "667/TALK",
            "narrator": "雛",
            "text": "じゃあ、またねー。",
            "zh": "那，回见咯—。",
            "narrator_zh": "雏"
        },
        {
            "location": "668/TALK",
            "narrator": "繭",
            "text": "…それじゃ。",
            "zh": "……走了。",
            "narrator_zh": "茧"
        },
        {
            "location": "670/TALK",
            "narrator": "ガブリエラ",
            "text": "うん、またね。",
            "zh": "嗯，回见。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "689/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "690/TALK",
            "narrator": "ガブリエラ",
            "text": "…よし、決めた。",
            "zh": "……好，决定了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "702/TALK",
            "narrator": "ガブリエラ",
            "text": "やっとわかったことがあるの",
            "zh": "有件事我终于想明白了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "703/TALK",
            "narrator": "ガブリエラ",
            "text": "聞いてもらえる？",
            "zh": "能听我说吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "705/SEL",
            "narrator": "",
            "text": "ガブの話ならいつでも",
            "zh": "如果是加布的话随时都行",
            "narrator_zh": ""
        },
        {
            "location": "706/SEL",
            "narrator": "",
            "text": "何がわかったの？",
            "zh": "想明白什么了？",
            "narrator_zh": ""
        },
        {
            "location": "707/SEL",
            "narrator": "",
            "text": "$me$への愛かな？",
            "zh": "难道是对$me$的爱吗？",
            "narrator_zh": ""
        },
        {
            "location": "708/ACT",
            "narrator": "",
            "text": "ガブの話ならいつでも",
            "zh": "如果是加布的话随时都行",
            "narrator_zh": ""
        },
        {
            "location": "709/TALK",
            "narrator": "ガブリエラ",
            "text": "ありがとうｖ",
            "zh": "谢谢ｖ",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "710/ACT",
            "narrator": "",
            "text": "何がわかったの？",
            "zh": "想明白什么了？",
            "narrator_zh": ""
        },
        {
            "location": "711/TALK",
            "narrator": "ガブリエラ",
            "text": "ええとね",
            "zh": "那个呀",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "712/ACT",
            "narrator": "",
            "text": "$me$への愛かな？",
            "zh": "难道是对$me$的爱吗？",
            "narrator_zh": ""
        },
        {
            "location": "714/TALK",
            "narrator": "ガブリエラ",
            "text": "違うわよ",
            "zh": "才不是呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "716/TALK",
            "narrator": "ガブリエラ",
            "text": "つばめのことよ",
            "zh": "是关于燕的事",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "717/TALK",
            "narrator": "ガブリエラ",
            "text": "神楽を敵として見ろって",
            "zh": "把神乐当敌人看待",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "718/TALK",
            "narrator": "ガブリエラ",
            "text": "説得するの",
            "zh": "这样去说服她",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "719/TALK",
            "narrator": "ガブリエラ",
            "text": "絶対無理だと思うの",
            "zh": "我觉得绝对是不可能的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "721/SEL",
            "narrator": "",
            "text": "何か事情を知ってるんじゃない？",
            "zh": "她是不是知道什么隐情？",
            "narrator_zh": ""
        },
        {
            "location": "722/SEL",
            "narrator": "",
            "text": "そんな感じだよね",
            "zh": "确实是那种感觉呢",
            "narrator_zh": ""
        },
        {
            "location": "723/SEL",
            "narrator": "",
            "text": "つばめは神楽大好きだからね",
            "zh": "因为燕最喜欢神乐了嘛",
            "narrator_zh": ""
        },
        {
            "location": "724/ACT",
            "narrator": "",
            "text": "何か事情を知ってるんじゃない？",
            "zh": "她是不是知道什么隐情？",
            "narrator_zh": ""
        },
        {
            "location": "726/TALK",
            "narrator": "ガブリエラ",
            "text": "そうなのかしら？",
            "zh": "是这样吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "727/TALK",
            "narrator": "ガブリエラ",
            "text": "でも",
            "zh": "不过",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "728/TALK",
            "narrator": "ガブリエラ",
            "text": "それが本当とは限らないわ",
            "zh": "那也未必就是真的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "729/ACT",
            "narrator": "",
            "text": "そんな感じだよね",
            "zh": "确实是那种感觉呢",
            "narrator_zh": ""
        },
        {
            "location": "731/TALK",
            "narrator": "ガブリエラ",
            "text": "やっぱり",
            "zh": "果然",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "732/TALK",
            "narrator": "ガブリエラ",
            "text": "$handle$から見ても",
            "zh": "从$handle$的角度来看",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "733/TALK",
            "narrator": "ガブリエラ",
            "text": "そうなのね",
            "zh": "也是这样呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "734/ACT",
            "narrator": "",
            "text": "つばめは神楽大好きだからね",
            "zh": "因为燕最喜欢神乐了嘛",
            "narrator_zh": ""
        },
        {
            "location": "736/TALK",
            "narrator": "ガブリエラ",
            "text": "どうなのかしらね？",
            "zh": "谁知道呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "738/TALK",
            "narrator": "ガブリエラ",
            "text": "大好きなのは",
            "zh": "说不定她最喜欢的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "739/TALK",
            "narrator": "ガブリエラ",
            "text": "メノウだったりして",
            "zh": "其实是MENOW呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "743/TALK",
            "narrator": "ガブリエラ",
            "text": "まあ",
            "zh": "算了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "744/TALK",
            "narrator": "ガブリエラ",
            "text": "そんなのどうでもいいわ",
            "zh": "那种事怎样都无所谓",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "745/TALK",
            "narrator": "ガブリエラ",
            "text": "とにかくわかったの",
            "zh": "总之我想明白了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "746/TALK",
            "narrator": "ガブリエラ",
            "text": "もうつばめの説得は無理",
            "zh": "已经不可能说服燕了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "747/TALK",
            "narrator": "ガブリエラ",
            "text": "神楽を敵として見ろとか",
            "zh": "什么把神乐当敌人看待之类的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "748/TALK",
            "narrator": "ガブリエラ",
            "text": "言うだけ無駄",
            "zh": "说了也是白说",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "749/TALK",
            "narrator": "ガブリエラ",
            "text": "期待するだけ無駄",
            "zh": "期待也是白期待",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "753/TALK",
            "narrator": "ガブリエラ",
            "text": "だから",
            "zh": "所以",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "754/TALK",
            "narrator": "ガブリエラ",
            "text": "もう神楽のことに関しては",
            "zh": "关于神乐的事",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "755/TALK",
            "narrator": "ガブリエラ",
            "text": "つばめには何も期待しない",
            "zh": "我对燕不会再抱任何期待",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "756/TALK",
            "narrator": "ガブリエラ",
            "text": "何も求めない",
            "zh": "也不会再有所要求",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "757/TALK",
