    "type": "MainStory",
    "info": {
        "story_id": "9205",
        "cid": "ayami",
        "title": "005 メインストーリー",
        "sub_title": "臆する季節＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "畏缩的季节＜后篇＞"
    },
    "entry": [
        {
            "location": "297/SCENARIO",
            "narrator": "",
            "text": "臆する季節",
            "zh": "畏缩的季节",
            "narrator_zh": ""
        },
        {
            "location": "313/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "316/TALK",
            "narrator": "小夜",
            "text": "じゃあさ、これは\nどうかしら？",
            "zh": "那，这个\n怎么样呢？",
            "narrator_zh": "小夜"
        },
        {
            "location": "317/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "318/TALK",
            "narrator": "小夜",
            "text": "アーヤ？",
            "zh": "绫水？",
            "narrator_zh": "小夜"
        },
        {
            "location": "321/TALK",
            "narrator": "アーヤ",
            "text": "あっ、ごめん。\n何の話だっけ？",
            "zh": "啊，抱歉。\n刚才说到哪儿了？",
            "narrator_zh": "绫水"
        },
        {
            "location": "322/TALK",
            "narrator": "小夜",
            "text": "うん…\nさっき話してた子って――",
            "zh": "嗯……\n刚才和你说话的那个女孩子——",
            "narrator_zh": "小夜"
        },
        {
            "location": "323/TALK",
            "narrator": "小夜",
            "text": "もしかして、\nトライナリーの\nメンバー？",
            "zh": "该不会，\n她是三重奏的\n成员吧？",
            "narrator_zh": "小夜"
        },
        {
            "location": "326/TALK",
            "narrator": "アーヤ",
            "text": "…話聞かれてたし、\n隠してもバレバレ\nよね。",
            "zh": "……话都被你听见了，\n就算想瞒也早就\n露馅了吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "329/TALK",
            "narrator": "アーヤ",
            "text": "はぁ…そうよ。\nでも、秘密だからね？",
            "zh": "唉……没错。\n不过，要保密哦？",
            "narrator_zh": "绫水"
        },
        {
            "location": "331/TALK",
            "narrator": "小夜",
            "text": "うわぁ、そうなんだ！",
            "zh": "哇，真的是啊！",
            "narrator_zh": "小夜"
        },
        {
            "location": "332/TALK",
            "narrator": "小夜",
            "text": "あの子って確か…、\n中等部の子よね？",
            "zh": "那个女孩子好像是……\n初中部的学生对吧？",
            "narrator_zh": "小夜"
        },
        {
            "location": "334/TALK",
            "narrator": "アーヤ",
            "text": "知ってるの？",
            "zh": "你认识她？",
            "narrator_zh": "绫水"
        },
        {
            "location": "336/TALK",
            "narrator": "小夜",
            "text": "何度か見たけたこと\nある程度だけど――",
            "zh": "只是见过几次\n而已啦——",
            "narrator_zh": "小夜"
        },
        {
            "location": "338/TALK",
            "narrator": "小夜",
            "text": "超可愛いんだもの。\n一度見たら忘れられ\nないって。",
            "zh": "因为她超级可爱的嘛。\n只要见过一次\n就忘不掉啊。",
            "narrator_zh": "小夜"
        },
        {
            "location": "339/TALK",
            "narrator": "アーヤ",
            "text": "あはは、確かに。\nギャヴィの可愛さは\n飛びぬけてるわね。",
            "zh": "啊哈哈，确实。\n加维的可爱程度\n真是出类拔萃呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "341/TALK",
            "narrator": "小夜",
            "text": "肌も白くて綺麗だし、\nお人形さんみたい。",
            "zh": "皮肤又白又水灵，\n简直像人偶一样。",
            "narrator_zh": "小夜"
        },
        {
            "location": "343/TALK",
            "narrator": "小夜",
            "text": "ギュッてして、\nスリスリー、って\nしてみたいなぁ。",
            "zh": "真想紧紧抱住她，\n蹭啊蹭啊地\n贴贴看呢。",
            "narrator_zh": "小夜"
        },
        {
            "location": "345/TALK",
            "narrator": "アーヤ",
            "text": "あ、あはは…。",
            "zh": "啊、啊哈哈……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "347/TALK",
            "narrator": "アーヤ",
            "text": "そんなことしたら\n絶対に怒る――",
            "zh": "要是真那么做了，\n她绝对会生气的——",
            "narrator_zh": "绫水"
        },
        {
            "location": "348/TALK",
            "narrator": "アーヤ",
            "text": "ううん、多分驚いて\n固まるわね…。",
            "zh": "不对，大概会吓到\n直接僵住吧……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "351/TALK",
            "narrator": "小夜",
            "text": "…ねえ、アーヤ。\nお願い！",
            "zh": "……呐，绫水。\n拜托你啦！",
            "narrator_zh": "小夜"
        },
        {
            "location": "352/TALK",
            "narrator": "小夜",
            "text": "トライナリーの\nみんなを――",
            "zh": "能不能把三重奏的\n大家——",
            "narrator_zh": "小夜"
        },
        {
            "location": "353/TALK",
            "narrator": "小夜",
            "text": "あたしに紹介して\nくれない？",
            "zh": "介绍给我\n认识啊？",
            "narrator_zh": "小夜"
        },
        {
            "location": "357/TALK",
            "narrator": "アーヤ",
            "text": "えっ！？",
            "zh": "哎！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "359/TALK",
            "narrator": "小夜",
            "text": "だって、その子達って\nアーヤと一緒に戦う\n仲間なんでしょ？",
            "zh": "因为，那些女孩子\n都是和绫水一起战斗的\n同伴对吧？",
            "narrator_zh": "小夜"
        },
        {
            "location": "360/TALK",
            "narrator": "小夜",
            "text": "なら、友達としては\n挨拶しときたいし――",
            "zh": "既然如此，作为你的朋友\n总想打声招呼嘛——",
            "narrator_zh": "小夜"
        },
        {
            "location": "361/TALK",
            "narrator": "小夜",
            "text": "ついでに、私も\n仲良くなりたいの。",
            "zh": "顺便，我也想\n和她们混熟呢。",
            "narrator_zh": "小夜"
        },
        {
            "location": "362/TALK",
            "narrator": "小夜",
            "text": "ね、いいでしょ？",
            "zh": "好不好嘛，可以吧？",
            "narrator_zh": "小夜"
        },
        {
            "location": "363/TALK",
            "narrator": "アーヤ",
            "text": "えっ！？",
            "zh": "哎！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "364/TALK",
            "narrator": "小夜",
            "text": "ダメかしら？",
            "zh": "不行吗？",
            "narrator_zh": "小夜"
        },
        {
            "location": "367/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "368/TALK",
            "narrator": "アーヤ",
            "text": "ううん、いいわよ。",
            "zh": "没有，可以哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "370/TALK",
            "narrator": "小夜",
            "text": "え、本当！？",
            "zh": "哎，真的吗！？",
            "narrator_zh": "小夜"
        },
        {
            "location": "371/TALK",
            "narrator": "アーヤ",
            "text": "ええ、すぐには\n無理かもしれない\nけど――",
            "zh": "嗯，虽然马上安排\n可能有点困难\n不过——",
            "narrator_zh": "绫水"
        },
        {
            "location": "372/TALK",
            "narrator": "アーヤ",
            "text": "みんなで食事にでも\n行きましょ。",
            "zh": "大家找个时间一起\n吃顿饭吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "373/TALK",
            "narrator": "小夜",
            "text": "やった！\n凄く楽しみ。",
            "zh": "太好了！\n好期待啊。",
            "narrator_zh": "小夜"
        },
        {
            "location": "375/TALK",
            "narrator": "アーヤ",
            "text": "でも、さっき言ってた\nようなことしたら\nダメよ？",
            "zh": "不过，刚才说的\n那种事可不许\n做哦？",
            "narrator_zh": "绫水"
        },
        {
            "location": "377/TALK",
            "narrator": "小夜",
            "text": "ギューとかスリスリ？\nさすがにあれは\n冗談よ。",
            "zh": "抱抱和蹭蹭吗？\n那当然只是\n开玩笑啦。",
            "narrator_zh": "小夜"
        },
        {
            "location": "378/TALK",
            "narrator": "小夜",
            "text": "でも、本当にいいの？\nアーヤ的に、\n迷惑だったりしない？",
            "zh": "不过，真的没关系吗？\n对绫水来说，\n会不会觉得很添麻烦？",
            "narrator_zh": "小夜"
        },
        {
            "location": "379/TALK",
            "narrator": "アーヤ",
            "text": "ん？",
            "zh": "嗯？",
            "narrator_zh": "绫水"
        },
        {
            "location": "381/TALK",
            "narrator": "アーヤ",
            "text": "うん…迷惑っていう\nよりかは――",
            "zh": "嗯……与其说是\n添麻烦——",
            "narrator_zh": "绫水"
        },
        {
            "location": "382/TALK",
            "narrator": "アーヤ",
            "text": "私も、紹介するのが\nちょっと楽しみかも。",
            "zh": "我自己，好像也稍微有点\n期待把大家介绍给你呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "383/TALK",
            "narrator": "小夜",
            "text": "そっか…。\nそれ聞いて安心した。",
            "zh": "这样啊……。\n听你这么说我就放心了。",
            "narrator_zh": "小夜"
        },
        {
            "location": "385/TALK",
            "narrator": "小夜",
            "text": "楽しみだなぁ。",
            "zh": "好期待呀。",
            "narrator_zh": "小夜"
        },
        {
            "location": "388/TALK",
            "narrator": "アーヤ",
            "text": "ふふっ…。",
            "zh": "呵呵……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "400/TALK",
            "narrator": "アーヤ",
            "text": "何だか不思議（￣ー￣？）",
            "zh": "总觉得有点不可思议（￣ー￣？）",
            "narrator_zh": "绫水"
        },
        {
            "location": "401/TALK",
            "narrator": "アーヤ",
            "text": "まさか",
            "zh": "没想到",
            "narrator_zh": "绫水"
        },
        {
            "location": "402/TALK",
            "narrator": "アーヤ",
            "text": "小夜にみんなを紹介するのを",
            "zh": "把大家介绍给小夜这件事",
            "narrator_zh": "绫水"
        },
        {
            "location": "403/TALK",
            "narrator": "アーヤ",
            "text": "楽しみに感じるなんて(^^",
            "zh": "我竟然也会感到期待(^^",
            "narrator_zh": "绫水"
        },
        {
            "location": "405/TALK",
            "narrator": "アーヤ",
            "text": "今までの私なら",
            "zh": "要是换作以前的我",
            "narrator_zh": "绫水"
        },
        {
            "location": "406/TALK",
            "narrator": "アーヤ",
            "text": "断ってたはずなのに",
            "zh": "明明肯定会拒绝的",
            "narrator_zh": "绫水"
        },
        {
            "location": "408/SEL",
            "narrator": "",
            "text": "$me$のおかげだからね",
            "zh": "这可都是托$me$的福呢",
            "narrator_zh": ""
        },
        {
            "location": "409/ACT",
            "narrator": "",
            "text": "$me$のおかげだからね",
            "zh": "这可都是托$me$的福呢",
            "narrator_zh": ""
        },
        {
            "location": "411/TALK",
            "narrator": "アーヤ",
            "text": "はい？(￣Д￣ )",
            "zh": "什么？(￣Д￣ )",
            "narrator_zh": "绫水"
        },
        {
            "location": "413/TALK",
            "narrator": "アーヤ",
            "text": "どういうこと？（￣ー￣？）",
            "zh": "什么意思？（￣ー￣？）",
            "narrator_zh": "绫水"
        },
        {
            "location": "415/SEL",
            "narrator": "",
            "text": "$me$がそう思えるようにした",
            "zh": "是$me$让你这么想的",
            "narrator_zh": ""
        },
        {
            "location": "416/ACT",
            "narrator": "",
            "text": "$me$がそう思えるようにした",
            "zh": "是$me$让你这么想的",
            "narrator_zh": ""
        },
        {
            "location": "419/TALK",
            "narrator": "アーヤ",
            "text": "ジョークかしら？(-ω-;)",
            "zh": "你在开玩笑吗？(-ω-;)",
            "narrator_zh": "绫水"
        },
        {
            "location": "420/TALK",
            "narrator": "アーヤ",
            "text": "そんなことできるわけないでしょ？",
            "zh": "这种事怎么可能做得到嘛？",
            "narrator_zh": "绫水"
        },
        {
            "location": "422/SEL",
            "narrator": "",
            "text": "本当なのに…",
            "zh": "明明是真的……",
            "narrator_zh": ""
        },
        {
            "location": "423/ACT",
            "narrator": "",
            "text": "本当なのに…",
            "zh": "明明是真的……",
            "narrator_zh": ""
        },
        {
            "location": "425/TALK",
            "narrator": "アーヤ",
            "text": "はいはい(^-^*)(･･*)(^-^*)(･･*)",
            "zh": "好好好(^-^*)(･･*)(^-^*)(･･*)",
            "narrator_zh": "绫水"
        },
        {
            "location": "426/TALK",
            "narrator": "アーヤ",
            "text": "じゃあ",
            "zh": "那就",
            "narrator_zh": "绫水"
        },
        {
            "location": "427/TALK",
            "narrator": "アーヤ",
            "text": "そういうことにしてお礼を言っておくわ",
            "zh": "权当是这么回事，先向你道个谢吧",
            "narrator_zh": "绫水"
        },
        {
            "location": "428/TALK",
            "narrator": "アーヤ",
            "text": "ありがとう(^з^)―☆",
            "zh": "谢谢(^з^)―☆",
            "narrator_zh": "绫水"
        },
        {
            "location": "451/DIALOG",
            "narrator": "Dialog_chapter_ch02",
            "text": "【07 愛，ロボット】",
            "zh": "【07 爱，机器人】",
            "narrator_zh": "Dialog_chapter_ch02"
        }
    ]
}
