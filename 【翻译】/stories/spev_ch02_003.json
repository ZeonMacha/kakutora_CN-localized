            "location": "158/TALK",
            "narrator": "透明アーヤ",
            "text": "…相手の動き…、\n次に移動する場所を\n予測して――",
            "zh": "……对手的动作……\n预测它\n下一步会去哪——",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "162/TALK",
            "narrator": "透明アーヤ",
            "text": "見えたッ！！",
            "zh": "看见了！！",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "163/TALK",
            "narrator": "透明アーヤ",
            "text": "……たあっ！！",
            "zh": "……哈啊！！",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "170/TALK",
            "narrator": "透明みやび",
            "text": "おおっ！！",
            "zh": "哦哦！！",
            "narrator_zh": "透明雅"
        },
        {
            "location": "172/TALK",
            "narrator": "透明ガブリエラ",
            "text": "うそっ！？",
            "zh": "不会吧！？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "174/TALK",
            "narrator": "透明アーヤ",
            "text": "やった！\nやっと取れ――",
            "zh": "成功了！\n终于捞到——",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "182/TALK",
            "narrator": "透明アーヤ",
            "text": "ちょ、えぇぇっ！？",
            "zh": "等、咦咦咦！？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "186/TALK",
            "narrator": "透明ガブリエラ",
            "text": "な、何よその\nエッチな取り方！",
            "zh": "什、什么呀，\n这种色气的捞法！",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "188/TALK",
            "narrator": "透明アーヤ",
            "text": "ち、違う！\n金魚が勝手に\n跳ねて――",
            "zh": "不、不是！\n金鱼自己\n跳起来——",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "189/TALK",
            "narrator": "透明みやび",
            "text": "なるほど。\n胸をお碗代わりに\nする取り方か！",
            "zh": "原来如此。\n把胸口当碗\n来捞啊！",
            "narrator_zh": "透明雅"
        },
        {
            "location": "190/TALK",
            "narrator": "透明アーヤ",
            "text": "そうじゃなくて！\nそれより早くお碗\n取ってよ！",
            "zh": "不是那样！\n比起这个，快拿碗\n过来！",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "191/TALK",
            "narrator": "透明つばめ",
            "text": "は、はい！\nえっと…。",
            "zh": "好、好的！\n那个……",
            "narrator_zh": "透明燕"
        },
        {
            "location": "193/TALK",
            "narrator": "透明アーヤ",
            "text": "あっ、ダメダメダメ！\nこの子、奥入ろうと\nしてる！",
            "zh": "啊，不行不行不行！\n这孩子要往里面\n钻了！",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "194/TALK",
            "narrator": "透明アーヤ",
            "text": "早く、早くお碗！\nは、入っちゃうから！",
            "zh": "快点，快点拿碗！\n要、要进去了！",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "196/TALK",
            "narrator": "透明神楽",
            "text": "アーヤさん…、\n素晴らしいものを\n見せていただいて――",
            "zh": "绫水……\n让我看到了\n这么了不起的东西——",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "197/TALK",
            "narrator": "透明神楽",
            "text": "本当にありがとう\nございます！",
            "zh": "真的\n非常感谢！",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "199/TALK",
            "narrator": "透明アーヤ",
            "text": "ああもう！\nお碗取ってってば！",
            "zh": "啊，真是的！\n我说了快拿碗！",
            "narrator_zh": "透明绫水"
        }
    ]
}
