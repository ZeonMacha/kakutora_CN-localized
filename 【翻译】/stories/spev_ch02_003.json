    "info": {
        "story_id": "2003",
        "cid": "",
        "title": "スペシャルエピソード",
        "sub_title": "掬われた先に",
        "title_zh": "特别篇",
        "sub_title_zh": "被捞起的那一头"
    },
    "entry": [
        {
            "location": "27/TALK",
            "narrator": "透明アーヤ",
            "text": "集中して、\n狙いを定めたら\n一気に…。",
            "zh": "集中精神，\n瞄准之后\n一口气……",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "28/TALK",
            "narrator": "透明アーヤ",
            "text": "そこ！！",
            "zh": "就是那里！！",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "36/TALK",
            "narrator": "透明アーヤ",
            "text": "あっ、もう！\nまた穴空いちゃった。",
            "zh": "啊，真是的！\n又破了个洞。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "39/TALK",
            "narrator": "透明みやび",
            "text": "なんや、アーヤは\n金魚すくいが\n下手なんやねぇ。",
            "zh": "怎么，绫水\n捞金鱼\n这么不在行啵。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "40/TALK",
            "narrator": "透明アーヤ",
            "text": "ポイが水につけた\n瞬間溶けるんだもの。\nこれじゃ取れないわ。",
            "zh": "纸网一碰到水\n马上就化了。\n这样根本捞不到。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "42/TALK",
            "narrator": "透明ガブリエラ",
            "text": "あらぁ？\nそれって負け惜しみ\nかしらぁ？",
            "zh": "哎呀？\n这是在找借口\n不肯认输吧？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "43/TALK",
            "narrator": "透明神楽",
            "text": "ガブちゃんは\n凄過ぎですよ。",
            "zh": "加布\n也太厉害了。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "44/TALK",
            "narrator": "透明神楽",
            "text": "一つのポイで五匹も\n取るなんて、\n普通できませんから。",
            "zh": "一张纸网就捞五条，\n一般人\n做不到的。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "45/TALK",
            "narrator": "透明ガブリエラ",
            "text": "何事も修行よ、修行。\nほら、新人も集中して\nやってみなさいよ。",
            "zh": "什么事都是修行，修行。\n来，新人你也集中精神\n给我试试看。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "47/TALK",
            "narrator": "透明つばめ",
            "text": "で、できるかなぁ？",
            "zh": "我、我能行吗？",
            "narrator_zh": "透明燕"
        },
        {
            "location": "48/TALK",
            "narrator": "透明みやび",
            "text": "アーヤはどうする？",
            "zh": "绫水你怎么办？",
            "narrator_zh": "透明雅"
        },
        {
            "location": "49/TALK",
            "narrator": "透明アーヤ",
            "text": "もちろんやるけど、\nちょっと集中させて。",
            "zh": "当然要捞，\n先让我集中一下。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "50/TALK",
            "narrator": "透明ガブリエラ",
            "text": "集中だけでどうにか\nなると思ったら\n大間違いよ？",
            "zh": "以为光靠集中\n就能有办法，\n那可大错特错了？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "52/TALK",
            "narrator": "透明アーヤ",
            "text": "一匹くらいは\n取ってみせるわ…。",
            "zh": "至少一条\n我捞给你看……",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "53/SEL",
            "narrator": "（選択肢）",
            "text": "楽しそうだね",
            "zh": "看起来很开心",
            "narrator_zh": "（选项）"
        },
        {
            "location": "54/ACT",
            "narrator": "",
            "text": "楽しそうだね",
            "zh": "看起来很开心",
            "narrator_zh": ""
        },
        {
            "location": "61/TALK",
            "narrator": "アーヤ",
            "text": "楽しいけど",
            "zh": "是开心",
            "narrator_zh": "绫水"
        },
        {
            "location": "62/TALK",
            "narrator": "アーヤ",
            "text": "真剣なの！(>_<)",
            "zh": "但我是认真的！(>_<)",
            "narrator_zh": "绫水"
        },
        {
            "location": "63/TALK",
            "narrator": "アーヤ",
            "text": "金魚ってスゴいわ",
            "zh": "金鱼真厉害",
            "narrator_zh": "绫水"
        },
        {
            "location": "64/TALK",
            "narrator": "アーヤ",
            "text": "自分から",
            "zh": "自己就会",
            "narrator_zh": "绫水"
        },
        {
            "location": "65/TALK",
            "narrator": "アーヤ",
            "text": "ポイに穴開けてくるし(☆｡☆)",
            "zh": "把纸网戳出洞来(☆｡☆)",
            "narrator_zh": "绫水"
        },
        {
            "location": "66/SEL",
            "narrator": "（選択肢）",
            "text": "攻撃的な金魚だね",
            "zh": "好有攻击性的金鱼",
            "narrator_zh": "（选项）"
        },
        {
            "location": "67/ACT",
            "narrator": "",
            "text": "攻撃的な金魚だね",
            "zh": "好有攻击性的金鱼",
