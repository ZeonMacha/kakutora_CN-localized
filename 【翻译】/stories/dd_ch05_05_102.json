{
    "dir": "chap05/daydra/dd_ch05_05_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "5505",
        "cid": "kagura",
        "title": "005 メインストーリー",
        "sub_title": "しろいこ＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "白色的孩子＜后篇＞"
    },
    "entry": [
        {
            "location": "1935/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1937/TALK",
            "narrator": "千羽鶴",
            "text": "迷ってるようなら、\nこの場で答えを出す\n必要はない。",
            "zh": "要是还在犹豫，\n不必在这里\n给出答案。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1939/TALK",
            "narrator": "千羽鶴",
            "text": "また明日来るから、\nその時までに\n考えておいて。",
            "zh": "我明天还会来，\n在那之前\n想好。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1940/TALK",
            "narrator": "神楽",
            "text": "…いえ、\nその必要はありません。",
            "zh": "……不必，\n没那个必要。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1942/TALK",
            "narrator": "神楽",
            "text": "こちらからも一つ、\n条件があります。",
            "zh": "我这边也有一个\n条件。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1943/TALK",
            "narrator": "千羽鶴",
            "text": "どうぞ。",
            "zh": "请说。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1944/TALK",
            "narrator": "神楽",
            "text": "あなたに協力した場合、\nその契約期間中…。",
            "zh": "如果协助你，\n在那份契约期间……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1945/TALK",
            "narrator": "神楽",
            "text": "私がする質問には、\n全て正直に\n答えてください。",
            "zh": "我提出的问题，\n请全部\n老实回答。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1946/TALK",
            "narrator": "千羽鶴",
            "text": "…嘘を言ったら？",
            "zh": "……如果说谎呢？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1947/TALK",
            "narrator": "神楽",
            "text": "即時契約破棄です。",
            "zh": "契约立即作废。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1948/TALK",
            "narrator": "千羽鶴",
            "text": "…随分と強気なのね。\n私はあなたの大切なモノ、\n全て握ってるというのに。",
            "zh": "……还挺强硬的。\n可我握着你珍惜的东西，\n全部都握着。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1949/TALK",
            "narrator": "神楽",
            "text": "お互い様でしょう？",
            "zh": "彼此彼此吧？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1950/TALK",
            "narrator": "神楽",
            "text": "私も、あなたにとっての\n重要な鍵を\n握ってるはずです。",
            "zh": "我也该握着\n对你而言\n重要的钥匙。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1951/TALK",
            "narrator": "神楽",
            "text": "仮に、私が今ここで\n自殺したとしたら？",
            "zh": "假如，我现在在这里\n自杀了呢？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1952/TALK",
            "narrator": "神楽",
            "text": "そうなったら、\nあなたは困るんじゃ\nないですか？",
            "zh": "那样的话，\n你会为难\n吧？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1953/TALK",
            "narrator": "千羽鶴",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1954/TALK",
            "narrator": "神楽",
            "text": "私の言う契約破棄には、\nそういった行動の可能性も\n含まれています。",
            "zh": "我说的契约作废，\n也包括做出那种行为的\n可能性。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1955/TALK",
            "narrator": "神楽",
            "text": "それでもよければ――",
            "zh": "这样也可以的话——",
            "narrator_zh": "神乐"
        },
        {
            "location": "1956/TALK",
            "narrator": "千羽鶴",
            "text": "わかった。",
            "zh": "好。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1957/TALK",
            "narrator": "千羽鶴",
            "text": "発する言葉は\n全て真実だけを伝えると\n約束する。",
            "zh": "我保证，说出口的话\n只传达\n真实。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1958/TALK",
            "narrator": "神楽",
            "text": "本当ですか？",
            "zh": "真的吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1959/TALK",
            "narrator": "千羽鶴",
            "text": "けど、\n答えられないことは正直に\n答えられないと言う。",
            "zh": "不过，\n回答不了的事会老实说\n回答不了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1960/TALK",
            "narrator": "千羽鶴",
            "text": "それでもいい？",
            "zh": "这样也可以？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1961/TALK",
            "narrator": "神楽",
            "text": "そうですね…。",
            "zh": "是啊……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1962/TALK",
            "narrator": "神楽",
            "text": "答えられない理由を\n教えてくれたら、\nその都度検討します。",
            "zh": "要是告诉我\n回答不了的理由，\n我每次再考虑。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1963/TALK",
            "narrator": "千羽鶴",
            "text": "…それでいい。\n契約成立ね。",
            "zh": "……那样就行。\n契约成立了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1964/TALK",
            "narrator": "神楽",
            "text": "はい。\nでは早速ですが、\n一つ目の質問です。",
            "zh": "好。\n那么马上，\n第一个问题。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1965/TALK",
            "narrator": "神楽",
            "text": "ライブの時に発生した\nフェノメノンに関する\n情報を教えてください。",
            "zh": "请告诉我\n演出时发生的\nPhenoMENON的情报。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1966/TALK",
            "narrator": "千羽鶴",
            "text": "わかった。\nまずはあのフェノメノンの\n発症者について。",
            "zh": "好。\n先说那个PhenoMENON的\n发病者。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1968/TALK",
            "narrator": "千羽鶴",
            "text": "発症者は、如月音羽。",
            "zh": "发病者是，如月音羽。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1970/TALK",
            "narrator": "神楽",
            "text": "……っ！！\n音羽！？",
            "zh": "……唔！！\n音羽！？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1971/TALK",
            "narrator": "神楽",
            "text": "それ、本当ですか？\n本当に、如月音羽が\n発症者なんですか？",
            "zh": "这是真的吗？\n真的是如月音羽\n发病了吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1972/TALK",
            "narrator": "千羽鶴",
            "text": "質問には正直に答える。\nそういう契約のはず。",
            "zh": "问题要老实回答。\n契约是这样约定的。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1974/TALK",
            "narrator": "神楽",
            "text": "どうして…！？\n何故発症したの！？",
            "zh": "为什么……！？\n为什么发病了！？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1975/TALK",
            "narrator": "千羽鶴",
            "text": "発症に至った\n直接的理由は、\n私にはわからない。",
            "zh": "导致发病的\n直接理由，\n我不知道。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1976/TALK",
            "narrator": "千羽鶴",
            "text": "けど、それに関しては\n貴方の方が推測しやすい\nのではないかと思う。",
            "zh": "不过这件事，\n我觉得你更容易\n推测。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1977/TALK",
            "narrator": "神楽",
            "text": "それで！！\n音羽は無事なんですか！？",
            "zh": "所以！！\n音羽没事吗！？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1978/TALK",
            "narrator": "千羽鶴",
            "text": "いいえ。\n残念だけど――",
            "zh": "没有。\n很遗憾——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1979/TALK",
            "narrator": "千羽鶴",
            "text": "彼女は破壊された。",
            "zh": "她被毁掉了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1980/TALK",
            "narrator": "神楽",
            "text": "…っ―――！！",
            "zh": "……唔——！！",
            "narrator_zh": "神乐"
        },
        {
            "location": "1981/TALK",
            "narrator": "千羽鶴",
            "text": "わかりやすく言えば、\n魂として復元不可能と\n思われる状況。",
            "zh": "说得明白一点，\n是作为灵魂已经\n无法复原的状况。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1982/TALK",
            "narrator": "神楽",
            "text": "…どうして。",
            "zh": "……为什么。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1983/TALK",
            "narrator": "神楽",
            "text": "いったい、誰が音羽を\n壊したんですか！？",
            "zh": "到底是谁\n毁掉了音羽！？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1984/TALK",
            "narrator": "千羽鶴",
            "text": "貴方が破壊対象とする\n存在であるところの\n“逢瀬つばめ”。",
            "zh": "就是你要毁掉的\n那个存在，\n“逢濑燕”。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1986/TALK",
            "narrator": "神楽",
            "text": "逢瀬つばめ！？",
            "zh": "逢濑燕！？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1987/TALK",
            "narrator": "神楽",
            "text": "ということは\nあれが――",
            "zh": "也就是说\n那个就是——",
            "narrator_zh": "神乐"
        },
        {
            "location": "2001/TALK",
            "narrator": "神楽",
            "text": "なんで…どうして？\nどうして逢瀬つばめが、\n音羽のことを…。",
            "zh": "为什么……怎么会？\n为什么逢濑燕，\n要对音羽……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2002/TALK",
            "narrator": "神楽",
            "text": "…許さない。",
            "zh": "……不会原谅。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2003/TALK",
            "narrator": "神楽",
            "text": "逢瀬つばめ…、\n私の手で、絶対、壊す！！",
            "zh": "逢濑燕……\n我亲手，绝对，毁掉！！",
            "narrator_zh": "神乐"
        },
        {
            "location": "2004/TALK",
            "narrator": "千羽鶴",
            "text": "ちなみに。",
            "zh": "顺便说一句。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "2005/TALK",
            "narrator": "千羽鶴",
            "text": "この世界に実在する\n“逢瀬つばめ”は、\n私にとっても都合が悪い。",
            "zh": "存在于这个世界的\n“逢濑燕”，\n对我也不方便。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "2006/TALK",
            "narrator": "千羽鶴",
            "text": "だから速やかに\n破壊すべきは、２人に\nとっての共通事項。",
            "zh": "所以应当尽快毁掉，\n这是我们两人\n共同的事。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "2007/TALK",
            "narrator": "千羽鶴",
            "text": "けれども幸い、今現在\n破壊されていないのは\n幸運なことでもある。",
            "zh": "不过幸好，她现在\n还没被毁掉，\n也算幸运。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "2008/TALK",
            "narrator": "神楽",
            "text": "どういうこと……？",
            "zh": "什么意思……？",
            "narrator_zh": "神乐"
        },
        {
            "location": "2009/TALK",
            "narrator": "千羽鶴",
            "text": "貴方は“彼ら”に言われた\nとおり、“逢瀬つばめ”を\n破壊する予定だった。",
            "zh": "你本来打算\n照“他们”说的，\n毁掉“逢濑燕”。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "2010/TALK",
            "narrator": "千羽鶴",
            "text": "けれども、それをあの時に\n達成されていたら、非常に\n面倒な事になっていた。",
            "zh": "可是，要是那时\n已经达成，就会变成\n非常麻烦的事。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "2011/TALK",
            "narrator": "千羽鶴",
            "text": "そもそもあなたは、\nこの世界のことを\nなにも知らない。",
            "zh": "说到底你对\n这个世界\n一无所知。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "2012/TALK",
            "narrator": "千羽鶴",
            "text": "同様に、あなたは\n“彼ら”のことも、\nなにも知らない…。",
            "zh": "同样，你对\n“他们”\n也一无所知……。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "2013/TALK",
            "narrator": "神楽",
            "text": "…意味が\nわからないんですけど。",
            "zh": "……我\n听不懂。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2014/TALK",
            "narrator": "千羽鶴",
            "text": "彼らがあなたに、\n何を託したのか。",
            "zh": "他们托付给你的，\n到底是什么。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "2015/TALK",
            "narrator": "千羽鶴",
            "text": "その真意を、\nあなたは\n知らないでしょう？",
            "zh": "那份真意，\n你\n不知道吧？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "2016/TALK",
            "narrator": "神楽",
            "text": "じゃあ、それがなにか\n教えてください。",
            "zh": "那就请告诉我\n那是什么。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2018/TALK",
            "narrator": "千羽鶴",
            "text": "申し訳ないけど、\n詳細に関しては\n私もよくは知らない。",
            "zh": "抱歉，\n细节方面\n我也不太清楚。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "2019/TALK",
            "narrator": "千羽鶴",
            "text": "けど、\n一つだけわかってること。",
            "zh": "不过，\n有一件事我知道。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "2020/TALK",
            "narrator": "千羽鶴",
            "text": "それは、決してあなたや、\n世界の利益にならない\nということ。",
            "zh": "那就是，绝对不会\n对你、对世界\n有益。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "2021/TALK",
            "narrator": "千羽鶴",
            "text": "私は違う。",
            "zh": "我不一样。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "2022/TALK",
            "narrator": "千羽鶴",
            "text": "逢瀬つばめを、\nずっと間近で見てきた。",
            "zh": "我一直在近处\n看着逢濑燕。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "2023/TALK",
            "narrator": "千羽鶴",
            "text": "だから、世界にとって、\n私達にとって――",
            "zh": "所以，对世界，\n对我们——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "2024/TALK",
            "narrator": "千羽鶴",
            "text": "そしてあなたにとって\n最もよい、彼女の壊し方を\nしっかりわかっている。",
            "zh": "以及对你而言\n最好的、毁掉她的方法，\n我清楚得很。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "2025/TALK",
            "narrator": "千羽鶴",
            "text": "そのために必要な\n十分なお膳立てを立てる\n準備もできている。",
            "zh": "为此需要的\n充分安排，\n我也准备好了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "2026/TALK",
            "narrator": "神楽",
            "text": "…遠回しに話すのは\n嫌いじゃなかったん\nですか？",
            "zh": "……你不是不喜欢\n说得绕来绕去\n吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "2027/TALK",
            "narrator": "千羽鶴",
            "text": "一之宮神楽。\nあなたには\n５月７日付で…。",
            "zh": "一之宫神乐。\n从5月7日起，\n你……。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "2028/TALK",
            "narrator": "千羽鶴",
            "text": "情報管理庁管轄\n拡張現実特殊戦略隊群\n特別攻撃隊――",
            "zh": "情报管理厅管辖的\n扩张现实特殊战略队群\n特别攻击队——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "2029/TALK",
            "narrator": "千羽鶴",
            "text": "通称トライナリーに\n入隊してもらう。",
            "zh": "通称三重奏，\n请你加入。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "2030/TALK",
            "narrator": "神楽",
            "text": "…は？\n何ですかそれは。",
            "zh": "……哈？\n那是什么。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2032/TALK",
            "narrator": "神楽",
            "text": "それのどこか、\nお膳立てになるんですか？",
            "zh": "这哪里算\n安排呢？",
            "narrator_zh": "神乐"
        },
        {
            "location": "2033/TALK",
            "narrator": "千羽鶴",
            "text": "逢瀬つばめは、\nトライナリーの隊員。",
            "zh": "逢濑燕是\n三重奏的队员。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "2034/TALK",
            "narrator": "千羽鶴",
            "text": "そしてメンバーは、\nあなたを含めて５人。",
            "zh": "成员加上你，\n一共5人。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "2035/TALK",
            "narrator": "千羽鶴",
            "text": "やろうと思えば、\n２４時間いつでも\n彼女の傍にいるのも可能。",
            "zh": "想做的话，\n24小时随时\n都能待在她身边。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "2036/TALK",
            "narrator": "千羽鶴",
            "text": "これで、いつでも\nあの子を簡単に壊せる。",
            "zh": "这样，随时\n都能轻易毁掉那孩子。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "2037/TALK",
            "narrator": "千羽鶴",
            "text": "あと。",
            "zh": "还有。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "2038/TALK",
            "narrator": "千羽鶴",
            "text": "トライナリーに入隊して\nくれれば、私はあなたの\n特別な任務のことも――",
            "zh": "只要你加入三重奏，\n你的特别任务，\n我也会——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "2039/TALK",
            "narrator": "千羽鶴",
            "text": "外からの来訪者である\nことも、そしてあなたの\nミッションについても。",
            "zh": "你是外来的访问者\n这件事，以及你的\n任务。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "2040/TALK",
            "narrator": "千羽鶴",
            "text": "全て隠蔽し、\n保護することができる。",
            "zh": "全部隐瞒起来，\n并加以保护。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "2041/TALK",
            "narrator": "千羽鶴",
            "text": "私からの提示は以上。\n他にも何かあれば。",
            "zh": "我要说的就这些。\n还有别的就说。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "2042/TALK",
            "narrator": "神楽",
            "text": "…十分です。",
            "zh": "……够了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2043/TALK",
            "narrator": "千羽鶴",
            "text": "よかった。",
            "zh": "太好了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "2044/TALK",
            "narrator": "神楽",
            "text": "…話は以上ですか？",
            "zh": "……话说完了吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "2045/TALK",
            "narrator": "千羽鶴",
            "text": "ええ、そう。",
            "zh": "嗯，是的。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "2046/TALK",
            "narrator": "神楽",
            "text": "じゃあ、今日はもう\nひとりになっても\nいいですか？",
            "zh": "那今天，\n可以让我一个人\n待着吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "2047/TALK",
            "narrator": "神楽",
            "text": "私これでも一応、\n被害者なんですけど。",
            "zh": "我好歹也算\n受害者。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2048/TALK",
            "narrator": "千羽鶴",
            "text": "ええ、もちろん。\n今日はゆっくり休んで。",
            "zh": "嗯，当然。\n今天好好休息。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "2055/TALK",
            "narrator": "千羽鶴",
            "text": "……そうだ。\nもう一つ。",
            "zh": "……对了。\n还有一件。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "2056/TALK",
            "narrator": "千羽鶴",
            "text": "逢瀬つばめとは、\n表面上、なるべく仲良く\nなった方がいい。",
            "zh": "和逢濑燕，\n表面上最好\n尽量处好。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "2057/TALK",
            "narrator": "神楽",
            "text": "破壊対象の子と\n仲良くする意味なんて\nないと思いますけど？",
            "zh": "和要毁掉的孩子\n处好，我觉得\n没什么意义吧？",
            "narrator_zh": "神乐"
        },
        {
            "location": "2065/TALK",
            "narrator": "千羽鶴",
            "text": "仲良くすることで、\n逢瀬つばめに\n隙を作らせる。",
            "zh": "处好了，\n就能让逢濑燕\n露出空子。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "2066/TALK",
            "narrator": "千羽鶴",
            "text": "あなたに対して自らの魂を\n捧げるくらいになれば…。",
            "zh": "要是到了愿意把灵魂\n献给你的程度……。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "2067/TALK",
            "narrator": "千羽鶴",
            "text": "より簡単にミッションを\n達成出来るはず。",
            "zh": "任务应该会\n更容易达成。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "2069/TALK",
            "narrator": "神楽",
            "text": "…ありえませんよ。\n自ら魂を捧げるだなんて。",
            "zh": "……不可能的。\n自己把灵魂献出去。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2070/TALK",
            "narrator": "千羽鶴",
            "text": "そう？",
            "zh": "是吗？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "2071/TALK",
            "narrator": "神楽",
            "text": "あるわけないですよ。",
            "zh": "怎么可能有。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2072/TALK",
            "narrator": "神楽",
            "text": "まあ、隙を作らせる\nというのには\n賛成ですから…。",
            "zh": "不过，让她露出空子\n这一点\n我赞成……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2073/TALK",
            "narrator": "神楽",
            "text": "少なくとも、\n警戒をされないよう\n努力します。",
            "zh": "至少，\n我会努力\n不让她起戒心。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2074/TALK",
            "narrator": "千羽鶴",
            "text": "それでいい。",
            "zh": "那样就行。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "2075/TALK",
            "narrator": "千羽鶴",
            "text": "期待している。\n私の協力者、\n一之宮神楽…。",
            "zh": "我很期待。\n我的协作者，\n一之宫神乐……。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "2076/TALK",
            "narrator": "神楽",
            "text": "私からも最後に１つ。",
            "zh": "我也最后说一件。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2077/TALK",
            "narrator": "千羽鶴",
            "text": "何？",
            "zh": "什么？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "2078/TALK",
            "narrator": "神楽",
            "text": "私の事を\n一之宮と呼ぶのは\nやめてください。",
            "zh": "请不要\n叫我\n一之宫。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2079/TALK",
            "narrator": "千羽鶴",
            "text": "では、何と？",
            "zh": "那，叫什么？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "2080/TALK",
            "narrator": "神楽",
            "text": "私は……",
            "zh": "我是……",
            "narrator_zh": "神乐"
        },
        {
            "location": "2081/TALK",
            "narrator": "神楽",
            "text": "私は、今でも\n卯月神楽ですから。",
            "zh": "我现在也还是\n卯月神乐。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2082/TALK",
            "narrator": "千羽鶴",
            "text": "……そう。\nわかった。",
            "zh": "……这样。\n我知道了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "2083/TALK",
            "narrator": "千羽鶴",
            "text": "それじゃ卯月神楽。\nなにかあればまた。",
            "zh": "那就卯月神乐。\n有事再说。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "2088/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2089/TALK",
            "narrator": "神楽",
            "text": "う～ん…。",
            "zh": "嗯……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2090/TALK",
            "narrator": "神楽",
            "text": "はぁ…仕方ない…。",
            "zh": "哈啊……没办法……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2104/TALK",
            "narrator": "システム",
            "text": "神楽さんが、あなたの\nブロックを解除しました。",
            "zh": "神乐\n解除了对你的屏蔽。",
            "narrator_zh": "系统"
        },
        {
            "location": "2107/TALK",
            "narrator": "神楽",
            "text": "$handle$さん",
            "zh": "$handle$",
            "narrator_zh": "神乐"
        },
        {
            "location": "2108/TALK",
            "narrator": "神楽",
            "text": "切断されている外部との接続は",
            "zh": "被切断的和外部的连接",
            "narrator_zh": "神乐"
        },
        {
            "location": "2109/TALK",
            "narrator": "神楽",
            "text": "直せないんですか？",
            "zh": "修不好吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "2111/SEL",
            "narrator": "",
            "text": "それはできない",
            "zh": "那个做不到",
            "narrator_zh": ""
        },
        {
            "location": "2112/SEL",
            "narrator": "",
            "text": "外部となんて接続しない方がいい",
            "zh": "还是别和外部连接比较好",
            "narrator_zh": ""
        },
        {
            "location": "2113/ACT",
            "narrator": "",
            "text": "それはできない",
            "zh": "那个做不到",
            "narrator_zh": ""
        },
        {
            "location": "2114/ACT",
            "narrator": "",
            "text": "外部となんて接続しない方がいい",
            "zh": "还是别和外部连接比较好",
            "narrator_zh": ""
        },
        {
            "location": "2116/TALK",
            "narrator": "神楽",
            "text": "そうですか",
            "zh": "是吗",
            "narrator_zh": "神乐"
        },
        {
            "location": "2119/TALK",
            "narrator": "神楽",
            "text": "わかりました",
            "zh": "我知道了",
            "narrator_zh": "神乐"
        },
        {
            "location": "2120/TALK",
            "narrator": "神楽",
            "text": "本当のことは教えていただけないようなので",
            "zh": "看来你不会告诉我真话",
            "narrator_zh": "神乐"
        },
        {
            "location": "2121/TALK",
            "narrator": "神楽",
            "text": "独り言です",
            "zh": "这是自言自语",
            "narrator_zh": "神乐"
        },
        {
            "location": "2122/TALK",
            "narrator": "神楽",
            "text": "私はあなたのことを",
            "zh": "我对你",
            "narrator_zh": "神乐"
        },
        {
            "location": "2123/TALK",
            "narrator": "神楽",
            "text": "まったく信用していません",
            "zh": "完全不信任",
            "narrator_zh": "神乐"
        },
        {
            "location": "2126/TALK",
            "narrator": "神楽",
            "text": "でも、さっきのちはるという子も",
            "zh": "可是，刚才那个叫千春的孩子也是",
            "narrator_zh": "神乐"
        },
        {
            "location": "2127/TALK",
            "narrator": "神楽",
            "text": "まったく信用していません",
            "zh": "完全不信任",
            "narrator_zh": "神乐"
        },
        {
            "location": "2128/TALK",
            "narrator": "神楽",
            "text": "そして外の世界の連中は",
            "zh": "而且外面世界的那些人",
            "narrator_zh": "神乐"
        },
        {
            "location": "2129/TALK",
            "narrator": "神楽",
            "text": "もっと冷酷な奴らです",
            "zh": "是更冷酷的家伙",
            "narrator_zh": "神乐"
        },
        {
            "location": "2130/TALK",
            "narrator": "神楽",
            "text": "だから、いち意見として",
            "zh": "所以，作为一种意见",
            "narrator_zh": "神乐"
        },
        {
            "location": "2131/TALK",
            "narrator": "神楽",
            "text": "あなたの意見も聞いていくことにします",
            "zh": "你的意见我也会听下去",
            "narrator_zh": "神乐"
        },
        {
            "location": "2132/TALK",
            "narrator": "神楽",
            "text": "勘違いはしないでくださいね",
            "zh": "请别误会",
            "narrator_zh": "神乐"
        },
        {
            "location": "2133/TALK",
            "narrator": "神楽",
            "text": "あなたを信用するためではありませんから",
            "zh": "不是为了信任你",
            "narrator_zh": "神乐"
        },
        {
            "location": "2134/TALK",
            "narrator": "神楽",
            "text": "あくまでも",
            "zh": "归根结底",
            "narrator_zh": "神乐"
        },
        {
            "location": "2135/TALK",
            "narrator": "神楽",
            "text": "ちはるや、それ以外の意見と照らし合わせ",
            "zh": "是要和千春以及其他意见对照",
            "narrator_zh": "神乐"
        },
        {
            "location": "2136/TALK",
            "narrator": "神楽",
            "text": "自分で答えを見つけるためです",
            "zh": "好自己找出答案",
            "narrator_zh": "神乐"
        },
        {
            "location": "2138/SEL",
            "narrator": "",
            "text": "おー、かっこいいー",
            "zh": "哦，好有型哦",
            "narrator_zh": ""
        },
        {
            "location": "2139/SEL",
            "narrator": "",
            "text": "ご意見番は任せとけ！",
            "zh": "意见顾问交给我！",
            "narrator_zh": ""
        },
        {
            "location": "2140/SEL",
            "narrator": "",
            "text": "信用してもらうために仲良くしよう",
            "zh": "为了让你信任，我们处好吧",
            "narrator_zh": ""
        },
        {
            "location": "2141/ACT",
            "narrator": "",
            "text": "おー、かっこいいー",
            "zh": "哦，好有型哦",
            "narrator_zh": ""
        },
        {
            "location": "2142/TALK",
            "narrator": "神楽",
            "text": "いや、ちょっと",
            "zh": "不是，等一下",
            "narrator_zh": "神乐"
        },
        {
            "location": "2144/TALK",
            "narrator": "神楽",
            "text": "もう少し空気考えて返事してくれます？",
            "zh": "回答的时候能不能稍微看看气氛？",
            "narrator_zh": "神乐"
        },
        {
            "location": "2145/TALK",
            "narrator": "神楽",
            "text": "なんか気が抜けるんですけど",
            "zh": "总觉得泄气",
            "narrator_zh": "神乐"
        },
        {
            "location": "2146/ACT",
            "narrator": "",
            "text": "ご意見番は任せとけ！",
            "zh": "意见顾问交给我！",
            "narrator_zh": ""
        },
        {
            "location": "2147/TALK",
            "narrator": "神楽",
            "text": "そこまで求めてませんから",
            "zh": "我没要求到那个份上",
            "narrator_zh": "神乐"
        },
        {
            "location": "2148/TALK",
            "narrator": "神楽",
            "text": "普通に意見してくれるだけで十分です",
            "zh": "正常说意见就够了",
            "narrator_zh": "神乐"
        },
        {
            "location": "2150/SEL",
            "narrator": "",
            "text": "遠慮するな！",
            "zh": "别客气！",
            "narrator_zh": ""
        },
        {
            "location": "2151/SEL",
            "narrator": "",
            "text": "やはり信用出来ないというのか？",
            "zh": "还是说不能信任吗？",
            "narrator_zh": ""
        },
        {
            "location": "2152/ACT",
            "narrator": "",
            "text": "遠慮するな！",
            "zh": "别客气！",
            "narrator_zh": ""
        },
        {
            "location": "2153/TALK",
            "narrator": "神楽",
            "text": "遠慮とかじゃないんですけど",
            "zh": "不是客气的问题",
            "narrator_zh": "神乐"
        },
        {
            "location": "2156/TALK",
            "narrator": "神楽",
            "text": "いえもういいです。",
            "zh": "不，不用了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2157/ACT",
            "narrator": "",
            "text": "やはり信用出来ないというのか？",
            "zh": "还是说不能信任吗？",
            "narrator_zh": ""
        },
        {
            "location": "2158/TALK",
            "narrator": "神楽",
            "text": "だからそう言ってるじゃないですか",
            "zh": "所以我不是这么说了吗",
            "narrator_zh": "神乐"
        },
        {
            "location": "2159/TALK",
            "narrator": "神楽",
            "text": "もぉ",
            "zh": "真是的",
            "narrator_zh": "神乐"
        },
        {
            "location": "2160/TALK",
            "narrator": "神楽",
            "text": "私の話聞いてくれてるのか不安です",
            "zh": "我都怀疑你有没有在听",
            "narrator_zh": "神乐"
        },
        {
            "location": "2162/ACT",
            "narrator": "",
            "text": "信用してもらうために仲良くしよう",
            "zh": "为了让你信任，我们处好吧",
            "narrator_zh": ""
        },
        {
            "location": "2163/TALK",
            "narrator": "神楽",
            "text": "なんというか",
            "zh": "怎么说呢",
            "narrator_zh": "神乐"
        },
        {
            "location": "2164/TALK",
            "narrator": "神楽",
            "text": "超ポジティブ？",
            "zh": "超级乐观？",
            "narrator_zh": "神乐"
        },
        {
            "location": "2165/TALK",
            "narrator": "神楽",
            "text": "信用してないと言ったばかりなのに",
            "zh": "我刚说了不信任",
            "narrator_zh": "神乐"
        },
        {
            "location": "2166/TALK",
            "narrator": "神楽",
            "text": "まさかそんなこと言ってくるとは思いませんでした",
            "zh": "没想到你会说出这种话",
            "narrator_zh": "神乐"
        },
        {
            "location": "2168/TALK",
            "narrator": "神楽",
            "text": "まあなんでもいいですよ",
            "zh": "嘛，怎样都好",
            "narrator_zh": "神乐"
        },
        {
            "location": "2170/TALK",
            "narrator": "神楽",
            "text": "とにかく言いたいことは言ったので",
            "zh": "总之想说的已经说了",
            "narrator_zh": "神乐"
        },
        {
            "location": "2171/TALK",
            "narrator": "神楽",
            "text": "落ちますね",
            "zh": "我下了",
            "narrator_zh": "神乐"
        },
        {
            "location": "2182/TALK",
            "narrator": "神楽",
            "text": "…ヘンなの。",
            "zh": "……好奇怪。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2183/TALK",
            "narrator": "神楽",
            "text": "他の世界の人って、\nみんなこんな感じ\nなのかしら？",
            "zh": "其他世界的人，\n都是这种感觉\n吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "2184/TALK",
            "narrator": "神楽",
            "text": "まあ、そのおかげか\nちょっと気持ちが\n落ち着いたけど…。",
            "zh": "嘛，也许托这个的福，\n心情稍微\n平静了一点……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2185/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2186/TALK",
            "narrator": "神楽",
            "text": "っていうか、\n本当に人？",
            "zh": "话说，\n真的是人吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "2187/TALK",
            "narrator": "神楽",
            "text": "実際に顔を見た\nわけじゃないんだから…。",
            "zh": "又没真正\n见过脸……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2188/TALK",
            "narrator": "神楽",
            "text": "人って決めつけるのも\n危険かしら？",
            "zh": "一口咬定是人，\n会不会危险？",
            "narrator_zh": "神乐"
        },
        {
            "location": "2189/TALK",
            "narrator": "神楽",
            "text": "それに、アカウントを\nもらった時に受けた\nレクチャとは違うような？",
            "zh": "而且，和拿到账号时\n接受的讲解\n好像不一样？",
            "narrator_zh": "神乐"
        },
        {
            "location": "2190/TALK",
            "narrator": "神楽",
            "text": "…もしかして、\n奴らの差し金じゃない\nのかしら？",
            "zh": "……该不会，\n是那些人指使的\n吧？",
            "narrator_zh": "神乐"
        },
        {
            "location": "2191/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2192/TALK",
            "narrator": "神楽",
            "text": "ふぅ…まあ、いいや。\nそれはいずれ\n聞き出すとして…。",
            "zh": "呼……算了。\n这件事以后\n再问出来……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2194/TALK",
            "narrator": "神楽",
            "text": "今は、ゆっくり休もう…。",
            "zh": "现在，好好休息吧……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2197/DIALOG",
            "narrator": "dialog_black",
            "text": "――逢瀬つばめ。\n必ずや、壊して差し上げます。\n\nあなたが、音羽のことを\n壊したように。",
            "zh": "——逢濑燕。\n我一定会毁掉你。\n\n就像你毁掉\n音羽那样。",
            "narrator_zh": "dialog_black"
        },
        {
            "location": "2206/DIALOG",
            "narrator": "Dialog_chapter_ch05",
            "text": "【03 赤い髪の転校生】",
            "zh": "【03 红发的转学生】",
            "narrator_zh": "Dialog_chapter_ch05"
        },
        {
            "location": "2217/DIALOG",
            "narrator": "Dialog_chapter_ch05",
            "text": "【03 赤い髪の転校生】",
            "zh": "【03 红发的转学生】",
            "narrator_zh": "Dialog_chapter_ch05"
        }
    ]
}
