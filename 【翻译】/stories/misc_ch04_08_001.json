            "narrator_zh": ""
        },
        {
            "location": "94/TALK",
            "narrator": "みやび",
            "text": "して学派は？",
            "zh": "那么，学派是？",
            "narrator_zh": "雅"
        },
        {
            "location": "95/SEL",
            "narrator": "",
            "text": "プラグマティズム",
            "zh": "实用主义",
            "narrator_zh": ""
        },
        {
            "location": "96/SEL",
            "narrator": "",
            "text": "独我論",
            "zh": "唯我论",
            "narrator_zh": ""
        },
        {
            "location": "97/ACT",
            "narrator": "",
            "text": "プラグマティズム",
            "zh": "实用主义",
            "narrator_zh": ""
        },
        {
            "location": "98/TALK",
            "narrator": "みやび",
            "text": "ふーん",
            "zh": "嗯——",
            "narrator_zh": "雅"
        },
        {
            "location": "99/TALK",
            "narrator": "みやび",
            "text": "なんじゃそりゃ",
            "zh": "那是哪门子",
            "narrator_zh": "雅"
        },
        {
            "location": "100/ACT",
            "narrator": "",
            "text": "独我論",
            "zh": "唯我论",
            "narrator_zh": ""
        },
        {
            "location": "101/TALK",
            "narrator": "みやび",
            "text": "我思う、故に我あり",
            "zh": "我思，故我在",
            "narrator_zh": "雅"
        },
        {
            "location": "102/TALK",
            "narrator": "みやび",
            "text": "ってやつ？",
            "zh": "是这个吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "103/TALK",
            "narrator": "みやび",
            "text": "なんか語感から適当に言ってみた",
            "zh": "看语感随便说的",
            "narrator_zh": "雅"
        },
        {
            "location": "106/TALK",
            "narrator": "みやび",
            "text": "まあ",
            "zh": "嘛",
            "narrator_zh": "雅"
        },
        {
            "location": "107/TALK",
            "narrator": "みやび",
            "text": "こういった会話も意思があって疎通を試みることができるからこその産物",
            "zh": "这种对话，也正是因为有意志、能试着把话说通，才会有的产物",
            "narrator_zh": "雅"
        },
        {
            "location": "108/TALK",
            "narrator": "みやび",
            "text": "そして我は",
            "zh": "然后我",
            "narrator_zh": "雅"
        },
        {
            "location": "109/TALK",
            "narrator": "みやび",
