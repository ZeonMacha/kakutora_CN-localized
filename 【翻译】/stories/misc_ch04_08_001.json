    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "007_あくびの空",
            "zh": "007_哈欠的天空",
            "narrator_zh": ""
        },
        {
            "location": "32/TALK",
            "narrator": "みやび",
            "text": "クランには意思がある。\nそれは即ち生きているということだ。",
            "zh": "库兰是有意志的。\n那也就是说，它活着。",
            "narrator_zh": "雅"
        },
        {
            "location": "34/SEL",
            "narrator": "",
            "text": "そうかな…？",
            "zh": "是吗……？",
            "narrator_zh": ""
        },
        {
            "location": "35/SEL",
            "narrator": "",
            "text": "そうかもね",
            "zh": "也许是吧",
            "narrator_zh": ""
        },
        {
            "location": "36/SEL",
            "narrator": "",
            "text": "そう思いたいだけじゃない？",
            "zh": "只是你想这么认为吧？",
            "narrator_zh": ""
        },
        {
            "location": "37/TALK",
            "narrator": "みやび",
            "text": "生物学的には？\nなどという問いは意味がない。",
            "zh": "从生物学上说呢？\n之类的问题没有意义。",
            "narrator_zh": "雅"
        },
        {
            "location": "38/TALK",
            "narrator": "みやび",
            "text": "とは言わないが――",
            "zh": "倒也不会这么说——",
            "narrator_zh": "雅"
        },
        {
            "location": "42/ACT",
            "narrator": "",
            "text": "そうかな…？",
            "zh": "是吗……？",
            "narrator_zh": ""
        },
        {
            "location": "43/TALK",
            "narrator": "みやび",
            "text": "そうだと思うが違うかね",
            "zh": "我是这么想的，不对咩",
            "narrator_zh": "雅"
        },
        {
            "location": "44/TALK",
            "narrator": "みやび",
            "text": "相棒",
            "zh": "搭档",
            "narrator_zh": "雅"
        },
        {
            "location": "45/ACT",
            "narrator": "",
            "text": "そうかもね",
            "zh": "也许是吧",
            "narrator_zh": ""
        },
        {
            "location": "46/TALK",
            "narrator": "みやび",
            "text": "そうであろうよ",
            "zh": "就是这样吧",
            "narrator_zh": "雅"
        },
        {
            "location": "47/TALK",
            "narrator": "みやび",
            "text": "違うかね、相棒",
            "zh": "不对咩，搭档",
            "narrator_zh": "雅"
        },
        {
            "location": "48/ACT",
            "narrator": "",
            "text": "そう思いたいだけじゃない？",
            "zh": "只是你想这么认为吧？",
            "narrator_zh": ""
        },
        {
            "location": "49/TALK",
            "narrator": "みやび",
            "text": "そうかもしれない。",
            "zh": "也许是这样。",
            "narrator_zh": "雅"
        },
        {
            "location": "50/TALK",
            "narrator": "みやび",
            "text": "否定するのだな",
            "zh": "你要否定啊",
            "narrator_zh": "雅"
        },
        {
            "location": "51/TALK",
            "narrator": "みやび",
            "text": "チミは",
            "zh": "你这个人",
            "narrator_zh": "雅"
        },
        {
            "location": "53/TALK",
            "narrator": "みやび",
            "text": "生きるということは意思を持つことと同義だと思うのだよ",
            "zh": "我认为，活着就等于拥有意志",
            "narrator_zh": "雅"
        },
        {
            "location": "54/TALK",
            "narrator": "みやび",
            "text": "即ち意思を持っているということは生きているということだ",
            "zh": "也就是说，拥有意志就等于活着",
            "narrator_zh": "雅"
        },
        {
            "location": "56/SEL",
            "narrator": "",
            "text": "$handle$も生きてるよ",
            "zh": "$handle$也活着呀",
            "narrator_zh": ""
        },
        {
            "location": "57/SEL",
            "narrator": "",
            "text": "ふーん",
            "zh": "嗯——",
            "narrator_zh": ""
        },
        {
            "location": "58/SEL",
            "narrator": "",
            "text": "哲学ってやつかな",
            "zh": "这就是所谓哲学吧",
            "narrator_zh": ""
        },
        {
            "location": "59/ACT",
            "narrator": "",
            "text": "$handle$も生きてるよ",
            "zh": "$handle$也活着呀",
            "narrator_zh": ""
        },
        {
            "location": "61/TALK",
            "narrator": "みやび",
            "text": "左様",
            "zh": "正是",
            "narrator_zh": "雅"
        },
        {
            "location": "62/TALK",
            "narrator": "みやび",
            "text": "貴殿も生きているということになってしまうのだ",
            "zh": "结果就变成你也活着了",
            "narrator_zh": "雅"
        },
        {
            "location": "63/TALK",
            "narrator": "みやび",
            "text": "これは些か",
            "zh": "这可有点",
            "narrator_zh": "雅"
        },
        {
            "location": "64/TALK",
            "narrator": "みやび",
            "text": "面白い",
            "zh": "有意思",
            "narrator_zh": "雅"
        },
        {
            "location": "67/SEL",
            "narrator": "",
            "text": "喜んでいただけて光栄",
            "zh": "能让你高兴，是我的荣幸",
            "narrator_zh": ""
        },
        {
            "location": "68/SEL",
            "narrator": "",
            "text": "いや事実だし",
            "zh": "不，这是事实",
            "narrator_zh": ""
        },
        {
            "location": "69/ACT",
            "narrator": "",
            "text": "喜んでいただけて光栄",
            "zh": "能让你高兴，是我的荣幸",
            "narrator_zh": ""
        },
        {
            "location": "70/TALK",
            "narrator": "みやび",
            "text": "まあね",
            "zh": "也是呢",
            "narrator_zh": "雅"
        },
        {
            "location": "71/TALK",
            "narrator": "みやび",
            "text": "ちょっと楽しいとは思ったの介",
            "zh": "倒是觉得有那么点意思",
            "narrator_zh": "雅"
        },
        {
            "location": "72/ACT",
            "narrator": "",
            "text": "いや事実だし",
            "zh": "不，这是事实",
            "narrator_zh": ""
        },
        {
            "location": "73/TALK",
            "narrator": "みやび",
            "text": "へえ",
            "zh": "嘿",
            "narrator_zh": "雅"
        },
        {
            "location": "74/TALK",
            "narrator": "みやび",
            "text": "カミングアウトしたってことか",
            "zh": "这算是坦白了？",
            "narrator_zh": "雅"
        },
        {
            "location": "75/TALK",
            "narrator": "みやび",
            "text": "いやまさかな",
            "zh": "不，怎么会",
            "narrator_zh": "雅"
        },
        {
            "location": "77/ACT",
            "narrator": "",
            "text": "ふーん",
            "zh": "嗯——",
            "narrator_zh": ""
        },
        {
            "location": "78/TALK",
            "narrator": "みやび",
            "text": "興味なしか",
            "zh": "没兴趣咩",
            "narrator_zh": "雅"
        },
        {
            "location": "80/TALK",
            "narrator": "みやび",
            "text": "はぐらかしか",
            "zh": "在打太极咩",
            "narrator_zh": "雅"
        },
        {
            "location": "82/SEL",
            "narrator": "",
            "text": "興味ないし",
            "zh": "没兴趣",
            "narrator_zh": ""
        },
        {
            "location": "83/SEL",
            "narrator": "",
            "text": "何をはぐらかしてるって？",
            "zh": "我在打什么太极？",
            "narrator_zh": ""
        },
        {
            "location": "84/ACT",
            "narrator": "",
            "text": "興味ないし",
            "zh": "没兴趣",
            "narrator_zh": ""
        },
        {
            "location": "85/TALK",
            "narrator": "みやび",
            "text": "さよけ",
            "zh": "是咯",
            "narrator_zh": "雅"
        },
        {
            "location": "86/ACT",
            "narrator": "",
            "text": "何をはぐらかしてるって？",
            "zh": "我在打什么太极？",
            "narrator_zh": ""
        },
        {
            "location": "87/TALK",
            "narrator": "みやび",
            "text": "ほうほう",
            "zh": "哦哦",
            "narrator_zh": "雅"
        },
        {
            "location": "89/TALK",
            "narrator": "みやび",
            "text": "一定のワードに反応するようにしてあるのか",
            "zh": "是设定成对某些词会有反应的吗",
            "narrator_zh": "雅"
        },
        {
            "location": "90/TALK",
            "narrator": "みやび",
            "text": "パターン多いな",
