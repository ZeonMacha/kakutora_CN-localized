{
    "dir": "chap16/daydra/dd_ch02_16_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "16205",
        "cid": "ayami",
        "title": "005 メインストーリー",
        "sub_title": "誰でもない父だから＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "正因是旁人之父＜后篇＞[?]"
    },
    "entry": [
        {
            "location": "486/TALK",
            "narrator": "アーヤ",
            "text": "…とか思ってたのに、\n結局心配でついて\nきちゃったわ。",
            "zh": "……虽说这么想着，\n到头来还是放心不下\n跟过来了呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "487/TALK",
            "narrator": "アーヤ",
            "text": "はぁ…でもまあ、\nこれでよかったの\nよね。",
            "zh": "哈啊……不过嘛，\n这样也好\n吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "488/TALK",
            "narrator": "アーヤ",
            "text": "大喧嘩した挙句に\n連れ帰るだのなんだの\n騒ぎ始めたりしたら。",
            "zh": "要是大吵一架之后\n闹出什么要把人\n带回去之类的事，",
            "narrator_zh": "绫水"
        },
        {
            "location": "489/TALK",
            "narrator": "アーヤ",
            "text": "それこそ面倒なことに\nなるんだし。",
            "zh": "那可就真的\n麻烦了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "490/TALK",
            "narrator": "啓介",
            "text": "ふむ…つばめがさっき\n読んでいたのは…、\nこの本だったか？",
            "zh": "嗯……燕刚才\n在看的……，\n就是这本书吗？",
            "narrator_zh": "启介"
        },
        {
            "location": "492/TALK",
            "narrator": "アーヤ",
            "text": "とはいえ、できるだけ\n早く静岡に帰って\nもらいたいわ。",
            "zh": "话虽如此，还是希望他能\n尽早回静冈去\n呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "493/TALK",
            "narrator": "アーヤ",
            "text": "どうにかして\n帰るように\n説得しないと…。",
            "zh": "得想办法\n劝他回去\n才行……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "497/TALK",
            "narrator": "アーヤ",
            "text": "あ、あの…。",
            "zh": "那、那个……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "498/TALK",
            "narrator": "アーヤ",
            "text": "後のことは\n私たちに任せて、\nそろそろ帰っては――",
            "zh": "接下来的事\n就交给我们吧，\n您也差不多该回去――",
            "narrator_zh": "绫水"
        },
        {
            "location": "500/TALK",
            "narrator": "啓介",
            "text": "『特別攻撃隊イッき\nまーすっ♪　～はじめ\nてのふぇのめのん～』",
            "zh": "《特别攻击队高潮\n出击啦♪　～初次的\nPhenoMENON～》",
            "narrator_zh": "启介"
        },
        {
            "location": "502/TALK",
            "narrator": "啓介",
            "text": "特別攻撃隊？\nつばめ達の本が\n出ていたのか！？",
            "zh": "特别攻击队？\n竟然连燕她们的书\n都出版了吗！？",
            "narrator_zh": "启介"
        },
        {
            "location": "506/TALK",
            "narrator": "アーヤ",
            "text": "ちょ！？　お父さん！\nその本は！！！",
            "zh": "等！？　伯父！\n那本书！！！",
            "narrator_zh": "绫水"
        },
        {
            "location": "507/TALK",
            "narrator": "啓介",
            "text": "…なっ！？",
            "zh": "……什！？",
            "narrator_zh": "启介"
        },
        {
            "location": "509/TALK",
            "narrator": "啓介",
            "text": "なんだこの本は！！",
            "zh": "这是什么鬼书啊！！",
            "narrator_zh": "启介"
        },
        {
            "location": "512/TALK",
            "narrator": "アーヤ",
            "text": "ああ、早速始まった！",
            "zh": "啊啊，果然开始了！",
            "narrator_zh": "绫水"
        },
        {
            "location": "513/TALK",
            "narrator": "アーヤ",
            "text": "ちょ、ちょっと、\n大声出さないで\nください！",
            "zh": "等、等一下，\n请别这么大声\n喊叫！",
            "narrator_zh": "绫水"
        },
        {
            "location": "514/TALK",
            "narrator": "アーヤ",
            "text": "みんな見てますよ？",
            "zh": "大家都在看着呢？",
            "narrator_zh": "绫水"
        },
        {
            "location": "516/TALK",
            "narrator": "啓介",
            "text": "そんなことは\nどうでもいい！！",
            "zh": "那种事\n管他呢！！",
            "narrator_zh": "启介"
        },
        {
            "location": "517/TALK",
            "narrator": "啓介",
            "text": "君たちは普段、\nフェノメノンの\n中で、中で…！",
            "zh": "你们平时在\nPhenoMENON\n里面、里面……！",
            "narrator_zh": "启介"
        },
        {
            "location": "519/TALK",
            "narrator": "啓介",
            "text": "こんなことを\nやっているのか！！\nああ！？",
            "zh": "难道在做这种事\n吗！！\n啊！？",
            "narrator_zh": "启介"
        },
        {
            "location": "523/TALK",
            "narrator": "アーヤ",
            "text": "こんなことって…。",
            "zh": "这种事什么的……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "524/TALK",
            "narrator": "アーヤ",
            "text": "な、なんですかこの\nヤラしい本は！？",
            "zh": "这、这是什么\n下流的书啊！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "526/TALK",
            "narrator": "啓介",
            "text": "どうなんだ！？",
            "zh": "到底是不是！？",
            "narrator_zh": "启介"
        },
        {
            "location": "529/TALK",
            "narrator": "アーヤ",
            "text": "こんなの、\nただの創作です！",
            "zh": "这只是\n同人创作而已！",
            "narrator_zh": "绫水"
        },
        {
            "location": "530/TALK",
            "narrator": "アーヤ",
            "text": "こんなことやってる\nわけないじゃない\nですか！",
            "zh": "怎么可能做\n这种事\n啊！",
            "narrator_zh": "绫水"
        },
        {
            "location": "531/TALK",
            "narrator": "アーヤ",
            "text": "それと、公衆の面前で\n国家機密バラさないで\nください！",
            "zh": "还有，请别在\n大庭广众之下泄露\n国家机密！",
            "narrator_zh": "绫水"
        },
        {
            "location": "533/TALK",
            "narrator": "啓介",
            "text": "いいや、もう結構！",
            "zh": "不，够了！",
            "narrator_zh": "启介"
        },
        {
            "location": "534/TALK",
            "narrator": "啓介",
            "text": "これが事実だろうが\n嘘だろうが、そんなの\nどうでもいい。",
            "zh": "不管这是真是假，\n那种事都\n无所谓了。",
            "narrator_zh": "启介"
        },
        {
            "location": "535/TALK",
            "narrator": "啓介",
            "text": "二十歳にもならない\n娘がこんな店に\n入れるなどと。",
            "zh": "连二十岁都不到的\n女儿竟然能进\n这种店。",
            "narrator_zh": "启介"
        },
        {
            "location": "536/TALK",
            "narrator": "啓介",
            "text": "東京はおかしい。\n狂ってる！！",
            "zh": "东京太不正常了。\n简直疯了！！",
            "narrator_zh": "启介"
        },
        {
            "location": "537/TALK",
            "narrator": "啓介",
            "text": "こんなところには\n居させられん。\n家へ連れて帰る！",
            "zh": "不能让她待在\n这种地方。\n我要带她回家！",
            "narrator_zh": "启介"
        },
        {
            "location": "541/TALK",
            "narrator": "アーヤ",
            "text": "ああもう、なんでこの\n親子は敢えて地雷を\n踏みに行くのか…。",
            "zh": "啊真是的，为什么这对\n父女非要专挑地雷\n去踩啊……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "543/TALK",
            "narrator": "啓介",
            "text": "むっ？　つばめ達は\nどこへ行った？",
            "zh": "嗯？　燕她们\n去哪儿了？",
            "narrator_zh": "启介"
        },
        {
            "location": "546/TALK",
            "narrator": "アーヤ",
            "text": "え？　さっきまで\nそこの棚の前に…。",
            "zh": "咦？　刚才还在\n那边的书架前……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "547/TALK",
            "narrator": "啓介",
            "text": "いないじゃないか！\nつばめ！\n今すぐ出てきなさい！",
            "zh": "不在了啊！\n燕！\n现在立刻给我出来！",
            "narrator_zh": "启介"
        },
        {
            "location": "550/TALK",
            "narrator": "アーヤ",
            "text": "だから！　そんなこと\nしてたら恥ずかしくて\n出てこれませんって！",
            "zh": "都说了！　您这么喊，\n她只会觉得太丢人\n更不敢出来的！",
            "narrator_zh": "绫水"
        },
        {
            "location": "570/TALK",
            "narrator": "啓介",
            "text": "はぁ…。",
            "zh": "哈啊……。",
            "narrator_zh": "启介"
        },
        {
            "location": "571/TALK",
            "narrator": "アーヤ",
            "text": "ため息吐きたいのは\n私の方なんだけど…。",
            "zh": "想叹气的明明是\n我这边才对……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "572/TALK",
            "narrator": "アーヤ",
            "text": "…つばめさん、\n見失っちゃい\nましたね。",
            "zh": "……结果还是把燕\n给跟丢\n了呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "574/TALK",
            "narrator": "啓介",
            "text": "…心当たりは\nないのか？",
            "zh": "……你有什么\n头绪吗？",
            "narrator_zh": "启介"
        },
        {
            "location": "575/TALK",
            "narrator": "アーヤ",
            "text": "私も、秋葉原って\nよくわからなくて…。",
            "zh": "我对秋叶原也\n不太熟悉……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "576/TALK",
            "narrator": "アーヤ",
            "text": "でも、今から二人を\n見つけるなんて、\n不可能ですよ。",
            "zh": "而且，现在想找到\n她们两个，\n根本是不可能的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "577/TALK",
            "narrator": "アーヤ",
            "text": "もう諦めて、静岡へ\nお戻りになった方が\nいいと思いますよ？",
            "zh": "我觉得您还是死心，\n回静冈去\n比较好哦？",
            "narrator_zh": "绫水"
        },
        {
            "location": "579/TALK",
            "narrator": "啓介",
            "text": "はぁ…。",
            "zh": "哈啊……。",
            "narrator_zh": "启介"
        },
        {
            "location": "580/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "582/TALK",
            "narrator": "啓介",
            "text": "…綾水さん、\n君の故郷はどこだ？",
            "zh": "……绫水，\n你的故乡是哪里？",
            "narrator_zh": "启介"
        },
        {
            "location": "584/TALK",
            "narrator": "アーヤ",
            "text": "え？　長野ですよ、\n松代。\nわかります？",
            "zh": "咦？　是长野哦，\n松代。\n您知道吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "585/TALK",
            "narrator": "啓介",
            "text": "ああ、わかる…。\nでは、ご両親は\nそちらに？",
            "zh": "嗯，知道……。\n那你父母\n也在那边吗？",
            "narrator_zh": "启介"
        },
        {
            "location": "586/TALK",
            "narrator": "アーヤ",
            "text": "はい。小さいですが、\n神社をやっています。",
            "zh": "是的。虽然规模不大，\n但家里开着一间神社。",
            "narrator_zh": "绫水"
        },
        {
            "location": "587/TALK",
            "narrator": "啓介",
            "text": "そうか…。\n君のご両親も\n大変だな。",
            "zh": "这样啊……。\n你的父母\n也很不容易啊。",
            "narrator_zh": "启介"
        },
        {
            "location": "588/TALK",
            "narrator": "啓介",
            "text": "こんなところに\n娘を一人でいさせる\nなんて。",
            "zh": "让女儿一个人在\n这种地方\n生活。",
            "narrator_zh": "启介"
        },
        {
            "location": "589/TALK",
            "narrator": "啓介",
            "text": "気が気じゃない\nだろう。",
            "zh": "肯定提心吊胆\n得不得了吧。",
            "narrator_zh": "启介"
        },
        {
            "location": "590/TALK",
            "narrator": "アーヤ",
            "text": "…そうですね。\n多分、今もそうだと\n思います。",
            "zh": "……是啊。\n大概现在也是\n如此吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "591/TALK",
            "narrator": "アーヤ",
            "text": "でも私の父は、\n最終的には私の意思を\n尊重してくれました。",
            "zh": "不过我的父亲，\n最终还是尊重了\n我的意愿。",
            "narrator_zh": "绫水"
        },
        {
            "location": "592/TALK",
            "narrator": "啓介",
            "text": "それは君がちゃんと\n独り立ちして\nいるからだ。",
            "zh": "那是因为你能够\n好好地独当\n一面了。",
            "narrator_zh": "启介"
        },
        {
            "location": "593/TALK",
            "narrator": "啓介",
            "text": "しっかりしている\nならば構わない。",
            "zh": "要是足够稳重，\n那倒也无妨。",
            "narrator_zh": "启介"
        },
        {
            "location": "594/TALK",
            "narrator": "啓介",
            "text": "…しかしつばめは、\nまだ全然ダメだ。",
            "zh": "……可燕她，\n还差得远呢。",
            "narrator_zh": "启介"
        },
        {
            "location": "595/TALK",
            "narrator": "アーヤ",
            "text": "そんなことないと\n思います。",
            "zh": "我觉得并不是\n那样。",
            "narrator_zh": "绫水"
        },
        {
            "location": "597/TALK",
            "narrator": "啓介",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "启介"
        },
        {
            "location": "598/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "600/TALK",
            "narrator": "啓介",
            "text": "…わかった。",
            "zh": "……好吧。",
            "narrator_zh": "启介"
        },
        {
            "location": "602/TALK",
            "narrator": "啓介",
            "text": "正直に言うとな、\n心配なんだよ。",
            "zh": "老实说啊，\n我是真的担心。",
            "narrator_zh": "启介"
        },
        {
            "location": "603/TALK",
            "narrator": "啓介",
            "text": "あいつは、絶対に\n自分からは\n何も言わないから…。",
            "zh": "那家伙，绝对不会\n主动开口说\n任何事……。",
            "narrator_zh": "启介"
        },
        {
            "location": "604/TALK",
            "narrator": "アーヤ",
            "text": "…？",
            "zh": "……？",
            "narrator_zh": "绫水"
        },
        {
            "location": "605/TALK",
            "narrator": "啓介",
            "text": "つばめが小学校の頃、\nちょっとした事件が\nあってな。",
            "zh": "燕上小学的时候，\n发生过一点\n小事。",
            "narrator_zh": "启介"
        },
        {
            "location": "606/TALK",
            "narrator": "啓介",
            "text": "あいつは生まれつき\n頭痛持ちなんだ。",
            "zh": "那家伙天生\n容易偏头痛。",
            "narrator_zh": "启介"
        },
        {
            "location": "607/TALK",
            "narrator": "啓介",
            "text": "授業中に座ったまま\nぶっ倒れたことも\nあった。",
            "zh": "甚至有过上课时\n坐着就直接昏倒\n的情况。",
            "narrator_zh": "启介"
        },
        {
            "location": "608/TALK",
            "narrator": "啓介",
            "text": "大人なら、そういった\n人には気を遣うように\nなる。",
            "zh": "要是大人，对这样的\n人自然会多加\n照顾。",
            "narrator_zh": "启介"
        },
        {
            "location": "609/TALK",
            "narrator": "啓介",
            "text": "が。\n子供は逆だろう。",
            "zh": "但。\n小孩子恰恰相反吧。",
            "narrator_zh": "启介"
        },
        {
            "location": "610/TALK",
            "narrator": "啓介",
            "text": "それを理由に、\n結構いじめられていた\nみたいなんだよ。",
            "zh": "似乎就因为这个，\n她没少被人\n欺负。",
            "narrator_zh": "启介"
        },
        {
            "location": "612/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "613/TALK",
            "narrator": "啓介",
            "text": "当然、そのことを\nつばめに問いただし\nたんだが……。",
            "zh": "我当然也追问过\n燕这件事，\n但是……。",
            "narrator_zh": "启介"
        },
        {
            "location": "614/TALK",
            "narrator": "啓介",
            "text": "いじめがあったことを\n認めなかった。",
            "zh": "她死活不承认\n自己被欺负过。",
            "narrator_zh": "启介"
        },
        {
            "location": "615/TALK",
            "narrator": "啓介",
            "text": "誰に似たんだか\n知らんが、頑固でね。",
            "zh": "真不知道随了谁，\n倔得很呐。",
            "narrator_zh": "启介"
        },
        {
            "location": "616/TALK",
            "narrator": "啓介",
            "text": "その時に思ったんだ。",
            "zh": "那时我就想。",
            "narrator_zh": "启介"
        },
        {
            "location": "617/TALK",
            "narrator": "啓介",
            "text": "私はこの子に、\n何がしてやれるん\nだろう、ってな。",
            "zh": "我能为这孩子\n做些什么\n呢。",
            "narrator_zh": "启介"
        },
        {
            "location": "618/TALK",
            "narrator": "啓介",
            "text": "人に辛いのを\n見せないこと。",
            "zh": "不把痛苦\n表露给别人看。",
            "narrator_zh": "启介"
        },
        {
            "location": "619/TALK",
            "narrator": "啓介",
            "text": "それが娘に\nとっての幸せのやり方\nだったとしても、だ。",
            "zh": "就算对女儿来说，\n那是她追求幸福的\n方式也好。",
            "narrator_zh": "启介"
        },
        {
            "location": "620/TALK",
            "narrator": "啓介",
            "text": "そんな我慢なんか\nしてちゃ、本当の幸せ\nなんて掴めやしない。",
            "zh": "那样一味忍耐，\n是抓不住真正的\n幸福的。",
            "narrator_zh": "启介"
        },
        {
            "location": "621/TALK",
            "narrator": "啓介",
            "text": "だから、娘が\n辛い目にあう前に。",
            "zh": "所以，在女儿\n遭遇痛苦之前，",
            "narrator_zh": "启介"
        },
        {
            "location": "622/TALK",
            "narrator": "啓介",
            "text": "できる限りのことを\nしよう、と思った。",
            "zh": "我想尽我所能\n去做点什么。",
            "narrator_zh": "启介"
        },
        {
            "location": "624/TALK",
            "narrator": "アーヤ",
            "text": "…つばめさんは、\nそのことを知ってるん\nですか？",
            "zh": "……燕她，\n知道这件事\n吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "626/TALK",
            "narrator": "啓介",
            "text": "いや…私の勝手な\n決心だ。",
            "zh": "不……那是我一厢情愿\n的决心。",
            "narrator_zh": "启介"
        },
        {
            "location": "627/TALK",
            "narrator": "啓介",
            "text": "それに、つばめも\nそんなことは望んで\nないだろう。",
            "zh": "而且，燕也肯定\n不希望我\n这么做吧。",
            "narrator_zh": "启介"
        },
        {
            "location": "629/TALK",
            "narrator": "啓介",
            "text": "だが、そうとわかって\nいても心配なんだよ。",
            "zh": "可就算明白这一点，\n我还是会担心啊。",
            "narrator_zh": "启介"
        },
        {
            "location": "630/TALK",
            "narrator": "啓介",
            "text": "フェノメノンで\n辛い目にあって\nないか。",
            "zh": "在PhenoMENON里\n有没有吃\n苦头。",
            "narrator_zh": "启介"
        },
        {
            "location": "631/TALK",
            "narrator": "啓介",
            "text": "また、クラスの子に\nイジメられてないか。",
            "zh": "有没有又被班里的\n同学欺负。",
            "narrator_zh": "启介"
        },
        {
            "location": "632/TALK",
            "narrator": "啓介",
            "text": "ＷＡＶＥや、\n会って話したり\nしても。",
            "zh": "不管是发WAVE，\n还是见面聊天\n的时候，",
            "narrator_zh": "启介"
        },
        {
            "location": "633/TALK",
            "narrator": "啓介",
            "text": "大丈夫とか、\nとても楽しいしか\n言わないんだ。",
            "zh": "她永远都只说\n没事、说非常\n开心。",
            "narrator_zh": "启介"
        },
        {
            "location": "635/TALK",
            "narrator": "啓介",
            "text": "だから、自分の目で\n見て安心したくてな。",
            "zh": "所以，我才想亲眼\n看看好让自己安心。",
            "narrator_zh": "启介"
        },
        {
            "location": "636/TALK",
            "narrator": "啓介",
            "text": "それが本当だ、って\nことを…。",
            "zh": "确认那些话\n都是真的……。",
            "narrator_zh": "启介"
        },
        {
            "location": "638/TALK",
            "narrator": "アーヤ",
            "text": "…そういうこと\nだったんですね。",
            "zh": "……原来是\n这么回事啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "639/TALK",
            "narrator": "啓介",
            "text": "ああ…。",
            "zh": "是啊……。",
            "narrator_zh": "启介"
        },
        {
            "location": "641/TALK",
            "narrator": "アーヤ",
            "text": "…親って、みんな\nこんな気持ちなの\nかしら？",
            "zh": "……做父母的，\n全都是这种心情\n吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "642/TALK",
            "narrator": "アーヤ",
            "text": "何とか安心させて\nあげたいけど……。",
            "zh": "虽然很想办法\n让他安心……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "643/TALK",
            "narrator": "アーヤ",
            "text": "今日一日だけで、\n安心してもらえる\nかしら…。",
            "zh": "光靠今天一天，\n能让他放下心\n来吗……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "651/TALK",
            "narrator": "アーヤ",
            "text": "っ！　フェノメノン\nアラート！？",
            "zh": "唔！　PhenoMENON\n警报！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "653/TALK",
            "narrator": "啓介",
            "text": "何ッ！？",
            "zh": "什么！？",
            "narrator_zh": "启介"
        },
        {
            "location": "657/TALK",
            "narrator": "透明真幌",
            "text": "フェノメノンの出現を\n確認した。",
            "zh": "已确认PhenoMENON\n出现。",
            "narrator_zh": "透明真幌"
        },
        {
            "location": "658/TALK",
            "narrator": "透明真幌",
            "text": "現場は江東区、豊洲。\nすぐに向かってくれ。",
            "zh": "现场在江东区、丰洲。\n立刻赶过去。",
            "narrator_zh": "透明真幌"
        },
        {
            "location": "659/TALK",
            "narrator": "アーヤ",
            "text": "了解。\nすぐ現場に――",
            "zh": "收到。\n立刻前往现场――",
            "narrator_zh": "绫水"
        },
        {
            "location": "660/TALK",
            "narrator": "啓介",
            "text": "フェノメノンが出たと\nいうことは、つばめも\n出撃するのか！？",
            "zh": "PhenoMENON出现了，\n也就是说，燕也要\n出击吗！？",
            "narrator_zh": "启介"
        },
        {
            "location": "662/TALK",
            "narrator": "アーヤ",
            "text": "そ、それはまあ、\nつばめさんも\n隊員なんで…。",
            "zh": "这、这个嘛，\n毕竟燕也是\n队员……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "663/TALK",
            "narrator": "啓介",
            "text": "…指令室があるのは、\nあの劇場だったな。",
            "zh": "……指令室所在的地方，\n是那座剧场对吧。",
            "narrator_zh": "启介"
        },
        {
            "location": "667/TALK",
            "narrator": "アーヤ",
            "text": "ちょ！？\nダメですよお父さん！",
            "zh": "等！？\n不行的，伯父！",
            "narrator_zh": "绫水"
        },
        {
            "location": "668/TALK",
            "narrator": "アーヤ",
            "text": "一応政府機関の\n秘密基地なんです\nから。",
            "zh": "那里姑且算是\n政府机关的\n秘密基地。",
            "narrator_zh": "绫水"
        },
        {
            "location": "669/TALK",
            "narrator": "アーヤ",
            "text": "隊員の家族とはいえ、\n一般人は入れないん\nです！",
            "zh": "就算是队员的家属，\n普通人也是不能\n进去的！",
            "narrator_zh": "绫水"
        },
        {
            "location": "671/TALK",
            "narrator": "啓介",
            "text": "そんな馬鹿な話が\nあるか！",
            "zh": "哪有这么荒唐\n的事！",
            "narrator_zh": "启介"
        },
        {
            "location": "672/TALK",
            "narrator": "啓介",
            "text": "私の娘が命がけで\n戦おうとしているん\nだぞ！？",
            "zh": "我女儿可是要赌上\n性命去战斗\n啊！？",
            "narrator_zh": "启介"
        },
        {
            "location": "673/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "674/TALK",
            "narrator": "啓介",
            "text": "誰が止めたとしても、\n私は行くからな。",
            "zh": "不管谁来拦我，\n我都一定要去。",
            "narrator_zh": "启介"
        },
        {
            "location": "675/TALK",
            "narrator": "透明真幌",
            "text": "おい、アーヤ。\n今の声、まさか\n逢瀬の父上か！？",
            "zh": "喂，绫水。\n刚才的声音，难道是\n逢濑的令尊吗！？",
            "narrator_zh": "透明真幌"
        },
        {
            "location": "679/TALK",
            "narrator": "アーヤ",
            "text": "は、はい…。\nつばめに会いに\n出てきたみたいで…。",
            "zh": "是、是的……。\n好像是来看望燕\n才过来的……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "681/TALK",
            "narrator": "啓介",
            "text": "その声…確かトライ\nナリーの隊長さんの\n声だったな？",
            "zh": "那个声音……记得是\n三重奏的队长\n对吧？",
            "narrator_zh": "启介"
        },
        {
            "location": "682/TALK",
            "narrator": "啓介",
            "text": "私を指令室へ入れろ。\nつばめの無事を\n確認させてくれ！",
            "zh": "让我进指令室。\n让我亲眼确认燕\n平安无事！",
            "narrator_zh": "启介"
        },
        {
            "location": "683/TALK",
            "narrator": "透明真幌",
            "text": "いや、気持ちはわかり\nますが規則が――",
            "zh": "不，您的心情我能理解，\n但规定就是――",
            "narrator_zh": "透明真幌"
        },
        {
            "location": "684/TALK",
            "narrator": "啓介",
            "text": "そんなもの知るか！",
            "zh": "鬼才管那种东西！",
            "narrator_zh": "启介"
        },
        {
            "location": "685/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "686/TALK",
            "narrator": "アーヤ",
            "text": "超が付く心配性で、\n頑固な性格…。",
            "zh": "超级爱操心，\n性格又顽固……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "687/TALK",
            "narrator": "アーヤ",
            "text": "この人見てると、\nお父さんのこと\n思い出すなぁ…。",
            "zh": "看着这个人，\n就会想起\n我爸爸啊……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "688/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "689/TALK",
            "narrator": "アーヤ",
            "text": "そっか…。\nだから放っておけな\nかったのかも…。",
            "zh": "这样啊……。\n所以才没法\n放着不管吧……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "690/TALK",
            "narrator": "アーヤ",
            "text": "でも、それなら…。",
            "zh": "不过，既然如此……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "691/TALK",
            "narrator": "透明真幌",
            "text": "何度言われても、\n規則を曲げることは\nできません！",
            "zh": "无论您说多少次，\n规定也是绝对\n不能通融的！",
            "narrator_zh": "透明真幌"
        },
        {
            "location": "692/TALK",
            "narrator": "啓介",
            "text": "ならば勝手に行かせて\nもらうだけだ！",
            "zh": "那我就自己硬闯\n过去好了！",
            "narrator_zh": "启介"
        },
        {
            "location": "693/TALK",
            "narrator": "透明真幌",
            "text": "何をバカな…。",
            "zh": "别说傻话了……。",
            "narrator_zh": "透明真幌"
        },
        {
            "location": "698/TALK",
            "narrator": "アーヤ",
            "text": "お帰りください。",
            "zh": "请回吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "700/TALK",
            "narrator": "啓介",
            "text": "…なんだと？",
            "zh": "……你说什么？",
            "narrator_zh": "启介"
        },
        {
            "location": "701/TALK",
            "narrator": "アーヤ",
            "text": "今日はもう、静岡へ\nお帰りください。",
            "zh": "今天还请您\n回静冈去吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "702/TALK",
            "narrator": "啓介",
            "text": "バカなことを言うな！\nこの状況で帰るなんて\nできるはずが！",
            "zh": "别说傻话了！\n在这种节骨眼上\n我怎么可能回去！",
            "narrator_zh": "启介"
        },
        {
            "location": "703/TALK",
            "narrator": "アーヤ",
            "text": "つばめさんのことを\n心配する気持ちは、\nよくわかりました。",
            "zh": "您担心燕的心情，\n我已经非常\n理解了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "704/TALK",
            "narrator": "アーヤ",
            "text": "それでも、今日は\n帰っていただきます。",
            "zh": "即便如此，今天\n也请您务必回去。",
            "narrator_zh": "绫水"
        },
        {
            "location": "705/TALK",
            "narrator": "アーヤ",
            "text": "大変申し訳\nありません。",
            "zh": "非常\n抱歉。",
            "narrator_zh": "绫水"
        },
        {
            "location": "706/TALK",
            "narrator": "アーヤ",
            "text": "これから向かうのは\n命を懸けた戦い\nですから。",
            "zh": "因为接下来要面对的\n是赌上性命的\n战斗。",
            "narrator_zh": "绫水"
        },
        {
            "location": "708/TALK",
            "narrator": "啓介",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "启介"
        },
        {
            "location": "710/TALK",
            "narrator": "啓介",
            "text": "わかっている。",
            "zh": "我知道。",
            "narrator_zh": "启介"
        },
        {
            "location": "711/TALK",
            "narrator": "啓介",
            "text": "だからこそ――",
            "zh": "正因如此――",
            "narrator_zh": "启介"
        },
        {
            "location": "712/TALK",
            "narrator": "アーヤ",
            "text": "だからこそ、\n帰ってください。",
            "zh": "正因如此，\n才请您回去。",
            "narrator_zh": "绫水"
        },
        {
            "location": "713/TALK",
            "narrator": "啓介",
            "text": "…！",
            "zh": "……！",
            "narrator_zh": "启介"
        },
        {
            "location": "714/TALK",
            "narrator": "アーヤ",
            "text": "…つばめさんは、\nとても強いんです。",
            "zh": "……燕她，\n非常坚强。",
            "narrator_zh": "绫水"
        },
        {
            "location": "715/TALK",
            "narrator": "アーヤ",
            "text": "彼女は確実に\n戦果を挙げています。",
            "zh": "她确实地在\n立下战果。",
            "narrator_zh": "绫水"
        },
        {
            "location": "716/TALK",
            "narrator": "アーヤ",
            "text": "立派な戦士として、\n育っているんです。",
            "zh": "已经成长为一名\n出色的战士了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "717/TALK",
            "narrator": "アーヤ",
            "text": "でも、お父さんが\nここにいることに\n気付いてしまったら。",
            "zh": "可是，如果她发现\n爸爸就在这里\n的话，",
            "narrator_zh": "绫水"
        },
        {
            "location": "718/TALK",
            "narrator": "アーヤ",
            "text": "私たちの戦闘に対する\n集中が乱されてしまう\n可能性があるんです。",
            "zh": "我们对战斗的\n专注力就有可能\n被打乱。",
            "narrator_zh": "绫水"
        },
        {
            "location": "719/TALK",
            "narrator": "アーヤ",
            "text": "そんなことになれば、\n最悪、仲間に死傷者が\nでるかもしれません。",
            "zh": "一旦变成那样，\n最坏的情况下，同伴\n甚至可能出现死伤。",
            "narrator_zh": "绫水"
        },
        {
            "location": "720/TALK",
            "narrator": "アーヤ",
            "text": "彼女たちをまとめる\nリーダーとして、\nそれは許せません。",
            "zh": "作为统领她们的\n队长，我绝不允许\n这种事发生。",
            "narrator_zh": "绫水"
        },
        {
            "location": "721/TALK",
            "narrator": "啓介",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "启介"
        },
        {
            "location": "722/TALK",
            "narrator": "アーヤ",
            "text": "失礼を承知で\nはっきりと言わせて\nいただきます。",
            "zh": "请恕我失礼，\n我就把话\n挑明了说。",
            "narrator_zh": "绫水"
        },
        {
            "location": "723/TALK",
            "narrator": "アーヤ",
            "text": "戦闘の場において、\nあなたの存在は\n足手まといなんです。",
            "zh": "在战场上，\n您的存在只会\n拖累我们。",
            "narrator_zh": "绫水"
        },
        {
            "location": "724/TALK",
            "narrator": "啓介",
            "text": "いや…だ、だが、\nしかし…。",
            "zh": "不……可、可是，\n话虽如此……。",
            "narrator_zh": "启介"
        },
        {
            "location": "725/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "726/TALK",
            "narrator": "アーヤ",
            "text": "小娘が何を、と\nお思いでしょうが。",
            "zh": "您或许会觉得小丫头片子\n在说什么大话。",
            "narrator_zh": "绫水"
        },
        {
            "location": "727/TALK",
            "narrator": "アーヤ",
            "text": "私はトライナリーの\nリーダーです。",
            "zh": "我是三重奏的\n队长。",
            "narrator_zh": "绫水"
        },
        {
            "location": "728/TALK",
            "narrator": "アーヤ",
            "text": "最も戦闘の経験を\n積んだ隊員です。",
            "zh": "是战斗经验\n最丰富的队员。",
            "narrator_zh": "绫水"
        },
        {
            "location": "729/TALK",
            "narrator": "アーヤ",
            "text": "今まで、一度たりとも\n戦闘で失敗したことは\nありません。",
            "zh": "至今为止，我在战斗中\n从来没有\n失败过一次。",
            "narrator_zh": "绫水"
        },
        {
            "location": "730/TALK",
            "narrator": "アーヤ",
            "text": "また、仲間の中に\n犠牲を出したことも\nありません。",
            "zh": "也从未让同伴\n出现过任何\n牺牲。",
            "narrator_zh": "绫水"
        },
        {
            "location": "731/TALK",
            "narrator": "アーヤ",
            "text": "そしてこれからも、\n仲間のことを護り\nたい…。",
            "zh": "而且今后，我也想\n继续保护好\n同伴……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "732/TALK",
            "narrator": "アーヤ",
            "text": "例え、自分の身を\n犠牲にしたとしても。",
            "zh": "哪怕是牺牲\n我自己的性命。",
            "narrator_zh": "绫水"
        },
        {
            "location": "734/TALK",
            "narrator": "アーヤ",
            "text": "だから、私のことを\n信じていただけま\nせんか？",
            "zh": "所以，您能\n相信我\n吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "736/TALK",
            "narrator": "啓介",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "启介"
        },
        {
            "location": "738/TALK",
            "narrator": "啓介",
            "text": "ひとつだけ\n聞かせてくれ。",
            "zh": "只有一个问题，\n能告诉我吗。",
            "narrator_zh": "启介"
        },
        {
            "location": "740/TALK",
            "narrator": "啓介",
            "text": "…君のお父さんは、\n君の入隊をどうして\n許したんだ？",
            "zh": "……你的父亲，\n当初为什么会允许你\n入队呢？",
            "narrator_zh": "启介"
        },
        {
            "location": "741/TALK",
            "narrator": "アーヤ",
            "text": "…私を見て、\nと言っていました。",
            "zh": "……他说，\n是因为看到了我。",
            "narrator_zh": "绫水"
        },
        {
            "location": "742/TALK",
            "narrator": "アーヤ",
            "text": "東京で、仲間たちに\n囲まれている\n私の姿を見たと。",
            "zh": "说他在东京看到了\n被同伴们围在中间\n的我。",
            "narrator_zh": "绫水"
        },
        {
            "location": "744/TALK",
            "narrator": "アーヤ",
            "text": "それが楽しそうで、\n幸せそうに見えたから\nだと。",
            "zh": "因为那时的我看起来\n很快乐、很幸福\n的缘故。",
            "narrator_zh": "绫水"
        },
        {
            "location": "746/TALK",
            "narrator": "啓介",
            "text": "…私には、到底無理な\n話だな。",
            "zh": "……对我来说，\n根本做不到这么豁达啊。",
            "narrator_zh": "启介"
        },
        {
            "location": "748/TALK",
            "narrator": "啓介",
            "text": "君の父親のように、\n達観することは\nできない…。",
            "zh": "我没法像你的父亲那样\n看得那么\n开……。",
            "narrator_zh": "启介"
        },
        {
            "location": "749/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "750/TALK",
            "narrator": "啓介",
            "text": "…だが…確かに今日の\nつばめは、楽しそうに\n笑っていた…。",
            "zh": "……不过……今天的燕，\n确实笑得很开心\n呢……。",
            "narrator_zh": "启介"
        },
        {
            "location": "751/TALK",
            "narrator": "啓介",
            "text": "静岡では見せたことが\nない、本物の笑顔\nだった…。",
            "zh": "是在静冈从未\n见过的、发自真心的\n笑容……。",
            "narrator_zh": "启介"
        },
        {
            "location": "753/TALK",
            "narrator": "啓介",
            "text": "…私には、何をする\nこともできない。",
            "zh": "……我什么也\n做不了。",
            "narrator_zh": "启介"
        },
        {
            "location": "754/TALK",
            "narrator": "啓介",
            "text": "……代わりに、\nつばめのことを\n護ってくれるか？",
            "zh": "……你能替我\n保护好燕\n吗？",
            "narrator_zh": "启介"
        },
        {
            "location": "755/TALK",
            "narrator": "アーヤ",
            "text": "…私に、任せて\nいただけるので\nあれば。",
            "zh": "……如果您愿意\n交托给我的\n话。",
            "narrator_zh": "绫水"
        },
        {
            "location": "756/TALK",
            "narrator": "啓介",
            "text": "…そうか。",
            "zh": "……这样啊。",
            "narrator_zh": "启介"
        },
        {
            "location": "757/TALK",
            "narrator": "啓介",
            "text": "綾水さんになら、\n委ねてもいいかも\nしれない。",
            "zh": "如果是绫水的话，\n或许真的可以\n托付给你。",
            "narrator_zh": "启介"
        },
        {
            "location": "758/TALK",
            "narrator": "啓介",
            "text": "だから、頼む…。\nつばめのことを、\n護ってやってくれ。",
            "zh": "所以，拜托了……。\n替我保护好\n燕吧。",
            "narrator_zh": "启介"
        },
        {
            "location": "759/TALK",
            "narrator": "アーヤ",
            "text": "…わかりました。\n私にお任せください。",
            "zh": "……我明白了。\n请交给我吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "760/TALK",
            "narrator": "啓介",
            "text": "…ありがとう。",
            "zh": "……谢谢。",
            "narrator_zh": "启介"
        },
        {
            "location": "761/TALK",
            "narrator": "啓介",
            "text": "…君の言う通り、\n今日のところは\n帰るとしよう。",
            "zh": "……照你说的，\n今天就先\n回去吧。",
            "narrator_zh": "启介"
        },
        {
            "location": "762/TALK",
            "narrator": "アーヤ",
            "text": "…よかった。",
            "zh": "……太好了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "767/TALK",
            "narrator": "アーヤ",
            "text": "館長。私は直接\n現場まで\n向かいます。",
            "zh": "馆长。我直接\n赶往现场\n了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "768/TALK",
            "narrator": "アーヤ",
            "text": "つばめのお父さんの\n迎えをお願いします",
            "zh": "请派车来接一下\n燕的爸爸",
            "narrator_zh": "绫水"
        },
        {
            "location": "769/TALK",
            "narrator": "透明真幌",
            "text": "わかった。\n至急手配する。",
            "zh": "知道了。\n马上安排。",
            "narrator_zh": "透明真幌"
        },
        {
            "location": "775/TALK",
            "narrator": "アーヤ",
            "text": "…迎えが来るまで、\nここで待っていて\nください。",
            "zh": "……在接您的人来之前，\n请先在这里\n稍候。",
            "narrator_zh": "绫水"
        },
        {
            "location": "776/TALK",
            "narrator": "アーヤ",
            "text": "それじゃ、\n私も行きますね。",
            "zh": "那么，\n我也出发了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "777/TALK",
            "narrator": "啓介",
            "text": "ああ…つばめのこと、\nよろしく頼む。",
            "zh": "嗯……燕的事，\n就拜托你了。",
            "narrator_zh": "启介"
        },
        {
            "location": "778/TALK",
            "narrator": "啓介",
            "text": "それと…。",
            "zh": "还有……。",
            "narrator_zh": "启介"
        },
        {
            "location": "779/TALK",
            "narrator": "啓介",
            "text": "君も気を付けろ！",
            "zh": "你自己也要小心！",
            "narrator_zh": "启介"
        },
        {
            "location": "780/TALK",
            "narrator": "アーヤ",
            "text": "…はい！",
            "zh": "……是！",
            "narrator_zh": "绫水"
        },
        {
            "location": "791/DIALOG",
            "narrator": "Dialog_chapter_ch02",
            "text": "【13 電脳料理人】",
            "zh": "【13 电脑厨师】",
            "narrator_zh": "Dialog_chapter_ch02"
        }
    ]
}
