{
    "dir": "chap00/daydra/spev_ch03_009.js",
    "type": "",
    "info": {
        "story_id": "3009",
        "cid": "",
        "title": "スペシャルエピソード",
        "sub_title": "水陸両用ガブちゃん",
        "title_zh": "特别篇",
        "sub_title_zh": "水陆两用小加布"
    },
    "entry": [
        {
            "location": "35/TALK",
            "narrator": "透明ガブリエラ",
            "text": "…想像してた以上に\n恥ずかしいんだけど？",
            "zh": "……比我想象的\n还要丢脸啊？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "36/TALK",
            "narrator": "透明みやび",
            "text": "何言うてるが。\nめっちゃ可愛いぞね。",
            "zh": "说驷马呢。\n蛮可爱滴咧。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "37/TALK",
            "narrator": "透明アーヤ",
            "text": "ええ、とっても素敵よ、\nギャヴィ。",
            "zh": "是啊，很好看哦，\n加维。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "40/TALK",
            "narrator": "透明ガブリエラ",
            "text": "嬉しくないから！\n中学生にもなって、\n浮き輪姿褒められても！",
            "zh": "才高兴不起来呢！\n都当上初中生了，\n套着泳圈的样子还被夸！",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "41/TALK",
            "narrator": "透明みやび",
            "text": "いや、中学生とか\n関係ないと思うがよ？",
            "zh": "没呀，跟是不是初中生\n没得关系啵？",
            "narrator_zh": "透明雅"
        },
        {
            "location": "42/TALK",
            "narrator": "透明みやび",
            "text": "浮き輪は大人でも使う\n海やプールでの\n玩具やきね。",
            "zh": "泳圈本来就是\n大人在海边或泳池\n也会拿来玩的玩具啵。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "43/TALK",
            "narrator": "透明アーヤ",
            "text": "そうよ。\n使わないなら、\n私が使おうかしら？",
            "zh": "就是啊。\n你不用的话，\n要不我来用吧？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "45/TALK",
            "narrator": "透明ガブリエラ",
            "text": "えっ？　でもアーヤ、\n泳げなかったっけ？",
            "zh": "诶？可是绫水，\n你不是不会游泳吗？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "47/TALK",
            "narrator": "透明アーヤ",
            "text": "のんびり泳ぐなら、\nやっぱり浮き輪あった方が\n楽しいじゃない。",
            "zh": "想悠闲地游水，\n果然还是有泳圈\n更好玩嘛。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "48/TALK",
            "narrator": "透明アーヤ",
            "text": "小さな波を越えたり\nするの、楽しいし。",
            "zh": "翻过小小的浪花\n什么的，挺有意思的。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "49/TALK",
            "narrator": "透明みやび",
            "text": "あの、ユラ～ッ、って\n独特な感じは堪らんな。",
            "zh": "那个晃呀晃～的\n独特感觉，真是受不了咧。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "50/TALK",
            "narrator": "透明アーヤ",
            "text": "そういうこと。\nだから、使わないなら\n貸してもらえる？",
            "zh": "就是这样。\n所以，不用的话\n能借我吗？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "51/SEL",
            "narrator": "（選択肢）",
            "text": "ガブリエラ専用です",
            "zh": "这是加布里埃拉专用的",
            "narrator_zh": "（选项）"
        },
        {
            "location": "52/ACT",
            "narrator": "",
            "text": "ガブリエラ専用です",
            "zh": "这是加布里埃拉专用的",
            "narrator_zh": ""
        },
        {
            "location": "54/TALK",
            "narrator": "透明ガブリエラ",
            "text": "ちょ、$handle$！\nなに勝手なこと\n言ってるのよ！？",
            "zh": "喂、$handle$！\n你在那儿擅自\n乱说什么啊！？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "55/TALK",
            "narrator": "透明アーヤ",
            "text": "そっか…。\nじゃ、私は向こうで\n肌でも焼こうかしら？",
            "zh": "这样啊……\n那我到那边去\n晒晒太阳好了？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "56/TALK",
            "narrator": "透明みやび",
            "text": "ほほう、ならばうちは\nサンオイル塗り担当に\nなるとするぞね。",
            "zh": "哦吼，那我就\n来当涂防晒油\n担当咧。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "58/TALK",
            "narrator": "透明アーヤ",
            "text": "…変な塗り方したら\n即クビよ？",
            "zh": "……要是敢乱涂的话\n立刻开除你哦？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "63/TALK",
            "narrator": "透明ガブリエラ",
            "text": "…もぅ！\n$handle$ってば\n勝手なこと言って！",
            "zh": "……真是的！\n$handle$你呀，\n净说些自作主张的话！",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "64/TALK",
            "narrator": "透明ガブリエラ",
            "text": "あんなにあたしが\n浮き輪を嫌がってたの、\nわからなかったの？",
            "zh": "我刚才那么讨厌\n戴泳圈的样子，\n你没看出来吗？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "66/TALK",
            "narrator": "透明ガブリエラ",
            "text": "こんなの使っても、\n全然面白くないわ。",
            "zh": "就算用这种东西，\n也一点都不好玩。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "67/SEL",
            "narrator": "（選択肢）",
            "text": "とっても可愛いよ？",
            "zh": "非常可爱呀？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "68/SEL",
            "narrator": "（選択肢）",
            "text": "絶対楽しいよ",
            "zh": "绝对很好玩哦",
            "narrator_zh": "（选项）"
        },
        {
            "location": "69/SEL",
            "narrator": "（選択肢）",
            "text": "とっても似合ってるのに？",
            "zh": "明明很适合你啊？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "70/ACT",
            "narrator": "",
            "text": "とっても可愛いよ？",
            "zh": "非常可爱呀？",
            "narrator_zh": ""
        },
        {
            "location": "72/TALK",
            "narrator": "透明ガブリエラ",
            "text": "…ず、ズルいわ！",
            "zh": "……太、太狡猾了！",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "73/TALK",
            "narrator": "透明ガブリエラ",
            "text": "$handle$に\nそう言われたら…、\n嫌って言えないじゃない。",
            "zh": "被$handle$\n这么一说……\n我就说不出讨厌了嘛。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "74/TALK",
            "narrator": "透明ガブリエラ",
            "text": "…でも、本当に\n可愛いって\n思ってくれてる？",
            "zh": "……不过，你真的\n觉得这副样子\n很可爱吗？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "75/SEL",
            "narrator": "（選択肢）",
            "text": "本当に思ってる",
            "zh": "我是认真的",
            "narrator_zh": "（选项）"
        },
        {
            "location": "76/SEL",
            "narrator": "（選択肢）",
            "text": "可愛らしいよ",
            "zh": "挺俏皮可爱的",
            "narrator_zh": "（选项）"
        },
        {
            "location": "77/ACT",
            "narrator": "",
            "text": "本当に思ってる",
            "zh": "我是认真的",
            "narrator_zh": ""
        },
        {
            "location": "79/TALK",
            "narrator": "透明ガブリエラ",
            "text": "そう…。",
            "zh": "是吗……",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "80/TALK",
            "narrator": "透明ガブリエラ",
            "text": "…なんか、ちょっとだけ\n嫌だって気持ち、\n薄れたかも…。",
            "zh": "……总觉得，那种\n讨厌的心情，\n好像淡了一点……",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "81/TALK",
            "narrator": "透明ガブリエラ",
            "text": "…恥ずかしいのは、\nまだ残ってるけど。",
            "zh": "……虽然丢脸的感觉，\n还是没消掉就是了。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "82/ACT",
            "narrator": "",
            "text": "可愛らしいよ",
            "zh": "挺俏皮可爱的",
            "narrator_zh": ""
        },
        {
            "location": "85/TALK",
            "narrator": "透明ガブリエラ",
            "text": "…なんでかしら？",
            "zh": "……怎么回事呀？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "86/TALK",
            "narrator": "透明ガブリエラ",
            "text": "すっごい子供扱い\nされてるような気が\nするんだけど…？",
            "zh": "我怎么觉得\n像被当成小孩子\n对待了呢……？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "87/TALK",
            "narrator": "透明ガブリエラ",
            "text": "…ま、$handle$が\nそんなイジワルするはず\nないわよね。",
            "zh": "……算了，$handle$\n肯定不会这么\n坏心眼吧。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "89/ACT",
            "narrator": "",
            "text": "絶対楽しいよ",
            "zh": "绝对很好玩哦",
            "narrator_zh": ""
        },
        {
            "location": "91/TALK",
            "narrator": "透明ガブリエラ",
            "text": "…まあ、アーヤが言ってた\nみたいな遊び方は…。",
            "zh": "……话是这么说，\n像绫水刚才说的那种玩法……",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "92/TALK",
            "narrator": "透明ガブリエラ",
            "text": "確かに浮き輪がないと\nできないことよね。",
            "zh": "确实要是没有泳圈\n就玩不起来呢。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "93/ACT",
            "narrator": "",
            "text": "とっても似合ってるのに？",
            "zh": "明明很适合你啊？",
            "narrator_zh": ""
        },
        {
            "location": "95/TALK",
            "narrator": "透明ガブリエラ",
            "text": "その似合ってるって\nなんなのよ？",
            "zh": "那个“很适合”\n是什么意思呀？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "96/TALK",
            "narrator": "透明ガブリエラ",
            "text": "浮き輪が似合うって、\n子供扱いされてるような\n気持ちになるんだけど？",
            "zh": "说我适合泳圈，\n怎么感觉像在\n把我当小孩一样啊？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "97/TALK",
            "narrator": "透明ガブリエラ",
            "text": "…まさか、そういう\nことじゃないでしょうね？",
            "zh": "……你该不会，\n真就是那个意思吧？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "98/SEL",
            "narrator": "（選択肢）",
            "text": "純粋に似合うと思っただけ",
            "zh": "我只是单纯觉得很适合你",
            "narrator_zh": "（选项）"
        },
        {
            "location": "99/SEL",
            "narrator": "（選択肢）",
            "text": "…そんなわけないよ！",
            "zh": "……怎么可能呢！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "100/ACT",
            "narrator": "",
            "text": "純粋に似合うと思っただけ",
            "zh": "我只是单纯觉得很适合你",
            "narrator_zh": ""
        },
        {
            "location": "101/TALK",
            "narrator": "透明ガブリエラ",
            "text": "そ、そうだったの？",
            "zh": "原、原来是这样啊？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "102/TALK",
            "narrator": "透明ガブリエラ",
            "text": "だとしたら…、ちょっと\n悪いこと言っちゃったかも\nしれないわね…。",
            "zh": "要是那样的话……我刚才\n好像说了点过分的话\n呢……",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "103/SEL",
            "narrator": "（選択肢）",
            "text": "キスしてくれたら許そう",
            "zh": "亲我一下就原谅你",
            "narrator_zh": "（选项）"
        },
        {
            "location": "104/SEL",
            "narrator": "（選択肢）",
            "text": "信じてくれて嬉しい",
            "zh": "谢谢你愿意相信我",
            "narrator_zh": "（选项）"
        },
        {
            "location": "105/ACT",
            "narrator": "",
            "text": "キスしてくれたら許そう",
            "zh": "亲我一下就原谅你",
            "narrator_zh": ""
        },
        {
            "location": "107/TALK",
            "narrator": "透明ガブリエラ",
            "text": "は、はぁ！？",
            "zh": "哈、哈啊！？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "108/TALK",
            "narrator": "透明ガブリエラ",
            "text": "無理無理無理！\nそんなの無理だから！",
            "zh": "不行不行不行！\n那种事绝对不行！",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "109/TALK",
            "narrator": "透明ガブリエラ",
            "text": "ほら、アーヤたちだって\n向こうでこっち見てるし。",
            "zh": "你看，绫水她们\n也在那边往这儿看呢。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "111/TALK",
            "narrator": "透明ガブリエラ",
            "text": "…二人っきりだったら、\n考えてあげなくも\nなかったけど…。",
            "zh": "……要是只有两个人的话，\n倒也不是不能\n考虑一下……",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "112/ACT",
            "narrator": "",
            "text": "信じてくれて嬉しい",
            "zh": "谢谢你愿意相信我",
            "narrator_zh": ""
        },
        {
            "location": "114/TALK",
            "narrator": "透明ガブリエラ",
            "text": "$handle$は\nあたしにウソついたり\nしないでしょ？",
            "zh": "$handle$\n应该不会对我\n说谎的吧？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "115/TALK",
            "narrator": "透明ガブリエラ",
            "text": "だから当然信じるわ。",
            "zh": "所以我当然相信你。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "117/TALK",
            "narrator": "透明ガブリエラ",
            "text": "…ウソだっていうのが\nわかったら、その時は\nお仕置きだけど。",
            "zh": "……不过要是让我知道\n你在撒谎，到时候\n可要惩罚你哦。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "119/ACT",
            "narrator": "",
            "text": "…そんなわけないよ！",
            "zh": "……怎么可能呢！",
            "narrator_zh": ""
        },
        {
            "location": "121/TALK",
            "narrator": "透明ガブリエラ",
            "text": "…すっごい\n怪しいんだけど？",
            "zh": "……听起来\n非常可疑好不好？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "122/TALK",
            "narrator": "透明ガブリエラ",
            "text": "でもまあ、あんまり\n$handle$を\n疑うのも悪いわね。",
            "zh": "不过算了，老是这样\n怀疑$handle$\n也不太好呢。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "123/TALK",
            "narrator": "透明ガブリエラ",
            "text": "今回は信じてあげるわ。",
            "zh": "这次就先相信你好了。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "127/TALK",
            "narrator": "透明ガブリエラ",
            "text": "…それじゃあ、\n今日は浮き輪を付けて\n海で遊ぶことにするわ。",
            "zh": "……那好吧，\n今天就戴着泳圈\n下海玩好了。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "128/TALK",
            "narrator": "透明ガブリエラ",
            "text": "アーヤ達もだけど、\n$handle$も、\n褒めてくれたし…。",
            "zh": "不光是绫水她们，\n连$handle$也\n夸了我嘛……",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "129/SEL",
            "narrator": "（選択肢）",
            "text": "おもいっきり楽しんでね",
            "zh": "尽情去玩吧",
            "narrator_zh": "（选项）"
        },
        {
            "location": "130/ACT",
            "narrator": "",
            "text": "おもいっきり楽しんでね",
            "zh": "尽情去玩吧",
            "narrator_zh": ""
        },
        {
            "location": "132/TALK",
            "narrator": "透明ガブリエラ",
            "text": "そうね、遊ばないと\n勿体ないわ。",
            "zh": "也是呢，不玩一玩\n就太可惜了。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "134/TALK",
            "narrator": "透明神楽",
            "text": "あ、つばめさん。\nガブちゃん達いましたよ。",
            "zh": "啊，燕。\n加布她们在这里哦。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "135/TALK",
            "narrator": "透明つばめ",
            "text": "ガブちゃーん。\n一緒にビーチバレーして\n遊ぼー。",
            "zh": "加布——。\n一起来打\n沙滩排球玩吧——。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "136/TALK",
            "narrator": "透明ガブリエラ",
            "text": "悪いけど、今日はちょっと\n沖まで泳ぐつもりなの。",
            "zh": "不好意思，今天我打算\n游到离岸边远点的地方去。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
