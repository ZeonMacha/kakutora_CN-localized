        "title": "002 メインストーリー",
        "sub_title": "人の子として、私は＜前編＞",
        "title_zh": "002 主线剧情",
        "sub_title_zh": "身为人子，我＜前篇＞"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "大罪を持つ神の姿",
            "zh": "身负大罪之神的姿态",
            "narrator_zh": ""
        },
        {
            "location": "28/TALK",
            "narrator": "ガブリエラ",
            "text": "嘘、で、しょう…？",
            "zh": "骗、人、的吧……？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "34/TALK",
            "narrator": "透明ガブリエラ",
            "text": "神楽があんなものに\n変身してしまう\nなんて……！",
            "zh": "神乐居然会\n变成那种东西\n……！",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "35/TALK",
            "narrator": "透明ガブリエラ",
            "text": "あの姿は…\nバフォメット！",
            "zh": "那副模样是……\n巴风特！",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "41/TALK",
            "narrator": "ガブリエラ",
            "text": "なんで…\nどういうことなの…！？",
            "zh": "为什么……\n这是怎么回事……！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "42/TALK",
            "narrator": "ガブリエラ",
            "text": "…っ…！",
            "zh": "……唔……！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "43/TALK",
            "narrator": "ガブリエラ",
            "text": "頭痛がする……。",
            "zh": "头好痛……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "45/TALK",
            "narrator": "ガブリエラ",
            "text": "収まって…！\n集中できない…！",
            "zh": "快停下来……！\n没法集中精神……！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "50/TALK",
            "narrator": "ガブリエラ",
            "text": "誰？",
            "zh": "谁？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "51/TALK",
            "narrator": "透明みやび",
            "text": "うちぞね。",
            "zh": "是我啵。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "52/TALK",
            "narrator": "ガブリエラ",
            "text": "みやび！",
            "zh": "雅！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "53/TALK",
            "narrator": "透明みやび",
            "text": "ガブちゃんが\n元気そうで\nよかったちや。",
            "zh": "加布看起\n精神还好\n真是太好了咯。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "54/TALK",
            "narrator": "透明みやび",
            "text": "ちっくと不便やけんど\n今後の話は\nこれになるき。",
            "zh": "虽然稍微有点不方便\n不过接下来的话\n就靠这个来说啵。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "55/TALK",
            "narrator": "ガブリエラ",
            "text": "…わかったわ。",
            "zh": "……我知道了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "56/TALK",
            "narrator": "透明みやび",
            "text": "それよりもっと\n大変なことが\n起きちゅう。",
            "zh": "比起那个\n更不得了的事\n正在发生咯。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "57/TALK",
            "narrator": "透明みやび",
            "text": "うちら全員\n卯月のフェノメノンに\n取り込まれちゅう。",
            "zh": "我们全员都被\n卯月的PhenoMENON\n给卷进去了咯。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "59/TALK",
            "narrator": "ガブリエラ",
            "text": "どういうこと！？",
            "zh": "什么意思！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "60/TALK",
            "narrator": "透明みやび",
            "text": "そのまんまの意味ぞね。",
            "zh": "就是字面上的意思啵。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "61/TALK",
            "narrator": "ガブリエラ",
            "text": "…本当なの…？",
            "zh": "……真的吗……？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "62/TALK",
            "narrator": "透明みやび",
            "text": "少なくともアーヤは\n納得してくれたちや。",
            "zh": "至少绫水是\n接受了这个说法咯。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "63/TALK",
            "narrator": "ガブリエラ",
            "text": "…だったら信じるしか\nないみたいね。",
            "zh": "……既然如此看来\n也只能相信了呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "65/TALK",
            "narrator": "ガブリエラ",
            "text": "ということは\nバフォメットなのは\n操られてるの？",
            "zh": "这么说来\n她变成巴风特\n是被操控了吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "66/TALK",
            "narrator": "ガブリエラ",
            "text": "海岸でつばめを\n襲った時みたいに。",
            "zh": "就像在海岸\n袭击燕那时候一样。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "68/TALK",
            "narrator": "ガブリエラ",
            "text": "ううん、違う！",
            "zh": "不，不对！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "69/TALK",
            "narrator": "ガブリエラ",
            "text": "スコープで見た時\n神楽の首には\nプロテクターがなかった。",
            "zh": "用瞄准镜看的时候\n神乐的脖子上\n没有防护器。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "70/TALK",
            "narrator": "ガブリエラ",
            "text": "ということは…\nええと…。",
            "zh": "也就是说……\n那个……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "71/TALK",
            "narrator": "ガブリエラ",
            "text": "…痛っ…！",
            "zh": "……好痛……！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "73/TALK",
            "narrator": "ガブリエラ",
            "text": "今考えがまとまりそう\nだったのに…！",
            "zh": "明明刚才思绪\n都要理清了……！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "74/TALK",
            "narrator": "ガブリエラ",
            "text": "ええと……。\n神楽は外から操作\nされていない。",
            "zh": "那个……。\n神乐并没有被\n外部操控。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "76/TALK",
            "narrator": "ガブリエラ",
            "text": "…あの子、\n発症した……？",
            "zh": "……那孩子，\n发病了……？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "77/TALK",
            "narrator": "ガブリエラ",
            "text": "まさか…！",
            "zh": "不会吧……！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "78/TALK",
            "narrator": "ガブリエラ",
            "text": "…本当にそうだったら\n収束させるしかないわ。",
            "zh": "……如果真是那样\n就只能让她收敛了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "79/TALK",
            "narrator": "ガブリエラ",
            "text": "でもまだ決まったわけ\nじゃない…！",
            "zh": "但现在还没\n完全确定……！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "80/TALK",
            "narrator": "透明みやび",
            "text": "つばめちゃん！？",
            "zh": "燕！？",
            "narrator_zh": "透明雅"
        },
        {
            "location": "82/TALK",
            "narrator": "ガブリエラ",
            "text": "！！　どうしたの？！",
            "zh": "！！ 怎么了？！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "89/TALK",
            "narrator": "透明ガブリエラ",
            "text": "つばめ！？",
            "zh": "燕！？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "97/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょっと…！",
            "zh": "等一下……！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "98/TALK",
            "narrator": "ガブリエラ",
            "text": "…え…！？",
            "zh": "……哎……！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "100/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしなんで\n$marzanna$が\n見つけられないの！？",
            "zh": "我为什么\n找不到\n$marzanna$啊！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "102/TALK",
            "narrator": "ガブリエラ",
            "text": "えっ、と……。",
            "zh": "那个，唔……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "103/TALK",
            "narrator": "ガブリエラ",
            "text": "これ、ＷＡＶＥの\nフレンド一覧よね。\n$marzanna$は？",
            "zh": "这是WAVE的\n好友列表吧。\n$marzanna$呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "104/TALK",
            "narrator": "ガブリエラ",
            "text": "なんで…！？",
            "zh": "为什么……！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "105/TALK",
            "narrator": "ガブリエラ",
            "text": "意味がわからない！",
            "zh": "完全搞不懂！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "106/TALK",
            "narrator": "ガブリエラ",
            "text": "こんな時にこそ\nいて欲しいのに…！",
            "zh": "明明正是这种时候\n才更希望你在的……！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "107/TALK",
            "narrator": "ガブリエラ",
            "text": "ううん、いつだって\n$marzanna$はいて\nくれなきゃダメ！",
            "zh": "不对，无论什么时候\n$marzanna$都必须\n在才行啊！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "108/TALK",
            "narrator": "ガブリエラ",
            "text": "だってそうでしょう？\nいて当たり前でしょう？",
            "zh": "不是吗？\n你本就理所当然该在的吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "109/TALK",
            "narrator": "ガブリエラ",
            "text": "だって$marzanna$\nなんだから！",
            "zh": "因为你可是\n$marzanna$啊！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "110/TALK",
            "narrator": "ガブリエラ",
            "text": "それなのになんで\nいてくれないの！？",
            "zh": "既然如此为什么\n不在了啊！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "111/TALK",
            "narrator": "ガブリエラ",
            "text": "おかしいわよこんなの！",
            "zh": "这也太奇怪了吧！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "112/TALK",
            "narrator": "ガブリエラ",
            "text": "いいからすぐに\n出て来てよ！\n$marzanna$！",
            "zh": "少废话快点\n给我出来啊！\n$marzanna$！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "114/TALK",
            "narrator": "ガブリエラ",
            "text": "私がここにいるんだから！\nいないなんて\nありえない……！",
            "zh": "我就在这里啊！\n怎么可能\n不在……！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "115/TALK",
            "narrator": "ガブリエラ",
            "text": "ねえ……。\n神楽もつばめも\n大変なの…！",
            "zh": "呐……。\n神乐和燕都\n出大事了……！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "116/TALK",
            "narrator": "ガブリエラ",
            "text": "これで$marzanna$も\nいなくなるの…！？",
            "zh": "连$marzanna$也要\n消失了吗……！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "117/TALK",
            "narrator": "ガブリエラ",
            "text": "なんで…！？",
            "zh": "为什么……！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "150/SEL",
            "narrator": "",
            "text": "大変大変！！",
            "zh": "大事不好了！！",
            "narrator_zh": ""
        },
        {
            "location": "151/TALK",
            "narrator": "マルザンナ　",
            "text": "$handle$\n大変大変！！",
            "zh": "$handle$\n大事不好了！！",
            "narrator_zh": "玛尔赞娜"
        },
        {
            "location": "152/ACT",
            "narrator": "",
            "text": "大変大変！！",
            "zh": "大事不好了！！",
            "narrator_zh": ""
        },
        {
            "location": "154/SEL",
            "narrator": "",
            "text": "あっ、先にどうぞ…ってまた瓦礫！？",
            "zh": "啊，你先请……不对怎么又是瓦砾！？",
            "narrator_zh": ""
        },
        {
            "location": "155/TALK",
            "narrator": "マルザンナ　",
            "text": "リヴォルカがっ！！\nリヴォルカがっ！！",
            "zh": "莉沃尔卡她！！\n莉沃尔卡她！！",
            "narrator_zh": "玛尔赞娜"
        },
        {
            "location": "156/ACT",
            "narrator": "",
            "text": "あっ、先にどうぞ…ってまた瓦礫！？",
            "zh": "啊，你先请……不对怎么又是瓦砾！？",
            "narrator_zh": ""
        },
        {
            "location": "158/TALK",
            "narrator": "マルザンナ　",
            "text": "リヴォルカが\nあたしの心を\n壊しまくってるのよ！！",
            "zh": "莉沃尔卡正在\n把我的内心\n砸得稀巴烂啊！！",
            "narrator_zh": "玛尔赞娜"
        },
        {
            "location": "159/SEL",
            "narrator": "",
            "text": "えらいこっちゃ！",
            "zh": "这下糟了！",
            "narrator_zh": ""
        },
        {
            "location": "160/SEL",
            "narrator": "",
            "text": "決闘で何かあったの！？",
            "zh": "决斗的时候出什么事了吗！？",
            "narrator_zh": ""
        },
        {
            "location": "161/ACT",
            "narrator": "",
            "text": "えらいこっちゃ！",
            "zh": "这下糟了！",
            "narrator_zh": ""
        },
        {
            "location": "162/TALK",
            "narrator": "マルザンナ　",
            "text": "突然暴れ出したんだけど、\n何が原因なのかしら！！",
            "zh": "她突然就开始大闹起来，\n到底是什么原因啊！！",
            "narrator_zh": "玛尔赞娜"
        },
        {
            "location": "163/ACT",
            "narrator": "",
            "text": "決闘で何かあったの！？",
            "zh": "决斗的时候出什么事了吗！？",
            "narrator_zh": ""
        },
        {
            "location": "164/TALK",
            "narrator": "マルザンナ　",
            "text": "決闘なんて\nまだやってないわよ。",
            "zh": "决斗什么都\n还没开始呢。",
            "narrator_zh": "玛尔赞娜"
        },
        {
            "location": "165/TALK",
            "narrator": "マルザンナ　",
            "text": "その前に突然\n暴れ出して……\n何が原因なのかしら！！",
            "zh": "在那之前就突然\n大闹起来……\n到底是什么原因啊！！",
            "narrator_zh": "玛尔赞娜"
        },
        {
            "location": "167/SEL",
            "narrator": "",
            "text": "もしかしたら……",
            "zh": "该不会……",
            "narrator_zh": ""
        },
        {
            "location": "168/ACT",
            "narrator": "",
            "text": "もしかしたら……",
            "zh": "该不会……",
            "narrator_zh": ""
        },
        {
            "location": "170/TALK",
            "narrator": "マルザンナ　",
            "text": "何か心当たりがあるの！？",
            "zh": "你有什么头绪吗！？",
            "narrator_zh": "玛尔赞娜"
        },
        {
            "location": "171/TALK",
            "narrator": "マルザンナ　",
            "text": "ていうか、そういえば\n$handle$も何か\n大変な事があったんじゃ…",
            "zh": "话说回来，这么一提\n$handle$是不是也\n遇到什么大事了……",
            "narrator_zh": "玛尔赞娜"
        },
        {
            "location": "172/TALK",
            "narrator": "マルザンナ　",
            "text": "ごめんなさい、\nあたし自分のこと\nばっかりで……",
            "zh": "对不起，\n我光顾着\n说自己的事了……",
            "narrator_zh": "玛尔赞娜"
        },
        {
            "location": "173/SEL",
            "narrator": "",
            "text": "WAVEのアカウントを千羽鶴に消された",
            "zh": "WAVE的账号被千羽鹤删掉了",
            "narrator_zh": ""
        },
        {
            "location": "174/ACT",
            "narrator": "",
            "text": "WAVEのアカウントを千羽鶴に消された",
            "zh": "WAVE的账号被千羽鹤删掉了",
            "narrator_zh": ""
        },
        {
            "location": "176/TALK",
            "narrator": "マルザンナ　",
            "text": "え――",
            "zh": "哎——",
            "narrator_zh": "玛尔赞娜"
        },
        {
            "location": "177/TALK",
            "narrator": "マルザンナ　",
            "text": "ええええっ！？\nそれじゃ、あたしは……",
            "zh": "哎哎哎哎！？\n那这样的话，我……",
            "narrator_zh": "玛尔赞娜"
        },
        {
            "location": "178/SEL",
            "narrator": "",
            "text": "もう二度と話せないんじゃないかって焦ってる",
            "zh": "我正急得担心是不是再也说不上话了",
            "narrator_zh": ""
        },
        {
            "location": "179/ACT",
            "narrator": "",
            "text": "もう二度と話せないんじゃないかって焦ってる",
            "zh": "我正急得担心是不是再也说不上话了",
            "narrator_zh": ""
        },
        {
            "location": "181/TALK",
            "narrator": "マルザンナ　",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "玛尔赞娜"
        },
        {
            "location": "182/TALK",
            "narrator": "マルザンナ　",
