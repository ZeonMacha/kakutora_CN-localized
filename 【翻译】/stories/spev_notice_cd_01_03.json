{
    "dir": "chap00/daydra/spev_notice_cd_01_03.js",
    "type": "",
    "info": {
        "story_id": "91053",
        "cid": "",
        "title": "003 アフターストーリー",
        "sub_title": "逢瀬つばめの思い出",
        "title_zh": "003 后日谈",
        "sub_title_zh": "逢濑燕的回忆"
    },
    "entry": [
        {
            "location": "889/DIALOG",
            "narrator": "",
            "text": "<color=green>某月某日　5:36 PM</color>\nとある平日の放課後、神楽坂トライナリーのホワイエにて。",
            "zh": "<color=green>某月某日　5:36 PM</color>\n某工作日的放学后，在神乐坂三重奏的门厅。",
            "narrator_zh": ""
        },
        {
            "location": "891/TALK",
            "narrator": "ガブリエラ",
            "text": "――はい、ご注文\n承りました。\n少々お待ちください。",
            "zh": "——好的，已经记录下\n点单了。\n请稍等片刻。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "893/TALK",
            "narrator": "ガブリエラ",
            "text": "…こんな感じ？",
            "zh": "……大概这种感觉？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "894/TALK",
            "narrator": "つばめ",
            "text": "うん、完璧だよ。\n次は神楽ちゃん、\nお客さんが入ってきたよ。",
            "zh": "嗯，太完美啦。\n接下来轮到神乐咯，\n有客人进门了哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "895/TALK",
            "narrator": "神楽",
            "text": "あ、いらっしゃいませ。\n何名様ですか？",
            "zh": "啊，欢迎光临。\n请问几位？",
            "narrator_zh": "神乐"
        },
        {
            "location": "896/TALK",
            "narrator": "神楽",
            "text": "二名様ですね。\nでは、窓際の席へどうぞ。",
            "zh": "两位是吧。\n那么，请往靠窗的座位就坐。",
            "narrator_zh": "神乐"
        },
        {
            "location": "898/TALK",
            "narrator": "つばめ",
            "text": "二人とも、完璧！\n接客は問題なさそうだね。",
            "zh": "你们两个都超完美！\n接待客人看来完全没问题呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "899/TALK",
            "narrator": "ガブリエラ",
            "text": "まあ、接客業は劇場で\nずっとやってたしね。",
            "zh": "嘛，接待工作咱们在剧场\n早就一直在做了嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "900/TALK",
            "narrator": "神楽",
            "text": "本番で緊張しなければ\nこれくらい簡単ですよ。",
            "zh": "只要正式上阵时不紧张，\n这点程度还是很容易的。",
            "narrator_zh": "神乐"
        },
        {
            "location": "901/TALK",
            "narrator": "つばめ",
            "text": "ふふっ、そうだね。",
            "zh": "呵呵，说得也是呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "902/TALK",
            "narrator": "ガブリエラ",
            "text": "それより、お店の制服も\n作るのよね？",
            "zh": "话说回来，店里的制服\n也要做对吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "903/TALK",
            "narrator": "ガブリエラ",
            "text": "もうデザインって\n完成してるの？",
            "zh": "款式已经\n设计好了吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "904/TALK",
            "narrator": "つばめ",
            "text": "あ、うん。\nこんな感じにしてみようと\n思ってるの。",
            "zh": "啊，嗯。\n我想着大概做成\n这样子的。",
            "narrator_zh": "燕"
        },
        {
            "location": "905/TALK",
            "narrator": "ガブリエラ",
            "text": "へー、ロゴの入った\nエプロンと、白いシャツ？",
            "zh": "哦——，印着标志的\n围裙配白衬衫？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "906/TALK",
            "narrator": "つばめ",
            "text": "他のカフェに行って、\n店員さんの格好を\n参考にしてきたんだけど。",
            "zh": "我去别的咖啡馆逛了逛，\n参考了一下店员们的\n穿着打扮。",
            "narrator_zh": "燕"
        },
        {
            "location": "907/TALK",
            "narrator": "つばめ",
            "text": "ちょっと地味だったかな？",
            "zh": "会不会有点太朴素了呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "908/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしは結構好きよ。\nシンプルな方が\nうるさくないし。",
            "zh": "我倒是蛮喜欢的哦。\n简简单单的才显得\n不花哨嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "910/TALK",
            "narrator": "神楽",
            "text": "えーっ、カフェなんだから\n可愛くしましょうよ。",
            "zh": "哎——，好不容易开咖啡馆，\n还是弄可爱一点嘛。",
            "narrator_zh": "神乐"
        },
        {
            "location": "911/TALK",
            "narrator": "神楽",
            "text": "ガブちゃんなんか、\nメイド服の方が\n絶対にかわいいですし。",
            "zh": "尤其是加布，\n穿女仆装的话\n肯定会超可爱的呀。",
            "narrator_zh": "神乐"
        },
        {
            "location": "913/TALK",
            "narrator": "ガブリエラ",
            "text": "メイドカフェするわけじゃ\nないから！",
            "zh": "我们又不是要开\n女仆咖啡厅！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "914/TALK",
            "narrator": "つばめ",
            "text": "でも、メイド服も\n考えはしたんだよ？",
            "zh": "不过，女仆装我也是\n有考虑过的哦？",
            "narrator_zh": "燕"
        },
        {
            "location": "916/TALK",
            "narrator": "ガブリエラ",
            "text": "却下よ、却下！！",
            "zh": "驳回，驳回！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "917/TALK",
            "narrator": "つばめ",
            "text": "だよねぇ…。",
            "zh": "也是啦……。",
            "narrator_zh": "燕"
        },
        {
            "location": "918/TALK",
            "narrator": "つばめ",
            "text": "だから、シンプルだけど\n誰でも着れる制服に\nしようと思ったんだ。",
            "zh": "所以我才想着，\n做一套虽然简洁但\n谁都能穿的制服。",
            "narrator_zh": "燕"
        },
        {
            "location": "920/TALK",
            "narrator": "神楽",
            "text": "冗談抜きでいうなら、\nとっても素敵だと\n思いますよ。",
            "zh": "不开玩笑认真说的话，\n我觉得这套设计\n非常棒哦。",
            "narrator_zh": "神乐"
        },
        {
            "location": "921/TALK",
            "narrator": "神楽",
            "text": "コレなら動きやすいから、\n給仕もしやすいと\n思いますしね。",
            "zh": "这样穿着也方便活动，\n端茶送水也会\n很顺手呢。",
            "narrator_zh": "神乐"
        },
        {
            "location": "922/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしも同感。\n採用でいいんじゃない？",
            "zh": "我也同意。\n直接定下来不就好了吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "923/TALK",
            "narrator": "つばめ",
            "text": "やった！\nじゃああとで真幌さんに\n発注のお願いしてくるよ。",
            "zh": "太好啦！\n那我回头就去请真幌\n帮忙下单订做咯。",
            "narrator_zh": "燕"
        },
        {
            "location": "924/TALK",
            "narrator": "つばめ",
            "text": "…でも、どうしよう？\nこれじゃわたしのお仕事、\nもうほとんどないかも…。",
            "zh": "……不过，怎么办呀？\n这么一来我的活儿，\n好像已经没剩多少了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "925/TALK",
            "narrator": "神楽",
            "text": "つばめさんのお仕事は\n開店してからが\n本番ですよ。",
            "zh": "燕的工作，\n等正式开店以后\n才是重头戏哦。",
            "narrator_zh": "神乐"
        },
        {
            "location": "926/TALK",
            "narrator": "ガブリエラ",
            "text": "そうね。\nどんなお客さんが\n来たとしても…。",
            "zh": "就是啊。\n不管遇到什么样的\n客人上门……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "927/TALK",
            "narrator": "ガブリエラ",
            "text": "臨機応変に対応できる\nように、指示を出さないと\nいけないのよ？",
            "zh": "都得由你来统筹安排，\n好让大家能灵活\n应对才行啊？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "930/TALK",
            "narrator": "つばめ",
            "text": "ううう、\nプレッシャーが…。",
            "zh": "呜呜呜，\n压力好大……。",
            "narrator_zh": "燕"
        },
        {
            "location": "931/TALK",
            "narrator": "神楽",
            "text": "ふふっ、大変だとは\n思いますけど、\n頑張ってくださいね。",
            "zh": "呵呵，虽然确实会\n挺辛苦的，\n请加油哦。",
            "narrator_zh": "神乐"
        },
        {
            "location": "932/TALK",
            "narrator": "神楽",
            "text": "私たちも、できる限り\n協力しますから。",
            "zh": "我们也会尽全力\n协助你的。",
            "narrator_zh": "神乐"
        },
        {
            "location": "934/TALK",
            "narrator": "つばめ",
            "text": "ありがと…。",
            "zh": "谢谢……。",
            "narrator_zh": "燕"
        },
        {
            "location": "935/TALK",
            "narrator": "つばめ",
            "text": "でも、わたしも\n精一杯頑張るね！",
            "zh": "不过，我也会\n拼尽全力加油的！",
            "narrator_zh": "燕"
        },
        {
            "location": "936/TALK",
            "narrator": "ガブリエラ",
            "text": "あはは、つばめが\nそんなに燃えてるのも\n珍しいわね。",
            "zh": "啊哈哈，燕像这样\n干劲十足的样子\n还真是少见呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "937/TALK",
            "narrator": "ガブリエラ",
            "text": "…そういえば、\n食器のことだけど、\nつばめはもう決めたの？",
            "zh": "……说起来，\n餐具的事，\n燕你已经选好了吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "938/TALK",
            "narrator": "つばめ",
            "text": "うーん…まだちょっと\n悩み中かも…。",
            "zh": "嗯……好像还有点\n拿不定主意……。",
            "narrator_zh": "燕"
        },
        {
            "location": "939/TALK",
            "narrator": "ガブリエラ",
            "text": "一つだけってのが\n難しいところよね。",
            "zh": "偏偏只能挑一种，\n这点确实不好选呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "940/TALK",
            "narrator": "神楽",
            "text": "私も悩んでるんです。\n候補が三つあって…。",
            "zh": "我也还在发愁呢。\n手里有三个候选……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "941/TALK",
            "narrator": "神楽",
            "text": "つばめさんは、\nいくつ候補が\nあるんですか？",
            "zh": "燕那边，\n有几个候选\n呀？",
            "narrator_zh": "神乐"
        },
        {
            "location": "942/TALK",
            "narrator": "つばめ",
            "text": "え、えっとぉ…。",
            "zh": "哎、那个呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "943/TALK",
            "narrator": "ガブリエラ",
            "text": "候補も決まってないとか？",
            "zh": "该不会连候选都还没定吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "944/TALK",
            "narrator": "つばめ",
            "text": "…一つ。",
            "zh": "……一个。",
            "narrator_zh": "燕"
        },
        {
            "location": "945/TALK",
            "narrator": "ガブリエラ",
            "text": "は？",
            "zh": "啊？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "946/TALK",
            "narrator": "つばめ",
            "text": "実は、お茶碗とかが\nいいかなぁ、なんて…。",
            "zh": "其实呀，我在想要不要\n选饭碗什么的……",
            "narrator_zh": "燕"
        },
        {
            "location": "948/TALK",
            "narrator": "ガブリエラ",
            "text": "茶碗？\nカフェなのにお茶碗が\n必要なのかしら。",
            "zh": "饭碗？\n好好的咖啡馆\n还用得着饭碗吗。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "950/TALK",
            "narrator": "神楽",
            "text": "ガブちゃん、最近の\nカフェは“和モダン”が\nウケるんですよっ！",
            "zh": "加布，现在的咖啡馆\n正流行“日式摩登风”\n才受欢迎哦！",
            "narrator_zh": "神乐"
        },
        {
            "location": "951/TALK",
            "narrator": "神楽",
            "text": "ほうじ茶や緑茶、\n雑穀スープごはんとかが\n今のトレンドなんです！",
            "zh": "焙茶还有绿茶、\n杂粮汤泡饭之类的\n才是现在的潮流呀！",
            "narrator_zh": "神乐"
        },
        {
            "location": "952/TALK",
            "narrator": "ガブリエラ",
            "text": "ああっ、むぎまるの隣にも\nそんな感じの洒落た\nカフェがあったわね。",
            "zh": "啊啊，麦丸旁边\n好像也有一家那种格调的\n时髦咖啡馆呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "953/TALK",
            "narrator": "神楽",
            "text": "だから、アーヤさんと\n相談して、お茶碗も必要と\nいう結論になりました。",
            "zh": "所以，我和绫水商量\n过后，也得出结论\n觉得饭碗是必需品呢。",
            "narrator_zh": "神乐"
        },
        {
            "location": "954/TALK",
            "narrator": "ガブリエラ",
            "text": "なるほどね、面白そう。\nでもなんでつばめは\nお茶碗がいいわけ？",
            "zh": "原来如此，听起来挺有趣。\n不过为什么燕你偏偏\n想选饭碗啊？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "955/TALK",
            "narrator": "つばめ",
            "text": "えっと、それは……\n…ちょっとだけ\n恥ずかしいんだけど…。",
            "zh": "那个，因为……\n……说起来稍微有点\n不好意思……。",
            "narrator_zh": "燕"
        },
        {
            "location": "956/TALK",
            "narrator": "ガブリエラ",
            "text": "ごめん、\n意味不明なんだけど？",
            "zh": "抱歉，\n完全没懂你在说什么？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "958/TALK",
            "narrator": "神楽",
            "text": "お茶碗になにか恥ずかしく\nなるような思い出でも\nあるんですか？",
            "zh": "莫非关于饭碗，\n有什么说出来会害羞的\n回忆吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "959/TALK",
            "narrator": "つばめ",
            "text": "う～ん、そういうことじゃ\nないんだけど…。",
            "zh": "嗯～，倒也不是\n那样啦……。",
            "narrator_zh": "燕"
        },
        {
            "location": "960/TALK",
            "narrator": "ガブリエラ",
            "text": "…まあ、無理には\n聞かないけど――",
            "zh": "……算了，虽然我不打算\n硬逼着你讲——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "961/TALK",
            "narrator": "ガブリエラ",
            "text": "後悔しないように\n考えなさいよ。",
            "zh": "你自己考虑清楚，\n别事后后悔哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "962/TALK",
            "narrator": "つばめ",
            "text": "…うん、そうするよ。",
            "zh": "……嗯，我会的。",
            "narrator_zh": "燕"
        },
        {
            "location": "963/TALK",
            "narrator": "神楽",
            "text": "…じゃあ、つばめさん。\n私たちはそろそろ\n帰りますね。",
            "zh": "……那，燕。\n我们就先\n回去了哦。",
            "narrator_zh": "神乐"
        },
        {
            "location": "965/TALK",
            "narrator": "つばめ",
            "text": "あ、うん。\nわざわざありがとね。",
            "zh": "啊，嗯。\n谢啦，还特意跑一趟。",
            "narrator_zh": "燕"
        },
        {
            "location": "966/TALK",
            "narrator": "ガブリエラ",
            "text": "制服のデザイン、\nまほに渡すの忘れたら\nダメよ。",
            "zh": "制服的设计稿，\n可别忘了交给\n真幌哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "972/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "974/TALK",
            "narrator": "つばめ",
            "text": "食器、\nどうしようかなぁ…。",
            "zh": "餐具，\n该怎么办才好呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "975/SEL",
            "narrator": "（選択肢）",
            "text": "なにが問題なの？",
            "zh": "有什么问题吗？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "976/ACT",
            "narrator": "",
            "text": "なにが問題なの？",
            "zh": "有什么问题吗？",
            "narrator_zh": ""
        },
        {
            "location": "993/TALK",
            "narrator": "つばめ",
            "text": "問題",
            "zh": "问题",
            "narrator_zh": "燕"
        },
        {
            "location": "994/TALK",
            "narrator": "つばめ",
            "text": "なのかな？(´･ω･｀) ",
            "zh": "算得上是问题吗？(´･ω･｀) ",
            "narrator_zh": "燕"
        },
        {
            "location": "995/TALK",
            "narrator": "つばめ",
            "text": "そぅぃぅのとは",
