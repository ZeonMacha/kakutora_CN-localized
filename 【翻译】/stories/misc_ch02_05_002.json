        },
        {
            "location": "185/TALK",
            "narrator": "アーヤ",
            "text": "ルバーブが売ってないのよ",
            "zh": "大黄没在卖哦",
            "narrator_zh": "绫水"
        },
        {
            "location": "186/TALK",
            "narrator": "アーヤ",
            "text": "高級スーパーでジャムをやっと蜜けたけど",
            "zh": "在高级超市总算找到果酱了，可是",
            "narrator_zh": "绫水"
        },
        {
            "location": "188/TALK",
            "narrator": "アーヤ",
            "text": "高くてびっくりしたわよ(--#)",
            "zh": "贵得吓了一跳(--#)",
            "narrator_zh": "绫水"
        },
        {
            "location": "189/SEL",
            "narrator": "",
            "text": "ルバーブって何",
            "zh": "大黄是什么",
            "narrator_zh": ""
        },
        {
            "location": "190/SEL",
            "narrator": "",
            "text": "なるほど",
            "zh": "原来如此",
            "narrator_zh": ""
        },
        {
            "location": "191/SEL",
            "narrator": "",
            "text": "ジャム買えば",
            "zh": "买果酱就好了",
            "narrator_zh": ""
        },
        {
            "location": "192/TALK",
            "narrator": "アーヤ",
            "text": "なんなのかしらあれ(￣Д￣ )",
            "zh": "那到底是什么啊(￣Д￣ )",
            "narrator_zh": "绫水"
        },
        {
            "location": "193/TALK",
            "narrator": "アーヤ",
            "text": "ほんとはそんなに好きでもないんだけど",
            "zh": "其实也没那么喜欢",
            "narrator_zh": "绫水"
        },
        {
            "location": "194/TALK",
            "narrator": "アーヤ",
            "text": "食べられないてなると食べたくなるから(-ω-;)",
            "zh": "一变成吃不到，就想吃了(-ω-;)",
            "narrator_zh": "绫水"
        },
        {
            "location": "195/TALK",
            "narrator": "アーヤ",
            "text": "困ったわー",
            "zh": "真麻烦",
            "narrator_zh": "绫水"
        },
        {
            "location": "203/ACT",
            "narrator": "",
            "text": "ルバーブって何",
            "zh": "大黄是什么",
            "narrator_zh": ""
        },
        {
            "location": "204/TALK",
            "narrator": "アーヤ",
            "text": "やっぱりそうなの＼(◎o◎)／",
            "zh": "果然是这样＼(◎o◎)／",
            "narrator_zh": "绫水"
        },
        {
            "location": "207/TALK",
            "narrator": "アーヤ",
            "text": "野菜",
            "zh": "蔬菜",
            "narrator_zh": "绫水"
        },
        {
            "location": "210/TALK",
            "narrator": "アーヤ",
            "text": "多分",
            "zh": "大概",
            "narrator_zh": "绫水"
        },
        {
            "location": "211/ACT",
            "narrator": "",
            "text": "なるほど",
            "zh": "原来如此",
            "narrator_zh": ""
        },
        {
            "location": "212/TALK",
            "narrator": "アーヤ",
            "text": "ええと",
            "zh": "那个",
            "narrator_zh": "绫水"
        },
        {
            "location": "214/TALK",
            "narrator": "アーヤ",
            "text": "わかってるのかな(´o｀；？",
            "zh": "你懂了吗(´o｀；？",
            "narrator_zh": "绫水"
        },
        {
            "location": "215/TALK",
            "narrator": "アーヤ",
            "text": "何の話か",
            "zh": "在说什么",
            "narrator_zh": "绫水"
        },
        {
            "location": "216/ACT",
            "narrator": "",
            "text": "ジャム買えば",
            "zh": "买果酱就好了",
            "narrator_zh": ""
        },
        {
            "location": "217/TALK",
            "narrator": "アーヤ",
            "text": "だから高いのよ(--#)",
            "zh": "所以说很贵啊(--#)",
            "narrator_zh": "绫水"
        },
        {
            "location": "218/TALK",
            "narrator": "アーヤ",
            "text": "ありえないくらいに",
            "zh": "贵得不像话",
            "narrator_zh": "绫水"
        },
        {
            "location": "227/TALK",
            "narrator": "アーヤ",
            "text": "ルバーブってね",
            "zh": "大黄呢",
            "narrator_zh": "绫水"
        },
        {
            "location": "228/TALK",
            "narrator": "アーヤ",
            "text": "赤い茎の草っていうか野菜があるのよ",
            "zh": "有一种红茎的草，或者说蔬菜",
            "narrator_zh": "绫水"
        },
        {
            "location": "229/TALK",
            "narrator": "アーヤ",
            "text": "茎のところを甘く似てジャムにしたりパイのフィリングにしたりするの",
            "zh": "把茎的地方甜甜地像一下，做成果酱，或者做成果馅派[?]",
            "narrator_zh": "绫水"
        },
        {
            "location": "230/TALK",
            "narrator": "アーヤ",
            "text": "煮て",
            "zh": "是煮",
            "narrator_zh": "绫水"
        },
        {
            "location": "232/SEL",
            "narrator": "",
            "text": "おいしそうだね",
            "zh": "听起来很好吃",
            "narrator_zh": ""
        },
        {
            "location": "233/SEL",
            "narrator": "",
            "text": "え…何それ…",
            "zh": "诶……那是什么……",
            "narrator_zh": ""
        },
        {
            "location": "234/SEL",
            "narrator": "",
            "text": "外国映画で見た気がする",
            "zh": "好像在外国电影里见过",
            "narrator_zh": ""
        },
        {
            "location": "235/ACT",
            "narrator": "",
            "text": "おいしそうだね",
            "zh": "听起来很好吃",
            "narrator_zh": ""
        },
        {
            "location": "236/TALK",
            "narrator": "アーヤ",
            "text": "まあおいしいかな",
            "zh": "嘛，好吃吧",
            "narrator_zh": "绫水"
        },
        {
            "location": "237/TALK",
            "narrator": "アーヤ",
            "text": "甘いの好きな人だったら結構好きかもね",
            "zh": "喜欢甜的人也许挺喜欢",
            "narrator_zh": "绫水"
        },
        {
            "location": "238/ACT",
            "narrator": "",
            "text": "え…何それ…",
            "zh": "诶……那是什么……",
            "narrator_zh": ""
        },
        {
            "location": "239/TALK",
            "narrator": "アーヤ",
            "text": "工ｴｴｪｪ(´д｀)ｪｪｴｴ工",
