        {
            "location": "242/ACT",
            "narrator": "",
            "text": "外国映画で見た気がする",
            "zh": "好像在外国电影里见过",
            "narrator_zh": ""
        },
        {
            "location": "252/TALK",
            "narrator": "アーヤ",
            "text": "あっ、そうね",
            "zh": "啊，对哦",
            "narrator_zh": "绫水"
        },
        {
            "location": "253/TALK",
            "narrator": "アーヤ",
            "text": "アメリカだと家庭料理でルバーブのパイ作るみたいだし",
            "zh": "在美国，家庭料理好像会做大黄派",
            "narrator_zh": "绫水"
        },
        {
            "location": "254/TALK",
            "narrator": "アーヤ",
            "text": "ガブも知ってた",
