{
    "dir": "chap00/daydra/spev_notice_cd_01_06.js",
    "type": "",
    "info": {
        "story_id": "91056",
        "cid": "",
        "title": "006 アフターストーリー",
        "sub_title": "恋ヶ崎みやびの思い出",
        "title_zh": "006 后日谈",
        "sub_title_zh": "恋之崎雅的回忆"
    },
    "entry": [
        {
            "location": "1508/DIALOG",
            "narrator": "",
            "text": "<color=green>某月某日　4:43 PM</color>\nとある平日の放課後、神楽坂トライナリーホワイエにて。",
            "zh": "<color=green>某月某日　4:43 PM</color>\n某个工作日的放学后，在神乐坂三重奏门厅。",
            "narrator_zh": ""
        },
        {
            "location": "1509/TALK",
            "narrator": "真幌",
            "text": "…美味い。",
            "zh": "……真好喝。",
            "narrator_zh": "真幌"
        },
        {
            "location": "1512/TALK",
            "narrator": "アーヤ",
            "text": "美味しいわ、みやび。\nまるでお店で飲む\nコーヒーみたい！",
            "zh": "真好喝，雅。\n简直跟店里卖的\n咖啡一样！",
            "narrator_zh": "绫水"
        },
        {
            "location": "1514/TALK",
            "narrator": "みやび",
            "text": "そりゃ、店で出すための\nコーヒーやきね。",
            "zh": "那当然了，毕竟是要\n在店里端给客人的咖啡嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "1515/TALK",
            "narrator": "みやび",
            "text": "ある程度美味くないと\nクレームの原因になるき。",
            "zh": "要是不够好喝的话，\n可是会遭客人投诉的啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "1516/TALK",
            "narrator": "真幌",
            "text": "しかし、今まで本格的な\nコーヒーを煎れたことは\nないんだろう？",
            "zh": "不过，你以前从来没\n正经冲泡过\n咖啡吧？",
            "narrator_zh": "真幌"
        },
        {
            "location": "1517/TALK",
            "narrator": "みやび",
            "text": "まほさんの入れてくれた\nコーヒーメーカーの\nおかげです。",
            "zh": "多亏了真幌\n帮忙添置的\n咖啡机。",
            "narrator_zh": "雅"
        },
        {
            "location": "1518/TALK",
            "narrator": "みやび",
            "text": "スイッチ一つで\nほぼほぼ完成やき。",
            "zh": "按一下开关\n差不多就能做好啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "1519/TALK",
            "narrator": "真幌",
            "text": "…まあ、コーヒーだけに\n限ればそうかもしれんな。",
            "zh": "……嘛，单说咖啡的话\n或许确实如此。",
            "narrator_zh": "真幌"
        },
        {
            "location": "1522/TALK",
            "narrator": "真幌",
            "text": "だが…このラテアートに\n関しては違うだろ？",
            "zh": "不过……这杯上的拉花\n可就不一样了吧？",
            "narrator_zh": "真幌"
        },
        {
            "location": "1525/TALK",
            "narrator": "アーヤ",
            "text": "ビックリするくらい\n上手いんだけど…、\nいつ練習したの？",
            "zh": "手艺厉害到让人吃惊啊……\n这画得也太棒了吧，\n你什么时候练的？",
            "narrator_zh": "绫水"
        },
        {
            "location": "1526/TALK",
            "narrator": "みやび",
            "text": "マシンが届いた日やね。\nこれくらいのウリは\n必要や思うてな。",
            "zh": "机器送到的那天咯。\n我觉着这种程度的卖点\n还是得有嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "1529/TALK",
            "narrator": "真幌",
            "text": "おい、アーヤ。\nラテアートに関しては\n詳しくないんだが…。",
            "zh": "喂，绫水。\n虽然我对拉花\n不太懂……",
            "narrator_zh": "真幌"
        },
        {
            "location": "1530/TALK",
            "narrator": "真幌",
            "text": "そんなちょっとの練習で\nどうにかなるモノなのか？",
            "zh": "就这么点练习时间，\n真能弄成这样吗？",
            "narrator_zh": "真幌"
        },
        {
            "location": "1533/TALK",
            "narrator": "アーヤ",
            "text": "無理だと思います。\n私も練習したこと\nあるんですけど…。",
            "zh": "我觉得不可能。\n其实我自己也\n试着练过……",
            "narrator_zh": "绫水"
        },
        {
            "location": "1535/TALK",
            "narrator": "アーヤ",
            "text": "全然思い通りの絵に\nなりませんでした。",
            "zh": "结果完全画不出\n心里想的图案。",
            "narrator_zh": "绫水"
        },
        {
            "location": "1536/TALK",
            "narrator": "みやび",
            "text": "コツがいるきね。\nそれを掴まんことには\n無理ゲーやろ。",
            "zh": "那是要诀窍的啵。\n摸不着门道的话，\n那就是无解游戏咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "1538/TALK",
            "narrator": "真幌",
            "text": "元々、手の込んだ\n和食を作ったりも\nしていたからな。",
            "zh": "也是，她原本就会做\n很讲究功夫的\n和食啊。",
            "narrator_zh": "真幌"
        },
        {
            "location": "1539/TALK",
            "narrator": "真幌",
            "text": "手が器用なのもそうだが、\nセンスもあったのかも\nしれんな。",
            "zh": "手巧固然是一方面，\n说不定还挺有\n天赋的呢。",
            "narrator_zh": "真幌"
        },
        {
            "location": "1541/TALK",
            "narrator": "みやび",
            "text": "けんど、ラテアートは\n一日十杯が限界ちや。",
            "zh": "但是，拉花这玩意\n一天十杯就是极限滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "1542/TALK",
            "narrator": "アーヤ",
            "text": "やっぱり、大変よね？",
            "zh": "果然，很费劲吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "1543/TALK",
            "narrator": "みやび",
            "text": "それもあるけんど、\nぶっちゃけ思うてたより\n何倍もめんどいちや。",
            "zh": "那是一方面，但是\n说实话比我想象中\n麻烦好几倍滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "1545/TALK",
            "narrator": "アーヤ",
            "text": "あのね…。",
            "zh": "我说你啊……",
            "narrator_zh": "绫水"
        },
        {
            "location": "1547/TALK",
            "narrator": "真幌",
            "text": "とりあえずコーヒーに\nついての心配はなさそう\nだな。",
            "zh": "总之咖啡方面\n看来是不必\n担心了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "1549/TALK",
            "narrator": "アーヤ",
            "text": "そうですね。",
            "zh": "是的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "1551/TALK",
            "narrator": "アーヤ",
            "text": "じゃあ、次は紅茶を\nお願いできる？\nミルクティーがいいわ。",
            "zh": "那接下来能请你就着\n帮我泡杯红茶吗？\n我想要奶茶。",
            "narrator_zh": "绫水"
        },
        {
            "location": "1553/TALK",
            "narrator": "みやび",
            "text": "あいあい。\nまほさんは？",
            "zh": "得咧。\n真幌要来一杯咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "1554/TALK",
            "narrator": "真幌",
            "text": "いや、私はいい。\n片付けねばならない\n仕事があるんでな。",
            "zh": "不用，我就算了。\n还有非处理不可的\n工作在呢。",
            "narrator_zh": "真幌"
        },
        {
            "location": "1555/TALK",
            "narrator": "真幌",
            "text": "続きは二人で\nやっててくれ。",
            "zh": "剩下的就你们俩\n继续忙吧。",
            "narrator_zh": "真幌"
        },
        {
            "location": "1567/TALK",
            "narrator": "みやび",
            "text": "…ほれ、アーヤ。\nミルクティー。",
            "zh": "……喏，绫水。\n奶茶。",
            "narrator_zh": "雅"
        },
        {
            "location": "1568/TALK",
            "narrator": "アーヤ",
            "text": "ありがとう…。\nちょうど良かったわ。",
            "zh": "谢谢……\n正好合适。",
            "narrator_zh": "绫水"
        },
        {
            "location": "1569/TALK",
            "narrator": "みやび",
            "text": "？　なにがや？",
            "zh": "？　说驷马正好？",
            "narrator_zh": "雅"
        },
        {
            "location": "1570/TALK",
            "narrator": "アーヤ",
            "text": "二人きりになれて…。\n大切な話があるの。",
            "zh": "正好就剩我们俩……\n我有件重要的事想聊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "1571/TALK",
            "narrator": "みやび",
            "text": "…まあ、なんとなく\n聞かんでもわかる\nけんど…。",
            "zh": "……嘛，不用问\n我也大概猜得到\n就是了……",
            "narrator_zh": "雅"
        },
        {
            "location": "1572/TALK",
            "narrator": "みやび",
            "text": "卯月のことやね？",
            "zh": "是卯月的事咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "1573/TALK",
            "narrator": "アーヤ",
            "text": "ええ…みやびから見て、\n今の卯月はどう見える？",
            "zh": "嗯……在雅看来，\n现在的卯月怎么样？",
            "narrator_zh": "绫水"
        },
        {
            "location": "1575/TALK",
            "narrator": "みやび",
            "text": "うちらの仕切り役、\nちゃんとこなしちゅうと\n思うがよ。",
            "zh": "我们的负责人一职，\n我觉得她扛得\n蛮像样的咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "1576/TALK",
            "narrator": "アーヤ",
            "text": "意見が合うわね。\n私も凄く頑張ってるって\n思ってたわ。",
            "zh": "真是英雄所见略同。\n我也觉得她\n一直都很努力。",
            "narrator_zh": "绫水"
        },
        {
            "location": "1577/TALK",
            "narrator": "みやび",
            "text": "…色々あったき、\n簡単に元通りになるとは\n思わんけんど…。",
            "zh": "……毕竟出过那么多事，\n虽然我也没指望能轻松\n变回原样……",
            "narrator_zh": "雅"
        },
        {
            "location": "1578/TALK",
            "narrator": "みやび",
            "text": "アーヤが無理矢理仕切り役\n任せて、関わらんといかん\nようにしてくれたき。",
            "zh": "绫水硬是把负责人\n交给了她，逼得她\n不得不跟大家打交道啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "1579/TALK",
            "narrator": "みやび",
            "text": "好調な感じに進んどると\n思うがよ。",
            "zh": "我看现在进展得\n蛮顺当的咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "1580/TALK",
            "narrator": "アーヤ",
            "text": "ふふっ…みやびだって、\nそうじゃない。",
            "zh": "呵呵……其实雅自己，\n不也一样吗。",
            "narrator_zh": "绫水"
        },
        {
            "location": "1581/TALK",
            "narrator": "みやび",
            "text": "…先輩である前に、\n卯月の仲間やきね。",
            "zh": "……在作为前辈之前，\n我首先是卯月的同伴嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "1582/TALK",
            "narrator": "みやび",
            "text": "今年の夏……。\n卯月がうちらの前から\n去っていった。",
            "zh": "今年夏天……\n卯月从我们面前\n离开了。",
            "narrator_zh": "雅"
        },
        {
            "location": "1583/TALK",
            "narrator": "みやび",
            "text": "あの時うちは思ったんよ。\nもっと卯月にできることが\nあったんやないかって。",
            "zh": "那时候我就在想咯。\n是不是本来还能为卯月\n多做点什么呢。",
            "narrator_zh": "雅"
        },
        {
            "location": "1584/TALK",
            "narrator": "みやび",
            "text": "やき、戻ってきた今――",
            "zh": "所以，趁她回来的现在——",
            "narrator_zh": "雅"
        },
        {
            "location": "1585/TALK",
            "narrator": "みやび",
            "text": "前よりもっと仲良くなれる\nように、迎え入れたいと\n思うてるちや。",
            "zh": "我想好好迎她回来，\n变得比以前还要\n要好滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "1586/TALK",
            "narrator": "アーヤ",
            "text": "…できると思う？\n卯月の方から距離を\n開けるかもしれないのに。",
            "zh": "……你觉得能行吗？\n搞不好卯月那边会主动\n拉开距离哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "1587/TALK",
            "narrator": "みやび",
            "text": "そんなん、簡単やき。",
            "zh": "那种事，简单得很啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "1588/TALK",
            "narrator": "みやび",
            "text": "何度でも、\n無理矢理にでも\n引っ張り出すがよ。",
            "zh": "不管多少次，\n就算是硬拽\n也要把她拉出来咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "1590/TALK",
            "narrator": "みやび",
            "text": "そんで、関わらんと\nいかんような状況に\n持って行くぞね。",
            "zh": "然后，把她带到\n不打交道也不行的\n局面里去咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "1591/TALK",
            "narrator": "アーヤ",
            "text": "ふふっ…やっぱり、\n強引に行くしかないわね。",
            "zh": "呵呵……果然，\n只能来硬的了呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "1592/TALK",
            "narrator": "みやび",
            "text": "多少強引でも、ちゃんと\nコミュニケーション\nとらんとね。",
            "zh": "就算稍微强硬点，\n也得好好\n沟通才行啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "1593/TALK",
            "narrator": "みやび",
            "text": "ドンドン距離が開きゆう。",
            "zh": "不然距离只会越拉越远咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "1594/TALK",
            "narrator": "みやび",
            "text": "ところで…アーヤ、\n紅茶冷めゆうよ？",
            "zh": "话说回来……绫水，\n红茶要凉咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "1596/TALK",
            "narrator": "アーヤ",
            "text": "え？　あっ！\n忘れてた！",
            "zh": "诶？　啊！\n我给忘了！",
            "narrator_zh": "绫水"
        },
        {
            "location": "1609/TALK",
            "narrator": "みやび",
            "text": "う～ん…。",
            "zh": "唔～……",
            "narrator_zh": "雅"
        },
        {
            "location": "1613/TALK",
            "narrator": "ガブリエラ",
            "text": "…あら？\nみやび、こんな時間まで\n練習してるの？",
            "zh": "……哎呀？\n雅，你怎么练到\n这么晚还在练啊？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1615/TALK",
            "narrator": "みやび",
            "text": "ん？　うわっ、マジか。\nいつの間にか真っ暗や！",
            "zh": "嗯？　唔哇，真的假的。\n不知不觉天都全黑了！",
            "narrator_zh": "雅"
        },
        {
            "location": "1616/TALK",
            "narrator": "ガブリエラ",
            "text": "随分集中してたみたいね。\nそんなに楽しいの？",
            "zh": "看来你刚才挺专注的嘛。\n有那么好玩吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1618/TALK",
            "narrator": "みやび",
            "text": "ん～、楽しいとは\nちくっと違うような…。",
            "zh": "嗯～，跟好玩\n倒稍微不太一样……",
            "narrator_zh": "雅"
        },
        {
            "location": "1619/TALK",
            "narrator": "ガブリエラ",
            "text": "面倒くさがりなくせに、\n変なとこ凝り性だものね、\nみやびって…。",
            "zh": "明明平时怕麻烦得要命，\n偏偏在奇怪的地方较真，\n这就是雅啊……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1620/TALK",
            "narrator": "ガブリエラ",
            "text": "ま、せっかくだし\nあたしにもなにか\n一杯煎れてもらえる？",
            "zh": "嘛，来都来了，\n能顺便也给我\n冲一杯什么吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1622/TALK",
            "narrator": "みやび",
            "text": "お客さん、もう閉店ぞね。",
            "zh": "客人，已经打烊了咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "1623/TALK",
            "narrator": "ガブリエラ",
            "text": "ラテアートできるって\nアーヤから聞いたわ。",
            "zh": "我听绫水说\n你会拉花了哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1625/TALK",
            "narrator": "ガブリエラ",
            "text": "絵柄はウサギでお願い。\nあと、うんと甘くしてね。",
            "zh": "图案就拜托画只兔子吧。\n还有，要加好多糖哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1626/TALK",
            "narrator": "みやび",
            "text": "人の話を聞かん\nお客さんやなぁ…。",
            "zh": "真是个不听人说话的\n客人呐……",
            "narrator_zh": "雅"
        },
        {
            "location": "1635/TALK",
            "narrator": "ガブリエラ",
            "text": "美味しかったぁ。\nみやび、ごちそうさま。",
            "zh": "好好喝啊——。\n雅，谢谢款待。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1637/TALK",
            "narrator": "みやび",
            "text": "おそまつさまぞね。",
            "zh": "招待不周咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "1638/TALK",
            "narrator": "ガブリエラ",
            "text": "飲み物担当を\nみやびがやったのは\n正解だったわね。",
            "zh": "让雅来负责\n饮品这一块，\n果然是对的呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1639/TALK",
            "narrator": "みやび",
            "text": "そう言うてもらえると、\nうちも安心するぞね。",
            "zh": "听你这么讲，\n我也放心了咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "1640/TALK",
            "narrator": "ガブリエラ",
            "text": "さてと、それじゃあ\nそろそろ――",
            "zh": "好啦，那我\n差不多该——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1641/TALK",
            "narrator": "ガブリエラ",
            "text": "あっ、そうだ。\nみやびってまだ食器\n決めてないでしょ？",
            "zh": "啊，对了。\n雅你是不是还没决定\n选什么餐具呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1642/TALK",
            "narrator": "ガブリエラ",
            "text": "そろそろ決めないと、\n勝手に決められちゃう\nわよ？",
            "zh": "再不赶紧定的话，\n可就要被大家\n替你擅自定下了哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1643/TALK",
            "narrator": "みやび",
            "text": "うちはそれでえいよ。\nもしくは、みんなの\n残りもんとかでな。",
            "zh": "我那样就得咯。\n或者用大家挑剩的\n也行嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "1644/TALK",
            "narrator": "ガブリエラ",
            "text": "そんなの勿体ないわ。\nせっかく自分の作った\nロゴが入る食器なのに。",
            "zh": "那样多浪费呀。\n好不容易这批餐具上\n都会印你自己做的logo呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1645/TALK",
            "narrator": "ガブリエラ",
            "text": "特別な一枚にしたいと\n思わないわけ？",
            "zh": "难道你不想挑一件\n特别一点的吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1646/TALK",
            "narrator": "みやび",
            "text": "…特別な一枚、か。",
            "zh": "……特别的一件，吗。",
            "narrator_zh": "雅"
        },
        {
            "location": "1648/TALK",
            "narrator": "みやび",
            "text": "ふーむ…そうやなぁ…。",
            "zh": "唔——……让我想想呐……",
            "narrator_zh": "雅"
        },
        {
            "location": "1649/TALK",
            "narrator": "みやび",
            "text": "…なら、\nうちは小鉢にするぞね。",
            "zh": "……那，\n我就选小钵咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "1650/TALK",
            "narrator": "ガブリエラ",
            "text": "え？\nそんな脇役みたいなので\nいいの！？",
            "zh": "诶？\n选那种跟配角似的餐具\n真的好吗！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1651/TALK",
            "narrator": "ガブリエラ",
            "text": "もっと大皿とか\nスープボウルとか\n色々あると思うのに。",
            "zh": "明明还有大盘子、\n汤碗之类的\n好多选择呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1652/TALK",
            "narrator": "みやび",
            "text": "小鉢は和食に於いては\n重要なものやよ？",
            "zh": "小钵在和食里头\n可是很重要的器皿哦？",
            "narrator_zh": "雅"
        },
        {
            "location": "1653/TALK",
            "narrator": "みやび",
            "text": "懐石でも一番最初に\n目に入る器やき、\nその店の品性が問われる。",
            "zh": "连怀石料理里最先\n映入眼帘的也是这个，\n最考验一间店的格调。",
            "narrator_zh": "雅"
        },
        {
            "location": "1654/TALK",
            "narrator": "みやび",
            "text": "アーヤも今回は、和風の\nアペタイザーを頑張って\n考えちゅうみたいやき――",
            "zh": "我看绫水这次也在\n努力构思和风的\n前菜——",
            "narrator_zh": "雅"
        },
        {
            "location": "1655/TALK",
            "narrator": "みやび",
            "text": "殆どのお客人に\n出されるものに\nなると思うちや。",
            "zh": "我想差不多所有客人\n面前的餐桌上\n都会摆上它滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "1656/TALK",
            "narrator": "ガブリエラ",
            "text": "なるほどね。みやびに\nとって思い入れあるなら、\nいいんじゃないかしら。",
            "zh": "原来如此。既然雅\n对它有感情的话，\n那不也挺好的嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1657/TALK",
            "narrator": "ガブリエラ",
            "text": "それじゃ、あたしは\n先に帰るわね。",
            "zh": "那我就\n先回去了哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1658/TALK",
            "narrator": "みやび",
            "text": "ん、おつかれー。",
            "zh": "嗯，辛苦——",
            "narrator_zh": "雅"
        },
        {
            "location": "1661/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………",
            "narrator_zh": "雅"
        },
        {
            "location": "1662/TALK",
            "narrator": "みやび",
            "text": "ふぅ…片付けるの、\n手伝うてもらえば\nよかったやろか…？",
            "zh": "呼……收拾这摊子，\n早知道叫她搭把手\n是不是更好些……？",
            "narrator_zh": "雅"
        },
        {
            "location": "1663/SEL",
            "narrator": "（選択肢）",
            "text": "小鉢にした理由、本気？",
            "zh": "选小钵的理由，你是认真的？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "1664/ACT",
            "narrator": "",
            "text": "小鉢にした理由、本気？",
            "zh": "选小钵的理由，你是认真的？",
            "narrator_zh": ""
        },
        {
            "location": "1681/TALK",
            "narrator": "みやび",
            "text": "本気と思うたか？",
            "zh": "你以为我是认真的咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "1682/TALK",
            "narrator": "みやび",
            "text": "もち冗談",
            "zh": "当然是开玩笑的",
            "narrator_zh": "雅"
        },
        {
            "location": "1683/TALK",
            "narrator": "みやび",
            "text": "当然である",
            "zh": "理所当然",
            "narrator_zh": "雅"
        },
        {
            "location": "1684/TALK",
            "narrator": "みやび",
            "text": "コレで満足か？",
            "zh": "这下满意了咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "1687/SEL",
            "narrator": "みやび",
            "text": "本当の理由は？",
            "zh": "真正的理由是？",
            "narrator_zh": "雅"
        },
        {
            "location": "1688/SEL",
            "narrator": "（選択肢）",
            "text": "うん、ありがとう",
            "zh": "嗯，谢谢",
            "narrator_zh": "（选项）"
        },
        {
            "location": "1689/ACT",
            "narrator": "",
            "text": "本当の理由は？",
            "zh": "真正的理由是？",
            "narrator_zh": ""
        },
        {
            "location": "1690/TALK",
            "narrator": "みやび",
            "text": "乙女のトップシークレットである",
            "zh": "乃是少女的最高机密",
            "narrator_zh": "雅"
        },
        {
            "location": "1691/TALK",
            "narrator": "みやび",
            "text": "可愛く言うなら",
            "zh": "硬要卖个萌来讲就是",
            "narrator_zh": "雅"
        },
        {
            "location": "1692/TALK",
            "narrator": "みやび",
            "text": "ナイショ",
            "zh": "秘～密",
            "narrator_zh": "雅"
        },
        {
            "location": "1693/TALK",
            "narrator": "みやび",
            "text": "ＯＫ？",
            "zh": "OK？",
            "narrator_zh": "雅"
        },
        {
            "location": "1696/SEL",
            "narrator": "（選択肢）",
            "text": "教えてほしい",
            "zh": "想听你讲嘛",
            "narrator_zh": "（选项）"
        },
        {
            "location": "1697/SEL",
            "narrator": "（選択肢）",
            "text": "ＯＫ！",
            "zh": "OK！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "1698/ACT",
            "narrator": "",
            "text": "教えてほしい",
            "zh": "想听你讲嘛",
            "narrator_zh": ""
        },
        {
            "location": "1699/TALK",
            "narrator": "みやび",
            "text": "大胆なヤツめ",
            "zh": "好大胆的家伙",
            "narrator_zh": "雅"
        },
        {
            "location": "1700/TALK",
            "narrator": "みやび",
            "text": "よろしい",
            "zh": "准了",
            "narrator_zh": "雅"
        },
        {
            "location": "1701/TALK",
            "narrator": "みやび",
            "text": "ではしかと聞くがよい",
            "zh": "那就洗耳恭听吧",
            "narrator_zh": "雅"
        },
        {
            "location": "1704/TALK",
            "narrator": "みやび",
            "text": "小鉢には",
            "zh": "对于小钵",
            "narrator_zh": "雅"
        },
        {
            "location": "1705/TALK",
            "narrator": "みやび",
            "text": "思い出があるのだ",
            "zh": "我可是有着回忆的",
            "narrator_zh": "雅"
        },
        {
            "location": "1706/TALK",
            "narrator": "みやび",
            "text": "以上！",
            "zh": "完毕！",
            "narrator_zh": "雅"
        },
        {
            "location": "1708/SEL",
            "narrator": "（選択肢）",
            "text": "思い出とは？",
            "zh": "是什么回忆？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "1709/SEL",
            "narrator": "（選択肢）",
            "text": "そうだったのか、ありがとう",
            "zh": "原来如此，谢谢",
            "narrator_zh": "（选项）"
        },
        {
            "location": "1710/ACT",
            "narrator": "",
            "text": "思い出とは？",
            "zh": "是什么回忆？",
            "narrator_zh": ""
        },
        {
            "location": "1712/TALK",
            "narrator": "みやび",
            "text": "随分と食いつくな？",
            "zh": "还真是咬着不放呢？",
            "narrator_zh": "雅"
        },
        {
            "location": "1713/TALK",
            "narrator": "みやび",
            "text": "まあよい",
            "zh": "罢了",
            "narrator_zh": "雅"
        },
        {
            "location": "1714/TALK",
            "narrator": "みやび",
            "text": "ずっと昔の話だが",
            "zh": "虽是很久以前的事了",
            "narrator_zh": "雅"
        },
        {
            "location": "1715/TALK",
            "narrator": "みやび",
            "text": "親戚からもらったのだ",
            "zh": "是亲戚送给我的",
            "narrator_zh": "雅"
        },
        {
            "location": "1716/TALK",
            "narrator": "みやび",
            "text": "綺麗な小鉢を",
            "zh": "一只漂亮的小钵",
            "narrator_zh": "雅"
        },
        {
            "location": "1717/TALK",
            "narrator": "みやび",
            "text": "もちろん高級品",
            "zh": "当然是高级货",
            "narrator_zh": "雅"
        },
        {
            "location": "1718/TALK",
            "narrator": "みやび",
            "text": "うちのお気に入りだったが",
            "zh": "曾是我的心头好",
            "narrator_zh": "雅"
        },
        {
            "location": "1719/TALK",
            "narrator": "みやび",
            "text": "素敵すぎた",
            "zh": "因为太好看了",
            "narrator_zh": "雅"
        },
        {
            "location": "1720/TALK",
            "narrator": "みやび",
            "text": "その結果",
            "zh": "结果就是",
            "narrator_zh": "雅"
        },
        {
            "location": "1721/TALK",
            "narrator": "みやび",
            "text": "使わず行方不明となったわけなのだ",
            "zh": "一直舍不得用然后就下落不明了",
            "narrator_zh": "雅"
        },
        {
            "location": "1724/TALK",
            "narrator": "みやび",
            "text": "そのことを思い出して",
            "zh": "于是我想起这件事",
            "narrator_zh": "雅"
        },
        {
            "location": "1725/TALK",
            "narrator": "みやび",
            "text": "小鉢にしようと思ったのだ",
            "zh": "便决定选小钵了",
            "narrator_zh": "雅"
        },
        {
            "location": "1726/TALK",
            "narrator": "みやび",
            "text": "理解したか？",
            "zh": "理解了吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "1728/SEL",
            "narrator": "（選択肢）",
            "text": "可愛い思い出だね",
            "zh": "好可爱的回忆呀",
            "narrator_zh": "（选项）"
        },
        {
            "location": "1729/ACT",
            "narrator": "",
            "text": "可愛い思い出だね",
            "zh": "好可爱的回忆呀",
            "narrator_zh": ""
        },
        {
            "location": "1731/TALK",
            "narrator": "みやび",
            "text": "うっさい",
            "zh": "吵死了",
            "narrator_zh": "雅"
        },
        {
            "location": "1733/TALK",
            "narrator": "みやび",
            "text": "みんなには",
            "zh": "不许告诉",
            "narrator_zh": "雅"
        },
        {
            "location": "1734/TALK",
            "narrator": "みやび",
            "text": "言うなよ？",
            "zh": "大家哦？",
            "narrator_zh": "雅"
        },
        {
            "location": "1735/TALK",
            "narrator": "みやび",
            "text": "小っ恥ずかしくて堪らん",
            "zh": "怪不好意思得让人受不了",
            "narrator_zh": "雅"
        },
        {
            "location": "1737/SEL",
            "narrator": "（選択肢）",
            "text": "二人だけの秘密ね",
            "zh": "就当是我们俩的秘密吧",
            "narrator_zh": "（选项）"
        },
        {
            "location": "1738/ACT",
            "narrator": "",
            "text": "二人だけの秘密ね",
            "zh": "就当是我们俩的秘密吧",
            "narrator_zh": ""
        },
        {
            "location": "1740/TALK",
            "narrator": "みやび",
            "text": "その言い方も",
            "zh": "那种说法倒也",
            "narrator_zh": "雅"
        },
        {
            "location": "1742/TALK",
            "narrator": "みやび",
            "text": "いや",
            "zh": "不",
            "narrator_zh": "雅"
        },
        {
            "location": "1743/TALK",
            "narrator": "みやび",
            "text": "悪くない",
            "zh": "还不赖",
            "narrator_zh": "雅"
        },
        {
            "location": "1745/TALK",
            "narrator": "みやび",
            "text": "なんてな",
            "zh": "开玩笑的啦",
            "narrator_zh": "雅"
        },
        {
            "location": "1746/TALK",
            "narrator": "みやび",
            "text": "さらば！",
            "zh": "告辞！",
            "narrator_zh": "雅"
        },
        {
            "location": "1758/TALK",
            "narrator": "みやび",
            "text": "…けんどまあ、今回\n目指すんはモダン和やし、\n似ても似つかんけんどな。",
            "zh": "……不过嘛，这次\n要搞的是现代和风，\n跟那个也八竿子打不着就是了。",
            "narrator_zh": "雅"
        },
        {
            "location": "1759/TALK",
            "narrator": "みやび",
            "text": "…まあ、\n大事なのは想いやきね。",
            "zh": "……嘛，\n重要的还是心意啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "1760/ACT",
            "narrator": "",
            "text": "そうだったのか、ありがとう",
            "zh": "原来如此，谢谢",
            "narrator_zh": ""
        },
        {
            "location": "1763/ACT",
            "narrator": "",
            "text": "ＯＫ！",
            "zh": "OK！",
            "narrator_zh": ""
        },
        {
            "location": "1766/ACT",
            "narrator": "",
            "text": "うん、ありがとう",
            "zh": "嗯，谢谢",
            "narrator_zh": ""
        },
        {
            "location": "1768/TALK",
            "narrator": "みやび",
            "text": "マジか",
            "zh": "真的假的",
            "narrator_zh": "雅"
        },
        {
            "location": "1769/TALK",
            "narrator": "みやび",
            "text": "もっと突っ込んでくるかと",
            "zh": "我还以为你会追问到底",
            "narrator_zh": "雅"
        },
        {
            "location": "1770/TALK",
            "narrator": "みやび",
            "text": "無駄に構えてしまった",
            "zh": "害我白白摆好架势了",
            "narrator_zh": "雅"
        },
        {
            "location": "1771/TALK",
            "narrator": "みやび",
            "text": "恥ずいではないか！",
            "zh": "羞死个人了不是吗！",
            "narrator_zh": "雅"
        },
        {
            "location": "1772/TALK",
            "narrator": "みやび",
            "text": "さらば！",
            "zh": "告辞！",
            "narrator_zh": "雅"
        },
        {
            "location": "1783/TALK",
            "narrator": "みやび",
            "text": "…テンション下がる。",
            "zh": "……情绪低落。",
            "narrator_zh": "雅"
        },
        {
            "location": "1784/TALK",
            "narrator": "みやび",
            "text": "中途半端に食いつくなら\n聞かんでほしいがよ。",
            "zh": "追问到一半就不问了，\n那还不如别问咯。",
            "narrator_zh": "雅"
        }
    ]
}
