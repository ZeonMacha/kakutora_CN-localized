{
    "dir": "chap00/daydra/spev_ch04_004.js",
    "type": "",
    "info": {
        "story_id": "4004",
        "cid": "",
        "title": "スペシャルエピソード",
        "sub_title": "カーテンの向こうから",
        "title_zh": "特别篇",
        "sub_title_zh": "从窗帘的那一边"
    },
    "entry": [
        {
            "location": "15/TALK",
            "narrator": "透明みやび",
            "text": "うーむ…。",
            "zh": "唔嗯……",
            "narrator_zh": "透明雅"
        },
        {
            "location": "16/TALK",
            "narrator": "透明みやび",
            "text": "何とも変な感じやけんど、\nこれ、大丈夫なんやろか？",
            "zh": "总觉得怪怪的，但是这样\n穿出去真的没问题咩？",
            "narrator_zh": "透明雅"
        },
        {
            "location": "17/TALK",
            "narrator": "透明みやび",
            "text": "相棒、言われた通り\n着てみたけんど、\nやはり脱いでえい？",
            "zh": "搭档，照你说的\n穿上了，但是\n还是脱掉算了得咩？",
            "narrator_zh": "透明雅"
        },
        {
            "location": "18/SEL",
            "narrator": "（選択肢）",
            "text": "見せてくれた後でね",
            "zh": "等给我看完了再脱嘛",
            "narrator_zh": "（选项）"
        },
        {
            "location": "19/ACT",
            "narrator": "",
            "text": "見せてくれた後でね",
            "zh": "等给我看完了再脱嘛",
            "narrator_zh": ""
        },
        {
            "location": "22/TALK",
            "narrator": "透明みやび",
            "text": "何という鬼畜な所業。\n相棒のそういうところ、\n嫌いではないけんど…。",
            "zh": "真是鬼畜的恶行。\n搭档的这一点，\n我倒也不是讨厌就是了……",
            "narrator_zh": "透明雅"
        },
        {
            "location": "23/TALK",
            "narrator": "透明みやび",
            "text": "目が潰れても、\n慰謝料は払わんぞ？",
            "zh": "眼睛看瞎了，\n我可不赔精神损失费哦？",
            "narrator_zh": "透明雅"
        },
        {
            "location": "36/TALK",
            "narrator": "透明みやび",
            "text": "はぁ…どうや？\nこれで満足か？",
            "zh": "唉……怎么样？\n这下满足了咩？",
            "narrator_zh": "透明雅"
        },
        {
            "location": "37/SEL",
            "narrator": "（選択肢）",
            "text": "和服以外のみやび、レアだ！",
            "zh": "不穿和服的雅，好稀罕！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "38/ACT",
            "narrator": "",
            "text": "和服以外のみやび、レアだ！",
            "zh": "不穿和服的雅，好稀罕！",
            "narrator_zh": ""
        },
        {
            "location": "41/TALK",
            "narrator": "透明みやび",
            "text": "相棒が見たい言うたき、\n仕方なく着てやっちょるん\nやろうが。",
            "zh": "还不是搭档说想看，\n我才勉强穿给你看\n的嘛。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "43/TALK",
            "narrator": "透明みやび",
            "text": "…しっかし、洋服なんぞ\nまともに着たん、\nどれくらいぶりやろ？",
            "zh": "……不过，像这样\n正经穿一回洋装，\n隔了多久了咯？",
            "narrator_zh": "透明雅"
        },
        {
            "location": "44/TALK",
            "narrator": "透明みやび",
            "text": "相変わらず窮屈で、\nまるで拘束されちょる\n気分になる服や…。",
            "zh": "还是老样子紧绷绷的，\n这衣服让人活像\n被捆住了一样……",
            "narrator_zh": "透明雅"
        },
        {
            "location": "45/TALK",
            "narrator": "透明みやび",
            "text": "まっこと、みんなは\nよくこんなもん着れると\n不思議でならん。",
            "zh": "真搞不懂，大家\n怎么穿得住这种东西，\n实在太不可思议了。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "46/SEL",
            "narrator": "（選択肢）",
            "text": "でも、カワイイよ",
            "zh": "可是，很可爱哦",
            "narrator_zh": "（选项）"
        },
        {
            "location": "47/ACT",
            "narrator": "",
            "text": "でも、カワイイよ",
            "zh": "可是，很可爱哦",
            "narrator_zh": ""
        },
        {
            "location": "50/TALK",
            "narrator": "透明みやび",
            "text": "…マジで言うてる？",
            "zh": "……你是认真这么说的？",
            "narrator_zh": "透明雅"
        },
        {
            "location": "52/TALK",
            "narrator": "透明みやび",
            "text": "うちにはこんな服の\nどこがえいのか、\nさっぱりわからんがよ。",
            "zh": "我实在没懂\n这种衣服哪里好\n咯。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "53/TALK",
            "narrator": "透明みやび",
            "text": "…ちゅうか、\nぶっちゃけお世辞やろ？",
            "zh": "……不对，\n坦白讲是客套话吧？",
            "narrator_zh": "透明雅"
        },
        {
            "location": "54/TALK",
            "narrator": "透明みやび",
            "text": "和服以外は似合わんとか\n思うてるんちゃう？",
            "zh": "该不会心里觉得除了和服\n别的都不搭吧？",
            "narrator_zh": "透明雅"
        },
        {
            "location": "55/SEL",
            "narrator": "（選択肢）",
            "text": "和服より似合ってると思う",
            "zh": "我觉得比和服还要适合",
            "narrator_zh": "（选项）"
        },
        {
            "location": "56/SEL",
            "narrator": "（選択肢）",
            "text": "和服も洋服も似合うと思う",
            "zh": "我觉得和服洋装都很适合",
            "narrator_zh": "（选项）"
        },
        {
            "location": "57/ACT",
            "narrator": "",
            "text": "和服より似合ってると思う",
            "zh": "我觉得比和服还要适合",
            "narrator_zh": ""
        },
        {
            "location": "59/TALK",
            "narrator": "透明みやび",
            "text": "うーん…それはそれで\nちくっと引っかかるんや\nけんど…。",
            "zh": "唔嗯……那样倒也\n让人稍微有点介意，\n但是……",
            "narrator_zh": "透明雅"
        },
        {
            "location": "60/TALK",
            "narrator": "透明みやび",
            "text": "まあ、褒め言葉には\n違いないき、\n素直に喜ぶとするぞね。",
            "zh": "嘛，反正是夸我的话，\n我就老实开心\n收下咧。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "61/ACT",
            "narrator": "",
            "text": "和服も洋服も似合うと思う",
            "zh": "我觉得和服洋装都很适合",
            "narrator_zh": ""
        },
        {
            "location": "62/TALK",
            "narrator": "透明みやび",
            "text": "うち、和服も洋服もいける\nハイブリッドな女\nやったんか…。",
            "zh": "我原来是个和服洋装\n都能驾驭的\n双修女人咩……",
            "narrator_zh": "透明雅"
        },
        {
            "location": "63/TALK",
            "narrator": "透明みやび",
            "text": "それはビックリ、大発見。\nうちは新たな自分を\n知ることに成功した。",
            "zh": "这可真是大吃一惊、大发现。\n我成功认识到了\n全新的自己。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "66/TALK",
            "narrator": "透明みやび",
            "text": "…ちゅうか、いい加減\n引っ込んでえいか？",
            "zh": "……话说，差不多\n可以缩回去了咩？",
            "narrator_zh": "透明雅"
        },
        {
            "location": "67/SEL",
            "narrator": "（選択肢）",
            "text": "可愛い姿、もっと見たい",
            "zh": "可爱的样子，还想多看会儿",
            "narrator_zh": "（选项）"
        },
        {
            "location": "68/ACT",
            "narrator": "",
            "text": "可愛い姿、もっと見たい",
            "zh": "可爱的样子，还想多看会儿",
            "narrator_zh": ""
        },
        {
            "location": "70/TALK",
            "narrator": "透明みやび",
            "text": "いや、そう可愛い\n連呼されるんも困る\nっちゅうか…。",
            "zh": "不，一直被这么连声\n夸可爱我也挺困扰\n就是了……",
            "narrator_zh": "透明雅"
        },
        {
            "location": "71/TALK",
            "narrator": "透明みやび",
            "text": "ほれ、わかるやろ？\n窮屈で息苦しいんよ。",
            "zh": "你看，你懂吧？\n紧绷绷的喘不过气咯。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "72/TALK",
            "narrator": "透明みやび",
            "text": "やき、そろそろ脱いで\n肺いっぱいに空気を\n吸い込みたいちや。",
            "zh": "所以，差不多想脱掉\n让肺里狠狠吸满\n空气滴。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "73/SEL",
            "narrator": "（選択肢）",
            "text": "今日はその格好でいてほしい",
            "zh": "想让你今天一整天都这么穿",
            "narrator_zh": "（选项）"
        },
        {
            "location": "74/SEL",
            "narrator": "（選択肢）",
            "text": "照れてる？",
            "zh": "你害羞了？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "75/ACT",
            "narrator": "",
            "text": "今日はその格好でいてほしい",
            "zh": "想让你今天一整天都这么穿",
            "narrator_zh": ""
        },
        {
            "location": "78/TALK",
            "narrator": "透明みやび",
            "text": "…マジで言うてるが？",
            "zh": "……你是说真的咩？",
            "narrator_zh": "透明雅"
        },
        {
            "location": "79/TALK",
            "narrator": "透明みやび",
            "text": "別に、服なんぞ洋服や\nなくても構わんやろ。",
            "zh": "没必要非得穿\n洋装不可吧。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "80/TALK",
            "narrator": "透明みやび",
            "text": "それともあれか？",
            "zh": "还是说怎么了？",
            "narrator_zh": "透明雅"
        },
        {
            "location": "81/TALK",
            "narrator": "透明みやび",
            "text": "相棒は和服女は\n嫌いなが？",
            "zh": "难道搭档讨厌\n穿和服的女人咩？",
            "narrator_zh": "透明雅"
        },
        {
            "location": "82/ACT",
            "narrator": "",
            "text": "照れてる？",
            "zh": "你害羞了？",
            "narrator_zh": ""
        },
        {
            "location": "84/TALK",
            "narrator": "透明みやび",
            "text": "…………。",
            "zh": "…………",
            "narrator_zh": "透明雅"
        },
        {
            "location": "85/TALK",
            "narrator": "透明みやび",
            "text": "いや、恥ずかしいだけや。",
            "zh": "不是，单纯觉得丢人咯。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "86/TALK",
            "narrator": "透明みやび",
            "text": "こんな肩やら足やらが\n出まくりの服着れば、\n当然のことやろ？",
            "zh": "穿这种肩膀啊腿啊\n露这么多的衣服，\n那是当然的吧？",
            "narrator_zh": "透明雅"
        },
        {
            "location": "87/SEL",
            "narrator": "（選択肢）",
            "text": "露出少ない服を選ぶよ",
            "zh": "那挑露得少点的衣服吧",
            "narrator_zh": "（选项）"
        },
        {
            "location": "88/ACT",
            "narrator": "",
            "text": "露出少ない服を選ぶよ",
            "zh": "那挑露得少点的衣服吧",
            "narrator_zh": ""
        },
        {
            "location": "92/TALK",
            "narrator": "透明みやび",
            "text": "ちょ！？　いやいや、\nそういうことを言うてる\nわけやなくて！",
            "zh": "等！？　不对不对，\n我不是说那个\n意思啊！",
            "narrator_zh": "透明雅"
        },
        {
            "location": "93/TALK",
            "narrator": "透明みやび",
            "text": "ちゅうか、うちのこと\nからかっちゅうやろ？",
            "zh": "说起来，你是在\n逗我玩吧？",
            "narrator_zh": "透明雅"
        },
        {
            "location": "95/SEL",
            "narrator": "（選択肢）",
            "text": "今のみやび、すごく可愛くて",
            "zh": "现在的雅，真的非常可爱",
            "narrator_zh": "（选项）"
        },
        {
            "location": "96/ACT",
            "narrator": "",
            "text": "今のみやび、すごく可愛くて",
            "zh": "现在的雅，真的非常可爱",
            "narrator_zh": ""
        },
        {
            "location": "98/TALK",
            "narrator": "透明みやび",
            "text": "いや、もう可愛い\n言うのやめぃ。",
            "zh": "都说了，别再一个劲\n说可爱了啦。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "99/TALK",
            "narrator": "透明みやび",
            "text": "そんな何度も言われると、\nむずむずした気持ちに\nなるき…。",
            "zh": "被你这么反复讲，\n心里会痒痒的\n啵……",
            "narrator_zh": "透明雅"
        },
        {
            "location": "100/SEL",
            "narrator": "（選択肢）",
            "text": "でも、本当可愛くて…",
            "zh": "可是，真的很可爱嘛……",
            "narrator_zh": "（选项）"
        },
        {
            "location": "101/SEL",
            "narrator": "（選択肢）",
            "text": "じゃあ、素敵だよ",
            "zh": "那，真是美极了",
            "narrator_zh": "（选项）"
        },
        {
            "location": "102/ACT",
            "narrator": "",
            "text": "でも、本当可愛くて…",
            "zh": "可是，真的很可爱嘛……",
            "narrator_zh": ""
        },
        {
            "location": "103/TALK",
            "narrator": "透明みやび",
            "text": "やき、可愛いはもう――",
            "zh": "所以说，可爱就别——",
            "narrator_zh": "透明雅"
        },
        {
            "location": "105/TALK",
            "narrator": "透明みやび",
            "text": "…いや、もうえい。\nわかった、これ以上は\n文句言わん。",
            "zh": "……算了，行吧。\n知道了，再也不多\n抱怨了。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "106/ACT",
            "narrator": "",
            "text": "じゃあ、素敵だよ",
            "zh": "那，真是美极了",
            "narrator_zh": ""
        },
        {
            "location": "107/TALK",
            "narrator": "透明みやび",
            "text": "っ！？",
            "zh": "唔！？",
            "narrator_zh": "透明雅"
        },
        {
            "location": "110/TALK",
            "narrator": "透明みやび",
            "text": "…あー…素敵なぁ…。",
            "zh": "……啊……美极了啊……",
            "narrator_zh": "透明雅"
        },
        {
            "location": "111/TALK",
            "narrator": "透明みやび",
            "text": "んー……。",
            "zh": "唔……",
            "narrator_zh": "透明雅"
        },
        {
            "location": "112/TALK",
            "narrator": "透明みやび",
            "text": "…いや、考えるのやめや。\nちゅうか、顔熱くて\n何も思いつかんし。",
            "zh": "……不行，别想了。\n不对，脸好烫，\n脑子转不动了。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "113/TALK",
            "narrator": "透明みやび",
            "text": "わかった、もうこれ以上\n服について文句は言わん。",
            "zh": "知道了，不会再对\n这衣服多说一句抱怨了。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "115/TALK",
            "narrator": "透明みやび",
            "text": "今日一日、この服着て\nデートしちゃる。",
            "zh": "今天一整天，就穿这身\n陪你约会咧。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "117/TALK",
            "narrator": "透明みやび",
            "text": "やき、これ以上\n可愛い言うんは禁止な。",
            "zh": "所以，不许再\n一直夸可爱了啊。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "118/TALK",
            "narrator": "透明みやび",
            "text": "それでどうや？",
            "zh": "这样总行了吧？",
            "narrator_zh": "透明雅"
        },
        {
            "location": "119/SEL",
            "narrator": "（選択肢）",
            "text": "自然に言っちゃうかも",
            "zh": "可能会脱口而出呢",
            "narrator_zh": "（选项）"
        },
        {
            "location": "120/ACT",
            "narrator": "",
            "text": "自然に言っちゃうかも",
            "zh": "可能会脱口而出呢",
            "narrator_zh": ""
        },
        {
            "location": "122/TALK",
            "narrator": "透明みやび",
            "text": "その時はペナルティとして\n相棒の個人情報が一つずつ\nネットに流れるぞね。",
            "zh": "到时就作为惩罚，\n把搭档的个人信息一条条\n放到网上公开咧。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "123/TALK",
            "narrator": "透明みやび",
            "text": "ほれ、いつまでも更衣室で\n漫才やっちょったら、\n店に迷惑かかる。",
            "zh": "快走，老在试衣间里\n说相声的话，\n会给店里添麻烦的。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "125/TALK",
            "narrator": "透明みやび",
            "text": "時間も勿体ないし、\nデートのつづきを\n楽しむとするがよ。",
            "zh": "浪费时间也怪可惜，\n继续享受接下来的\n约会啵。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "139/SEL",
            "narrator": "（選択肢）",
            "text": "こんなデートをしたいんだ！",
            "zh": "好想来一场这样的约会啊！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "140/ACT",
            "narrator": "",
            "text": "こんなデートをしたいんだ！",
            "zh": "好想来一场这样的约会啊！",
            "narrator_zh": ""
        },
        {
            "location": "142/TALK",
            "narrator": "みやび",
            "text": "なるほどなるほど",
            "zh": "原来如此原来如此",
            "narrator_zh": "雅"
        },
        {
            "location": "143/TALK",
            "narrator": "みやび",
            "text": "理解した",
            "zh": "我理解了",
            "narrator_zh": "雅"
        },
        {
            "location": "144/TALK",
            "narrator": "みやび",
            "text": "うちの感想を言わせてもらうと",
            "zh": "要让我发表感想的话",
            "narrator_zh": "雅"
        },
        {
