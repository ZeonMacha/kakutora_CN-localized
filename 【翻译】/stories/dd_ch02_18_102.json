{
    "dir": "chap18/daydra/dd_ch02_18_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "18205",
        "cid": "ayami",
        "title": "005 メインストーリー",
        "sub_title": "其は詮索か友愛か＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "此乃刺探抑或友爱＜后篇＞"
    },
    "entry": [
        {
            "location": "381/SEL",
            "narrator": "",
            "text": "$me$も協力しようか？",
            "zh": "$me$也来帮忙吧？",
            "narrator_zh": ""
        },
        {
            "location": "382/SEL",
            "narrator": "",
            "text": "知ってるところから知っていこう",
            "zh": "从已经知道的地方开始了解吧",
            "narrator_zh": ""
        },
        {
            "location": "383/ACT",
            "narrator": "",
            "text": "$me$も協力しようか？",
            "zh": "$me$也来帮忙吧？",
            "narrator_zh": ""
        },
        {
            "location": "384/TALK",
            "narrator": "アーヤ",
            "text": "ううん",
            "zh": "不用了",
            "narrator_zh": "绫水"
        },
        {
            "location": "385/TALK",
            "narrator": "アーヤ",
            "text": "やっぱりダメ(￣Д￣ )",
            "zh": "果然还是不行(￣Д￣ )",
            "narrator_zh": "绫水"
        },
        {
            "location": "386/TALK",
            "narrator": "アーヤ",
            "text": "いくらなんでも",
            "zh": "不管怎么说",
            "narrator_zh": "绫水"
        },
        {
            "location": "387/TALK",
            "narrator": "アーヤ",
            "text": "倫理的に問題あるし(´o｀；",
            "zh": "在伦理上也有问题啊(´o｀；",
            "narrator_zh": "绫水"
        },
        {
            "location": "388/TALK",
            "narrator": "アーヤ",
            "text": "リーダーだからって",
            "zh": "也不能因为是队长",
            "narrator_zh": "绫水"
        },
        {
            "location": "389/TALK",
            "narrator": "アーヤ",
            "text": "何やっても許されるわけじゃないし(>_<)",
            "zh": "就做什么都能被原谅呀(>_<)",
            "narrator_zh": "绫水"
        },
        {
            "location": "392/TALK",
            "narrator": "アーヤ",
            "text": "もうちょっと",
            "zh": "我再稍微",
            "narrator_zh": "绫水"
        },
        {
            "location": "393/TALK",
            "narrator": "アーヤ",
            "text": "考えてみるわ(￣∇￣)",
            "zh": "想想办法吧(￣∇￣)",
            "narrator_zh": "绫水"
        },
        {
            "location": "405/TALK",
            "narrator": "アーヤ",
            "text": "…なんて言ったけど、\n考えてどうにかなる\nことじゃないわよね。",
            "zh": "……话虽这么说，\n可这也不是光靠想\n就能解决的事呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "406/TALK",
            "narrator": "アーヤ",
            "text": "本人に直接\n聞いてみる？",
            "zh": "直接去问\n本人试试？",
            "narrator_zh": "绫水"
        },
        {
            "location": "407/TALK",
            "narrator": "アーヤ",
            "text": "そんなことしても\n教えてくれる\nわけないわよね…。",
            "zh": "就算真那么做，\n她也不可能\n告诉我的吧……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "408/TALK",
            "narrator": "アーヤ",
            "text": "…何か、卯月のことを\n知れるようなもの…。",
            "zh": "……有没有什么，\n能了解卯月的东西呢……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "412/TALK",
            "narrator": "アーヤ",
            "text": "またやってる…。\n意識しなかったけど、\n本当大人気なのね…。",
            "zh": "又在放了……。\n以前没注意过，\n原来真的这么受欢迎呢……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "413/ACT",
            "narrator": "",
            "text": "知ってるところから知っていこう",
            "zh": "从已经知道的地方开始了解吧",
            "narrator_zh": ""
        },
        {
            "location": "414/TALK",
            "narrator": "アーヤ",
            "text": "そう言われても",
            "zh": "就算你这么说",
            "narrator_zh": "绫水"
        },
        {
            "location": "415/TALK",
            "narrator": "アーヤ",
            "text": "知らないことの方が多いし(; ;)",
            "zh": "不知道的事反而更多啊(; ;)",
            "narrator_zh": "绫水"
        },
        {
            "location": "416/TALK",
            "narrator": "アーヤ",
            "text": "知ってるところと言われてもね",
            "zh": "要说已经知道的地方也……",
            "narrator_zh": "绫水"
        },
        {
            "location": "419/TALK",
            "narrator": "アーヤ",
            "text": "まあ",
            "zh": "不过",
            "narrator_zh": "绫水"
        },
        {
            "location": "420/TALK",
            "narrator": "アーヤ",
            "text": "ちょっと考えてみるわ(´o｀；",
            "zh": "我稍微想想看吧(´o｀；",
            "narrator_zh": "绫水"
        },
        {
            "location": "432/TALK",
            "narrator": "アーヤ",
            "text": "私が卯月のことで\n知ってること、か…。",
            "zh": "我所知道的\n关于卯月的事，吗……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "433/TALK",
            "narrator": "アーヤ",
            "text": "…何も知らない、って\nことはないはず\nなんだけど…。",
            "zh": "……应该也不至于\n什么都不知道\n才对……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "434/TALK",
            "narrator": "アーヤ",
            "text": "何を知ってるのか、\nって言われても…、\nすぐに出てこないわ。",
            "zh": "可要问我到底知道些什么……\n一时间还真\n说不上来。",
            "narrator_zh": "绫水"
        },
        {
            "location": "435/TALK",
            "narrator": "アーヤ",
            "text": "はぁ…やっぱり私、\n何も知らなかったの\nかしら？",
            "zh": "唉……果然我\n其实什么都\n不知道吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "436/TALK",
            "narrator": "アーヤ",
            "text": "卯月がメノウ\nだっていうのも\n知らなかったしね…。",
            "zh": "就连卯月是MENOW\n这件事，我之前\n也不知道呢……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "438/TALK",
            "narrator": "アーヤ",
            "text": "…………！？",
            "zh": "…………！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "439/TALK",
            "narrator": "アーヤ",
            "text": "そうよ、メノウよ！\nメノウがあったわ！",
            "zh": "对了，是MENOW啊！\n还有MENOW呢！",
            "narrator_zh": "绫水"
        },
        {
            "location": "440/TALK",
            "narrator": "アーヤ",
            "text": "メノウの正体が\n卯月なんだから。",
            "zh": "毕竟MENOW的真身\n就是卯月嘛。",
            "narrator_zh": "绫水"
        },
        {
            "location": "441/TALK",
            "narrator": "アーヤ",
            "text": "メノウを知れば、\n少しは卯月を知る\nことができるかも。",
            "zh": "只要了解MENOW，\n说不定就能多少\n了解一点卯月了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "442/TALK",
            "narrator": "アーヤ",
            "text": "そうでなくても、\nきっかけを掴む\n可能性はあるし。",
            "zh": "就算不行，\n也有可能借此\n抓住什么契机。",
            "narrator_zh": "绫水"
        },
        {
            "location": "444/TALK",
            "narrator": "アーヤ",
            "text": "…さっきのＣＤ、\n買いに行こう。",
            "zh": "……刚才那张CD，\n去买下来吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "460/TALK",
            "narrator": "アーヤ",
            "text": "…メノウの曲かぁ。",
            "zh": "……MENOW的歌啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "461/TALK",
            "narrator": "アーヤ",
            "text": "そういえば、ＣＭで\nサビの部分だけは\nよく聞いてるわ。",
            "zh": "说起来，广告里\n倒是经常听到\n副歌的部分。",
            "narrator_zh": "绫水"
        },
        {
            "location": "462/TALK",
            "narrator": "アーヤ",
            "text": "でも\n通して聞いたことって\nないわね…。",
            "zh": "不过\n完整听过一整首\n还真没有呢……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "463/TALK",
            "narrator": "アーヤ",
            "text": "…あの卯月が、\nどんな歌を\n歌うのか…。",
            "zh": "……那个卯月，\n会唱出\n怎样的歌呢……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "464/TALK",
            "narrator": "アーヤ",
            "text": "なんだか、ちょっと\n楽しみかも…。",
            "zh": "总觉得，还有点\n期待呢……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "465/TALK",
            "narrator": "アーヤ",
            "text": "あ、あった。\nこれね。",
            "zh": "啊，找到了。\n就是这张吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "466/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "467/TALK",
            "narrator": "アーヤ",
            "text": "改めて見ても、\nやっぱり卯月には\n見えないわね。",
            "zh": "仔细再看一遍，\n果然还是看不出\n这是卯月呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "469/TALK",
            "narrator": "アーヤ",
            "text": "同一人物だって\n知ってて見ても\n信じられないわ。",
            "zh": "哪怕明知道\n是同一个人再看，\n还是觉得难以置信。",
            "narrator_zh": "绫水"
        },
        {
            "location": "470/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "471/TALK",
            "narrator": "アーヤ",
            "text": "本当に、これを聞いて\n少しは卯月に近づける\nのかしら？",
            "zh": "真的，听了这张之后\n就能稍微靠近\n卯月一点吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "472/TALK",
            "narrator": "アーヤ",
            "text": "メノウって、卯月が\n必死に隠そうとしてた\n姿なのよね。",
            "zh": "MENOW，是卯月\n拼命想要隐藏的\n另一面吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "473/TALK",
            "narrator": "アーヤ",
            "text": "きっと卯月には\n凄く大切で、重要な\n秘密だった…。",
            "zh": "对卯月来说，这一定是\n非常重要、极其关键的\n秘密……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "474/TALK",
            "narrator": "アーヤ",
            "text": "……秘密には\nあまり触れられたく\nない、わよね……。",
            "zh": "……秘密这种东西，\n她应该不太想\n被人触碰吧……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "475/TALK",
            "narrator": "アーヤ",
            "text": "もしそうだとしたら、\n今このＣＤを聞いても\nいいのかしら？",
            "zh": "如果真是那样的话，\n现在听这张CD\n真的好吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "476/TALK",
            "narrator": "アーヤ",
            "text": "知られたくない一面に\n無理やり飛び込む\nようなものだし…。",
            "zh": "这就跟强行闯入\n别人不想被知道的一面\n没什么两样……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "477/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "479/TALK",
            "narrator": "アーヤ",
            "text": "むやみに踏み込んで\nいいことじゃない\nわね。",
            "zh": "这不是可以\n贸然踏足的\n领域呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "480/TALK",
            "narrator": "アーヤ",
            "text": "…やっぱり、\n別の方法を考えよう。",
            "zh": "……果然，\n还是想想别的办法吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "491/DIALOG",
            "narrator": "Dialog_chapter_ch02",
            "text": "【15 弾の数だけ抱きしめて】",
            "zh": "【15 有多少子弹，就拥抱多少次】",
            "narrator_zh": "Dialog_chapter_ch02"
        }
    ]
}
