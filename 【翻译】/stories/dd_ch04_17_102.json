{
    "dir": "chap17/daydra/dd_ch04_17_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "17405",
        "cid": "miyabi",
        "title": "005 メインストーリー",
        "sub_title": "相対的情報漏洩＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "相对的情报泄露＜后篇＞"
    },
    "entry": [
        {
            "location": "582/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "584/TALK",
            "narrator": "みやび",
            "text": "すみません。\nその命令には、\n従えないです。",
            "zh": "对不起。\n这道命令，\n我没法遵从。",
            "narrator_zh": "雅"
        },
        {
            "location": "585/TALK",
            "narrator": "真幌",
            "text": "…なんだと？",
            "zh": "…你说什么？",
            "narrator_zh": "真幌"
        },
        {
            "location": "587/TALK",
            "narrator": "みやび",
            "text": "すみません…。\nけんど、嫌ながです。",
            "zh": "对不起……\n但是，我不想干咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "588/TALK",
            "narrator": "みやび",
            "text": "仲間の素性を\n探るような行為は…。",
            "zh": "去探伙伴底细\n这种事……。",
            "narrator_zh": "雅"
        },
        {
            "location": "589/TALK",
            "narrator": "真幌",
            "text": "おまえ、さっき私に\n言ったよな？",
            "zh": "你刚才不是\n对我说过吗？",
            "narrator_zh": "真幌"
        },
        {
            "location": "590/TALK",
            "narrator": "真幌",
            "text": "卯月をスパイと\n思っていた時期が\nあった、と。",
            "zh": "你说你有过\n把神乐当成\n间谍的时期吧。",
            "narrator_zh": "真幌"
        },
        {
            "location": "591/TALK",
            "narrator": "真幌",
            "text": "おまえも、卯月を\n怪しいと思って\nいたんじゃないのか？",
            "zh": "你不也一样\n觉得神乐\n可疑吗？",
            "narrator_zh": "真幌"
        },
        {
            "location": "592/TALK",
            "narrator": "みやび",
            "text": "そうです。\n今でも疑うてます。",
            "zh": "是的。\n到现在我也怀疑着咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "593/TALK",
            "narrator": "真幌",
            "text": "ならば、どうして\n私の命令を拒否する？",
            "zh": "那为什么\n拒绝我的命令？",
            "narrator_zh": "真幌"
        },
        {
            "location": "596/TALK",
            "narrator": "みやび",
            "text": "それは……。",
            "zh": "那是……。",
            "narrator_zh": "雅"
        },
        {
            "location": "598/TALK",
            "narrator": "みやび",
            "text": "卯月はうちらの\n仲間やからです。",
            "zh": "因为神乐\n是我们的伙伴。",
            "narrator_zh": "雅"
        },
        {
            "location": "599/TALK",
            "narrator": "みやび",
            "text": "卯月については、\nまっこと疑わしい、\n謎な部分が多いです。",
            "zh": "关于神乐，\n蛮可疑、\n谜团也很多咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "601/TALK",
            "narrator": "みやび",
            "text": "けんど――\nそれでも。",
            "zh": "但是——\n即便如此。",
            "narrator_zh": "雅"
        },
        {
            "location": "602/TALK",
            "narrator": "みやび",
            "text": "フェノメノンと\n何度も戦った\n仲間です。",
            "zh": "她是和 PhenoMENON\n反复交战过的\n伙伴。",
            "narrator_zh": "雅"
        },
        {
            "location": "604/TALK",
            "narrator": "みやび",
            "text": "ですき。",
            "zh": "就是嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "605/TALK",
            "narrator": "みやび",
            "text": "素性を調べよう\nなんて気に、\nならんがです。",
            "zh": "要去调查她\n这种念头，\n根本起不来咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "606/TALK",
            "narrator": "真幌",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "真幌"
        },
        {
            "location": "607/TALK",
            "narrator": "みやび",
            "text": "お叱りは受けますが、\n答えは変わらんが\nですよ？",
            "zh": "责罚我照单全收，\n但答案\n不会变的哦？",
            "narrator_zh": "雅"
        },
        {
            "location": "608/TALK",
            "narrator": "真幌",
            "text": "…いや、叱りは\nしないさ。",
            "zh": "…不，\n我不会罚你。",
            "narrator_zh": "真幌"
        },
        {
            "location": "609/TALK",
            "narrator": "真幌",
            "text": "だが、みやびにしては\n随分と甘いな。",
            "zh": "不过，以雅来说\n你也太天真了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "610/TALK",
            "narrator": "真幌",
            "text": "おまえなら、躊躇なく\nやってくれると\n思ったんだが…。",
            "zh": "我还以为换作是你，\n会毫不犹豫地\n做下去……",
            "narrator_zh": "真幌"
        },
        {
            "location": "611/TALK",
            "narrator": "みやび",
            "text": "…うちらしくないと\n思いますか？",
            "zh": "…你觉得这\n不像我们的作风吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "612/TALK",
            "narrator": "真幌",
            "text": "ああ、思う。",
            "zh": "啊，确实觉得。",
            "narrator_zh": "真幌"
        },
        {
            "location": "613/TALK",
            "narrator": "真幌",
            "text": "…だが、正直言って\n嬉しいよ。",
            "zh": "…但是，说实话\n我很高兴。",
            "narrator_zh": "真幌"
        },
        {
            "location": "614/TALK",
            "narrator": "真幌",
            "text": "おまえが、そこまで\n仲間のことを思って\nいると知れてな。",
            "zh": "我知道了你竟然\n这么把伙伴\n放在心上。",
            "narrator_zh": "真幌"
        },
        {
            "location": "615/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "616/TALK",
            "narrator": "真幌",
            "text": "すまなかったな。\n嫌な役目を負わせよう\nとして…。",
            "zh": "抱歉啊。\n想让你背上这种\n难办的差事……",
            "narrator_zh": "真幌"
        },
        {
            "location": "617/TALK",
            "narrator": "みやび",
            "text": "いえ…。",
            "zh": "不会……",
            "narrator_zh": "雅"
        },
        {
            "location": "619/TALK",
            "narrator": "みやび",
            "text": "けんど、卯月の件は\n放置するわけには\nいきませんよね？",
            "zh": "但是，神乐的事\n也不能就这么\n放着不管，对吧？",
            "narrator_zh": "雅"
        },
        {
            "location": "621/TALK",
            "narrator": "真幌",
            "text": "当然だ。",
            "zh": "那是当然。",
            "narrator_zh": "真幌"
        },
        {
            "location": "623/TALK",
            "narrator": "真幌",
            "text": "私は今から、\n管理庁へ抗議をしに\n行ってくる。",
            "zh": "我现在这就去\n管理厅\n抗议。",
            "narrator_zh": "真幌"
        },
        {
            "location": "624/TALK",
            "narrator": "真幌",
            "text": "私にまで情報を\n隠してたというのは、\n絶対に許せんからな。",
            "zh": "连我都瞒着，\n这种事\n绝对不可原谅。",
            "narrator_zh": "真幌"
        },
        {
            "location": "625/TALK",
            "narrator": "みやび",
            "text": "…大丈夫ながですか？\n管理庁に、一人で行く\nなんて…。",
            "zh": "…真没问题咯？\n一个人去管理厅\n什么的……",
            "narrator_zh": "雅"
        },
        {
            "location": "626/TALK",
            "narrator": "真幌",
            "text": "フェノメノンの中で\n戦うおまえ達に\n比べたら、な。",
            "zh": "比起在 PhenoMENON\n里战斗的\n你们几个，算什么。",
            "narrator_zh": "真幌"
        },
        {
            "location": "627/TALK",
            "narrator": "真幌",
            "text": "管理庁に行くくらい、\nなんてことはない。",
            "zh": "去一趟管理厅，\n不算什么。",
            "narrator_zh": "真幌"
        },
        {
            "location": "628/TALK",
            "narrator": "真幌",
            "text": "…気は緩められん\nがな。",
            "zh": "…只是不能\n大意罢了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "629/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "630/TALK",
            "narrator": "真幌",
            "text": "留守を任せたぞ、\nみやび。",
            "zh": "看家就交给你了，\n雅。",
            "narrator_zh": "真幌"
        },
        {
            "location": "635/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "636/TALK",
            "narrator": "みやび",
            "text": "仲間の素性は\n調べられん、か…。",
            "zh": "伙伴的底细，\n不能查了吗……",
            "narrator_zh": "雅"
        },
        {
            "location": "638/TALK",
            "narrator": "みやび",
            "text": "まっこと、うちも\n甘くなったぞね…。",
            "zh": "还真是，我也\n变得天真了咧……",
            "narrator_zh": "雅"
        },
        {
            "location": "649/DIALOG",
            "narrator": "Dialog_chapter_ch04",
            "text": "【14 神楽学校やめるってよ】",
            "zh": "【14 听说神乐要退学喽】",
            "narrator_zh": "Dialog_chapter_ch04"
        }
    ]
}
