{
    "dir": "chap37/daydra/dd_ch02_37_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "37205",
        "cid": "ayami",
        "title": "005 メインストーリー",
        "sub_title": "新世界に近いもの＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "接近新世界之物＜后篇＞"
    },
    "entry": [
        {
            "location": "649/TALK",
            "narrator": "アーヤ",
            "text": "……これでほぼ\n確定ってことよね……。",
            "zh": "……这下几乎\n算是定局了呢……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "650/TALK",
            "narrator": "アーヤ",
            "text": "自分の運命は全部\n自分で決められるって\n思ってたのに。",
            "zh": "我还以为自己的命运\n全都能由自己决定\n来着呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "651/TALK",
            "narrator": "アーヤ",
            "text": "…なんて。\nそんなわけないか。",
            "zh": "……开玩笑的。\n怎么可能嘛。",
            "narrator_zh": "绫水"
        },
        {
            "location": "653/SEL",
            "narrator": "",
            "text": "元気？",
            "zh": "还好吗？",
            "narrator_zh": ""
        },
        {
            "location": "654/SEL",
            "narrator": "",
            "text": "少し話せる？",
            "zh": "能聊几句吗？",
            "narrator_zh": ""
        },
        {
            "location": "655/SEL",
            "narrator": "",
            "text": "$me$を恨んでる？",
            "zh": "你恨$me$吗？",
            "narrator_zh": ""
        },
        {
            "location": "656/ACT",
            "narrator": "",
            "text": "元気？",
            "zh": "还好吗？",
            "narrator_zh": ""
        },
        {
            "location": "658/TALK",
            "narrator": "アーヤ",
            "text": "…残念ながら\nあんまり元気には\nなれそうもないわ。",
            "zh": "……很遗憾，\n现在实在不太能\n打起精神来呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "659/ACT",
            "narrator": "",
            "text": "少し話せる？",
            "zh": "能聊几句吗？",
            "narrator_zh": ""
        },
        {
            "location": "660/TALK",
            "narrator": "アーヤ",
            "text": "…大丈夫よ。",
            "zh": "……没关系哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "661/TALK",
            "narrator": "アーヤ",
            "text": "話すのも\n最後になるかも\nしれないしね。",
            "zh": "说不定这也是\n最后一次\n聊天了呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "662/ACT",
            "narrator": "",
            "text": "$me$を恨んでる？",
            "zh": "你恨$me$吗？",
            "narrator_zh": ""
        },
        {
            "location": "663/TALK",
            "narrator": "アーヤ",
            "text": "……恨んでもいいの？",
            "zh": "……可以恨你吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "664/TALK",
            "narrator": "アーヤ",
            "text": "…なんてね。",
            "zh": "……开玩笑的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "667/SEL",
            "narrator": "",
            "text": "元気？",
            "zh": "还好吗？",
            "narrator_zh": ""
        },
        {
            "location": "668/SEL",
            "narrator": "",
            "text": "少し話せる？",
            "zh": "能聊几句吗？",
            "narrator_zh": ""
        },
        {
            "location": "669/SEL",
            "narrator": "",
            "text": "$me$を恨んでる？",
            "zh": "你恨$me$吗？",
            "narrator_zh": ""
        },
        {
            "location": "670/ACT",
            "narrator": "",
            "text": "元気？",
            "zh": "还好吗？",
            "narrator_zh": ""
        },
        {
            "location": "671/TALK",
            "narrator": "アーヤ",
            "text": "…どうかしら。",
            "zh": "……谁知道呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "672/TALK",
            "narrator": "アーヤ",
            "text": "それから\n少しだけ驚いてる。",
            "zh": "而且\n还有点惊讶。",
            "narrator_zh": "绫水"
        },
        {
            "location": "673/ACT",
            "narrator": "",
            "text": "少し話せる？",
            "zh": "能聊几句吗？",
            "narrator_zh": ""
        },
        {
            "location": "674/TALK",
            "narrator": "アーヤ",
            "text": "…そうね。",
            "zh": "……好啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "675/TALK",
            "narrator": "アーヤ",
            "text": "私も話したいことが\nあるし。",
            "zh": "我也正好\n有些话想说。",
            "narrator_zh": "绫水"
        },
        {
            "location": "676/ACT",
            "narrator": "",
            "text": "$me$を恨んでる？",
            "zh": "你恨$me$吗？",
            "narrator_zh": ""
        },
        {
            "location": "677/TALK",
            "narrator": "アーヤ",
            "text": "…どうして？",
            "zh": "……为什么这么问？",
            "narrator_zh": "绫水"
        },
        {
            "location": "678/TALK",
            "narrator": "アーヤ",
            "text": "$handle$さんの\n選択とは違う結果に\nなっても受け入れる。",
            "zh": "就算最后变成与$handle$\n的选择不同的结果，\n我也会接受。",
            "narrator_zh": "绫水"
        },
        {
            "location": "680/TALK",
            "narrator": "アーヤ",
            "text": "まだ覚悟ができたとは\n言えないけど。",
            "zh": "虽然还不能说\n已经做好了觉悟。",
            "narrator_zh": "绫水"
        },
        {
            "location": "683/TALK",
            "narrator": "アーヤ",
            "text": "$handle$さんと話すの\nこれが最後かもって\n最近ずっと思ってる。",
            "zh": "和$handle$说话，\n说不定这就是最后一次了，\n我最近一直在这么想。",
            "narrator_zh": "绫水"
        },
        {
            "location": "684/TALK",
            "narrator": "アーヤ",
            "text": "その割には私いつも\nちゃんとしたこと\n言えてない。",
            "zh": "可话虽如此，\n我却总是没能\n说出什么像样的话。",
            "narrator_zh": "绫水"
        },
        {
            "location": "685/TALK",
            "narrator": "アーヤ",
            "text": "だから改めて聞いて。",
            "zh": "所以，请再听我说一次。",
            "narrator_zh": "绫水"
        },
        {
            "location": "686/TALK",
            "narrator": "アーヤ",
            "text": "トライナリーの私は\n$handle$さんに\n助けられてばかりで。",
            "zh": "三重奏的我\n一直在承蒙\n$handle$照顾。",
            "narrator_zh": "绫水"
        },
        {
            "location": "687/TALK",
            "narrator": "アーヤ",
            "text": "一人だけ大学生で\nリーダーの役目を\nすることになって。",
            "zh": "只有我一个是大学生，\n还不得不担起\n队长的职责。",
            "narrator_zh": "绫水"
        },
        {
            "location": "688/TALK",
            "narrator": "アーヤ",
            "text": "プレッシャーも\nすごかったし、\nみんな勝手だし。",
            "zh": "压力也\n大得不得了，\n大家又各行其是。",
            "narrator_zh": "绫水"
        },
        {
            "location": "689/TALK",
            "narrator": "アーヤ",
            "text": "弱音を吐ける相手は\n$handle$さんしか\nいなかった。",
            "zh": "能让我吐露软弱的\n对象，就只有\n$handle$而已。",
            "narrator_zh": "绫水"
        },
        {
            "location": "691/TALK",
            "narrator": "アーヤ",
            "text": "$handle$さんは\n色々アドバイス\nしてくれた。",
            "zh": "$handle$曾给了我\n各种各样的\n建议。",
            "narrator_zh": "绫水"
        },
        {
            "location": "692/TALK",
            "narrator": "アーヤ",
            "text": "その中で一番\nありがたかったのは。",
            "zh": "其中让我觉得\n最感激的一件事就是。",
            "narrator_zh": "绫水"
        },
        {
            "location": "693/TALK",
            "narrator": "アーヤ",
            "text": "私の立場を楽しむ\n方法を教えて\nくれたこと。",
            "zh": "你教会了我\n去享受自己所处\n立场的方法。",
            "narrator_zh": "绫水"
        },
        {
            "location": "694/SEL",
            "narrator": "",
            "text": "そうだっけ？",
            "zh": "是吗？",
            "narrator_zh": ""
        },
        {
            "location": "695/SEL",
            "narrator": "",
            "text": "気付いてた？",
            "zh": "你察觉到了吗？",
            "narrator_zh": ""
        },
        {
            "location": "696/SEL",
            "narrator": "",
            "text": "気を張ってばかりじゃね",
            "zh": "总绷着一根弦可不行呢",
            "narrator_zh": ""
        },
        {
            "location": "697/ACT",
            "narrator": "",
            "text": "そうだっけ？",
            "zh": "是吗？",
            "narrator_zh": ""
        },
        {
            "location": "698/TALK",
            "narrator": "アーヤ",
            "text": "もしかして\n無自覚だったの？",
            "zh": "难道说你\n自己都没意识到吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "699/ACT",
            "narrator": "",
            "text": "気付いてた？",
            "zh": "你察觉到了吗？",
            "narrator_zh": ""
        },
        {
            "location": "700/TALK",
            "narrator": "アーヤ",
            "text": "もちろん。\n当たり前でしょ。",
            "zh": "当然。\n那不是理所当然的嘛。",
            "narrator_zh": "绫水"
        },
        {
            "location": "701/ACT",
            "narrator": "",
            "text": "気を張ってばかりじゃね",
            "zh": "总绷着一根弦可不行呢",
            "narrator_zh": ""
        },
        {
            "location": "703/TALK",
            "narrator": "アーヤ",
            "text": "本当にそう。\n私だけじゃなくて\nみんな疲れちゃう。",
            "zh": "真的就是这样。\n不止是我，\n大家都会累垮的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "705/TALK",
            "narrator": "アーヤ",
            "text": "ふざけたことばっかり\n言ってって思った\nこともあったけど。",
            "zh": "虽然也有过觉得你\n尽说些不正经的话\n的时候。",
            "narrator_zh": "绫水"
        },
        {
            "location": "706/TALK",
            "narrator": "アーヤ",
            "text": "チームを円滑に\nまとめるには\nユーモアが必要。",
            "zh": "但要把团队顺利\n凝聚在一起，\n确实需要幽默感。",
            "narrator_zh": "绫水"
        },
        {
            "location": "707/TALK",
            "narrator": "アーヤ",
            "text": "それに気付けたのは\n$handle$さんの\nおかげ。",
            "zh": "能让我意识到这一点，\n都是多亏了\n$handle$。",
            "narrator_zh": "绫水"
        },
        {
            "location": "708/TALK",
            "narrator": "アーヤ",
            "text": "私一人だったら\n絶対に気付けなかった。",
            "zh": "如果只有我一个人，\n绝对不可能察觉到。",
            "narrator_zh": "绫水"
        },
        {
            "location": "709/TALK",
            "narrator": "アーヤ",
            "text": "だから本当に\nありがとう。",
            "zh": "所以真的\n非常谢谢你。",
            "narrator_zh": "绫水"
        },
        {
            "location": "710/SEL",
            "narrator": "",
            "text": "アーヤにだけ特別だから",
            "zh": "因为只对绫水特别",
            "narrator_zh": ""
        },
        {
            "location": "711/SEL",
            "narrator": "",
            "text": "別に普通だから",
            "zh": "没什么，很平常而已",
            "narrator_zh": ""
        },
        {
            "location": "712/SEL",
            "narrator": "",
            "text": "気にしなくていいのに",
            "zh": "其实不用在意的",
            "narrator_zh": ""
        },
        {
            "location": "713/ACT",
            "narrator": "",
            "text": "アーヤにだけ特別だから",
            "zh": "因为只对绫水特别",
            "narrator_zh": ""
        },
        {
            "location": "714/TALK",
            "narrator": "アーヤ",
            "text": "私にだって\n$handle$さんは\n特別だから。",
            "zh": "对我来说，\n$handle$也是\n特别的存在啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "716/TALK",
            "narrator": "アーヤ",
            "text": "特別なんて\n言葉が霞むくらい\n別格だから。",
            "zh": "甚至特别到\n连“特别”这个词都相形见绌，\n是独一无二的存在。",
            "narrator_zh": "绫水"
        },
        {
            "location": "717/ACT",
            "narrator": "",
            "text": "別に普通だから",
            "zh": "没什么，很平常而已",
            "narrator_zh": ""
        },
        {
            "location": "718/TALK",
            "narrator": "アーヤ",
            "text": "そうなの…？",
            "zh": "是这样吗……？",
            "narrator_zh": "绫水"
        },
        {
            "location": "719/TALK",
            "narrator": "アーヤ",
            "text": "誰にでも優しいんだ、\n$handle$さんは。",
            "zh": "$handle$对谁都\n这么温柔呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "720/ACT",
            "narrator": "",
            "text": "気にしなくていいのに",
            "zh": "其实不用在意的",
            "narrator_zh": ""
        },
        {
            "location": "721/TALK",
            "narrator": "アーヤ",
            "text": "…たいしたことじゃ\nないのね。",
            "zh": "……只是微不足道的\n小事而已啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "723/TALK",
            "narrator": "アーヤ",
            "text": "$handle$さんに\nとっては。",
            "zh": "对$handle$\n来说。",
            "narrator_zh": "绫水"
        },
        {
            "location": "725/TALK",
            "narrator": "アーヤ",
            "text": "………………………。",
            "zh": "………………………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "726/TALK",
            "narrator": "アーヤ",
            "text": "…今度こそ\n最後になるかも\nしれないもの…。",
            "zh": "……这次说不定\n真的就是\n最后一次了……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "727/TALK",
            "narrator": "アーヤ",
            "text": "思い切って\n伝えておこう。",
            "zh": "我还是鼓起勇气\n向你传达吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "728/TALK",
            "narrator": "アーヤ",
            "text": "…変なこと言うなって\n思うかもしれないけど。",
            "zh": "……你可能会觉得\n我在说些奇怪的话。",
            "narrator_zh": "绫水"
        },
        {
            "location": "729/TALK",
            "narrator": "アーヤ",
            "text": "でも聞いて。\n私が今考えてること。",
            "zh": "但还是听我说完吧。\n我此刻心里的想法。",
            "narrator_zh": "绫水"
        },
        {
            "location": "730/TALK",
            "narrator": "アーヤ",
            "text": "あなたはどっちの私が\nいなくなったとしても。",
            "zh": "无论哪个我消失，\n你都一定会……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "731/TALK",
            "narrator": "アーヤ",
            "text": "ううん、どっちの私も\nいなくなって魂だけに\nなったとしても。",
            "zh": "不对，哪怕两个我都消失了，\n只剩下灵魂\n也一样。",
            "narrator_zh": "绫水"
        },
        {
            "location": "733/TALK",
            "narrator": "アーヤ",
            "text": "ずっと、絶対、\n何があっても\n私の側にいてくれる。",
            "zh": "一直、绝对、\n无论发生什么，\n你都会留在我身边。",
            "narrator_zh": "绫水"
        },
        {
            "location": "734/TALK",
            "narrator": "アーヤ",
            "text": "私を支えてくれる。\n今それを確信したの。",
            "zh": "都会支撑着我。\n我现在对此深信不疑。",
            "narrator_zh": "绫水"
        },
        {
            "location": "735/TALK",
            "narrator": "アーヤ",
            "text": "…人は生きている時\n肉体に支配される。",
            "zh": "……人活着的时候，\n总是会受到肉体的支配。",
            "narrator_zh": "绫水"
        },
        {
            "location": "736/TALK",
            "narrator": "アーヤ",
            "text": "だから純粋に魂と\n魂を交えることは\nできない。",
            "zh": "所以无法纯粹地\n让灵魂与灵魂\n彼此交融。",
            "narrator_zh": "绫水"
        },
        {
            "location": "737/TALK",
            "narrator": "アーヤ",
            "text": "…だけどあなたは違う。\n心に直接接してくれる。",
            "zh": "……但你不一样。\n你能直接触碰我的心灵。",
            "narrator_zh": "绫水"
        },
        {
            "location": "738/TALK",
            "narrator": "アーヤ",
            "text": "$handle$さんとの\n魂と魂の交わりは\n他の人とは違う。",
            "zh": "与$handle$之间的\n灵魂交融，\n和任何人都不同。",
            "narrator_zh": "绫水"
        },
        {
            "location": "739/TALK",
            "narrator": "アーヤ",
            "text": "一人じゃないんだって\nそんな気持ちを\n与えてくれる。",
            "zh": "让我感受到自己\n并不是孤单一人，\n你给了我这样的心情。",
            "narrator_zh": "绫水"
        },
        {
            "location": "740/TALK",
            "narrator": "アーヤ",
            "text": "そんなあなたが好き。",
            "zh": "我喜欢这样的你。",
            "narrator_zh": "绫水"
        },
        {
            "location": "741/TALK",
            "narrator": "アーヤ",
            "text": "……ううん。\nそんな言葉じゃ\n全然足りない。",
            "zh": "……不对。\n这种字眼\n根本远远不够。",
            "narrator_zh": "绫水"
        },
        {
            "location": "742/TALK",
            "narrator": "アーヤ",
            "text": "愛してる。",
            "zh": "我爱你。",
            "narrator_zh": "绫水"
        },
        {
            "location": "743/TALK",
            "narrator": "アーヤ",
            "text": "……違う。愛なんて\n言葉すら安っぽい。",
            "zh": "……不对。连“爱”这个词\n都显得太廉价了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "744/TALK",
            "narrator": "アーヤ",
            "text": "もっと、この気持ちに\nあてはまる言葉……。",
            "zh": "还有没有更能贴合\n这份心情的词汇……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "745/TALK",
            "narrator": "アーヤ",
            "text": "…満たされる？",
            "zh": "……被填满？",
            "narrator_zh": "绫水"
        },
        {
            "location": "746/TALK",
            "narrator": "アーヤ",
            "text": "ううん、違う。\nだってあなたは\n私の一部。",
            "zh": "不，不对。\n因为你就是\n我的一部分。",
            "narrator_zh": "绫水"
        },
        {
            "location": "747/TALK",
            "narrator": "アーヤ",
            "text": "…やっぱり違う。\nだってこれじゃ\nあなたに失礼だもの。",
            "zh": "……果然还是不对。\n因为这样说\n未免太对你不敬了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "748/TALK",
            "narrator": "アーヤ",
            "text": "私にとっての\n$handle$さんは\n世界と同じもの。",
            "zh": "对我来说，\n$handle$就和\n世界本身一样。",
            "narrator_zh": "绫水"
        },
        {
            "location": "749/TALK",
            "narrator": "アーヤ",
            "text": "いつも側にいて\n見えなくてもわかる\nそんな存在。",
            "zh": "总是陪伴在身旁，\n即使看不见也能感知到的\n那样一种存在。",
            "narrator_zh": "绫水"
        },
        {
            "location": "750/TALK",
            "narrator": "アーヤ",
            "text": "私はいつも\n$handle$さんを\n感じてる。",
            "zh": "我一直都在\n感受着\n$handle$。",
            "narrator_zh": "绫水"
        },
        {
            "location": "751/TALK",
            "narrator": "アーヤ",
            "text": "私は$handle$さんに\n満たされてる。",
            "zh": "我的内心被$handle$\n满满地填满了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "752/TALK",
            "narrator": "アーヤ",
            "text": "私には\n$handle$さんが\n満ちている。",
            "zh": "我的心里\n充盈着\n$handle$。",
            "narrator_zh": "绫水"
        },
        {
            "location": "753/TALK",
            "narrator": "アーヤ",
            "text": "私のセカイには\nあなたが満ち溢れている。\n私のセカイ全ての場所に。",
            "zh": "我的世界里\n满满都是你的身影。\n在我世界的每一个角落。",
            "narrator_zh": "绫水"
        },
        {
            "location": "754/TALK",
            "narrator": "アーヤ",
            "text": "……ねえ。\nどうしよう。",
            "zh": "……呐。\n该怎么办才好呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "755/TALK",
            "narrator": "アーヤ",
            "text": "こんな言葉じゃ\n言い表せない。",
            "zh": "用这样的语言\n根本无法表达万一。",
            "narrator_zh": "绫水"
        },
        {
            "location": "757/TALK",
            "narrator": "アーヤ",
            "text": "私の言葉じゃ\n稚拙すぎる。",
            "zh": "我的言辞\n实在是太稚拙了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "758/TALK",
            "narrator": "アーヤ",
            "text": "…だけど感じて。\n私を感じて。",
            "zh": "……但是，请感受吧。\n请感受我。",
            "narrator_zh": "绫水"
        },
        {
            "location": "759/TALK",
            "narrator": "アーヤ",
            "text": "もっとうんと\n私の魂を感じて\nもらいたいの。",
            "zh": "真希望能让你\n更加深切地\n感受到我的灵魂。",
            "narrator_zh": "绫水"
        },
        {
            "location": "760/TALK",
            "narrator": "アーヤ",
            "text": "今の私の魂を。\nこの先の私の魂も。",
            "zh": "现在的我的灵魂。\n还有今后的我的灵魂。",
            "narrator_zh": "绫水"
        },
        {
            "location": "763/SEL",
            "narrator": "",
            "text": "愛してる。ずっと一緒だから",
            "zh": "我爱你。因为我们会一直在一起",
            "narrator_zh": ""
        },
        {
            "location": "764/SEL",
            "narrator": "",
            "text": "これからも共に支え合っていこう",
            "zh": "今后也一起互相扶持着走下去吧",
            "narrator_zh": ""
        },
        {
            "location": "765/SEL",
            "narrator": "",
            "text": "これからも頑張ってね",
            "zh": "今后也要加油哦",
            "narrator_zh": ""
        },
        {
            "location": "766/SEL",
            "narrator": "",
            "text": "役に立てて良かったよ",
            "zh": "能帮上忙真是太好了",
            "narrator_zh": ""
        },
        {
            "location": "767/ACT",
            "narrator": "",
            "text": "愛してる。ずっと一緒だから",
            "zh": "我爱你。因为我们会一直在一起",
            "narrator_zh": ""
        },
        {
            "location": "768/TALK",
            "narrator": "アーヤ",
            "text": "…現実世界の\n私の人格とでしょ？",
            "zh": "……你是说和现实世界的\n我的人格在一起吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "770/TALK",
            "narrator": "アーヤ",
            "text": "自分自身のはずなのに\nなんだか妬ける…。",
            "zh": "明明应该是同一个自己，\n不知怎么却有点吃醋……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "771/ACT",
            "narrator": "",
            "text": "これからも共に支え合っていこう",
            "zh": "今后也一起互相扶持着走下去吧",
            "narrator_zh": ""
        },
        {
            "location": "772/TALK",
            "narrator": "アーヤ",
            "text": "私じゃない私と？",
            "zh": "和不是我的我吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "773/TALK",
            "narrator": "アーヤ",
            "text": "変な気分。",
            "zh": "真是奇妙的感觉。",
            "narrator_zh": "绫水"
        },
        {
            "location": "774/ACT",
            "narrator": "",
            "text": "これからも頑張ってね",
            "zh": "今后也要加油哦",
            "narrator_zh": ""
        },
        {
            "location": "775/TALK",
            "narrator": "アーヤ",
            "text": "そうね。",
            "zh": "是啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "776/TALK",
            "narrator": "アーヤ",
            "text": "私にはもう\n頑張りようも\nないかもしれないけど。",
            "zh": "虽然对我来说，\n或许已经没什么\n能再努力的余地了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "777/ACT",
            "narrator": "",
            "text": "役に立てて良かったよ",
            "zh": "能帮上忙真是太好了",
            "narrator_zh": ""
        },
        {
            "location": "778/TALK",
            "narrator": "アーヤ",
            "text": "もう過去なのね。",
            "zh": "已经是过去式了呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "779/TALK",
            "narrator": "アーヤ",
            "text": "$handle$さんには。",
            "zh": "对$handle$而言。",
            "narrator_zh": "绫水"
        },
        {
            "location": "781/TALK",
            "narrator": "アーヤ",
            "text": "……どう転んでも\n私は私。",
            "zh": "……无论事情怎么发展，\n我依然是我。",
            "narrator_zh": "绫水"
        },
        {
            "location": "782/TALK",
            "narrator": "アーヤ",
            "text": "それは魂の真実。",
            "zh": "这是灵魂的真实。",
            "narrator_zh": "绫水"
        },
        {
            "location": "783/TALK",
            "narrator": "アーヤ",
            "text": "フェノメノンの中で\n生きた私が\nいなくなったとしても。",
            "zh": "即便在PhenoMENON中\n活过的我\n消失不见。",
            "narrator_zh": "绫水"
        },
        {
            "location": "784/TALK",
            "narrator": "アーヤ",
            "text": "私が私であることに\n変わりはない……。",
            "zh": "我作为我这一点，\n也绝不会改变……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "786/SEL",
            "narrator": "",
            "text": "愛してる。ずっと一緒だから",
            "zh": "我爱你。因为我们会一直在一起",
            "narrator_zh": ""
        },
        {
            "location": "787/SEL",
            "narrator": "",
            "text": "これからも共に支え合っていこう",
            "zh": "今后也一起互相扶持着走下去吧",
            "narrator_zh": ""
        },
        {
            "location": "788/SEL",
            "narrator": "",
            "text": "これからも頑張ってね",
            "zh": "今后也要加油哦",
            "narrator_zh": ""
        },
        {
            "location": "789/SEL",
            "narrator": "",
            "text": "役に立てて良かったよ",
            "zh": "能帮上忙真是太好了",
            "narrator_zh": ""
        },
        {
            "location": "790/ACT",
            "narrator": "",
            "text": "愛してる。ずっと一緒だから",
            "zh": "我爱你。因为我们会一直在一起",
            "narrator_zh": ""
        },
        {
            "location": "792/TALK",
            "narrator": "アーヤ",
            "text": "うん。\nそれだけは絶対だから。",
            "zh": "嗯。\n只有这一点是绝对的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "793/TALK",
            "narrator": "アーヤ",
            "text": "$handle$さんが\nいない未来なんて\n考えられない。",
            "zh": "没有$handle$的\n未来什么的，\n我根本无法想象。",
            "narrator_zh": "绫水"
        },
        {
            "location": "794/TALK",
            "narrator": "アーヤ",
            "text": "$handle$さんは\n私にとって\n世界そのものだから。",
            "zh": "因为$handle$\n对我来说，\n就是世界本身。",
            "narrator_zh": "绫水"
        },
        {
            "location": "795/ACT",
            "narrator": "",
            "text": "これからも共に支え合っていこう",
            "zh": "今后也一起互相扶持着走下去吧",
            "narrator_zh": ""
        },
        {
            "location": "796/TALK",
            "narrator": "アーヤ",
            "text": "そうね。\nそうして生きて\n行きましょう。",
            "zh": "是啊。\n就这样一起\n活下去吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "797/TALK",
            "narrator": "アーヤ",
            "text": "なんて。\n偉そうね私。",
            "zh": "开玩笑的。\n我说话真自大呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "798/TALK",
            "narrator": "アーヤ",
            "text": "本当はそうじゃないと\n生きていけないのは\n私の方なのに。",
            "zh": "明明如果不那样做\n就活不下去的人\n其实是我才对。",
            "narrator_zh": "绫水"
        },
        {
            "location": "799/ACT",
            "narrator": "",
            "text": "これからも頑張ってね",
            "zh": "今后也要加油哦",
            "narrator_zh": ""
        },
        {
            "location": "800/TALK",
            "narrator": "アーヤ",
            "text": "……。\nがんばるわ。\nもちろん。",
            "zh": "……。\n我会加油的。\n那当然。",
            "narrator_zh": "绫水"
        },
        {
            "location": "801/TALK",
            "narrator": "アーヤ",
            "text": "でも。\n$handle$さんには\n他人事でしかないの？",
            "zh": "不过。\n对$handle$来说，\n这只是事不关己的事吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "802/ACT",
            "narrator": "",
            "text": "役に立てて良かったよ",
            "zh": "能帮上忙真是太好了",
            "narrator_zh": ""
        },
        {
            "location": "803/TALK",
            "narrator": "アーヤ",
            "text": "これで終わりだって\nそう思ってる？",
            "zh": "你以为事情\n这样就结束了吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "804/TALK",
            "narrator": "アーヤ",
            "text": "人生はまだ続くのに。",
            "zh": "人生明明还会继续下去。",
            "narrator_zh": "绫水"
        },
        {
            "location": "806/TALK",
            "narrator": "アーヤ",
            "text": "$handle$さんは\n私の意思のある世界を\n選択してくれた。",
            "zh": "$handle$\n选择了有我意志\n存在的世界。",
            "narrator_zh": "绫水"
        },
        {
            "location": "807/TALK",
            "narrator": "アーヤ",
            "text": "その選択を私は\n絶対に忘れない。",
            "zh": "那个选择，我\n绝对不会忘记。",
            "narrator_zh": "绫水"
        },
        {
            "location": "808/TALK",
            "narrator": "アーヤ",
            "text": "もし違う未来を\n歩まざるを\n得なくなっても。",
            "zh": "哪怕将来不得不\n走向另一条\n不同的未来。",
            "narrator_zh": "绫水"
        },
        {
            "location": "809/TALK",
            "narrator": "アーヤ",
            "text": "$handle$さんの\n姿形を見失っても。\n魂は絶対に見失わない。",
            "zh": "哪怕再也看不到\n$handle$的身影。\n我也绝不会认丢你的灵魂。",
            "narrator_zh": "绫水"
        },
        {
            "location": "810/TALK",
            "narrator": "アーヤ",
            "text": "もし私が別の私の\n奥底で眠るだけの\n存在になっても。",
            "zh": "哪怕我变成只能在\n另一个我的深处\n沉睡的存在。",
            "narrator_zh": "绫水"
        },
        {
            "location": "811/TALK",
            "narrator": "アーヤ",
            "text": "$handle$さんの魂の\n記憶だけは手放さない。",
            "zh": "唯独关于$handle$\n灵魂的记忆，我绝不放手。",
            "narrator_zh": "绫水"
        },
        {
            "location": "812/TALK",
            "narrator": "アーヤ",
            "text": "それが私の決心。",
            "zh": "这就是我的决心。",
            "narrator_zh": "绫水"
        },
        {
            "location": "815/TALK",
            "narrator": "アーヤ",
            "text": "$handle$さん。",
            "zh": "$handle$。",
            "narrator_zh": "绫水"
        },
        {
            "location": "816/TALK",
            "narrator": "アーヤ",
            "text": "私、どんな結末に\nなっても受け入れる。",
            "zh": "无论最后迎来\n怎样的结局，我都会接受。",
            "narrator_zh": "绫水"
        },
        {
            "location": "818/TALK",
            "narrator": "アーヤ",
            "text": "一生懸命考えて\n出してくれた答え\nなんだから。",
            "zh": "因为那可是你\n拼尽全力思考后\n给出的答案。",
            "narrator_zh": "绫水"
        },
        {
            "location": "819/TALK",
            "narrator": "アーヤ",
            "text": "私が出会った全ての人の\n中で一番私のことを考えて\nくれた人の答えだから。",
            "zh": "因为那是在我遇见的所有人中\n最替我着想的人\n所给出的答案。",
            "narrator_zh": "绫水"
        },
        {
            "location": "820/TALK",
            "narrator": "アーヤ",
            "text": "私はそれを受け入れる。",
            "zh": "我会接受它。",
            "narrator_zh": "绫水"
        },
        {
            "location": "821/TALK",
            "narrator": "アーヤ",
            "text": "どんな姿になっても\n私は$handle$さんの\n側にいたいから。",
            "zh": "无论变成什么样子，\n我都想留在\n$handle$的身边。",
            "narrator_zh": "绫水"
        },
        {
            "location": "822/TALK",
            "narrator": "アーヤ",
            "text": "何度言っても足りないけど\n本当にありがとう。\n感謝します。",
            "zh": "虽然说多少遍都不够，\n但真的谢谢你。\n十分感谢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "823/TALK",
            "narrator": "アーヤ",
            "text": "気持ちに言葉が\n追いつかないけど。",
            "zh": "虽然言语总是\n追不上心意。",
            "narrator_zh": "绫水"
        },
        {
            "location": "824/TALK",
            "narrator": "アーヤ",
            "text": "愛してる。\n大好き。\nありがとう。",
            "zh": "我爱你。\n最喜欢你了。\n谢谢你。",
            "narrator_zh": "绫水"
        },
        {
