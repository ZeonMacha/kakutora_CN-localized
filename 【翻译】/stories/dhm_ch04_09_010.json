            "text": "012_ご当地方言少女",
            "zh": "012_本地方言少女",
            "narrator_zh": ""
        },
        {
            "location": "32/TALK",
            "narrator": "みやび",
            "text": "土佐弁がマイナー方言だとは思えんぞね",
            "zh": "我可觉得土佐话不算小众方言咧",
            "narrator_zh": "雅"
        },
        {
            "location": "33/TALK",
            "narrator": "みやび",
            "text": "なんといっても",
            "zh": "毕竟不管怎么说",
            "narrator_zh": "雅"
        },
        {
            "location": "34/TALK",
            "narrator": "みやび",
            "text": "高知県民はみんな土佐弁なのだからな",
            "zh": "高知县民人人都在讲土佐话啵",
            "narrator_zh": "雅"
        },
        {
            "location": "37/SEL",
            "narrator": "",
            "text": "それはそうかもしれないけど",
            "zh": "话是这么说没错啦",
            "narrator_zh": ""
        },
        {
            "location": "38/SEL",
            "narrator": "",
            "text": "マイナーだと思う",
            "zh": "我觉得就是小众",
            "narrator_zh": ""
        },
        {
            "location": "39/SEL",
            "narrator": "",
            "text": "方言少女萌えー",
            "zh": "方言少女萌——",
            "narrator_zh": ""
        },
        {
            "location": "40/ACT",
            "narrator": "",
            "text": "それはそうかもしれないけど",
            "zh": "话是这么说没错啦",
            "narrator_zh": ""
        },
        {
            "location": "41/TALK",
            "narrator": "みやび",
            "text": "けど、とか",
            "zh": "“可是”什么的",
            "narrator_zh": "雅"
        },
        {
            "location": "42/TALK",
            "narrator": "みやび",
            "text": "相棒のくせに生意気だ",
            "zh": "明明是搭档口气倒不小",
            "narrator_zh": "雅"
        },
        {
            "location": "43/ACT",
            "narrator": "",
            "text": "マイナーだと思う",
            "zh": "我觉得就是小众",
            "narrator_zh": ""
        },
        {
            "location": "44/TALK",
            "narrator": "みやび",
            "text": "まさか",
            "zh": "难不成",
            "narrator_zh": "雅"
        },
        {
            "location": "45/TALK",
            "narrator": "みやび",
            "text": "信じんぞ",
            "zh": "我才不信咧",
            "narrator_zh": "雅"
        },
        {
            "location": "46/ACT",
            "narrator": "",
            "text": "方言少女萌えー",
            "zh": "方言少女萌——",
            "narrator_zh": ""
        },
        {
            "location": "48/TALK",
            "narrator": "みやび",
            "text": "萌えとな",
            "zh": "还萌上了呢",
            "narrator_zh": "雅"
        },
        {
            "location": "49/TALK",
            "narrator": "みやび",
            "text": "いや",
            "zh": "不对",
            "narrator_zh": "雅"
        },
        {
            "location": "50/TALK",
            "narrator": "みやび",
            "text": "萌えちゅうかよ",
            "zh": "这算哪门子萌啦",
            "narrator_zh": "雅"
        },
        {
            "location": "51/TALK",
            "narrator": "みやび",
            "text": "ふふん",
            "zh": "哼哼",
            "narrator_zh": "雅"
        },
        {
            "location": "53/TALK",
            "narrator": "みやび",
            "text": "しかしつばめちゃんのことだ",
            "zh": "不过以燕那孩子来说",
            "narrator_zh": "雅"
        },
        {
            "location": "54/TALK",
            "narrator": "みやび",
            "text": "下手したら本気でキャラづくりだと思われている懸念",
            "zh": "有个隐忧：搞不好她会认真以为是在刻意立人设",
            "narrator_zh": "雅"
        },
        {
            "location": "55/TALK",
            "narrator": "みやび",
            "text": "ぬぬぬ…",
            "zh": "唔唔唔……",
            "narrator_zh": "雅"
        },
        {
            "location": "57/SEL",
            "narrator": "",
            "text": "一度じっくり話し合おう",
            "zh": "找个时间好好聊聊吧",
            "narrator_zh": ""
        },
        {
            "location": "58/SEL",
            "narrator": "",
            "text": "さすがにそれはないよ",
            "zh": "那不至于吧",
            "narrator_zh": ""
        },
        {
            "location": "59/SEL",
            "narrator": "",
            "text": "標準語で話さないの？",
            "zh": "不用普通话讲吗？",
            "narrator_zh": ""
        },
        {
            "location": "60/ACT",
            "narrator": "",
            "text": "一度じっくり話し合おう",
            "zh": "找个时间好好聊聊吧",
            "narrator_zh": ""
        },
        {
            "location": "62/TALK",
            "narrator": "みやび",
            "text": "話し合いだ？",
            "zh": "要谈？",
            "narrator_zh": "雅"
        },
        {
            "location": "64/TALK",
            "narrator": "みやび",
            "text": "そこまでして訂正せんでもよい",
            "zh": "犯不着搞到那一步去纠正",
            "narrator_zh": "雅"
        },
        {
            "location": "65/TALK",
            "narrator": "みやび",
            "text": "それはそれで面白そうだし",
            "zh": "而且那样也挺有意思",
            "narrator_zh": "雅"
        },
        {
            "location": "66/ACT",
            "narrator": "",
            "text": "さすがにそれはないよ",
            "zh": "那不至于吧",
            "narrator_zh": ""
        },
        {
            "location": "67/TALK",
            "narrator": "みやび",
            "text": "なんだと？",
            "zh": "你说什么？",
            "narrator_zh": "雅"
        },
        {
            "location": "68/TALK",
            "narrator": "みやび",
            "text": "まだまだじゃの、相棒",
            "zh": "还差得远咧，搭档",
            "narrator_zh": "雅"
        },
        {
            "location": "69/TALK",
            "narrator": "みやび",
            "text": "あの子の天然っぷりを把握できておらぬ",
            "zh": "那孩子的天然呆程度你根本没掌握",
            "narrator_zh": "雅"
        },
        {
            "location": "70/ACT",
            "narrator": "",
            "text": "標準語で話さないの？",
            "zh": "不用普通话讲吗？",
            "narrator_zh": ""
        },
        {
            "location": "71/TALK",
            "narrator": "みやび",
            "text": "話せる",
            "zh": "会讲",
            "narrator_zh": "雅"
        },
        {
            "location": "72/TALK",
            "narrator": "みやび",
            "text": "が",
            "zh": "但是",
            "narrator_zh": "雅"
        },
        {
            "location": "73/TALK",
            "narrator": "みやび",
            "text": "話さん",
            "zh": "不讲",
            "narrator_zh": "雅"
        },
        {
            "location": "74/TALK",
            "narrator": "みやび",
            "text": "全く",
            "zh": "真是的",
            "narrator_zh": "雅"
        },
        {
            "location": "75/TALK",
            "narrator": "みやび",
            "text": "土佐弁が標準語になればええのに",
            "zh": "土佐话要是能当普通话就好了",
            "narrator_zh": "雅"
        }
    ]
