{
    "dir": "chap05/daydra/dd_ch02_05_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "5253",
        "cid": "ayami",
        "title": "Extra003 プレミアムストーリー",
        "sub_title": "公園の思い出",
        "title_zh": "Extra003 额外剧情",
        "sub_title_zh": "公园的回忆"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "公園の思い出",
            "zh": "公园的回忆",
            "narrator_zh": ""
        },
        {
            "location": "22/TALK",
            "narrator": "つばめ",
            "text": "今日は手続き手伝って\nくれて、ありがとう\nございました。",
            "zh": "今天帮我\n办手续，\n谢谢。",
            "narrator_zh": "燕"
        },
        {
            "location": "24/TALK",
            "narrator": "アーヤ",
            "text": "色々しないといけない\nことが多いから、\n面倒だったでしょ？",
            "zh": "要办的事\n那么多，\n很麻烦吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "25/TALK",
            "narrator": "つばめ",
            "text": "はい…わたしだけじゃ\n今日だけで終わらな\nかったと思います…。",
            "zh": "是……只有我的话，\n今天应该\n办不完……。",
            "narrator_zh": "燕"
        },
        {
            "location": "26/TALK",
            "narrator": "つばめ",
            "text": "でも、明日からかぁ…\nちょっと不安です…。",
            "zh": "可是，从明天起……\n有点不安……。",
            "narrator_zh": "燕"
        },
        {
            "location": "28/TALK",
            "narrator": "アーヤ",
            "text": "ごめんなさい。\nいくらなんでも、\n突然過ぎだものね…。",
            "zh": "抱歉。\n不管怎么说，\n也太突然了……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "29/TALK",
            "narrator": "つばめ",
            "text": "そんな、謝らないで\nください。\nそれに――",
            "zh": "哪里，别\n道歉。\n而且——",
            "narrator_zh": "燕"
        },
        {
            "location": "31/TALK",
            "narrator": "つばめ",
            "text": "トライナリーの方も、\nちゃんとやって\nいけるかどうか…。",
            "zh": "三重奏那边，\n我能不能\n做好……。",
            "narrator_zh": "燕"
        },
        {
            "location": "32/TALK",
            "narrator": "アーヤ",
            "text": "大丈夫。さっき教えた\n通りにコネクト\nできれば心配ないわ。",
            "zh": "没事。按刚才教的\n那样连接上，\n就不用担心。",
            "narrator_zh": "绫水"
        },
        {
            "location": "33/TALK",
            "narrator": "つばめ",
            "text": "でも、本番でも\n落ち着いてできるか\nちょっと不安です。",
            "zh": "可是，正式的时候\n能不能沉住气，\n还是有点不安。",
            "narrator_zh": "燕"
        },
        {
            "location": "34/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "36/TALK",
            "narrator": "つばめ",
            "text": "あ、けど！\n失敗しないように\n頑張りますから！",
            "zh": "啊，不过！\n我会努力\n不搞砸的！",
            "narrator_zh": "燕"
        },
        {
            "location": "38/TALK",
            "narrator": "アーヤ",
            "text": "ええ、期待してる。\nでも、あまり\n気負わないでね？",
            "zh": "嗯，我期待着。\n不过，别太\n绷着哦？",
            "narrator_zh": "绫水"
        },
        {
            "location": "39/TALK",
            "narrator": "つばめ",
            "text": "はい！",
            "zh": "好！",
            "narrator_zh": "燕"
        },
        {
            "location": "41/TALK",
            "narrator": "つばめ",
            "text": "…あれ？",
            "zh": "……咦？",
            "narrator_zh": "燕"
        },
        {
            "location": "42/TALK",
            "narrator": "アーヤ",
            "text": "ん、どうしたの？",
            "zh": "嗯，怎么了？",
            "narrator_zh": "绫水"
        },
        {
            "location": "44/TALK",
            "narrator": "つばめ",
            "text": "ここの公園、遊具が\n少なくないですか？",
            "zh": "这个公园，游乐设施\n是不是有点少？",
            "narrator_zh": "燕"
        },
        {
            "location": "45/TALK",
            "narrator": "アーヤ",
            "text": "ああ、\nつばめもそう思う？",
            "zh": "啊，\n燕也这么觉得？",
            "narrator_zh": "绫水"
        },
        {
            "location": "46/TALK",
            "narrator": "アーヤ",
            "text": "何でも、子供がケガを\nする危険があるから、\nって理由で――",
            "zh": "听说是因为，\n小孩有受伤的危险\n——",
            "narrator_zh": "绫水"
        },
        {
            "location": "47/TALK",
            "narrator": "アーヤ",
            "text": "色々撤去された結果、\nブランコと砂場しか\n残らなかったらしいの。",
            "zh": "拆掉不少之后，\n只剩秋千和沙坑\n了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "48/TALK",
            "narrator": "アーヤ",
            "text": "少なくとも、私が東京に\n出てきた時には――",
            "zh": "至少，我来东京的\n时候——",
            "narrator_zh": "绫水"
        },
        {
            "location": "49/TALK",
            "narrator": "アーヤ",
            "text": "ジャングルジムと\nシーソーが残ってたわ。",
            "zh": "攀爬架和\n跷跷板还在。",
            "narrator_zh": "绫水"
        },
        {
            "location": "50/TALK",
            "narrator": "つばめ",
            "text": "そうだったんですか…。",
            "zh": "是这样啊……。",
            "narrator_zh": "燕"
        },
        {
            "location": "51/TALK",
            "narrator": "アーヤ",
            "text": "…もしかして、\n遊びたかった？",
            "zh": "……难道，\n你想玩？",
            "narrator_zh": "绫水"
        },
        {
            "location": "52/TALK",
            "narrator": "つばめ",
            "text": "えへへ…ちょっとだけ\nそう思ってました。",
            "zh": "诶嘿嘿……稍微\n有那么想过。",
            "narrator_zh": "燕"
        },
        {
            "location": "53/TALK",
            "narrator": "アーヤ",
            "text": "つばめはどれが\n一番好きなの？",
            "zh": "燕最喜欢\n哪一种？",
            "narrator_zh": "绫水"
        },
        {
            "location": "55/TALK",
            "narrator": "つばめ",
            "text": "う、う～ん…。",
            "zh": "唔、唔——嗯……。",
            "narrator_zh": "燕"
        },
        {
            "location": "56/TALK",
            "narrator": "つばめ",
            "text": "遊具の名前って、\n実はよく知らないん\nですよね…。",
            "zh": "游乐设施的名字，\n我其实不大\n知道……。",
            "narrator_zh": "燕"
        },
        {
            "location": "58/TALK",
            "narrator": "アーヤ",
            "text": "それ、わかるわ。\nみんな独自の愛称で\n呼ぶことが多いし。",
            "zh": "这我懂。\n大家经常用自己的\n爱称来叫。",
            "narrator_zh": "绫水"
        },
        {
            "location": "59/TALK",
            "narrator": "アーヤ",
            "text": "うんていのことを\n空中桟橋、って呼ぶ子とか\nいたわ。",
            "zh": "有小孩把云梯\n叫成空中栈桥，\n之类的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "61/TALK",
            "narrator": "つばめ",
            "text": "あはは、オシャレで\n良いですね。",
            "zh": "啊哈哈，挺时髦，\n很好看。",
            "narrator_zh": "燕"
        },
        {
            "location": "62/TALK",
            "narrator": "つばめ",
            "text": "アーヤさんは、\n子供の頃はどんな遊具で\n遊んでたんですか？",
            "zh": "绫水，\n小时候都玩\n什么样的？",
            "narrator_zh": "燕"
        },
        {
            "location": "64/TALK",
            "narrator": "アーヤ",
            "text": "う～ん…そうね…。",
            "zh": "唔——嗯……这个嘛……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "66/TALK",
            "narrator": "アーヤ",
            "text": "公園には結構思い出が\nあるから、どれか一つを\n選ぶのは悩むかも…。",
            "zh": "公园里的回忆\n挺多的，只选一个\n可能有点难……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "67/SEL",
            "narrator": "",
            "text": "箱型ブランコは？",
            "zh": "箱形秋千呢？",
            "narrator_zh": ""
        },
        {
            "location": "68/SEL",
            "narrator": "",
            "text": "ジャングルジムは？",
            "zh": "攀爬架呢？",
            "narrator_zh": ""
        },
        {
            "location": "69/SEL",
            "narrator": "",
            "text": "のぼり棒は？",
            "zh": "爬杆呢？",
            "narrator_zh": ""
        },
        {
            "location": "71/TALK",
            "narrator": "アーヤ",
            "text": "………………。",
            "zh": "………………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "72/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "73/TALK",
            "narrator": "アーヤ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "76/TALK",
            "narrator": "つばめ",
            "text": "そんなによく\n遊んでたんですか？",
            "zh": "你玩得那么\n多吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "78/TALK",
            "narrator": "アーヤ",
            "text": "近所に、ちょっとだけ\n大きい公園があってね。",
            "zh": "附近有个\n稍微大一点的公园。",
            "narrator_zh": "绫水"
        },
        {
            "location": "79/TALK",
            "narrator": "アーヤ",
            "text": "約束とかしなくても\n行けば誰かしらいて、\n沢山遊んだわ。",
            "zh": "不用约，\n去了总有人，\n玩了好多。",
            "narrator_zh": "绫水"
        },
        {
            "location": "80/TALK",
            "narrator": "アーヤ",
            "text": "そういえば、ジャングル\nジムは好きだったわ。",
            "zh": "这么说，攀爬架\n我是喜欢的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "82/TALK",
            "narrator": "アーヤ",
            "text": "色んな遊具があったけど、\n一日一回は絶対に遊ぶ\nくらいに好きだったの。",
            "zh": "设施有很多，\n喜欢到一天\n至少要玩一次。",
            "narrator_zh": "绫水"
        },
        {
            "location": "83/TALK",
            "narrator": "つばめ",
            "text": "ジャングルジムって、\nどういう風に遊ぶん\nですか？",
            "zh": "攀爬架，\n是怎么玩的\n呢？",
            "narrator_zh": "燕"
        },
        {
            "location": "84/TALK",
            "narrator": "アーヤ",
            "text": "誰が一番最初に\nてっぺんまで登れるかを\n競ったり――",
            "zh": "比谁最先\n爬到顶\n——",
            "narrator_zh": "绫水"
        },
        {
            "location": "85/TALK",
            "narrator": "アーヤ",
            "text": "ジャングルジムの上で\n鬼ごっこしたりとか､\nかしら？",
            "zh": "或者在攀爬架上\n捉迷藏，\n之类？",
            "narrator_zh": "绫水"
        },
        {
            "location": "87/TALK",
            "narrator": "つばめ",
            "text": "そ、そんなことしてたん\nですか！？",
            "zh": "你、你做过\n那种事！？",
            "narrator_zh": "燕"
        },
        {
            "location": "89/TALK",
            "narrator": "アーヤ",
            "text": "え？　ジャングルジムって\nそうやって遊ぶものじゃ\nないの？",
            "zh": "诶？　攀爬架\n不就是这么玩的\n吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "90/TALK",
            "narrator": "つばめ",
            "text": "…アーヤさんって、\n意外とおてんばさん\nだったのかな？",
            "zh": "……绫水，\n意外地是个\n野丫头吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "91/TALK",
            "narrator": "アーヤ",
            "text": "楽しかったなぁ…。\n大人になった今じゃ、\nもう遊べないけど――",
            "zh": "真开心啊……。\n现在长大了，\n已经玩不了——",
            "narrator_zh": "绫水"
        },
        {
            "location": "92/TALK",
            "narrator": "アーヤ",
            "text": "子供に戻れるなら、\nまたジャングルジムで\n鬼ごっこをしたいわ。",
            "zh": "要是能变回小孩，\n还想在攀爬架上\n捉迷藏。",
            "narrator_zh": "绫水"
        },
        {
            "location": "94/ACT",
            "narrator": "",
            "text": "箱型ブランコは？",
            "zh": "箱形秋千呢？",
            "narrator_zh": ""
        },
        {
            "location": "111/TALK",
            "narrator": "アーヤ",
            "text": "あ、それがあったわ",
            "zh": "啊，那个有过",
            "narrator_zh": "绫水"
        },
        {
            "location": "112/TALK",
            "narrator": "アーヤ",
            "text": "思い出話にはいいかも",
            "zh": "用来讲回忆也许正好",
            "narrator_zh": "绫水"
        },
        {
            "location": "124/TALK",
            "narrator": "アーヤ",
            "text": "…箱型ブランコ、って\nわかるかしら？",
            "zh": "……箱形秋千，\n知道吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "126/TALK",
            "narrator": "つばめ",
            "text": "えっと…観覧車の座席\nみたいになってるやつ\nですか？",
            "zh": "那个……是像摩天轮座位\n那样的\n吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "127/TALK",
            "narrator": "アーヤ",
            "text": "そう、それそれ。",
            "zh": "对，就是那个。",
            "narrator_zh": "绫水"
        },
        {
            "location": "128/TALK",
            "narrator": "アーヤ",
            "text": "地元にね、箱型ブランコの\n噂話があったの。",
            "zh": "我老家，有个\n箱形秋千的传闻。",
            "narrator_zh": "绫水"
        },
        {
            "location": "129/TALK",
            "narrator": "アーヤ",
            "text": "好きな人同士が乗って、\n十分間乗り続けられると\n恋が実る、って噂が。",
            "zh": "喜欢的两个人一起坐，\n能连坐十分钟，\n恋情就会成真。",
            "narrator_zh": "绫水"
        },
        {
            "location": "132/TALK",
            "narrator": "つばめ",
            "text": "わぁ、何だか可愛いです！",
            "zh": "哇，感觉好可爱！",
            "narrator_zh": "燕"
        },
        {
            "location": "134/TALK",
            "narrator": "アーヤ",
            "text": "ふふっ、そうね。",
            "zh": "呵呵，是吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "135/TALK",
            "narrator": "アーヤ",
            "text": "私の友達も、何人かは\nそれを実行した人が\nいるんだけど――",
            "zh": "我朋友里，也有\n几个人真的\n去试了——",
            "narrator_zh": "绫水"
        },
        {
            "location": "136/TALK",
            "narrator": "アーヤ",
            "text": "なんと、そのうちの一組は\nこの前婚約したの。",
            "zh": "而且其中一对，\n前阵子订婚了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "138/TALK",
            "narrator": "つばめ",
            "text": "えぇっ！？",
            "zh": "诶诶！？",
            "narrator_zh": "燕"
        },
        {
            "location": "139/TALK",
            "narrator": "アーヤ",
            "text": "噂もバカにはできない、\nってことなのかしらね？",
            "zh": "传闻也不能小看，\n是这个意思吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "140/TALK",
            "narrator": "つばめ",
            "text": "…素敵ですね。",
            "zh": "……真好。",
            "narrator_zh": "燕"
        },
        {
            "location": "141/TALK",
            "narrator": "つばめ",
            "text": "そういえば、アーヤさんも\n誰かと乗ったりしたん\nですか？",
            "zh": "这么说，绫水\n也和谁一起坐过\n吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "142/TALK",
            "narrator": "アーヤ",
            "text": "えっ！？\nえっと、どうだった\nかしら…？",
            "zh": "诶！？\n那个，怎么样\n来着……？",
            "narrator_zh": "绫水"
        },
        {
            "location": "143/TALK",
            "narrator": "アーヤ",
            "text": "忘れちゃったわ。",
            "zh": "忘掉了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "144/TALK",
            "narrator": "つばめ",
            "text": "アーヤさん、\n顔が赤くなってますよ？",
            "zh": "绫水，\n脸红了哦？",
            "narrator_zh": "燕"
        },
        {
            "location": "147/TALK",
            "narrator": "アーヤ",
            "text": "な、なってないから！\n多分、夕日のせいよ。",
            "zh": "没、没有！\n大概是夕阳的缘故。",
            "narrator_zh": "绫水"
        },
        {
            "location": "164/ACT",
            "narrator": "",
            "text": "ジャングルジムは？",
            "zh": "攀爬架呢？",
            "narrator_zh": ""
        },
        {
            "location": "189/TALK",
            "narrator": "アーヤ",
            "text": "そういえば、一番好きな遊具だったわ",
            "zh": "这么说起来，那是我最喜欢的游乐设施",
            "narrator_zh": "绫水"
        },
        {
            "location": "190/TALK",
            "narrator": "アーヤ",
            "text": "思い出させてくれてありがと",
            "zh": "谢谢你让我想起来",
            "narrator_zh": "绫水"
        },
        {
            "location": "203/TALK",
            "narrator": "アーヤ",
            "text": "私、遊具の中では\nジャングルジムが\n一番好きだったの。",
            "zh": "游乐设施里，\n我最喜欢\n攀爬架。",
            "narrator_zh": "绫水"
        },
        {
            "location": "204/TALK",
            "narrator": "アーヤ",
            "text": "一日一回は絶対に\n遊んでたくらいだし。",
            "zh": "喜欢到一天\n至少要玩一次。",
            "narrator_zh": "绫水"
        },
        {
            "location": "206/TALK",
            "narrator": "つばめ",
            "text": "ジャングルジムって、\nどういう風に遊ぶん\nですか？",
            "zh": "攀爬架，\n是怎么玩的\n呢？",
            "narrator_zh": "燕"
        },
        {
            "location": "207/TALK",
            "narrator": "アーヤ",
            "text": "誰が一番最初に\nてっぺんまで登れるかを\n競ったり――",
            "zh": "比谁最先\n爬到顶\n——",
            "narrator_zh": "绫水"
        },
        {
            "location": "208/TALK",
            "narrator": "アーヤ",
            "text": "ジャングルジムの上で\n鬼ごっこしたりとか\nかしら？",
            "zh": "或者在攀爬架上\n捉迷藏\n之类？",
            "narrator_zh": "绫水"
        },
        {
            "location": "210/TALK",
            "narrator": "つばめ",
            "text": "そ、そんなことしてたん\nですか！？",
            "zh": "你、你做过\n那种事！？",
            "narrator_zh": "燕"
        },
        {
            "location": "212/TALK",
            "narrator": "アーヤ",
            "text": "え？　ジャングルジムって\nそうやって遊ぶものじゃ\nないの？",
            "zh": "诶？　攀爬架\n不就是这么玩的\n吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "213/TALK",
            "narrator": "つばめ",
            "text": "…アーヤさんって、\n意外とおてんばさん\nだったのかな？",
            "zh": "……绫水，\n意外地是个\n野丫头吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "214/ACT",
            "narrator": "",
            "text": "のぼり棒は？",
            "zh": "爬杆呢？",
            "narrator_zh": ""
        },
        {
            "location": "239/TALK",
            "narrator": "アーヤ",
            "text": "う～ん…",
            "zh": "唔——嗯……",
            "narrator_zh": "绫水"
        },
        {
            "location": "240/TALK",
            "narrator": "アーヤ",
            "text": "まあ、今なら笑い話だし、いいかな",
            "zh": "嘛，现在当笑话讲也行吧",
            "narrator_zh": "绫水"
        },
        {
            "location": "252/TALK",
            "narrator": "アーヤ",
            "text": "…遊んでたっていうか、\nよく挑戦したのが\nのぼり棒だったわ。",
            "zh": "……说是玩，\n我经常挑战的是\n爬杆。",
            "narrator_zh": "绫水"
        },
        {
            "location": "253/TALK",
            "narrator": "つばめ",
            "text": "のぼり棒、ですか？",
            "zh": "爬杆，吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "256/TALK",
            "narrator": "アーヤ",
            "text": "ええ…私、あれだけは\n一度ものぼれたことが\nないの…。",
            "zh": "嗯……只有那个，\n我一次都\n没爬上去过……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "257/TALK",
            "narrator": "つばめ",
            "text": "えっ、そうだったん\nですか！？",
            "zh": "诶，是这样\n吗！？",
            "narrator_zh": "燕"
        },
        {
            "location": "260/TALK",
            "narrator": "アーヤ",
            "text": "うん…友達はみんな\nひょいひょいのぼって\nいくのに――",
            "zh": "嗯……朋友们都\n轻轻松松爬上去\n——",
            "narrator_zh": "绫水"
        },
        {
            "location": "262/TALK",
            "narrator": "アーヤ",
            "text": "私は棒にしがみついて、\nズルズル地面に落ちる\nだけでね…。",
            "zh": "我抱着杆，\n只会哧溜溜掉到\n地上……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "263/TALK",
            "narrator": "アーヤ",
            "text": "悔しくて沢山練習した\nけど、結局一度も\nのぼれず仕舞いだったわ。",
            "zh": "不甘心，练了很多，\n结果一次都\n没爬上去。",
            "narrator_zh": "绫水"
        },
        {
            "location": "264/TALK",
            "narrator": "つばめ",
            "text": "…必死にのぼろうと\nしてるのに、ズルズル\n落ちるアーヤさん…。",
            "zh": "……拼命想爬，\n却哧溜溜掉下来的\n绫水……。",
            "narrator_zh": "燕"
        },
        {
            "location": "266/TALK",
            "narrator": "つばめ",
            "text": "…ぷっ。",
            "zh": "……噗。",
            "narrator_zh": "燕"
        },
        {
            "location": "267/TALK",
            "narrator": "アーヤ",
            "text": "あっ、今笑った？",
            "zh": "啊，你刚才笑了？",
            "narrator_zh": "绫水"
        },
        {
            "location": "268/TALK",
            "narrator": "つばめ",
            "text": "ご、ごめんなさい。",
            "zh": "对、对不起。",
            "narrator_zh": "燕"
        },
        {
            "location": "269/TALK",
            "narrator": "つばめ",
            "text": "でも、想像したら\nなんか可愛くて…。",
            "zh": "可是，一想象\n就觉得好可爱……。",
            "narrator_zh": "燕"
        },
        {
            "location": "271/TALK",
            "narrator": "アーヤ",
            "text": "…それで？\nつばめにはどんな\n思い出があるの？",
            "zh": "……然后呢？\n燕有什么样的\n回忆？",
            "narrator_zh": "绫水"
        },
        {
            "location": "273/TALK",
            "narrator": "つばめ",
            "text": "わたしは、その…。",
            "zh": "我，那个……。",
            "narrator_zh": "燕"
        },
        {
            "location": "274/TALK",
            "narrator": "つばめ",
            "text": "…実は、あんまり公園で\n遊んだ記憶、ないんです。",
            "zh": "……其实，在公园玩的记忆，\n不怎么有。",
            "narrator_zh": "燕"
        },
        {
            "location": "275/TALK",
            "narrator": "アーヤ",
            "text": "外で遊ぶのが\n嫌いだった、とか？",
            "zh": "不喜欢在外面玩，\n之类？",
            "narrator_zh": "绫水"
        },
        {
            "location": "276/TALK",
            "narrator": "つばめ",
            "text": "いえ、そうじゃないん\nですけど――",
            "zh": "不是，不是那样\n——",
            "narrator_zh": "燕"
        },
        {
            "location": "277/TALK",
            "narrator": "つばめ",
            "text": "お父さんが、あまり外で\n遊ぶのを許してくれ\nなかったんです。",
            "zh": "爸爸不大允许\n我在外面\n玩。",
            "narrator_zh": "燕"
        },
        {
            "location": "279/TALK",
            "narrator": "アーヤ",
            "text": "…そうだったんだ。",
            "zh": "……是这样啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "281/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "284/TALK",
            "narrator": "アーヤ",
            "text": "ブランコ競争、って\n遊びがあるの。",
            "zh": "有种玩法，叫\n秋千比赛。",
            "narrator_zh": "绫水"
        },
        {
            "location": "285/TALK",
            "narrator": "つばめ",
            "text": "ブランコ競争、ですか？",
            "zh": "秋千比赛，吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "286/TALK",
            "narrator": "アーヤ",
            "text": "うん、誰が一番高くまで、\nブランコで上がれるかを\n競う遊びなんだけど――",
            "zh": "嗯，比谁能把\n秋千荡得最高\n——",
            "narrator_zh": "绫水"
        },
        {
            "location": "287/TALK",
            "narrator": "アーヤ",
            "text": "今から、やってみない？",
            "zh": "现在，要不要试试？",
            "narrator_zh": "绫水"
        },
        {
            "location": "288/TALK",
            "narrator": "つばめ",
            "text": "えっ、今からですか！？",
            "zh": "诶，现在吗！？",
            "narrator_zh": "燕"
        },
        {
            "location": "289/TALK",
            "narrator": "アーヤ",
            "text": "ブランコは撤去されて\nいないし――",
            "zh": "秋千没有被\n拆掉——",
            "narrator_zh": "绫水"
        },
        {
            "location": "290/TALK",
            "narrator": "アーヤ",
            "text": "私達以外誰もいないから、\nやるならチャンスよ。",
            "zh": "除了我们没别人，\n要玩就趁现在。",
            "narrator_zh": "绫水"
        },
        {
            "location": "291/TALK",
            "narrator": "つばめ",
            "text": "そ、そうですけど…。\nでも、高校生にもなって\nブランコは…。",
            "zh": "是、是这样……。\n可是，都高中生了，\n秋千什么的……。",
            "narrator_zh": "燕"
        },
        {
            "location": "292/TALK",
            "narrator": "アーヤ",
            "text": "だからこそ、やるのよ。",
            "zh": "所以才要玩。",
            "narrator_zh": "绫水"
        },
        {
            "location": "293/TALK",
            "narrator": "アーヤ",
            "text": "だって、絶対に笑える\n思い出になるでしょ？",
            "zh": "因为，绝对会变成\n能笑出来的回忆吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "294/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "295/TALK",
            "narrator": "つばめ",
            "text": "…ふふっ、そうですね。",
            "zh": "……呵呵，说得对。",
            "narrator_zh": "燕"
        },
        {
            "location": "296/TALK",
            "narrator": "アーヤ",
            "text": "よし、決まりね！\n久しぶりにおもいっきり\nこぐわよ！",
            "zh": "好，决定了！\n好久没这么用劲\n蹬了！",
            "narrator_zh": "绫水"
        },
        {
            "location": "297/TALK",
            "narrator": "つばめ",
            "text": "わ、わたしも、\n初めてだけど負けません。",
            "zh": "我、我虽然是\n第一次，也不会输。",
            "narrator_zh": "燕"
        },
        {
            "location": "298/TALK",
            "narrator": "アーヤ",
            "text": "じゃあ、負けた方が\nジュース一本ね。",
            "zh": "那，输的人\n请一杯果汁。",
            "narrator_zh": "绫水"
        },
        {
            "location": "299/TALK",
            "narrator": "つばめ",
            "text": "望むところです。\nよーし、頑張るぞー！",
            "zh": "正合我意。\n好——，我要加油了！",
            "narrator_zh": "燕"
        },
        {
            "location": "301/TALK",
            "narrator": "アーヤ",
            "text": "ふふっ…。",
            "zh": "呵呵……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "302/TALK",
            "narrator": "アーヤ",
            "text": "こうやって、童心に返る\nのも悪くないわね。",
            "zh": "像这样回到童心，\n也不坏。",
            "narrator_zh": "绫水"
        },
        {
            "location": "19/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>5月5日　6:30 PM</color>\nドーム戦の2日後、神楽坂付近の路上にて。",
            "zh": "<color=green>5月5日　6:30 PM</color>\n穹顶战两天后，神乐坂附近的路上。",
            "narrator_zh": "Dialog_EventData"
        },
        {
            "location": "158/DIALOG",
            "narrator": "Dialog_GEThimegoto_ch02",
            "text": "【もしかして：初恋】",
            "zh": "【难道是：初恋】",
            "narrator_zh": "Dialog_GEThimegoto_ch02"
        },
        {
            "location": "170/DIALOG",
            "narrator": "Dialog_GETGokigen",
            "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！",
            "zh": "心情点数\n<size=40><color=red><b>300pt.</b></color></size>\n增加了！",
            "narrator_zh": "Dialog_GETGokigen"
        },
        {
            "location": "220/DIALOG",
            "narrator": "Dialog_GETGokigen",
            "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！",
            "zh": "心情点数\n<size=40><color=red><b>300pt.</b></color></size>\n增加了！",
            "narrator_zh": "Dialog_GETGokigen"
        }
    ]
