    },
    "entry": [
        {
            "location": "1839/SCENARIO",
            "narrator": "",
            "text": "CY敵（ガブちゃん）",
            "zh": "CY敌人（加布）",
            "narrator_zh": ""
        },
        {
            "location": "1851/TALK",
            "narrator": "千羽鶴",
            "text": "かつてここには\n宝箱があった。",
            "zh": "这里曾经\n有个宝箱。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1852/SEL",
            "narrator": "",
            "text": "かわいいミミックのこと？",
            "zh": "是说可爱的宝箱怪？",
            "narrator_zh": ""
        },
        {
            "location": "1853/ACT",
            "narrator": "",
            "text": "かわいいミミックのこと？",
            "zh": "是说可爱的宝箱怪？",
            "narrator_zh": ""
        },
        {
            "location": "1856/TALK",
            "narrator": "千羽鶴",
            "text": "そう！\nかわいいミミック――",
            "zh": "没错！\n可爱的宝箱怪——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1857/TALK",
            "narrator": "千羽鶴",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1859/TALK",
            "narrator": "千羽鶴",
            "text": "可愛かったら\nミミックにならない。",
            "zh": "要是可爱的话，\n就当不成宝箱怪了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1860/TALK",
            "narrator": "千羽鶴",
            "text": "そう。\nミミックにガブリエラは\nミスキャストだった。",
            "zh": "没错。\n让加布里埃拉演宝箱怪，\n是选角失误。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1861/TALK",
            "narrator": "千羽鶴",
            "text": "そこは反省。",
            "zh": "这点我有反省。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1862/TALK",
            "narrator": "千羽鶴",
            "text": "でも仕方ないの！\nだって――",
            "zh": "可是没办法呀！\n因为——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1865/TALK",
            "narrator": "千羽鶴",
            "text": "宝箱の中に入りそうなの\nガブリエラしか\nいなかったし！！",
            "zh": "看起来能钻进宝箱的，\n就只有加布里埃拉\n一个啊！！",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1866/SEL",
            "narrator": "",
            "text": "それ、ガブリエラが聞いたら怒るよ…？",
            "zh": "这话让加布里埃拉听到，她会生气的……吧？",
            "narrator_zh": ""
        },
        {
            "location": "1867/ACT",
            "narrator": "",
            "text": "それ、ガブリエラが聞いたら怒るよ…？",
            "zh": "这话让加布里埃拉听到，她会生气的……吧？",
            "narrator_zh": ""
        },
        {
            "location": "1869/TALK",
            "narrator": "千羽鶴",
            "text": "今はいない。よって\n聞かれることはない。",
            "zh": "现在不在。所以\n不会被听到。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1870/TALK",
            "narrator": "千羽鶴",
            "text": "結論、怒られない！",
            "zh": "结论：不会被骂！",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1871/TALK",
            "narrator": "千羽鶴",
            "text": "我ながら完璧……。",
            "zh": "连我都觉得天衣无缝……。",
            "narrator_zh": "千羽鹤"
        }
    ]
}
