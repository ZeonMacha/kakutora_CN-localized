{
    "dir": "chap10/daydra/dd_ch03_10_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "10305",
        "cid": "gabriella",
        "title": "005 メインストーリー",
        "sub_title": "七夕祭りへ行きません？＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "不去七夕祭典吗？＜后篇＞"
    },
    "entry": [
        {
            "location": "319/SCENARIO",
            "narrator": "",
            "text": "七夕祭りへ行きません？",
            "zh": "不去七夕祭典吗？",
            "narrator_zh": ""
        },
        {
            "location": "352/TALK",
            "narrator": "ガブリエラ",
            "text": "と、とにかく！\nあたしはあんた達とは\n絶対に――",
            "zh": "总、总之！\n我绝对不跟你们\n一起——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "353/TALK",
            "narrator": "ガブリエラ",
            "text": "絶対に、その…。",
            "zh": "绝对、那个……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "354/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "357/TALK",
            "narrator": "ガブリエラ",
            "text": "…私、最低だわ。",
            "zh": "……我真是差劲透顶了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "358/TALK",
            "narrator": "ガブリエラ",
            "text": "つばめの力のことは、\n確かに怖いけど――",
            "zh": "燕的力量，\n确实让我觉得害怕——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "359/TALK",
            "narrator": "ガブリエラ",
            "text": "一緒に行くの断った\nのは、違う理由だから\nなのに。",
            "zh": "可我拒绝一起去，\n明明是因为别的\n理由才对。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "360/TALK",
            "narrator": "ガブリエラ",
            "text": "平和ボケしてる\nみんなに、勝手に\nイライラして――",
            "zh": "我对沉浸在和平里\n松懈大意的大家\n擅自感到烦躁——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "361/TALK",
            "narrator": "ガブリエラ",
            "text": "それを、つばめに\n八つ当たりする\nなんて…最低過ぎ…。",
            "zh": "还把这股火\n撒到燕头上……\n真是太差劲了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "362/TALK",
            "narrator": "ガブリエラ",
            "text": "…謝らないと。\n今のは、絶対に\n謝らなきゃ！",
            "zh": "……得道歉才行。\n刚才那话，我绝对\n得道歉才行！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "364/TALK",
            "narrator": "ガブリエラ",
            "text": "…ぜ――",
            "zh": "……前——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "366/TALK",
            "narrator": "神楽",
            "text": "ぜ？",
            "zh": "前？",
            "narrator_zh": "神乐"
        },
        {
            "location": "367/TALK",
            "narrator": "ガブリエラ",
            "text": "…前言、撤回するわ。",
            "zh": "……收回前言。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "368/TALK",
            "narrator": "ガブリエラ",
            "text": "って、これ全然謝罪に\nなってないー！！",
            "zh": "不对，这完全不算在\n道歉啊——！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "370/TALK",
            "narrator": "神楽",
            "text": "な、何ですかそれ！？\nまさかそれで謝ってる\nつもりなんですか！？",
            "zh": "那、那算什么呀！？\n难道你以为这样就算\n道过歉了吗！？",
            "narrator_zh": "神乐"
        },
        {
            "location": "371/TALK",
            "narrator": "みやび",
            "text": "ガブちゃんの性格は、\nうちらもよーく知っ\nちょるけんど――",
            "zh": "加布的脾气，\n我们几个也都清楚\n得很，不过——",
            "narrator_zh": "雅"
        },
        {
            "location": "373/TALK",
            "narrator": "みやび",
            "text": "謝るべき時に謝らん\nっちゅうのは、\n許されんことぞね。",
            "zh": "该道歉的时候不肯\n低头道歉，这可\n不能饶过你啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "375/TALK",
            "narrator": "ガブリエラ",
            "text": "あ、う…。",
            "zh": "啊、呜……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "376/TALK",
            "narrator": "ガブリエラ",
            "text": "…どうしよう。\n二人とも、本気で\n怒ってる…。",
            "zh": "……怎么办。\n她们两个，是动真格\n在生气了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "377/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、ここまで言って\nおいて今更謝るなんて\nかっこ悪いこと――",
            "zh": "可是，话都说到这份上了\n事到如今再低头道歉\n也太丢脸了——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "378/TALK",
            "narrator": "ガブリエラ",
            "text": "…ああ、もう。\nまだ頑固なプライドが\n邪魔してる…。",
            "zh": "……啊啊，真是的。\n这股顽固的自尊心\n还在妨碍我……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "379/TALK",
            "narrator": "神楽",
            "text": "ガブちゃん！",
            "zh": "加布！",
            "narrator_zh": "神乐"
        },
        {
            "location": "380/TALK",
            "narrator": "みやび",
            "text": "謝りぃ！",
            "zh": "快道歉咯！",
            "narrator_zh": "雅"
        },
        {
            "location": "382/TALK",
            "narrator": "ガブリエラ",
            "text": "人の気も知らないで！",
            "zh": "你们根本不懂我的心情！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "384/TALK",
            "narrator": "つばめ",
            "text": "や、やめてください！",
            "zh": "请、请别这样！",
            "narrator_zh": "燕"
        },
        {
            "location": "389/TALK",
            "narrator": "つばめ",
            "text": "卯月さんも、\nみやびさんも――",
            "zh": "卯月，\n还有雅——",
            "narrator_zh": "燕"
        },
        {
            "location": "390/TALK",
            "narrator": "つばめ",
            "text": "ガブちゃんのこと、\n怒らないであげて\nください…。",
            "zh": "请不要生\n加布的气\n了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "392/TALK",
            "narrator": "ガブリエラ",
            "text": "…新人。",
            "zh": "……新人。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "393/TALK",
            "narrator": "神楽",
            "text": "で、でも！\nさっきのは絶対に\n言い過ぎですよ。",
            "zh": "可、可是！\n刚才那番话绝对\n说得太过分了呀。",
            "narrator_zh": "神乐"
        },
        {
            "location": "395/TALK",
            "narrator": "つばめ",
            "text": "あれは、わたし達が\nいけないんだよ。",
            "zh": "那件事，是我们\n不对在先呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "396/TALK",
            "narrator": "つばめ",
            "text": "わたし達が、一緒に\nお祭りに行かない\n理由を――",
            "zh": "是我们硬要问出\n她不肯一起\n去祭典的理由——",
            "narrator_zh": "燕"
        },
        {
            "location": "398/TALK",
            "narrator": "つばめ",
            "text": "無理やり聞き出した\nから、こんなことに\nなったんだし…。",
            "zh": "是硬逼着她问出来的，\n才会变成这样\n嘛……。",
            "narrator_zh": "燕"
        },
        {
            "location": "399/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "401/TALK",
            "narrator": "みやび",
            "text": "…つばめちゃんは\n怒っちょらんが？",
            "zh": "……燕你不生气\n的喃？",
            "narrator_zh": "雅"
        },
        {
            "location": "402/TALK",
            "narrator": "つばめ",
            "text": "はい…っていうか、\n感謝してます。",
            "zh": "嗯……倒不如说，\n我还要谢谢她呢。",
            "narrator_zh": "燕"
        },
        {
            "location": "403/TALK",
            "narrator": "ガブリエラ",
            "text": "なっ、はぁ！？\n何でそうなるのよ！？",
            "zh": "什、哈啊！？\n怎么就变成那样了！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "404/TALK",
            "narrator": "つばめ",
            "text": "だって…わたし達が\nしつこく聞かなかっ\nたら――",
            "zh": "因为……要是我们\n没有一个劲儿追问\n的话——",
            "narrator_zh": "燕"
        },
        {
            "location": "405/TALK",
            "narrator": "つばめ",
            "text": "絶対に本当の理由は\n言わなかったでしょ？",
            "zh": "她肯定不会说出\n真正的理由对吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "406/TALK",
            "narrator": "つばめ",
            "text": "それって、ちょっとは\nわたしのこと――",
            "zh": "这不就说明，她心里\n多少还是有点——",
            "narrator_zh": "燕"
        },
        {
            "location": "407/TALK",
            "narrator": "つばめ",
            "text": "思ってくれてる証拠\nなのかなぁ、って\n思ったから…。",
            "zh": "替我着想的，\n我就是这么觉得\n的嘛……。",
            "narrator_zh": "燕"
        },
        {
            "location": "409/TALK",
            "narrator": "みやび",
            "text": "呆れるほどの\nポジティブシンキング\n娘やなぁ…。",
            "zh": "真是乐观积极到\n让人服气的\n姑娘咯……。",
            "narrator_zh": "雅"
        },
        {
            "location": "411/TALK",
            "narrator": "つばめ",
            "text": "えへへ…、\nそれくらいしか\n取り柄ないんで…。",
            "zh": "哎嘿嘿……\n我就只有这点\n长处了嘛……。",
            "narrator_zh": "燕"
        },
        {
            "location": "412/TALK",
            "narrator": "つばめ",
            "text": "でも、せんぱい。\nこれならどうですか？",
            "zh": "不过，前辈。\n这样的话怎么样？",
            "narrator_zh": "燕"
        },
        {
            "location": "413/TALK",
            "narrator": "ガブリエラ",
            "text": "な、なによ？",
            "zh": "什、什么事？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "414/TALK",
            "narrator": "つばめ",
            "text": "お祭りの日までに、\nせんぱいが嫌がってる\nわたしの力のこと――",
            "zh": "在祭典那天之前，\n前辈你在意的\n我的那股力量——",
            "narrator_zh": "燕"
        },
        {
            "location": "415/TALK",
            "narrator": "つばめ",
            "text": "わたしが、\n解明してみせます！",
            "zh": "我一定会\n查个水落石出的！",
            "narrator_zh": "燕"
        },
        {
            "location": "416/TALK",
            "narrator": "ガブリエラ",
            "text": "っ！？",
            "zh": "唔！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "419/TALK",
            "narrator": "神楽",
            "text": "え、えぇっ！？",
            "zh": "咦、咦咦！？",
            "narrator_zh": "神乐"
        },
        {
            "location": "420/TALK",
            "narrator": "神楽",
            "text": "ちょ、つばめさん！\nいくらなんでも\nそれは…。",
            "zh": "等、燕！\n再怎么说那也\n太……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "422/TALK",
            "narrator": "みやび",
            "text": "１００パー不可能な\nことやと思うちや。",
            "zh": "我觉得那是百分之百\n不可能的事咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "423/TALK",
            "narrator": "つばめ",
            "text": "そ、そうかもしれま\nせんけど、でも――",
            "zh": "也、也许是这样\n没错，但是——",
            "narrator_zh": "燕"
        },
        {
            "location": "424/TALK",
            "narrator": "つばめ",
            "text": "わたし、せんぱいを\n絶対にお祭りに連れて\nいきたいんです！",
            "zh": "我无论如何都想\n带前辈一起去逛\n祭典呀！",
            "narrator_zh": "燕"
        },
        {
            "location": "425/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "426/TALK",
            "narrator": "つばめ",
            "text": "だから、この力の\n正体がわかったら――",
            "zh": "所以，等我弄清楚\n这股力量的真相后——",
            "narrator_zh": "燕"
        },
        {
            "location": "428/TALK",
            "narrator": "つばめ",
            "text": "その時は…、\n一緒にお祭り行って\nくれますか？",
            "zh": "到那个时候……\n你能和我一起去\n逛祭典吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "429/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "430/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "431/TALK",
            "narrator": "ガブリエラ",
            "text": "…本当、しつこいん\nだから。",
            "zh": "……真是的，缠人\n得要命。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "432/TALK",
            "narrator": "ガブリエラ",
            "text": "っていうか、\n連れてく、ってのは\n変でしょ？",
            "zh": "话说回来，\n什么叫“带我去”，\n听着很奇怪吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "433/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしは一人でも\n行こうとしてるん\nだから。",
            "zh": "我本来就算一个人\n也打算去逛\n的啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "434/TALK",
            "narrator": "つばめ",
            "text": "そ、そうかな？",
            "zh": "是、是这样吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "435/TALK",
            "narrator": "ガブリエラ",
            "text": "そうよ。\nまったく…。",
            "zh": "就是这样。\n真是的……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "437/TALK",
            "narrator": "ガブリエラ",
            "text": "…でも、いいわ。\nそこまで言うなら、\n一緒に行ってあげる。",
            "zh": "……不过，好吧。\n既然你都说到这份上了，\n我就勉为其难陪你去一趟。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "438/TALK",
            "narrator": "つばめ",
            "text": "…え？",
            "zh": "……咦？",
            "narrator_zh": "燕"
        },
        {
            "location": "441/TALK",
            "narrator": "神楽",
            "text": "が、ガブちゃん！\n今のって…。",
            "zh": "加、加布！\n你刚才说的是……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "442/TALK",
            "narrator": "ガブリエラ",
            "text": "本気よ、本気。\nあんたのその――",
            "zh": "认真的，我是认真的。\n谁叫你这么——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "443/TALK",
            "narrator": "ガブリエラ",
            "text": "…しつこさには、\nさすがに負けたわ。",
            "zh": "……这么缠人，\n我实在是败给你了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "445/TALK",
            "narrator": "つばめ",
            "text": "…や、やったー！\nやったよ、卯月さん、\nみやびさん！",
            "zh": "……太、太好啦！\n太好啦，卯月，\n雅！",
            "narrator_zh": "燕"
        },
        {
            "location": "446/TALK",
            "narrator": "みやび",
            "text": "す、凄いやないか、\nつばめちゃん。",
            "zh": "真、真有一手啊，\n燕。",
            "narrator_zh": "雅"
        },
        {
            "location": "447/TALK",
            "narrator": "みやび",
            "text": "あの一度嫌と言うたら\n絶対に首を縦に振らん\nガブちゃんを――",
            "zh": "那个一旦说了不肯\n就绝对不会点头\n的加布——",
            "narrator_zh": "雅"
        },
        {
            "location": "448/TALK",
            "narrator": "みやび",
            "text": "根負けさせるなんて、\nトライナリー初の\nできごとや。",
            "zh": "居然能把她磨到妥协，\n这还是三重奏头一回\n发生的事咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "450/TALK",
            "narrator": "神楽",
            "text": "つばめさんの気持ちが\n通じたんですよ。\nよかったですね！",
            "zh": "是燕的心意\n传达到她心里了哦。\n太好了呢！",
            "narrator_zh": "神乐"
        },
        {
            "location": "451/TALK",
            "narrator": "つばめ",
            "text": "そ、そんなこと\nないよぉ…。",
            "zh": "没、没有那么\n夸张啦……。",
            "narrator_zh": "燕"
        },
        {
            "location": "453/TALK",
            "narrator": "ガブリエラ",
            "text": "…実際、\nそうなんだけどね。",
            "zh": "……其实，\n还真是那样呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "454/TALK",
            "narrator": "ガブリエラ",
            "text": "あんな純粋な頼み方\nされて、断れるわけ\nないわ…。",
            "zh": "被她那样纯粹地\n拜托，怎么可能\n拒绝得了嘛……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "456/TALK",
            "narrator": "ガブリエラ",
            "text": "とりあえず、これで\nつばめの希望は叶える\nことになるけど…。",
            "zh": "总之，这样一来\n也算是满足了\n燕的心愿……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "468/TALK",
            "narrator": "ガブリエラ",
            "text": "ねえ、マルザンナ",
            "zh": "喂，玛尔赞娜",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "469/TALK",
            "narrator": "ガブリエラ",
            "text": "私、これだけでいいのかしら？",
            "zh": "我光这样就可以了吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "470/TALK",
            "narrator": "ガブリエラ",
            "text": "本当はちゃんと謝らないといけないのはわかってるけど",
            "zh": "虽然我知道本来应该好好道个歉才对",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "472/TALK",
            "narrator": "ガブリエラ",
            "text": "やっぱり、どうしてもごめんねって言葉が出てこなくて…。",
            "zh": "但果然，那句“对不起”还是怎么都说不出口……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "473/TALK",
            "narrator": "ガブリエラ",
            "text": "何か、他にいい方法はないかしら？",
            "zh": "有没有什么别的好办法呀？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "475/SEL",
            "narrator": "",
            "text": "楽しみにしてることを伝えればいい",
            "zh": "告诉她你也很期待就好了",
            "narrator_zh": ""
        },
        {
            "location": "476/ACT",
            "narrator": "",
            "text": "楽しみにしてることを伝えればいい",
            "zh": "告诉她你也很期待就好了",
            "narrator_zh": ""
        },
        {
            "location": "478/TALK",
            "narrator": "ガブリエラ",
            "text": "それでいいの？",
            "zh": "那样就行了吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "479/TALK",
            "narrator": "ガブリエラ",
            "text": "本当に、それだけで平気？",
            "zh": "真的光那样就没问题吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "480/TALK",
            "narrator": "ガブリエラ",
            "text": "またつばめに悲しい顔させたり",
            "zh": "不会又让燕露出伤心的表情",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "481/TALK",
            "narrator": "ガブリエラ",
            "text": "神楽達を怒らせたりとかしない？",
            "zh": "或者又惹神乐她们生气吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "483/SEL",
            "narrator": "",
            "text": "そんなビクついてると、逆に気を使われるよ？",
            "zh": "你这么战战兢兢的，反而会让她们拘束的哦？",
            "narrator_zh": ""
        },
        {
            "location": "484/ACT",
            "narrator": "",
            "text": "そんなビクついてると、逆に気を使われるよ？",
            "zh": "你这么战战兢兢的，反而会让她们拘束的哦？",
            "narrator_zh": ""
        },
        {
            "location": "486/TALK",
            "narrator": "ガブリエラ",
            "text": "そう言われても",
            "zh": "话是这么说",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "488/TALK",
            "narrator": "ガブリエラ",
            "text": "今は難しいわ",
            "zh": "现在还是很难办到嘛",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "490/SEL",
            "narrator": "",
            "text": "つばめは超頑張ったのに…",
            "zh": "燕明明那么努力了……",
            "narrator_zh": ""
        },
        {
            "location": "491/ACT",
            "narrator": "",
            "text": "つばめは超頑張ったのに…",
            "zh": "燕明明那么努力了……",
            "narrator_zh": ""
        },
        {
            "location": "493/TALK",
            "narrator": "ガブリエラ",
            "text": "それズルい！",
            "zh": "你这招太狡猾了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "495/TALK",
            "narrator": "ガブリエラ",
            "text": "わかった、わかったわ！",
            "zh": "知道了，我知道了啦！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "496/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、もしこれで変なことになったら",
            "zh": "不过，要是这样搞出什么奇怪的状况",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "498/TALK",
            "narrator": "ガブリエラ",
            "text": "マルザンナが責任取りなさいよ！？",
            "zh": "玛尔赞娜你可得负起责任来哦！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "510/TALK",
            "narrator": "ガブリエラ",
            "text": "…いつもの調子、\nいつもの調子で…。",
            "zh": "……保持平常的节奏，\n平常的节奏……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "512/TALK",
            "narrator": "つばめ",
            "text": "じゃあ、せんぱい。\n当日は一緒に行くって\nことで決まりですね！",
            "zh": "那么，前辈。\n当天就说好一起去\n了哦！",
            "narrator_zh": "燕"
        },
        {
            "location": "513/TALK",
            "narrator": "ガブリエラ",
            "text": "え、ええ…でも、\nえっと…。",
            "zh": "嗯、嗯……不过，\n那个……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "514/TALK",
            "narrator": "ガブリエラ",
            "text": "そ、そう！\n一つ条件追加よ！",
            "zh": "对、对了！\n我还要追加一个条件！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "516/TALK",
            "narrator": "つばめ",
            "text": "えぇっ！？",
            "zh": "咦咦！？",
            "narrator_zh": "燕"
        },
        {
            "location": "518/TALK",
            "narrator": "神楽",
            "text": "はぁ…、\n今度はなんですか？",
            "zh": "哈啊……\n这次又是什么呀？",
            "narrator_zh": "神乐"
        },
        {
            "location": "519/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしを誘ったのは\nあんたなんだから――",
            "zh": "既然是你主动\n邀请我的——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "520/TALK",
            "narrator": "ガブリエラ",
            "text": "責任もって、\nあたしのことを\nエスコートすること！",
            "zh": "那就要负起责任，\n好好当我的\nEscort 才行！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "521/TALK",
            "narrator": "つばめ",
            "text": "エスコートって…、\nえっと…。",
            "zh": "Escort 是指……\n那个……。",
            "narrator_zh": "燕"
        },
        {
            "location": "522/TALK",
            "narrator": "ガブリエラ",
            "text": "つ、つまり！",
            "zh": "简、简而言之！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "523/TALK",
            "narrator": "ガブリエラ",
            "text": "あんたが、あたしを\n楽しませてくれれば\nいい、ってことよ。",
            "zh": "只要你能让我\n玩得尽兴\n就行了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "524/TALK",
            "narrator": "つばめ",
            "text": "あっ、なるほど。\nそれなら任せて\nください！",
            "zh": "啊，原来如此。\n那这个就交给我\n吧！",
            "narrator_zh": "燕"
        },
        {
            "location": "526/TALK",
            "narrator": "ガブリエラ",
            "text": "…偉く自信満々ね。",
            "zh": "……倒是挺自信满满的嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "527/TALK",
            "narrator": "ガブリエラ",
            "text": "言っとくけど、\n一生の思い出に\n残るくらい――",
            "zh": "我可先说好，\n得是能留作一生回忆\n的程度——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "528/TALK",
            "narrator": "ガブリエラ",
            "text": "楽しい気持ちにさせろ\nってことよ？",
            "zh": "要让我觉得开心\n才行哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "530/TALK",
            "narrator": "つばめ",
            "text": "はい、わかってます。",
            "zh": "嗯，我明白。",
            "narrator_zh": "燕"
        },
        {
            "location": "531/TALK",
            "narrator": "つばめ",
            "text": "せんぱいの思い出に\n残るくらい――",
            "zh": "我一定会办成能留在\n前辈回忆里那样——",
            "narrator_zh": "燕"
        },
        {
            "location": "532/TALK",
            "narrator": "つばめ",
            "text": "楽しいお祭りに、\n絶対します！",
            "zh": "一场超级开心的祭典，\n绝对会的！",
            "narrator_zh": "燕"
        },
        {
            "location": "533/TALK",
            "narrator": "つばめ",
            "text": "だから、期待してて\nくださいね。",
            "zh": "所以，请好好\n期待着哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "534/TALK",
            "narrator": "ガブリエラ",
            "text": "…そう。\nじゃ、期待してるわ。",
            "zh": "……是吗。\n那我就期待着吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "536/TALK",
            "narrator": "ガブリエラ",
            "text": "…つばめとお祭りを\n一緒に楽しみたい、\nって気持ち――",
            "zh": "……想和燕一起\n开开心心逛祭典的\n这份心情——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "537/TALK",
            "narrator": "ガブリエラ",
            "text": "上手く伝わった\nかしら？",
            "zh": "不知道有没有顺利\n传达给她呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "539/TALK",
            "narrator": "みやび",
            "text": "ガブちゃんにしては、\n甘い条件やねぇ。",
            "zh": "以加布的作风来说，\n这条件可真温柔咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "541/TALK",
            "narrator": "神楽",
            "text": "でも、今の私達には\n丁度いい条件じゃ\nないですか。",
            "zh": "不过，这对现在的我们\n来说不是刚刚好的\n条件吗。",
            "narrator_zh": "神乐"
        },
        {
            "location": "542/TALK",
            "narrator": "つばめ",
            "text": "みやびさんが考えて\nくれた、ロマンチック\n大作戦で――",
            "zh": "用雅帮我们\n想出来的浪漫\n大作战——",
            "narrator_zh": "燕"
        },
        {
            "location": "543/TALK",
            "narrator": "つばめ",
            "text": "絶対に、せんぱいの\n思い出に残るお祭りに\nしてみせます！",
            "zh": "绝对要让这场祭典\n留在前辈的记忆里，\n我保证！",
            "narrator_zh": "燕"
        },
        {
            "location": "546/TALK",
            "narrator": "神楽",
            "text": "ふふっ、お祭り当日が\n楽しみです。",
            "zh": "呵呵，真期待\n祭典当天呀。",
            "narrator_zh": "神乐"
        },
        {
            "location": "557/DIALOG",
            "narrator": "Dialog_chapter_ch03",
            "text": "【08 HANABI】",
            "zh": "【08 HANABI】",
            "narrator_zh": "Dialog_chapter_ch03"
        }
    ]
}
