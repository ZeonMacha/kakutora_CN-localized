{
    "dir": "tutorial/beach_tutorial_ch06.js",
    "type": "Tutorial",
    "info": {
        "story_id": "",
        "cid": "_",
        "title": "",
        "sub_title": "TGS千羽鶴",
        "sub_title_zh": "TGS千羽鹤"
    },
    "entry": [
        {
            "location": "765/SCENARIO",
            "narrator": "",
            "text": "TGS千羽鶴",
            "zh": "TGS千羽鹤",
            "narrator_zh": ""
        },
        {
            "location": "775/TALK",
            "narrator": "千羽鶴",
            "text": "まさか、私が\nこんな事をする羽目に\nなるとは思わなかった。",
            "zh": "没想到，我居然会\n落到要做这种事的\n地步。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "776/SEL",
            "narrator": "",
            "text": "嬉しい！",
            "zh": "好开心！",
            "narrator_zh": ""
        },
        {
            "location": "777/SEL",
            "narrator": "",
            "text": "水着は！？",
            "zh": "泳装呢！？",
            "narrator_zh": ""
        },
        {
            "location": "778/ACT",
            "narrator": "",
            "text": "嬉しい！",
            "zh": "好开心！",
            "narrator_zh": ""
        },
        {
            "location": "779/TALK",
            "narrator": "千羽鶴",
            "text": "まあ、\nそう言ってくれるなら\n少しは意義があるかも。",
            "zh": "好吧，\n既然你都这么说了，\n多少也有点意义。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "780/ACT",
            "narrator": "",
            "text": "水着は！？",
            "zh": "泳装呢！？",
            "narrator_zh": ""
        },
        {
            "location": "781/TALK",
            "narrator": "千羽鶴",
            "text": "調子に乗らないで。",
            "zh": "别得意忘形。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "782/TALK",
            "narrator": "千羽鶴",
            "text": "そもそも私は\n非攻略対象なんだし。",
            "zh": "再说了，我本来就\n不是可攻略对象。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "783/TALK",
            "narrator": "千羽鶴",
            "text": "タッチ機能だって、私には\n対応していなかったのを、\n今回この為に対応したし。",
            "zh": "就连触摸功能，\n原本也没适配我，\n这次专门为这个适配了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "784/TALK",
            "narrator": "千羽鶴",
            "text": "それだけでも十分、\n感謝されてもおかしくない\nレベルだと思う。",
            "zh": "光是这样，我觉得\n已经到了\n值得感谢的程度了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "785/SEL",
            "narrator": "",
            "text": "ありがとうございます！",
            "zh": "非常感谢！",
            "narrator_zh": ""
        },
        {
            "location": "786/SEL",
            "narrator": "",
            "text": "まだまだ甘いわ！",
            "zh": "还差得远呢！",
            "narrator_zh": ""
        },
        {
            "location": "787/ACT",
            "narrator": "",
            "text": "ありがとうございます！",
            "zh": "非常感谢！",
            "narrator_zh": ""
        },
        {
            "location": "788/TALK",
            "narrator": "千羽鶴",
            "text": "それでよし。",
            "zh": "这就对了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "789/ACT",
            "narrator": "",
            "text": "まだまだ甘いわ！",
            "zh": "还差得远呢！",
            "narrator_zh": ""
        },
        {
            "location": "790/TALK",
            "narrator": "千羽鶴",
            "text": "なるほど。\nよくわかった。",
            "zh": "原来如此。\n我明白了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "791/TALK",
            "narrator": "千羽鶴",
            "text": "至らない旅行を続けても\n申し訳無いから、\n帰りましょ。",
            "zh": "再继续这趟不周到的\n旅行我也过意不去，\n回去吧。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "795/TALK",
            "narrator": "千羽鶴",
            "text": "さて。\nハネムーンと言えば\n南国の海。",
            "zh": "那么。\n说到蜜月\n就是南国的海。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "796/TALK",
            "narrator": "千羽鶴",
            "text": "というわけで、\n早速来てみた。\n感想は？",
            "zh": "于是呢，\n马上就来体验了。\n感想如何？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "797/SEL",
            "narrator": "",
            "text": "北欧とか寒い方が好き",
            "zh": "更喜欢北欧那种冷的地方",
            "narrator_zh": ""
        },
        {
            "location": "798/SEL",
            "narrator": "",
            "text": "いつか本当に結婚して南国旅行に行きたい",
            "zh": "想有一天真的结婚去南国旅行",
            "narrator_zh": ""
        },
        {
            "location": "799/ACT",
            "narrator": "",
            "text": "北欧とか寒い方が好き",
            "zh": "更喜欢北欧那种冷的地方",
            "narrator_zh": ""
        },
        {
            "location": "800/TALK",
            "narrator": "千羽鶴",
            "text": "なるほど。それじゃ\nポーランドにする。",
            "zh": "原来如此。那就\n去波兰吧。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "803/TALK",
            "narrator": "千羽鶴",
            "text": "はい、到着。",
            "zh": "好了，到了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "804/SEL",
            "narrator": "",
            "text": "ワルシャワ！素敵！",
            "zh": "华沙！真棒！",
            "narrator_zh": ""
        },
        {
            "location": "805/SEL",
            "narrator": "",
            "text": "なんでポーランドなの？",
            "zh": "为什么是波兰？",
            "narrator_zh": ""
        },
        {
            "location": "806/ACT",
            "narrator": "",
            "text": "ワルシャワ！素敵！",
            "zh": "华沙！真棒！",
            "narrator_zh": ""
        },
        {
            "location": "807/TALK",
            "narrator": "千羽鶴",
            "text": "ええ。\nワルシャワはとても\n素敵な所。",
            "zh": "是啊。\n华沙是个\n很棒的地方。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "808/ACT",
            "narrator": "",
            "text": "なんでポーランドなの？",
            "zh": "为什么是波兰？",
            "narrator_zh": ""
        },
        {
            "location": "809/TALK",
            "narrator": "千羽鶴",
            "text": "それを聞くのは\n愚問と言わざるを得ない。",
            "zh": "你这么问，\n只能说是个蠢问题。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "811/TALK",
            "narrator": "千羽鶴",
            "text": "ポーランドはドイツや\nフランスよりはマイナー\nだけど、見所は沢山ある。",
            "zh": "波兰虽然比不上\n德国和法国有名，\n看点却很多。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "812/TALK",
            "narrator": "千羽鶴",
            "text": "興味が出たなら\nいつか本当に\n行ってみるといい。",
            "zh": "要是来了兴趣，\n以后真的\n去一趟也不错。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "813/SEL",
            "narrator": "",
            "text": "その時はちーちゃん案内して！",
            "zh": "到时候让小千当导游！",
            "narrator_zh": ""
        },
        {
            "location": "814/ACT",
            "narrator": "",
            "text": "その時はちーちゃん案内して！",
            "zh": "到时候让小千当导游！",
            "narrator_zh": ""
        },
        {
            "location": "816/TALK",
            "narrator": "千羽鶴",
            "text": "いいけど。",
            "zh": "可以哦。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "817/SEL",
            "narrator": "",
            "text": "二人きりの旅行だーやったー！",
            "zh": "两个人的旅行——太棒了！",
            "narrator_zh": ""
        },
        {
            "location": "818/ACT",
            "narrator": "",
            "text": "二人きりの旅行だーやったー！",
            "zh": "两个人的旅行——太棒了！",
            "narrator_zh": ""
        },
        {
            "location": "821/TALK",
            "narrator": "千羽鶴",
            "text": "……なるほど。",
            "zh": "……原来如此。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "822/TALK",
            "narrator": "千羽鶴",
            "text": "言葉巧みに二人きりの\nシチュエーションを\n作る才能には恐れ入る。",
            "zh": "用花言巧语制造\n两人独处场面的\n才能，实在佩服。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "824/TALK",
            "narrator": "千羽鶴",
            "text": "是非それを\n彼女たちとの交流で\n活用してほしい。",
            "zh": "请务必把这份才能\n用在和她们的\n交流上。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "825/TALK",
            "narrator": "千羽鶴",
            "text": "ちなみに、\n私たちの世界では――",
            "zh": "顺带一提，\n在我们的世界里——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "826/TALK",
            "narrator": "千羽鶴",
            "text": "ポーランドは今\n内戦状態で、とても\n行ける感じでは無い。",
            "zh": "波兰现在\n正处于内战状态，\n根本去不了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "827/ACT",
            "narrator": "",
            "text": "いつか本当に結婚して南国旅行に行きたい",
            "zh": "想有一天真的结婚去南国旅行",
            "narrator_zh": ""
        },
        {
            "location": "828/TALK",
            "narrator": "千羽鶴",
            "text": "そうね。",
            "zh": "是啊。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "830/TALK",
            "narrator": "千羽鶴",
            "text": "……じゃなくて。",
            "zh": "……不对。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "831/TALK",
            "narrator": "千羽鶴",
            "text": "私は非攻略対象だから、\nそういう現実は来ない。",
            "zh": "我不是可攻略对象，\n那种现实不会来。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "834/TALK",
            "narrator": "千羽鶴",
            "text": "さあ、だいぶ時間\n使っちゃったし。",
            "zh": "好了，时间\n已经花了不少。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "835/TALK",
            "narrator": "千羽鶴",
            "text": "ちゃっちゃと\nやることやって\n戻りましょ。",
            "zh": "赶紧把该做的事\n做完，\n就回去吧。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "854/TALK",
            "narrator": "千羽鶴",
            "text": "いたい。",
            "zh": "好痛。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "856/TALK",
            "narrator": "千羽鶴",
            "text": "こづかれた。",
            "zh": "被戳了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "862/TALK",
            "narrator": "千羽鶴",
            "text": "押さない。",
            "zh": "别推。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "863/TALK",
            "narrator": "千羽鶴",
            "text": "胸は無い。",
            "zh": "没有胸。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "865/TALK",
            "narrator": "千羽鶴",
            "text": "小さいのが好き？",
            "zh": "喜欢小的？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "871/TALK",
            "narrator": "千羽鶴",
            "text": "なるほど。",
            "zh": "原来如此。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "873/TALK",
            "narrator": "千羽鶴",
            "text": "ちょっと。",
            "zh": "等一下。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "874/TALK",
            "narrator": "千羽鶴",
            "text": "強く押しすぎ。",
            "zh": "按得太用力了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "880/TALK",
            "narrator": "千羽鶴",
            "text": "ハネムーンだからって\n踊らされすぎ。",
            "zh": "别因为是蜜月\n就逼人跳个没完。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "882/TALK",
            "narrator": "千羽鶴",
            "text": "そんなことしても\n株は上がらないから。",
            "zh": "做这种事，\n评价也不会涨的。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "888/TALK",
            "narrator": "千羽鶴",
            "text": "おまわりさん、\nこの人です。",
            "zh": "警察叔叔，\n就是这个人。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "889/TALK",
            "narrator": "千羽鶴",
            "text": "通報した。",
            "zh": "已经报警了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "891/TALK",
            "narrator": "千羽鶴",
            "text": "変態。",
            "zh": "变态。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "897/TALK",
            "narrator": "千羽鶴",
            "text": "私に腹筋はないから\n触っても楽しくない。",
            "zh": "我没有腹肌，\n摸了也不会有意思。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "899/TALK",
            "narrator": "千羽鶴",
            "text": "くすぐったい。",
            "zh": "好痒。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "900/TALK",
            "narrator": "千羽鶴",
            "text": "ばか。",
            "zh": "笨蛋。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "840/DIALOG",
            "narrator": "INFO",
            "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n接続されました。\n\n画面をタップして相手に\n感覚を伝えましょう。",
            "zh": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\n触摸交流\n已连接。\n\n请点击画面，向对方\n传达感觉吧。",
            "narrator_zh": "INFO"
        },
        {
            "location": "907/DIALOG",
            "narrator": "NOTICE",
            "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n切断されました。",
            "zh": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\n触摸交流\n已断开。",
            "narrator_zh": "NOTICE"
        }
    ]
}
