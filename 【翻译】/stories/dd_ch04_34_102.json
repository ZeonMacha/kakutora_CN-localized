    },
    "entry": [
        {
            "location": "539/SCENARIO",
            "narrator": "",
            "text": "それが、未来の",
            "zh": "那便是，未来的",
            "narrator_zh": ""
        },
        {
            "location": "554/TALK",
            "narrator": "みやび",
            "text": "…つばめちゃん…。",
            "zh": "……燕……。",
            "narrator_zh": "雅"
        },
        {
            "location": "558/SEL",
            "narrator": "",
            "text": "$handle$参上",
            "zh": "$handle$大驾光临",
            "narrator_zh": ""
        },
        {
            "location": "559/ACT",
            "narrator": "",
            "text": "$handle$参上",
            "zh": "$handle$大驾光临",
            "narrator_zh": ""
        },
        {
            "location": "562/TALK",
            "narrator": "みやび",
            "text": "はっ！？",
            "zh": "哈！？",
            "narrator_zh": "雅"
        },
        {
            "location": "576/TALK",
            "narrator": "みやび",
            "text": "ふざけるな",
            "zh": "别闹了",
            "narrator_zh": "雅"
        },
        {
            "location": "577/TALK",
            "narrator": "みやび",
            "text": "主役気取りか",
            "zh": "还摆主演的架子吗",
            "narrator_zh": "雅"
        },
        {
            "location": "578/TALK",
            "narrator": "みやび",
            "text": "$handle$め",
            "zh": "$handle$这家伙",
            "narrator_zh": "雅"
        },
        {
            "location": "580/SEL",
            "narrator": "",
            "text": "何それ川柳？",
            "zh": "那是什么川柳？",
            "narrator_zh": ""
        },
        {
            "location": "581/SEL",
            "narrator": "",
            "text": "ごめん遅くなって",
            "zh": "抱歉来晚了",
            "narrator_zh": ""
        },
        {
            "location": "582/SEL",
            "narrator": "",
            "text": "$me$もあせったよ",
            "zh": "$me$也急坏了哦",
            "narrator_zh": ""
        },
        {
            "location": "583/ACT",
            "narrator": "",
            "text": "何それ川柳？",
            "zh": "那是什么川柳？",
            "narrator_zh": ""
        },
        {
            "location": "584/TALK",
            "narrator": "みやび",
            "text": "違うわ",
            "zh": "才不是",
            "narrator_zh": "雅"
        },
        {
            "location": "585/TALK",
            "narrator": "みやび",
            "text": "ばかちんが",
            "zh": "你这个笨蛋",
            "narrator_zh": "雅"
        },
        {
            "location": "586/ACT",
            "narrator": "",
            "text": "ごめん遅くなって",
            "zh": "抱歉来晚了",
            "narrator_zh": ""
        },
        {
            "location": "587/TALK",
            "narrator": "みやび",
            "text": "遅すぎぞね",
            "zh": "慢得也太离谱了咧",
            "narrator_zh": "雅"
        },
        {
            "location": "588/TALK",
            "narrator": "みやび",
            "text": "亀の呪いがかかったレベル",
            "zh": "中了乌龟诅咒的级别",
            "narrator_zh": "雅"
        },
        {
            "location": "589/ACT",
            "narrator": "",
            "text": "$me$もあせったよ",
            "zh": "$me$也急坏了哦",
            "narrator_zh": ""
        },
        {
            "location": "590/TALK",
            "narrator": "みやび",
            "text": "一番焦ったのは",
            "zh": "最着急的那个",
            "narrator_zh": "雅"
        },
        {
            "location": "592/TALK",
            "narrator": "みやび",
            "text": "うちぞね",
            "zh": "是我咧",
            "narrator_zh": "雅"
        },
        {
            "location": "594/TALK",
            "narrator": "みやび",
            "text": "なごちゃんの話を",
            "zh": "七五的事",
            "narrator_zh": "雅"
        },
        {
            "location": "595/TALK",
            "narrator": "みやび",
            "text": "したばかりであろう",
            "zh": "我可是刚说完",
            "narrator_zh": "雅"
        },
        {
            "location": "596/TALK",
            "narrator": "みやび",
            "text": "なごちゃんは",
            "zh": "七五当时",
            "narrator_zh": "雅"
        },
        {
            "location": "597/TALK",
            "narrator": "みやび",
            "text": "うちの目の前ではなかった",
            "zh": "并不在我的眼前",
            "narrator_zh": "雅"
        },
        {
            "location": "598/TALK",
            "narrator": "みやび",
            "text": "けんど",
            "zh": "但是",
            "narrator_zh": "雅"
        },
        {
            "location": "599/TALK",
            "narrator": "みやび",
            "text": "つばめちゃんは",
            "zh": "燕这次",
            "narrator_zh": "雅"
        },
        {
            "location": "600/TALK",
            "narrator": "みやび",
            "text": "いや",
            "zh": "不",
            "narrator_zh": "雅"
        },
        {
            "location": "601/TALK",
            "narrator": "みやび",
            "text": "そうではない",
            "zh": "不对",
            "narrator_zh": "雅"
        },
        {
            "location": "602/TALK",
            "narrator": "みやび",
            "text": "$handle$の話だ",
            "zh": "说的是$handle$",
            "narrator_zh": "雅"
        },
        {
            "location": "603/TALK",
            "narrator": "みやび",
            "text": "$handle$は地べたに正座の刑",
            "zh": "$handle$被判跪坐在地",
            "narrator_zh": "雅"
        },
        {
            "location": "604/TALK",
            "narrator": "みやび",
            "text": "うちの説教を受けよ",
            "zh": "给我领受说教",
            "narrator_zh": "雅"
        },
        {
            "location": "606/SEL",
            "narrator": "",
            "text": "ごめんってば",
            "zh": "都说了对不起嘛",
            "narrator_zh": ""
        },
        {
            "location": "607/SEL",
            "narrator": "",
            "text": "その元気があれば大丈夫",
            "zh": "有这精神头就没问题",
            "narrator_zh": ""
        },
        {
            "location": "608/SEL",
            "narrator": "",
            "text": "わかりにくい甘え方だなー",
            "zh": "这撒娇方式真难懂啊——",
            "narrator_zh": ""
        },
        {
            "location": "609/ACT",
            "narrator": "",
            "text": "ごめんってば",
            "zh": "都说了对不起嘛",
            "narrator_zh": ""
        },
        {
            "location": "610/TALK",
            "narrator": "みやび",
            "text": "許さん",
            "zh": "不原谅",
            "narrator_zh": "雅"
        },
        {
            "location": "611/ACT",
            "narrator": "",
            "text": "その元気があれば大丈夫",
            "zh": "有这精神头就没问题",
            "narrator_zh": ""
        },
        {
            "location": "612/TALK",
            "narrator": "みやび",
            "text": "それはある",
            "zh": "那倒是",
            "narrator_zh": "雅"
        },
        {
            "location": "613/ACT",
            "narrator": "",
            "text": "わかりにくい甘え方だなー",
            "zh": "这撒娇方式真难懂啊——",
            "narrator_zh": ""
        },
        {
            "location": "614/TALK",
            "narrator": "みやび",
            "text": "デレさせろ",
            "zh": "那就哄哄我啊",
            "narrator_zh": "雅"
        },
        {
            "location": "616/TALK",
            "narrator": "みやび",
            "text": "それとあれだ",
            "zh": "还有一件事",
            "narrator_zh": "雅"
        },
        {
            "location": "617/TALK",
            "narrator": "みやび",
            "text": "今回の件を鑑み",
            "zh": "鉴于这次的事",
            "narrator_zh": "雅"
        },
        {
            "location": "618/TALK",
            "narrator": "みやび",
            "text": "うちは$handle$専用ツールを開発する",
            "zh": "我要开发一款$handle$专用工具",
            "narrator_zh": "雅"
        },
        {
            "location": "619/TALK",
            "narrator": "みやび",
            "text": "うち以外の何人たりとも",
            "zh": "除了我之外的任何人",
            "narrator_zh": "雅"
        },
        {
            "location": "620/TALK",
            "narrator": "みやび",
            "text": "$handle$のアカウントをクラックできんようにする",
            "zh": "都无法破解$handle$的账号",
            "narrator_zh": "雅"
        },
        {
            "location": "621/TALK",
            "narrator": "みやび",
            "text": "うちの全精力をかけて",
            "zh": "我会倾尽全力",
            "narrator_zh": "雅"
        },
        {
            "location": "623/SEL",
            "narrator": "",
            "text": "ええと…ありがとう？",
            "zh": "那个……谢谢？",
            "narrator_zh": ""
        },
        {
            "location": "624/SEL",
            "narrator": "",
            "text": "さすがスーパーハッカ―",
            "zh": "不愧是超级黑客",
            "narrator_zh": ""
        },
        {
            "location": "625/SEL",
            "narrator": "",
            "text": "$me$は既にみやびの配下",
            "zh": "$me$早已是雅的部下",
            "narrator_zh": ""
        },
        {
            "location": "626/ACT",
            "narrator": "",
            "text": "ええと…ありがとう？",
            "zh": "那个……谢谢？",
            "narrator_zh": ""
        },
        {
            "location": "627/TALK",
            "narrator": "みやび",
            "text": "礼には及ばん",
            "zh": "不必言谢",
            "narrator_zh": "雅"
        },
        {
            "location": "628/TALK",
            "narrator": "みやび",
            "text": "というか",
            "zh": "或者说",
            "narrator_zh": "雅"
        },
        {
            "location": "629/TALK",
            "narrator": "みやび",
            "text": "いややっぱり",
            "zh": "不，果然还是",
            "narrator_zh": "雅"
        },
        {
            "location": "630/TALK",
            "narrator": "みやび",
            "text": "それでよい",
            "zh": "那样就好",
            "narrator_zh": "雅"
        },
        {
            "location": "631/ACT",
            "narrator": "",
            "text": "さすがスーパーハッカ―",
            "zh": "不愧是超级黑客",
            "narrator_zh": ""
        },
        {
            "location": "632/TALK",
            "narrator": "みやび",
            "text": "当然だ",
            "zh": "当然",
            "narrator_zh": "雅"
        },
        {
            "location": "633/TALK",
            "narrator": "みやび",
            "text": "と言うとでも思ったか",
            "zh": "你以为我会这么说吗",
            "narrator_zh": "雅"
        },
        {
            "location": "634/TALK",
            "narrator": "みやび",
            "text": "環境は常にアップデートされる",
            "zh": "环境可是随时都在更新",
            "narrator_zh": "雅"
        },
        {
            "location": "635/TALK",
            "narrator": "みやび",
            "text": "一筋縄ではいかぬ",
            "zh": "没那么好对付",
            "narrator_zh": "雅"
        },
        {
            "location": "636/ACT",
            "narrator": "",
            "text": "$me$は既にみやびの配下",
            "zh": "$me$早已是雅的部下",
            "narrator_zh": ""
        },
        {
            "location": "637/TALK",
            "narrator": "みやび",
            "text": "そういう説はある",
            "zh": "倒是有那种说法",
            "narrator_zh": "雅"
        },
        {
            "location": "638/TALK",
            "narrator": "みやび",
            "text": "しかしこれは",
            "zh": "但这里说的",
            "narrator_zh": "雅"
        },
        {
            "location": "639/TALK",
            "narrator": "みやび",
            "text": "外部からのアタックの話",
            "zh": "是外部攻击的问题",
            "narrator_zh": "雅"
        },
        {
            "location": "640/TALK",
            "narrator": "みやび",
            "text": "対策が必要",
            "zh": "需要做对策",
            "narrator_zh": "雅"
        },
        {
            "location": "642/TALK",
            "narrator": "みやび",
            "text": "以上のことは",
            "zh": "上述这些",
            "narrator_zh": "雅"
        },
        {
            "location": "643/TALK",
            "narrator": "みやび",
            "text": "こちらの件が解決してからのこと",
            "zh": "都等这边的事解决之后再说",
            "narrator_zh": "雅"
        },
        {
            "location": "644/TALK",
            "narrator": "みやび",
            "text": "今はつばめちゃんを救いたい",
            "zh": "现在先救燕",
            "narrator_zh": "雅"
        },
        {
            "location": "645/TALK",
            "narrator": "みやび",
            "text": "全力で手伝え",
            "zh": "给我全力帮忙",
            "narrator_zh": "雅"
        },
        {
            "location": "657/TALK",
            "narrator": "みやび",
            "text": "もうあんな気持ちには\nなりとうない。",
            "zh": "我不想再体会\n那种心情了。",
            "narrator_zh": "雅"
        },
        {
            "location": "658/TALK",
            "narrator": "みやび",
            "text": "なごちゃんの時の\nあの気持ちはもう\n味わいとうない。",
            "zh": "七五那时\n的那种心情，\n我已经尝够了。",
            "narrator_zh": "雅"
        },
        {
            "location": "659/TALK",
            "narrator": "みやび",
            "text": "手術が成功したか\nどうかもわからんまま\n会えなくなるのは。",
            "zh": "连手术成功与否\n都还不晓得，\n就这么见不到了，这种事。",
            "narrator_zh": "雅"
        },
        {
            "location": "660/TALK",
            "narrator": "みやび",
            "text": "あ…？",
            "zh": "啊…？",
            "narrator_zh": "雅"
        },
        {
            "location": "661/TALK",
            "narrator": "みやび",
            "text": "…うちは自覚以上に\n取り乱しとるんか？",
            "zh": "…我比自己以为的\n还要失态吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "662/TALK",
            "narrator": "みやび",
            "text": "$handle$と\n一時的に話せんかった\nことが尾を引いたか？",
            "zh": "跟$handle$\n一时失去联系的事，\n还留有后遗症吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "663/TALK",
            "narrator": "みやび",
            "text": "体験もしとらん\n謎の記憶が\n頭をよぎるとは。",
            "zh": "明明没有体验过，\n却有莫名其妙的记忆\n掠过脑海。",
            "narrator_zh": "雅"
        },
        {
            "location": "664/TALK",
            "narrator": "みやび",
            "text": "…いかんいかん。\n落ち着けうち。",
            "zh": "…不行不行。\n冷静点，我。",
            "narrator_zh": "雅"
        },
        {
            "location": "665/TALK",
            "narrator": "みやび",
            "text": "$handle$もおる。\nつばめちゃんを\nどうにかする…！",
            "zh": "$handle$也在。\n一定要把燕\n救回来…！",
            "narrator_zh": "雅"
        },
        {
            "location": "557/DIALOG",
            "narrator": "Dialog_InfoOS",
            "text": "\n<color=red>\nApp::WAVE\nactivation succeed!!\n</color>\nライセンスの更新\nありがとうございました。\n素敵なWAVEライフを！\n",
            "zh": "\n<color=red>\nApp::WAVE\nactivation succeed!!\n</color>\n感谢更新\n授权许可。\n祝你有段美好的WAVE生活！\n",
            "narrator_zh": "Dialog_InfoOS"
        },
        {
            "location": "676/DIALOG",
            "narrator": "Dialog_chapter_ch04",
            "text": "【28 時計じかけのイチゴ】",
