        {
            "location": "181/TALK",
            "narrator": "神楽",
            "text": "それで構いませんけど",
            "zh": "那样也可以",
            "narrator_zh": "神乐"
        },
        {
            "location": "193/TALK",
            "narrator": "神楽",
            "text": "割り切っていこう。",
            "zh": "干脆地公事公办吧。",
            "narrator_zh": "神乐"
        },
        {
            "location": "194/TALK",
            "narrator": "神楽",
            "text": "利用できるものは\n利用する。",
            "zh": "能利用的东西\n就要加以利用。",
            "narrator_zh": "神乐"
        },
        {
            "location": "196/TALK",
            "narrator": "神楽",
            "text": "そうしないといつまでも\n助けられないから…。",
            "zh": "因为不那样就永远\n帮不上忙……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "206/TALK",
            "narrator": "神楽",
            "text": "音羽の家……。\n見た目は全然\n代わってない…。",
            "zh": "音羽的家……。\n外表完全\n没有变……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "207/TALK",
            "narrator": "神楽",
            "text": "あの部屋も元のまま\nなんだろうな…。",
            "zh": "那个房间应该也还保持着\n原来的样子吧……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "208/SEL",
            "narrator": "",
            "text": "ここどこ？",
            "zh": "这里是哪里？",
            "narrator_zh": ""
        },
        {
            "location": "209/ACT",
            "narrator": "",
            "text": "ここどこ？",
