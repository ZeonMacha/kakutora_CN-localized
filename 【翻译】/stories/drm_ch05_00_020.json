        },
        {
            "location": "160/ACT",
            "narrator": "",
            "text": "いやならいいけど……",
            "zh": "不愿意的话也没关系……",
            "narrator_zh": ""
        },
        {
            "location": "161/TALK",
            "narrator": "神楽",
            "text": "意外と控えめですね",
            "zh": "意外地还挺克制呢",
            "narrator_zh": "神乐"
        },
        {
            "location": "163/ACT",
            "narrator": "",
            "text": "神楽のこと知りたいな～",
            "zh": "想多了解神乐啊～",
            "narrator_zh": ""
        },
        {
            "location": "164/TALK",
            "narrator": "神楽",
            "text": "なんだかずいぶんカワイイ言い方を",
            "zh": "总觉得说得相当可爱",
            "narrator_zh": "神乐"
        },
        {
            "location": "167/TALK",
            "narrator": "神楽",
            "text": "そういえば",
            "zh": "说起来",
            "narrator_zh": "神乐"
        },
        {
            "location": "168/TALK",
            "narrator": "神楽",
            "text": "私はこの世界では2016年のハイティを演じる必要があるんです\n女子高生です",
            "zh": "我在这个世界里必须扮演2016年的High-T才行\n也就是女高中生",
            "narrator_zh": "神乐"
        },
        {
            "location": "169/TALK",
            "narrator": "神楽",
            "text": "それに付き合ってくれるなら多少の譲歩はするつもりです",
            "zh": "如果你愿意配合，我也打算做些让步",
            "narrator_zh": "神乐"
        },
        {
            "location": "171/SEL",
            "narrator": "",
            "text": "はい喜んで！！！",
            "zh": "好，我很乐意！！！",
            "narrator_zh": ""
        },
        {
            "location": "172/SEL",
            "narrator": "",
            "text": "その展開待ってた！",
            "zh": "就等这个发展！",
            "narrator_zh": ""
        },
        {
            "location": "173/SEL",
            "narrator": "",
            "text": "仕方ないから付き合うよ",
            "zh": "没办法，我陪你吧",
            "narrator_zh": ""
        },
        {
            "location": "174/ACT",
            "narrator": "",
            "text": "はい喜んで！！！",
            "zh": "好，我很乐意！！！",
            "narrator_zh": ""
        },
        {
            "location": "175/TALK",
            "narrator": "神楽",
            "text": "じゃあよろしく",
            "zh": "那就拜托你了",
            "narrator_zh": "神乐"
        },
        {
            "location": "176/ACT",
            "narrator": "",
            "text": "その展開待ってた！",
            "zh": "就等这个发展！",
            "narrator_zh": ""
        },
        {
            "location": "177/TALK",
            "narrator": "神楽",
            "text": "随分乗り気ですね",
            "zh": "你倒是挺积极的嘛",
            "narrator_zh": "神乐"
        },
        {
            "location": "178/TALK",
            "narrator": "神楽",
            "text": "助かりますけど",
            "zh": "虽然这样挺帮大忙的",
            "narrator_zh": "神乐"
        },
        {
            "location": "179/ACT",
            "narrator": "",
            "text": "仕方ないから付き合うよ",
            "zh": "没办法，我陪你吧",
            "narrator_zh": ""
        },
        {
            "location": "180/TALK",
            "narrator": "神楽",
            "text": "まあそういうものですよね",
