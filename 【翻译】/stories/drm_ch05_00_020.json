        },
        {
            "location": "154/SEL",
            "narrator": "",
            "text": "できれば",
            "zh": "可以的话",
            "narrator_zh": ""
        },
        {
            "location": "155/SEL",
            "narrator": "",
            "text": "いやならいいけど……",
