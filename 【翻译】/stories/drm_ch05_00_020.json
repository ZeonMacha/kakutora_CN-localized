    "entry": [
        {
            "location": "121/SCENARIO",
            "narrator": "",
            "text": "すぐにわかることだけど",
            "zh": "这虽是显而易见的，但……",
            "narrator_zh": ""
        },
        {
            "location": "130/TALK",
            "narrator": "神楽",
            "text": "この世界にも\nあるのかな……。",
            "zh": "这个世界里\n也有吗……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "132/TALK",
            "narrator": "神楽",
            "text": "なんて。\nあるに決まってるけど。",
            "zh": "什么嘛。\n当然会有了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "133/TALK",
            "narrator": "神楽",
            "text": "やっぱり行かない方が\nいいのかな…。",
            "zh": "果然还是不去\n比较好吗……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "134/SEL",
            "narrator": "",
            "text": "どこ行くの？",
            "zh": "要去哪里？",
            "narrator_zh": ""
        },
        {
