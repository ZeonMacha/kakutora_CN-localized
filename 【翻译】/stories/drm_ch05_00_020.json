        },
        {
            "location": "157/ACT",
            "narrator": "",
            "text": "できれば",
            "zh": "可以的话",
            "narrator_zh": ""
        },
        {
            "location": "158/TALK",
            "narrator": "神楽",
            "text": "なるほど",
            "zh": "原来如此",
