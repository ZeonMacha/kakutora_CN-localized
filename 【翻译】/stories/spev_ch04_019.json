{
    "dir": "chap00/daydra/spev_ch04_019.js",
    "type": "EventQuest",
    "info": {
        "story_id": "91012",
        "cid": "miyabi",
        "title": "【期間限定】誕生日イベント",
        "sub_title": "みやびの誕生日",
        "title_zh": "【限时】生日活动",
        "sub_title_zh": "雅的生日"
    },
    "entry": [
        {
            "location": "8/SCENARIO",
            "narrator": "",
            "text": "みやびの誕生日（復元）",
            "zh": "雅的生日（复原）",
            "narrator_zh": ""
        },
        {
            "location": "20/TALK",
            "narrator": "みやび",
            "text": "む？\nなんぞこれは……",
            "zh": "嗯？\n这是驷马玩意……",
            "narrator_zh": "雅"
        },
        {
            "location": "22/SEL",
            "narrator": "",
            "text": "お誕生日おめでとう！",
            "zh": "生日快乐！",
            "narrator_zh": ""
        },
        {
            "location": "23/ACT",
            "narrator": "",
            "text": "お誕生日おめでとう！",
            "zh": "生日快乐！",
            "narrator_zh": ""
        },
        {
            "location": "25/TALK",
            "narrator": "みやび",
            "text": "おおっ！\nそうか！",
            "zh": "哦哦！\n对啊！",
            "narrator_zh": "雅"
        },
        {
            "location": "26/TALK",
            "narrator": "みやび",
            "text": "そういえば確かに、\nうちの誕生日は\n7月27日やったね。",
            "zh": "说起来确实，\n我的生日就是\n7月27日咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "27/TALK",
            "narrator": "みやび",
            "text": "普段誰も目出度がらんき、\n完全に忘れちょった。",
            "zh": "平时也没谁跟着道贺啵，\n我都给忘个精光了。",
            "narrator_zh": "雅"
        },
        {
            "location": "28/SEL",
            "narrator": "",
            "text": "プレゼントあるよ",
            "zh": "有礼物哦",
            "narrator_zh": ""
        },
        {
            "location": "29/ACT",
            "narrator": "",
            "text": "プレゼントあるよ",
            "zh": "有礼物哦",
            "narrator_zh": ""
        },
        {
            "location": "31/TALK",
            "narrator": "みやび",
            "text": "マジか！",
            "zh": "真的咩！",
            "narrator_zh": "雅"
        },
        {
            "location": "34/TALK",
            "narrator": "みやび",
            "text": "まさか、相棒から\nこのようなものを\nもらう事になるとは……",
            "zh": "真没想到，居然能从\n搭档这儿收到\n这样的东西……",
            "narrator_zh": "雅"
        },
        {
            "location": "35/TALK",
            "narrator": "みやび",
            "text": "しかしあれか。\nここは定番の――",
            "zh": "不过怎么讲呢。\n这时候是不是该走套路——",
            "narrator_zh": "雅"
        },
        {
            "location": "36/TALK",
            "narrator": "みやび",
            "text": "開けていい？",
            "zh": "可以打开吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "37/TALK",
            "narrator": "みやび",
            "text": "……という、\n嬉し恥ずかしイベントを\nやるべきなんやろか。",
            "zh": "……来一段\n又羞又喜的过场戏，\n才对味咩。",
            "narrator_zh": "雅"
        },
        {
            "location": "38/SEL",
            "narrator": "",
            "text": "もちろん開けて！",
            "zh": "当然可以，打开吧！",
            "narrator_zh": ""
        },
        {
            "location": "39/ACT",
            "narrator": "",
            "text": "もちろん開けて！",
            "zh": "当然可以，打开吧！",
            "narrator_zh": ""
        },
        {
            "location": "41/TALK",
            "narrator": "みやび",
            "text": "う、うむ……。",
            "zh": "嗯、嗯哼……。",
            "narrator_zh": "雅"
        },
        {
            "location": "42/TALK",
            "narrator": "みやび",
            "text": "けんど、あれやぞ！\nうちはまだ、開けていい？\nと言ったわけではない。",
            "zh": "但是，话说在前头啊！\n我刚才可还没真说过\n「可以打开吗？」啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "43/TALK",
            "narrator": "みやび",
            "text": "そのことだけは\n努々忘れるな。",
            "zh": "唯独这一点\n你千万给我记牢了。",
            "narrator_zh": "雅"
        },
        {
            "location": "52/DIALOG",
            "narrator": "",
            "text": "みやびのコスチューム\n<size=40><color=red><b>おかざリップ</b></color></size>\nをゲットしました！",
            "zh": "雅的服装\n<size=40><color=red><b>装饰唇</b></color></size>\n拿到了！[?]",
            "narrator_zh": ""
        },
        {
            "location": "55/TALK",
            "narrator": "みやび",
            "text": "おおっ！\nこれは――",
            "zh": "哦哦！\n这是——",
            "narrator_zh": "雅"
        },
        {
            "location": "57/TALK",
            "narrator": "みやび",
            "text": "さすがうちの相棒や！\nなんという\n独特のセンス！！",
            "zh": "不愧是我的搭档咯！\n这真是何等\n独特的品味！！",
            "narrator_zh": "雅"
        },
        {
            "location": "58/TALK",
            "narrator": "みやび",
            "text": "こんなものをプレゼント\nされるなど、予想だに\nせんかったぞね！",
            "zh": "压根儿没料到\n会收到这种东西\n当礼物咧！",
            "narrator_zh": "雅"
        },
        {
            "location": "59/TALK",
            "narrator": "みやび",
            "text": "こんなサプライズ誕生日\nは\n初めてや……。",
            "zh": "这么惊喜的生日\n还是\n头一回咯……。",
            "narrator_zh": "雅"
        },
        {
            "location": "60/TALK",
            "narrator": "みやび",
            "text": "ありがとね…。",
            "zh": "谢谢咯……。",
            "narrator_zh": "雅"
        },
        {
            "location": "66/DIALOG",
            "narrator": "",
            "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n接続されました。\n\n画面をタップして相手に\n感覚を伝えましょう。",
            "zh": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\n触摸交流\n已连接。\n\n请点击画面，向对方\n传达感觉吧。",
            "narrator_zh": ""
        },
        {
            "location": "84/TALK",
            "narrator": "みやび",
            "text": "はあっ……。",
            "zh": "哈啊……。",
            "narrator_zh": "雅"
        },
        {
            "location": "85/TALK",
            "narrator": "みやび",
            "text": "なんぞ、今日のナデは\nいつもと違うて\nゾクゾクするぞね…。",
            "zh": "做驷马呀，今天的抚摸\n跟平时不一样，\n摸得我酥酥麻麻咧……。",
            "narrator_zh": "雅"
        },
        {
            "location": "88/DIALOG",
            "narrator": "",
            "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n切断されました。",
            "zh": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\n触摸交流\n已断开。",
            "narrator_zh": ""
        },
        {
            "location": "89/TALK",
            "narrator": "みやび",
            "text": "はあっ……\nな、なんかまだ\nドキドキしゆう。",
            "zh": "哈啊……\n总、总觉得心跳\n还在扑通扑通跳着。",
            "narrator_zh": "雅"
        },
        {
            "location": "90/TALK",
            "narrator": "みやび",
            "text": "まっこと、\n心臓に悪い相棒やね。",
            "zh": "真是的，\n真是个折腾心脏的搭档咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "91/SEL",
            "narrator": "",
            "text": "いつもと同じだけど？",
            "zh": "跟平时一样啊？",
            "narrator_zh": ""
        },
        {
            "location": "92/SEL",
            "narrator": "",
            "text": "いつもの倍マジで愛情込めて\nタッチしました！",
            "zh": "带着比平时多一倍的真爱\n认真触摸了！",
            "narrator_zh": ""
        },
        {
            "location": "93/ACT",
            "narrator": "",
            "text": "いつもと同じだけど？",
            "zh": "跟平时一样啊？",
            "narrator_zh": ""
        },
        {
            "location": "94/ACT",
            "narrator": "",
            "text": "いつもの倍マジで愛情込めて\nタッチしました！",
            "zh": "带着比平时多一倍的真爱\n认真触摸了！",
            "narrator_zh": ""
        },
        {
            "location": "95/TALK",
            "narrator": "みやび",
            "text": "まったく。そんなこと\nするから、うちの心臓に\n負荷がかかる。",
            "zh": "真是的。就因为你\n干这种事，我的心脏\n才受了这么大负荷。",
            "narrator_zh": "雅"
        },
        {
            "location": "96/TALK",
            "narrator": "みやび",
            "text": "ちゃんと責任とって\n身のまわりの介護を\nしいや。",
            "zh": "你可要负起责任来，\n好好照料我的\n日常起居咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "98/TALK",
            "narrator": "みやび",
            "text": "とまあ、\nそんな戯れ言は\nこれくらいにして。",
            "zh": "咳嘛，\n这种胡扯玩笑\n就先到这儿。",
            "narrator_zh": "雅"
        },
        {
            "location": "99/TALK",
            "narrator": "みやび",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "雅"
        },
        {
            "location": "100/TALK",
            "narrator": "みやび",
            "text": "今回はほんと、\nありがとな。\nまっこと嬉しかったぞね。",
            "zh": "这一回真的，\n谢啦。\n我可蛮开心咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "101/TALK",
            "narrator": "みやび",
            "text": "これからもずっと、\nうちの相棒でいてや。",
            "zh": "今后也一直\n做我的搭档咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "104/DIALOG",
            "narrator": "",
            "text": "コスチューム\n<color=green>【おかざリップ】</color>は、\n夜時間にパジャマとして\n着せることができます。",
            "zh": "服装\n<color=green>【装饰唇】</color>\n可以在夜晚时段当作睡衣\n穿上。[?]",
            "narrator_zh": ""
        }
    ]
}
