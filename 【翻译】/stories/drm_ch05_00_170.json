  "title": "らぶとーく 第17話",
  "sub_title": "バーチャルプラネットのアリス"
 },
 "entry": [
  {
   "location": "864/SCENARIO",
   "narrator": "",
   "text": "バーチャルプラネットのアリス"
  },
  {
   "location": "882/TALK",
   "narrator": "つばめ",
   "text": "メノウちゃんの曲\nやっぱりいいなー。"
  },
  {
   "location": "884/TALK",
   "narrator": "神楽",
   "text": "……。"
  },
  {
   "location": "886/TALK",
   "narrator": "みやび",
   "text": "つばめちゃんは本当に\nメノウのことが\n好きなんやねえ。",
   "zh": "燕真的很喜欢\n玛瑙呢。\n",
   "narrator_zh": "雅"
  },
  {
   "location": "888/TALK",
   "narrator": "つばめ",
   "text": "もちろんです！",
   "zh": "当然啦！",
   "narrator_zh": "燕"
  },
  {
   "location": "890/TALK",
   "narrator": "つばめ",
   "text": "曲も声もアレンジも\nステキですけど。"
  },
  {
   "location": "891/TALK",
   "narrator": "つばめ",
   "text": "アルバムを通して\nひとつの物語に\nなってるところ！"
  },
  {
   "location": "892/TALK",
   "narrator": "つばめ",
   "text": "何度聞いても\n同じところで\nドキドキして…。"
  },
  {
   "location": "893/SEL",
   "narrator": "",
   "text": "目の前で褒められる気分はどう？",
   "zh": "当着面被夸奖感觉如何？",
   "narrator_zh": ""
  },
  {
   "location": "894/ACT",
   "narrator": "",
   "text": "目の前で褒められる気分はどう？",
   "zh": "当着面被夸奖感觉如何？",
   "narrator_zh": ""
  },
  {
   "location": "911/TALK",
   "narrator": "神楽",
   "text": "どう答えれば満足ですか？",
   "zh": "怎么回答你才满意？",
   "narrator_zh": "神乐"
  },
  {
   "location": "913/SEL",
   "narrator": "",
   "text": "機嫌悪いの？",
   "zh": "你心情不好？",
   "narrator_zh": ""
  },
  {
   "location": "914/SEL",
   "narrator": "",
   "text": "なんかごめんね",
   "zh": "有点抱歉啊",
   "narrator_zh": ""
  },
  {
   "location": "915/SEL",
   "narrator": "",
   "text": "うれしいですよ！　とか？",
   "zh": "“我很高兴哦！”　之类的？",
   "narrator_zh": ""
  },
  {
   "location": "916/ACT",
   "narrator": "",
   "text": "機嫌悪いの？",
   "zh": "你心情不好？",
   "narrator_zh": ""
  },
  {
   "location": "917/TALK",
   "narrator": "神楽",
   "text": "そういうわけではないですけどー",
   "zh": "也不是那么回事啦——",
   "narrator_zh": "神乐"
  },
  {
   "location": "918/ACT",
   "narrator": "",
   "text": "なんかごめんね",
   "zh": "有点抱歉啊",
   "narrator_zh": ""
  },
  {
   "location": "919/TALK",
   "narrator": "神楽",
   "text": "謝る必要なんて全然ないですよ？"
  },
  {
   "location": "920/ACT",
   "narrator": "",
   "text": "うれしいですよ！　とか？",
   "zh": "“我很高兴哦！”　之类的？",
   "narrator_zh": ""
  },
  {
   "location": "921/TALK",
   "narrator": "神楽",
   "text": "あんまりそういう気分にはならないですね"
  },
  {
   "location": "923/TALK",
   "narrator": "神楽",
   "text": "つばめさんは私がメノウだって知らないわけですし",
   "zh": "燕又不知道我是玛瑙",
   "narrator_zh": "神乐"
  },
  {
   "location": "924/TALK",
   "narrator": "神楽",
   "text": "リサーチ材料にするくらいですかね"
  },
  {
   "location": "926/SEL",
   "narrator": "",
   "text": "冷静なんだね",
   "zh": "你还挺冷静呢",
   "narrator_zh": ""
  },
  {
   "location": "927/SEL",
   "narrator": "",
   "text": "ドライだなあ",
   "zh": "真洒脱啊",
   "narrator_zh": ""
  },
  {
   "location": "928/SEL",
   "narrator": "",
   "text": "本当は嬉しいでしょ？",
   "zh": "其实你很高兴吧？",
   "narrator_zh": ""
  },
  {
   "location": "929/ACT",
   "narrator": "",
   "text": "冷静なんだね",
   "zh": "你还挺冷静呢",
   "narrator_zh": ""
  },
  {
   "location": "930/TALK",
   "narrator": "神楽",
   "text": "そうですね",
   "zh": "是啊",
   "narrator_zh": "神乐"
  },
  {
   "location": "931/TALK",
   "narrator": "神楽",
   "text": "そうじゃないとアーティストではいられませんからね",
   "zh": "不那样就当不了艺术家了呢",
   "narrator_zh": "神乐"
  },
  {
   "location": "932/ACT",
   "narrator": "",
   "text": "ドライだなあ",
   "zh": "真洒脱啊",
   "narrator_zh": ""
  },
  {
   "location": "933/TALK",
   "narrator": "神楽",
   "text": "そうでしょうか？",
   "zh": "是这样吗？",
   "narrator_zh": "神乐"
  },
  {
   "location": "934/TALK",
   "narrator": "神楽",
   "text": "正しい対処だと思いますけど"
  },
  {
   "location": "935/ACT",
   "narrator": "",
   "text": "本当は嬉しいでしょ？",
   "zh": "其实你很高兴吧？",
   "narrator_zh": ""
  },
  {
   "location": "936/TALK",
   "narrator": "神楽",
   "text": "そこは微妙ですね",
   "zh": "那里很微妙呢",
   "narrator_zh": "神乐"
  },
  {
   "location": "937/TALK",
   "narrator": "神楽",
   "text": "いつの時期のメノウかにもよりますし"
  },
  {
   "location": "951/TALK",
   "narrator": "みやび",
   "text": "つばめちゃんがメノウを\n好きなことは\nようわかった。",
   "zh": "燕喜欢玛瑙，\n这点我\n很清楚咯。",
   "narrator_zh": "雅"
  },
  {
   "location": "953/TALK",
   "narrator": "つばめ",
   "text": "えへへ……。",
   "zh": "嘿嘿……。",
   "narrator_zh": "燕"
  },
  {
   "location": "954/TALK",
   "narrator": "神楽",
   "text": "私少し疑問に\n思ってることが\nあるんですけど。"
  },
  {
   "location": "956/TALK",
   "narrator": "みやび",
   "text": "うむ。"
  },
  {
   "location": "958/TALK",
   "narrator": "つばめ",
   "text": "何？"
  },
  {
   "location": "959/TALK",
   "narrator": "神楽",
   "text": "例えばメノウのアルバムは\n最初から創作じゃ\nないですか。"
  },
  {
   "location": "960/TALK",
   "narrator": "神楽",
   "text": "ある意味嘘です。\nでもそれを聴いて\n人は感動する。"
  },
  {
   "location": "962/TALK",
   "narrator": "つばめ",
   "text": "うん。\nだって本当に\nすごいんだもん！"
  },
  {
   "location": "963/TALK",
   "narrator": "神楽",
   "text": "……。"
  },
  {
   "location": "964/TALK",
   "narrator": "神楽",
   "text": "でも実話の場合は\nちょっと反応が\n変わってきますよね。",
   "zh": "不过如果是真实故事，\n反应会有点\n不一样呢。",
   "narrator_zh": "神乐"
  },
  {
   "location": "965/TALK",
   "narrator": "つばめ",
   "text": "どういうこと？",
   "zh": "怎么回事？",
   "narrator_zh": "燕"
  },
  {
   "location": "966/TALK",
   "narrator": "神楽",
   "text": "実話だと言われた\n話の内容が人の心を\n動かしたとしても。"
  },
  {
   "location": "967/TALK",
   "narrator": "神楽",
   "text": "それが創作だとわかれば\n人は怒りを覚えます。",
   "zh": "如果知道那是创作，\n人们就会感到愤怒。",
   "narrator_zh": "神乐"
  },
  {
   "location": "968/TALK",
   "narrator": "神楽",
   "text": "この差はどこから\n来るんでしょうね？",
   "zh": "这差别到底\n是从哪来的呢？",
   "narrator_zh": "神乐"
  },
  {
   "location": "969/TALK",
   "narrator": "みやび",
   "text": "嘘をつかれたと\n思うからや\nないかねえ。"
  },
  {
   "location": "970/TALK",
   "narrator": "みやび",
   "text": "裏切られた気持ちに\nなるからやない？"
  },
  {
   "location": "972/TALK",
   "narrator": "つばめ",
   "text": "…優しい嘘って\nありますよね。",
   "zh": "……世上是有\n善意的谎言吧。",
   "narrator_zh": "燕"
  },
  {
   "location": "973/TALK",
   "narrator": "つばめ",
   "text": "その場合もバレたら\n怒っちゃうもの\nなんでしょうか？",
   "zh": "那种情况被发现的话\n也还是会\n生气的吧？",
   "narrator_zh": "燕"
  },
  {
   "location": "974/TALK",
   "narrator": "神楽",
   "text": "…………。"
  },
  {
   "location": "975/TALK",
   "narrator": "みやび",
   "text": "うちは内容に\nよるねえ。"
  },
  {
   "location": "976/TALK",
   "narrator": "みやび",
   "text": "遅刻しそうごめん\nちうて連絡した時に\n自分もだよとか。"
  },
  {
   "location": "977/TALK",
   "narrator": "みやび",
   "text": "そういうのは\n優しいねえと\n思うしねえ。",
   "zh": "那种地方\n我觉得\n很温柔咯。",
   "narrator_zh": "雅"
  },
  {
   "location": "979/TALK",
   "narrator": "つばめ",
   "text": "えっ！？",
   "zh": "诶！？",
   "narrator_zh": "燕"
  },
  {
   "location": "980/TALK",
   "narrator": "つばめ",
   "text": "わたしはそういう時は\n本当に\n遅刻してますよ？"
  },
  {
   "location": "982/TALK",
   "narrator": "みやび",
   "text": "まあつばめちゃんは\nそうやろうけど。"
  },
  {
   "location": "983/TALK",
   "narrator": "みやび",
   "text": "アーヤがそう返して\n来た時は多分嘘ぞね。"
  },
  {
   "location": "984/TALK",
   "narrator": "つばめ",
   "text": "確かにそうかも\nしれません……。"
  },
  {
   "location": "987/TALK",
   "narrator": "みやび",
   "text": "卯月はどうぞね？"
  },
  {
   "location": "988/TALK",
   "narrator": "神楽",
   "text": "私ですか？"
  },
  {
   "location": "989/SEL",
   "narrator": "",
   "text": "$me$が答えを当ててあげる",
   "zh": "$me$来猜答案",
   "narrator_zh": ""
  },
  {
   "location": "990/ACT",
   "narrator": "",
   "text": "$me$が答えを当ててあげる",
   "zh": "$me$来猜答案",
   "narrator_zh": ""
  },
  {
   "location": "1007/SEL",
   "narrator": "",
   "text": "嘘、ダメ、絶対",
   "zh": "撒谎、不行、绝对",
   "narrator_zh": ""
  },
  {
   "location": "1008/SEL",
   "narrator": "",
   "text": "ケースバイケース",
   "zh": "看情况吧",
   "narrator_zh": ""
  },
  {
   "location": "1009/SEL",
   "narrator": "",
   "text": "むしろ全てが嘘",
   "zh": "还不如全都是假的",
   "narrator_zh": ""
  },
  {
   "location": "1010/ACT",
   "narrator": "",
   "text": "嘘、ダメ、絶対",
   "zh": "撒谎、不行、绝对",
   "narrator_zh": ""
  },
  {
   "location": "1011/TALK",
   "narrator": "神楽",
   "text": "そんなに潔癖でも子供でもないですよ？",
   "zh": "我也没那么洁癖也没那么幼稚哦？",
   "narrator_zh": "神乐"
  },
  {
   "location": "1012/ACT",
   "narrator": "",
   "text": "ケースバイケース",
   "zh": "看情况吧",
   "narrator_zh": ""
  },
  {
   "location": "1013/TALK",
   "narrator": "神楽",
   "text": "それってどっちでもいいってことですよねー",
   "zh": "那是说哪个都行吧——",
   "narrator_zh": "神乐"
  },
  {
   "location": "1014/ACT",
   "narrator": "",
   "text": "むしろ全てが嘘",
   "zh": "还不如全都是假的",
   "narrator_zh": ""
  },
  {
   "location": "1015/TALK",
   "narrator": "神楽",
   "text": "いっそそう言えればどれだけ楽なことか！"
  },
  {
   "location": "1027/TALK",
   "narrator": "神楽",
   "text": "ちょっとすぐには\n答えが出ないです。",
   "zh": "这个一时半会儿\n答不上来。",
   "narrator_zh": "神乐"
  },
  {
   "location": "1028/TALK",
   "narrator": "みやび",
   "text": "…卯月は真面目\nなんやねえ。",
   "zh": "……卯月还真是\n认真咯。",
   "narrator_zh": "雅"
  },
  {
   "location": "1031/TALK",
   "narrator": "神楽",
   "text": "そういうわけじゃ\nないんですけど…。",
   "zh": "也不是\n那么回事……。",
   "narrator_zh": "神乐"
  },
  {
   "location": "1033/TALK",
   "narrator": "みやび",
   "text": "つばめちゃんは？",
   "zh": "燕呢？",
   "narrator_zh": "雅"
  },
  {
   "location": "1034/TALK",
   "narrator": "つばめ",
   "text": "わたしは……。"
  },
  {
   "location": "1035/TALK",
   "narrator": "つばめ",
   "text": "嘘をつかれたことは\nさみしいって思います。"
  },
  {
   "location": "1036/TALK",
   "narrator": "つばめ",
   "text": "でも、理由が\nわたしを思っての\nことなら。",
   "zh": "不过，如果那理由\n是为我\n着想的",
   "narrator_zh": "燕"
  },
  {
   "location": "1037/TALK",
   "narrator": "つばめ",
   "text": "その気持ちは\nうれしいかもです。",
   "zh": "那份心情\n我挺高兴的。",
   "narrator_zh": "燕"
  },
  {
   "location": "1038/TALK",
   "narrator": "みやび",
   "text": "つばめちゃんは\nえい子やねえ。",
   "zh": "燕真是\n个好孩子嘛。",
   "narrator_zh": "雅"
  },
  {
   "location": "1040/TALK",
   "narrator": "つばめ",
   "text": "そ、そんなこと\nないですよ……！？",
   "zh": "不、不会有\n那种事啦……！？",
   "narrator_zh": "燕"
  },
  {
   "location": "1043/TALK",
   "narrator": "神楽",
   "text": "………………。"
  },
  {
   "location": "873/DIALOG",
   "narrator": "Dialog_EventData",
   "text": "<color=green>某月某日　0:20 PM</color>\nとある平日、付属学園食堂でのこと"
  }
 ]
}
