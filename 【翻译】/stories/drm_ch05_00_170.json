{
    "dir": "dramatics/daydra/drm_ch05_00_170.js",
    "type": "Episode",
    "info": {
        "story_id": "5017",
        "cid": "kagura",
        "title": "らぶとーく 第17話",
        "sub_title": "バーチャルプラネットのアリス",
        "title_zh": "恋爱漫谈 第17话",
        "sub_title_zh": "虚拟星球的爱丽丝"
    },
    "entry": [
        {
            "location": "864/SCENARIO",
            "narrator": "",
            "text": "バーチャルプラネットのアリス",
            "zh": "虚拟星球的爱丽丝",
            "narrator_zh": ""
        },
        {
            "location": "882/TALK",
            "narrator": "つばめ",
            "text": "メノウちゃんの曲\nやっぱりいいなー。",
            "zh": "MENOW的歌\n果然好好听啊——。",
            "narrator_zh": "燕"
        },
        {
            "location": "884/TALK",
            "narrator": "神楽",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "886/TALK",
            "narrator": "みやび",
            "text": "つばめちゃんは本当に\nメノウのことが\n好きなんやねえ。",
            "zh": "燕真的很喜欢\nMENOW呢。\n",
            "narrator_zh": "雅"
        },
        {
            "location": "888/TALK",
            "narrator": "つばめ",
            "text": "もちろんです！",
            "zh": "当然啦！",
            "narrator_zh": "燕"
        },
        {
            "location": "890/TALK",
            "narrator": "つばめ",
            "text": "曲も声もアレンジも\nステキですけど。",
            "zh": "曲子、歌声和编曲\n都很棒啦。",
            "narrator_zh": "燕"
        },
        {
            "location": "891/TALK",
            "narrator": "つばめ",
            "text": "アルバムを通して\nひとつの物語に\nなってるところ！",
            "zh": "还有整张专辑\n串联成一个完整\n故事的地方！",
            "narrator_zh": "燕"
        },
        {
            "location": "892/TALK",
            "narrator": "つばめ",
            "text": "何度聞いても\n同じところで\nドキドキして…。",
            "zh": "不管听多少遍，\n还是会在同一个地方\n心动不已……。",
            "narrator_zh": "燕"
        },
        {
            "location": "893/SEL",
            "narrator": "",
            "text": "目の前で褒められる気分はどう？",
            "zh": "当着面被夸奖感觉如何？",
            "narrator_zh": ""
        },
        {
            "location": "894/ACT",
            "narrator": "",
            "text": "目の前で褒められる気分はどう？",
            "zh": "当着面被夸奖感觉如何？",
            "narrator_zh": ""
        },
        {
            "location": "911/TALK",
            "narrator": "神楽",
            "text": "どう答えれば満足ですか？",
            "zh": "怎么回答你才满意？",
            "narrator_zh": "神乐"
        },
        {
            "location": "913/SEL",
            "narrator": "",
            "text": "機嫌悪いの？",
            "zh": "你心情不好？",
            "narrator_zh": ""
        },
        {
            "location": "914/SEL",
            "narrator": "",
            "text": "なんかごめんね",
            "zh": "有点抱歉啊",
            "narrator_zh": ""
        },
        {
            "location": "915/SEL",
            "narrator": "",
            "text": "うれしいですよ！　とか？",
            "zh": "“我很高兴哦！”　之类的？",
            "narrator_zh": ""
        },
        {
            "location": "916/ACT",
            "narrator": "",
            "text": "機嫌悪いの？",
            "zh": "你心情不好？",
            "narrator_zh": ""
        },
        {
            "location": "917/TALK",
            "narrator": "神楽",
            "text": "そういうわけではないですけどー",
            "zh": "也不是那么回事啦——",
            "narrator_zh": "神乐"
        },
        {
            "location": "918/ACT",
            "narrator": "",
            "text": "なんかごめんね",
            "zh": "有点抱歉啊",
            "narrator_zh": ""
        },
        {
            "location": "919/TALK",
            "narrator": "神楽",
            "text": "謝る必要なんて全然ないですよ？",
            "zh": "完全没有必要道歉哦？",
            "narrator_zh": "神乐"
        },
        {
            "location": "920/ACT",
            "narrator": "",
            "text": "うれしいですよ！　とか？",
            "zh": "“我很高兴哦！”　之类的？",
            "narrator_zh": ""
        },
        {
            "location": "921/TALK",
            "narrator": "神楽",
            "text": "あんまりそういう気分にはならないですね",
            "zh": "不太会有那种心情呢",
            "narrator_zh": "神乐"
        },
        {
            "location": "923/TALK",
            "narrator": "神楽",
            "text": "つばめさんは私がメノウだって知らないわけですし",
            "zh": "燕又不知道我是MENOW",
            "narrator_zh": "神乐"
        },
        {
            "location": "924/TALK",
            "narrator": "神楽",
            "text": "リサーチ材料にするくらいですかね",
            "zh": "最多当成调研材料吧",
            "narrator_zh": "神乐"
        },
        {
            "location": "926/SEL",
            "narrator": "",
            "text": "冷静なんだね",
            "zh": "你还挺冷静呢",
            "narrator_zh": ""
        },
        {
            "location": "927/SEL",
            "narrator": "",
            "text": "ドライだなあ",
            "zh": "真洒脱啊",
            "narrator_zh": ""
        },
        {
            "location": "928/SEL",
            "narrator": "",
            "text": "本当は嬉しいでしょ？",
            "zh": "其实你很高兴吧？",
            "narrator_zh": ""
        },
        {
            "location": "929/ACT",
            "narrator": "",
            "text": "冷静なんだね",
            "zh": "你还挺冷静呢",
            "narrator_zh": ""
        },
        {
            "location": "930/TALK",
            "narrator": "神楽",
            "text": "そうですね",
            "zh": "是啊",
            "narrator_zh": "神乐"
        },
        {
            "location": "931/TALK",
            "narrator": "神楽",
            "text": "そうじゃないとアーティストではいられませんからね",
            "zh": "不那样就当不了艺术家了呢",
            "narrator_zh": "神乐"
        },
        {
            "location": "932/ACT",
            "narrator": "",
            "text": "ドライだなあ",
            "zh": "真洒脱啊",
            "narrator_zh": ""
        },
        {
            "location": "933/TALK",
            "narrator": "神楽",
            "text": "そうでしょうか？",
            "zh": "是这样吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "934/TALK",
            "narrator": "神楽",
            "text": "正しい対処だと思いますけど",
            "zh": "我觉得这是正确的处理方式呀",
            "narrator_zh": "神乐"
        },
        {
            "location": "935/ACT",
            "narrator": "",
            "text": "本当は嬉しいでしょ？",
            "zh": "其实你很高兴吧？",
            "narrator_zh": ""
        },
        {
            "location": "936/TALK",
            "narrator": "神楽",
            "text": "そこは微妙ですね",
            "zh": "那里很微妙呢",
            "narrator_zh": "神乐"
        },
        {
            "location": "937/TALK",
            "narrator": "神楽",
            "text": "いつの時期のメノウかにもよりますし",
            "zh": "而且这也取决于是指哪个时期的MENOW",
            "narrator_zh": "神乐"
        },
        {
            "location": "951/TALK",
            "narrator": "みやび",
            "text": "つばめちゃんがメノウを\n好きなことは\nようわかった。",
            "zh": "燕喜欢MENOW，\n这点我\n很清楚咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "953/TALK",
            "narrator": "つばめ",
            "text": "えへへ……。",
            "zh": "嘿嘿……。",
            "narrator_zh": "燕"
        },
        {
            "location": "954/TALK",
            "narrator": "神楽",
            "text": "私少し疑問に\n思ってることが\nあるんですけど。",
            "zh": "不过我倒是有件事\n一直觉得\n有点疑问。",
            "narrator_zh": "神乐"
        },
        {
            "location": "956/TALK",
            "narrator": "みやび",
            "text": "うむ。",
            "zh": "嗯。",
            "narrator_zh": "雅"
        },
        {
            "location": "958/TALK",
            "narrator": "つばめ",
            "text": "何？",
            "zh": "什么事？",
            "narrator_zh": "燕"
        },
        {
            "location": "959/TALK",
            "narrator": "神楽",
            "text": "例えばメノウのアルバムは\n最初から創作じゃ\nないですか。",
            "zh": "比方说MENOW的专辑\n打一开始不就是\n虚构创作吗。",
            "narrator_zh": "神乐"
        },
        {
            "location": "960/TALK",
            "narrator": "神楽",
            "text": "ある意味嘘です。\nでもそれを聴いて\n人は感動する。",
            "zh": "某种意义上是谎言。\n但人们听了它\n还是会感动。",
            "narrator_zh": "神乐"
        },
        {
            "location": "962/TALK",
            "narrator": "つばめ",
            "text": "うん。\nだって本当に\nすごいんだもん！",
            "zh": "嗯。\n因为真的\n好厉害嘛！",
            "narrator_zh": "燕"
        },
        {
            "location": "963/TALK",
            "narrator": "神楽",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "964/TALK",
            "narrator": "神楽",
            "text": "でも実話の場合は\nちょっと反応が\n変わってきますよね。",
            "zh": "不过如果是真实故事，\n反应会有点\n不一样呢。",
            "narrator_zh": "神乐"
        },
        {
            "location": "965/TALK",
            "narrator": "つばめ",
            "text": "どういうこと？",
            "zh": "怎么回事？",
            "narrator_zh": "燕"
        },
        {
            "location": "966/TALK",
            "narrator": "神楽",
            "text": "実話だと言われた\n話の内容が人の心を\n動かしたとしても。",
            "zh": "哪怕被说成是真人真事的\n内容真的打动了\n人心，",
            "narrator_zh": "神乐"
        },
        {
            "location": "967/TALK",
            "narrator": "神楽",
            "text": "それが創作だとわかれば\n人は怒りを覚えます。",
            "zh": "如果知道那是创作，\n人们就会感到愤怒。",
            "narrator_zh": "神乐"
        },
        {
            "location": "968/TALK",
            "narrator": "神楽",
            "text": "この差はどこから\n来るんでしょうね？",
            "zh": "这差别到底\n是从哪来的呢？",
            "narrator_zh": "神乐"
        },
        {
            "location": "969/TALK",
            "narrator": "みやび",
            "text": "嘘をつかれたと\n思うからや\nないかねえ。",
            "zh": "大概是因为觉得\n被人骗了\n不是咩。",
            "narrator_zh": "雅"
        },
        {
            "location": "970/TALK",
            "narrator": "みやび",
            "text": "裏切られた気持ちに\nなるからやない？",
            "zh": "因为会有种被背叛的感觉\n不是咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "972/TALK",
            "narrator": "つばめ",
            "text": "…優しい嘘って\nありますよね。",
            "zh": "……世上是有\n善意的谎言吧。",
            "narrator_zh": "燕"
        },
        {
            "location": "973/TALK",
            "narrator": "つばめ",
            "text": "その場合もバレたら\n怒っちゃうもの\nなんでしょうか？",
            "zh": "那种情况被发现的话\n也还是会\n生气的吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "974/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "975/TALK",
            "narrator": "みやび",
            "text": "うちは内容に\nよるねえ。",
            "zh": "我的话，要看\n内容咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "976/TALK",
            "narrator": "みやび",
            "text": "遅刻しそうごめん\nちうて連絡した時に\n自分もだよとか。",
            "zh": "比如发消息说\n“快迟到了抱歉”的时候，\n对方回“我也是哦”之类的。",
            "narrator_zh": "雅"
        },
        {
            "location": "977/TALK",
            "narrator": "みやび",
            "text": "そういうのは\n優しいねえと\n思うしねえ。",
            "zh": "那种地方\n我觉得\n很温柔咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "979/TALK",
            "narrator": "つばめ",
            "text": "えっ！？",
            "zh": "诶！？",
            "narrator_zh": "燕"
        },
        {
            "location": "980/TALK",
            "narrator": "つばめ",
            "text": "わたしはそういう時は\n本当に\n遅刻してますよ？",
            "zh": "不过我那种时候，\n都是真的\n快迟到了哦？",
            "narrator_zh": "燕"
        },
        {
            "location": "982/TALK",
            "narrator": "みやび",
            "text": "まあつばめちゃんは\nそうやろうけど。",
            "zh": "嘛，燕的话\n应该是那样咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "983/TALK",
            "narrator": "みやび",
            "text": "アーヤがそう返して\n来た時は多分嘘ぞね。",
            "zh": "不过要是绫水这么回过来，\n多半就是假话咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "984/TALK",
            "narrator": "つばめ",
            "text": "確かにそうかも\nしれません……。",
            "zh": "确实有这个\n可能……。",
            "narrator_zh": "燕"
        },
        {
            "location": "987/TALK",
            "narrator": "みやび",
            "text": "卯月はどうぞね？",
            "zh": "卯月怎么看咧？",
            "narrator_zh": "雅"
        },
        {
            "location": "988/TALK",
            "narrator": "神楽",
            "text": "私ですか？",
            "zh": "我吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "989/SEL",
            "narrator": "",
            "text": "$me$が答えを当ててあげる",
            "zh": "$me$来猜答案",
            "narrator_zh": ""
        },
        {
            "location": "990/ACT",
            "narrator": "",
            "text": "$me$が答えを当ててあげる",
            "zh": "$me$来猜答案",
            "narrator_zh": ""
        },
        {
            "location": "1007/SEL",
            "narrator": "",
            "text": "嘘、ダメ、絶対",
            "zh": "撒谎、不行、绝对",
            "narrator_zh": ""
        },
        {
            "location": "1008/SEL",
            "narrator": "",
            "text": "ケースバイケース",
            "zh": "看情况吧",
            "narrator_zh": ""
        },
        {
            "location": "1009/SEL",
            "narrator": "",
            "text": "むしろ全てが嘘",
            "zh": "还不如全都是假的",
            "narrator_zh": ""
        },
        {
            "location": "1010/ACT",
            "narrator": "",
            "text": "嘘、ダメ、絶対",
            "zh": "撒谎、不行、绝对",
            "narrator_zh": ""
        },
        {
            "location": "1011/TALK",
            "narrator": "神楽",
            "text": "そんなに潔癖でも子供でもないですよ？",
            "zh": "我也没那么洁癖也没那么幼稚哦？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1012/ACT",
            "narrator": "",
            "text": "ケースバイケース",
            "zh": "看情况吧",
            "narrator_zh": ""
        },
        {
            "location": "1013/TALK",
            "narrator": "神楽",
            "text": "それってどっちでもいいってことですよねー",
            "zh": "那是说哪个都行吧——",
            "narrator_zh": "神乐"
        },
        {
            "location": "1014/ACT",
            "narrator": "",
            "text": "むしろ全てが嘘",
            "zh": "还不如全都是假的",
            "narrator_zh": ""
        },
        {
            "location": "1015/TALK",
            "narrator": "神楽",
            "text": "いっそそう言えればどれだけ楽なことか！",
            "zh": "要是干脆能这么说该有多轻松啊！",
            "narrator_zh": "神乐"
        },
        {
            "location": "1027/TALK",
            "narrator": "神楽",
            "text": "ちょっとすぐには\n答えが出ないです。",
            "zh": "这个一时半会儿\n答不上来。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1028/TALK",
            "narrator": "みやび",
            "text": "…卯月は真面目\nなんやねえ。",
            "zh": "……卯月还真是\n认真咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "1031/TALK",
            "narrator": "神楽",
            "text": "そういうわけじゃ\nないんですけど…。",
            "zh": "也不是\n那么回事……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1033/TALK",
            "narrator": "みやび",
            "text": "つばめちゃんは？",
            "zh": "燕呢？",
            "narrator_zh": "雅"
        },
        {
            "location": "1034/TALK",
            "narrator": "つばめ",
            "text": "わたしは……。",
            "zh": "我呢……。",
            "narrator_zh": "燕"
        },
        {
            "location": "1035/TALK",
            "narrator": "つばめ",
            "text": "嘘をつかれたことは\nさみしいって思います。",
            "zh": "被隐瞒撒谎这件事，\n我觉得挺难过的。",
            "narrator_zh": "燕"
        },
        {
            "location": "1036/TALK",
            "narrator": "つばめ",
            "text": "でも、理由が\nわたしを思っての\nことなら。",
            "zh": "不过，如果那理由\n是为我\n着想的",
            "narrator_zh": "燕"
        },
        {
            "location": "1037/TALK",
            "narrator": "つばめ",
            "text": "その気持ちは\nうれしいかもです。",
            "zh": "那份心情\n我挺高兴的。",
            "narrator_zh": "燕"
        },
        {
            "location": "1038/TALK",
            "narrator": "みやび",
            "text": "つばめちゃんは\nえい子やねえ。",
            "zh": "燕真是\n个好孩子嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "1040/TALK",
            "narrator": "つばめ",
            "text": "そ、そんなこと\nないですよ……！？",
            "zh": "不、不会有\n那种事啦……！？",
            "narrator_zh": "燕"
        },
        {
            "location": "1043/TALK",
            "narrator": "神楽",
            "text": "………………。",
            "zh": "………………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "873/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>某月某日　0:20 PM</color>\nとある平日、付属学園食堂でのこと",
            "zh": "<color=green>某月某日　0:20 PM</color>\n某个平日，在附属学园食堂发生的事",
            "narrator_zh": "Dialog_EventData"
        }
    ]
}
