{
    "dir": "chap17/daydra/dd_ch03_17_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "17305",
        "cid": "gabriella",
        "title": "005 メインストーリー",
        "sub_title": "マナーか娯楽か＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "礼仪还是娱乐＜后篇＞"
    },
    "entry": [
        {
            "location": "307/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "311/TALK",
            "narrator": "ガブリエラ",
            "text": "ううん…やっぱり、\n繭の言う通りなの\nかも…。",
            "zh": "不……果然，\n说不定真像茧说的\n那样呢……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "324/TALK",
            "narrator": "ガブリエラ",
            "text": "聞いてほしいの",
            "zh": "我想让你听我说",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "325/TALK",
            "narrator": "ガブリエラ",
            "text": "私ね",
            "zh": "我啊",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "326/TALK",
            "narrator": "ガブリエラ",
            "text": "あの時ちゃんと対応しなかったことを",
            "zh": "关于当时没能好好跟进处理这件事",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "327/TALK",
            "narrator": "ガブリエラ",
            "text": "本当に後悔しているの",
            "zh": "真的感到非常后悔",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "328/TALK",
            "narrator": "ガブリエラ",
            "text": "でも",
            "zh": "可是",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "329/TALK",
            "narrator": "ガブリエラ",
            "text": "発症者が出るなんて",
            "zh": "会有发病者出现这种事",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "330/TALK",
            "narrator": "ガブリエラ",
            "text": "わかりっこなかったんだし",
            "zh": "本来也不可能预料得到嘛",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "331/TALK",
            "narrator": "ガブリエラ",
            "text": "私が必要以上に気にするのって",
            "zh": "你觉得我像这样过度在意这件事",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "332/TALK",
            "narrator": "ガブリエラ",
            "text": "やっぱり変だと思う？",
            "zh": "果然还是有点奇怪吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "334/SEL",
            "narrator": "",
            "text": "ゲームで発症する方がおかしい",
            "zh": "玩个游戏会发病才比较奇怪吧",
            "narrator_zh": ""
        },
        {
            "location": "335/SEL",
            "narrator": "",
            "text": "気にすることじゃない",
            "zh": "没什么好在意的",
            "narrator_zh": ""
        },
        {
            "location": "336/SEL",
            "narrator": "",
            "text": "それを予測してこそトライナリー",
            "zh": "能预料到那种事才叫三重奏嘛",
            "narrator_zh": ""
        },
        {
            "location": "337/ACT",
            "narrator": "",
            "text": "ゲームで発症する方がおかしい",
            "zh": "玩个游戏会发病才比较奇怪吧",
            "narrator_zh": ""
        },
        {
            "location": "338/TALK",
            "narrator": "ガブリエラ",
            "text": "どうなのかしらね？",
            "zh": "这可不好说哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "339/TALK",
            "narrator": "ガブリエラ",
            "text": "最近はね",
            "zh": "最近啊",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "340/TALK",
            "narrator": "ガブリエラ",
            "text": "アプリゲームに一千万とか課金する人もいるらしいの",
            "zh": "听说还有人往手游里氪上千万日元的呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "341/TALK",
            "narrator": "ガブリエラ",
            "text": "それにね",
            "zh": "而且啊",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "342/TALK",
            "narrator": "ガブリエラ",
            "text": "十万円とか課金しても",
            "zh": "就算氪个十万日元",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "343/TALK",
            "narrator": "ガブリエラ",
            "text": "レアキャラが出ないの当然だから",
            "zh": "抽不到稀有角色也都是家常便饭了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "344/TALK",
            "narrator": "ガブリエラ",
            "text": "変ではないわよ",
            "zh": "所以也没什么奇怪的哦",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "347/TALK",
            "narrator": "ガブリエラ",
            "text": "っていうか",
            "zh": "不如说",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "348/TALK",
            "narrator": "ガブリエラ",
            "text": "それ考えたら発症者に同情しちゃうわ",
            "zh": "一想到这些，我都忍不住有点同情那些发病者了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "349/ACT",
            "narrator": "",
            "text": "気にすることじゃない",
            "zh": "没什么好在意的",
            "narrator_zh": ""
        },
        {
            "location": "350/TALK",
            "narrator": "ガブリエラ",
            "text": "そうよね",
            "zh": "是啊",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "351/TALK",
            "narrator": "ガブリエラ",
            "text": "何が発症の原因になるかなんて",
            "zh": "什么东西会成为发病的诱因这种事",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "352/TALK",
            "narrator": "ガブリエラ",
            "text": "誰にもわからないんだし",
            "zh": "本来就谁也说不准嘛",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "353/TALK",
            "narrator": "ガブリエラ",
            "text": "対処のしようがないのよね",
            "zh": "根本无从防起啊",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "354/TALK",
            "narrator": "ガブリエラ",
            "text": "発症は防げないし",
            "zh": "既没法预防发病",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "355/TALK",
            "narrator": "ガブリエラ",
            "text": "予測もできない",
            "zh": "也无法提前预测",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "356/TALK",
            "narrator": "ガブリエラ",
            "text": "だからこそ私たちがいるのよね？",
            "zh": "正因如此才需要我们存在的，对吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "357/ACT",
            "narrator": "",
            "text": "それを予測してこそトライナリー",
            "zh": "能预料到那种事才叫三重奏嘛",
            "narrator_zh": ""
        },
        {
            "location": "358/TALK",
            "narrator": "ガブリエラ",
            "text": "それができれば苦労しないわ",
            "zh": "真能做到的话就不用这么辛苦了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "359/TALK",
            "narrator": "ガブリエラ",
            "text": "発症者が出るのが予測できたとしたら",
            "zh": "要是连谁会发病都能提前预测到的话",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "360/TALK",
            "narrator": "ガブリエラ",
            "text": "私達トライナリーはいらないわよ",
            "zh": "那根本就不需要我们三重奏了吧",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "361/TALK",
            "narrator": "ガブリエラ",
            "text": "預言者集団じゃないんだし",
            "zh": "我们又不是什么预言家团体",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "364/TALK",
            "narrator": "ガブリエラ",
            "text": "そうよね",
            "zh": "是啊",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "365/TALK",
            "narrator": "ガブリエラ",
            "text": "預言者じゃないんだから",
            "zh": "既然不是预言家",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "366/TALK",
            "narrator": "ガブリエラ",
            "text": "止められるはずがなかったのよ",
            "zh": "本来也就不可能阻止得了嘛",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "368/TALK",
            "narrator": "ガブリエラ",
            "text": "少し後悔は残るけれど",
            "zh": "虽然心里多少还是留有一点遗憾",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "369/TALK",
            "narrator": "ガブリエラ",
            "text": "もうこのこと",
            "zh": "不过这件事",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "370/TALK",
            "narrator": "ガブリエラ",
            "text": "気にするのやめにするわ",
            "zh": "我决定不再继续纠结了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "371/TALK",
            "narrator": "ガブリエラ",
            "text": "勝手に言いたいことばかり言ってしまったわね",
            "zh": "光顾着自说自话，真是抱歉呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "372/TALK",
            "narrator": "ガブリエラ",
            "text": "でもスッキリしたわ",
            "zh": "不过说出来之后痛快多了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "386/TALK",
            "narrator": "ガブリエラ",
            "text": "…そういえば、\nあれからカプドラは\nどうなったの？",
            "zh": "……话说回来，\n那之后卡普多拉\n怎么样了？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "388/TALK",
            "narrator": "雛",
            "text": "ガブリエラちゃん、\n知らないの？",
            "zh": "加布里埃拉，\n你不知道吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "390/TALK",
            "narrator": "雛",
            "text": "あの炎上のあと、\nすぐにパッチで\nバグが修正されたの。",
            "zh": "那次炎上之后，\n官方马上就发补丁\n把BUG修好了哦。",
            "narrator_zh": "雏"
        },
        {
            "location": "391/TALK",
            "narrator": "雛",
            "text": "今はもう次のイベント\n始まってるよー。",
            "zh": "现在都已经开启\n下一个新活动啦——",
            "narrator_zh": "雏"
        },
        {
            "location": "395/TALK",
            "narrator": "ガブリエラ",
            "text": "は！？　何それ！",
            "zh": "哈！？　什么鬼啊！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "396/TALK",
            "narrator": "ガブリエラ",
            "text": "発症者出した原因\n作っときながら、\n普通に続いてるの！？",
            "zh": "明明闹出了让人发病的\n祸端，结果却还跟没事人\n一样继续运营吗！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "397/TALK",
            "narrator": "繭",
            "text": "発症の原因は、\n一般には公開されて\nないからね。",
            "zh": "因为发病的真正原因，\n并没有向大众\n公开嘛。",
            "narrator_zh": "茧"
        },
        {
            "location": "398/TALK",
            "narrator": "繭",
            "text": "多分、公式は\n気づいてすらいないと\n思う。",
            "zh": "我估计，官方自己\n甚至连察觉都没察觉到\n吧。",
            "narrator_zh": "茧"
        },
        {
            "location": "400/TALK",
            "narrator": "ガブリエラ",
            "text": "…それはそれで、\nなんかモヤッとした\n気持ちになるわね。",
            "zh": "……就算这样，\n总觉得心里还是有点\n说不出的憋屈呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "401/TALK",
            "narrator": "繭",
            "text": "なんにせよ、\nもう済んだこと。\n気にするだけ無駄。",
            "zh": "不管怎么说，\n都已经是过去的事了。\n再纠结也只是徒劳。",
            "narrator_zh": "茧"
        },
        {
            "location": "403/TALK",
            "narrator": "雛",
            "text": "そういうことだよ。\nというわけでー。",
            "zh": "就是这么回事啦。\n所以说——",
            "narrator_zh": "雏"
        },
        {
            "location": "404/TALK",
            "narrator": "雛",
            "text": "平和になったカプドラ\nやって、嫌な気持ちを\n吹き飛ばしちゃおー！",
            "zh": "咱们来玩已经恢复和平的\n卡普多拉，把不痛快的\n心情全都吹飞吧——！",
            "narrator_zh": "雏"
        },
        {
            "location": "406/TALK",
            "narrator": "ガブリエラ",
            "text": "この流れで\nカプドラ！？",
            "zh": "接在这种气氛后面\n玩卡普多拉吗！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "407/TALK",
            "narrator": "繭",
            "text": "炎上した後だけに、\n今は超安全。",
            "zh": "正因为刚炎上过，\n现在反而安全得很。",
            "narrator_zh": "茧"
        },
        {
            "location": "408/TALK",
            "narrator": "雛",
            "text": "今回こそ、イベント\n攻略目指そ。",
            "zh": "这一次，一定要以\n通关活动为目标哦。",
            "narrator_zh": "雏"
        },
        {
            "location": "409/TALK",
            "narrator": "ガブリエラ",
            "text": "…仕方ないわね。",
            "zh": "……真是拿你们没办法。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "411/TALK",
            "narrator": "ガブリエラ",
            "text": "疲れてるから、\n１プレイだけよ？",
            "zh": "我今天挺累的，\n只打一局哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "412/TALK",
            "narrator": "雛",
            "text": "やった！\nじゃあ、とりあえず\nイベントクエの――",
            "zh": "太好啦！\n那，首先就先打\n活动副本的——",
            "narrator_zh": "雏"
        },
        {
            "location": "423/DIALOG",
            "narrator": "Dialog_chapter_ch03",
            "text": "【14 神楽学校やめるってよ】",
            "zh": "【14 听说神乐要退学】",
            "narrator_zh": "Dialog_chapter_ch03"
        }
    ]
}
