  "title": "らぶとーく 第03話",
  "sub_title": "それが事実、あれだったとして"
 },
 "entry": [
  {
   "location": "379/SCENARIO",
   "narrator": "",
   "text": "それが事実、あれだったとして",
   "zh": "就算那件事确实是那样",
   "narrator_zh": ""
  },
  {
   "location": "391/TALK",
   "narrator": "みやび",
   "text": "推論に基づいて\n検証するしか\nないけんど。"
  },
  {
   "location": "392/TALK",
   "narrator": "みやび",
   "text": "うちだけでは解析の\n精度が上げられん…。"
  },
  {
   "location": "393/TALK",
   "narrator": "みやび",
   "text": "どうしたものか…。",
   "zh": "该怎么办呢……。",
   "narrator_zh": "雅"
  },
  {
   "location": "398/TALK",
   "narrator": "みやび",
   "text": "どうぞー。",
   "zh": "请吧——。",
   "narrator_zh": "雅"
  },
  {
   "location": "404/TALK",
   "narrator": "アーヤ",
   "text": "突然ごめんね。\n今、大丈夫？"
  },
  {
   "location": "406/TALK",
   "narrator": "みやび",
   "text": "どういたが？\n真剣な顔して。",
   "zh": "怎么了？\n一脸认真的。",
   "narrator_zh": "雅"
  },
  {
   "location": "407/TALK",
   "narrator": "アーヤ",
   "text": "……。\nやっぱり\nわかっちゃった？"
  },
  {
   "location": "410/TALK",
   "narrator": "アーヤ",
   "text": "これから\nすごく変なことを\n言うかもしれない。",
   "zh": "接下来\n我可能会说些\n很奇怪的话。",
   "narrator_zh": "绫水"
  },
  {
   "location": "413/TALK",
   "narrator": "アーヤ",
   "text": "でもまじめに\n考えてほしいの。",
   "zh": "不过我希望你\n认真想一想。",
   "narrator_zh": "绫水"
  },
  {
   "location": "414/TALK",
   "narrator": "みやび",
   "text": "…………。"
  },
  {
   "location": "416/TALK",
   "narrator": "アーヤ",
   "text": "ううん。きっと、\n私よりみやびの方が\n先に気づいてる。",
   "zh": "不是。我想，\n雅一定比我\n更早察觉到了。",
   "narrator_zh": "绫水"
  },
  {
   "location": "417/TALK",
   "narrator": "みやび",
   "text": "…………。"
  },
  {
   "location": "419/TALK",
   "narrator": "アーヤ",
   "text": "トライガジェットの\nＢｏｔについて。",
   "zh": "关于三重小装置的\nBot。",
   "narrator_zh": "绫水"
  },
  {
   "location": "421/TALK",
   "narrator": "アーヤ",
   "text": "ちょっとあれ、\n機械的じゃない\nところあるわよね？",
   "zh": "那个，反倒是\n不是机械的\n地方才有吧？",
   "narrator_zh": "绫水"
  },
  {
   "location": "422/TALK",
   "narrator": "みやび",
   "text": "いつ、\nそう思うた？"
  },
  {
   "location": "423/TALK",
   "narrator": "アーヤ",
   "text": "改めて考えなきゃって\n思ったのはこの前の\n映画の話の時。"
  },
  {
   "location": "424/TALK",
   "narrator": "みやび",
   "text": "アーヤが\n怖い話かと聞いた時の\nことかよ？"
  },
  {
   "location": "425/TALK",
   "narrator": "アーヤ",
   "text": "…そうね。",
   "zh": "……也是。",
   "narrator_zh": "绫水"
  },
  {
   "location": "426/TALK",
   "narrator": "みやび",
   "text": "だったら\n言いたいことの\n想像はついちゅう。",
   "zh": "那样的话，我想说什么\n大概也能\n猜到咯。",
   "narrator_zh": "雅"
  },
  {
   "location": "427/TALK",
   "narrator": "みやび",
   "text": "Ｂｏｔは人間かも\nしれん、と\n言いたいろう。"
  },
  {
   "location": "429/TALK",
   "narrator": "アーヤ",
   "text": "……みやびの口から\n言ってくれて\nホッとしたわ。"
  },
  {
   "location": "430/TALK",
   "narrator": "アーヤ",
   "text": "自分の頭が\nおかしいのかもって\n思ってたから。"
  },
  {
   "location": "431/TALK",
   "narrator": "みやび",
   "text": "いや。",
   "zh": "不是。",
   "narrator_zh": "雅"
  },
  {
   "location": "443/TALK",
   "narrator": "みやび",
   "text": "よう"
  },
  {
   "location": "445/TALK",
   "narrator": "みやび",
   "text": "相棒"
  },
  {
   "location": "447/SEL",
   "narrator": "",
   "text": "呼んだ？",
   "zh": "叫我？",
   "narrator_zh": ""
  },
  {
   "location": "448/SEL",
   "narrator": "",
   "text": "ＹＯ！　ＹＯ！　ラップだＹＯ！",
   "zh": "YO！　YO！　说唱YO！",
   "narrator_zh": ""
  },
  {
   "location": "449/SEL",
   "narrator": "",
   "text": "もっと色気のある呼びかけがいいなー",
   "zh": "想要更撩人的称呼啊～",
   "narrator_zh": ""
  },
  {
   "location": "450/ACT",
   "narrator": "",
   "text": "呼んだ？",
   "zh": "叫我？",
   "narrator_zh": ""
  },
  {
   "location": "451/TALK",
   "narrator": "みやび",
   "text": "呼ばれたぞ"
  },
  {
   "location": "452/SEL",
   "narrator": "",
   "text": "そうみたい",
   "zh": "好像是这样",
   "narrator_zh": ""
  },
  {
   "location": "453/SEL",
   "narrator": "",
   "text": "忙しいんだけど",
   "zh": "我很忙的",
   "narrator_zh": ""
  },
  {
   "location": "454/SEL",
   "narrator": "",
   "text": "ひょっとして暇？",
   "zh": "你难道是闲着？",
   "narrator_zh": ""
  },
  {
   "location": "455/ACT",
   "narrator": "",
   "text": "そうみたい",
   "zh": "好像是这样",
   "narrator_zh": ""
  },
  {
   "location": "456/TALK",
   "narrator": "みやび",
   "text": "他人事か",
   "zh": "当别人的事啊",
   "narrator_zh": "雅"
  },
  {
   "location": "457/TALK",
   "narrator": "みやび",
   "text": "のらりくらりだの",
   "zh": "油嘴滑舌的",
   "narrator_zh": "雅"
  },
  {
   "location": "458/SEL",
   "narrator": "",
   "text": "ひねもすのたりのたりだよ",
   "zh": "整天就这么悠悠闲闲的呀",
   "narrator_zh": ""
  },
  {
   "location": "459/ACT",
   "narrator": "",
   "text": "ひねもすのたりのたりだよ",
   "zh": "整天就这么悠悠闲闲的呀",
   "narrator_zh": ""
  },
  {
   "location": "460/TALK",
   "narrator": "みやび",
   "text": "そうか",
   "zh": "这样哦",
   "narrator_zh": "雅"
  },
  {
   "location": "461/TALK",
   "narrator": "みやび",
   "text": "それは失礼した",
   "zh": "那是我失礼了",
   "narrator_zh": "雅"
  },
  {
   "location": "463/ACT",
   "narrator": "",
   "text": "忙しいんだけど",
   "zh": "我很忙的",
   "narrator_zh": ""
  },
  {
   "location": "464/TALK",
   "narrator": "みやび",
   "text": "またまた",
   "zh": "又来了",
   "narrator_zh": "雅"
  },
  {
   "location": "465/TALK",
   "narrator": "みやび",
   "text": "即答しておいて"
  },
  {
   "location": "466/SEL",
   "narrator": "",
   "text": "それはまた別問題",
   "zh": "那是另一码事",
   "narrator_zh": ""
  },
  {
   "location": "467/ACT",
   "narrator": "",
   "text": "それはまた別問題",
   "zh": "那是另一码事",
   "narrator_zh": ""
  },
  {
   "location": "468/TALK",
   "narrator": "みやび",
   "text": "なるほど",
   "zh": "原来如此",
   "narrator_zh": "雅"
  },
  {
   "location": "469/TALK",
   "narrator": "みやび",
   "text": "うまく問題をすり替えたな"
  },
  {
   "location": "471/ACT",
   "narrator": "",
   "text": "ひょっとして暇？",
   "zh": "你难道是闲着？",
   "narrator_zh": ""
  },
  {
   "location": "472/TALK",
   "narrator": "みやび",
   "text": "いや",
   "zh": "不对",
   "narrator_zh": "雅"
  },
  {
   "location": "474/TALK",
   "narrator": "みやび",
   "text": "絶賛大忙しぞね"
  },
  {
   "location": "475/SEL",
   "narrator": "",
   "text": "じゃあ失礼しますね",
   "zh": "那我先失陪了",
   "narrator_zh": ""
  },
  {
   "location": "476/ACT",
   "narrator": "",
   "text": "じゃあ失礼しますね",
   "zh": "那我先失陪了",
   "narrator_zh": ""
  },
  {
   "location": "477/TALK",
   "narrator": "みやび",
   "text": "空気を読んできおった"
  },
  {
   "location": "478/TALK",
   "narrator": "みやび",
   "text": "こざかしいの",
   "zh": "真会耍小聪明咯",
   "narrator_zh": "雅"
  },
  {
   "location": "481/ACT",
   "narrator": "",
   "text": "ＹＯ！　ＹＯ！　ラップだＹＯ！",
   "zh": "YO！　YO！　说唱YO！",
   "narrator_zh": ""
  },
  {
   "location": "482/TALK",
   "narrator": "みやび",
   "text": "ラッパーの風上にも置けん安易さ"
  },
  {
   "location": "483/SEL",
   "narrator": "",
   "text": "ラップは大衆芸術だからね",
   "zh": "说唱可是大众艺术呢",
   "narrator_zh": ""
  },
  {
   "location": "484/ACT",
   "narrator": "",
   "text": "ラップは大衆芸術だからね",
   "zh": "说唱可是大众艺术呢",
   "narrator_zh": ""
  },
  {
   "location": "485/TALK",
   "narrator": "みやび",
   "text": "キャッチーさが売りと"
  },
  {
   "location": "486/TALK",
   "narrator": "みやび",
   "text": "そういうことか",
   "zh": "原来是这么回事",
   "narrator_zh": "雅"
  },
  {
   "location": "488/ACT",
   "narrator": "",
   "text": "もっと色気のある呼びかけがいいなー",
   "zh": "想要更撩人的称呼啊～",
   "narrator_zh": ""
  },
  {
   "location": "489/TALK",
   "narrator": "みやび",
   "text": "これ以上色気づくと人類が滅ぶぞ",
   "zh": "再这么卖弄风情，人类就要灭亡了咯",
   "narrator_zh": "雅"
  },
  {
   "location": "490/SEL",
   "narrator": "",
   "text": "みやびと$me$だけ残ればいいでしょ",
   "zh": "只要留下雅和$me$不就好了",
   "narrator_zh": ""
  },
  {
   "location": "491/ACT",
   "narrator": "",
   "text": "みやびと$me$だけ残ればいいでしょ",
   "zh": "只要留下雅和$me$不就好了",
   "narrator_zh": ""
  },
  {
   "location": "492/TALK",
   "narrator": "みやび",
   "text": "セカイ系"
  },
  {
   "location": "493/TALK",
   "narrator": "みやび",
   "text": "あるいはディストピア恋愛ドラマ"
  },
  {
   "location": "494/TALK",
   "narrator": "みやび",
   "text": "今回は遠慮しておこう"
  },
  {
   "location": "508/TALK",
   "narrator": "みやび",
   "text": "かなり突拍子もない\n会話をしても\nはぐらかしなし。",
   "zh": "就算是相当离谱的\n对话，也不\n打岔咯。",
   "narrator_zh": "雅"
  },
  {
   "location": "509/TALK",
   "narrator": "みやび",
   "text": "こんな会話パターンを\n用意するのは\n尋常ではないぞね。",
   "zh": "能准备出这种\n对话模式，\n可不寻常咯。",
   "narrator_zh": "雅"
  },
  {
   "location": "510/TALK",
   "narrator": "みやび",
   "text": "人間だと考える方が\nうちには自然や。"
  },
  {
   "location": "511/TALK",
   "narrator": "アーヤ",
   "text": "……。"
  },
  {
   "location": "512/TALK",
   "narrator": "みやび",
   "text": "もちろん現時点では\nあくまで仮定の話や。"
  },
  {
   "location": "514/TALK",
   "narrator": "みやび",
   "text": "検証して確定するには\nアーヤの協力が\n必要ぞね。"
  },
  {
   "location": "517/TALK",
   "narrator": "アーヤ",
   "text": "私の？"
  },
  {
   "location": "518/TALK",
   "narrator": "みやび",
   "text": "Ｂｏｔとの会話ログ。\nそれを提供しちゃあ\nくれんろうか。"
  },
  {
   "location": "521/TALK",
   "narrator": "アーヤ",
   "text": "……！"
  },
  {
   "location": "522/TALK",
   "narrator": "みやび",
   "text": "プライバシーに\n関わることやきね。"
  },
  {
   "location": "523/TALK",
   "narrator": "みやび",
   "text": "決心がついたら、で\nええけんど。"
  },
  {
   "location": "525/TALK",
   "narrator": "アーヤ",
   "text": "……。"
  },
  {
   "location": "526/TALK",
   "narrator": "アーヤ",
   "text": "ちょっと、\n考えさせて。",
   "zh": "那个，\n让我想想。",
   "narrator_zh": "绫水"
  },
  {
   "location": "527/TALK",
   "narrator": "みやび",
   "text": "……えい答えを\n期待しちょる。"
  },
