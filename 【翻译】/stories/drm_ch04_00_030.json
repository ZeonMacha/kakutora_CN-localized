{
    "dir": "dramatics/daydra/drm_ch04_00_030.js",
    "type": "Episode",
    "info": {
        "story_id": "4003",
        "cid": "miyabi",
        "title": "らぶとーく 第03話",
        "sub_title": "それが事実、あれだったとして",
        "title_zh": "恋爱漫谈 第03话",
        "sub_title_zh": "就算那件事确实是那样"
    },
    "entry": [
        {
            "location": "379/SCENARIO",
            "narrator": "",
            "text": "それが事実、あれだったとして",
            "zh": "就算那件事确实是那样",
            "narrator_zh": ""
        },
        {
            "location": "391/TALK",
            "narrator": "みやび",
            "text": "推論に基づいて\n検証するしか\nないけんど。",
            "zh": "只能靠推理来\n验证了，\n但是。",
            "narrator_zh": "雅"
        },
        {
            "location": "392/TALK",
            "narrator": "みやび",
            "text": "うちだけでは解析の\n精度が上げられん…。",
            "zh": "光靠我，解析的\n精度提不上去……。",
            "narrator_zh": "雅"
        },
        {
            "location": "393/TALK",
            "narrator": "みやび",
            "text": "どうしたものか…。",
            "zh": "该怎么办……咩……。",
            "narrator_zh": "雅"
        },
        {
            "location": "398/TALK",
            "narrator": "みやび",
            "text": "どうぞー。",
            "zh": "请进——。",
            "narrator_zh": "雅"
        },
        {
            "location": "404/TALK",
            "narrator": "アーヤ",
            "text": "突然ごめんね。\n今、大丈夫？",
            "zh": "突然打扰，不好意思。\n现在方便吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "406/TALK",
            "narrator": "みやび",
            "text": "どういたが？\n真剣な顔して。",
            "zh": "怎么了？\n一脸认真的。",
            "narrator_zh": "雅"
        },
        {
            "location": "407/TALK",
            "narrator": "アーヤ",
            "text": "……。\nやっぱり\nわかっちゃった？",
            "zh": "……。\n果然\n还是被看穿了？",
            "narrator_zh": "绫水"
        },
        {
            "location": "410/TALK",
            "narrator": "アーヤ",
            "text": "これから\nすごく変なことを\n言うかもしれない。",
            "zh": "接下来\n我可能会说些\n很奇怪的话。",
            "narrator_zh": "绫水"
        },
        {
            "location": "413/TALK",
            "narrator": "アーヤ",
            "text": "でもまじめに\n考えてほしいの。",
            "zh": "不过我希望你\n认真想一想。",
            "narrator_zh": "绫水"
        },
        {
            "location": "414/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "416/TALK",
            "narrator": "アーヤ",
            "text": "ううん。きっと、\n私よりみやびの方が\n先に気づいてる。",
            "zh": "不是。我想，\n雅一定比我\n更早察觉到了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "417/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "419/TALK",
            "narrator": "アーヤ",
            "text": "トライガジェットの\nＢｏｔについて。",
            "zh": "关于三重小装置的\nBot。",
            "narrator_zh": "绫水"
        },
        {
            "location": "421/TALK",
            "narrator": "アーヤ",
            "text": "ちょっとあれ、\n機械的じゃない\nところあるわよね？",
            "zh": "那个，反倒是\n不是机械的\n地方才有吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "422/TALK",
            "narrator": "みやび",
            "text": "いつ、\nそう思うた？",
            "zh": "是几时，\n开始这么想的？",
            "narrator_zh": "雅"
        },
        {
            "location": "423/TALK",
            "narrator": "アーヤ",
            "text": "改めて考えなきゃって\n思ったのはこの前の\n映画の話の時。",
            "zh": "让我重新思考，\n是上次聊电影的\n时候。",
            "narrator_zh": "绫水"
        },
        {
            "location": "424/TALK",
            "narrator": "みやび",
            "text": "アーヤが\n怖い話かと聞いた時の\nことかよ？",
            "zh": "是绫水你问\n「是不是恐怖故事」\n那会儿的事啊？",
            "narrator_zh": "雅"
        },
        {
            "location": "425/TALK",
            "narrator": "アーヤ",
            "text": "…そうね。",
            "zh": "……也是。",
            "narrator_zh": "绫水"
        },
        {
            "location": "426/TALK",
            "narrator": "みやび",
            "text": "だったら\n言いたいことの\n想像はついちゅう。",
            "zh": "那样的话，你想说的\n事大概也能\n猜到咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "427/TALK",
            "narrator": "みやび",
            "text": "Ｂｏｔは人間かも\nしれん、と\n言いたいろう。",
            "zh": "你是想说\n「Bot说不定\n是人类」吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "429/TALK",
            "narrator": "アーヤ",
            "text": "……みやびの口から\n言ってくれて\nホッとしたわ。",
            "zh": "……能听雅\n亲口说出来，\n我就安心了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "430/TALK",
            "narrator": "アーヤ",
            "text": "自分の頭が\nおかしいのかもって\n思ってたから。",
            "zh": "因为我还以为\n是自己的脑子\n有问题。",
            "narrator_zh": "绫水"
        },
        {
            "location": "431/TALK",
            "narrator": "みやび",
            "text": "いや。",
            "zh": "不是。",
            "narrator_zh": "雅"
        },
        {
            "location": "443/TALK",
            "narrator": "みやび",
            "text": "よう",
            "zh": "哟",
            "narrator_zh": "雅"
        },
        {
            "location": "445/TALK",
            "narrator": "みやび",
            "text": "相棒",
            "zh": "搭档",
            "narrator_zh": "雅"
        },
        {
            "location": "447/SEL",
            "narrator": "",
            "text": "呼んだ？",
            "zh": "叫我？",
            "narrator_zh": ""
        },
        {
            "location": "448/SEL",
            "narrator": "",
            "text": "ＹＯ！　ＹＯ！　ラップだＹＯ！",
            "zh": "YO！　YO！　说唱YO！",
            "narrator_zh": ""
        },
        {
            "location": "449/SEL",
            "narrator": "",
            "text": "もっと色気のある呼びかけがいいなー",
            "zh": "想要更撩人的称呼啊～",
            "narrator_zh": ""
        },
        {
            "location": "450/ACT",
            "narrator": "",
            "text": "呼んだ？",
            "zh": "叫我？",
            "narrator_zh": ""
        },
        {
            "location": "451/TALK",
            "narrator": "みやび",
            "text": "呼ばれたぞ",
            "zh": "被叫了啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "452/SEL",
            "narrator": "",
            "text": "そうみたい",
            "zh": "好像是这样",
            "narrator_zh": ""
        },
        {
            "location": "453/SEL",
            "narrator": "",
            "text": "忙しいんだけど",
            "zh": "我很忙的",
            "narrator_zh": ""
        },
        {
            "location": "454/SEL",
            "narrator": "",
            "text": "ひょっとして暇？",
            "zh": "你难道是闲着？",
            "narrator_zh": ""
        },
        {
            "location": "455/ACT",
            "narrator": "",
            "text": "そうみたい",
            "zh": "好像是这样",
            "narrator_zh": ""
        },
        {
            "location": "456/TALK",
            "narrator": "みやび",
            "text": "他人事か",
            "zh": "说得跟别人的事似的啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "457/TALK",
            "narrator": "みやび",
            "text": "のらりくらりだの",
            "zh": "真是滑头滑脑的呐。",
            "narrator_zh": "雅"
        },
        {
            "location": "458/SEL",
            "narrator": "",
            "text": "ひねもすのたりのたりだよ",
            "zh": "整天就这么悠悠闲闲的呀",
            "narrator_zh": ""
        },
        {
            "location": "459/ACT",
            "narrator": "",
            "text": "ひねもすのたりのたりだよ",
            "zh": "整天就这么悠悠闲闲的呀",
            "narrator_zh": ""
        },
        {
            "location": "460/TALK",
            "narrator": "みやび",
            "text": "そうか",
            "zh": "这样哦",
            "narrator_zh": "雅"
        },
        {
            "location": "461/TALK",
            "narrator": "みやび",
            "text": "それは失礼した",
            "zh": "那是我失礼了",
            "narrator_zh": "雅"
        },
        {
            "location": "463/ACT",
            "narrator": "",
            "text": "忙しいんだけど",
            "zh": "我很忙的",
            "narrator_zh": ""
        },
        {
            "location": "464/TALK",
            "narrator": "みやび",
            "text": "またまた",
            "zh": "又来了",
            "narrator_zh": "雅"
        },
        {
            "location": "465/TALK",
            "narrator": "みやび",
            "text": "即答しておいて",
            "zh": "明明立刻就答了",
            "narrator_zh": "雅"
        },
        {
            "location": "466/SEL",
            "narrator": "",
            "text": "それはまた別問題",
            "zh": "那是另一码事",
            "narrator_zh": ""
        },
        {
            "location": "467/ACT",
            "narrator": "",
            "text": "それはまた別問題",
            "zh": "那是另一码事",
            "narrator_zh": ""
        },
        {
            "location": "468/TALK",
            "narrator": "みやび",
            "text": "なるほど",
            "zh": "原来如此",
            "narrator_zh": "雅"
        },
        {
            "location": "469/TALK",
            "narrator": "みやび",
            "text": "うまく問題をすり替えたな",
            "zh": "问题偷换得挺溜啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "471/ACT",
            "narrator": "",
            "text": "ひょっとして暇？",
            "zh": "你难道是闲着？",
            "narrator_zh": ""
        },
        {
            "location": "472/TALK",
            "narrator": "みやび",
            "text": "いや",
            "zh": "不对",
            "narrator_zh": "雅"
        },
        {
            "location": "474/TALK",
            "narrator": "みやび",
            "text": "絶賛大忙しぞね",
            "zh": "正忙得不可开交咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "475/SEL",
            "narrator": "",
            "text": "じゃあ失礼しますね",
            "zh": "那我先失陪了",
            "narrator_zh": ""
        },
        {
            "location": "476/ACT",
            "narrator": "",
            "text": "じゃあ失礼しますね",
            "zh": "那我先失陪了",
            "narrator_zh": ""
        },
        {
            "location": "477/TALK",
            "narrator": "みやび",
            "text": "空気を読んできおった",
            "zh": "还挺会看空气的啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "478/TALK",
            "narrator": "みやび",
            "text": "こざかしいの",
            "zh": "真会耍小聪明咯",
            "narrator_zh": "雅"
        },
        {
            "location": "481/ACT",
            "narrator": "",
            "text": "ＹＯ！　ＹＯ！　ラップだＹＯ！",
            "zh": "YO！　YO！　说唱YO！",
            "narrator_zh": ""
        },
        {
            "location": "482/TALK",
            "narrator": "みやび",
            "text": "ラッパーの風上にも置けん安易さ",
            "zh": "这份敷衍劲，说唱歌手都耻与为伍。",
            "narrator_zh": "雅"
        },
        {
            "location": "483/SEL",
            "narrator": "",
            "text": "ラップは大衆芸術だからね",
            "zh": "说唱可是大众艺术呢",
            "narrator_zh": ""
        },
        {
            "location": "484/ACT",
            "narrator": "",
            "text": "ラップは大衆芸術だからね",
            "zh": "说唱可是大众艺术呢",
            "narrator_zh": ""
        },
        {
            "location": "485/TALK",
            "narrator": "みやび",
            "text": "キャッチーさが売りと",
            "zh": "卖点是好上口啊",
            "narrator_zh": "雅"
        },
        {
            "location": "486/TALK",
            "narrator": "みやび",
            "text": "そういうことか",
            "zh": "原来是这么回事",
            "narrator_zh": "雅"
        },
        {
            "location": "488/ACT",
            "narrator": "",
            "text": "もっと色気のある呼びかけがいいなー",
            "zh": "想要更撩人的称呼啊～",
            "narrator_zh": ""
        },
        {
            "location": "489/TALK",
            "narrator": "みやび",
            "text": "これ以上色気づくと人類が滅ぶぞ",
            "zh": "再这么卖弄风情，人类就要灭亡了咯",
            "narrator_zh": "雅"
        },
        {
            "location": "490/SEL",
            "narrator": "",
            "text": "みやびと$me$だけ残ればいいでしょ",
            "zh": "只要留下雅和$me$不就好了",
            "narrator_zh": ""
        },
        {
            "location": "491/ACT",
            "narrator": "",
            "text": "みやびと$me$だけ残ればいいでしょ",
            "zh": "只要留下雅和$me$不就好了",
            "narrator_zh": ""
        },
        {
            "location": "492/TALK",
            "narrator": "みやび",
            "text": "セカイ系",
            "zh": "世界系",
            "narrator_zh": "雅"
        },
        {
            "location": "493/TALK",
            "narrator": "みやび",
            "text": "あるいはディストピア恋愛ドラマ",
            "zh": "或者反乌托邦恋爱剧",
            "narrator_zh": "雅"
        },
        {
            "location": "494/TALK",
            "narrator": "みやび",
            "text": "今回は遠慮しておこう",
            "zh": "这次就先免了吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "508/TALK",
            "narrator": "みやび",
            "text": "かなり突拍子もない\n会話をしても\nはぐらかしなし。",
            "zh": "就算是相当离谱的\n对话，也不\n打岔咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "509/TALK",
            "narrator": "みやび",
            "text": "こんな会話パターンを\n用意するのは\n尋常ではないぞね。",
            "zh": "能准备出这种\n对话模式，\n可不寻常咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "510/TALK",
            "narrator": "みやび",
            "text": "人間だと考える方が\nうちには自然や。",
            "zh": "当成人类来想，\n对我来说反而自然咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "511/TALK",
            "narrator": "アーヤ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "512/TALK",
            "narrator": "みやび",
            "text": "もちろん現時点では\nあくまで仮定の話や。",
            "zh": "当然，现阶段\n不过是假设罢了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "514/TALK",
            "narrator": "みやび",
            "text": "検証して確定するには\nアーヤの協力が\n必要ぞね。",
            "zh": "要验证并确定下来，\n得靠绫水\n协助才行咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "517/TALK",
            "narrator": "アーヤ",
            "text": "私の？",
            "zh": "我的？",
            "narrator_zh": "绫水"
        },
        {
            "location": "518/TALK",
            "narrator": "みやび",
            "text": "Ｂｏｔとの会話ログ。\nそれを提供しちゃあ\nくれんろうか。",
            "zh": "你和Bot的对话记录。\n能不能提供\n给我咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "521/TALK",
            "narrator": "アーヤ",
            "text": "……！",
            "zh": "……！",
            "narrator_zh": "绫水"
        },
        {
            "location": "522/TALK",
            "narrator": "みやび",
            "text": "プライバシーに\n関わることやきね。",
            "zh": "这可是牵涉\n隐私的事啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "523/TALK",
            "narrator": "みやび",
            "text": "決心がついたら、で\nええけんど。",
            "zh": "等你下定决心了\n再给就好，但是。",
            "narrator_zh": "雅"
        },
        {
            "location": "525/TALK",
            "narrator": "アーヤ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "526/TALK",
            "narrator": "アーヤ",
            "text": "ちょっと、\n考えさせて。",
            "zh": "那个，\n让我想想。",
            "narrator_zh": "绫水"
        },
        {
            "location": "527/TALK",
            "narrator": "みやび",
            "text": "……えい答えを\n期待しちょる。",
            "zh": "……我可期待着\n好答案咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "390/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>5月某日　5:35 PM</color>\n放課後、寮とらいあんぐるのみやびの部屋にて。",
            "zh": "<color=green>5月某日　5:35 PM</color>\n放学后，在Tri-angle宿舍的雅房间里。",
            "narrator_zh": "Dialog_EventData"
        }
    ]
}
