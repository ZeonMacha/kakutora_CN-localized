{
    "dir": "chap27/daydra/dd_ch02_27_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "27205",
        "cid": "ayami",
        "title": "005 メインストーリー",
        "sub_title": "二人の秘密基地＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "两人的秘密基地＜后篇＞"
    },
    "entry": [
        {
            "location": "373/SCENARIO",
            "narrator": "",
            "text": "二人の秘密基地",
            "zh": "两人的秘密基地",
            "narrator_zh": ""
        },
        {
            "location": "397/TALK",
            "narrator": "アーヤ",
            "text": "そうね。\nギャヴィの言うとおり。",
            "zh": "是啊。\n就像加维说的一样。",
            "narrator_zh": "绫水"
        },
        {
            "location": "398/TALK",
            "narrator": "アーヤ",
            "text": "わたしずっと姉を\n守ってるつもり\nだったけど。",
            "zh": "我虽然一直以为\n自己是在\n保护姐姐。",
            "narrator_zh": "绫水"
        },
        {
            "location": "399/TALK",
            "narrator": "アーヤ",
            "text": "本当は認められたかった\nだけなのかもしれないわ。",
            "zh": "但其实或许只是\n想得到她的认可罢了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "400/TALK",
            "narrator": "アーヤ",
            "text": "お姉ちゃんは\nダメなんだからその分\n私がしっかりしないと。",
            "zh": "姐姐太靠不住了，\n所以连她的份一起，\n我必须更加可靠才行。",
            "narrator_zh": "绫水"
        },
        {
            "location": "401/TALK",
            "narrator": "アーヤ",
            "text": "そう思ってたのにね。",
            "zh": "明明之前一直是这么想的呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "402/SEL",
            "narrator": "",
            "text": "そんなエリカの業績を聞きたい",
            "zh": "好想听听那样的领火的成就",
            "narrator_zh": ""
        },
        {
            "location": "403/SEL",
            "narrator": "",
            "text": "エリカ何作ってたの？",
            "zh": "领火以前都在做些什么？",
            "narrator_zh": ""
        },
        {
            "location": "404/SEL",
            "narrator": "",
            "text": "姉妹百合萌える",
            "zh": "姐妹百合太萌了",
            "narrator_zh": ""
        },
        {
            "location": "405/ACT",
            "narrator": "",
            "text": "姉妹百合萌える",
            "zh": "姐妹百合太萌了",
            "narrator_zh": ""
        },
        {
            "location": "406/ACT",
            "narrator": "",
            "text": "姉妹百合萌える",
            "zh": "姐妹百合太萌了",
            "narrator_zh": ""
        },
        {
            "location": "407/ACT",
            "narrator": "",
            "text": "姉妹百合萌える",
            "zh": "姐妹百合太萌了",
            "narrator_zh": ""
        },
        {
            "location": "422/TALK",
            "narrator": "プレイヤー",
            "text": "姉妹百合萌える",
            "zh": "姐妹百合太萌了",
            "narrator_zh": "玩家"
        },
        {
            "location": "424/TALK",
            "narrator": "アーヤ",
            "text": "え？",
            "zh": "哎？",
            "narrator_zh": "绫水"
        },
        {
            "location": "425/TALK",
            "narrator": "アーヤ",
            "text": "は？",
            "zh": "哈？",
            "narrator_zh": "绫水"
        },
        {
            "location": "426/SEL",
            "narrator": "",
            "text": "いや、誤解だ",
            "zh": "不，这是误会",
            "narrator_zh": ""
        },
        {
            "location": "427/SEL",
            "narrator": "",
            "text": "そんなこと言ってないし！",
            "zh": "我才没说那种话！",
            "narrator_zh": ""
        },
        {
            "location": "428/SEL",
            "narrator": "",
            "text": "いい話ぶちこわし！",
            "zh": "好好的气氛全毁了！",
            "narrator_zh": ""
        },
        {
            "location": "429/SEL",
            "narrator": "",
            "text": "百合は尊い…",
            "zh": "百合太尊了……",
            "narrator_zh": ""
        },
        {
            "location": "430/ACT",
            "narrator": "",
            "text": "百合は尊い…",
            "zh": "百合太尊了……",
            "narrator_zh": ""
        },
        {
            "location": "431/ACT",
            "narrator": "",
            "text": "百合は尊い…",
            "zh": "百合太尊了……",
            "narrator_zh": ""
        },
        {
            "location": "432/ACT",
            "narrator": "",
            "text": "百合は尊い…",
            "zh": "百合太尊了……",
            "narrator_zh": ""
        },
        {
            "location": "433/ACT",
            "narrator": "",
            "text": "百合は尊い…",
            "zh": "百合太尊了……",
            "narrator_zh": ""
        },
        {
            "location": "435/TALK",
            "narrator": "アーヤ",
            "text": "もういいわ",
            "zh": "够了",
            "narrator_zh": "绫水"
        },
        {
            "location": "437/TALK",
            "narrator": "アーヤ",
            "text": "切るから！",
            "zh": "我要挂了！",
            "narrator_zh": "绫水"
        },
        {
            "location": "448/TALK",
            "narrator": "ガブリエラ",
            "text": "…きっかけが\n何だったとしても。",
            "zh": "……不管契机\n究竟是什么。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "449/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤが世界で一番\nなのは本当だし。",
            "zh": "绫水是世界上最厉害的，\n这一点是真的啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "450/TALK",
            "narrator": "ガブリエラ",
            "text": "それに実際に\nお姉さんを\n守っていたんでしょ。",
            "zh": "而且实际上，\n你也确实\n保护过你姐姐吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "451/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤは別に\n間違ってないわ。",
            "zh": "绫水并没有\n做错什么哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "454/TALK",
            "narrator": "アーヤ",
            "text": "そうね。\nありがとう。",
            "zh": "是啊。\n谢谢你。",
            "narrator_zh": "绫水"
        },
        {
            "location": "457/TALK",
            "narrator": "アーヤ",
            "text": "だからなのかしら。",
            "zh": "大概也是因为这样吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "458/TALK",
            "narrator": "ガブリエラ",
            "text": "何が？",
            "zh": "什么？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "459/TALK",
            "narrator": "アーヤ",
            "text": "姉がここに\n戻ってないって\n聞いた時。",
            "zh": "听说姐姐没有\n回到这里\n的时候。",
            "narrator_zh": "绫水"
        },
        {
            "location": "460/TALK",
            "narrator": "アーヤ",
            "text": "もう本当に悔しくて！\n戻ってくるんじゃ\nなかったって思ったの。",
            "zh": "我心里真的好不甘心！\n甚至觉得还不如\n别回来算了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "461/TALK",
            "narrator": "アーヤ",
            "text": "本当に勝手なんだからって\n怒ってたけど。",
            "zh": "嘴上气呼呼地说她\n真是太任性了，",
            "narrator_zh": "绫水"
        },
        {
            "location": "463/TALK",
            "narrator": "アーヤ",
            "text": "本当は会いたかった\nだけなのかも。",
            "zh": "可其实或许只是\n想见她一面罢了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "464/TALK",
            "narrator": "ガブリエラ",
            "text": "ぷっ。",
            "zh": "噗。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "466/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤったら。\nただ拗ねてる\nだけじゃない。",
            "zh": "绫水真是的。\n说白了不就是\n在闹别扭嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "467/TALK",
            "narrator": "アーヤ",
            "text": "そんな言い方\nしないでよ…！",
            "zh": "别用那种说法\n说我啦……！",
            "narrator_zh": "绫水"
        },
        {
            "location": "468/TALK",
            "narrator": "ガブリエラ",
            "text": "だって。\n他に言い方\nないじゃない。",
            "zh": "可除此之外。\n也没有别的\n说法了嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "469/TALK",
            "narrator": "アーヤ",
            "text": "もー！",
            "zh": "真是的——！",
            "narrator_zh": "绫水"
        },
        {
            "location": "471/TALK",
            "narrator": "ガブリエラ",
            "text": "…でも。\nアーヤの気持ち、\n少しわかるわ。",
            "zh": "……不过。\n绫水的心情，\n我多少也能理解。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "472/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしもお父様には\n素直になれない。",
            "zh": "我对父亲大人，\n也没办法坦率起来。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "473/TALK",
            "narrator": "ガブリエラ",
            "text": "……少なくとも今は。",
            "zh": "……至少现在是这样。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "474/TALK",
            "narrator": "アーヤ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "476/TALK",
            "narrator": "ガブリエラ",
            "text": "ねえアーヤ。\n小さい頃の\n写真ってないの？",
            "zh": "我说绫水。\n有没有小时候的\n照片呀？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "477/TALK",
            "narrator": "ガブリエラ",
            "text": "お姉さんとアーヤ\n見てみたいわ。",
            "zh": "好想看看你姐姐\n和绫水小时候的样子哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "478/TALK",
            "narrator": "アーヤ",
            "text": "えっ…。",
            "zh": "哎……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "479/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤは意外と\nおてんばだった\nみたいだし。",
            "zh": "绫水好像意外地\n挺像个\n假小子呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "480/TALK",
            "narrator": "ガブリエラ",
            "text": "なんだがすごく\n興味が出てきたの。",
            "zh": "不知怎么的，\n突然非常感兴趣了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "481/TALK",
            "narrator": "ガブリエラ",
            "text": "実家だもの\nあるわよね？",
            "zh": "既然是老家，\n肯定有的吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "482/TALK",
            "narrator": "アーヤ",
            "text": "あ、あるけど……。",
            "zh": "有、倒是有……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "483/TALK",
            "narrator": "ガブリエラ",
            "text": "みやびと三人で\n鑑賞会よ！",
            "zh": "那就和雅三个人\n一起开鉴赏会咯！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "485/TALK",
            "narrator": "アーヤ",
            "text": "ちょっと！　勝手に\n決めないでよ！",
            "zh": "喂！别擅自\n就替我做决定啊！",
            "narrator_zh": "绫水"
        },
        {
            "location": "487/TALK",
            "narrator": "アーヤ",
            "text": "もー……！",
            "zh": "真是的……！",
            "narrator_zh": "绫水"
        },
        {
            "location": "499/DIALOG",
            "narrator": "Dialog_chapter_ch02",
            "text": "【22 トークン・リング】",
            "zh": "【22 令牌环网】",
            "narrator_zh": "Dialog_chapter_ch02"
        }
    ]
}
