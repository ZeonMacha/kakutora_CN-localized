    "entry": [
        {
            "location": "70/SCENARIO",
            "narrator": "",
            "text": "ある晴れた日に",
            "zh": "在某个晴天",
            "narrator_zh": ""
        },
        {
            "location": "95/TALK",
            "narrator": "アーヤ",
            "text": "何の変哲もない晴れた日に",
            "zh": "在一个平平无奇的晴天",
            "narrator_zh": "绫水"
        },
        {
            "location": "96/TALK",
            "narrator": "アーヤ",
            "text": "世界が突然",
            "zh": "世界突然",
            "narrator_zh": "绫水"
        },
        {
            "location": "97/TALK",
            "narrator": "アーヤ",
            "text": "変わってしまった",
            "zh": "变了",
            "narrator_zh": "绫水"
        },
        {
            "location": "99/SEL",
            "narrator": "",
            "text": "ゲームの話？",
            "zh": "是在说游戏？",
            "narrator_zh": ""
        },
        {
            "location": "100/SEL",
            "narrator": "",
            "text": "幼稚園児にはハードすぎる内容じゃない？",
            "zh": "对幼儿园的孩子会不会太沉重了？",
            "narrator_zh": ""
        },
        {
            "location": "101/SEL",
            "narrator": "",
            "text": "アーヤと$me$の出会いの日だ",
            "zh": "是绫水和$me$相遇的日子",
            "narrator_zh": ""
        },
        {
            "location": "102/ACT",
            "narrator": "",
            "text": "ゲームの話？",
            "zh": "是在说游戏？",
            "narrator_zh": ""
        },
        {
            "location": "103/TALK",
            "narrator": "アーヤ",
            "text": "ゲームっていう蚊",
            "zh": "说是游戏的蚊子[?]",
            "narrator_zh": "绫水"
        },
        {
            "location": "104/TALK",
            "narrator": "アーヤ",
            "text": "いうか",
            "zh": "这么说",
            "narrator_zh": "绫水"
        },
        {
            "location": "105/TALK",
            "narrator": "アーヤ",
            "text": "現実世界の話ね",
            "zh": "是现实世界的事",
            "narrator_zh": "绫水"
        },
        {
            "location": "106/ACT",
            "narrator": "",
            "text": "幼稚園児にはハードすぎる内容じゃない？",
            "zh": "对幼儿园的孩子会不会太沉重了？",
            "narrator_zh": ""
        },
        {
            "location": "107/TALK",
            "narrator": "アーヤ",
            "text": "人形劇の話じゃないわよ",
            "zh": "不是人偶剧的事哦",
            "narrator_zh": "绫水"
        },
        {
            "location": "109/TALK",
            "narrator": "アーヤ",
            "text": "でも",
            "zh": "不过",
            "narrator_zh": "绫水"
        },
        {
            "location": "110/TALK",
            "narrator": "アーヤ",
            "text": "先生には受けるかもだわ",
            "zh": "老师也许会吃这套",
            "narrator_zh": "绫水"
        },
        {
            "location": "111/ACT",
            "narrator": "",
            "text": "アーヤと$me$の出会いの日だ",
            "zh": "是绫水和$me$相遇的日子",
            "narrator_zh": ""
        },
        {
            "location": "113/TALK",
            "narrator": "アーヤ",
            "text": "そんなに衝撃的な出会いだったかしら",
            "zh": "相遇有那么冲击吗",
            "narrator_zh": "绫水"
        },
        {
            "location": "114/TALK",
            "narrator": "アーヤ",
            "text": "それじゃまるで",
            "zh": "那样简直",
            "narrator_zh": "绫水"
        },
        {
            "location": "115/TALK",
            "narrator": "アーヤ",
            "text": "運命の相手と出会ったみたいじゃないの",
            "zh": "像是遇见了命定之人",
            "narrator_zh": "绫水"
        },
        {
            "location": "117/TALK",
            "narrator": "アーヤ",
            "text": "今ってトライナリーで活動するのが",
            "zh": "现在在三重奏活动",
            "narrator_zh": "绫水"
        },
        {
            "location": "118/TALK",
            "narrator": "アーヤ",
            "text": "日常になってるけど",
            "zh": "已经成了日常",
            "narrator_zh": "绫水"
        },
        {
            "location": "119/TALK",
            "narrator": "アーヤ",
            "text": "これって本来",
            "zh": "可这本来",
            "narrator_zh": "绫水"
        },
        {
            "location": "120/TALK",
            "narrator": "アーヤ",
            "text": "非常事態なわけよね",
            "zh": "是非常事态吧",
            "narrator_zh": "绫水"
        },
        {
            "location": "122/SEL",
            "narrator": "",
            "text": "この国の礎となれ",
            "zh": "去当这个国家的基石",
            "narrator_zh": ""
        },
        {
            "location": "123/SEL",
            "narrator": "",
            "text": "慣れだよ、慣れ",
            "zh": "是习惯，习惯",
            "narrator_zh": ""
        },
        {
            "location": "124/SEL",
            "narrator": "",
            "text": "だからこそアーヤと$me$は出会えたんだ",
            "zh": "所以绫水和$me$才能相遇",
            "narrator_zh": ""
        },
        {
            "location": "125/ACT",
            "narrator": "",
            "text": "この国の礎となれ",
            "zh": "去当这个国家的基石",
            "narrator_zh": ""
        },
        {
            "location": "126/TALK",
            "narrator": "アーヤ",
            "text": "や",
            "zh": "呀",
            "narrator_zh": "绫水"
        },
        {
            "location": "127/TALK",
            "narrator": "アーヤ",
            "text": "ちょっと",
            "zh": "等等",
            "narrator_zh": "绫水"
        },
        {
            "location": "128/TALK",
            "narrator": "アーヤ",
            "text": "そういうのは",
            "zh": "那种话",
            "narrator_zh": "绫水"
        },
        {
            "location": "129/TALK",
            "narrator": "アーヤ",
            "text": "怖いから",
            "zh": "很可怕",
            "narrator_zh": "绫水"
        },
        {
            "location": "130/TALK",
            "narrator": "アーヤ",
            "text": "やめてよね",
            "zh": "别说了",
            "narrator_zh": "绫水"
        },
        {
            "location": "131/ACT",
            "narrator": "",
            "text": "慣れだよ、慣れ",
            "zh": "是习惯，习惯",
            "narrator_zh": ""
        },
        {
            "location": "132/TALK",
            "narrator": "アーヤ",
            "text": "そうなのよ",
            "zh": "就是这样啊",
            "narrator_zh": "绫水"
        },
        {
            "location": "133/TALK",
            "narrator": "アーヤ",
            "text": "慣れちゃったのよね",
            "zh": "已经习惯了",
            "narrator_zh": "绫水"
        },
        {
            "location": "134/TALK",
            "narrator": "アーヤ",
            "text": "非日常って日常に",
            "zh": "非日常变成了日常",
            "narrator_zh": "绫水"
        },
        {
            "location": "135/ACT",
            "narrator": "",
            "text": "だからこそアーヤと$me$は出会えたんだ",
            "zh": "所以绫水和$me$才能相遇",
            "narrator_zh": ""
        },
        {
            "location": "137/TALK",
            "narrator": "アーヤ",
            "text": "またそういう",
            "zh": "又是这种话",
            "narrator_zh": "绫水"
        },
        {
            "location": "138/TALK",
            "narrator": "アーヤ",
            "text": "でも確かに",
            "zh": "不过确实",
            "narrator_zh": "绫水"
        },
        {
            "location": "139/TALK",
            "narrator": "アーヤ",
            "text": "そうじゃなければ",
            "zh": "若不是那样",
            "narrator_zh": "绫水"
        },
        {
            "location": "140/TALK",
            "narrator": "アーヤ",
            "text": "出会えてないのよね",
            "zh": "就遇不到了",
            "narrator_zh": "绫水"
        },
        {
            "location": "141/TALK",
            "narrator": "アーヤ",
            "text": "不思議だわ",
            "zh": "真不可思议",
            "narrator_zh": "绫水"
        },
        {
            "location": "145/TALK",
            "narrator": "アーヤ",
            "text": "ひょっとして運命？",
            "zh": "难道是命运？",
            "narrator_zh": "绫水"
        },
        {
            "location": "148/TALK",
            "narrator": "アーヤ",
            "text": "なんてね",
            "zh": "开玩笑的",
            "narrator_zh": "绫水"
        }
    ]
}
