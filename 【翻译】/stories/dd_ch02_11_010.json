        "title": "Extra002 プレミアムストーリー",
        "sub_title": "待ち受け",
        "title_zh": "Extra002 额外剧情",
        "sub_title_zh": "待机壁纸"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "待ち受け",
            "zh": "待机壁纸",
            "narrator_zh": ""
        },
        {
            "location": "23/TALK",
            "narrator": "みやび",
            "text": "へぇ、つばめちゃんは\nやっぱりそれなんやね。",
            "zh": "哦，燕\n果然用的就是那个咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "25/TALK",
            "narrator": "つばめ",
            "text": "はい！　メノウちゃんは\nわたしにとっての神様\nみたいな人ですから。",
            "zh": "是的！毕竟MENOW\n对我来说就像是\n神明一样的人呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "27/TALK",
            "narrator": "神楽",
            "text": "そ、それはちょっと、\n大袈裟のような…。",
            "zh": "这、这稍微有点\n太夸张了吧……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "28/TALK",
            "narrator": "ガブリエラ",
            "text": "もっと一般受けするのに\nすればいいのに。",
            "zh": "明明用更大众一点的\n不就好了嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "30/TALK",
            "narrator": "みやび",
            "text": "ガブちゃん、人のこと\n言えんき。",
            "zh": "加布，你也没资格\n说别人啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "32/TALK",
            "narrator": "アーヤ",
            "text": "何だか盛り上がってる\nみたいだけど、\n何を話してるの？",
            "zh": "好像聊得很热火，\n你们在说\n什么呀？",
            "narrator_zh": "绫水"
        },
        {
            "location": "34/TALK",
            "narrator": "神楽",
            "text": "スマホの待ち受け画面を\n何にしているのか、\n見せ合ってたんです。",
            "zh": "大家正在互相展示\n手机的待机画面\n用的都是什么呢。",
            "narrator_zh": "神乐"
        },
        {
            "location": "36/TALK",
            "narrator": "みやび",
            "text": "うちのはカプドラの\n期間限定配布された\n壁紙や。",
            "zh": "我的是卡普多拉\n期间限定发放的\n壁纸。",
            "narrator_zh": "雅"
        },
        {
            "location": "38/TALK",
            "narrator": "つばめ",
            "text": "わたしは、メノウちゃんの\n写真を画像にしてます。",
            "zh": "我把MENOW的照片\n设成图片了哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "40/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしは東京タワーを\n真下から撮った写真よ。",
            "zh": "我的是从正下方拍的\n东京塔照片哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "41/TALK",
            "narrator": "神楽",
            "text": "それで私が、大好きな\nラノベのキャラ絵です。",
            "zh": "然后我的是最喜欢的\n轻小说角色插画。",
            "narrator_zh": "神乐"
        },
        {
            "location": "45/TALK",
            "narrator": "ガブリエラ",
            "text": "それ、二次絵じゃない。\n何で公式絵にしないの？",
            "zh": "那不是同人图嘛。\n为什么不用官图啊？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "47/TALK",
            "narrator": "神楽",
            "text": "私はこの絵描きさんの\n絵が一番好きなんです。",
            "zh": "我最喜欢这位画师\n画的图了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "48/TALK",
            "narrator": "アーヤ",
            "text": "いけない！\nこの話の流れだと…。",
            "zh": "糟了！\n照这个话题发展下去……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "50/TALK",
            "narrator": "神楽",
            "text": "アーヤさんは何の壁紙に\nしてるんですか？",
            "zh": "绫水用的是什么\n壁纸呢？",
            "narrator_zh": "神乐"
        },
        {
            "location": "55/TALK",
            "narrator": "アーヤ",
            "text": "えっ！？\nえ、えっと…。",
            "zh": "哎！？\n那、那个……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "56/SEL",
            "narrator": "",
            "text": "端末壁紙変更：初期状態",
            "zh": "更改终端壁纸：初始状态",
            "narrator_zh": ""
        },
        {
            "location": "57/SEL",
            "narrator": "",
            "text": "端末壁紙変更：アイドル",
            "zh": "更改终端壁纸：偶像",
            "narrator_zh": ""
        },
        {
            "location": "58/SEL",
            "narrator": "",
            "text": "端末壁紙変更：満月",
            "zh": "更改终端壁纸：满月",
            "narrator_zh": ""
        },
        {
            "location": "60/TALK",
            "narrator": "アーヤ",
            "text": "どうしよう…今の壁紙を\n見られるのはマズイわ。",
            "zh": "怎么办……要是被看到\n现在的壁纸就糟了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "62/TALK",
            "narrator": "神楽",
            "text": "アーヤさん？",
            "zh": "绫水？",
            "narrator_zh": "神乐"
        },
        {
            "location": "65/TALK",
            "narrator": "ガブリエラ",
            "text": "別に隠す必要ないでしょ？",
            "zh": "没必要藏着掖着吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "66/TALK",
            "narrator": "アーヤ",
            "text": "か、隠してなんかないわ！\nただ、こういうのって\nちょっと恥ずかしくて…。",
            "zh": "我、我才没有藏呢！\n只是这种东西\n让人有点害羞嘛……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "67/TALK",
            "narrator": "みやび",
            "text": "イヤらしい壁紙にでも\nしてるが？",
            "zh": "难道你用了什么\n色色的壁纸？",
            "narrator_zh": "雅"
        },
        {
            "location": "69/TALK",
            "narrator": "アーヤ",
            "text": "そんなわけないでしょ！",
            "zh": "怎么可能啊！",
            "narrator_zh": "绫水"
        },
        {
            "location": "72/TALK",
            "narrator": "みやび",
            "text": "なら、すっと出して\n見せるちや。",
            "zh": "那就爽快拿出来\n给我们看咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "76/TALK",
            "narrator": "アーヤ",
            "text": "…こ、こうなったら！",
            "zh": "……既、既然这样！",
            "narrator_zh": "绫水"
        },
        {
            "location": "81/TALK",
            "narrator": "みやび",
            "text": "んっ？",
            "zh": "嗯？",
            "narrator_zh": "雅"
        },
        {
            "location": "82/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょ、なに！？\nいきなり写真撮って…。",
            "zh": "等、干嘛啊！？\n突然拍照……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "83/TALK",
            "narrator": "アーヤ",
            "text": "ごめん、急にいいことを\n思いついちゃったの。",
            "zh": "抱歉，我突然想到一个\n好主意。",
            "narrator_zh": "绫水"
        },
        {
            "location": "85/TALK",
            "narrator": "アーヤ",
            "text": "みんなが楽しそうに\n話し合ってる写真を、\n壁紙にさせてもらうわ。",
            "zh": "大家聊得这么开心的\n照片，就拿来\n当我的壁纸吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "86/TALK",
            "narrator": "ガブリエラ",
            "text": "…上手く逃げたわね。",
            "zh": "……溜得挺快嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "87/TALK",
            "narrator": "みやび",
            "text": "なるほど、そういう\n逃げ方もあるんか…\n勉強になったがよ。",
            "zh": "原来如此，还有这种\n脱身办法啊……\n学到了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "88/TALK",
            "narrator": "アーヤ",
            "text": "に、逃げてない！\n別に逃げたわけじゃ\nないわ。",
            "zh": "没、没有逃！\n我才不是在逃避\n呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "89/TALK",
            "narrator": "神楽",
            "text": "アーヤさん、一体どんな\n待ち受けにしていたん\nでしょうか？",
            "zh": "绫水之前到底\n用的是什么样的\n待机壁纸呢？",
            "narrator_zh": "神乐"
        },
        {
            "location": "91/TALK",
            "narrator": "つばめ",
            "text": "う～ん…ちょっとだけ\n気になるよね。",
            "zh": "唔～……稍微有点\n让人在意呢。",
            "narrator_zh": "燕"
        },
        {
            "location": "92/TALK",
            "narrator": "アーヤ",
            "text": "ただの風景写真よ。\n気にするほどでも\nないってば。",
            "zh": "只是普通的风景照啦。\n用不着那么\n在意啦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "93/TALK",
            "narrator": "アーヤ",
            "text": "…見せたくない壁紙を\n使ってたって、\nバレバレよね。",
            "zh": "……用了不想给人看的\n壁纸这件事，\n完全暴露了呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "94/TALK",
            "narrator": "アーヤ",
            "text": "でも――",
            "zh": "不过——",
            "narrator_zh": "绫水"
        },
        {
            "location": "95/TALK",
            "narrator": "アーヤ",
            "text": "みんなが写った写真って、\nまだ一枚も持ってなかった\nのよね。",
            "zh": "有大家在的照片，\n我还一张都没有\n留过呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "97/TALK",
            "narrator": "アーヤ",
            "text": "ふふっ、偶然とはいえ、\n良い記念写真が\n手に入ったわ。",
            "zh": "呵呵，虽说是偶然，\n但也算拍到一张\n不错的纪念照了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "99/ACT",
            "narrator": "",
            "text": "端末壁紙変更：初期状態",
            "zh": "更改终端壁纸：初始状态",
            "narrator_zh": ""
        },
        {
            "location": "100/TALK",
            "narrator": "アーヤ",
            "text": "…さすがにこれ以上\n隠すのは無理かも。",
            "zh": "……再继续藏下去\n果然还是不行吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "101/TALK",
            "narrator": "アーヤ",
            "text": "もういいわ！\n覚悟決めてやる！",
            "zh": "算了！\n豁出去了！",
            "narrator_zh": "绫水"
        },
        {
            "location": "107/TALK",
            "narrator": "アーヤ",
            "text": "わ、私のは、これよ！",
            "zh": "我、我的是这个！",
            "narrator_zh": "绫水"
        },
        {
            "location": "110/TALK",
            "narrator": "つばめ",
            "text": "…あれ？\nこの壁紙って確か…。",
            "zh": "……咦？\n这张壁纸记得好像……。",
            "narrator_zh": "燕"
        },
        {
            "location": "113/TALK",
            "narrator": "ガブリエラ",
            "text": "初期設定の壁紙じゃない。\nアーヤって壁紙変えない\nタイプなの？",
            "zh": "这不是初始设置的壁纸嘛。\n绫水你是那种不会换\n壁纸的类型吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "115/TALK",
            "narrator": "アーヤ",
            "text": "…えっ？",
            "zh": "……哎？",
            "narrator_zh": "绫水"
        },
        {
            "location": "116/TALK",
            "narrator": "神楽",
            "text": "バイクの写真にしてると\n思ったんだけどなぁ…。",
            "zh": "我还以为你会用\n摩托车的照片呢……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "117/TALK",
            "narrator": "みやび",
            "text": "あんま壁紙とか気にせん\nタイプなんやね。\n初めて知ったがよ。",
            "zh": "原来你是不太在意\n壁纸的那种类型啊。\n还是头一次知道咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "120/TALK",
            "narrator": "アーヤ",
            "text": "え、ええ…まあね。",
            "zh": "嗯、嗯……算是吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "122/TALK",
            "narrator": "みやび",
            "text": "それよりガブちゃん。\nその東京タワーの写真、\n送ってもらえん？",
            "zh": "比起那个，加布。\n那张东京塔的照片，\n能发给我吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "125/TALK",
            "narrator": "ガブリエラ",
            "text": "いいわよ。\nあたしもカプドラの\n壁紙欲しかったし。",
            "zh": "可以啊。\n反正我也想要\n卡普多拉的壁纸。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "128/TALK",
            "narrator": "つばめ",
            "text": "あ、わたしも送って\n欲しいです！",
            "zh": "啊，我也想要，\n请发给我呀！",
            "narrator_zh": "燕"
        },
        {
            "location": "131/TALK",
            "narrator": "アーヤ",
            "text": "まさか、これって…。",
            "zh": "难道说，这是……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "136/TALK",
            "narrator": "アーヤ",
            "text": "もしかして、壁紙変えてくれたの？",
            "zh": "该不会，是你帮我换了壁纸？",
            "narrator_zh": "绫水"
        },
        {
            "location": "138/SEL",
            "narrator": "",
            "text": "変えられたみたい",
            "zh": "好像真的换成功了",
            "narrator_zh": ""
        },
        {
            "location": "139/ACT",
            "narrator": "",
            "text": "変えられたみたい",
            "zh": "好像真的换成功了",
            "narrator_zh": ""
        },
        {
            "location": "141/TALK",
            "narrator": "アーヤ",
            "text": "やっぱり！",
            "zh": "果然！",
            "narrator_zh": "绫水"
        },
        {
            "location": "142/TALK",
            "narrator": "アーヤ",
            "text": "気が利くわね(≧∇≦)b",
            "zh": "真机灵呢(≧∇≦)b",
            "narrator_zh": "绫水"
        },
        {
            "location": "143/TALK",
            "narrator": "アーヤ",
            "text": "これからは、見られて良い写真を壁紙に使うようにするわ",
            "zh": "今后我会挑就算被人看到也没问题的照片当壁纸的",
            "narrator_zh": "绫水"
        },
        {
            "location": "146/SEL",
            "narrator": "",
            "text": "何の壁紙だったの？",
            "zh": "原本是什么壁纸？",
            "narrator_zh": ""
        },
        {
            "location": "147/ACT",
            "narrator": "",
            "text": "何の壁紙だったの？",
            "zh": "原本是什么壁纸？",
            "narrator_zh": ""
        },
        {
            "location": "149/TALK",
            "narrator": "アーヤ",
            "text": "( *´艸`)",
            "zh": "( *´艸`)",
            "narrator_zh": "绫水"
        },
        {
            "location": "150/TALK",
            "narrator": "アーヤ",
            "text": "今は秘密よ",
            "zh": "现在还是秘密哦",
            "narrator_zh": "绫水"
        },
        {
            "location": "151/TALK",
            "narrator": "アーヤ",
            "text": "でも",
            "zh": "不过",
            "narrator_zh": "绫水"
        },
        {
            "location": "152/TALK",
            "narrator": "アーヤ",
            "text": "いつかは話すわ",
            "zh": "总有一天会告诉你的",
            "narrator_zh": "绫水"
        },
        {
            "location": "163/ACT",
            "narrator": "",
            "text": "端末壁紙変更：アイドル",
            "zh": "更改终端壁纸：偶像",
            "narrator_zh": ""
        },
        {
            "location": "165/TALK",
            "narrator": "アーヤ",
            "text": "…さすがにこれ以上\n隠すのは無理かも。",
            "zh": "……再继续藏下去\n果然还是不行吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "166/TALK",
            "narrator": "アーヤ",
            "text": "もういいわ！\n覚悟決めてやる！",
            "zh": "算了！\n豁出去了！",
            "narrator_zh": "绫水"
        },
        {
            "location": "172/TALK",
            "narrator": "アーヤ",
            "text": "わ、私のは、これよ！",
            "zh": "我、我的是这个！",
            "narrator_zh": "绫水"
        },
        {
            "location": "176/TALK",
            "narrator": "ガブリエラ",
            "text": "は、はぁ！？",
            "zh": "哈、哈啊！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "178/TALK",
            "narrator": "つばめ",
            "text": "この人達って確か、\nアイドルグループの\n『ジェネシス』ですよね？",
            "zh": "这几位记得没错的话，\n是偶像组合\n『杰内西斯』对吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "180/TALK",
            "narrator": "アーヤ",
            "text": "…え？",
            "zh": "……哎？",
            "narrator_zh": "绫水"
        },
        {
            "location": "182/TALK",
            "narrator": "みやび",
            "text": "こ、これはビックリした\nがよ。",
            "zh": "这、这还真是吓到我了\n咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "183/TALK",
            "narrator": "みやび",
            "text": "まさかアーヤが、\n男性アイドルグループの\n壁紙を使っちゅうとは…。",
            "zh": "真没想到绫水居然\n在用男偶像组合的\n壁纸……。",
            "narrator_zh": "雅"
        },
        {
            "location": "187/TALK",
            "narrator": "アーヤ",
            "text": "え、えぇっ！？\nうそっ、なんで！？",
            "zh": "哎、哎哎！？\n骗人的吧，为什么！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "188/TALK",
            "narrator": "神楽",
            "text": "アーヤさんがアイドルの\nファンだったなんて、\n初めて知りました。",
            "zh": "没想到绫水竟然是\n偶像的粉丝，\n我还是第一次听说。",
