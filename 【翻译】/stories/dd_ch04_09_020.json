{
    "dir": "chap09/daydra/dd_ch04_09_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "9456",
        "cid": "miyabi",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "校庭でのこと",
        "title_zh": "Extra006 额外剧情",
        "sub_title_zh": "操场上的事"
    },
    "entry": [
        {
            "location": "296/SCENARIO",
            "narrator": "",
            "text": "校庭でのこと",
            "zh": "操场上的事",
            "narrator_zh": ""
        },
        {
            "location": "312/TALK",
            "narrator": "みやび",
            "text": "はぁ……\n面倒なことになったわ。",
            "zh": "哈啊……\n搞出麻烦事来了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "315/TALK",
            "narrator": "つばめ",
            "text": "あっ、みやびさん。\nこんなところにいる\nなんて珍しいですね。",
            "zh": "啊，雅。\n你居然会在\n这种地方，好稀奇啊。",
            "narrator_zh": "燕"
        },
        {
            "location": "319/TALK",
            "narrator": "みやび",
            "text": "つばめちゃん、うちを\nヒッキーか何かと\n勘違いしちょらんか？",
            "zh": "燕，你该不会\n把我当成家里蹲\n什么的了吧？",
            "narrator_zh": "雅"
        },
        {
            "location": "320/TALK",
            "narrator": "つばめ",
            "text": "い、いえ！\nそんなことは……。",
            "zh": "不、不是！\n才没有……。",
            "narrator_zh": "燕"
        },
        {
            "location": "322/TALK",
            "narrator": "つばめ",
            "text": "って、みやびさん！？\nその手に持ってるの\nって……！！",
            "zh": "等等，雅！？\n你手里拿着的\n是……！！",
            "narrator_zh": "燕"
        },
        {
            "location": "323/TALK",
            "narrator": "みやび",
            "text": "見ての通り、小鳥さんや。\nなんちゅう鳥なのかは\n知らんけんど。",
            "zh": "如你所见，是小鸟咯。\n是驷马品种，\n我就不懂了。",
            "narrator_zh": "雅"
        },
        {
            "location": "325/TALK",
            "narrator": "つばめ",
            "text": "いや、そんな呑気な\nこと言ってる場合じゃ\nないですよ！",
            "zh": "不是，现在可不是\n说这种风凉话\n的时候啊！",
            "narrator_zh": "燕"
        },
        {
            "location": "326/TALK",
            "narrator": "つばめ",
            "text": "足に怪我してるじゃ\nないですか！",
            "zh": "它的脚受伤了\n不是吗！",
            "narrator_zh": "燕"
        },
        {
            "location": "328/TALK",
            "narrator": "つばめ",
            "text": "はわわ、どうしよう。\nわたし、絆創膏くらい\nしか持ってないよ。",
            "zh": "哇哇，怎么办。\n我身上只有\n创可贴呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "329/TALK",
            "narrator": "みやび",
            "text": "いや…絆創膏て…\n流石のうちにも、\nその発想は無かったわ。",
            "zh": "不是……创可贴……\n就算是我，\n也没想到这招啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "331/TALK",
            "narrator": "つばめ",
            "text": "あ、あれ？\nだめですか？",
            "zh": "咦、咦？\n不行吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "334/TALK",
            "narrator": "みやび",
            "text": "つばめちゃん……\n寛大なえい婿さん、\nみつかるとえいね。",
            "zh": "燕……\n要是能找到宽宏大量的\n好夫婿就咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "335/TALK",
            "narrator": "つばめ",
            "text": "いや、言ってる意味が\n全然わからないです。",
            "zh": "不是，完全\n听不懂你在说什么。",
            "narrator_zh": "燕"
        },
        {
            "location": "336/TALK",
            "narrator": "つばめ",
            "text": "それより、その小鳥さん\nなんとか助けないと！",
            "zh": "比起这个，得先\n想办法救那只小鸟才行！",
            "narrator_zh": "燕"
        },
        {
            "location": "339/TALK",
            "narrator": "みやび",
            "text": "わかっちゅう。\nけんど、うちに\n治療スキルはない！",
            "zh": "懂着呢。\n但是，治疗技能\n我是没有的！",
            "narrator_zh": "雅"
        },
        {
            "location": "341/TALK",
            "narrator": "つばめ",
            "text": "で、でもでも、\nこのままじゃ……。",
            "zh": "可、可是可是，\n这样下去……。",
            "narrator_zh": "燕"
        },
        {
            "location": "344/TALK",
            "narrator": "みやび",
            "text": "わかったわかった。\n今聞いてみるき、\nちょっと待ちいや。",
            "zh": "知道了知道了。\n我现在问问看嘛，\n你稍等一下哈。",
            "narrator_zh": "雅"
        },
        {
            "location": "356/TALK",
            "narrator": "みやび",
            "text": "見てのとおりや",
            "zh": "如你所见咯",
            "narrator_zh": "雅"
        },
        {
            "location": "358/SEL",
            "narrator": "",
            "text": "詳しく説明して",
            "zh": "详细说明一下",
            "narrator_zh": ""
        },
        {
            "location": "359/ACT",
            "narrator": "",
            "text": "詳しく説明して",
            "zh": "详细说明一下",
            "narrator_zh": ""
        },
        {
            "location": "361/TALK",
            "narrator": "みやび",
            "text": "怪我した鳥を見つけたけんど、治療スキルも無いき、困っちゅう",
            "zh": "捡到一只受伤的鸟，但我没得治疗技能嘛，愁着呢",
            "narrator_zh": "雅"
        },
        {
            "location": "362/TALK",
            "narrator": "みやび",
            "text": "どうすればえい？",
            "zh": "怎么做才好？",
            "narrator_zh": "雅"
        },
        {
            "location": "365/SEL",
            "narrator": "",
            "text": "つばめに任せよう",
            "zh": "交给燕吧",
            "narrator_zh": ""
        },
        {
            "location": "366/SEL",
            "narrator": "",
            "text": "とりあえず助けよう",
            "zh": "总之先救救它吧",
            "narrator_zh": ""
        },
        {
            "location": "367/ACT",
            "narrator": "",
            "text": "つばめに任せよう",
            "zh": "交给燕吧",
            "narrator_zh": ""
        },
        {
            "location": "368/TALK",
            "narrator": "みやび",
            "text": "…なるほど",
            "zh": "……原来如此",
            "narrator_zh": "雅"
        },
        {
            "location": "369/TALK",
            "narrator": "みやび",
            "text": "うちが一番ラクできる選択をしたか",
            "zh": "选了个让我最省事的选项是没是？",
            "narrator_zh": "雅"
        },
        {
            "location": "381/TALK",
            "narrator": "みやび",
            "text": "機械的な答えやね。\nまあ、所詮はbotちゅう\nことか。",
            "zh": "真是机械的回答呢。\n嘛，毕竟就是个\nbot咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "382/TALK",
            "narrator": "つばめ",
            "text": "あ、みやびさん。\nどこ行くんですか？",
            "zh": "啊，雅。\n你要去哪里呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "385/TALK",
            "narrator": "みやび",
            "text": "この鳥、かなりのうが\nわるそうやき。",
            "zh": "这只鸟，看样子状况\n相当糟糕嘛",
            "narrator_zh": "雅"
        },
        {
            "location": "386/TALK",
            "narrator": "みやび",
            "text": "とりあえず…保健室に\n連れて行くか。",
            "zh": "总之……先带去\n保健室吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "387/TALK",
            "narrator": "つばめ",
            "text": "そっか。学校で怪我を\nしたら、まず保健室\nですよね。",
            "zh": "对哦。在学校\n受了伤，就先去\n保健室对吧。",
            "narrator_zh": "燕"
        },
        {
            "location": "388/TALK",
            "narrator": "つばめ",
            "text": "でも、鳥さんでも\n見てもらえるかな？",
            "zh": "不过，小鸟也\n能给看吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "389/TALK",
            "narrator": "みやび",
            "text": "人しか治さんなんて\n看板、保健室には\n掛かっちょらんき。",
            "zh": "保健室又没挂着\n“只治人类”\n这种招牌嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "391/TALK",
            "narrator": "みやび",
            "text": "ほれ、\nすっと行くちや。",
            "zh": "走咯，\n麻利地去滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "396/TALK",
            "narrator": "つばめ",
            "text": "はい！　あ、置いてか\nないでくださいよー！",
            "zh": "好！　啊，别把我\n丢下呀——！",
            "narrator_zh": "燕"
        },
        {
            "location": "399/ACT",
            "narrator": "",
            "text": "とりあえず助けよう",
            "zh": "总之先救救它吧",
            "narrator_zh": ""
        },
        {
            "location": "401/TALK",
            "narrator": "みやび",
            "text": "無茶いうな。治療スキル無いっていっちゅうが！",
            "zh": "别瞎出主意。都说了没得治疗技能咯！",
            "narrator_zh": "雅"
        },
        {
            "location": "403/SEL",
            "narrator": "",
            "text": "助けてあげて",
            "zh": "去救救它吧",
            "narrator_zh": ""
        },
        {
            "location": "404/ACT",
            "narrator": "",
            "text": "助けてあげて",
            "zh": "去救救它吧",
            "narrator_zh": ""
        },
        {
            "location": "406/TALK",
            "narrator": "みやび",
            "text": "…うむむ、強情なbotやね",
            "zh": "……唔姆姆，真是个顽固的bot咯",
            "narrator_zh": "雅"
        },
        {
            "location": "417/TALK",
            "narrator": "みやび",
            "text": "まあ、聞いたのはうち\nやき、今回は従っちゃる。",
            "zh": "嘛，问的是我嘛，\n这次就依你咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "419/TALK",
            "narrator": "みやび",
            "text": "つばめちゃん、\nいい加減そろそろ\n落ち着きいや。",
            "zh": "燕，你也差不多\n该冷静下来\n了哈。",
            "narrator_zh": "雅"
        },
        {
            "location": "421/TALK",
            "narrator": "つばめ",
            "text": "でも、わたしじゃ\n何もできないし……。",
            "zh": "可是，我什么都\n做不了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "422/TALK",
            "narrator": "つばめ",
            "text": "みやびさんは？",
            "zh": "雅你呢？",
            "narrator_zh": "燕"
        },
        {
            "location": "423/TALK",
            "narrator": "みやび",
            "text": "治療スキルはないと\nさっきから言っちゅう。",
            "zh": "治疗技能没得\n这事，从刚才就说咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "424/TALK",
            "narrator": "みやび",
            "text": "けんど、\n今更放っておくのも\n何や気が引けるき。",
            "zh": "但是，\n事到如今再丢下\n不管，又有点过意不去嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "425/TALK",
            "narrator": "みやび",
            "text": "とりあえず、保健室に\nでも連れて行くか。",
            "zh": "总之，先带去\n保健室吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "427/TALK",
            "narrator": "つばめ",
            "text": "そっか。学校で怪我を\nしたら、まず保健室\nですよね。",
            "zh": "对哦。在学校\n受了伤，就先去\n保健室对吧。",
            "narrator_zh": "燕"
        },
        {
            "location": "428/TALK",
            "narrator": "つばめ",
            "text": "でも、鳥さんでも\n見てもらえるかな？",
            "zh": "不过，小鸟也\n能给看吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "429/TALK",
            "narrator": "みやび",
            "text": "人しか治さんなんて\n看板、保健室には\n掛かっちょらんき。",
            "zh": "保健室又没挂着\n“只治人类”\n这种招牌嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "431/TALK",
            "narrator": "みやび",
            "text": "ほれ、\nすっと行くちや。",
            "zh": "走咯，\n麻利地去滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "432/TALK",
            "narrator": "つばめ",
            "text": "は、はい！",
            "zh": "是、是！",
            "narrator_zh": "燕"
        },
        {
            "location": "434/TALK",
            "narrator": "みやび",
            "text": "はぁ…どうしてうちが\nこんなことを……。",
            "zh": "唉……我怎么\n会来搞这种事……。",
            "narrator_zh": "雅"
        },
        {
            "location": "436/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "448/TALK",
            "narrator": "つばめ",
            "text": "あのね、なんだかみやびさんの機嫌が凄く悪そうなの",
            "zh": "那个呀，雅的心情好像特别差的样子",
            "narrator_zh": "燕"
        },
        {
            "location": "449/TALK",
            "narrator": "つばめ",
            "text": "もしかして、鳥さんがあまり好きじゃないのかな？",
            "zh": "难道说，她其实不太喜欢小鸟吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "452/SEL",
            "narrator": "",
            "text": "余計なことさせたかも",
            "zh": "可能让她做了多余的事",
            "narrator_zh": ""
        },
        {
            "location": "453/SEL",
            "narrator": "",
            "text": "鳥アレルギーなのかも",
            "zh": "可能是对鸟过敏",
            "narrator_zh": ""
        },
        {
            "location": "454/SEL",
            "narrator": "",
            "text": "照れ隠しだよ",
            "zh": "是在掩饰害羞啦",
            "narrator_zh": ""
        },
        {
            "location": "455/ACT",
            "narrator": "",
            "text": "余計なことさせたかな？",
            "zh": "是让她做了多余的事吗？",
            "narrator_zh": ""
        },
        {
            "location": "457/TALK",
            "narrator": "つばめ",
            "text": "Botさんが助けるように言ったの？",
            "zh": "是Bot叫她救的吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "458/TALK",
            "narrator": "つばめ",
            "text": "それじゃあ、わたしが代わるって伝えてみるね",
            "zh": "那我去跟她说，由我来代劳哦",
            "narrator_zh": "燕"
        },
        {
            "location": "470/TALK",
            "narrator": "つばめ",
            "text": "でも、本当に鳥さんが\n嫌いかはわからない\nから…。",
            "zh": "不过，是不是真的\n讨厌小鸟\n还不确定……。",
            "narrator_zh": "燕"
        },
        {
            "location": "472/TALK",
            "narrator": "つばめ",
            "text": "あの、みやびさん。",
            "zh": "那个，雅。",
            "narrator_zh": "燕"
        },
        {
            "location": "473/TALK",
            "narrator": "つばめ",
            "text": "もし用事でもあるなら\nわたしが保健室に\n連れていきますよ？",
            "zh": "如果你有事的\n话，我可以带它\n去保健室哦？",
            "narrator_zh": "燕"
        },
        {
            "location": "475/TALK",
            "narrator": "みやび",
            "text": "ん？　別に構わんよ。",
            "zh": "嗯？　没什么关系咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "476/TALK",
            "narrator": "つばめ",
            "text": "でも……。",
            "zh": "可是……。",
            "narrator_zh": "燕"
        },
        {
            "location": "478/TALK",
            "narrator": "みやび",
            "text": "それに、動かすと\n傷が悪化するかも\nしれんきね。",
            "zh": "再说，挪动它的话\n伤可能会\n恶化嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "479/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "480/TALK",
            "narrator": "みやび",
            "text": "このままうちが\n持って行くのが\n一番えい。",
            "zh": "就这样由我\n拿过去，\n才是最好的。",
            "narrator_zh": "雅"
        },
        {
            "location": "484/TALK",
            "narrator": "つばめ",
            "text": "あ、待ってください。\nみやびさーん！",
            "zh": "啊，请等等。\n雅——！",
            "narrator_zh": "燕"
        },
        {
            "location": "486/TALK",
            "narrator": "つばめ",
            "text": "…みやびさん、もしかして\n鳥さんのこと、結構心配\nしてるのかな？",
            "zh": "……雅，你该不会\n其实挺担心\n那只小鸟的吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "487/ACT",
            "narrator": "",
            "text": "鳥アレルギーなのかも",
            "zh": "可能是对鸟过敏",
            "narrator_zh": ""
        },
        {
            "location": "489/TALK",
            "narrator": "つばめ",
            "text": "えっ！？　それ大変だよ！！",
            "zh": "诶！？　那可不得了呀！！",
            "narrator_zh": "燕"
        },
        {
            "location": "501/TALK",
            "narrator": "つばめ",
            "text": "みやびさん！\n小鳥さんはわたしが\n持ちます！",
            "zh": "雅！\n小鸟由我\n来拿！",
            "narrator_zh": "燕"
        },
        {
            "location": "504/TALK",
            "narrator": "みやび",
            "text": "は？　どうしたが？\n急に。",
            "zh": "哈？　怎么了？\n这么突然。",
            "narrator_zh": "雅"
        },
        {
            "location": "505/TALK",
            "narrator": "つばめ",
            "text": "だってみやびさん、\n鳥アレルギー\nなんですよね？",
            "zh": "因为雅你对鸟\n过敏，\n对吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "506/TALK",
            "narrator": "つばめ",
            "text": "だから機嫌が悪いん\nですよね？",
            "zh": "所以心情才差的\n对吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "508/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "509/TALK",
            "narrator": "つばめ",
            "text": "……みやびさん？",
            "zh": "……雅？",
            "narrator_zh": "燕"
        },
        {
            "location": "511/TALK",
            "narrator": "みやび",
            "text": "……つばめちゃん、\nいいこと教えちゃるき、\nよく聞きいや。",
            "zh": "……燕，\n教你个好东西嘛，\n好好听着哈。",
            "narrator_zh": "雅"
        },
        {
            "location": "512/TALK",
            "narrator": "みやび",
            "text": "botの言うこと、\n素直に信じたら\nいかんぞね。",
            "zh": "bot说的话，\n可不能老老实实\n全信咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "515/TALK",
            "narrator": "つばめ",
            "text": "え？　えっ！？\nそれってどういう…。",
            "zh": "诶？　诶！？\n那是什么意思……。",
            "narrator_zh": "燕"
        },
        {
            "location": "517/TALK",
            "narrator": "みやび",
            "text": "えいから、すっと\n保健室行くき。",
            "zh": "得啦，麻利地\n去保健室嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "522/TALK",
            "narrator": "つばめ",
            "text": "あっ、待って！\nわたしも行きますよー！",
            "zh": "啊，等等！\n我也去呀——！",
            "narrator_zh": "燕"
        },
        {
            "location": "539/ACT",
            "narrator": "",
            "text": "照れ隠しだよ",
            "zh": "是在掩饰害羞啦",
            "narrator_zh": ""
        },
        {
            "location": "540/TALK",
            "narrator": "つばめ",
            "text": "なるほど…うん、納得したよ！",
            "zh": "原来如此……嗯，我懂了！",
            "narrator_zh": "燕"
        },
        {
            "location": "541/TALK",
            "narrator": "つばめ",
            "text": "理由がわかってよかった。ありがとう",
            "zh": "能明白原因太好了。谢谢",
            "narrator_zh": "燕"
        },
        {
            "location": "554/TALK",
            "narrator": "つばめ",
            "text": "えへへ……。",
            "zh": "嘿嘿……。",
            "narrator_zh": "燕"
        },
        {
            "location": "556/TALK",
            "narrator": "みやび",
            "text": "どうしたが？\n変な顔して。",
            "zh": "怎么了？\n一脸怪相。",
            "narrator_zh": "雅"
        },
        {
            "location": "558/TALK",
            "narrator": "つばめ",
            "text": "あ、いえ、なにも…。",
            "zh": "啊，没、没什么……。",
            "narrator_zh": "燕"
        },
        {
            "location": "559/TALK",
            "narrator": "みやび",
            "text": "…………。\nbotのやつが、\n何かゆうたが？",
            "zh": "…………。\n那个bot家伙，\n跟你说了驷马咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "561/TALK",
            "narrator": "つばめ",
            "text": "えっ！？　",
            "zh": "诶！？　",
            "narrator_zh": "燕"
        },
        {
            "location": "562/TALK",
            "narrator": "みやび",
            "text": "正直に白状しいや。\nbotは何を\n言うたが？",
            "zh": "老实交代哈。\n那个bot都\n说了驷马？",
            "narrator_zh": "雅"
        },
        {
            "location": "563/TALK",
            "narrator": "つばめ",
            "text": "…み、みやびさんが\n機嫌悪そうなのは、\n照れ隠しだ、って。",
            "zh": "……它说、雅你\n心情看着差，\n是在害羞掩饰。",
            "narrator_zh": "燕"
        },
        {
            "location": "565/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "566/TALK",
            "narrator": "みやび",
            "text": "つばめちゃん、botの\n言葉を信じすぎたら\nいかんちや。",
            "zh": "燕，bot的话\n信太多了\n可不行滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "567/TALK",
            "narrator": "みやび",
            "text": "あれは所詮機械やき。",
            "zh": "那玩意终究是机器嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "568/TALK",
            "narrator": "みやび",
            "text": "こっちの気持ちなんぞ\nこれっぽっちも\n感じ取れんのやし。",
            "zh": "我们这边的心情，\n它半点\n都感受不到的嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "569/TALK",
            "narrator": "つばめ",
            "text": "そ、そうなんですか？",
            "zh": "是、是这样吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "570/TALK",
            "narrator": "みやび",
            "text": "少なくともうちの\n気持ちを理解して\nないんは確かやわ。",
            "zh": "至少它不理解\n我的心情\n是肯定的咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "572/TALK",
            "narrator": "みやび",
            "text": "さ、無駄口叩いとらんで\nすっと行くき。",
            "zh": "好了，别费口舌了，\n麻利地去嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "576/TALK",
            "narrator": "つばめ",
            "text": "あっ、みやびさん！！",
            "zh": "啊，雅！！",
            "narrator_zh": "燕"
        },
        {
            "location": "579/TALK",
            "narrator": "つばめ",
            "text": "…怒らせちゃったかな？",
            "zh": "……惹她生气了吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "303/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>5月31日　3:20 PM</color>\nとある放課後、学園中庭にて。",
            "zh": "<color=green>5月31日　3:20 PM</color>\n某个放学后，于学园中庭。",
            "narrator_zh": "Dialog_EventData"
        },
        {
            "location": "533/DIALOG",
            "narrator": "Dialog_GEThimegoto_ch04",
            "text": "【擬人化などしておらぬ】",
            "zh": "【才没有拟人化呢】",
            "narrator_zh": "Dialog_GEThimegoto_ch04"
        }
    ]
}
