{
    "dir": "chap18/daydra/dd_ch01_18_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "18156",
        "cid": "tsubame",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "ガブリエラとの買い物",
        "title_zh": "Extra006 额外剧情",
        "sub_title_zh": "和加布里埃拉一起购物"
    },
    "entry": [
        {
            "location": "281/SCENARIO",
            "narrator": "",
            "text": "ガブリエラとの買い物",
            "zh": "和加布里埃拉一起购物",
            "narrator_zh": ""
        },
        {
            "location": "294/TALK",
            "narrator": "ガブリエラ",
            "text": "う～ん…これも良いけど、\nこっちのシャツも素敵ね。",
            "zh": "嗯——……这个也不错，\n这边的衬衫也很棒。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "297/TALK",
            "narrator": "ガブリエラ",
            "text": "つばめ、どっちが良いと\n思う？",
            "zh": "燕，你觉得\n哪个好？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "301/TALK",
            "narrator": "つばめ",
            "text": "難しいなぁ…。\nどっちもガブちゃんに\n似合いそうだし…。",
            "zh": "好难呀……。\n哪个都好像\n适合加布……。",
            "narrator_zh": "燕"
        },
        {
            "location": "302/TALK",
            "narrator": "ガブリエラ",
            "text": "いや、それ全然答えに\nなってないし…。",
            "zh": "不行，这完全\n不算回答……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "305/TALK",
            "narrator": "ガブリエラ",
            "text": "もういいわ。\n試着して自分で\n確かめるから。",
            "zh": "算了。\n我试穿，自己\n确认。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "306/TALK",
            "narrator": "つばめ",
            "text": "ガブちゃん、その服で\n十回目なのに…そんなに\n試着して疲れないのかな？",
            "zh": "加布，那件衣服\n都第十次了……试这么多\n不累吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "309/TALK",
            "narrator": "ガブリエラ",
            "text": "っていうか、つばめは\n良い服見つかった？",
            "zh": "话说，燕\n找到好衣服了吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "310/TALK",
            "narrator": "ガブリエラ",
            "text": "今日はあんたの夏服を\n探しに来たんだから、\n真面目に探しなさいよ。",
            "zh": "今天是来给你找夏装的，\n给我认真\n找。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "311/TALK",
            "narrator": "つばめ",
            "text": "あっ、そうだったよね。",
            "zh": "啊，对哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "312/TALK",
            "narrator": "ガブリエラ",
            "text": "なんで忘れてるのよ…。",
            "zh": "为什么会忘啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "313/TALK",
            "narrator": "つばめ",
            "text": "ガブちゃんが試着した\n姿が、どれも可愛かった\nから――",
            "zh": "加布试穿的样子，\n每一件都好可爱，\n所以——",
            "narrator_zh": "燕"
        },
        {
            "location": "314/TALK",
            "narrator": "つばめ",
            "text": "そっちに夢中になってた\nみたい。",
            "zh": "好像光顾着\n看那个了。",
            "narrator_zh": "燕"
        },
        {
            "location": "317/TALK",
            "narrator": "ガブリエラ",
            "text": "…つばめのこういう\n天然なところ、本当に\n厄介だわ。",
            "zh": "……燕这种\n天然呆的地方，真的\n很麻烦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "318/TALK",
            "narrator": "ガブリエラ",
            "text": "怒るに怒れないじゃない。",
            "zh": "想气也气不起来。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "319/TALK",
            "narrator": "つばめ",
            "text": "…ガブちゃん？",
            "zh": "……加布？",
            "narrator_zh": "燕"
        },
        {
            "location": "322/TALK",
            "narrator": "ガブリエラ",
            "text": "ああ、もういいから。\n気にしない！",
            "zh": "啊，行了。\n别在意！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "323/TALK",
            "narrator": "ガブリエラ",
            "text": "っていうか、このままじゃ\nいつになっても決めそうに\nないし――",
            "zh": "再说，这样下去\n什么时候都\n决定不了——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "324/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしがつばめの服を\n選んであげる。",
            "zh": "我来给你\n选衣服。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "327/TALK",
            "narrator": "つばめ",
            "text": "が、ガブちゃんが選ぶの？",
            "zh": "加、加布来选？",
            "narrator_zh": "燕"
        },
        {
            "location": "329/TALK",
            "narrator": "ガブリエラ",
            "text": "何よ、不満？",
            "zh": "怎么，不满意？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "332/TALK",
            "narrator": "つばめ",
            "text": "う、う～ん…。",
            "zh": "唔、嗯——……。",
            "narrator_zh": "燕"
        },
        {
            "location": "333/TALK",
            "narrator": "つばめ",
            "text": "でも、ガブちゃんって\n凄くオシャレさん\nだから――",
            "zh": "不过，加布\n非常会打扮，\n所以——",
            "narrator_zh": "燕"
        },
        {
            "location": "334/TALK",
            "narrator": "つばめ",
            "text": "わたしが選ぶよりも\n素敵な服を見つけて\nくれるかも。",
            "zh": "也许能找到比我选的\n更棒的\n衣服。",
            "narrator_zh": "燕"
        },
        {
            "location": "335/TALK",
            "narrator": "つばめ",
            "text": "…じゃあ、\nお願いしようかな？",
            "zh": "……那就，\n拜托你了？",
            "narrator_zh": "燕"
        },
        {
            "location": "336/TALK",
            "narrator": "ガブリエラ",
            "text": "うん、よろしい。\n実はもう見つけてたのよ。",
            "zh": "嗯，很好。\n其实我已经找到了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "337/TALK",
            "narrator": "ガブリエラ",
            "text": "つばめってさ、\nワンピース系の服が\n好きだったでしょ？",
            "zh": "燕，你喜欢\n连衣裙那一类\n吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "338/TALK",
            "narrator": "つばめ",
            "text": "うん。可愛いワンピース\n見つけてくれたの？",
            "zh": "嗯。找到可爱的\n连衣裙了吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "340/TALK",
            "narrator": "ガブリエラ",
            "text": "可愛いだけは卒業よ。\nこれからは、こういうのを\n着ていかなくちゃ！",
            "zh": "只是可爱，毕业了。\n今后得穿\n这种！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "345/TALK",
            "narrator": "つばめ",
            "text": "えっ…あ、あれ？\nこれって、ワンピース？",
            "zh": "诶……咦、咦？\n这是连衣裙？",
            "narrator_zh": "燕"
        },
        {
            "location": "346/TALK",
            "narrator": "つばめ",
            "text": "けど、胸から上が\n何にもないし…。",
            "zh": "可是，胸口以上\n什么都没有……。",
            "narrator_zh": "燕"
        },
        {
            "location": "348/TALK",
            "narrator": "ガブリエラ",
            "text": "ベアトップのワンピースを\n選んでみたのよ。",
            "zh": "我选了抹胸的\n连衣裙哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "349/TALK",
            "narrator": "つばめ",
            "text": "えぇっ！？\nで、でもこれ、捲れたら\n胸が見えちゃうんじゃ…。",
            "zh": "诶诶！？\n可、可是这个，卷下去的话\n胸口不就看见了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "351/TALK",
            "narrator": "ガブリエラ",
            "text": "そんな簡単に\n捲れたりしないって。",
            "zh": "不会那么容易\n卷下去的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "355/TALK",
            "narrator": "つばめ",
            "text": "で、でも…\nこれじゃブラ紐が\n見えちゃうよ？",
            "zh": "可、可是……\n这样内衣带子\n会露出来呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "357/TALK",
            "narrator": "つばめ",
            "text": "それに、タイトだから\n体のラインもくっきり\n出ちゃいそうだし…。",
            "zh": "而且很紧身，\n身体的线条也会\n看得很清楚……。",
            "narrator_zh": "燕"
        },
        {
            "location": "359/TALK",
            "narrator": "ガブリエラ",
            "text": "当然でしょ？\n大人っぽいデザイン\nなんだから。",
            "zh": "当然吧？\n本来就是偏成熟的\n设计。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "360/TALK",
            "narrator": "ガブリエラ",
            "text": "っていうか、紐のない\nタイプのブラなんて、\n沢山あるでしょ？",
            "zh": "再说，没有带子的\n那种内衣，\n不是很多吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "364/TALK",
            "narrator": "つばめ",
            "text": "そうだけど、付けたこと\nないから…。",
            "zh": "是这样，可我没\n穿过……。",
            "narrator_zh": "燕"
        },
        {
            "location": "366/TALK",
            "narrator": "ガブリエラ",
            "text": "いいから、とりあえず\n着てから考えなさいよ。",
            "zh": "行了，总之\n穿上再想。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "370/TALK",
            "narrator": "ガブリエラ",
            "text": "あ、向こうのも\n良さそうかも…。",
            "zh": "啊，那边的\n好像也不错……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "374/TALK",
            "narrator": "つばめ",
            "text": "…ど、どうしよう。\nあんな服、恥ずかしくて\n着られないよ…。",
            "zh": "……怎、怎么办。\n那种衣服，羞得\n我穿不了呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "386/TALK",
            "narrator": "つばめ",
            "text": "困ったよー",
            "zh": "头疼呀——",
            "narrator_zh": "燕"
        },
        {
            "location": "387/TALK",
            "narrator": "つばめ",
            "text": "ガブちゃんが選んだ服、\nちょっとわたしには\n派手な感じなの",
            "zh": "加布选的衣服，\n对我来说有点\n太显眼了",
            "narrator_zh": "燕"
        },
        {
            "location": "388/TALK",
            "narrator": "つばめ",
            "text": "でも、せっかく\n選んでくれたのに、",
            "zh": "可是，难得\n她帮我选了，",
            "narrator_zh": "燕"
        },
        {
            "location": "389/TALK",
            "narrator": "つばめ",
            "text": "着たくないなんて\n言えないし…",
            "zh": "说不想穿\n又说不出口……",
            "narrator_zh": "燕"
        },
        {
            "location": "390/TALK",
            "narrator": "つばめ",
            "text": "どうしたらいいかな？",
            "zh": "怎么办好呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "392/SEL",
            "narrator": "",
            "text": "見てみたいな",
            "zh": "有点想看",
            "narrator_zh": ""
        },
        {
            "location": "393/SEL",
            "narrator": "",
            "text": "ガブリエラにも着せよう",
            "zh": "也让加布里埃拉穿",
            "narrator_zh": ""
        },
        {
            "location": "394/ACT",
            "narrator": "",
            "text": "見てみたいな",
            "zh": "有点想看",
            "narrator_zh": ""
        },
        {
            "location": "397/TALK",
            "narrator": "つばめ",
            "text": "ダメ！",
            "zh": "不行！",
            "narrator_zh": "燕"
        },
        {
            "location": "398/TALK",
            "narrator": "つばめ",
            "text": "絶対に似合わないから…",
            "zh": "绝对不适合……",
            "narrator_zh": "燕"
        },
        {
            "location": "415/TALK",
            "narrator": "ガブリエラ",
            "text": "やっぱりこれが一番ね。\n早速試着して。",
            "zh": "果然还是这件最好。\n赶紧试穿。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "418/TALK",
            "narrator": "つばめ",
            "text": "あ、あの、ガブちゃん。\n本当に着るの？",
            "zh": "那、那个，加布。\n真的要穿吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "419/TALK",
            "narrator": "ガブリエラ",
            "text": "もぉ、試着くらいで\n文句言わないの！",
            "zh": "真是的，试穿一下\n别抱怨！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "420/TALK",
            "narrator": "ガブリエラ",
            "text": "ほら、早く着てきて。\nそれともここで着る？",
            "zh": "来，快点去换上。\n还是在这里换？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "421/TALK",
            "narrator": "つばめ",
            "text": "わ、わかったよぉ…。",
            "zh": "知、知道了哦……。",
            "narrator_zh": "燕"
        },
        {
            "location": "424/TALK",
            "narrator": "つばめ",
            "text": "…心配だなぁ。",
            "zh": "……好担心呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "439/TALK",
            "narrator": "つばめ",
            "text": "はぁ…。",
            "zh": "哈啊……。",
            "narrator_zh": "燕"
        },
        {
            "location": "442/TALK",
            "narrator": "ガブリエラ",
            "text": "…ごめん。\nちょっと、調子に乗り\n過ぎた。",
            "zh": "……对不起。\n有点得意\n过了头。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "443/TALK",
            "narrator": "ガブリエラ",
            "text": "まさか、あそこまで\n服に着られちゃってる感が\n凄くなるなんて…。",
            "zh": "没想到会被衣服\n压成那样的感觉\n这么强……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "446/TALK",
            "narrator": "つばめ",
            "text": "…ううん、いいの。",
            "zh": "……不，没关系。",
            "narrator_zh": "燕"
        },
        {
            "location": "447/TALK",
            "narrator": "つばめ",
            "text": "早いうちに、ああいう服が\nわたしに似合わないのが\nわかって――",
            "zh": "早点明白那种衣服\n不适合我，\n——",
            "narrator_zh": "燕"
        },
        {
            "location": "448/TALK",
            "narrator": "つばめ",
            "text": "逆に良かったよ。",
            "zh": "反倒很好呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "449/TALK",
            "narrator": "ガブリエラ",
            "text": "ま、まあ、そんなに\n落ち込む必要ないんじゃ\nない？",
            "zh": "也、也没必要\n那么\n失落吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "450/TALK",
            "narrator": "ガブリエラ",
            "text": "あんた、元はそんなに\n悪くないんだし――",
            "zh": "你本来也没那么\n差——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "451/TALK",
            "narrator": "ガブリエラ",
            "text": "大学生になる頃には、\nきっと着こなせるように\nなるって！",
            "zh": "到了大学生的时候，\n肯定能驾驭得了\n的！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "452/TALK",
            "narrator": "つばめ",
            "text": "大学生…あと三年かぁ…。",
            "zh": "大学生……还有三年呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "454/TALK",
            "narrator": "つばめ",
            "text": "それまでには、少しでも\n大人っぽくなれたら\nいいなぁ…。",
            "zh": "在那之前，要是能\n稍微成熟一点\n就好了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "455/ACT",
            "narrator": "",
            "text": "ガブリエラにも着せよう",
            "zh": "也让加布里埃拉穿",
            "narrator_zh": ""
        },
        {
            "location": "456/TALK",
            "narrator": "つばめ",
            "text": "ガブちゃんにも着てもらうの？",
            "zh": "也让加布穿吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "457/TALK",
            "narrator": "つばめ",
            "text": "あ、そういうことだね！",
            "zh": "啊，是这个意思呀！",
            "narrator_zh": "燕"
        },
        {
            "location": "471/TALK",
            "narrator": "つばめ",
            "text": "ねえ、ガブちゃんが\n選んでくれた服だけど…。",
            "zh": "呐，加布选的\n那件衣服……。",
            "narrator_zh": "燕"
        },
        {
            "location": "475/TALK",
            "narrator": "ガブリエラ",
            "text": "何よ、まだ何か言いたい\nことがあるの？",
            "zh": "什么，还有话\n要说吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "477/TALK",
            "narrator": "つばめ",
            "text": "そうじゃなくて、\nガブちゃんとお揃いなら、\n着てみようかな？",
            "zh": "不是的，\n要是和加布成套，\n我也许愿意穿？",
            "narrator_zh": "燕"
        },
        {
            "location": "478/TALK",
            "narrator": "ガブリエラ",
            "text": "……は？",
            "zh": "……哈？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "481/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょ、本気！？\nあたしにこの服着ろって\n言うの！？",
            "zh": "等、认真的！？\n要我穿\n这件！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "483/TALK",
            "narrator": "つばめ",
            "text": "うん。わたし、こういう\nタイプの服って着たこと\nないから――",
            "zh": "嗯。我没穿过\n这种类型的\n衣服——",
            "narrator_zh": "燕"
        },
        {
            "location": "484/TALK",
            "narrator": "つばめ",
            "text": "一人で着るの、\nちょっと恥ずかしくて…。",
            "zh": "一个人穿，\n有点害羞……。",
            "narrator_zh": "燕"
        },
        {
            "location": "486/TALK",
            "narrator": "つばめ",
            "text": "だから、ガブちゃんにも\n一緒に着てもらえば、\n多分大丈夫だと思うの。",
            "zh": "所以，要是加布\n也一起穿，\n我觉得大概就不要紧。",
            "narrator_zh": "燕"
        },
        {
            "location": "487/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょっと待って！\nダメだって、あたしには\n似合わないから…。",
            "zh": "等一下！\n不行，我不\n适合……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "488/TALK",
            "narrator": "つばめ",
            "text": "そんなことないよ。\n可愛いデザインだから、\nきっと似合うって。",
            "zh": "才没有。\n设计很可爱，\n肯定适合的。",
            "narrator_zh": "燕"
        },
        {
            "location": "491/TALK",
            "narrator": "ガブリエラ",
            "text": "で、でもこれ、胸のとこ\nちょっと開いてるから――",
            "zh": "可、可是这个，胸口\n有点开——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "492/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしの体型的に、\n似合わないと思うし…。",
            "zh": "以我的体型，\n我觉得不适合……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "493/TALK",
            "narrator": "つばめ",
            "text": "ワンサイズ小さいの\n着れば平気だよ。",
            "zh": "穿小一号的\n就不要紧呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "495/TALK",
            "narrator": "つばめ",
            "text": "それに、ガブちゃんは\n可愛いから、それくらい\n誰も気にしないって。",
            "zh": "而且加布很可爱，\n这点程度\n谁都不会在意的。",
            "narrator_zh": "燕"
        },
        {
            "location": "498/TALK",
            "narrator": "ガブリエラ",
            "text": "他人じゃなくて、\nあたし自身が気にするん\nだってば！",
            "zh": "不是别人，\n是我自己会在意\n啦！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "501/TALK",
            "narrator": "ガブリエラ",
            "text": "っていうか、マズいわ。\nこのままじゃつばめに\n押し切られちゃう！",
            "zh": "不好。\n这样下去要被燕\n说服了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "507/TALK",
            "narrator": "ガブリエラ",
            "text": "…あ、ああっ！\nつばめ、あれ見て、あれ！\nあそこのワンピース！",
            "zh": "……啊、啊啊！\n燕，看那个，那个！\n那边的连衣裙！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "510/TALK",
            "narrator": "ガブリエラ",
            "text": "あれも素敵だと思わない？\nちょっと大人しめだけど、\n大人っぽい感じするし。",
            "zh": "那个不也很好看吗？\n虽然稍微素一点，\n但有成熟的感觉。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "512/TALK",
            "narrator": "つばめ",
            "text": "わぁ、これ良いかも！\nわたし、こういうの\n大好きなんだ！",
            "zh": "哇，这个也许不错！\n我最喜欢\n这种了！",
            "narrator_zh": "燕"
        },
        {
            "location": "514/TALK",
            "narrator": "ガブリエラ",
            "text": "そうだと思った。",
            "zh": "我就觉得是。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "516/TALK",
            "narrator": "ガブリエラ",
            "text": "やっぱり、あんたには\n普通のワンピースが\n一番よ。",
            "zh": "果然，你还是\n普通的连衣裙\n最合适。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "518/TALK",
            "narrator": "つばめ",
            "text": "…よかった。\nやっぱりさっきの服は\n諦めてくれたみたい。",
            "zh": "……太好了。\n刚才那件，她好像\n放弃了。",
            "narrator_zh": "燕"
        },
        {
            "location": "522/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…絶対さっきの方が、\nつばめに似合うと思うのに\nなぁ…。",
            "zh": "哈啊……我还是觉得\n刚才那件更适合燕\n啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "292/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>7月15日　3:29 PM</color>\nとある平日の午後、某所ブティックにて。",
            "zh": "<color=green>7月15日　3:29 PM</color>\n某个工作日的下午，某处精品店。",
            "narrator_zh": "Dialog_EventData"
        },
        {
            "location": "533/DIALOG",
            "narrator": "Dialog_GEThimegoto_ch01",
            "text": "【スタイリスト候補生】",
            "zh": "【造型师候补生】",
            "narrator_zh": "Dialog_GEThimegoto_ch01"
        }
    ]
}
