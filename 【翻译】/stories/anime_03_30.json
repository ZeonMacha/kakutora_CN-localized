    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "アニメ第30話",
            "zh": "动画第30话",
            "narrator_zh": ""
        },
        {
            "location": "47/TALK",
            "narrator": "表層みやび",
            "text": "おお、相棒。\nまた会ったね。",
            "zh": "哦，搭档。\n又见面了咯。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "48/TALK",
            "narrator": "表層みやび",
            "text": "うちのMVは前に\n見ちゅうけんど、\nもう一度みるが？",
            "zh": "我的MV你之前\n看过了，\n还要再看一次咩？",
            "narrator_zh": "表层雅"
        },
        {
            "location": "49/SEL",
            "narrator": "",
            "text": "もう一度見る！",
            "zh": "再看一次！",
            "narrator_zh": ""
        },
        {
            "location": "50/SEL",
            "narrator": "",
            "text": "いえ、結構です",
            "zh": "不了，谢谢",
            "narrator_zh": ""
        },
        {
            "location": "51/ACT",
            "narrator": "",
            "text": "もう一度見る！",
            "zh": "再看一次！",
            "narrator_zh": ""
        },
        {
            "location": "52/TALK",
            "narrator": "表層みやび",
            "text": "わかった。",
            "zh": "行咯。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "54/ACT",
            "narrator": "",
            "text": "いえ、結構です",
            "zh": "不了，谢谢",
            "narrator_zh": ""
        },
        {
            "location": "55/TALK",
            "narrator": "表層みやび",
            "text": "なんぞ…。\nほんだらこれで\nお別れぞね。",
            "zh": "做驷马……。\n那就到这里\n再见咧。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "60/TALK",
            "narrator": "表層みやび",
            "text": "おお、相棒。\nよう来たね。",
            "zh": "哦，搭档。\n欢迎来咯。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "61/SEL",
            "narrator": "",
            "text": "呂号ちゃん！？",
            "zh": "吕号！？",
            "narrator_zh": ""
        },
        {
            "location": "62/SEL",
            "narrator": "",
            "text": "誰？呂号って…",
            "zh": "谁？吕号是谁……",
            "narrator_zh": ""
        },
        {
            "location": "63/ACT",
            "narrator": "",
            "text": "呂号ちゃん！？",
            "zh": "吕号！？",
            "narrator_zh": ""
        },
        {
            "location": "64/TALK",
            "narrator": "表層みやび",
            "text": "久し振りやね。",
            "zh": "几久没见了啵。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "65/SEL",
            "narrator": "",
            "text": "今日は伊号ちゃんは一緒じゃないの？",
            "zh": "今天伊号没一起来吗？",
            "narrator_zh": ""
        },
        {
            "location": "66/ACT",
            "narrator": "",
            "text": "今日は伊号ちゃんは一緒じゃないの？",
            "zh": "今天伊号没一起来吗？",
            "narrator_zh": ""
        },
        {
            "location": "68/TALK",
            "narrator": "表層みやび",
            "text": "うむ。\nあやつには別の仕事が\nあるきね。",
            "zh": "嗯。\n那家伙还有别的\n事要做啵。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "69/ACT",
            "narrator": "",
            "text": "誰？呂号って…",
            "zh": "谁？吕号是谁……",
            "narrator_zh": ""
        },
        {
            "location": "70/TALK",
            "narrator": "表層みやび",
            "text": "おお、そうか！",
            "zh": "哦，对哦！",
            "narrator_zh": "表层雅"
        },
        {
            "location": "71/TALK",
            "narrator": "表層みやび",
            "text": "お前さんは、一度も\nココロスフィアに\n来たこと無かったか。",
            "zh": "你一次都\n没来过\n心灵领域咩。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "72/TALK",
            "narrator": "表層みやび",
            "text": "まあ、ここで多くを語るは\nお門違いやき。",
            "zh": "嘛，在这里说太多\n也不合适啵。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "73/TALK",
            "narrator": "表層みやび",
            "text": "正体を知りたくば、\nココロスフィアに来いや。",
            "zh": "想知道真面目的话，\n就来心灵领域咧。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "75/TALK",
            "narrator": "表層みやび",
            "text": "さて、今回やけんど、\n見ての通り、\nエリカさんは留守や。",
            "zh": "好了，这次嘛，\n如你所见，\n领火不在家咯。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "76/TALK",
            "narrator": "表層みやび",
            "text": "ほんで、うちは\nその間の留守番を\n任されたぞね。",
            "zh": "然后，我就被派来\n替她看这段时间的\n门咧。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "77/SEL",
            "narrator": "",
            "text": "ここに留守番は必要なの？",
            "zh": "这里还需要人看门吗？",
            "narrator_zh": ""
        },
        {
            "location": "78/SEL",
            "narrator": "",
            "text": "じゃあエリカの代わりに色々見せて",
            "zh": "那你代替领火给我看看各种东西吧",
            "narrator_zh": ""
        },
        {
            "location": "79/SEL",
            "narrator": "",
            "text": "エリカは何してるの？",
            "zh": "领火去做什么了？",
            "narrator_zh": ""
        },
        {
            "location": "80/ACT",
            "narrator": "",
            "text": "ここに留守番は必要なの？",
            "zh": "这里还需要人看门吗？",
            "narrator_zh": ""
        },
        {
            "location": "81/TALK",
            "narrator": "表層みやび",
            "text": "カラッポにすると、\n某Cさんに占領されて\nしまうそうや。",
            "zh": "听说要是放空着，\n就会被某位C小姐\n占领掉咯。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "82/TALK",
            "narrator": "表層みやび",
            "text": "まあ、確定やなくて、\nそういう危険性もある\nちゅうことらしいけんど。",
            "zh": "嘛，也不是百分百确定，\n好像只是说有\n这种风险罢了。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "83/TALK",
            "narrator": "表層みやび",
            "text": "そんなわけやき、\n今回は新情報はナシやよ。",
            "zh": "就是这么回事啵，\n这次没得新情报咯。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "84/SEL",
            "narrator": "",
            "text": "残念",
            "zh": "好遗憾",
            "narrator_zh": ""
        },
        {
            "location": "85/SEL",
            "narrator": "",
            "text": "じゃあデートしよう",
            "zh": "那我们来约会吧",
            "narrator_zh": ""
        },
        {
            "location": "86/ACT",
            "narrator": "",
            "text": "残念",
            "zh": "好遗憾",
            "narrator_zh": ""
        },
        {
            "location": "87/TALK",
            "narrator": "表層みやび",
            "text": "むぅ、\nそう言われてもだな…。",
            "zh": "唔，\n就算你这么说……",
            "narrator_zh": "表层雅"
        },
        {
            "location": "88/ACT",
            "narrator": "",
            "text": "じゃあデートしよう",
            "zh": "那我们来约会吧",
            "narrator_zh": ""
        },
        {
            "location": "89/TALK",
            "narrator": "表層みやび",
            "text": "なるほど。",
            "zh": "原来如此。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "90/TALK",
            "narrator": "表層みやび",
            "text": "まあ、それも\n悪くはないけんど…",
            "zh": "嘛，那样\n倒也不坏，但是……",
            "narrator_zh": "表层雅"
        },
        {
            "location": "91/TALK",
            "narrator": "表層みやび",
            "text": "それより、\nうち秘蔵のMVがあるがや\nけんど、見ないかね？",
            "zh": "比起那个，\n我这儿有珍藏的MV\n来着，要不要看咩？",
            "narrator_zh": "表层雅"
        },
        {
            "location": "92/SEL",
            "narrator": "",
            "text": "ミルミル！！",
            "zh": "看！看！！",
            "narrator_zh": ""
        },
        {
            "location": "93/SEL",
            "narrator": "",
            "text": "いえ、結構です",
            "zh": "不了，谢谢",
            "narrator_zh": ""
        },
        {
            "location": "94/ACT",
            "narrator": "",
            "text": "ミルミル！！",
            "zh": "看！看！！",
            "narrator_zh": ""
        },
        {
            "location": "95/TALK",
            "narrator": "表層みやび",
            "text": "わかった。",
            "zh": "行咯。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "97/ACT",
            "narrator": "",
            "text": "いえ、結構です",
            "zh": "不了，谢谢",
            "narrator_zh": ""
        },
        {
            "location": "98/TALK",
            "narrator": "表層みやび",
            "text": "む、そうか。",
            "zh": "唔，这样咩。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "102/ACT",
            "narrator": "",
            "text": "じゃあエリカの代わりに色々見せて",
            "zh": "那你代替领火给我看看各种东西吧",
            "narrator_zh": ""
        },
        {
            "location": "103/TALK",
            "narrator": "表層みやび",
            "text": "何が見たい？",
            "zh": "想看驷马？",
            "narrator_zh": "表层雅"
        },
        {
            "location": "104/SEL",
            "narrator": "",
            "text": "記録映像とか、この世界の真実とか",
            "zh": "记录影像啦，这个世界的真相啦",
            "narrator_zh": ""
        },
        {
            "location": "105/SEL",
            "narrator": "",
            "text": "みやびの生まれたままの姿",
            "zh": "雅一丝不挂的样子",
            "narrator_zh": ""
        },
        {
            "location": "106/ACT",
            "narrator": "",
            "text": "記録映像とか、この世界の真実とか",
            "zh": "记录影像啦，这个世界的真相啦",
            "narrator_zh": ""
        },
        {
            "location": "107/TALK",
            "narrator": "表層みやび",
            "text": "あー、それは\nうちも是非見たいちや。",
            "zh": "啊——，那个\n我也好想看滴。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "108/TALK",
            "narrator": "表層みやび",
            "text": "けんど、うちには\nその方法は\n判らんきね……。",
            "zh": "但是，我可\n不懂怎么调出来\n啵……。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "109/TALK",
            "narrator": "表層みやび",
            "text": "残念やけんど、\nエリカさんが戻るのを\n待つしかないね。",
            "zh": "虽然遗憾，但是\n只能等领火回来\n咯。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "110/ACT",
            "narrator": "",
            "text": "みやびの生まれたままの姿",
            "zh": "雅一丝不挂的样子",
            "narrator_zh": ""
        },
        {
            "location": "111/TALK",
            "narrator": "表層みやび",
            "text": "えいよ。",
            "zh": "得。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "112/SEL",
            "narrator": "",
            "text": "え！？",
            "zh": "咦！？",
            "narrator_zh": ""
        },
        {
            "location": "113/ACT",
            "narrator": "",
            "text": "え！？",
            "zh": "咦！？",
            "narrator_zh": ""
        },
        {
            "location": "115/TALK",
            "narrator": "表層みやび",
            "text": "なんぞ、\n希望通りやないか？",
            "zh": "做驷马，\n不正是如你所愿咩？",
            "narrator_zh": "表层雅"
        },
        {
            "location": "116/TALK",
            "narrator": "表層みやび",
            "text": "わからんヤツぞね。",
            "zh": "真是个让人搞不懂的家伙咧。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "117/SEL",
            "narrator": "",
            "text": "恥ずかしくないの？",
            "zh": "不觉得害羞吗？",
            "narrator_zh": ""
        },
        {
            "location": "118/ACT",
            "narrator": "",
            "text": "恥ずかしくないの？",
            "zh": "不觉得害羞吗？",
            "narrator_zh": ""
        },
        {
            "location": "120/TALK",
            "narrator": "表層みやび",
            "text": "“うちは”\n恥ずかしくないけんどな。",
            "zh": "“我”是\n不觉得害羞咯。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "121/TALK",
            "narrator": "表層みやび",
            "text": "現実のうちは\nどう言うかは知らんよ。",
            "zh": "现实里的我\n会怎么说就不知道了咯。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "122/TALK",
            "narrator": "表層みやび",
            "text": "で？\n見るんか？\n見ないんか？",
            "zh": "怎样？\n看咩？\n还是不看咩？",
            "narrator_zh": "表层雅"
        },
        {
            "location": "123/SEL",
            "narrator": "",
            "text": "ミルミル！！",
            "zh": "看！看！！",
            "narrator_zh": ""
        },
        {
            "location": "124/SEL",
            "narrator": "",
            "text": "いえ、結構です",
            "zh": "不了，谢谢",
            "narrator_zh": ""
        },
        {
            "location": "125/ACT",
            "narrator": "",
            "text": "ミルミル！！",
            "zh": "看！看！！",
            "narrator_zh": ""
        },
        {
            "location": "126/TALK",
            "narrator": "表層みやび",
            "text": "わかった。",
            "zh": "行咯。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "128/ACT",
            "narrator": "",
            "text": "いえ、結構です",
            "zh": "不了，谢谢",
            "narrator_zh": ""
        },
        {
            "location": "129/TALK",
            "narrator": "表層みやび",
            "text": "む、そうか。",
            "zh": "唔，这样咩。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "133/ACT",
            "narrator": "",
            "text": "エリカは何してるの？",
            "zh": "领火去做什么了？",
            "narrator_zh": ""
        },
        {
            "location": "134/TALK",
            "narrator": "表層みやび",
            "text": "何でも、千羽鶴の\n居場所がわかりそうとかで\nその特定に当たっちゅう。",
            "zh": "听说是好像快找到\n千羽鹤的行踪了，\n正在锁定她的位置。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "135/TALK",
            "narrator": "表層みやび",
            "text": "まあ、正直こんな\nココロの戦争は、\n早う終わらせて――",
            "zh": "嘛，说实话这种\n心灵战争，\n真想早点结束——",
            "narrator_zh": "表层雅"
        },
        {
            "location": "136/TALK",
            "narrator": "表層みやび",
            "text": "エリカさんとお茶しつつ\n色んな話を聞いたり\nしたいがやけんどなぁ。",
            "zh": "一边和领火喝茶\n一边听她讲讲各种事\n来着啊。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "137/SEL",
            "narrator": "",
            "text": "同感だね",
            "zh": "同感呢",
            "narrator_zh": ""
        },
        {
            "location": "138/SEL",
            "narrator": "",
            "text": "その時$me$はお別れなの？",
            "zh": "到那时$me$就要分别了吗？",
            "narrator_zh": ""
        },
        {
            "location": "139/ACT",
            "narrator": "",
            "text": "同感だね",
            "zh": "同感呢",
            "narrator_zh": ""
        },
        {
            "location": "140/TALK",
            "narrator": "表層みやび",
            "text": "うむ。\n平和が一番ちや。",
            "zh": "嗯。\n和平才是最好滴。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "142/TALK",
            "narrator": "表層みやび",
            "text": "まあ、平和になっても\nお前さんはうちの目覚まし\nアラームやけんどな。",
            "zh": "嘛，就算和平了，\n你也是我的起床\n闹钟咯。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "144/TALK",
            "narrator": "表層みやび",
            "text": "あと…たまになら\nちゅうもしてえいんよ？",
            "zh": "还有……要是偶尔的话\n亲一下也是可以的啵？",
            "narrator_zh": "表层雅"
        },
        {
            "location": "145/ACT",
            "narrator": "",
            "text": "その時$me$はお別れなの？",
            "zh": "到那时$me$就要分别了吗？",
            "narrator_zh": ""
        },
        {
            "location": "146/TALK",
            "narrator": "表層みやび",
            "text": "さあ、どうだかなぁ。",
            "zh": "这嘛，谁知道呢。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "147/TALK",
            "narrator": "表層みやび",
            "text": "うちの意志にかかわらず、\nうちらの関係はTRI-OSが\n全て握っちゅう。",
            "zh": "不管我怎么想，\n我们的关系全都攥在\nTRI-OS手里。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "148/TALK",
            "narrator": "表層みやび",
            "text": "このポンコツOS様が\nどう采配するか。\nそれが全てやき。",
            "zh": "全看这位废柴OS大人\n怎么发落咯。\n一切都由它说了算啵。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "149/TALK",
            "narrator": "表層みやび",
            "text": "けんど、うちは\nお前さんにはずっと\nいて欲しいと思っちゅう。",
            "zh": "但是，我是\n希望你能一直\n留在这里滴。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "150/TALK",
            "narrator": "表層みやび",
            "text": "お前さんがいなくなったら\n誰がうちの目覚まし時計に\nなるぞね！",
            "zh": "要是你不在了，\n谁来当我的\n起床闹钟咧！",
            "narrator_zh": "表层雅"
        },
        {
            "location": "151/TALK",
            "narrator": "表層みやび",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "152/TALK",
            "narrator": "表層みやび",
            "text": "まあ、それと…\nたまにはちゅうも\nしてえいけんどな。",
            "zh": "嘛，还有就是……\n偶尔亲一口\n也得滴嘛。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "154/TALK",
            "narrator": "表層みやび",
            "text": "っと、だいぶ話が\n脱線してもうたね。",
            "zh": "哎呀，话题好像\n扯得太远了咯。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "155/TALK",
            "narrator": "表層みやび",
            "text": "話を戻すと、\n今回は新しい情報は\nナシやね。",
            "zh": "说回正题，\n这次没得新情报\n咯。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "157/TALK",
            "narrator": "表層みやび",
            "text": "まあ、けんどあれやね…。",
            "zh": "嘛，不过那个啊……。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "158/TALK",
            "narrator": "表層みやび",
            "text": "このまま\n『はいさようなら』で\n追い出すのも可哀想やき。",
            "zh": "就这么\n“好啦再见”把你赶走\n也太可怜了啵。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "159/TALK",
            "narrator": "表層みやび",
            "text": "みやびさんが\n身体張って\nおもてなししちゃる。",
            "zh": "雅小姐就\n豁出这身板\n好好招待你咧。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "160/SEL",
            "narrator": "",
            "text": "え？なになに？",
            "zh": "咦？什么什么？",
            "narrator_zh": ""
        },
        {
            "location": "161/SEL",
            "narrator": "",
            "text": "鼻血は出ますか！？",
            "zh": "会流鼻血吗！？",
            "narrator_zh": ""
        },
        {
            "location": "162/ACT",
            "narrator": "",
            "text": "え？なになに？",
            "zh": "咦？什么什么？",
            "narrator_zh": ""
        },
        {
            "location": "163/TALK",
            "narrator": "表層みやび",
            "text": "うちの秘蔵MVや。",
            "zh": "是我珍藏的MV咯。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "165/TALK",
            "narrator": "表層みやび",
            "text": "他では絶対に見られん\n貴重な映像やよ？",
            "zh": "在别处绝对看不到的\n珍贵影像啵？",
            "narrator_zh": "表层雅"
        },
        {
            "location": "166/SEL",
            "narrator": "",
            "text": "やったー！",
            "zh": "太好啦——！",
            "narrator_zh": ""
        },
        {
            "location": "167/SEL",
            "narrator": "",
            "text": "そういうの自分で見せようとするの、みやび実はナルシスト？",
            "zh": "这种东西自己主动给人看，雅其实很自恋吗？",
            "narrator_zh": ""
        },
        {
            "location": "168/ACT",
            "narrator": "",
            "text": "やったー！",
            "zh": "太好啦——！",
            "narrator_zh": ""
        },
        {
            "location": "169/TALK",
            "narrator": "表層みやび",
            "text": "まあ、実際に見て\nガッカリしても、\n自己責任でよろしゅうな。",
            "zh": "嘛，就算实际看了\n觉得失望，\n也请后果自负咯。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "170/ACT",
            "narrator": "",
            "text": "そういうの自分で見せようとするの、みやび実はナルシスト？",
            "zh": "这种东西自己主动给人看，雅其实很自恋吗？",
            "narrator_zh": ""
        },
        {
            "location": "171/TALK",
            "narrator": "表層みやび",
            "text": "うむ。\nうちはナルシストや！",
            "zh": "嗯。\n我就是自恋狂咯！",
            "narrator_zh": "表层雅"
        },
        {
            "location": "172/TALK",
            "narrator": "表層みやび",
            "text": "そうでなければ\n自分のことなぞ\n好きになれんきね。",
            "zh": "要是不这样的话，\n根本没法喜欢上\n自己嘛。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "173/TALK",
            "narrator": "表層みやび",
            "text": "ま、うちは少数派の\n人格やき、現実のうちは\nその辺全然ダメやけんど。",
            "zh": "嘛，我是少数派的\n人格啵，现实里的我\n这方面完全不行就是了。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "175/ACT",
            "narrator": "",
            "text": "鼻血は出ますか！？",
            "zh": "会流鼻血吗！？",
            "narrator_zh": ""
        },
        {
            "location": "176/TALK",
            "narrator": "表層みやび",
            "text": "鼻血…？",
            "zh": "鼻血……？",
            "narrator_zh": "表层雅"
        },
        {
            "location": "177/TALK",
            "narrator": "表層みやび",
            "text": "身体張る言うても\nうちがプロレスやる\nわけやないぞ？",
            "zh": "说是豁出身板，\n也不是我要去打\n职业摔角哦？",
            "narrator_zh": "表层雅"
        },
        {
            "location": "178/SEL",
            "narrator": "",
            "text": "じゃあ何？",
            "zh": "那是什么？",
            "narrator_zh": ""
        },
        {
            "location": "179/SEL",
            "narrator": "",
            "text": "みやびちゃんとプロレスしたいです",
            "zh": "我想和雅打职业摔角",
            "narrator_zh": ""
        },
        {
            "location": "180/ACT",
            "narrator": "",
            "text": "じゃあ何？",
            "zh": "那是什么？",
            "narrator_zh": ""
        },
        {
            "location": "181/TALK",
            "narrator": "表層みやび",
            "text": "うち秘蔵のMVを\n見せちゃるよ。",
            "zh": "我把珍藏的MV\n拿给你看咯。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "183/ACT",
            "narrator": "",
            "text": "みやびちゃんとプロレスしたいです",
            "zh": "我想和雅打职业摔角",
            "narrator_zh": ""
        },
        {
            "location": "184/TALK",
            "narrator": "表層みやび",
            "text": "ふむ。\n$handle$とは\n別れの時が来たようだ。",
            "zh": "嗯。\n看来和$handle$\n道别的时刻到了。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "185/SEL",
            "narrator": "",
            "text": "ごめんなさい許してください",
            "zh": "对不起请原谅我",
            "narrator_zh": ""
        },
        {
            "location": "186/SEL",
            "narrator": "",
            "text": "要するに意味が分かってるってことだよね",
            "zh": "说白了你其实懂那是什么意思吧",
            "narrator_zh": ""
        },
        {
            "location": "187/ACT",
            "narrator": "",
            "text": "ごめんなさい許してください",
            "zh": "对不起请原谅我",
            "narrator_zh": ""
        },
        {
            "location": "188/TALK",
            "narrator": "表層みやび",
            "text": "まったく。\n仕方のないヤツやね。",
            "zh": "真是的。\n真拿你没办法咯。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "189/TALK",
            "narrator": "表層みやび",
            "text": "そんなに配信停止の危機へ\n誘導するような事しゆうと\n工作員を疑うぞね。",
            "zh": "老是往导致停播危机的方向\n引导的话，\n我都要怀疑你是间谍咧。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "190/ACT",
            "narrator": "",
            "text": "要するに意味が分かってるってことだよね",
            "zh": "说白了你其实懂那是什么意思吧",
            "narrator_zh": ""
        },
        {
            "location": "192/TALK",
            "narrator": "表層みやび",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "193/TALK",
            "narrator": "表層みやび",
            "text": "今の論点は\nそこではない。",
            "zh": "现在的重点\n不在这里。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "194/TALK",
            "narrator": "表層みやび",
            "text": "重要なのは、貴様が\nアプリ配信停止の危機に\n誘導しゆうことやき。",
            "zh": "重要的是，你这家伙\n正在往App停播危机的方向\n引导啵。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "195/SEL",
            "narrator": "",
            "text": "そんなつもりはないよ！\nみやびとスキンシップをとりたいだけ",
            "zh": "我没那个意思！\n只是想和雅亲密接触一下",
            "narrator_zh": ""
        },
        {
            "location": "196/SEL",
            "narrator": "",
            "text": "やってるのはTRI-OSさん",
            "zh": "干这事的是TRI-OS",
            "narrator_zh": ""
        },
        {
            "location": "197/ACT",
            "narrator": "",
            "text": "そんなつもりはないよ！\nみやびとスキンシップをとりたいだけ",
            "zh": "我没那个意思！\n只是想和雅亲密接触一下",
            "narrator_zh": ""
        },
        {
            "location": "199/TALK",
            "narrator": "表層みやび",
            "text": "そうゆうのは、\nこうゆう公の場で言わず、\nWAVEをつかえ。",
            "zh": "那种话，\n别在这种公开场合讲，\n用WAVE发啊。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "200/TALK",
            "narrator": "表層みやび",
            "text": "デリカシーの無いやつめ。",
            "zh": "真是个没分寸的家伙。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "201/ACT",
            "narrator": "",
            "text": "やってるのはTRI-OSさん",
            "zh": "干这事的是TRI-OS",
            "narrator_zh": ""
        },
        {
            "location": "203/TALK",
            "narrator": "表層みやび",
            "text": "それはあれやな。",
            "zh": "这就跟那个一样咯。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "204/TALK",
            "narrator": "表層みやび",
            "text": "そこに刃物が置いて\nあったから人を刺しました\nゆうのと同じやぞ。",
            "zh": "跟“因为那里放着\n刀子所以就捅了人”\n是一个道理哦。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "205/TALK",
            "narrator": "表層みやび",
            "text": "まあえいよ。\n辛抱たまらなくなった\nだけやって判っちゅうき。",
            "zh": "得吧得吧。\n我也知道你只是\n实在憋不住了啵。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "206/TALK",
            "narrator": "表層みやび",
            "text": "けんど、そうゆうこと\n言うんは、WAVEの中だけに\nしいや。",
            "zh": "但是，那种话\n只能在WAVE里\n说咧。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "208/SEL",
            "narrator": "",
            "text": "すみません…",
            "zh": "对不起……",
            "narrator_zh": ""
        },
        {
            "location": "209/ACT",
            "narrator": "",
            "text": "すみません…",
            "zh": "对不起……",
            "narrator_zh": ""
        },
        {
            "location": "213/TALK",
            "narrator": "表層みやび",
            "text": "まあ、けんどあれや。\nお前さんも反省した\nみたいやし。",
            "zh": "嘛，不过那个啊。\n看你也像是\n反省过了。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "214/TALK",
            "narrator": "表層みやび",
            "text": "今回は特別に、\nお前さんの需要に\nちくっと応えちゃる。",
            "zh": "这次就破例，\n稍微满足一下\n你的需求咧。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "215/TALK",
            "narrator": "表層みやび",
            "text": "うちのMVを\nお前さんだけに\n見せちゃるきね。",
            "zh": "把我的MV\n单独拿给你\n看啵。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "224/SEL",
            "narrator": "",
            "text": "映像を見る\n<color=green>【高画質/40MB 2:35】</color>",
            "zh": "观看影像\n<color=green>【高画质/40MB 2:35】</color>",
            "narrator_zh": ""
        },
        {
            "location": "225/SEL",
            "narrator": "",
            "text": "映像を見る\n<color=green>【標準画質/14MB 2:35】</color>",
            "zh": "观看影像\n<color=green>【标准画质/14MB 2:35】</color>",
            "narrator_zh": ""
        },
        {
            "location": "226/SEL",
            "narrator": "",
            "text": "やっぱり見ない",
            "zh": "还是不看了",
            "narrator_zh": ""
        },
        {
            "location": "227/ACT",
            "narrator": "",
            "text": "映像を見る\n<color=green>【高画質/40MB 2:35】</color>",
            "zh": "观看影像\n<color=green>【高画质/40MB 2:35】</color>",
            "narrator_zh": ""
        },
        {
            "location": "234/ACT",
            "narrator": "",
            "text": "映像を見る\n<color=green>【標準画質/14MB 2:35】</color>",
            "zh": "观看影像\n<color=green>【标准画质/14MB 2:35】</color>",
            "narrator_zh": ""
        },
        {
            "location": "241/ACT",
            "narrator": "",
            "text": "やっぱり見ない",
            "zh": "还是不看了",
            "narrator_zh": ""
        },
        {
            "location": "242/TALK",
            "narrator": "表層みやび",
            "text": "なんぞそれは…。\nまあえいよ。",
            "zh": "做驷马嘛这是……。\n得吧得吧。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "243/TALK",
            "narrator": "表層みやび",
            "text": "ほな、またなー。",
            "zh": "那就，下次见了啵。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "258/TALK",
            "narrator": "表層みやび",
            "text": "……ふむ。",
            "zh": "……嗯。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "259/TALK",
            "narrator": "表層みやび",
            "text": "どうやった？\n少しは暇つぶしに\nなったかね。",
            "zh": "怎么样？\n多少算解了点闷\n咩。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "260/SEL",
            "narrator": "",
            "text": "よかった！！！",
            "zh": "太好了！！！",
            "narrator_zh": ""
        },
        {
            "location": "261/SEL",
            "narrator": "",
            "text": "エロかった",
            "zh": "好色情",
            "narrator_zh": ""
        },
        {
            "location": "262/SEL",
            "narrator": "",
            "text": "イマイチだった",
            "zh": "一般般吧",
            "narrator_zh": ""
        },
        {
            "location": "263/ACT",
            "narrator": "",
            "text": "よかった！！！",
            "zh": "太好了！！！",
            "narrator_zh": ""
        },
        {
            "location": "264/TALK",
            "narrator": "表層みやび",
            "text": "それはよかった。",
            "zh": "那挺好。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "265/ACT",
            "narrator": "",
            "text": "エロかった",
            "zh": "好色情",
            "narrator_zh": ""
        },
        {
            "location": "266/TALK",
            "narrator": "表層みやび",
            "text": "お前さん\nそればっかりやね。",
            "zh": "你呀\n满脑子就这个咯。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "267/ACT",
            "narrator": "",
            "text": "イマイチだった",
            "zh": "一般般吧",
            "narrator_zh": ""
        },
        {
            "location": "268/TALK",
            "narrator": "表層みやび",
            "text": "そうかー。\nそれはすまんかったね。",
            "zh": "这样啊——。\n那真没好意思咯。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "270/TALK",
            "narrator": "表層みやび",
            "text": "ま、そんなわけで、\nうちのMVは\nこれで終わりやよ。",
            "zh": "嘛，总之呢，\n我的MV\n就到这里咯。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "271/TALK",
            "narrator": "表層みやび",
            "text": "それと、今回のMVで\n何を伝えたかったかは、\nここでは解説せん。",
            "zh": "还有，这次的MV里\n想传达什么，\n我就不在这里解说了。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "273/TALK",
            "narrator": "表層みやび",
            "text": "それはまた後ほど、\nうちと二人きりで\n見る時に、な？",
            "zh": "那个等以后，\n只有我俩独处\n一起看的时候再说，好不？",
            "narrator_zh": "表层雅"
        },
        {
            "location": "274/TALK",
            "narrator": "表層みやび",
            "text": "一緒にMVを見る時に\nたっぷり濃密な時間を\n過ごさせちゃるきね。",
            "zh": "一起看MV的时候\n会让你好好度过一段\n浓密的时光啵。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "276/TALK",
            "narrator": "表層みやび",
            "text": "っと、それともう１つ、\nゆうておくことがあった。",
            "zh": "哦，还有一件事，\n得先跟你说一声。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "277/TALK",
            "narrator": "表層みやび",
            "text": "今回、歌の中にうちからの\n特別なメッセージが\n入っちょったけんど――",
            "zh": "这次，歌里藏着我\n发出的特别讯息\n来着——",
            "narrator_zh": "表层雅"
        },
        {
            "location": "278/TALK",
            "narrator": "表層みやび",
            "text": "残念ながらMV合わせの\nショート版には、それが\n入っちょらんがよ。",
            "zh": "可惜配合MV剪的\n短版里面，没有\n收进去咯。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "283/TALK",
            "narrator": "表層みやび",
            "text": "というわけで、相棒には\n是非フルバージョンの\n曲を聴いて欲しいぞね。",
            "zh": "所以说，希望搭档\n务必去听一听\n完整版的曲子咧。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "284/TALK",
            "narrator": "表層みやび",
            "text": "まあ、聴いたところで\n解読は困難を極めると\n思うけんど――",
            "zh": "嘛，就算听了，\n我也觉得破译起来\n会难上加难——",
            "narrator_zh": "表层雅"
        },
        {
            "location": "286/TALK",
            "narrator": "表層みやび",
            "text": "そんなことは関係ない！\n解読しようとすることが\n愛なのやから！",
            "zh": "那种事没关系！\n想要去破译的心意\n才是爱呀！",
            "narrator_zh": "表层雅"
        },
        {
            "location": "290/SEL",
            "narrator": "",
            "text": "どんなメッセージなの？",
            "zh": "是什么样的讯息？",
            "narrator_zh": ""
        },
        {
            "location": "291/SEL",
            "narrator": "",
            "text": "もちろんフルバージョン聴くよ！",
            "zh": "我当然会听完整版！",
            "narrator_zh": ""
        },
        {
            "location": "292/ACT",
            "narrator": "",
            "text": "どんなメッセージなの？",
            "zh": "是什么样的讯息？",
            "narrator_zh": ""
        },
        {
            "location": "294/TALK",
            "narrator": "表層みやび",
            "text": "それを言うたら\nお終いやき…。",
            "zh": "要是说出来了\n就没意思了啵……。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "295/TALK",
            "narrator": "表層みやび",
            "text": "知りたければ、\nフルバージョンを\n聴いてみいや。",
            "zh": "想知道的话，\n就去听听\n完整版咧。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "296/ACT",
            "narrator": "",
            "text": "もちろんフルバージョン聴くよ！",
            "zh": "我当然会听完整版！",
            "narrator_zh": ""
        },
        {
            "location": "298/TALK",
            "narrator": "表層みやび",
            "text": "うむ。\nもし解読できたら、\nうちに教え――",
            "zh": "嗯。\n要是破译出来了，\n就告诉——",
            "narrator_zh": "表层雅"
        },
        {
            "location": "300/TALK",
            "narrator": "表層みやび",
            "text": "……やっぱり\n教えんでえい。",
            "zh": "……还是\n不用告诉我了。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "302/TALK",
            "narrator": "表層みやび",
            "text": "お前さんの胸のうちに\n秘めておくがよい。",
            "zh": "就藏在你自己\n心底好了。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "305/TALK",
            "narrator": "表層みやび",
            "text": "ま、今回は\nそんなとこやね。",
            "zh": "嘛，这次\n就差不多这样咯。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "310/TALK",
            "narrator": "表層みやび",
            "text": "あと、うちのエピソードを\n最新まで追いかけると、\n色々プレゼントあるきね。",
            "zh": "还有，把我的剧情\n追到最新进度的话，\n会有各种礼物送啵。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "311/TALK",
            "narrator": "表層みやび",
            "text": "お前さんがまだ途中\nやったら、今最新まで\nやるとお得やよ？",
            "zh": "你要是还看到一半，\n现在一口气推到最新\n可划算咯？",
            "narrator_zh": "表层雅"
        },
        {
            "location": "316/TALK",
            "narrator": "表層みやび",
            "text": "ほんだら今回はこの辺で。\nまたココロスフィアでな。",
            "zh": "那就这次先到这儿。\n在心灵领域再见咯。",
            "narrator_zh": "表层雅"
        },
