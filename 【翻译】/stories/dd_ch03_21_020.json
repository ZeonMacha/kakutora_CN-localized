{
    "dir": "chap21/daydra/dd_ch03_21_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "21356",
        "cid": "gabriella",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "夜の怖さ",
        "title_zh": "Extra006 额外剧情",
        "sub_title_zh": "夜晚的恐惧"
    },
    "entry": [
        {
            "location": "226/SCENARIO",
            "narrator": "",
            "text": "夜の怖さ",
            "zh": "夜晚的恐惧",
            "narrator_zh": ""
        },
        {
            "location": "237/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "239/TALK",
            "narrator": "ガブリエラ",
            "text": "ど、どうしよう…\nトイレ行きたく\nなっちゃった…。",
            "zh": "怎、怎么办……\n突然好想上\n厕所啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "240/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "241/TALK",
            "narrator": "ガブリエラ",
            "text": "ああ、もうっ！\nいつもは夜中でも\n平気で行けるのに！",
            "zh": "啊，真是的！\n平时明明半夜也能\n毫不害怕地去的！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "242/TALK",
            "narrator": "ガブリエラ",
            "text": "寝る前に怪談なんて\nやるんじゃなかったわ…。",
            "zh": "睡前真不该听什么\n怪谈的……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "243/TALK",
            "narrator": "ガブリエラ",
            "text": "…んっ、んんっ！\nゲホゲホッ！",
            "zh": "……唔、唔唔！\n咳咳咳！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "244/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "246/TALK",
            "narrator": "ガブリエラ",
            "text": "誰も起きないし…！！",
            "zh": "大家都不醒啊……！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "247/SEL",
            "narrator": "",
            "text": "$me$が見てるよ",
            "zh": "$me$在看着哦",
            "narrator_zh": ""
        },
        {
            "location": "250/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "252/TALK",
            "narrator": "ガブリエラ",
            "text": "ううっ…お、お願いだから\n誰か起きてよぉ…。",
            "zh": "呜呜……拜、拜托了，\n随便谁快醒醒呀……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "254/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "258/TALK",
            "narrator": "ガブリエラ",
            "text": "ああ、もう限界！！",
            "zh": "啊啊，到极限了！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "259/TALK",
            "narrator": "ガブリエラ",
            "text": "お化けなんていない。\nうん、大丈夫！",
            "zh": "幽灵什么的根本不存在。\n嗯，没问题的！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "273/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "274/TALK",
            "narrator": "ガブリエラ",
            "text": "こ、怖いぃ…！\nリアルお化け屋敷じゃん！",
            "zh": "好、好可怕……！\n这简直就是现实版鬼屋嘛！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "275/TALK",
            "narrator": "ガブリエラ",
            "text": "日本の古民家って、\nどうしてこんな暗いのよ？",
            "zh": "日本的古民居，\n为什么会这么黑啊？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "277/TALK",
            "narrator": "ガブリエラ",
            "text": "…っ！？",
            "zh": "……唔！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "279/TALK",
            "narrator": "ガブリエラ",
            "text": "な、なんだ、床の音か…。",
            "zh": "什、什么嘛，是地板的声音啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "281/TALK",
            "narrator": "ガブリエラ",
            "text": "…トイレ、こんなに\n遠かったっかしら？",
            "zh": "……厕所，以前有\n这么远来着吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "282/TALK",
            "narrator": "ガブリエラ",
            "text": "…………っ！？",
            "zh": "…………！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "284/TALK",
            "narrator": "ガブリエラ",
            "text": "えっ？　な、なに？",
            "zh": "哎？　什、什么？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "285/TALK",
            "narrator": "ガブリエラ",
            "text": "今、二階から足音が…\nこんな時間に！？",
            "zh": "刚才，二楼好像有脚步声……\n都这种时间了！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "287/TALK",
            "narrator": "ガブリエラ",
            "text": "みやびのお母さん達は\n離れにいるはずだから――",
            "zh": "雅的妈妈她们\n应该在别院才对――",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "288/TALK",
            "narrator": "ガブリエラ",
            "text": "二階には誰もいない\nはずなのに！",
            "zh": "二楼明明应该\n一个人都没有的！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "291/TALK",
            "narrator": "ガブリエラ",
            "text": "…う、うそ…うそうそ、\nちょっと待って…。",
            "zh": "……骗、骗人的吧……骗人骗人，\n等一下啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "293/TALK",
            "narrator": "ガブリエラ",
            "text": "足音、二階から降りて…\n近づいてきてる…！？",
            "zh": "脚步声，从二楼下来……\n正在往这边靠近……！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "294/SEL",
            "narrator": "",
            "text": "$me$が付いてるよ",
            "zh": "$me$陪着你哦",
            "narrator_zh": ""
        },
        {
            "location": "296/TALK",
            "narrator": "ガブリエラ",
            "text": "ウソでしょ？\nお化けなんて、いるはず\nないのに…。",
            "zh": "骗人的吧？\n幽灵什么的，明明\n不可能有的……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "297/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…はぁ…。",
            "zh": "哈啊……哈啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "301/TALK",
            "narrator": "ガブリエラ",
            "text": "に、逃げなくちゃ！",
            "zh": "得、得赶紧逃才行！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "315/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ、はぁ…。\nな、何だったの、あれ？",
            "zh": "哈啊、哈啊……。\n刚、刚才那到底是什么？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "316/TALK",
            "narrator": "ガブリエラ",
            "text": "…ううん、もういい！",
            "zh": "……算了，不管了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "317/TALK",
            "narrator": "ガブリエラ",
            "text": "あれが心霊現象でも\nなんでも、もう考えたく\nないし！",
            "zh": "不管那是灵异现象还是\n别的什么，我再也\n不想去想了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "318/TALK",
            "narrator": "ガブリエラ",
            "text": "とにかく、明るくなるまで\n我慢してれば――",
            "zh": "总之，只要忍到天亮\n就行了――",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "321/TALK",
            "narrator": "みやび",
            "text": "ふぁ～…。",
            "zh": "哈啊～……。",
            "narrator_zh": "雅"
        },
        {
            "location": "324/TALK",
            "narrator": "ガブリエラ",
            "text": "っ！\nみ、みやび！？",
            "zh": "唔！\n雅、雅！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "326/TALK",
            "narrator": "みやび",
            "text": "ん？　ああ、すまん。\n起こしてしもうた？",
            "zh": "嗯？　啊，对不住。\n把你吵醒咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "327/TALK",
            "narrator": "ガブリエラ",
            "text": "…みやび、こんな時間まで\n起きてたの？",
            "zh": "……雅，你一直醒到\n这么晚吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "328/TALK",
            "narrator": "みやび",
            "text": "うん、部屋のＰＣ\n弄っちょったがよ。",
            "zh": "嗯，在房间里\n摆弄电脑啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "329/TALK",
            "narrator": "ガブリエラ",
            "text": "…ってことは、さっきの\n足音って…。",
            "zh": "……也就是说，刚才的\n脚步声是……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "333/TALK",
            "narrator": "みやび",
            "text": "ガブちゃんも早く寝ないと\nいかんよ、おやすみ…。",
            "zh": "加布也得早点睡\n才行咯，晚安……。",
            "narrator_zh": "雅"
        },
        {
            "location": "334/TALK",
            "narrator": "ガブリエラ",
            "text": "あっ…。",
            "zh": "啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "337/TALK",
            "narrator": "ガブリエラ",
            "text": "…おやすみ。",
            "zh": "……晚安。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "339/TALK",
            "narrator": "ガブリエラ",
            "text": "…あたしのバカ！\nあそこまで行ったのに、\n勝手に勘違いして！",
            "zh": "……我这个笨蛋！\n明明都走到那里了，\n还自己吓自己！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "341/TALK",
            "narrator": "ガブリエラ",
            "text": "ど、どうしよう…。\nもう一度トイレに――",
            "zh": "怎、怎么办……。\n再去一次厕所――",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "342/TALK",
            "narrator": "ガブリエラ",
            "text": "いやいや、絶対無理！\nまた廊下に出るとか\nありえないし！",
            "zh": "不不不，绝对不行！\n让我再走出走廊什么的\n绝不可能！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "344/TALK",
            "narrator": "ガブリエラ",
            "text": "…ううっ、\n早く明るくなってよぉ…。",
            "zh": "……呜呜，\n快点天亮吧……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "346/ACT",
            "narrator": "",
            "text": "$me$が付いてるよ",
            "zh": "$me$陪着你哦",
            "narrator_zh": ""
        },
        {
            "location": "350/TALK",
            "narrator": "ガブリエラ",
            "text": "ひっ！？",
            "zh": "噫！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "353/TALK",
            "narrator": "ガブリエラ",
            "text": "きゃぁぁぁぁ、もがっ！？",
            "zh": "呀啊啊啊、唔唔！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "356/TALK",
            "narrator": "みやび",
            "text": "しーっ、静かに。",
            "zh": "嘘――安静。",
            "narrator_zh": "雅"
        },
        {
            "location": "361/TALK",
            "narrator": "ガブリエラ",
            "text": "んむっ！？\nみ、みやび！？",
            "zh": "唔嗯！？\n雅、雅！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "362/TALK",
            "narrator": "みやび",
            "text": "みんなが起きるき、\n夜中に叫ぶんは\n関心せんよ？",
            "zh": "大家会被吵醒啵，\n半夜大喊大叫的\n可不行咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "365/TALK",
            "narrator": "ガブリエラ",
            "text": "ご、ごめん…\n急にスマホが震えて、\n驚いちゃって…。",
            "zh": "对、对不起……\n手机突然震了一下，\n把我吓了一跳……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "368/TALK",
            "narrator": "ガブリエラ",
            "text": "っていうか、みやび。\nまさか今まで起きてたの？",
            "zh": "话说回来，雅。\n难道你一直醒到现在吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "369/TALK",
            "narrator": "みやび",
            "text": "そりゃ、せっかく自室の\nＰＣ弄れる機会やっちゅう\nのに――",
            "zh": "那当然啦，好不容易才有\n机会摆弄自己房间的\n电脑嘛――",
            "narrator_zh": "雅"
        },
        {
            "location": "370/TALK",
            "narrator": "みやび",
            "text": "さっさと寝てしまうとか、\nありえんき。",
            "zh": "早早睡掉什么的，\n不可能啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "371/TALK",
            "narrator": "ガブリエラ",
            "text": "…な、なんだ…\n音の正体はみやび\nだったんだ…。",
            "zh": "……什、什么嘛……\n原来声音的源头就是\n雅啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "373/TALK",
            "narrator": "ガブリエラ",
            "text": "ふぅ…安心したわ。",
            "zh": "呼……放心了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "375/TALK",
            "narrator": "みやび",
            "text": "？",
            "zh": "？",
            "narrator_zh": "雅"
        },
        {
            "location": "377/TALK",
            "narrator": "ガブリエラ",
            "text": "あ、ううん。\n何でもない。",
            "zh": "啊，没什么。\n不用在意。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "378/TALK",
            "narrator": "みやび",
            "text": "そうか？\nとにかく、うちも\nもう寝るき――",
            "zh": "是吗？\n总之，我也准备\n去睡了啵――",
            "narrator_zh": "雅"
        },
        {
            "location": "379/TALK",
            "narrator": "みやび",
            "text": "ガブちゃんも、あんまし\n夜更かししたらいかんよ。",
            "zh": "加布也别熬太晚\n了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "381/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょ、ちょっと待った！",
            "zh": "等、等一下！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "382/TALK",
            "narrator": "ガブリエラ",
            "text": "みやび…あんた、寝る前に\nトイレには行ったの？",
            "zh": "雅……你睡前\n去过厕所了吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "383/TALK",
            "narrator": "みやび",
            "text": "いや、一時間くらい前に\n行ったけんど…。",
            "zh": "没，大概一小时前\n去过不过……。",
            "narrator_zh": "雅"
        },
        {
            "location": "384/TALK",
            "narrator": "ガブリエラ",
            "text": "もう一度行った方が\nいいわ。",
            "zh": "最好还是再去\n一趟哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "385/TALK",
            "narrator": "ガブリエラ",
            "text": "トイレに行きたくて\n夜中に起きるの、\n嫌でしょ？",
            "zh": "半夜因为想上厕所\n而醒过来，\n很讨厌的吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "386/TALK",
            "narrator": "みやび",
            "text": "…………？",
            "zh": "…………？",
            "narrator_zh": "雅"
        },
        {
            "location": "387/TALK",
            "narrator": "みやび",
            "text": "…ああ、なるほど。",
            "zh": "……啊，原来如此。",
            "narrator_zh": "雅"
        },
        {
            "location": "388/TALK",
            "narrator": "みやび",
            "text": "うん、そうやね。\nうちもスッキリしてから\n寝ることにするよ。",
            "zh": "嗯，也是咯。\n那我也先去痛快一下\n再睡咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "389/TALK",
            "narrator": "ガブリエラ",
            "text": "そ、そう…。\nうん、それがいいわ。",
            "zh": "这、这样啊……。\n嗯，这样最好。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "390/TALK",
            "narrator": "みやび",
            "text": "…ついでに、ガブちゃんに\n一つ教えとくけんど――",
            "zh": "……顺便，跟加布\n说一声不过――",
            "narrator_zh": "雅"
        },
        {
            "location": "391/TALK",
            "narrator": "みやび",
            "text": "廊下の電気のスイッチ、\n部屋の向かい側の壁に\nあるき――",
            "zh": "走廊电灯的开关，\n就在房间对面那面\n墙上啵――",
            "narrator_zh": "雅"
        },
        {
            "location": "392/TALK",
            "narrator": "みやび",
            "text": "次からは点けてきた方が、\nえいと思うよ。",
            "zh": "下次开始还是开着灯\n过来，比较要得咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "393/TALK",
            "narrator": "ガブリエラ",
