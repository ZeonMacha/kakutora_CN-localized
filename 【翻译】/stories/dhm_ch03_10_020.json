            "text": "012_クライシス・クライシス",
            "zh": "012_危机・危机",
            "narrator_zh": ""
        },
        {
            "location": "114/TALK",
            "narrator": "ガブリエラ",
            "text": "ねえマルザンナ",
            "zh": "我说，玛尔赞娜",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "115/TALK",
            "narrator": "ガブリエラ",
            "text": "私、ついに観てしまったのよ",
            "zh": "我终于看了哦",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "116/TALK",
            "narrator": "ガブリエラ",
            "text": "クライシス・ジュピターを！",
            "zh": "《危机・木星》！[?]",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "118/SEL",
            "narrator": "",
            "text": "楽しかった？",
            "zh": "开心吗？",
            "narrator_zh": ""
        },
        {
            "location": "119/SEL",
            "narrator": "",
            "text": "過激なシーンあった？",
            "zh": "有过激的场景吗？",
            "narrator_zh": ""
        },
        {
            "location": "120/SEL",
            "narrator": "",
            "text": "悪いことした気分？",
            "zh": "感觉自己做了坏事？",
            "narrator_zh": ""
        },
        {
            "location": "121/ACT",
            "narrator": "",
            "text": "楽しかった？",
            "zh": "开心吗？",
            "narrator_zh": ""
        },
        {
            "location": "122/TALK",
            "narrator": "ガブリエラ",
            "text": "それがね",
            "zh": "其实呀",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "123/TALK",
            "narrator": "ガブリエラ",
            "text": "ドキドキしてしまってあんまり頭に入らなかったの",
            "zh": "一直心怦怦跳，内容都没怎么进脑子",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "124/TALK",
            "narrator": "ガブリエラ",
            "text": "あ",
            "zh": "啊",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "125/TALK",
            "narrator": "ガブリエラ",
            "text": "その、えっちなシーンとかじゃなくて/////",
            "zh": "那个，不是那种色色的场景/////",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "126/TALK",
            "narrator": "ガブリエラ",
            "text": "悪いことしてるって意味でよ/////////////////",
            "zh": "是说做了坏事的那种意思啦/////////////////",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "127/TALK",
            "narrator": "ガブリエラ",
            "text": "勘違いしないで頂戴ね！",
            "zh": "你可别会错意哦！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "128/ACT",
            "narrator": "",
            "text": "過激なシーンあった？",
            "zh": "有过激的场景吗？",
            "narrator_zh": ""
        },
        {
            "location": "129/TALK",
            "narrator": "ガブリエラ",
            "text": "過激ってえっちなのとかって意味よね////////////////",
            "zh": "过激是指色色之类的意思吧////////////////",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "130/TALK",
            "narrator": "ガブリエラ",
            "text": "そういうのはなかったわよ！？！？！",
            "zh": "那种东西才没有呢！？！？！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "132/TALK",
            "narrator": "ガブリエラ",
            "text": "でも本当にそういうのもなくて",
            "zh": "不过那种内容真的连一点也没有",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "134/TALK",
            "narrator": "ガブリエラ",
            "text": "時々夜中のアニメでびっくりするのとか見るけど",
            "zh": "虽然偶尔会在半夜的动画里看到吓人的东西",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "135/TALK",
            "narrator": "ガブリエラ",
            "text": "あっちの方がよくないと思うのよ",
            "zh": "我觉得那边才更不像话呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "136/TALK",
            "narrator": "ガブリエラ",
            "text": "どうしてポーランドではレイティングされてたのかしらね？",
            "zh": "可为什么在波兰会被分级呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "137/ACT",
            "narrator": "",
            "text": "悪いことした気分？",
            "zh": "感觉自己做了坏事？",
            "narrator_zh": ""
        },
        {
            "location": "139/TALK",
            "narrator": "ガブリエラ",
            "text": "悪いことなんてしてないわ",
            "zh": "我才没做什么坏事呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "140/TALK",
            "narrator": "ガブリエラ",
            "text": "だって日本じゃレイティングの指定はないもの",
            "zh": "毕竟在日本根本没有分级嘛",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "142/TALK",
            "narrator": "ガブリエラ",
            "text": "でも",
            "zh": "可是",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "143/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょっとだけ",
            "zh": "就一点点",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "144/TALK",
            "narrator": "ガブリエラ",
            "text": "悪い子になった気分よ",
            "zh": "还是有点当坏孩子的感觉哦",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "146/SEL",
            "narrator": "",
            "text": "ガブは不良だね",
            "zh": "加布是不良少女呢",
            "narrator_zh": ""
        },
        {
            "location": "147/SEL",
            "narrator": "",
            "text": "よしよし、いい子いい子",
            "zh": "好啦好啦，乖孩子乖孩子",
            "narrator_zh": ""
        },
        {
            "location": "148/ACT",
            "narrator": "",
            "text": "ガブは不良だね",
            "zh": "加布是不良少女呢",
            "narrator_zh": ""
        },
        {
            "location": "149/TALK",
            "narrator": "ガブリエラ",
            "text": "不良なんかじゃないわ",
            "zh": "我才不是什么不良呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "150/TALK",
            "narrator": "ガブリエラ",
            "text": "ないったら！",
            "zh": "才不是呢！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "151/ACT",
            "narrator": "",
            "text": "よしよし、いい子いい子",
            "zh": "好啦好啦，乖孩子乖孩子",
            "narrator_zh": ""
        },
        {
            "location": "153/TALK",
            "narrator": "ガブリエラ",
            "text": "うん",
            "zh": "嗯",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "154/TALK",
            "narrator": "ガブリエラ",
            "text": "やっぱり私悪いことしてないわよね",
            "zh": "果然我什么坏事都没做过呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "155/TALK",
            "narrator": "ガブリエラ",
            "text": "よかったわ",
            "zh": "太好了",
            "narrator_zh": "加布里埃拉"
        }
    ]
