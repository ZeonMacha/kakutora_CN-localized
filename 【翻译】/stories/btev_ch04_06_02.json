{
    "dir": "chap06/battle/btev_ch04_06_02.js",
    "type": "",
    "info": {
        "story_id": "24009",
        "cid": "",
        "title": "009 ココロスフィアストーリー【Lv03】",
        "sub_title": "敵Ⅲ＜帰結＞",
        "title_zh": "009 心灵领域故事【Lv03】",
        "sub_title_zh": "敌人Ⅲ＜归结＞"
    },
    "entry": [
        {
            "location": "115/SCENARIO",
            "narrator": "",
            "text": "敵Ⅱ４",
            "zh": "敌人Ⅱ4",
            "narrator_zh": ""
        },
        {
            "location": "127/TALK",
            "narrator": "潜在みやび",
            "text": "相変わらず\n馬鹿力な想いやね。",
            "zh": "还是一如既往地\n蛮力心意咯。",
            "narrator_zh": "潜在雅"
        },
        {
            "location": "128/TALK",
            "narrator": "表層みやび",
            "text": "クラン共を\nちぎっては投げ\nちぎっては投げ。",
            "zh": "把那些库兰\n揪起来就摔，\n揪起来就摔。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "129/TALK",
            "narrator": "潜在みやび",
            "text": "毎回よう\n頑張っちょるなぁ。",
            "zh": "每次都这么\n拼命呐。",
            "narrator_zh": "潜在雅"
        },
        {
            "location": "130/TALK",
            "narrator": "表層みやび",
            "text": "その元気、\nいつまで続くかね。",
            "zh": "这股干劲，\n还能撑多久呢。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "132/TALK",
            "narrator": "潜在みやび",
            "text": "さて、と。\nほんだら、例によって\n例の如く――",
            "zh": "那么，好。\n那就照老规矩\n照旧例——",
            "narrator_zh": "潜在雅"
        },
        {
            "location": "134/TALK",
            "narrator": "表層みやび",
            "text": "敵対していた方の\n人格さんは消えるき。",
            "zh": "敌对的那边\n人格就会消失啵。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "135/TALK",
            "narrator": "潜在みやび",
            "text": "後はよろしく頼んだ。\nOR頼まれた。",
            "zh": "之后就拜托了。\nOR受人所托。",
            "narrator_zh": "潜在雅"
        },
        {
            "location": "136/TALK",
            "narrator": "表層みやび",
            "text": "頼んだOR頼まれた。",
            "zh": "拜托了OR受人所托。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "154/TALK",
            "narrator": "みやび",
            "text": "ふう。",
            "zh": "呼。",
            "narrator_zh": "雅"
        },
        {
            "location": "155/SEL",
            "narrator": "（選択肢）",
            "text": "相変わらず徹底してるね",
            "zh": "还是一如既往地彻底呢",
            "narrator_zh": "（选项）"
        },
        {
            "location": "156/ACT",
            "narrator": "",
            "text": "相変わらず徹底してるね",
            "zh": "还是一如既往地彻底呢",
            "narrator_zh": ""
        },
        {
            "location": "158/TALK",
            "narrator": "みやび",
            "text": "うむ。\nハッカーたるもの\n身バレは最悪やきね。",
            "zh": "嗯。\n身为黑客，\n暴露真实身份可是最糟的啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "159/TALK",
            "narrator": "みやび",
            "text": "とはいえ、もう\nお前さんにはそこまで\nせんでもえいか。",
            "zh": "话虽如此，倒也\n没必要对你\n做到那份上就是了。",
            "narrator_zh": "雅"
        },
        {
            "location": "161/TALK",
            "narrator": "みやび",
            "text": "なあ$handle$。\n本当のところ、何が\n目的で近づいちょる？",
            "zh": "我说$handle$。\n老实讲，你接近我\n到底有驷马目的？",
            "narrator_zh": "雅"
        },
        {
            "location": "162/TALK",
            "narrator": "みやび",
            "text": "ここまで拳で語り\n合ってきた仲や。",
            "zh": "好歹也是拳脚\n相交过来的交情咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "163/TALK",
            "narrator": "みやび",
            "text": "もう正直に教えて\nくれてもえいろう。",
            "zh": "事到如今老实\n告诉我了也行嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "164/SEL",
            "narrator": "（選択肢）",
            "text": "みやびを助けたい",
            "zh": "想帮助雅",
            "narrator_zh": "（选项）"
        },
        {
            "location": "165/SEL",
            "narrator": "（選択肢）",
            "text": "みやびのことをもっと知りたい",
            "zh": "想更了解雅",
            "narrator_zh": "（选项）"
        },
        {
            "location": "166/SEL",
            "narrator": "（選択肢）",
            "text": "みやびを娶りたい",
            "zh": "想娶雅",
            "narrator_zh": "（选项）"
        },
        {
            "location": "167/SEL",
            "narrator": "（選択肢）",
            "text": "フラグ立てるために仕方なく",
            "zh": "为了立Flag才不得已",
            "narrator_zh": "（选项）"
        },
        {
            "location": "168/ACT",
            "narrator": "",
            "text": "みやびを助けたい",
            "zh": "想帮助雅",
            "narrator_zh": ""
        },
        {
            "location": "169/TALK",
            "narrator": "みやび",
            "text": "前も聞いたけんど\nそれは本当かえ？",
            "zh": "之前也问过，但是\n这是真的咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "170/TALK",
            "narrator": "みやび",
            "text": "まあ、そこまで\n言うなら信じるぞね。",
            "zh": "嘛，你都说到\n这份上了，那就信你咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "171/ACT",
            "narrator": "",
            "text": "みやびのことをもっと知りたい",
            "zh": "想更了解雅",
            "narrator_zh": ""
        },
        {
            "location": "172/TALK",
            "narrator": "みやび",
            "text": "知ってどうする？",
            "zh": "知道了又想怎样？",
            "narrator_zh": "雅"
        },
        {
            "location": "173/TALK",
            "narrator": "みやび",
            "text": "やっぱりうちから\n何かを奪おうと\nしちょるが？",
            "zh": "果然还是想从我这儿\n抢走驷马东西\n咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "174/SEL",
            "narrator": "（選択肢）",
            "text": "なんでそんな警戒するの？",
            "zh": "为什么这么戒备啊？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "175/ACT",
            "narrator": "",
            "text": "なんでそんな警戒するの？",
            "zh": "为什么这么戒备啊？",
            "narrator_zh": ""
        },
        {
            "location": "177/TALK",
            "narrator": "みやび",
            "text": "そういう性やきね。",
            "zh": "我就是这种性子啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "178/TALK",
            "narrator": "みやび",
            "text": "まあえい。\n信じると決めたら\n信じるちや。",
            "zh": "算了得。\n既然决定了要信，\n那就信滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "179/ACT",
            "narrator": "",
            "text": "みやびを娶りたい",
            "zh": "想娶雅",
            "narrator_zh": ""
        },
        {
            "location": "180/TALK",
            "narrator": "みやび",
            "text": "ふむ。\nえい答えやね。",
            "zh": "唔。\n好回答咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "181/TALK",
            "narrator": "みやび",
            "text": "すなわちそれは、\n中の人がいる場合は\n好意的かつ――",
            "zh": "也就是说，\n若背后有真人操作，\n既是怀有好意——",
            "narrator_zh": "雅"
        },
        {
            "location": "182/TALK",
            "narrator": "みやび",
            "text": "現時点では物理的\n接触は不可能である\nということ。",
            "zh": "现阶段也\n不可能产生\n物理接触。",
            "narrator_zh": "雅"
        },
        {
            "location": "183/TALK",
            "narrator": "みやび",
            "text": "逆にAIならば、\n単なるゴタクに\n過ぎん。",
            "zh": "反之若是AI，\n那不过是一通\n胡扯罢了。",
            "narrator_zh": "雅"
        },
        {
            "location": "184/TALK",
            "narrator": "みやび",
            "text": "どちらにせよ、うちに\nとっては無害な存在っ\nちゅうことやきね。",
            "zh": "不管哪种，对我\n来说都是无害的\n存在啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "185/ACT",
            "narrator": "",
            "text": "フラグ立てるために仕方なく",
            "zh": "为了立Flag才不得已",
            "narrator_zh": ""
        },
        {
            "location": "186/TALK",
            "narrator": "みやび",
            "text": "なるほどな。",
            "zh": "原来如此。",
            "narrator_zh": "雅"
        },
        {
            "location": "187/TALK",
            "narrator": "みやび",
            "text": "ならば、割とどうでも\nいい存在ゆうこっちゃ\nな。お互いに。",
            "zh": "那么，彼此彼此都算\n挺无关紧要的\n存在咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "188/TALK",
            "narrator": "みやび",
            "text": "それくらいがえいな。\n近いうちに、ここにも\n来なくなるじゃろ。",
            "zh": "那样倒也正好。\n过不了多久，你大概也不会\n再往这儿来了吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "190/TALK",
            "narrator": "みやび",
            "text": "何にしても、今回の\nことは、うち全体に\nとって大きな変化や。",
            "zh": "不管怎样，这次的\n事对我整体来说，\n是个很大的变化咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "191/TALK",
            "narrator": "みやび",
            "text": "$handle$に\n対するスタンスに\n結論を出したわけやし。",
            "zh": "对$handle$\n的态度总算\n有了结论嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "192/TALK",
            "narrator": "みやび",
            "text": "現実のうちも、\nしばらくは大人しく\nつき合うじゃろ。",
            "zh": "现实里的我，\n大概也会消停一阵子\n跟你相处吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "193/TALK",
            "narrator": "みやび",
            "text": "まあそんなわけで、\nせっかく和解した\nわけやし――",
            "zh": "嘛就是这样，\n既然难得\n和解了——",
            "narrator_zh": "雅"
        },
        {
            "location": "194/TALK",
            "narrator": "みやび",
            "text": "和解記念にひとつ\nちゅーでもしよか。",
            "zh": "作为和解纪念，\n要不来亲一下？",
            "narrator_zh": "雅"
        },
        {
            "location": "195/SEL",
            "narrator": "（選択肢）",
            "text": "是非！！",
            "zh": "务必！！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "196/SEL",
            "narrator": "（選択肢）",
            "text": "遠慮します",
            "zh": "不了谢谢",
            "narrator_zh": "（选项）"
        },
        {
            "location": "197/ACT",
            "narrator": "",
            "text": "是非！！",
            "zh": "务必！！",
            "narrator_zh": ""
        },
        {
            "location": "198/TALK",
            "narrator": "みやび",
            "text": "うむ。\n素直が一番やきね。",
            "zh": "嗯。\n老实听话最好啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "216/TALK",
            "narrator": "みやび",
            "text": "さあ、はよう。",
            "zh": "来，快点。",
            "narrator_zh": "雅"
        },
        {
            "location": "222/DIALOG",
            "narrator": "",
            "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n接続されました。\n\n画面をタップして相手に\n感覚を伝えましょう。",
            "zh": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\n触摸交流\n已连接。\n\n轻点画面，\n把感觉传达给对方吧。",
            "narrator_zh": ""
        },
        {
            "location": "234/TALK",
            "narrator": "みやび",
            "text": "ふぁっ…",
            "zh": "呼啊……",
            "narrator_zh": "雅"
        },
        {
            "location": "237/TALK",
            "narrator": "みやび",
            "text": "ふぁっ…",
            "zh": "呼啊……",
            "narrator_zh": "雅"
        },
        {
            "location": "241/DIALOG",
            "narrator": "",
            "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n切断されました。",
            "zh": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\n触摸交流\n已断开。",
            "narrator_zh": ""
        },
        {
            "location": "259/TALK",
            "narrator": "みやび",
            "text": "ふむ。\nえい『ちゅー』やった。",
            "zh": "唔。\n真是个好“亲亲”。",
            "narrator_zh": "雅"
        },
        {
            "location": "260/TALK",
            "narrator": "みやび",
            "text": "まあ、これも全て\n幻想でしかないの\nやけんどな。",
            "zh": "嘛，不过这一切\n也都只是\n幻想罢了，但是呢。",
            "narrator_zh": "雅"
        },
        {
            "location": "261/SEL",
            "narrator": "（選択肢）",
            "text": "幻想？",
            "zh": "幻想？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "262/ACT",
            "narrator": "",
            "text": "幻想？",
            "zh": "幻想？",
            "narrator_zh": ""
        },
        {
            "location": "264/TALK",
            "narrator": "みやび",
            "text": "当然や。\nここは精神世界。\n単なる妄想に過ぎん。",
            "zh": "那当然。\n这里是精神世界。\n不过是单纯的妄想罢了。",
            "narrator_zh": "雅"
        },
        {
            "location": "265/TALK",
            "narrator": "みやび",
            "text": "まあ、本気で\nうちに興味あるなら―",
            "zh": "嘛，你要是真对\n我有兴趣的话—",
            "narrator_zh": "雅"
        },
        {
            "location": "266/TALK",
            "narrator": "みやび",
            "text": "現実のうちと\n『ちゅー』できるよう\nがんばりや。",
            "zh": "就加油争取跟\n现实里的我\n“亲亲”吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "267/TALK",
            "narrator": "みやび",
            "text": "ここからが\n大変やきね。",
            "zh": "往后才是\n难关重重啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "268/ACT",
            "narrator": "",
            "text": "遠慮します",
            "zh": "不了谢谢",
            "narrator_zh": ""
        },
        {
            "location": "270/TALK",
            "narrator": "みやび",
            "text": "なに！？\n本気か！？",
            "zh": "什么！？\n认真的咩！？",
            "narrator_zh": "雅"
        },
        {
            "location": "271/SEL",
            "narrator": "（選択肢）",
            "text": "裏が有りそう",
            "zh": "感觉背后有隐情",
            "narrator_zh": "（选项）"
        },
        {
            "location": "272/ACT",
            "narrator": "",
            "text": "裏が有りそう",
            "zh": "感觉背后有隐情",
            "narrator_zh": ""
        },
        {
            "location": "274/TALK",
            "narrator": "みやび",
            "text": "はぁ……\n可哀想なヤツやね。",
            "zh": "唉……\n真是个可怜的家伙咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "275/TALK",
            "narrator": "みやび",
            "text": "きっと今まで\n世の中の全てを疑って\n生きてきたんやろな。",
            "zh": "大概至今为止，\n都是怀疑着世间万物\n活过来的吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "276/SEL",
            "narrator": "（選択肢）",
            "text": "みやび先輩にだけは言われたくないんですけど",
            "zh": "我可不想唯独被雅前辈这么说",
            "narrator_zh": "（选项）"
        },
        {
            "location": "277/ACT",
            "narrator": "",
            "text": "みやび先輩にだけは言われたくないんですけど",
            "zh": "我可不想唯独被雅前辈这么说",
            "narrator_zh": ""
        },
        {
            "location": "279/TALK",
            "narrator": "みやび",
            "text": "まあえいよ。",
            "zh": "得吧得吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "280/TALK",
            "narrator": "みやび",
            "text": "これが最初で最後の\nうちからのプレゼント\nやったけんど――",
            "zh": "这本来是来自我的\n最初也是最后的\n礼物，但是——",
            "narrator_zh": "雅"
        },
        {
            "location": "281/TALK",
            "narrator": "みやび",
            "text": "もらうもらわないは\nもらい手の自由やきね。",
            "zh": "收不收下\n是收礼人的自由啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "282/TALK",
            "narrator": "みやび",
            "text": "けんど、ここから先が\n本番ちや。",
            "zh": "但是，从这里往后\n才是正戏滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "283/TALK",
            "narrator": "みやび",
            "text": "うちの深い所を見よう\nゆうなら、それなりに\n覚悟していきや。",
            "zh": "想窥探我更深处的\n东西，就做好相应的\n觉悟再进来咯。",
            "narrator_zh": "雅"
        }
    ]
}
