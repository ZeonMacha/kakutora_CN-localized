        },
        {
            "location": "1916/ACT",
            "narrator": "",
            "text": "ファはファンクションのファ",
            "zh": "发，是函数的发",
            "narrator_zh": ""
        },
        {
            "location": "1917/TALK",
            "narrator": "神楽",
            "text": "もっと不穏当な言葉にしてくれないとー！",
            "zh": "不换成更不妥的词可不行——！",
            "narrator_zh": "神乐"
        },
        {
            "location": "1918/TALK",
            "narrator": "神楽",
            "text": "ぴょんこはもうぷんぷん！",
            "zh": "蹦子已经气鼓鼓了！",
            "narrator_zh": "神乐"
        },
        {
            "location": "1919/ACT",
            "narrator": "",
            "text": "ファ、ファイト！",
            "zh": "发，加油！",
            "narrator_zh": ""
        },
        {
            "location": "1920/TALK",
            "narrator": "神楽",
            "text": "あーね",
            "zh": "啊是呢",
            "narrator_zh": "神乐"
        },
        {
            "location": "1921/TALK",
            "narrator": "神楽",
            "text": "やです",
            "zh": "不要",
            "narrator_zh": "神乐"
        },
        {
            "location": "1922/ACT",
            "narrator": "",
            "text": "ファッファッファッファッｗ",
            "zh": "发发发发哈哈",
            "narrator_zh": ""
        },
        {
            "location": "1924/TALK",
            "narrator": "神楽",
            "text": "ファッウケたｗ",
            "zh": "发，笑到了哈哈",
            "narrator_zh": "神乐"
        },
        {
            "location": "1925/TALK",
            "narrator": "神楽",
            "text": "やったね！！！",
            "zh": "成功了！！！",
            "narrator_zh": "神乐"
        },
        {
            "location": "1929/TALK",
            "narrator": "神楽",
            "text": "原曲の歌詞自体が納得いかないんだけどねこれ",
            "zh": "不过原曲的歌词本身我就没法接受",
            "narrator_zh": "神乐"
        },
        {
            "location": "1930/TALK",
            "narrator": "神楽",
            "text": "実際はドの音じゃないし",
            "zh": "实际上也不是哆这个音",
            "narrator_zh": "神乐"
        },
        {
            "location": "1933/SEL",
            "narrator": "",
            "text": "そうだったんだ！？",
            "zh": "是这样的吗！？",
            "narrator_zh": ""
        },
        {
            "location": "1934/SEL",
            "narrator": "",
            "text": "知ってたしー",
            "zh": "我早就知道了——",
            "narrator_zh": ""
        },
        {
            "location": "1935/ACT",
            "narrator": "",
            "text": "そうだったんだ！？",
            "zh": "是这样的吗！？",
            "narrator_zh": ""
        },
        {
            "location": "1936/TALK",
            "narrator": "神楽",
            "text": "ここにも一人騙されていた人間が",
            "zh": "这里又有一个被骗的人",
            "narrator_zh": "神乐"
        },
        {
            "location": "1937/ACT",
            "narrator": "",
            "text": "知ってたしー",
            "zh": "我早就知道了——",
            "narrator_zh": ""
        },
        {
            "location": "1938/TALK",
            "narrator": "神楽",
            "text": "へーそう？",
            "zh": "诶，是吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1940/TALK",
            "narrator": "神楽",
            "text": "ドーいうことなのって聞きたくなるでしょ？",
            "zh": "就会想问，这到底是哆么回事吧",
            "narrator_zh": "神乐"
        },
        {
            "location": "1942/SEL",
            "narrator": "",
            "text": "それはさすがに寒…",
            "zh": "这玩笑也太冷了……",
            "narrator_zh": ""
        },
        {
            "location": "1943/SEL",
            "narrator": "",
            "text": "ドーなってんだろうね！？",
            "zh": "到底哆成什么样了！？",
            "narrator_zh": ""
        },
        {
            "location": "1944/SEL",
            "narrator": "",
            "text": "作曲家を問い詰めよう！",
            "zh": "去追问作曲家！",
            "narrator_zh": ""
        },
        {
            "location": "1945/ACT",
            "narrator": "",
            "text": "それはさすがに寒…",
            "zh": "这玩笑也太冷了……",
            "narrator_zh": ""
        },
        {
            "location": "1946/TALK",
            "narrator": "神楽",
            "text": "自分でもそうオモタ",
            "zh": "我自己也这么觉得",
            "narrator_zh": "神乐"
        },
        {
            "location": "1947/TALK",
            "narrator": "神楽",
            "text": "そしてｵﾜﾀ＼(^o^)／",
            "zh": "然后结束了＼(^o^)／",
            "narrator_zh": "神乐"
        },
        {
            "location": "1948/ACT",
            "narrator": "",
            "text": "ドーなってんだろうね！？",
            "zh": "到底哆成什么样了！？",
            "narrator_zh": ""
        },
        {
            "location": "1950/TALK",
            "narrator": "神楽",
            "text": "うわ寒っｗｗｗ",
            "zh": "哇好冷哈哈哈",
            "narrator_zh": "神乐"
        },
        {
            "location": "1951/TALK",
            "narrator": "神楽",
            "text": "マジヤバスｗｗｗ",
            "zh": "真的糟了哈哈哈",
            "narrator_zh": "神乐"
        },
        {
            "location": "1952/TALK",
            "narrator": "神楽",
            "text": "でもそこがｲｲ！！！",
            "zh": "可就是这里好！！！",
            "narrator_zh": "神乐"
        },
        {
            "location": "1953/ACT",
            "narrator": "",
            "text": "作曲家を問い詰めよう！",
            "zh": "去追问作曲家！",
            "narrator_zh": ""
        },
        {
            "location": "1954/TALK",
            "narrator": "神楽",
            "text": "それはいいや",
            "zh": "那个就算了",
            "narrator_zh": "神乐"
        },
        {
            "location": "1956/TALK",
            "narrator": "神楽",
            "text": "ぴょんこは残りのソラシドについて考えながら眠ります",
