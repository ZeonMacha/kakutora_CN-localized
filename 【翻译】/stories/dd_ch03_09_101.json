{
    "dir": "chap09/daydra/dd_ch03_09_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "9302",
        "cid": "gabriella",
        "title": "002 メインストーリー",
        "sub_title": "クラスの実態＜前編＞",
        "title_zh": "002 主线剧情",
        "sub_title_zh": "班级的实情＜前篇＞"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "クラスの実態",
            "zh": "班级的实情",
            "narrator_zh": ""
        },
        {
            "location": "30/TALK",
            "narrator": "ガブリエラ",
            "text": "…さてと。\n今日もバイトだし、\nさっさと帰って――",
            "zh": "……那么。\n今天也有打工，\n赶紧回去吧——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "32/TALK",
            "narrator": "つばめ",
            "text": "えーっと…。",
            "zh": "那个……。",
            "narrator_zh": "燕"
        },
        {
            "location": "41/TALK",
            "narrator": "つばめ",
            "text": "あっ、せんぱーい！",
            "zh": "啊，前辈—！",
            "narrator_zh": "燕"
        },
        {
            "location": "44/TALK",
            "narrator": "ガブリエラ",
            "text": "っ！？　し、新人！？",
            "zh": "唔！？新、新人！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "45/TALK",
            "narrator": "つばめ",
            "text": "よかったぁ…。\n先に帰ってたら\nどうしようかと――",
            "zh": "太好了呀……。\n我还在想要是你先回去了\n该怎么办呢——",
            "narrator_zh": "燕"
        },
        {
            "location": "47/TALK",
            "narrator": "ガブリエラ",
            "text": "ば、バカ！\n声が大きいから！",
            "zh": "笨、笨蛋！\n声音太大了啦！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "48/TALK",
            "narrator": "つばめ",
            "text": "あっ…。",
            "zh": "啊……。",
            "narrator_zh": "燕"
        },
        {
            "location": "52/TALK",
            "narrator": "つばめ",
            "text": "えへへ…。\n目立っちゃった…。",
            "zh": "哎嘿嘿……。\n一下子显眼了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "54/TALK",
            "narrator": "ガブリエラ",
            "text": "まったく…。",
            "zh": "真是的……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "57/TALK",
            "narrator": "つばめ",
            "text": "ごめんなさい、\nガブリエラせんぱい。",
            "zh": "对不起，\n加布里埃拉前辈。",
            "narrator_zh": "燕"
        },
        {
            "location": "59/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょ！？\nここでせんぱいって\n言うな！",
            "zh": "喂！？\n说了别在这里\n叫前辈啊！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "60/TALK",
            "narrator": "つばめ",
            "text": "えっ！？　でも、\nせんぱいがそう呼べ、\nって言ったのに…。",
            "zh": "咦！？可是，\n明明是前辈让我\n这么叫的呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "61/TALK",
            "narrator": "ガブリエラ",
            "text": "だ、だから、声も\nもう少し抑えて…。",
            "zh": "所、所以说，声音也\n给我压低一点啦……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "65/TALK",
            "narrator": "ガブリエラ",
            "text": "…ううん。\nもう遅いか…。。",
            "zh": "……算了。\n已经晚了吧……。。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "66/TALK",
            "narrator": "男子高校生Ａ",
            "text": "なあ、あの人って\n特別攻撃隊に入った\n高等部の先輩だろ？",
            "zh": "喂，那个人就是\n进了特别攻击队的\n高中部前辈吧？",
            "narrator_zh": "男高中生A"
        },
        {
            "location": "67/TALK",
            "narrator": "女子高校生Ａ",
            "text": "そうそう。\nこの間転校して\nきたんだって。",
            "zh": "对对。\n听说前阵子才\n转学过来的。",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "68/TALK",
            "narrator": "男子高校生Ｂ",
            "text": "年上の人に先輩って\n呼ばせてるとか、\nすげーな……。",
            "zh": "居然让年纪比自己大的人\n叫自己前辈，\n好厉害啊……。",
            "narrator_zh": "男高中生B"
        },
        {
            "location": "69/TALK",
            "narrator": "女子高校生Ａ",
            "text": "うん…度胸あるよね。",
            "zh": "嗯……真有胆量呢。",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "72/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…またあたしの\nイメージが…。",
            "zh": "哈啊……我的形象\n又被……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "73/TALK",
            "narrator": "ガブリエラ",
            "text": "タダでさえ浮き\nまくってるって\nいうのに……。",
            "zh": "本来就已经格格不入\n到极点了\n说起来……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "75/TALK",
            "narrator": "つばめ",
            "text": "えっと…怒ってる？",
            "zh": "那个……你生气了吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "78/TALK",
            "narrator": "ガブリエラ",
            "text": "…怒ってなんか\nないから。ほら、\nさっさと出るわよ！",
            "zh": "……我才没有\n生气呢。好啦，\n赶紧出去吧！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "81/TALK",
            "narrator": "つばめ",
            "text": "あ、待ってください、\nせんぱい！",
            "zh": "啊，请等一下，\n前辈！",
            "narrator_zh": "燕"
        },
        {
            "location": "85/TALK",
            "narrator": "ガブリエラ",
            "text": "せんぱいは\nやめなさいって！",
            "zh": "说了别叫\n前辈啦！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "107/TALK",
            "narrator": "ガブリエラ",
            "text": "まったく…高等部の\n人が中等部の教室に\n来たら――",
            "zh": "真是的……高中部的人\n跑到初中部的教室里\n来——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "108/TALK",
            "narrator": "ガブリエラ",
            "text": "それだけで目立つって\nわかんないの！？",
            "zh": "光这样就会很显眼，\n难道你不懂吗！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "110/TALK",
            "narrator": "つばめ",
            "text": "そ、そうだよね…。",
            "zh": "这、说得也是呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "113/TALK",
            "narrator": "ガブリエラ",
            "text": "それで、何の用？\nなんか話すことでも\nあるわけ？",
            "zh": "所以呢，有什么事？\n难道有什么话\n要跟我说吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "115/TALK",
            "narrator": "つばめ",
            "text": "あ、はい…せんぱい、\n昼休みにわたしの\n教室に来ましたよね？",
            "zh": "啊，是的……前辈，\n午休的时候你来过\n我的教室对吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "117/TALK",
            "narrator": "ガブリエラ",
            "text": "っ！？\nき、気付かれてた！？",
            "zh": "唔！？\n被、被发现了吗！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "118/TALK",
            "narrator": "つばめ",
            "text": "でも、教室覗いて、\nそのまま帰っちゃった\nから――",
            "zh": "不过，你往教室里看了一眼\n就那样直接回去了，\n所以——",
            "narrator_zh": "燕"
        },
        {
            "location": "119/TALK",
            "narrator": "つばめ",
            "text": "ちょっと心配で、\n様子を見に来たん\nです。",
            "zh": "我有点担心，\n就过来看看你的\n情况了。",
            "narrator_zh": "燕"
        },
        {
            "location": "122/TALK",
            "narrator": "ガブリエラ",
            "text": "別に…心配するような\nことじゃないでしょ？",
            "zh": "也没什么……值得\n你担心的事吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "124/TALK",
            "narrator": "つばめ",
            "text": "わたしがまた何か\nやっちゃったのかな、\nって…。えへへ。",
            "zh": "我还在想是不是我又\n闯了什么祸呢，\n这样……。哎嘿嘿。",
            "narrator_zh": "燕"
        },
        {
            "location": "128/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ……",
            "zh": "哈啊……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "130/TALK",
            "narrator": "ガブリエラ",
            "text": "それってちょっと\n自意識過剰なんじゃ\nない？",
            "zh": "你那是不是有点\n自我意识过剩\n了啊？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "132/TALK",
            "narrator": "つばめ",
            "text": "え？",
            "zh": "咦？",
            "narrator_zh": "燕"
        },
        {
            "location": "134/TALK",
            "narrator": "ガブリエラ",
            "text": "べ、べつにあんたの\n様子を見に行った\nわけじゃないの！",
            "zh": "我、我才不是特意\n去看你的\n情况的呢！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "135/TALK",
            "narrator": "ガブリエラ",
            "text": "変に勘違いしないで。",
            "zh": "别乱误会啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "137/TALK",
            "narrator": "つばめ",
            "text": "あ、あはは。\nそうですよね。\nごめんなさい。",
            "zh": "啊、啊哈哈。\n说得也是呢。\n对不起。",
            "narrator_zh": "燕"
        },
        {
            "location": "140/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "142/TALK",
            "narrator": "つばめ",
            "text": "…やっぱり、\nいつもと比べて\n元気がないかも…。",
            "zh": "……果然，\n跟平时比起来\n好像没什么精神……。",
            "narrator_zh": "燕"
        },
        {
            "location": "145/TALK",
            "narrator": "つばめ",
            "text": "あ、あの…相談したい\nこととかあったら、\n言ってくださいね？",
            "zh": "那、那个……要是有什么\n想找人商量的事，\n随时跟我说哦？",
            "narrator_zh": "燕"
        },
        {
            "location": "147/TALK",
            "narrator": "ガブリエラ",
            "text": "うるさい！\n何もないって\n言ってるでしょ！？",
            "zh": "吵死了！\n我不是说了\n什么事都没有吗！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "150/TALK",
            "narrator": "つばめ",
            "text": "…ごめんなさい。",
            "zh": "……对不起。",
            "narrator_zh": "燕"
        },
        {
            "location": "151/TALK",
            "narrator": "ガブリエラ",
            "text": "まったく…。",
            "zh": "真是的……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "152/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "153/SEL",
            "narrator": "",
            "text": "そんなに怒らないで",
            "zh": "别这么生气啦",
            "narrator_zh": ""
        },
        {
            "location": "154/ACT",
            "narrator": "",
            "text": "そんなに怒らないで",
            "zh": "别这么生气啦",
            "narrator_zh": ""
        },
        {
            "location": "165/TALK",
            "narrator": "ガブリエラ",
            "text": "私のせいじゃないわ",
            "zh": "又不是我的错",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "166/TALK",
            "narrator": "ガブリエラ",
            "text": "新人が天然過ぎるのがいけないのよ",
            "zh": "都怪新人太天然了才这样的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "168/SEL",
            "narrator": "",
            "text": "天然だから許してあげて",
            "zh": "因为天然就原谅她吧",
            "narrator_zh": ""
        },
        {
            "location": "169/ACT",
            "narrator": "",
            "text": "天然だから許してあげて",
            "zh": "因为天然就原谅她吧",
            "narrator_zh": ""
        },
        {
            "location": "171/TALK",
            "narrator": "ガブリエラ",
            "text": "違うわ",
            "zh": "不对啦",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "174/TALK",
            "narrator": "ガブリエラ",
            "text": "違うのよ、マルザンナ",
            "zh": "不是那样的，玛尔赞娜",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "175/TALK",
            "narrator": "ガブリエラ",
            "text": "そういうことじゃないのよ",
            "zh": "不是那么回事啦",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "222/SEL",
            "narrator": "",
            "text": "そういうことじゃないなら、どういうことなんだろうか",
            "zh": "既然不是那么回事，那究竟是怎么回事呢",
            "narrator_zh": ""
        },
        {
            "location": "223/ACT",
            "narrator": "",
            "text": "そういうことじゃないなら、どういうことなんだろうか",
            "zh": "既然不是那么回事，那究竟是怎么回事呢",
            "narrator_zh": ""
        },
        {
            "location": "226/TALK",
            "narrator": "ガブリエラ",
            "text": "あら、どうしたの？",
            "zh": "哎呀，怎么啦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "227/SEL",
            "narrator": "",
            "text": "現実のガブリエラが「そういうことじゃないのよ」って",
            "zh": "现实里的加布里埃拉说“不是那么回事啦”",
            "narrator_zh": ""
        },
        {
            "location": "228/ACT",
            "narrator": "",
            "text": "現実のガブリエラが「そういうことじゃないのよ」って",
            "zh": "现实里的加布里埃拉说“不是那么回事啦”",
            "narrator_zh": ""
        },
        {
            "location": "230/TALK",
            "narrator": "ガブリエラ",
            "text": "なるほどね♪",
            "zh": "原来如此呀♪",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "231/TALK",
            "narrator": "ガブリエラ",
            "text": "答えは簡単！",
            "zh": "答案很简单！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "232/SEL",
            "narrator": "",
            "text": "流石本人の一人格！",
            "zh": "不愧是本人的一个人格！",
            "narrator_zh": ""
        },
        {
            "location": "233/ACT",
            "narrator": "",
            "text": "流石本人の一人格！",
            "zh": "不愧是本人的一个人格！",
            "narrator_zh": ""
        },
        {
            "location": "236/TALK",
            "narrator": "ガブリエラ",
            "text": "扉をコールすれば\nどんな事でも全部\n判っちゃうの♪",
            "zh": "只要呼叫门扉，\n不管什么事都能\n一清二楚哦♪",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "237/SEL",
            "narrator": "",
            "text": "あ、はい…",
            "zh": "啊，好的……",
            "narrator_zh": ""
        },
        {
            "location": "238/ACT",
            "narrator": "",
            "text": "あ、はい…",
            "zh": "啊，好的……",
            "narrator_zh": ""
        },
        {
            "location": "240/TALK",
            "narrator": "ガブリエラ",
            "text": "それじゃ早速！\n今回も頑張って扉を\nコールしちゃうわね！",
            "zh": "那事不宜迟！\n这次我也要努力把门扉\n呼叫出来咯！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "247/TALK",
            "narrator": "ガブリエラ",
            "text": "オープンプロセス、\n0x578番地から\n0x19D番地へ。",
            "zh": "开放进程，\n从0x578号地址前往\n0x19D号地址。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "262/TALK",
            "narrator": "ガブリエラ",
            "text": "シーク完了っ♪",
            "zh": "搜索完成♪",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "264/TALK",
            "narrator": "ガブリエラ",
            "text": "で…っと、\n何が「そういうことじゃ\nない」のかしらね。",
            "zh": "然后……那个，\n究竟是什么\n“不是那么回事”呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "266/TALK",
            "narrator": "ガブリエラ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "267/TALK",
            "narrator": "ガブリエラ",
            "text": "………。",
            "zh": "………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "268/TALK",
            "narrator": "ガブリエラ",
            "text": "あー、なるほど。",
            "zh": "啊—，原来如此。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "269/TALK",
            "narrator": "ガブリエラ",
            "text": "結構混乱\nしちゃってるわね。",
            "zh": "看来相当\n混乱了呀。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "270/TALK",
            "narrator": "ガブリエラ",
            "text": "$handle$の助けが\n必要みたいよ？",
            "zh": "看来需要$handle$的\n帮助了哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "271/TALK",
            "narrator": "ガブリエラ",
            "text": "ココロファイルナンバー\n03-596-15を見る限り、\nもうあたしは限界っぽい。",
            "zh": "从心灵档案编号\n03-596-15来看，\n我已经快到极限了呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "272/TALK",
            "narrator": "ガブリエラ",
            "text": "つばめと仲良くなりたくて\n仕方ないのに、どうしても\n素直になれない。",
            "zh": "明明想跟燕搞好关系\n想得不得了，却怎么都\n没办法坦率起来。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "273/TALK",
            "narrator": "ガブリエラ",
            "text": "それでも今までは\nクランを産むほどじゃ\nなかったんだけど。",
            "zh": "就算这样，至今为止\n倒也没到生出库兰的\n地步来着。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "274/TALK",
            "narrator": "ガブリエラ",
            "text": "今回はこのままクランを\n放っておくと、つばめとの\n関係に亀裂が入りそうね。",
            "zh": "但这次要是放着库兰\n不管的话，跟燕之间的\n关系怕是要出现裂痕了呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "275/SEL",
            "narrator": "",
            "text": "それってかなり大変じゃない？",
            "zh": "那不是相当严重吗？",
            "narrator_zh": ""
        },
        {
            "location": "276/ACT",
            "narrator": "",
            "text": "それってかなり大変じゃない？",
            "zh": "那不是相当严重吗？",
            "narrator_zh": ""
        },
        {
            "location": "278/TALK",
            "narrator": "ガブリエラ",
            "text": "そうよ！",
            "zh": "就是呀！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "279/TALK",
            "narrator": "ガブリエラ",
            "text": "そんな事になったら、\nあたしここに閉じこもって\nもう出てこないから！",
            "zh": "真变成那样的话，\n我可就要躲在这里面\n再也不出去了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "280/SEL",
            "narrator": "",
            "text": "逆ギレ！？",
            "zh": "反过来发脾气！？",
            "narrator_zh": ""
        },
        {
            "location": "281/ACT",
            "narrator": "",
            "text": "逆ギレ！？",
            "zh": "反过来发脾气！？",
            "narrator_zh": ""
        },
        {
            "location": "284/TALK",
            "narrator": "ガブリエラ",
            "text": "いや、そういうわけじゃ\nないんだけど！",
            "zh": "哎呀，倒也不是\n那个意思啦！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "285/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…、それにしても\nほんとに…あたしってば\n不器用なんだから！",
            "zh": "哈啊……话说回来\n我这个人啊，还真是\n有够笨拙的！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "286/TALK",
            "narrator": "ガブリエラ",
            "text": "だから早く、つばめと\n仲良くなっておけば\n良かったのに。",
            "zh": "所以说啊，早点跟燕\n搞好关系不就\n好了嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "287/TALK",
            "narrator": "ガブリエラ",
            "text": "お願い！　毎度助けて\nもらってるのに、こんな事\n言うのも変だけど！",
            "zh": "拜托了！虽然每次都\n受你照顾，说这种话\n也有点怪不好意思的！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "288/TALK",
            "narrator": "ガブリエラ",
            "text": "今回ばかりは、\nあたしたちのために\n力を貸して！",
            "zh": "唯独这一次，\n为了我们\n借我们力量吧！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "289/SEL",
            "narrator": "",
            "text": "もちろん",
            "zh": "当然",
            "narrator_zh": ""
        },
        {
            "location": "290/ACT",
            "narrator": "",
            "text": "もちろん",
            "zh": "当然",
            "narrator_zh": ""
        },
        {
            "location": "293/TALK",
            "narrator": "ガブリエラ",
            "text": "ありがとう。\n本当にありがとう！",
            "zh": "谢谢你。\n真的谢谢你！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "294/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしのこと\n宜しくお願いね。",
            "zh": "我的事\n就拜托你咯。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "295/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしと\n$handle$にとって\n素敵なココロの旅を！",
            "zh": "祝我与\n$handle$能有一段\n美妙的心灵之旅！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "29/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>5月11日　3:31 PM</color>\nとある平日の放課後、中等部教室にて。",
            "zh": "<color=green>5月11日　3:31 PM</color>\n某个平日的放学后，在初中部教室里。",
            "narrator_zh": "Dialog_EventData"
        },
        {
            "location": "190/DIALOG",
            "narrator": "BattleInit/Dialog_BATTLE_ch03",
            "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n",
            "zh": "<color=black><size=50><b>在加布里埃拉的心中\n开始了战斗。</b></size></color>\n\n\n\n\n\n在她的心中，\n正产生着巨大的纠葛。\n\n请潜入心灵领域\n化解加布里埃拉内心的纠葛吧。\n\n\n\n",
            "narrator_zh": "BattleInit/Dialog_BATTLE_ch03"
        }
    ]
