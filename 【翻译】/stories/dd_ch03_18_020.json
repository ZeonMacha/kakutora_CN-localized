{
    "dir": "chap18/daydra/dd_ch03_18_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "18356",
        "cid": "gabriella",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "言えるかな？",
        "title_zh": "Extra006 额外剧情",
        "sub_title_zh": "能说出口吗？"
    },
    "entry": [
        {
            "location": "187/SCENARIO",
            "narrator": "",
            "text": "言えるかな？",
            "zh": "能说出口吗？",
            "narrator_zh": ""
        },
        {
            "location": "203/TALK",
            "narrator": "ガブリエラ",
            "text": "まほ、映写機の交換用\nパーツって届いてない？",
            "zh": "真幌，放映机的替换\n零件还没送到吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "205/TALK",
            "narrator": "真幌",
            "text": "ああ、それなら劇場の方に\n置いてあるが…。",
            "zh": "哦，那个已经放在\n剧场那边了……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "206/TALK",
            "narrator": "ガブリエラ",
            "text": "ん、ありがと。",
            "zh": "嗯，谢谢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "207/TALK",
            "narrator": "真幌",
            "text": "かなり重そうだから\n一人で運ぶのは…ん？",
            "zh": "看着挺沉的，你一个人\n搬不动……嗯？",
            "narrator_zh": "真幌"
        },
        {
            "location": "209/TALK",
            "narrator": "真幌",
            "text": "…人の話を最後まで\n聞かないヤツだ。",
            "zh": "……真是个话都不听人\n说完的家伙。",
            "narrator_zh": "真幌"
        },
        {
            "location": "227/TALK",
            "narrator": "ガブリエラ",
            "text": "ぐっ、くぬ～～～っ！！",
            "zh": "唔、呜呜～～～！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "235/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ、はぁ…\nな、何よこれ…\nバカみたいに重いわ！",
            "zh": "呼、呼……\n这、这是什么玩意儿啊……\n重得跟傻子似的！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "237/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤかつばめでも呼んで\n手伝ってもらわないと。",
            "zh": "得叫绫水或者燕过来\n搭把手才行了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "241/TALK",
            "narrator": "ヒカル",
            "text": "大丈夫ですか？",
            "zh": "你没事吧？",
            "narrator_zh": "光"
        },
        {
            "location": "244/TALK",
            "narrator": "ガブリエラ",
            "text": "っ！？",
            "zh": "！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "247/TALK",
            "narrator": "キリト",
            "text": "よっ！　なんかスッゲェ\n重たそうだな。",
            "zh": "哟！　看着可真够\n沉的啊。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "249/TALK",
            "narrator": "ヒカル",
            "text": "これって…ああ、映写機の\n交換用パーツですか。",
            "zh": "这个难道是……啊，是放映机的\n替换零件吗？",
            "narrator_zh": "光"
        },
        {
            "location": "251/TALK",
            "narrator": "ヒカル",
            "text": "ガブリエラさんだけで\n運ぶのは無茶ですよ。",
            "zh": "光靠加布里埃拉一个人\n搬这东西太勉强了。",
            "narrator_zh": "光"
        },
        {
            "location": "253/TALK",
            "narrator": "キリト",
            "text": "だな。よっしゃ、ヒカル！\n俺が前持つから、おまえは\n後ろ頼んだぜ！",
            "zh": "就是说啊。好，光！\n我抬前面，后面就\n交给你了！",
            "narrator_zh": "圣翔"
        },
        {
            "location": "256/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "272/TALK",
            "narrator": "ガブリエラ",
            "text": "もぉ、どうしていつもこうなの！？",
            "zh": "真是的，为什么每次都会变成这样啊！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "274/TALK",
            "narrator": "ガブリエラ",
            "text": "これじゃまるで、礼儀知らずの最低女じゃない！",
            "zh": "搞得我活像个不懂礼貌的差劲女人一样！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "275/TALK",
            "narrator": "ガブリエラ",
            "text": "バカバカ、私のバカ！！",
            "zh": "笨蛋笨蛋，我真是个大笨蛋！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "277/SEL",
            "narrator": "",
            "text": "落ち着いて、どうしたの？",
            "zh": "冷静点，怎么了？",
            "narrator_zh": ""
        },
        {
            "location": "278/ACT",
            "narrator": "",
            "text": "落ち着いて、どうしたの？",
            "zh": "冷静点，怎么了？",
            "narrator_zh": ""
        },
        {
            "location": "281/TALK",
            "narrator": "ガブリエラ",
            "text": "凄く重い映写機の交換用パーツなんだけど",
            "zh": "就是那个重得要命的放映机替换零件啊",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "282/TALK",
            "narrator": "ガブリエラ",
            "text": "私の代わりに、キリトとヒカルくんが運んでくれてるの",
            "zh": "圣翔和光代替我把它搬上去了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "283/TALK",
            "narrator": "ガブリエラ",
            "text": "なのに、私、お礼が言えなくて…",
            "zh": "可我却连句道谢都说不出口……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "284/TALK",
            "narrator": "ガブリエラ",
            "text": "凄く嬉しいし、感謝もしてるのよ！？",
            "zh": "我明明特别开心，心里也非常感激的呀！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "285/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、どうしても男の人相手だと声が出なくなっちゃうの",
            "zh": "但只要一面对男生，声音就怎么都发不出来",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "286/TALK",
            "narrator": "ガブリエラ",
            "text": "$marzanna$、私はどうしたら良いの？",
            "zh": "$marzanna$，我该怎么办才好呀？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "288/SEL",
            "narrator": "",
            "text": "頑張って！",
            "zh": "加油！",
            "narrator_zh": ""
        },
        {
            "location": "289/SEL",
            "narrator": "",
            "text": "何も言わなくて良いよ",
            "zh": "什么都不用说也没关系",
            "narrator_zh": ""
        },
        {
            "location": "290/SEL",
            "narrator": "",
            "text": "$marzanna$にお任せあれ",
            "zh": "就交给$marzanna$吧",
            "narrator_zh": ""
        },
        {
            "location": "291/ACT",
            "narrator": "",
            "text": "頑張って！",
            "zh": "加油！",
            "narrator_zh": ""
        },
        {
            "location": "292/TALK",
            "narrator": "ガブリエラ",
            "text": "…やっぱり、お礼を言わないのは失礼よね",
            "zh": "……果然，不道谢的话太失礼了呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "293/TALK",
            "narrator": "ガブリエラ",
            "text": "わかったわ、$marzanna$",
            "zh": "我知道了，$marzanna$",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "294/TALK",
            "narrator": "ガブリエラ",
            "text": "私、頑張ってみる！",
            "zh": "我再努力试试看！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "305/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "308/TALK",
            "narrator": "キリト",
            "text": "ふんぬっ！　くぅ～…\nえ、映写室、どこだった\nっけかぁ？",
            "zh": "嘿咻！　唔～……\n放、放映室是在哪儿\n来着？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "311/TALK",
            "narrator": "ヒカル",
            "text": "に、二階です、二階！\n場所もわからないのに\n前になったんですか！？",
            "zh": "在、在二楼，二楼！\n你连地方在哪儿都不知道\n就抢着走前面啊！？",
            "narrator_zh": "光"
        },
        {
            "location": "312/TALK",
            "narrator": "キリト",
            "text": "今わかったから良いだろ！\nほれ、力入れろぉ！",
            "zh": "现在知道了不就得了！\n喂，使点劲啊！",
            "narrator_zh": "圣翔"
        },
        {
            "location": "313/TALK",
            "narrator": "ガブリエラ",
            "text": "ああ、こんなに頑張って\nくれてるのに！",
            "zh": "啊啊，人家明明都\n这么卖力了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "314/TALK",
            "narrator": "ガブリエラ",
            "text": "どうして出ないのよ！？\nありがとう、の一言くらい\n簡単なはずなのに！！",
            "zh": "为什么就是发不出声啊！？\n明明只是说句“谢谢”\n这么简单的事！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "315/TALK",
            "narrator": "ヒカル",
            "text": "き、キリト！？\n階段上るときは上るって\n一声掛けてください！",
            "zh": "圣、圣翔！？\n上楼梯的时候好歹\n提前喊一声要上楼啊！",
            "narrator_zh": "光"
        },
        {
            "location": "316/TALK",
            "narrator": "キリト",
            "text": "わ、わりぃ…余裕なくて。",
            "zh": "抱、抱歉……没顾上。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "317/TALK",
            "narrator": "キリト",
            "text": "けど、もう一踏ん張りだ！\n行くぜぇ！！",
            "zh": "不过，再咬牙撑一下就到了！\n上啊！！",
            "narrator_zh": "圣翔"
        },
        {
            "location": "318/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "320/TALK",
            "narrator": "ガブリエラ",
            "text": "…やっぱりダメだわ。\n声、全然出てくれない。",
            "zh": "……果然还是不行。\n声音，完全发不出来。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "321/TALK",
            "narrator": "ガブリエラ",
            "text": "あとで手紙でお礼言おう。",
            "zh": "待会儿再写信向他们道谢吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "322/ACT",
            "narrator": "",
            "text": "何も言わなくて良いよ",
            "zh": "什么都不用说也没关系",
            "narrator_zh": ""
        },
        {
            "location": "323/TALK",
            "narrator": "ガブリエラ",
            "text": "…二人も、わかってるよね？",
            "zh": "……那两个人，应该也明白的吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "324/TALK",
            "narrator": "ガブリエラ",
            "text": "私が何も言えなくなっちゃう、ってこと…",
            "zh": "明白我对着他们什么话都说不出来……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "336/TALK",
            "narrator": "ヒカル",
            "text": "キリト、もっとしっかり\n持ってください！\n落ちそうです！",
            "zh": "圣翔，\n麻烦抓稳一点！\n感觉快要掉下去了！",
            "narrator_zh": "光"
        },
        {
            "location": "338/TALK",
            "narrator": "キリト",
            "text": "お、おうっ！\nっしゃぁー！！",
            "zh": "哦、哦！\n看我的——！！",
            "narrator_zh": "圣翔"
        },
        {
            "location": "339/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "360/TALK",
            "narrator": "キリト",
            "text": "ぜーっ、ぜーっ…\nき、キツかったぜ…。",
            "zh": "哈啊、哈啊……\n累、累死我了……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "363/TALK",
            "narrator": "ヒカル",
            "text": "ほ、本当、ですね…。\n男二人でもこんなに\n疲れるなんて――",
            "zh": "是、真的呢……。\n连两个男生抬都这么\n吃力——",
            "narrator_zh": "光"
        },
        {
            "location": "364/TALK",
            "narrator": "ヒカル",
            "text": "ガブリエラさん一人じゃ、\n絶対に無理でしたよ。",
            "zh": "加布里埃拉一个人搬，\n绝对是不可能的。",
            "narrator_zh": "光"
        },
        {
            "location": "365/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "369/TALK",
            "narrator": "キリト",
            "text": "ふぅ…まあ、男手が\n必要なときはいつでも\n呼んでくれよ。",
            "zh": "呼……嘛，以后需要\n男劳力的时候随时\n叫我就行。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "370/TALK",
            "narrator": "キリト",
            "text": "俺とヒカルでどうにか\nなることなら、何でも\nやってやるからさ。",
            "zh": "只要是我和光能摆平\n的事，什么都包在\n我们身上。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "371/TALK",
            "narrator": "ヒカル",
            "text": "じゃあ、僕達は向こうに\n戻りますね。",
            "zh": "那，我们就先回\n那边去了。",
            "narrator_zh": "光"
        },
        {
            "location": "372/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "378/TALK",
            "narrator": "ガブリエラ",
            "text": "…あたし、最低だわ。",
            "zh": "……我真是太差劲了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "380/TALK",
            "narrator": "ガブリエラ",
            "text": "後で手紙を書いて\n謝らないと…。",
            "zh": "待会儿非得写信\n向他们道歉不可……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "381/ACT",
            "narrator": "",
            "text": "$marzanna$にお任せあれ",
            "zh": "就交给$marzanna$吧",
            "narrator_zh": ""
        },
        {
            "location": "383/TALK",
            "narrator": "ガブリエラ",
            "text": "ああ、なんて頼りになるの$marzanna$！",
            "zh": "啊啊，$marzanna$你怎么这么靠得住啊！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "384/TALK",
            "narrator": "ガブリエラ",
            "text": "あなたがいてくれて、私は本当に幸せ者よ",
            "zh": "有你在我身边，我真是太幸福了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "385/TALK",
            "narrator": "ガブリエラ",
            "text": "じゃあ画面を二人に見せるから、お礼のメッセージを表示してね",
            "zh": "那我就把屏幕亮给他们俩看，你把道谢的消息显示出来吧",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "387/SEL",
            "narrator": "",
            "text": "手伝ってくれてありがと",
            "zh": "谢谢你们帮忙",
            "narrator_zh": ""
        },
        {
            "location": "388/SEL",
            "narrator": "",
            "text": "うむ、ご苦労である！",
            "zh": "嗯，辛苦尔等了！",
            "narrator_zh": ""
        },
        {
            "location": "389/SEL",
            "narrator": "",
            "text": "素敵！　かっこいい！！",
            "zh": "好棒！　好帅气！！",
            "narrator_zh": ""
        },
        {
            "location": "390/ACT",
            "narrator": "",
            "text": "手伝ってくれてありがと",
            "zh": "谢谢你们帮忙",
            "narrator_zh": ""
        },
        {
            "location": "414/TALK",
            "narrator": "キリト",
            "text": "ぜーっ、ぜーっ…\nき、キツかったぜ…。",
            "zh": "哈啊、哈啊……\n累、累死我了……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "417/TALK",
            "narrator": "ヒカル",
            "text": "ほ、本当、ですね…。\n男二人でもこんなに\n疲れるなんて――",
            "zh": "是、真的呢……。\n连两个男生抬都这么\n吃力——",
            "narrator_zh": "光"
        },
        {
            "location": "418/TALK",
            "narrator": "ヒカル",
            "text": "ガブリエラさん一人じゃ、\n絶対に無理でしたよ。",
            "zh": "加布里埃拉一个人搬，\n绝对是不可能的。",
            "narrator_zh": "光"
        },
        {
            "location": "420/TALK",
            "narrator": "ガブリエラ",
            "text": "よし、今よ！",
            "zh": "好，就是现在！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "422/TALK",
            "narrator": "ガブリエラ",
            "text": "…………っ！！",
            "zh": "…………！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "426/TALK",
            "narrator": "ヒカル",
            "text": "え？　…キリト。\nガブリエラさんが…。",
            "zh": "咦？　……圣翔。\n加布里埃拉她……。",
            "narrator_zh": "光"
        },
        {
            "location": "430/TALK",
            "narrator": "キリト",
            "text": "…ん？",
            "zh": "……嗯？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "431/TALK",
            "narrator": "キリト",
            "text": "…ははっ、別に良いって。\nこんくらい平気だっての。",
            "zh": "……哈哈，没什么啦。\n这点小事算不上什么。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "433/TALK",
            "narrator": "ヒカル",
            "text": "どういたしまして。\nまた何かあれば、いつでも\n言ってくださいね。",
            "zh": "不用客气。\n以后再有什么事，随时\n叫我们就行。",
            "narrator_zh": "光"
        },
        {
            "location": "434/TALK",
            "narrator": "キリト",
            "text": "遠慮はいらねぇからな。\nそんじゃ、俺達は向こうに\n戻るぜ。",
            "zh": "用不着跟我们客气。\n那我们先回那边\n去了啊。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "441/TALK",
            "narrator": "ガブリエラ",
            "text": "ほっ…よかった。\nちゃんと伝わったみたい。",
            "zh": "呼……太好了。\n心意似乎好好传达到了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "444/TALK",
            "narrator": "ガブリエラ",
            "text": "$marzanna$のおかげね。",
            "zh": "多亏了$marzanna$呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "461/ACT",
            "narrator": "",
            "text": "うむ、ご苦労である！",
            "zh": "嗯，辛苦尔等了！",
            "narrator_zh": ""
        },
        {
            "location": "482/TALK",
            "narrator": "キリト",
            "text": "ぜーっ、ぜーっ…\nき、キツかったぜ…。",
            "zh": "哈啊、哈啊……\n累、累死我了……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "485/TALK",
            "narrator": "ヒカル",
            "text": "ほ、本当、ですね…。\n男二人でもこんなに\n疲れるなんて――",
            "zh": "是、真的呢……。\n连两个男生抬都这么\n吃力——",
            "narrator_zh": "光"
        },
        {
            "location": "486/TALK",
            "narrator": "ヒカル",
            "text": "ガブリエラさん一人じゃ、\n絶対に無理でしたよ。",
            "zh": "加布里埃拉一个人搬，\n绝对是不可能的。",
            "narrator_zh": "光"
        },
        {
            "location": "489/TALK",
            "narrator": "ガブリエラ",
            "text": "よし、今よ！",
            "zh": "好，就是现在！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "493/TALK",
            "narrator": "キリト",
            "text": "…んあ？\n何だこれ？",
            "zh": "……嗯啊？\n这啥玩意儿？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "496/TALK",
            "narrator": "ヒカル",
            "text": "えーっと…これは多分、\nＢｏｔでしょうか？",
            "zh": "呃……这个大概是\nBot之类的吧？",
            "narrator_zh": "光"
        },
        {
            "location": "497/TALK",
            "narrator": "キリト",
            "text": "ガブリエラ、Ｂｏｔが\n変なこと言ってるぞ。",
            "zh": "加布里埃拉，你的Bot\n在说奇怪的话哦。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "499/TALK",
            "narrator": "ガブリエラ",
            "text": "…………っ！？",
            "zh": "…………！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "500/TALK",
            "narrator": "ガブリエラ",
            "text": "ま、$marzanna$！！\nこれはお礼じゃないわ！",
            "zh": "玛、$marzanna$！！\n这哪儿算道谢啊！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "502/TALK",
            "narrator": "キリト",
            "text": "ぷっ…おまえ、いつも\nこんな面白いＢｏｔと\n話してんのかよ。",
            "zh": "噗……你平时就是\n跟这么逗的Bot\n聊天的啊。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "503/TALK",
            "narrator": "ヒカル",
            "text": "一応、僕達に労いの\n言葉をかけてくれている\nみたいですね。",
            "zh": "不过听起来，它倒也算是在\n向我们表示慰劳的\n意思吧。",
            "narrator_zh": "光"
        },
        {
            "location": "504/TALK",
            "narrator": "キリト",
            "text": "だな。まあ、こんくらい\n礼言われるまでもねぇ\nからさ――",
            "zh": "也是。不过这点小事\n本来也用不着专门\n道谢啦——",
            "narrator_zh": "圣翔"
        },
        {
            "location": "505/TALK",
            "narrator": "キリト",
            "text": "何かあったらまた呼びな。\nじゃあな。",
            "zh": "有事再叫我们吧。\n走了啊。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "506/TALK",
            "narrator": "ヒカル",
            "text": "それじゃあ。",
            "zh": "那我们先走了。",
            "narrator_zh": "光"
        },
        {
            "location": "513/TALK",
            "narrator": "ガブリエラ",
            "text": "ほっ…怒ってはいない\nみたいで安心したけど――",
            "zh": "呼……看样子没生气，\n倒是松了口气——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "515/TALK",
            "narrator": "ガブリエラ",
            "text": "$marzanna$ったらもう、\n困った子なんだから！",
            "zh": "我说$marzanna$啊，\n你可真是个让人操心的家伙！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "516/ACT",
            "narrator": "",
            "text": "素敵！　かっこいい！！",
            "zh": "好棒！　好帅气！！",
            "narrator_zh": ""
        },
        {
            "location": "538/TALK",
            "narrator": "キリト",
            "text": "ぜーっ、ぜーっ…\nき、キツかったぜ…。",
            "zh": "哈啊、哈啊……\n累、累死我了……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "541/TALK",
            "narrator": "ヒカル",
            "text": "ほ、本当、ですね…。\n男二人でもこんなに\n疲れるなんて――",
            "zh": "是、真的呢……。\n连两个男生抬都这么\n吃力——",
            "narrator_zh": "光"
        },
        {
            "location": "542/TALK",
            "narrator": "ヒカル",
            "text": "ガブリエラさん一人じゃ、\n絶対に無理でしたよ。",
            "zh": "加布里埃拉一个人搬，\n绝对是不可能的。",
            "narrator_zh": "光"
        },
        {
            "location": "545/TALK",
            "narrator": "ガブリエラ",
            "text": "よし、今よ！",
            "zh": "好，就是现在！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "549/TALK",
            "narrator": "キリト",
            "text": "…ん？",
            "zh": "……嗯？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "551/TALK",
            "narrator": "キリト",
            "text": "…あ～、ガブリエラ？\nこれはちょっとキャラが\n変わり過ぎじゃねぇか？",
            "zh": "……啊～，加布里埃拉？\n这画风未免也变得\n太厉害了吧？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "552/TALK",
            "narrator": "ガブリエラ",
            "text": "え？",
            "zh": "咦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "554/TALK",
            "narrator": "ヒカル",
            "text": "褒めては貰えているみたい\nですけど…。",
            "zh": "不过听起来，倒像是在\n夸我们就是了……。",
            "narrator_zh": "光"
        },
        {
            "location": "556/TALK",
            "narrator": "ガブリエラ",
            "text": "な、なに？\n何が表示されて…。",
            "zh": "什、什么？\n上面到底显示了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "558/TALK",
            "narrator": "ガブリエラ",
            "text": "っ！？",
            "zh": "！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "560/TALK",
            "narrator": "ガブリエラ",
            "text": "なっ、何よこれー！？",
            "zh": "这、这什么鬼东西啊！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "562/TALK",
            "narrator": "キリト",
            "text": "はははっ、ガブリエラが\nそんなに驚いたとこ、\n初めて見たぜ。",
            "zh": "哈哈哈，我还是头一回\n见加布里埃拉吓成\n这样子呢。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "563/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "566/TALK",
            "narrator": "ヒカル",
            "text": "キリト！",
            "zh": "圣翔！",
            "narrator_zh": "光"
        },
        {
            "location": "567/TALK",
            "narrator": "キリト",
            "text": "っと、ごめんな。\nつい…。",
            "zh": "哎呀，抱歉。\n一不小心……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "570/TALK",
            "narrator": "ヒカル",
            "text": "それじゃあ、僕達は\n戻りますね。",
            "zh": "那我们就先\n回去了。",
            "narrator_zh": "光"
        },
        {
            "location": "571/TALK",
            "narrator": "キリト",
            "text": "力仕事が必要なときは、\n素敵な俺達が手伝って\nやるからなー！",
            "zh": "需要出力气活的时候，\n就交给帅气迷人的我们来\n帮你们搭把手吧—！",
            "narrator_zh": "圣翔"
        },
        {
            "location": "579/TALK",
            "narrator": "ガブリエラ",
            "text": "くっ…ぐぬぬぬ…！",
            "zh": "唔……唔唔唔……！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "581/TALK",
            "narrator": "ガブリエラ",
            "text": "もぉ、$marzanna$の\nバカバカバカーッ！！",
            "zh": "真是的，$marzanna$你这个\n大笨蛋大笨蛋大笨蛋——！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "195/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>7月17日　1:23 PM</color>\nとある休日の午後、神楽坂トライナリー劇場でのバイト中のこと。",
            "zh": "<color=green>7月17日　1:23 PM</color>\n某个假日的午后，在神乐坂三重奏剧场打工时发生的事。",
            "narrator_zh": "Dialog_EventData"
        },
        {
            "location": "455/DIALOG",
            "narrator": "Dialog_GEThimegoto_ch03",
            "text": "【口にする日を】",
            "zh": "【说出口的那天】",
            "narrator_zh": "Dialog_GEThimegoto_ch03"
        }
    ]
