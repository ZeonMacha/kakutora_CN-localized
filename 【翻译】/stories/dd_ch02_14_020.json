    "entry": [
        {
            "location": "317/SCENARIO",
            "narrator": "",
            "text": "アーヤＭＶ回２",
            "zh": "绫水MV回2",
            "narrator_zh": ""
        },
        {
            "location": "332/TALK",
            "narrator": "真幌",
            "text": "もうこんな時間か…。\nすまんな、遅くまで\n付き合わせて。",
            "zh": "已经这么晚了啊……。\n抱歉啊，让你陪我\n忙到这么晚。",
            "narrator_zh": "真幌"
        },
        {
            "location": "334/TALK",
            "narrator": "アーヤ",
            "text": "いえ、報告書の作成も\n職務の内ですから。",
            "zh": "不，撰写报告书也是\n职责所在嘛。",
            "narrator_zh": "绫水"
        },
        {
            "location": "335/TALK",
            "narrator": "真幌",
            "text": "そうなんだが…。\nこの時間に一人で\n帰らせるのは――",
            "zh": "话是这么说……。\n这个点让你一个人\n回去——",
            "narrator_zh": "真幌"
        },
        {
            "location": "336/TALK",
            "narrator": "真幌",
            "text": "ちと物騒な気も\nするからな…。\n劇場に泊まってくか？",
            "zh": "总觉得有点不太\n安全啊……。\n要不就在剧场住一晚？",
            "narrator_zh": "真幌"
        },
        {
            "location": "337/TALK",
            "narrator": "アーヤ",
            "text": "今日はバイクで\n来てるから\n大丈夫ですよ。",
            "zh": "我今天是骑摩托车\n过来的，\n没关系的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "339/TALK",
            "narrator": "アーヤ",
            "text": "では、館長。\n私はこれで。",
            "zh": "那么，馆长。\n我先走了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "341/TALK",
            "narrator": "真幌",
            "text": "ん、お疲れさん。\nおやすみ。",
            "zh": "嗯，辛苦了。\n晚安。",
            "narrator_zh": "真幌"
        },
        {
            "location": "342/TALK",
            "narrator": "アーヤ",
            "text": "おやすみなさい。",
            "zh": "晚安。",
            "narrator_zh": "绫水"
        },
        {
            "location": "352/TALK",
            "narrator": "アーヤ",
            "text": "ふぅ…疲れた…。",
            "zh": "呼……好累……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "353/SEL",
            "narrator": "",
            "text": "お疲れさま",
            "zh": "辛苦啦",
            "narrator_zh": ""
        },
        {
            "location": "354/TALK",
            "narrator": "アーヤ",
            "text": "日付が変わる前には\n終わったけど、\nもうこんな時間か…。",
            "zh": "虽然在零点之前\n总算弄完了，\n但已经这么晚了啊……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "355/TALK",
            "narrator": "アーヤ",
            "text": "今から帰っても、\n夕飯の準備する気に\nなれないし――",
            "zh": "现在回去，\n也没力气再做晚饭\n了——",
            "narrator_zh": "绫水"
        },
        {
            "location": "356/TALK",
            "narrator": "アーヤ",
            "text": "今夜はコンビニで\nすませるしかない\nわね…。",
            "zh": "今晚只能去便利店\n凑合一下\n了呢……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "358/TALK",
            "narrator": "アーヤ",
            "text": "…ご飯食べて、\nシャワー浴びたら――",
            "zh": "……吃完饭，\n再洗个澡——",
            "narrator_zh": "绫水"
        },
        {
            "location": "359/TALK",
            "narrator": "アーヤ",
            "text": "今日はさっさと\n寝ちゃおう…。",
            "zh": "今天就早点\n睡觉吧……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "361/ACT",
            "narrator": "",
            "text": "お疲れさま",
            "zh": "辛苦啦",
            "narrator_zh": ""
