            "text": "おはよ…。\nねえ、アーヤから\n連絡あった？",
            "zh": "早啊……。\n我说，绫水有跟你\n联系吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "770/TALK",
            "narrator": "つばめ",
            "text": "え？　無いけど…、\nどうして？",
            "zh": "咦？　没有啊……，\n怎么了？",
            "narrator_zh": "燕"
        },
        {
            "location": "771/TALK",
            "narrator": "ガブリエラ",
            "text": "昨日、劇場から\n帰ってきてない\nみたいなのよ。",
            "zh": "她昨天从剧场离开后，\n好像一直没回来\n呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "773/TALK",
            "narrator": "ガブリエラ",
            "text": "ほら、バイクも\nないでしょ？",
            "zh": "你看，摩托车也\n不在吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "775/TALK",
            "narrator": "つばめ",
            "text": "本当だ…。\n昨日は誰も宿直じゃ\nなかったはずだし…。",
            "zh": "真的耶……。\n昨天应该没人值夜班\n才对啊……。",
            "narrator_zh": "燕"
        },
        {
            "location": "777/TALK",
            "narrator": "ガブリエラ",
            "text": "どこ行ったのかしら？\nまったく…。",
            "zh": "到底是跑哪儿去了啊？\n真是的……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "781/TALK",
            "narrator": "ガブリエラ",
            "text": "この音は…。",
            "zh": "这声音是……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "786/TALK",
            "narrator": "アーヤ",
            "text": "ふぅ…。",
            "zh": "呼……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "790/TALK",
            "narrator": "つばめ",
            "text": "アーヤさん！",
            "zh": "绫水！",
            "narrator_zh": "燕"
        },
        {
            "location": "793/TALK",
            "narrator": "アーヤ",
            "text": "あら、二人とも\nおはよう。\n今から学校？",
            "zh": "哎呀，你们俩\n早啊。\n现在去上学？",
            "narrator_zh": "绫水"
        },
        {
            "location": "794/TALK",
            "narrator": "つばめ",
            "text": "あ、はい…。\nアーヤさんは？",
            "zh": "啊、是的……。\n绫水你呢？",
            "narrator_zh": "燕"
        },
        {
            "location": "795/TALK",
            "narrator": "アーヤ",
            "text": "見てのとおり、\n今帰ったところよ。",
            "zh": "如你们所见，\n刚回来哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "797/TALK",
            "narrator": "ガブリエラ",
            "text": "一晩中どこ行ってた\nのよ？",
            "zh": "你一整晚都去哪儿了\n啊？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "799/TALK",
            "narrator": "アーヤ",
            "text": "どこって…あちこち\n走ってたから、\n話せば長くなるわ。",
            "zh": "去哪儿……到处\n跑了跑，\n说来话长呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "801/TALK",
            "narrator": "つばめ",
            "text": "一晩中！？",
            "zh": "一整晚！？",
            "narrator_zh": "燕"
        },
        {
            "location": "803/TALK",
            "narrator": "アーヤ",
            "text": "ええ。やっぱり、\n夜のツーリングは\n楽しいわ。",
            "zh": "嗯。果然，\n夜间兜风\n很有意思哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "806/TALK",
            "narrator": "ガブリエラ",
            "text": "…まあ、そんなこと\nだろうとは思った\nけど。",
            "zh": "……算了，我也猜到\n大概就是这么回事\n了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "807/TALK",
            "narrator": "ガブリエラ",
            "text": "そんなんで、\n大学の講義\nちゃんと聞けるの？",
            "zh": "这样通宵，\n大学的课你还能\n好好听进去吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "808/TALK",
            "narrator": "アーヤ",
            "text": "平気よ。\n今日は午後から\nだから――",
            "zh": "没关系。\n今天下午才有课\n所以——",
            "narrator_zh": "绫水"
        },
        {
            "location": "809/TALK",
            "narrator": "アーヤ",
            "text": "とりあえずシャワー\n浴びて、時間までは\n仮眠もとるし。",
            "zh": "总之先洗个澡，\n到点前还能\n补个觉。",
            "narrator_zh": "绫水"
        },
        {
            "location": "811/TALK",
            "narrator": "アーヤ",
            "text": "そういうわけだから、\nまた夕方に劇場でね。",
            "zh": "就是这样，\n傍晚剧场见啦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "815/TALK",
            "narrator": "ガブリエラ",
            "text": "…一晩中走ってた\nようには見えなかった\nわね…。",
            "zh": "……完全看不出来\n像骑了一整晚车的样子\n呢……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "816/TALK",
            "narrator": "つばめ",
            "text": "うん…アーヤさん、\nほんとパワフル\nだなぁ…。",
            "zh": "嗯……绫水，\n精力真是\n充沛啊……。",
            "narrator_zh": "燕"
        },
        {
            "location": "818/TALK",
            "narrator": "ガブリエラ",
            "text": "体育系だし、無駄に\n体力有り余ってる\nだけよ。",
            "zh": "毕竟是体育系的，\n纯粹是体力过剩\n罢了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "819/TALK",
            "narrator": "ガブリエラ",
            "text": "それより、急がないと\n遅刻するわよ。",
            "zh": "比起这个，再不快点\n就要迟到了哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "822/TALK",
            "narrator": "つばめ",
            "text": "あ、ガブちゃん\n待ってー！",
            "zh": "啊、加布\n等等我——！",
            "narrator_zh": "燕"
        },
        {
            "location": "823/ACT",
            "narrator": "",
            "text": "残念…",
            "zh": "好可惜……",
            "narrator_zh": ""
        },
        {
            "location": "824/TALK",
            "narrator": "アーヤ",
            "text": "出かけるのは",
            "zh": "出门的事",
            "narrator_zh": "绫水"
        },
        {
            "location": "825/TALK",
            "narrator": "アーヤ",
            "text": "また今度ね(￣∇￣)",
            "zh": "等下次吧(￣∇￣)",
            "narrator_zh": "绫水"
        },
        {
            "location": "836/TALK",
            "narrator": "アーヤ",
            "text": "…コンビニ、\nいいお弁当残ってると\nいいな…。",
            "zh": "……希望便利店里，\n还能剩下好吃的\n便当啊……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "845/ACT",
            "narrator": "",
            "text": "計画立ててからがいいかな？",
            "zh": "还是先定好计划再去比较好吗？",
            "narrator_zh": ""
        },
        {
            "location": "846/TALK",
            "narrator": "アーヤ",
            "text": "そうね(｡-_-｡)",
            "zh": "也是呢(｡-_-｡)",
            "narrator_zh": "绫水"
        },
        {
            "location": "847/TALK",
            "narrator": "アーヤ",
            "text": "せっかく出かけるなら",
            "zh": "既然要出门",
            "narrator_zh": "绫水"
        },
        {
            "location": "848/TALK",
            "narrator": "アーヤ",
            "text": "そっちの方がいいし(￣Д￣ )",
            "zh": "还是那样比较好(￣Д￣ )",
            "narrator_zh": "绫水"
        },
        {
            "location": "849/TALK",
            "narrator": "アーヤ",
            "text": "だから",
            "zh": "所以",
            "narrator_zh": "绫水"
        },
        {
            "location": "850/TALK",
            "narrator": "アーヤ",
            "text": "出かけるのは",
            "zh": "出门的事",
            "narrator_zh": "绫水"
        },
        {
            "location": "851/TALK",
            "narrator": "アーヤ",
            "text": "また今度ね(￣∇￣)",
            "zh": "等下次吧(￣∇￣)",
            "narrator_zh": "绫水"
        },
        {
            "location": "862/TALK",
            "narrator": "アーヤ",
            "text": "…コンビニ、\nいいお弁当残ってると\nいいな…。",
            "zh": "……希望便利店里，\n还能剩下好吃的\n便当啊……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "325/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>6月30日　9:43 PM</color>\nとある平日、バイト終了後の神楽坂トライナリーにて。",
            "zh": "<color=green>6月30日　9:43 PM</color>\n某个工作日，打工结束后的神乐坂三重奏。",
            "narrator_zh": "Dialog_EventData"
        }
    ]
}
