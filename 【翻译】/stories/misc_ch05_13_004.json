            "narrator_zh": ""
        },
        {
            "location": "4069/SEL",
            "narrator": "",
            "text": "なんで$me$の役職知ってるの",
            "zh": "为什么知道$me$的职位",
            "narrator_zh": ""
        },
        {
            "location": "4070/ACT",
            "narrator": "",
            "text": "普通に無理だろ…",
            "zh": "普通来说不可能吧……",
            "narrator_zh": ""
        },
        {
            "location": "4071/TALK",
            "narrator": "神楽",
            "text": "そこをなんとか",
            "zh": "那里想想办法",
            "narrator_zh": "神乐"
        },
        {
