            "narrator_zh": "神乐"
        },
        {
            "location": "4067/SEL",
            "narrator": "",
            "text": "普通に無理だろ…",
            "zh": "普通来说不可能吧……",
            "narrator_zh": ""
        },
        {
            "location": "4068/SEL",
            "narrator": "",
            "text": "それは二次元にしか存在しない系",
