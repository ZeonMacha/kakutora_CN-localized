{
    "dir": "chap16/daydra/dd_ch03_16_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "16305",
        "cid": "gabriella",
        "title": "005 メインストーリー",
        "sub_title": "プライベートタイム＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "私人时间＜后篇＞"
    },
    "entry": [
        {
            "location": "311/TALK",
            "narrator": "ガブリエラ",
            "text": "…でも、カプドラって\n共通の話題が\nあるし。",
            "zh": "……不过，卡普多拉好歹\n算是有个共同\n话题嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "312/TALK",
            "narrator": "ガブリエラ",
            "text": "話に困るようなことは\nないのよね？",
            "zh": "总不至于没话可聊\n冷场对吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "313/TALK",
            "narrator": "ガブリエラ",
            "text": "第一、悪い人たちじゃ\nないのは間違いないん\nだし。",
            "zh": "再说了，她们俩肯定\n也不是什么坏人\n嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "314/TALK",
            "narrator": "ガブリエラ",
            "text": "あたし、ちょっと\n警戒し過ぎだった\nかも…。",
            "zh": "我刚才，是不是有点\n戒备过头了\n呢……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "318/TALK",
            "narrator": "ガブリエラ",
            "text": "…わかったわ。\n戦力は多いに越した\nことないものね。",
            "zh": "……我知道了。\n毕竟战力当然是越多\n越好嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "319/TALK",
            "narrator": "雛",
            "text": "やった！\nじゃあ決まりだね。",
            "zh": "太好啦！\n那就这么定了呢。",
            "narrator_zh": "雏"
        },
        {
            "location": "320/TALK",
            "narrator": "雛",
            "text": "お店混んじゃう前に、\n急ご！",
            "zh": "趁着店里还没挤满人，\n快走吧！",
            "narrator_zh": "雏"
        },
        {
            "location": "341/TALK",
            "narrator": "ガブリエラ",
            "text": "あっ、ヤバい！\nクリティカル\nもらっちゃった！",
            "zh": "啊，糟了！\n吃到一记\n暴击了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "342/TALK",
            "narrator": "繭",
            "text": "即回復。",
            "zh": "秒恢复。",
            "narrator_zh": "茧"
        },
        {
            "location": "344/TALK",
            "narrator": "ガブリエラ",
            "text": "早ッ！？",
            "zh": "好快！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "347/TALK",
            "narrator": "雛",
            "text": "まゆちんはサポート\n極めてるからねー。",
            "zh": "因为小茧把辅助位\n练到极致了嘛—。",
            "narrator_zh": "雏"
        },
        {
            "location": "349/TALK",
            "narrator": "繭",
            "text": "状況を一歩離れた\nところから見れるのが\n気に入ってる。",
            "zh": "我很喜欢这种能退后一步\n旁观全局的\n感觉。",
            "narrator_zh": "茧"
        },
        {
            "location": "351/TALK",
            "narrator": "繭",
            "text": "…そろそろトドメ。\nガブリエラ、\nスキル発動。",
            "zh": "……差不多该收尾了。\n加布里埃拉，\n发动技能。",
            "narrator_zh": "茧"
        },
        {
            "location": "353/TALK",
            "narrator": "ガブリエラ",
            "text": "おっけー。\n発動！",
            "zh": "OK。\n发动！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "355/TALK",
            "narrator": "雛",
            "text": "やった、倒したよ！\nこれでステージ６\nクリアー！",
            "zh": "太棒了，打倒啦！\n这样关卡6\n就通关了—！",
            "narrator_zh": "雏"
        },
        {
            "location": "356/TALK",
            "narrator": "繭",
            "text": "今日はここまで。",
            "zh": "今天就先到这儿。",
            "narrator_zh": "茧"
        },
        {
            "location": "357/TALK",
            "narrator": "繭",
            "text": "７からはレベルが\n一気に上がるから\n準備しないと。",
            "zh": "从7开始难度等级会\n一口气飙升，\n必须先做准备才行。",
            "narrator_zh": "茧"
        },
        {
            "location": "358/TALK",
            "narrator": "繭",
            "text": "レベル上げ\nしとかしないと\n瞬殺確実だよ。",
            "zh": "要是不提前\n练级的话，\n肯定会被瞬秒的哦。",
            "narrator_zh": "茧"
        },
        {
            "location": "359/TALK",
            "narrator": "雛",
            "text": "そっかぁ…攻略までの\n道のりは遠いなぁ…。",
            "zh": "这样啊……距离通关\n还路漫漫呢……。",
            "narrator_zh": "雏"
        },
        {
            "location": "362/TALK",
            "narrator": "ガブリエラ",
            "text": "っていうか、繭は\nどこでそんな情報\n手に入れてくるのよ？",
            "zh": "话说回来，茧你都是\n从哪儿弄来这些\n情报的啊？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "363/TALK",
            "narrator": "繭",
            "text": "…普通にウェブ検索で\n出てくる程度の情報\nだから…。",
            "zh": "……只是普通地在网上搜一下\n就能查到的程度\n而已……。",
            "narrator_zh": "茧"
        },
        {
            "location": "364/TALK",
            "narrator": "繭",
            "text": "あっ。",
            "zh": "啊。",
            "narrator_zh": "茧"
        },
        {
            "location": "367/TALK",
            "narrator": "雛",
            "text": "なになに？",
            "zh": "怎么了怎么了？",
            "narrator_zh": "雏"
        },
        {
            "location": "368/TALK",
            "narrator": "繭",
            "text": "今日のギガスマート\nエキスポ、終わった\nみたい。",
            "zh": "今天的GigaSmart\n博览会，好像\n结束了。",
            "narrator_zh": "茧"
        },
        {
            "location": "370/TALK",
            "narrator": "ガブリエラ",
            "text": "それって、\n確か国際展示場で\nやってるやつよね。",
            "zh": "那个的话，\n记得是在国际展示场\n办的活动对吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "371/TALK",
            "narrator": "ガブリエラ",
            "text": "ゲームのイベント\nだったかしら？",
            "zh": "好像是游戏的\n展会来着？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "374/TALK",
            "narrator": "雛",
            "text": "そうそう、ギガスマ。\n一度行ってみたいん\nだよねー。",
            "zh": "对对，GigaSma。\n我一直想找机会\n去一次呢—。",
            "narrator_zh": "雏"
        },
        {
            "location": "378/TALK",
            "narrator": "繭",
            "text": "明日行けば？",
            "zh": "明天去不就得了？",
            "narrator_zh": "茧"
        },
        {
            "location": "381/TALK",
            "narrator": "雛",
            "text": "まゆちんも一緒に\n来てくれるなら！",
            "zh": "要是小茧也愿意\n跟我一起去的话！",
            "narrator_zh": "雏"
        },
        {
            "location": "383/TALK",
            "narrator": "繭",
            "text": "断る、面倒くさい。",
            "zh": "拒绝，太麻烦了。",
            "narrator_zh": "茧"
        },
        {
            "location": "385/TALK",
            "narrator": "ガブリエラ",
            "text": "あっ、\nもしかして！",
            "zh": "啊，\n难道说！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "386/TALK",
            "narrator": "ガブリエラ",
            "text": "今回のカプドラの\nイベントって\nギガスマに合わせて？",
            "zh": "这次卡普多拉的\n活动，就是配合\nGigaSma开的吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "388/TALK",
            "narrator": "繭",
            "text": "そう…。だからこの\nイベントは三日限定の\n超短期間。",
            "zh": "没错……。所以这次\n活动是仅限三天的\n超短周期。",
            "narrator_zh": "茧"
        },
        {
            "location": "389/TALK",
            "narrator": "繭",
            "text": "それに、期間限定の\nレアドロップキャラも\nいるみたい。",
            "zh": "而且，好像还有\n期间限定的\n稀有掉落角色。",
            "narrator_zh": "茧"
        },
        {
            "location": "390/TALK",
            "narrator": "ガブリエラ",
            "text": "ふーん…まあ、確率が\n超低くて取れないとは\n思うけど。",
            "zh": "哦—……不过，估计掉率\n低得离谱，根本\n刷不出来吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "393/TALK",
            "narrator": "雛",
            "text": "あはは、それを\n言っちゃおしまい\nだよー。",
            "zh": "啊哈哈，话都这么说了\n那可就没法玩\n下去啦—。",
            "narrator_zh": "雏"
        },
        {
            "location": "394/TALK",
            "narrator": "繭",
            "text": "あとそのキャラ、\n意外と可愛くない。",
            "zh": "而且那个角色，\n意外地并不可爱。",
            "narrator_zh": "茧"
        },
        {
            "location": "395/TALK",
            "narrator": "繭",
            "text": "だから、無理してまで\n取る必要ないと思う。",
            "zh": "所以，我觉得没必要\n勉强去刷。",
            "narrator_zh": "茧"
        },
        {
            "location": "396/TALK",
            "narrator": "繭",
            "text": "能力値も微妙だし。",
            "zh": "数值也挺微妙的。",
            "narrator_zh": "茧"
        },
        {
            "location": "397/TALK",
            "narrator": "ガブリエラ",
            "text": "なにそれ？\nだったらやる必要\nないじゃない。",
            "zh": "什么啊？\n那不就完全没必要\n去刷了嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "398/TALK",
            "narrator": "雛",
            "text": "いや、でもレアに\n違いはないし。",
            "zh": "哎，不过好歹是稀有\n角色嘛。",
            "narrator_zh": "雏"
        },
        {
            "location": "399/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしは、かわいい\nキャラだけを選んで\n使うようにしてるの。",
            "zh": "我一向只挑可爱的\n角色来\n用哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "400/TALK",
            "narrator": "ガブリエラ",
            "text": "かわいくないなら\nたとえレアだと\nしても興味ないわ。",
            "zh": "不可爱的话，\n就算再怎么稀有\n我也没兴趣。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "401/TALK",
            "narrator": "雛",
            "text": "こだわりが\nあるんだねぇ。",
            "zh": "还真有自己的\n原则呢。",
            "narrator_zh": "雏"
        },
        {
            "location": "402/TALK",
            "narrator": "ガブリエラ",
            "text": "まあね。",
            "zh": "算是吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "404/TALK",
            "narrator": "ガブリエラ",
            "text": "あとは、\nイベント戦なんかより\nマッチングバトル。",
            "zh": "还有就是，\n比起活动本什么的，\n还是匹配对战。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "405/TALK",
            "narrator": "ガブリエラ",
            "text": "こっちの方が\nカプドラは\n面白いと思うのよ。",
            "zh": "我觉得卡普多拉\n还是这个模式\n更有意思呀。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "406/TALK",
            "narrator": "雛",
            "text": "えー、そうかなー？",
            "zh": "哎—，是这样吗—？",
            "narrator_zh": "雏"
        },
        {
            "location": "407/TALK",
            "narrator": "雛",
            "text": "あたし、全然勝てない\nからほとんどやって\nないよ…。",
            "zh": "我完全赢不了，\n所以几乎没怎么\n打过呀……。",
            "narrator_zh": "雏"
        },
        {
            "location": "408/TALK",
            "narrator": "ガブリエラ",
            "text": "ガチ勢が多いのよね。\nあたしもほとんど\n勝てないし。",
            "zh": "毕竟肝帝大佬很多嘛。\n其实我也基本\n赢不了几把。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "414/TALK",
            "narrator": "ガブリエラ",
            "text": "だけど、今の戦いで\nちょっと安定して\nきた感じよね。",
            "zh": "不过，刚才那几仗打下来，\n感觉稍微摸到点\n门道了呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "415/TALK",
            "narrator": "ガブリエラ",
            "text": "マッチングバトル、\n一回だけやってみよう\nかしら？",
            "zh": "匹配对战，\n要不要试着打\n一把看看呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "419/TALK",
            "narrator": "雛",
            "text": "おっ、頑張れ\nガブリエラちゃーん！",
            "zh": "哦，加油啊\n加布里埃拉—！",
            "narrator_zh": "雏"
        },
        {
            "location": "423/TALK",
            "narrator": "繭",
            "text": "…マッチング、\n攻略法…情報は…。",
            "zh": "……匹配，\n攻略法……情报是……。",
            "narrator_zh": "茧"
        },
        {
            "location": "425/TALK",
            "narrator": "繭",
            "text": "っ！！　ダメ！！\nマッチングは\nやらないで！",
            "zh": "唔！！　不行！！\n千万别打\n匹配对战！",
            "narrator_zh": "茧"
        },
        {
            "location": "427/TALK",
            "narrator": "ガブリエラ",
            "text": "えっ！？\nな、なんでよ？",
            "zh": "哎！？\n为、为什么呀？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "428/TALK",
            "narrator": "繭",
            "text": "いいから、早く！\nキャンセルして！",
            "zh": "别管那么多，快点！\n赶紧取消！",
            "narrator_zh": "茧"
        },
        {
            "location": "433/TALK",
            "narrator": "ガブリエラ",
            "text": "う、うん…。\nしたけど…。",
            "zh": "嗯、嗯……。\n我是取消了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "436/TALK",
            "narrator": "雛",
            "text": "繭ちん、どうしたの？",
            "zh": "小茧，怎么了吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "438/TALK",
            "narrator": "繭",
            "text": "…バグがあるらしい。",
            "zh": "……好像有个BUG。",
            "narrator_zh": "茧"
        },
        {
            "location": "439/TALK",
            "narrator": "雛",
            "text": "へえ、カプドラに\nバグなんて珍しいね。\nどんなバグなの",
            "zh": "咦，卡普多拉居然也会\n出BUG，真罕见呢。\n是什么样的BUG呀",
            "narrator_zh": "雏"
        },
        {
            "location": "441/TALK",
            "narrator": "繭",
            "text": "…かなりヤバめ。",
            "zh": "……相当要命。",
            "narrator_zh": "茧"
        },
        {
            "location": "442/TALK",
            "narrator": "繭",
            "text": "マッチング中に、\nある操作を行うと――",
            "zh": "在匹配过程中，\n只要进行某个操作——",
            "narrator_zh": "茧"
        },
        {
            "location": "443/TALK",
            "narrator": "繭",
            "text": "勝敗無関係に、\n戦利品を自分の物に\nできるみたい。",
            "zh": "似乎就能无视胜负，\n把战利品全都据为\n己有。",
            "narrator_zh": "茧"
        },
        {
            "location": "446/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ！？　それって、\nメチャクチャヤバい\nじゃない！",
            "zh": "哈啊！？　那岂不是\n超级恶劣的\n问题吗！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "448/TALK",
            "narrator": "繭",
            "text": "大炎上で運営土下座\nレベルのとんでもない\nバグ。",
            "zh": "足以闹到全网炎上、\n逼得运营下跪谢罪程度的\n离谱BUG。",
            "narrator_zh": "茧"
        },
        {
            "location": "451/TALK",
            "narrator": "雛",
            "text": "うわぁ、それマジで\nヤバ過ぎるよぉ。",
            "zh": "呜哇，那真的\n太要命了呀。",
            "narrator_zh": "雏"
        },
        {
            "location": "452/TALK",
            "narrator": "雛",
            "text": "マッチングの戦利品\nだって、超レア物も\n入るんだしさ。",
            "zh": "毕竟匹配对战的战利品里，\n连超稀有道具\n都会出的嘛。",
            "narrator_zh": "雏"
        },
        {
            "location": "453/TALK",
            "narrator": "雛",
            "text": "それを無条件に\n取られたら、泣いても\n泣ききれないね…。",
            "zh": "要是就这么无条件被抢走，\n真是哭都\n哭不出来呢……。",
            "narrator_zh": "雏"
        },
        {
            "location": "457/TALK",
            "narrator": "繭",
            "text": "だから、マッチングは\nやらない方がいい。",
            "zh": "所以，匹配对战\n还是别打为妙。",
            "narrator_zh": "茧"
        },
        {
            "location": "458/TALK",
            "narrator": "繭",
            "text": "公式がこのバグに\n気づいて、パッチを\n充てるまでは。",
            "zh": "至少在官方发现这个BUG、\n打上补丁\n之前别去碰。",
            "narrator_zh": "茧"
        },
        {
            "location": "459/TALK",
            "narrator": "ガブリエラ",
            "text": "え！？　\n公式、このバグに\n気づいてないの！？",
            "zh": "哎！？　\n官方到现在还没发现\n这个BUG吗！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "460/TALK",
            "narrator": "繭",
            "text": "気づいてない。",
            "zh": "没发现。",
            "narrator_zh": "茧"
        },
        {
            "location": "461/TALK",
            "narrator": "繭",
            "text": "気づいているのは、\n超ディープな一部の\nプレイヤーだけ。",
            "zh": "发现的只有\n极其硬核的一小撮\n玩家而已。",
            "narrator_zh": "茧"
        },
        {
            "location": "462/TALK",
            "narrator": "繭",
            "text": "多分、世界で数十人\nいるかいないかだと\n思う。",
            "zh": "大概全世界也就几十个人\n知道吧，甚至可能\n还不到。",
            "narrator_zh": "茧"
        },
        {
            "location": "465/TALK",
            "narrator": "ガブリエラ",
            "text": "だから、何でそんな\n情報を知ってるのよ？",
            "zh": "所以说，你干嘛连这种\n情报都知道啊？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "466/TALK",
            "narrator": "繭",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "茧"
        },
        {
            "location": "467/TALK",
            "narrator": "繭",
            "text": "まあ…知る手段は\nいくらでもあるから。",
            "zh": "嘛……想知道的门路\n多得是嘛。",
            "narrator_zh": "茧"
        },
        {
            "location": "468/TALK",
            "narrator": "ガブリエラ",
            "text": "どんな手段よ？",
            "zh": "什么门路啊？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "470/TALK",
            "narrator": "繭",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "茧"
        },
        {
            "location": "474/TALK",
            "narrator": "ガブリエラ",
            "text": "わかったわ。\nもう聞かないわよ。",
            "zh": "行了行了。\n我不问了就是。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "478/TALK",
            "narrator": "雛",
            "text": "でもさー…。",
            "zh": "可是呀—……。",
            "narrator_zh": "雏"
        },
        {
            "location": "479/TALK",
            "narrator": "雛",
            "text": "そんなバグがあるのに\n放っておいたら\n大変なことにならない？",
            "zh": "明明有这么个BUG，\n就这么放着不管的话\n不会出大事吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "480/TALK",
            "narrator": "ガブリエラ",
            "text": "そうよね。",
            "zh": "就是说啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "481/TALK",
            "narrator": "ガブリエラ",
            "text": "これが知れ渡ったり\nしたら、大炎上する\nことになるわね。",
            "zh": "这事要是在网上\n传开了，肯定会\n闹得沸沸扬扬吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "483/TALK",
            "narrator": "繭",
            "text": "それもアプリゲーの\n楽しみの一つ。",
            "zh": "那也是手游的\n乐趣之一。",
            "narrator_zh": "茧"
        },
        {
            "location": "485/TALK",
            "narrator": "雛",
            "text": "まゆちん悪趣味ー。",
            "zh": "小茧好恶趣味—。",
            "narrator_zh": "雏"
        },
        {
            "location": "486/SEL",
            "narrator": "",
            "text": "今のうちにそのバグ使おう！",
            "zh": "趁现在赶紧用这个BUG吧！",
            "narrator_zh": ""
        },
        {
            "location": "487/SEL",
            "narrator": "",
            "text": "被害者が出てるかも",
            "zh": "说不定已经出现受害者了",
            "narrator_zh": ""
        },
        {
            "location": "488/SEL",
            "narrator": "",
            "text": "運営に報告すれば？",
            "zh": "向运营举报不就好了？",
            "narrator_zh": ""
        },
        {
            "location": "489/ACT",
            "narrator": "",
            "text": "今のうちにそのバグ使おう！",
            "zh": "趁现在赶紧用这个BUG吧！",
            "narrator_zh": ""
        },
        {
            "location": "505/TALK",
            "narrator": "ガブリエラ",
            "text": "使うわけないでしょう？",
            "zh": "我怎么可能会去用啊？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "506/TALK",
            "narrator": "ガブリエラ",
            "text": "だってそれは不正だもの",
            "zh": "因为那是作弊行为嘛",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "507/TALK",
            "narrator": "ガブリエラ",
            "text": "ゲームはルールがあるから",
            "zh": "游戏正是因为有规则",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "508/TALK",
            "narrator": "ガブリエラ",
            "text": "初めて楽しめるものなのよ？",
            "zh": "才能让人乐在其中不是吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "509/TALK",
            "narrator": "ガブリエラ",
            "text": "それを無視したら",
            "zh": "要是无视了规则",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "510/TALK",
            "narrator": "ガブリエラ",
            "text": "ゲームではなくなってしまうわ",
            "zh": "那就算不上是游戏了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "511/TALK",
            "narrator": "ガブリエラ",
            "text": "そうじゃなくて？",
            "zh": "难道不是吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "512/ACT",
            "narrator": "",
            "text": "被害者が出てるかも",
            "zh": "说不定已经出现受害者了",
            "narrator_zh": ""
        },
        {
            "location": "528/TALK",
            "narrator": "ガブリエラ",
            "text": "かもではないと思うわ",
            "zh": "我觉得已经不是“说不定”了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "529/TALK",
            "narrator": "ガブリエラ",
            "text": "そのバグが発覚しているということは",
            "zh": "既然这个BUG已经被人发现了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "530/TALK",
            "narrator": "ガブリエラ",
            "text": "誰かが確かめたということだし",
            "zh": "那就说明肯定有人实测过",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "531/TALK",
            "narrator": "ガブリエラ",
            "text": "きっと",
            "zh": "现在",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "532/TALK",
            "narrator": "ガブリエラ",
            "text": "今も被害者の数が増えているはずよ",
            "zh": "受害者的数量说不定还在增加呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "533/TALK",
            "narrator": "ガブリエラ",
            "text": "このまま放ってはおけないわね",
            "zh": "不能就这么放着不管呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "534/ACT",
            "narrator": "",
            "text": "運営に報告すれば？",
            "zh": "向运营举报不就好了？",
            "narrator_zh": ""
        },
        {
            "location": "550/TALK",
            "narrator": "ガブリエラ",
            "text": "それがいいわね",
            "zh": "这样比较好呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "551/TALK",
            "narrator": "ガブリエラ",
            "text": "知っている人が少ない今なら",
            "zh": "趁着现在知道的人还不多",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "552/TALK",
            "narrator": "ガブリエラ",
            "text": "被害を最小限に抑えられると思うし",
            "zh": "应该能把损失降到最低",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "557/TALK",
            "narrator": "ガブリエラ",
            "text": "とにかく、早いとこ\n公式に報告した方が\nいいわね。",
            "zh": "总之，还是尽早\n向官方举报\n比较好呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "559/TALK",
            "narrator": "繭",
            "text": "…もう？",
            "zh": "……这就报？",
            "narrator_zh": "茧"
        },
        {
            "location": "562/TALK",
            "narrator": "ガブリエラ",
            "text": "もうって何よ？\n早くしないと被害が\n大きくなるでしょ？",
            "zh": "什么叫这就报啊？\n不赶紧的话受害范围\n只会越来越大吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "564/TALK",
            "narrator": "繭",
            "text": "大規模炎上するの、\n見たかったのに…。",
            "zh": "大规模炎上的场面，\n我还想看呢……。",
            "narrator_zh": "茧"
        },
        {
            "location": "567/TALK",
            "narrator": "ガブリエラ",
            "text": "…バグのこと、\n掲示板に書き込んだり\nするんじゃないわよ？",
            "zh": "……BUG的事，\n你可不许跑到\n论坛上乱发啊？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "578/DIALOG",
            "narrator": "Dialog_chapter_ch03",
            "text": "【13 電脳料理人】",
            "zh": "【13 电脑料理人】",
            "narrator_zh": "Dialog_chapter_ch03"
        }
    ]
}
