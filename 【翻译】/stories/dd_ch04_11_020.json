{
    "dir": "chap11/daydra/dd_ch04_11_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "11456",
        "cid": "miyabi",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "調理実習",
        "title_zh": "Extra006 额外剧情",
        "sub_title_zh": "烹饪实习"
    },
    "entry": [
        {
            "location": "256/SCENARIO",
            "narrator": "",
            "text": "調理実習",
            "zh": "烹饪实习",
            "narrator_zh": ""
        },
        {
            "location": "273/TALK",
            "narrator": "みやび",
            "text": "う～ん…。",
            "zh": "唔～……。",
            "narrator_zh": "雅"
        },
        {
            "location": "274/SEL",
            "narrator": "",
            "text": "悩みごと？",
            "zh": "有心事吗？",
            "narrator_zh": ""
        },
        {
            "location": "276/TALK",
            "narrator": "みやび",
            "text": "どうしたもんか？",
            "zh": "该怎么办才好？",
            "narrator_zh": "雅"
        },
        {
            "location": "277/TALK",
            "narrator": "みやび",
            "text": "まあ、作った以上\n食べはするけんど――",
            "zh": "嘛，既然做了\n那肯定会吃，不过——",
            "narrator_zh": "雅"
        },
        {
            "location": "278/TALK",
            "narrator": "みやび",
            "text": "見た目がこれやしなぁ…。",
            "zh": "可卖相是这副样子啊……。",
            "narrator_zh": "雅"
        },
        {
            "location": "279/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "282/TALK",
            "narrator": "みやび",
            "text": "まあ、小腹が空いた\n時にでも、ちまちま\n食べればえいか。",
            "zh": "嘛，等肚子有点饿\n的时候，小口小口\n吃掉就得了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "284/ACT",
            "narrator": "",
            "text": "悩みごと？",
            "zh": "有心事吗？",
            "narrator_zh": ""
        },
        {
            "location": "303/TALK",
            "narrator": "みやび",
            "text": "そんな大層なもんやないちや",
            "zh": "哪有什么了不起滴",
            "narrator_zh": "雅"
        },
        {
            "location": "304/TALK",
            "narrator": "みやび",
            "text": "今日、調理実習でクッキーを作ったんやけんど",
            "zh": "今天烹饪实习上做了饼干来着",
            "narrator_zh": "雅"
        },
        {
            "location": "305/TALK",
            "narrator": "みやび",
            "text": "ウサギの形にするつもりが、崩れてボロボロになちゅうたがよ",
            "zh": "本来打算做成兔子形状，结果塌掉变得稀碎咯",
            "narrator_zh": "雅"
        },
        {
            "location": "308/SEL",
            "narrator": "",
            "text": "料理上手なのに！？",
            "zh": "你明明很会做菜！？",
            "narrator_zh": ""
        },
        {
            "location": "309/ACT",
            "narrator": "",
            "text": "料理上手なのに！？",
            "zh": "你明明很会做菜！？",
            "narrator_zh": ""
        },
        {
            "location": "312/TALK",
            "narrator": "みやび",
            "text": "うちの得意料理は和食限定やき、クッキーは専門外や",
            "zh": "我擅长的只有和食啵，饼干不在行",
            "narrator_zh": "雅"
        },
        {
            "location": "313/TALK",
            "narrator": "みやび",
            "text": "…まあ、簡単に見えたき、上手くいく思うたんやけんどね",
            "zh": "……嘛，看起来挺简单啵，就想着能做好来着",
            "narrator_zh": "雅"
        },
        {
            "location": "315/TALK",
            "narrator": "みやび",
            "text": "そのクッキーをどうするかを、考え中なんよ",
            "zh": "现在正在想这些饼干要怎么处理哦",
            "narrator_zh": "雅"
        },
        {
            "location": "317/SEL",
            "narrator": "",
            "text": "食べたいな",
            "zh": "想尝尝",
            "narrator_zh": ""
        },
        {
            "location": "318/SEL",
            "narrator": "",
            "text": "みんなのお茶菓子にしよう",
            "zh": "拿来给大家当茶点吧",
            "narrator_zh": ""
        },
        {
            "location": "319/SEL",
            "narrator": "",
            "text": "残念だけど捨てよう",
            "zh": "可惜了，还是扔掉吧",
            "narrator_zh": ""
        },
        {
            "location": "320/ACT",
            "narrator": "",
            "text": "食べたいな",
            "zh": "想尝尝",
            "narrator_zh": ""
        },
        {
            "location": "322/TALK",
            "narrator": "みやび",
            "text": "相棒にやったら食べさせてもえいけんど",
            "zh": "给搭档吃倒是得咯，",
            "narrator_zh": "雅"
        },
        {
            "location": "324/TALK",
            "narrator": "みやび",
            "text": "まあ、ここにいないき、無理な話やね",
            "zh": "嘛，搭档又不在这里啵，想也白想咯",
            "narrator_zh": "雅"
        },
        {
            "location": "325/TALK",
            "narrator": "みやび",
            "text": "…ちゅうか、美味いかどうかの確認もまだやき、ちっくと食べてみるちや",
            "zh": "……说起来，还没确认过味道啵，我先尝一点滴",
            "narrator_zh": "雅"
        },
        {
            "location": "336/TALK",
            "narrator": "みやび",
            "text": "…見た目は美味そうには\n見えんけんど、どれ…。",
            "zh": "……卖相看着是\n不像好吃，但吃哪个……。",
            "narrator_zh": "雅"
        },
        {
            "location": "337/TALK",
            "narrator": "みやび",
            "text": "あむっ……。",
            "zh": "啊呜……。",
            "narrator_zh": "雅"
        },
        {
            "location": "339/TALK",
            "narrator": "みやび",
            "text": "…ん？",
            "zh": "……嗯？",
            "narrator_zh": "雅"
        },
        {
            "location": "340/TALK",
            "narrator": "みやび",
            "text": "なんや、見た目の割に\n味は普通やね。",
            "zh": "什么嘛，虽然卖相那样，\n味道倒是普通咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "341/TALK",
            "narrator": "みやび",
            "text": "美味くも不味くもない、\nただのクッキー…とでも\n言うんやろか？",
            "zh": "不好吃也不难吃，\n就是块普普通通的\n饼干……该这么说咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "342/TALK",
            "narrator": "みやび",
            "text": "んむんむ…しかし…\nあむっ…物足りんな。",
            "zh": "嗯姆嗯姆……但是……\n啊呜……不够味啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "343/TALK",
            "narrator": "みやび",
            "text": "甘さが足らんわけやない\nけんど、何か決定的な\nものが――",
            "zh": "甜度并不是不够，\n但总觉得缺点什么\n决定性的东西——",
            "narrator_zh": "雅"
        },
        {
            "location": "345/TALK",
            "narrator": "みやび",
            "text": "ああ、バニラビーンズの\n香りが足りないんやな。",
            "zh": "啊，是少了\n香草荚的香气啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "346/TALK",
            "narrator": "みやび",
            "text": "決定的なミスは…\n多分それくらいか？",
            "zh": "决定性的失误……\n大概就那个吧？",
            "narrator_zh": "雅"
        },
        {
            "location": "347/TALK",
            "narrator": "みやび",
            "text": "んむんむんむ…。",
            "zh": "嗯姆嗯姆嗯姆……。",
            "narrator_zh": "雅"
        },
        {
            "location": "352/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょっとみやび、\n仕事中に何食べてるのよ？",
            "zh": "我说雅，\n干活时间吃什么呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "354/TALK",
            "narrator": "みやび",
            "text": "んっ…ああ、調理実習で\n作ったクッキーや。",
            "zh": "嗯……啊，是烹饪实习\n做的饼干咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "355/TALK",
            "narrator": "ガブリエラ",
            "text": "えっ、みやびって\nクッキーとか作るの！？",
            "zh": "诶，雅你会\n做饼干什么的！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "356/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしにもちょうだい。\nみやびのクッキー、\n食べてみたいわ。",
            "zh": "也给我一块。\n雅做的饼干，\n我想尝尝看。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "358/TALK",
            "narrator": "みやび",
            "text": "えいけんど、あんまし\n期待すると――",
            "zh": "得倒是得咯，\n但太期待的话——",
            "narrator_zh": "雅"
        },
        {
            "location": "359/TALK",
            "narrator": "みやび",
            "text": "って、すまんなぁ。\nうっかり全部食べて\nしもうた。",
            "zh": "哎呀，没好意思哈。\n一不小心就全部\n吃掉了。",
            "narrator_zh": "雅"
        },
        {
            "location": "360/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ！？\n全部食べちゃったの！？",
            "zh": "哈！？\n全都吃掉了！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "362/TALK",
            "narrator": "みやび",
            "text": "一つ残らず、\nうちのお腹に入って\nしまったようや。",
            "zh": "一块不剩，\n全都进了我\n肚子里咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "365/TALK",
            "narrator": "ガブリエラ",
            "text": "そんなに美味しかった\nなら、少しくらい残して\nおいてくれても――",
            "zh": "既然那么好吃，\n哪怕留一点给\n我也好——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "366/TALK",
            "narrator": "ガブリエラ",
            "text": "良かったのに…。",
            "zh": "留着就好了嘛……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "368/TALK",
            "narrator": "みやび",
            "text": "…期待してるほど、\n美味い味やないんよ？",
            "zh": "……可没有你期待的\n那么好吃哦？",
            "narrator_zh": "雅"
        },
        {
            "location": "369/TALK",
            "narrator": "ガブリエラ",
            "text": "みやびが料理上手なのは\nみんな知ってるん\nだから――",
            "zh": "雅做菜厉害的事，\n大家都知道\n的——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "371/TALK",
            "narrator": "ガブリエラ",
            "text": "そんなのウソって\nバレバレよ？",
            "zh": "那种谎话\n一眼就穿帮了吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "372/TALK",
            "narrator": "みやび",
            "text": "いや、そう思うてくれ\nるんは嬉しいけんど…。",
            "zh": "不，你能这么想，\n我是挺高兴的……。",
            "narrator_zh": "雅"
        },
        {
            "location": "373/TALK",
            "narrator": "みやび",
            "text": "…わかった。\nじゃあ、ガブちゃんの\nために――",
            "zh": "……知道了。\n那我就为了加布\n——",
            "narrator_zh": "雅"
        },
        {
            "location": "374/TALK",
            "narrator": "みやび",
            "text": "今度クッキー作るき、\nそれでえいか？",
            "zh": "下次做饼干的时候，\n那样得咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "377/TALK",
            "narrator": "ガブリエラ",
            "text": "やった！\nさすがみやびね！",
            "zh": "太好了！\n不愧是雅！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "378/TALK",
            "narrator": "ガブリエラ",
            "text": "多めに作る分には\n全然かまわないから。\n楽しみにしてるわ。",
            "zh": "只要多做一些，\n我完全没意见。\n我很期待哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "382/TALK",
            "narrator": "みやび",
            "text": "…ちっくと、クッキーの\n練習しといた方が、\nえいかもしれんな。",
            "zh": "……还是稍微练练\n做饼干，\n可能比较好咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "384/TALK",
            "narrator": "みやび",
            "text": "はぁ…しゃあないなぁ…。",
            "zh": "哈啊……没办法呀……。",
            "narrator_zh": "雅"
        },
        {
            "location": "401/ACT",
            "narrator": "",
            "text": "みんなのお茶菓子にしよう",
            "zh": "拿来给大家当茶点吧",
            "narrator_zh": ""
        },
        {
            "location": "402/TALK",
            "narrator": "みやび",
            "text": "このボロボロのをみんなに食べさせるんは、ちっくと気が引けるぞね",
            "zh": "把这种碎渣渣的玩意给大家吃，我有点过意不去咧",
            "narrator_zh": "雅"
        },
        {
            "location": "403/TALK",
            "narrator": "みやび",
            "text": "…けんど、うちが初めて作ったクッキーやき",
            "zh": "……但是，这可是我第一次做的饼干啵",
            "narrator_zh": "雅"
        },
        {
            "location": "404/TALK",
            "narrator": "みやび",
            "text": "みんなに感想聞いた方が、今後の参考にはなるか",
            "zh": "问问大家的感想，对以后也好有个参考吧",
            "narrator_zh": "雅"
        },
        {
            "location": "415/TALK",
            "narrator": "みやび",
            "text": "…よし。\nみんなを集めるぞね。",
            "zh": "……好。\n把大家召集起来咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "431/TALK",
            "narrator": "みやび",
            "text": "…ちゅうわけやき、\n味の保証はできん\nけんど――",
            "zh": "……就是这么回事啵，\n味道我可不敢\n保证——",
            "narrator_zh": "雅"
        },
        {
            "location": "432/TALK",
            "narrator": "みやび",
            "text": "それでもえいなら、\n食べてもらえんか？",
            "zh": "要是这样也不介意，\n能赏脸吃一下咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "435/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしはもらうわ。",
            "zh": "我要了哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "437/TALK",
            "narrator": "ガブリエラ",
            "text": "みやびの作ったものなら、\n不味くはならないと\n思うし。",
            "zh": "雅做出来的东西，\n总不至于\n难吃吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "439/TALK",
            "narrator": "つばめ",
            "text": "わたしも、いただきます。",
            "zh": "我也要开动了。",
            "narrator_zh": "燕"
        },
        {
            "location": "440/TALK",
            "narrator": "みやび",
            "text": "…美味い保証はない\n言うてるのに。",
            "zh": "……明明都说了\n没有好吃保证的。",
            "narrator_zh": "雅"
        },
        {
            "location": "442/TALK",
            "narrator": "アーヤ",
            "text": "私もいただくわ。",
            "zh": "我也要尝尝。",
            "narrator_zh": "绫水"
        },
        {
            "location": "443/TALK",
            "narrator": "みやび",
            "text": "…超絶不味くても、\n怒らんでくれな？",
            "zh": "……就算难吃得不行，\n也请别生气好咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "445/TALK",
            "narrator": "アーヤ",
            "text": "怒ったりしないって。\nあむっ…。",
            "zh": "不会生气的啦。\n啊呜……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "447/TALK",
            "narrator": "ガブリエラ",
            "text": "んむんむ…。",
            "zh": "嗯姆嗯姆……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "450/TALK",
            "narrator": "ガブリエラ",
            "text": "…なんだ、\n美味しいじゃん。",
            "zh": "……什么嘛，\n不是挺好吃的嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "451/TALK",
            "narrator": "みやび",
            "text": "…美味しい？",
            "zh": "……好吃？",
            "narrator_zh": "雅"
        },
        {
            "location": "452/TALK",
            "narrator": "つばめ",
            "text": "はい、これ美味しいです。\nみやびさん、心配し過ぎ\nですよ。",
            "zh": "嗯，这个很好吃哦。\n雅，你担心得\n太多啦。",
            "narrator_zh": "燕"
        },
        {
            "location": "453/TALK",
            "narrator": "ガブリエラ",
            "text": "サクサク感が少ないのと、\n甘さがちょっとだけ\n足りないけど――",
            "zh": "酥脆感差了一点，\n甜度也差了那么\n一点，但是——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "455/TALK",
            "narrator": "ガブリエラ",
            "text": "普通に美味しいわね。\nアーヤもそう思うでしょ？",
            "zh": "明明挺好吃的。\n绫水你也这么觉得吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "458/TALK",
            "narrator": "アーヤ",
            "text": "うん、美味しいわ。",
            "zh": "嗯，好吃。",
            "narrator_zh": "绫水"
        },
        {
            "location": "460/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "462/TALK",
            "narrator": "アーヤ",
            "text": "不満なの？",
            "zh": "你不满意吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "463/TALK",
            "narrator": "みやび",
            "text": "いや…なんちゅうか、\n面白くてな。",
            "zh": "不……怎么说呢，\n觉得很有意思。",
            "narrator_zh": "雅"
        },
        {
            "location": "467/TALK",
            "narrator": "みやび",
            "text": "和食を食べた時と違う、\nこのなんとも言えん\n微妙な反応が――",
            "zh": "和吃和食时不一样，\n这种难以言喻的\n微妙反应——",
            "narrator_zh": "雅"
        },
        {
            "location": "468/TALK",
            "narrator": "みやび",
            "text": "新鮮に感じるんよ。",
            "zh": "感觉就很新鲜哦。",
            "narrator_zh": "雅"
        },
        {
            "location": "470/TALK",
            "narrator": "ガブリエラ",
            "text": "…それ、面白いの？",
            "zh": "……那个，有意思吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "471/TALK",
            "narrator": "みやび",
            "text": "うん、中々面白いちや。",
            "zh": "嗯，相当有意思滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "473/TALK",
            "narrator": "みやび",
            "text": "今度はプリン作りに\n挑戦して、またみんなに\n食べてもらうか…。",
            "zh": "下次挑战做布丁，\n再让大家\n试吃吧……。",
            "narrator_zh": "雅"
        },
        {
            "location": "476/TALK",
            "narrator": "つばめ",
            "text": "えっ、プリンですか！？\nやったー！",
            "zh": "诶，布丁吗！？\n太棒啦！",
            "narrator_zh": "燕"
        },
        {
            "location": "477/TALK",
            "narrator": "ガブリエラ",
            "text": "実験台にされるのは\nちょっと気に入らない\nけど――",
            "zh": "被当实验台这点\n是有点不乐意，\n不过——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "478/TALK",
            "narrator": "ガブリエラ",
            "text": "美味しいプリンが\n食べれるなら、\nあたしも協力するわ。",
            "zh": "要是能吃上\n好吃的布丁，\n我也出力。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "480/TALK",
            "narrator": "みやび",
            "text": "どんな反応が見られるか、\n今から楽しみや。",
            "zh": "能看到什么反应，\n现在就开始期待咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "482/TALK",
            "narrator": "アーヤ",
            "text": "…そうやって面白いから\n作ってるうちに――",
            "zh": "……就这么因为觉得有趣\n做着做着——",
            "narrator_zh": "绫水"
        },
        {
            "location": "483/TALK",
            "narrator": "アーヤ",
            "text": "知らず知らずの間に、\n極めていくタイプなのかも\nしれないわね…。",
            "zh": "说不定你也会在不知不觉中\n越做越\n精通呢……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "484/ACT",
            "narrator": "",
            "text": "残念だけど捨てよう",
            "zh": "可惜了，还是扔掉吧",
            "narrator_zh": ""
        },
        {
            "location": "485/TALK",
            "narrator": "みやび",
            "text": "それは本気か？",
            "zh": "你是认真的咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "486/TALK",
            "narrator": "みやび",
            "text": "冗談やとしても、うちはそういうの大嫌いや",
            "zh": "就算是开玩笑，这种事我也最讨厌了",
            "narrator_zh": "雅"
        },
        {
            "location": "487/TALK",
            "narrator": "みやび",
            "text": "うちが作った物を捨てろ言われて、怒ってるわけやないぞ？",
            "zh": "被叫扔掉自己做的东西，我可不是因为这个才生气啵？",
            "narrator_zh": "雅"
        },
        {
            "location": "488/TALK",
            "narrator": "みやび",
            "text": "軽い気持ちで食べ物を粗末にしよう思うんが許せないちや",
            "zh": "随随便便糟蹋食物这件事，让我忍不了滴",
            "narrator_zh": "雅"
        },
        {
            "location": "499/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "501/TALK",
            "narrator": "みやび",
            "text": "ちっくと、熱くなり\n過ぎたか。",
            "zh": "稍微有点\n太激动了咩。",
            "narrator_zh": "雅"
        },
        {
            "location": "506/TALK",
            "narrator": "ガブリエラ",
            "text": "みやび、暇ならこっちの\n作業手伝っ――",
            "zh": "雅，有空的话\n来帮这边——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "508/TALK",
            "narrator": "ガブリエラ",
            "text": "うわ、何それ？\nボロボロのクッキー？",
            "zh": "哇，那是什么？\n碎成渣的饼干？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "510/TALK",
            "narrator": "みやび",
            "text": "ん…うちが初めて作った\nクッキーちや。",
            "zh": "嗯……是我第一次做的\n饼干滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "511/TALK",
            "narrator": "ガブリエラ",
            "text": "…みやび、クッキー\n作ったことなかったんだ？",
            "zh": "……雅你以前\n没做过饼干呀？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "512/TALK",
            "narrator": "ガブリエラ",
            "text": "なんか意外だわ。",
            "zh": "总觉得挺意外的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "513/TALK",
            "narrator": "みやび",
            "text": "うちの得意料理は\n和食専門やきね。",
            "zh": "我擅长的料理\n只限于和食啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "515/TALK",
            "narrator": "みやび",
            "text": "こういう洋菓子は\nどうにも苦手ちや。",
            "zh": "这种西点，\n我实在搞不来滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "516/TALK",
            "narrator": "ガブリエラ",
            "text": "ふーん…。",
            "zh": "哦——……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "517/TALK",
            "narrator": "ガブリエラ",
            "text": "ねえ、一つちょうだい。\n味見してみたいわ。",
            "zh": "呐，给我一块。\n我想尝尝味道。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "518/TALK",
            "narrator": "みやび",
            "text": "味の保証はできない\nけんど、それでも\nよければな。",
            "zh": "味道我可不敢保证，\n但你要不介意的话，\n就吃吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "520/TALK",
            "narrator": "ガブリエラ",
            "text": "構わないわ。\nじゃあ、一つ貰うね。",
            "zh": "不介意。\n那我拿一块咯。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "522/TALK",
            "narrator": "ガブリエラ",
            "text": "あむっ…んむんむ…。",
            "zh": "啊呜……嗯姆嗯姆……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "523/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "527/TALK",
            "narrator": "みやび",
            "text": "…不味かった？",
            "zh": "……很难吃？",
            "narrator_zh": "雅"
        },
        {
            "location": "529/TALK",
            "narrator": "ガブリエラ",
            "text": "不味くはないけど――",
            "zh": "不难吃，但是——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "531/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょっと、みやびが\n作ったとは思えない\n味だわ。",
            "zh": "说真的，这味道\n完全不像\n雅你做出来的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "532/TALK",
            "narrator": "みやび",
            "text": "？",
            "zh": "？",
            "narrator_zh": "雅"
        },
        {
            "location": "534/TALK",
            "narrator": "ガブリエラ",
            "text": "凄く美味しいとは\n思えない、ってことよ。",
            "zh": "是说「并不觉得\n特别好吃」的意思哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "536/TALK",
            "narrator": "みやび",
            "text": "そうか…ちっくと\n悔しいな…。",
            "zh": "这样啊……有点\n不甘心啊……。",
            "narrator_zh": "雅"
        },
        {
            "location": "537/TALK",
            "narrator": "ガブリエラ",
            "text": "まあ、及第点以上の\n味なのは間違いない\nから――",
            "zh": "嘛，味道肯定\n在及格线以上，\n所以——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "538/TALK",
            "narrator": "ガブリエラ",
            "text": "悔しがる必要はないん\nじゃない？\n初めて作ったんだし。",
            "zh": "没什么好不甘心的\n吧？\n毕竟是第一次做。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "540/TALK",
            "narrator": "みやび",
            "text": "…ガブちゃんはハッキリ\n言うてくれるから\n好きちや。",
            "zh": "……加布肯把话\n说得这么直白，\n我喜欢滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "542/TALK",
            "narrator": "ガブリエラ",
            "text": "味見なんだから\nハッキリ言わないと\n意味ないじゃん。",
            "zh": "既然是试吃，\n不把话说清楚\n就没意义了嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "543/TALK",
            "narrator": "ガブリエラ",
            "text": "もう一つちょうだい。",
            "zh": "再给我一块。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "544/TALK",
            "narrator": "みやび",
            "text": "一つと言わず、\n全部持っていって\n構わんよ。",
            "zh": "何止一块，\n全部拿去\n也无妨咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "546/TALK",
            "narrator": "ガブリエラ",
            "text": "えっ、いいの！？\nやった！",
            "zh": "诶，真的可以！？\n太棒了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "547/TALK",
            "narrator": "ガブリエラ",
            "text": "今夜勉強する時の、\n夜食代わりにさせて\nもらうわ。",
            "zh": "今晚学习的时候，\n就拿它当\n宵夜了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "548/TALK",
            "narrator": "みやび",
            "text": "…ガブちゃんは\nえい子やね。",
            "zh": "……加布真是\n好孩子咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "549/TALK",
            "narrator": "みやび",
            "text": "見た目が悪いき、\n捨てろとか言わんし。",
            "zh": "也不会因为卖相不好，\n就叫我扔掉啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "551/TALK",
            "narrator": "ガブリエラ",
            "text": "そんな理由で捨てろとか、\n言うはずないじゃない。",
            "zh": "那种理由叫我扔东西，\n怎么可能说得出口嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "553/TALK",
            "narrator": "みやび",
            "text": "…それを聞いて、\nちっくと安心したぞね。",
            "zh": "……听你这么说，\n我稍微安心了咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "556/TALK",
            "narrator": "みやび",
            "text": "ありがとな、ガブちゃん。",
            "zh": "谢了，加布。",
            "narrator_zh": "雅"
        },
        {
            "location": "557/TALK",
            "narrator": "ガブリエラ",
            "text": "？　え、ええ…\nどういたしまして…？",
            "zh": "？　诶、诶……\n不用谢……？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "264/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>6月30日　4:03 PM</color>\nとある平日、神楽坂トライナリー劇場でのバイト中のこと。",
            "zh": "<color=green>6月30日　4:03 PM</color>\n某个工作日，在神乐坂三重奏剧场打工时发生的事。",
            "narrator_zh": "Dialog_EventData"
        },
        {
            "location": "395/DIALOG",
            "narrator": "Dialog_GEThimegoto_ch04",
            "text": "【スイーツの甘きことなし】",
            "zh": "【甜点无比甘甜】",
            "narrator_zh": "Dialog_GEThimegoto_ch04"
        }
    ]
}
