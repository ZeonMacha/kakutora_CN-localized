            "narrator": "透明みやび",
            "text": "何言うてるが？\n文句なしの\nパーフェクトぞね。",
            "zh": "你在说么子喃？\n没得挑剔，\n完美得很啵。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "153/TALK",
            "narrator": "透明みやび",
            "text": "これなら、いつでも\nお嫁に行けるがよ。",
            "zh": "这样的话，随时\n都能嫁人啵。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "154/TALK",
            "narrator": "透明神楽",
            "text": "アーヤさん、\nこっち向いてください。",
            "zh": "绫水，\n请看这边。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "158/TALK",
            "narrator": "透明アーヤ",
            "text": "ちょっと\n恥ずかしいかも…。",
            "zh": "有点\n害羞……",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "159/TALK",
            "narrator": "透明ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "160/TALK",
            "narrator": "透明アーヤ",
            "text": "ギャヴィ？",
            "zh": "加维？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "162/TALK",
            "narrator": "透明ガブリエラ",
            "text": "…あ、うん。\nし、幸せになってね…。",
            "zh": "……啊，嗯。\n要、要幸福哦……",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "163/TALK",
            "narrator": "透明アーヤ",
            "text": "はい？",
            "zh": "嗯？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "164/TALK",
            "narrator": "透明ガブリエラ",
            "text": "あっ！！",
            "zh": "啊！！",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "165/TALK",
            "narrator": "透明みやび",
            "text": "アーヤがあまりにも\n本物っぽいきね。",
            "zh": "因为绫水\n太像真的了啵。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "167/TALK",
            "narrator": "透明みやび",
            "text": "まっこと結婚するん\n思うたんやろ？",
            "zh": "你的确以为\n她要结婚了喃？",
            "narrator_zh": "透明雅"
        },
        {
            "location": "168/TALK",
            "narrator": "透明ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "170/TALK",
            "narrator": "透明アーヤ",
            "text": "あはは。\n本当にお嫁に行ったり\nしないわよ。",
            "zh": "啊哈哈。\n我才不会真的\n嫁人。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "172/TALK",
            "narrator": "透明ガブリエラ",
            "text": "わ、わかってるわよ！\nていうか、本当に結婚する\nとか思ってないし…。",
            "zh": "我、我知道！\n再说，我又没以为\n你真的要结婚……",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "173/TALK",
            "narrator": "透明アーヤ",
            "text": "大丈夫よ。\nまだ、もうしばらくは\n寮にいるから、ね？",
            "zh": "没关系。\n再过一段时间，\n我还是会在宿舍的，对吧？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "174/TALK",
            "narrator": "透明ガブリエラ",
            "text": "…そんなの、\nわからないじゃん。",
            "zh": "……那种事，\n谁说得准。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "175/TALK",
            "narrator": "透明ガブリエラ",
            "text": "急に彼氏ができて、\n寿除隊する可能性だって\nあるでしょ？",
            "zh": "突然有了男朋友，\n甚至结婚退伍\n也有可能吧？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "176/TALK",
            "narrator": "透明アーヤ",
            "text": "あ、あのね…、\nそんなことするわけ\nないでしょ？",
            "zh": "啊、那个……\n我怎么会\n做那种事？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "177/TALK",
            "narrator": "透明ガブリエラ",
            "text": "でも…。",
            "zh": "可是……",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "178/TALK",
            "narrator": "透明みやび",
            "text": "なぁに、ガブちゃん。\nその心配は無用や。",
            "zh": "没事，加布。\n这担心用不着啵。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "180/TALK",
            "narrator": "透明みやび",
            "text": "アーヤがそう簡単に\n彼氏なんぞ作れるはず\nないちや。",
            "zh": "绫水哪那么容易\n找得到\n男朋友啵。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "182/TALK",
            "narrator": "透明アーヤ",
            "text": "ちょっと、みやび。\nそれってどういう意味よ？",
            "zh": "等一下，雅。\n这话是什么意思？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "183/TALK",
            "narrator": "透明みやび",
            "text": "そのまんまの意味ぞね。",
            "zh": "就是字面上那个意思啵。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "184/TALK",
            "narrator": "透明つばめ",
            "text": "そんなことないですよ。",
            "zh": "才没有那种事。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "186/TALK",
            "narrator": "透明つばめ",
            "text": "アーヤさんは素敵だから、\nきっとすぐに恋人を\n作っちゃうと思います。",
            "zh": "绫水那么好，\n我想很快就会\n有恋人的。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "187/TALK",
            "narrator": "透明つばめ",
            "text": "ね？",
            "zh": "对吧？",
            "narrator_zh": "透明燕"
        },
        {
            "location": "189/TALK",
            "narrator": "透明アーヤ",
            "text": "ね？　って、\n同意を求められても\n困るんだけど…。",
            "zh": "对吧？这种，\n就算找我同意\n我也很为难……",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "190/TALK",
            "narrator": "透明神楽",
            "text": "う～ん…アーヤさんが\nとっても素敵なのは\n間違いありません。",
            "zh": "嗯……绫水\n非常好看，\n这是不会错的。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "191/TALK",
            "narrator": "透明神楽",
            "text": "でも、恋愛に対して\n積極性がないのが\n問題なんですよね…。",
            "zh": "可是，对恋爱\n不够主动，\n这才是问题……",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "192/TALK",
            "narrator": "透明みやび",
            "text": "うむ、婚期を逃しちゅう\n一番の原因や。",
            "zh": "嗯，婚期一直错过，\n最大的原因就在这啵。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "193/TALK",
            "narrator": "透明アーヤ",
            "text": "いい加減にして！",
            "zh": "适可而止！",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "194/TALK",
            "narrator": "透明アーヤ",
            "text": "まったく、本人の前で\n言いたい放題言って…。",
            "zh": "真是的，当着本人的面\n想说什么就说什么……",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "195/TALK",
            "narrator": "透明みやび",
            "text": "あんまし怒ると、\nウエディングドレスが\n台無しやぞ？",
            "zh": "太生气的话，\n婚纱可就要\n糟蹋了啵？",
            "narrator_zh": "透明雅"
        },
        {
            "location": "197/TALK",
            "narrator": "透明アーヤ",
            "text": "怒らせてるのは\nあなた達でしょ？\nまったく…。",
            "zh": "让我生气的\n是你们吧？\n真是的……",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "198/TALK",
            "narrator": "透明ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "199/TALK",
            "narrator": "透明ガブリエラ",
            "text": "ウエディングドレスで\n怒ってるアーヤも、\nちょっと可愛いかも…。",
            "zh": "穿着婚纱\n生气的绫水，\n也有点可爱……",
            "narrator_zh": "透明加布里埃拉"
        }
    ]
}
