        "title": "005 メインストーリー",
        "sub_title": "アーヤの午後＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "绫水的午后＜后篇＞"
    },
    "entry": [
        {
            "location": "344/SCENARIO",
            "narrator": "",
            "text": "アーヤの午後",
            "zh": "绫水的午后",
            "narrator_zh": ""
        },
        {
            "location": "363/TALK",
            "narrator": "プレイヤー",
            "text": "アーヤのタイプって？",
            "zh": "绫水喜欢的类型是？",
            "narrator_zh": "玩家"
        },
        {
            "location": "364/TALK",
            "narrator": "アーヤ",
            "text": "それは",
            "zh": "这个嘛",
            "narrator_zh": "绫水"
        },
        {
            "location": "365/TALK",
            "narrator": "アーヤ",
            "text": "うーん",
            "zh": "唔——",
            "narrator_zh": "绫水"
        },
        {
            "location": "371/TALK",
            "narrator": "アーヤ",
            "text": "笑わないし",
            "zh": "如果你发誓不会笑话我",
            "narrator_zh": "绫水"
        },
        {
            "location": "372/TALK",
            "narrator": "アーヤ",
            "text": "誰にも言わないって約束するなら",
            "zh": "而且也不告诉任何人的话",
            "narrator_zh": "绫水"
        },
        {
            "location": "373/TALK",
            "narrator": "アーヤ",
            "text": "ヒントくらいは言ってもいいかも(｡-_-｡)",
            "zh": "稍微给点提示倒也不是不行(｡-_-｡)",
            "narrator_zh": "绫水"
        },
        {
            "location": "375/SEL",
            "narrator": "",
            "text": "約束します",
            "zh": "我保证",
            "narrator_zh": ""
        },
        {
            "location": "376/ACT",
            "narrator": "",
            "text": "約束します",
            "zh": "我保证",
            "narrator_zh": ""
        },
        {
            "location": "379/TALK",
            "narrator": "アーヤ",
            "text": "じゃあヒントね",
            "zh": "那我就给点提示咯",
            "narrator_zh": "绫水"
        },
        {
            "location": "380/TALK",
            "narrator": "アーヤ",
            "text": "いつも凛としていて",
            "zh": "总是英姿飒爽",
            "narrator_zh": "绫水"
        },
        {
            "location": "381/TALK",
            "narrator": "アーヤ",
            "text": "私を支えてくれる人(*^.^*)",
            "zh": "能够支撑着我的人(*^.^*)。",
            "narrator_zh": "绫水"
        },
        {
            "location": "384/TALK",
            "narrator": "アーヤ",
            "text": "はいおしまい(>_<)",
            "zh": "好，到此为止(>_<)",
            "narrator_zh": "绫水"
        },
        {
            "location": "386/SEL",
            "narrator": "",
            "text": "もう少しヒントを！",
            "zh": "再多给点提示嘛！",
            "narrator_zh": ""
        },
        {
            "location": "387/ACT",
            "narrator": "",
            "text": "もう少しヒントを！",
            "zh": "再多给点提示嘛！",
            "narrator_zh": ""
        },
        {
            "location": "389/TALK",
            "narrator": "アーヤ",
            "text": "ダメ(｀ヘ´)",
            "zh": "不行(｀ヘ´)",
            "narrator_zh": "绫水"
        },
        {
            "location": "390/TALK",
            "narrator": "アーヤ",
            "text": "この話はもうおしまい",
            "zh": "这个话题到此结束",
            "narrator_zh": "绫水"
        },
        {
            "location": "398/TALK",
            "narrator": "アーヤ",
            "text": "はぁ…。",
            "zh": "唉……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "400/TALK",
            "narrator": "アーヤ",
            "text": "…さすがに、\nこれ以上は\n言えないわ。",
            "zh": "……果然，\n再往下就\n说不出口了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "401/TALK",
            "narrator": "アーヤ",
            "text": "こんな時代なのに\n亭主関白な人が\n理想だなんて。",
            "zh": "都什么年代了，\n理想型居然是\n大男子主义的人什么的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "402/TALK",
            "narrator": "アーヤ",
            "text": "笑われる？\nううん、ドン引き\nされるわ。",
            "zh": "会被笑话吗？\n不，肯定会把人\n吓跑的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "405/TALK",
            "narrator": "店員",
            "text": "お待たせいたし\nました。",
            "zh": "让您久等\n了。",
            "narrator_zh": "店员"
        },
        {
            "location": "407/TALK",
            "narrator": "アーヤ",
            "text": "あ、どうも…。",
            "zh": "啊，谢谢……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "409/TALK",
            "narrator": "店員",
            "text": "…？\n何かありましたか？",
            "zh": "……？\n发生什么事了吗？",
            "narrator_zh": "店员"
        },
        {
            "location": "412/TALK",
            "narrator": "アーヤ",
            "text": "へ！？",
            "zh": "咦！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "415/TALK",
            "narrator": "店員",
            "text": "いえ、先ほどより\n元気がない感じに\n見えたので。",
            "zh": "没有，只是觉得您\n看起来比刚才\n没精神了些。",
            "narrator_zh": "店员"
        },
        {
            "location": "417/TALK",
            "narrator": "アーヤ",
            "text": "そ、そうですか？\n別に、なんてこと\nないですけど…。",
            "zh": "是、是吗？\n没什么，倒也没什么\n特别的事……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "419/TALK",
            "narrator": "店員",
            "text": "…そうですか。\nそれならばよいの\nですが。",
            "zh": "……这样啊。\n那就好\n了。",
            "narrator_zh": "店员"
        },
        {
            "location": "420/TALK",
            "narrator": "店員",
            "text": "では、ごゆっくり。",
            "zh": "那么，请慢用。",
            "narrator_zh": "店员"
        },
        {
            "location": "425/TALK",
            "narrator": "アーヤ",
            "text": "…ここのマスター、\n相変わらず観察力が\n凄いわ。",
            "zh": "……这里的店长，\n观察力还是一如既往地\n敏锐呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "426/SEL",
            "narrator": "",
            "text": "仲良さそうだね",
            "zh": "你们关系挺好的嘛",
            "narrator_zh": ""
        },
        {
            "location": "427/ACT",
            "narrator": "",
            "text": "仲良さそうだね",
            "zh": "你们关系挺好的嘛",
            "narrator_zh": ""
        },
        {
            "location": "439/TALK",
            "narrator": "アーヤ",
            "text": "仲が良いっていうのかしら？(｡-_-｡)",
            "zh": "这算关系好吗？(｡-_-｡)",
            "narrator_zh": "绫水"
        },
        {
            "location": "440/TALK",
            "narrator": "アーヤ",
            "text": "よく来る店だから",
            "zh": "只是因为我经常来这家店",
            "narrator_zh": "绫水"
        },
        {
            "location": "441/TALK",
            "narrator": "アーヤ",
            "text": "顔を覚えられてるだけよ(^^",
            "zh": "被记住长相了而已哦(^^",
            "narrator_zh": "绫水"
        },
        {
            "location": "444/TALK",
            "narrator": "アーヤ",
            "text": "仲良しといえば",
            "zh": "说到关系好",
            "narrator_zh": "绫水"
        },
        {
            "location": "445/TALK",
            "narrator": "アーヤ",
            "text": "つばめのお友達のこと知ってる？(￣Д￣ )",
            "zh": "你知道燕的朋友们吗？(￣Д￣ )",
            "narrator_zh": "绫水"
        },
        {
            "location": "447/SEL",
            "narrator": "",
            "text": "雛達のこと？",
            "zh": "是指雏她们吗？",
            "narrator_zh": ""
        },
        {
            "location": "448/ACT",
            "narrator": "",
            "text": "雛達のこと？",
            "zh": "是指雏她们吗？",
            "narrator_zh": ""
        },
        {
            "location": "450/TALK",
            "narrator": "アーヤ",
            "text": "そう",
            "zh": "没错",
            "narrator_zh": "绫水"
        },
        {
            "location": "451/TALK",
            "narrator": "アーヤ",
            "text": "あの子達ってば",
            "zh": "那几个孩子呀",
            "narrator_zh": "绫水"
        },
        {
            "location": "452/TALK",
            "narrator": "アーヤ",
            "text": "うちの劇場でアルバイトすることになったの(☆｡☆)",
            "zh": "决定来我们剧场打工了哦(☆｡☆)",
            "narrator_zh": "绫水"
        },
        {
            "location": "453/TALK",
            "narrator": "アーヤ",
            "text": "正確には",
            "zh": "准确来说",
            "narrator_zh": "绫水"
        },
        {
            "location": "454/TALK",
            "narrator": "アーヤ",
            "text": "劇場のバイト兼トライナリーの手伝いだけど(￣∇￣)",
            "zh": "是在剧场打工兼给三重奏帮忙就是了(￣∇￣)",
            "narrator_zh": "绫水"
        },
        {
            "location": "456/SEL",
            "narrator": "",
            "text": "真幌は許可したの？",
            "zh": "真幌批准了吗？",
            "narrator_zh": ""
        },
        {
            "location": "457/ACT",
            "narrator": "",
            "text": "真幌は許可したの？",
            "zh": "真幌批准了吗？",
            "narrator_zh": ""
        },
        {
            "location": "459/TALK",
            "narrator": "アーヤ",
            "text": "したらしいわ",
            "zh": "好像批准了",
            "narrator_zh": "绫水"
        },
        {
            "location": "460/TALK",
            "narrator": "アーヤ",
            "text": "実はあの子達",
            "zh": "其实那几个孩子",
            "narrator_zh": "绫水"
        },
        {
            "location": "461/TALK",
            "narrator": "アーヤ",
            "text": "バイトをしたいから館長に口添えしてくれって",
            "zh": "之前来找过我",
            "narrator_zh": "绫水"
        },
        {
            "location": "462/TALK",
            "narrator": "アーヤ",
            "text": "私のところに来たのよ",
            "zh": "让我替她们向馆长说情，好去打工",
            "narrator_zh": "绫水"
        },
        {
            "location": "463/TALK",
            "narrator": "アーヤ",
            "text": "もちろん断ったけど(￣Д￣ )",
            "zh": "当然被我拒绝了(￣Д￣ )",
            "narrator_zh": "绫水"
        },
        {
            "location": "464/TALK",
            "narrator": "アーヤ",
            "text": "トライナリーは秘密の特殊部隊だし",
            "zh": "毕竟三重奏是秘密特殊部队嘛",
            "narrator_zh": "绫水"
        },
        {
            "location": "465/TALK",
            "narrator": "アーヤ",
            "text": "でもその後",
            "zh": "不过后来",
            "narrator_zh": "绫水"
        },
        {
            "location": "466/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィに頼んで口添えしてもらったらしいの(>_<)",
            "zh": "她们好像去拜托加维帮忙说情了(>_<)",
            "narrator_zh": "绫水"
        },
        {
            "location": "468/SEL",
            "narrator": "",
            "text": "ガブリエラが？　珍しいね",
            "zh": "加布里埃拉？　真稀奇呢",
            "narrator_zh": ""
        },
        {
            "location": "469/ACT",
            "narrator": "",
            "text": "ガブリエラが？　珍しいね",
            "zh": "加布里埃拉？　真稀奇呢",
            "narrator_zh": ""
        },
        {
            "location": "471/TALK",
            "narrator": "アーヤ",
            "text": "私も驚いたわ(☆｡☆)",
            "zh": "我也吓了一跳呢(☆｡☆)",
            "narrator_zh": "绫水"
        },
        {
            "location": "473/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィがそんな手伝いをするなんて",
            "zh": "加维居然会帮这种忙",
            "narrator_zh": "绫水"
        },
        {
            "location": "474/TALK",
            "narrator": "アーヤ",
            "text": "ちょっと意外かも",
            "zh": "还挺让人意外的",
            "narrator_zh": "绫水"
        },
        {
            "location": "476/SEL",
            "narrator": "",
            "text": "でも、みんないい子だよ",
            "zh": "不过，大家都是好孩子呀",
            "narrator_zh": ""
        },
        {
            "location": "477/ACT",
            "narrator": "",
            "text": "でも、みんないい子だよ",
            "zh": "不过，大家都是好孩子呀",
            "narrator_zh": ""
        },
        {
            "location": "479/TALK",
            "narrator": "アーヤ",
            "text": "それは心配してないわ",
            "zh": "这点我倒是不担心",
            "narrator_zh": "绫水"
        },
        {
            "location": "480/TALK",
            "narrator": "アーヤ",
            "text": "つばめのお友達なら",
            "zh": "既然是燕的朋友",
            "narrator_zh": "绫水"
        },
        {
            "location": "481/TALK",
            "narrator": "アーヤ",
            "text": "変な子じゃないと思うし(^^",
            "zh": "我觉得应该都不会是奇怪的孩子(^^",
            "narrator_zh": "绫水"
        },
        {
            "location": "483/TALK",
            "narrator": "アーヤ",
            "text": "でも",
            "zh": "不过",
            "narrator_zh": "绫水"
        },
        {
            "location": "484/TALK",
            "narrator": "アーヤ",
            "text": "日向さんがちょっと困るかも(；´Д｀)",
            "zh": "日向那边可能有点让人头疼(；´Д｀)",
            "narrator_zh": "绫水"
        },
        {
            "location": "485/TALK",
            "narrator": "アーヤ",
            "text": "私のこと",
            "zh": "她老是叫我",
            "narrator_zh": "绫水"
        },
        {
            "location": "486/TALK",
            "narrator": "アーヤ",
            "text": "綾水様って呼ぶのがね(-ω-;)",
            "zh": "绫水大人嘛(-ω-;)",
            "narrator_zh": "绫水"
        },
        {
            "location": "487/TALK",
            "narrator": "アーヤ",
            "text": "それがちょっと恥ずかしくて(>_<)",
            "zh": "那样叫实在有点不好意思(>_<)",
            "narrator_zh": "绫水"
        },
        {
            "location": "489/SEL",
            "narrator": "",
            "text": "アーヤは雛の白馬の王子様なんだよ",
            "zh": "绫水可是雏的白马王子嘛",
            "narrator_zh": ""
        },
        {
            "location": "490/ACT",
            "narrator": "",
            "text": "アーヤは雛の白馬の王子様なんだよ",
            "zh": "绫水可是雏的白马王子嘛",
            "narrator_zh": ""
        },
        {
            "location": "492/TALK",
            "narrator": "アーヤ",
            "text": "喜べないから！(｀ヘ´)",
            "zh": "我可高兴不起来！(｀ヘ´)",
            "narrator_zh": "绫水"
        },
        {
            "location": "500/TALK",
            "narrator": "アーヤ",
            "text": "はぁ…。",
            "zh": "唉……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "501/TALK",
            "narrator": "アーヤ",
            "text": "私が望んでるのは、\nその逆なのに。",
            "zh": "我真正渴望的，\n明明是反过来才对。",
            "narrator_zh": "绫水"
        },
        {
            "location": "502/TALK",
            "narrator": "アーヤ",
            "text": "私、いつまで経っても\nこうなのね…。",
            "zh": "我啊，不管过多久\n还是老样子呢……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "513/DIALOG",
            "narrator": "Dialog_chapter_ch02",
            "text": "【10 江戸川橋物語】",
            "zh": "【10 江户川桥物语】",
            "narrator_zh": "Dialog_chapter_ch02"
        }
    ]
}
