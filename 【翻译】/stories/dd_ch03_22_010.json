{
    "dir": "chap22/daydra/dd_ch03_22_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "22352",
        "cid": "gabriella",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "気分を変えて",
        "title_zh": "Extra002 额外剧情",
        "sub_title_zh": "换个心情"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "気分を変えて",
            "zh": "换个心情",
            "narrator_zh": ""
        },
        {
            "location": "21/TALK",
            "narrator": "つばめ",
            "text": "アーヤさん、どこか\n出かけるんですか？",
            "zh": "绫水，你是要\n出门去哪里吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "25/TALK",
            "narrator": "アーヤ",
            "text": "うん、ちょっと遠出して、\nショッピングモールに\n行こうと思うの。",
            "zh": "嗯，我想稍微走远点，\n去购物中心\n逛逛。",
            "narrator_zh": "绫水"
        },
        {
            "location": "26/TALK",
            "narrator": "つばめ",
            "text": "そういえば、こっちに\n来てから行ってませんね。",
            "zh": "说起来，来这边之后\n还没去过呢。",
            "narrator_zh": "燕"
        },
        {
            "location": "29/TALK",
            "narrator": "アーヤ",
            "text": "うん…だからかしら？\n朝起きたら急に行きたい\n気持ちになっちゃって…。",
            "zh": "嗯……是因为这个吧？\n早上醒来就突然\n很想去逛逛了……",
            "narrator_zh": "绫水"
        },
        {
            "location": "31/TALK",
            "narrator": "アーヤ",
            "text": "みんなは、今日は\nどうする予定なの？",
            "zh": "大家今天\n有什么打算吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "33/TALK",
            "narrator": "つばめ",
            "text": "ちょっと悩み中です。\nこの辺りの探検も\nしてみたいけど――",
            "zh": "还在犹豫中呀。\n我也想在这附近\n探探险——",
            "narrator_zh": "燕"
        },
        {
            "location": "35/TALK",
            "narrator": "つばめ",
            "text": "電車に乗って、ただ景色を\n眺めるのも面白そうだな、\nとも思ってて…。",
            "zh": "不过也在想，坐着电车\n单纯看看风景\n好像也蛮有意思的……",
            "narrator_zh": "燕"
        },
        {
            "location": "37/TALK",
            "narrator": "神楽",
            "text": "電車ってことは、\nひなこさんですね？",
            "zh": "说到电车，\n是雏约的吧？",
            "narrator_zh": "神乐"
        },
        {
            "location": "39/TALK",
            "narrator": "つばめ",
            "text": "うん。昨日の夜、\nＷＡＶＥで誘われたんだ。",
            "zh": "嗯。昨天晚上，\n在 WAVE 上被她约了。",
            "narrator_zh": "燕"
        },
        {
            "location": "41/TALK",
            "narrator": "ガブリエラ",
            "text": "まあ、見慣れない景色\nばかりだから、意外と\n楽しめそうよね。",
            "zh": "嘛，毕竟全都是\n没见过的风景，意外地\n应该会挺有意思的吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "44/TALK",
            "narrator": "つばめ",
            "text": "うん…どうしようかなぁ？",
            "zh": "嗯……该怎么办好呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "46/TALK",
            "narrator": "つばめ",
            "text": "神楽ちゃんはどこか\n行きたいところある？",
            "zh": "神乐有什么\n想去的地方吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "47/TALK",
            "narrator": "神楽",
            "text": "私は特に…つばめさんに\n付いていきますよ。",
            "zh": "我倒是没什么特别的……\n燕去哪我就跟着去哪哦。",
            "narrator_zh": "神乐"
        },
        {
            "location": "49/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィは？",
            "zh": "加维呢？",
            "narrator_zh": "绫水"
        },
        {
            "location": "50/TALK",
            "narrator": "ガブリエラ",
            "text": "…まだ悩み中よ。",
            "zh": "……还在纠结呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "52/TALK",
            "narrator": "つばめ",
            "text": "あっ、ひなこちゃんから\nＷＡＶＥ来ちゃった。",
            "zh": "啊，雏在 WAVE 上\n发消息过来了。",
            "narrator_zh": "燕"
        },
        {
            "location": "53/TALK",
            "narrator": "神楽",
            "text": "もう電車にしちゃって\nいいんじゃないですか？",
            "zh": "那干脆就选坐电车\n不挺好的吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "54/TALK",
            "narrator": "神楽",
            "text": "ひなこさん達も一緒なら、\n選択の幅が広がると\n思いますし。",
            "zh": "有雏她们一起的话，\n我觉得选择的余地\n也会更广一些。",
            "narrator_zh": "神乐"
        },
        {
            "location": "57/TALK",
            "narrator": "つばめ",
            "text": "う～ん…。",
            "zh": "唔～嗯……",
            "narrator_zh": "燕"
        },
        {
            "location": "59/TALK",
            "narrator": "ガブリエラ",
            "text": "…あたしも、いい加減\n何か決めないと。",
            "zh": "……我也差不多\n该做个决定了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "71/TALK",
            "narrator": "ガブリエラ",
            "text": "$marzanna$、今日の予定をどうするか考えてるんだけど",
            "zh": "$marzanna$，我在想今天的安排该怎么定",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "72/TALK",
            "narrator": "ガブリエラ",
            "text": "中々思いつかなくて困ってるの",
            "zh": "可半天想不出个头绪，真头疼",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "74/SEL",
            "narrator": "",
            "text": "行きたいところはないの？",
            "zh": "没有什么想去的地方吗？",
            "narrator_zh": ""
        },
        {
            "location": "75/ACT",
            "narrator": "",
            "text": "行きたいところはないの？",
            "zh": "没有什么想去的地方吗？",
            "narrator_zh": ""
        },
        {
            "location": "77/TALK",
            "narrator": "ガブリエラ",
            "text": "この辺りって、どういうものがあるのかよくわかってないから",
            "zh": "这一带到底有些什么，我也不太清楚",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "78/TALK",
            "narrator": "ガブリエラ",
            "text": "どこに行きたいか考えようがないのよ",
            "zh": "根本无从下手去想该去哪里啊",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "79/TALK",
            "narrator": "ガブリエラ",
            "text": "もう、これならアーヤと一緒にショッピングモール行った方がいいかしら？",
            "zh": "哎呀，这样的话干脆跟绫水一起去购物中心是不是比较好？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "81/SEL",
            "narrator": "",
            "text": "それでいいんじゃない？",
            "zh": "那样不挺好的吗？",
            "narrator_zh": ""
        },
        {
            "location": "82/SEL",
            "narrator": "",
            "text": "近くに何かないの？",
            "zh": "这附近没有什么好玩的地方吗？",
            "narrator_zh": ""
        },
        {
            "location": "83/ACT",
            "narrator": "",
            "text": "それでいいんじゃない？",
            "zh": "那样不挺好的吗？",
            "narrator_zh": ""
        },
        {
            "location": "84/TALK",
            "narrator": "ガブリエラ",
            "text": "そうね…",
            "zh": "也是呢……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "85/TALK",
            "narrator": "ガブリエラ",
            "text": "ショッピングモールなら、色々施設もあるから楽しめそうだし",
            "zh": "购物中心的话，里面各种设施都有，应该能逛得很开心",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "86/TALK",
            "narrator": "ガブリエラ",
            "text": "そうしてみるわ",
            "zh": "那就这么办吧",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "98/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤ、あたしも一緒に\n行くから、ちょっと\n待ってて。",
            "zh": "绫水，我也一起\n去，稍微\n等我一下。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "117/TALK",
            "narrator": "ガブリエラ",
            "text": "あっ、あそこの帽子、\n可愛くて良さそうじゃ\nない？",
            "zh": "啊，那边的帽子，\n又可爱又不错\n对吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "120/TALK",
            "narrator": "アーヤ",
            "text": "あら、いいじゃない。\n形も可愛いし、それに\n凄く涼しげな感じで。",
            "zh": "哎呀，挺好嘛。\n版型很可爱，而且\n看着特别凉快。",
            "narrator_zh": "绫水"
        },
        {
            "location": "123/TALK",
            "narrator": "ガブリエラ",
            "text": "今持ってる服と\n合わせるのが難しそう\nだけど、う～ん…。",
            "zh": "不过感觉跟我现在\n带着的衣服不太好搭，\n唔～嗯……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "124/TALK",
            "narrator": "アーヤ",
            "text": "なら、服も一緒に\n買ったら？",
            "zh": "那干脆把衣服也\n一起买了吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "126/TALK",
            "narrator": "ガブリエラ",
            "text": "あんまり荷物増やしたら、\n帰る時大変でしょ？",
            "zh": "行李弄得太多的话，\n回去的时候会很麻烦吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "127/TALK",
            "narrator": "アーヤ",
            "text": "一着や二着増えても\n変わらないって。",
            "zh": "多一两件衣服\n也差不了多少啦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "129/TALK",
            "narrator": "ガブリエラ",
            "text": "そうかもしれないけど…。",
            "zh": "话是这么说没错……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "131/TALK",
            "narrator": "ガブリエラ",
            "text": "っていうか、アーヤは\nちょっと買い過ぎだから。",
            "zh": "话说回来，绫水你\n也买得太夸张了吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "134/TALK",
            "narrator": "アーヤ",
            "text": "仕方ないじゃない。\n素敵だな、って\n思っちゃったんだから。",
            "zh": "那也没办法嘛。\n因为看到就觉得\n真不错啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "135/TALK",
            "narrator": "アーヤ",
            "text": "そう思ったら買わないと、\n後で絶対後悔するわ。",
            "zh": "既然这么想却不买的话，\n事后绝对会后悔的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "137/TALK",
            "narrator": "ガブリエラ",
            "text": "…帰り、大荷物になっても\n手伝わないわよ？",
            "zh": "……回去要是大包小包提不动，\n我可不帮你拿哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "140/TALK",
            "narrator": "アーヤ",
            "text": "平気よ。\n荷物は宅急便で寮まで\n送るつもりだし。",
            "zh": "没事的。\n我打算把行李用宅急便\n直接寄回宿舍。",
            "narrator_zh": "绫水"
        },
        {
            "location": "142/TALK",
            "narrator": "ガブリエラ",
            "text": "…旅慣れてる感じが\n凄いわね。",
            "zh": "……你这出门旅行的熟练感\n也太强了吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "143/TALK",
            "narrator": "ガブリエラ",
            "text": "っていうか、\nそろそろお昼じゃん。",
            "zh": "话说回来，\n都快到中午了吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "145/TALK",
            "narrator": "ガブリエラ",
            "text": "買い物は中断して\nお昼ご飯にしよ。",
            "zh": "先暂停逛街，\n去吃午饭吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "162/TALK",
            "narrator": "アーヤ",
            "text": "あー、楽しかった！\nギャヴィはどうだった？",
            "zh": "啊—，太开心了！\n加维觉得怎么样？",
            "narrator_zh": "绫水"
        },
        {
            "location": "163/TALK",
            "narrator": "ガブリエラ",
            "text": "うん、楽しかったわ。",
            "zh": "嗯，挺开心的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "165/TALK",
            "narrator": "ガブリエラ",
            "text": "ショッピングモールって、\nどこも変わり映えしない\nだろうから――",
            "zh": "我原本以为购物中心\n不管哪家应该都\n大同小异——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "166/TALK",
            "narrator": "ガブリエラ",
            "text": "最初は暇潰しくらいに\nなればいいかな、って\n思ってたんだけど――",
            "zh": "一开始还想着\n能打发下时间\n就算不错了——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "167/TALK",
            "narrator": "ガブリエラ",
            "text": "おもいっきり一日中\n楽しんじゃった。",
            "zh": "结果硬是痛痛快快地\n玩了一整天呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "169/TALK",
            "narrator": "アーヤ",
            "text": "ふふっ…久しぶりに\n都会っぽい空気に\n触れたからかしらね？",
            "zh": "呵呵……大概是因为\n久违地呼吸到了\n都市感的气息吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "170/TALK",
            "narrator": "ガブリエラ",
            "text": "うん、そうかも。",
            "zh": "嗯，说不定真是这样。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "172/TALK",
            "narrator": "ガブリエラ",
            "text": "ここも凄く素敵で、\nいいところだと\n思うけど――",
            "zh": "虽然这里也非常棒，\n我觉得是个\n很好的地方——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "173/TALK",
            "narrator": "ガブリエラ",
            "text": "そろそろ東京にも\n戻りたいな…。",
            "zh": "但差不多也想\n回东京了呢……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "174/ACT",
            "narrator": "",
            "text": "近くに何かないの？",
            "zh": "这附近没有什么好玩的地方吗？",
            "narrator_zh": ""
        },
        {
            "location": "176/TALK",
            "narrator": "ガブリエラ",
            "text": "海くらいしかないと思うけど",
            "zh": "我觉得除了海以外就没别的了吧",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "177/TALK",
            "narrator": "ガブリエラ",
            "text": "あ、でも確か",
            "zh": "啊，不过我记得",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "178/TALK",
            "narrator": "ガブリエラ",
            "text": "駅前に何か看板があったような…",
            "zh": "车站前面好像有个什么招牌……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "190/TALK",
            "narrator": "ガブリエラ",
            "text": "ねえ、確か駅前に、\n何かの看板があったと\n思ったんだけど…。",
            "zh": "我说，我记得车站前面，\n是不是有个写着什么的\n招牌来着……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "193/TALK",
            "narrator": "つばめ",
            "text": "看板？",
            "zh": "招牌？",
            "narrator_zh": "燕"
        },
        {
            "location": "195/TALK",
            "narrator": "つばめ",
            "text": "あっ、そういえば！\n確かあれは――",
            "zh": "啊，这么说起来！\n我记得那个好像是——",
            "narrator_zh": "燕"
        },
        {
            "location": "214/TALK",
            "narrator": "ガブリエラ",
            "text": "か、可愛い！！\nほら、つばめ、神楽！\nあれ見て、あれ！",
            "zh": "好、好可爱！！\n快看，燕，神乐！\n看那边，看那个！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "216/TALK",
            "narrator": "神楽",
            "text": "ちゃんと見てますよー。\n可愛いペンギンですね。",
            "zh": "我有在好好看啦—。\n真是可爱的企鹅呢。",
            "narrator_zh": "神乐"
        },
        {
            "location": "218/TALK",
            "narrator": "つばめ",
            "text": "あはは、手がピコピコ\n動いてる。",
            "zh": "啊哈哈，小手在一抖一抖地\n动着呢。",
            "narrator_zh": "燕"
        },
        {
            "location": "220/TALK",
            "narrator": "ガブリエラ",
            "text": "あの手の動き、\n超可愛いんだけど！？",
            "zh": "它那个小手挥动的样子，\n未免也太可爱了吧！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "222/TALK",
            "narrator": "ガブリエラ",
            "text": "いいなぁ…\nペンギン飼いたいなぁ…。",
            "zh": "真好啊……\n好想养一只企鹅啊……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "224/TALK",
            "narrator": "つばめ",
            "text": "ふふっ…ガブちゃん、\n凄く楽しんでるね。",
            "zh": "呵呵……加布，\n玩得好开心呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "226/TALK",
            "narrator": "神楽",
            "text": "ガブちゃんがあんなに\n無邪気な笑顔をしている\nところ――",
            "zh": "加布露出那样\n天真无邪的笑容的\n样子——",
            "narrator_zh": "神乐"
        },
        {
            "location": "227/TALK",
            "narrator": "神楽",
            "text": "私、初めて見ました。",
            "zh": "我还是第一次见到。",
            "narrator_zh": "神乐"
        },
        {
            "location": "228/TALK",
            "narrator": "ガブリエラ",
            "text": "いいなぁ…実家の近くに\nこんな水族館がある\nなんて…。",
            "zh": "真好啊……老家附近\n竟然有这么棒的\n水族馆……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "230/TALK",
            "narrator": "ガブリエラ",
            "text": "やっぱり、みやびも\nここにはよく来てたの\nかしら？",
            "zh": "雅以前应该也\n经常来这里玩\n对吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "233/TALK",
            "narrator": "つばめ",
            "text": "う～ん…どうかなぁ？\nあんまりイメージ\nわかないけど…。",
            "zh": "唔～嗯……怎么样呢？\n虽然不太能想象\n那个画面就是了……",
            "narrator_zh": "燕"
        },
        {
            "location": "235/TALK",
            "narrator": "神楽",
            "text": "みやびさん、外出と\n人混みが大嫌いです\nからね…。",
            "zh": "毕竟雅非常讨厌\n出门和人多的地方\n嘛……",
            "narrator_zh": "神乐"
        },
        {
            "location": "245/TALK",
            "narrator": "みやび",
            "text": "…っくしゅん！",
            "zh": "……阿嚏！",
            "narrator_zh": "雅"
        },
        {
            "location": "246/SEL",
            "narrator": "",
            "text": "近くに水族館があって良いね",
            "zh": "附近有水族馆真不错呢",
            "narrator_zh": ""
        },
        {
            "location": "249/TALK",
            "narrator": "みやび",
            "text": "…夏風邪か？\nいや、体調はどこも\n悪くないき――",
            "zh": "……夏天感冒了吗？\n不对，身体哪儿都\n没不舒服嘛——",
            "narrator_zh": "雅"
        },
        {
            "location": "250/TALK",
            "narrator": "みやび",
            "text": "噂でもされゆうが？",
            "zh": "难道是有人在念叨我喃？",
            "narrator_zh": "雅"
        },
        {
            "location": "253/TALK",
            "narrator": "みやび",
            "text": "…一応、風邪薬飲んで\nおくか。",
            "zh": "……保险起见，还是吃颗\n感冒药吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "254/ACT",
            "narrator": "",
            "text": "近くに水族館があって良いね",
            "zh": "附近有水族馆真不错呢",
            "narrator_zh": ""
        },
        {
            "location": "273/TALK",
            "narrator": "みやび",
            "text": "ああ、あそこの水族館か",
            "zh": "哦，那边那个水族馆啊",
            "narrator_zh": "雅"
        },
        {
            "location": "274/TALK",
            "narrator": "みやび",
            "text": "行ったことないからわからんよ",
            "zh": "没去过，不晓得咯",
            "narrator_zh": "雅"
        },
        {
            "location": "20/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>8月20日　 10:34 AM</color>\n合宿中、みやびの実家でのこと",
            "zh": "<color=green>8月20日　 10:34 AM</color>\n合宿期间，在雅的老家",
