{
    "dir": "chap13/daydra/dd_ch03_13_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "13352",
        "cid": "gabriella",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "図書館で勉強",
        "title_zh": "Extra002 额外剧情",
        "sub_title_zh": "在图书馆学习"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "図書館で勉強",
            "zh": "在图书馆学习",
            "narrator_zh": ""
        },
        {
            "location": "29/TALK",
            "narrator": "雛",
            "text": "そっかぁ…。\nそれはショックだねー。",
            "zh": "这样啊……\n那确实挺受打击的呢—。",
            "narrator_zh": "雏"
        },
        {
            "location": "31/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…本当にショックよ。",
            "zh": "唉……真是备受打击。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "32/TALK",
            "narrator": "ガブリエラ",
            "text": "テストで７０点台なんて、\n生まれて初めてだわ。",
            "zh": "考试才拿七十多分，\n我长这么大还是头一次。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "34/TALK",
            "narrator": "繭",
            "text": "平均点より上だけど、\n良くも悪くもない\n微妙な点ね。",
            "zh": "虽然高过平均分了，\n但也算不上好，\n是个不上不下的分数呢。",
            "narrator_zh": "茧"
        },
        {
            "location": "36/TALK",
            "narrator": "ガブリエラ",
            "text": "微妙言うな！\n普段は９０点より下は\n絶対取らないんだから！",
            "zh": "别说不上不下！\n我平时可是绝对不会\n考到九十分以下的！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "38/TALK",
            "narrator": "つばめ",
            "text": "具合でも悪かったの？",
            "zh": "是不是身体不舒服呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "39/TALK",
            "narrator": "ガブリエラ",
            "text": "…そうじゃないわ。",
            "zh": "……并不是那样。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "40/TALK",
            "narrator": "ガブリエラ",
            "text": "ただ…とっくに勉強した\nところだから、甘く見て\n勉強しなかったのよ。",
            "zh": "只是……因为是早就学过的\n内容，一时大意\n就没去复习。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "41/TALK",
            "narrator": "雛",
            "text": "テスト前に勉強しな\nかったの！？\n勇気あるなぁ…。",
            "zh": "考前居然完全没复习\n吗！？\n真有勇气啊……。",
            "narrator_zh": "雏"
        },
        {
            "location": "42/TALK",
            "narrator": "繭",
            "text": "復習くらいはしておく\nべきだったと思う。",
            "zh": "我觉得至少还是应该\n稍微复习一下的。",
            "narrator_zh": "茧"
        },
        {
            "location": "46/TALK",
            "narrator": "ガブリエラ",
            "text": "ぐっ…そ、そうね…。",
            "zh": "唔……说、说得对……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "47/TALK",
            "narrator": "ガブリエラ",
            "text": "甘く見過ぎてたのは\n事実なんだし…。",
            "zh": "太掉以轻心确实是\n事实嘛……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "49/TALK",
            "narrator": "つばめ",
            "text": "ガブちゃん…。",
            "zh": "加布……。",
            "narrator_zh": "燕"
        },
        {
            "location": "50/TALK",
            "narrator": "つばめ",
            "text": "そうだ！\nそれならわたしが\n勉強を教えるよ。",
            "zh": "对了！\n既然这样，那由我来\n教你学习吧。",
            "narrator_zh": "燕"
        },
        {
            "location": "53/TALK",
            "narrator": "ガブリエラ",
            "text": "えっ！？\nいや、別にいいって。",
            "zh": "哎！？\n不，倒也不用啦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "55/TALK",
            "narrator": "つばめ",
            "text": "遠慮しなくていいのに。",
            "zh": "不用客气的啦。",
            "narrator_zh": "燕"
        },
        {
            "location": "57/TALK",
            "narrator": "ガブリエラ",
            "text": "そうじゃなくてさ…\nつばめじゃ頼りない、って\nいうか…。",
            "zh": "不是客气不客气……\n怎么说呢，总觉得燕\n不太靠得住……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "62/TALK",
            "narrator": "つばめ",
            "text": "ガーンッ！",
            "zh": "晴天霹雳！",
            "narrator_zh": "燕"
        },
        {
            "location": "64/TALK",
            "narrator": "ガブリエラ",
            "text": "そ、そんなショック\n受けないでよ！\n冗談だってば…。",
            "zh": "别、别受这么大\n打击呀！\n我开玩笑的啦……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "65/TALK",
            "narrator": "ガブリエラ",
            "text": "それに、軽く復習する程度\nだから、教わるようなこと\nでもないし…。",
            "zh": "再说，只是随便复习\n一下的程度，也没必要\n专门让人教啦……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "66/TALK",
            "narrator": "ガブリエラ",
            "text": "っていうか、つばめの\n成績はどうなの？",
            "zh": "话说回来，燕你的\n成绩怎么样？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "69/TALK",
            "narrator": "つばめ",
            "text": "え、えっと…\nどうにか平均点は\nキープしてる感じ、かな？",
            "zh": "这、这个嘛……\n大概就是勉强维持在\n平均分左右的感觉，吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "70/TALK",
            "narrator": "ガブリエラ",
            "text": "…前言撤回。\nやっぱ頼りないわ。",
            "zh": "……收回前言。\n果然不太靠得住。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "72/TALK",
            "narrator": "つばめ",
            "text": "二回も言われた！？",
            "zh": "居然被说了两次！？",
            "narrator_zh": "燕"
        },
        {
            "location": "73/TALK",
            "narrator": "雛",
            "text": "あはは…でも、あたしも\n正直、数学で心配な\nところがあるんだよねー。",
            "zh": "啊哈哈……不过说实话，\n我数学也有好些\n放心不下的地方呢—。",
            "narrator_zh": "雏"
        },
        {
            "location": "75/TALK",
            "narrator": "雛",
            "text": "だからさ、提案！",
            "zh": "所以，我有个提议！",
            "narrator_zh": "雏"
        },
        {
            "location": "76/TALK",
            "narrator": "雛",
            "text": "今日の放課後、みんなで\n勉強会しない？",
            "zh": "今天放学后，大家一起\n开个学习会怎么样？",
            "narrator_zh": "雏"
        },
        {
            "location": "78/TALK",
            "narrator": "つばめ",
            "text": "わぁ、それ賛成！\nみんなとならお勉強も\n捗りそうだよ。",
            "zh": "哇，我赞成！\n和大家一起的话，学习\n好像也能更有干劲哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "79/TALK",
            "narrator": "繭",
            "text": "勉強会って、集まる名目で\n実際に勉強するための\nものじゃないと思ってた。",
            "zh": "我还以为所谓学习会，\n只是把大家聚在一起的名义，\n并不是真为了学习呢。",
            "narrator_zh": "茧"
        },
        {
            "location": "81/TALK",
            "narrator": "雛",
            "text": "そんなことないよー。",
            "zh": "才没这回事呢—。",
            "narrator_zh": "雏"
        },
        {
            "location": "83/TALK",
            "narrator": "雛",
            "text": "だからさ、今日の放課後は\nみんな時間作っといてね！",
            "zh": "所以啦，今天放学后\n大家都要把时间空出来哦！",
            "narrator_zh": "雏"
        },
        {
            "location": "84/TALK",
            "narrator": "つばめ",
            "text": "うん。\nガブちゃんも来れるよね？",
            "zh": "嗯。\n加布也能来的吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "86/TALK",
            "narrator": "ガブリエラ",
            "text": "そ、そうね…。\nまあ、マジメにやるって\n約束するなら――",
            "zh": "这、这样啊……。\n好吧，要是你们答应\n认真学的话——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "87/TALK",
            "narrator": "ガブリエラ",
            "text": "行ってもいいかも。",
            "zh": "去一趟倒也不是不行。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "88/TALK",
            "narrator": "つばめ",
            "text": "じゃあ、決まりだね！",
            "zh": "那就这么定了！",
            "narrator_zh": "燕"
        },
        {
            "location": "90/TALK",
            "narrator": "ガブリエラ",
            "text": "…ふふっ、勉強会かぁ。",
            "zh": "……呼呼，学习会啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "91/TALK",
            "narrator": "ガブリエラ",
            "text": "一度もしたことないから、\nずっと憧れてたのよね。",
            "zh": "以前一次都没参加过，\n一直很向往呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "93/TALK",
            "narrator": "つばめ",
            "text": "あ、でも場所は\nどこにする？",
            "zh": "啊，不过地点\n定在哪里呢？",
            "narrator_zh": "燕"
        },
        {
            "location": "94/TALK",
            "narrator": "つばめ",
            "text": "教室は、遅くまで残って\n遊んでる人達がいると\n思うし…。",
            "zh": "教室的话，放学后应该\n还有不少人留下来玩，\n会比较吵吧……。",
            "narrator_zh": "燕"
        },
        {
            "location": "95/SEL",
            "narrator": "",
            "text": "誰かの家でやろう",
            "zh": "去谁家里吧",
            "narrator_zh": ""
        },
        {
            "location": "96/SEL",
            "narrator": "",
            "text": "カフェじゃない？",
            "zh": "去咖啡厅吧？",
            "narrator_zh": ""
        },
        {
            "location": "97/SEL",
            "narrator": "",
            "text": "図書室こそ王道！",
            "zh": "图书室才是王道！",
            "narrator_zh": ""
        },
        {
            "location": "101/TALK",
            "narrator": "雛",
            "text": "う～ん…どこにしよっか？",
            "zh": "嗯～……选哪里好呢？",
            "narrator_zh": "雏"
        },
        {
            "location": "102/TALK",
            "narrator": "雛",
            "text": "あたしの家は、\n狭いから無理だし…。",
            "zh": "我家太窄了，\n肯定不行……。",
            "narrator_zh": "雏"
        },
        {
            "location": "104/TALK",
            "narrator": "雛",
            "text": "そうだ、まゆちんの家は？",
            "zh": "对了，小茧家呢？",
            "narrator_zh": "雏"
        },
        {
            "location": "105/TALK",
            "narrator": "繭",
            "text": "うるさい兄弟達が\n乱入して大騒ぎになること\n確実だけど？",
            "zh": "那群吵死人的兄弟\n肯定会闯进来闹翻天，\n你确定？",
            "narrator_zh": "茧"
        },
        {
            "location": "109/TALK",
            "narrator": "つばめ",
            "text": "それじゃあ、わたしの\n部屋はどうかな？",
            "zh": "那这样的话，去我的\n房间怎么样？",
            "narrator_zh": "燕"
        },
        {
            "location": "110/TALK",
            "narrator": "つばめ",
            "text": "静かだし、十分広いから、\nお勉強するのには\n困らないと思うの。",
            "zh": "既安静又足够宽敞，\n用来学习的话\n应该完全没问题。",
            "narrator_zh": "燕"
        },
        {
            "location": "111/TALK",
            "narrator": "雛",
            "text": "えっ、いいの？",
            "zh": "哎，可以吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "113/TALK",
            "narrator": "つばめ",
            "text": "もちろん。\nひなこちゃんとまゆちんが\n良ければだけど。",
            "zh": "当然。\n只要雏和小茧觉得\n没问题就行。",
            "narrator_zh": "燕"
        },
        {
            "location": "114/TALK",
            "narrator": "雛",
            "text": "ないない、問題なしだよ。\nあたしもまゆちんもね。",
            "zh": "没问题没问题，完全OK。\n我和小茧都没意见对吧。",
            "narrator_zh": "雏"
        },
        {
            "location": "115/TALK",
            "narrator": "繭",
            "text": "まだ何も言ってないけど？",
            "zh": "我可还什么都没说呢？",
            "narrator_zh": "茧"
        },
        {
            "location": "116/TALK",
            "narrator": "雛",
            "text": "言わなくたってわかるよ。\nあたし達の仲じゃん。",
            "zh": "不用说我也懂啦。\n咱们可是这种交情嘛。",
            "narrator_zh": "雏"
        },
        {
            "location": "118/TALK",
            "narrator": "繭",
            "text": "…うざっ。\nでも、私もそれでいいわ。",
            "zh": "……真烦人。\n不过，我也觉得这样行。",
            "narrator_zh": "茧"
        },
        {
            "location": "119/TALK",
            "narrator": "雛",
            "text": "じゃあ、お菓子買って\nつばめちゃんの部屋に\n集合だね。",
            "zh": "那买好零食，\n就在燕的房间\n集合啦。",
            "narrator_zh": "雏"
        },
        {
            "location": "121/TALK",
            "narrator": "つばめ",
            "text": "ガブちゃんも、\nわたしの部屋でいい？",
            "zh": "加布也觉得，\n去我房间可以吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "123/TALK",
            "narrator": "ガブリエラ",
            "text": "え、ええ…\nそれで構わないわ。",
            "zh": "嗯、嗯……\n我没意见。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "125/TALK",
            "narrator": "ガブリエラ",
            "text": "うわぁ、お菓子持ち寄る\n勉強会って、アニメとかで\n見たことあるわ。",
            "zh": "哇啊，大家各自带零食\n去开学习会，我在动画里\n看见过这种情节呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "127/TALK",
            "narrator": "ガブリエラ",
            "text": "何だか凄く楽しく\n勉強できそう！",
            "zh": "总觉得能非常开心地\n好好学习！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "128/TALK",
            "narrator": "ガブリエラ",
            "text": "早く放課後に\nならないかなぁ？",
            "zh": "好想快点到\n放学时间呀？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "149/TALK",
            "narrator": "雛",
            "text": "…うわっ！？\nもう八時過ぎてる！",
            "zh": "……哇！？\n都已经过八点了！",
            "narrator_zh": "雏"
        },
        {
            "location": "151/TALK",
            "narrator": "ガブリエラ",
            "text": "えっ、もうそんな時間？",
            "zh": "哎，已经这么晚了？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "153/TALK",
            "narrator": "つばめ",
            "text": "まだ問題集、一ページも\nやれてないのに…。",
            "zh": "习题集明明连一页\n都还没写完呢……。",
            "narrator_zh": "燕"
        },
        {
            "location": "154/TALK",
            "narrator": "繭",
            "text": "…わかりきった結果\n過ぎて、呆れるわ。",
            "zh": "……简直是意料之中的\n结果，让人无语。",
            "narrator_zh": "茧"
        },
        {
            "location": "156/TALK",
            "narrator": "雛",
            "text": "もぉ、またそういうこと\n言ってー！",
            "zh": "真是的，又说这种\n风凉话—！",
            "narrator_zh": "雏"
        },
        {
            "location": "157/TALK",
            "narrator": "雛",
            "text": "まゆちんだって、\n全然問題集進めて\nないじゃん！",
            "zh": "小茧你不也一样，\n习题集根本一丁点儿\n都没动嘛！",
            "narrator_zh": "雏"
        },
        {
            "location": "158/TALK",
            "narrator": "つばめ",
            "text": "…勉強会で集まったはず\nなのに、つい遊んじゃった\nもんね。",
            "zh": "……明明是为了学习会\n才聚在一起的，结果\n不知不觉就玩起来了呢。",
            "narrator_zh": "燕"
        },
        {
            "location": "160/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…全然復習できな\nかったわ。",
            "zh": "唉……完全没能\n复习成啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "162/TALK",
            "narrator": "つばめ",
            "text": "ごめんね、ガブちゃん。\n勉強教えられなくて…。",
            "zh": "对不起哦，加布。\n没能教你学习……。",
            "narrator_zh": "燕"
        },
        {
            "location": "165/TALK",
            "narrator": "ガブリエラ",
            "text": "…別に、謝らなくても\nいいわよ。",
            "zh": "……倒也不用\n特意道歉啦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "166/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしも、お喋りしたり\n遊んだりしちゃったし――",
            "zh": "我自己也跟着聊天、\n玩得挺开心的——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "168/TALK",
            "narrator": "ガブリエラ",
            "text": "それに…勉強会って、\n一度してみたかったから、\n嬉しかったし…。",
            "zh": "而且……学习会什么的，\n我一直都很想试一次，\n所以还挺开心的……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "170/TALK",
            "narrator": "つばめ",
            "text": "…そうだったんだ？",
            "zh": "……原来是这样呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "171/TALK",
            "narrator": "雛",
            "text": "お勉強会は失敗しちゃった\nけど、ガブリエラちゃんが\n喜んでくれたし――",
            "zh": "虽然学习会没开成，\n不过加布里埃拉\n觉得开心了嘛——",
            "narrator_zh": "雏"
        },
        {
            "location": "172/TALK",
            "narrator": "雛",
            "text": "今回は、それでＯＫ、って\nことでいいんじゃない？",
            "zh": "这次就算OK，\n这样不也挺好的嘛？",
            "narrator_zh": "雏"
        },
        {
            "location": "174/TALK",
            "narrator": "繭",
            "text": "貴方が言うのには\n納得できないけど――",
            "zh": "从你嘴里说出来\n实在让人服气不了——",
            "narrator_zh": "茧"
        },
        {
            "location": "175/TALK",
            "narrator": "繭",
            "text": "まあ、今日くらいは\nそれでいいと思う。",
            "zh": "算了，也就今天一次，\n这样也行吧。",
            "narrator_zh": "茧"
        },
        {
            "location": "177/TALK",
            "narrator": "つばめ",
            "text": "よかったね、ガブちゃん。",
            "zh": "太好了呢，加布。",
            "narrator_zh": "燕"
        },
        {
            "location": "179/TALK",
            "narrator": "ガブリエラ",
            "text": "ええ…いい気分転換にも\nなったし――",
            "zh": "嗯……也算是好好\n转换了一下心情——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "180/TALK",
            "narrator": "ガブリエラ",
            "text": "今夜は、いつもより\n集中して勉強できそう\nだわ。",
            "zh": "今晚感觉能比平时\n更集中精力\n学习了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "181/TALK",
            "narrator": "つばめ",
            "text": "えぇっ！？\nまだやるの！？",
            "zh": "哎哎！？\n还要学呀！？",
            "narrator_zh": "燕"
        },
        {
            "location": "182/TALK",
            "narrator": "ガブリエラ",
            "text": "まだも何も、遊んじゃって\nほとんどやってないじゃ\nない。",
            "zh": "什么叫还要，刚才光顾着玩\n几乎什么都没学\n不是吗。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "183/TALK",
            "narrator": "ガブリエラ",
            "text": "勉強会で遊んだ以上、\nその分ちゃんと勉強\nしなきゃダメでしょ？",
            "zh": "既然在学习会上玩了，\n那份量就得好好补回来\n才行吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "184/TALK",
            "narrator": "繭",
            "text": "…こういうところで、\n優秀かそうでないかの\n違いが出るのか…。",
            "zh": "……优秀的孩子和普通人\n之间的差距，原来就\n体现在这种地方吗……。",
            "narrator_zh": "茧"
        },
        {
            "location": "187/TALK",
            "narrator": "つばめ",
            "text": "…わたしも、今夜は\nちょっと遅くまで\n勉強しようかな？",
            "zh": "……那我今晚也\n稍微熬点夜\n学习一下好了？",
            "narrator_zh": "燕"
        },
        {
            "location": "189/TALK",
            "narrator": "雛",
            "text": "うん…一応あたし達、\nガブリエラちゃんより\n先輩なんだから――",
            "zh": "嗯……不管怎么说，\n我们好歹也比加布里埃拉\n高一届嘛——",
            "narrator_zh": "雏"
        },
        {
            "location": "190/TALK",
            "narrator": "雛",
            "text": "負けてられないもんね。",
            "zh": "可不能输给她呢。",
            "narrator_zh": "雏"
        },
        {
            "location": "192/ACT",
            "narrator": "",
            "text": "誰かの家でやろう",
            "zh": "去谁家里吧",
            "narrator_zh": ""
        },
        {
            "location": "211/TALK",
            "narrator": "ガブリエラ",
            "text": "さすがはマルザンナ、わかってるわね",
            "zh": "不愧是玛尔赞娜，真懂行呀",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "212/TALK",
            "narrator": "ガブリエラ",
            "text": "お勉強会といえば、誰かの家にお菓子を持ち寄って\nするものよ",
            "zh": "说到学习会，就是要去谁家里\n各自带零食一起学才对嘛",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "213/TALK",
            "narrator": "ガブリエラ",
            "text": "そうじゃなかったら、\n面白くないわ",
            "zh": "要不是那样，\n可就没什么意思了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "225/TALK",
            "narrator": "ガブリエラ",
            "text": "それじゃ、誰かの家に――",
            "zh": "那就去谁家里——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "226/TALK",
            "narrator": "雛",
            "text": "そうだ！\nガブリエラちゃんの\n部屋ってダメかな？",
            "zh": "对了！\n去加布里埃拉的\n房间不行吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "228/TALK",
            "narrator": "ガブリエラ",
            "text": "あ、あたしの部屋！？",
            "zh": "我、我的房间！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "229/TALK",
            "narrator": "雛",
            "text": "うん。",
            "zh": "嗯。",
            "narrator_zh": "雏"
        },
        {
            "location": "230/TALK",
            "narrator": "雛",
            "text": "ガブリエラちゃんが\nどんな部屋で暮らしてる\nのか――",
            "zh": "加布里埃拉平时\n都住在什么样的\n房间里呢——",
            "narrator_zh": "雏"
        },
        {
            "location": "231/TALK",
            "narrator": "雛",
            "text": "ちょっと気になるんだー。",
            "zh": "我还有点好奇呢—。",
            "narrator_zh": "雏"
        },
        {
            "location": "233/TALK",
            "narrator": "ガブリエラ",
            "text": "だ、ダメよ！\nあたしの部屋は…。",
            "zh": "不、不行！\n我的房间……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "234/TALK",
            "narrator": "雛",
            "text": "どうして？",
            "zh": "为什么呀？",
            "narrator_zh": "雏"
        },
        {
            "location": "236/TALK",
            "narrator": "ガブリエラ",
            "text": "ど、どうしても！\n第一、急に言われても\n困るし…。",
            "zh": "说不行就是不行！\n再说，突然这么提出来\n我也很为难啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "237/TALK",
            "narrator": "つばめ",
            "text": "でも、わたしもちょっと\n入ってみたいな。",
            "zh": "不过，我也有点想\n进去看看呢。",
            "narrator_zh": "燕"
        },
        {
            "location": "238/TALK",
            "narrator": "つばめ",
            "text": "ガブちゃんの部屋って、\nわたしも入ったこと\nなかったし。",
            "zh": "加布的房间，\n连我也从来没进去\n看过呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "240/TALK",
            "narrator": "ガブリエラ",
            "text": "で、でも…。",
            "zh": "可、可是……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "241/TALK",
            "narrator": "ガブリエラ",
            "text": "あの部屋見たら、\n絶対引かれるか、\nからかわれるわ…。",
            "zh": "要是看到那个房间，\n你们肯定会觉得无语，\n或者拿我打趣的……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "242/TALK",
            "narrator": "ガブリエラ",
            "text": "メルヘン趣味、とか、\n似合わない、って…。",
            "zh": "说什么童话风爱好啦、\n和我不搭啦……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "243/TALK",
            "narrator": "雛",
            "text": "あ、もしかして、\n結構散らかってたり\nするのかなー？",
            "zh": "啊，难道说，\n房间里其实乱糟糟的\n不成—？",
            "narrator_zh": "雏"
        },
        {
            "location": "245/TALK",
            "narrator": "ガブリエラ",
            "text": "そんなわけないでしょ？\n整理整頓された部屋が\n好きなんだから。",
            "zh": "怎么可能啊？\n我最喜欢整理得\n井井有条的房间了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "246/TALK",
            "narrator": "繭",
            "text": "…あっ。",
            "zh": "……啊。",
            "narrator_zh": "茧"
        },
        {
            "location": "247/TALK",
            "narrator": "つばめ",
            "text": "どうしたの、まゆちん？",
            "zh": "怎么了，小茧？",
            "narrator_zh": "燕"
        },
        {
            "location": "249/TALK",
            "narrator": "繭",
            "text": "…もしかして、見られたら\nマズいようなものが\n置いてある…とか？",
            "zh": "……难道说，房间里放着\n什么一旦被人看见\n就会很麻烦的东西……之类的？",
            "narrator_zh": "茧"
        },
        {
            "location": "251/TALK",
            "narrator": "雛",
            "text": "…はっ！？",
            "zh": "……哈！？",
            "narrator_zh": "雏"
        },
        {
            "location": "252/TALK",
            "narrator": "雛",
            "text": "ガブリエラちゃん！\nまさか銃の不法所持とか\nしてるんじゃ…！？",
            "zh": "加布里埃拉！\n你该不会非法持有\n枪支之类的吧……！？",
            "narrator_zh": "雏"
        },
        {
            "location": "254/TALK",
            "narrator": "ガブリエラ",
            "text": "してない！\n法律に触れるような物、\n持ってないわよ。",
            "zh": "才没有！\n我可不会藏什么\n违法的东西。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "255/TALK",
            "narrator": "繭",
            "text": "…だとすると――",
            "zh": "……既然不是那样——",
            "narrator_zh": "茧"
        },
        {
            "location": "256/TALK",
            "narrator": "繭",
            "text": "あまり、他人を部屋に\n上げたくないタイプなの\nかも。",
            "zh": "那大概就是那种\n不太想让外人进自己\n房间的类型吧。",
            "narrator_zh": "茧"
        },
        {
            "location": "258/TALK",
            "narrator": "つばめ",
            "text": "そうなの？",
            "zh": "是这样吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "260/TALK",
            "narrator": "ガブリエラ",
            "text": "あ、えと、別にそういう\nわけじゃないけど…。",
            "zh": "啊、那个，倒也不是\n因为这个原因……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "261/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "263/TALK",
            "narrator": "ガブリエラ",
            "text": "…笑わない？",
            "zh": "……你们不会笑吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "264/TALK",
            "narrator": "雛",
            "text": "何が？",
            "zh": "笑什么？",
            "narrator_zh": "雏"
        },
        {
            "location": "267/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしの部屋…\n見ても笑わない？",
            "zh": "看了我的房间……\n不会笑话我吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "268/TALK",
            "narrator": "雛",
            "text": "うーん…面白い物が\n置いてあったら、\n笑うかもしれないけど――",
            "zh": "嗯……要是摆着什么\n好笑的东西，说不定\n会笑一下吧——",
            "narrator_zh": "雏"
        },
        {
            "location": "269/TALK",
            "narrator": "雛",
            "text": "そうじゃないなら、\n笑ったりしないよ。",
            "zh": "要是不是那样，\n我肯定不会笑的哦。",
            "narrator_zh": "雏"
        },
        {
            "location": "270/TALK",
            "narrator": "ガブリエラ",
            "text": "…本当？",
            "zh": "……真的？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "271/TALK",
            "narrator": "つばめ",
            "text": "約束するよ。\nガブちゃんの部屋見て、\n笑ったりしないから。",
            "zh": "我保证哦。\n绝对不会看了加布的房间\n就笑话你的。",
            "narrator_zh": "燕"
        },
        {
            "location": "272/TALK",
            "narrator": "繭",
            "text": "私を笑わせたいなら、\n全力で笑わせに来た方が\nいい。",
            "zh": "你要是真想逗我笑，\n那还不如全力来搞笑\n比较实在。",
            "narrator_zh": "茧"
        },
        {
            "location": "274/TALK",
            "narrator": "ガブリエラ",
            "text": "笑ってもらいたい\nわけじゃないんだけど…。",
            "zh": "我也不是想让你们\n笑啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "275/TALK",
            "narrator": "ガブリエラ",
            "text": "…それじゃあ、うちで\nしてもいいわ。",
            "zh": "……那好吧，去我家\n开学习会也行。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "277/TALK",
            "narrator": "つばめ",
            "text": "やった！\nありがと、ガブちゃん！",
            "zh": "太好了！\n谢谢你，加布！",
            "narrator_zh": "燕"
        },
        {
            "location": "278/TALK",
            "narrator": "雛",
            "text": "どんな部屋なんだろー？\nすっごく楽しみだよ！",
            "zh": "会是什么样的房间呢—？\n好期待呀！",
            "narrator_zh": "雏"
        },
        {
            "location": "279/TALK",
            "narrator": "ガブリエラ",
            "text": "目的間違えないでよ？",
            "zh": "可别忘了咱们去的目的是什么哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "299/TALK",
            "narrator": "ガブリエラ",
            "text": "…どうぞ、上がって。",
            "zh": "……请进吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "300/TALK",
            "narrator": "雛",
            "text": "お邪魔しまーす。",
            "zh": "打扰啦—。",
            "narrator_zh": "雏"
        },
        {
            "location": "301/TALK",
            "narrator": "つばめ",
            "text": "わぁ、ここがガブちゃんの\n部屋かぁ…。",
            "zh": "哇，这就是加布的\n房间呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "302/TALK",
            "narrator": "雛",
            "text": "うわっ、凄い！！\nあんなに人形があるよ。",
            "zh": "哇啊，好厉害！！\n摆了这么多玩偶呢。",
            "narrator_zh": "雏"
        },
        {
            "location": "303/TALK",
            "narrator": "繭",
            "text": "フランス人形？\n結構良い物みたいね。",
            "zh": "法式人偶？\n看起来品相都相当不错呢。",
            "narrator_zh": "茧"
        },
        {
            "location": "304/TALK",
            "narrator": "雛",
            "text": "ガブリエラちゃんって、\n意外とお人形が\n好きなんだ？",
            "zh": "原来加布里埃拉\n意外地很喜欢\n洋娃娃呀？",
            "narrator_zh": "雏"
        },
        {
            "location": "306/TALK",
            "narrator": "ガブリエラ",
            "text": "…悪かったわね、\n似合わなくて。",
            "zh": "……真不好意思啊，\n和我不太搭。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "309/TALK",
            "narrator": "雛",
            "text": "え？\n全然そんなことなくない？",
            "zh": "哎？\n完全不会不搭吧？",
            "narrator_zh": "雏"
        },
        {
            "location": "311/TALK",
            "narrator": "つばめ",
            "text": "うん、全然変じゃないよ。",
            "zh": "嗯，一点也不奇怪哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "312/TALK",
            "narrator": "つばめ",
            "text": "わたしだって、こういう\nお人形は可愛くて\n好きだし。",
            "zh": "就连我，也很喜欢\n这种可爱的\n洋娃娃呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "313/TALK",
            "narrator": "雛",
            "text": "あたしもこういう部屋に\n住みたいなー。",
            "zh": "我也好想住在这样的\n房间里呀—。",
            "narrator_zh": "雏"
        },
        {
            "location": "315/TALK",
            "narrator": "ガブリエラ",
            "text": "…あ、あれ？",
            "zh": "……哎、哎？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "317/TALK",
            "narrator": "ガブリエラ",
            "text": "…笑わないんだ？",
            "zh": "……你们不笑吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "318/TALK",
            "narrator": "つばめ",
            "text": "笑うところ、あるかな？",
            "zh": "这里有哪里好笑的吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "320/TALK",
            "narrator": "繭",
            "text": "むしろ、どこが笑われると\n思ったのか知りたい。",
            "zh": "我倒想反过来问问，\n你觉得哪里会被人笑。",
            "narrator_zh": "茧"
        },
        {
            "location": "321/TALK",
            "narrator": "繭",
            "text": "メルヘンな感じだけど、\nオシャレで良い部屋だと\n思う。",
            "zh": "虽然是有点童话风，\n但我觉得这房间既时髦\n又很不错啊。",
            "narrator_zh": "茧"
        },
        {
            "location": "324/TALK",
            "narrator": "ガブリエラ",
            "text": "…そっか。",
            "zh": "……这样啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "325/TALK",
            "narrator": "ガブリエラ",
            "text": "可愛い、か…。\nそんな部屋であたしが\n暮らしてても――",
            "zh": "可爱、吗……。\n就算我住在这样的\n房间里——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "326/TALK",
            "narrator": "ガブリエラ",
            "text": "変だとは思われないんだ。",
            "zh": "大家也不会觉得奇怪啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "328/TALK",
            "narrator": "ガブリエラ",
            "text": "…なんか、ちょっとだけ\n気が軽くなったかも。",
            "zh": "……总觉得，稍微\n松了口气呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "331/TALK",
            "narrator": "ガブリエラ",
            "text": "…さ、さあ、ほら！\nさっさと勉強始めるわよ！",
            "zh": "……好、好了，快点！\n赶紧开始学习吧！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "332/TALK",
            "narrator": "つばめ",
            "text": "ま、まだ到着したばかり\nなんだし、もう少しして\nからにしようよ…？",
            "zh": "我、我们才刚到不久，\n稍微歇一会儿再开始\n嘛……？",
            "narrator_zh": "燕"
        },
        {
            "location": "335/TALK",
            "narrator": "ガブリエラ",
            "text": "ダメよ。",
            "zh": "不行。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "336/TALK",
            "narrator": "ガブリエラ",
            "text": "やる以上はすぐにでも\n始めないと――",
            "zh": "既然要学就得马上\n开始才行——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "337/TALK",
            "narrator": "ガブリエラ",
            "text": "どんどん面倒になって、\n勉強する気なくなっ\nちゃうわ。",
            "zh": "不然越拖越觉得麻烦，\n最后就会不想\n学了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "338/TALK",
            "narrator": "雛",
            "text": "はぁ…真面目だねー。",
            "zh": "唉……真是认真呢—。",
            "narrator_zh": "雏"
        },
        {
            "location": "339/TALK",
            "narrator": "繭",
            "text": "だからこそ、\n優秀なんじゃない？",
            "zh": "正因如此，\n她才这么优秀吧？",
            "narrator_zh": "茧"
        },
        {
            "location": "340/ACT",
            "narrator": "",
            "text": "カフェじゃない？",
            "zh": "去咖啡厅吧？",
            "narrator_zh": ""
        },
        {
            "location": "359/TALK",
            "narrator": "ガブリエラ",
            "text": "放課後のカフェで勉強なんて、凄く素敵！",
            "zh": "放学后在咖啡厅学习什么的，听起来超棒的！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "360/TALK",
            "narrator": "ガブリエラ",
            "text": "みんなに提案してみるわ",
            "zh": "我去向大家提议看看",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "372/TALK",
            "narrator": "ガブリエラ",
            "text": "いつも行くカフェはどう？",
            "zh": "平时常去的那家咖啡厅怎么样？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "373/TALK",
            "narrator": "ガブリエラ",
            "text": "あそこなら、お茶しながら\n勉強できるし。",
            "zh": "去那里的话，可以一边喝茶\n一边学习。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "374/TALK",
            "narrator": "雛",
            "text": "おっ、それいいかも。",
            "zh": "哦，那好像不错。",
            "narrator_zh": "雏"
        },
        {
            "location": "375/TALK",
            "narrator": "雛",
            "text": "お茶だけじゃなくて、\nケーキで糖分補給も\nできるし。",
            "zh": "不光能喝茶，\n还能吃块蛋糕补充糖分\n呢。",
            "narrator_zh": "雏"
        },
        {
            "location": "376/TALK",
            "narrator": "つばめ",
            "text": "わぁ、カフェで勉強なんて\nオシャレだよぉ！",
            "zh": "哇，在咖啡厅学习\n好时髦呀！",
            "narrator_zh": "燕"
        },
        {
            "location": "377/TALK",
            "narrator": "つばめ",
            "text": "ちょっとドキドキして\nきちゃった。",
            "zh": "我都有点期待得\n心跳加速了。",
            "narrator_zh": "燕"
        },
        {
            "location": "379/TALK",
            "narrator": "ガブリエラ",
            "text": "じゃあ、決まりね。\n繭はどう？",
            "zh": "那就这么定了。\n茧觉得呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "380/TALK",
            "narrator": "繭",
            "text": "…ケーキは食べたいから、\nとりあえず賛成。",
            "zh": "……因为想吃蛋糕，\n姑且算我赞成。",
            "narrator_zh": "茧"
        },
        {
            "location": "381/TALK",
            "narrator": "繭",
            "text": "けど…。",
            "zh": "不过……。",
            "narrator_zh": "茧"
        },
        {
            "location": "382/TALK",
            "narrator": "雛",
            "text": "じゃあ、決まりだね。",
            "zh": "那就这么决定了呢。",
            "narrator_zh": "雏"
        },
        {
            "location": "383/TALK",
            "narrator": "つばめ",
            "text": "うん、早く放課後に\nならないかなぁ？",
            "zh": "嗯，好想快点到\n放学时间呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "385/TALK",
            "narrator": "繭",
            "text": "…あそこのカフェで、\n勉強できるのかしら？",
            "zh": "……那家咖啡厅，\n真的适合学习吗？",
            "narrator_zh": "茧"
        },
        {
            "location": "406/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…ぜんっぜん\n勉強なんてできな\nかったわ。",
            "zh": "唉……完完全全\n没法静下心来\n学习啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "409/TALK",
            "narrator": "つばめ",
            "text": "うん…そういう雰囲気じゃ\nなかったもんね？",
            "zh": "嗯……毕竟那里完全\n不是能学习的氛围呢？",
            "narrator_zh": "燕"
        },
        {
            "location": "411/TALK",
            "narrator": "繭",
            "text": "っていうか、明らかに\n選んだ店が間違い。",
            "zh": "说到底，明显是\n选错地方了。",
            "narrator_zh": "茧"
        },
        {
            "location": "412/TALK",
            "narrator": "繭",
            "text": "あのカフェは、\n騒がしいし人の出入りも\n激しいから――",
            "zh": "那家咖啡厅本来就吵，\n客人进进出出\n又很频繁——",
            "narrator_zh": "茧"
        },
        {
            "location": "413/TALK",
            "narrator": "繭",
            "text": "勉強で長時間居座るのは、\nまず無理。",
            "zh": "想在那里长时间坐着\n学习，基本是不可能的。",
            "narrator_zh": "茧"
        },
        {
            "location": "416/TALK",
            "narrator": "雛",
            "text": "それ、もっと早く\n言ってよ！",
            "zh": "那种事，你早点\n说出来呀！",
            "narrator_zh": "雏"
        },
        {
            "location": "417/TALK",
            "narrator": "繭",
            "text": "言おうとしたけど\n遮られたのよ。",
            "zh": "我正想说的时候\n被你们打断了嘛。",
            "narrator_zh": "茧"
        },
        {
            "location": "420/TALK",
            "narrator": "ガブリエラ",
            "text": "よく通ってるのに、\nそんな店だとはまったく\n気づかなかったわ。",
            "zh": "明明常去那家店，\n我却完全没注意到\n它是那种氛围。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "423/TALK",
            "narrator": "つばめ",
            "text": "いつもは勉強じゃなくて、\nお喋りしに行ってるから\nかもしれないね。",
            "zh": "平时去那里都不是为了学习，\n而是去聊天的，\n大概是因为这个吧。",
            "narrator_zh": "燕"
        },
        {
            "location": "424/TALK",
            "narrator": "繭",
            "text": "…もう少し、静かで\n長時間いても大丈夫な\n店を探した方が良い。",
            "zh": "……最好还是找一家\n更安静、就算久坐\n也没关系的店。",
            "narrator_zh": "茧"
        },
        {
            "location": "425/TALK",
            "narrator": "繭",
            "text": "店によっては、\n勉強ＮＧなところも\nあるみたいだけど…。",
            "zh": "不过听说也有些店\n是禁止在里面\n学习的……。",
            "narrator_zh": "茧"
        },
        {
            "location": "426/TALK",
            "narrator": "雛",
            "text": "そっかぁ…。\nそういうのダメな\nお店もあるのか…。",
            "zh": "这样啊……。\n还有不允许学习的\n店呀……。",
            "narrator_zh": "雏"
        },
        {
            "location": "427/TALK",
            "narrator": "繭",
            "text": "長時間居座られても、\n儲けにならなきゃ\n店側もやってられない。",
            "zh": "要是客人一直占着位子\n却赚不到钱，店家\n也撑不下去的。",
            "narrator_zh": "茧"
        },
        {
            "location": "430/TALK",
            "narrator": "ガブリエラ",
            "text": "外で勉強するのって、\n意外と難しいのね…。",
            "zh": "原来在外面学习，\n意外地挺不容易呢……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "432/TALK",
            "narrator": "つばめ",
            "text": "じゃあ、今度の勉強会は\nわたしの部屋でやろうよ。",
            "zh": "那下次开学习会，\n就去我房间吧。",
            "narrator_zh": "燕"
        },
        {
            "location": "433/TALK",
            "narrator": "つばめ",
            "text": "それなら静かだし、\n時間も気にしないで、\nじっくり勉強できるよ。",
            "zh": "那里既安静，\n也不用担心时间，\n可以踏踏实实地学哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "434/TALK",
            "narrator": "雛",
            "text": "いいね、そうしようよ！\nお菓子とかジュース、\n一杯買っていってさー！",
            "zh": "好呀，就这么办吧！\n多买些零食和果汁\n带过去—！",
            "narrator_zh": "雏"
        },
        {
            "location": "437/TALK",
            "narrator": "ガブリエラ",
            "text": "勉強より、飲み食いが\nメインになりそうで\n心配だわ。",
            "zh": "我有点担心到头来\n吃喝会变成主角，\n学习反倒成了顺便。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "438/TALK",
            "narrator": "ガブリエラ",
            "text": "…でも、それもちょっと\n楽しそうかも。",
            "zh": "……不过，那样好像也\n挺有意思的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "439/ACT",
            "narrator": "",
            "text": "図書室こそ王道",
            "zh": "图书室才是王道",
            "narrator_zh": ""
        },
        {
            "location": "459/TALK",
            "narrator": "ガブリエラ",
            "text": "マルザンナ、それじゃ５０点よ",
            "zh": "玛尔赞娜，那只能打50分哦",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "460/TALK",
            "narrator": "ガブリエラ",
            "text": "図書室での勉強会は、ラブコメ漫画の王道だから、私達にとってはそうじゃないわ",
            "zh": "在图书室开学习会，那是恋爱喜剧漫画里的王道，对我们来说可算不上",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "461/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、静かで集中できそうではあるわね",
            "zh": "不过，确实很安静，看起来能集中精力呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "472/TALK",
            "narrator": "ガブリエラ",
            "text": "図書室でいいじゃない。",
            "zh": "去图书室不就好了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "473/TALK",
            "narrator": "ガブリエラ",
            "text": "あそこなら無駄話も\nできないから――",
            "zh": "在那里也没法\n闲聊扯淡——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "474/TALK",
            "narrator": "ガブリエラ",
            "text": "勉強に集中できそうだし。",
            "zh": "应该能专心学习。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "475/TALK",
            "narrator": "雛",
            "text": "えーっ、カフェとか\n誰かの家の方が\nお喋りできるのにー…。",
            "zh": "哎—，去咖啡厅或者\n谁家里的话，还能顺便\n聊聊天呢—……。",
            "narrator_zh": "雏"
        },
        {
            "location": "476/TALK",
            "narrator": "繭",
            "text": "…勉強する気ないでしょ？",
            "zh": "……你根本没打算学习吧？",
            "narrator_zh": "茧"
        },
        {
            "location": "479/TALK",
            "narrator": "つばめ",
            "text": "ま、まあまあ…",
            "zh": "好、好啦好啦……",
            "narrator_zh": "燕"
        },
        {
            "location": "480/TALK",
            "narrator": "つばめ",
            "text": "でも、図書室なら\nどこよりも集中できそう\nだし、賛成だよ。",
            "zh": "不过，去图书室的话\n感觉比去哪里都能专心，\n我也赞成哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "482/TALK",
            "narrator": "ガブリエラ",
            "text": "んじゃ、決まりね。\n放課後になったら\n図書室に集合よ。",
            "zh": "那就这么定了。\n放学后就在\n图书室集合。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "484/TALK",
            "narrator": "ガブリエラ",
            "text": "ふふっ、楽しみだなぁ…。",
            "zh": "呼呼，真期待呀……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "507/TALK",
            "narrator": "ガブリエラ",
            "text": "じーーーーっ。",
            "zh": "盯————。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "509/TALK",
            "narrator": "女子高校生Ｂ",
            "text": "ねぇねぇ、コウくん。\nこの問題わからないぃー。",
            "zh": "呐呐，阿光。\n这道题我不会做啦—。",
            "narrator_zh": "女高中生B"
        },
        {
            "location": "511/TALK",
            "narrator": "男子高校生Ａ",
            "text": "またか？　チィは本当に\n数学が苦手なんだな。",
            "zh": "又不会了？小千你还真是\n不擅长数学啊。",
            "narrator_zh": "男高中生A"
        },
        {
            "location": "512/TALK",
            "narrator": "女子高校生Ｂ",
            "text": "だって、方程式とか\n苦手なんだもん。",
            "zh": "人家就是不擅长\n方程式之类的嘛。",
            "narrator_zh": "女高中生B"
        },
        {
            "location": "513/TALK",
            "narrator": "ガブリエラ",
            "text": "じーーーーっ。",
            "zh": "盯————。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "516/TALK",
            "narrator": "つばめ",
            "text": "ガブちゃん。\n今は勉強中だから、\n教科書見よう？",
            "zh": "加布。\n现在是学习时间，\n看课本好不好？",
            "narrator_zh": "燕"
        },
        {
            "location": "519/TALK",
            "narrator": "ガブリエラ",
            "text": "わ、わかってるわよ。",
            "zh": "我、我知道啦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "521/TALK",
            "narrator": "ガブリエラ",
            "text": "うわぁ…前に座ってるの、\n絶対カップルよね？",
            "zh": "哇啊……坐在前面的，\n绝对是情侣对吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "522/TALK",
            "narrator": "ガブリエラ",
            "text": "本当に図書室で勉強する\nカップルっていたんだ…\nビックリかも。",
            "zh": "原来真的有会在图书室\n一起学习的情侣啊……\n吓了我一跳。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "525/TALK",
            "narrator": "女子高校生Ｂ",
            "text": "あーん、コウくーん。\nこの問題わからないー。",
            "zh": "呜呜，阿光—。\n这道题也不会做—。",
            "narrator_zh": "女高中生B"
        },
        {
            "location": "528/TALK",
            "narrator": "男子高校生Ａ",
            "text": "ん？　今度はどこが\nわからないんだ？",
            "zh": "嗯？这次又是哪里\n看不懂了？",
            "narrator_zh": "男高中生A"
        },
        {
            "location": "529/TALK",
            "narrator": "女子高校生Ｂ",
            "text": "ここだよぉ…。\nちゃんと教えてもらった\n方程式使ってるのに…。",
            "zh": "这里啦……。\n我明明照着你教的\n方程式在算了……。",
            "narrator_zh": "女高中生B"
        },
        {
            "location": "530/TALK",
            "narrator": "男子高校生Ａ",
            "text": "…ははっ、\nこのおっちょこちょい。",
            "zh": "……哈哈，\n真是个小迷糊。",
            "narrator_zh": "男高中生A"
        },
        {
            "location": "531/TALK",
            "narrator": "女子高校生Ｂ",
            "text": "アンッ！\nもぉ、オデコツンツン\n禁止ー。",
            "zh": "讨厌啦！\n真是的，不准用手指\n戳我额头—。",
            "narrator_zh": "女高中生B"
        },
        {
            "location": "534/TALK",
            "narrator": "ガブリエラ",
            "text": "おっちょこちょいからの\nデコツン！？",
            "zh": "先说小迷糊紧接着\n又戳额头！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "535/TALK",
            "narrator": "ガブリエラ",
            "text": "えっ？　何この二人凄い！\nラブコメみたいなこと\n本当にやってる！",
            "zh": "哎？这两人也太厉害了吧！\n居然真的在演\n恋爱喜剧里的桥段！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "537/TALK",
            "narrator": "雛",
            "text": "ガブリエラちゃん、\n見ちゃいけません！",
            "zh": "加布里埃拉，\n不许看哦！",
            "narrator_zh": "雏"
        },
        {
            "location": "541/TALK",
            "narrator": "ガブリエラ",
            "text": "み、見てないわよ。",
            "zh": "我、我才没看呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "542/TALK",
            "narrator": "男子高校生Ａ",
            "text": "計算する順番が違うぞ。\nほら、足し算と掛け算は、\nどっちを最初にする？",
            "zh": "计算顺序搞错了哦。\n你看，加法和乘法，\n应该先算哪一个？",
            "narrator_zh": "男高中生A"
        },
        {
            "location": "543/TALK",
            "narrator": "女子高校生Ｂ",
            "text": "えっとぉ…えっとぉ…。",
            "zh": "那个……那个……。",
            "narrator_zh": "女高中生B"
        },
        {
            "location": "544/TALK",
            "narrator": "女子高校生Ｂ",
            "text": "あっ、掛け算だ！",
            "zh": "啊，是乘法！",
            "narrator_zh": "女高中生B"
        },
        {
            "location": "545/TALK",
            "narrator": "男子高校生Ａ",
            "text": "そう、だから答えが\n違ってるんだよ。",
            "zh": "对，所以你算出来的\n答案才不对呀。",
            "narrator_zh": "男高中生A"
        },
        {
            "location": "546/TALK",
            "narrator": "女子高校生Ｂ",
            "text": "てへっ、失敗失敗。",
            "zh": "哎嘿，搞砸啦搞砸啦。",
            "narrator_zh": "女高中生B"
        },
        {
            "location": "549/TALK",
            "narrator": "ガブリエラ",
            "text": "てへっ！？\nてへって本当に言うの！？",
            "zh": "哎嘿！？\n真的有人会嘴上说“哎嘿”吗！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "550/TALK",
            "narrator": "ガブリエラ",
            "text": "アニメの世界だけかと\n思ったけど…日本人の\nカップルって凄い！",
            "zh": "我还以为只有动画里\n才会这样呢……日本的\n情侣好厉害！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "552/TALK",
            "narrator": "ガブリエラ",
            "text": "勉強会を図書館にして\n正解だったわ。",
            "zh": "把学习会定在图书馆\n真是选对了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "554/TALK",
            "narrator": "つばめ",
            "text": "…席移るか、もう帰るか\nした方が良いかな？",
            "zh": "……我们还是换个座位，\n或者干脆回家比较好吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "556/TALK",
            "narrator": "雛",
            "text": "うん、それがいいと思う。\nガブリエラちゃんの\n教育に良くないし…。",
            "zh": "嗯，我也觉得这样好。\n对加布里埃拉的\n教育太不好了……。",
            "narrator_zh": "雏"
        },
        {
            "location": "557/TALK",
            "narrator": "つばめ",
            "text": "…図書館での勉強会は、\nもうやらない方が\nいいかも…。",
            "zh": "……在图书馆开学习会，\n以后还是别再\n搞了吧……。",
            "narrator_zh": "燕"
        },
