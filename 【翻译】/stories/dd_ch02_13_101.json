{
    "dir": "chap13/daydra/dd_ch02_13_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "13202",
        "cid": "ayami",
        "title": "002 メインストーリー",
        "sub_title": "子供の頃の憧れ＜前編＞",
        "title_zh": "002 主线剧情",
        "sub_title_zh": "儿时的憧憬＜前篇＞"
    },
    "entry": [
        {
            "location": "8/SCENARIO",
            "narrator": "",
            "text": "魔法少女になろうよ",
            "zh": "一起来当魔法少女吧",
            "narrator_zh": ""
        },
        {
            "location": "46/TALK",
            "narrator": "アーヤ",
            "text": "…困ったわね。\nあの怪物、身体が\n恐ろしく固いわ。",
            "zh": "……真棘手呢。\n那只怪物，身体\n硬得吓人。",
            "narrator_zh": "绫水"
        },
        {
            "location": "47/TALK",
            "narrator": "みやび",
            "text": "みたいやね…。\nアーヤの剣、\nぼろっぼろやし。",
            "zh": "好像是咯……。\n绫水的剑，\n都破破烂烂了嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "49/TALK",
            "narrator": "アーヤ",
            "text": "もう使えないわね…。\nギャヴィ、そっちは？",
            "zh": "已经不能用了呢……。\n加维，你那边呢？",
            "narrator_zh": "绫水"
        },
        {
            "location": "52/TALK",
            "narrator": "ガブリエラ",
            "text": "弾はまだあるけど、\nこっちの攻撃も\n全然効いてないわ。",
            "zh": "子弹倒是还有，\n但我这边的攻击也\n完全没效果。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "53/TALK",
            "narrator": "ガブリエラ",
            "text": "これじゃ、いくら\n撃っても弾の無駄よ。",
            "zh": "这样下去，打再多\n也只是浪费子弹而已。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "55/TALK",
            "narrator": "みやび",
            "text": "だとすると…、\nうちら、どうするが？",
            "zh": "这么说的话……\n我们，该怎么办喃？",
            "narrator_zh": "雅"
        },
        {
            "location": "56/TALK",
            "narrator": "アーヤ",
            "text": "どうするって、\nそれは…。",
            "zh": "怎么办……\n这可……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "72/TALK",
            "narrator": "ガブリエラ",
            "text": "いや、考えるまでも\nないでしょ？",
            "zh": "不，这还用想\n吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "73/TALK",
            "narrator": "ガブリエラ",
            "text": "こんなの、\nどうしようも\nないわよ。",
            "zh": "这种家伙，\n根本没法打\n嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "76/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィ！\nあなた、諦める\nつもりなの！？",
            "zh": "加维！\n你打算就这么\n放弃吗！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "77/TALK",
            "narrator": "ガブリエラ",
            "text": "だって、あの怪物には\nこっちの攻撃が\n全然効かないのよ？",
            "zh": "可是，那只怪物\n对我们的攻击\n完全免疫啊？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "78/TALK",
            "narrator": "ガブリエラ",
            "text": "そんな状況だってのに\nどうしろってのよ。",
            "zh": "都这种局面了\n你让我怎么办嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "81/TALK",
            "narrator": "アーヤ",
            "text": "どうって、それは…。",
            "zh": "怎么办……这……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "87/TALK",
            "narrator": "透明真幌",
            "text": "解析の結果が出た。\nクリア条件を教える。",
            "zh": "解析结果出来了。\n告诉你们通关条件。",
            "narrator_zh": "透明真幌"
        },
        {
            "location": "90/TALK",
            "narrator": "みやび",
            "text": "まほさん、\nナイスタイミングや！",
            "zh": "真幌，\n来得太及时咯！",
            "narrator_zh": "雅"
        },
        {
            "location": "91/TALK",
            "narrator": "アーヤ",
            "text": "それで、\nクリア条件は？",
            "zh": "那么，\n通关条件是？",
            "narrator_zh": "绫水"
        },
        {
            "location": "93/TALK",
            "narrator": "透明真幌",
            "text": "アップルティメルティと\nミルクティメルティーだ。",
            "zh": "苹果茶融化和\n奶茶融化。",
            "narrator_zh": "透明真幌"
        },
        {
            "location": "99/TALK",
            "narrator": "アーヤ",
            "text": "…は？",
            "zh": "……哈？",
            "narrator_zh": "绫水"
        },
        {
            "location": "100/TALK",
            "narrator": "みやび",
            "text": "まほさん、\n何言うてるがです？",
            "zh": "真幌，\n你在讲么子？",
            "narrator_zh": "雅"
        },
        {
            "location": "101/TALK",
            "narrator": "透明真幌",
            "text": "いや…私にもよくは\nわからんのだが……",
            "zh": "不……其实我也不是很\n明白……",
            "narrator_zh": "透明真幌"
        },
        {
            "location": "102/TALK",
            "narrator": "透明真幌",
            "text": "その世界は、アニメの\n世界が元になっている\nようだ。",
            "zh": "那个世界，好像是\n以动画的世界\n为蓝本的。",
            "narrator_zh": "透明真幌"
        },
        {
            "location": "103/TALK",
            "narrator": "透明真幌",
            "text": "えーっと…魔法少女、\nトリプルメルティーズ？",
            "zh": "那个……魔法少女，\n三重融化？",
            "narrator_zh": "透明真幌"
        },
        {
            "location": "104/TALK",
            "narrator": "透明真幌",
            "text": "…そういうことだ。",
            "zh": "……就是这么回事。",
            "narrator_zh": "透明真幌"
        },
        {
            "location": "106/TALK",
            "narrator": "アーヤ",
            "text": "いや、そういうことと\n言われても、さっぱり\nですよ。",
            "zh": "不，就算你这么说，\n我也完全听不懂\n啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "107/TALK",
            "narrator": "透明真幌",
            "text": "つまりだな、その\nスウィーティ―って奴には\n２人の仲間がいるらしい。",
            "zh": "也就是说，那个叫\n甜甜的家伙\n好像有两名同伴。",
            "narrator_zh": "透明真幌"
        },
        {
            "location": "108/TALK",
            "narrator": "透明真幌",
            "text": "アップルティーと\nミルクティーという\nヤツがな。",
            "zh": "就是苹果茶和\n奶茶那两个\n家伙。",
            "narrator_zh": "透明真幌"
        },
        {
            "location": "109/TALK",
            "narrator": "透明真幌",
            "text": "なので、おまえ達が\nその二人になって、共に\n敵を倒すことになるな。",
            "zh": "所以，你们得\n变成那两个人，一起\n把敌人打倒才行。",
            "narrator_zh": "透明真幌"
        },
        {
            "location": "110/TALK",
            "narrator": "透明真幌",
            "text": "スウィーティ―って\nヤツと一緒に、\nその怪物を討て。",
            "zh": "和那个叫甜甜的\n家伙一起，\n讨伐那只怪物。",
            "narrator_zh": "透明真幌"
        },
        {
            "location": "111/TALK",
            "narrator": "アーヤ",
            "text": "…まさか、それが\nクリア条件ですか？",
            "zh": "……难道说，这就是\n通关条件吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "112/TALK",
            "narrator": "透明真幌",
            "text": "そういうことだ。",
            "zh": "就是这么回事。",
            "narrator_zh": "透明真幌"
        },
        {
            "location": "113/TALK",
            "narrator": "透明真幌",
            "text": "そうすれば、こちらの\n攻撃も向こうへ通じる\nようになる。",
            "zh": "那样的话，这边的\n攻击就能对那边\n起效了。",
            "narrator_zh": "透明真幌"
        },
        {
            "location": "114/TALK",
            "narrator": "透明真幌",
            "text": "必殺技で一撃で倒すことが\nできるとのことだ。",
            "zh": "听说用必杀技\n一击就能打倒。",
            "narrator_zh": "透明真幌"
        },
        {
            "location": "116/TALK",
            "narrator": "ガブリエラ",
            "text": "何よそれ！\n他に方法はないの！？",
            "zh": "什么鬼啊！\n就没有别的办法了吗！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "117/TALK",
            "narrator": "透明真幌",
            "text": "無いな。",
            "zh": "没有。",
            "narrator_zh": "透明真幌"
        },
        {
            "location": "118/TALK",
            "narrator": "透明真幌",
            "text": "とにかく、\n早急に事態の収束を\n頼んだぞ。",
            "zh": "总之，\n拜托你们尽早\n平息事态了。",
            "narrator_zh": "透明真幌"
        },
        {
            "location": "123/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょっ！？\nまほ、まほってば！！",
            "zh": "等下！？\n真幌、真幌你听我说！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "124/TALK",
            "narrator": "ガブリエラ",
            "text": "信じらんない！\n任務中なのに通信を\n切ったわ！！",
            "zh": "简直不敢相信！\n还在任务中呢，她居然\n把通讯挂了！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "125/TALK",
            "narrator": "みやび",
            "text": "これ以上通信したまま\nでも、文句を言われる\nだけぞね。",
            "zh": "再这么连着通讯，\n也只会被她骂\n一顿啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "126/TALK",
            "narrator": "アーヤ",
            "text": "そうね。\nでも、この条件なら\n簡単に――",
            "zh": "是啊。\n不过，只要满足这个条件\n就能轻松——",
            "narrator_zh": "绫水"
        },
        {
            "location": "128/TALK",
            "narrator": "みやび",
            "text": "…で？\n誰がやるがよ？",
            "zh": "……那？\n谁去当咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "130/TALK",
            "narrator": "ガブリエラ",
            "text": "私パス。\nアーヤとみやびで\nやりなさいよ。",
            "zh": "我pass。\n绫水和雅去\n当吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "132/TALK",
            "narrator": "みやび",
            "text": "グリーンティー\nメルティがいるなら\nえいんやけんど。",
            "zh": "要是有绿茶\n融化的话，\n那倒要得，不过。",
            "narrator_zh": "雅"
        },
        {
            "location": "134/TALK",
            "narrator": "みやび",
            "text": "アップルティ―と\nミルクティ―はパスや。",
            "zh": "苹果茶和\n奶茶我就pass咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "136/TALK",
            "narrator": "アーヤ",
            "text": "グリーンティー\nなんているの？",
            "zh": "还有绿茶\n融化这种角色吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "138/TALK",
            "narrator": "みやび",
            "text": "知らんけんど、\nうちは緑茶好きやきね。",
            "zh": "不晓得啵，\n不过我喜欢绿茶嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "140/TALK",
            "narrator": "ガブリエラ",
            "text": "お茶の好みの話を\nしてるんじゃない\nでしょ！？",
            "zh": "现在不是聊喜不喜欢\n喝茶的时候\n吧！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "156/TALK",
            "narrator": "ガブリエラ",
            "text": "ほら、早く早く！\nどんどん被害が\n広がっちゃうわよ！？",
            "zh": "快点快点！\n再拖下去损失可要\n越来越大了哦！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "158/TALK",
            "narrator": "みやび",
            "text": "うちの心にまで\n被害が及ぶのだけは\n避けたいちや。",
            "zh": "我可不想连自己的\n心灵都跟着遭殃\n咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "159/TALK",
            "narrator": "みやび",
            "text": "ちゅうわけやき、\n二人に頼んだ！\n決定！",
            "zh": "就是这么回事啵，\n拜托你们俩了！\n就这么定了！",
            "narrator_zh": "雅"
        },
        {
            "location": "162/TALK",
            "narrator": "ガブリエラ",
            "text": "絶対イヤ！\nそんな恥ずかしいこと\nやりたくないわ。",
            "zh": "绝对不要！\n那么丢人的事\n我才不要做。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "164/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "167/TALK",
            "narrator": "みやび",
            "text": "アーヤもやりたくない\n思うてるが？",
            "zh": "绫水也是不想干，\n对吧？",
            "narrator_zh": "雅"
        },
        {
            "location": "169/TALK",
            "narrator": "アーヤ",
            "text": "…そうね。\nまあ、やっぱり\n恥ずかしいし…。",
            "zh": "……是啊。\n嘛，果然还是\n挺不好意思的……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "171/TALK",
            "narrator": "ガブリエラ",
            "text": "じゃあ、どうすんの？\nつばめ達が来るまで\nこのまま放置？",
            "zh": "那怎么办？\n就这么干耗着，\n等燕她们过来吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "173/TALK",
            "narrator": "みやび",
            "text": "それ、帰ったら\nまほさんにめっちゃ\n怒られるやろうね。",
            "zh": "那样的话，回去之后\n肯定会被真幌\n骂惨咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "175/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "176/SEL",
            "narrator": "",
            "text": "ねえ、アーヤ",
            "zh": "我说，绫水",
            "narrator_zh": ""
        },
        {
            "location": "177/ACT",
            "narrator": "",
            "text": "ねえ、アーヤ",
            "zh": "我说，绫水",
            "narrator_zh": ""
        },
        {
            "location": "194/TALK",
            "narrator": "アーヤ",
            "text": "任務中(>_<)",
            "zh": "正在任务中(>_<)",
            "narrator_zh": "绫水"
        },
        {
            "location": "195/TALK",
            "narrator": "アーヤ",
            "text": "手短に",
            "zh": "长话短说",
            "narrator_zh": "绫水"
        },
        {
            "location": "197/SEL",
            "narrator": "",
            "text": "本当はやりたいと思ってない？",
            "zh": "其实你心里挺想当的吧？",
            "narrator_zh": ""
        },
        {
            "location": "198/SEL",
            "narrator": "",
            "text": "誰かがやらないとダメなことだよ",
            "zh": "总得有人去才行呀",
            "narrator_zh": ""
        },
        {
            "location": "199/ACT",
            "narrator": "",
            "text": "本当はやりたいと思ってない？",
            "zh": "其实你心里挺想当的吧？",
            "narrator_zh": ""
        },
        {
            "location": "202/TALK",
            "narrator": "アーヤ",
            "text": "いや",
            "zh": "不",
            "narrator_zh": "绫水"
        },
        {
            "location": "203/TALK",
            "narrator": "アーヤ",
            "text": "まさか！",
            "zh": "怎么可能！",
            "narrator_zh": "绫水"
        },
        {
            "location": "204/TALK",
            "narrator": "アーヤ",
            "text": "そんなわけないでしょ(--#)",
            "zh": "怎么可能会有那种事(--#)",
            "narrator_zh": "绫水"
        },
        {
            "location": "205/TALK",
            "narrator": "アーヤ",
            "text": "っていうか",
            "zh": "再说了",
            "narrator_zh": "绫水"
        },
        {
            "location": "206/TALK",
            "narrator": "アーヤ",
            "text": "私の年齢だと",
            "zh": "以我的年纪",
            "narrator_zh": "绫水"
        },
        {
            "location": "207/TALK",
            "narrator": "アーヤ",
            "text": "イタいだけ(T_T)",
            "zh": "只会显得很尴尬而已(T_T)",
            "narrator_zh": "绫水"
        },
        {
            "location": "208/TALK",
            "narrator": "アーヤ",
            "text": "絶対ノいから！",
            "zh": "绝对不行！",
            "narrator_zh": "绫水"
        },
        {
            "location": "209/TALK",
            "narrator": "アーヤ",
            "text": "無いから！(>_<)",
            "zh": "想都别想！(>_<)",
            "narrator_zh": "绫水"
        },
        {
            "location": "210/ACT",
            "narrator": "",
            "text": "誰かがやらないとダメなことだよ",
            "zh": "总得有人去才行呀",
            "narrator_zh": ""
        },
        {
            "location": "211/TALK",
            "narrator": "アーヤ",
            "text": "そうよね",
            "zh": "话是这么说没错",
            "narrator_zh": "绫水"
        },
        {
            "location": "212/TALK",
            "narrator": "アーヤ",
            "text": "でも",
            "zh": "可是",
            "narrator_zh": "绫水"
        },
        {
            "location": "214/TALK",
            "narrator": "アーヤ",
            "text": "私がやるの？(￣Д￣ )",
            "zh": "要我去当吗？(￣Д￣ )",
            "narrator_zh": "绫水"
        },
        {
            "location": "215/TALK",
            "narrator": "アーヤ",
            "text": "一番年上の私が？",
            "zh": "年纪最大的我去当？",
            "narrator_zh": "绫水"
        },
        {
            "location": "217/TALK",
            "narrator": "アーヤ",
            "text": "そのキャラって何歳？",
            "zh": "那个角色设定才几岁啊？",
            "narrator_zh": "绫水"
        },
        {
            "location": "218/TALK",
            "narrator": "アーヤ",
            "text": "絶対成人じゃないでしょ？",
            "zh": "肯定不是成年人吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "219/TALK",
            "narrator": "アーヤ",
            "text": "なのに",
