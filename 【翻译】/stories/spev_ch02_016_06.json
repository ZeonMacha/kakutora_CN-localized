    "entry": [
        {
            "location": "397/SCENARIO",
            "narrator": "",
            "text": "読書のお供",
            "zh": "读书良伴",
            "narrator_zh": ""
        },
        {
            "location": "399/TALK",
            "narrator": "アーヤ",
            "text": "最近行ってみたいところといえば",
            "zh": "要说最近想去的地方",
            "narrator_zh": "绫水"
        },
        {
            "location": "400/TALK",
            "narrator": "アーヤ",
            "text": "ブックカフェかな",
            "zh": "大概是书吧咖啡馆吧",
            "narrator_zh": "绫水"
        },
        {
            "location": "401/TALK",
            "narrator": "アーヤ",
            "text": "ただね、ブックカフェって",
            "zh": "不过呀，书吧咖啡馆",
            "narrator_zh": "绫水"
        },
        {
            "location": "402/TALK",
            "narrator": "アーヤ",
            "text": "おしゃれだけど",
            "zh": "虽然很时髦",
            "narrator_zh": "绫水"
        },
        {
            "location": "403/TALK",
            "narrator": "アーヤ",
            "text": "少しだけ抵抗があるのよね",
            "zh": "但我还是稍微有点抗拒呢",
            "narrator_zh": "绫水"
        },
        {
            "location": "405/SEL",
            "narrator": "",
            "text": "そう？",
            "zh": "是吗？",
            "narrator_zh": ""
        },
        {
            "location": "406/SEL",
            "narrator": "",
            "text": "漫画の方がいいよね",
            "zh": "还是漫画更好吧",
            "narrator_zh": ""
        },
        {
            "location": "407/SEL",
            "narrator": "",
            "text": "本汚したらって思うよね",
            "zh": "会担心把书弄脏吧",
            "narrator_zh": ""
        },
        {
            "location": "408/ACT",
            "narrator": "",
            "text": "そう？",
            "zh": "是吗？",
            "narrator_zh": ""
        },
        {
            "location": "409/TALK",
            "narrator": "アーヤ",
            "text": "$handle$さんは",
            "zh": "$handle$",
            "narrator_zh": "绫水"
        },
        {
            "location": "410/TALK",
            "narrator": "アーヤ",
            "text": "そうじゃないのね",
            "zh": "倒不觉得呢",
            "narrator_zh": "绫水"
        },
        {
            "location": "411/ACT",
            "narrator": "",
            "text": "漫画の方がいいよね",
            "zh": "还是漫画更好吧",
            "narrator_zh": ""
        },
        {
            "location": "412/TALK",
            "narrator": "アーヤ",
            "text": "ええと",
            "zh": "呃",
            "narrator_zh": "绫水"
        },
        {
            "location": "413/TALK",
            "narrator": "アーヤ",
            "text": "そういうことじゃなくて",
            "zh": "我不是那个意思",
            "narrator_zh": "绫水"
        },
        {
            "location": "414/ACT",
            "narrator": "",
            "text": "本汚したらって思うよね",
            "zh": "会担心把书弄脏吧",
            "narrator_zh": ""
        },
        {
            "location": "415/TALK",
            "narrator": "アーヤ",
            "text": "そうなのよ",
            "zh": "就是那样",
            "narrator_zh": "绫水"
        },
        {
            "location": "416/TALK",
            "narrator": "アーヤ",
            "text": "食べ物って",
            "zh": "食物这种东西",
            "narrator_zh": "绫水"
        },
        {
            "location": "417/TALK",
            "narrator": "アーヤ",
            "text": "うっかりした時が",
            "zh": "万一不小心弄撒的时候",
            "narrator_zh": "绫水"
        },
        {
            "location": "418/TALK",
            "narrator": "アーヤ",
            "text": "怖いの",
            "zh": "很可怕嘛",
            "narrator_zh": "绫水"
        },
        {
            "location": "419/TALK",
            "narrator": "アーヤ",
            "text": "それに",
            "zh": "而且",
            "narrator_zh": "绫水"
        },
        {
            "location": "421/TALK",
            "narrator": "アーヤ",
            "text": "図書館だと",
            "zh": "在图书馆里的话",
            "narrator_zh": "绫水"
        },
        {
            "location": "422/TALK",
            "narrator": "アーヤ",
            "text": "飲食禁止でしょ",
            "zh": "是禁止饮食的吧",
            "narrator_zh": "绫水"
        },
        {
            "location": "423/TALK",
            "narrator": "アーヤ",
            "text": "普通は",
            "zh": "一般来讲",
            "narrator_zh": "绫水"
        },
        {
            "location": "425/SEL",
            "narrator": "",
            "text": "確かに",
            "zh": "确实",
            "narrator_zh": ""
        },
        {
            "location": "426/SEL",
            "narrator": "",
            "text": "行かないから知らない",
            "zh": "我不去所以不知道",
            "narrator_zh": ""
        },
        {
            "location": "427/SEL",
            "narrator": "",
            "text": "カフェ併設してるとこもあるよ",
            "zh": "也有附设咖啡馆的地方哦",
            "narrator_zh": ""
        },
        {
            "location": "428/ACT",
            "narrator": "",
            "text": "確かに",
            "zh": "确实",
            "narrator_zh": ""
        },
        {
            "location": "429/TALK",
            "narrator": "アーヤ",
            "text": "そっちに慣れてるから",
            "zh": "因为我已经习惯那样的规矩了",
            "narrator_zh": "绫水"
        },
        {
            "location": "430/ACT",
            "narrator": "",
            "text": "行かないから知らない",
            "zh": "我不去所以不知道",
            "narrator_zh": ""
        },
        {
            "location": "431/TALK",
            "narrator": "アーヤ",
            "text": "あら",
            "zh": "哎呀",
            "narrator_zh": "绫水"
        },
        {
            "location": "432/TALK",
            "narrator": "アーヤ",
            "text": "そうなの",
            "zh": "这样啊",
            "narrator_zh": "绫水"
        },
        {
            "location": "433/ACT",
            "narrator": "",
            "text": "カフェ併設してるとこもあるよ",
            "zh": "也有附设咖啡馆的地方哦",
            "narrator_zh": ""
        },
        {
            "location": "434/TALK",
            "narrator": "アーヤ",
            "text": "それでも",
            "zh": "就算那样",
            "narrator_zh": "绫水"
        },
        {
            "location": "435/TALK",
            "narrator": "アーヤ",
            "text": "本があるところは",
            "zh": "有书在的地方",
            "narrator_zh": "绫水"
        },
        {
            "location": "436/TALK",
            "narrator": "アーヤ",
            "text": "飲食禁止でしょ",
            "zh": "还是禁止饮食吧",
            "narrator_zh": "绫水"
        },
        {
            "location": "438/TALK",
            "narrator": "アーヤ",
            "text": "気にしすぎなのかも",
            "zh": "也许是我",
            "narrator_zh": "绫水"
        },
        {
            "location": "439/TALK",
            "narrator": "アーヤ",
            "text": "しれないけど",
            "zh": "太在意了",
            "narrator_zh": "绫水"
        },
        {
            "location": "440/TALK",
            "narrator": "アーヤ",
            "text": "やっぱり気になるのよ",
            "zh": "可还是会在意呀",
            "narrator_zh": "绫水"
        },
        {
            "location": "441/TALK",
            "narrator": "アーヤ",
            "text": "気にしすぎ？",
            "zh": "是不是在意过头了？",
            "narrator_zh": "绫水"
        }
    ]
}
