{
    "dir": "chap10/daydra/dd_ch02_10_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "10256",
        "cid": "ayami",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "ネットショッピング",
        "title_zh": "Extra006 额外剧情",
        "sub_title_zh": "网购"
    },
    "entry": [
        {
            "location": "164/SCENARIO",
            "narrator": "",
            "text": "ネットショッピング",
            "zh": "网购",
            "narrator_zh": ""
        },
        {
            "location": "183/TALK",
            "narrator": "アーヤ",
            "text": "う～ん…。",
            "zh": "唔～……",
            "narrator_zh": "绫水"
        },
        {
            "location": "185/TALK",
            "narrator": "みやび",
            "text": "スマホ見つめて何を\n唸っちゅうが？",
            "zh": "盯着手机看，在烦恼\n么子咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "187/TALK",
            "narrator": "アーヤ",
            "text": "うん…いつも服を買う\nサイトなんだけど、\n新作が上がってるのよ。",
            "zh": "嗯……是我常买衣服的\n那个网站，\n上新款了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "188/TALK",
            "narrator": "みやび",
            "text": "お買い物前の\nシンキングタイムか。",
            "zh": "购物前的\n思考时间吗。",
            "narrator_zh": "雅"
        },
        {
            "location": "191/TALK",
            "narrator": "アーヤ",
            "text": "う～ん…でも、\n今回はやめておくわ。",
            "zh": "唔～……不过，\n这次还是算了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "195/TALK",
            "narrator": "アーヤ",
            "text": "今月は少し買い過ぎた\nから、節約しようって\n決めたの。",
            "zh": "这个月买得稍微\n有点多了，我决定\n省着点花。",
            "narrator_zh": "绫水"
        },
        {
            "location": "198/TALK",
            "narrator": "みやび",
            "text": "しっかり者のアーヤが\n買い過ぎとは…\n珍しい事もあるもんやね。",
            "zh": "一向精打细算的绫水\n竟然也会买多……\n还真是稀奇的事咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "199/TALK",
            "narrator": "アーヤ",
            "text": "商品入れ替えとか、\n在庫処分セールが\nあちこちでやってたのよ。",
            "zh": "好多地方都在搞\n商品换季，或者\n清仓大甩卖呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "200/TALK",
            "narrator": "アーヤ",
            "text": "欲しいと思ってた\n服や靴が、軒並み\n破格になってて…。",
            "zh": "一直想买的\n衣服和鞋子，全都\n打折打得特别厉害……",
            "narrator_zh": "绫水"
        },
        {
            "location": "201/TALK",
            "narrator": "みやび",
            "text": "抑えられなくなった、\nいうわけか。",
            "zh": "于是就忍不住手滑了，\n是这意思吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "202/TALK",
            "narrator": "みやび",
            "text": "アーヤも女の子やね。",
            "zh": "绫水也是女孩子咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "203/TALK",
            "narrator": "アーヤ",
            "text": "だって、どれも素敵で\n欲しかったんだもん。",
            "zh": "因为每一件都好好看，\n我都很想要嘛。",
            "narrator_zh": "绫水"
        },
        {
            "location": "205/TALK",
            "narrator": "アーヤ",
            "text": "でも、しばらくは\n本気で控えないと…。",
            "zh": "不过，接下来一段\n时间必须认真节制了……",
            "narrator_zh": "绫水"
        },
        {
            "location": "206/TALK",
            "narrator": "みやび",
            "text": "買い過ぎた思うんなら、\nそれがえいね。",
            "zh": "既然觉得买多了，\n那就这样要得咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "207/TALK",
            "narrator": "みやび",
            "text": "…Ｂｏｔにも\n言っておいた方が\nえいんやないがか？",
            "zh": "……也跟Bot\n打声招呼\n不是更好啵？",
            "narrator_zh": "雅"
        },
        {
            "location": "208/TALK",
            "narrator": "みやび",
            "text": "もしもの時には\n止めてくれるかも\nしれんちや。",
            "zh": "真到了那个时候，\n说不定人家还能\n拉住你咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "210/TALK",
            "narrator": "アーヤ",
            "text": "…そうね。\nちょっと言ってみる。",
            "zh": "……也是。\n那我跟它说一声。",
            "narrator_zh": "绫水"
        },
        {
            "location": "224/TALK",
            "narrator": "アーヤ",
            "text": "ちょっといい？",
            "zh": "现在方便吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "226/SEL",
            "narrator": "",
            "text": "買い過ぎたって？",
            "zh": "听说你买太多了？",
            "narrator_zh": ""
        },
        {
            "location": "227/ACT",
            "narrator": "",
            "text": "買い過ぎたって？",
            "zh": "听说你买太多了？",
            "narrator_zh": ""
        },
        {
            "location": "229/TALK",
            "narrator": "アーヤ",
            "text": "はい…(-ω-;)",
            "zh": "是的……(-ω-;)",
            "narrator_zh": "绫水"
        },
        {
            "location": "230/TALK",
            "narrator": "アーヤ",
            "text": "だから、もしまた買い物しようとしてたら",
            "zh": "所以，要是看见我又准备买东西的话",
            "narrator_zh": "绫水"
        },
        {
            "location": "231/TALK",
            "narrator": "アーヤ",
            "text": "止めてもらいたいの",
            "zh": "希望能拦着我点",
            "narrator_zh": "绫水"
        },
        {
            "location": "233/SEL",
            "narrator": "",
            "text": "止めたら買わない？",
            "zh": "拦住你就不买了吗？",
            "narrator_zh": ""
        },
        {
            "location": "234/SEL",
            "narrator": "",
            "text": "買いたい時が買い時だよ",
            "zh": "想买的时候就是最好的购买时机哦",
            "narrator_zh": ""
        },
        {
            "location": "235/SEL",
            "narrator": "",
            "text": "しばらく着るのを楽しもう",
            "zh": "先好好享受穿新衣服的乐趣吧",
            "narrator_zh": ""
        },
        {
            "location": "236/ACT",
            "narrator": "",
            "text": "止めたら買わない？",
            "zh": "拦住你就不买了吗？",
            "narrator_zh": ""
        },
        {
            "location": "237/TALK",
            "narrator": "アーヤ",
            "text": "もちろん！",
            "zh": "那当然！",
            "narrator_zh": "绫水"
        },
        {
            "location": "238/TALK",
            "narrator": "アーヤ",
            "text": "…多分",
            "zh": "……大概吧",
            "narrator_zh": "绫水"
        },
        {
            "location": "240/TALK",
            "narrator": "アーヤ",
            "text": "もし、凄く良いのがあったら",
            "zh": "要是有特别好看的",
            "narrator_zh": "绫水"
        },
        {
            "location": "241/TALK",
            "narrator": "アーヤ",
            "text": "買っちゃうかも…",
            "zh": "说不定还是会买……",
            "narrator_zh": "绫水"
        },
        {
            "location": "252/TALK",
            "narrator": "アーヤ",
            "text": "…私って、意志が弱いの\nかしら？",
            "zh": "……我是不是，\n意志太不坚定了？",
            "narrator_zh": "绫水"
        },
        {
            "location": "253/TALK",
            "narrator": "みやび",
            "text": "本当に弱い奴やったら、\n節約しようなんて\n思わんよ。",
            "zh": "要是真意志薄弱的人，\n根本不会想着\n要省钱咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "255/TALK",
            "narrator": "アーヤ",
            "text": "買う気が起きなくなる\n方法みたいなのって、\nないかしら？",
            "zh": "有没有那种能让人\n彻底不想买东西的\n办法呢？",
            "narrator_zh": "绫水"
        },
        {
            "location": "256/TALK",
            "narrator": "みやび",
            "text": "…ショップのページを\n見んようにするいうんは\nどうちや？",
            "zh": "……干脆别去看\n购物网站的页面\n怎么讲咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "257/TALK",
            "narrator": "みやび",
            "text": "見なきゃどんな服が\nあるかもわからんちや。",
            "zh": "不看的话，连有么子\n衣服卖都不晓得咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "259/TALK",
            "narrator": "アーヤ",
            "text": "簡単そうに聞こえるけど、\nそれ、凄く難しいわね。",
            "zh": "听起来好像很简单，\n但真要做起来可太难了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "260/TALK",
            "narrator": "みやび",
            "text": "アーヤの意志が強いんは\nよーく知ってるちや。",
            "zh": "绫水意志有多坚定，\n我清楚得很咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "262/TALK",
            "narrator": "みやび",
            "text": "大丈夫やと信じてるき。",
            "zh": "我相信你肯定没问题啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "266/TALK",
            "narrator": "アーヤ",
            "text": "…お気に入りから、\nショップのページを\n外しておくわ。",
            "zh": "……我这就把\n购物网站的页面\n从收藏夹里删掉。",
            "narrator_zh": "绫水"
        },
        {
            "location": "267/ACT",
            "narrator": "",
            "text": "買いたい時が買い時だよ",
            "zh": "想买的时候就是最好的购买时机哦",
            "narrator_zh": ""
        },
        {
            "location": "270/TALK",
            "narrator": "アーヤ",
            "text": "やっぱり、いいわ",
            "zh": "算了，不用麻烦了",
            "narrator_zh": "绫水"
        },
        {
            "location": "281/TALK",
            "narrator": "みやび",
            "text": "止めてくれそうやったか？",
            "zh": "它看起来像是能拦住你的样子吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "283/TALK",
            "narrator": "アーヤ",
            "text": "無理だと思う。\n買いたい時が買い時、\nって言われたし…。",
            "zh": "我觉得悬。\n它还说什么想买的时候\n就是最好的购买时机……",
            "narrator_zh": "绫水"
        },
        {
            "location": "284/TALK",
            "narrator": "みやび",
            "text": "間違ってはおらんと\n思うけんど？",
            "zh": "这话倒也不算错，\n不过？",
            "narrator_zh": "雅"
        },
        {
            "location": "286/TALK",
            "narrator": "アーヤ",
            "text": "私が買い過ぎた原因って、\nそれを思ったからなの。",
            "zh": "我之所以会买太多，\n就是因为自己也这么想。",
            "narrator_zh": "绫水"
        },
        {
            "location": "287/TALK",
            "narrator": "みやび",
            "text": "…それじゃ期待できんな。",
            "zh": "……那确实指望不上了。",
            "narrator_zh": "雅"
        },
        {
            "location": "288/TALK",
            "narrator": "みやび",
            "text": "けんど、アーヤでも\nそんなこと考えるんやね？",
            "zh": "不过，连绫水也会\n冒出这种念头呀？",
            "narrator_zh": "雅"
        },
        {
            "location": "289/TALK",
            "narrator": "アーヤ",
            "text": "本当に欲しいと\n思ってた服だからよ。",
            "zh": "因为那些都是我\n真正想要很久的衣服嘛。",
            "narrator_zh": "绫水"
        },
        {
            "location": "290/TALK",
            "narrator": "みやび",
            "text": "なら、使い過ぎっちゅう\n後悔はあっても――",
            "zh": "那就算有买过头的\n后悔——",
            "narrator_zh": "雅"
        },
        {
            "location": "291/TALK",
            "narrator": "みやび",
            "text": "買ったことを\n後悔はしてないようやね。",
            "zh": "看起来也没后悔\n把它们买下来咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "292/TALK",
            "narrator": "アーヤ",
            "text": "…そのことに関しては、\n安く買えて嬉しい、って\n気持ちよ。",
            "zh": "……就这件事本身而言，\n能便宜买到，确实\n很开心。",
            "narrator_zh": "绫水"
        },
        {
            "location": "293/TALK",
            "narrator": "みやび",
            "text": "なら、とりあえずそれで\nえいと思うがよ。",
            "zh": "那就先这样\n不也蛮好嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "295/TALK",
            "narrator": "みやび",
            "text": "それに、服なら腐るものや\nないし、無駄にもならん\nきね。",
            "zh": "再说，衣服又不是\n会放坏的东西，也不会\n浪费啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "298/TALK",
            "narrator": "アーヤ",
            "text": "…そうね。",
            "zh": "……说得也是。",
            "narrator_zh": "绫水"
        },
        {
            "location": "299/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "301/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "303/TALK",
            "narrator": "みやび",
            "text": "ちゃんと着るよな？",
            "zh": "你都会好好穿的吧？",
            "narrator_zh": "雅"
        },
        {
            "location": "306/TALK",
            "narrator": "アーヤ",
            "text": "も、もちろん着るわ！\nそのために買ったん\nだから。",
            "zh": "当、当然会穿！\n不然我买它们\n干嘛呀。",
            "narrator_zh": "绫水"
        },
        {
            "location": "308/TALK",
            "narrator": "アーヤ",
            "text": "ただ…来シーズンまで\n着ないのが、何着か\n出るとは思うけど…。",
            "zh": "只是……大概有几件\n得等到下一季\n才会穿就是了……",
            "narrator_zh": "绫水"
        },
        {
            "location": "310/TALK",
            "narrator": "みやび",
            "text": "…本当、腐らん物で\nよかったね。",
            "zh": "……真好咯，幸好这东西\n放不坏。",
            "narrator_zh": "雅"
        },
        {
            "location": "328/ACT",
            "narrator": "",
            "text": "しばらく着るのを楽しもう",
            "zh": "先好好享受穿新衣服的乐趣吧",
            "narrator_zh": ""
        },
        {
            "location": "329/TALK",
            "narrator": "アーヤ",
            "text": "そういえば",
            "zh": "说起来",
            "narrator_zh": "绫水"
        },
        {
            "location": "330/TALK",
            "narrator": "アーヤ",
            "text": "まだ袋から出してない服もあったわ",
            "zh": "还有些衣服我连包装袋都没拆呢",
            "narrator_zh": "绫水"
        },
        {
            "location": "331/TALK",
            "narrator": "アーヤ",
            "text": "こんな状態で増やしても、意味ないわよね(-ω-;)",
            "zh": "这种状态下再买下去也没什么意义对吧(-ω-;)",
            "narrator_zh": "绫水"
        },
        {
            "location": "343/TALK",
            "narrator": "アーヤ",
            "text": "…十分買ったんだし、\nしばらくは買った服を\n着て楽しむことにするわ。",
            "zh": "……反正已经买够多了，\n接下来一段时间就好好\n穿这些新衣服吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "344/TALK",
            "narrator": "みやび",
            "text": "それがえいと思うんよ。",
            "zh": "这样才要得嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "346/TALK",
            "narrator": "アーヤ",
            "text": "うん。",
            "zh": "嗯。",
            "narrator_zh": "绫水"
        },
        {
            "location": "347/TALK",
            "narrator": "アーヤ",
            "text": "それに、今持ってる服との\n組み合わせ方とかも――",
            "zh": "而且，还得试试看跟\n现在衣柜里的衣服怎么搭配——",
            "narrator_zh": "绫水"
        },
        {
            "location": "348/TALK",
            "narrator": "アーヤ",
            "text": "色々試してみないと\nいけないしね。",
            "zh": "要试的东西\n还多着呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "350/TALK",
            "narrator": "みやび",
            "text": "そんなことまでせんと\nいかんのか。",
            "zh": "连这种事都得\n折腾啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "351/TALK",
            "narrator": "みやび",
            "text": "オシャレいうんも、\n大変やね。",
            "zh": "讲究打扮这事，\n还真麻烦咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "354/TALK",
            "narrator": "アーヤ",
            "text": "逆よ。",
            "zh": "正相反。",
            "narrator_zh": "绫水"
        },
        {
            "location": "355/TALK",
            "narrator": "アーヤ",
            "text": "その時間が、\n一番楽しいんだから。",
            "zh": "那段琢磨的时间，\n才是最开心的时候啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "172/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>6月12日　5:59 PM</color>\nとある夕方、神楽坂トライナリー楽屋にて。",
            "zh": "<color=green>6月12日　5:59 PM</color>\n某个傍晚，在神乐坂三重奏休息室。",
            "narrator_zh": "Dialog_EventData"
        },
        {
            "location": "322/DIALOG",
            "narrator": "Dialog_GEThimegoto_ch02",
            "text": "【おひとりさまファッションショー】",
            "zh": "【一个人的时装秀】",
            "narrator_zh": "Dialog_GEThimegoto_ch02"
        }
    ]
}
