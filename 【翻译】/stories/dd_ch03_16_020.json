{
    "dir": "chap16/daydra/dd_ch03_16_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "16356",
        "cid": "gabriella",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "肝試しと女生徒",
        "title_zh": "Extra006 额外剧情",
        "sub_title_zh": "试胆大会与女学生"
    },
    "entry": [
        {
            "location": "269/SCENARIO",
            "narrator": "",
            "text": "肝試しと女生徒",
            "zh": "试胆大会与女学生",
            "narrator_zh": ""
        },
        {
            "location": "284/TALK",
            "narrator": "ガブリエラ",
            "text": "みんな、揃ったわね。\nそれじゃあ肝試しを\n始めるわ！",
            "zh": "大家，都到齐了吧。\n那么试胆大会\n现在开始！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "286/TALK",
            "narrator": "キリト",
            "text": "…ここまで来るだけでも、\n十分肝試しにはなった\nけどな。",
            "zh": "……光是走到这里，\n就已经够像试胆了\n好吧。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "287/TALK",
            "narrator": "つばめ",
            "text": "ここも結構怖いよ。\n静かで真っ暗だし…。",
            "zh": "这里也挺吓人的呀。\n又安静又漆黑的……。",
            "narrator_zh": "燕"
        },
        {
            "location": "288/TALK",
            "narrator": "雛",
            "text": "あたしもそれ思った。\n校舎の中とは違った\n怖さあるよね？",
            "zh": "我也这么觉得。\n跟教学楼里面是另一种\n吓人法吧？",
            "narrator_zh": "雏"
        },
        {
            "location": "290/TALK",
            "narrator": "ガブリエラ",
            "text": "お喋りしないの！\n今からルールを\n説明するわ。",
            "zh": "别闲聊了！\n现在开始我来\n说明规则。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "291/TALK",
            "narrator": "ガブリエラ",
            "text": "スタートはこの屋上で、\nゴールは一階の玄関ね。",
            "zh": "起点是这片天台，\n终点是一楼大门。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "292/TALK",
            "narrator": "ガブリエラ",
            "text": "玄関に到着した、って\n連絡が来たら、\n次の人がスタート。",
            "zh": "收到已经抵达大门的\n消息之后，\n下一个人再出发。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "295/TALK",
            "narrator": "キリト",
            "text": "…俺もヒカルと一緒に、\n玄関で待ちたかったなぁ。",
            "zh": "……我也想和光一起，\n在大门那边等着啊。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "296/TALK",
            "narrator": "雛",
            "text": "キリトってこういうの\n苦手だっけ？",
            "zh": "圣翔你本来就怕\n这种东西吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "299/TALK",
            "narrator": "キリト",
            "text": "苦手じゃねぇ奴って\nいるのか？",
            "zh": "这世上有不怕的\n家伙吗？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "301/TALK",
            "narrator": "ガブリエラ",
            "text": "というわけだから。\nさ、誰から始める？",
            "zh": "事情就是这样。\n来，谁第一个上？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "303/TALK",
            "narrator": "雛",
            "text": "…あたし、最初で良い？",
            "zh": "……我，可以第一个去吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "305/TALK",
            "narrator": "ガブリエラ",
            "text": "あら、やる気満々ね？",
            "zh": "哎呀，干劲十足嘛？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "307/TALK",
            "narrator": "雛",
            "text": "いやー、正直怖いけど、\n一番最後よりはマシかな、\nって思って…。",
            "zh": "哪呀，说实话是挺怕的，\n但总觉得比排最后一个\n要好一点……。",
            "narrator_zh": "雏"
        },
        {
            "location": "310/TALK",
            "narrator": "キリト",
            "text": "だ、だな…一番最後は、\nなんか嫌な予感しか\nしねぇし…。",
            "zh": "是、是啊……排最后一个，\n总有种很不好的\n预感……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "311/TALK",
            "narrator": "雛",
            "text": "男のクセに怖がらない\nでよ！",
            "zh": "一个大男生别那么\n胆小啦！",
            "narrator_zh": "雏"
        },
        {
            "location": "313/TALK",
            "narrator": "キリト",
            "text": "男だって怖いもんは\n怖いんだよ！",
            "zh": "男生也是会怕的好吧，\n怕就是怕！",
            "narrator_zh": "圣翔"
        },
        {
            "location": "316/TALK",
            "narrator": "つばめ",
            "text": "わたしも、一番最後は\nちょっと嫌かも…。",
            "zh": "我也觉得，排最后一个\n有点不太想……。",
            "narrator_zh": "燕"
        },
        {
            "location": "319/TALK",
            "narrator": "ガブリエラ",
            "text": "は？",
            "zh": "哈？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "321/TALK",
            "narrator": "ガブリエラ",
            "text": "何番だろうとすることは\n変わらないんだから、\n関係ないでしょ？",
            "zh": "不管排第几个，要做的事\n不都一样吗，\n有什么关系？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "323/TALK",
            "narrator": "雛",
            "text": "いやいや、全然違うって！",
            "zh": "不不不，完全不一样好吧！",
            "narrator_zh": "雏"
        },
        {
            "location": "324/TALK",
            "narrator": "雛",
            "text": "一番最後だと、後ろには\nもう誰もいない、って\n不安になるし…。",
            "zh": "排最后一个的话，总觉得\n身后已经没人了，\n心里会发慌嘛……。",
            "narrator_zh": "雏"
        },
        {
            "location": "326/TALK",
            "narrator": "ガブリエラ",
            "text": "一緒に歩かない時点で、\nそんなこと気にする必要\nないでしょ？",
            "zh": "反正本来也不是一起走，\n根本没必要在意\n那种事吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "328/TALK",
            "narrator": "キリト",
            "text": "…おい、ガブリエラって\n根性座り過ぎてねぇか？",
            "zh": "……喂，加布里埃拉是不是\n胆子大过头了啊？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "330/TALK",
            "narrator": "つばめ",
            "text": "さすがガブちゃん、って\n感じだね。",
            "zh": "真不愧是加布呢，\n这种感觉。",
            "narrator_zh": "燕"
        },
        {
            "location": "331/TALK",
            "narrator": "雛",
            "text": "じゃあ、一番最後は\nガブリエラちゃんに\nお任せしていいかな？",
            "zh": "那最后一个，\n就交给加布里埃拉\n没问题吧？",
            "narrator_zh": "雏"
        },
        {
            "location": "334/TALK",
            "narrator": "ガブリエラ",
            "text": "構わないわ。\nそれじゃ、さっさと\n始めましょ。",
            "zh": "无所谓啊。\n那就赶紧\n开始吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "336/TALK",
            "narrator": "つばめ",
            "text": "ううっ、ドキドキして\nきたよぉ…。",
            "zh": "呜呜，心跳开始\n加速了呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "353/TALK",
            "narrator": "ガブリエラ",
            "text": "ふぁ…退屈だわ…。",
            "zh": "呼啊……好无聊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "354/TALK",
            "narrator": "ガブリエラ",
            "text": "つばめったら、どこで\nノロノロしてるのかしら？",
            "zh": "燕这家伙，磨磨蹭蹭地\n卡在哪儿了啊？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "355/TALK",
            "narrator": "ガブリエラ",
            "text": "これじゃいつまで経っても\nあたしが出発できない\nじゃない…。",
            "zh": "这样下去不管等多久\n我都没法出发\n不是吗……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "359/TALK",
            "narrator": "ガブリエラ",
            "text": "…あっ、来た！",
            "zh": "……啊，来了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "362/TALK",
            "narrator": "ガブリエラ",
            "text": "やっとメール来たわ。\nまったく、後でちょっと\nだけ文句言わないと。",
            "zh": "总算发邮件来了。\n真是的，待会儿必须\n小小抱怨她几句才行。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "365/TALK",
            "narrator": "ガブリエラ",
            "text": "さてと、あたしも\n出発…。",
            "zh": "好嘞，我也\n出发……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "370/TALK",
            "narrator": "女子高校生Ａ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "371/TALK",
            "narrator": "ガブリエラ",
            "text": "っ！？",
            "zh": "唔！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "372/TALK",
            "narrator": "女子高校生Ａ",
            "text": "うそっ…こんな時間に\nまだ生徒が残ってた\nなんて…。",
            "zh": "不会吧……都这个点了，\n居然还有学生留在\n学校里……。",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "373/TALK",
            "narrator": "ガブリエラ",
            "text": "だ、誰なの？\nどうしてここに…？",
            "zh": "你、你是谁？\n为什么会在这里……？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "374/TALK",
            "narrator": "女子高校生Ａ",
            "text": "私は高等部生徒会の\n副会長よ。",
            "zh": "我是高中部学生会的\n副会长哦。",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "375/TALK",
            "narrator": "女子高校生Ａ",
            "text": "先生に頼まれて、\n屋上の施錠に来たの。",
            "zh": "是受老师之托，\n来锁天台门的。",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "377/TALK",
            "narrator": "ガブリエラ",
            "text": "あ、そっか…。\nそういえばここの扉、\n開けっ放しだったっけ…。",
            "zh": "啊，这样啊……。\n说起来这里的门，\n刚才确实一直敞着来着……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "380/TALK",
            "narrator": "女子高校生Ａ",
            "text": "っていうか、あなたって\n中等部の子よね？",
            "zh": "话说回来，你是\n初中部的孩子吧？",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "381/TALK",
            "narrator": "女子高校生Ａ",
            "text": "どうしてこんな時間に、\n高等部の屋上にいるの？",
            "zh": "为什么这么晚了，\n还待在高中部的天台？",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "383/TALK",
            "narrator": "ガブリエラ",
            "text": "そ、それは、その…\nちょっと肝試しをしよう\nかな、って…。",
            "zh": "这、这个，那个……\n就是想着稍微玩一下\n试胆大会之类的……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "384/TALK",
            "narrator": "女子高校生Ａ",
            "text": "はぁ…私だからよかった\nけど、先生に見つかったら\n怒られてたわよ？",
            "zh": "唉……碰上我还好说，\n要是被老师撞见，\n可就要挨批了哦？",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "386/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "387/TALK",
            "narrator": "女子高校生Ａ",
            "text": "さ、玄関まで送るから、\n一緒に行きましょ。",
            "zh": "好了，我送你到大门，\n一起走吧。",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "388/TALK",
            "narrator": "ガブリエラ",
            "text": "何言ってるのよ？\nそれじゃ肝試しに\nならないじゃん。",
            "zh": "你说什么呢？\n那样不就完全\n不算试胆了吗。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "389/SEL",
            "narrator": "",
            "text": "逃げちゃえ",
            "zh": "快逃吧",
            "narrator_zh": ""
        },
        {
            "location": "390/SEL",
            "narrator": "",
            "text": "悪いのはこっちだよ",
            "zh": "确实是我们不对呀",
            "narrator_zh": ""
        },
        {
            "location": "392/TALK",
            "narrator": "女子高校生Ａ",
            "text": "まだ続けるつもり\nだったの？",
            "zh": "你还打算继续\n下去吗？",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "393/TALK",
            "narrator": "女子高校生Ａ",
            "text": "私に見つかった時点で、\n肝試しはおしまいよ。",
            "zh": "从被我撞见的那一刻起，\n试胆大会就已经结束了。",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "394/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "395/TALK",
            "narrator": "女子高校生Ａ",
            "text": "ほら、早く行こ。",
            "zh": "好啦，快走吧。",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "398/TALK",
            "narrator": "ガブリエラ",
            "text": "…どうせ玄関まで\n行くなら…。",
            "zh": "……反正都是要走到\n大门去的……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "399/TALK",
            "narrator": "女子高校生Ａ",
            "text": "ん？",
            "zh": "嗯？",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "400/TALK",
            "narrator": "ガブリエラ",
            "text": "あたし一人で行くわ！\nさよなら！",
            "zh": "我自己一个人下去！\n拜拜！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "405/TALK",
            "narrator": "女子高校生Ａ",
            "text": "え！？　あ、ちょ！！",
            "zh": "哎！？　啊，等一下！！",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "406/TALK",
            "narrator": "女子高校生Ａ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "407/TALK",
            "narrator": "女子高校生Ａ",
            "text": "ちっ、逃がしたか。",
            "zh": "啧，让她跑了啊。",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "409/ACT",
            "narrator": "",
            "text": "逃げちゃえ",
            "zh": "快逃吧",
            "narrator_zh": ""
        },
        {
            "location": "430/TALK",
            "narrator": "ガブリエラ",
            "text": "賛成よ、$marzanna$",
            "zh": "我赞成，$marzanna$",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "431/TALK",
            "narrator": "ガブリエラ",
            "text": "私だけ付き添い付きで言ったら、みんなに笑われちゃうもの",
            "zh": "要是只有我带着陪同下去的话，肯定会被大家笑话的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "442/TALK",
            "narrator": "女子高校生Ａ",
            "text": "さ、行きましょ。",
            "zh": "来，走吧。",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "444/TALK",
            "narrator": "ガブリエラ",
            "text": "…あの。",
            "zh": "……那个。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "445/TALK",
            "narrator": "女子高校生Ａ",
            "text": "ん、なに？",
            "zh": "嗯，怎么了？",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "447/TALK",
            "narrator": "ガブリエラ",
            "text": "やっぱりあたし、\n一人で行きたいから――",
            "zh": "我果然还是想\n自己一个人走——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "448/TALK",
            "narrator": "ガブリエラ",
            "text": "ごめんなさい！！",
            "zh": "对不起！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "449/TALK",
            "narrator": "女子高校生Ａ",
            "text": "え？",
            "zh": "哎？",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "454/TALK",
            "narrator": "女子高校生Ａ",
            "text": "あ、ちょっと！！",
            "zh": "啊，等一下！！",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "455/TALK",
            "narrator": "女子高校生Ａ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "456/TALK",
            "narrator": "女子高校生Ａ",
            "text": "ちっ…時間を掛けて\n準備したのに…。",
            "zh": "啧……我花了那么多时间\n准备的说……。",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "457/ACT",
            "narrator": "",
            "text": "悪いのはこっちだよ",
            "zh": "确实是我们不对呀",
            "narrator_zh": ""
        },
        {
            "location": "480/TALK",
            "narrator": "ガブリエラ",
            "text": "それはそうだけど…",
            "zh": "话虽这么说……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "481/TALK",
            "narrator": "ガブリエラ",
            "text": "わかったわ、この人の言う通りにするわ",
            "zh": "我知道了，就按这个人说的做吧",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "492/TALK",
            "narrator": "ガブリエラ",
            "text": "…ごめんなさい。",
            "zh": "……对不起。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "493/TALK",
            "narrator": "女子高校生Ａ",
            "text": "反省してるならいいのよ。\nさ、一緒に行きましょ。",
            "zh": "知道反省就好。\n来，一起走吧。",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "505/TALK",
            "narrator": "女子高校生Ａ",
            "text": "それにしても、\n肝試しをするなんて\n勇気があるのね。",
            "zh": "不过话说回来，\n敢跑来玩试胆大会，\n胆子还真不小呢。",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "506/TALK",
            "narrator": "女子高校生Ａ",
            "text": "夜の校舎が怖くないの？",
            "zh": "你不觉得晚上的教学楼很可怕吗？",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "507/TALK",
            "narrator": "ガブリエラ",
            "text": "昼も夜も校舎は同じよ。\n別に怖くないわ。",
            "zh": "白天和晚上的教学楼都一样啊。\n没什么好怕的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "509/TALK",
            "narrator": "女子高校生Ａ",
            "text": "…凄いのね。\n普通はお化けとか幽霊が\n出そうに思えて――",
            "zh": "……真厉害呢。\n一般都会觉得这种地方\n好像会闹鬼或者有幽灵——",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "510/TALK",
            "narrator": "女子高校生Ａ",
            "text": "怖くなるのに…。",
            "zh": "然后就会害怕吧……。",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "512/TALK",
            "narrator": "ガブリエラ",
            "text": "場所によってはそうかも\nしれないけど、この学校は\n平気でしょ？",
            "zh": "换作别的地方或许会吧，\n不过这所学校\n肯定没事的啦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "514/TALK",
            "narrator": "ガブリエラ",
            "text": "墓地を潰して作った\nわけでもないし――",
            "zh": "既不是推平了墓地\n建起来的——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "515/TALK",
            "narrator": "ガブリエラ",
            "text": "人が死ぬような事件や\n事故も過去になかったん\nだから――",
            "zh": "过去也从没发生过\n什么死人的案件或\n事故——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "517/TALK",
            "narrator": "ガブリエラ",
            "text": "幽霊が出るはずないのよ。",
            "zh": "根本不可能闹鬼嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "518/TALK",
            "narrator": "女子高校生Ａ",
            "text": "す、凄いわね。\nそこまで調べたんだ？",
            "zh": "好、好厉害啊。\n你连这些都查过了吗？",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "520/TALK",
            "narrator": "ガブリエラ",
            "text": "当然じゃない。\nあ、そろそろ玄関ね。",
            "zh": "那是当然。\n啊，快到大门了呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "521/TALK",
            "narrator": "女子高校生Ａ",
            "text": "あなたのお友達にも\n注意しないと、\nまったく…。",
            "zh": "待会儿也得提醒一下\n你的那些朋友们才行，\n真是的……。",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "537/TALK",
            "narrator": "ガブリエラ",
            "text": "お待たせ。",
            "zh": "久等了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "539/TALK",
            "narrator": "ヒカル",
            "text": "おかえりなさい、\nガブリエラさん。",
            "zh": "欢迎回来，\n加布里埃拉。",
            "narrator_zh": "光"
        },
        {
            "location": "540/TALK",
            "narrator": "雛",
            "text": "ガブリエラちゃん、\n無事だったんだね！",
            "zh": "加布里埃拉，\n你平安下来了呀！",
            "narrator_zh": "雏"
        },
        {
            "location": "542/TALK",
            "narrator": "ガブリエラ",
            "text": "物騒なこと言わないでよ。\n無事に決まってるでしょ？",
            "zh": "别说得那么吓人啦。\n我当然平平安安的吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "544/TALK",
            "narrator": "キリト",
            "text": "遅いから心配したんだぞ？",
            "zh": "看你这么慢，我们都担心了啊？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "546/TALK",
            "narrator": "つばめ",
            "text": "暗いから、階段から\n落ちたりしてないか、\nって。",
            "zh": "因为太黑了，我们还怕你\n是不是从楼梯上\n摔下来了呢。",
            "narrator_zh": "燕"
        },
        {
            "location": "549/TALK",
            "narrator": "ガブリエラ",
            "text": "落ちたりなんか\nしないって。",
            "zh": "怎么可能\n摔下来嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "552/TALK",
            "narrator": "ガブリエラ",
            "text": "この人に見つかって、\nちょっと話し込んでた\nだけよ。",
            "zh": "只是被这个人撞见了，\n稍微聊了几句\n而已。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "554/TALK",
            "narrator": "ヒカル",
            "text": "この人？\nそれって誰ですか？",
            "zh": "这个人？\n你说的是谁呀？",
            "narrator_zh": "光"
        },
        {
            "location": "556/TALK",
            "narrator": "ガブリエラ",
            "text": "？",
            "zh": "？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "557/TALK",
            "narrator": "雛",
            "text": "ガブリエラちゃん以外、\n誰もいないよ？",
            "zh": "除了加布里埃拉以外，\n这儿根本没人啊？",
            "narrator_zh": "雏"
        },
        {
            "location": "560/TALK",
            "narrator": "ガブリエラ",
            "text": "あれ？\nさっきまでいたのに…。",
            "zh": "咦？\n刚才明明还在这儿的……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "562/TALK",
            "narrator": "つばめ",
            "text": "こんな時間なのに、\n他に生徒がいたの？",
            "zh": "都这么晚了，\n还有别的学生在学校里吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "565/TALK",
            "narrator": "ガブリエラ",
            "text": "え、ええ…確か、\n高等部生徒会の副会長\nって言ってたわ。",
            "zh": "嗯、嗯……我记得，\n她是说自己是高中部\n学生会的副会长来着。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "566/TALK",
            "narrator": "キリト",
            "text": "それって、あのマッチョの\n野田先輩のことか？",
            "zh": "你是说那个肌肉猛男\n野田前辈吗？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "569/TALK",
            "narrator": "ガブリエラ",
            "text": "…マッチョ？",
            "zh": "……肌肉猛男？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "570/TALK",
            "narrator": "雛",
            "text": "野田先輩って、\nレスリング部の遠征で\n来週までお休みだよ？",
            "zh": "野田前辈不是参加\n摔跤部远征，\n要请假到下周吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "572/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょっと待って。\n副会長って女の人でしょ？",
            "zh": "等一下。\n副会长不是女孩子吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "573/TALK",
            "narrator": "ヒカル",
            "text": "？　野田先輩は\n男性ですよ？",
            "zh": "？　野田前辈是\n男生哦？",
            "narrator_zh": "光"
        },
        {
            "location": "574/TALK",
            "narrator": "キリト",
            "text": "ははっ、あれを女に\n見間違えることは\nまずねぇわな。",
            "zh": "哈哈，那位怎么看也不可能\n让人误认成\n女孩子吧。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "575/TALK",
            "narrator": "キリト",
            "text": "身長二メートル近い\n筋肉の塊だぜ？",
            "zh": "那可是身高将近两米的\n一块肌肉疙瘩啊？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "576/TALK",
            "narrator": "つばめ",
            "text": "…ガブちゃんが会ったの、\nその人じゃないの？",
            "zh": "……加布遇见的，\n不是那个人吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "577/TALK",
            "narrator": "ガブリエラ",
            "text": "ふ、普通の女の人よ！",
            "zh": "是、是普通的女生啊！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "578/TALK",
            "narrator": "ガブリエラ",
            "text": "生徒会の副会長で、\n先生に頼まれて屋上を\n施錠しに来た、って――",
            "zh": "说是学生会副会长，\n受老师所托来锁\n天台门的——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "581/TALK",
            "narrator": "ガブリエラ",
            "text": "玄関の近くまで\n一緒にいたんだから！",
            "zh": "还一直陪我走到\n大门附近呢！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "583/TALK",
            "narrator": "キリト",
            "text": "お、おいおい、待てよ！\nそれおかしいだろ？",
            "zh": "喂、喂喂，等一下！\n这不对劲吧？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "584/TALK",
            "narrator": "キリト",
            "text": "こんな時間まで生徒が\n残ってるはずねぇし――",
            "zh": "这么晚了学校里根本不可能\n还有学生留着——",
            "narrator_zh": "圣翔"
        },
        {
            "location": "586/TALK",
            "narrator": "キリト",
            "text": "施錠を生徒に任せるとか、\nありえねぇから。",
            "zh": "更不可能把锁门的事\n交给学生去办吧。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "588/TALK",
            "narrator": "雛",
            "text": "じゃ、じゃあ何？\nガブリエラちゃんが\n会ったのって――",
            "zh": "那、那算什么？\n加布里埃拉刚才\n遇见的难道——",
            "narrator_zh": "雏"
        },
        {
            "location": "589/TALK",
            "narrator": "雛",
            "text": "まさか…。",
            "zh": "该不会……。",
            "narrator_zh": "雏"
        },
        {
            "location": "592/TALK",
            "narrator": "ガブリエラ",
            "text": "っ！？",
            "zh": "唔！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "594/TALK",
            "narrator": "ガブリエラ",
            "text": "い、いやあぁぁぁぁぁ！！",
            "zh": "不、不要啊啊啊啊啊！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "600/TALK",
            "narrator": "つばめ",
            "text": "ま、待って置いてか\nないでー！！",
            "zh": "等、等等，别丢下\n我不管呀——！！",
            "narrator_zh": "燕"
        },
        {
            "location": "603/TALK",
            "narrator": "雛",
            "text": "出たあぁぁぁぁぁぁ！！",
            "zh": "闹鬼啦啊啊啊啊啊！！",
            "narrator_zh": "雏"
        },
        {
            "location": "605/TALK",
            "narrator": "キリト",
            "text": "あ、待て、待って！\n腰、腰が、あわわわわ！",
            "zh": "啊，等等，等一下！\n腿、腿软了，啊哇哇哇哇！",
            "narrator_zh": "圣翔"
        },
        {
            "location": "607/TALK",
            "narrator": "ヒカル",
            "text": "キリト、しっかりして\nください！！",
            "zh": "圣翔，请你振作\n一点！！",
            "narrator_zh": "光"
        },
        {
            "location": "620/TALK",
            "narrator": "女子高校生Ａ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "621/TALK",
            "narrator": "女子高校生Ａ",
            "text": "ようやく帰ったか。\nやれやれ、まったく…。",
            "zh": "总算走了啊。\n真是的，一个个的……。",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "622/TALK",
            "narrator": "女子高校生Ａ",
            "text": "よっ…。",
            "zh": "嘿咻……。",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "633/TALK",
            "narrator": "真幌",
            "text": "ふぅ…どうやら、\nバレてはいないようだな。",
            "zh": "呼……看来，\n是没有穿帮呢。",
            "narrator_zh": "真幌"
        },
        {
            "location": "634/TALK",
            "narrator": "真幌",
            "text": "普通に注意するより、\n驚かした方が効果的かと\n思ったのだが――",
            "zh": "本以为比起正经提醒，\n吓唬一下会更有\n效果——",
            "narrator_zh": "真幌"
        },
        {
            "location": "635/TALK",
            "narrator": "真幌",
            "text": "予想以上だったな。",
            "zh": "没想到效果好过头了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "636/TALK",
            "narrator": "真幌",
            "text": "ふふっ、私の変装の腕は\nまだまだ衰え知らずの\nようだ。",
            "zh": "呵呵，看来我的变装手艺\n也还没有\n退步嘛。",
            "narrator_zh": "真幌"
        },
        {
            "location": "638/TALK",
            "narrator": "真幌",
            "text": "…しかし、女子高生の\n制服は、もう二度と\n着る気になれんな…。",
            "zh": "……不过，女高中生的\n制服，我可再也不想\n穿第二次了……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "282/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>7月19日　8:44 PM</color>\nとある平日の夜、附属学園前庭にて。",
            "zh": "<color=green>7月19日　8:44 PM</color>\n某个平日夜晚，在附属学园前庭。",
            "narrator_zh": "Dialog_EventData"
        },
        {
            "location": "649/DIALOG",
            "narrator": "Dialog_GEThimegoto_ch03",
            "text": "【別名は花子さん】",
            "zh": "【别名是花子】",
            "narrator_zh": "Dialog_GEThimegoto_ch03"
        }
    ]
}
