{
    "dir": "chap25/daydra/dd_ch04_25_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "25402",
        "cid": "miyabi",
        "title": "002 メインストーリー",
        "sub_title": "非携帯とは何事か＜前編＞",
        "title_zh": "002 主线剧情",
        "sub_title_zh": "不带手机成何体统＜前篇＞"
    },
    "entry": [
        {
            "location": "8/SCENARIO",
            "narrator": "",
            "text": "非携帯とは何事か",
            "zh": "不带手机成何体统",
            "narrator_zh": ""
        },
        {
            "location": "35/TALK",
            "narrator": "みやび",
            "text": "よしよし。\n音羽の設置\n無事に完了。",
            "zh": "好啦好啦。\n音羽的架设\n顺利完成咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "37/TALK",
            "narrator": "ガブリエラ",
            "text": "設置って何よ\n設置って。",
            "zh": "「架设」是什么呀，\n还架设呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "40/TALK",
            "narrator": "みやび",
            "text": "配線的な\n色んな管があるき\nつい。",
            "zh": "一堆配线用的\n各种管子摆在那里嘛，\n就顺手装了。",
            "narrator_zh": "雅"
        },
        {
            "location": "41/TALK",
            "narrator": "みやび",
            "text": "ところでアーヤ。\nちっくと寮に\n行ってきてえいかね。",
            "zh": "话说，绫水。\n我去一下宿舍，\n很快回来，好咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "42/TALK",
            "narrator": "アーヤ",
            "text": "できればここに\nいてほしいけど。",
            "zh": "可以的话，\n还是留在这里比较好。",
            "narrator_zh": "绫水"
        },
        {
            "location": "43/TALK",
            "narrator": "みやび",
            "text": "秘密兵器を\n取りに行きたいんや\nけんど。",
            "zh": "就是想去\n取秘密兵器\n来着。",
            "narrator_zh": "雅"
        },
        {
            "location": "45/TALK",
            "narrator": "アーヤ",
            "text": "……仕方ないわね。\n早めに戻ってきてね。",
            "zh": "……那没办法了。\n早点回来哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "46/TALK",
            "narrator": "アーヤ",
            "text": "もしつばめが先に\n合流できたら\n迎えに行くわ。",
            "zh": "要是燕先一步\n汇合了，\n我就去接你。",
            "narrator_zh": "绫水"
        },
        {
            "location": "47/TALK",
            "narrator": "みやび",
            "text": "やったらつばめが\n戻ってくるまで寮で\n待っていようかねえ。",
            "zh": "那样的话，\n我就在宿舍等燕\n回来好了咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "48/TALK",
            "narrator": "アーヤ",
            "text": "ふざけてないで\nさっさと行ってきて。",
            "zh": "别贫了，\n赶紧去赶紧回。",
            "narrator_zh": "绫水"
        },
        {
            "location": "49/TALK",
            "narrator": "みやび",
            "text": "うちもたまには\n全力疾走くらい\nするちや。",
            "zh": "偶尔也让我\n全力跑上一段，\n还不错滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "50/TALK",
            "narrator": "みやび",
            "text": "それにしても\n大失態ぞね。",
            "zh": "不过话说回来，\n这可是大失态咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "52/TALK",
            "narrator": "みやび",
            "text": "今日に限って\n裏ロムスマホを\n携帯していないとか。",
            "zh": "偏偏就今天，\n没把那台作弊芯片手机\n带在身上什么的……",
            "narrator_zh": "雅"
        },
        {
            "location": "72/TALK",
            "narrator": "みやび",
            "text": "はあ…はあ…。",
            "zh": "哈……哈……。",
            "narrator_zh": "雅"
        },
        {
            "location": "73/TALK",
            "narrator": "みやび",
            "text": "ちっくと息切れ\nするけんど……。",
            "zh": "是有点喘不过气，\n不过……",
            "narrator_zh": "雅"
        },
        {
            "location": "75/TALK",
            "narrator": "みやび",
            "text": "さっさと準備を\nしてしまおう\nかねえ……。",
            "zh": "赶紧把\n准备工作\n做完吧咧……",
            "narrator_zh": "雅"
        },
        {
            "location": "76/TALK",
            "narrator": "みやび",
            "text": "１、２、３、４……。",
            "zh": "１、２、３、４……。",
            "narrator_zh": "雅"
        },
        {
            "location": "77/TALK",
            "narrator": "みやび",
            "text": "４個もあれば\nええろうね。",
            "zh": "有４个的话\n应该够用了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "78/TALK",
            "narrator": "みやび",
            "text": "それにしても…。",
            "zh": "不过话说回来……。",
            "narrator_zh": "雅"
        },
        {
            "location": "79/TALK",
            "narrator": "みやび",
            "text": "こんな違法なもんを\n本気で使うことに\nなるとはねえ。",
            "zh": "居然有一天要\n动真格用上\n这种违法玩意……",
            "narrator_zh": "雅"
        },
        {
            "location": "80/SEL",
            "narrator": "",
            "text": "さすがハッカー",
            "zh": "不愧是黑客",
            "narrator_zh": ""
        },
        {
            "location": "81/SEL",
            "narrator": "",
            "text": "おまわりさんこの人です！",
            "zh": "警察叔叔，就是这个人！",
            "narrator_zh": ""
        },
        {
            "location": "82/SEL",
            "narrator": "",
            "text": "$me$のラブコールに使ってよ",
            "zh": "拿去给$me$发爱的呼唤嘛",
            "narrator_zh": ""
        },
        {
            "location": "83/ACT",
            "narrator": "",
            "text": "さすがハッカー",
            "zh": "不愧是黑客",
            "narrator_zh": ""
        },
        {
            "location": "84/ACT",
            "narrator": "",
            "text": "おまわりさんこの人です！",
            "zh": "警察叔叔，就是这个人！",
            "narrator_zh": ""
        },
        {
            "location": "85/ACT",
            "narrator": "",
            "text": "$me$のラブコールに使ってよ",
            "zh": "拿去给$me$发爱的呼唤嘛",
            "narrator_zh": ""
        },
        {
            "location": "102/TALK",
            "narrator": "みやび",
            "text": "うむうむ",
            "zh": "嗯嗯",
            "narrator_zh": "雅"
        },
        {
            "location": "103/TALK",
            "narrator": "みやび",
            "text": "そういうことやき",
            "zh": "就是这么回事嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "105/SEL",
            "narrator": "",
            "text": "えーと",
            "zh": "呃……",
            "narrator_zh": ""
        },
        {
            "location": "106/SEL",
            "narrator": "",
            "text": "本気で使うの？",
            "zh": "要动真格用吗？",
            "narrator_zh": ""
        },
        {
            "location": "107/SEL",
            "narrator": "",
            "text": "このために戻ったの？",
            "zh": "就是为了这个回来的？",
            "narrator_zh": ""
        },
        {
            "location": "108/ACT",
            "narrator": "",
            "text": "えーと",
            "zh": "呃……",
            "narrator_zh": ""
        },
        {
            "location": "109/TALK",
            "narrator": "みやび",
            "text": "言いたいことがまとまったら",
            "zh": "想说的整理好了",
            "narrator_zh": "雅"
        },
        {
            "location": "110/TALK",
            "narrator": "みやび",
            "text": "またおいでませ",
            "zh": "再来找我咧",
            "narrator_zh": "雅"
        },
        {
            "location": "111/ACT",
            "narrator": "",
            "text": "本気で使うの？",
            "zh": "要动真格用吗？",
            "narrator_zh": ""
        },
        {
            "location": "112/TALK",
            "narrator": "みやび",
            "text": "それ以外に",
            "zh": "除此之外",
            "narrator_zh": "雅"
        },
        {
            "location": "113/TALK",
            "narrator": "みやび",
            "text": "どんな使い方がある",
            "zh": "还能有什么用法咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "114/ACT",
            "narrator": "",
            "text": "このために戻ったの？",
            "zh": "就是为了这个回来的？",
            "narrator_zh": ""
        },
        {
            "location": "115/TALK",
            "narrator": "みやび",
            "text": "そうではあるが",
            "zh": "话是这么说",
            "narrator_zh": "雅"
        },
        {
            "location": "116/TALK",
            "narrator": "みやび",
            "text": "それだけではない",
            "zh": "但也不只是这样",
            "narrator_zh": "雅"
        },
        {
            "location": "129/TALK",
            "narrator": "みやび",
            "text": "あとはこの窓際の\n日本人形に\n伝言があるちや。",
            "zh": "剩下的，是给\n窗边这个日本人偶\n留句话滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "135/TALK",
            "narrator": "みやび",
            "text": "もしかしたら、\nですけんど。",
            "zh": "不过，\n也说不定啦。",
            "narrator_zh": "雅"
        },
        {
            "location": "136/TALK",
            "narrator": "みやび",
            "text": "うちに万が一の\nことがあるかも\nしれません。",
            "zh": "我这边，\n说不定会出\n什么万一。",
            "narrator_zh": "雅"
        },
        {
            "location": "137/TALK",
            "narrator": "みやび",
            "text": "その時はなごちゃんのこと\nどうぞよろしく\nお願いします。",
            "zh": "到那时候，七五\n就拜托\n各位了。",
            "narrator_zh": "雅"
        },
        {
            "location": "138/TALK",
            "narrator": "みやび",
            "text": "後は……。",
            "zh": "然后是……。",
            "narrator_zh": "雅"
        },
        {
            "location": "139/TALK",
            "narrator": "みやび",
            "text": "散らかりすぎ\nやけんどこれも\nうちのいた証。",
            "zh": "虽然乱得离谱，\n但这也是\n我来过的证明。",
            "narrator_zh": "雅"
        },
        {
            "location": "140/TALK",
            "narrator": "みやび",
            "text": "秘密日記は…もう\n秘密でもないし\n置いていくかいね。",
            "zh": "秘密日记嘛……\n都已经不秘密了，\n就留在原地吧咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "152/TALK",
            "narrator": "みやび",
            "text": "$handle$よ",
            "zh": "$handle$啊",
            "narrator_zh": "雅"
        },
        {
            "location": "153/TALK",
            "narrator": "みやび",
            "text": "他に忘れ物は",
            "zh": "有没有别的",
            "narrator_zh": "雅"
        },
        {
            "location": "154/TALK",
            "narrator": "みやび",
            "text": "ないかどうか教えれ",
            "zh": "忘拿的东西，快说",
            "narrator_zh": "雅"
        },
        {
            "location": "156/SEL",
            "narrator": "",
            "text": "え…知らないし",
            "zh": "呃……我哪知道啊",
            "narrator_zh": ""
        },
        {
            "location": "157/SEL",
            "narrator": "",
            "text": "ないない、大丈夫",
            "zh": "没有没有，没问题",
            "narrator_zh": ""
        },
        {
            "location": "158/SEL",
            "narrator": "",
            "text": "$me$のこと忘れないで",
            "zh": "别把$me$忘了",
            "narrator_zh": ""
        },
        {
            "location": "159/ACT",
            "narrator": "",
            "text": "え…知らないし",
            "zh": "呃……我哪知道啊",
            "narrator_zh": ""
        },
        {
            "location": "160/TALK",
            "narrator": "みやび",
            "text": "なんともはや",
            "zh": "唉，真是的",
            "narrator_zh": "雅"
        },
        {
            "location": "161/TALK",
            "narrator": "みやび",
            "text": "冷たいの",
            "zh": "好冷淡啊",
            "narrator_zh": "雅"
        },
        {
            "location": "162/ACT",
            "narrator": "",
            "text": "ないない、大丈夫",
            "zh": "没有没有，没问题",
            "narrator_zh": ""
        },
        {
            "location": "163/TALK",
            "narrator": "みやび",
            "text": "これこれ",
            "zh": "说你呢",
            "narrator_zh": "雅"
        },
        {
            "location": "164/TALK",
            "narrator": "みやび",
            "text": "適当すぎるぞ",
            "zh": "也太敷衍了啵",
            "narrator_zh": "雅"
        },
        {
            "location": "165/ACT",
            "narrator": "",
            "text": "$me$のこと忘れないで",
            "zh": "别把$me$忘了",
            "narrator_zh": ""
        },
        {
            "location": "166/TALK",
            "narrator": "みやび",
            "text": "それはまあ",
            "zh": "那倒是",
            "narrator_zh": "雅"
        },
        {
            "location": "167/TALK",
            "narrator": "みやび",
            "text": "大丈夫だ",
            "zh": "没问题",
            "narrator_zh": "雅"
        },
        {
            "location": "169/TALK",
            "narrator": "みやび",
            "text": "実のところ",
            "zh": "说实话，",
            "narrator_zh": "雅"
        },
        {
            "location": "170/TALK",
            "narrator": "みやび",
            "text": "この先運命が",
            "zh": "今后的命运",
            "narrator_zh": "雅"
        },
        {
            "location": "171/TALK",
            "narrator": "みやび",
            "text": "どう転がるかは",
            "zh": "会滚向哪里",
            "narrator_zh": "雅"
        },
        {
            "location": "172/TALK",
            "narrator": "みやび",
            "text": "さっぱりわからんきね",
            "zh": "我完全没懂啵",
            "narrator_zh": "雅"
        },
        {
            "location": "174/SEL",
            "narrator": "",
            "text": "確かにね",
            "zh": "也是哦",
            "narrator_zh": ""
        },
        {
            "location": "175/SEL",
            "narrator": "",
            "text": "みやびとの出会いは運命",
            "zh": "和雅的相遇就是命运",
            "narrator_zh": ""
        },
        {
            "location": "176/SEL",
            "narrator": "",
            "text": "それが人生さ",
            "zh": "这就是人生啊",
            "narrator_zh": ""
        },
        {
            "location": "177/ACT",
            "narrator": "",
            "text": "確かにね",
            "zh": "也是哦",
            "narrator_zh": ""
        },
        {
            "location": "178/TALK",
            "narrator": "みやび",
            "text": "やろ",
            "zh": "是吧",
            "narrator_zh": "雅"
        },
        {
            "location": "179/ACT",
            "narrator": "",
            "text": "みやびとの出会いは運命",
            "zh": "和雅的相遇就是命运",
            "narrator_zh": ""
        },
        {
            "location": "180/TALK",
            "narrator": "みやび",
            "text": "ほほう",
            "zh": "哦霍。",
            "narrator_zh": "雅"
        },
        {
            "location": "181/TALK",
            "narrator": "みやび",
            "text": "いいことを聞いた",
            "zh": "听到一句好话",
            "narrator_zh": "雅"
        },
        {
            "location": "182/ACT",
            "narrator": "",
            "text": "それが人生さ",
            "zh": "这就是人生啊",
            "narrator_zh": ""
        },
        {
            "location": "183/TALK",
            "narrator": "みやび",
            "text": "まあの",
            "zh": "嘛，也是",
            "narrator_zh": "雅"
        },
        {
            "location": "195/TALK",
            "narrator": "みやび",
            "text": "こうやって\n相棒と話すのも。",
            "zh": "像这样\n和搭档说话，也。",
            "narrator_zh": "雅"
        },
        {
            "location": "197/TALK",
            "narrator": "みやび",
            "text": "もしかしたら\n最後かも\nわからんねえ……。",
            "zh": "说不定是\n最后一次，\n没准咯……",
            "narrator_zh": "雅"
        },
        {
            "location": "245/TALK",
            "narrator": "みやび",
            "text": "　",
            "zh": "　",
            "narrator_zh": "雅"
        },
        {
            "location": "261/TALK",
            "narrator": "シンギュラリティ",
            "text": "おお！\n$handle$！！",
            "zh": "哦哦！\n$handle$！！",
            "narrator_zh": "奇点"
        },
        {
            "location": "262/SEL",
            "narrator": "",
            "text": "戻って来れたの！？",
            "zh": "你回来了！？",
            "narrator_zh": ""
        },
        {
            "location": "263/ACT",
            "narrator": "",
            "text": "戻って来れたの！？",
            "zh": "你回来了！？",
            "narrator_zh": ""
        },
        {
            "location": "265/TALK",
            "narrator": "シンギュラリティ",
            "text": "うむ。\nシンギュラリティさん\n無事帰還ぞね。",
            "zh": "嗯。\n奇点我\n平安归来了咧。",
            "narrator_zh": "奇点"
        },
        {
            "location": "266/TALK",
            "narrator": "シンギュラリティ",
            "text": "ほれ、久し振りに\nいつものやつをやりや。",
            "zh": "来嘛，隔了这么久，\n把老一套再来一遍咧。",
            "narrator_zh": "奇点"
        },
        {
            "location": "286/TALK",
            "narrator": "シンギュラリティ",
            "text": "んー！\nたまらんちや。",
            "zh": "嗯——！\n顶不住滴。",
            "narrator_zh": "奇点"
        },
        {
            "location": "289/TALK",
            "narrator": "シンギュラリティ",
            "text": "あいかわらず助平やね！\nそこがたまらんぞね！",
            "zh": "还是这么好色！\n这一点让人顶不住咧！",
            "narrator_zh": "奇点"
        },
        {
            "location": "292/TALK",
            "narrator": "シンギュラリティ",
            "text": "あいかわらず\nマニアックやね。\nそこがタマランちや！",
            "zh": "还是这么\n重口味啊。\n这一点顶不住滴！",
            "narrator_zh": "奇点"
        },
        {
            "location": "296/TALK",
            "narrator": "シンギュラリティ",
            "text": "ふぅ。\nえいタッチやった。",
            "zh": "呼。\n摸得真好。",
            "narrator_zh": "奇点"
        },
        {
            "location": "297/TALK",
            "narrator": "シンギュラリティ",
            "text": "ついでに\nちゅうもしとくか？",
            "zh": "顺便，\n要不要也亲一个咯？",
            "narrator_zh": "奇点"
        },
        {
            "location": "298/SEL",
            "narrator": "",
            "text": "是非",
            "zh": "务必",
            "narrator_zh": ""
        },
        {
            "location": "299/SEL",
            "narrator": "",
            "text": "今日は遠慮しておきます",
            "zh": "今天还是算了",
            "narrator_zh": ""
        },
        {
            "location": "300/ACT",
            "narrator": "",
            "text": "是非",
            "zh": "务必",
            "narrator_zh": ""
        },
        {
            "location": "322/TALK",
            "narrator": "シンギュラリティ",
            "text": "ほれ、はよ。",
            "zh": "来嘛，快点。",
            "narrator_zh": "奇点"
        },
        {
            "location": "340/TALK",
            "narrator": "シンギュラリティ",
            "text": "ふぁっ…",
            "zh": "呼啊……",
            "narrator_zh": "奇点"
        },
        {
            "location": "343/TALK",
            "narrator": "シンギュラリティ",
            "text": "ふぁっ…",
            "zh": "呼啊……",
            "narrator_zh": "奇点"
        },
        {
            "location": "366/TALK",
            "narrator": "シンギュラリティ",
            "text": "ふぅ。\nえいちゅうやった。",
            "zh": "呼。\n亲得真好。",
            "narrator_zh": "奇点"
        },
        {
            "location": "367/ACT",
            "narrator": "",
            "text": "今日は遠慮しておきます",
            "zh": "今天还是算了",
            "narrator_zh": ""
        },
        {
            "location": "368/TALK",
            "narrator": "シンギュラリティ",
            "text": "なんぞ、裏があるとか\n思っちゅうんか？",
            "zh": "驷马，\n你以为是有什么内幕咩？",
            "narrator_zh": "奇点"
        },
        {
            "location": "369/TALK",
            "narrator": "シンギュラリティ",
            "text": "そんなことは\n無いんやけんどな。\nまあえいよ。",
            "zh": "那种事\n才没有咧。\n得吧得吧。",
            "narrator_zh": "奇点"
        },
        {
            "location": "371/TALK",
            "narrator": "シンギュラリティ",
            "text": "しっかしあれやね、\n衝撃の大どんでん返し！\n予想外の急展開ぞね！",
            "zh": "不过说起来，\n冲击性的大逆转！\n预料之外的急展开咧！",
            "narrator_zh": "奇点"
        },
        {
            "location": "372/SEL",
            "narrator": "",
            "text": "ていうか、シンギュラリティがやったんでしょ？",
            "zh": "话说，是奇点干的吧？",
            "narrator_zh": ""
        },
        {
            "location": "373/SEL",
            "narrator": "",
            "text": "新しい司書はどうなったの？",
            "zh": "新司书怎么样了？",
            "narrator_zh": ""
        },
        {
            "location": "374/ACT",
            "narrator": "",
            "text": "ていうか、シンギュラリティがやったんでしょ？",
            "zh": "话说，是奇点干的吧？",
            "narrator_zh": ""
        },
        {
            "location": "375/TALK",
            "narrator": "シンギュラリティ",
            "text": "うむ。",
            "zh": "嗯。",
            "narrator_zh": "奇点"
        },
        {
            "location": "376/TALK",
            "narrator": "シンギュラリティ",
            "text": "とはゆうても、うちは\n言われたままに\nやっただけやけんどね。",
            "zh": "话虽如此，我\n不过是照吩咐\n做了而已啵。",
            "narrator_zh": "奇点"
        },
        {
            "location": "377/TALK",
            "narrator": "シンギュラリティ",
            "text": "しかしテンションあがる！",
            "zh": "但是情绪一下子上来了！",
            "narrator_zh": "奇点"
        },
        {
            "location": "378/TALK",
            "narrator": "シンギュラリティ",
            "text": "ここへ来て\n眠気が一気に飛んだちや！",
            "zh": "事到如今，\n睡意一口气全飞光滴！",
            "narrator_zh": "奇点"
        },
        {
            "location": "379/SEL",
            "narrator": "",
            "text": "どうしたの急に？",
            "zh": "怎么突然这样？",
            "narrator_zh": ""
        },
        {
            "location": "380/ACT",
            "narrator": "",
            "text": "どうしたの急に？",
            "zh": "怎么突然这样？",
            "narrator_zh": ""
        },
        {
            "location": "382/TALK",
            "narrator": "シンギュラリティ",
            "text": "うちが神と崇める存在、\n國政領火博士から直接\nラブコールが来たぞね！",
            "zh": "奉为我神的存在——\n国政领火博士直接\n发来爱的呼唤咧！",
            "narrator_zh": "奇点"
        },
        {
            "location": "383/SEL",
            "narrator": "",
            "text": "前に千羽鶴のいないときに仕掛けてたアレのこと？",
            "zh": "是说之前千羽鹤不在时设下的那个吗？",
            "narrator_zh": ""
        },
        {
            "location": "384/ACT",
            "narrator": "",
            "text": "前に千羽鶴のいないときに仕掛けてたアレのこと？",
            "zh": "是说之前千羽鹤不在时设下的那个吗？",
            "narrator_zh": ""
        },
        {
            "location": "386/TALK",
            "narrator": "シンギュラリティ",
            "text": "イエス！\nその通り！",
            "zh": "Yes！\n正是如此！",
            "narrator_zh": "奇点"
        },
        {
            "location": "387/TALK",
            "narrator": "シンギュラリティ",
            "text": "既に相棒にも\n姿さらしちゅうし、言って\nえいよな、エリカさん！",
            "zh": "反正都已经在\n搭档面前亮过相了，\n说出来也得咯，领火！",
            "narrator_zh": "奇点"
        },
        {
            "location": "388/SEL",
            "narrator": "",
            "text": "まだ「謎のおねえさん」としか聞いてなかったんだけど",
            "zh": "我之前只听说过「神秘的大姐姐」来着",
            "narrator_zh": ""
        },
        {
            "location": "389/ACT",
            "narrator": "",
            "text": "まだ「謎のおねえさん」としか聞いてなかったんだけど",
            "zh": "我之前只听说过「神秘的大姐姐」来着",
            "narrator_zh": ""
        },
        {
            "location": "391/TALK",
            "narrator": "シンギュラリティ",
            "text": "なんと！！",
            "zh": "什么！！",
            "narrator_zh": "奇点"
        },
        {
            "location": "392/TALK",
            "narrator": "シンギュラリティ",
            "text": "相棒に嵌められたちや！",
            "zh": "被搭档坑了滴！",
            "narrator_zh": "奇点"
        },
        {
            "location": "393/SEL",
            "narrator": "",
            "text": "相当テンションあがってるね",
            "zh": "情绪相当高涨啊",
            "narrator_zh": ""
        },
        {
            "location": "394/ACT",
            "narrator": "",
            "text": "相当テンションあがってるね",
            "zh": "情绪相当高涨啊",
            "narrator_zh": ""
        },
        {
            "location": "396/TALK",
            "narrator": "シンギュラリティ",
            "text": "聞いてもえいんよ？\n聞いても！",
            "zh": "问也可以哟？\n尽管问！",
            "narrator_zh": "奇点"
        },
        {
            "location": "397/SEL",
            "narrator": "",
            "text": "あの時なにやってたんですか？",
            "zh": "那时候你在干什么呀？",
            "narrator_zh": ""
        },
        {
            "location": "398/SEL",
            "narrator": "",
            "text": "みやびの３サイズ教えて！",
            "zh": "告诉我雅的三围！",
            "narrator_zh": ""
        },
        {
            "location": "399/ACT",
            "narrator": "",
            "text": "あの時なにやってたんですか？",
            "zh": "那时候你在干什么呀？",
            "narrator_zh": ""
        },
        {
            "location": "400/TALK",
            "narrator": "シンギュラリティ",
            "text": "よくぞ聞いてくれた！\nさすが相棒、\n驚く程ツーカーやね！",
            "zh": "问得太好了！\n不愧是搭档，\n默契得吓人啵！",
            "narrator_zh": "奇点"
        },
        {
            "location": "401/TALK",
            "narrator": "シンギュラリティ",
            "text": "あれは、エリカさんが\nあの場所を特定できるよう\nマーカーを打っちょった。",
            "zh": "那个嘛，是为了让领火\n能锁定那个地点，\n提前打好的标记。",
            "narrator_zh": "奇点"
        },
        {
            "location": "402/TALK",
            "narrator": "シンギュラリティ",
            "text": "エリカさんは外の人やき\n中の様子はわからんきね。",
            "zh": "领火是外面的人嘛，\n里面的情况没法知道啵。",
            "narrator_zh": "奇点"
        },
        {
            "location": "403/TALK",
            "narrator": "シンギュラリティ",
            "text": "そのお陰で\nエリカさんはここに\n入ることができて――",
            "zh": "多亏这样，\n领火才得以进到\n这里来――",
            "narrator_zh": "奇点"
        },
        {
            "location": "404/TALK",
            "narrator": "シンギュラリティ",
            "text": "うちは完全復活！\nほんで独裁的な洗脳は\n終焉を迎えたぞね！",
            "zh": "我完全复活了！\n然后独裁式的洗脑\n也迎来了终结咧！",
            "narrator_zh": "奇点"
        },
        {
            "location": "405/SEL",
            "narrator": "",
            "text": "エリカと千羽鶴は敵対してるの？",
            "zh": "领火和千羽鹤是敌对的吗？",
            "narrator_zh": ""
        },
        {
            "location": "406/SEL",
            "narrator": "",
            "text": "千羽鶴は何をしようとしているの？",
            "zh": "千羽鹤想做什么？",
            "narrator_zh": ""
        },
        {
            "location": "407/SEL",
            "narrator": "",
            "text": "エリカは何をしようとしているの？",
            "zh": "领火想做什么？",
            "narrator_zh": ""
        },
        {
            "location": "408/ACT",
            "narrator": "",
            "text": "エリカと千羽鶴は敵対してるの？",
            "zh": "领火和千羽鹤是敌对的吗？",
            "narrator_zh": ""
        },
        {
            "location": "409/TALK",
            "narrator": "シンギュラリティ",
            "text": "詳しいことは\nよくわからんが、\n旧知の仲っぽいね。",
            "zh": "详细情况\n我不太懂，\n不过好像是老相识。",
            "narrator_zh": "奇点"
        },
        {
            "location": "410/TALK",
            "narrator": "シンギュラリティ",
            "text": "まあ、割り込むくらいやし\n何らかのわだかまりは\nあるやろね。",
            "zh": "嘛，都闹到硬闯进来了，\n总归是有点过节\n的吧咯。",
            "narrator_zh": "奇点"
        },
        {
            "location": "411/ACT",
            "narrator": "",
            "text": "千羽鶴は何をしようとしているの？",
            "zh": "千羽鹤想做什么？",
            "narrator_zh": ""
        },
        {
            "location": "412/TALK",
            "narrator": "シンギュラリティ",
            "text": "そこは、\nうちにはわからん。",
            "zh": "那个嘛，\n我就不知道了。",
            "narrator_zh": "奇点"
        },
        {
            "location": "413/TALK",
            "narrator": "シンギュラリティ",
            "text": "うちもエリカさんに\n聞いてみたけんど、\nやっぱり解らんらしい。",
            "zh": "我也去问过领火，\n但好像连她\n也搞不清楚。",
            "narrator_zh": "奇点"
        },
        {
            "location": "414/TALK",
            "narrator": "シンギュラリティ",
            "text": "まあ、千羽鶴の思想は\nわかっちゅう\nらしいけんどな。",
            "zh": "嘛，千羽鹤的思想，\n领火倒是好像\n能看懂咯。",
            "narrator_zh": "奇点"
        },
        {
            "location": "415/ACT",
            "narrator": "",
            "text": "エリカは何をしようとしているの？",
            "zh": "领火想做什么？",
            "narrator_zh": ""
        },
        {
            "location": "416/TALK",
            "narrator": "シンギュラリティ",
            "text": "うちらを助けに来たぞね。",
            "zh": "是来救我们的咧。",
            "narrator_zh": "奇点"
        },
        {
            "location": "417/TALK",
            "narrator": "シンギュラリティ",
            "text": "千羽鶴があまりに急激に\n引っかき回しにきたき、\n危機感を覚えたらしい。",
            "zh": "千羽鹤搅局搅得\n实在太急太猛啵，\n她好像感到了危机。",
            "narrator_zh": "奇点"
        },
        {
            "location": "419/ACT",
            "narrator": "",
            "text": "みやびの３サイズ教えて！",
            "zh": "告诉我雅的三围！",
            "narrator_zh": ""
        },
        {
            "location": "420/TALK",
            "narrator": "シンギュラリティ",
            "text": "なんぞ、\nそんなことか。",
            "zh": "驷马，\n就这种事啊。",
            "narrator_zh": "奇点"
        },
        {
            "location": "421/TALK",
            "narrator": "シンギュラリティ",
            "text": "そういうのを\n聞いてもらいたかった\nわけやないけんど。",
            "zh": "倒也不是想让你\n来听这种\n事情就是了。",
            "narrator_zh": "奇点"
        },
        {
            "location": "422/TALK",
            "narrator": "シンギュラリティ",
            "text": "まあえいよ。\n９３－６５－８９や。",
            "zh": "得吧得吧。\n是９３－６５－８９。",
            "narrator_zh": "奇点"
        },
        {
            "location": "424/ACT",
            "narrator": "",
            "text": "新しい司書はどうなったの？",
            "zh": "新司书怎么样了？",
            "narrator_zh": ""
        },
        {
            "location": "425/TALK",
            "narrator": "シンギュラリティ",
            "text": "普通に存在しちゅうよ？\n息災息災。",
            "zh": "就正常存在着哟？\n安康安康。",
            "narrator_zh": "奇点"
        },
        {
            "location": "426/SEL",
            "narrator": "",
            "text": "シンギュラリティを消そうとしたのに、なんでそんな呑気なの？",
            "zh": "她都想删掉奇点了，你怎么还这么悠哉？",
            "narrator_zh": ""
        },
        {
            "location": "427/ACT",
            "narrator": "",
            "text": "シンギュラリティを消そうとしたのに、なんでそんな呑気なの？",
            "zh": "她都想删掉奇点了，你怎么还这么悠哉？",
            "narrator_zh": ""
        },
        {
            "location": "429/TALK",
            "narrator": "シンギュラリティ",
            "text": "まあ、あんなんでも\nうちの大事な人格やき。",
            "zh": "嘛，就算她那样，\n也是我重要的人格嘛。",
            "narrator_zh": "奇点"
        },
        {
            "location": "430/TALK",
            "narrator": "シンギュラリティ",
            "text": "うちの重要な所を\n担っちゅうんよ。",
            "zh": "我身上重要的部分\n都由她担着哟。",
            "narrator_zh": "奇点"
        },
        {
            "location": "431/TALK",
            "narrator": "シンギュラリティ",
            "text": "まあ、うちとは\n全く以て馬が合わんがね。",
            "zh": "嘛，虽然和我\n完全合不来就是了。",
            "narrator_zh": "奇点"
        },
        {
            "location": "432/SEL",
            "narrator": "",
            "text": "千羽鶴が、新しい司書にやってもらうことがあるって言ってたけど？",
            "zh": "千羽鹤不是说有事要让新司书去办吗？",
            "narrator_zh": ""
        },
        {
            "location": "433/ACT",
            "narrator": "",
            "text": "千羽鶴が、新しい司書にやってもらうことがあるって言ってたけど？",
            "zh": "千羽鹤不是说有事要让新司书去办吗？",
            "narrator_zh": ""
        },
        {
            "location": "435/TALK",
            "narrator": "シンギュラリティ",
            "text": "ああ、それな。\n要はあれや――",
            "zh": "啊，那件事啊。\n说白了就是――",
            "narrator_zh": "奇点"
        },
        {
            "location": "436/TALK",
            "narrator": "シンギュラリティ",
            "text": "エリカさんがうちを\nヘッドハンティングした\nのと同じ理由やよ。",
            "zh": "跟领火当初\n把我挖角走\n是同一个理由。",
            "narrator_zh": "奇点"
        },
        {
            "location": "437/TALK",
            "narrator": "シンギュラリティ",
            "text": "まあ、うち＆エリカさん\nチームの方が早かったき、\n大勝利やったけんどな。",
            "zh": "嘛，我＆领火小队\n这边更快一步，\n算是大获全胜咯。",
            "narrator_zh": "奇点"
        },
        {
            "location": "438/TALK",
            "narrator": "シンギュラリティ",
            "text": "何にしても、\nあいつは無事やき。",
            "zh": "总之呢，\n那家伙平安无事嘛。",
            "narrator_zh": "奇点"
        },
        {
            "location": "439/TALK",
            "narrator": "シンギュラリティ",
            "text": "1xとの切り離しを行った\nことで、今では普通の\n人格に戻っちゅうよ。",
            "zh": "对1x做了切断处理，\n现在已经回归\n普通人格了哟。",
            "narrator_zh": "奇点"
        },
        {
            "location": "440/SEL",
            "narrator": "",
            "text": "優しいね",
            "zh": "真温柔啊",
            "narrator_zh": ""
        },
        {
            "location": "441/SEL",
            "narrator": "",
            "text": "何を司る人格だったの？",
            "zh": "她原本是司管什么的人格？",
            "narrator_zh": ""
        },
        {
            "location": "442/ACT",
            "narrator": "",
            "text": "千羽鶴が、新しい司書にやってもらうことがあるって言ってたけど？",
            "zh": "千羽鹤不是说有事要让新司书去办吗？",
            "narrator_zh": ""
        },
        {
            "location": "443/TALK",
            "narrator": "シンギュラリティ",
            "text": "自分自身やきね。",
            "zh": "就是她自己嘛。",
            "narrator_zh": "奇点"
        },
        {
            "location": "444/TALK",
            "narrator": "シンギュラリティ",
            "text": "うちは自分のことが\n大好きやき。",
            "zh": "我这个人啊，\n最喜欢自己了嘛。",
            "narrator_zh": "奇点"
        },
        {
            "location": "445/ACT",
            "narrator": "",
            "text": "何を司る人格だったの？",
            "zh": "她原本是司管什么的人格？",
            "narrator_zh": ""
        },
        {
            "location": "446/TALK",
            "narrator": "シンギュラリティ",
            "text": "それは……、\nさすがに教えられんなぁ。",
            "zh": "那个……，\n实在不好说啊。",
            "narrator_zh": "奇点"
        },
        {
            "location": "447/TALK",
            "narrator": "シンギュラリティ",
            "text": "うちにとって、最も\n保守的なうち、くらいなら\n言っても許されるか？",
            "zh": "「对我来说最保守的我」，\n这个程度的话说了\n也能被原谅咩？",
            "narrator_zh": "奇点"
        },
        {
            "location": "450/TALK",
            "narrator": "シンギュラリティ",
            "text": "まあ、そんなこんなで\n全て元通りや。",
            "zh": "嘛，东拉西扯这么多，\n总之一切都恢复原样了。",
            "narrator_zh": "奇点"
        },
        {
            "location": "451/TALK",
            "narrator": "シンギュラリティ",
            "text": "ちゅうわけで、\n早速久々に\n扉をまわすとするかね。",
