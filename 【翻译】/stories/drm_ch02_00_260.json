{
    "dir": "dramatics/daydra/drm_ch02_00_260.js",
    "type": "Episode",
    "info": {
        "story_id": "2026",
        "cid": "ayami",
        "title": "らぶとーく 第26話",
        "sub_title": "通常運行",
        "title_zh": "恋爱漫谈 第26话",
        "sub_title_zh": "照常运行"
    },
    "entry": [
        {
            "location": "168/SCENARIO",
            "narrator": "",
            "text": "通常運行",
            "zh": "照常运行",
            "narrator_zh": ""
        },
        {
            "location": "180/TALK",
            "narrator": "アーヤ",
            "text": "うーん…想像以上に\nガタが来てるわね…。",
            "zh": "嗯……比想象中\n老化得更厉害……",
            "narrator_zh": "绫水"
        },
        {
            "location": "181/TALK",
            "narrator": "アーヤ",
            "text": "こりゃ、お店持ってって\n任せた方が早いかも…。",
            "zh": "这个还是拿到店里\n交给他们可能更快……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "185/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょっと、アーヤ。",
            "zh": "那个，绫水。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "187/TALK",
            "narrator": "アーヤ",
            "text": "あら、ギャヴィじゃない。\nつばめも一緒なのね。",
            "zh": "哎呀，这不是加维。\n燕也在啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "190/TALK",
            "narrator": "つばめ",
            "text": "わぁ、凄いです！\nバイクの整備をしてるん\nですか？",
            "zh": "哇，好厉害呀！\n是在保养摩托\n吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "191/TALK",
            "narrator": "アーヤ",
            "text": "ええ、久しぶりにね。",
            "zh": "嗯，好久没弄了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "193/TALK",
            "narrator": "ガブリエラ",
            "text": "どうでもいいけど、\n外で独り言はやめた方が\nいいわよ？",
            "zh": "随便啦，不过在\n外面自言自语\n还是别了吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "194/TALK",
            "narrator": "ガブリエラ",
            "text": "知らない人が見たら、\n変な人に思われるし。",
            "zh": "不认识的人看见，\n会觉得你是怪人的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "196/TALK",
            "narrator": "アーヤ",
            "text": "私、独り言なんて\n言ってた？",
            "zh": "我有在\n自言自语吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "197/TALK",
            "narrator": "ガブリエラ",
            "text": "ガタが来てるとか、\nお店持ってった方が\n早いとか、ね。",
            "zh": "什么老化了，\n拿到店里去\n比较快，之类的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "199/TALK",
            "narrator": "アーヤ",
            "text": "…気付かなかったわ。",
            "zh": "……我没注意到呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "202/TALK",
            "narrator": "つばめ",
            "text": "そんなにガタが来てるん\nですか？",
            "zh": "机器有那么\n老化吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "203/TALK",
            "narrator": "つばめ",
            "text": "私には、凄くピカピカに\n見えますけど…。",
            "zh": "在我看来，亮闪闪的\n很漂亮……",
            "narrator_zh": "燕"
        },
        {
            "location": "206/TALK",
            "narrator": "アーヤ",
            "text": "中見の方がちょっとね。",
            "zh": "看里面就有点了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "208/TALK",
            "narrator": "アーヤ",
            "text": "ブレーキパッドは\n摩耗してるし、エンジン\nオイルは少ないし――",
            "zh": "刹车片\n磨了，发动机\n机油也少——",
            "narrator_zh": "绫水"
        },
        {
            "location": "209/TALK",
            "narrator": "アーヤ",
            "text": "クラッチワイヤーも\nちょっと錆びてるし…。",
            "zh": "离合线也\n有点生锈……",
            "narrator_zh": "绫水"
        },
        {
            "location": "212/TALK",
            "narrator": "ガブリエラ",
            "text": "どういうものかはさっぱり\nだけど、メンテナンスを\nサボッてたせいよね？",
            "zh": "具体什么情况我完全\n不懂，是因为疏忽了\n维护吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "213/TALK",
            "narrator": "アーヤ",
            "text": "したくても、忙しくて\nできなかったのよ。",
            "zh": "想做也因为忙\n没做成。",
            "narrator_zh": "绫水"
        },
        {
            "location": "215/TALK",
            "narrator": "アーヤ",
            "text": "はぁ…まあ、次の休みに\nでもお店持って行くわ。",
            "zh": "唉……算了，下次休假的时候\n再带店里的东西去吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "217/TALK",
            "narrator": "つばめ",
            "text": "ふーん…。",
            "zh": "哦……。",
            "narrator_zh": "燕"
        },
        {
            "location": "219/TALK",
            "narrator": "つばめ",
            "text": "バイクをお店に持って\n行く時って――",
            "zh": "把摩托拿到店里\n去的时候——",
            "narrator_zh": "燕"
        },
        {
            "location": "220/TALK",
            "narrator": "つばめ",
            "text": "お店まではバイクに\n乗って行くんですか？",
            "zh": "到店里是骑摩托\n去吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "222/TALK",
            "narrator": "アーヤ",
            "text": "ええ、そうよ。",
            "zh": "嗯，是的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "223/TALK",
            "narrator": "つばめ",
            "text": "あの、その時、\nわたしも一緒に行って\nいいですか？",
            "zh": "那个，那时候，\n我也可以一起\n去吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "225/TALK",
            "narrator": "アーヤ",
            "text": "良いけど…つばめも\nバイクに興味出てきた？",
            "zh": "可以是可以……燕也\n对摩托感兴趣了？",
            "narrator_zh": "绫水"
        },
        {
            "location": "226/TALK",
            "narrator": "つばめ",
            "text": "うーん…自分で乗るのは\n怖そうですけど――",
            "zh": "嗯……自己骑\n好像有点怕——",
            "narrator_zh": "燕"
        },
        {
            "location": "227/TALK",
            "narrator": "つばめ",
            "text": "アーヤさんの後ろには、\n一度乗ってみたいなぁ、\nって思ってて…。",
            "zh": "我想坐一次\n绫水的后座，\n一直这么想着……",
            "narrator_zh": "燕"
        },
        {
            "location": "231/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ！？",
            "zh": "哈！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "233/TALK",
            "narrator": "つばめ",
            "text": "だって、バイクの後ろって\n乗ったことないんだもん。",
            "zh": "因为，摩托后座我\n从来没坐过嘛。",
            "narrator_zh": "燕"
        },
        {
            "location": "234/TALK",
            "narrator": "アーヤ",
            "text": "あはは、まあ中々無いと\n思うわよ？",
            "zh": "啊哈哈，这种机会\n可不多吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "235/TALK",
            "narrator": "アーヤ",
            "text": "私も、後ろに乗ったことは\n一度もないし。",
            "zh": "我自己也一次都\n没坐过后座。",
            "narrator_zh": "绫水"
        },
        {
            "location": "237/TALK",
            "narrator": "つばめ",
            "text": "だから、アーヤさんが\n良ければ、一度後ろに\n乗せてもらいたいんです。",
            "zh": "所以，如果绫水\n愿意，我想请你\n载我坐一次后座。",
            "narrator_zh": "燕"
        },
        {
            "location": "239/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "241/TALK",
            "narrator": "ガブリエラ",
            "text": "止めた方が良いわよ。\nアーヤの後ろに乗るのは\nお勧めしないわ。",
            "zh": "还是劝你别坐。\n坐绫水后面\n我不推荐。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "243/TALK",
            "narrator": "アーヤ",
            "text": "失礼ね。\nそこまでガタが来てる\nわけじゃないわ。",
            "zh": "真失礼。\n也没有老化到\n那个地步。",
            "narrator_zh": "绫水"
        },
        {
            "location": "245/TALK",
            "narrator": "ガブリエラ",
            "text": "そうじゃなくて、\nつばめがアーヤの後ろに\n乗れると思う？",
            "zh": "不是那样，\n你觉得燕能坐\n在绫水后面吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "247/TALK",
            "narrator": "ガブリエラ",
            "text": "腕力もないし、アーヤの\n乱暴運転に耐えられなくて\nすっ飛ばされちゃうわ。",
            "zh": "又没力气，受不了绫水\n的粗暴驾驶，\n会被甩飞的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "249/TALK",
            "narrator": "アーヤ",
            "text": "誰が乱暴よ？",
            "zh": "谁粗暴了？",
            "narrator_zh": "绫水"
        },
        {
            "location": "251/TALK",
            "narrator": "つばめ",
            "text": "大丈夫だよ、ガブちゃん。\n乗る時はしっかりと\nアーヤさんに捕まるから。",
            "zh": "没事呀，加布。\n坐的时候我会牢牢\n抓住绫水。",
            "narrator_zh": "燕"
        },
        {
            "location": "253/TALK",
            "narrator": "ガブリエラ",
            "text": "人の忠告は聞きなさいよ。\nやめた方がいい、って\n言ってるでしょ？",
            "zh": "别人的忠告给我听好了。\n我说了别去，\n不是吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "255/TALK",
            "narrator": "つばめ",
            "text": "でも、前から乗ってみたい\nって思ってて…。",
            "zh": "不过，我以前就一直\n想坐坐看……。",
            "narrator_zh": "燕"
        },
        {
            "location": "258/TALK",
            "narrator": "アーヤ",
            "text": "…何でかしら？",
            "zh": "……是为什么呢？",
            "narrator_zh": "绫水"
        },
        {
            "location": "259/TALK",
            "narrator": "アーヤ",
            "text": "なんか、ギャヴィが執拗に\n乗せたがってないような\n感じがするけど…。",
            "zh": "总觉得加维好像\n不太想让我\n坐上去……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "260/TALK",
            "narrator": "アーヤ",
            "text": "私的には別にどっちでも\nいいんだけど、どうしよう\nかしら…？",
            "zh": "对我来说哪边都\n行，到底怎么办\n呢……？",
            "narrator_zh": "绫水"
        },
        {
            "location": "261/TALK",
            "narrator": "アーヤ",
            "text": "…聞いてみようかしら？",
            "zh": "……要不要问问看？",
            "narrator_zh": "绫水"
        },
        {
            "location": "273/TALK",
            "narrator": "アーヤ",
            "text": "ちょっと",
            "zh": "稍微",
            "narrator_zh": "绫水"
        },
        {
            "location": "274/TALK",
            "narrator": "アーヤ",
            "text": "今っていい？",
            "zh": "现在方便吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "276/SEL",
            "narrator": "",
            "text": "大丈夫だよ",
            "zh": "没关系哦",
            "narrator_zh": ""
        },
        {
            "location": "277/ACT",
            "narrator": "",
            "text": "大丈夫だよ",
            "zh": "没关系哦",
            "narrator_zh": ""
        },
        {
            "location": "279/TALK",
            "narrator": "アーヤ",
            "text": "よかった(*^.^*)",
            "zh": "太好了(*^.^*)",
            "narrator_zh": "绫水"
        },
        {
            "location": "280/TALK",
            "narrator": "アーヤ",
            "text": "つばめがね",
            "zh": "燕她啊",
            "narrator_zh": "绫水"
        },
        {
            "location": "281/TALK",
            "narrator": "アーヤ",
            "text": "バイクの後ろに乗りたがってるんだけど",
            "zh": "她想坐摩托后座",
            "narrator_zh": "绫水"
        },
        {
            "location": "282/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィがちょっと不機嫌になってるの(>_<)",
            "zh": "加维有点不高兴(>_<)",
            "narrator_zh": "绫水"
        },
        {
            "location": "283/TALK",
            "narrator": "アーヤ",
            "text": "どうしたらいいかしら？",
            "zh": "该怎么办才好呢？",
            "narrator_zh": "绫水"
        },
        {
            "location": "286/SEL",
            "narrator": "",
            "text": "乗せるのはやめよう",
            "zh": "别骑了",
            "narrator_zh": ""
        },
        {
            "location": "287/ACT",
            "narrator": "",
            "text": "乗せるのはやめよう",
            "zh": "别骑了",
            "narrator_zh": ""
        },
        {
            "location": "289/TALK",
            "narrator": "アーヤ",
            "text": "じゃあ",
            "zh": "那么",
            "narrator_zh": "绫水"
        },
        {
            "location": "291/TALK",
            "narrator": "アーヤ",
            "text": "断らないといけないわね（；￢＿￢）",
            "zh": "得拒绝了（；￢＿￢）",
            "narrator_zh": "绫水"
        },
        {
            "location": "293/SEL",
            "narrator": "",
            "text": "自分で免許を取れと言え",
            "zh": "你就说让他们自己去考驾照",
            "narrator_zh": ""
        },
        {
            "location": "294/SEL",
            "narrator": "",
            "text": "後ろは事故の時危ないと言え",
            "zh": "你就说后面在事故的时候很危险",
            "narrator_zh": ""
        },
        {
            "location": "295/SEL",
            "narrator": "",
            "text": "その前に整備できるようにならないとねと言え",
            "zh": "在那之前得先能整备起来才行啊",
            "narrator_zh": ""
        },
        {
            "location": "296/ACT",
            "narrator": "",
            "text": "自分で免許を取れと言え",
            "zh": "你就说让他们自己去考驾照",
            "narrator_zh": ""
        },
        {
            "location": "297/TALK",
            "narrator": "アーヤ",
            "text": "それじゃ結局後ろに乗れないんだけど（；￢＿￢）",
            "zh": "那样结果还是坐不上后座（；￢＿￢）",
            "narrator_zh": "绫水"
        },
        {
            "location": "298/TALK",
            "narrator": "アーヤ",
            "text": "まあ",
            "zh": "嗯",
            "narrator_zh": "绫水"
        },
        {
            "location": "300/TALK",
            "narrator": "アーヤ",
            "text": "適当に理由は付けておくわ(；´Д｀)",
            "zh": "我会随便找个理由(；´Д｀)",
            "narrator_zh": "绫水"
        },
        {
            "location": "311/TALK",
            "narrator": "アーヤ",
            "text": "…バイクに乗ってみたい、\nって思うなら、後ろじゃ\nなくて――",
            "zh": "……如果想试着\n骑摩托的话，\n坐后面可不行——",
            "narrator_zh": "绫水"
        },
        {
            "location": "313/TALK",
            "narrator": "アーヤ",
            "text": "自分で免許を取って、\n運転した方がいいわ。",
            "zh": "还是自己去考执照，\n自己开比较好。",
            "narrator_zh": "绫水"
        },
        {
            "location": "316/TALK",
            "narrator": "つばめ",
            "text": "わ、わたしが！？",
            "zh": "我、我吗！？",
            "narrator_zh": "燕"
        },
        {
            "location": "317/TALK",
            "narrator": "アーヤ",
            "text": "ええ…っていうか、\n普通二輪だったら\nもう取れる年齢でしょ？",
            "zh": "嗯……说起来，\n普通二轮的话，\n已经到能考的年龄了吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "318/TALK",
            "narrator": "アーヤ",
            "text": "大型はまだ無理だけど、\nとりあえず取ってみたら？",
            "zh": "大型还不行，\n先考这个试试？",
            "narrator_zh": "绫水"
        },
        {
            "location": "321/TALK",
            "narrator": "つばめ",
            "text": "う、うーん…、\n取れるかなぁ？",
            "zh": "嗯、嗯……\n我考得下来吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "322/TALK",
            "narrator": "アーヤ",
            "text": "平気よ。\n受験勉強に比べれば、\n試験も簡単だしね。",
            "zh": "没事。\n比起升学考试，\n这个考试也简单。",
            "narrator_zh": "绫水"
        },
        {
            "location": "324/TALK",
            "narrator": "ガブリエラ",
            "text": "そっか…つばめはもう、\n免許が取れる年齢なの\nよね？",
            "zh": "这样啊……燕已经\n到了能考驾照的\n年龄了呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "326/TALK",
            "narrator": "つばめ",
            "text": "う、うん、そうみたい…。\nわたし、もうそんな年齢に\nなってたんだね…。",
            "zh": "嗯、嗯，好像是……\n我已经到这个年纪\n了呀……",
            "narrator_zh": "燕"
        },
        {
            "location": "328/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "330/TALK",
            "narrator": "ガブリエラ",
            "text": "なんか、負けた気がして\n超悔しいんだけど？",
            "zh": "总觉得像输了，\n超不甘心的？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "332/TALK",
            "narrator": "アーヤ",
            "text": "いや、そこは年齢なん\nだから仕方ないでしょ…。",
            "zh": "不是，年龄这事\n也没办法吧……",
            "narrator_zh": "绫水"
        },
        {
            "location": "333/ACT",
            "narrator": "",
            "text": "後ろは事故の時危ないと言え",
            "zh": "你就说后面在事故的时候很危险",
            "narrator_zh": ""
        },
        {
            "location": "334/TALK",
            "narrator": "アーヤ",
            "text": "なるほど",
            "zh": "原来如此",
            "narrator_zh": "绫水"
        },
        {
            "location": "335/TALK",
            "narrator": "アーヤ",
            "text": "それなら諦めてもらえそうね(=^0^=)",
            "zh": "那样的话好像能让他放弃了(=^0^=)",
            "narrator_zh": "绫水"
        },
        {
            "location": "347/TALK",
            "narrator": "アーヤ",
            "text": "…後ろに乗せるのは\n構わないんだけど――",
            "zh": "……让你坐后面\n倒是没关系——",
            "narrator_zh": "绫水"
        },
        {
            "location": "349/TALK",
            "narrator": "アーヤ",
            "text": "事故の時危ないから、\nあまりお勧めはしないわ。",
            "zh": "出事故的时候危险，\n所以不太推荐。",
            "narrator_zh": "绫水"
        },
        {
            "location": "351/TALK",
            "narrator": "つばめ",
            "text": "えっ…そうなんですか？",
            "zh": "诶……是这样吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "353/TALK",
            "narrator": "ガブリエラ",
            "text": "そういえば、二人乗りで\n同乗者だけが死亡、って\nニュース――",
            "zh": "说起来，双人骑摩托\n只有乘客死亡，那条\n新闻——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "354/TALK",
            "narrator": "ガブリエラ",
            "text": "時々見る気がするわ。",
            "zh": "感觉时不时会看到。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "357/TALK",
            "narrator": "つばめ",
            "text": "えぇっ！？",
            "zh": "诶诶！？",
            "narrator_zh": "燕"
        },
        {
            "location": "359/TALK",
            "narrator": "アーヤ",
            "text": "まあ、私も危険な運転を\nしたりするつもりはないん\nだけど――",
            "zh": "我也没打算\n开得很危险\n就是了——",
            "narrator_zh": "绫水"
        },
        {
            "location": "360/TALK",
            "narrator": "アーヤ",
            "text": "バイクの状態も完全じゃ\nないから、今はちょっと\n不安かも…。",
            "zh": "摩托的状态也不\n完整，现在有点\n不放心……",
            "narrator_zh": "绫水"
        },
        {
            "location": "362/TALK",
            "narrator": "アーヤ",
            "text": "…どうする？",
            "zh": "……怎么办？",
            "narrator_zh": "绫水"
        },
        {
            "location": "364/TALK",
            "narrator": "つばめ",
            "text": "…やっぱり、\nやめておきます。",
            "zh": "……那还是，\n算了吧。",
            "narrator_zh": "燕"
        },
        {
            "location": "366/TALK",
            "narrator": "ガブリエラ",
            "text": "うんうん、それがいいわ。",
            "zh": "嗯嗯，那样最好。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "369/TALK",
            "narrator": "つばめ",
            "text": "…バイクって、\n思ってたより\n危ない乗り物なんですね。",
            "zh": "……摩托车这东西，\n比我想的\n还要危险呢。",
            "narrator_zh": "燕"
        },
        {
            "location": "371/TALK",
            "narrator": "アーヤ",
            "text": "…ちょっと、怖がらせ\n過ぎちゃったかしら？",
            "zh": "……是不是\n吓过头了？",
            "narrator_zh": "绫水"
        },
        {
            "location": "372/ACT",
            "narrator": "",
            "text": "その前に整備できるようにならないとねと言え",
            "zh": "在那之前得先能整备起来才行啊",
            "narrator_zh": ""
        },
        {
            "location": "373/TALK",
            "narrator": "アーヤ",
            "text": "それ、結構酷じゃない？(；´Д｀)",
            "zh": "那个，挺过分的吧？(；´Д｀)",
            "narrator_zh": "绫水"
        },
        {
            "location": "375/TALK",
            "narrator": "アーヤ",
            "text": "まあ",
            "zh": "嗯",
            "narrator_zh": "绫水"
        },
        {
            "location": "376/TALK",
            "narrator": "アーヤ",
            "text": "乗せない理由としては使えそうだけど",
            "zh": "当作不让她坐的理由倒是能用",
            "narrator_zh": "绫水"
        },
        {
            "location": "388/TALK",
            "narrator": "アーヤ",
            "text": "…バイクに乗りたいなら、\nまずはそれなりに準備が\n必要になるわ。",
            "zh": "……想骑摩托的话，\n首先得做些\n相应的准备。",
            "narrator_zh": "绫水"
        },
        {
            "location": "390/TALK",
            "narrator": "つばめ",
            "text": "準備、ですか？",
            "zh": "准备，吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "391/TALK",
            "narrator": "アーヤ",
            "text": "ええ…まあ、簡単な\n整備くらいはできるように\nならないとね。",
            "zh": "嗯……至少简单的\n保养得会做\n才行。",
            "narrator_zh": "绫水"
        },
        {
            "location": "393/TALK",
            "narrator": "つばめ",
            "text": "えっ！？",
            "zh": "诶！？",
            "narrator_zh": "燕"
        },
        {
            "location": "395/TALK",
            "narrator": "ガブリエラ",
            "text": "あ～…まあ、確かにねー。",
            "zh": "啊～……是啊，确实。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "397/TALK",
            "narrator": "ガブリエラ",
            "text": "乗り物に乗る以上は、\nそれの整備くらいは\n出来なきゃダメよね。",
            "zh": "既然要乘坐，\n起码保养得会做\n才行。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "399/TALK",
            "narrator": "つばめ",
            "text": "…それって、車も？",
            "zh": "……那，汽车也是？",
            "narrator_zh": "燕"
        },
        {
            "location": "402/TALK",
            "narrator": "ガブリエラ",
            "text": "く、車は別よ。\nあれは大勢で乗るための\n乗り物なんだし。",
            "zh": "不、车是另说的。\n那可是给一大堆人\n坐的交通工具。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "404/TALK",
            "narrator": "つばめ",
            "text": "そっか…。",
            "zh": "是这样呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "406/TALK",
            "narrator": "つばめ",
            "text": "じゃあ、わたしにはまだ\n乗れなさそうかも…。",
            "zh": "那，我好像还\n坐不了……",
            "narrator_zh": "燕"
        },
        {
            "location": "407/TALK",
            "narrator": "アーヤ",
            "text": "ふふっ…まあ、もし興味が\nあるんだったら――",
            "zh": "呵呵……要是有\n兴趣的话——",
            "narrator_zh": "绫水"
        },
        {
            "location": "408/TALK",
            "narrator": "アーヤ",
            "text": "つばめもバイクの免許、\n取った方がいいかもね。",
            "zh": "燕也去考个\n摩托驾照比较好哦。",
            "narrator_zh": "绫水"
        }
    ]
}
