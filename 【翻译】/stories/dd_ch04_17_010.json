{
    "dir": "chap17/daydra/dd_ch04_17_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "17452",
        "cid": "miyabi",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "恐怖",
        "title_zh": "Extra002 额外剧情",
        "sub_title_zh": "恐怖"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "恐怖",
            "zh": "恐怖",
            "narrator_zh": ""
        },
        {
            "location": "33/TALK",
            "narrator": "みやび",
            "text": "んっ？",
            "zh": "嗯？",
            "narrator_zh": "雅"
        },
        {
            "location": "36/TALK",
            "narrator": "つばめ",
            "text": "あれ？　みやびさん、\nパソコンどうかしたん\nですか？",
            "zh": "咦？　雅，\n电脑出了什么\n问题吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "38/TALK",
            "narrator": "みやび",
            "text": "…ＳＳＤの様子が\nちっくとおかしくてな。",
            "zh": "…ＳＳＤ的样子\n有点不对劲咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "39/TALK",
            "narrator": "みやび",
            "text": "とうとうおしゃかに\nなったようやが。",
            "zh": "看来是终于\n寿终正寝了咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "41/TALK",
            "narrator": "繭",
            "text": "結構使い込んでいた\nみたいですね。",
            "zh": "看来用了\n挺久了呢。",
            "narrator_zh": "茧"
        },
        {
            "location": "42/TALK",
            "narrator": "みやび",
            "text": "うん、長い間頑張って\nくれたえい子やったが。",
            "zh": "嗯，是个长时间\n努力干活的好孩子啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "45/TALK",
            "narrator": "キリト",
            "text": "あの、ＳＳＤの様子が\n変だったってことは、\nデータはもちろん…。",
            "zh": "那个，ＳＳＤ要是\n出了状况，\n数据自然也……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "47/TALK",
            "narrator": "みやび",
            "text": "おしゃかやね。\n綺麗さっぱりさよならや。",
            "zh": "报废咯。\n干干净净说拜拜咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "49/TALK",
            "narrator": "雛",
            "text": "でも、全然ショックを\n受けてるようには\n見えませんよー？",
            "zh": "可是，完全看不出\n你受到打击的样子\n哦——？",
            "narrator_zh": "雏"
        },
        {
            "location": "51/TALK",
            "narrator": "繭",
            "text": "バックアップ取ってる\nからに決まってる。",
            "zh": "肯定是因为\n平时有做备份。",
            "narrator_zh": "茧"
        },
        {
            "location": "53/TALK",
            "narrator": "繭",
            "text": "あなた達も、週に一度\nくらいは取ってるでしょ？",
            "zh": "你们也应该\n一周至少备份一次吧？",
            "narrator_zh": "茧"
        },
        {
            "location": "55/TALK",
            "narrator": "雛",
            "text": "…バックアップ？",
            "zh": "…备份？",
            "narrator_zh": "雏"
        },
        {
            "location": "58/TALK",
            "narrator": "キリト",
            "text": "いや、取ってねぇけど？",
            "zh": "没有，我压根没做过啊？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "59/TALK",
            "narrator": "繭",
            "text": "…は？",
            "zh": "…哈？",
            "narrator_zh": "茧"
        },
        {
            "location": "61/TALK",
            "narrator": "みやび",
            "text": "まさか…つばめちゃんは\nちゃんとバックアップを\n取っちょるよな？",
            "zh": "该不会……燕你\n平时都有好好\n备份着的嘛？",
            "narrator_zh": "雅"
        },
        {
            "location": "62/TALK",
            "narrator": "つばめ",
            "text": "取ってないですけど？",
            "zh": "可是我没做啊？",
            "narrator_zh": "燕"
        },
        {
            "location": "65/TALK",
            "narrator": "みやび",
            "text": "…なんでや？\nどうしてバックアップを\n取らんが？",
            "zh": "…做驷马咯？\n做驷马就不\n做备份咧？",
            "narrator_zh": "雅"
        },
        {
            "location": "67/TALK",
            "narrator": "雛",
            "text": "なんでって…\n考えたこともないし…。",
            "zh": "为什么……\n根本没想过啊……。",
            "narrator_zh": "雏"
        },
        {
            "location": "69/TALK",
            "narrator": "キリト",
            "text": "っていうか、\n面倒くさくないっすか？",
            "zh": "话说回来，\n不嫌麻烦吗？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "71/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "73/TALK",
            "narrator": "繭",
            "text": "っ！？　みやび先輩！",
            "zh": "！？　雅前辈！",
            "narrator_zh": "茧"
        },
        {
            "location": "77/TALK",
            "narrator": "みやび",
            "text": "だ、大丈夫や。\nちっくと、眩暈がした\nだけやき…。",
            "zh": "没、没事的。\n就是稍微，\n有点头晕嘛……。",
            "narrator_zh": "雅"
        },
        {
            "location": "80/TALK",
            "narrator": "みやび",
            "text": "…こいつら、正気とは\n思えんな。",
            "zh": "…这帮家伙，\n没法当成正常人看啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "92/TALK",
            "narrator": "みやび",
            "text": "相棒、うちは頭が痛うなってきたがよ",
            "zh": "搭档，我的头都开始痛了咯",
            "narrator_zh": "雅"
        },
        {
            "location": "94/TALK",
            "narrator": "みやび",
            "text": "つばめちゃん達、ＰＣのデータが消えたらショック受けるんわかっちゅうに",
            "zh": "燕她们明明晓得ＰＣ数据要是没了会受打击的",
            "narrator_zh": "雅"
        },
        {
            "location": "95/TALK",
            "narrator": "みやび",
            "text": "まったくバックアップ取っとらんがよ",
            "zh": "却压根一点都不做备份咯",
            "narrator_zh": "雅"
        },
        {
            "location": "96/TALK",
            "narrator": "みやび",
            "text": "まっこと信じられん…今まで集めたり作ったデータが",
            "zh": "真是没法信……一直以来收集的、做出来的数据",
            "narrator_zh": "雅"
        },
        {
            "location": "97/TALK",
            "narrator": "みやび",
            "text": "一瞬にして消えてしまうんが怖くないがか？",
            "zh": "一瞬间就会全部消失，不觉得怕咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "98/TALK",
            "narrator": "みやび",
            "text": "…ここは、言って聞かせた方がえいやろか？",
            "zh": "…这种情况，讲给他们听会不会好点咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "100/SEL",
            "narrator": "",
            "text": "一度痛い目を見せるべき",
            "zh": "该让他们吃吃苦头",
            "narrator_zh": ""
        },
        {
            "location": "101/SEL",
            "narrator": "",
            "text": "何とかしてあげて",
            "zh": "想办法帮帮他们",
            "narrator_zh": ""
        },
        {
            "location": "102/ACT",
            "narrator": "",
            "text": "一度痛い目を見せるべき",
            "zh": "该让他们吃吃苦头",
            "narrator_zh": ""
        },
        {
            "location": "104/TALK",
            "narrator": "みやび",
            "text": "…相棒、思ってた以上にスパルタやね",
            "zh": "…搭档，你比我想象的还要斯巴达咯",
            "narrator_zh": "雅"
        },
        {
            "location": "105/TALK",
            "narrator": "みやび",
            "text": "やけんど、確かにそれが一番かもしれんね",
            "zh": "但是，那样说不定确实是最好的咧",
            "narrator_zh": "雅"
        },
        {
            "location": "106/TALK",
            "narrator": "みやび",
            "text": "大切なデータが根こそぎ消えるショックと恐怖",
            "zh": "重要数据被一锅端全没了的打击和恐惧",
            "narrator_zh": "雅"
        },
        {
            "location": "107/TALK",
            "narrator": "みやび",
            "text": "それがどれほどのものか、身を持って知るのが一番やな",
            "zh": "那滋味有多难受，让他们亲身体会才是最好的咯",
            "narrator_zh": "雅"
        },
        {
            "location": "118/TALK",
            "narrator": "みやび",
            "text": "…あんたら、一つだけ言うて\nおくき、耳かっぽじって\nよく聞くちや。",
            "zh": "…你们这些家伙，\n我只讲一遍啵，\n竖起耳朵好好听着滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "119/TALK",
            "narrator": "みやび",
            "text": "ＰＣなんてのは、\nいつ異常が出るか\nわからない物なんよ。",
            "zh": "ＰＣ这种东西，\n什么时候会出问题\n谁也说不准咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "121/TALK",
            "narrator": "キリト",
            "text": "…まあ、そうっすよね。\n俺のも急に再起動したり\nすることあるし。",
            "zh": "…嘛，倒也是。\n我的机器也有过\n突然重启的情况。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "124/TALK",
            "narrator": "雛",
            "text": "あ～、あるある。\nあたしのノートも\n時々そうなるよ。",
            "zh": "啊～，有的有的。\n我的笔记本\n也时不时这样。",
            "narrator_zh": "雏"
        },
        {
            "location": "126/TALK",
            "narrator": "繭",
            "text": "あ、あなた達…それで\n不安を感じないの？",
            "zh": "你、你们……就不会\n为此感到不安吗？",
            "narrator_zh": "茧"
        },
        {
            "location": "129/TALK",
            "narrator": "キリト",
            "text": "不安っていうか、\nしっかりしてくれ、って\n思うけどな。",
            "zh": "倒算不上不安，\n就是希望它们\n能靠得住点啊。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "131/TALK",
            "narrator": "みやび",
            "text": "もうえいよ。\n多分、言ってもわかって\nもらえんきね。",
            "zh": "得咧。\n反正讲了他们\n多半也听不进嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "133/TALK",
            "narrator": "みやび",
            "text": "バックアップを取らんで\nいるとどうなるか――",
            "zh": "不做备份的话\n会变成什么样——",
            "narrator_zh": "雅"
        },
        {
            "location": "134/TALK",
            "narrator": "みやび",
            "text": "いずれ身を持って経験し、\n後悔から学ぶとえいよ。",
            "zh": "早晚亲身去经历，\n从后悔里学乖就得了。",
            "narrator_zh": "雅"
        },
        {
            "location": "136/TALK",
            "narrator": "雛",
            "text": "う～ん…ちょっと大げさな\n気がするけどなぁ…。",
            "zh": "嗯～……是觉得\n有点夸张啊……。",
            "narrator_zh": "雏"
        },
        {
            "location": "138/TALK",
            "narrator": "つばめ",
            "text": "ショックは受けると\n思いますけど、そこまで\nじゃない気がします。",
            "zh": "打击肯定会有，\n但应该还没到\n那个地步。",
            "narrator_zh": "燕"
        },
        {
            "location": "141/TALK",
            "narrator": "キリト",
            "text": "ちくしょぉ、って思う\nくらいじゃねぇの？\n繭もそう思うだろ？",
            "zh": "顶多就是骂一句\n「可恶」的程度吧？\n茧你也是这么想的吧？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "142/TALK",
            "narrator": "繭",
            "text": "…想像するだけでも、\n死にたくなるほど\n怖いんだけど？",
            "zh": "…光是想象一下，\n就恐怖得让人\n想死好吗？",
            "narrator_zh": "茧"
        },
        {
            "location": "143/ACT",
            "narrator": "",
            "text": "何とかしてあげて",
            "zh": "想办法帮帮他们",
            "narrator_zh": ""
        },
        {
            "location": "146/TALK",
            "narrator": "みやび",
            "text": "そうやね",
            "zh": "是咯",
            "narrator_zh": "雅"
        },
        {
            "location": "147/TALK",
            "narrator": "みやび",
            "text": "言った方がえいかどうか\n聞くまでもなかったがよ",
            "zh": "该不该讲给他们听，\n根本就不用问咯",
            "narrator_zh": "雅"
        },
        {
            "location": "148/TALK",
            "narrator": "みやび",
            "text": "驚き過ぎてまともな判断が\nできんくなっちゅうたの\nかもしれん",
            "zh": "可能是吓得过了头，\n没办法好好\n判断来着。",
            "narrator_zh": "雅"
        },
        {
            "location": "159/TALK",
            "narrator": "みやび",
            "text": "…明日、みんなに\nフラッシュメモリを\n配るき。",
            "zh": "…明天，就给\n大伙一人发一支\n闪存盘啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "160/TALK",
            "narrator": "みやび",
            "text": "それに、最低限自分の\n大事なデータを保存して、\n大切にしまっとくちや。",
            "zh": "还有，最起码\n把自己重要的数据\n存好收着滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "162/TALK",
            "narrator": "雛",
            "text": "大事なデータだけでも\nバックアップしろ、って\nことですか？",
            "zh": "至少把重要的数据\n备份好，\n是这意思吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "164/TALK",
            "narrator": "繭",
            "text": "それ以外にないでしょ？",
            "zh": "不然还能怎样？",
            "narrator_zh": "茧"
        },
        {
            "location": "167/TALK",
            "narrator": "キリト",
            "text": "まあ、貰えるってんなら\nありがたく使わせて\n貰うっすけど――",
            "zh": "嘛，既然有得拿，\n那我就不客气\n收下了——",
            "narrator_zh": "圣翔"
        },
        {
            "location": "168/TALK",
            "narrator": "キリト",
            "text": "そこまでする必要、\n本当にあんのかなぁ？",
            "zh": "真有必要做到\n这个份上吗？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "170/TALK",
            "narrator": "つばめ",
            "text": "う～ん…でも、全部\n消えちゃうよりは\nいいんじゃないかな？",
            "zh": "嗯～……但是，\n总比全部\n没了要好吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "172/TALK",
            "narrator": "雛",
            "text": "確かにそうだけど、\n消えても困るような\nデータほとんどないし…。",
            "zh": "确实是这样，\n但会丢了就麻烦的\n数据基本没有……。",
            "narrator_zh": "雏"
        },
        {
            "location": "174/TALK",
            "narrator": "みやび",
            "text": "…そんなデータでも、\n消えた時のショックは\nまっことはんぱないんよ。",
            "zh": "…就算是那种数据，\n没的时候那打击\n也蛮不得了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "176/TALK",
            "narrator": "繭",
            "text": "みやび先輩…こいつら、\n一度痛い目を見た方が\n良いんじゃないですか？",
            "zh": "雅前辈……这帮家伙，\n是不是该让他们\n吃一回苦头？",
            "narrator_zh": "茧"
        },
        {
            "location": "179/TALK",
            "narrator": "みやび",
            "text": "正直うちもそう思うがよ。",
            "zh": "老实讲我也这么想咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "181/TALK",
            "narrator": "みやび",
            "text": "ＨＤＤ、綺麗さっぱり\nキエテナクナーレ、\nっちゅう感じにな。",
            "zh": "ＨＤＤ，干干净净地\n——统统消失掉！\n差不多就这感觉咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "182/TALK",
            "narrator": "みやび",
            "text": "けんど、やれること\nやっとかんと――",
            "zh": "但是，该做的\n不先做好的话——",
            "narrator_zh": "雅"
        },
        {
            "location": "183/TALK",
            "narrator": "みやび",
            "text": "後で痛むんは、\nこっちの心やきな…。",
            "zh": "到时候疼的，\n可就是这颗心啵……。",
            "narrator_zh": "雅"
        },
        {
            "location": "185/TALK",
            "narrator": "キリト",
            "text": "あの、バックアップって\n一回やればそれで\nいいんすか？",
            "zh": "那个，备份\n是不是做一次\n就完事了？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "187/TALK",
            "narrator": "繭",
            "text": "…キエテナクナーレ！",
            "zh": "…统统消失掉！",
            "narrator_zh": "茧"
        },
        {
            "location": "18/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>7月26日　0:21 PM</color>\nとある平日の昼休み、つばめの教室にて。",
            "zh": "<color=green>7月26日　0:21 PM</color>\n某个平日的午休时间，在燕的教室里。",
            "narrator_zh": "Dialog_EventData"
        }
    ]
}
