{
    "dir": "chap28/daydra/dd_ch02_28_010.js",
    "type": "",
    "info": {
        "story_id": "50008",
        "cid": "",
        "title": "SideStory008 ストーリー",
        "sub_title": "FILE06.始動",
        "title_zh": "SideStory008 剧情",
        "sub_title_zh": "FILE06.始动"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "東京編６話",
            "zh": "东京篇 第6话",
            "narrator_zh": ""
        },
        {
            "location": "22/DIALOG",
            "narrator": "",
            "text": "<color=green>9月5日　 4:12 PM</color>\nとある平日の昼休み、付属学園屋上にて",
            "zh": "<color=green>9月5日　 4:12 PM</color>\n某个工作日的午休，于附属学园屋顶",
            "narrator_zh": ""
        },
        {
            "location": "23/TALK",
            "narrator": "ヒカル",
            "text": "…え？\n逢瀬さんの大切な人…、\nですか？",
            "zh": "……哎？\n逢濑重要的人……\n是吗？",
            "narrator_zh": "光"
        },
        {
            "location": "24/TALK",
            "narrator": "雛",
            "text": "そうなの！",
            "zh": "没错！",
            "narrator_zh": "雏"
        },
        {
            "location": "25/TALK",
            "narrator": "雛",
            "text": "ほら、つばめちゃんって\nよく誰かとＷＡＶＥで\n話してるでしょ？",
            "zh": "你看，燕她\n不是经常在WAVE上\n和谁聊天吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "27/TALK",
            "narrator": "キリト",
            "text": "えっ？　あれって確か、\nＢｏｔとか\n言ってなかったか？",
            "zh": "哎？那个她之前不是说过\n是什么\nBot之类的吗？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "28/TALK",
            "narrator": "雛",
            "text": "それとは別なのかも。\nそれとも、恥ずかしくて\n言えなかったとか？",
            "zh": "也许是另外的人吧。\n又或者，是不好意思\n说出口之类的？",
            "narrator_zh": "雏"
        },
        {
            "location": "29/TALK",
            "narrator": "繭",
            "text": "…とにかく、その人と\n連絡を取ることに\n成功した、と？",
            "zh": "……总之，你成功和那个人\n取得联系了，\n是这样吧？",
            "narrator_zh": "茧"
        },
        {
            "location": "32/TALK",
            "narrator": "雛",
            "text": "うん！\n事情を話したら、\n協力してくれるって！",
            "zh": "嗯！\n把情况告诉对方后，\n对方说愿意帮忙！",
            "narrator_zh": "雏"
        },
        {
            "location": "34/TALK",
            "narrator": "ヒカル",
            "text": "…でも、その人って\nどんな人なんだろう？",
            "zh": "……不过，那个人\n到底是什么人呢？",
            "narrator_zh": "光"
        },
        {
            "location": "35/TALK",
            "narrator": "ヒカル",
            "text": "特別攻撃隊の関係者に、\n思い当たる人って\nいたかな？",
            "zh": "特别攻击队的相关人员里，\n有能想到是\n谁的人吗？",
            "narrator_zh": "光"
        },
        {
            "location": "38/TALK",
            "narrator": "キリト",
            "text": "いや…そもそも逢瀬達と\n東雲教官以外は、\n誰もいないと思うぞ？",
            "zh": "不……说到底除了逢濑她们和\n东云教官之外，\n应该没有别人了吧？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "40/TALK",
            "narrator": "繭",
            "text": "…管理庁の内部にいる、\n協力者という可能性も\nありえる。",
            "zh": "……也有可能是\n潜伏在管理厅内部的\n协力者。",
            "narrator_zh": "茧"
        },
        {
            "location": "43/TALK",
            "narrator": "キリト",
            "text": "あ、なるほどな。",
            "zh": "啊，原来如此。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "46/TALK",
            "narrator": "繭",
            "text": "…まあ、ほぼ確実に\n違うとは思うけど。",
            "zh": "……不过，我觉得几乎可以\n肯定不是那样。",
            "narrator_zh": "茧"
        },
        {
            "location": "47/TALK",
            "narrator": "キリト",
            "text": "おまえなぁ…。\nでも、どうして違うと\n思うんだ？",
            "zh": "你这家伙……。\n不过，为什么觉得\n不是呢？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "49/TALK",
            "narrator": "繭",
            "text": "そんなスパイがいるなら、\n卯月神楽のスパイ行為は\n筒抜けだったはず。",
            "zh": "要真有那样的间谍，\n卯月神乐的间谍行径\n早就应该全露馅了。",
            "narrator_zh": "茧"
        },
        {
            "location": "52/TALK",
            "narrator": "繭",
            "text": "もし見抜けなかったなら、\nただのマヌケ。\nいても邪魔なだけよ。",
            "zh": "要是连这也看不穿，\n那不过是个蠢货。\n留着也只会碍事。",
            "narrator_zh": "茧"
        },
        {
            "location": "53/TALK",
            "narrator": "キリト",
            "text": "…なるほどな。",
            "zh": "……有道理。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "56/TALK",
            "narrator": "雛",
            "text": "でも、つばめちゃんが\n信頼してる人なんだから、\nきっと頼りになるよー。",
            "zh": "不过，既然是燕\n信任的人，\n肯定很靠得住哦——。",
            "narrator_zh": "雏"
        },
        {
            "location": "58/TALK",
            "narrator": "繭",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "茧"
        },
        {
            "location": "61/TALK",
            "narrator": "キリト",
            "text": "…で？　そいつと連絡が\n取れたからって、\nどうしろっていうんだ？",
            "zh": "……然后呢？就算和那家伙\n联系上了，\n你打算怎么办？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "64/TALK",
            "narrator": "雛",
            "text": "…綾水様達は今、\n多分東京にはいないと\n思うんだけど…どう？",
            "zh": "……绫水大人她们现在，\n大概已经不在东京了\n吧……怎么样？",
            "narrator_zh": "雏"
        },
        {
            "location": "65/TALK",
            "narrator": "ヒカル",
            "text": "うん、確か都内を出た\nところまでは確認した、\nって聞いたから…。",
            "zh": "嗯，听说确实\n只确认到了她们离开东京都内，\n之后就……。",
            "narrator_zh": "光"
        },
        {
            "location": "66/TALK",
            "narrator": "キリト",
            "text": "そうだったな…。\nその後はわからねぇけど。",
            "zh": "是那样没错……。\n之后的事就不清楚了。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "67/TALK",
            "narrator": "雛",
            "text": "つまりさ、今、東京で\n自由に動けるのは、\nあたし達だけだよね？",
            "zh": "也就是说，现在在东京\n能够自由行动的，\n只有我们了吧？",
            "narrator_zh": "雏"
        },
        {
            "location": "68/TALK",
            "narrator": "雛",
            "text": "だから、あたし達だけで\n行動を始める時だと\n思うんだよー。",
            "zh": "所以，我觉得现在\n正是只有我们自己\n开始行动的时候了——。",
            "narrator_zh": "雏"
        },
        {
            "location": "69/TALK",
            "narrator": "繭",
            "text": "…ありえない。",
            "zh": "……不可能。",
            "narrator_zh": "茧"
        },
        {
            "location": "72/TALK",
            "narrator": "雛",
            "text": "えーっ、どうしてー！？",
            "zh": "哎——，为什么呀——！？",
            "narrator_zh": "雏"
        },
        {
            "location": "74/TALK",
            "narrator": "繭",
            "text": "自殺行為。\n私達だけでどうにかなる\n相手じゃない。",
            "zh": "这是自杀行为。\n对方不是靠我们几个\n就能应付得了的。",
            "narrator_zh": "茧"
        },
        {
            "location": "75/TALK",
            "narrator": "雛",
            "text": "別に、戦おうなんて\n思ってないよー。",
            "zh": "我又没打算\n去跟他们打架——。",
            "narrator_zh": "雏"
        },
        {
            "location": "76/TALK",
            "narrator": "雛",
            "text": "ただ、東京にいない\n綾水様達の代わりに…。",
            "zh": "只是想代替\n不在东京的绫水大人她们……。",
            "narrator_zh": "雏"
        },
        {
            "location": "77/TALK",
            "narrator": "雛",
            "text": "つばめちゃんの\n捕まってる場所を探す\nくらいはできるでしょ？",
            "zh": "至少找找燕\n被关在哪里，\n这总能做到吧？",
            "narrator_zh": "雏"
        },
        {
            "location": "78/TALK",
            "narrator": "キリト",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "79/TALK",
            "narrator": "ヒカル",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "光"
        },
        {
            "location": "80/TALK",
            "narrator": "雛",
            "text": "ね！？",
            "zh": "对吧！？",
            "narrator_zh": "雏"
        },
        {
            "location": "81/TALK",
            "narrator": "ヒカル",
            "text": "…ひなこさん。\n逢瀬さんを思う気持ちは、\nよくわかるよ。",
            "zh": "……雏子。\n你担心逢濑的心情，\n我完全理解。",
            "narrator_zh": "光"
        },
        {
            "location": "82/TALK",
            "narrator": "ヒカル",
            "text": "けど、僕はその考えに\n賛成できない。",
            "zh": "但是，我不能赞成\n你的这个想法。",
            "narrator_zh": "光"
        },
        {
            "location": "84/TALK",
            "narrator": "雛",
            "text": "な、なんで？",
            "zh": "为、为什么？",
            "narrator_zh": "雏"
        },
        {
            "location": "86/TALK",
            "narrator": "キリト",
            "text": "素人だからだよ。\n管理庁のヤツラに比べて、\n俺たち全員な。",
            "zh": "因为我们是外行啊。\n比起管理厅那帮家伙，\n我们所有人都是。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "87/TALK",
            "narrator": "雛",
            "text": "でも、キリト達は――",
            "zh": "可是，圣翔你们——",
            "narrator_zh": "雏"
        },
        {
            "location": "88/TALK",
            "narrator": "キリト",
            "text": "言ったろ？\n俺たちはまだ学生身分の\n候補生だ、って。",
            "zh": "我不是说过吗？\n我们还只是学生身份的\n候补生。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "89/TALK",
            "narrator": "キリト",
            "text": "正規隊員のヤツラを\n相手にしたら、\n手も足も出ねぇって…。",
            "zh": "要是跟正规队员那帮人\n动起手来，\n我们根本毫无还手之力……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "90/TALK",
            "narrator": "ヒカル",
            "text": "さっき繭さんが自殺行為と\n言ってたけれど…、\n大げさじゃないよ。",
            "zh": "刚才茧说是\n自杀行为……\n这可一点儿也不夸张。",
            "narrator_zh": "光"
        },
        {
            "location": "91/TALK",
            "narrator": "ヒカル",
            "text": "今の僕達じゃ、\n万に一つの勝ち目もない。",
            "zh": "以现在的我们来说，\n连万分之一的胜算都没有。",
            "narrator_zh": "光"
        },
        {
            "location": "92/TALK",
            "narrator": "雛",
            "text": "でも！\nこのまま何もしないで\nジッとしてるなんて…。",
            "zh": "可是！\n要我就这样什么都不做\n干等着……。",
            "narrator_zh": "雏"
        },
        {
            "location": "93/TALK",
            "narrator": "繭",
            "text": "…落ち着いて。",
            "zh": "……冷静点。",
            "narrator_zh": "茧"
        },
        {
            "location": "95/TALK",
            "narrator": "雛",
            "text": "落ち着けないよ！\nこうしてる間も、\nつばめちゃんは…。",
            "zh": "我冷静不下来啊！\n就在我们说话的时候，\n燕她……。",
            "narrator_zh": "雏"
        },
        {
            "location": "96/TALK",
            "narrator": "繭",
            "text": "私達が無茶をして\nなにかあれば、\n逢瀬さんが悲しむわ。",
            "zh": "如果我们乱来\n出了什么事，\n逢濑会伤心的。",
            "narrator_zh": "茧"
        },
        {
            "location": "97/TALK",
            "narrator": "繭",
            "text": "ひなこは、逢瀬さんに\nそんな想いをさせたいの？",
            "zh": "雏子，你想让逢濑\n承受那样的心情吗？",
            "narrator_zh": "茧"
        },
        {
            "location": "100/TALK",
            "narrator": "雛",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雏"
        },
        {
            "location": "101/TALK",
            "narrator": "キリト",
            "text": "…なあ、ひなこ。\n俺達だってさ、\n平気じゃないんだぜ？",
            "zh": "……喂，雏子。\n其实我们几个，\n心里也不好受啊？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "102/TALK",
            "narrator": "キリト",
            "text": "今だって、管理庁を\n許せねぇって思ってる。",
            "zh": "哪怕到现在，我也觉得\n绝不能原谅管理厅。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "103/TALK",
            "narrator": "キリト",
            "text": "逢瀬を助けたいとも、\n綾水先輩達と連絡を\n取りたいともな…。",
            "zh": "既想救出逢濑，\n也想和绫水前辈她们\n取得联系啊……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "105/TALK",
            "narrator": "雛",
            "text": "…でも、何もしないの？",
            "zh": "……可是，就什么都不做吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "106/TALK",
            "narrator": "キリト",
            "text": "…できるのに、\nしないと思ってるのか？",
            "zh": "……你以为我们是能做\n却故意不做吗？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "108/TALK",
            "narrator": "雛",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雏"
        },
        {
            "location": "109/TALK",
            "narrator": "ヒカル",
            "text": "…とりあえず、\n今日はこの辺にして\n帰りませんか？",
            "zh": "……总之，\n今天先聊到这里，\n大家先回去吧？",
            "narrator_zh": "光"
        },
        {
            "location": "110/TALK",
            "narrator": "ヒカル",
            "text": "僕達は、逢瀬さんが\n大切に思う人と連絡を\n取る方法がわかった。",
            "zh": "我们已经知道了\n如何与逢濑珍视的那个人\n取得联系。",
            "narrator_zh": "光"
        },
        {
            "location": "111/TALK",
            "narrator": "ヒカル",
            "text": "それだけでも、\n今日僕達は一歩前進した。",
            "zh": "光凭这一点，\n我们今天就已经向前迈出了一步。",
            "narrator_zh": "光"
        },
        {
            "location": "112/TALK",
            "narrator": "ヒカル",
            "text": "…次に何をするかは、\n一度家に帰ってから\n考えようよ。",
            "zh": "……接下来该怎么做，\n先各自回家之后\n再好好想想吧。",
            "narrator_zh": "光"
        },
        {
            "location": "113/TALK",
            "narrator": "繭",
            "text": "賛成。",
            "zh": "赞成。",
            "narrator_zh": "茧"
        },
        {
            "location": "114/TALK",
            "narrator": "繭",
            "text": "このままじゃ、\n感情論のぶつけ合いに\nなりかねない。",
            "zh": "再这样下去，\n搞不好会变成\n单纯的情绪宣泄。",
            "narrator_zh": "茧"
        },
        {
            "location": "116/TALK",
            "narrator": "キリト",
            "text": "…だな。",
            "zh": "……说得对。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "117/TALK",
            "narrator": "キリト",
            "text": "今日は解散して、\n別の案考えようぜ。",
            "zh": "今天就先解散，\n各自再想想别的办法吧。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "118/TALK",
            "narrator": "雛",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雏"
        },
        {
            "location": "127/TALK",
            "narrator": "アーヤ",
            "text": "…みやびの解析、\nまだかかるのかしら？",
            "zh": "……雅的解析，\n还要花不少时间吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "129/TALK",
            "narrator": "アーヤ",
            "text": "私も、手伝えたら\nいいんだけど…。",
            "zh": "我也想帮上点忙\n就好了……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "130/TALK",
            "narrator": "アーヤ",
            "text": "…東京に戻れたら、\n私も少し勉強しよう\nかしら？",
            "zh": "……等回到东京，\n我也稍微学一点\n好了？",
            "narrator_zh": "绫水"
        },
        {
            "location": "131/SEL",
            "narrator": "（選択肢）",
            "text": "東京のことを聞きたい？",
            "zh": "想听听东京那边的事吗？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "132/ACT",
            "narrator": "",
            "text": "東京のことを聞きたい？",
            "zh": "想听听东京那边的事吗？",
            "narrator_zh": ""
        },
        {
            "location": "137/TALK",
            "narrator": "アーヤ",
            "text": "…また、日向さん達？",
            "zh": "……又是日向她们？",
            "narrator_zh": "绫水"
        },
        {
            "location": "151/TALK",
            "narrator": "アーヤ",
            "text": "どういうこと？(￣Д￣ )",
            "zh": "怎么回事？(￣Д￣ )",
            "narrator_zh": "绫水"
        },
        {
            "location": "153/TALK",
            "narrator": "アーヤ",
            "text": "東京の方でなにかあったの？",
            "zh": "东京那边发生什么事了吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "155/SEL",
            "narrator": "（選択肢）",
            "text": "雛達が大変",
            "zh": "雏她们出大事了",
