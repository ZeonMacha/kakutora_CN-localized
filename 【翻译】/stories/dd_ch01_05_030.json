{
    "dir": "chap05/daydra/dd_ch01_05_030.js",
    "type": "MainStory",
    "info": {
        "story_id": "5157",
        "cid": "tsubame",
        "title": "Extra007 プレミアムストーリー",
        "sub_title": "次の映画は？",
        "title_zh": "Extra007 额外剧情",
        "sub_title_zh": "下一部电影是？"
    },
    "entry": [
        {
            "location": "552/SCENARIO",
            "narrator": "",
            "text": "次の映画は？",
            "zh": "下一部电影是？",
            "narrator_zh": ""
        },
        {
            "location": "567/TALK",
            "narrator": "真幌",
            "text": "そういえば、\n逢瀬はどんな映画が\n好きなんだ？",
            "zh": "说起来，\n逢濑喜欢\n什么样的电影？",
            "narrator_zh": "真幌"
        },
        {
            "location": "569/TALK",
            "narrator": "つばめ",
            "text": "え？",
            "zh": "诶？",
            "narrator_zh": "燕"
        },
        {
            "location": "570/TALK",
            "narrator": "真幌",
            "text": "いや、おまえがどんな\n作品が好きなのか――",
            "zh": "不，你喜欢\n什么样的作品——",
            "narrator_zh": "真幌"
        },
        {
            "location": "571/TALK",
            "narrator": "真幌",
            "text": "まだ聞いていなかった\nのを思い出してな。",
            "zh": "我还没问过，\n这才想起来。",
            "narrator_zh": "真幌"
        },
        {
            "location": "572/TALK",
            "narrator": "つばめ",
            "text": "は、はあ…。\nでも、どうして\nですか？",
            "zh": "是、是吗……\n可是，为什么\n问这个？",
            "narrator_zh": "燕"
        },
        {
            "location": "573/TALK",
            "narrator": "真幌",
            "text": "…このことも説明して\nおかなければならな\nかったな。",
            "zh": "……这件事也得\n说明一下\n才行啊。",
            "narrator_zh": "真幌"
        },
        {
            "location": "574/TALK",
            "narrator": "真幌",
            "text": "うちの劇場は\nトライナリーの本部\nであると同時に――",
            "zh": "我们剧场\n是三重奏的本部，\n同时也——",
            "narrator_zh": "真幌"
        },
        {
            "location": "575/TALK",
            "narrator": "真幌",
            "text": "カモフラージュに、\n映画館もやって\nいるんだ。",
            "zh": "为了伪装，\n也在经营\n电影院。",
            "narrator_zh": "真幌"
        },
        {
            "location": "576/TALK",
            "narrator": "つばめ",
            "text": "なるほど…。",
            "zh": "原来如此……。",
            "narrator_zh": "燕"
        },
        {
            "location": "577/TALK",
            "narrator": "真幌",
            "text": "…まあ、正直に言うと\nだな――",
            "zh": "……嘛，老实说\n吧——",
            "narrator_zh": "真幌"
        },
        {
            "location": "578/TALK",
            "narrator": "真幌",
            "text": "次の映画を何にするか\n決まっていないんだ。",
            "zh": "下一部电影放什么，\n还没定。",
            "narrator_zh": "真幌"
        },
        {
            "location": "579/TALK",
            "narrator": "真幌",
            "text": "だから、参考に逢瀬の\n好みを教えてほしい。",
            "zh": "所以，想请逢濑\n告诉我你的喜好。",
            "narrator_zh": "真幌"
        },
        {
            "location": "580/TALK",
            "narrator": "真幌",
            "text": "ちなみに、\n今上映しているのは\n怪獣映画だ。",
            "zh": "顺便一提，\n现在上映的是\n怪兽电影。",
            "narrator_zh": "真幌"
        },
        {
            "location": "584/TALK",
            "narrator": "つばめ",
            "text": "…でも、わたしって面白い\n映画は何でも好きって\n思うタイプだから――",
            "zh": "……可是，我觉得自己\n有意思的电影都喜欢，\n是这种类型——",
            "narrator_zh": "燕"
        },
        {
            "location": "586/TALK",
            "narrator": "つばめ",
            "text": "どの映画がいいか、って\n聞かれても、ちょっと…。",
            "zh": "要问哪部电影好，\n我也有点……。",
            "narrator_zh": "燕"
        },
        {
            "location": "587/TALK",
            "narrator": "真幌",
            "text": "難しく考える必要はない。\nどうせ何を流そうとも\n客なんか来ないからな。",
            "zh": "不必想得太复杂。\n反正不管放什么，\n客人都不会来。",
            "narrator_zh": "真幌"
        },
        {
            "location": "588/TALK",
            "narrator": "真幌",
            "text": "頭に浮かんだジャンルを\n一つ言ってもらえれば、\nそれで構わん。",
            "zh": "脑子里浮现的类型，\n说一个就行，\n这样就够了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "591/TALK",
            "narrator": "つばめ",
            "text": "う～ん…\nジャンルですかぁ…。",
            "zh": "唔……\n类型吗……。",
            "narrator_zh": "燕"
        },
        {
            "location": "593/TALK",
            "narrator": "つばめ",
            "text": "本当にそういうの気にして\n見ないから、まったく\n思いつかないよ…。",
            "zh": "我看电影真的不在意那个，\n完全\n想不出来……。",
            "narrator_zh": "燕"
        },
        {
            "location": "594/TALK",
            "narrator": "つばめ",
            "text": "…相談してみようかな？",
            "zh": "……问问看吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "597/TALK",
            "narrator": "つばめ",
            "text": "ちょ、ちょっとだけ\n待ってください。\nえっと…。",
            "zh": "请、请稍微\n等一下。\n那个……。",
            "narrator_zh": "燕"
        },
        {
            "location": "611/TALK",
            "narrator": "つばめ",
            "text": "真幌さんに、今度映画館で流す映画を決めろって言われてるの",
            "zh": "真幌说，要我决定下次电影院放什么",
            "narrator_zh": "燕"
        },
        {
            "location": "612/TALK",
            "narrator": "つばめ",
            "text": "なんて答えれば\nいいのかな？",
            "zh": "我该怎么\n回答好呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "613/TALK",
            "narrator": "つばめ",
            "text": "わたしじゃわからないの、手伝って！",
            "zh": "我搞不懂，帮帮我！",
            "narrator_zh": "燕"
        },
        {
            "location": "615/SEL",
            "narrator": "",
            "text": "ミステリーは？",
            "zh": "悬疑怎么样？",
            "narrator_zh": ""
        },
        {
            "location": "616/SEL",
            "narrator": "",
            "text": "怪獣映画は？",
            "zh": "怪兽电影怎么样？",
            "narrator_zh": ""
        },
        {
            "location": "617/SEL",
            "narrator": "",
            "text": "ラブロマンスがいい",
            "zh": "love romance比较好",
            "narrator_zh": ""
        },
        {
            "location": "618/ACT",
            "narrator": "",
            "text": "ミステリーは？",
            "zh": "悬疑怎么样？",
            "narrator_zh": ""
        },
        {
            "location": "619/TALK",
            "narrator": "つばめ",
            "text": "ミステリーって、推理モノだよね？",
            "zh": "悬疑的话，就是推理片吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "620/TALK",
            "narrator": "つばめ",
            "text": "わかったよ、ありがと！",
            "zh": "知道了，谢谢！",
            "narrator_zh": "燕"
        },
        {
            "location": "632/TALK",
            "narrator": "つばめ",
            "text": "それじゃあ、ミステリー\n映画とかはどうですか？",
            "zh": "那么，悬疑\n电影怎么样？",
            "narrator_zh": "燕"
        },
        {
            "location": "633/TALK",
            "narrator": "真幌",
            "text": "おっ、いいぞ逢瀬！\n素晴らしいじゃないか！",
            "zh": "哦，不错嘛逢濑！\n太棒了不是吗！",
            "narrator_zh": "真幌"
        },
        {
            "location": "634/TALK",
            "narrator": "つばめ",
            "text": "本当ですか！？",
            "zh": "真的吗！？",
            "narrator_zh": "燕"
        },
        {
            "location": "635/TALK",
            "narrator": "真幌",
            "text": "ああ、最高だ！",
            "zh": "啊，最好了！",
            "narrator_zh": "真幌"
        },
        {
            "location": "636/TALK",
            "narrator": "真幌",
            "text": "次の映画を何にするか\n必死で悩んでいた私と\n同じように――",
            "zh": "就像拼命烦恼\n下一部放什么的我\n一样——",
            "narrator_zh": "真幌"
        },
        {
            "location": "637/TALK",
            "narrator": "真幌",
            "text": "見に来た観客にも、\n犯人が誰なのか悩んで\nもらうとしよう。",
            "zh": "来看的观众，\n也让他们去猜\n凶手是谁吧。",
            "narrator_zh": "真幌"
        },
        {
            "location": "639/TALK",
            "narrator": "つばめ",
            "text": "そ、そうですか…。\nお客さん、来てくれると\nいいですね。",
            "zh": "是、是这样吗……\n客人能来\n就好了。",
            "narrator_zh": "燕"
        },
        {
            "location": "640/TALK",
            "narrator": "真幌",
            "text": "大勢来られては困るが…\nまあ、十人くらいは\n来てもらいたいな。",
            "zh": "来太多会头疼……\n不过，十个人左右\n还是希望能来。",
            "narrator_zh": "真幌"
        },
        {
            "location": "641/ACT",
            "narrator": "",
            "text": "怪獣映画は？",
            "zh": "怪兽电影怎么样？",
            "narrator_zh": ""
        },
        {
            "location": "642/TALK",
            "narrator": "つばめ",
            "text": "怪獣映画も良さそうだね",
            "zh": "怪兽电影好像也不错",
            "narrator_zh": "燕"
        },
        {
            "location": "643/TALK",
            "narrator": "つばめ",
            "text": "そう言ってみるよ、ありがと",
            "zh": "我这么说说看，谢谢",
            "narrator_zh": "燕"
        },
        {
            "location": "655/TALK",
            "narrator": "つばめ",
            "text": "あの、怪獣映画が\nいいと思います！",
            "zh": "那个，我觉得\n怪兽电影比较好！",
            "narrator_zh": "燕"
        },
        {
            "location": "656/TALK",
            "narrator": "真幌",
            "text": "怪獣映画って…\n本気か？",
            "zh": "怪兽电影……\n是认真的吗？",
            "narrator_zh": "真幌"
        },
        {
            "location": "658/TALK",
            "narrator": "つばめ",
            "text": "はい！",
            "zh": "是的！",
            "narrator_zh": "燕"
        },
        {
            "location": "660/TALK",
            "narrator": "真幌",
            "text": "……そうか。",
            "zh": "……这样啊。",
            "narrator_zh": "真幌"
        },
        {
            "location": "662/TALK",
            "narrator": "真幌",
            "text": "正直、連続で\n怪獣映画はどうかと\n思ったんだが…。",
            "zh": "老实说，连续放\n怪兽电影怎么样，\n我是想过的……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "664/TALK",
            "narrator": "つばめ",
            "text": "あっ、そういえば今も\n怪獣映画やってるの\n忘れてた！",
            "zh": "啊，说起来现在\n也在放怪兽电影，\n我忘了！",
            "narrator_zh": "燕"
        },
        {
            "location": "666/TALK",
            "narrator": "真幌",
            "text": "まあ、何も思い\n浮かばんのだから、\n仕方ないな。",
            "zh": "算了，既然什么都\n想不出来，\n也没办法。",
            "narrator_zh": "真幌"
        },
        {
            "location": "668/TALK",
            "narrator": "つばめ",
            "text": "…怪獣映画以外で、\nって聞けば\nよかったなぁ。",
            "zh": "……要是问除了怪兽电影\n以外的，\n就好了。",
            "narrator_zh": "燕"
        },
        {
            "location": "669/ACT",
            "narrator": "",
            "text": "ラブロマンスがいい",
            "zh": "love romance比较好",
            "narrator_zh": ""
        },
        {
            "location": "680/TALK",
            "narrator": "つばめ",
            "text": "ラブロマンスってことは、恋愛映画のことかな？",
            "zh": "love romance的话，是恋爱电影吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "681/TALK",
            "narrator": "つばめ",
            "text": "じゃあ、そう言っておくね",
            "zh": "那我就这么说哦",
            "narrator_zh": "燕"
        },
        {
            "location": "693/TALK",
            "narrator": "つばめ",
            "text": "あの、\nラブロマンス…って\nいうのはどうですか？",
            "zh": "那个，\nlove romance……\n怎么样？",
            "narrator_zh": "燕"
        },
        {
            "location": "694/TALK",
            "narrator": "真幌",
            "text": "…なんだと？",
            "zh": "……你说什么？",
            "narrator_zh": "真幌"
        },
        {
            "location": "696/TALK",
            "narrator": "つばめ",
            "text": "ラブロマンスです。",
            "zh": "是love romance。",
            "narrator_zh": "燕"
        },
        {
            "location": "697/TALK",
            "narrator": "真幌",
            "text": "…驚いた。まさか\n逢瀬の口からそんな\n単語が出てくるとは。",
            "zh": "……吓了一跳。没想到\n会从逢濑嘴里\n冒出这种词。",
            "narrator_zh": "真幌"
        },
        {
            "location": "698/TALK",
            "narrator": "真幌",
            "text": "まあいい、それにしよう。",
            "zh": "也行，就这个吧。",
            "narrator_zh": "真幌"
        },
        {
            "location": "699/TALK",
            "narrator": "真幌",
            "text": "次はラブロマンス。\nそれも、少し大人の\n恋愛映画に決まりだ！",
            "zh": "下一部是love romance。\n而且，定成稍微成人一点的\n恋爱电影！",
            "narrator_zh": "真幌"
        },
        {
            "location": "700/TALK",
            "narrator": "つばめ",
            "text": "ほっ…\n力になれたみたいで\nよかったです。",
            "zh": "呼……\n能帮上忙，\n太好了。",
            "narrator_zh": "燕"
        },
        {
            "location": "702/TALK",
            "narrator": "真幌",
            "text": "ああ…だがな、逢瀬。",
            "zh": "啊……不过，逢濑。",
            "narrator_zh": "真幌"
        },
        {
            "location": "704/TALK",
            "narrator": "真幌",
            "text": "おまえとギャヴィは、\n絶対にその映画を\n見るんじゃないぞ。",
            "zh": "你和加维，\n绝对不许看\n那部电影。",
            "narrator_zh": "真幌"
        },
        {
            "location": "705/TALK",
            "narrator": "つばめ",
            "text": "え、なんでですか？",
            "zh": "诶，为什么？",
            "narrator_zh": "燕"
        },
        {
            "location": "706/TALK",
            "narrator": "真幌",
            "text": "おまえ達には、\nまだ早いからだ。",
            "zh": "对你们来说，\n还太早。",
            "narrator_zh": "真幌"
        },
        {
            "location": "707/TALK",
            "narrator": "つばめ",
            "text": "少し大人向けの映画\nだからですか？",
            "zh": "因为是稍微偏成人的\n电影吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "708/TALK",
            "narrator": "真幌",
            "text": "ハッキリ言えば、\n濃厚なラブシーンが\nある映画だ。",
            "zh": "说白了，\n是有浓烈亲热场面的\n电影。",
            "narrator_zh": "真幌"
        },
        {
            "location": "709/TALK",
            "narrator": "つばめ",
            "text": "えっと…普通のよりも\n凄いってことですか？",
            "zh": "那个……比普通的\n更厉害的意思吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "710/TALK",
            "narrator": "真幌",
            "text": "そういうことだが…\nまさかどういうことか\nわかっていないのか？",
            "zh": "是这个意思……\n难道你还不明白\n是怎么回事？",
            "narrator_zh": "真幌"
        },
        {
            "location": "712/TALK",
            "narrator": "つばめ",
            "text": "う～ん…\n多分そうだと思います。",
            "zh": "唔……\n大概是吧。",
            "narrator_zh": "燕"
        },
        {
            "location": "714/TALK",
            "narrator": "つばめ",
            "text": "わたし、恋愛映画って、\nあんまり見たことも\nないし…。",
            "zh": "我恋爱电影，\n也没怎么看过，\n所以……。",
            "narrator_zh": "燕"
        },
        {
            "location": "715/TALK",
            "narrator": "真幌",
            "text": "…ふふっ、そうだったか。",
            "zh": "……呵呵，是这样啊。",
            "narrator_zh": "真幌"
        },
        {
            "location": "716/TALK",
            "narrator": "真幌",
            "text": "ならば特別授業として、\n私が濃厚なラブシーンが\nどういうものかを――",
            "zh": "那就当作特别课，\n浓烈的亲热场面\n是什么——",
            "narrator_zh": "真幌"
        },
        {
            "location": "717/TALK",
            "narrator": "真幌",
            "text": "しっかり、わかり\nやすく、丁寧に教育\nしてやるとしよう！",
            "zh": "由我清楚、\n好懂、仔细地\n教给你吧！",
            "narrator_zh": "真幌"
        },
        {
            "location": "719/TALK",
            "narrator": "つばめ",
            "text": "えっ？　でも私には\nまだ早過ぎるんじゃ…。",
            "zh": "诶？　可是对我来说\n会不会还太早……。",
            "narrator_zh": "燕"
        },
        {
            "location": "721/TALK",
            "narrator": "真幌",
            "text": "この映画は早すぎるが、\n逢瀬は少し初心過ぎる\n気がするのでな。",
            "zh": "这部电影是太早，\n不过逢濑好像\n有点太纯了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "723/TALK",
            "narrator": "真幌",
            "text": "教師としてしっかりと、\nわかりやすく説明して\nやろう。",
            "zh": "作为老师，我会好好、\n清楚、好懂地\n说明给你。",
            "narrator_zh": "真幌"
        },
        {
            "location": "725/TALK",
            "narrator": "つばめ",
            "text": "な、なんでこんなに\n楽しそうなんだろう？",
            "zh": "为、为什么看起来\n这么开心？",
            "narrator_zh": "燕"
        },
        {
            "location": "726/TALK",
            "narrator": "つばめ",
            "text": "興味はあるけど、\nちょっと怖いから\n断ろう…。",
            "zh": "我是有兴趣，\n可有点害怕，\n还是拒绝吧……。",
            "narrator_zh": "燕"
        },
        {
            "location": "729/TALK",
