            "narrator_zh": "绫水"
        },
        {
            "location": "117/TALK",
            "narrator": "アーヤ",
            "text": "ｍだちょっと",
            "zh": "嗯、有点",
            "narrator_zh": "绫水"
        },
        {
            "location": "118/TALK",
            "narrator": "アーヤ",
            "text": "整理がつかないわ",
            "zh": "还整理不好",
            "narrator_zh": "绫水"
        },
        {
            "location": "120/TALK",
            "narrator": "アーヤ",
            "text": "それに",
            "zh": "而且",
            "narrator_zh": "绫水"
        },
        {
            "location": "121/TALK",
            "narrator": "アーヤ",
            "text": "まだ信じてるわけじゃない",
            "zh": "也还不是就相信了",
            "narrator_zh": "绫水"
        },
        {
            "location": "122/TALK",
            "narrator": "アーヤ",
            "text": "でも",
            "zh": "不过",
            "narrator_zh": "绫水"
        },
        {
            "location": "123/TALK",
            "narrator": "アーヤ",
            "text": "いい加減にするつもりはないの",
            "zh": "我没打算敷衍了事",
            "narrator_zh": "绫水"
        },
        {
            "location": "124/TALK",
            "narrator": "アーヤ",
            "text": "だからそこは",
            "zh": "所以那里",
            "narrator_zh": "绫水"
        },
        {
            "location": "125/TALK",
            "narrator": "アーヤ",
            "text": "心配しないで",
            "zh": "别担心",
            "narrator_zh": "绫水"
        },
        {
            "location": "128/TALK",
            "narrator": "アーヤ",
            "text": "っていうのも",
            "zh": "也是说",
            "narrator_zh": "绫水"
        },
        {
            "location": "129/TALK",
            "narrator": "アーヤ",
            "text": "ちょっと変かもね",
