        {
            "location": "101/TALK",
            "narrator": "アーヤ",
            "text": "そうねとしか言えないわ",
            "zh": "只能说声是啊",
            "narrator_zh": "绫水"
        },
        {
            "location": "102/TALK",
            "narrator": "アーヤ",
            "text": "でもこんな状況",
            "zh": "不过这种状况",
            "narrator_zh": "绫水"
        },
        {
            "location": "103/TALK",
            "narrator": "アーヤ",
            "text": "想定外だったもの",
            "zh": "因为完全没想到",
            "narrator_zh": "绫水"
        },
        {
            "location": "104/TALK",
            "narrator": "アーヤ",
            "text": "仕方ないわ",
