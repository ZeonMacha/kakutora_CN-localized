            "narrator": "アーヤ",
            "text": "なんだけど、",
            "zh": "虽然是这样，",
            "narrator_zh": "绫水"
        },
        {
            "location": "35/SEL",
            "narrator": "",
            "text": "うん",
            "zh": "嗯",
            "narrator_zh": ""
        },
        {
            "location": "36/SEL",
            "narrator": "",
