            "location": "41/TALK",
            "narrator": "アーヤ",
            "text": "念のためだけど",
            "zh": "虽然是确认一下",
            "narrator_zh": "绫水"
        },
        {
            "location": "42/TALK",
            "narrator": "アーヤ",
            "text": "貴方が人間かもしれないって",
            "zh": "你也许是人类这件事",
            "narrator_zh": "绫水"
        },
        {
            "location": "43/TALK",
            "narrator": "アーヤ",
            "text": "トライナリーのみんなに教えたって話よ",
            "zh": "就是告诉了三重奏大家的那件事",
            "narrator_zh": "绫水"
        },
        {
            "location": "45/SEL",
            "narrator": "",
            "text": "知ってるって",
            "zh": "我说我知道",
            "narrator_zh": ""
        },
        {
            "location": "46/SEL",
            "narrator": "",
            "text": "わかってるってば",
            "zh": "我知道啦",
            "narrator_zh": ""
        },
        {
            "location": "47/ACT",
            "narrator": "",
            "text": "知ってるって",
            "zh": "我说我知道",
            "narrator_zh": ""
        },
        {
            "location": "48/TALK",
            "narrator": "アーヤ",
            "text": "そうよね、、、",
            "zh": "也是啊……",
            "narrator_zh": "绫水"
        },
        {
            "location": "49/ACT",
            "narrator": "",
            "text": "わかってるってば",
            "zh": "我知道啦",
            "narrator_zh": ""
        },
        {
            "location": "50/TALK",
            "narrator": "アーヤ",
            "text": "そう？",
            "zh": "是吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "52/TALK",
            "narrator": "アーヤ",
            "text": "肩の荷が降りたような",
            "zh": "像是卸下了肩上的担子",
            "narrator_zh": "绫水"
        },
        {
            "location": "53/TALK",
            "narrator": "アーヤ",
            "text": "もっとやっかいごとができたような",
            "zh": "又像是多了更麻烦的事",
            "narrator_zh": "绫水"
        },
        {
            "location": "54/TALK",
            "narrator": "アーヤ",
            "text": "複雑な気持ちよ",
            "zh": "心情很复杂",
            "narrator_zh": "绫水"
        },
        {
            "location": "57/SEL",
            "narrator": "",
            "text": "そんな深刻にならないで",
            "zh": "别想得那么严重",
            "narrator_zh": ""
        },
        {
            "location": "58/SEL",
            "narrator": "",
            "text": "気楽にやろうよ",
            "zh": "轻松点来吧",
            "narrator_zh": ""
        },
        {
            "location": "59/ACT",
            "narrator": "",
            "text": "そんな深刻にならないで",
            "zh": "别想得那么严重",
            "narrator_zh": ""
        },
        {
            "location": "60/TALK",
            "narrator": "アーヤ",
            "text": "なるわよ",
            "zh": "会哦",
            "narrator_zh": "绫水"
        },
        {
            "location": "61/TALK",
            "narrator": "アーヤ",
            "text": "鳴るに決まってるわ",
            "zh": "当然会响",
            "narrator_zh": "绫水"
        },
        {
            "location": "62/TALK",
            "narrator": "アーヤ",
            "text": "なるに",
            "zh": "会吗",
            "narrator_zh": "绫水"
        },
        {
            "location": "63/ACT",
            "narrator": "",
            "text": "気楽にやろうよ",
            "zh": "轻松点来吧",
            "narrator_zh": ""
        },
        {
            "location": "64/TALK",
            "narrator": "アーヤ",
            "text": "そういうふうに",
            "zh": "那样的话",
            "narrator_zh": "绫水"
        },
        {
            "location": "65/TALK",
            "narrator": "アーヤ",
            "text": "割り切れないわ",
            "zh": "想不通",
            "narrator_zh": "绫水"
        },
        {
            "location": "67/TALK",
            "narrator": "アーヤ",
            "text": "最初から言っててくれれば",
            "zh": "要是一开始就说了",
            "narrator_zh": "绫水"
        },
        {
            "location": "69/TALK",
            "narrator": "アーヤ",
            "text": "こんな風に",
            "zh": "像这样",
            "narrator_zh": "绫水"
        },
        {
            "location": "70/TALK",
            "narrator": "アーヤ",
            "text": "こじれなかったのに",
            "zh": "本来就不用闹僵的",
            "narrator_zh": "绫水"
        },
        {
            "location": "72/SEL",
            "narrator": "",
            "text": "まあまあ",
            "zh": "好啦好啦",
            "narrator_zh": ""
        },
        {
            "location": "73/SEL",
            "narrator": "",
            "text": "事情があって",
            "zh": "是有原因的",
            "narrator_zh": ""
        },
        {
            "location": "74/SEL",
            "narrator": "",
            "text": "システム的に無理だった",
            "zh": "系统上做不到",
            "narrator_zh": ""
        },
        {
            "location": "75/ACT",
            "narrator": "",
            "text": "まあまあ",
            "zh": "好啦好啦",
            "narrator_zh": ""
        },
        {
            "location": "76/TALK",
            "narrator": "アーヤ",
            "text": "ほんと",
            "zh": "真的",
            "narrator_zh": "绫水"
        },
        {
            "location": "77/TALK",
            "narrator": "アーヤ",
            "text": "のんきね",
            "zh": "真悠闲呢",
            "narrator_zh": "绫水"
        },
        {
            "location": "78/ACT",
            "narrator": "",
            "text": "事情があって",
            "zh": "是有原因的",
            "narrator_zh": ""
        },
        {
            "location": "79/TALK",
            "narrator": "アーヤ",
            "text": "まあ",
            "zh": "嗯",
            "narrator_zh": "绫水"
        },
        {
            "location": "80/TALK",
            "narrator": "アーヤ",
            "text": "そうなんだろうけど",
            "zh": "大概是这样，不过",
            "narrator_zh": "绫水"
        },
        {
            "location": "81/ACT",
            "narrator": "",
            "text": "システム的に無理だった",
            "zh": "系统上做不到",
            "narrator_zh": ""
        },
        {
            "location": "82/TALK",
            "narrator": "アーヤ",
            "text": "なんだか",
            "zh": "总觉得",
            "narrator_zh": "绫水"
        },
        {
            "location": "83/TALK",
            "narrator": "アーヤ",
            "text": "いろんな事情がありそうね、、、",
            "zh": "好像各有各的情况……",
            "narrator_zh": "绫水"
        },
        {
            "location": "85/TALK",
            "narrator": "アーヤ",
            "text": "でも全員",
            "zh": "不过全员",
            "narrator_zh": "绫水"
        },
        {
            "location": "86/TALK",
            "narrator": "アーヤ",
            "text": "違うこと言ってたわ",
            "zh": "说的都不一样",
            "narrator_zh": "绫水"
        },
        {
            "location": "87/TALK",
            "narrator": "アーヤ",
            "text": "そういうものかもしれないけど",
            "zh": "也许是这样吧",
            "narrator_zh": "绫水"
        },
        {
            "location": "88/TALK",
            "narrator": "アーヤ",
            "text": "ちょっと不思議",
            "zh": "有点不可思议",
            "narrator_zh": "绫水"
        },
        {
            "location": "90/SEL",
            "narrator": "",
            "text": "乙女心は複雑怪奇",
