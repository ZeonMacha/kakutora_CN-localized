        },
        {
            "location": "98/TALK",
            "narrator": "アーヤ",
            "text": "そんなものかもしれないわね",
            "zh": "也许是那样呢",
            "narrator_zh": "绫水"
        },
        {
            "location": "99/ACT",
            "narrator": "",
            "text": "観察力が足りないね",
            "zh": "观察力不够啊",
            "narrator_zh": ""
        },
        {
            "location": "100/TALK",
            "narrator": "アーヤ",
            "text": "そう言われると",
            "zh": "这么一说",
            "narrator_zh": "绫水"
