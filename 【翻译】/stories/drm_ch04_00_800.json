        },
        {
            "location": "154/ACT",
            "narrator": "",
            "text": "ニヤニヤが止まらない",
            "zh": "笑得停不下来",
            "narrator_zh": ""
        },
        {
            "location": "155/TALK",
            "narrator": "みやび",
            "text": "相棒が\nそんなやつだとは。",
            "zh": "没想到搭档\n是这么个家伙。",
            "narrator_zh": "雅"
        },
        {
            "location": "156/TALK",
            "narrator": "みやび",
            "text": "…いや。\n知っとったけんど。",
            "zh": "……不。\n其实一直都知道，但是。",
