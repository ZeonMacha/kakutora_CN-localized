        },
        {
            "location": "177/SEL",
            "narrator": "",
            "text": "マルチデバイスに対応しよう",
            "zh": "来支持多设备吧",
            "narrator_zh": ""
        },
        {
            "location": "178/ACT",
            "narrator": "",
            "text": "カタカナ表記なのはどうかなー",
            "zh": "用片假名写不太好吧——",
            "narrator_zh": ""
        },
        {
            "location": "179/TALK",
            "narrator": "みやび",
            "text": "ユーザーフレンドリーなところを",
            "zh": "把亲和易用的地方",
            "narrator_zh": "雅"
        },
        {
            "location": "181/TALK",
            "narrator": "みやび",
            "text": "強調してみたのだ",
            "zh": "试着突出了一下",
            "narrator_zh": "雅"
        },
        {
            "location": "182/ACT",
            "narrator": "",
            "text": "やっぱり普段のみやびだった",
            "zh": "果然还是平时的雅",
            "narrator_zh": ""
        },
        {
            "location": "183/TALK",
            "narrator": "みやび",
            "text": "まあ",
            "zh": "嗯",
            "narrator_zh": "雅"
        },
        {
            "location": "184/TALK",
            "narrator": "みやび",
            "text": "うちはうちやけんど",
            "zh": "我还是我，但是",
            "narrator_zh": "雅"
        },
        {
            "location": "185/ACT",
            "narrator": "",
            "text": "マルチデバイスに対応しよう",
            "zh": "来支持多设备吧",
            "narrator_zh": ""
        },
        {
            "location": "186/TALK",
            "narrator": "みやび",
            "text": "ほほう",
            "zh": "哦哦",
            "narrator_zh": "雅"
        },
        {
            "location": "187/TALK",
            "narrator": "みやび",
            "text": "それっぽいことを",
            "zh": "就是说点像样的话",
            "narrator_zh": "雅"
        },
        {
            "location": "189/TALK",
            "narrator": "みやび",
            "text": "その",
            "zh": "那个",
            "narrator_zh": "雅"
        },
        {
            "location": "190/TALK",
            "narrator": "みやび",
            "text": "なんだ",
            "zh": "什么事",
            "narrator_zh": "雅"
        },
        {
            "location": "191/TALK",
            "narrator": "みやび",
            "text": "$handle$とは",
            "zh": "跟$handle$啊",
            "narrator_zh": "雅"
        },
        {
            "location": "192/TALK",
            "narrator": "みやび",
            "text": "常にチャット前提の",
            "zh": "一直是以聊天为前提的",
            "narrator_zh": "雅"
        },
        {
            "location": "194/TALK",
            "narrator": "みやび",
            "text": "お付き合いだったというか",
            "zh": "算是交往来着",
            "narrator_zh": "雅"
        },
        {
            "location": "196/SEL",
            "narrator": "",
            "text": "でも結婚するんでしょ",
            "zh": "可你们要结婚吧",
            "narrator_zh": ""
        },
        {
            "location": "197/SEL",
            "narrator": "",
            "text": "結婚してもそれが続くの？",
            "zh": "结婚之后还能继续吗？",
            "narrator_zh": ""
        },
        {
            "location": "198/SEL",
            "narrator": "",
            "text": "みやびにとっての結婚とは？",
            "zh": "对雅来说结婚是什么？",
            "narrator_zh": ""
        },
        {
            "location": "199/ACT",
            "narrator": "",
            "text": "でも結婚するんでしょ",
            "zh": "可你们要结婚吧",
            "narrator_zh": ""
        },
        {
            "location": "200/TALK",
            "narrator": "みやび",
            "text": "それは",
            "zh": "这个",
            "narrator_zh": "雅"
        },
        {
            "location": "201/TALK",
            "narrator": "みやび",
            "text": "確定事項ぞね",
            "zh": "是确定事项咧",
            "narrator_zh": "雅"
        },
        {
            "location": "202/ACT",
            "narrator": "",
            "text": "結婚してもそれが続くの？",
            "zh": "结婚之后还能继续吗？",
            "narrator_zh": ""
        },
        {
            "location": "203/TALK",
            "narrator": "みやび",
            "text": "困るか",
            "zh": "会为难吗",
            "narrator_zh": "雅"
        },
        {
            "location": "204/TALK",
            "narrator": "みやび",
            "text": "やはり",
            "zh": "果然",
            "narrator_zh": "雅"
        },
        {
            "location": "205/ACT",
            "narrator": "",
            "text": "みやびにとっての結婚とは？",
            "zh": "对雅来说结婚是什么？",
            "narrator_zh": ""
        },
        {
            "location": "206/TALK",
            "narrator": "みやび",
            "text": "確固とした結論があった",
            "zh": "明明有明确结论的",
            "narrator_zh": "雅"
        },
        {
            "location": "207/TALK",
            "narrator": "みやび",
            "text": "しかし雲散霧消した",
            "zh": "但是转眼烟消云散了",
            "narrator_zh": "雅"
        },
        {
            "location": "209/TALK",
            "narrator": "みやび",
            "text": "ぐぬぬ",
            "zh": "咕唔唔",
            "narrator_zh": "雅"
        },
        {
            "location": "210/TALK",
            "narrator": "みやび",
            "text": "どうすればいい",
            "zh": "该怎么办",
            "narrator_zh": "雅"
        },
        {
            "location": "212/SEL",
            "narrator": "",
            "text": "とりあえず式を挙げよう",
            "zh": "先把仪式办了吧",
            "narrator_zh": ""
        },
        {
            "location": "213/SEL",
            "narrator": "",
            "text": "結婚式だけでもしよう",
            "zh": "至少办个婚礼吧",
            "narrator_zh": ""
        },
        {
            "location": "214/ACT",
            "narrator": "",
            "text": "とりあえず式を挙げよう",
            "zh": "先把仪式办了吧",
            "narrator_zh": ""
        },
        {
            "location": "215/TALK",
            "narrator": "みやび",
            "text": "いや",
            "zh": "不对",
            "narrator_zh": "雅"
        },
        {
            "location": "216/TALK",
            "narrator": "みやび",
            "text": "ちょっと待て",
            "zh": "等一下",
            "narrator_zh": "雅"
        },
        {
            "location": "217/ACT",
            "narrator": "",
            "text": "結婚式だけでもしよう",
            "zh": "至少办个婚礼吧",
            "narrator_zh": ""
        },
        {
            "location": "218/TALK",
            "narrator": "みやび",
            "text": "あ",
            "zh": "啊",
            "narrator_zh": "雅"
        },
        {
            "location": "219/TALK",
            "narrator": "みやび",
            "text": "何だと",
            "zh": "驷马？！",
            "narrator_zh": "雅"
        },
        {
            "location": "221/TALK",
            "narrator": "みやび",
            "text": "その発言は",
            "zh": "那个发言",
            "narrator_zh": "雅"
        },
        {
            "location": "222/TALK",
            "narrator": "みやび",
            "text": "唐突かつ",
            "zh": "既唐突",
            "narrator_zh": "雅"
        },
        {
            "location": "223/TALK",
            "narrator": "みやび",
            "text": "ハードルだだ上がりぞね",
            "zh": "门槛又一路飙升咧",
            "narrator_zh": "雅"
        },
        {
            "location": "224/TALK",
            "narrator": "みやび",
            "text": "なぜそうなる",
            "zh": "为什么会那样",
            "narrator_zh": "雅"
        },
        {
            "location": "226/SEL",
            "narrator": "",
            "text": "したいから",
            "zh": "因为我想做",
            "narrator_zh": ""
        },
        {
            "location": "227/SEL",
            "narrator": "",
            "text": "なんとなく？",
            "zh": "就是感觉？",
            "narrator_zh": ""
        },
        {
            "location": "228/SEL",
            "narrator": "",
            "text": "案ずるより産むが易し",
            "zh": "与其空想，不如动手",
            "narrator_zh": ""
        },
        {
            "location": "229/ACT",
            "narrator": "",
            "text": "したいから",
            "zh": "因为我想做",
            "narrator_zh": ""
        },
        {
            "location": "230/TALK",
            "narrator": "みやび",
            "text": "なんと",
            "zh": "好一个",
            "narrator_zh": "雅"
        },
        {
            "location": "232/TALK",
            "narrator": "みやび",
            "text": "直球な",
            "zh": "直球啊",
            "narrator_zh": "雅"
        },
        {
            "location": "233/ACT",
            "narrator": "",
            "text": "なんとなく？",
            "zh": "就是感觉？",
            "narrator_zh": ""
        },
        {
            "location": "234/TALK",
            "narrator": "みやび",
            "text": "いや",
            "zh": "不对",
            "narrator_zh": "雅"
        },
        {
            "location": "236/TALK",
            "narrator": "みやび",
            "text": "適当すぎる",
            "zh": "太敷衍了吧",
            "narrator_zh": "雅"
        },
        {
            "location": "237/ACT",
            "narrator": "",
            "text": "案ずるより産むが易し",
            "zh": "与其空想，不如动手",
            "narrator_zh": ""
        },
        {
            "location": "238/TALK",
            "narrator": "みやび",
            "text": "まあ",
            "zh": "嗯",
            "narrator_zh": "雅"
        },
        {
            "location": "239/TALK",
            "narrator": "みやび",
            "text": "そういう考えもあるか",
            "zh": "也有这种想法啊",
            "narrator_zh": "雅"
        },
        {
            "location": "241/TALK",
            "narrator": "みやび",
            "text": "うーぬぬぬぬ",
            "zh": "唔——唔唔唔唔",
            "narrator_zh": "雅"
        },
        {
            "location": "247/TALK",
            "narrator": "みやび",
            "text": "どういう状態\nやったとしても。",
            "zh": "不管是什么样\n的状态。",
            "narrator_zh": "雅"
        },
        {
            "location": "249/TALK",
            "narrator": "みやび",
            "text": "$handle$は\n$handle$やし。",
            "zh": "$handle$就是\n$handle$嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "250/TALK",
            "narrator": "みやび",
            "text": "うちはうちや。",
            "zh": "我还是我咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "251/TALK",
            "narrator": "みやび",
            "text": "それにいつか\n直接会えるという\n可能性もある。",
            "zh": "而且也有哪天\n直接见面的\n可能性。",
            "narrator_zh": "雅"
        },
        {
            "location": "252/TALK",
            "narrator": "みやび",
            "text": "そうなっても\nチャットを続けるか？",
            "zh": "就算变成那样，\n还要继续聊咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "253/TALK",
            "narrator": "みやび",
            "text": "…いや、あまりにも\nシュールすぎるろう…。",
            "zh": "……不，这也\n太超现实了吧……。",
            "narrator_zh": "雅"
        },
        {
            "location": "254/TALK",
            "narrator": "みやび",
            "text": "…それはそれで\n少し楽しそうと\n思ったのは許せ。",
            "zh": "……觉得那好像\n也有点好玩，\n这点请原谅。",
            "narrator_zh": "雅"
        },
        {
            "location": "255/TALK",
            "narrator": "みやび",
            "text": "$handle$。\nうちは決めたぞね。",
            "zh": "$handle$。\n我下定决心咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "256/TALK",
            "narrator": "みやび",
            "text": "$handle$と\n式を挙げると。",
            "zh": "要是跟$handle$\n办婚礼的话。",
            "narrator_zh": "雅"
        },
        {
            "location": "257/SEL",
            "narrator": "",
            "text": "棚からぼた餅",
            "zh": "天上掉馅饼",
            "narrator_zh": ""
        },
        {
            "location": "258/SEL",
            "narrator": "",
            "text": "ひょうたんから駒",
            "zh": "歪打正着",
            "narrator_zh": ""
        },
        {
            "location": "259/SEL",
            "narrator": "",
            "text": "割れ鍋にとじぶた",
            "zh": "破锅配烂盖",
            "narrator_zh": ""
        },
        {
            "location": "260/ACT",
            "narrator": "",
            "text": "棚からぼた餅",
            "zh": "天上掉馅饼",
            "narrator_zh": ""
        },
        {
            "location": "262/TALK",
            "narrator": "みやび",
            "text": "あれ！？",
            "zh": "咦！？",
            "narrator_zh": "雅"
        },
        {
            "location": "263/TALK",
            "narrator": "みやび",
            "text": "その程度の\n話だったかね。",
            "zh": "原来只是这种程度的\n事嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "264/ACT",
            "narrator": "",
            "text": "ひょうたんから駒",
            "zh": "歪打正着",
            "narrator_zh": ""
        },
        {
            "location": "265/TALK",
            "narrator": "みやび",
            "text": "それはまたおめでたい\nような気がする。",
            "zh": "那又让人觉得很\n可喜可贺。",
            "narrator_zh": "雅"
        },
        {
            "location": "266/TALK",
            "narrator": "みやび",
            "text": "…で、いいんかね？",
            "zh": "……这样就好，得咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "267/ACT",
            "narrator": "",
            "text": "割れ鍋にとじぶた",
            "zh": "破锅配烂盖",
            "narrator_zh": ""
        },
        {
            "location": "268/TALK",
            "narrator": "みやび",
            "text": "その言い方は\nちっくと気に入らん。",
            "zh": "那种说法\n我有点不喜欢。",
            "narrator_zh": "雅"
        },
        {
            "location": "269/TALK",
            "narrator": "みやび",
            "text": "…ある意味現実的な\n表現かもしれんが。",
            "zh": "……某种意义上\n说不定还挺现实，就是。",
            "narrator_zh": "雅"
        },
        {
            "location": "271/TALK",
            "narrator": "みやび",
            "text": "とは言うたけんど。",
            "zh": "话是这么说，但是。",
            "narrator_zh": "雅"
        },
        {
            "location": "272/TALK",
            "narrator": "みやび",
            "text": "$handle$の\n等身大看板を\n作るわけにもいかんし。",
            "zh": "总不能给$handle$\n做个等身\n大看板咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "273/TALK",
            "narrator": "みやび",
            "text": "いや自動人形にすれば\n却って何も言われん\nかもしれんけんど。",
            "zh": "不，要是换成自动人偶，\n说不定反而没人\n会说三道四，但是。",
            "narrator_zh": "雅"
        },
        {
            "location": "274/SEL",
            "narrator": "",
            "text": "いやちょっと待って！",
            "zh": "等等等一下！",
            "narrator_zh": ""
        },
        {
            "location": "275/SEL",
            "narrator": "",
            "text": "脱線しすぎ",
            "zh": "跑题跑太远了",
            "narrator_zh": ""
        },
        {
            "location": "276/SEL",
            "narrator": "",
            "text": "怖いからそれ怖いから",
            "zh": "好可怕，那个好可怕",
            "narrator_zh": ""
        },
        {
            "location": "277/ACT",
            "narrator": "",
            "text": "いやちょっと待って！",
            "zh": "等等等一下！",
            "narrator_zh": ""
        },
        {
            "location": "278/TALK",
            "narrator": "みやび",
            "text": "やっぱり替え玉は\nいかんかねえ。",
            "zh": "果然找人顶替\n还是不行呐。",
            "narrator_zh": "雅"
        },
        {
            "location": "279/ACT",
            "narrator": "",
            "text": "脱線しすぎ",
            "zh": "跑题跑太远了",
            "narrator_zh": ""
        },
        {
            "location": "280/TALK",
            "narrator": "みやび",
            "text": "そういうわけでは\nないけんど。",
            "zh": "倒也不是\n那么回事，但是。",
            "narrator_zh": "雅"
        },
        {
            "location": "281/TALK",
            "narrator": "みやび",
            "text": "ちょっと面白そうやと\n思うてしもうたぞね。",
            "zh": "我稍微觉得\n好像挺有意思咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "282/ACT",
            "narrator": "",
            "text": "怖いからそれ怖いから",
            "zh": "好可怕，那个好可怕",
            "narrator_zh": ""
        },
        {
            "location": "283/TALK",
            "narrator": "みやび",
            "text": "そこがえいかと\n思うたけんど。",
            "zh": "我觉得那里不错，\n但是呢。",
            "narrator_zh": "雅"
        },
        {
            "location": "284/TALK",
            "narrator": "みやび",
            "text": "やっぱり\nサイコホラー路線は\nいかんかねえ。",
            "zh": "果然\n心理恐怖路线\n还是不行呐。",
            "narrator_zh": "雅"
        },
        {
            "location": "286/TALK",
            "narrator": "みやび",
            "text": "妥協案として\nこういうのは\nどうかいね？",
            "zh": "作为妥协案，\n这样的\n怎么样咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "287/TALK",
            "narrator": "みやび",
            "text": "日本には八百万の神が\nおると当時に\n付喪神という存在もある。",
            "zh": "日本有八百万神明\n坐镇，同时还有\n付丧神这种存在。",
            "narrator_zh": "雅"
        },
        {
            "location": "289/TALK",
            "narrator": "みやび",
            "text": "その懐の広さは\n祈願の類にも\n表れちゅう。",
            "zh": "那份宽厚也\n体现在祈愿之类的\n东西上咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "290/TALK",
            "narrator": "みやび",
            "text": "やき、これなら\n式が挙げられると\n思うんやけんど…。",
            "zh": "啵，这样一来\n我觉得倒是能\n办婚礼了……。",
            "narrator_zh": "雅"
        },
