            "narrator_zh": "雅"
        },
        {
            "location": "135/TALK",
            "narrator": "みやび",
            "text": "今までと違う\nコミュニケーション\n手段になっても。",
            "zh": "就算变成和以前\n不一样的沟通\n手段也一样。",
            "narrator_zh": "雅"
        },
        {
            "location": "136/SEL",
            "narrator": "",
            "text": "むしろうれしいし",
            "zh": "反而挺高兴的",
            "narrator_zh": ""
        },
        {
            "location": "137/SEL",
            "narrator": "",
            "text": "今までと\n変わらないでしょ",
            "zh": "跟以前\n没什么两样吧",
            "narrator_zh": ""
        },
        {
