{
    "dir": "chap24/daydra/dd_ch03_24_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "24352",
        "cid": "gabriella",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "大掃除デー",
        "title_zh": "Extra002 额外剧情",
        "sub_title_zh": "大扫除日"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "大掃除デー",
            "zh": "大扫除日",
            "narrator_zh": ""
        },
        {
            "location": "26/TALK",
            "narrator": "みやび",
            "text": "なるほどなぁ…。\nうちは気づかんかった\nけんど？",
            "zh": "原来如此啊……。\n我倒是没注意到\n不过……？",
            "narrator_zh": "雅"
        },
        {
            "location": "29/TALK",
            "narrator": "つばめ",
            "text": "えぇっ、本当ですか！？",
            "zh": "诶诶，真的吗！？",
            "narrator_zh": "燕"
        },
        {
            "location": "30/TALK",
            "narrator": "つばめ",
            "text": "わたし、帰ってきて\nすぐに気づきましたよ。",
            "zh": "我一回来\n就立刻注意到了哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "31/TALK",
            "narrator": "つばめ",
            "text": "みやびさんの部屋って、\nロボット掃除機とか\nありましたっけ？",
            "zh": "雅的房间里，\n是不是有扫地机器人\n之类的东西呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "33/TALK",
            "narrator": "みやび",
            "text": "あの部屋で動けるような\nロボット掃除機があれば、\n大発明ぞね。",
            "zh": "要是真有能在那间屋里\n跑得动的扫地机器人，\n那可真是大发明啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "36/TALK",
            "narrator": "ガブリエラ",
            "text": "楽しそうね。\n何盛り上がってたの？",
            "zh": "聊得好开心嘛。\n你们在兴奋什么呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "38/TALK",
            "narrator": "つばめ",
            "text": "あ、ガブちゃんは\n東京帰ってきたときに\n気づかなかった？",
            "zh": "啊，加布\n回东京的时候\n没注意到吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "39/TALK",
            "narrator": "つばめ",
            "text": "部屋の中が、なんとなく\n埃っぽいかも、って。",
            "zh": "就是觉得房间里，\n好像有点落灰了，这样。",
            "narrator_zh": "燕"
        },
        {
            "location": "40/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…そうなのよ。\n帰ってきてから\nずっと気になってたのよ。",
            "zh": "哈……是啊。\n回来以后\n我一直都在意着呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "41/TALK",
            "narrator": "つばめ",
            "text": "やっぱり？",
            "zh": "果然？",
            "narrator_zh": "燕"
        },
        {
            "location": "42/TALK",
            "narrator": "ガブリエラ",
            "text": "ええ。だから今日は、\n帰ったら部屋の掃除を\nするつもりよ。",
            "zh": "嗯。所以今天，\n我打算回去以后\n把房间打扫一下。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "45/TALK",
            "narrator": "みやび",
            "text": "換気するだけでえいやろ？",
            "zh": "只要通通风不就要得了？",
            "narrator_zh": "雅"
        },
        {
            "location": "48/TALK",
            "narrator": "ガブリエラ",
            "text": "それだけじゃ\n綺麗にならないでしょ？",
            "zh": "光那样\n怎么可能干净啊？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "49/TALK",
            "narrator": "ガブリエラ",
            "text": "第一、中途半端にしか\n掃除してないとこなんかで\n生活したくないし。",
            "zh": "再说了，我可不想\n在只打扫了一半的地方\n生活呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "51/TALK",
            "narrator": "みやび",
            "text": "ガブちゃんは偉いなぁ…。",
            "zh": "加布真是了不起啊……。",
            "narrator_zh": "雅"
        },
        {
            "location": "52/TALK",
            "narrator": "みやび",
            "text": "見習いはせんけんど、\n尊敬するぞね。",
            "zh": "虽然我不打算学，\n不过蛮敬佩你的啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "53/TALK",
            "narrator": "つばめ",
            "text": "じゃあ、ガブちゃんは\n帰ったら大掃除だね。",
            "zh": "那加布\n回去以后就要大扫除啦。",
            "narrator_zh": "燕"
        },
        {
            "location": "54/TALK",
            "narrator": "つばめ",
            "text": "わたしもお手伝いしに\n行くよ。",
            "zh": "我也过去\n给你搭把手吧。",
            "narrator_zh": "燕"
        },
        {
            "location": "57/TALK",
            "narrator": "ガブリエラ",
            "text": "いや、いいから。\n一人でできるし。",
            "zh": "不用了，没关系。\n我一个人就行。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "58/TALK",
            "narrator": "つばめ",
            "text": "でも、二人でやった方が\n早く終わるよ？",
            "zh": "可是，两个人一起弄\n会结束得更快哦？",
            "narrator_zh": "燕"
        },
        {
            "location": "60/TALK",
            "narrator": "ガブリエラ",
            "text": "いいの！\nバイト終わった後で\n夜になっちゃうし。",
            "zh": "不用啦！\n打工结束之后\n都已经是晚上了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "61/TALK",
            "narrator": "ガブリエラ",
            "text": "一人でやるから、\n絶対来ちゃダメよ？",
            "zh": "我自己一个人搞定，\n绝对不要过来哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "77/TALK",
            "narrator": "ガブリエラ",
            "text": "ただいまー。",
            "zh": "我回来了—。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "78/TALK",
            "narrator": "ガブリエラ",
            "text": "…さて、と。\n面倒になる前に、\nさっさと始めないと。",
            "zh": "……好，那么。\n趁着还没犯懒，\n赶紧动手吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "83/TALK",
            "narrator": "ガブリエラ",
            "text": "よし…、\nま、こんなもんかしら？",
            "zh": "好……，\n嗯，差不多就这样吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "84/TALK",
            "narrator": "ガブリエラ",
            "text": "さすがに、暗くなってから\nやるようなことじゃ\nなかったかしら？",
            "zh": "话说回来，这种事\n果然不太适合\n天黑了再做吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "85/TALK",
            "narrator": "ガブリエラ",
            "text": "雑巾掛けまでやったから、\nちょっと疲れたし…。",
            "zh": "连地板都用抹布擦了一遍，\n稍微有点累了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "86/TALK",
            "narrator": "ガブリエラ",
            "text": "…休憩しよう。",
            "zh": "……休息一下吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "87/TALK",
            "narrator": "ガブリエラ",
            "text": "ふぅ…。",
            "zh": "呼……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "101/TALK",
            "narrator": "ガブリエラ",
            "text": "あなたにも見えるかしら？",
            "zh": "你也能看得出来吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "102/TALK",
            "narrator": "ガブリエラ",
            "text": "今日は",
            "zh": "今天我",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "103/TALK",
            "narrator": "ガブリエラ",
            "text": "プチ大掃除をしたわ",
            "zh": "搞了次小规模大扫除哦",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "104/TALK",
            "narrator": "ガブリエラ",
            "text": "おかげで部屋がピカピカ",
            "zh": "多亏这个，房间亮晶晶的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "105/TALK",
            "narrator": "ガブリエラ",
            "text": "やっぱり生活空間は",
            "zh": "果然生活空间",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "106/TALK",
            "narrator": "ガブリエラ",
            "text": "これくらい綺麗でないとね",
            "zh": "就得这么干净才行呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "108/SEL",
            "narrator": "",
            "text": "お疲れさま",
            "zh": "辛苦啦",
            "narrator_zh": ""
        },
        {
            "location": "109/ACT",
            "narrator": "",
            "text": "お疲れさま",
            "zh": "辛苦啦",
            "narrator_zh": ""
        },
        {
            "location": "111/TALK",
            "narrator": "ガブリエラ",
            "text": "ありがと",
            "zh": "谢谢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "112/TALK",
            "narrator": "ガブリエラ",
            "text": "さすがに",
            "zh": "说真的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "114/TALK",
            "narrator": "ガブリエラ",
            "text": "一人でやるのは疲れた",
            "zh": "一个人弄还是挺累的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "115/TALK",
            "narrator": "ガブリエラ",
            "text": "$marzanna$が手伝ってくれたらよかったのに",
            "zh": "要是$marzanna$能来帮忙就好了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "116/TALK",
            "narrator": "ガブリエラ",
            "text": "なんてね",
            "zh": "开玩笑的啦",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "118/SEL",
            "narrator": "",
            "text": "誰かに手伝ってもらわなかったの？",
            "zh": "没找谁来帮忙吗？",
            "narrator_zh": ""
        },
        {
            "location": "119/SEL",
            "narrator": "",
            "text": "いいお嫁さんになるよ",
            "zh": "会成为好新娘哦",
            "narrator_zh": ""
        },
        {
            "location": "120/ACT",
            "narrator": "",
            "text": "誰かに手伝ってもらわなかったの？",
            "zh": "没找谁来帮忙吗？",
            "narrator_zh": ""
        },
        {
            "location": "121/TALK",
            "narrator": "ガブリエラ",
            "text": "つばめが手伝うって言ってくれたけど",
            "zh": "燕说过要来帮忙的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "122/TALK",
            "narrator": "ガブリエラ",
            "text": "断ったの",
            "zh": "被我拒绝了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "123/TALK",
            "narrator": "ガブリエラ",
            "text": "$marzanna$には言ったかしら？",
            "zh": "我有跟$marzanna$说过吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "124/TALK",
            "narrator": "ガブリエラ",
            "text": "私ね",
            "zh": "我呀",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "125/TALK",
            "narrator": "ガブリエラ",
            "text": "部屋に入られるのって",
            "zh": "被人进到房间里",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "126/TALK",
            "narrator": "ガブリエラ",
            "text": "あまり好きじゃないのよ",
            "zh": "不太喜欢呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "129/TALK",
            "narrator": "ガブリエラ",
            "text": "絶対ダメってことじゃないの",
            "zh": "倒也不是绝对不行啦",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "130/TALK",
            "narrator": "ガブリエラ",
            "text": "でも部屋って",
            "zh": "不过房间毕竟是",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "131/TALK",
            "narrator": "ガブリエラ",
            "text": "プライベートな空間だし",
            "zh": "私人空间嘛",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "132/TALK",
            "narrator": "ガブリエラ",
            "text": "それに",
            "zh": "而且",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "133/TALK",
            "narrator": "ガブリエラ",
            "text": "可愛い系の小物とか人形とか",
            "zh": "还有些可爱系的小物件啊玩偶什么的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "134/TALK",
            "narrator": "ガブリエラ",
            "text": "そういうのもあるから",
            "zh": "也有那种东西在",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "136/TALK",
            "narrator": "ガブリエラ",
            "text": "見られるの恥ずかしいし/////",
            "zh": "被人看见怪不好意思的/////",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "139/TALK",
            "narrator": "ガブリエラ",
            "text": "普段みんなの前で",
            "zh": "平时在大家面前",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "140/TALK",
            "narrator": "ガブリエラ",
            "text": "そういうの",
            "zh": "那种东西",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "141/TALK",
            "narrator": "ガブリエラ",
            "text": "見せないから//////",
            "zh": "我都不会拿出来看的//////",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "143/SEL",
            "narrator": "",
            "text": "みんな知ってると思うよ？",
            "zh": "我觉得大家应该都知道哦？",
            "narrator_zh": ""
        },
        {
            "location": "144/ACT",
            "narrator": "",
            "text": "みんな知ってると思うよ？",
            "zh": "我觉得大家应该都知道哦？",
            "narrator_zh": ""
        },
        {
            "location": "147/TALK",
            "narrator": "ガブリエラ",
            "text": "そりゃそうよ",
            "zh": "那倒是啦",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "148/TALK",
            "narrator": "ガブリエラ",
            "text": "みんな",
            "zh": "大家",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "149/TALK",
            "narrator": "ガブリエラ",
            "text": "一度は部屋に来たことあるし",
            "zh": "好歹都来过房间一次嘛",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "150/TALK",
            "narrator": "ガブリエラ",
            "text": "でも",
            "zh": "可是",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "151/TALK",
            "narrator": "ガブリエラ",
            "text": "可愛いものが増えるたびに",
            "zh": "每当可爱的东西多起来",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "152/TALK",
            "narrator": "ガブリエラ",
            "text": "何も言われなくても",
            "zh": "就算嘴上什么都不说",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "153/TALK",
            "narrator": "ガブリエラ",
            "text": "思われるかもしれない",
            "zh": "说不定也会这么想",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "154/TALK",
            "narrator": "ガブリエラ",
            "text": "こんな趣味あるんだ",
            "zh": "原来她有这种爱好啊",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "155/TALK",
            "narrator": "ガブリエラ",
            "text": "とか",
            "zh": "之类的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "156/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょっと似合わないかも",
            "zh": "感觉有点不太搭呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "157/TALK",
            "narrator": "ガブリエラ",
            "text": "とか",
            "zh": "之类的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "158/TALK",
            "narrator": "ガブリエラ",
            "text": "それが不安で",
            "zh": "就是因为不安这个",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "159/TALK",
            "narrator": "ガブリエラ",
            "text": "部屋にあげたくないの",
            "zh": "才不想让别人进房间",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "161/SEL",
            "narrator": "",
            "text": "意外かも",
            "zh": "感觉挺意外的",
            "narrator_zh": ""
        },
        {
            "location": "162/SEL",
            "narrator": "",
            "text": "それは仕方ないと思う",
            "zh": "我觉得这也没办法",
            "narrator_zh": ""
        },
        {
            "location": "163/ACT",
            "narrator": "",
            "text": "意外かも",
            "zh": "感觉挺意外的",
            "narrator_zh": ""
        },
        {
            "location": "164/TALK",
            "narrator": "ガブリエラ",
            "text": "そう？",
            "zh": "是吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "165/TALK",
            "narrator": "ガブリエラ",
            "text": "まあ",
            "zh": "嘛",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "166/TALK",
            "narrator": "ガブリエラ",
            "text": "誰にも話したことないし",
            "zh": "毕竟我也没跟谁说过嘛",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "167/TALK",
            "narrator": "ガブリエラ",
            "text": "$marzanna$にだけ",
            "zh": "只告诉$marzanna$哦",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "169/TALK",
            "narrator": "ガブリエラ",
            "text": "特別よ",
            "zh": "特别待遇啦",
            "narrator_zh": "加布里埃拉"
        },
        {
