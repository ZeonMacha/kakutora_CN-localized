  {
   "location": "1127/TALK",
   "narrator": "神楽",
   "text": "私ああいうのほんとクズだなって思うのね"
  },
  {
   "location": "1129/SEL",
   "narrator": "",
   "text": "あれむかつくよね！",
   "zh": "那个很气人吧！",
