        },
        {
            "location": "1175/TALK",
            "narrator": "神楽",
            "text": "それに牙を剥くようなら私はあなたをメチャクチャに壊して別れる",
            "zh": "而且要是敢露牙齿，我就把你彻底毁掉再分手",
            "narrator_zh": "神乐"
        },
        {
            "location": "1176/TALK",
            "narrator": "神楽",
            "text": "それくらいの覚悟で、あなたに心を許してるから",
            "zh": "我就是抱着那种觉悟，才对你敞开心扉的",
            "narrator_zh": "神乐"
        },
        {
            "location": "1178/SEL",
            "narrator": "",
            "text": "わかった",
            "zh": "知道了",
            "narrator_zh": ""
        },
        {
            "location": "1179/ACT",
            "narrator": "",
            "text": "わかった",
            "zh": "知道了",
            "narrator_zh": ""
        },
        {
            "location": "1182/TALK",
            "narrator": "神楽",
            "text": "ぴょん",
            "zh": "pyon",
            "narrator_zh": "神乐"
        },
        {
            "location": "1183/TALK",
            "narrator": "神楽",
            "text": "じゃあ",
            "zh": "那么",
            "narrator_zh": "神乐"
        },
        {
