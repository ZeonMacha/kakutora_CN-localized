{
    "dir": "chap17/daydra/dd_ch01_17_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "17152",
        "cid": "tsubame",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "先生の不安",
        "title_zh": "Extra002 额外剧情",
        "sub_title_zh": "老师的不安"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "先生の不安",
            "zh": "老师的不安",
            "narrator_zh": ""
        },
        {
            "location": "30/TALK",
            "narrator": "珠緒先生",
            "text": "逢瀬さん…\nお仕事の方はどう？",
            "zh": "逢濑……\n工作那边怎么样？",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "32/TALK",
            "narrator": "つばめ",
            "text": "仕事っていうと…\n特別攻撃隊のことですか？",
            "zh": "说工作的话……\n是特别攻击队的事吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "33/TALK",
            "narrator": "珠緒先生",
            "text": "ええ…上手くいってる？\n困ったこととかはない？",
            "zh": "嗯……顺利吗？\n没有什么为难的事？",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "35/TALK",
            "narrator": "つばめ",
            "text": "はい、大丈夫です。\n先輩の皆さんはもちろん、\n真幌さんも優しいですし。",
            "zh": "是的，没事。\n前辈们当然不用说，\n真幌也很温柔。",
            "narrator_zh": "燕"
        },
        {
            "location": "37/TALK",
            "narrator": "珠緒先生",
            "text": "そう…。",
            "zh": "这样啊……。",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "38/TALK",
            "narrator": "つばめ",
            "text": "…先生？",
            "zh": "……老师？",
            "narrator_zh": "燕"
        },
        {
            "location": "40/TALK",
            "narrator": "珠緒先生",
            "text": "ごめんなさい。\nどうしても、\n心配になっちゃうの。",
            "zh": "对不起。\n我总是\n会担心。",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "41/TALK",
            "narrator": "珠緒先生",
            "text": "逢瀬さんって、あんまり\n特別攻撃隊に向いてる\n性格に思えないから――",
            "zh": "逢濑，总觉得\n你的性格不太适合\n特别攻击队——",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "42/TALK",
            "narrator": "珠緒先生",
            "text": "ちゃんとやれてるの\nかな、って…。",
            "zh": "能不能做好，\n之类的……。",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "45/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "47/TALK",
            "narrator": "珠緒先生",
            "text": "相談したいこととか\nあるんじゃないかな、\nって思ったんだけど――",
            "zh": "我还想着，\n你会不会有\n想商量的事——",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "48/TALK",
            "narrator": "珠緒先生",
            "text": "私の考え過ぎだった\nみたいね。",
            "zh": "看来是我\n想多了。",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "49/SEL",
            "narrator": "",
            "text": "相談してみれば？",
            "zh": "要不要跟她说说？",
            "narrator_zh": ""
        },
        {
            "location": "50/SEL",
            "narrator": "",
            "text": "弱音を見せるな！",
            "zh": "别示弱！",
            "narrator_zh": ""
        },
        {
            "location": "53/TALK",
            "narrator": "つばめ",
            "text": "…話、聞いてもらおう\nかな？",
            "zh": "……要不要\n说给她听？",
            "narrator_zh": "燕"
        },
        {
            "location": "54/TALK",
            "narrator": "つばめ",
            "text": "でも、お仕事をやるのに\n自信がないなんて\n言ったら――",
            "zh": "可是，要是说\n做这份工作\n没有自信——",
            "narrator_zh": "燕"
        },
        {
            "location": "56/TALK",
            "narrator": "つばめ",
            "text": "今以上に心配かけちゃい\nそうだし…。",
            "zh": "只会让她\n更担心……。",
            "narrator_zh": "燕"
        },
        {
            "location": "59/TALK",
            "narrator": "つばめ",
            "text": "大丈夫ですよ、先生。",
            "zh": "没关系的，老师。",
            "narrator_zh": "燕"
        },
        {
            "location": "60/TALK",
            "narrator": "つばめ",
            "text": "わたし一人だったら、\n多分平気じゃないと\n思うけど――",
            "zh": "要是只有我一个人，\n我想大概\n不会没事——",
            "narrator_zh": "燕"
        },
        {
            "location": "61/TALK",
            "narrator": "つばめ",
            "text": "わたしよりも、うんと\n頼りになる先輩方がいて\nくれるから――",
            "zh": "有比我\n可靠得多的前辈\n在——",
            "narrator_zh": "燕"
        },
        {
            "location": "62/TALK",
            "narrator": "つばめ",
            "text": "本当に平気なんです。",
            "zh": "真的没事。",
            "narrator_zh": "燕"
        },
        {
            "location": "64/TALK",
            "narrator": "珠緒先生",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "65/TALK",
            "narrator": "珠緒先生",
            "text": "やっぱり、私が心配性\n過ぎただけみたい。",
            "zh": "果然，只是我\n太爱操心了。",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "66/TALK",
            "narrator": "珠緒先生",
            "text": "ごめんなさいね。\n変なこと言っちゃって…。",
            "zh": "对不起。\n说了奇怪的话……。",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "68/TALK",
            "narrator": "つばめ",
            "text": "いえ、そんなこと\nないです。",
            "zh": "没有，\n不是那样。",
            "narrator_zh": "燕"
        },
        {
            "location": "69/TALK",
            "narrator": "つばめ",
            "text": "先生に、そんなふうに\n心配してもらえてるのが\nわかって――",
            "zh": "知道老师\n是这么\n担心我的——",
            "narrator_zh": "燕"
        },
        {
            "location": "71/TALK",
            "narrator": "つばめ",
            "text": "すごく嬉しかったです。",
            "zh": "我非常高兴。",
            "narrator_zh": "燕"
        },
        {
            "location": "72/TALK",
            "narrator": "珠緒先生",
            "text": "当然でしょ？",
            "zh": "那不是当然的吗？",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "73/TALK",
            "narrator": "珠緒先生",
            "text": "特別攻撃隊だろうが\n何だろうが、大切な生徒に\n代わりはないもの。",
            "zh": "不管是特别攻击队\n还是别的什么，重要的学生\n都没有替代。",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "74/TALK",
            "narrator": "珠緒先生",
            "text": "だから、今更だけど、\n本当に気を付けてね。",
            "zh": "所以，虽然晚了，\n真的要小心。",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "78/TALK",
            "narrator": "つばめ",
            "text": "…先生、わたしのこと、\nそんなに心配してくれて\nたんだ…。",
            "zh": "……老师，原来\n这么担心\n我……。",
            "narrator_zh": "燕"
        },
        {
            "location": "79/TALK",
            "narrator": "つばめ",
            "text": "今まで以上に、気を引き\n締めて戦わないと。",
            "zh": "得比以前\n更打起精神去战斗。",
            "narrator_zh": "燕"
        },
        {
            "location": "80/TALK",
            "narrator": "つばめ",
            "text": "あんな優しい先生を\n悲しませるなんて、\n絶対しちゃダメだよね。",
            "zh": "让那么温柔的老师\n伤心，\n绝对不行。",
            "narrator_zh": "燕"
        },
        {
            "location": "82/ACT",
            "narrator": "",
            "text": "相談してみれば？",
            "zh": "要不要跟她说说？",
            "narrator_zh": ""
        },
        {
            "location": "89/TALK",
            "narrator": "珠緒先生",
            "text": "携帯、確認した方が\nいいんじゃない？",
            "zh": "手机，是不是\n该看一下？",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "90/TALK",
            "narrator": "珠緒先生",
            "text": "お仕事のことかも\nしれないんだから、\n優先しないとダメよ。",
            "zh": "也许是工作的事，\n得优先处理\n才行。",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "94/TALK",
            "narrator": "つばめ",
            "text": "は、はい…。",
            "zh": "是、是……。",
            "narrator_zh": "燕"
        },
        {
            "location": "111/TALK",
            "narrator": "つばめ",
            "text": "やっぱり、相談してみようかな？",
            "zh": "果然，还是跟她说说吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "112/TALK",
            "narrator": "つばめ",
            "text": "ちょっと、真幌さん達には相談し辛いことだし",
            "zh": "跟真幌他们有点说不出口",
            "narrator_zh": "燕"
        },
        {
            "location": "126/TALK",
            "narrator": "つばめ",
            "text": "すみません。\n何でもありませんでした。",
            "zh": "抱歉。\n没什么事。",
            "narrator_zh": "燕"
        },
        {
            "location": "127/TALK",
            "narrator": "つばめ",
            "text": "それで…その、ちょっと\n相談っていうか――",
            "zh": "那个……其实，\n与其说商量——",
            "narrator_zh": "燕"
        },
        {
            "location": "128/TALK",
            "narrator": "つばめ",
            "text": "アドバイスがもらえたら\n嬉しいな、ってことが\nあって…。",
            "zh": "有件事，\n要是能得到建议\n就好了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "129/TALK",
            "narrator": "珠緒先生",
            "text": "私で力になれるならね。\n話してもらえる？",
            "zh": "要是我帮得上的话。\n愿意说吗？",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "134/TALK",
            "narrator": "つばめ",
            "text": "…実は、ちょっとだけ\n不安なんです。",
            "zh": "……其实，我有一点\n不安。",
            "narrator_zh": "燕"
        },
        {
            "location": "135/TALK",
            "narrator": "つばめ",
            "text": "このままみんなと一緒に、\nトライナリーとして\nやっていけるのかが…。",
            "zh": "这样下去，\n能不能跟大家一起\n做三重奏……。",
            "narrator_zh": "燕"
        },
        {
            "location": "136/TALK",
            "narrator": "つばめ",
            "text": "わたしはみんなみたいに、\n特技とか持ってないし――",
            "zh": "我不像大家，\n没有什么特长——",
            "narrator_zh": "燕"
        },
        {
            "location": "137/TALK",
            "narrator": "つばめ",
            "text": "あんまり、役に立ててる\nような気がしなくて…。",
            "zh": "总觉得，自己\n没帮上多少忙……。",
            "narrator_zh": "燕"
        },
        {
            "location": "139/TALK",
            "narrator": "珠緒先生",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "142/TALK",
            "narrator": "つばめ",
            "text": "こんなこと言われても、\n困っちゃいますよね？",
            "zh": "听我说这些，\n会为难吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "144/TALK",
            "narrator": "珠緒先生",
            "text": "ううん、聞いたのは\n私なんだから。",
            "zh": "不会，是我\n要听的。",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "145/TALK",
            "narrator": "珠緒先生",
            "text": "でも、私の力じゃ\nどうすることもできない\n問題みたい。",
            "zh": "不过，以我的力量\n好像怎样都\n解决不了。",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "147/TALK",
            "narrator": "珠緒先生",
            "text": "力になれそうになくて、\nごめんなさいね。",
            "zh": "帮不上忙，\n对不起。",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "151/TALK",
            "narrator": "つばめ",
            "text": "いえ、そんな…。",
            "zh": "没有，哪有……。",
            "narrator_zh": "燕"
        },
        {
            "location": "153/TALK",
            "narrator": "珠緒先生",
            "text": "…でも、ちょっとだけ\n安心したわ。",
            "zh": "……不过，稍微\n放心了。",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "154/TALK",
            "narrator": "珠緒先生",
            "text": "逢瀬さんって、普段から\n明るくて元気な姿しか\n見せないから――",
            "zh": "逢濑平时\n只让人看到\n开朗有精神的样子——",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "155/TALK",
            "narrator": "珠緒先生",
            "text": "お仕事に対する不安とか、\n抱えてないのかと思って\n少し怖かったの。",
            "zh": "我还以为你\n对工作没有不安，\n有点害怕。",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "156/TALK",
            "narrator": "つばめ",
            "text": "怖い…ですか？",
            "zh": "害怕……吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "157/TALK",
            "narrator": "珠緒先生",
            "text": "あなたはまだ高校生なの。\n大人に近くはあるけど、\nまだまだ子供よ？",
            "zh": "你还是高中生。\n虽然已经接近大人了，\n但还是个孩子哦？",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "158/TALK",
            "narrator": "珠緒先生",
            "text": "子供が急に命がけの\n戦いに参加することに\nなったのに――",
            "zh": "孩子突然\n就要参加\n拼命的战斗——",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "159/TALK",
            "narrator": "珠緒先生",
            "text": "それに対して何の不安も\n感じてなかったとしたら、\nちょっと異常でしょ？",
            "zh": "要是对此\n一点不安都没有，\n有点不正常吧？",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "160/TALK",
            "narrator": "つばめ",
            "text": "…そうですね。\n自分でも、そんな風には\nなりたくないです。",
            "zh": "……是的。\n我自己也不想\n变成那样。",
            "narrator_zh": "燕"
        },
        {
            "location": "161/TALK",
            "narrator": "珠緒先生",
            "text": "そう思えるなら、\n逢瀬さんは平気よ。",
            "zh": "能这么想的话，\n逢濑就没事。",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "162/TALK",
            "narrator": "珠緒先生",
            "text": "私には、あなたの不安や\n不満を解決できる力は\nないかもしれないけど――",
            "zh": "你的不安和不满，\n我也许没有力量\n帮你解决——",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "163/TALK",
            "narrator": "珠緒先生",
            "text": "話を聞いたりするくらいは\nできるから…先生のことも\n頼ってほしいな。",
            "zh": "听你说话\n还是做得到的……\n也依靠一下老师吧。",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "166/TALK",
            "narrator": "つばめ",
            "text": "…ありがとうございます。\n凄く嬉しいです。",
            "zh": "……谢谢。\n我非常高兴。",
            "narrator_zh": "燕"
        },
        {
            "location": "167/TALK",
            "narrator": "つばめ",
            "text": "弱音とかって、どうしても\n真幌さん達には言えない\nから――",
            "zh": "示弱的话，\n怎么也没法\n对真幌他们说——",
            "narrator_zh": "燕"
        },
        {
            "location": "168/TALK",
            "narrator": "つばめ",
            "text": "そういう話とかでも、\n聞いてもらえますか？",
            "zh": "这种话，\n也可以说给你听吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "170/TALK",
            "narrator": "珠緒先生",
            "text": "ええ、もちろん。",
            "zh": "嗯，当然。",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "171/TALK",
            "narrator": "珠緒先生",
            "text": "逢瀬さんの気持ちが、\n少しでもラクになる\n手伝いができるなら――",
            "zh": "要是能让逢濑的心情\n轻松哪怕一点，\n我帮得上的话——",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "172/TALK",
            "narrator": "珠緒先生",
            "text": "いつでも相談に来てね。\n遠慮なんかしたらダメよ？",
            "zh": "随时来找我商量。\n不许客气哦？",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "189/ACT",
            "narrator": "",
            "text": "弱音を見せるな！",
            "zh": "别示弱！",
            "narrator_zh": ""
        },
        {
            "location": "195/TALK",
            "narrator": "珠緒先生",
            "text": "携帯、確認した方が\nいいんじゃない？",
            "zh": "手机，是不是\n该看一下？",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "196/TALK",
            "narrator": "珠緒先生",
            "text": "お仕事のことかも\nしれないんだから、\n優先しないとダメよ。",
            "zh": "也许是工作的事，\n得优先处理\n才行。",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "200/TALK",
            "narrator": "つばめ",
            "text": "は、はい…。",
            "zh": "是、是……。",
            "narrator_zh": "燕"
        },
        {
            "location": "217/TALK",
            "narrator": "つばめ",
            "text": "そうだね",
            "zh": "是啊",
            "narrator_zh": "燕"
        },
        {
            "location": "218/TALK",
            "narrator": "つばめ",
            "text": "わたしが弱音を見せたら、不安にさせちゃうと思うし",
            "zh": "我要是示弱，会让她不安的",
            "narrator_zh": "燕"
        },
        {
            "location": "233/TALK",
            "narrator": "つばめ",
            "text": "すみません。\n何でもありませんでした。",
            "zh": "抱歉。\n没什么事。",
            "narrator_zh": "燕"
        },
        {
            "location": "235/TALK",
            "narrator": "つばめ",
            "text": "お仕事、ちょっとだけ\n不安なことはあるけど――",
            "zh": "工作上，是有一点\n不安——",
            "narrator_zh": "燕"
        },
        {
            "location": "237/TALK",
            "narrator": "つばめ",
            "text": "でも、大丈夫です。\nどうにか皆さんについて\nいけてますし――",
            "zh": "不过，没关系。\n我好歹还能\n跟上大家——",
            "narrator_zh": "燕"
        },
        {
            "location": "238/TALK",
            "narrator": "つばめ",
            "text": "もう少し経験を積めば、\n慣れて普通に感じられると\n思いますから。",
            "zh": "再积累一点经验，\n我想就能习惯，\n觉得平常了。",
            "narrator_zh": "燕"
        },
        {
            "location": "241/TALK",
            "narrator": "珠緒先生",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "243/TALK",
            "narrator": "珠緒先生",
            "text": "逢瀬さん…それはあまり\n大丈夫とは言えないわ。",
            "zh": "逢濑……这可\n说不上没关系。",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "245/TALK",
            "narrator": "つばめ",
            "text": "…どうしてですか？",
            "zh": "……为什么？",
            "narrator_zh": "燕"
        },
        {
            "location": "248/TALK",
            "narrator": "珠緒先生",
            "text": "…この学園は、逢瀬さん\nみたいな特別攻撃隊の\n人達だけじゃなくて――",
            "zh": "……这所学园，不只\n有逢濑这样的\n特别攻击队——",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "249/TALK",
            "narrator": "珠緒先生",
            "text": "将来的に通常攻撃隊に\n所属する子達の養成科も\nあるから――",
            "zh": "还有将来会进入\n通常攻击队的\n培训科——",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "250/TALK",
            "narrator": "珠緒先生",
            "text": "時々現場にも行くし、\nそれに慣れてしまうのは\n当然だとは思うの。",
            "zh": "有时也会去现场，\n对此习惯掉，\n我想是当然的。",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "252/TALK",
            "narrator": "珠緒先生",
            "text": "けど…あなた達はまだ、\n高校生なのよ？",
            "zh": "可是……你们\n还是高中生哦？",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "253/TALK",
            "narrator": "珠緒先生",
            "text": "それなのに、こんな状況に\n慣れるなんていうのは、\n普通とは言えないわ。",
            "zh": "即便如此，习惯\n这种状况，\n不能说是正常。",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "255/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "257/TALK",
            "narrator": "珠緒先生",
            "text": "フェノメノンが普通の\n人達より、身近な物に\nなるのは仕方ないけど――",
            "zh": "PhenoMENON比普通人\n离你们更近，\n这也没办法——",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "258/TALK",
            "narrator": "珠緒先生",
            "text": "慣れてはほしくないの。\nあれは普通じゃない、\n異常なことなんだから。",
            "zh": "但我不希望你们习惯。\n那不是普通的事，\n是异常。",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "259/TALK",
            "narrator": "つばめ",
            "text": "…そうですよね。\n先生の言うとおりだと\n思います。",
            "zh": "……是啊。\n我觉得老师\n说得对。",
            "narrator_zh": "燕"
        },
        {
            "location": "260/TALK",
            "narrator": "つばめ",
            "text": "わたしも、ちょっと前まで\n戦いとは無縁の生活を\nしてたんだから――",
            "zh": "我自己，直到不久前\n过的也是跟战斗\n无关的生活——",
            "narrator_zh": "燕"
        },
        {
            "location": "261/TALK",
            "narrator": "つばめ",
            "text": "こんなすぐ慣れちゃう方が\n異常なんですよね？",
            "zh": "这么快就习惯，\n才不正常吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "263/TALK",
            "narrator": "珠緒先生",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "264/TALK",
            "narrator": "珠緒先生",
            "text": "…ごめんなさい。\n私のワガママだったわ。",
            "zh": "……对不起。\n是我任性了。",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "266/TALK",
            "narrator": "珠緒先生",
            "text": "何を言ったところで、\n私が逢瀬さんの代わりに\n戦うことはできないし――",
            "zh": "不管我说什么，\n也不能代替逢濑\n去战斗——",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "267/TALK",
            "narrator": "珠緒先生",
            "text": "結局、あなた達を\n頼らなきゃ\nいけないんだもの。",
            "zh": "到头来，\n还是得\n依靠你们。",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "269/TALK",
            "narrator": "つばめ",
            "text": "…ワガママなんかじゃ\nないです。",
            "zh": "……这不是\n任性。",
            "narrator_zh": "燕"
        },
        {
            "location": "270/TALK",
            "narrator": "つばめ",
            "text": "先生の言ってること、\n正しいと思います。",
            "zh": "老师说的，\n我觉得是对的。",
            "narrator_zh": "燕"
        },
        {
            "location": "272/TALK",
            "narrator": "珠緒先生",
            "text": "…ありがと。",
            "zh": "……谢谢。",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "274/TALK",
            "narrator": "珠緒先生",
            "text": "ごめんなさいね。\n話を聞くつもりが、逆に\n困らせちゃったみたいで。",
            "zh": "对不起。\n本来想听你说，\n结果倒让你为难了。",
            "narrator_zh": "珠绪老师"
        },
        {
            "location": "281/TALK",
            "narrator": "つばめ",
            "text": "…なんだか、大切なことを\n思い出した気がするな。",
            "zh": "……总觉得，想起了\n一件重要的事。",
            "narrator_zh": "燕"
        },
        {
            "location": "282/TALK",
            "narrator": "つばめ",
            "text": "先生の言った通り、\n慣れ過ぎないように\n気を付けなきゃ…。",
            "zh": "就像老师说的，\n得注意\n别习惯过头……。",
            "narrator_zh": "燕"
        },
        {
            "location": "15/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>7月19日　10:02 PM</color>\nとある平日、２時間目終了後の\n休み時間のこと。",
            "zh": "<color=green>7月19日　10:02 PM</color>\n某个工作日，第2节课结束后，\n是休息时间。",
            "narrator_zh": "Dialog_EventData"
        },
        {
            "location": "183/DIALOG",
            "narrator": "Dialog_GEThimegoto_ch01",
            "text": "【見ていてくれる？】",
            "zh": "【你会看着我吗？】",
            "narrator_zh": "Dialog_GEThimegoto_ch01"
        }
    ]
}
