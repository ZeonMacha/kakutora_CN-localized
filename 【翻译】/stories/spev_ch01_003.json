            "narrator": "透明神楽",
            "text": "お化けに連れて\nいかれちゃいますよ？",
            "zh": "会被鬼\n拐走的哦？",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "160/TALK",
            "narrator": "透明つばめ",
            "text": "や、やめてよぉ！\nそういう怖いこと\n言うの…。",
            "zh": "别、别这样呀！\n别说那种\n可怕的话……",
            "narrator_zh": "透明燕"
        },
        {
            "location": "162/TALK",
            "narrator": "透明神楽",
            "text": "でも、つばめさんは\n可愛いから、\n意外と本当に――",
            "zh": "可是，燕\n这么可爱，\n说不定真的会——",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "168/TALK",
            "narrator": "透明つばめ",
            "text": "キャァァァーッ！！",
            "zh": "呀啊啊啊——！！",
            "narrator_zh": "透明燕"
        },
        {
            "location": "169/TALK",
            "narrator": "透明つばめ",
            "text": "う、卯月さぁん…。\nわたし…わたし、\nやっぱりもぅ…。",
            "zh": "卯、卯月……\n我……我，\n还是已经……",
            "narrator_zh": "透明燕"
        },
        {
            "location": "170/TALK",
            "narrator": "透明神楽",
            "text": "つ、つばめさん。\nそんなに恐がったら\n可愛過ぎて――",
            "zh": "燕、燕。\n怕成这样，\n也太可爱了——",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "174/TALK",
            "narrator": "幽霊",
            "text": "あ゛あ゛あ゛あ゛！！\nうぅらぁめぇしぃ\nやぁぁぁぁ…。",
            "zh": "啊啊啊啊！！\n好怨啊啊\n啊啊啊……",
            "narrator_zh": "幽灵"
        },
        {
            "location": "176/TALK",
            "narrator": "透明つばめ",
            "text": "んぴっ！？",
            "zh": "嗯噼！？",
            "narrator_zh": "透明燕"
        },
        {
            "location": "178/TALK",
            "narrator": "透明神楽",
            "text": "ま、またそんな\n可愛い声を！！",
            "zh": "居、居然又发出\n这么可爱的声音！！",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "179/TALK",
            "narrator": "透明つばめ",
            "text": "も、もうダメェ…！\n卯月さん、早く、\n早く出ようよぉ…！",
            "zh": "不、不行了……！\n卯月，快点，\n快点出去呀……！",
            "narrator_zh": "透明燕"
        },
        {
            "location": "181/TALK",
            "narrator": "透明神楽",
            "text": "ま、まあまあ、\n落ち着いてください。",
            "zh": "好、好了好了，\n冷静一点。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "182/TALK",
            "narrator": "透明神楽",
            "text": "そんな可愛い声で\n怯えていたら――",
            "zh": "用这么可爱的声音\n害怕的话——",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "183/TALK",
            "narrator": "透明神楽",
            "text": "魅了されたお化け\nさん達が集まって\nきちゃいますよ？",
            "zh": "被魅惑到的鬼们\n会聚过来\n的哦？",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "185/TALK",
            "narrator": "透明つばめ",
            "text": "魅了って何！？\n意味わからないよ！",
            "zh": "魅惑是什么！？\n我听不懂呀！",
            "narrator_zh": "透明燕"
        },
        {
            "location": "186/TALK",
            "narrator": "透明神楽",
            "text": "大丈夫です。\n私はわかりますから！",
            "zh": "没事的。\n我听得懂！",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "189/TALK",
            "narrator": "透明つばめ",
            "text": "もぉ、お願いだから\n出口に急ごうよぉ！",
            "zh": "真是的，求你了\n快去出口呀！",
            "narrator_zh": "透明燕"
        }
    ]
}
