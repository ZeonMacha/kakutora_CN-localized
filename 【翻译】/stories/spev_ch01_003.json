    "info": {
        "story_id": "1003",
        "cid": "",
        "title": "スペシャルエピソード",
        "sub_title": "恐怖と魅了のお化け屋敷",
        "title_zh": "特别篇",
        "sub_title_zh": "恐惧与魅惑的鬼屋"
    },
    "entry": [
        {
            "location": "25/TALK",
            "narrator": "透明つばめ",
            "text": "う、卯月さん！\n歩くの早いよぉ！",
            "zh": "卯、卯月！\n走那么快呀！",
            "narrator_zh": "透明燕"
        },
        {
            "location": "26/TALK",
            "narrator": "透明神楽",
            "text": "大丈夫ですよ。\n置いていったりは\nしませんから。",
            "zh": "没事的。\n我不会把你\n丢下的。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "28/TALK",
            "narrator": "透明神楽",
            "text": "それにしても、\n随分本格的な\nお化け屋敷ですね。",
            "zh": "话说回来，\n这座鬼屋\n还挺像样的。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "30/TALK",
            "narrator": "透明神楽",
            "text": "あそこの人形とか、\nちょっと迫力あり過ぎ\nだと思いませんか？",
            "zh": "那边的人偶，\n是不是有点\n太有魄力了？",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "32/TALK",
            "narrator": "透明つばめ",
            "text": "や、ヤダよ！\nわたし見ないから！",
            "zh": "不、不要！\n我不看！",
            "narrator_zh": "透明燕"
        },
        {
            "location": "33/TALK",
            "narrator": "透明神楽",
            "text": "せっかく入ったのに\n見ないなんて、\n勿体ないですよ。",
            "zh": "好不容易进来了\n却不看，\n太可惜了。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "34/TALK",
            "narrator": "透明つばめ",
            "text": "で、でも、\n凄く怖いし…。",
            "zh": "可、可是，\n真的很可怕……",
            "narrator_zh": "透明燕"
        },
        {
            "location": "35/TALK",
            "narrator": "透明神楽",
            "text": "怖いのが出てきたら\n教えてあげますね。",
            "zh": "有可怕的东西出来，\n我会告诉你的。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "36/TALK",
            "narrator": "透明つばめ",
            "text": "教えられなくても\n見えちゃうよ！",
            "zh": "就算不告诉我\n也会看见的！",
            "narrator_zh": "透明燕"
        },
        {
            "location": "38/TALK",
            "narrator": "透明神楽",
            "text": "なら、私にしっかり\n捕まって、下を向いて\nいてください。",
            "zh": "那就抓紧我，\n低着头\n往前走。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "39/TALK",
            "narrator": "透明神楽",
            "text": "見えなければ、\nちょっとはマシに\nなると思いますよ。",
            "zh": "看不见的话，\n多少会\n好一点。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "42/TALK",
            "narrator": "透明つばめ",
            "text": "そ、そうかなぁ？",
            "zh": "是、是这样吗？",
            "narrator_zh": "透明燕"
        },
        {
            "location": "43/TALK",
            "narrator": "透明神楽",
            "text": "ほら、つばめさん。\nそこの影から何か\n出てきそうですよ。",
            "zh": "来，燕。\n那边的影子里\n好像要出来什么了。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "44/TALK",
            "narrator": "透明つばめ",
            "text": "わかった、\nわかったよぉ…。",
            "zh": "知道了，\n知道了啦……",
            "narrator_zh": "透明燕"
        },
        {
            "location": "47/TALK",
            "narrator": "透明神楽",
            "text": "ふふっ…怯えてる\nつばめさんって、\nかわいいです。",
            "zh": "呵呵……害怕的\n燕，\n很可爱。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "48/TALK",
            "narrator": "透明つばめ",
            "text": "それ、あんまし\n嬉しくないよ…？",
            "zh": "这话，我不怎么\n高兴哦……？",
            "narrator_zh": "透明燕"
        },
        {
            "location": "50/SEL",
            "narrator": "（選択肢）",
            "text": "そんなに怖いの？",
            "zh": "有那么可怕吗？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "51/ACT",
            "narrator": "",
            "text": "そんなに怖いの？",
            "zh": "有那么可怕吗？",
            "narrator_zh": ""
        },
        {
            "location": "58/TALK",
            "narrator": "つばめ",
            "text": "お化け屋敷が怖くなぃ人",
            "zh": "不怕鬼屋的人",
            "narrator_zh": "燕"
        },
        {
            "location": "60/TALK",
            "narrator": "つばめ",
            "text": "そんなに",
            "zh": "哪有",
            "narrator_zh": "燕"
        },
        {
            "location": "61/TALK",
            "narrator": "つばめ",
            "text": "ぃなぃと思ぅよ・゜・(ノД`)・゜・",
            "zh": "那么多呀・゜・(ノД`)・゜・",
            "narrator_zh": "燕"
        },
        {
            "location": "62/SEL",
            "narrator": "（選択肢）",
            "text": "怖がる必要ないよ",
            "zh": "没必要害怕呀",
            "narrator_zh": "（选项）"
        },
        {
            "location": "63/ACT",
            "narrator": "",
            "text": "怖がる必要ないよ",
            "zh": "没必要害怕呀",
            "narrator_zh": ""
        },
        {
            "location": "65/TALK",
