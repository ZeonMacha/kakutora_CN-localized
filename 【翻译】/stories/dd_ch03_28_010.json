{
    "dir": "chap28/daydra/dd_ch03_28_010.js",
    "type": "",
    "info": {
        "story_id": "50009",
        "cid": "",
        "title": "SideStory009 ストーリー",
        "sub_title": "FILE07.告白",
        "title_zh": "SideStory009 剧情",
        "sub_title_zh": "FILE07.告白"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "東京編７話",
            "zh": "东京篇 第7话",
            "narrator_zh": ""
        },
        {
            "location": "16/DIALOG",
            "narrator": "",
            "text": "<color=green>9月5日　 9:13 AM</color>\nとある平日の放課後、神楽坂トライナリー劇場前にて",
            "zh": "<color=green>9月5日　 9:13 AM</color>\n某个工作日的放学后，于神乐坂三重奏剧场前",
            "narrator_zh": ""
        },
        {
            "location": "17/TALK",
            "narrator": "雛",
            "text": "う～ん…思った以上に\n警備がすごいなぁ…。",
            "zh": "唔～……\n警备比想象中还要严密啊……。",
            "narrator_zh": "雏"
        },
        {
            "location": "18/TALK",
            "narrator": "雛",
            "text": "こっそり入れないかと\n思ったけど、簡単には\nいかないかも…。",
            "zh": "还想着能不能\n偷偷溜进去呢，\n看来没那么容易……。",
            "narrator_zh": "雏"
        },
        {
            "location": "19/TALK",
            "narrator": "雛",
            "text": "…どこか、ちょっとでも\nチャンスがあれば\nいいんだけど…。",
            "zh": "……哪怕有一点点\n机会都好，\n要是能找到突破口就好了……。",
            "narrator_zh": "雏"
        },
        {
            "location": "20/TALK",
            "narrator": "ヒカル",
            "text": "…ひなこさん。",
            "zh": "……雏子。",
            "narrator_zh": "光"
        },
        {
            "location": "21/TALK",
            "narrator": "雛",
            "text": "っ！？",
            "zh": "！？",
            "narrator_zh": "雏"
        },
        {
            "location": "24/TALK",
            "narrator": "ヒカル",
            "text": "すみません。\n驚かせちゃいました？",
            "zh": "不好意思。\n吓到你了吗？",
            "narrator_zh": "光"
        },
        {
            "location": "26/TALK",
            "narrator": "雛",
            "text": "ヒカルくん！\nどうしてここにいるの！？",
            "zh": "光！\n你怎么会在这里！？",
            "narrator_zh": "雏"
        },
        {
            "location": "27/TALK",
            "narrator": "ヒカル",
            "text": "…とりあえず、\n場所を変えよう。\nここにいるのは危険だよ。",
            "zh": "……总之，\n先换个地方吧。\n待在这里很危险。",
            "narrator_zh": "光"
        },
        {
            "location": "28/TALK",
            "narrator": "雛",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雏"
        },
        {
            "location": "40/TALK",
            "narrator": "雛",
            "text": "…どうしてわかったの？\nあたしが劇場にいるって。",
            "zh": "……你怎么知道的？\n知道我在剧场这边。",
            "narrator_zh": "雏"
        },
        {
            "location": "41/TALK",
            "narrator": "ヒカル",
            "text": "ひなこさんは\n簡単に引き下がるような\nタイプじゃないから…。",
            "zh": "因为雏子你\n可不是会轻易\n退缩的类型啊……。",
            "narrator_zh": "光"
        },
        {
            "location": "42/TALK",
            "narrator": "ヒカル",
            "text": "あれで納得して、\n大人しく家に帰るなんて\n思わないよ。",
            "zh": "我可不觉得你会\n就那么乖乖接受，\n然后老实回家去。",
            "narrator_zh": "光"
        },
        {
            "location": "43/TALK",
            "narrator": "雛",
            "text": "バレバレだったの！？",
            "zh": "完全被看穿了吗！？",
            "narrator_zh": "雏"
        },
        {
            "location": "44/TALK",
            "narrator": "雛",
            "text": "そんなぁ…。\n帰るフリまでして\n行ったのにー…。",
            "zh": "怎么这样……。\n我明明还装作\n回去了呢……。",
            "narrator_zh": "雏"
        },
        {
            "location": "45/TALK",
            "narrator": "ヒカル",
            "text": "…それより、劇場で\n何をしようとしてたの？",
            "zh": "……话说回来，你在剧场\n打算做什么？",
            "narrator_zh": "光"
        },
        {
            "location": "46/TALK",
            "narrator": "ヒカル",
            "text": "わかってるだろうけど、\n劇場は今、管理庁が\n厳重警備していて…。",
            "zh": "你应该也明白吧，\n剧场现在正被管理厅\n严密把守着……。",
            "narrator_zh": "光"
        },
        {
            "location": "47/TALK",
            "narrator": "ヒカル",
            "text": "入るのはもちろん、\n近づくだけでも\n危険なの、知ってるよね？",
            "zh": "别说进去了，\n光是靠近都很危险，\n你知道的吧？",
            "narrator_zh": "光"
        },
        {
            "location": "48/TALK",
            "narrator": "ヒカル",
            "text": "それなのに、\nどうして行ったの？",
            "zh": "既然知道，\n为什么还要去？",
            "narrator_zh": "光"
        },
        {
            "location": "49/TALK",
            "narrator": "雛",
            "text": "…あ、あれ？\nヒカルくん、\nちょっと怒ってない？",
            "zh": "……啊、啊咧？\n光，\n你是不是有点生气了？",
            "narrator_zh": "雏"
        },
        {
            "location": "50/TALK",
            "narrator": "ヒカル",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "光"
        },
        {
            "location": "52/TALK",
            "narrator": "雛",
            "text": "えと…ちょっと、\n劇場に入ろうかなぁ、\nって…。",
            "zh": "那个……我只是想着，\n要不要试着\n溜进剧场里面看看……。",
            "narrator_zh": "雏"
        },
        {
            "location": "53/TALK",
            "narrator": "ヒカル",
            "text": "やっぱり…どうして\nそんな危ないことを…。",
            "zh": "果然……为什么\n要做这么危险的事……。",
            "narrator_zh": "光"
        },
        {
            "location": "54/TALK",
            "narrator": "雛",
            "text": "…ヒカルくん達、\nあたし達が勝手に動くのは\n危険、って言ったでしょ？",
            "zh": "……光你们\n不是说了，我们擅自行动\n很危险吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "55/TALK",
            "narrator": "雛",
            "text": "だから、綾水様達と\n連絡を取る方法を\n探そうと思って…。",
            "zh": "所以我就想着，\n去寻找和绫水大人她们\n取得联系的方法……。",
            "narrator_zh": "雏"
        },
        {
            "location": "56/TALK",
            "narrator": "ヒカル",
            "text": "…なるほど。\n綾水先輩達に連絡が\n取れれば…。",
            "zh": "……原来如此。\n如果能联系上\n绫水前辈她们……。",
            "narrator_zh": "光"
        },
        {
            "location": "57/TALK",
            "narrator": "ヒカル",
            "text": "僕達がどう動けば\n手助けができるか、\n聞けると思ったんだね？",
            "zh": "你是想问问她们，\n我们该怎么行动\n才能帮上忙，对吧？",
            "narrator_zh": "光"
        },
        {
            "location": "59/TALK",
            "narrator": "雛",
            "text": "うん…それなら、\n自殺行為じゃないでしょ？",
            "zh": "嗯……那样的话，\n就不算自杀行为了吧？",
            "narrator_zh": "雏"
        },
        {
            "location": "60/TALK",
            "narrator": "ヒカル",
            "text": "でも、無謀だよ。",
            "zh": "可这还是很鲁莽啊。",
            "narrator_zh": "光"
        },
        {
            "location": "61/TALK",
            "narrator": "ヒカル",
            "text": "厳重警備の劇場に\n不法侵入しようだ\nなんて…。",
            "zh": "居然想非法潜入\n严密警备中的剧场\n什么的……。",
            "narrator_zh": "光"
        },
        {
            "location": "62/TALK",
            "narrator": "雛",
            "text": "…わかってるよ。\n無謀ってことくらい…。",
            "zh": "……我知道啦。\n我也知道这很鲁莽……。",
            "narrator_zh": "雏"
        },
        {
            "location": "64/TALK",
            "narrator": "雛",
            "text": "それでも、何もしない\nなんてできないよ！",
            "zh": "可就算这样，我也\n做不到什么都不做啊！",
            "narrator_zh": "雏"
        },
        {
            "location": "65/TALK",
            "narrator": "ヒカル",
            "text": "ひなこさん…。",
            "zh": "雏子……。",
            "narrator_zh": "光"
        },
        {
            "location": "66/TALK",
            "narrator": "雛",
            "text": "みんなには迷惑かけない。\nあたしが一人で勝手に\nやろうとしてるだけ。",
            "zh": "我不会连累大家的。\n这只是我一个人\n擅自想做的事而已。",
            "narrator_zh": "雏"
        },
        {
            "location": "68/TALK",
            "narrator": "雛",
            "text": "だからお願い。\n何も見なかった\nことにして！",
            "zh": "所以拜托了。\n请你就当\n什么都没看见吧！",
            "narrator_zh": "雏"
        },
        {
            "location": "69/TALK",
            "narrator": "ヒカル",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "光"
        },
        {
            "location": "70/TALK",
            "narrator": "雛",
            "text": "…だめ？",
            "zh": "……不行吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "71/TALK",
            "narrator": "ヒカル",
            "text": "…当然、ダメだよ。",
            "zh": "……当然不行。",
            "narrator_zh": "光"
        },
        {
            "location": "72/TALK",
            "narrator": "雛",
            "text": "やっぱり…。",
            "zh": "果然……。",
            "narrator_zh": "雏"
        },
        {
            "location": "73/TALK",
            "narrator": "ヒカル",
            "text": "そんな危険なこと、\nひなこさん一人だけに\nさせられないよ。",
            "zh": "这么危险的事，\n我怎么可能放着\n雏子你一个人去做。",
            "narrator_zh": "光"
        },
        {
            "location": "74/TALK",
            "narrator": "雛",
            "text": "…え？",
            "zh": "……诶？",
            "narrator_zh": "雏"
        },
        {
            "location": "75/TALK",
            "narrator": "ヒカル",
            "text": "僕も協力する。\nだから、一緒にどうするか\n考えよう。",
            "zh": "我也来帮忙。\n所以，我们一起来想\n该怎么做吧。",
            "narrator_zh": "光"
        },
        {
            "location": "76/TALK",
            "narrator": "雛",
            "text": "で、でも、いいの！？\nヒカルくんはあたしに\n反対してたのに…。",
            "zh": "可、可是，这样可以吗！？\n光你之前明明\n反对过我的……。",
            "narrator_zh": "雏"
        },
        {
            "location": "77/TALK",
            "narrator": "ヒカル",
            "text": "今だって、手放しで\n賛成はできないけど…。",
            "zh": "哪怕现在，我也\n没法毫无保留地赞成……。",
            "narrator_zh": "光"
        },
        {
            "location": "78/TALK",
            "narrator": "ヒカル",
            "text": "一人で突っ走ろうと\nしてるひなこさんを、\n放っておけないよ。",
            "zh": "但看雏子你一副\n要一个人往前冲的样子，\n我实在没法放着不管啊。",
            "narrator_zh": "光"
        },
        {
            "location": "79/TALK",
            "narrator": "雛",
            "text": "ヒカルくん…。",
            "zh": "光……。",
            "narrator_zh": "雏"
        },
        {
            "location": "80/TALK",
            "narrator": "ヒカル",
            "text": "それに、キリトだって\n言ってたでしょ？",
            "zh": "而且，圣翔不也\n说过吗？",
            "narrator_zh": "光"
        },
        {
            "location": "81/TALK",
            "narrator": "ヒカル",
            "text": "僕達だって、逢瀬さんを\n助けたいって気持ちは\n一緒だ、って…。",
            "zh": "我们也一样，\n想要救逢濑的心情\n都是一样的……。",
            "narrator_zh": "光"
        },
        {
            "location": "82/TALK",
            "narrator": "ヒカル",
            "text": "だから…自分の気持ちに\nまっすぐなひなこさんを\n見てたら…。",
            "zh": "所以……看到\n对自己的心意如此坦诚的\n雏子……。",
            "narrator_zh": "光"
        },
        {
            "location": "83/TALK",
            "narrator": "ヒカル",
            "text": "ちょっと、羨ましいって\n思っちゃって…。",
            "zh": "我心里稍微觉得，\n有点羡慕呢……。",
            "narrator_zh": "光"
        },
        {
            "location": "84/TALK",
            "narrator": "雛",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雏"
        },
        {
            "location": "85/TALK",
            "narrator": "ヒカル",
            "text": "一緒に考えよう。\nこれから、二人だけで\nなにが出来るか…。",
            "zh": "一起想想吧。\n接下来，靠我们两个人\n能做些什么……。",
            "narrator_zh": "光"
        },
        {
            "location": "86/TALK",
            "narrator": "雛",
            "text": "…うん！",
            "zh": "……嗯！",
            "narrator_zh": "雏"
        },
        {
            "location": "95/TALK",
            "narrator": "ガブリエラ",
            "text": "…本当、素敵な場所。",
            "zh": "……真是的，好漂亮的地方。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "96/TALK",
            "narrator": "ガブリエラ",
            "text": "できれば、\nもっと普通の時に\n来たかったな…。",
            "zh": "可以的话，\n真想在更平常的时候\n过来看看啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "100/TALK",
            "narrator": "ガブリエラ",
            "text": "…なんとなくわかるけど。",
            "zh": "……虽然多少能理解就是了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "104/TALK",
            "narrator": "ガブリエラ",
            "text": "…やっぱり雛からだわ。\n既読つかないように\n確認しないと…。",
            "zh": "……果然是雏发来的。\n得小心别留下已读，\n先确认一下……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "109/TALK",
            "narrator": "雛",
            "text": "見てるかどうかわからないけど",
            "zh": "虽然不知道你看不看得到",
            "narrator_zh": "雏"
        },
        {
            "location": "110/TALK",
            "narrator": "雛",
            "text": "報告するよ",
            "zh": "我来汇报一下哦",
            "narrator_zh": "雏"
        },
        {
            "location": "111/TALK",
            "narrator": "雛",
            "text": "あたし",
            "zh": "我呀",
            "narrator_zh": "雏"
        },
        {
            "location": "112/TALK",
            "narrator": "雛",
            "text": "つばめちゃんを助けるの諦めないから",
            "zh": "我是不会放弃救燕的",
            "narrator_zh": "雏"
        },
        {
            "location": "113/TALK",
            "narrator": "雛",
            "text": "ガブリエラちゃん達と連絡を取るのも",
            "zh": "也不会放弃和加布里埃拉她们联系",
            "narrator_zh": "雏"
        },
        {
            "location": "115/TALK",
            "narrator": "雛",
            "text": "さいしょはね",
            "zh": "一开始呢",
            "narrator_zh": "雏"
        },
        {
            "location": "116/TALK",
            "narrator": "雛",
            "text": "みんなに反対されたの",
            "zh": "大家都反对我",
            "narrator_zh": "雏"
        },
        {
            "location": "117/TALK",
            "narrator": "雛",
            "text": "危ないって",
            "zh": "说太危险了",
            "narrator_zh": "雏"
        },
        {
            "location": "118/TALK",
            "narrator": "雛",
            "text": "自殺行為だって",
            "zh": "说这是自杀行为",
            "narrator_zh": "雏"
        },
        {
            "location": "119/TALK",
            "narrator": "雛",
            "text": "でも諦められなくて",
            "zh": "但我实在放弃不了",
            "narrator_zh": "雏"
        },
        {
            "location": "120/TALK",
            "narrator": "雛",
            "text": "そしたら",
            "zh": "结果",
            "narrator_zh": "雏"
        },
        {
            "location": "121/TALK",
            "narrator": "雛",
            "text": "ヒカルくんが手伝ってくれることになって",
            "zh": "光愿意来帮我了",
            "narrator_zh": "雏"
        },
        {
            "location": "123/TALK",
            "narrator": "雛",
            "text": "あたしは諦めないからね？",
            "zh": "我不会放弃的哦？",
            "narrator_zh": "雏"
        },
        {
            "location": "124/TALK",
            "narrator": "雛",
            "text": "ガブリエラちゃん達や",
            "zh": "因为我想见加布里埃拉她们",
            "narrator_zh": "雏"
        },
        {
            "location": "125/TALK",
            "narrator": "雛",
            "text": "つばめちゃんに会いたいから",
            "zh": "也想见燕",
            "narrator_zh": "雏"
        },
        {
            "location": "127/TALK",
            "narrator": "雛",
            "text": "ヒカルくんも",
            "zh": "光他呀",
            "narrator_zh": "雏"
        },
        {
            "location": "128/TALK",
            "narrator": "雛",
            "text": "ガブリエラちゃんに会いたがってるよ",
            "zh": "也很想见加布里埃拉哦",
            "narrator_zh": "雏"
        },
        {
            "location": "139/TALK",
            "narrator": "ガブリエラ",
            "text": "…ヒカルくんが一緒って、\nそれって手伝いじゃ\nなくて…。",
            "zh": "……光和她在一起，\n那根本不是在帮忙，\n而是……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "140/TALK",
            "narrator": "ガブリエラ",
            "text": "手伝うふりして、\n止められてるんじゃ\nないのかしら？",
            "zh": "该不会是假装帮忙，\n其实是在\n拦着她吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "141/TALK",
            "narrator": "ガブリエラ",
            "text": "自殺行為とわかってて、\n手伝ったりするような\n人じゃないし…。",
            "zh": "他可不是那种\n明知是自杀行为\n还会去帮衬的人……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "142/TALK",
            "narrator": "ガブリエラ",
            "text": "…それにしても。",
            "zh": "……话说回来。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "143/TALK",
            "narrator": "ガブリエラ",
