        "title": "らぶとーく 第59話",
        "sub_title": "ルールじゃなくて法律なのよ",
        "title_zh": "恋爱漫谈 第59话",
        "sub_title_zh": "不是规则，是法律哦"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "ルールじゃなくて法律なのよ",
            "zh": "不是规则，是法律哦",
            "narrator_zh": ""
        },
        {
            "location": "18/TALK",
            "narrator": "真幌",
            "text": "…ん？",
            "zh": "……嗯？",
            "narrator_zh": "真幌"
        },
        {
            "location": "21/TALK",
            "narrator": "アーヤ",
            "text": "あ、館長。\nお疲れ様です。",
            "zh": "啊，馆长。\n辛苦了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "23/TALK",
            "narrator": "真幌",
            "text": "お疲れさん。\nこんな時間に外出か？",
            "zh": "辛苦啦。\n这个时间出门？",
            "narrator_zh": "真幌"
        },
        {
            "location": "24/TALK",
            "narrator": "アーヤ",
            "text": "はい。\n大学に行った後で、\n新宿の方へ…。",
            "zh": "是的。\n去了大学之后，\n就往新宿那边……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "25/TALK",
            "narrator": "真幌",
            "text": "ほう…。",
            "zh": "哦……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "26/TALK",
            "narrator": "真幌",
            "text": "バイクを置いていく\nところから察するに…。",
            "zh": "从丢下摩托车\n不管这一点来看……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "28/TALK",
            "narrator": "アーヤ",
            "text": "ふふっ…館長には\nバレバレですね。",
            "zh": "呵呵……在馆长面前\n根本藏不住呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "29/TALK",
            "narrator": "真幌",
            "text": "ふっ…、\n程々に楽しんでこいよ。",
            "zh": "哼……，\n记得适可而止啊。",
            "narrator_zh": "真幌"
        },
        {
            "location": "30/TALK",
            "narrator": "アーヤ",
            "text": "はい。\nそれじゃ…。",
            "zh": "好的。\n那么……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "39/TALK",
            "narrator": "アーヤ",
            "text": "…少し早かったかしら？",
            "zh": "……是不是有点早了？",
            "narrator_zh": "绫水"
        },
        {
            "location": "40/TALK",
            "narrator": "アーヤ",
            "text": "でも、遅れてみんなを\n待たせたら悪いし…。",
            "zh": "不过，迟到了让大家\n等也不好……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "41/SEL",
            "narrator": "",
            "text": "どこ行くの？",
            "zh": "要去哪里？",
            "narrator_zh": ""
        },
        {
            "location": "42/SEL",
            "narrator": "",
            "text": "今暇？",
            "zh": "现在有空吗？",
            "narrator_zh": ""
        },
        {
            "location": "43/SEL",
            "narrator": "",
            "text": "秘密とかない？",
            "zh": "没有什么秘密吗？",
            "narrator_zh": ""
        },
        {
            "location": "45/TALK",
            "narrator": "アーヤ",
            "text": "…日付が変わる前に\n帰れるかしら？",
            "zh": "……能在日期变更\n之前回去吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "46/TALK",
            "narrator": "アーヤ",
            "text": "ううん、帰らないと。",
            "zh": "不，得回去才行。",
            "narrator_zh": "绫水"
        },
        {
            "location": "47/TALK",
            "narrator": "アーヤ",
            "text": "あんまり遅く帰ると、\nギャヴィ達に変な勘繰り\n入れられそうだし。",
            "zh": "回去太晚的话，\n感觉会被加维她们\n乱猜的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "50/TALK",
            "narrator": "アーヤ",
            "text": "…ふふっ、楽しみだなぁ。",
            "zh": "……呵呵，真期待呀。",
            "narrator_zh": "绫水"
        },
        {
            "location": "52/ACT",
            "narrator": "",
            "text": "どこ行くの？",
            "zh": "要去哪里？",
            "narrator_zh": ""
        },
        {
            "location": "56/TALK",
            "narrator": "アーヤ",
            "text": "あっ…。",
            "zh": "啊……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "70/TALK",
            "narrator": "アーヤ",
            "text": "$handle$さん！(*^o^*)",
            "zh": "$handle$！(*^o^*)",
            "narrator_zh": "绫水"
        },
        {
            "location": "71/TALK",
            "narrator": "アーヤ",
            "text": "今から",
            "zh": "我现在",
            "narrator_zh": "绫水"
        },
        {
            "location": "73/TALK",
            "narrator": "アーヤ",
            "text": "ちょっと大学に行くの",
            "zh": "稍微去一趟大学",
            "narrator_zh": "绫水"
        },
        {
            "location": "75/SEL",
            "narrator": "",
            "text": "バイク通学しないの？",
            "zh": "你不骑摩托上学吗？",
            "narrator_zh": ""
        },
        {
            "location": "76/ACT",
            "narrator": "",
            "text": "バイク通学しないの？",
            "zh": "你不骑摩托上学吗？",
            "narrator_zh": ""
        },
        {
            "location": "78/TALK",
            "narrator": "アーヤ",
            "text": "今日はね",
            "zh": "今天呢",
            "narrator_zh": "绫水"
        },
        {
            "location": "79/TALK",
            "narrator": "アーヤ",
            "text": "っていうか",
            "zh": "话说",
            "narrator_zh": "绫水"
        },
        {
            "location": "80/TALK",
            "narrator": "アーヤ",
            "text": "電車通学の方が多いのよ？",
            "zh": "坐电车上学的时候更多哦？",
            "narrator_zh": "绫水"
        },
        {
            "location": "81/TALK",
            "narrator": "アーヤ",
            "text": "大学の後",
            "zh": "下了课之后",
            "narrator_zh": "绫水"
        },
        {
            "location": "82/TALK",
            "narrator": "アーヤ",
            "text": "みんなで飲みに行くことも多いし",
            "zh": "也经常大家一起出去喝",
            "narrator_zh": "绫水"
        },
        {
            "location": "83/TALK",
            "narrator": "アーヤ",
            "text": "今も",
            "zh": "现在也是",
            "narrator_zh": "绫水"
        },
        {
            "location": "84/TALK",
            "narrator": "アーヤ",
            "text": "大学で待ち合わせて飲みに行くところなの",
            "zh": "正要和大家在大学碰头去喝酒",
            "narrator_zh": "绫水"
        },
        {
            "location": "86/SEL",
            "narrator": "",
            "text": "アーヤって、飲める方なの？",
            "zh": "绫水能喝酒吗？",
            "narrator_zh": ""
        },
        {
            "location": "87/ACT",
            "narrator": "",
            "text": "アーヤって、飲める方なの？",
            "zh": "绫水能喝酒吗？",
            "narrator_zh": ""
        },
        {
            "location": "89/TALK",
            "narrator": "アーヤ",
            "text": "わからない(｡-_-｡)",
            "zh": "不知道呢(｡-_-｡)",
            "narrator_zh": "绫水"
        },
        {
            "location": "91/TALK",
            "narrator": "アーヤ",
            "text": "二杯以上飲まないようにしてるから",
            "zh": "因为我控制自己不喝超过两杯",
            "narrator_zh": "绫水"
        },
        {
            "location": "92/TALK",
            "narrator": "アーヤ",
            "text": "でも",
            "zh": "不过",
            "narrator_zh": "绫水"
        },
        {
            "location": "93/TALK",
            "narrator": "アーヤ",
            "text": "一度だけ一升瓶空けたことある(・・。)ゞ",
            "zh": "只有一次喝空过一整瓶(・・。)ゞ",
            "narrator_zh": "绫水"
        },
        {
            "location": "94/TALK",
            "narrator": "アーヤ",
            "text": "初めて飲んだ時だったから",
            "zh": "因为那是我第一次喝酒",
            "narrator_zh": "绫水"
        },
        {
            "location": "95/TALK",
            "narrator": "アーヤ",
            "text": "緊張して酔えなかったけど",
            "zh": "虽然紧张得根本没醉",
            "narrator_zh": "绫水"
        },
        {
            "location": "97/SEL",
            "narrator": "",
            "text": "…イケる口なんだね",
            "zh": "…你挺能喝嘛",
            "narrator_zh": ""
        },
        {
            "location": "98/ACT",
            "narrator": "",
            "text": "…イケる口なんだね",
            "zh": "…你挺能喝嘛",
            "narrator_zh": ""
        },
        {
            "location": "100/TALK",
            "narrator": "アーヤ",
            "text": "全然よ",
            "zh": "完全不是哦",
            "narrator_zh": "绫水"
        },
        {
            "location": "101/TALK",
            "narrator": "アーヤ",
            "text": "普通の時だったら絶対酔うと思うし(;^_^A",
            "zh": "平时的话肯定早就醉了(;^_^A",
            "narrator_zh": "绫水"
        },
        {
            "location": "103/TALK",
            "narrator": "アーヤ",
            "text": "とにかく",
            "zh": "总之",
            "narrator_zh": "绫水"
        },
        {
            "location": "104/TALK",
            "narrator": "アーヤ",
            "text": "そういうわけだから",
            "zh": "所以",
            "narrator_zh": "绫水"
        },
        {
            "location": "105/TALK",
            "narrator": "アーヤ",
            "text": "話はまた帰ってからね",
            "zh": "话我们回去再聊哦",
            "narrator_zh": "绫水"
        },
        {
            "location": "107/SEL",
            "narrator": "",
            "text": "しっかり楽しんできてね",
            "zh": "好好玩个够吧",
            "narrator_zh": ""
        },
        {
            "location": "108/ACT",
            "narrator": "",
            "text": "しっかり楽しんできてね",
            "zh": "好好玩个够吧",
            "narrator_zh": ""
        },
        {
            "location": "121/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "123/TALK",
            "narrator": "アーヤ",
            "text": "…やっぱり、早く帰ろう。",
            "zh": "……果然，还是早点回去吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "124/TALK",
            "narrator": "アーヤ",
            "text": "夜は$handle$さんと、\nゆっくり話したいし。",
            "zh": "晚上想跟$handle$，\n好好聊聊天。",
            "narrator_zh": "绫水"
        },
        {
            "location": "125/ACT",
            "narrator": "",
            "text": "今暇？",
            "zh": "现在有空吗？",
            "narrator_zh": ""
        },
        {
            "location": "129/TALK",
            "narrator": "アーヤ",
            "text": "あっ…。",
            "zh": "啊……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "143/TALK",
            "narrator": "アーヤ",
            "text": "$handle$さん！(*^o^*)",
            "zh": "$handle$！(*^o^*)",
            "narrator_zh": "绫水"
        },
        {
            "location": "144/TALK",
            "narrator": "アーヤ",
            "text": "ごめんなさい",
            "zh": "对不起",
            "narrator_zh": "绫水"
        },
        {
            "location": "145/TALK",
            "narrator": "アーヤ",
            "text": "暇じゃないんだけど、どうかした？",
            "zh": "我现在没空，怎么了？",
            "narrator_zh": "绫水"
        },
        {
            "location": "147/SEL",
            "narrator": "",
            "text": "アーヤと話したくて",
            "zh": "因为想跟绫水说话",
            "narrator_zh": ""
        },
        {
            "location": "148/ACT",
            "narrator": "",
            "text": "アーヤと話したくて",
            "zh": "因为想跟绫水说话",
            "narrator_zh": ""
        },
        {
            "location": "150/TALK",
            "narrator": "アーヤ",
            "text": "そうだったんだ",
            "zh": "原来是这样",
            "narrator_zh": "绫水"
        },
        {
            "location": "151/TALK",
            "narrator": "アーヤ",
            "text": "でも",
            "zh": "不过",
            "narrator_zh": "绫水"
        },
        {
            "location": "153/TALK",
            "narrator": "アーヤ",
            "text": "歩きスマホは危ないから(-.-;)",
            "zh": "边走边看手机很危险的(-.-;)",
            "narrator_zh": "绫水"
        },
        {
            "location": "154/TALK",
            "narrator": "アーヤ",
            "text": "またこっちから連絡するわ",
            "zh": "回头我这边再联系你",
            "narrator_zh": "绫水"
        },
        {
            "location": "166/TALK",
            "narrator": "アーヤ",
            "text": "…素っ気なかったかしら？",
            "zh": "……是不是太冷淡了？",
            "narrator_zh": "绫水"
        },
        {
            "location": "167/TALK",
            "narrator": "アーヤ",
            "text": "…ううん。\nさすがに考え過ぎよね。",
            "zh": "…不对。\n果然是我想太多了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "168/ACT",
            "narrator": "",
            "text": "秘密とかない？",
            "zh": "没有什么秘密吗？",
            "narrator_zh": ""
        },
        {
            "location": "172/TALK",
            "narrator": "アーヤ",
            "text": "あっ…。",
            "zh": "啊……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "187/TALK",
            "narrator": "アーヤ",
            "text": "え？",
            "zh": "诶？",
            "narrator_zh": "绫水"
        },
        {
            "location": "191/SEL",
            "narrator": "",
            "text": "いや、なんとなく…",
            "zh": "没，就是随便……",
            "narrator_zh": ""
        },
        {
            "location": "192/ACT",
            "narrator": "",
            "text": "いや、なんとなく…",
            "zh": "没，就是随便……",
            "narrator_zh": ""
        },
        {
            "location": "207/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "209/TALK",
            "narrator": "アーヤ",
            "text": "私ったら、何をそんなに\nムキになってるのよ…。",
            "zh": "我这是怎么了，\n干嘛这么较真啊……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "210/TALK",
            "narrator": "アーヤ",
            "text": "帰ったら謝らないと…。",
            "zh": "回去以后得道歉才行……。",
            "narrator_zh": "绫水"
        },
