  "title": "らぶとーく 第59話",
  "sub_title": "ルールじゃなくて法律なのよ"
 },
 "entry": [
  {
   "location": "7/SCENARIO",
   "narrator": "",
   "text": "ルールじゃなくて法律なのよ"
  },
  {
   "location": "18/TALK",
   "narrator": "真幌",
   "text": "…ん？",
   "zh": "……嗯？",
   "narrator_zh": "真幌"
  },
  {
   "location": "21/TALK",
   "narrator": "アーヤ",
   "text": "あ、館長。\nお疲れ様です。"
  },
  {
   "location": "23/TALK",
   "narrator": "真幌",
   "text": "お疲れさん。\nこんな時間に外出か？",
   "zh": "辛苦啦。\n这个时间出门？",
   "narrator_zh": "真幌"
  },
  {
   "location": "24/TALK",
   "narrator": "アーヤ",
   "text": "はい。\n大学に行った後で、\n新宿の方へ…。"
  },
  {
   "location": "25/TALK",
   "narrator": "真幌",
   "text": "ほう…。"
  },
  {
   "location": "26/TALK",
   "narrator": "真幌",
   "text": "バイクを置いていく\nところから察するに…。"
  },
  {
   "location": "28/TALK",
   "narrator": "アーヤ",
   "text": "ふふっ…館長には\nバレバレですね。"
  },
  {
   "location": "29/TALK",
   "narrator": "真幌",
   "text": "ふっ…、\n程々に楽しんでこいよ。"
  },
  {
   "location": "30/TALK",
   "narrator": "アーヤ",
   "text": "はい。\nそれじゃ…。"
  },
  {
   "location": "39/TALK",
   "narrator": "アーヤ",
   "text": "…少し早かったかしら？",
   "zh": "……是不是有点早了？",
   "narrator_zh": "绫水"
  },
  {
   "location": "40/TALK",
   "narrator": "アーヤ",
   "text": "でも、遅れてみんなを\n待たせたら悪いし…。",
   "zh": "不过，迟到了让大家\n等也不好……。",
   "narrator_zh": "绫水"
  },
  {
   "location": "41/SEL",
   "narrator": "",
   "text": "どこ行くの？",
   "zh": "要去哪里？",
   "narrator_zh": ""
  },
  {
   "location": "42/SEL",
   "narrator": "",
   "text": "今暇？"
  },
  {
   "location": "43/SEL",
   "narrator": "",
   "text": "秘密とかない？",
   "zh": "没有什么秘密吗？",
   "narrator_zh": ""
  },
  {
   "location": "45/TALK",
   "narrator": "アーヤ",
   "text": "…日付が変わる前に\n帰れるかしら？",
   "zh": "……能在日期变更\n之前回去吗？",
   "narrator_zh": "绫水"
  },
  {
   "location": "46/TALK",
   "narrator": "アーヤ",
   "text": "ううん、帰らないと。"
  },
  {
   "location": "47/TALK",
   "narrator": "アーヤ",
   "text": "あんまり遅く帰ると、\nギャヴィ達に変な勘繰り\n入れられそうだし。"
  },
  {
   "location": "50/TALK",
   "narrator": "アーヤ",
   "text": "…ふふっ、楽しみだなぁ。",
   "zh": "……呵呵，真期待呀。",
   "narrator_zh": "绫水"
  },
  {
   "location": "52/ACT",
   "narrator": "",
   "text": "どこ行くの？",
   "zh": "要去哪里？",
   "narrator_zh": ""
  },
  {
   "location": "56/TALK",
   "narrator": "アーヤ",
   "text": "あっ…。",
   "zh": "啊……。",
   "narrator_zh": "绫水"
  },
  {
   "location": "70/TALK",
   "narrator": "アーヤ",
   "text": "$handle$さん！(*^o^*)",
   "zh": "$handle$！(*^o^*)",
   "narrator_zh": "绫水"
  },
  {
   "location": "71/TALK",
   "narrator": "アーヤ",
   "text": "今から"
  },
  {
   "location": "73/TALK",
   "narrator": "アーヤ",
   "text": "ちょっと大学に行くの",
   "zh": "稍微去一趟大学",
   "narrator_zh": "绫水"
  },
  {
   "location": "75/SEL",
   "narrator": "",
   "text": "バイク通学しないの？",
   "zh": "你不骑摩托上学吗？",
   "narrator_zh": ""
  },
  {
   "location": "76/ACT",
   "narrator": "",
   "text": "バイク通学しないの？",
   "zh": "你不骑摩托上学吗？",
   "narrator_zh": ""
  },
  {
   "location": "78/TALK",
   "narrator": "アーヤ",
   "text": "今日はね",
   "zh": "今天呢",
   "narrator_zh": "绫水"
  },
  {
   "location": "79/TALK",
   "narrator": "アーヤ",
   "text": "っていうか",
   "zh": "话说",
   "narrator_zh": "绫水"
  },
  {
   "location": "80/TALK",
   "narrator": "アーヤ",
   "text": "電車通学の方が多いのよ？"
  },
  {
   "location": "81/TALK",
   "narrator": "アーヤ",
   "text": "大学の後"
  },
  {
   "location": "82/TALK",
   "narrator": "アーヤ",
   "text": "みんなで飲みに行くことも多いし"
  },
  {
   "location": "83/TALK",
   "narrator": "アーヤ",
   "text": "今も"
  },
  {
   "location": "84/TALK",
   "narrator": "アーヤ",
   "text": "大学で待ち合わせて飲みに行くところなの"
  },
  {
   "location": "86/SEL",
   "narrator": "",
   "text": "アーヤって、飲める方なの？",
   "zh": "绫水能喝酒吗？",
   "narrator_zh": ""
  },
  {
   "location": "87/ACT",
   "narrator": "",
   "text": "アーヤって、飲める方なの？",
   "zh": "绫水能喝酒吗？",
   "narrator_zh": ""
  },
  {
   "location": "89/TALK",
   "narrator": "アーヤ",
   "text": "わからない(｡-_-｡)"
  },
  {
   "location": "91/TALK",
   "narrator": "アーヤ",
   "text": "二杯以上飲まないようにしてるから"
  },
  {
   "location": "92/TALK",
   "narrator": "アーヤ",
   "text": "でも",
   "zh": "不过",
   "narrator_zh": "绫水"
  },
  {
   "location": "93/TALK",
   "narrator": "アーヤ",
   "text": "一度だけ一升瓶空けたことある(・・。)ゞ"
  },
  {
   "location": "94/TALK",
   "narrator": "アーヤ",
   "text": "初めて飲んだ時だったから"
  },
  {
   "location": "95/TALK",
   "narrator": "アーヤ",
   "text": "緊張して酔えなかったけど"
  },
  {
   "location": "97/SEL",
   "narrator": "",
   "text": "…イケる口なんだね",
   "zh": "…你挺能喝嘛",
   "narrator_zh": ""
  },
  {
   "location": "98/ACT",
   "narrator": "",
   "text": "…イケる口なんだね",
   "zh": "…你挺能喝嘛",
   "narrator_zh": ""
  },
  {
   "location": "100/TALK",
   "narrator": "アーヤ",
   "text": "全然よ"
  },
  {
   "location": "101/TALK",
   "narrator": "アーヤ",
   "text": "普通の時だったら絶対酔うと思うし(;^_^A"
  },
  {
   "location": "103/TALK",
   "narrator": "アーヤ",
   "text": "とにかく",
   "zh": "总之",
   "narrator_zh": "绫水"
  },
  {
   "location": "104/TALK",
   "narrator": "アーヤ",
   "text": "そういうわけだから",
   "zh": "所以",
   "narrator_zh": "绫水"
  },
  {
   "location": "105/TALK",
   "narrator": "アーヤ",
   "text": "話はまた帰ってからね"
  },
  {
   "location": "107/SEL",
   "narrator": "",
   "text": "しっかり楽しんできてね",
   "zh": "好好玩个够吧",
   "narrator_zh": ""
  },
  {
   "location": "108/ACT",
   "narrator": "",
   "text": "しっかり楽しんできてね",
   "zh": "好好玩个够吧",
   "narrator_zh": ""
  },
  {
   "location": "121/TALK",
   "narrator": "アーヤ",
   "text": "…………。"
  },
  {
   "location": "123/TALK",
   "narrator": "アーヤ",
   "text": "…やっぱり、早く帰ろう。",
