        },
        {
            "location": "712/SEL",
            "narrator": "",
            "text": "夢がー夢がー",
            "zh": "梦想啊——梦想啊——",
            "narrator_zh": ""
        },
        {
            "location": "713/SEL",
            "narrator": "",
            "text": "努力で勝ち取る美か…",
