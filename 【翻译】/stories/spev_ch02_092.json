{
    "dir": "chap00/daydra/spev_ch02_092.js",
    "type": "",
    "info": {
        "story_id": "91033",
        "cid": "",
        "title": "ぴょんこのサマー大作戦♪",
        "sub_title": "ぴょんこのサマー大作戦♪③【アーヤ編】",
        "title_zh": "蹦子的夏日大作战♪",
        "sub_title_zh": "蹦子的夏日大作战♪③【绫水篇】"
    },
    "entry": [
        {
            "location": "20/DIALOG",
            "narrator": "",
            "text": "<color=green>7月20日　3:43 PM</color>\nとある平日、付属学園アーヤの教室にて",
            "zh": "<color=green>7月20日　3:43 PM</color>\n某个平日，在附属学园绫水的教室里",
            "narrator_zh": ""
        },
        {
            "location": "21/TALK",
            "narrator": "小夜",
            "text": "そういえば、アーヤ。\nこの前の講義\n出てなかったでしょ？",
            "zh": "说起来，绫水。\n上次那堂课\n你没来吧？",
            "narrator_zh": "小夜"
        },
        {
            "location": "22/TALK",
            "narrator": "小夜",
            "text": "あの時取ったノート、\nコピーする？",
            "zh": "当时记的笔记，\n要复印吗？",
            "narrator_zh": "小夜"
        },
        {
            "location": "24/TALK",
            "narrator": "アーヤ",
            "text": "助かるわ。\nちょうどお願いしようかと\n思ってたのよ。",
            "zh": "帮大忙了。\n我正好还想\n拜托你来着。",
            "narrator_zh": "绫水"
        },
        {
            "location": "25/TALK",
            "narrator": "小夜",
            "text": "だと思ったから、\n実はもうコピーして\nあるのよね。",
            "zh": "我就猜到你会这么说，\n其实我已经\n给你复印好了。",
            "narrator_zh": "小夜"
        },
        {
            "location": "26/TALK",
            "narrator": "アーヤ",
            "text": "さすが！\nランチ奢るわ",
            "zh": "不愧是你！\n我请你吃午饭",
            "narrator_zh": "绫水"
        },
        {
            "location": "27/TALK",
            "narrator": "小夜",
            "text": "えー、そこまですること\nないってー。\nごちそうさまー。",
            "zh": "诶——，不用做到\n这种地步啦——。\n那就多谢款待啦——。",
            "narrator_zh": "小夜"
        },
        {
            "location": "28/TALK",
            "narrator": "アーヤ",
            "text": "それじゃ週末にでも…。",
            "zh": "那就等周末吧……",
            "narrator_zh": "绫水"
        },
        {
            "location": "31/TALK",
            "narrator": "アーヤ",
            "text": "んっ？",
            "zh": "嗯？",
            "narrator_zh": "绫水"
        },
        {
            "location": "32/TALK",
            "narrator": "小夜",
            "text": "どうしたの？",
            "zh": "怎么了？",
            "narrator_zh": "小夜"
        },
        {
            "location": "34/TALK",
            "narrator": "アーヤ",
            "text": "…気のせいかしら？\n視線を感じるんだけど…。",
            "zh": "……是错觉吗？\n总觉得有视线在看这边……",
            "narrator_zh": "绫水"
        },
        {
            "location": "48/TALK",
            "narrator": "神楽",
            "text": "…思った通り。",
            "zh": "……果然如我所料。",
            "narrator_zh": "神乐"
        },
        {
            "location": "49/TALK",
            "narrator": "神楽",
            "text": "アーヤさんと小夜さんは、\n見てるだけで色々と\nネタになりますね。",
            "zh": "绫水和小夜，\n光看着就能\n攒出好多素材呢。",
            "narrator_zh": "神乐"
        },
        {
            "location": "50/TALK",
            "narrator": "神楽",
            "text": "同人誌、ラノベにするのは\nやめて正解だったかも。",
            "zh": "同人志不写成轻小说，\n或许真是选对了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "51/TALK",
            "narrator": "神楽",
            "text": "やっぱり、せっかく\n画像編集ソフトを\n入れたんですから…ふふ。",
            "zh": "毕竟好不容易\n装了修图软件\n嘛……呵呵。",
            "narrator_zh": "神乐"
        },
        {
            "location": "53/TALK",
            "narrator": "神楽",
            "text": "えーっと…講義のノートを\n貸してもらう、という\n展開だと、オチは…。",
            "zh": "呃……要是按借讲义\n笔记的展开来画，\n结局笑点就……",
            "narrator_zh": "神乐"
        },
        {
            "location": "58/TALK",
            "narrator": "アーヤ",
            "text": "…卯月、さっきから\nコソコソなにしてるの？",
            "zh": "……卯月，你从刚才起\n鬼鬼祟祟地在做什么？",
            "narrator_zh": "绫水"
        },
        {
            "location": "61/TALK",
            "narrator": "神楽",
            "text": "はい。アーヤさんを\n観察することで\n創作のネタを…。",
            "zh": "是的。我想借着\n观察绫水来为新作\n搜索灵感……",
            "narrator_zh": "神乐"
        },
        {
            "location": "63/TALK",
            "narrator": "神楽",
            "text": "え？",
            "zh": "诶？",
            "narrator_zh": "神乐"
        },
        {
            "location": "65/TALK",
            "narrator": "アーヤ",
            "text": "ソウサク？",
            "zh": "“搜索”？[?]",
            "narrator_zh": "绫水"
        },
        {
            "location": "67/TALK",
            "narrator": "神楽",
            "text": "あ、アーヤさん！？",
            "zh": "啊、绫水！？",
            "narrator_zh": "神乐"
        },
        {
            "location": "69/TALK",
            "narrator": "アーヤ",
            "text": "大学まで来て、\nなにやってるの？",
            "zh": "跑到大学里来，\n在干什么呀？",
            "narrator_zh": "绫水"
        },
        {
            "location": "71/TALK",
            "narrator": "神楽",
            "text": "えっ！？\nそ、それは、えっと…。",
            "zh": "诶！？\n那、那个，呃……",
            "narrator_zh": "神乐"
        },
        {
            "location": "74/TALK",
            "narrator": "小夜",
            "text": "ソウサクがどうのこうの\n言ってたみたいだけど？",
            "zh": "她刚才好像说了什么\n“搜索”来着？",
            "narrator_zh": "小夜"
        },
        {
            "location": "76/TALK",
            "narrator": "神楽",
            "text": "そ、ソウサク！\nそうなんです！！",
            "zh": "对、搜索！\n没错！！",
            "narrator_zh": "神乐"
        },
        {
            "location": "77/TALK",
            "narrator": "神楽",
            "text": "アーヤさんのことを、\nずっと捜索してたん\nですよ。",
            "zh": "我可是一直在\n四处搜索\n绫水呢。",
            "narrator_zh": "神乐"
        },
        {
            "location": "78/TALK",
            "narrator": "アーヤ",
            "text": "ＷＡＶＥで連絡くれれば\nよかったのに。",
            "zh": "在WAVE上联系我\n不就好了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "79/TALK",
            "narrator": "神楽",
            "text": "そ、そうですよね…。",
            "zh": "说、说得也是……",
            "narrator_zh": "神乐"
        },
        {
            "location": "80/TALK",
            "narrator": "小夜",
            "text": "あはは、神楽ちゃんって\n意外とうっかり屋さん\nなのね。",
            "zh": "啊哈哈，神乐原来\n意外地是个\n迷糊虫呢。",
            "narrator_zh": "小夜"
        },
        {
            "location": "82/TALK",
            "narrator": "神楽",
            "text": "あはは…。",
            "zh": "啊哈哈……",
            "narrator_zh": "神乐"
        },
        {
            "location": "83/TALK",
            "narrator": "アーヤ",
            "text": "っていうか、\n用事があるなら\nどうして隠れてたの？",
            "zh": "话说回来，\n既然有事找我，\n为什么要躲着？",
            "narrator_zh": "绫水"
        },
        {
            "location": "84/TALK",
            "narrator": "神楽",
            "text": "そ、それは…小夜さんと\nお話し中だったので、\nお邪魔になるかと…。",
            "zh": "那、那是因为……你正在和\n小夜说话，我怕\n打扰到你们……",
            "narrator_zh": "神乐"
        },
        {
            "location": "85/TALK",
            "narrator": "小夜",
            "text": "邪魔なんて思わないって。\n神楽ちゃん、気にし過ぎ。",
            "zh": "怎么会觉得打扰呢。\n神乐，你想太多了。",
            "narrator_zh": "小夜"
        },
        {
            "location": "86/TALK",
            "narrator": "アーヤ",
            "text": "そうよ。\n大したこと話してた\nわけじゃないんだし。",
            "zh": "就是呀。\n又不是在聊什么\n了不得的事。",
            "narrator_zh": "绫水"
        },
        {
            "location": "88/TALK",
            "narrator": "小夜",
            "text": "ちょ、それ酷くない！？",
            "zh": "喂，这说法太过分了吧！？",
            "narrator_zh": "小夜"
        },
        {
            "location": "92/TALK",
            "narrator": "アーヤ",
            "text": "ふふっ、冗談よ。",
            "zh": "呵呵，开玩笑的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "93/TALK",
            "narrator": "神楽",
            "text": "…お二人とも、\n本当に仲がいいんですね。",
            "zh": "……两位的关系\n真是要好呢。",
            "narrator_zh": "神乐"
        },
        {
            "location": "95/TALK",
            "narrator": "小夜",
            "text": "そう？\n普通じゃない？",
            "zh": "是吗？\n挺普通的吧？",
            "narrator_zh": "小夜"
        },
        {
            "location": "98/TALK",
            "narrator": "アーヤ",
            "text": "普通だと思うけど？",
            "zh": "我也觉得挺普通的？",
            "narrator_zh": "绫水"
        },
        {
            "location": "99/TALK",
            "narrator": "神楽",
            "text": "そうですか？\nとっても仲がいいように\n見えますけど…。",
            "zh": "是这样吗？\n在我看来关系\n非常要好呢……",
            "narrator_zh": "神乐"
        },
        {
            "location": "100/TALK",
            "narrator": "神楽",
            "text": "そういえば、この前\nガブちゃんもヤキモチ\n焼いてました。",
            "zh": "说起来，前阵子\n加布也\n吃醋了呢。",
            "narrator_zh": "神乐"
        },
        {
            "location": "101/TALK",
            "narrator": "神楽",
            "text": "アーヤさんは大学の\nお友達とばっかり\n一緒にいる、って。",
            "zh": "她说绫水总是\n只和大学里的\n朋友待在一起。",
            "narrator_zh": "神乐"
        },
        {
            "location": "103/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィがヤキモチ？\nまさか。",
            "zh": "加维会吃醋？\n怎么可能。",
            "narrator_zh": "绫水"
        },
        {
            "location": "104/TALK",
            "narrator": "小夜",
            "text": "あはは。\nガブリエラちゃん、\n相変わらずかわいいなぁ。",
            "zh": "啊哈哈。\n加布里埃拉\n还是一如既往地可爱呀。",
            "narrator_zh": "小夜"
        },
        {
            "location": "106/TALK",
            "narrator": "小夜",
            "text": "私と話すのもいいけど、\nあんまし寂しがらせるのは\nよくないわよ？",
            "zh": "虽然和我聊是挺好的，\n不过太让她觉得寂寞\n也不太好哦？",
            "narrator_zh": "小夜"
        },
        {
            "location": "109/TALK",
            "narrator": "アーヤ",
            "text": "なに言ってるの。\nギャヴィとは\n毎日顔合わせてるのよ？",
            "zh": "说什么呢。\n我和加维每天\n都有见面的好不好？",
            "narrator_zh": "绫水"
        },
        {
            "location": "110/TALK",
            "narrator": "小夜",
            "text": "そういうんじゃなくて、\nうーん…なんていえば\nいいのかなぁ…？",
            "zh": "不是那个意思啦，\n嗯……该怎么说\n才好呢……？",
            "narrator_zh": "小夜"
        },
        {
            "location": "111/TALK",
            "narrator": "神楽",
            "text": "お姉ちゃん大好きな妹が\n抱く感情、みたいなもの\nでしょうか？",
            "zh": "大概就像是\n最喜欢姐姐的妹妹\n会抱有的那种心情吧？",
            "narrator_zh": "神乐"
        },
        {
            "location": "113/TALK",
            "narrator": "アーヤ",
            "text": "は？",
            "zh": "哈？",
            "narrator_zh": "绫水"
        },
        {
            "location": "115/TALK",
            "narrator": "神楽",
            "text": "えっと、お姉ちゃんには\nとっても仲のいい友達が\nいたとします。",
            "zh": "呃，打个比方，\n姐姐有一个\n关系非常好的朋友。",
            "narrator_zh": "神乐"
        },
        {
            "location": "116/TALK",
            "narrator": "神楽",
            "text": "すると、妹はお姉ちゃんを\n取られたと思い、不機嫌に\nなっちゃうんです。",
            "zh": "于是妹妹就会觉得\n姐姐被抢走了，\n闹起别扭来。",
            "narrator_zh": "神乐"
        },
        {
            "location": "118/TALK",
            "narrator": "小夜",
            "text": "あ、それわかる！\n私の友達の妹が\nまさにそれだったわ。",
            "zh": "啊，我懂我懂！\n我朋友的妹妹\n就完全是那样呢。",
            "narrator_zh": "小夜"
        },
        {
            "location": "119/TALK",
            "narrator": "アーヤ",
            "text": "それをギャヴィが？\nどうにも信じられないわ。",
            "zh": "加维会那样？\n我怎么也不敢相信。",
            "narrator_zh": "绫水"
        },
        {
            "location": "120/TALK",
            "narrator": "神楽",
            "text": "確かに、ガブちゃんとは\n毎日話してるかも\nしれませんけど。",
            "zh": "确实，你和加布\n也许每天\n都在说话。",
            "narrator_zh": "神乐"
        },
        {
            "location": "121/TALK",
            "narrator": "神楽",
            "text": "小夜さんと話すみたいに、\n対等の立場で話したりは\nしないでしょう？",
            "zh": "但应该不会像和\n小夜聊天这样，\n用平等的立场说话吧？",
            "narrator_zh": "神乐"
        },
        {
            "location": "123/TALK",
            "narrator": "小夜",
            "text": "あ～、そりゃ当然だよ。",
            "zh": "啊～，那当然咯。",
            "narrator_zh": "小夜"
        },
        {
            "location": "124/TALK",
            "narrator": "小夜",
            "text": "アーヤって年下の前だと、\nいっつもいいかっこしか\n見せようとしないし。",
            "zh": "绫水在比自己小的人面前，\n总是只想摆出\n帅气靠谱的样子嘛。",
            "narrator_zh": "小夜"
        },
        {
            "location": "127/TALK",
            "narrator": "アーヤ",
            "text": "ちょ、小夜！\nそんなことないでしょ？",
            "zh": "喂，小夜！\n哪有那回事？",
            "narrator_zh": "绫水"
        },
        {
            "location": "129/TALK",
            "narrator": "小夜",
            "text": "いや、あるから\n神楽ちゃんだって\nこう言ってるんじゃん。",
            "zh": "不，就是有，\n所以连神乐\n都这么说了嘛。",
            "narrator_zh": "小夜"
        },
        {
            "location": "130/TALK",
            "narrator": "神楽",
            "text": "なるほど…。\nアーヤさんは普段から、\nかっこつけていた、と。",
            "zh": "原来如此……\n原来绫水平时\n一直在装酷啊。",
            "narrator_zh": "神乐"
        },
        {
            "location": "131/TALK",
            "narrator": "アーヤ",
            "text": "つけてません！",
            "zh": "才没有装！",
            "narrator_zh": "绫水"
        },
        {
            "location": "134/TALK",
            "narrator": "アーヤ",
            "text": "でも、年長者として\nみんなと同じってわけには\nいかないでしょ？",
            "zh": "不过，作为年长者，\n总不能和大家\n混在一起闹吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "135/TALK",
            "narrator": "アーヤ",
            "text": "だから、年長者らしく\n振る舞おうとはしてるけど\nかっこつけてはいないわ。",
            "zh": "所以，我只是试着\n表现得像个年长者，\n才没有装酷。",
            "narrator_zh": "绫水"
        },
        {
            "location": "136/TALK",
            "narrator": "神楽",
            "text": "…なるほど。\nガブちゃんがヤキモチを\n焼くのもわかりますね。",
            "zh": "……原来如此。\n加布会吃醋\n也就不难理解了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "137/TALK",
            "narrator": "神楽",
            "text": "小夜さんは、アーヤさんが\n普通の大学生でいられる\n相手みたいですし。",
            "zh": "小夜似乎是能让绫水\n做回普通大学生的\n倾诉对象呢。",
            "narrator_zh": "神乐"
        },
        {
            "location": "139/TALK",
            "narrator": "神楽",
            "text": "…でも、ちょっと\n引っかかるところも\nありますけど。",
            "zh": "……不过，也有些\n让我在意的\n地方。",
            "narrator_zh": "神乐"
        },
        {
            "location": "142/TALK",
            "narrator": "アーヤ",
            "text": "引っかかる？",
            "zh": "在意？",
            "narrator_zh": "绫水"
        },
        {
            "location": "143/TALK",
            "narrator": "神楽",
            "text": "はい…お二人のことを\n見ていると、友達って\nいうよりは。",
            "zh": "是的……看着你们两位，\n与其说是\n普通朋友。",
            "narrator_zh": "神乐"
        },
        {
            "location": "144/TALK",
            "narrator": "神楽",
            "text": "なにか、もっと違う\n関係があるようにも\n感じるんです。",
            "zh": "总觉得像是\n还有什么\n更不一样的关系。",
            "narrator_zh": "神乐"
        },
        {
            "location": "146/TALK",
            "narrator": "アーヤ",
            "text": "えっ！？",
            "zh": "诶！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "147/TALK",
            "narrator": "神楽",
            "text": "もしかしてガブちゃん、\nそれに対してヤキモチを\n焼いているのかも…。",
            "zh": "说不定加布，\n其实是在对那种关系\n吃醋……",
            "narrator_zh": "神乐"
        },
        {
            "location": "149/TALK",
            "narrator": "小夜",
            "text": "ああ、もしかしてそれ、\nにんぎょ――",
            "zh": "啊啊，难道说的是那个，\n人偶——",
            "narrator_zh": "小夜"
        },
        {
            "location": "151/TALK",
            "narrator": "アーヤ",
            "text": "なにもないから！\n神楽の勘違いよ！",
            "zh": "什么都没有！\n是神乐搞错了！",
            "narrator_zh": "绫水"
        },
        {
            "location": "153/TALK",
            "narrator": "小夜",
            "text": "…アーヤ、ちょっと。",
            "zh": "……绫水，等一下。",
            "narrator_zh": "小夜"
        },
        {
            "location": "158/TALK",
            "narrator": "アーヤ",
            "text": "え！？\nちょっと、どうしたの？",
            "zh": "诶！？\n等等，怎么了？",
            "narrator_zh": "绫水"
        },
        {
            "location": "164/TALK",
            "narrator": "小夜",
            "text": "…もしかして、アーヤ。\nサークルのこと\nまだみんなに内緒なの？",
            "zh": "……难道说，绫水。\n社团的事\n你还没告诉大家吗？",
            "narrator_zh": "小夜"
        },
        {
            "location": "166/TALK",
            "narrator": "アーヤ",
            "text": "そういうこと。\nだから小夜も\n話し合わせて！",
            "zh": "就是那样。\n所以小夜也\n配合我圆一下！",
            "narrator_zh": "绫水"
        },
        {
            "location": "167/TALK",
            "narrator": "小夜",
            "text": "はいはい…まったく、\n世話焼けるんだから…。",
            "zh": "好好好……真是的，\n真让人操心……",
            "narrator_zh": "小夜"
        },
        {
            "location": "173/TALK",
            "narrator": "神楽",
            "text": "アーヤさんの慌てようと、\n小夜さんとのヒソヒソ話。",
            "zh": "绫水慌张的样子，\n还有和小夜的窃窃私语。",
            "narrator_zh": "神乐"
        },
        {
            "location": "174/TALK",
            "narrator": "神楽",
            "text": "やっぱり、この二人には\nなにか特別な関係性が\nあるのは間違いない！",
            "zh": "果然，这两人之间\n绝对存在什么\n特别的关系！",
            "narrator_zh": "神乐"
        },
        {
            "location": "182/TALK",
            "narrator": "小夜",
            "text": "ごめんね、\nちょっと急な\n連絡事項があって。",
            "zh": "抱歉抱歉，\n有点急事\n要交代一下。",
            "narrator_zh": "小夜"
        },
        {
            "location": "184/TALK",
            "narrator": "神楽",
            "text": "全然お気に\nなさらないでください！",
            "zh": "请完全\n不用介意！",
            "narrator_zh": "神乐"
        },
        {
            "location": "185/TALK",
            "narrator": "神楽",
            "text": "アーヤさんが\n小夜さんとラブラブなのは\nよくわかりましたから！",
            "zh": "我已经完全明白\n绫水和小夜\n恩爱得很了！",
            "narrator_zh": "神乐"
        },
        {
            "location": "188/TALK",
            "narrator": "アーヤ",
            "text": "は！？",
            "zh": "哈！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "189/TALK",
            "narrator": "神楽",
            "text": "でも、ガブちゃんのことも\n気にかけてあげないと、\nフラれちゃいますよ？",
            "zh": "不过，要是不也\n多关心关心加布的话，\n会被甩掉的哦？",
            "narrator_zh": "神乐"
        },
        {
            "location": "192/TALK",
            "narrator": "小夜",
            "text": "あ～、ラブラブなの\nバレちゃったねー。",
            "zh": "啊～，我们这么恩爱\n被发现啦——。",
            "narrator_zh": "小夜"
        },
        {
            "location": "196/TALK",
            "narrator": "アーヤ",
            "text": "ちょ、小夜！！\nなに言ってんのよ！？",
            "zh": "喂，小夜！！\n你在胡说什么呀！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "197/TALK",
            "narrator": "小夜",
            "text": "いや、話し合わせろって\n言われたから…。",
            "zh": "不是，是你叫我\n顺着话圆一下的嘛……",
            "narrator_zh": "小夜"
        },
        {
            "location": "199/TALK",
            "narrator": "アーヤ",
            "text": "卯月に合わせて\nどうするのよ…。",
            "zh": "顺着卯月的话圆\n要怎么收场呀……",
            "narrator_zh": "绫水"
        },
        {
            "location": "201/TALK",
            "narrator": "神楽",
            "text": "えっ？　えっ！？\nまさか、本当にそういう\n関係なんですか！？",
            "zh": "诶？　诶！？\n难道说，你们真的\n是那种关系吗！？",
            "narrator_zh": "神乐"
        },
        {
            "location": "203/TALK",
            "narrator": "アーヤ",
            "text": "ああもう…どうしてこう\n面倒なことになるかな…。",
            "zh": "啊啊真是的……怎么会\n变成这么麻烦的状况……",
            "narrator_zh": "绫水"
        },
        {
            "location": "204/SEL",
            "narrator": "（選択肢）",
            "text": "その通りだって認めちゃえば？",
            "zh": "干脆就承认是那样呗？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "205/SEL",
            "narrator": "（選択肢）",
            "text": "神楽に観察されてるよ",
            "zh": "你正在被神乐观察呢",
            "narrator_zh": "（选项）"
        },
        {
            "location": "206/SEL",
            "narrator": "（選択肢）",
            "text": "禁断の三角関係クルー！？",
            "zh": "禁忌的三角关系要来了！？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "207/ACT",
            "narrator": "",
            "text": "その通りだって認めちゃえば？",
            "zh": "干脆就承认是那样呗？",
            "narrator_zh": ""
        },
        {
            "location": "224/TALK",
            "narrator": "アーヤ",
            "text": "そんなことしたら",
            "zh": "要是那样做",
            "narrator_zh": "绫水"
        },
        {
            "location": "225/TALK",
            "narrator": "アーヤ",
            "text": "余計面倒なことになるから",
            "zh": "只会变得更麻烦",
            "narrator_zh": "绫水"
        },
        {
            "location": "226/TALK",
            "narrator": "アーヤ",
            "text": "第一",
            "zh": "再说了",
            "narrator_zh": "绫水"
        },
        {
            "location": "227/TALK",
            "narrator": "アーヤ",
            "text": "そんな勘違い",
            "zh": "这种误会",
            "narrator_zh": "绫水"
        },
        {
            "location": "228/TALK",
            "narrator": "アーヤ",
            "text": "嬉しくないし",
            "zh": "我才不高兴",
            "narrator_zh": "绫水"
        },
        {
            "location": "229/TALK",
            "narrator": "アーヤ",
            "text": "大体",
            "zh": "而且",
            "narrator_zh": "绫水"
        },
        {
            "location": "230/TALK",
            "narrator": "アーヤ",
            "text": "そうじゃないって",
            "zh": "才不是那样",
            "narrator_zh": "绫水"
        },
        {
            "location": "231/TALK",
            "narrator": "アーヤ",
            "text": "知ってるでしょ？",
            "zh": "你明明知道的吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "239/TALK",
            "narrator": "アーヤ",
            "text": "…まったく。\nこんなの見られたら\n更に誤解されて…。",
            "zh": "……真是的。\n要是被看到这种画面\n更要被误会了……",
            "narrator_zh": "绫水"
        },
        {
            "location": "240/TALK",
            "narrator": "神楽",
            "text": "$handle$さんから\nなにか言われたんですか？",
            "zh": "$handle$刚刚\n跟你说什么了吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "242/TALK",
            "narrator": "アーヤ",
            "text": "えっ！？",
            "zh": "诶！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "243/TALK",
            "narrator": "小夜",
            "text": "$handle$って、\n確かBotだっけ？",
            "zh": "$handle$，\n记得是个Bot来着？",
            "narrator_zh": "小夜"
        },
        {
            "location": "245/TALK",
            "narrator": "アーヤ",
            "text": "あ、えっと…。",
            "zh": "啊，那个……",
            "narrator_zh": "绫水"
        },
        {
            "location": "247/TALK",
            "narrator": "小夜",
            "text": "なになに…。\n『その通りだって\n　認めちゃえば…？』",
            "zh": "我看看……。\n“干脆就承认\n　是那样呗……？”",
            "narrator_zh": "小夜"
        },
        {
            "location": "248/TALK",
            "narrator": "神楽",
            "text": "や、やっぱり！",
            "zh": "果、果然！",
            "narrator_zh": "神乐"
        },
        {
            "location": "249/TALK",
            "narrator": "アーヤ",
            "text": "いや、違うから！\nこれは$handle$が\n勝手に言ってるだけ。",
            "zh": "不是，才不是那样！\n这只是$handle$\n自己瞎说的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "252/TALK",
            "narrator": "アーヤ",
            "text": "私と小夜は、\n本当にただの友達って\nだけだから。",
            "zh": "我和小夜，\n真的只是\n普通朋友而已。",
            "narrator_zh": "绫水"
        },
        {
            "location": "254/TALK",
            "narrator": "小夜",
            "text": "そうそう。\n同じ趣味の同志でも\nあるけどね。",
            "zh": "对对。\n不过也是志同道合的\n同好就是了。",
            "narrator_zh": "小夜"
        },
        {
            "location": "255/TALK",
            "narrator": "神楽",
            "text": "趣味？",
            "zh": "爱好？",
            "narrator_zh": "神乐"
        },
        {
            "location": "258/TALK",
            "narrator": "アーヤ",
            "text": "ちょ、小夜！",
            "zh": "喂，小夜！",
            "narrator_zh": "绫水"
        },
        {
            "location": "260/TALK",
            "narrator": "小夜",
            "text": "えっ！？\n今のもダメなの？",
            "zh": "诶！？\n连刚才那句也不能说吗？",
            "narrator_zh": "小夜"
        },
        {
            "location": "262/TALK",
            "narrator": "神楽",
            "text": "なるほど…。\n友人であり、同じ趣味を\n共有する同志…。",
            "zh": "原来如此……\n既是朋友，又是共享\n同一个爱好的同志……",
            "narrator_zh": "神乐"
        },
        {
            "location": "264/TALK",
            "narrator": "神楽",
            "text": "私達には言えない、\n秘密の趣味を大学の\nお友達と共有する。",
            "zh": "和大学的朋友\n共享一个不能对我们说的\n秘密爱好。",
            "narrator_zh": "神乐"
        },
        {
            "location": "265/TALK",
            "narrator": "神楽",
            "text": "仲間達には見せられない、\nしっかり者のリーダーの\n知られざる趣味とは！？",
            "zh": "不能让同伴们知道、\n靠谱队长\n不为人知的爱好究竟是！？",
            "narrator_zh": "神乐"
        },
        {
            "location": "267/TALK",
            "narrator": "神楽",
            "text": "これは、なにかネタに\n使えるかもしれません！",
            "zh": "这个，说不定能用来\n当什么素材！",
            "narrator_zh": "神乐"
        },
        {
            "location": "271/TALK",
            "narrator": "アーヤ",
            "text": "あのね、卯月。\n今小夜が言ったことは\n気にしないで――",
            "zh": "那个，卯月。\n刚才小夜说的话\n你别放在心上——",
            "narrator_zh": "绫水"
        },
        {
            "location": "273/TALK",
            "narrator": "神楽",
            "text": "大丈夫です！",
            "zh": "没关系！",
            "narrator_zh": "神乐"
        },
        {
            "location": "274/TALK",
            "narrator": "神楽",
            "text": "もうこれ以上、\n私はなにも\nお尋ねしませんから。",
            "zh": "我不会再\n继续追问\n任何事了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "275/TALK",
            "narrator": "アーヤ",
            "text": "えっ？",
            "zh": "诶？",
            "narrator_zh": "绫水"
        },
        {
            "location": "276/TALK",
            "narrator": "神楽",
            "text": "ありがとうございました。\nそれじゃ、また劇場で。",
            "zh": "非常感谢。\n那么，剧场再见。",
            "narrator_zh": "神乐"
        },
        {
            "location": "277/TALK",
            "narrator": "アーヤ",
            "text": "あ、ちょっと卯月。\n用事はなんだったの？",
            "zh": "啊，等一下卯月。\n你到底有什么事来着？",
            "narrator_zh": "绫水"
        },
        {
            "location": "279/TALK",
            "narrator": "神楽",
            "text": "大丈夫です。\nもう解決しましたから！",
            "zh": "没关系。\n已经解决了！",
            "narrator_zh": "神乐"
        },
        {
            "location": "285/TALK",
            "narrator": "アーヤ",
            "text": "…な、なんだったの？",
            "zh": "……什、什么情况啊？",
            "narrator_zh": "绫水"
        },
        {
            "location": "287/TALK",
            "narrator": "小夜",
            "text": "さあ…でも楽しかったし、\nそれでいいんじゃない？",
            "zh": "谁知道呢……不过挺有意思的，\n这样不也挺好吗？",
            "narrator_zh": "小夜"
        },
        {
            "location": "288/ACT",
            "narrator": "",
            "text": "神楽に観察されてるよ",
            "zh": "你正在被神乐观察呢",
            "narrator_zh": ""
        },
        {
            "location": "305/TALK",
            "narrator": "アーヤ",
            "text": "そうみたい",
            "zh": "好像是这样",
            "narrator_zh": "绫水"
        },
        {
            "location": "306/TALK",
            "narrator": "アーヤ",
            "text": "サークルのこととか",
            "zh": "社团的事什么的",
            "narrator_zh": "绫水"
        },
        {
            "location": "307/TALK",
            "narrator": "アーヤ",
            "text": "色々知られちゃうかも",
            "zh": "搞不好全被发现了",
            "narrator_zh": "绫水"
        },
        {
            "location": "309/SEL",
            "narrator": "（選択肢）",
            "text": "反応を見てるだけだと思う",
            "zh": "我觉得她只是在看你的反应",
            "narrator_zh": "（选项）"
        },
        {
            "location": "310/ACT",
            "narrator": "",
            "text": "反応を見てるだけだと思う",
            "zh": "我觉得她只是在看你的反应",
            "narrator_zh": ""
        },
        {
            "location": "312/TALK",
            "narrator": "アーヤ",
            "text": "どういうこと？",
            "zh": "什么意思？",
            "narrator_zh": "绫水"
        },
        {
            "location": "314/SEL",
            "narrator": "（選択肢）",
            "text": "試しに聞いてみれば？",
            "zh": "要不试着问问看？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "315/ACT",
            "narrator": "",
            "text": "試しに聞いてみれば？",
            "zh": "要不试着问问看？",
            "narrator_zh": ""
        },
        {
            "location": "317/TALK",
            "narrator": "アーヤ",
            "text": "よくわからないけど",
            "zh": "虽然不太明白",
            "narrator_zh": "绫水"
        },
        {
            "location": "318/TALK",
            "narrator": "アーヤ",
            "text": "まあ",
            "zh": "不过",
            "narrator_zh": "绫水"
        },
        {
            "location": "319/TALK",
            "narrator": "アーヤ",
            "text": "話の方向変えられるかもしれないし",
            "zh": "也许能把话题岔开",
            "narrator_zh": "绫水"
        },
        {
            "location": "320/TALK",
            "narrator": "アーヤ",
            "text": "聞いてみる",
            "zh": "我问问看",
            "narrator_zh": "绫水"
        },
        {
            "location": "333/TALK",
            "narrator": "アーヤ",
            "text": "…ねえ、卯月。\n私からも聞きたいこと\nあるんだけど。",
            "zh": "……我说，卯月。\n我也有件事\n想问你。",
            "narrator_zh": "绫水"
        },
        {
            "location": "334/TALK",
            "narrator": "神楽",
            "text": "はい、なんですか？",
            "zh": "是，什么事？",
            "narrator_zh": "神乐"
        },
        {
            "location": "335/TALK",
            "narrator": "アーヤ",
            "text": "もしかして…、\n私のこと、さっきから\n観察してた？",
            "zh": "难道说……\n你从刚才起，\n一直在观察我吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "336/TALK",
            "narrator": "神楽",
            "text": "っ！？",
            "zh": "唔！？",
            "narrator_zh": "神乐"
        },
        {
            "location": "340/TALK",
            "narrator": "神楽",
            "text": "え…、えっ？\nな、なんのことでしょう？",
            "zh": "诶……、诶？\n你、你在说什么呀？",
            "narrator_zh": "神乐"
        },
        {
            "location": "342/TALK",
            "narrator": "小夜",
            "text": "か、神楽ちゃん。\nさすがにその反応、\nあからさま過ぎだよ？",
            "zh": "神、神乐。\n你这反应，\n也太明显了吧？",
            "narrator_zh": "小夜"
        },
        {
            "location": "343/TALK",
            "narrator": "アーヤ",
            "text": "やっぱり。\nなにか企んでるんじゃ\nないでしょうね？",
            "zh": "果然。\n你该不会在打什么\n坏主意吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "346/TALK",
            "narrator": "神楽",
            "text": "ま、まさか！\n私はただ、ちょっと\nネタがほしいと思って…。",
            "zh": "怎、怎么会！\n我只是稍微\n想找点点子而已……",
            "narrator_zh": "神乐"
        },
        {
            "location": "347/TALK",
            "narrator": "アーヤ",
            "text": "ネタ？",
            "zh": "点子？",
            "narrator_zh": "绫水"
        },
        {
            "location": "348/TALK",
            "narrator": "神楽",
            "text": "あっ！",
            "zh": "啊！",
            "narrator_zh": "神乐"
        },
        {
            "location": "349/TALK",
            "narrator": "神楽",
            "text": "ち、違うんです！\nネタっていうか、\nきっかけっていうか…。",
            "zh": "不、不是的！\n与其说是点子，\n不如说是契机……",
            "narrator_zh": "神乐"
        },
        {
            "location": "350/TALK",
            "narrator": "神楽",
            "text": "とにかく、いい刺激は\nいただけました！\nそれじゃあ、また劇場で！",
            "zh": "总之，已经获得\n很棒的灵感刺激了！\n那么，剧场见！",
            "narrator_zh": "神乐"
        },
        {
            "location": "357/TALK",
            "narrator": "アーヤ",
            "text": "あ、卯月、待ちなさい！",
            "zh": "啊，卯月，站住！",
            "narrator_zh": "绫水"
        },
        {
            "location": "359/TALK",
            "narrator": "小夜",
            "text": "…行っちゃった。\n結局、なんの用事で\n来たのかしら？",
            "zh": "……走掉了。\n结果，她到底是来\n干嘛的呀？",
            "narrator_zh": "小夜"
        },
        {
            "location": "361/TALK",
            "narrator": "アーヤ",
            "text": "わからないけど、\nロクなことじゃないのは\n確かみたいね。",
            "zh": "不知道，\n但肯定不是什么正经事\n就对了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "362/ACT",
            "narrator": "",
            "text": "禁断の三角関係クルー！？",
            "zh": "禁忌的三角关系要来了！？",
            "narrator_zh": ""
        },
        {
            "location": "379/TALK",
            "narrator": "アーヤ",
            "text": "来ません！",
            "zh": "不会来的！",
            "narrator_zh": "绫水"
        },
        {
            "location": "380/TALK",
            "narrator": "アーヤ",
            "text": "そういう関係じゃないの",
            "zh": "才不是那种关系",
            "narrator_zh": "绫水"
        },
        {
            "location": "381/TALK",
            "narrator": "アーヤ",
            "text": "わかってるでしょ？",
            "zh": "你明明知道的吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "383/SEL",
            "narrator": "（選択肢）",
            "text": "もしかしたらってことも…",
            "zh": "说不定也有可能……",
            "narrator_zh": "（选项）"
        },
        {
            "location": "384/SEL",
            "narrator": "（選択肢）",
            "text": "$me$も話に合わせてみた",
            "zh": "$me$也配合着说了一嘴",
            "narrator_zh": "（选项）"
        },
        {
            "location": "385/ACT",
            "narrator": "",
            "text": "もしかしたらってことも…",
            "zh": "说不定也有可能……",
            "narrator_zh": ""
        },
        {
            "location": "386/TALK",
            "narrator": "アーヤ",
            "text": "絶対ないから",
            "zh": "绝对不可能",
            "narrator_zh": "绫水"
        },
        {
            "location": "387/TALK",
            "narrator": "アーヤ",
            "text": "そもそも",
            "zh": "本来就是",
            "narrator_zh": "绫水"
        },
        {
            "location": "388/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィは仲間で",
            "zh": "加维是同伴",
            "narrator_zh": "绫水"
        },
        {
            "location": "389/TALK",
            "narrator": "アーヤ",
            "text": "小夜は友達",
            "zh": "小夜是朋友",
            "narrator_zh": "绫水"
        },
        {
            "location": "390/TALK",
            "narrator": "アーヤ",
            "text": "大切だけど",
            "zh": "虽然都很重要",
            "narrator_zh": "绫水"
        },
        {
            "location": "391/TALK",
            "narrator": "アーヤ",
            "text": "そう言うのと違うから",
            "zh": "但跟那种关系不一样",
            "narrator_zh": "绫水"
        },
        {
            "location": "392/ACT",
            "narrator": "",
            "text": "$me$も話に合わせてみた",
            "zh": "$me$也配合着说了一嘴",
            "narrator_zh": ""
        },
        {
            "location": "393/TALK",
            "narrator": "アーヤ",
            "text": "$handle$と小夜",
            "zh": "$handle$和小夜",
            "narrator_zh": "绫水"
        },
        {
            "location": "394/TALK",
            "narrator": "アーヤ",
            "text": "気が合いそうね",
            "zh": "好像挺合得来呢",
            "narrator_zh": "绫水"
        },
        {
            "location": "395/TALK",
            "narrator": "アーヤ",
            "text": "でも",
            "zh": "不过",
            "narrator_zh": "绫水"
        },
        {
            "location": "396/TALK",
            "narrator": "アーヤ",
            "text": "お願いだから",
            "zh": "拜托你",
            "narrator_zh": "绫水"
        },
        {
            "location": "397/TALK",
            "narrator": "アーヤ",
            "text": "私の方に合わせて",
            "zh": "请站到我这边来",
            "narrator_zh": "绫水"
        },
        {
            "location": "411/TALK",
            "narrator": "アーヤ",
            "text": "はぁ…。",
            "zh": "哈啊……",
            "narrator_zh": "绫水"
        },
        {
            "location": "412/TALK",
            "narrator": "神楽",
            "text": "あれ？\nアーヤさん、\n大丈夫ですか？",
            "zh": "咦？\n绫水，\n你没事吧？",
            "narrator_zh": "神乐"
        },
        {
            "location": "415/TALK",
            "narrator": "アーヤ",
            "text": "ええ…ちょっと、\nこの会話のノリに\n疲れただけだから…。",
            "zh": "嗯……只是有点\n被这种对话节奏\n搞累了而已……",
            "narrator_zh": "绫水"
        },
        {
            "location": "418/TALK",
            "narrator": "小夜",
            "text": "う～ん、アーヤには\nちょっと苦手なノリ\nだったかしら？",
            "zh": "嗯～，这种玩笑节奏\n对绫水来说\n有点吃不消吗？",
            "narrator_zh": "小夜"
        },
        {
            "location": "419/TALK",
            "narrator": "小夜",
            "text": "次の講義まではまだ\n時間あるし、ちょっと\n食堂で休みましょ。",
            "zh": "离下一节课还有\n点时间，去食堂\n休息一下吧。",
            "narrator_zh": "小夜"
        },
        {
            "location": "422/TALK",
            "narrator": "アーヤ",
            "text": "そうね…。\nちょっと冷たいものでも\n飲みたいわ。",
            "zh": "是啊……\n想喝点\n凉的东西。",
            "narrator_zh": "绫水"
        },
        {
            "location": "423/TALK",
            "narrator": "小夜",
            "text": "疲れてるってことは、\nアイスミルクティー？",
            "zh": "既然累了，那就是\n冰奶茶咯？",
            "narrator_zh": "小夜"
        },
        {
            "location": "424/TALK",
            "narrator": "アーヤ",
            "text": "そうね。",
            "zh": "是啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "425/TALK",
            "narrator": "神楽",
            "text": "つ、疲れてるアーヤさんを\n見ただけで、そんなことが\nわかるなんて…。",
            "zh": "光、光看疲惫的绫水\n一眼，就能知道\n那种事……",
            "narrator_zh": "神乐"
        },
        {
            "location": "427/TALK",
            "narrator": "神楽",
            "text": "ガブちゃんに最強の\nライバル現る！",
            "zh": "加布迎来了\n最强对手！",
            "narrator_zh": "神乐"
        },
        {
            "location": "428/TALK",
            "narrator": "神楽",
            "text": "そう、恋のライバル。\nこれ、もしかしたら\nネタになるかも…。",
            "zh": "没错，情敌。\n这个，说不定\n能拿来当素材……",
            "narrator_zh": "神乐"
        },
        {
            "location": "430/TALK",
            "narrator": "アーヤ",
            "text": "…そういえば、\n私に用事があったんじゃ\nなかった？",
            "zh": "……说起来，\n你不是有事\n找我吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "432/TALK",
            "narrator": "神楽",
            "text": "あ、大丈夫です。\nたった今、最高のものを\nもらったので。",
            "zh": "啊，没关系了。\n就在刚才，我已经拿到\n最棒的东西了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "434/TALK",
            "narrator": "神楽",
            "text": "それじゃあ、失礼します。",
            "zh": "那么，我先告辞了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "441/TALK",
            "narrator": "小夜",
            "text": "…アーヤ、神楽ちゃんに\nなにかあげたの？",
            "zh": "……绫水，你给了\n神乐什么东西吗？",
            "narrator_zh": "小夜"
        },
        {
            "location": "443/TALK",
            "narrator": "アーヤ",
            "text": "さあ…？\nホントに謎の多い子ね…。",
            "zh": "谁知道呢……？\n真是个充满谜团的孩子啊……",
            "narrator_zh": "绫水"
        }
    ]
}
