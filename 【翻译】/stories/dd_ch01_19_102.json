{
    "dir": "chap19/daydra/dd_ch01_19_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "19105",
        "cid": "tsubame",
        "title": "005 メインストーリー",
        "sub_title": "気にしすぎの夏＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "想太多的夏天＜后篇＞"
    },
    "entry": [
        {
            "location": "550/TALK",
            "narrator": "つばめ",
            "text": "…あれ？",
            "zh": "……咦？",
            "narrator_zh": "燕"
        },
        {
            "location": "553/TALK",
            "narrator": "つばめ",
            "text": "って、違うよ！",
            "zh": "不对，不是这样啦！",
            "narrator_zh": "燕"
        },
        {
            "location": "555/TALK",
            "narrator": "雛",
            "text": "うわっ！\nな、なにが違うの？",
            "zh": "哇！\n什、什么不是这样？",
            "narrator_zh": "雏"
        },
        {
            "location": "557/TALK",
            "narrator": "つばめ",
            "text": "だって！",
            "zh": "因为！",
            "narrator_zh": "燕"
        },
        {
            "location": "558/TALK",
            "narrator": "つばめ",
            "text": "ひなこちゃん達が\n大変なのって\nわたし達のせいなのに。",
            "zh": "小雏你们这么辛苦，\n全都是因为\n我们的缘故啊。",
            "narrator_zh": "燕"
        },
        {
            "location": "559/TALK",
            "narrator": "つばめ",
            "text": "それなのに\nわたし全然\n気がつかなくて。",
            "zh": "可我却\n完全没有\n注意到。",
            "narrator_zh": "燕"
        },
        {
            "location": "561/TALK",
            "narrator": "つばめ",
            "text": "なんか、他人事\nみたいなこと\n言っちゃったから…。",
            "zh": "刚才还说了\n那么事不关己的话\n……。",
            "narrator_zh": "燕"
        },
        {
            "location": "562/TALK",
            "narrator": "雛",
            "text": "そんな、気にすること\nないのにー。",
            "zh": "不用在意\n这种事啦——。",
            "narrator_zh": "雏"
        },
        {
            "location": "563/TALK",
            "narrator": "ヒカル",
            "text": "そうですよ。\n無理に強制されてる\nわけじゃないし。",
            "zh": "是啊。\n又不是被迫强拉\n过来的。",
            "narrator_zh": "光"
        },
        {
            "location": "564/TALK",
            "narrator": "ヒカル",
            "text": "僕達がやりたいと\n思って来てる\nだけのことだよ。",
            "zh": "只是我们自己\n想过来帮忙，\n才来的而已哦。",
            "narrator_zh": "光"
        },
        {
            "location": "566/TALK",
            "narrator": "つばめ",
            "text": "それでも、夏休みに\n遠出させちゃって\nごめんね…。",
            "zh": "就算这样，大暑假的\n把你们折腾这么远，\n真是对不起……。",
            "narrator_zh": "燕"
        },
        {
            "location": "568/TALK",
            "narrator": "雛",
            "text": "気にし過ぎ\nだってばー。",
            "zh": "都说你想太多\n啦——。",
            "narrator_zh": "雏"
        },
        {
            "location": "570/TALK",
            "narrator": "つばめ",
            "text": "でも…。",
            "zh": "可是……。",
            "narrator_zh": "燕"
        },
        {
            "location": "572/TALK",
            "narrator": "みやび",
            "text": "…報酬ありやろ？",
            "zh": "……是有报酬的啵？",
            "narrator_zh": "雅"
        },
        {
            "location": "575/TALK",
            "narrator": "雛",
            "text": "えっ！？",
            "zh": "诶！？",
            "narrator_zh": "雏"
        },
        {
            "location": "576/TALK",
            "narrator": "ヒカル",
            "text": "うっ…。",
            "zh": "唔……。",
            "narrator_zh": "光"
        },
        {
            "location": "577/TALK",
            "narrator": "キリト",
            "text": "ギクッ！？",
            "zh": "咯噔！？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "580/TALK",
            "narrator": "みやび",
            "text": "まほさんのことやき、\n多分何かしらの報酬は\nあるんやろ？",
            "zh": "既然是真幌嘛，\n大概总会有\n什么报酬的啵？",
            "narrator_zh": "雅"
        },
        {
            "location": "584/TALK",
            "narrator": "つばめ",
            "text": "え？　そうなの？",
            "zh": "诶？ 是这样吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "585/TALK",
            "narrator": "ヒカル",
            "text": "あはは…、\n実はそうなんです。",
            "zh": "啊哈哈……，\n其实是这样没错。",
            "narrator_zh": "光"
        },
        {
            "location": "586/TALK",
            "narrator": "キリト",
            "text": "こっちにいる間、\n食事に関してだけは\n保障する。",
            "zh": "说是待在这边期间，\n至少吃饭方面\n全包管够。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "587/TALK",
            "narrator": "キリト",
            "text": "美味いものを\n好きなだけ食わせて\nくれるって。",
            "zh": "说是好吃的东西\n随便我们\n吃到饱。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "588/TALK",
            "narrator": "雛",
            "text": "えへへ…この辺って\n三崎マグロっていう\nのが有名でしょ？",
            "zh": "诶嘿嘿……这附近不是\n有个叫三崎金枪鱼\n的特产很有名嘛？",
            "narrator_zh": "雏"
        },
        {
            "location": "589/TALK",
            "narrator": "雛",
            "text": "それをお腹いっぱい\n食べられるのは\n魅力的だなぁ、って。",
            "zh": "能把那个吃个饱，\n感觉还是很有\n吸引力的呀——。",
            "narrator_zh": "雏"
        },
        {
            "location": "591/TALK",
            "narrator": "みやび",
            "text": "…食い物に\n釣られたが！？",
            "zh": "……被吃的\n钓上钩了咩！？",
            "narrator_zh": "雅"
        },
        {
            "location": "593/TALK",
            "narrator": "雛",
            "text": "食べてみたかったん\nです、三崎マグロ！",
            "zh": "就是想吃吃看嘛，\n三崎金枪鱼！",
            "narrator_zh": "雏"
        },
        {
            "location": "595/TALK",
            "narrator": "キリト",
            "text": "大トロ食い放題でも\nいいって言われりゃ\n釣られますって！",
            "zh": "一听说大肥金枪鱼\n随便吃也没关系，\n谁都会上钩吧！",
            "narrator_zh": "圣翔"
        },
        {
            "location": "596/TALK",
            "narrator": "雛",
            "text": "ま、そういうこと\nだから。",
            "zh": "嘛，就是这样\n啦。",
            "narrator_zh": "雏"
        },
        {
            "location": "597/TALK",
            "narrator": "雛",
            "text": "あたし達だって\nただ働き、って\nわけじゃないの。",
            "zh": "我们也并不是\n来打白工的\n哦。",
            "narrator_zh": "雏"
        },
        {
            "location": "598/TALK",
            "narrator": "雛",
            "text": "だからつばめちゃんが\n気にする必要はない、\nってことだよ。",
            "zh": "所以燕根本\n不用放在心上，\n明白了吧。",
            "narrator_zh": "雏"
        },
        {
            "location": "603/TALK",
            "narrator": "真幌",
            "text": "おまえら、\n食事はすんだのか？",
            "zh": "你们几个，\n饭吃完了吗？",
            "narrator_zh": "真幌"
        },
        {
            "location": "607/TALK",
            "narrator": "キリト",
            "text": "あ、東雲教官。\nちょうど終わった\nとこっすよ。",
            "zh": "啊，东云教官。\n我们刚好\n吃完呢。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "608/TALK",
            "narrator": "真幌",
            "text": "よし、ならば\n早速働いてもらうぞ。",
            "zh": "好，那就\n赶紧给我干活。",
            "narrator_zh": "真幌"
        },
        {
            "location": "610/TALK",
            "narrator": "真幌",
            "text": "荷物を持って\n外の車に乗れ。",
            "zh": "拿上行李，\n坐到外面的车上去。",
            "narrator_zh": "真幌"
        },
        {
            "location": "612/TALK",
            "narrator": "ヒカル",
            "text": "わかりました。",
            "zh": "明白了。",
            "narrator_zh": "光"
        },
        {
            "location": "614/TALK",
            "narrator": "ヒカル",
            "text": "では、逢瀬さん、\nみやび先輩。\n僕たちはこれで。",
            "zh": "那么，逢濑，\n雅前辈。\n我们先过去了。",
            "narrator_zh": "光"
        },
        {
            "location": "616/TALK",
            "narrator": "みやび",
            "text": "ん。",
            "zh": "嗯。",
            "narrator_zh": "雅"
        },
        {
            "location": "618/TALK",
            "narrator": "みやび",
            "text": "外食もえいけんど、\nうちに食べに来ても\nえいきね。",
            "zh": "出去吃也得，\n不过来我家里吃\n也得啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "619/TALK",
            "narrator": "キリト",
            "text": "マジっすか！？",
            "zh": "真的吗！？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "620/TALK",
            "narrator": "雛",
            "text": "じゃあ、お夕飯は\n一緒に食べよ、\nつばめちゃん。",
            "zh": "那，晚饭就\n一起吃吧，\n燕。",
            "narrator_zh": "雏"
        },
        {
            "location": "622/TALK",
            "narrator": "つばめ",
            "text": "うん、楽しみに\nしてるね。",
            "zh": "嗯，我等着你们\n哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "625/TALK",
            "narrator": "真幌",
            "text": "ほら、もういいか？\n行くぞ。",
            "zh": "喂，好了没有？\n要走了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "627/TALK",
            "narrator": "雛",
            "text": "あ、はい。\nじゃあ、また夜にね。",
            "zh": "啊，来了。\n那，晚上见啦。",
            "narrator_zh": "雏"
        },
        {
            "location": "651/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "653/TALK",
            "narrator": "みやび",
            "text": "つばめちゃん。\nうちらも食事に\nするがよ。",
            "zh": "燕。\n我们也来吃饭\n咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "654/TALK",
            "narrator": "みやび",
            "text": "用意してくるき、\n座って待っちょれ。",
            "zh": "我去端过来啵，\n坐着等咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "655/TALK",
            "narrator": "つばめ",
            "text": "あ、はい。",
            "zh": "啊，好。",
            "narrator_zh": "燕"
        },
        {
            "location": "658/SEL",
            "narrator": "",
            "text": "雛達が来てくれてよかったね",
            "zh": "小雏她们能来真是太好了",
            "narrator_zh": ""
        },
        {
            "location": "659/ACT",
            "narrator": "",
            "text": "雛達が来てくれてよかったね",
            "zh": "小雏她们能来真是太好了",
            "narrator_zh": ""
        },
        {
            "location": "676/TALK",
            "narrator": "つばめ",
            "text": "ぅん(*´︶`*)",
            "zh": "嗯呀(*´︶`*)",
            "narrator_zh": "燕"
        },
        {
            "location": "678/TALK",
            "narrator": "つばめ",
            "text": "遊ぶ時間作れるかはわからないけど",
            "zh": "虽然不知道能不能抽出时间一起玩",
            "narrator_zh": "燕"
        },
        {
            "location": "679/TALK",
            "narrator": "つばめ",
            "text": "ぉ夕飯だけでも",
            "zh": "哪怕只是晚饭",
            "narrator_zh": "燕"
        },
        {
            "location": "680/TALK",
            "narrator": "つばめ",
            "text": "一緒に取りたぃな(●´ω｀●)ゞｴﾍﾍ",
            "zh": "也想一起吃呀(●´ω｀●)ゞｴﾍﾍ",
            "narrator_zh": "燕"
        },
        {
            "location": "681/TALK",
            "narrator": "つばめ",
            "text": "沢山",
            "zh": "也想聊",
            "narrator_zh": "燕"
        },
        {
            "location": "682/TALK",
            "narrator": "つばめ",
            "text": "ぉ話もしたぃし(´艸`*",
            "zh": "好多好多话呀(´艸`*",
            "narrator_zh": "燕"
        },
        {
            "location": "684/SEL",
            "narrator": "",
            "text": "つばめも訓練頑張れそうだね",
            "zh": "燕训练也能加油了吧",
            "narrator_zh": ""
        },
        {
            "location": "685/ACT",
            "narrator": "",
            "text": "つばめも訓練頑張れそうだね",
            "zh": "燕训练也能加油了吧",
            "narrator_zh": ""
        },
        {
            "location": "687/TALK",
            "narrator": "つばめ",
            "text": "そぅだね",
            "zh": "是呀",
            "narrator_zh": "燕"
        },
        {
            "location": "688/TALK",
            "narrator": "つばめ",
            "text": "ひなこちゃん達が",
            "zh": "因为小雏她们",
            "narrator_zh": "燕"
        },
        {
            "location": "689/TALK",
            "narrator": "つばめ",
            "text": "頑張ってくれてるんだもん(≧ω≦)",
            "zh": "都在那么努力嘛(≧ω≦)",
            "narrator_zh": "燕"
        },
        {
            "location": "690/TALK",
            "narrator": "つばめ",
            "text": "わたしも頑張らなきゃ(๑･ㅂ･)و☆",
            "zh": "我也得加油才行(๑･ㅂ･)و☆",
            "narrator_zh": "燕"
        },
        {
            "location": "701/TALK",
            "narrator": "つばめ",
            "text": "よーし、お昼の訓練も\n頑張ろ！",
            "zh": "好——，下午的训练\n也要加油！",
            "narrator_zh": "燕"
        },
        {
            "location": "712/DIALOG",
            "narrator": "Dialog_chapter_ch01",
            "text": "【MV EXE_GARBiELa】",
            "zh": "【MV EXE_GARBiELa】",
            "narrator_zh": "Dialog_chapter_ch01"
        }
    ]
}
