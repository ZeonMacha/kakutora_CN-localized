        },
        {
            "location": "782/TALK",
            "narrator": "アーヤ",
            "text": "二人とも。",
            "zh": "你们两个。",
            "narrator_zh": "绫水"
        },
        {
            "location": "783/TALK",
            "narrator": "アーヤ",
            "text": "アーケロンに\n何を積んだか\n憶えてる？",
            "zh": "还记得\n古巨龟里\n都装了什么吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "784/TALK",
            "narrator": "ガブリエラ",
            "text": "武器。\n対人用の武器を\n大量に積んだわ。",
            "zh": "武器。\n装了大量的\n对人用武器。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "785/TALK",
            "narrator": "みやび",
            "text": "あとは音羽やね。",
            "zh": "还有音羽咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "786/TALK",
            "narrator": "アーヤ",
            "text": "後は？",
            "zh": "还有呢？",
            "narrator_zh": "绫水"
        },
        {
            "location": "788/TALK",
            "narrator": "みやび",
            "text": "あ。",
            "zh": "啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "789/TALK",
            "narrator": "みやび",
            "text": "元々の装備に\n脱出用のポッドがある\nはずやけんど。",
            "zh": "原有的装备里\n应该有逃生舱\n才对不过。",
            "narrator_zh": "雅"
        },
        {
            "location": "791/TALK",
            "narrator": "ガブリエラ",
            "text": "それ！\nまさに今\n使うものじゃない！？",
            "zh": "就是那个！\n那不正是现在\n该用的东西吗！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "792/TALK",
            "narrator": "アーヤ",
            "text": "じゃあポッドで…。",
            "zh": "那就乘逃生舱……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "794/TALK",
            "narrator": "みやび",
            "text": "けんど、ポッドも\n乗っ取られとる\n可能性がある。",
            "zh": "不过，逃生舱\n也有可能\n被劫持了。",
            "narrator_zh": "雅"
        },
        {
            "location": "795/TALK",
            "narrator": "アーヤ",
            "text": "あ…。",
            "zh": "啊……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "797/TALK",
            "narrator": "ガブリエラ",
            "text": "じゃあここから\n脱出するには\n飛び降りるしかないの？",
            "zh": "那想从这里\n逃出去的话，\n就只有跳车了吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "800/TALK",
            "narrator": "アーヤ",
            "text": "１２０キロ出てるのよ？\nそんなことしたら…！",
            "zh": "时速可是有 120 公里哦？\n要是真那么做……！",
            "narrator_zh": "绫水"
        },
        {
            "location": "802/TALK",
            "narrator": "ガブリエラ",
            "text": "そんな……。\n$handle$と約束した\nばかりなのに……。",
            "zh": "怎么会……。\n明明才刚和$handle$\n约定好……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "803/TALK",
            "narrator": "アーヤ",
            "text": "あ！",
            "zh": "啊！",
            "narrator_zh": "绫水"
        },
        {
            "location": "806/TALK",
            "narrator": "アーヤ",
            "text": "トライコネクト！\nこれを脱出の手段に\n使えないかしら？",
            "zh": "Tri-Connect！\n能不能用它\n当作脱身的手段？",
            "narrator_zh": "绫水"
        },
        {
            "location": "808/TALK",
            "narrator": "ガブリエラ",
            "text": "え？\nそんなことできるの？",
            "zh": "欸？\n那种事也能做到吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "809/TALK",
            "narrator": "みやび",
            "text": "…確かに。\n今ならできるね。",
            "zh": "……确实。\n现在的话做得到咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "810/TALK",
            "narrator": "みやび",
            "text": "音羽用にシステムを\n改造したき。",
            "zh": "毕竟为了音羽\n把系统改造过了啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "811/TALK",
            "narrator": "みやび",
            "text": "けんど、それだけ\nやったら敵の目を\n欺けんかもしれん。",
            "zh": "不过，光靠那样的话\n可能瞒不过\n敌人的眼睛。",
            "narrator_zh": "雅"
        },
        {
            "location": "813/TALK",
            "narrator": "ガブリエラ",
            "text": "敵の目を逸らさせれば\nいいのよね。\nだったら……。",
            "zh": "只要把敌人的视线\n引开就行了，对吧。\n那……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "815/TALK",
            "narrator": "ガブリエラ",
            "text": "それなら脱出ポッドを\n使うのはどう？",
            "zh": "用那个逃生舱\n怎么样？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "817/TALK",
            "narrator": "アーヤ",
            "text": "…いい手ね。私達が\n乗ってると思わせれば\nいいんじゃない。",
            "zh": "……好主意。只要让敌人\n以为我们坐在里面\n不就行了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "818/TALK",
            "narrator": "みやび",
            "text": "さすがに爆発は\nさせられんかね。",
            "zh": "总不能让它\n爆炸吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "819/TALK",
            "narrator": "ガブリエラ",
            "text": "ポッドを？",
            "zh": "逃生舱吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "820/TALK",
            "narrator": "みやび",
            "text": "ただ射出された\nだけやったら\nすぐに鹵獲されるき。",
            "zh": "毕竟要是光弹射出去，\n马上就会被\n缴获啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "822/TALK",
            "narrator": "みやび",
            "text": "爆発できるなら\n現場の混乱も狙えるし。",
            "zh": "要是能炸掉的话\n还能在现场制造混乱。",
            "narrator_zh": "雅"
        },
        {
            "location": "823/TALK",
            "narrator": "アーヤ",
            "text": "救命のためのものだから\nそう簡単には\n壊せないわ。",
            "zh": "那是救生用的设备，\n没那么容易\n破坏掉的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "825/TALK",
            "narrator": "ガブリエラ",
            "text": "確かにその通り。\nでも諦めないで。\n考えて、あたし。",
            "zh": "确实如此。\n但别放弃。\n动动脑筋，我。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "827/TALK",
            "narrator": "ガブリエラ",
            "text": "だったら壊れたように\n見せかければいいのよ。",
            "zh": "那就假装成\n被炸坏了的样子不就好了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "828/TALK",
            "narrator": "ガブリエラ",
            "text": "積み込んだ武器の中に\n発煙手榴弾がある。\nこれを使えばいいわ。",
            "zh": "装进来的武器里有\n发烟手榴弹。\n用这个就行了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "830/TALK",
            "narrator": "みやび",
            "text": "煙はどのくらい\n広がるもんなんかね？",
            "zh": "烟雾大概能\n扩散到多大范围喃？",
            "narrator_zh": "雅"
        },
        {
            "location": "832/TALK",
            "narrator": "ガブリエラ",
            "text": "ここにあるものを\n全部ポッドに\nぶち込んだなら。",
            "zh": "如果把车上的东西\n全都塞进\n逃生舱的话。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "833/TALK",
            "narrator": "ガブリエラ",
            "text": "ざっと１００ｍと\nいったところかしら。",
            "zh": "大概能扩散到\n100 米左右吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "834/TALK",
            "narrator": "アーヤ",
            "text": "そんなに！？",
            "zh": "能有那么多！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "835/TALK",
            "narrator": "みやび",
            "text": "派手やねえ。\n気に入った。",
            "zh": "够拉风咯。\n我喜欢。",
            "narrator_zh": "雅"
        },
        {
            "location": "837/TALK",
            "narrator": "みやび",
            "text": "じゃ、うちは起爆用の\nリモコンでも\n作ろうかね。",
            "zh": "那我去攒个\n起爆用的遥控器\n之类的咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "840/TALK",
            "narrator": "ガブリエラ",
            "text": "発煙手榴弾の\n設置は任せて。",
            "zh": "安放发烟手榴弹的事\n交给我吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "841/TALK",
            "narrator": "アーヤ",
            "text": "じゃあ私は\nトライコネクトの\n確認をしておくわね。",
            "zh": "那我去确认一下\nTri-Connect 的\n状况。",
            "narrator_zh": "绫水"
        },
        {
            "location": "842/TALK",
            "narrator": "ガブリエラ",
            "text": "大丈夫。\nあたしはやれる。\nみんなの役に立てる。",
            "zh": "没问题。\n我做得到。\n我能帮上大家的忙。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "846/TALK",
            "narrator": "ガブリエラ",
            "text": "ねえ",
            "zh": "呐",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "847/TALK",
            "narrator": "ガブリエラ",
            "text": "私もうひとつ",
            "zh": "我还想起了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "848/TALK",
            "narrator": "ガブリエラ",
            "text": "思い出したの",
            "zh": "另一件",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "849/TALK",
            "narrator": "ガブリエラ",
            "text": "ポーランドでのこと",
            "zh": "在波兰时的事",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "851/SEL",
            "narrator": "",
            "text": "どんなこと？",
            "zh": "什么事？",
            "narrator_zh": ""
        },
        {
            "location": "852/SEL",
            "narrator": "",
            "text": "聞いてもいいの？",
            "zh": "可以听吗？",
            "narrator_zh": ""
        },
        {
            "location": "853/SEL",
            "narrator": "",
            "text": "教えてよ",
            "zh": "告诉我吧",
            "narrator_zh": ""
        },
        {
            "location": "854/ACT",
            "narrator": "",
            "text": "どんなこと？",
            "zh": "什么事？",
            "narrator_zh": ""
        },
        {
            "location": "855/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤのこと",
            "zh": "关于绫水的事",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "856/ACT",
            "narrator": "",
            "text": "聞いてもいいの？",
            "zh": "可以听吗？",
            "narrator_zh": ""
        },
        {
            "location": "857/TALK",
            "narrator": "ガブリエラ",
            "text": "もちろんよ",
            "zh": "当然可以",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "858/ACT",
            "narrator": "",
            "text": "教えてよ",
            "zh": "告诉我吧",
            "narrator_zh": ""
        },
        {
            "location": "859/TALK",
            "narrator": "ガブリエラ",
            "text": "聞いて欲しいわ",
            "zh": "我想说给你听",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "862/TALK",
            "narrator": "ガブリエラ",
            "text": "明鏡止水のココロって",
            "zh": "明镜止水的心境",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "863/TALK",
            "narrator": "ガブリエラ",
            "text": "言葉を実感したのは",
            "zh": "真正体会到这句话",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "864/TALK",
            "narrator": "ガブリエラ",
            "text": "決勝戦のアーヤを見た時なの",
            "zh": "是在决赛看到绫水的时候",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "865/TALK",
            "narrator": "ガブリエラ",
            "text": "本当に強い人間は",
            "zh": "真正强大的人",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "866/TALK",
            "narrator": "ガブリエラ",
            "text": "勝ちが絶対に必要な時は",
            "zh": "在非赢不可的时候",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "867/TALK",
            "narrator": "ガブリエラ",
            "text": "凪の心で挑むのよ",
            "zh": "会以风平浪静的心境去迎战",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "869/SEL",
            "narrator": "",
            "text": "そうだね",
            "zh": "是啊",
            "narrator_zh": ""
        },
        {
            "location": "870/SEL",
            "narrator": "",
            "text": "そうなんだ",
            "zh": "原来如此",
            "narrator_zh": ""
        },
        {
            "location": "871/SEL",
            "narrator": "",
            "text": "ガブリエラもその心で挑むんでしょ",
            "zh": "加布里埃拉也会用那样的心境去迎战吧",
            "narrator_zh": ""
        },
        {
            "location": "872/ACT",
            "narrator": "",
            "text": "そうだね",
            "zh": "是啊",
            "narrator_zh": ""
        },
        {
            "location": "873/TALK",
            "narrator": "ガブリエラ",
            "text": "思い出させてくれて",
            "zh": "谢谢你让我想起来",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "874/TALK",
            "narrator": "ガブリエラ",
            "text": "ありがとう$marzanna$",
            "zh": "$marzanna$",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "875/ACT",
            "narrator": "",
            "text": "そうなんだ",
            "zh": "原来如此",
            "narrator_zh": ""
        },
        {
            "location": "876/TALK",
            "narrator": "ガブリエラ",
            "text": "そういうものよね",
            "zh": "就是那样的东西呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "877/TALK",
            "narrator": "ガブリエラ",
            "text": "$marzanna$がいなかったら",
            "zh": "要是没有$marzanna$在",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "878/TALK",
            "narrator": "ガブリエラ",
            "text": "思い出せなかったわ",
            "zh": "我大概想不起来了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "879/ACT",
            "narrator": "",
            "text": "ガブリエラもその心で挑むんでしょ",
            "zh": "加布里埃拉也会用那样的心境去迎战吧",
            "narrator_zh": ""
        },
        {
            "location": "880/TALK",
            "narrator": "ガブリエラ",
            "text": "当然よ",
            "zh": "那当然",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "881/TALK",
            "narrator": "ガブリエラ",
            "text": "まだまだアーヤの境地には",
            "zh": "虽然我还远达不到",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "883/TALK",
            "narrator": "ガブリエラ",
            "text": "なれないけど",
            "zh": "绫水那样的境界",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "918/TALK",
            "narrator": "ガブリエラ",
            "text": "みやび、準備は\nどうなのよ？",
            "zh": "雅，准备\n得怎么样了？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "920/TALK",
            "narrator": "みやび",
            "text": "脱出ポッドの\n射出準備ならとっくに\nできちゅうき。",
            "zh": "逃生舱的\n弹射准备\n早就搞定啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "921/TALK",
            "narrator": "みやび",
            "text": "それより二人は\nコネクトこじゃんと\nせんといかんよ。",
            "zh": "比起那个，你们两个\n连接可要狠狠地\n给我搞定咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "922/TALK",
            "narrator": "アーヤ",
            "text": "もちろんよ。",
            "zh": "那是当然。",
            "narrator_zh": "绫水"
        },
        {
            "location": "923/TALK",
            "narrator": "ガブリエラ",
            "text": "当たり前でしょ。",
            "zh": "这不是废话嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "924/TALK",
            "narrator": "アーヤ",
            "text": "それよりやっぱり\nスピードを落とす気は\nないみたいよ。",
            "zh": "话说回来，看来对方\n果然一点都没有\n减速的意思。",
            "narrator_zh": "绫水"
        },
        {
            "location": "925/TALK",
            "narrator": "アーヤ",
            "text": "このまま文京ドームに\n突っ込ませる気\n満々ね。",
            "zh": "是铁了心要让车\n就这么直接撞进\n文京穹顶啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "926/TALK",
            "narrator": "みやび",
            "text": "脱出のタイミングは\nさっきの打ち合わせ\n通りに頼むちや。",
            "zh": "脱身的时机\n就照刚才商量好的\n拜托你们咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "927/TALK",
            "narrator": "ガブリエラ",
            "text": "オッケー。",
            "zh": "OK。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "928/TALK",
            "narrator": "アーヤ",
            "text": "何かあったら\nフォローするわ。",
            "zh": "要是出什么状况\n我会掩护你们的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "929/TALK",
            "narrator": "アーヤ",
            "text": "でも私、二人のこと\n信じてるから。",
            "zh": "不过，我可是\n很相信你们两个的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "931/TALK",
            "narrator": "みやび",
            "text": "…泣かせるね。\nさすがはリーダーやき。",
            "zh": "……真让人感动咯。\n不愧是队长啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "932/TALK",
            "narrator": "アーヤ",
            "text": "からかわないで。",
            "zh": "别拿我打趣了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "938/TALK",
            "narrator": "みやび",
            "text": "…ＧＰＳ脱出目標まで\n１００ｍ。",
            "zh": "……距离 GPS 脱身目标\n还有 100 米。",
            "narrator_zh": "雅"
        },
        {
            "location": "939/TALK",
            "narrator": "みやび",
            "text": "５０ｍ。",
            "zh": "50 米。",
            "narrator_zh": "雅"
        },
        {
            "location": "941/TALK",
            "narrator": "ガブリエラ",
            "text": "絶対にまた\n生きて会いましょう\n$handle$。",
            "zh": "一定要再\n活着相见啊，\n$handle$。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "942/TALK",
            "narrator": "みやび",
            "text": "３０ｍ。",
            "zh": "30 米。",
            "narrator_zh": "雅"
        },
        {
            "location": "943/TALK",
            "narrator": "みやび",
            "text": "２０ｍ。",
            "zh": "20 米。",
            "narrator_zh": "雅"
        },
        {
            "location": "944/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしの神様。\nそれから――",
