{
    "dir": "chap09/daydra/dd_ch04_09_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "9405",
        "cid": "miyabi",
        "title": "005 メインストーリー",
        "sub_title": "コイガサキの日常＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "恋之崎的日常＜后篇＞"
    },
    "entry": [
        {
            "location": "371/SCENARIO",
            "narrator": "",
            "text": "コイガサキの日常",
            "zh": "恋之崎的日常",
            "narrator_zh": ""
        },
        {
            "location": "386/TALK",
            "narrator": "みやび",
            "text": "結局授業に出ることに\nしてもうたけんど…。",
            "zh": "结果最后还是决定\n去上课了……",
            "narrator_zh": "雅"
        },
        {
            "location": "389/TALK",
            "narrator": "女子高校生Ａ",
            "text": "…あ、あの！\n恋ヶ崎さん…。",
            "zh": "……那、那个！\n恋之崎……。",
            "narrator_zh": "女高中生Ａ"
        },
        {
            "location": "392/TALK",
            "narrator": "みやび",
            "text": "ん？　どうしたが？",
            "zh": "嗯？　怎么啦？",
            "narrator_zh": "雅"
        },
        {
            "location": "393/TALK",
            "narrator": "女子高校生Ａ",
            "text": "あ、ううん。\n大したことじゃないん\nだけど――",
            "zh": "啊，不是。\n也不是什么大事，\n就是——",
            "narrator_zh": "女高中生Ａ"
        },
        {
            "location": "394/TALK",
            "narrator": "女子高校生Ａ",
            "text": "今日は恋ヶ崎さんが\nいてくれて、\nよかったな、って…。",
            "zh": "今天恋之崎在，\n真是太好了，\n就是想说这个……",
            "narrator_zh": "女高中生Ａ"
        },
        {
            "location": "395/TALK",
            "narrator": "みやび",
            "text": "…うち、そんなに\nサボっちょるわけや\nないけんど？",
            "zh": "……我也没有\n翘课翘到\n那种地步，是没是？",
            "narrator_zh": "雅"
        },
        {
            "location": "396/TALK",
            "narrator": "女子高校生Ａ",
            "text": "そ、そうじゃないの。\n出動がなくてよかった\nってことよ。",
            "zh": "不、不是那个意思。\n我是说，今天没有\n出动真是太好了。",
            "narrator_zh": "女高中生Ａ"
        },
        {
            "location": "398/TALK",
            "narrator": "女子高校生Ａ",
            "text": "ほら、今日の課題は\n二人ペアになって顔を\n描くってのだから――",
            "zh": "你看，今天的课题\n是两人一组\n画脸来着——",
            "narrator_zh": "女高中生Ａ"
        },
        {
            "location": "399/TALK",
            "narrator": "女子高校生Ａ",
            "text": "もしいなかったら、\nまた私だけ、相手が\nいなくて困ってたかも。",
            "zh": "你要是不在的话，\n可能又只剩我一个人\n没有搭档，很发愁了。",
            "narrator_zh": "女高中生Ａ"
        },
        {
            "location": "401/TALK",
            "narrator": "みやび",
            "text": "うむ、うちもそれを\n気にしちょったぞね。",
            "zh": "嗯，这个我也\n一直很在意咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "404/TALK",
            "narrator": "みやび",
            "text": "そんなことで美術の点数\n悪くされたら、うちも\n後味わるいしね。",
            "zh": "要是因为这个美术分数\n被打低了，我心里\n也不舒服嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "405/TALK",
            "narrator": "女子高校生Ａ",
            "text": "あはは、\nさすがにそんな事には\nならないと思うけど――",
            "zh": "啊哈哈，\n应该不至于\n到那种地步——",
            "narrator_zh": "女高中生Ａ"
        },
        {
            "location": "406/TALK",
            "narrator": "女子高校生Ａ",
            "text": "とにかく、いてくれて\n嬉しいってこと。\nほら、描いちゃお。",
            "zh": "总之就是说，\n你在让我很开心。\n来，开画吧。",
            "narrator_zh": "女高中生Ａ"
        },
        {
            "location": "407/TALK",
            "narrator": "みやび",
            "text": "ん…",
            "zh": "嗯…",
            "narrator_zh": "雅"
        },
        {
            "location": "408/TALK",
            "narrator": "みやび",
            "text": "…………まあ。",
            "zh": "…………也好。",
            "narrator_zh": "雅"
        },
        {
            "location": "409/TALK",
            "narrator": "みやび",
            "text": "予想通り、\n結果オーライっちゅう\nことやね。",
            "zh": "和预想的一样，\n最后结果是好的，\n就是这么回事咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "425/TALK",
            "narrator": "女子高校生Ａ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "女高中生Ａ"
        },
        {
            "location": "426/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "427/TALK",
            "narrator": "女子高校生Ａ",
            "text": "そういえばさ、\n気になってたことが\nあるんだけど。",
            "zh": "说起来啊，\n有件事我一直\n有点在意。",
            "narrator_zh": "女高中生Ａ"
        },
        {
            "location": "428/TALK",
            "narrator": "みやび",
            "text": "好きな食べ物は\n洋菓子や。",
            "zh": "喜欢的食物是\n西点。",
            "narrator_zh": "雅"
        },
        {
            "location": "429/TALK",
            "narrator": "女子高校生Ａ",
            "text": "そうじゃなくて…、\nほら、さっきの話に\n少し戻るけど――",
            "zh": "不是问这个……\n就是，稍微说回\n刚才的话题——",
            "narrator_zh": "女高中生Ａ"
        },
        {
            "location": "430/TALK",
            "narrator": "女子高校生Ａ",
            "text": "恋ヶ崎さんって、\n時々出動以外でも\nいない時あるでしょ？",
            "zh": "恋之崎你啊，\n有时候不出动\n也不在的吧？",
            "narrator_zh": "女高中生Ａ"
        },
        {
            "location": "431/TALK",
            "narrator": "女子高校生Ａ",
            "text": "あれって、やっぱり\nサボり？",
            "zh": "那种时候，\n果然是翘课？",
            "narrator_zh": "女高中生Ａ"
        },
        {
            "location": "432/TALK",
            "narrator": "みやび",
            "text": "んー…まあ、そういう\nことやね。",
            "zh": "嗯——…嘛，\n就是这么回事咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "433/TALK",
            "narrator": "女子高校生Ａ",
            "text": "そうなんだ…。\nでも、サボって\nどこか行くの？",
            "zh": "这样啊……\n那翘课的时候\n都去哪里？",
            "narrator_zh": "女高中生Ａ"
        },
        {
            "location": "434/TALK",
            "narrator": "女子高校生Ａ",
            "text": "まさか、溜まり場に\n行くようなタイプには\n見えないし。",
            "zh": "毕竟你看起来\n不像会去\n据点混的人。",
            "narrator_zh": "女高中生Ａ"
        },
        {
            "location": "435/TALK",
            "narrator": "みやび",
            "text": "そういうタイプや\nないきね…。",
            "zh": "我不是那种\n类型的啵……",
            "narrator_zh": "雅"
        },
        {
            "location": "437/TALK",
            "narrator": "女子高校生Ａ",
            "text": "それじゃあ、\nサボッてどこに\n行くの？",
            "zh": "那翘课的时候，\n到底是去\n哪里？",
            "narrator_zh": "女高中生Ａ"
        },
        {
            "location": "438/TALK",
            "narrator": "みやび",
            "text": "溜まり場じゃない、\n静かなとこやね。",
            "zh": "不是据点，\n是安静的地方咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "439/TALK",
            "narrator": "女子高校生Ａ",
            "text": "そ、そっか…。",
            "zh": "是、是吗……",
            "narrator_zh": "女高中生Ａ"
        },
        {
            "location": "440/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "441/TALK",
            "narrator": "女子高校生Ａ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "女高中生Ａ"
        },
        {
            "location": "442/TALK",
            "narrator": "女子高校生Ａ",
            "text": "…ふふっ、わかった。\n恋ヶ崎さんが\n行くとこって――",
            "zh": "……呵呵，我知道了。\n恋之崎你去的\n地方是——",
            "narrator_zh": "女高中生Ａ"
        },
        {
            "location": "444/TALK",
            "narrator": "女子高校生Ａ",
            "text": "ズバリ、\n彼氏の家でしょ？",
            "zh": "一针见血——\n是男朋友家吧？",
            "narrator_zh": "女高中生Ａ"
        },
        {
            "location": "445/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "446/TALK",
            "narrator": "女子高校生Ａ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "女高中生Ａ"
        },
        {
            "location": "447/TALK",
            "narrator": "みやび",
            "text": "んー…彼氏なぁ…。",
            "zh": "嗯——…男朋友啊……",
            "narrator_zh": "雅"
        },
        {
            "location": "449/TALK",
            "narrator": "みやび",
            "text": "…うちが彼氏の\n家に行くと思っちゅう\nんは――",
            "zh": "……你觉得我会\n去男朋友家里，\n是因为——",
            "narrator_zh": "雅"
        },
        {
            "location": "450/TALK",
            "narrator": "みやび",
            "text": "つまり、うちが男に\n興味がある思うてる\nからか？",
            "zh": "就是说，你觉得\n我对男人有\n兴趣，是没是？",
            "narrator_zh": "雅"
        },
        {
            "location": "452/TALK",
            "narrator": "女子高校生Ａ",
            "text": "え？",
            "zh": "诶？",
            "narrator_zh": "女高中生Ａ"
        },
        {
            "location": "454/TALK",
            "narrator": "みやび",
            "text": "いや…男よりも女に\n興味があるっちゅう\n可能性もあるやろ？",
            "zh": "不……也有可能\n比起男人，我对\n女人更有兴趣吧？",
            "narrator_zh": "雅"
        },
        {
            "location": "455/TALK",
            "narrator": "女子高校生Ａ",
            "text": "えっ！？",
            "zh": "诶！？",
            "narrator_zh": "女高中生Ａ"
        },
        {
            "location": "457/TALK",
            "narrator": "みやび",
            "text": "ほれ、早く描かんと\nいつまでも終わらん\nがよ。",
            "zh": "喏，不快点画，\n到什么时候\n都完不成哦。",
            "narrator_zh": "雅"
        },
        {
            "location": "459/TALK",
            "narrator": "女子高校生Ａ",
            "text": "え、あ、ああ…、\nそう、だね…。",
            "zh": "诶、啊、啊……\n是、是啊……",
            "narrator_zh": "女高中生Ａ"
        },
        {
            "location": "461/TALK",
            "narrator": "女子高校生Ａ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "女高中生Ａ"
        },
        {
            "location": "463/TALK",
            "narrator": "みやび",
            "text": "…うちを慌てさせよう\n思うて言うたようや\nけんど――",
            "zh": "……看起来你是想\n让我慌张才说的，\n不过——",
            "narrator_zh": "雅"
        },
        {
            "location": "464/TALK",
            "narrator": "みやび",
            "text": "まだまだ甘いなぁ。",
            "zh": "你还嫩得很啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "480/TALK",
            "narrator": "みやび",
            "text": "ふぅ…ただいま。",
            "zh": "呼……我回来了。",
            "narrator_zh": "雅"
        },
        {
            "location": "481/TALK",
            "narrator": "みやび",
            "text": "…とりあえず、\n汗流すか。",
            "zh": "……总之先，\n流一身汗吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "499/TALK",
            "narrator": "みやび",
            "text": "ふぅ…。",
            "zh": "呼……。",
            "narrator_zh": "雅"
        },
        {
            "location": "500/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "502/TALK",
            "narrator": "みやび",
            "text": "一息ついたら、\n夕飯作るん面倒に\nなってきたな…。",
            "zh": "一歇下来，\n做晚饭就觉得\n麻烦起来了……",
            "narrator_zh": "雅"
        },
        {
            "location": "503/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "505/TALK",
            "narrator": "みやび",
            "text": "夕飯は外でラーメン。\n自炊は実家に帰りまし\nた、と…。",
            "zh": "晚饭在外面吃拉面。\n自炊嘛，就写回老家\n吃了，如此这般……",
            "narrator_zh": "雅"
        },
        {
            "location": "506/TALK",
            "narrator": "みやび",
            "text": "…ちゃっちゃと\n着替えて食いに\n行くか。",
            "zh": "……赶紧换好衣服，\n出门去\n吃吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "507/SEL",
            "narrator": "",
            "text": "今度は本当なんだ？",
            "zh": "这次说的是真的？",
            "narrator_zh": ""
        },
        {
            "location": "508/ACT",
            "narrator": "",
            "text": "今度は本当なんだ？",
            "zh": "这次说的是真的？",
            "narrator_zh": ""
        },
        {
            "location": "528/TALK",
            "narrator": "みやび",
            "text": "そこツッコミいるか？",
            "zh": "那里需要吐槽吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "529/TALK",
            "narrator": "みやび",
            "text": "ネット上の呟きで",
            "zh": "网上的发言里",
            "narrator_zh": "雅"
        },
        {
            "location": "530/TALK",
            "narrator": "みやび",
            "text": "本当のことだけ書いてるやつなんぞ",
            "zh": "只写真话的那种家伙",
            "narrator_zh": "雅"
        },
        {
            "location": "531/TALK",
            "narrator": "みやび",
            "text": "果たしてどれだけいるのか？",
            "zh": "到底能有几个咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "532/TALK",
            "narrator": "みやび",
            "text": "適当言って",
            "zh": "随口乱讲",
            "narrator_zh": "雅"
        },
        {
            "location": "533/TALK",
            "narrator": "みやび",
            "text": "キャラ作るんは当然のこと",
            "zh": "立人设是理所当然的",
            "narrator_zh": "雅"
        },
        {
            "location": "535/TALK",
            "narrator": "みやび",
            "text": "純粋な相棒に",
            "zh": "对天真的搭档来说",
            "narrator_zh": "雅"
        },
        {
            "location": "537/TALK",
            "narrator": "みやび",
            "text": "ネットの世界は危険かもしれんぞ",
            "zh": "网络的世界可能很危险哦",
            "narrator_zh": "雅"
        },
        {
            "location": "558/DIALOG",
            "narrator": "Dialog_chapter_ch04",
            "text": "【07 愛，ロボット】",
            "zh": "【07 爱，机器人】",
            "narrator_zh": "Dialog_chapter_ch04"
        }
    ]
}
