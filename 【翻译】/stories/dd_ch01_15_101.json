{
 "dir": "chap15/daydra/dd_ch01_15_101.js",
 "type": "MainStory",
 "info": {
  "story_id": "15102",
  "cid": "tsubame",
  "title": "002 メインストーリー",
  "sub_title": "薄い本の森＜前編＞",
  "title_zh": "002 主线剧情",
  "sub_title_zh": "同人志之森＜前篇＞"
 },
 "entry": [
  {
   "location": "31/TALK",
   "narrator": "神楽",
   "text": "つばめさん！\nこの本なんか\nすごくいいですよ！",
   "zh": "燕！\n这本书\n非常好看哦！",
   "narrator_zh": "神乐"
  },
  {
   "location": "32/TALK",
   "narrator": "神楽",
   "text": "このサークルの本は\nどれもオススメなん\nですけど――",
   "zh": "这个社团的书\n哪本都推荐，\n不过——",
   "narrator_zh": "神乐"
  },
  {
   "location": "33/TALK",
   "narrator": "神楽",
   "text": "特にこの新刊は\nサービスシーン\n満載なんです！",
   "zh": "尤其这本新刊，\n满是福利场面\n哦！",
   "narrator_zh": "神乐"
  },
  {
   "location": "35/TALK",
   "narrator": "つばめ",
   "text": "ちょ！？　この本、\n表紙が裸の女の子\nなんだけど！？",
   "zh": "等！？　这本书，\n封面是裸体的女孩子\n呀！？",
   "narrator_zh": "燕"
  },
  {
   "location": "37/TALK",
   "narrator": "神楽",
   "text": "何言ってるんですか。\nちゃんと水着を\n着てますよ？",
   "zh": "你在说什么。\n好好穿着泳装\n哦？",
   "narrator_zh": "神乐"
  },
  {
   "location": "38/TALK",
   "narrator": "つばめ",
   "text": "これ水着なの！？\n紐にしか見えないん\nだけど…。",
   "zh": "这是泳装！？\n看起来只是几根绳子\n……。",
   "narrator_zh": "燕"
  },
  {
   "location": "40/TALK",
   "narrator": "神楽",
   "text": "じゃあ、こっちの本は\nどうですか？",
   "zh": "那，这边这本\n怎么样？",
   "narrator_zh": "神乐"
  },
  {
   "location": "41/TALK",
   "narrator": "つばめ",
   "text": "…それは普通の\n漫画かな？",
   "zh": "……这是普通的\n漫画吗？",
   "narrator_zh": "燕"
  },
  {
   "location": "42/TALK",
   "narrator": "神楽",
   "text": "表紙だけだと\nそう見えますけど、\n中身は――",
   "zh": "只看封面\n是那样，\n里面——",
   "narrator_zh": "神乐"
  },
  {
   "location": "43/TALK",
   "narrator": "つばめ",
   "text": "も、もういいよぉ！",
   "zh": "好、好了啦！",
   "narrator_zh": "燕"
  },
  {
   "location": "45/TALK",
   "narrator": "神楽",
   "text": "つばめさん、ちょっと\n耐性なさ過ぎですよっ！",
   "zh": "燕，你这\n耐性也太差了呀！",
   "narrator_zh": "神乐"
  },
  {
   "location": "46/TALK",
   "narrator": "神楽",
   "text": "可愛いですけど、\nそれじゃ秋葉原では\n生きていけません！",
   "zh": "是挺可爱的，\n可这样在秋叶原\n活不下去！",
   "narrator_zh": "神乐"
  },
  {
   "location": "49/TALK",
   "narrator": "つばめ",
   "text": "卯月さんは\n慣れ過ぎだと\n思うんだけどなぁ…。",
   "zh": "我觉得卯月\n才是习惯过头了\n呀……。",
   "narrator_zh": "燕"
  },
  {
   "location": "50/TALK",
   "narrator": "つばめ",
   "text": "っていうか、\n思ったことが\nあるんだけど――",
   "zh": "话说，\n我一直有件事\n想说——",
   "narrator_zh": "燕"
  },
  {
   "location": "51/TALK",
   "narrator": "つばめ",
   "text": "卯月さんは、\nこういう本\n持ってるの？",
   "zh": "卯月，\n这种书\n你有吗？",
   "narrator_zh": "燕"
  },
  {
   "location": "52/TALK",
   "narrator": "神楽",
   "text": "いえ、私も買ったことは\nないんです。",
   "zh": "没有，我也\n没买过。",
   "narrator_zh": "神乐"
  },
  {
   "location": "53/TALK",
   "narrator": "神楽",
   "text": "でも、こういう本がある、\nっていうのは、前から\n知ってたので。",
   "zh": "不过，有这种书，\n这件事我以前\n就知道。",
   "narrator_zh": "神乐"
  },
  {
   "location": "54/TALK",
   "narrator": "つばめ",
   "text": "そうなんだ？\nちょっと安心したかも…。",
   "zh": "是这样呀？\n稍微放心了点……。",
   "narrator_zh": "燕"
  },
  {
   "location": "55/TALK",
   "narrator": "つばめ",
   "text": "でも、あれ？\nそれならどうして\nこのお店に来たの？",
   "zh": "可是，咦？\n那为什么\n来这家店？",
   "narrator_zh": "燕"
  },
  {
   "location": "57/TALK",
   "narrator": "神楽",
   "text": "もちろん、つばめさんを\nビックリさせるためです。",
   "zh": "当然是为了\n吓燕一跳。",
   "narrator_zh": "神乐"
  },
  {
   "location": "58/TALK",
   "narrator": "神楽",
   "text": "二人で来る初めての\n秋葉原ですからね。",
   "zh": "这是两个人第一次\n一起来秋叶原呀。",
   "narrator_zh": "神乐"
  },
  {
   "location": "59/TALK",
   "narrator": "神楽",
   "text": "ずっと忘れられない、\n思い出に残るようなものに\nしたかったんです。",
   "zh": "我想让它变成\n一直忘不掉、\n能留下来的回忆。",
   "narrator_zh": "神乐"
  },
  {
   "location": "60/TALK",
   "narrator": "つばめ",
   "text": "もう十分忘れられない\n思い出になったと思うよ。",
   "zh": "已经是忘不掉的\n回忆了呀。",
   "narrator_zh": "燕"
  },
  {
   "location": "61/TALK",
   "narrator": "神楽",
   "text": "そうですか？\nまあ、つばめさんが\nそういうなら…。",
   "zh": "是吗？\n嗯，燕\n这么说的话……。",
   "narrator_zh": "神乐"
  },
  {
   "location": "63/TALK",
   "narrator": "神楽",
   "text": "あっ！",
   "zh": "啊！",
   "narrator_zh": "神乐"
  },
  {
   "location": "64/TALK",
   "narrator": "つばめ",
   "text": "どうしたの？",
   "zh": "怎么了？",
   "narrator_zh": "燕"
  },
  {
   "location": "65/TALK",
   "narrator": "神楽",
   "text": "えっと…実は、とっても\nおすすめな本があるのを\n思い出したんです。",
   "zh": "那个……其实，\n我想起有一本\n非常推荐的书。",
   "narrator_zh": "神乐"
  },
  {
   "location": "66/TALK",
   "narrator": "神楽",
   "text": "探してきますから、\nちょっとだけ\n待っててくださいね。",
   "zh": "我去找，\n你就稍微\n等我一下哦。",
   "narrator_zh": "神乐"
  },
  {
   "location": "69/TALK",
   "narrator": "つばめ",
   "text": "えっ！？\nちょっと、卯月さん！",
   "zh": "诶！？\n等等，卯月！",
   "narrator_zh": "燕"
  },
  {
   "location": "71/TALK",
   "narrator": "つばめ",
   "text": "…こんなところに\n一人だけ残されても、\n困るんだけど…。",
   "zh": "……把我一个人\n留在这种地方，\n我也很为难呀……。",
   "narrator_zh": "燕"
  },
  {
   "location": "75/TALK",
   "narrator": "つばめ",
   "text": "うぅ、どっちを\n見てもエッチな本\nばっかり…。",
   "zh": "呜，不管看哪边\n都是色色的书\n……。",
   "narrator_zh": "燕"
  },
  {
   "location": "78/TALK",
   "narrator": "つばめ",
   "text": "…………。",
   "zh": "…………。",
   "narrator_zh": "燕"
  },
  {
   "location": "80/TALK",
   "narrator": "つばめ",
   "text": "でも、凄いなぁ…。",
   "zh": "不过，好厉害呀……。",
   "narrator_zh": "燕"
  },
  {
   "location": "81/TALK",
   "narrator": "つばめ",
   "text": "これ全部、そういう\n本だなんて…",
   "zh": "这些全部，都是那种\n书……",
   "narrator_zh": "燕"
  },
  {
   "location": "82/SEL",
   "narrator": "",
   "text": "もしかして、興味ある？",
   "zh": "难道，有兴趣？",
   "narrator_zh": ""
  },
  {
   "location": "83/ACT",
   "narrator": "",
   "text": "もしかして、興味ある？",
   "zh": "难道，有兴趣？",
   "narrator_zh": ""
  },
  {
   "location": "100/TALK",
   "narrator": "つばめ",
   "text": "興味ってなに！？(ﾟ△ﾟ;ﾉ)ﾉ",
   "zh": "兴趣是什么呀！？(ﾟ△ﾟ;ﾉ)ﾉ",
   "narrator_zh": "燕"
  },
  {
   "location": "102/SEL",
   "narrator": "",
   "text": "読みたいのかな、と…",
   "zh": "是想读吧，之类的……",
   "narrator_zh": ""
  },
  {
   "location": "103/ACT",
   "narrator": "",
   "text": "読みたいのかな、と…",
   "zh": "是想读吧，之类的……",
   "narrator_zh": ""
  },
  {
   "location": "105/TALK",
   "narrator": "つばめ",
   "text": "違ぅよ！(´ｪ｀；)三(；´ｪ｀)",
   "zh": "不是呀！(´ｪ｀；)三(；´ｪ｀)",
   "narrator_zh": "燕"
  },
  {
   "location": "107/TALK",
   "narrator": "つばめ",
   "text": "わたし",
   "zh": "我",
   "narrator_zh": "燕"
  },
  {
   "location": "108/TALK",
   "narrator": "つばめ",
   "text": "そんなこと思ってなぃよo(*･ﾛ･*)o、",
   "zh": "才没那么想呀o(*･ﾛ･*)o、",
   "narrator_zh": "燕"
  },
  {
   "location": "109/TALK",
   "narrator": "つばめ",
   "text": "ただ",
   "zh": "只是",
   "narrator_zh": "燕"
  },
  {
   "location": "110/TALK",
   "narrator": "つばめ",
   "text": "こんなにたくさん",
   "zh": "这么多",
   "narrator_zh": "燕"
  },
  {
   "location": "111/TALK",
   "narrator": "つばめ",
   "text": "そぅぃぅ本に囲まれたことなぃから(/ω＼)",
   "zh": "被这种书围住还是第一次呀(/ω＼)",
   "narrator_zh": "燕"
  },
  {
   "location": "112/TALK",
   "narrator": "つばめ",
   "text": "ちょっと",
   "zh": "有点",
   "narrator_zh": "燕"
  },
  {
   "location": "115/TALK",
   "narrator": "つばめ",
   "text": "緊張？",
   "zh": "紧张？",
   "narrator_zh": "燕"
  },
  {
   "location": "118/TALK",
   "narrator": "つばめ",
   "text": "ぅぅん",
   "zh": "嗯——",
   "narrator_zh": "燕"
  },
  {
   "location": "119/TALK",
   "narrator": "つばめ",
   "text": "ちょっと違ぅかも(･Д･｀)",
   "zh": "好像有点不一样呀(･Д･｀)",
   "narrator_zh": "燕"
  },
  {
   "location": "120/TALK",
   "narrator": "つばめ",
   "text": "困る？",
   "zh": "为难？",
   "narrator_zh": "燕"
  },
  {
   "location": "121/TALK",
   "narrator": "つばめ",
   "text": "それが近ぃかも(*´︶`*)",
   "zh": "这个比较接近呀(*´︶`*)",
   "narrator_zh": "燕"
  },
  {
   "location": "123/TALK",
   "narrator": "つばめ",
   "text": "でも",
   "zh": "可是",
   "narrator_zh": "燕"
  },
  {
   "location": "126/TALK",
   "narrator": "つばめ",
   "text": "でも",
   "zh": "可是",
   "narrator_zh": "燕"
  },
  {
   "location": "127/TALK",
   "narrator": "つばめ",
   "text": "卯月さん",
   "zh": "卯月",
   "narrator_zh": "燕"
  },
  {
   "location": "128/TALK",
   "narrator": "つばめ",
   "text": "とっても楽しそぅだった(≧艸≦*)",
   "zh": "看起来非常开心呀(≧艸≦*)",
   "narrator_zh": "燕"
  },
  {
   "location": "131/TALK",
   "narrator": "つばめ",
   "text": "ちょっとだけ",
   "zh": "就一点点",
   "narrator_zh": "燕"
  },
  {
   "location": "133/TALK",
   "narrator": "つばめ",
   "text": "読んでみよぅかな？(●´ω｀●)ゞｴﾍﾍ",
   "zh": "要不要读读看呀？(●´ω｀●)ゞｴﾍﾍ",
   "narrator_zh": "燕"
  },
  {
   "location": "134/TALK",
   "narrator": "つばめ",
   "text": "読んでみたら",
   "zh": "读了的话",
   "narrator_zh": "燕"
  },
  {
   "location": "135/TALK",
   "narrator": "つばめ",
   "text": "そんなにえっちじゃないかもしれないしヾ(｡>﹏<｡)ﾉﾞ",
   "zh": "也许没那么色色呀ヾ(｡>﹏<｡)ﾉﾞ",
   "narrator_zh": "燕"
  },
  {
   "location": "136/TALK",
   "narrator": "つばめ",
   "text": "卯月さんと",
   "zh": "和卯月",
   "narrator_zh": "燕"
  },
  {
   "location": "137/TALK",
   "narrator": "つばめ",
   "text": "一緒に話せること",
   "zh": "能一起聊的事",
   "narrator_zh": "燕"
  },
  {
   "location": "138/TALK",
   "narrator": "つばめ",
   "text": "増ぇるし(灬・ω・灬)",
   "zh": "也会变多呀(灬・ω・灬)",
   "narrator_zh": "燕"
  },
  {
   "location": "141/TALK",
   "narrator": "つばめ",
   "text": "でもちょっと",
   "zh": "可是有点",
   "narrator_zh": "燕"
  },
  {
   "location": "144/TALK",
   "narrator": "つばめ",
   "text": "ぅ～ん",
   "zh": "嗯——",
   "narrator_zh": "燕"
  },
  {
   "location": "244/TALK",
   "narrator": "アーヤ",
   "text": "こんにちは、\n$handle$さん。",
   "zh": "你好，\n$handle$。",
   "narrator_zh": "绫水"
  },
  {
   "location": "247/TALK",
   "narrator": "アーヤ",
   "text": "また会えたわね。",
   "zh": "又见面了。",
   "narrator_zh": "绫水"
  },
  {
   "location": "250/SEL",
   "narrator": "",
   "text": "なんでアーヤがいるの！？",
   "zh": "为什么绫水会在！？",
   "narrator_zh": ""
  },
  {
   "location": "251/ACT",
   "narrator": "",
   "text": "なんでアーヤがいるの！？",
   "zh": "为什么绫水会在！？",
   "narrator_zh": ""
  },
  {
   "location": "253/TALK",
   "narrator": "アーヤ",
   "text": "ビックリしたでしょ？",
   "zh": "吓到了吧？",
   "narrator_zh": "绫水"
  },
  {
   "location": "254/TALK",
   "narrator": "アーヤ",
   "text": "ココロの中でもみんなと\n親睦を深めようと思って、\n回ってみることにしたの。",
   "zh": "我想在心里\n也和大家亲近亲近，\n所以决定转转看。",
   "narrator_zh": "绫水"
  },
  {
   "location": "255/TALK",
   "narrator": "アーヤ",
   "text": "せっかく\n行き来できるように\nなったんだしね。",
   "zh": "既然\n已经能来回走了，\n就这么办了。",
   "narrator_zh": "绫水"
  },
  {
   "location": "256/SEL",
   "narrator": "",
   "text": "ココロの中って行き来出来るの！？",
   "zh": "心里也能来回走吗！？",
   "narrator_zh": ""
  },
  {
   "location": "257/ACT",
   "narrator": "",
   "text": "ココロの中って行き来出来るの！？",
   "zh": "心里也能来回走吗！？",
   "narrator_zh": ""
  },
  {
   "location": "259/TALK",
   "narrator": "アーヤ",
   "text": "実は私も驚いてる。",
   "zh": "其实我也很吃惊。",
   "narrator_zh": "绫水"
  },
  {
   "location": "260/TALK",
   "narrator": "アーヤ",
   "text": "いつの間にか、\n普通に行き来できるように\nなっていたのよね。",
   "zh": "不知什么时候，\n已经能正常\n来回走了。",
   "narrator_zh": "绫水"
  },
  {
   "location": "261/TALK",
   "narrator": "アーヤ",
   "text": "とはいっても、\n[ココロゲート]まで\nみたいだけど。",
   "zh": "不过，\n好像只到[心之扉]\n为止。",
   "narrator_zh": "绫水"
  },
  {
   "location": "262/TALK",
   "narrator": "アーヤ",
   "text": "だから今回は、みんなの\n[ココロゲート]にお邪魔\nしようかと思ってる。",
   "zh": "所以这次，我想去\n大家的[心之扉]\n拜访一下。",
   "narrator_zh": "绫水"
  },
  {
   "location": "263/TALK",
   "narrator": "アーヤ",
   "text": "よろしくね。",
   "zh": "请多关照。",
   "narrator_zh": "绫水"
  },
  {
   "location": "264/SEL",
   "narrator": "",
   "text": "なんか不思議な感じ",
   "zh": "有点不可思议",
   "narrator_zh": ""
  },
  {
   "location": "265/SEL",
   "narrator": "",
   "text": "なんか怖い",
   "zh": "有点害怕",
   "narrator_zh": ""
  },
  {
   "location": "266/ACT",
   "narrator": "",
   "text": "なんか不思議な感じ",
   "zh": "有点不可思议",
   "narrator_zh": ""
  },
  {
   "location": "267/TALK",
   "narrator": "アーヤ",
   "text": "ほんとね。\n$chrname$の心の中に私が\nいるのはちょっと変かも。",
   "zh": "真的。\n我在$chrname$的心里，\n也许有点奇怪。",
   "narrator_zh": "绫水"
  },
  {
   "location": "268/ACT",
   "narrator": "",
   "text": "なんか怖い",
   "zh": "有点害怕",
   "narrator_zh": ""
  },
  {
   "location": "269/TALK",
   "narrator": "アーヤ",
   "text": "そうなの？",
   "zh": "是吗？",
   "narrator_zh": "绫水"
  },
  {
   "location": "270/TALK",
   "narrator": "アーヤ",
   "text": "まあ確かに、他の人の\n心の中を侵蝕している\nようにも見えるけど。",
   "zh": "确实，看起来\n也像在侵蚀\n别人的心。",
   "narrator_zh": "绫水"
  },
  {
   "location": "271/TALK",
   "narrator": "アーヤ",
   "text": "でも、扉の外はパブリック\nスペースだから、\nプライバシーは守られる。",
   "zh": "不过，门外面是\n公共空间，\n隐私有保障。",
   "narrator_zh": "绫水"
  },
  {
   "location": "272/TALK",
   "narrator": "アーヤ",
   "text": "私も最初はちょっと\n怖かったけど、そんな感じ\nだから心配しないで。",
   "zh": "我一开始也\n有点怕，不过就是这样，\n所以别担心。",
   "narrator_zh": "绫水"
  },
  {
   "location": "275/TALK",
   "narrator": "アーヤ",
   "text": "ところで、つばめの司書が\n見当たらないんだけど、\nどこにいるか知らない？",
   "zh": "对了，没看到\n燕的司书，\n你知道在哪吗？",
   "narrator_zh": "绫水"
  },
  {
   "location": "276/SEL",
   "narrator": "",
   "text": "更迭されました",
   "zh": "被更迭了",
   "narrator_zh": ""
  },
  {
   "location": "277/ACT",
   "narrator": "",
   "text": "更迭されました",
   "zh": "被更迭了",
   "narrator_zh": ""
  },
  {
   "location": "280/TALK",
   "narrator": "アーヤ",
   "text": "え！？\nなにそれ！\nそんな事ってあるの？",
   "zh": "诶！？\n这是什么！\n还有这种事？",
   "narrator_zh": "绫水"
  },
  {
   "location": "281/TALK",
   "narrator": "アーヤ",
   "text": "それじゃ、これから\nつばめにココロの司書は\nいないってこと？",
   "zh": "那就是说，\n燕以后没有\n心之司书了？",
   "narrator_zh": "绫水"
  },
  {
   "location": "282/SEL",
   "narrator": "",
   "text": "新しい司書が来るらしいよ",
   "zh": "听说会来新司书",
   "narrator_zh": ""
  },
  {
   "location": "283/ACT",
   "narrator": "",
   "text": "新しい司書が来るらしいよ",
   "zh": "听说会来新司书",
   "narrator_zh": ""
  },
  {
   "location": "285/TALK",
   "narrator": "アーヤ",
   "text": "そうなのね。\n本当に、\n人のココロそれぞれね。",
   "zh": "是这样。\n真是，\n人的心各不相同。",
   "narrator_zh": "绫水"
  },
  {
   "location": "286/TALK",
   "narrator": "アーヤ",
   "text": "そんなことが\nあるなんて、夢にも\n思わなかったわ。",
   "zh": "居然有这种事，\n我做梦都\n没想到。",
   "narrator_zh": "绫水"
  },
  {
   "location": "287/TALK",
   "narrator": "アーヤ",
   "text": "でも、そうしたら\n困ったわね。",
   "zh": "不过，这样就\n麻烦了。",
   "narrator_zh": "绫水"
  },
  {
   "location": "288/TALK",
   "narrator": "アーヤ",
   "text": "私はつばめの司書に\n挨拶に来たのにいないし。",
   "zh": "我是来跟燕的司书\n打招呼的，人却不在。",
   "narrator_zh": "绫水"
  },
  {
   "location": "289/TALK",
   "narrator": "アーヤ",
   "text": "貴方はきっと、現実の\nつばめが悩んでるから\nここに来てるんでしょ？",
   "zh": "你一定是因为\n现实里的燕在烦恼，\n才来这里的吧？",
   "narrator_zh": "绫水"
  },
  {
   "location": "290/SEL",
   "narrator": "",
   "text": "そう",
   "zh": "对",
   "narrator_zh": ""
  },
  {
   "location": "291/ACT",
   "narrator": "",
   "text": "そう",
   "zh": "对",
   "narrator_zh": ""
  },
  {
   "location": "293/TALK",
   "narrator": "アーヤ",
   "text": "でも、司書がいなくちゃ\n扉も呼べないものね。",
   "zh": "可是，没有司书，\n门也叫不出来。",
   "narrator_zh": "绫水"
  },
  {
   "location": "294/TALK",
   "narrator": "アーヤ",
   "text": "んー……",
   "zh": "嗯……",
   "narrator_zh": "绫水"
  },
  {
   "location": "295/TALK",
   "narrator": "アーヤ",
   "text": "あ、そうだ！\n私が検索してみようか？\nつばめのココロの扉。",
   "zh": "啊，对了！\n我来搜索看看？\n燕的心之扉。",
   "narrator_zh": "绫水"
  },
  {
   "location": "296/SEL",
   "narrator": "",
   "text": "出来るの！？",
   "zh": "做得到！？",
   "narrator_zh": ""
  },
  {
   "location": "297/SEL",
   "narrator": "",
   "text": "危険だからやめて！",
   "zh": "很危险，快停下！",
   "narrator_zh": ""
  },
  {
   "location": "298/ACT",
   "narrator": "",
   "text": "出来るの！？",
   "zh": "做得到！？",
   "narrator_zh": ""
  },
  {
   "location": "299/TALK",
   "narrator": "アーヤ",
   "text": "ええ、多分。",
   "zh": "嗯，大概。",
   "narrator_zh": "绫水"
  },
  {
   "location": "300/TALK",
   "narrator": "アーヤ",
   "text": "ネットワークが\n切り替わってる\nハズだから……。",
   "zh": "网络应该\n已经切过来了，\n所以……。",
   "narrator_zh": "绫水"
  },
  {
   "location": "302/TALK",
   "narrator": "アーヤ",
   "text": "あ、やっぱり。",
   "zh": "啊，果然。",
   "narrator_zh": "绫水"
  },
  {
   "location": "303/TALK",
   "narrator": "アーヤ",
   "text": "つばめのココロ検索が\n出てきた。",
   "zh": "燕的心搜索\n出来了。",
   "narrator_zh": "绫水"
  },
  {
   "location": "304/SEL",
   "narrator": "",
   "text": "すごい！",
   "zh": "好厉害！",
   "narrator_zh": ""
  },
  {
   "location": "305/SEL",
   "narrator": "",
   "text": "セキュリティユルすぎじゃない？",
   "zh": "安全也太松了吧？",
   "narrator_zh": ""
  },
  {
   "location": "306/ACT",
   "narrator": "",
   "text": "すごい！",
   "zh": "好厉害！",
   "narrator_zh": ""
  },
  {
   "location": "308/TALK",
   "narrator": "アーヤ",
   "text": "ふふ、すごいでしょ。",
   "zh": "呵呵，厉害吧。",
   "narrator_zh": "绫水"
  },
  {
   "location": "309/TALK",
   "narrator": "アーヤ",
   "text": "なんて。\n実はわかってたのよね。",
   "zh": "开玩笑的。\n其实我知道的。",
   "narrator_zh": "绫水"
  },
  {
   "location": "310/TALK",
   "narrator": "アーヤ",
   "text": "司書のコールシステムって\n決められたフォーマットで\n動いてるから。",
   "zh": "司书的呼叫系统，\n是按定好的格式\n在运行的。",
   "narrator_zh": "绫水"
  },
  {
   "location": "311/ACT",
   "narrator": "",
   "text": "セキュリティユルすぎじゃない？",
   "zh": "安全也太松了吧？",
   "narrator_zh": ""
  },
  {
   "location": "312/TALK",
   "narrator": "アーヤ",
   "text": "そんな事ないわよ。\n司書にしかできないもの。",
   "zh": "没有那回事。\n只有司书才做得到。",
   "narrator_zh": "绫水"
  },
  {
   "location": "313/TALK",
   "narrator": "アーヤ",
   "text": "それに、動かせばすぐに\nその世界の司書は\nわかるようになってるし。",
   "zh": "而且，一动起来，\n那个世界的司书\n马上就知道了。",
   "narrator_zh": "绫水"
  },
  {
   "location": "314/SEL",
   "narrator": "",
   "text": "でも$me$にも動かせたよ？",
   "zh": "可是$me$也能开动呀？",
   "narrator_zh": ""
  },
  {
   "location": "315/ACT",
   "narrator": "",
   "text": "でも$me$にも動かせたよ？",
   "zh": "可是$me$也能开动呀？",
   "narrator_zh": ""
  },
  {
   "location": "317/TALK",
   "narrator": "アーヤ",
   "text": "え！？\nそうなの？",
   "zh": "诶！？\n是这样吗？",
   "narrator_zh": "绫水"
  },
  {
   "location": "318/TALK",
   "narrator": "アーヤ",
   "text": "すごい。\n貴方、司書としての\n資格もあるのね。",
   "zh": "好厉害。\n你也有\n司书的资格。",
   "narrator_zh": "绫水"
  },
  {
   "location": "319/SEL",
   "narrator": "",
   "text": "よくわからないけど",
   "zh": "我也说不好",
   "narrator_zh": ""
  },
  {
   "location": "320/ACT",
   "narrator": "",
   "text": "よくわからないけど",
   "zh": "我也说不好",
   "narrator_zh": ""
  },
  {
   "location": "323/ACT",
   "narrator": "",
   "text": "危険だからやめて！",
   "zh": "很危险，快停下！",
   "narrator_zh": ""
  },
  {
   "location": "325/TALK",
   "narrator": "アーヤ",
   "text": "え？\n危険？？\nどうして？",
   "zh": "诶？\n危险？？\n为什么？",
   "narrator_zh": "绫水"
  },
  {
   "location": "326/SEL",
   "narrator": "",
   "text": "アーヤも更迭されるよ！",
   "zh": "绫水也会被更迭的！",
   "narrator_zh": ""
  },
  {
   "location": "327/ACT",
   "narrator": "",
   "text": "アーヤも更迭されるよ！",
   "zh": "绫水也会被更迭的！",
   "narrator_zh": ""
  },
  {
   "location": "329/TALK",
   "narrator": "アーヤ",
   "text": "そうなの？",
   "zh": "是吗？",
   "narrator_zh": "绫水"
  },
  {
   "location": "334/TALK",
   "narrator": "アーヤ",
   "text": "あ。\nメールみたい。",
   "zh": "啊。\n好像是邮件。",
   "narrator_zh": "绫水"
  },
  {
   "location": "337/TALK",
   "narrator": "アーヤ",
   "text": "司書長からね。",
   "zh": "司书长发来的。",
   "narrator_zh": "绫水"
  },
  {
   "location": "338/SEL",
   "narrator": "",
   "text": "そんな人いるの？",
   "zh": "有这样的人吗？",
   "narrator_zh": ""
  },
  {
   "location": "339/ACT",
   "narrator": "",
   "text": "そんな人いるの？",
   "zh": "有这样的人吗？",
   "narrator_zh": ""
  },
  {
   "location": "342/TALK",
   "narrator": "アーヤ",
   "text": "人って言うか、精神？\n人格…ってのも違うし、\n説明しづらいけど。",
   "zh": "说是人，不如说精神？\n人格……也不对，\n不太好解释。",
   "narrator_zh": "绫水"
  },
  {
   "location": "343/TALK",
   "narrator": "アーヤ",
   "text": "……。",
   "zh": "……。",
   "narrator_zh": "绫水"
  },
  {
   "location": "344/TALK",
   "narrator": "アーヤ",
   "text": "つばめのココロの総意から\n連絡があって、今回は私に\n代行して欲しいって。",
   "zh": "燕的心达成了一致，\n联络过来说，这次\n希望我来代班。",
   "narrator_zh": "绫水"
  },
  {
   "location": "345/SEL",
   "narrator": "",
   "text": "そうなんだ！",
   "zh": "是这样！",
   "narrator_zh": ""
  },
  {
   "location": "346/SEL",
   "narrator": "",
   "text": "うそでしょ！",
   "zh": "骗人的吧！",
   "narrator_zh": ""
  },
  {
   "location": "347/ACT",
   "narrator": "",
   "text": "そうなんだ！",
   "zh": "是这样！",
   "narrator_zh": ""
  },
  {
   "location": "348/TALK",
   "narrator": "アーヤ",
   "text": "ええ。\nなので、改めまして――",
   "zh": "嗯。\n所以，重新说——",
   "narrator_zh": "绫水"
  },
  {
   "location": "349/ACT",
   "narrator": "",
   "text": "うそでしょ！",
   "zh": "骗人的吧！",
   "narrator_zh": ""
  },
  {
   "location": "350/TALK",
   "narrator": "アーヤ",
   "text": "嘘なんかつかないわよ。",
   "zh": "我不会说谎。",
   "narrator_zh": "绫水"
  },
  {
   "location": "352/TALK",
   "narrator": "アーヤ",
   "text": "前にも言ったけど、\n司書は本当の事だけを\n伝えるのよ。",
   "zh": "之前也说过，\n司书只传达\n真实的事。",
   "narrator_zh": "绫水"
  },
  {
   "location": "355/TALK",
   "narrator": "アーヤ",
   "text": "知らないと思うけど、\n司書は本当のことしか\n言わないんです。",
   "zh": "你可能不知道，\n司书只会\n说真话。",
   "narrator_zh": "绫水"
  },
  {
   "location": "357/TALK",
   "narrator": "アーヤ",
   "text": "というわけで――",
   "zh": "所以说——",
   "narrator_zh": "绫水"
  },
  {
   "location": "359/TALK",
   "narrator": "アーヤ",
   "text": "つばめの１日司書に\n任命されたアーヤです！\nよろしくね。",
   "zh": "被任命为燕的\n一日司书的绫水！\n请多关照。",
   "narrator_zh": "绫水"
  },
  {
   "location": "360/SEL",
   "narrator": "",
   "text": "お、おう…",
   "zh": "哦、哦……",
   "narrator_zh": ""
  },
  {
   "location": "361/ACT",
   "narrator": "",
   "text": "お、おう…",
   "zh": "哦、哦……",
   "narrator_zh": ""
  },
  {
   "location": "364/TALK",
   "narrator": "アーヤ",
   "text": "それじゃ早速、\n扉をコールするわね。",
   "zh": "那就马上，\n呼叫门吧。",
   "narrator_zh": "绫水"
  },
  {
   "location": "369/TALK",
   "narrator": "アーヤ",
   "text": "オープンプロセス、\n0x218番地から\n0x568番地へ。",
   "zh": "开放进程，\n从0x218地址\n到0x568地址。",
   "narrator_zh": "绫水"
  },
  {
   "location": "384/TALK",
   "narrator": "アーヤ",
   "text": "シーク完了。",
   "zh": "搜索完成。",
   "narrator_zh": "绫水"
  },
  {
   "location": "386/TALK",
   "narrator": "アーヤ",
   "text": "さて、\nどんなことで\n悩んでるのかしら……と。",
   "zh": "那么，\n是在烦恼\n什么……。",
   "narrator_zh": "绫水"
  },
  {
   "location": "388/TALK",
   "narrator": "アーヤ",
   "text": "……。",
   "zh": "……。",
   "narrator_zh": "绫水"
  },
  {
   "location": "389/TALK",
   "narrator": "アーヤ",
   "text": "あー、なるほど。\nそういうお年頃だものね。",
   "zh": "啊，原来如此。\n到了那个年纪了。",
   "narrator_zh": "绫水"
  },
  {
   "location": "390/TALK",
   "narrator": "アーヤ",
   "text": "ここはひとつ、つばめの\nココロが期待してる通り、\n読む方へ導きましょ。",
   "zh": "这里就按\n燕的心所期待的，\n往读的方向引吧。",
   "narrator_zh": "绫水"
  },
  {
   "location": "391/SEL",
   "narrator": "",
   "text": "あー、やっぱり読みたがってたのか",
   "zh": "啊——果然想读呀",
   "narrator_zh": ""
  },
  {
   "location": "392/SEL",
   "narrator": "",
   "text": "アーヤはつばめと同じお年頃のころは、どうだったの？",
   "zh": "绫水在燕这个年纪时，是怎么样的？",
   "narrator_zh": ""
  },
  {
   "location": "393/ACT",
   "narrator": "",
   "text": "あー、やっぱり読みたがってたのか",
   "zh": "啊——果然想读呀",
   "narrator_zh": ""
  },
  {
   "location": "394/TALK",
   "narrator": "アーヤ",
   "text": "まあ、興味が出ちゃうのは\n仕方ないわよね。",
   "zh": "嘛，产生兴趣\n也是没办法。",
   "narrator_zh": "绫水"
  },
  {
   "location": "395/TALK",
   "narrator": "アーヤ",
   "text": "特につばめは、そっちの\n方は遅れてそうだし。",
   "zh": "尤其燕，\n那方面好像比较晚。",
   "narrator_zh": "绫水"
  },
  {
   "location": "396/TALK",
   "narrator": "アーヤ",
   "text": "やっぱりそういう方面も\nちゃんと教えないと\nダメかしら……。",
   "zh": "那方面，\n是不是也得好好教\n才行……。",
   "narrator_zh": "绫水"
  },
  {
   "location": "397/SEL",
   "narrator": "",
   "text": "確かに。危ないよね",
   "zh": "确实。很危险",
   "narrator_zh": ""
  },
  {
   "location": "398/SEL",
   "narrator": "",
   "text": "キマシタワー！！",
   "zh": "来了哇！！",
   "narrator_zh": ""
  },
  {
   "location": "399/ACT",
   "narrator": "",
   "text": "確かに。危ないよね",
   "zh": "确实。很危险",
   "narrator_zh": ""
  },
  {
   "location": "400/TALK",
   "narrator": "アーヤ",
   "text": "そうよ、危ないのよ。",
   "zh": "对，很危险。",
   "narrator_zh": "绫水"
  },
  {
   "location": "401/TALK",
   "narrator": "アーヤ",
   "text": "よくわからない状況で、\nそのうち大変なことに\nなっちゃうかも……。",
   "zh": "在不明白的情况下，\n说不定哪天\n会出事……。",
   "narrator_zh": "绫水"
  },
  {
   "location": "402/TALK",
   "narrator": "アーヤ",
   "text": "やっぱり私がちゃんと\n気をつけるよう\n言わないとダメね。",
   "zh": "果然还是得我\n好好说，让她\n小心才行。",
   "narrator_zh": "绫水"
  },
  {
   "location": "403/TALK",
   "narrator": "アーヤ",
   "text": "でも今はとにかく、\nつばめのココロを\n解決しなくちゃ。",
   "zh": "不过现在总之，\n得解决\n燕的心。",
   "narrator_zh": "绫水"
  },
  {
   "location": "404/ACT",
   "narrator": "",
   "text": "キマシタワー！！",
   "zh": "来了哇！！",
   "narrator_zh": ""
  },
  {
   "location": "405/TALK",
   "narrator": "アーヤ",
   "text": "なぁに？\nキマシタワーって。",
   "zh": "什么？\n来了哇是什么。",
   "narrator_zh": "绫水"
  },
  {
   "location": "406/SEL",
   "narrator": "",
   "text": "手取り足取り教えるんでしょ？",
   "zh": "要手把手教吧？",
   "narrator_zh": ""
  },
  {
   "location": "407/ACT",
   "narrator": "",
   "text": "手取り足取り教えるんでしょ？",
   "zh": "要手把手教吧？",
   "narrator_zh": ""
  },
  {
   "location": "409/TALK",
   "narrator": "アーヤ",
   "text": "なにを！？",
   "zh": "教什么！？",
   "narrator_zh": "绫水"
  },
  {
   "location": "410/TALK",
   "narrator": "アーヤ",
   "text": "単に、大人の交際の\n常識を教えるだけよ。",
   "zh": "只是教她\n成年人交往的常识。",
   "narrator_zh": "绫水"
  },
  {
   "location": "411/TALK",
   "narrator": "アーヤ",
   "text": "今のつばめは\n危なっかしくて、\nボーイフレンドなんて……",
   "zh": "现在的燕\n太让人放心不下，\n男朋友什么的……",
   "narrator_zh": "绫水"
  },
  {
   "location": "412/TALK",
   "narrator": "アーヤ",
   "text": "……貴方もね。",
   "zh": "……你也是。",
   "narrator_zh": "绫水"
  },
  {
   "location": "413/TALK",
   "narrator": "アーヤ",
   "text": "まあとにかく、\n今はつばめのココロを\n解決しなくちゃ。",
   "zh": "总之，\n现在得解决\n燕的心。",
   "narrator_zh": "绫水"
  },
  {
   "location": "415/ACT",
   "narrator": "",
   "text": "アーヤはつばめと同じお年頃のころは、どうだったの？",
   "zh": "绫水在燕这个年纪时，是怎么样的？",
   "narrator_zh": ""
  },
  {
   "location": "417/TALK",
   "narrator": "アーヤ",
   "text": "え？　私？",
   "zh": "诶？　我？",
   "narrator_zh": "绫水"
  },
  {
   "location": "418/TALK",
   "narrator": "アーヤ",
   "text": "私はそのお年頃は\n剣道一直線だったから。",
   "zh": "我那个年纪，\n一门心思在剑道。",
   "narrator_zh": "绫水"
  },
  {
   "location": "419/SEL",
   "narrator": "",
   "text": "本当に？司書は本当の事しか言わないはずだけど？",
   "zh": "真的吗？司书应该只会说真话吧？",
   "narrator_zh": ""
  },
  {
   "location": "420/SEL",
   "narrator": "",
   "text": "流石アーヤ。司書の言う事だし信じるよ",
   "zh": "不愧是绫水。司书说的，我信。",
   "narrator_zh": ""
  },
  {
   "location": "421/ACT",
   "narrator": "",
   "text": "本当に？司書は本当の事しか言わないはずだけど？",
   "zh": "真的吗？司书应该只会说真话吧？",
   "narrator_zh": ""
  },
  {
   "location": "422/TALK",
   "narrator": "アーヤ",
   "text": "本当の事です！",
   "zh": "是真的！",
   "narrator_zh": "绫水"
  },
  {
   "location": "423/TALK",
   "narrator": "アーヤ",
   "text": "一字一句全て、全部\n本当のことよ。失礼ね！",
   "zh": "一字一句，全部\n都是真的。真失礼！",
   "narrator_zh": "绫水"
  },
  {
   "location": "424/ACT",
   "narrator": "",
   "text": "流石アーヤ。司書の言う事だし信じるよ",
   "zh": "不愧是绫水。司书说的，我信。",
   "narrator_zh": ""
  },
  {
   "location": "426/TALK",
   "narrator": "アーヤ",
   "text": "ありがと。",
   "zh": "谢谢。",
   "narrator_zh": "绫水"
  },
  {
   "location": "427/SEL",
   "narrator": "",
   "text": "真面目少女だったんだね",
   "zh": "原来是个认真的女孩",
   "narrator_zh": ""
  },
  {
   "location": "428/SEL",
   "narrator": "",
   "text": "じゃあ、エッチなことに興味があったかを「はい」か「いいえ」で答えて？",
   "zh": "那，对色色的事有没有兴趣，用“是”或者“不是”回答？",
   "narrator_zh": ""
  },
  {
   "location": "429/ACT",
   "narrator": "",
   "text": "真面目少女だったんだね",
   "zh": "原来是个认真的女孩",
   "narrator_zh": ""
  },
  {
   "location": "430/TALK",
   "narrator": "アーヤ",
   "text": "もちろんよ。中学の頃から\n学級委員と生徒会長は\n欠かしたことが無いのよ？",
   "zh": "当然。从中学起，\n班委和学生会长\n就没缺过哦？",
   "narrator_zh": "绫水"
  },
  {
   "location": "431/ACT",
   "narrator": "",
   "text": "じゃあ、エッチなことに興味があったかを「はい」か「いいえ」で答えて？",
   "zh": "那，对色色的事有没有兴趣，用“是”或者“不是”回答？",
   "narrator_zh": ""
  },
  {
   "location": "433/TALK",
   "narrator": "アーヤ",
   "text": "え………",
   "zh": "诶………",
   "narrator_zh": "绫水"
  },
  {
   "location": "434/TALK",
   "narrator": "アーヤ",
   "text": "だからさっき、\n剣道一直線だったって……",
   "zh": "所以刚才说了，\n一门心思在剑道……",
   "narrator_zh": "绫水"
  },
  {
   "location": "435/SEL",
   "narrator": "",
   "text": "答えになってないよ？",
   "zh": "这不算回答吧？",
   "narrator_zh": ""
  },
  {
   "location": "436/ACT",
   "narrator": "",
   "text": "答えになってないよ？",
   "zh": "这不算回答吧？",
   "narrator_zh": ""
  },
  {
   "location": "438/TALK",
   "narrator": "アーヤ",
   "text": "拒否権を発動します！",
   "zh": "我要行使拒绝权！",
   "narrator_zh": "绫水"
  },
  {
   "location": "439/SEL",
   "narrator": "",
   "text": "うぐう",
   "zh": "唔咕",
   "narrator_zh": ""
  },
  {
   "location": "440/SEL",
   "narrator": "",
   "text": "ならば今回はココロの解決に協力しません",
   "zh": "那这次我不协助解决这个心",
   "narrator_zh": ""
  },
  {
   "location": "441/ACT",
   "narrator": "",
   "text": "うぐう",
   "zh": "唔咕",
   "narrator_zh": ""
  },
  {
   "location": "442/TALK",
   "narrator": "アーヤ",
   "text": "ふふーん。",
   "zh": "哼哼。",
   "narrator_zh": "绫水"
  },
  {
   "location": "443/ACT",
   "narrator": "",
   "text": "ならば今回はココロの解決に協力しません",
   "zh": "那这次我不协助解决这个心",
   "narrator_zh": ""
  },
  {
   "location": "445/TALK",
   "narrator": "アーヤ",
   "text": "うわ汚い！",
   "zh": "哇，真脏！",
   "narrator_zh": "绫水"
  },
  {
   "location": "446/SEL",
   "narrator": "",
   "text": "ごく普通の交渉ですけど？",
   "zh": "这只是很普通的交涉吧？",
   "narrator_zh": ""
  },
  {
   "location": "447/ACT",
   "narrator": "",
   "text": "ごく普通の交渉ですけど？",
   "zh": "这只是很普通的交涉吧？",
   "narrator_zh": ""
  },
  {
   "location": "450/TALK",
   "narrator": "アーヤ",
   "text": "………。",
   "zh": "………。",
   "narrator_zh": "绫水"
  },
  {
   "location": "451/TALK",
   "narrator": "アーヤ",
   "text": "……………………………\n……………………………\n…………………………。",
   "zh": "……………………………\n……………………………\n…………………………。",
   "narrator_zh": "绫水"
  },
  {
   "location": "452/TALK",
   "narrator": "アーヤ",
   "text": "……………………………\n……………………………\n……………………はぃ。",
   "zh": "……………………………\n……………………………\n……………………是。",
   "narrator_zh": "绫水"
  },
  {
   "location": "453/SEL",
   "narrator": "",
   "text": "やっぱりエッチだったんだね！！",
   "zh": "果然是色色的呀！！",
   "narrator_zh": ""
  },
  {
   "location": "454/SEL",
   "narrator": "",
   "text": "具体的にはどんなことを？",
   "zh": "具体是什么样的事？",
   "narrator_zh": ""
  },
  {
   "location": "455/SEL",
   "narrator": "",
   "text": "アーヤかわいい",
   "zh": "绫水好可爱",
   "narrator_zh": ""
  },
  {
   "location": "456/ACT",
   "narrator": "",
   "text": "やっぱりエッチだったんだね！！",
   "zh": "果然是色色的呀！！",
   "narrator_zh": ""
  },
  {
   "location": "459/TALK",
   "narrator": "アーヤ",
   "text": "もう！！\nそんなハッキリ\n言わないで！",
   "zh": "真是的！！\n别说得\n那么明白！",
   "narrator_zh": "绫水"
  },
  {
   "location": "460/TALK",
   "narrator": "アーヤ",
   "text": "そうよ！\n悪かったわね！",
   "zh": "对！\n是我不好！",
   "narrator_zh": "绫水"
  },
  {
   "location": "461/TALK",
   "narrator": "アーヤ",
   "text": "この年頃はみんなそうよ！\n女の子同士の会話だって\n普通にそんな感じだし！",
   "zh": "这个年纪大家都这样！\n女孩子之间的对话\n本来就是这样！",
   "narrator_zh": "绫水"
  },
  {
   "location": "462/SEL",
   "narrator": "",
   "text": "わかったわかった、ごめんね？",
   "zh": "知道了知道了，对不起？",
   "narrator_zh": ""
  },
  {
   "location": "463/ACT",
   "narrator": "",
   "text": "わかったわかった、ごめんね？",
   "zh": "知道了知道了，对不起？",
   "narrator_zh": ""
  },
  {
   "location": "466/TALK",
   "narrator": "アーヤ",
   "text": "……もう。\n知らない！",
   "zh": "……真是的。\n不管了！",
   "narrator_zh": "绫水"
  },
  {
   "location": "467/ACT",
   "narrator": "",
   "text": "具体的にはどんなことを？",
   "zh": "具体是什么样的事？",
   "narrator_zh": ""
  },
  {
   "location": "469/TALK",
   "narrator": "アーヤ",
   "text": "……。",
   "zh": "……。",
   "narrator_zh": "绫水"
  },
  {
   "location": "470/TALK",
   "narrator": "アーヤ",
   "text": "それを言わないと\n協力しないというなら\n私、帰ります。",
   "zh": "要是不说这个\n就不帮忙的话，\n我回去了。",
   "narrator_zh": "绫水"
  },
  {
   "location": "471/SEL",
   "narrator": "",
   "text": "わかった、もういいよ、ごめんね？",
   "zh": "知道了，算了，对不起？",
   "narrator_zh": ""
  },
  {
   "location": "472/ACT",
   "narrator": "",
   "text": "わかった、もういいよ、ごめんね？",
   "zh": "知道了，算了，对不起？",
   "narrator_zh": ""
  },
  {
   "location": "474/TALK",
   "narrator": "アーヤ",
   "text": "よかった。\nわかってくれればいいの。",
   "zh": "太好了。\n你明白就好。",
   "narrator_zh": "绫水"
  },
  {
   "location": "476/TALK",
   "narrator": "アーヤ",
   "text": "その話をするには、\nもうちょっと深い仲に\nならないとダメよね。",
   "zh": "要说那个，\n得再熟一点\n才行。",
   "narrator_zh": "绫水"
  },
