   "location": "478/ACT",
   "narrator": "",
   "text": "アーヤかわいい",
   "zh": "绫水好可爱",
   "narrator_zh": ""
  },
  {
   "location": "480/TALK",
   "narrator": "アーヤ",
   "text": "うー……。\nずるいわよ、それ。",
   "zh": "唔……。\n那样太狡猾了。",
   "narrator_zh": "绫水"
  },
  {
   "location": "481/TALK",
   "narrator": "アーヤ",
   "text": "怒りたくても\n怒れないじゃない…。",
   "zh": "想生气\n也生不起来……。",
   "narrator_zh": "绫水"
  },
  {
   "location": "486/TALK",
   "narrator": "アーヤ",
   "text": "まあとにかく！",
   "zh": "总之！",
   "narrator_zh": "绫水"
  },
  {
   "location": "487/TALK",
   "narrator": "アーヤ",
   "text": "今は私の事より\nつばめのことよ！",
   "zh": "现在比起我，\n是燕的事！",
   "narrator_zh": "绫水"
  },
  {
   "location": "488/TALK",
   "narrator": "アーヤ",
   "text": "彼女の成長の為にも\n私たちが頑張らないと。",
   "zh": "为了她的成长，\n我们也得加油。",
   "narrator_zh": "绫水"
  },
  {
   "location": "490/TALK",
   "narrator": "アーヤ",
   "text": "それじゃ、\n準備はいい？",
   "zh": "那么，\n准备好了吗？",
   "narrator_zh": "绫水"
  },
  {
