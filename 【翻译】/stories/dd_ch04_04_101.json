{
    "dir": "chap04/daydra/dd_ch04_04_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "4402",
        "cid": "miyabi",
        "title": "002 メインストーリー",
        "sub_title": "恋ヶ崎みやびという存在＜前編＞",
        "title_zh": "002 主线剧情",
        "sub_title_zh": "名为恋之崎雅的存在＜前篇＞"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "みやび導入",
            "zh": "雅的开场",
            "narrator_zh": ""
        },
        {
            "location": "34/TALK",
            "narrator": "ガブリエラ",
            "text": "うそっ…。",
            "zh": "不会吧……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "35/TALK",
            "narrator": "アーヤ",
            "text": "くっ…遅かった…。",
            "zh": "唔……来晚了……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "36/TALK",
            "narrator": "みやび",
            "text": "…あんだけ見事に\n刺されちゃ、\n確実に死んでるか。",
            "zh": "……被扎得那么漂亮，\n肯定已经\n死透了吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "37/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "39/TALK",
            "narrator": "みやび",
            "text": "ああ…誰も抹茶ババロア\nゲットできんかったね。",
            "zh": "啊……抹茶芭芭露亚\n谁都没能弄到手呢。",
            "narrator_zh": "雅"
        },
        {
            "location": "42/TALK",
            "narrator": "ガブリエラ",
            "text": "っ！？",
            "zh": "唔！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "44/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょっと、みやび！！\nそんなこと言ってる\n場合じゃないでしょ！？",
            "zh": "等等，雅！！\n现在哪是说\n这种话的时候！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "45/TALK",
            "narrator": "みやび",
            "text": "いや、でもあれじゃ、\n確実に死んでるちや。",
            "zh": "不，不过那样的话，\n肯定已经死了滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "47/TALK",
            "narrator": "アーヤ",
            "text": "みやび、不謹慎なこと\n言わないで！！",
            "zh": "雅，别说\n不该说的话！！",
            "narrator_zh": "绫水"
        },
        {
            "location": "53/TALK",
            "narrator": "みやび",
            "text": "はぁ…。",
            "zh": "唉……。",
            "narrator_zh": "雅"
        },
        {
            "location": "54/TALK",
            "narrator": "アーヤ",
            "text": "みやび…あなた正気！？",
            "zh": "雅……你清醒吗！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "55/TALK",
            "narrator": "みやび",
            "text": "別に、そう慌てることも\nないやろ？",
            "zh": "也没必要\n这么慌吧？",
            "narrator_zh": "雅"
        },
        {
            "location": "56/TALK",
            "narrator": "みやび",
            "text": "あの女の子も死んで\nしもうたようやし――",
            "zh": "那个女孩子\n好像也死了——",
            "narrator_zh": "雅"
        },
        {
            "location": "57/TALK",
            "narrator": "みやび",
            "text": "ちっくと、一息入れて\nから再開でえいやろ。",
            "zh": "等子，喘口气\n再开始就得咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "58/TALK",
            "narrator": "ガブリエラ",
            "text": "何で平気なの！？\n目の前で、人が――",
            "zh": "你怎么这么平静！？\n眼前明明有人——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "59/TALK",
            "narrator": "ガブリエラ",
            "text": "あたし達みたいな\n女の子が殺されたのよ！？",
            "zh": "跟我们一样的\n女孩子被杀掉了呀！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "60/TALK",
            "narrator": "みやび",
            "text": "いや、そう言われても――",
            "zh": "不，你这么说——",
            "narrator_zh": "雅"
        },
        {
            "location": "61/TALK",
            "narrator": "みやび",
            "text": "今更人死にの一人二人\n出たところで、驚いたり\nショック受けてたら――",
            "zh": "事到如今死一两个人，\n要是还吃惊、\n还受打击的话——",
            "narrator_zh": "雅"
        },
        {
            "location": "62/TALK",
            "narrator": "みやび",
            "text": "こんな仕事、\nやっちょれんが。\nなあ、まほさん？",
            "zh": "这种工作，\n就干不下去了。\n对吧，真幌？",
            "narrator_zh": "雅"
        },
        {
            "location": "66/TALK",
            "narrator": "真幌",
            "text": "…そうかもしれんな。",
            "zh": "……也许是这样。",
            "narrator_zh": "真幌"
        },
        {
            "location": "71/TALK",
            "narrator": "アーヤ",
            "text": "館長！？",
            "zh": "馆长！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "72/TALK",
            "narrator": "真幌",
            "text": "どんな想いやスタイルで\nいようと、それはみやびの\n自由だ。",
            "zh": "抱着怎样的想法、\n怎样的作风，\n那是雅的自由。",
            "narrator_zh": "真幌"
        },
        {
            "location": "73/TALK",
            "narrator": "真幌",
            "text": "そこまでどうしろ\nこうしろと、命令も\n強制もできん。",
            "zh": "具体该怎么做，\n我既不能下令，\n也不能强迫。",
            "narrator_zh": "真幌"
        },
        {
            "location": "74/TALK",
            "narrator": "みやび",
            "text": "そういうことや。",
            "zh": "就是这么回事咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "76/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、これじゃ…。",
            "zh": "可是，这样的话……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "77/TALK",
            "narrator": "真幌",
            "text": "だが！！",
            "zh": "但是！！",
            "narrator_zh": "真幌"
        },
        {
            "location": "78/TALK",
            "narrator": "真幌",
            "text": "これは仕事だ。\nそして今は任務中だ。",
            "zh": "这是工作。\n而且现在正在执行任务。",
            "narrator_zh": "真幌"
        },
        {
            "location": "79/TALK",
            "narrator": "真幌",
            "text": "想いもスタイルも\n強制はしないが、\n任務には全力で当たれ。",
            "zh": "想法和作风\n我都不强迫，\n但任务必须全力以赴。",
            "narrator_zh": "真幌"
        },
        {
            "location": "80/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "81/TALK",
            "narrator": "真幌",
            "text": "わかったな！？",
            "zh": "听明白了！？",
            "narrator_zh": "真幌"
        },
        {
            "location": "84/TALK",
            "narrator": "みやび",
            "text": "らじゃ。",
            "zh": "知道了。",
            "narrator_zh": "雅"
        },
        {
            "location": "85/TALK",
            "narrator": "真幌",
            "text": "…以上だ。",
            "zh": "……就这些。",
            "narrator_zh": "真幌"
        },
        {
            "location": "89/TALK",
            "narrator": "みやび",
            "text": "はぁ…やってられんちや。",
            "zh": "唉……真受不了滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "92/TALK",
            "narrator": "ガブリエラ",
            "text": "みやび！！\nあんたまだそんなこと！",
            "zh": "雅！！\n你还在说这种话！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "94/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィ、作戦変更よ！\nとにかく接近するわ。",
            "zh": "加维，作战变更！\n总之先靠近。",
            "narrator_zh": "绫水"
        },
        {
            "location": "95/TALK",
            "narrator": "アーヤ",
            "text": "まだ、運が良ければ\n息があるかもしれない。",
            "zh": "运气好的话，\n也许还有气。",
            "narrator_zh": "绫水"
        },
        {
            "location": "97/TALK",
            "narrator": "ガブリエラ",
            "text": "…わかった！！",
            "zh": "……知道了！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "100/TALK",
            "narrator": "みやび",
            "text": "…気が進まんなぁ。",
            "zh": "……提不起劲啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "101/TALK",
            "narrator": "みやび",
            "text": "…なんか、もう何もかも\nどうでもよくなってきた\nちや。",
            "zh": "……总觉得，已经什么都\n无所谓起来了\n滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "102/TALK",
            "narrator": "みやび",
            "text": "…ちっくと、休憩するか。",
            "zh": "……等子，歇一下吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "147/TALK",
            "narrator": "みやび",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "雅"
        },
        {
            "location": "156/TALK",
            "narrator": "千羽鶴",
            "text": "[ココロスフィア]の説明は\n前に私がしてると思うけど\nもう一度聞く？",
            "zh": "[心灵领域]的说明，\n我想我之前讲过，\n要再听一次吗？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "157/SEL",
            "narrator": "",
            "text": "はい",
            "zh": "是",
            "narrator_zh": ""
        },
        {
            "location": "158/SEL",
            "narrator": "",
            "text": "いいえ",
            "zh": "不",
            "narrator_zh": ""
        },
        {
            "location": "159/ACT",
            "narrator": "",
            "text": "はい",
            "zh": "是",
            "narrator_zh": ""
        },
        {
            "location": "160/TALK",
            "narrator": "千羽鶴",
            "text": "わかった。",
            "zh": "好。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "162/ACT",
            "narrator": "",
            "text": "いいえ",
            "zh": "不",
            "narrator_zh": ""
        },
        {
            "location": "170/TALK",
            "narrator": "千羽鶴",
            "text": "ようこそ。",
            "zh": "欢迎。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "171/SEL",
            "narrator": "",
            "text": "ここは…精神世界？",
            "zh": "这里是……精神世界？",
            "narrator_zh": ""
        },
        {
            "location": "172/ACT",
            "narrator": "",
            "text": "ここは…精神世界？",
            "zh": "这里是……精神世界？",
            "narrator_zh": ""
        },
        {
            "location": "174/TALK",
            "narrator": "千羽鶴",
            "text": "そう。\nバトル説明で入ったのと\n同じ、精神世界。",
            "zh": "是的。\n和战斗说明里进去的\n是同一个精神世界。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "175/TALK",
            "narrator": "千羽鶴",
            "text": "ここは、後ろにいる\n彼女、恋ヶ崎みやびの\n精神世界の入口――",
            "zh": "这里是身后那位\n恋之崎雅的\n精神世界入口——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "176/TALK",
            "narrator": "千羽鶴",
            "text": "通称<color=red>【[ココロゲート]】</color>\nと呼ばれている場所。",
            "zh": "通称<color=red>【[心之扉]】</color>\n的地方。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "177/TALK",
            "narrator": "千羽鶴",
            "text": "ここでは彼女は\nあなたと普通に\n対話できる。",
            "zh": "在这里，她可以\n和你正常\n对话。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "178/TALK",
            "narrator": "千羽鶴",
            "text": "彼女の心に直接\n語りかけることで、\n心を動かすの。",
            "zh": "直接对她的心\n说话，\n就能打动她。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "179/TALK",
            "narrator": "千羽鶴",
            "text": "早速、\n彼女に話しかけてみて。",
            "zh": "现在，\n试着跟她说说话。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "186/TALK",
            "narrator": "みやび",
            "text": "……",
            "zh": "……",
            "narrator_zh": "雅"
        },
        {
            "location": "187/SEL",
            "narrator": "",
            "text": "あのー",
            "zh": "那个——",
            "narrator_zh": ""
        },
        {
            "location": "188/ACT",
            "narrator": "",
            "text": "あのー",
            "zh": "那个——",
            "narrator_zh": ""
        },
        {
            "location": "190/TALK",
            "narrator": "みやび",
            "text": "………",
            "zh": "………",
            "narrator_zh": "雅"
        },
        {
            "location": "191/SEL",
            "narrator": "",
            "text": "すみませーん",
            "zh": "不好意思——",
            "narrator_zh": ""
        },
        {
            "location": "192/ACT",
            "narrator": "",
            "text": "すみませーん",
            "zh": "不好意思——",
            "narrator_zh": ""
        },
        {
            "location": "194/TALK",
            "narrator": "みやび",
            "text": "……　…",
            "zh": "……　…",
            "narrator_zh": "雅"
        },
        {
            "location": "208/TALK",
            "narrator": "みやび",
            "text": "ふわあっ！",
            "zh": "哇啊！",
            "narrator_zh": "雅"
        },
        {
            "location": "212/TALK",
            "narrator": "みやび",
            "text": "ひやぁぁっ！",
            "zh": "呀啊啊！",
            "narrator_zh": "雅"
        },
        {
            "location": "216/TALK",
            "narrator": "みやび",
            "text": "ふごあぁぁっ！",
            "zh": "呜咕啊啊啊！",
            "narrator_zh": "雅"
        },
        {
            "location": "223/TALK",
            "narrator": "みやび",
            "text": "はあああ……\nこじゃんと\nひせくったで～。",
            "zh": "哈啊啊……\n结结实实\n吓了一跳～。",
            "narrator_zh": "雅"
        },
        {
            "location": "224/SEL",
            "narrator": "",
            "text": "？？？",
            "zh": "？？？",
            "narrator_zh": ""
        },
        {
            "location": "225/ACT",
            "narrator": "",
            "text": "？？？",
            "zh": "？？？",
            "narrator_zh": ""
        },
        {
            "location": "229/TALK",
            "narrator": "みやび",
            "text": "超ビックリした～\n…ちゅう意味や。",
            "zh": "超级吃惊了～\n……是这个意思。",
            "narrator_zh": "雅"
        },
        {
            "location": "230/TALK",
            "narrator": "みやび",
            "text": "ふわぁぁ、\nそれにしても、\nあんた誰や？",
            "zh": "哇啊啊，\n话说回来，\n你是谁？",
            "narrator_zh": "雅"
        },
        {
            "location": "231/SEL",
            "narrator": "",
            "text": "はじめまして。$handle$です",
            "zh": "初次见面。我是$handle$",
            "narrator_zh": ""
        },
        {
            "location": "232/ACT",
            "narrator": "",
            "text": "はじめまして。$handle$です",
            "zh": "初次见面。我是$handle$",
            "narrator_zh": ""
        },
        {
            "location": "234/TALK",
            "narrator": "みやび",
            "text": "ほほう、\n$handle$……",
            "zh": "哦哦，\n$handle$……",
            "narrator_zh": "雅"
        },
        {
            "location": "236/TALK",
            "narrator": "みやび",
            "text": "ほんなら\nうちはこれで。\nおやすみ…　…",
            "zh": "那就\n我先这样。\n晚安……　…",
            "narrator_zh": "雅"
        },
        {
            "location": "237/SEL",
            "narrator": "",
            "text": "いやいやいやいや",
            "zh": "不不不不不",
            "narrator_zh": ""
        },
        {
            "location": "238/ACT",
            "narrator": "",
            "text": "いやいやいやいや",
            "zh": "不不不不不",
            "narrator_zh": ""
        },
        {
            "location": "241/TALK",
            "narrator": "みやび",
            "text": "なんぞ、\n何か用か？",
            "zh": "做驷马，\n有什么事？",
            "narrator_zh": "雅"
        },
        {
            "location": "243/SEL",
            "narrator": "",
            "text": "ここはどこ？",
            "zh": "这里是哪里？",
            "narrator_zh": ""
        },
        {
            "location": "244/SEL",
            "narrator": "",
            "text": "司書でしょ？　仕事してよ",
            "zh": "你是司书吧？　干活啊",
            "narrator_zh": ""
        },
        {
            "location": "245/ACT",
            "narrator": "",
            "text": "ここはどこ？",
            "zh": "这里是哪里？",
            "narrator_zh": ""
        },
        {
            "location": "247/ACT",
            "narrator": "",
            "text": "司書でしょ？　仕事してよ",
            "zh": "你是司书吧？　干活啊",
            "narrator_zh": ""
        },
        {
            "location": "251/SEL",
            "narrator": "",
            "text": "ここはどこ？",
            "zh": "这里是哪里？",
            "narrator_zh": ""
        },
        {
            "location": "252/ACT",
            "narrator": "",
            "text": "ここはどこ？",
            "zh": "这里是哪里？",
            "narrator_zh": ""
        },
        {
            "location": "257/TALK",
            "narrator": "みやび",
            "text": "ああ、バレちょったか。\nしょうがないね。",
            "zh": "啊，被看穿了。\n没办法咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "260/TALK",
            "narrator": "みやび",
            "text": "恋ヶ崎みやびの\n精神世界の入口や。\n[ココロゲート]っちゅう。",
            "zh": "恋之崎雅的\n精神世界入口咯。\n叫[心之扉]。",
            "narrator_zh": "雅"
        },
        {
            "location": "261/TALK",
            "narrator": "みやび",
            "text": "ここはなぁ、現実のうちが\n何か物事を決めゆう時に\n使われる場所や。",
            "zh": "这里呢，是现实里的我\n决定事情的时候\n会用到的地方。",
            "narrator_zh": "雅"
        },
        {
            "location": "262/TALK",
            "narrator": "みやび",
            "text": "んで、\nうちは[ココロの司書]\nっちゅう役割の人格。",
            "zh": "然后，\n我是称作[心之司书]\n的那个人格。",
            "narrator_zh": "雅"
        },
        {
            "location": "263/TALK",
            "narrator": "みやび",
            "text": "この幾千もの扉から\n的確に判断して、開ける\nべき扉を指示する人やき。",
            "zh": "从这几千扇门里\n准确判断，指出\n该开哪一扇的人啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "264/TALK",
            "narrator": "みやび",
            "text": "普段はそんだけ。\n簡単なお仕事や。",
            "zh": "平时就这些。\n是很简单的工作。",
            "narrator_zh": "雅"
        },
        {
            "location": "265/TALK",
            "narrator": "みやび",
            "text": "指定した扉も\n簡単に開くしね。",
            "zh": "指定好的门\n也很容易打开。",
            "narrator_zh": "雅"
        },
        {
            "location": "266/TALK",
            "narrator": "みやび",
            "text": "けんど、今みたいな時は\nそうはいかん。",
            "zh": "但是，像现在这种时候\n就不行了。",
            "narrator_zh": "雅"
        },
        {
            "location": "267/TALK",
            "narrator": "みやび",
            "text": "何ら心に怯えとか葛藤が\n出来ちゅうと、正しい扉が\n開かんくなるき。",
            "zh": "心里一旦生出胆怯啊纠葛，\n正确的门\n就开不了啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "268/TALK",
            "narrator": "みやび",
            "text": "そうなると、うちはもう\nお手上げや。",
            "zh": "到了那一步，我就\n没办法了。",
            "narrator_zh": "雅"
        },
        {
            "location": "269/TALK",
            "narrator": "みやび",
            "text": "寝るしかない。",
            "zh": "只能睡了。",
            "narrator_zh": "雅"
        },
        {
            "location": "270/TALK",
            "narrator": "みやび",
            "text": "おやすみ。",
            "zh": "晚安。",
            "narrator_zh": "雅"
        },
        {
            "location": "271/SEL",
            "narrator": "",
            "text": "ちゃんと仕事して",
            "zh": "好好干活",
            "narrator_zh": ""
        },
        {
            "location": "272/ACT",
            "narrator": "",
            "text": "ちゃんと仕事して",
            "zh": "好好干活",
            "narrator_zh": ""
        },
        {
            "location": "274/TALK",
            "narrator": "みやび",
            "text": "そうはゆうても、扉に\n<color=red>【[クラン]】</color>が蔓延ったら\nうちには対処できんよ。",
            "zh": "话是这么说，门上要是\n蔓延了<color=red>【[库兰]】</color>，\n我也对付不了。",
            "narrator_zh": "雅"
        },
        {
            "location": "275/SEL",
            "narrator": "",
            "text": "扉にクラン？？",
            "zh": "门上有库兰？？",
            "narrator_zh": ""
        },
        {
            "location": "276/ACT",
            "narrator": "",
            "text": "扉にクラン？？",
            "zh": "门上有库兰？？",
            "narrator_zh": ""
        },
        {
            "location": "279/TALK",
            "narrator": "みやび",
            "text": "そうやね。",
            "zh": "是咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "280/TALK",
            "narrator": "みやび",
            "text": "怯えなんかが出ると、\n人生先へ進ませたくない\n気持ちがクランを作る。",
            "zh": "一旦生出胆怯，\n不想让人生往前走的\n心情就会造出库兰。",
            "narrator_zh": "雅"
        },
        {
            "location": "281/TALK",
            "narrator": "みやび",
            "text": "そのクランが扉を封鎖して\n本来うちが進むべき道を\n閉ざしてしまうんよ。",
            "zh": "那些库兰把门锁上，\n把我本该走的路\n给堵住了。",
            "narrator_zh": "雅"
        },
        {
            "location": "282/TALK",
            "narrator": "みやび",
            "text": "今も扉の所では、打破\nしたい頑張り屋のうちが\n戦っちょるけんど……。",
            "zh": "现在门那边，想要\n打破局面的、努力的我\n正在打着，但是……。",
            "narrator_zh": "雅"
        },
        {
            "location": "283/TALK",
            "narrator": "みやび",
            "text": "どうにも\n勝てそうにないちや。",
            "zh": "怎么看\n都赢不了滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "284/TALK",
            "narrator": "みやび",
            "text": "やき、そうなれば\n寝るしかないっちゅう\nわけなんやが――",
            "zh": "所以嘛，到了这一步\n就只能睡觉\n了——",
            "narrator_zh": "雅"
        },
        {
            "location": "285/TALK",
            "narrator": "みやび",
            "text": "誰かさんが手伝って\nくれるちゅうんなら\n話は別や。",
            "zh": "要是有人肯\n来帮忙的话，\n那就另说了。",
            "narrator_zh": "雅"
        },
        {
            "location": "286/SEL",
            "narrator": "",
            "text": "クランを倒すってこと？",
            "zh": "就是去打倒库兰？",
            "narrator_zh": ""
        },
        {
            "location": "287/ACT",
            "narrator": "",
            "text": "クランを倒すってこと？",
            "zh": "就是去打倒库兰？",
            "narrator_zh": ""
        },
        {
            "location": "289/TALK",
            "narrator": "みやび",
            "text": "ご名答。",
            "zh": "答对了。",
            "narrator_zh": "雅"
        },
        {
            "location": "291/TALK",
            "narrator": "みやび",
            "text": "お前さんが、頑張り屋の\nうちを助けてくれるなら、\nあるいは…ぞね。",
            "zh": "你要是肯帮\n那个努力的我，\n也许……咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "292/SEL",
            "narrator": "",
            "text": "いいよ",
            "zh": "好啊",
            "narrator_zh": ""
        },
        {
            "location": "293/SEL",
            "narrator": "",
            "text": "やだ",
            "zh": "不要",
            "narrator_zh": ""
        },
        {
            "location": "294/ACT",
            "narrator": "",
            "text": "いいよ",
            "zh": "好啊",
            "narrator_zh": ""
        },
        {
            "location": "296/TALK",
            "narrator": "みやび",
            "text": "ふむ。\nまあ、そう言って\nもらわんと話が進まん。",
            "zh": "嗯。\n嘛，你不这么说，\n事情就进行不下去。",
            "narrator_zh": "雅"
        },
        {
            "location": "297/ACT",
            "narrator": "",
            "text": "やだ",
            "zh": "不要",
            "narrator_zh": ""
        },
        {
            "location": "299/TALK",
            "narrator": "みやび",
            "text": "いや、ここは\n是とするとこやろ。",
            "zh": "不，这里\n该答应才对吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "300/TALK",
            "narrator": "みやび",
            "text": "やりなおし。",
            "zh": "重来。",
            "narrator_zh": "雅"
        },
        {
            "location": "304/SEL",
            "narrator": "",
            "text": "それで、どうすればいいの？",
            "zh": "那么，该怎么做？",
            "narrator_zh": ""
        },
        {
            "location": "305/ACT",
            "narrator": "",
            "text": "それで、どうすればいいの？",
            "zh": "那么，该怎么做？",
            "narrator_zh": ""
        },
        {
            "location": "307/TALK",
            "narrator": "みやび",
            "text": "今からその、<color=red>【[クラン]】</color>が\n塞いじゅう扉を\nここに呼ぶきね。",
            "zh": "现在我把被<color=red>【[库兰]】</color>\n堵住的那扇门\n叫到这里来啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "308/TALK",
            "narrator": "みやび",
            "text": "その扉にアクセスして、\nファイターのうちと一緒に\n頑張ってくれりゃあえい。",
            "zh": "你去接入那扇门，\n和负责战斗的我一起\n加油就好。",
            "narrator_zh": "雅"
        },
        {
            "location": "310/TALK",
            "narrator": "みやび",
            "text": "ほんだら、いくよ。",
            "zh": "那就，走了。",
            "narrator_zh": "雅"
        },
        {
            "location": "320/TALK",
            "narrator": "みやび",
            "text": "オープンプロセス、\n0x884番地から\n0x01C番地へ。",
            "zh": "开放进程，\n从0x884地址\n到0x01C地址。",
            "narrator_zh": "雅"
        },
        {
            "location": "335/TALK",
            "narrator": "みやび",
            "text": "シークおわり。",
            "zh": "搜索完成。",
            "narrator_zh": "雅"
        },
        {
            "location": "336/TALK",
            "narrator": "みやび",
            "text": "いてら。",
            "zh": "去吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "337/SEL",
            "narrator": "",
            "text": "なんでそんなやる気ないの？",
            "zh": "为什么那么没干劲？",
            "narrator_zh": ""
        },
        {
            "location": "338/ACT",
            "narrator": "",
            "text": "なんでそんなやる気ないの？",
            "zh": "为什么那么没干劲？",
            "narrator_zh": ""
        },
        {
            "location": "340/TALK",
            "narrator": "みやび",
            "text": "んー……\n……さてねえ。",
            "zh": "嗯——……\n……这可说不好。",
            "narrator_zh": "雅"
        },
        {
            "location": "341/TALK",
            "narrator": "みやび",
            "text": "まあ、\n一つ言えることは――",
            "zh": "嘛，\n能说的只有一件——",
            "narrator_zh": "雅"
        },
        {
            "location": "342/TALK",
            "narrator": "みやび",
            "text": "こんなやから\nこんな閑職に\n左遷されたちや。",
            "zh": "就是因为这样，\n才被调到\n这种闲职滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "343/TALK",
            "narrator": "みやび",
            "text": "うちって、\n可哀想な人格さんやね。",
            "zh": "我这个人，\n真是个可怜的人格咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "344/SEL",
            "narrator": "",
            "text": "せめてクランが蔓延ってる理由だけでも教えてよ",
            "zh": "至少把库兰蔓延的理由告诉我",
            "narrator_zh": ""
        },
        {
            "location": "345/ACT",
            "narrator": "",
            "text": "せめてクランが蔓延ってる理由だけでも教えてよ",
            "zh": "至少把库兰蔓延的理由告诉我",
            "narrator_zh": ""
        },
        {
            "location": "347/TALK",
            "narrator": "みやび",
            "text": "えぇ？\nなんでそんな面倒なこと\nうちがせないかんちや。",
            "zh": "诶？\n这么麻烦的事，\n为什么要我来做滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "348/TALK",
            "narrator": "みやび",
            "text": "とはいえ、今回ばかりは\n仕方ないか。",
            "zh": "话虽如此，唯独这次\n也没办法。",
            "narrator_zh": "雅"
        },
        {
            "location": "349/TALK",
            "narrator": "みやび",
            "text": "倒してもらわんと\nいかんしね。",
            "zh": "不请你打倒的话\n也不行。",
            "narrator_zh": "雅"
        },
        {
            "location": "353/TALK",
            "narrator": "みやび",
            "text": "ココロファイルNo.\n04-645-11に、今回の\n件が記載されちょる。",
            "zh": "心之档案No.\n04-645-11里，记着\n这次的事。",
            "narrator_zh": "雅"
        },
        {
            "location": "354/TALK",
            "narrator": "みやび",
            "text": "……ふむ。",
            "zh": "……嗯。",
            "narrator_zh": "雅"
        },
        {
            "location": "355/TALK",
            "narrator": "みやび",
            "text": "どうやら意気消沈の\n原因は【なごちゃん】に\nあるみたいやね。",
            "zh": "看来提不起劲的\n原因在【七五】\n身上咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "356/SEL",
            "narrator": "",
            "text": "なごちゃん？？",
            "zh": "七五？？",
            "narrator_zh": ""
        },
        {
            "location": "357/ACT",
            "narrator": "",
            "text": "なごちゃん？？",
            "zh": "七五？？",
            "narrator_zh": ""
        },
        {
            "location": "359/TALK",
            "narrator": "みやび",
            "text": "あ。",
            "zh": "啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "360/TALK",
            "narrator": "みやび",
            "text": "これ、ゆうてもえい\nことやったっけ…？",
            "zh": "这个，是可以说的\n事来着……？",
            "narrator_zh": "雅"
        },
        {
            "location": "361/TALK",
            "narrator": "みやび",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "雅"
        },
        {
            "location": "362/TALK",
            "narrator": "みやび",
            "text": "あかん、レベル７\n機密事項やった……。",
            "zh": "不行，这是等级7\n的机密……。",
            "narrator_zh": "雅"
        },
        {
            "location": "363/SEL",
            "narrator": "",
            "text": "チョンボした？",
            "zh": "失手了？",
            "narrator_zh": ""
        },
        {
            "location": "364/ACT",
            "narrator": "",
            "text": "チョンボした？",
            "zh": "失手了？",
            "narrator_zh": ""
        },
        {
            "location": "367/TALK",
            "narrator": "みやび",
            "text": "なっ！",
            "zh": "什！",
            "narrator_zh": "雅"
        },
        {
            "location": "368/TALK",
            "narrator": "みやび",
            "text": "うちの心を読んだ！？\nあんた一体何者や！？",
            "zh": "你读了我的心！？\n你到底是什么人！？",
            "narrator_zh": "雅"
        },
        {
            "location": "369/TALK",
            "narrator": "みやび",
            "text": "とにかく、今回の原因を\n知った以上、もう\n後戻りは出来んぞね！",
            "zh": "总之，既然知道了\n这次的原因，\n就没法回头了咧！",
            "narrator_zh": "雅"
        },
        {
            "location": "370/SEL",
            "narrator": "",
            "text": "え？なごちゃんって名前しか聞いてないけど",
            "zh": "诶？我只听到七五这个名字而已",
            "narrator_zh": ""
        },
        {
            "location": "371/ACT",
            "narrator": "",
            "text": "え？なごちゃんって名前しか聞いてないけど",
            "zh": "诶？我只听到七五这个名字而已",
            "narrator_zh": ""
        },
        {
            "location": "373/TALK",
            "narrator": "みやび",
            "text": "十分十分！　それだけで\n黒服に連れて行かれる\nレベルの情報やよ。",
            "zh": "足够足够！　光这个\n就够被黑衣人带走的\n等级的情报咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "374/TALK",
            "narrator": "みやび",
            "text": "お駄賃に不足無し！\nさぁ、すっと行くちや！",
            "zh": "报酬绰绰有余！\n来，这就走滴！",
            "narrator_zh": "雅"
        },
        {
            "location": "375/SEL",
            "narrator": "",
            "text": "ちょっとまっ！",
            "zh": "等一下！",
            "narrator_zh": ""
        },
        {
            "location": "376/ACT",
            "narrator": "",
            "text": "ちょっとまっ！",
            "zh": "等一下！",
            "narrator_zh": ""
        },
        {
            "location": "379/TALK",
            "narrator": "みやび",
            "text": "うちと$handle$に\nえいココロの旅を！",
            "zh": "献给我和$handle$的\n美妙的心灵之旅！",
            "narrator_zh": "雅"
        },
        {
            "location": "33/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>5月3日　6:06 PM</color>\nFreyMENOWライブ中に発生した\nフェノメノンドーム戦にて。",
            "zh": "<color=green>5月3日　6:06 PM</color>\n发生在FreyMENOW演唱会中的\nPhenoMENON穹顶战。",
            "narrator_zh": "Dialog_EventData"
        },
        {
            "location": "114/DIALOG",
            "narrator": "BattleInit/Dialog_BATTLE_ch04",
            "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n",
            "zh": "<color=black><size=50><b>恋之崎雅的心中\n战斗开始了。</b></size></color>\n\n\n\n\n\n她的心中，\n产生了很大的挣扎。\n\n请潜入心灵领域，\n化解恋之崎雅心中的挣扎。\n\n\n\n",
            "narrator_zh": "BattleInit/Dialog_BATTLE_ch04"
        },
        {
            "location": "199/DIALOG",
            "narrator": "INFO",
            "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n接続されました。\n\n画面をタップして相手に\n感覚を伝えましょう。",
            "zh": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\n触摸交流\n已连接。\n\n请点击画面，向对方\n传达感觉吧。",
            "narrator_zh": "INFO"
        },
        {
            "location": "221/DIALOG",
            "narrator": "NOTICE",
            "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n切断されました。",
            "zh": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\n触摸交流\n已断开。",
            "narrator_zh": "NOTICE"
        }
    ]
}
