{
    "dir": "chap05/daydra/dd_ch03_05_030.js",
    "type": "MainStory",
    "info": {
        "story_id": "5357",
        "cid": "gabriella",
        "title": "Extra007 プレミアムストーリー",
        "sub_title": "新しい服",
        "title_zh": "Extra007 额外剧情",
        "sub_title_zh": "新衣服"
    },
    "entry": [
        {
            "location": "494/SCENARIO",
            "narrator": "",
            "text": "新しい服",
            "zh": "新衣服",
            "narrator_zh": ""
        },
        {
            "location": "507/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤ、\n聞きたいことが\nあるんだけど――",
            "zh": "绫水，\n我有事\n想问——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "508/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょっと前に、\n新しいジャケット、\n着てたでしょ？",
            "zh": "不久之前，\n你穿过一件\n新夹克吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "510/TALK",
            "narrator": "アーヤ",
            "text": "ああ、\nあのベージュの？",
            "zh": "啊，\n那件米色的？",
            "narrator_zh": "绫水"
        },
        {
            "location": "511/TALK",
            "narrator": "ガブリエラ",
            "text": "そう、それよ。",
            "zh": "对，就是那件。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "512/TALK",
            "narrator": "ガブリエラ",
            "text": "あのジャケット、\nどこの店で買ったか\n教えてもらえる？",
            "zh": "那件夹克，\n能告诉我是在\n哪家店买的吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "513/TALK",
            "narrator": "ガブリエラ",
            "text": "素敵なデザインだった\nから、他にどんな服が\nあるのか見てみたいの。",
            "zh": "设计很不错，\n我想看看还有\n什么别的衣服。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "514/TALK",
            "narrator": "アーヤ",
            "text": "教えるのは\n構わないけど、\n大丈夫かしら？",
            "zh": "告诉你倒是\n没关系，\n你没问题吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "515/TALK",
            "narrator": "アーヤ",
            "text": "あのお店、\n少し入り組んだ\nところにあるから…。",
            "zh": "那家店，\n在有点绕的\n地方……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "517/TALK",
            "narrator": "ガブリエラ",
            "text": "そんなに\nわかり難いの？",
            "zh": "有那么\n难找吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "518/TALK",
            "narrator": "アーヤ",
            "text": "初めて行ったときは、\nなかなか見つから\nなくて――",
            "zh": "第一次去的时候，\n怎么都\n找不到——",
            "narrator_zh": "绫水"
        },
        {
            "location": "520/TALK",
            "narrator": "アーヤ",
            "text": "店の前を三回も\n通り過ぎたくらいよ。",
            "zh": "在店门口走过\n大概有三次。",
            "narrator_zh": "绫水"
        },
        {
            "location": "521/TALK",
            "narrator": "ガブリエラ",
            "text": "相当わかり難い場所に\nあるようね…。\n少し不安かも。",
            "zh": "看来是在相当难找的地方\n啊……。\n有点不安。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "522/TALK",
            "narrator": "アーヤ",
            "text": "う～ん…よかったら、\n私が案内しましょうか？",
            "zh": "嗯……你要是愿意，\n我带你去吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "523/SEL",
            "narrator": "",
            "text": "二人で行くの楽しそう",
            "zh": "两个人去好像很开心",
            "narrator_zh": ""
        },
        {
            "location": "524/SEL",
            "narrator": "",
            "text": "一人で行こう",
            "zh": "一个人去吧",
            "narrator_zh": ""
        },
        {
            "location": "527/TALK",
            "narrator": "ガブリエラ",
            "text": "い、いいわよ。\nアーヤだって最近行った\nばかりなんでしょ？",
            "zh": "可、可以哦。\n绫水你最近不是\n刚去过吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "530/TALK",
            "narrator": "アーヤ",
            "text": "先週にね。\nでも、服を見るのも\n趣味みたいなものだし。",
            "zh": "上周去的。\n不过，看衣服\n也算是兴趣。",
            "narrator_zh": "绫水"
        },
        {
            "location": "531/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィがよければ、\n一緒にどう？",
            "zh": "加维愿意的话，\n一起去怎么样？",
            "narrator_zh": "绫水"
        },
        {
            "location": "534/TALK",
            "narrator": "ガブリエラ",
            "text": "…そ、そうねぇ。",
            "zh": "……也、也是。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "539/TALK",
            "narrator": "ガブリエラ",
            "text": "やっぱり、いいわ。",
            "zh": "还是算了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "540/TALK",
            "narrator": "ガブリエラ",
            "text": "服以外にも\nちょっと見たいものも\nあるし――",
            "zh": "除了衣服，\n还有点别的\n想看的——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "541/TALK",
            "narrator": "ガブリエラ",
            "text": "のんびり行ってくるわ。",
            "zh": "我会慢慢去的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "543/TALK",
            "narrator": "アーヤ",
            "text": "そっか。",
            "zh": "这样啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "544/TALK",
            "narrator": "アーヤ",
            "text": "じゃあ、ＷＡＶＥで\n地図を送っておくわ。",
            "zh": "那我用WAVE\n把地图发给你。",
            "narrator_zh": "绫水"
        },
        {
            "location": "545/TALK",
            "narrator": "ガブリエラ",
            "text": "助かるわ。",
            "zh": "帮大忙了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "547/TALK",
            "narrator": "アーヤ",
            "text": "いい服が見つかると\nいいわね。",
            "zh": "能找到好衣服\n就好了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "549/ACT",
            "narrator": "",
            "text": "二人で行くの楽しそう",
            "zh": "两个人去好像很开心",
            "narrator_zh": ""
        },
        {
            "location": "578/TALK",
            "narrator": "ガブリエラ",
            "text": "…そうかも",
            "zh": "……也许是",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "579/TALK",
            "narrator": "ガブリエラ",
            "text": "それじゃあ、思い切ってお願いしてみるわ",
            "zh": "那就鼓起勇气拜托看看",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "592/TALK",
            "narrator": "ガブリエラ",
            "text": "じゃ、じゃあ…\nお願いしようかしら。",
            "zh": "那、那么……\n拜托你吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "593/TALK",
            "narrator": "アーヤ",
            "text": "うん、任せて。\n多分もう迷ったりは\nしないはずだから。",
            "zh": "嗯，交给我。\n大概不会\n再迷路了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "594/TALK",
            "narrator": "ガブリエラ",
            "text": "多分？",
            "zh": "大概？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "596/TALK",
            "narrator": "アーヤ",
            "text": "もう、本気にしないでよ。\n冗談だってば。",
            "zh": "真是的，别当真。\n开玩笑的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "599/TALK",
            "narrator": "ガブリエラ",
            "text": "…冗談、ね。\nもしかして凄くご機嫌\nだったりしない？",
            "zh": "……玩笑，是吧。\n难道你心情\n特别好？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "602/TALK",
            "narrator": "アーヤ",
            "text": "ふふっ…ちょっとね。",
            "zh": "呵呵……有一点。",
            "narrator_zh": "绫水"
        },
        {
            "location": "603/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィと服を\n見に行くのって、\n初めてでしょ？",
            "zh": "和加维一起\n去看衣服，\n是第一次吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "604/TALK",
            "narrator": "アーヤ",
            "text": "だから、\nちょっと楽しみなのよ。",
            "zh": "所以，\n有点期待。",
            "narrator_zh": "绫水"
        },
        {
            "location": "607/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "608/TALK",
            "narrator": "アーヤ",
            "text": "行く日が決まったら\nまた声かけてね。",
            "zh": "日子定了\n再叫我。",
            "narrator_zh": "绫水"
        },
        {
            "location": "611/TALK",
            "narrator": "ガブリエラ",
            "text": "…アーヤも、\n楽しみにして\nくれてるんだ。",
            "zh": "……绫水也\n在期待\n啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "612/TALK",
            "narrator": "ガブリエラ",
            "text": "なんだか嬉しいな。\nマルザンナのとおり、\nお願いしてよかった。",
            "zh": "总觉得挺高兴的。\n照玛尔赞娜说的，\n拜托了真好。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "613/ACT",
            "narrator": "",
            "text": "一人で行こう",
            "zh": "一个人去吧",
            "narrator_zh": ""
        },
        {
            "location": "633/TALK",
            "narrator": "ガブリエラ",
            "text": "初めて行くお店なんだし",
            "zh": "毕竟是第一次去的店",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "634/TALK",
            "narrator": "ガブリエラ",
            "text": "一人でじっくり見た方が集中できるかしら？",
            "zh": "一个人慢慢看，更能集中吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "647/TALK",
            "narrator": "ガブリエラ",
            "text": "…今回は一人で行くわ。\n時間掛けてゆっくり\n見たいし。",
            "zh": "……这次我一个人去。\n想花时间慢慢\n看。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "648/TALK",
            "narrator": "アーヤ",
            "text": "そっか…まあ、\nあの辺は面白い\nお店も沢山あるから――",
            "zh": "这样啊……不过，\n那一带有意思的\n店也很多——",
            "narrator_zh": "绫水"
        },
        {
            "location": "649/TALK",
            "narrator": "アーヤ",
            "text": "探検気分で行くのも、\n悪くないと思うわ。",
            "zh": "带着探险的心情去，\n我觉得也不错。",
            "narrator_zh": "绫水"
        },
        {
            "location": "650/TALK",
            "narrator": "ガブリエラ",
            "text": "それ良いわね。\n探検気分の買い物って、\n結構好きかも。",
            "zh": "这个好。\n带着探险心情买东西，\n我可能挺喜欢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "652/TALK",
            "narrator": "アーヤ",
            "text": "後でお店の住所と地図を\n渡すから――",
            "zh": "店的地址和地图\n我稍后给你——",
            "narrator_zh": "绫水"
        },
        {
            "location": "654/TALK",
            "narrator": "アーヤ",
            "text": "休みの日にでもゆっくり\n行ってらっしゃい。",
            "zh": "休息日\n慢慢去就行。",
            "narrator_zh": "绫水"
        },
        {
            "location": "655/TALK",
            "narrator": "ガブリエラ",
            "text": "ええ、そうするわ。",
            "zh": "嗯，就这么办。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "656/TALK",
            "narrator": "ガブリエラ",
            "text": "どんなお店があるのか\n今から楽しみだわ。",
            "zh": "有些什么店，\n现在就开始期待了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "658/TALK",
            "narrator": "アーヤ",
            "text": "楽しみすぎて、\n服を買うのを忘れない\nようにね。",
            "zh": "别期待过头，\n忘了要买\n衣服。",
            "narrator_zh": "绫水"
        },
        {
            "location": "505/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>5月12日　5:18 PM</color>\nＧＷ後、神楽坂通りにて。",
            "zh": "<color=green>5月12日　5:18 PM</color>\n黄金周过后，在神乐坂大街。",
            "narrator_zh": "Dialog_EventData"
        },
        {
            "location": "555/DIALOG",
            "narrator": "Dialog_GETGokigen",
            "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！",
            "zh": "心情点数\n<size=40><color=red><b>300pt.</b></color></size>\n增加了！",
            "narrator_zh": "Dialog_GETGokigen"
        }
    ]
}
