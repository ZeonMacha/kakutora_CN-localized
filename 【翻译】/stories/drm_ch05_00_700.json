    "entry": [
        {
            "location": "1760/SCENARIO",
            "narrator": "",
            "text": "マジックワード",
            "zh": "Magic Word",
            "narrator_zh": ""
        },
        {
            "location": "1785/TALK",
            "narrator": "神楽",
            "text": "イシュリールの新しい話をしてもいい？",
            "zh": "可以聊聊关于伊修利尔的新故事吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1786/TALK",
            "narrator": "神楽",
            "text": "今じゃなくて",
            "zh": "不是现在",
            "narrator_zh": "神乐"
        },
        {
            "location": "1787/TALK",
            "narrator": "神楽",
            "text": "思いついたら",
            "zh": "等我想到的时候",
            "narrator_zh": "神乐"
        },
        {
            "location": "1789/SEL",
            "narrator": "",
            "text": "もちろん",
            "zh": "当然",
            "narrator_zh": ""
        },
        {
            "location": "1790/SEL",
            "narrator": "",
            "text": "思いついたら言って",
            "zh": "想起来就告诉我",
            "narrator_zh": ""
        },
        {
            "location": "1791/SEL",
            "narrator": "",
            "text": "今度はどんな話？",
            "zh": "下次聊什么？",
            "narrator_zh": ""
        },
        {
            "location": "1792/ACT",
            "narrator": "",
            "text": "もちろん",
            "zh": "当然",
            "narrator_zh": ""
        },
        {
            "location": "1793/TALK",
            "narrator": "神楽",
            "text": "ｱﾘｶﾞﾄ、、、",
            "zh": "谢谢……",
            "narrator_zh": "神乐"
        },
        {
            "location": "1794/TALK",
            "narrator": "神楽",
            "text": "そう言ってくれてよかった",
            "zh": "你能那么说，太好了",
            "narrator_zh": "神乐"
        },
        {
            "location": "1804/ACT",
            "narrator": "",
            "text": "思いついたら言って",
            "zh": "想起来就告诉我",
            "narrator_zh": ""
        },
        {
            "location": "1807/TALK",
            "narrator": "神楽",
            "text": "またね",
            "zh": "下次见",
            "narrator_zh": "神乐"
        },
        {
            "location": "1817/ACT",
            "narrator": "",
            "text": "今度はどんな話？",
            "zh": "下次聊什么？",
            "narrator_zh": ""
        },
        {
            "location": "1819/TALK",
            "narrator": "神楽",
            "text": "まだふんわりとしてるんだけど",
            "zh": "虽然现在还只是个大概轮廓",
            "narrator_zh": "神乐"
        },
        {
            "location": "1820/TALK",
            "narrator": "神楽",
            "text": "今度はハッピーエンド",
            "zh": "这次是圆满结局",
            "narrator_zh": "神乐"
        },
        {
            "location": "1821/TALK",
            "narrator": "神楽",
            "text": "それだけは決まってる",
            "zh": "这一点是确定的",
            "narrator_zh": "神乐"
        },
        {
            "location": "1823/SEL",
            "narrator": "",
            "text": "なるほどね",
            "zh": "原来如此",
            "narrator_zh": ""
        },
        {
            "location": "1824/SEL",
            "narrator": "",
            "text": "今のイシュリールは？",
            "zh": "现在的伊修利尔是？",
            "narrator_zh": ""
        },
        {
            "location": "1825/ACT",
            "narrator": "",
            "text": "なるほどね",
            "zh": "原来如此",
            "narrator_zh": ""
        },
        {
            "location": "1826/TALK",
            "narrator": "神楽",
            "text": "そうなんだ",
            "zh": "是这样啊",
            "narrator_zh": "神乐"
        },
        {
            "location": "1827/ACT",
            "narrator": "",
            "text": "今のイシュリールは？",
            "zh": "现在的伊修利尔是？",
            "narrator_zh": ""
        },
        {
            "location": "1828/TALK",
            "narrator": "神楽",
            "text": "いるよ",
            "zh": "在的",
            "narrator_zh": "神乐"
        },
        {
            "location": "1829/TALK",
            "narrator": "神楽",
            "text": "その続きだから",
            "zh": "因为那是后续",
            "narrator_zh": "神乐"
        },
        {
            "location": "1831/TALK",
            "narrator": "神楽",
            "text": "ぴょんこは",
            "zh": "蹦子她",
            "narrator_zh": "神乐"
        },
        {
            "location": "1832/TALK",
            "narrator": "神楽",
            "text": "イシュリールを否定してすごく後悔した",
            "zh": "否定掉伊修利尔，我非常后悔",
            "narrator_zh": "神乐"
        },
        {
            "location": "1833/TALK",
            "narrator": "神楽",
            "text": "だけどイシュフォビアも大事な子供みたいなものだし",
            "zh": "可是伊什菲比亚也像重要的孩子一样",
            "narrator_zh": "神乐"
        },
        {
            "location": "1834/TALK",
            "narrator": "神楽",
            "text": "今度こそ愛してあげる",
            "zh": "这一次我一定要好好爱它",
            "narrator_zh": "神乐"
        },
        {
            "location": "1836/SEL",
            "narrator": "",
            "text": "$me$も愛が欲しい",
            "zh": "$me$也想要爱",
            "narrator_zh": ""
        },
        {
            "location": "1837/SEL",
            "narrator": "",
            "text": "そっか…",
            "zh": "这样啊……",
            "narrator_zh": ""
        },
        {
            "location": "1838/SEL",
            "narrator": "",
            "text": "今までだって愛してたでしょ",
            "zh": "以前不也一直爱着吗",
            "narrator_zh": ""
        },
        {
            "location": "1839/ACT",
            "narrator": "",
            "text": "$me$も愛が欲しい",
            "zh": "$me$也想要爱",
            "narrator_zh": ""
        },
        {
            "location": "1840/TALK",
            "narrator": "神楽",
            "text": "気付いてないの？",
            "zh": "你没注意到吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1841/TALK",
            "narrator": "神楽",
            "text": "ぴょんこの愛に、、、",
            "zh": "没注意到蹦子的爱吗……",
            "narrator_zh": "神乐"
        },
        {
            "location": "1842/ACT",
            "narrator": "",
            "text": "そっか…",
            "zh": "这样啊……",
            "narrator_zh": ""
        },
        {
            "location": "1843/TALK",
            "narrator": "神楽",
            "text": "うん",
            "zh": "嗯",
            "narrator_zh": "神乐"
        },
        {
            "location": "1845/TALK",
            "narrator": "神楽",
            "text": "今度こそね",
            "zh": "这一次一定哦",
            "narrator_zh": "神乐"
        },
        {
            "location": "1846/ACT",
            "narrator": "",
            "text": "今までだって愛してたでしょ",
            "zh": "以前不也一直爱着吗",
            "narrator_zh": ""
        },
        {
            "location": "1847/TALK",
            "narrator": "神楽",
            "text": "そうかな",
            "zh": "是吗",
            "narrator_zh": "神乐"
        },
        {
            "location": "1848/TALK",
            "narrator": "神楽",
            "text": "だったらいいんだけど",
            "zh": "那样倒还好",
            "narrator_zh": "神乐"
        },
        {
            "location": "1850/TALK",
            "narrator": "神楽",
            "text": "イシュリールに対する愛は",
            "zh": "对伊修利尔的爱",
            "narrator_zh": "神乐"
        },
        {
            "location": "1851/TALK",
            "narrator": "神楽",
            "text": "$handle$への愛とは違うものだから",
            "zh": "因为那跟对$handle$的爱是不同的东西",
            "narrator_zh": "神乐"
        },
        {
            "location": "1852/TALK",
            "narrator": "神楽",
            "text": "やきもち妬かないで",
            "zh": "别吃醋哦",
            "narrator_zh": "神乐"
        },
        {
            "location": "1854/SEL",
            "narrator": "",
            "text": "そんなことしないし！",
            "zh": "我才不会做那种事！",
            "narrator_zh": ""
        },
        {
            "location": "1855/SEL",
            "narrator": "",
            "text": "態度に出ちゃうかも…",
            "zh": "可能会露在态度上……",
            "narrator_zh": ""
        },
        {
            "location": "1856/SEL",
            "narrator": "",
            "text": "一緒に愛を注ぐよ",
            "zh": "一起倾注爱吧",
            "narrator_zh": ""
        },
        {
            "location": "1857/ACT",
            "narrator": "",
            "text": "そんなことしないし！",
            "zh": "我才不会做那种事！",
            "narrator_zh": ""
        },
        {
            "location": "1858/TALK",
            "narrator": "神楽",
            "text": "ならいいんだけど？",
            "zh": "那就好？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1860/TALK",
            "narrator": "神楽",
            "text": "本当かな？？？",
            "zh": "真的吗？？？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1861/ACT",
            "narrator": "",
            "text": "態度に出ちゃうかも…",
            "zh": "可能会露在态度上……",
            "narrator_zh": ""
        },
        {
            "location": "1862/TALK",
            "narrator": "神楽",
            "text": "それでもいいのよ？",
            "zh": "那样也可以哦？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1864/TALK",
            "narrator": "神楽",
            "text": "かわいいね$handle$♪",
            "zh": "好可爱呢$handle$♪",
            "narrator_zh": "神乐"
        },
        {
            "location": "1865/ACT",
            "narrator": "",
            "text": "一緒に愛を注ぐよ",
            "zh": "一起倾注爱吧",
            "narrator_zh": ""
        },
        {
            "location": "1866/TALK",
            "narrator": "神楽",
            "text": "ﾔﾀﾞｽﾃｷ、、、",
            "zh": "讨厌，好棒……",
            "narrator_zh": "神乐"
        },
        {
            "location": "1869/TALK",
            "narrator": "神楽",
            "text": "そうじゃなきゃ",
            "zh": "不然的话",
            "narrator_zh": "神乐"
        },
        {
            "location": "1870/TALK",
            "narrator": "神楽",
            "text": "ぴょんこ自身がダメになるから",
            "zh": "不然蹦子自己就会垮掉的",
            "narrator_zh": "神乐"
        },
        {
            "location": "1871/TALK",
            "narrator": "神楽",
            "text": "自分を許せなくなるから",
            "zh": "会无法原谅自己的",
            "narrator_zh": "神乐"
        },
        {
            "location": "1873/SEL",
            "narrator": "",
            "text": "真面目だよね…",
            "zh": "你还真认真呢……",
            "narrator_zh": ""
        },
        {
            "location": "1874/SEL",
            "narrator": "",
            "text": "そういうものかも",
            "zh": "也许是这样",
            "narrator_zh": ""
        },
        {
            "location": "1875/SEL",
            "narrator": "",
            "text": "もっと肩の力抜いてもいいのに",
            "zh": "其实你可以再放松一点的",
            "narrator_zh": ""
        },
        {
            "location": "1876/ACT",
            "narrator": "",
            "text": "真面目だよね…",
            "zh": "你还真认真呢……",
            "narrator_zh": ""
        },
        {
            "location": "1877/TALK",
            "narrator": "神楽",
            "text": "創作には真摯に向き合いたいから",
            "zh": "因为我想认真诚恳地面对创作",
            "narrator_zh": "神乐"
        },
        {
            "location": "1878/TALK",
            "narrator": "神楽",
            "text": "そうじゃなきゃ",
            "zh": "不然的话",
            "narrator_zh": "神乐"
        },
        {
            "location": "1879/TALK",
            "narrator": "神楽",
            "text": "創作の意味がない",
            "zh": "创作就没有意义了",
            "narrator_zh": "神乐"
        },
        {
            "location": "1880/ACT",
            "narrator": "",
            "text": "そういうものかも",
            "zh": "也许是这样",
            "narrator_zh": ""
        },
        {
            "location": "1881/TALK",
            "narrator": "神楽",
            "text": "人によって違うのかもね",
            "zh": "也许因人而异吧",
            "narrator_zh": "神乐"
        },
        {
            "location": "1882/TALK",
            "narrator": "神楽",
            "text": "そういう感覚",
            "zh": "那种感觉",
            "narrator_zh": "神乐"
        },
        {
            "location": "1883/ACT",
            "narrator": "",
            "text": "もっと肩の力抜いてもいいのに",
            "zh": "其实你可以再放松一点的",
            "narrator_zh": ""
        },
        {
            "location": "1884/TALK",
            "narrator": "神楽",
            "text": "大人な意見",
            "zh": "好成熟的意见",
            "narrator_zh": "神乐"
        },
        {
            "location": "1885/TALK",
            "narrator": "神楽",
            "text": "それともいい加減なの？",
            "zh": "还是说你在敷衍？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1886/TALK",
            "narrator": "神楽",
            "text": "むつかしいね",
            "zh": "好难啊",
            "narrator_zh": "神乐"
        },
        {
            "location": "1888/TALK",
            "narrator": "神楽",
            "text": "今のぴょんこには",
            "zh": "对现在的蹦子来说",
            "narrator_zh": "神乐"
        },
        {
            "location": "1890/TALK",
            "narrator": "神楽",
            "text": "降り注ぐ全ての不幸を振り払って",
            "zh": "甩开倾泻而下的所有不幸",
            "narrator_zh": "神乐"
        },
        {
            "location": "1891/TALK",
            "narrator": "神楽",
            "text": "満身創痍になっても",
            "zh": "就算变得遍体鳞伤",
            "narrator_zh": "神乐"
        },
        {
            "location": "1892/TALK",
            "narrator": "神楽",
            "text": "絶対にハッピーエンドにする",
            "zh": "也绝对要迎来圆满结局",
            "narrator_zh": "神乐"
        },
        {
            "location": "1893/TALK",
            "narrator": "神楽",
            "text": "だから聞いてね",
            "zh": "所以你听我说",
            "narrator_zh": "神乐"
        },
        {
            "location": "1894/TALK",
            "narrator": "神楽",
            "text": "続きの話を",
            "zh": "听听后续的故事吧",
            "narrator_zh": "神乐"
        }
    ]
