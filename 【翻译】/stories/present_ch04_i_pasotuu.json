            "text": "最新号はまだ買ってなかったき",
            "zh": "最新一期还没买啵",
            "narrator_zh": "雅"
        },
        {
            "location": "345/TALK",
            "narrator": "みやび",
            "text": "早速読ませてもらう",
            "zh": "我这就拜读了",
            "narrator_zh": "雅"
        },
        {
            "location": "348/SEL",
            "narrator": "",
            "text": "ＰＣ好きだよね？",
            "zh": "你喜欢ＰＣ来着？",
            "narrator_zh": ""
        },
        {
            "location": "349/ACT",
            "narrator": "",
            "text": "ＰＣ好きだよね？",
            "zh": "你喜欢ＰＣ来着？",
            "narrator_zh": ""
        },
        {
            "location": "352/TALK",
            "narrator": "みやび",
            "text": "好き嫌いのレベルやない",
            "zh": "已经不是喜不喜欢那个层次了",
            "narrator_zh": "雅"
        },
        {
            "location": "353/TALK",
            "narrator": "みやび",
            "text": "切っても切り離せん存在",
            "zh": "怎么切都分不开的存在",
            "narrator_zh": "雅"
        },
        {
            "location": "354/TALK",
            "narrator": "みやび",
            "text": "分身",
            "zh": "分身",
            "narrator_zh": "雅"
        },
        {
            "location": "355/TALK",
            "narrator": "みやび",
            "text": "もう一人のうち",
            "zh": "另一个我",
            "narrator_zh": "雅"
        },
        {
            "location": "358/SEL",
            "narrator": "",
            "text": "ＰＣのことは、みやびに聞くようにするよ",
            "zh": "ＰＣ的事，我就来问你吧",
            "narrator_zh": ""
        },
        {
            "location": "359/ACT",
            "narrator": "",
            "text": "ＰＣのことは、みやびに聞くようにするよ",
            "zh": "ＰＣ的事，我就来问你吧",
            "narrator_zh": ""
        },
        {
            "location": "362/TALK",
            "narrator": "みやび",
            "text": "えいよ",
            "zh": "得",
            "narrator_zh": "雅"
        },
        {
            "location": "363/TALK",
            "narrator": "みやび",
            "text": "けんど",
            "zh": "但是",
            "narrator_zh": "雅"
        },
        {
            "location": "364/TALK",
            "narrator": "みやび",
            "text": "忙しい時はお断りや",
            "zh": "忙的时候免谈",
            "narrator_zh": "雅"
        },
        {
            "location": "365/TALK",
            "narrator": "みやび",
            "text": "ちなみに今は貰った本を読むき",
            "zh": "顺便一提，现在我要去读你送的书咧",
            "narrator_zh": "雅"
        },
        {
            "location": "366/TALK",
            "narrator": "みやび",
            "text": "忙しいき、話も終わりや",
            "zh": "忙了啵，话也到此为止咯",
