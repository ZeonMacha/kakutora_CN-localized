{
    "dir": "dramatics/daydra/drm_ch03_00_580.js",
    "type": "Episode",
    "info": {
        "story_id": "3058",
        "cid": "gabriella",
        "title": "らぶとーく  第59話",
        "sub_title": "わがままなんて言ってない",
        "title_zh": "恋爱漫谈 第59话",
        "sub_title_zh": "我可没在任性"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "わがままなんて言ってない",
            "zh": "我可没在任性",
            "narrator_zh": ""
        },
        {
            "location": "24/TALK",
            "narrator": "ガブリエラ",
            "text": "うそ…何でないの？",
            "zh": "不会吧…怎么没有？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "25/TALK",
            "narrator": "ガブリエラ",
            "text": "確かにちゃんと\nしまったはずなのに…。",
            "zh": "明明确实\n好好收进去了的……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "26/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "38/TALK",
            "narrator": "ガブリエラ",
            "text": "私の生徒手帳知らない？",
            "zh": "没看到我的学生手册吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "40/SEL",
            "narrator": "",
            "text": "知らないけど、どうして？",
            "zh": "我不知道，不过为什么？",
            "narrator_zh": ""
        },
        {
            "location": "41/ACT",
            "narrator": "",
            "text": "知らないけど、どうして？",
            "zh": "我不知道，不过为什么？",
            "narrator_zh": ""
        },
        {
            "location": "43/TALK",
            "narrator": "ガブリエラ",
            "text": "今気が付いたらなかったの",
            "zh": "一注意到就没了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "44/TALK",
            "narrator": "ガブリエラ",
            "text": "朝はちゃんと持ってたのに",
            "zh": "明明早上还好好带着的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "45/TALK",
            "narrator": "ガブリエラ",
            "text": "どこやっちゃったのかしら？",
            "zh": "弄到哪里去了呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "56/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…とりあえず、\nもう一度鞄の中を…。",
            "zh": "唉……总之，\n再把包里看一遍……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "59/TALK",
            "narrator": "男子高校生Ａ",
            "text": "ねえ、君。",
            "zh": "喂，你。",
            "narrator_zh": "男高中生A"
        },
        {
            "location": "62/TALK",
            "narrator": "ガブリエラ",
            "text": "っ！？",
            "zh": "！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "64/TALK",
            "narrator": "男子高校生Ａ",
            "text": "君、ガブリエラさんで\n良いんだよね？",
            "zh": "你是加布里埃拉\n没错吧？",
            "narrator_zh": "男高中生A"
        },
        {
            "location": "66/TALK",
            "narrator": "ガブリエラ",
            "text": "…だ、誰、この人？\n知らないんだけど…。",
            "zh": "……这、这人是谁？\n我根本不认识啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "67/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "68/TALK",
            "narrator": "男子高校生Ａ",
            "text": "いや、そんなに\n警戒しなくても…。",
            "zh": "不是，不用\n这么警惕吧……。",
            "narrator_zh": "男高中生A"
        },
        {
            "location": "70/TALK",
            "narrator": "男子高校生Ａ",
            "text": "ほら、この生徒手帳って\n君のだろ？",
            "zh": "你看，这本学生手册\n是你的吧？",
            "narrator_zh": "男高中生A"
        },
        {
            "location": "72/TALK",
            "narrator": "ガブリエラ",
            "text": "っ！！",
            "zh": "唔！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "73/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしの生徒手帳！？\nどうしてこの人が…。",
            "zh": "我的学生手册！？\n为什么会在这种人……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "74/TALK",
            "narrator": "男子高校生Ａ",
            "text": "今朝登校した時、\n校門の前で拾ってさ。",
            "zh": "今天早上上学时，\n在校门口捡到的。",
            "narrator_zh": "男高中生A"
        },
        {
            "location": "75/TALK",
            "narrator": "男子高校生Ａ",
            "text": "すぐ届けたかったん\nだけど、中々中等部まで\n来れなくてね。",
            "zh": "本想马上送来，\n但一直没机会\n到中等部这边来。",
            "narrator_zh": "男高中生A"
        },
        {
            "location": "77/TALK",
            "narrator": "ガブリエラ",
            "text": "…そういえば、忘れ物\nした気がして――",
            "zh": "……这么一说，好像\n确实落了东西——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "78/TALK",
            "narrator": "ガブリエラ",
            "text": "校門の前で鞄の中を\n探ったような…。",
            "zh": "好像在校门口\n翻过包……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "81/TALK",
            "narrator": "ガブリエラ",
            "text": "そっか。\nあの時落としたんだ…。",
            "zh": "这样啊。\n原来是那时候丢的……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "82/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "84/TALK",
            "narrator": "男子高校生Ａ",
            "text": "え、えっと…。",
            "zh": "诶、那个……。",
            "narrator_zh": "男高中生A"
        },
        {
            "location": "86/TALK",
            "narrator": "男子高校生Ａ",
            "text": "な、中を見たりは\nしてないよ？",
            "zh": "我、我可没\n偷看里面哦？",
            "narrator_zh": "男高中生A"
        },
        {
            "location": "87/TALK",
            "narrator": "男子高校生Ａ",
            "text": "一ページ目の名前と\nクラスが書いてあるとこ\n以外見てないから…。",
            "zh": "除了第一页写着\n姓名和班级的地方\n其他都没看过……。",
            "narrator_zh": "男高中生A"
        },
        {
            "location": "89/TALK",
            "narrator": "ガブリエラ",
            "text": "いや、別に見られても\n大したこと書いてないん\nだけど…。",
            "zh": "不是，就算被看到\n里面也没写什么\n了不起的东西……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "90/TALK",
            "narrator": "ガブリエラ",
            "text": "っていうか、\nお礼言わないと！",
            "zh": "话说，\n得道谢才行！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "92/TALK",
            "narrator": "男子高校生Ａ",
            "text": "ほ、本当だから！\nてか、そんな睨まないで\nくれよ…。",
            "zh": "真、真的是这样！\n话说，别那么\n瞪着我啊……。",
            "narrator_zh": "男高中生A"
        },
        {
            "location": "93/TALK",
            "narrator": "ガブリエラ",
            "text": "っ！？",
            "zh": "！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "95/TALK",
            "narrator": "男子高校生Ａ",
            "text": "あ、いや…ごめん！\nそれじゃ！！",
            "zh": "啊，不是……抱歉！\n那我走了！！",
            "narrator_zh": "男高中生A"
        },
        {
            "location": "99/TALK",
            "narrator": "ガブリエラ",
            "text": "あっ…。",
            "zh": "啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "100/TALK",
            "narrator": "ガブリエラ",
            "text": "…そんな…睨んでなんか\nいないのに…。",
            "zh": "……我明明……没有\n在瞪他啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "102/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "115/TALK",
            "narrator": "ガブリエラ",
            "text": "最低なことしちゃったかも",
            "zh": "我可能干了件最糟的事",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "116/TALK",
            "narrator": "ガブリエラ",
            "text": "せっかく親切にしてくれた人なのに",
            "zh": "对方明明是一片好意",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "117/TALK",
            "narrator": "ガブリエラ",
            "text": "お礼も言えなかったし",
            "zh": "也没能说声谢谢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "118/TALK",
            "narrator": "ガブリエラ",
            "text": "しかも",
            "zh": "而且",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "119/TALK",
            "narrator": "ガブリエラ",
            "text": "睨んでると思われたし",
            "zh": "还被当成是在瞪人",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "120/TALK",
            "narrator": "ガブリエラ",
            "text": "クラスの子達にもまた怖い子だって誤解されたと思う",
            "zh": "班上的同学们肯定又要误会我是个可怕的人了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "122/SEL",
            "narrator": "",
            "text": "ドンマイ",
            "zh": "没事的",
            "narrator_zh": ""
        },
        {
            "location": "123/ACT",
            "narrator": "",
            "text": "ドンマイ",
            "zh": "没事的",
            "narrator_zh": ""
        },
        {
            "location": "125/TALK",
            "narrator": "ガブリエラ",
            "text": "ドンマイじゃない！",
            "zh": "才不是没事呢！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "127/TALK",
            "narrator": "ガブリエラ",
            "text": "そもそも",
            "zh": "说到底",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "128/TALK",
            "narrator": "ガブリエラ",
            "text": "$handle$が隣にいてくれないのが悪いのよ！",
            "zh": "都怪$handle$不在我旁边！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "129/TALK",
            "narrator": "ガブリエラ",
            "text": "$handle$が隣にいたらこんな風にはならないのに",
            "zh": "要是$handle$在旁边就不会变成这样了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "131/SEL",
            "narrator": "",
            "text": "スマイル、スマイル",
            "zh": "微笑，微笑",
            "narrator_zh": ""
        },
        {
            "location": "132/SEL",
            "narrator": "",
            "text": "ごめんね、側にいられなくて",
            "zh": "对不起，没能陪在你身边",
            "narrator_zh": ""
        },
        {
            "location": "133/SEL",
            "narrator": "",
            "text": "かわいいから大丈夫だよ",
            "zh": "因为很可爱，所以没关系哦",
            "narrator_zh": ""
        },
        {
            "location": "134/ACT",
            "narrator": "",
            "text": "スマイル、スマイル",
            "zh": "微笑，微笑",
            "narrator_zh": ""
        },
        {
            "location": "135/TALK",
            "narrator": "ガブリエラ",
            "text": "人の気も知らないで！",
            "zh": "也不懂人家的心情！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "136/TALK",
            "narrator": "ガブリエラ",
            "text": "それが出来ないから困ってるのに！",
            "zh": "就是因为做不到才发愁啊！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "137/TALK",
            "narrator": "ガブリエラ",
            "text": "$handle$がいてくれればいくらでも笑えるんだから",
            "zh": "只要有$handle$在，我随时都能笑出来",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "138/TALK",
            "narrator": "ガブリエラ",
            "text": "そう言うなら私のところに来てよ！",
            "zh": "你要是这么说，就来我这里啊！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "139/TALK",
            "narrator": "ガブリエラ",
            "text": "バカ！",
            "zh": "笨蛋！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "151/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "152/TALK",
            "narrator": "ガブリエラ",
            "text": "や、八つ当たりじゃ\nないわよね？",
            "zh": "不、那不是在\n迁怒吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "154/TALK",
            "narrator": "ガブリエラ",
            "text": "そうよ。\nあいつが隣にいてくれ\nないのが悪いんだから！",
            "zh": "对啊。\n那家伙不在旁边\n就是他不对！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "155/ACT",
            "narrator": "",
            "text": "ごめんね、側にいられなくて",
            "zh": "对不起，没能陪在你身边",
            "narrator_zh": ""
        },
        {
            "location": "156/TALK",
            "narrator": "ガブリエラ",
            "text": "違うの",
            "zh": "不是的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "157/TALK",
            "narrator": "ガブリエラ",
            "text": "そうじゃなくて",
            "zh": "不是那样",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "158/TALK",
            "narrator": "ガブリエラ",
            "text": "私の方こそごめんなさい",
            "zh": "该道歉的是我才对",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "160/TALK",
            "narrator": "ガブリエラ",
            "text": "でも",
            "zh": "不过",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "161/TALK",
            "narrator": "ガブリエラ",
            "text": "$handle$が隣にいないのは悪いことだから",
            "zh": "因为$handle$不在旁边就是不对的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "162/TALK",
            "narrator": "ガブリエラ",
            "text": "それは謝らないから！",
            "zh": "那个我不会道歉！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "174/ACT",
            "narrator": "",
            "text": "かわいいから大丈夫だよ",
            "zh": "因为很可爱，所以没关系哦",
            "narrator_zh": ""
        },
        {
            "location": "175/TALK",
            "narrator": "ガブリエラ",
            "text": "理由になってないから",
            "zh": "这理由根本不成立",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "176/TALK",
            "narrator": "ガブリエラ",
            "text": "そもそも",
            "zh": "说到底",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "177/TALK",
            "narrator": "ガブリエラ",
            "text": "可愛いって言ってくれるの$handle$だけだから",
            "zh": "会说我可爱的就只有$handle$了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "178/TALK",
            "narrator": "ガブリエラ",
            "text": "まったく信用できないわ",
            "zh": "根本没法信任呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "179/TALK",
            "narrator": "ガブリエラ",
            "text": "っていうか",
            "zh": "话说",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "180/TALK",
            "narrator": "ガブリエラ",
            "text": "本当に可愛いって思ってるなら",
            "zh": "要是你真觉得我可爱",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "181/TALK",
            "narrator": "ガブリエラ",
            "text": "私の隣に来なさいよ！",
            "zh": "就到我身边来啊！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "16/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>某月某日　 0:25 PM</color>\nとある平日の昼休み、付属学園中等部ガブリエラの教室にて",
            "zh": "<color=green>某月某日　 0:25 PM</color>\n某个平日的午休，于附属学园中等部加布里埃拉的教室",
            "narrator_zh": "Dialog_EventData"
        }
    ]
}
