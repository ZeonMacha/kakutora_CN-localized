{
    "dir": "chap00/daydra/spev_ch04_012.js",
    "type": "",
    "info": {
        "story_id": "4012",
        "cid": "",
        "title": "スペシャルエピソード",
        "sub_title": "悪魔の誘惑",
        "title_zh": "特别篇",
        "sub_title_zh": "恶魔的诱惑"
    },
    "entry": [
        {
            "location": "22/TALK",
            "narrator": "透明みやび",
            "text": "ほれほれ、相棒。\n怖くないき、\nこっち来ぃ。",
            "zh": "来嘛来嘛，搭档。\n不吓人啵，\n快过来。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "23/TALK",
            "narrator": "透明みやび",
            "text": "今ならうちのこと、\n好き放題してもえいぞ～。",
            "zh": "这会儿你想对我\n怎么胡来都得哦～。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "25/SEL",
            "narrator": "（選択肢）",
            "text": "本当に？",
            "zh": "真的吗？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "26/SEL",
            "narrator": "（選択肢）",
            "text": "逆に何かするでしょ？",
            "zh": "反过来你也要做什么吧？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "27/ACT",
            "narrator": "",
            "text": "本当に？",
            "zh": "真的吗？",
            "narrator_zh": ""
        },
        {
            "location": "28/TALK",
            "narrator": "透明みやび",
            "text": "もちろんや。\n触り放題撫で放題、\nついでに吸い放題やぞ。",
            "zh": "那当然咯。\n随便摸随便揉，\n顺带还随便吸咯。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "29/TALK",
            "narrator": "透明みやび",
            "text": "…それはうちにも\n言えることやけんど。",
            "zh": "……这话放我身上\n也一样适用，但是。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "30/ACT",
            "narrator": "",
            "text": "逆に何かするでしょ？",
            "zh": "反过来你也要做什么吧？",
            "narrator_zh": ""
        },
        {
            "location": "33/TALK",
            "narrator": "透明みやび",
            "text": "バカを言うな！",
            "zh": "别说傻话！",
            "narrator_zh": "透明雅"
        },
        {
            "location": "34/TALK",
            "narrator": "透明みやび",
            "text": "世の中、一方だけが\n得するゆう上手い話、\nあるわけないやろ？",
            "zh": "这世上哪有\n只让一方占便宜的\n美事嘛，对吧？",
            "narrator_zh": "透明雅"
        },
        {
            "location": "35/TALK",
            "narrator": "透明みやび",
            "text": "当然、ちくっと\n吸わせてもらうぞね。",
            "zh": "当然，也得让我\n稍微吸一口咧。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "38/TALK",
            "narrator": "透明みやび",
            "text": "まあ、死にはせん。",
            "zh": "嘛，又不会死人。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "39/TALK",
            "narrator": "透明みやび",
            "text": "それに、首元に牙の痕が\n残りはするけんど…。",
            "zh": "再说了，脖颈上是会\n留下牙印，但是……。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "40/TALK",
            "narrator": "透明みやび",
            "text": "女に噛まれて吸われた\n勲章や思えば、\n誇らしいと思わんか？",
            "zh": "你就当成是被女人\n咬了又吸的勋章，\n不觉得还挺自豪的咩？",
            "narrator_zh": "透明雅"
        },
        {
            "location": "41/SEL",
            "narrator": "（選択肢）",
            "text": "言われてみれば確かに",
            "zh": "听你这么一说确实",
            "narrator_zh": "（选项）"
        },
        {
            "location": "42/SEL",
            "narrator": "（選択肢）",
            "text": "そういうもんなの？",
            "zh": "是这么回事吗？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "43/ACT",
            "narrator": "",
            "text": "言われてみれば確かに",
            "zh": "听你这么一说确实",
            "narrator_zh": ""
        },
        {
            "location": "46/TALK",
            "narrator": "透明みやび",
            "text": "理解が早くて素晴らしい。\nさすが、うちの自慢の\n相棒や。",
            "zh": "领悟得快，太棒了。\n不愧是我引以为傲的\n搭档咯。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "47/TALK",
            "narrator": "透明みやび",
            "text": "イケメンな性格に\n思わず顔が赤くなって\nしまい…。",
            "zh": "被你这帅气的性子\n搞得我脸都忍不住\n红起来了……。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "48/TALK",
            "narrator": "透明みやび",
            "text": "ついでに赤い血が\n更に欲しくなってきた\nがよ。",
            "zh": "顺带连那红彤彤的血\n也更想要起来了\n咧。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "49/ACT",
            "narrator": "",
            "text": "そういうもんなの？",
            "zh": "是这么回事吗？",
            "narrator_zh": ""
        },
        {
            "location": "51/TALK",
            "narrator": "透明みやび",
            "text": "そりゃそうやろ。",
            "zh": "那当然咯。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "52/TALK",
            "narrator": "透明みやび",
            "text": "そんな傷つけた状態で\n街中歩いてみぃ。",
            "zh": "你顶着那么个印子\n上街走一圈试试看。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "53/TALK",
            "narrator": "透明みやび",
            "text": "おっ、あいつなかなか\nやりよるなぁ…。",
            "zh": "“哦，那小子\n还真有两下子嘛……”",
            "narrator_zh": "透明雅"
        },
        {
            "location": "54/TALK",
            "narrator": "透明みやび",
            "text": "っちゅう感じで、\n視線釘付け\n間違いなしぞね。",
            "zh": "准保像那样，\n把周边视线全吸过来\n没跑了咧。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "57/TALK",
            "narrator": "透明みやび",
            "text": "それに、さっきから\n言うちょるけんど…。",
            "zh": "而且啊，打刚才起\n我就说过了，但是……。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "58/TALK",
            "narrator": "透明みやび",
            "text": "ロハでくれ言うちょる\nわけやない。",
            "zh": "我也不是让你\n白白给我吸。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "59/TALK",
            "narrator": "透明みやび",
            "text": "うちが吸うてる間、\nうちを好きにしてえい\nっちゅう…。",
            "zh": "是在我吸的那会儿，\n随便你怎么折腾我\n都得……。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "60/TALK",
            "narrator": "透明みやび",
            "text": "持ってけ泥棒大安売り\n条件やぞ？",
            "zh": "简直是赔本大甩卖\n级别的跳楼条件咯？",
            "narrator_zh": "透明雅"
        },
        {
            "location": "61/TALK",
            "narrator": "透明みやび",
            "text": "うちには邪魔くさいだけの\nものやけんど…。",
            "zh": "虽说对我而言\n不过是碍事的累赘，但是……。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "63/TALK",
            "narrator": "透明みやび",
            "text": "ほれ、この無駄にでかい\nだけの胸とか、\n興味を引かれんか？",
            "zh": "瞧，像这除了白白占地儿\n一无是处的大胸，\n你不感兴趣咩？",
            "narrator_zh": "透明雅"
        },
        {
            "location": "64/SEL",
            "narrator": "（選択肢）",
            "text": "そりゃ、引かれるけど…",
            "zh": "那肯定感兴趣，可是……",
            "narrator_zh": "（选项）"
        },
        {
            "location": "65/SEL",
            "narrator": "（選択肢）",
            "text": "う～ん…",
            "zh": "唔～……",
            "narrator_zh": "（选项）"
        },
        {
            "location": "66/ACT",
            "narrator": "",
            "text": "そりゃ、引かれるけど…",
            "zh": "那肯定感兴趣，可是……",
            "narrator_zh": ""
        },
        {
            "location": "68/TALK",
            "narrator": "透明みやび",
            "text": "ならここは一つ\n勇気を出して…。",
            "zh": "那这里就且\n鼓起勇气……。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "69/ACT",
            "narrator": "",
            "text": "う～ん…",
            "zh": "唔～……",
            "narrator_zh": ""
        },
        {
            "location": "70/TALK",
            "narrator": "透明みやび",
            "text": "なんと…相棒はもっと\nツルッとすべすべ\nぺったんこが好みか？",
            "zh": "居然……搭档你\n更喜欢那种滑溜溜\n平平的飞机场咩？",
            "narrator_zh": "透明雅"
        },
        {
            "location": "71/TALK",
            "narrator": "透明みやび",
            "text": "ふむ…そうなると\nうちとは正反対っちゅう\nことになるな…。",
            "zh": "唔……那岂不是\n跟我完全相反\n了嘛……。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "73/TALK",
            "narrator": "透明みやび",
            "text": "いや、好き嫌いはいかん！\n自分の好みだけで考えては\nろくなことにならんぞね。",
            "zh": "不对，不能挑食！\n光顾着自己的喜好想东想西，\n可没驷马好下场咧。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "75/TALK",
            "narrator": "透明みやび",
            "text": "ほれ、お互い損する\nことはないんやき、\nささっと済ますがよ。",
            "zh": "来嘛，反正对我们俩\n都没半点吃亏啵，\n麻利点办完咧。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "76/SEL",
            "narrator": "（選択肢）",
            "text": "そ、それじゃあ…",
            "zh": "那、那就……",
            "narrator_zh": "（选项）"
        },
        {
            "location": "77/ACT",
            "narrator": "",
            "text": "そ、それじゃあ…",
            "zh": "那、那就……",
            "narrator_zh": ""
        },
        {
            "location": "81/TALK",
            "narrator": "透明みやび",
            "text": "…交渉成立やね。",
            "zh": "……交涉成立咯。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "82/TALK",
            "narrator": "透明みやび",
            "text": "じゃあ、お互い\n甘い一時を楽しむと\nするぞね。",
            "zh": "那就，让我们俩\n好好享受这甜蜜的\n一刻咧。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "83/TALK",
            "narrator": "透明みやび",
            "text": "ふふっ…。",
            "zh": "呵呵……。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "85/TALK",
            "narrator": "透明みやび",
            "text": "…ん？",
            "zh": "……嗯？",
            "narrator_zh": "透明雅"
        },
        {
            "location": "86/TALK",
            "narrator": "透明みやび",
            "text": "いや、ちくっと待ちぃ。\nストップや。",
            "zh": "不对，等子一下。\n先停下。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "87/SEL",
            "narrator": "（選択肢）",
            "text": "ここでお預けか！？",
            "zh": "偏要在这里吊胃口吗！？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "88/ACT",
            "narrator": "",
            "text": "ここでお預けか！？",
            "zh": "偏要在这里吊胃口吗！？",
            "narrator_zh": ""
        },
        {
            "location": "90/TALK",
            "narrator": "透明みやび",
            "text": "いや…考えてみたらうち、\nまだ皮膚から直接血を\n飲んだことなかったちや。",
            "zh": "不是……仔细一想，\n我还从来没直接从\n皮肤里喝过血滴。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "91/TALK",
            "narrator": "透明みやび",
            "text": "やき、こうしてじっくり\n人間の皮膚っちゅうのを\n見ると…。",
            "zh": "所以啵，像这样仔细\n端详起人类皮肤\n这东西……。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "92/TALK",
            "narrator": "透明みやび",
            "text": "…なんや、堅そうで\n直接吸うのめっちゃ\n億劫そうやな…。",
            "zh": "……总觉得硬邦邦的，\n直接咬上去吸\n好麻烦的样子啊……。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "94/TALK",
            "narrator": "透明みやび",
            "text": "はぁ…注射器で\nちゅちゅっと吸って\n飲むか…。",
            "zh": "唉……要不用针筒\n滋溜抽一管\n来喝咩……。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "95/SEL",
            "narrator": "（選択肢）",
            "text": "注射！？　イヤだよ！！",
            "zh": "打针！？　不要啊！！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "96/ACT",
            "narrator": "",
            "text": "注射！？　イヤだよ！！",
            "zh": "打针！？　不要啊！！",
            "narrator_zh": ""
        },
        {
            "location": "98/TALK",
            "narrator": "透明みやび",
            "text": "注射針の方が\n歯より細いき、\n痛くなかろうに…。",
            "zh": "注射针明明\n比牙齿细得多啵，\n肯定没那么痛嘛……。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "100/TALK",
            "narrator": "透明みやび",
            "text": "じゃあ、注射じゃなくて\nえいき、相棒が自分で\n血を出すぞね。",
            "zh": "那行，不用针筒\n也得啵，搭档你自己\n放点血出来咧。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "101/TALK",
            "narrator": "透明みやび",
            "text": "それならうちも\n労力使わずグビグビ\n飲めてラクやし。",
            "zh": "这样一来我也能\n不费力气大口大口\n畅饮，多省事。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "102/SEL",
            "narrator": "（選択肢）",
            "text": "じゃあ、包丁で手首を…",
            "zh": "那，用菜刀往手腕……",
            "narrator_zh": "（选项）"
        },
        {
            "location": "103/SEL",
            "narrator": "（選択肢）",
            "text": "却下だよ！！",
            "zh": "驳回！！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "104/ACT",
            "narrator": "",
            "text": "じゃあ、包丁で手首を…",
            "zh": "那，用菜刀往手腕……",
            "narrator_zh": ""
        },
        {
            "location": "106/TALK",
            "narrator": "透明みやび",
            "text": "誰が死ねとまで言うた！？",
            "zh": "谁让你去寻死了啊！？",
            "narrator_zh": "透明雅"
        },
        {
            "location": "107/TALK",
            "narrator": "透明みやび",
            "text": "相棒はその名の通り\nうちの相棒なんやぞ？",
            "zh": "搭档你人如其名，\n可是我的搭档咯？",
            "narrator_zh": "透明雅"
        },
        {
            "location": "108/TALK",
            "narrator": "透明みやび",
            "text": "命を大切にしてもらえんと\n困るぞね。",
            "zh": "不好好爱惜性命\n我可要头疼咧。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "109/ACT",
            "narrator": "",
            "text": "却下だよ！！",
            "zh": "驳回！！",
            "narrator_zh": ""
        },
        {
            "location": "111/TALK",
            "narrator": "透明みやび",
            "text": "しょんぼりすることを\n平然と言いよったな？",
            "zh": "真敢面不改色地\n说出这种叫人泄气的话啊？",
            "narrator_zh": "透明雅"
        },
        {
            "location": "112/TALK",
            "narrator": "透明みやび",
            "text": "まったく…ちくっと\n血を流すくらいで\n大袈裟な…。",
            "zh": "真是的……不就稍微\n流点血而已嘛，\n大惊小怪的……。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "115/TALK",
            "narrator": "透明みやび",
            "text": "…まあ、この格好で\nしばらく色仕掛けを\n続けちょれば…。",
            "zh": "……嘛，穿着这身\n再这么持续施展一阵\n美人计的话……。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "116/TALK",
            "narrator": "透明みやび",
            "text": "そのうち、相棒の鼻から\n血がブッシューするかも\nしれん。",
            "zh": "说不定过会儿\n搭档鼻子里就会\n噗嗤一声喷血出来。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "118/TALK",
            "narrator": "透明みやび",
            "text": "それを楽しみに\n待つとするぞね。",
            "zh": "我就怀着期待\n等着那时候咧。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "119/SEL",
            "narrator": "（選択肢）",
            "text": "多分出ないけどね",
            "zh": "多半不会流吧",
            "narrator_zh": "（选项）"
        },
        {
            "location": "120/ACT",
            "narrator": "",
            "text": "多分出ないけどね",
            "zh": "多半不会流吧",
            "narrator_zh": ""
        },
        {
            "location": "122/TALK",
            "narrator": "透明みやび",
            "text": "やってみんことには\nわからんがよ。",
            "zh": "没试过怎么晓得\n行不行咧。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "123/TALK",
            "narrator": "透明みやび",
            "text": "ちゅーわけやき、\nふふふ…。",
            "zh": "既然如此啵，\n呵呵呵……。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "126/TALK",
            "narrator": "透明みやび",
            "text": "…ほれ、これでどうや？",
