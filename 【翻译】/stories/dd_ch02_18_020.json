            "narrator_zh": "绫水"
        },
        {
            "location": "499/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "502/TALK",
            "narrator": "ガブリエラ",
            "text": "…まあ、いいけど。\nあたしも久しぶりに\n食べたいし――",
            "zh": "……算了，也行吧。\n正好我也好久没吃了，\n怪想念的——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "503/TALK",
            "narrator": "ガブリエラ",
            "text": "最近は創作和食ばかりで、\nずっと作ってなかった\nから、自信ないけど。",
            "zh": "不过最近光顾着做\n创意日料，好久没做过了，\n没什么自信就是了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "504/TALK",
            "narrator": "アーヤ",
            "text": "大丈夫よ。\n楽しみにしてるわ。",
            "zh": "没关系的。\n我很期待哦。",
            "narrator_zh": "绫水"
