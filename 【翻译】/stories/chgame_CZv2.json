        "title": "",
        "sub_title": "CZジャンプ台（みやび）",
        "title_zh": "",
        "sub_title_zh": "CZ跳跃台（雅）"
    },
    "entry": [
        {
            "location": "1886/SCENARIO",
            "narrator": "",
            "text": "CZジャンプ台（みやび）",
            "zh": "CZ跳跃台（雅）",
            "narrator_zh": ""
        },
        {
            "location": "1898/TALK",
            "narrator": "千羽鶴",
            "text": "ここは\nコイガサコ博士の\n研究所跡地。",
            "zh": "这里是\n恋之崎博士的\n研究所遗址。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1899/TALK",
            "narrator": "千羽鶴",
            "text": "そしてジャンプ台が\nあったところでもある。",
            "zh": "也是跳跃台\n曾经所在的地方。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1900/TALK",
            "narrator": "千羽鶴",
            "text": "そしてこの\nジャンプ台は\nチートの象徴。",
            "zh": "而且这座跳跃台，\n正是开挂的\n象征。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1901/TALK",
            "narrator": "千羽鶴",
            "text": "実はこのRPGゲームは\n國政綾水を倒して\n進むのが正道であり――",
            "zh": "其实这款RPG游戏，\n打倒国政绫水前进\n才是正道——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1902/TALK",
            "narrator": "千羽鶴",
            "text": "ジャンプ台を使うのは\n裏道として設定していた。",
            "zh": "而用跳跃台，\n则是设定上的邪道。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1903/TALK",
            "narrator": "千羽鶴",
            "text": "現実でもそうだけど――",
            "zh": "现实里也是这样——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1904/TALK",
            "narrator": "千羽鶴",
            "text": "恋ヶ崎みやびは\nトライナリーの\nジョーカーともいえる。",
            "zh": "恋之崎雅，\n可以说是三重奏里的\n王牌。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1905/TALK",
            "narrator": "千羽鶴",
            "text": "彼女は絶大なる\n能力を秘めてはいるけど、\n誰にも心を許さない。",
            "zh": "她身怀绝大的能力，\n却不对任何人\n敞开心扉。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1906/TALK",
            "narrator": "千羽鶴",
            "text": "だからこそ、\n普段から頼るべきは\n國政綾水であり――",
            "zh": "正因为如此，\n平时该依靠的\n是国政绫水——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1907/TALK",
            "narrator": "千羽鶴",
            "text": "恋ヶ崎みやびに何かを\n頼る場合は、何らかの\n代償を覚悟すべきである。",
            "zh": "而若要依靠恋之崎雅，\n就得觉悟好付出\n某种代价。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1908/TALK",
            "narrator": "千羽鶴",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1909/TALK",
            "narrator": "千羽鶴",
            "text": "もちろん、\n情報管理庁長官としての\n立場の話。",
            "zh": "当然，说的是\n情报管理厅长官\n立场上的话。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1910/TALK",
            "narrator": "千羽鶴",
            "text": "貴方は相棒として、\nのんべんだらりと\n過ごしていればいい。",
            "zh": "你作为搭档，\n悠哉悠哉地\n过日子就好。",
            "narrator_zh": "千羽鹤"
        }
    ]
}
