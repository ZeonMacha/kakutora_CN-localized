{
    "dir": "chap12/daydra/dd_ch01_12_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "12152",
        "cid": "tsubame",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "電車が止まった",
        "title_zh": "Extra002 额外剧情",
        "sub_title_zh": "电车停了"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "電車が止まった",
            "zh": "电车停了",
            "narrator_zh": ""
        },
        {
            "location": "21/TALK",
            "narrator": "つばめ",
            "text": "…みんな、\nまだ電車の中かな？",
            "zh": "……大家，\n还在电车里吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "23/TALK",
            "narrator": "ヒカル",
            "text": "そうみたいだね。",
            "zh": "看起来是这样。",
            "narrator_zh": "光"
        },
        {
            "location": "24/TALK",
            "narrator": "ヒカル",
            "text": "運行状況を見たら、\nまだ運転見合わせに\nなってるし…。",
            "zh": "看了运行情况，\n还在停运\n……。",
            "narrator_zh": "光"
        },
        {
            "location": "25/TALK",
            "narrator": "神楽",
            "text": "それにしても、\nこんなことって\nあるんですね。",
            "zh": "话说回来，\n还会有\n这种事啊。",
            "narrator_zh": "神乐"
        },
        {
            "location": "27/TALK",
            "narrator": "神楽",
            "text": "私達以外、みんな電車に\n閉じ込められるなんて…。",
            "zh": "除了我们，大家都\n被关在电车里……",
            "narrator_zh": "神乐"
        },
        {
            "location": "28/TALK",
            "narrator": "つばめ",
            "text": "授業の後、すぐに劇場に\n来て正解だったよね。",
            "zh": "下了课马上到剧场，\n来对了呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "29/TALK",
            "narrator": "神楽",
            "text": "でも、映写機の動かし方を\n誰も知らないんじゃ、\n意味ないですけど…。",
            "zh": "不过，放映机怎么开\n谁都不知道的话，\n也没什么意义……",
            "narrator_zh": "神乐"
        },
        {
            "location": "30/TALK",
            "narrator": "ヒカル",
            "text": "劇場、開けられない\nからね…。",
            "zh": "剧场，\n打不开啊……",
            "narrator_zh": "光"
        },
        {
            "location": "31/TALK",
            "narrator": "つばめ",
            "text": "…待ってるの、退屈だね。",
            "zh": "……干等着，好无聊呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "32/TALK",
            "narrator": "ヒカル",
            "text": "そうだね…。",
            "zh": "是啊……",
            "narrator_zh": "光"
        },
        {
            "location": "35/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "39/TALK",
            "narrator": "神楽",
            "text": "私達、このままでいいん\nでしょうか？",
            "zh": "我们就这样，\n真的好吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "41/TALK",
            "narrator": "つばめ",
            "text": "どういうこと？",
            "zh": "怎么回事？",
            "narrator_zh": "燕"
        },
        {
            "location": "43/TALK",
            "narrator": "神楽",
            "text": "今のこの状況ですよ。",
            "zh": "就是现在这个情况。",
            "narrator_zh": "神乐"
        },
        {
            "location": "44/TALK",
            "narrator": "神楽",
            "text": "私達、高校生ですよ？\n青春時代真っ盛りですよ？",
            "zh": "我们是高中生哦？\n正是青春正盛的时候哦？",
            "narrator_zh": "神乐"
        },
        {
            "location": "46/TALK",
            "narrator": "神楽",
            "text": "なのに、開けられもしない\n劇場の中で、ダラダラ\n時間を潰してるなんて――",
            "zh": "可是，在打都打不开的\n剧场里，懒懒散散\n把时间耗掉——",
            "narrator_zh": "神乐"
        },
        {
            "location": "48/TALK",
            "narrator": "神楽",
            "text": "青春の無駄遣いをして\nいるとは思いませんか？",
            "zh": "这不就是在\n浪费青春吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "50/TALK",
            "narrator": "つばめ",
            "text": "そ、そうかなぁ？\nヒカルくんはどう思う？",
            "zh": "是、是这样吗？\n光，你怎么想？",
            "narrator_zh": "燕"
        },
        {
            "location": "51/TALK",
            "narrator": "ヒカル",
            "text": "えっと…どうだろう？\n無駄にしてるように\n見えるのかな？",
            "zh": "那个……怎么样呢？\n看起来像是\n在浪费吗？",
            "narrator_zh": "光"
        },
        {
            "location": "52/TALK",
            "narrator": "神楽",
            "text": "してますよ。\n青春を謳歌している風に\n全然見えません。",
            "zh": "就是在浪费。\n完全看不出\n在享受青春。",
            "narrator_zh": "神乐"
        },
        {
            "location": "54/TALK",
            "narrator": "つばめ",
            "text": "そ、そう言われても、\n謳歌する方法なんて\nわからないし…。",
            "zh": "你、你这么说，\n可享受青春的方法\n我也不知道……",
            "narrator_zh": "燕"
        },
        {
            "location": "55/TALK",
            "narrator": "神楽",
            "text": "青春を謳歌するための\n簡単な方法といえば――",
            "zh": "要说享受青春的\n简单方法——",
            "narrator_zh": "神乐"
        },
        {
            "location": "56/TALK",
            "narrator": "神楽",
            "text": "恋愛以外にないじゃない\nですか。",
            "zh": "除了恋爱，\n没有别的吧。",
            "narrator_zh": "神乐"
        },
        {
            "location": "59/TALK",
            "narrator": "ヒカル",
            "text": "なるほど…確かにそうかも\nしれないね。",
            "zh": "原来如此……确实\n也许是这样。",
            "narrator_zh": "光"
        },
        {
            "location": "61/TALK",
            "narrator": "ヒカル",
            "text": "ただ、残念ながら\n僕にはまだそういった\n相手がいないけど…。",
            "zh": "只是，很遗憾，\n我还没有\n那样的对象……",
            "narrator_zh": "光"
        },
        {
            "location": "62/TALK",
            "narrator": "つばめ",
            "text": "そうなんだ？\nちょっと意外かも。",
            "zh": "是这样吗？\n有点意外。",
            "narrator_zh": "燕"
        },
        {
            "location": "63/TALK",
            "narrator": "神楽",
            "text": "えっ？　ヒカルくんには\nもうお相手がいるじゃない\nですか。",
            "zh": "诶？光不是\n已经有对象了\n吗。",
            "narrator_zh": "神乐"
        },
        {
            "location": "64/TALK",
            "narrator": "ヒカル",
            "text": "え？",
            "zh": "诶？",
            "narrator_zh": "光"
        },
        {
            "location": "65/TALK",
            "narrator": "神楽",
            "text": "ガブちゃんのことですよ。",
            "zh": "说的是加布呀。",
            "narrator_zh": "神乐"
        },
        {
            "location": "66/TALK",
            "narrator": "ヒカル",
            "text": "ガブリエラさん？",
            "zh": "加布里埃拉？",
            "narrator_zh": "光"
        },
        {
            "location": "67/TALK",
            "narrator": "神楽",
            "text": "そうですよ。\nお二人の関係は、\nその後どうなんですか？",
            "zh": "就是呀。\n你们两位的关系，\n后来怎么样了？",
            "narrator_zh": "神乐"
        },
        {
            "location": "68/TALK",
            "narrator": "神楽",
            "text": "少しは発展したんじゃ\nないですか？",
            "zh": "多少有点进展了\n吧？",
            "narrator_zh": "神乐"
        },
        {
            "location": "71/TALK",
            "narrator": "つばめ",
            "text": "わわっ！\nこれって、恋バナ？",
            "zh": "哇哇！\n这是在聊恋爱吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "75/TALK",
            "narrator": "ヒカル",
            "text": "えっと…卯月さん？\nいったい何のことか、\nわからないんだけど…。",
            "zh": "那个……卯月？\n我完全不知道\n你在说什么……",
            "narrator_zh": "光"
        },
        {
            "location": "78/TALK",
            "narrator": "神楽",
            "text": "…もしかして、はぐらか\nそうとしていませんか？",
            "zh": "……该不会，\n是在打岔吧？",
            "narrator_zh": "神乐"
        },
        {
            "location": "80/TALK",
            "narrator": "神楽",
            "text": "お祭りの時、\n凄く良い雰囲気だったじゃ\nないですか。",
            "zh": "祭典那时候，\n气氛不是很好\n吗。",
            "narrator_zh": "神乐"
        },
        {
            "location": "81/TALK",
            "narrator": "ヒカル",
            "text": "ああ、あの時……。",
            "zh": "啊，那时候……",
            "narrator_zh": "光"
        },
        {
            "location": "82/TALK",
            "narrator": "ヒカル",
            "text": "あの時は、特に\nこれといって話らしい\n話はしてないけど……",
            "zh": "那时候，并没有\n说什么像样的\n话……",
            "narrator_zh": "光"
        },
        {
            "location": "83/TALK",
            "narrator": "神楽",
            "text": "その後はどうなんですか？",
            "zh": "那后来呢？",
            "narrator_zh": "神乐"
        },
        {
            "location": "84/TALK",
            "narrator": "神楽",
            "text": "ＷＡＶＥやメールで\n連絡を取り合ったり\nしてるんじゃないですか？",
            "zh": "不是会用WAVE和邮件\n互相联系\n吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "85/TALK",
            "narrator": "ヒカル",
            "text": "えっと…卯月さん？\nもしかして何か勘違い\nしてるんじゃ…。",
            "zh": "那个……卯月？\n你是不是\n误会了什么……",
            "narrator_zh": "光"
        },
        {
            "location": "89/TALK",
            "narrator": "つばめ",
            "text": "ガブちゃんとヒカルくんの\n関係かぁ…。",
            "zh": "加布和光的\n关系啊……",
            "narrator_zh": "燕"
        },
        {
            "location": "101/TALK",
            "narrator": "つばめ",
            "text": "あなたはどう思う？",
            "zh": "你怎么想？",
            "narrator_zh": "燕"
        },
        {
            "location": "103/SEL",
            "narrator": "",
            "text": "ヒカルとガブリエラのこと？",
            "zh": "光和加布里埃拉的事？",
            "narrator_zh": ""
        },
        {
            "location": "104/ACT",
            "narrator": "",
            "text": "ヒカルとガブリエラのこと？",
            "zh": "光和加布里埃拉的事？",
            "narrator_zh": ""
        },
        {
            "location": "106/TALK",
            "narrator": "つばめ",
            "text": "そう",
            "zh": "对",
            "narrator_zh": "燕"
        },
        {
            "location": "107/TALK",
            "narrator": "つばめ",
            "text": "何のことか聞く前だったのに、よくわかったね？",
            "zh": "我还没问是什么事，你就听懂了？",
            "narrator_zh": "燕"
        },
        {
            "location": "109/SEL",
            "narrator": "",
            "text": "聞いてたからね",
            "zh": "因为我在听",
            "narrator_zh": ""
        },
        {
            "location": "110/ACT",
            "narrator": "",
            "text": "聞いてたからね",
            "zh": "因为我在听",
            "narrator_zh": ""
        },
        {
            "location": "112/TALK",
            "narrator": "つばめ",
            "text": "声が出るなら、一緒にお話しできそうだね",
            "zh": "要是能出声，就能一起聊天了呀",
            "narrator_zh": "燕"
        },
        {
            "location": "114/TALK",
            "narrator": "つばめ",
            "text": "話逸れちゃった、ごめん",
            "zh": "话题跑掉了，对不起",
            "narrator_zh": "燕"
        },
        {
            "location": "115/TALK",
            "narrator": "つばめ",
            "text": "卯月さんはああ言ってるけど",
            "zh": "卯月是那么说的",
            "narrator_zh": "燕"
        },
        {
            "location": "116/TALK",
            "narrator": "つばめ",
            "text": "二人とも、本当にそういう関係なのかな？",
            "zh": "他们两个，真的是那种关系吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "118/SEL",
            "narrator": "",
            "text": "ヒカルはモテそうだしね",
            "zh": "光看起来就很受欢迎",
            "narrator_zh": ""
        },
        {
            "location": "119/SEL",
            "narrator": "",
            "text": "ガブリエラに聞いてみよう",
            "zh": "去问问加布里埃拉吧",
            "narrator_zh": ""
        },
        {
            "location": "120/ACT",
            "narrator": "",
            "text": "ヒカルはモテそうだしね",
            "zh": "光看起来就很受欢迎",
            "narrator_zh": ""
        },
        {
            "location": "122/TALK",
            "narrator": "つばめ",
            "text": "確かに、ヒカルくんってかっこいいもんね",
            "zh": "确实，光很帅呀",
            "narrator_zh": "燕"
        },
        {
            "location": "123/TALK",
            "narrator": "つばめ",
            "text": "だとしたら、ガブちゃんが好きになっても、おかしくないよね",
            "zh": "那样的话，加布喜欢上也没什么奇怪的",
            "narrator_zh": "燕"
        },
        {
            "location": "134/TALK",
            "narrator": "ヒカル",
            "text": "あの、言っておきますが\n僕とガブリエラさんは、\nただのお友達だよ。",
            "zh": "那个，我先说清楚，\n我和加布里埃拉\n只是普通朋友。",
            "narrator_zh": "光"
        },
        {
            "location": "135/TALK",
            "narrator": "ヒカル",
            "text": "本当に、卯月さんが\n思っているような\n関係じゃないよ。",
            "zh": "真的不是\n卯月想的\n那种关系。",
            "narrator_zh": "光"
        },
        {
            "location": "139/TALK",
            "narrator": "つばめ",
            "text": "…でも、ガブちゃんは\nそう思ってないかも\nしれないよ？",
            "zh": "……可是，加布\n也许不这么想\n哦？",
            "narrator_zh": "燕"
        },
        {
            "location": "140/TALK",
            "narrator": "ヒカル",
            "text": "ちょ、逢瀬さん！？",
            "zh": "等、逢濑！？",
            "narrator_zh": "光"
        },
        {
            "location": "143/TALK",
            "narrator": "つばめ",
            "text": "だって、ヒカルくんって\n凄くかっこいいから、\n女の子にモテそうだし――",
            "zh": "因为光\n很帅，\n女孩子会喜欢——",
            "narrator_zh": "燕"
        },
        {
            "location": "144/TALK",
            "narrator": "つばめ",
            "text": "ガブちゃんが好きに\nなったとしても、\nおかしくないもん。",
            "zh": "就算加布\n喜欢上了，\n也不奇怪。",
            "narrator_zh": "燕"
        },
        {
            "location": "146/TALK",
            "narrator": "神楽",
            "text": "っ！？",
            "zh": "唔！？",
            "narrator_zh": "神乐"
        },
        {
            "location": "150/TALK",
            "narrator": "ヒカル",
            "text": "え…いや、あはは…。",
            "zh": "诶……不是，啊哈哈……",
            "narrator_zh": "光"
        },
        {
            "location": "151/TALK",
            "narrator": "ヒカル",
            "text": "…なんというか、その…\nありがとうございます、で\nいいのかな？",
            "zh": "……怎么说呢，那个……\n回一句谢谢，\n这样行吗？",
            "narrator_zh": "光"
        },
        {
            "location": "153/TALK",
            "narrator": "つばめ",
            "text": "？　何が？",
            "zh": "？什么？",
            "narrator_zh": "燕"
        },
        {
            "location": "157/TALK",
            "narrator": "神楽",
            "text": "…つばめさん、\n凄いですね。",
            "zh": "……燕，\n好厉害。",
            "narrator_zh": "神乐"
        },
        {
            "location": "158/TALK",
            "narrator": "神楽",
            "text": "男の子に対して、サラッと\nかっこいい、って言える\nなんて…。",
            "zh": "对男孩子，能轻飘飘地\n说出帅，\n这种事……",
            "narrator_zh": "神乐"
        },
        {
            "location": "161/TALK",
            "narrator": "つばめ",
            "text": "えっ！？\nで、でも、事実だし…。",
            "zh": "诶！？\n可、可是，这是事实……",
            "narrator_zh": "燕"
        },
        {
            "location": "163/TALK",
            "narrator": "神楽",
            "text": "…まさかとは思いますが、\nつばめさんも\nヒカルくんのことを…。",
            "zh": "……我想不至于，\n燕也\n对光……",
            "narrator_zh": "神乐"
        },
        {
            "location": "165/TALK",
            "narrator": "つばめ",
            "text": "ち、違う、違うよ。\nそういうんじゃないよ！",
            "zh": "不、不是，不是的。\n不是那种意思！",
            "narrator_zh": "燕"
        },
        {
            "location": "166/TALK",
            "narrator": "つばめ",
            "text": "わたしはただ、ほら…\nガブちゃんだって\n女の子だから――",
            "zh": "我只是，你看……\n加布也是\n女孩子——",
            "narrator_zh": "燕"
        },
        {
            "location": "167/TALK",
            "narrator": "つばめ",
            "text": "ヒカルくんみたいな\nかっこいい男の子は\n好きかも、って…。",
            "zh": "像光这样\n帅的男孩子，\n也许会喜欢……",
            "narrator_zh": "燕"
        },
        {
            "location": "169/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "170/TALK",
            "narrator": "つばめ",
            "text": "だから、わたしが好きとか\nそういうんじゃなくて、\nその…。",
            "zh": "所以，不是我喜欢\n那种意思，\n那个……",
            "narrator_zh": "燕"
        },
        {
            "location": "173/TALK",
            "narrator": "神楽",
            "text": "冗談のつもりでした。",
            "zh": "我是想开玩笑的。",
            "narrator_zh": "神乐"
        },
        {
            "location": "174/TALK",
            "narrator": "神楽",
            "text": "でも、そんなに慌てる\nところを見ると、\n本当は…。",
            "zh": "不过，看你慌成\n这样，\n其实……",
            "narrator_zh": "神乐"
        },
        {
            "location": "176/TALK",
            "narrator": "つばめ",
            "text": "こういう話に慣れてない\nだけなんだってばー！",
            "zh": "我只是不习惯\n聊这种话啦——！",
            "narrator_zh": "燕"
        },
        {
            "location": "178/TALK",
            "narrator": "ヒカル",
            "text": "…僕からも、逢瀬さんを\nフォローするべきかも\nしれないけど――",
            "zh": "……也许我也该\n帮逢濑圆一下\n——",
            "narrator_zh": "光"
        },
        {
            "location": "179/TALK",
            "narrator": "ヒカル",
            "text": "余計に話がこんがらがり\nそうだし、黙ってた方が\n良さそうだね…。",
            "zh": "再说下去只会\n更乱，还是闭嘴\n比较好……",
            "narrator_zh": "光"
        },
        {
            "location": "180/ACT",
            "narrator": "",
            "text": "ガブリエラに聞いてみよう",
            "zh": "去问问加布里埃拉吧",
            "narrator_zh": ""
        },
        {
            "location": "181/TALK",
            "narrator": "つばめ",
            "text": "教えてくれるかな？",
            "zh": "会告诉我吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "182/TALK",
            "narrator": "つばめ",
            "text": "でも、今は前と違って仲良くなれたんだし",
            "zh": "不过，现在和以前不一样，已经变熟了",
            "narrator_zh": "燕"
        },
        {
            "location": "183/TALK",
            "narrator": "つばめ",
            "text": "きっと、教えてくれるよね？",
            "zh": "一定会告诉我的吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "184/TALK",
            "narrator": "つばめ",
            "text": "ＷＡＶＥを送って聞いてみるよ",
            "zh": "我发WAVE去问问",
            "narrator_zh": "燕"
        },
        {
            "location": "191/TALK",
            "narrator": "つばめ",
            "text": "えっと、なんて書こう\nかなぁ？",
            "zh": "那个，写什么\n好呢？",
            "narrator_zh": "燕"
        },
        {
            "location": "195/TALK",
            "narrator": "ヒカル",
            "text": "あの、言っておきますが\n僕とガブリエラさんは、\nただのお友達だよ。",
            "zh": "那个，我先说清楚，\n我和加布里埃拉\n只是普通朋友。",
            "narrator_zh": "光"
        },
        {
            "location": "196/TALK",
            "narrator": "ヒカル",
            "text": "本当に、卯月さんが\n思っているような\n関係じゃないよ。",
            "zh": "真的不是\n卯月想的\n那种关系。",
            "narrator_zh": "光"
        },
        {
            "location": "197/TALK",
            "narrator": "つばめ",
            "text": "…よし、送信！\n返事来るかなぁ？",
            "zh": "……好，发送！\n会有回信吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "200/TALK",
            "narrator": "神楽",
            "text": "…それは、将来的には\nそうなる可能性もある、\nということですか？",
            "zh": "……这是说，将来\n也有可能变成那样，\n是吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "203/TALK",
            "narrator": "ヒカル",
            "text": "なんか、芸能レポーター\nみたいになってるよ…？",
            "zh": "怎么，变得像\n娱乐记者了……？",
            "narrator_zh": "光"
        },
        {
            "location": "205/TALK",
            "narrator": "神楽",
            "text": "今わかりました。\nハッキリ答えてくれない\n人にはこの聞き方が――",
            "zh": "我现在明白了。\n对不肯说清楚的人，\n就该这么问——",
            "narrator_zh": "神乐"
        },
        {
            "location": "209/TALK",
            "narrator": "神楽",
            "text": "あっ、ごめんなさい。\nちょっと電話が…。",
            "zh": "啊，对不起。\n有电话……",
            "narrator_zh": "神乐"
        },
        {
            "location": "215/TALK",
            "narrator": "神楽",
            "text": "はい、もしも…",
            "zh": "喂，你好……",
            "narrator_zh": "神乐"
        },
        {
            "location": "218/TALK",
            "narrator": "神楽",
            "text": "きゃっ！？",
            "zh": "呀！？",
            "narrator_zh": "神乐"
        },
        {
            "location": "219/TALK",
            "narrator": "神楽",
            "text": "が、ガブちゃんですか？\nえ？　いえ、変なことは\n聞いてないですから！",
            "zh": "是、是加布吗？\n诶？没有，我没问\n奇怪的事！",
            "narrator_zh": "神乐"
        },
        {
            "location": "220/TALK",
            "narrator": "神楽",
            "text": "っていうか、どうして\nそのことを知ってるん\nですか？",
            "zh": "话说，你为什么\n会知道\n这件事？",
            "narrator_zh": "神乐"
        },
        {
            "location": "222/TALK",
            "narrator": "ヒカル",
            "text": "…電話の相手、\nガブリエラさん？",
            "zh": "……电话那头，\n是加布里埃拉？",
            "narrator_zh": "光"
        },
        {
            "location": "223/TALK",
            "narrator": "つばめ",
            "text": "そうみたいだね。",
            "zh": "看起来是这样。",
            "narrator_zh": "燕"
        },
        {
            "location": "226/TALK",
            "narrator": "ヒカル",
            "text": "逢瀬さん、いったい何が\nどうなってるの？",
            "zh": "逢濑，到底\n是怎么回事？",
            "narrator_zh": "光"
        },
        {
            "location": "228/TALK",
            "narrator": "つばめ",
            "text": "う～ん…実は今ね、\nガブちゃんにＷＡＶＥで\n直接聞いてみたの。",
            "zh": "嗯……其实刚才，\n我用WAVE直接\n问了加布。",
            "narrator_zh": "燕"
        },
        {
            "location": "229/TALK",
            "narrator": "つばめ",
            "text": "ヒカルくんとの関係は、\nどこまで進んだのか、\nって。",
            "zh": "和光的关系，\n进展到哪一步了，\n这么问的。",
            "narrator_zh": "燕"
        },
        {
            "location": "238/TALK",
            "narrator": "ヒカル",
            "text": "聞いたの！？",
            "zh": "你问了！？",
            "narrator_zh": "光"
        },
        {
            "location": "239/TALK",
            "narrator": "つばめ",
            "text": "うん…あの様子だと、\n教えてもらえない\nみたいだけど…。",
            "zh": "嗯……看那样子，\n是不会告诉我\n了……",
            "narrator_zh": "燕"
        },
        {
            "location": "241/TALK",
            "narrator": "つばめ",
            "text": "やっぱり、まだ心を\n開いてくれてないの\nかなぁ？",
            "zh": "果然，还没有\n对我敞开心\n吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "252/TALK",
            "narrator": "ヒカル",
            "text": "…ああ、そうか。",
            "zh": "……啊，这样啊。",
            "narrator_zh": "光"
        },
        {
            "location": "253/TALK",
            "narrator": "ヒカル",
            "text": "こういうところが、\n天然、と言われるところ\nなんだね…。",
            "zh": "就是这种地方，\n才会被叫做\n天然吧……",
            "narrator_zh": "光"
        },
        {
            "location": "18/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>7月6日　3:45 PM</color>\n平日の放課後、神楽坂トライナリー劇場内にて。",
            "zh": "<color=green>7月6日　3:45 PM</color>\n工作日的放学后，在神乐坂三重奏剧场里。",
            "narrator_zh": "Dialog_EventData"
        }
    ]
}
