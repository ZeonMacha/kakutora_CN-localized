    },
    "entry": [
        {
            "location": "24/TALK",
            "narrator": "真幌",
            "text": "よーし、午前の訓練は\nここまでだ。",
            "zh": "好，上午的训练\n到此为止。",
            "narrator_zh": "真幌"
        },
        {
            "location": "25/TALK",
            "narrator": "真幌",
            "text": "午後はみっちりと\n模擬戦をするから、\nそのつもりでな。",
            "zh": "下午要扎扎实实\n打模拟战，\n有个准备。",
            "narrator_zh": "真幌"
        },
        {
            "location": "64/TALK",
            "narrator": "みやび",
            "text": "…まほさん、今日は\nやたらとスパルタ\nメニューやね。",
            "zh": "……真幌，今天\n斯巴达课表\n也太狠了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "65/TALK",
            "narrator": "アーヤ",
            "text": "訓練の成果がちゃんと\n出てるか、確かめたい\nのかもしれないわね。",
            "zh": "也许是想确认\n训练成果\n到底做出来没有。",
            "narrator_zh": "绫水"
        },
        {
            "location": "68/TALK",
            "narrator": "神楽",
            "text": "私、先に行きますね。",
            "zh": "我先走了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "69/TALK",
            "narrator": "神楽",
            "text": "早く食事を取って、\n少しでも長く休みたい\nので…。",
            "zh": "想快点吃饭，\n然后尽量多休息\n一会儿……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "71/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしも。\nほら、つばめも\n行くわよ。",
            "zh": "我也是。\n来，燕也\n走了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "74/TALK",
            "narrator": "つばめ",
            "text": "ううん、先行って…。\n五分くらい座ってから\n行くよ…。",
            "zh": "不了，你们先走……。\n我坐五分钟\n再走……。",
            "narrator_zh": "燕"
        },
        {
            "location": "76/TALK",
            "narrator": "ガブリエラ",
            "text": "あらそう。\nじゃあ、お先に。",
            "zh": "这样啊。\n那我先走了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "78/TALK",
            "narrator": "神楽",
            "text": "ごめんなさい、\nつばめさん。\n先行ってますね。",
            "zh": "对不起，\n燕。\n我先走了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "107/TALK",
            "narrator": "みやび",
            "text": "…卯月がつばめちゃん\n置いてくとはなぁ。",
            "zh": "……卯月把燕\n丢下就走了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "109/TALK",
            "narrator": "アーヤ",
            "text": "それだけ疲れてる\nってことでしょ。",
            "zh": "说明她就累成\n这样了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "111/TALK",
            "narrator": "つばめ",
            "text": "アーヤさん達も、\nわたしに構わず\n行ってくださいね。",
            "zh": "绫水你们也，\n不用管我，\n先走就好。",
            "narrator_zh": "燕"
        },
        {
            "location": "112/TALK",
            "narrator": "つばめ",
            "text": "少し休んだら、\nすぐにわたしも\n戻りますから。",
            "zh": "休息一下，\n我马上\n也回去。",
            "narrator_zh": "燕"
        },
        {
            "location": "114/TALK",
            "narrator": "アーヤ",
            "text": "そう？\nじゃあ、悪いけど\n先行くわね。",
            "zh": "是吗？\n那不好意思，\n我先走了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "115/TALK",
            "narrator": "つばめ",
            "text": "はい。",
            "zh": "好的。",
            "narrator_zh": "燕"
        },
        {
            "location": "118/TALK",
            "narrator": "アーヤ",
            "text": "…あ、そういえば。",
            "zh": "……啊，说起来。",
            "narrator_zh": "绫水"
        },
        {
            "location": "119/TALK",
            "narrator": "アーヤ",
            "text": "今日って確か、\n日向さん達が東京に\n帰る日だったわね？",
            "zh": "今天好像是\n日向她们回东京\n的日子吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "121/TALK",
            "narrator": "みやび",
            "text": "ああ、あの子達、\n今日帰るんか。",
            "zh": "啊，那几个孩子，\n今天回去咩。",
            "narrator_zh": "雅"
        },
        {
            "location": "122/TALK",
            "narrator": "つばめ",
            "text": "はい…午後一の\n電車で帰るって\n言ってました。",
            "zh": "是……她们说\n坐下午第一班\n电车回去。",
            "narrator_zh": "燕"
        },
        {
            "location": "123/TALK",
            "narrator": "つばめ",
            "text": "もうそろそろ、\n駅に到着する頃\nだと思います。",
            "zh": "这会儿，\n差不多该到\n车站了。",
            "narrator_zh": "燕"
        },
        {
            "location": "124/TALK",
            "narrator": "みやび",
            "text": "そうやったか…。\n別れの挨拶できんのは\n寂しいなぁ？",
            "zh": "原来是这样……。\n没能道别，\n有点寂寞咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "125/TALK",
            "narrator": "つばめ",
            "text": "それは朝起きたとき、\nＷＡＶＥでしたから\n大丈夫ですよ。",
            "zh": "那个，早上起来时\n已经在WAVE上说过，\n所以没关系。",
            "narrator_zh": "燕"
        },
        {
            "location": "127/TALK",
            "narrator": "アーヤ",
            "text": "そっか。",
            "zh": "这样啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "129/TALK",
            "narrator": "アーヤ",
            "text": "それじゃ、つばめも\n少し休んだら\n戻っておいでね。",
            "zh": "那，燕也\n休息一下\n再回来。",
            "narrator_zh": "绫水"
        },
        {
            "location": "130/TALK",
            "narrator": "つばめ",
            "text": "あ、はい。",
            "zh": "啊，好的。",
            "narrator_zh": "燕"
        },
        {
            "location": "138/TALK",
            "narrator": "つばめ",
            "text": "…ふぅ…本当、\n今日の訓練は\nキツいなぁ…。",
            "zh": "……呼……真的，\n今天的训练\n好狠呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "139/SEL",
            "narrator": "",
            "text": "雛達帰っちゃうんだ？",
            "zh": "小雏她们要回去了？",
            "narrator_zh": ""
        },
        {
            "location": "140/ACT",
            "narrator": "",
            "text": "雛達帰っちゃうんだ？",
            "zh": "小雏她们要回去了？",
            "narrator_zh": ""
        },
        {
            "location": "157/TALK",
            "narrator": "つばめ",
            "text": "ぅん(´･ω･｀) ",
            "zh": "嗯(´･ω･｀) ",
            "narrator_zh": "燕"
        },
        {
            "location": "158/TALK",
            "narrator": "つばめ",
            "text": "そぅなの",
            "zh": "是这样呀",
            "narrator_zh": "燕"
        },
        {
            "location": "159/TALK",
            "narrator": "つばめ",
            "text": "元々ひなこちゃん達は",
            "zh": "本来小雏她们",
            "narrator_zh": "燕"
        },
        {
            "location": "160/TALK",
            "narrator": "つばめ",
            "text": "早く帰ることになってて(´つω・｀)ｼｭﾝ",
            "zh": "早就定好要早点回去(´つω・｀)ｼｭﾝ",
            "narrator_zh": "燕"
        },
        {
            "location": "162/SEL",
            "narrator": "",
            "text": "やっぱり寂しい？",
            "zh": "果然还是寂寞？",
            "narrator_zh": ""
        },
        {
            "location": "163/SEL",
            "narrator": "",
            "text": "これで訓練に集中できるね",
            "zh": "这样就能专心训练了吧",
            "narrator_zh": ""
        },
        {
            "location": "164/ACT",
            "narrator": "",
            "text": "やっぱり寂しい？",
            "zh": "果然还是寂寞？",
            "narrator_zh": ""
        },
        {
            "location": "165/TALK",
            "narrator": "つばめ",
            "text": "もちろん(´･ω･｀) ",
            "zh": "当然啦(´･ω･｀) ",
            "narrator_zh": "燕"
        },
        {
            "location": "166/TALK",
            "narrator": "つばめ",
            "text": "ひなこちゃん達は帰るけど",
            "zh": "小雏她们是要回去",
            "narrator_zh": "燕"
        },
        {
            "location": "167/TALK",
            "narrator": "つばめ",
            "text": "わたし達は",
            "zh": "我们",
            "narrator_zh": "燕"
        },
        {
            "location": "168/TALK",
            "narrator": "つばめ",
            "text": "まだ合宿続くから",
            "zh": "合宿还要继续",
            "narrator_zh": "燕"
        },
        {
            "location": "169/TALK",
            "narrator": "つばめ",
            "text": "東京帰るまで",
            "zh": "回东京之前",
            "narrator_zh": "燕"
        },
        {
            "location": "171/TALK",
            "narrator": "つばめ",
            "text": "会ぇなぃんだし・゜・(ノД`)・゜・",
            "zh": "见不到面呀・゜・(ノД`)・゜・",
            "narrator_zh": "燕"
        },
        {
            "location": "173/ACT",
            "narrator": "",
            "text": "これで訓練に集中できるね",
            "zh": "这样就能专心训练了吧",
            "narrator_zh": ""
        },
        {
            "location": "174/TALK",
            "narrator": "つばめ",
            "text": "(´・ω・｀)(´・ω・｀)",
            "zh": "(´・ω・｀)(´・ω・｀)",
            "narrator_zh": "燕"
        },
        {
            "location": "175/TALK",
            "narrator": "つばめ",
            "text": "みんなとほとんど会えてなぃょ",
            "zh": "跟大家几乎见不到面哦",
            "narrator_zh": "燕"
        },
        {
            "location": "176/TALK",
            "narrator": "つばめ",
            "text": "それに",
            "zh": "而且",
            "narrator_zh": "燕"
        },
        {
            "location": "177/TALK",
            "narrator": "つばめ",
            "text": "会ってお話とかした方が",
            "zh": "见见面、说说话",
            "narrator_zh": "燕"
        },
        {
            "location": "178/TALK",
            "narrator": "つばめ",
            "text": "その後ちゃんと",
            "zh": "之后才能好好",
            "narrator_zh": "燕"
        },
        {
            "location": "179/TALK",
            "narrator": "つばめ",
            "text": "集中できるょ",
            "zh": "专心啦",
            "narrator_zh": "燕"
        },
        {
            "location": "182/SEL",
            "narrator": "",
            "text": "見送りに行かないの？",
            "zh": "不去送行吗？",
            "narrator_zh": ""
        },
        {
            "location": "183/SEL",
            "narrator": "",
            "text": "別れの挨拶はいいの？",
            "zh": "不道别也可以吗？",
            "narrator_zh": ""
        },
        {
            "location": "184/ACT",
            "narrator": "",
            "text": "見送りに行かないの？",
            "zh": "不去送行吗？",
            "narrator_zh": ""
        },
        {
            "location": "185/TALK",
            "narrator": "つばめ",
            "text": "そりゃ",
            "zh": "那当然",
            "narrator_zh": "燕"
        },
        {
            "location": "186/TALK",
            "narrator": "つばめ",
            "text": "行きたぃけどヾ(｡>﹏<｡)ﾉﾞ",
            "zh": "想去呀ヾ(｡>﹏<｡)ﾉﾞ",
            "narrator_zh": "燕"
        },
        {
            "location": "189/TALK",
            "narrator": "つばめ",
            "text": "でも",
            "zh": "可是",
            "narrator_zh": "燕"
        },
        {
            "location": "190/TALK",
            "narrator": "つばめ",
            "text": "午後の訓練があるし(´･ω･｀) ",
            "zh": "下午还有训练(´･ω･｀) ",
            "narrator_zh": "燕"
        },
        {
            "location": "191/TALK",
            "narrator": "つばめ",
            "text": "見送り行ったら",
            "zh": "去送行的话",
            "narrator_zh": "燕"
        },
        {
            "location": "193/TALK",
            "narrator": "つばめ",
            "text": "訓練に遅れちゃぅから",
            "zh": "训练会迟到的呀",
            "narrator_zh": "燕"
        },
        {
            "location": "196/TALK",
            "narrator": "つばめ",
            "text": "行きたぃけど",
            "zh": "虽然想去",
            "narrator_zh": "燕"
        },
        {
            "location": "197/TALK",
            "narrator": "つばめ",
            "text": "行けなぃよ(o´Д`)=з",
            "zh": "去不了呀(o´Д`)=з",
            "narrator_zh": "燕"
        },
        {
            "location": "199/ACT",
            "narrator": "",
            "text": "別れの挨拶はいいの？",
            "zh": "不道别也可以吗？",
            "narrator_zh": ""
        },
        {
            "location": "201/TALK",
            "narrator": "つばめ",
            "text": "東京でまた会えるから",
            "zh": "在东京还能再见面",
            "narrator_zh": "燕"
        },
        {
            "location": "202/TALK",
            "narrator": "つばめ",
            "text": "それに",
            "zh": "而且",
            "narrator_zh": "燕"
        },
        {
            "location": "203/TALK",
            "narrator": "つばめ",
            "text": "午後の訓練もあるし_(┐「ε:)_",
            "zh": "下午还有训练_(┐「ε:)_",
            "narrator_zh": "燕"
        },
        {
            "location": "204/TALK",
            "narrator": "つばめ",
            "text": "挨拶なんてしたら",
            "zh": "要是道别的话",
            "narrator_zh": "燕"
        },
        {
            "location": "206/TALK",
            "narrator": "つばめ",
            "text": "さみしくなっちゃう|д･)",
            "zh": "会变寂寞的|д･)",
            "narrator_zh": "燕"
        },
        {
            "location": "209/SEL",
            "narrator": "",
            "text": "後悔しない？",
            "zh": "不会后悔吗？",
            "narrator_zh": ""
        },
        {
            "location": "210/ACT",
            "narrator": "",
            "text": "後悔しない？",
            "zh": "不会后悔吗？",
            "narrator_zh": ""
        },
        {
            "location": "213/TALK",
            "narrator": "つばめ",
            "text": "どぅかな",
            "zh": "谁知道呀",
            "narrator_zh": "燕"
        },
        {
            "location": "215/TALK",
            "narrator": "つばめ",
            "text": "わからなぃよ",
            "zh": "不知道呀",
            "narrator_zh": "燕"
        },
        {
            "location": "280/TALK",
            "narrator": "つばめ",
            "text": "　",
            "zh": "　",
            "narrator_zh": "燕"
        },
        {
            "location": "293/TALK",
            "narrator": "つばめ",
            "text": "こんにちは、\n$handle$さん。",
            "zh": "你好，\n$handle$。",
            "narrator_zh": "燕"
        },
        {
            "location": "294/TALK",
            "narrator": "つばめ",
            "text": "突然ですが、\n前回までのあらすじです。",
            "zh": "突然，\n此前剧情提要。",
            "narrator_zh": "燕"
        },
        {
            "location": "295/TALK",
            "narrator": "つばめ",
            "text": "自分で自分に嫉妬した\nココロつばめは、水着姿で\n大胆勝負をかけた。",
            "zh": "嫉妒自己的\n心之燕，穿着泳衣\n大胆赌了一把。",
            "narrator_zh": "燕"
        },
        {
            "location": "296/TALK",
            "narrator": "つばめ",
            "text": "以上。",
            "zh": "以上。",
            "narrator_zh": "燕"
        },
        {
            "location": "297/SEL",
            "narrator": "",
            "text": "…で？",
            "zh": "……然后？",
            "narrator_zh": ""
        },
        {
            "location": "298/SEL",
            "narrator": "",
            "text": "どうしたの！？急に",
            "zh": "怎么了！？突然",
            "narrator_zh": ""
        },
        {
            "location": "299/ACT",
            "narrator": "",
            "text": "…で？",
            "zh": "……然后？",
            "narrator_zh": ""
        },
        {
            "location": "300/TALK",
            "narrator": "つばめ",
            "text": "わかりませんか？",
            "zh": "听不懂吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "301/ACT",
            "narrator": "",
            "text": "どうしたの！？急に",
            "zh": "怎么了！？突然",
            "narrator_zh": ""
        },
        {
            "location": "302/TALK",
            "narrator": "つばめ",
            "text": "大事なお話があります。",
            "zh": "有要紧的话。",
            "narrator_zh": "燕"
        },
        {
            "location": "304/TALK",
            "narrator": "つばめ",
            "text": "元司書の某さんは\n危険な存在です。",
            "zh": "原司书某某\n是危险人物。",
            "narrator_zh": "燕"
        },
        {
            "location": "305/TALK",
            "narrator": "つばめ",
            "text": "かかわるくらいなら\nわたしにかかわって\nください。",
            "zh": "要打交道的话，\n请跟我\n打交道。",
            "narrator_zh": "燕"
        },
        {
            "location": "306/SEL",
            "narrator": "",
            "text": "それと前回のあらすじとの関係は？",
            "zh": "这和上次的剧情提要有什么关系？",
            "narrator_zh": ""
        },
        {
            "location": "307/ACT",
            "narrator": "",
            "text": "それと前回のあらすじとの関係は？",
            "zh": "这和上次的剧情提要有什么关系？",
            "narrator_zh": ""
        },
        {
            "location": "309/TALK",
            "narrator": "つばめ",
            "text": "……わかりませんか？",
            "zh": "……听不懂吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "311/TALK",
            "narrator": "つばめ",
            "text": "『わたしだけを見て！』\nということです。",
            "zh": "就是，\n『只看着我！』。",
            "narrator_zh": "燕"
        },
        {
            "location": "313/TALK",
            "narrator": "つばめ",
            "text": "なんて。花言葉みたいで\nちょっとオシャレかなと\n思いました。",
            "zh": "算了。像句花语，\n我觉得还挺\n时髦。",
            "narrator_zh": "燕"
        },
        {
            "location": "314/SEL",
            "narrator": "",
