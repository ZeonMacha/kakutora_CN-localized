        {
            "location": "181/TALK",
            "narrator": "アーヤ",
            "text": "袴は履き慣れてるからいいんだけど",
            "zh": "袴我倒是穿惯了，没关系",
            "narrator_zh": "绫水"
        },
        {
            "location": "182/TALK",
            "narrator": "アーヤ",
            "text": "帯結びがちょっと自信ないのよね",
            "zh": "系带我有点没信心",
            "narrator_zh": "绫水"
        },
        {
            "location": "183/TALK",
            "narrator": "アーヤ",
            "text": "練習しなきゃだわ",
            "zh": "得练习才行",
            "narrator_zh": "绫水"
        },
        {
            "location": "185/SEL",
            "narrator": "",
            "text": "巫女装束萌えー",
            "zh": "巫女服萌到了——",
            "narrator_zh": ""
        },
        {
            "location": "186/SEL",
            "narrator": "",
            "text": "剣道またするの",
            "zh": "又要练剑道吗",
            "narrator_zh": ""
        },
        {
            "location": "187/SEL",
            "narrator": "",
            "text": "わかった、浴衣だ",
            "zh": "知道了，是浴衣",
            "narrator_zh": ""
        },
        {
            "location": "188/ACT",
            "narrator": "",
            "text": "巫女装束萌えー",
            "zh": "巫女服萌到了——",
            "narrator_zh": ""
        },
        {
            "location": "189/TALK",
            "narrator": "アーヤ",
            "text": "いやいや(-ω-;)",
            "zh": "不不(-ω-;)",
            "narrator_zh": "绫水"
        },
        {
            "location": "190/TALK",
            "narrator": "アーヤ",
            "text": "違うから",
            "zh": "不是的",
            "narrator_zh": "绫水"
        },
        {
            "location": "191/ACT",
            "narrator": "",
            "text": "剣道またするの",
            "zh": "又要练剑道吗",
            "narrator_zh": ""
        },
        {
            "location": "192/TALK",
            "narrator": "アーヤ",
            "text": "あ",
            "zh": "啊",
            "narrator_zh": "绫水"
        },
        {
            "location": "193/TALK",
            "narrator": "アーヤ",
            "text": "そうじゃなくて",
            "zh": "不是那个",
            "narrator_zh": "绫水"
        },
        {
            "location": "194/ACT",
            "narrator": "",
            "text": "わかった、浴衣だ",
            "zh": "知道了，是浴衣",
            "narrator_zh": ""
        },
        {
            "location": "196/TALK",
            "narrator": "アーヤ",
            "text": "あら",
            "zh": "哎呀",
            "narrator_zh": "绫水"
        },
        {
            "location": "197/TALK",
            "narrator": "アーヤ",
            "text": "随分感がいいのね",
            "zh": "感觉挺好的呢[?]",
            "narrator_zh": "绫水"
        },
        {
            "location": "198/TALK",
            "narrator": "アーヤ",
            "text": "勘がいいのね",
            "zh": "直觉挺好的呢",
            "narrator_zh": "绫水"
        },
        {
            "location": "199/TALK",
            "narrator": "アーヤ",
            "text": "ご名答",
            "zh": "答对了",
            "narrator_zh": "绫水"
        },
        {
            "location": "201/TALK",
            "narrator": "アーヤ",
            "text": "つばめとギャヴィの分の",
            "zh": "燕和加维的份",
            "narrator_zh": "绫水"
        },
        {
            "location": "202/TALK",
            "narrator": "アーヤ",
            "text": "浴衣を着付けてあげることになったのよ",
            "zh": "决定由我帮她们穿浴衣",
            "narrator_zh": "绫水"
        },
        {
            "location": "203/TALK",
            "narrator": "アーヤ",
            "text": "帯は",
            "zh": "带子",
            "narrator_zh": "绫水"
        },
        {
            "location": "204/TALK",
            "narrator": "アーヤ",
            "text": "みやびに任せればいいか",
            "zh": "交给雅就好了吧",
            "narrator_zh": "绫水"
        },
        {
            "location": "206/SEL",
            "narrator": "",
            "text": "がんばって覚えようよ",
            "zh": "努力记住吧",
            "narrator_zh": ""
        },
        {
            "location": "207/SEL",
            "narrator": "",
            "text": "それでいいんじゃない",
            "zh": "那样不就好了",
            "narrator_zh": ""
        },
        {
            "location": "208/SEL",
            "narrator": "",
            "text": "$me$も着付けて欲しいな",
            "zh": "也想让你帮$me$穿",
            "narrator_zh": ""
        },
        {
            "location": "209/ACT",
            "narrator": "",
            "text": "がんばって覚えようよ",
            "zh": "努力记住吧",
            "narrator_zh": ""
        },
        {
            "location": "210/TALK",
            "narrator": "アーヤ",
            "text": "できればできた方がいいわよね",
            "zh": "能会还是会比较好吧",
            "narrator_zh": "绫水"
        },
        {
            "location": "211/TALK",
            "narrator": "アーヤ",
            "text": "がんばろうかしら",
            "zh": "我是不是该加油",
            "narrator_zh": "绫水"
        },
        {
            "location": "212/ACT",
            "narrator": "",
            "text": "それでいいんじゃない",
            "zh": "那样不就好了",
            "narrator_zh": ""
        },
        {
            "location": "213/TALK",
            "narrator": "アーヤ",
            "text": "今回はそれでいいわよね",
            "zh": "这次那样就好",
            "narrator_zh": "绫水"
        },
        {
            "location": "214/TALK",
            "narrator": "アーヤ",
            "text": "それが確実だし",
            "zh": "那样也稳妥",
            "narrator_zh": "绫水"
        },
        {
            "location": "215/ACT",
            "narrator": "",
            "text": "$me$も着付けて欲しいな",
            "zh": "也想让你帮$me$穿",
            "narrator_zh": ""
        },
        {
            "location": "217/TALK",
            "narrator": "アーヤ",
            "text": "自分で切る気は元々ないのね",
            "zh": "你根本没打算自己切吧[?]",
            "narrator_zh": "绫水"
        },
        {
            "location": "218/TALK",
            "narrator": "アーヤ",
            "text": "着る気は",
            "zh": "是穿",
            "narrator_zh": "绫水"
        },
        {
            "location": "220/TALK",
            "narrator": "アーヤ",
            "text": "小学生でもちゃんと一人で着れるわよ",
            "zh": "小学生都能一个人好好穿上哦",
            "narrator_zh": "绫水"
        },
        {
            "location": "221/TALK",
            "narrator": "アーヤ",
            "text": "まあ",
            "zh": "嘛",
            "narrator_zh": "绫水"
        },
        {
            "location": "222/TALK",
            "narrator": "アーヤ",
            "text": "一回ぐらいなら着付けてあげるわ",
            "zh": "一次的话我可以帮你穿",
            "narrator_zh": "绫水"
        }
    ]
