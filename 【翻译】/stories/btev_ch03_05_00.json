{
    "dir": "chap05/battle/btev_ch03_05_00.js",
    "type": "",
    "info": {
        "story_id": "23004",
        "cid": "",
        "title": "004 ココロスフィアストーリー【Lv02】",
        "sub_title": "壊されるココロⅠ＜提起＞",
        "title_zh": "004 心灵领域故事【Lv02】",
        "sub_title_zh": "被弄坏的心Ⅰ＜提起＞"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "壊されるココロ１",
            "zh": "被弄坏的心1",
            "narrator_zh": ""
        },
        {
            "location": "13/DIALOG",
            "narrator": "",
            "text": "<size=40>KOKORO-Lv. 02</size>\nGABRIELLA\n\n<size=45>壊されるココロⅠ</size>\n<size=35>～妄想の逆襲～</size>",
            "zh": "<size=40>KOKORO-Lv. 02</size>\n加布里埃拉\n\n<size=45>被弄坏的心Ⅰ</size>\n<size=35>～妄想的逆袭～</size>",
            "narrator_zh": ""
        },
        {
            "location": "33/TALK",
            "narrator": "ガブリエラ",
            "text": "つ、つばめ…",
            "zh": "燕、燕……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "34/TALK",
            "narrator": "ガブリエラ",
            "text": "……ちゃん？",
            "zh": "……小燕？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "35/TALK",
            "narrator": "つばめ",
            "text": "え？\nどうしたの？\nガブちゃん。",
            "zh": "诶？\n怎么了？\n加布。",
            "narrator_zh": "燕"
        },
        {
            "location": "36/TALK",
            "narrator": "ガブリエラ",
            "text": "あ、いや！\nその！",
            "zh": "啊，不是！\n那个！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "37/TALK",
            "narrator": "ガブリエラ",
            "text": "あたし、つばめちゃん\nとお友達になりたい\nなぁ……なんて！",
            "zh": "我想着，要是能和\n小燕成为朋友\n就好了……什么的！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "39/TALK",
            "narrator": "つばめ",
            "text": "あはは！　なんだ\nそんなことかぁ。",
            "zh": "啊哈哈！　什么嘛，\n就这事呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "42/TALK",
            "narrator": "つばめ",
            "text": "ダメに\n決まってるじゃん。\nバカじゃないの！？",
            "zh": "那肯定\n不行嘛。\n你是不是傻！？",
            "narrator_zh": "燕"
        },
        {
            "location": "43/TALK",
            "narrator": "ガブリエラ",
            "text": "うわああっ！\nご、ごめんなさい！\nごめんなさいっ！",
            "zh": "哇啊啊！\n对、对不起！\n对不起！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "45/TALK",
            "narrator": "つばめ",
            "text": "お前さあ、\nいつもわたしに何を\nしてるか自覚あんの？",
            "zh": "我说你啊，\n平时老是对我干什么，\n自己心里有数吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "46/TALK",
            "narrator": "ガブリエラ",
            "text": "は、はいっ…",
            "zh": "是、是的……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "47/TALK",
            "narrator": "つばめ",
            "text": "迷惑とかウザイとか\n足手まといとか\nリスクだとか！",
            "zh": "什么添麻烦啦烦人啦\n拖后腿啦\n高风险啦！",
            "narrator_zh": "燕"
        },
        {
            "location": "48/TALK",
            "narrator": "つばめ",
            "text": "年下のくせに先輩とか\n呼ばせるし新人とか\nフザケた呼び方するし！",
            "zh": "明明比我小还让人\n叫你前辈，还用“新人”\n这种敷衍人的叫法！",
            "narrator_zh": "燕"
        },
        {
            "location": "50/TALK",
            "narrator": "ガブリエラ",
            "text": "……ご、\nごめんなさい…",
            "zh": "……对、\n对不起……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "53/TALK",
            "narrator": "つばめ",
            "text": "まあでも、\nそれももう過去のこと\nだし、水に流すよ。",
            "zh": "算了，不过\n那些都已经是过去的事，\n我就一笔勾销吧。",
            "narrator_zh": "燕"
        },
        {
            "location": "54/TALK",
            "narrator": "ガブリエラ",
            "text": "え！？\nほんとに？",
            "zh": "诶！？\n真的吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "55/TALK",
            "narrator": "つばめ",
            "text": "もちろんだよ。\nそのかわり――",
            "zh": "当然啦。\n不过作为交换——",
            "narrator_zh": "燕"
        },
        {
            "location": "58/TALK",
            "narrator": "つばめ",
            "text": "お前のクランを\n粉々にぶっ壊して\nからな！",
            "zh": "等我把你的库兰\n砸个粉碎\n再说！",
            "narrator_zh": "燕"
        },
        {
            "location": "60/TALK",
            "narrator": "ガブリエラ",
            "text": "いやああああああああ\nああああああああああ\nああああああああ！！",
            "zh": "不要啊啊啊啊啊啊啊啊\n啊啊啊啊啊啊啊啊啊啊\n啊啊啊啊啊啊啊！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "61/SEL",
            "narrator": "（選択肢）",
            "text": "ちょ、ちょっと待て！",
            "zh": "等、等一下！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "62/ACT",
            "narrator": "",
            "text": "ちょ、ちょっと待て！",
            "zh": "等、等一下！",
            "narrator_zh": ""
        },
        {
            "location": "65/TALK",
            "narrator": "ガブリエラ",
            "text": "ひぇ……っ？",
            "zh": "噫……？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "67/TALK",
            "narrator": "つばめ",
            "text": "ちょっと、\nアンタ誰よ。",
            "zh": "喂，\n你谁啊。",
            "narrator_zh": "燕"
        },
        {
            "location": "80/TALK",
            "narrator": "ガブリエラ",
            "text": "え、ええええっ！\nあたしだったの？",
            "zh": "诶、诶诶诶！\n原来是我自己吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "82/TALK",
            "narrator": "表層ガブリエラ",
            "text": "そうよ。　　　　",
            "zh": "是啊。",
            "narrator_zh": "表层加布里埃拉"
        },
        {
            "location": "83/TALK",
            "narrator": "表層ガブリエラ",
            "text": "あんたがあまりに\nオメデタイこと考えて\nるからお灸を据えたの。",
            "zh": "看你脑子里净想着\n这么天真的事，\n才给你长长记性。",
            "narrator_zh": "表层加布里埃拉"
        },
        {
            "location": "84/TALK",
            "narrator": "ガブリエラ",
            "text": "お、オメデタイって！",
            "zh": "什、什么叫天真啊！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "85/TALK",
            "narrator": "表層ガブリエラ",
            "text": "いいこと！？\n軟弱なあたし。",
            "zh": "听好了！？\n软弱的我。",
            "narrator_zh": "表层加布里埃拉"
        },
        {
            "location": "86/TALK",
            "narrator": "表層ガブリエラ",
            "text": "逢瀬つばめは\n危険な存在よ。",
            "zh": "逢濑燕是\n危险的存在。",
            "narrator_zh": "表层加布里埃拉"
        },
        {
            "location": "87/TALK",
            "narrator": "表層ガブリエラ",
            "text": "友達になろうとか、\n仲良くなろうとか、\nそんな事思わないで！",
            "zh": "想跟她做朋友啦，\n想和她搞好关系啦，\n别去想那种事！",
            "narrator_zh": "表层加布里埃拉"
        },
        {
            "location": "88/TALK",
            "narrator": "ガブリエラ",
            "text": "な、軟弱ですって！？",
            "zh": "你、你说我软弱！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "89/TALK",
            "narrator": "ガブリエラ",
            "text": "これから同じ仲間に\nなる子なのよ！？",
            "zh": "她可是今后要成为\n同一个队伍同伴的孩子哦！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "90/TALK",
            "narrator": "ガブリエラ",
            "text": "つばめにビビってる\nあんたの方が、よほど\n軟弱よ。",
            "zh": "被燕吓成那样的你，\n才更显得\n软弱吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "91/TALK",
            "narrator": "表層ガブリエラ",
            "text": "あら、言ったわね。\nこうなったらもう、\n勝負するしかないわね。",
            "zh": "哎呀，你可真敢说。\n事到如今，\n只有一决胜负了。",
            "narrator_zh": "表层加布里埃拉"
        },
        {
            "location": "92/TALK",
            "narrator": "ガブリエラ",
            "text": "望むところよ。",
            "zh": "正合我意。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "93/TALK",
            "narrator": "ガブリエラ",
            "text": "つばめはあんたが\n思ってるような\n怖い子じゃないわ。",
            "zh": "燕才不是你想的\n那种可怕的\n孩子。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "94/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしが勝って、\nそれを証明してあげる。",
            "zh": "我会赢下这场，\n证明给你看。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "95/SEL",
            "narrator": "（選択肢）",
            "text": "あ、あのー",
            "zh": "那、那个——",
            "narrator_zh": "（选项）"
        },
        {
            "location": "96/ACT",
            "narrator": "",
            "text": "あ、あのー",
            "zh": "那、那个——",
            "narrator_zh": ""
        },
        {
            "location": "103/TALK",
            "narrator": "ガブリエラ",
            "text": "で？\nあんたはどっちに\n力を貸してくれるの？",
            "zh": "那么？\n你要把力量\n借给哪一边？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "104/SEL",
            "narrator": "（選択肢）",
            "text": "仲良くなりたいガブリエラ",
            "zh": "想和她搞好关系的加布里埃拉",
            "narrator_zh": "（选项）"
        },
        {
            "location": "105/SEL",
            "narrator": "（選択肢）",
            "text": "警戒するガブリエラ",
            "zh": "心怀警戒的加布里埃拉",
            "narrator_zh": "（选项）"
        },
        {
            "location": "106/ACT",
            "narrator": "",
            "text": "仲良くなりたいガブリエラ",
            "zh": "想和她搞好关系的加布里埃拉",
            "narrator_zh": ""
        },
        {
            "location": "110/TALK",
            "narrator": "表層ガブリエラ",
            "text": "ふん。\n所詮外野は\n無責任なものね。",
            "zh": "哼。\n外人终究是\n站着说话不腰疼啊。",
            "narrator_zh": "表层加布里埃拉"
        },
        {
            "location": "111/TALK",
            "narrator": "表層ガブリエラ",
            "text": "やっぱり\n自分を守れるのは\nあたしだけ。",
            "zh": "果然，\n能保护自己的\n只有我自己。",
            "narrator_zh": "表层加布里埃拉"
        },
        {
            "location": "112/TALK",
            "narrator": "表層ガブリエラ",
            "text": "最強のクランで\nあんたたちを\nぶっ壊してあげる。",
            "zh": "我会用最强的库兰\n把你们\n砸个稀巴烂。",
            "narrator_zh": "表层加布里埃拉"
        },
        {
            "location": "114/TALK",
            "narrator": "ガブリエラ",
            "text": "それは\nこっちのセリフよ！",
            "zh": "这话\n该我说才对！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "121/ACT",
            "narrator": "",
            "text": "警戒するガブリエラ",
            "zh": "心怀警戒的加布里埃拉",
            "narrator_zh": ""
        },
        {
            "location": "122/TALK",
            "narrator": "ガブリエラ",
            "text": "えええっ！！\nなんでよ！",
            "zh": "诶诶诶！！\n为什么啊！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "127/TALK",
            "narrator": "表層ガブリエラ",
            "text": "当然の選択ね。",
            "zh": "理所当然的选择。",
            "narrator_zh": "表层加布里埃拉"
        },
        {
            "location": "128/TALK",
            "narrator": "表層ガブリエラ",
            "text": "今までのつばめを\n見ていれば誰でも\nわかることよ。",
            "zh": "只要看过一直以来的\n燕，任谁都\n能看明白。",
            "narrator_zh": "表层加布里埃拉"
        },
        {
            "location": "129/TALK",
            "narrator": "表層ガブリエラ",
            "text": "どう考えても普通じゃ\nないわ、あの子。\nそうでしょ？",
            "zh": "怎么想都不正常吧，\n那孩子。\n对不对？",
            "narrator_zh": "表层加布里埃拉"
        },
        {
            "location": "130/SEL",
            "narrator": "（選択肢）",
            "text": "うむ",
            "zh": "嗯",
            "narrator_zh": "（选项）"
        },
        {
            "location": "131/ACT",
            "narrator": "",
            "text": "うむ",
            "zh": "嗯",
            "narrator_zh": ""
        },
        {
            "location": "136/TALK",
            "narrator": "ガブリエラ",
            "text": "そんなことないわよ！",
            "zh": "才没有那种事！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "137/TALK",
            "narrator": "ガブリエラ",
            "text": "確かに変な力を\n持ってはいるけど――",
            "zh": "虽然她确实拥有\n奇怪的力量——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "138/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしを壊そうと\nしたりなんて絶対\nしないわよ。",
            "zh": "但她绝对不会\n想要破坏\n我的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "144/TALK",
            "narrator": "表層ガブリエラ",
            "text": "本当に\nしょうがないあたし。",
            "zh": "真是个\n没救的我。",
            "narrator_zh": "表层加布里埃拉"
        },
        {
            "location": "145/TALK",
            "narrator": "表層ガブリエラ",
            "text": "あんたはあたしの\nココロには不要な\n存在よ。",
            "zh": "你在我的心里\n是多余的\n存在。",
            "narrator_zh": "表层加布里埃拉"
        },
        {
            "location": "146/TALK",
            "narrator": "表層ガブリエラ",
            "text": "今すぐ\n消してあげるわ。",
            "zh": "现在我就\n把你抹消掉。",
            "narrator_zh": "表层加布里埃拉"
        },
        {
            "location": "147/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしのクランに\n勝てたらね！",
            "zh": "要是你能赢过\n我的库兰的话！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "166/DIALOG",
            "narrator": "",
            "text": "<color=black><size=50><b>つばめに対する気持ちを整理させ\n彼女のココロを安定させよ！</b></size></color>\n\n\n\nガブリエラは、逢瀬つばめを\n非常に危険な存在として捉えている。\nそれはドーム戦の最中に\n人が変わったようになったことが\n原因ではあるが、同時に普通の友達として\n仲良くなりたいという気持ちも存在する。\n\n今回はどちらの味方についても構わない。\n彼女の気持ちを整理して、ココロを成長させよう！\n\n",
            "zh": "<color=black><size=50><b>帮她理清对燕的心情，\n安定她的内心！</b></size></color>\n\n\n\n加布里埃拉将逢濑燕视作\n非常危险的存在。\n虽然原因在于穹顶战中\n对方宛如变了一个人般的异状，\n但与此同时，她心里也存在着\n想作为普通朋友与之交好的愿望。\n\n这次站到哪一边都没有关系。\n替她理清心情，让她的心获得成长吧！\n\n",
            "narrator_zh": ""
        }
    ]
}
