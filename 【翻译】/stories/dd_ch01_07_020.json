{
    "dir": "chap07/daydra/dd_ch01_07_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "7156",
        "cid": "tsubame",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "将来の夢は？",
        "title_zh": "Extra006 额外剧情",
        "sub_title_zh": "将来的梦想是？"
    },
    "entry": [
        {
            "location": "227/SCENARIO",
            "narrator": "",
            "text": "将来の夢は？",
            "zh": "将来的梦想是？",
            "narrator_zh": ""
        },
        {
            "location": "245/TALK",
            "narrator": "アーヤ",
            "text": "そういえば、つばめは\n将来の夢ってあるの？",
            "zh": "说起来，燕\n有将来的梦想吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "247/TALK",
            "narrator": "つばめ",
            "text": "えっ？　急にどうしたん\nですか？",
            "zh": "诶？　怎么突然\n问这个？",
            "narrator_zh": "燕"
        },
        {
            "location": "248/TALK",
            "narrator": "アーヤ",
            "text": "ちょっと気になってね。",
            "zh": "有点在意。",
            "narrator_zh": "绫水"
        },
        {
            "location": "249/TALK",
            "narrator": "アーヤ",
            "text": "私もつばめも、いずれは\n学生を終えて社会人に\nなるでしょ？",
            "zh": "我和燕，迟早\n都会离开学生，成为\n社会人吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "250/TALK",
            "narrator": "アーヤ",
            "text": "その時、つばめはどんな\n風になりたいのかな、って\n思ったの。",
            "zh": "那时候，燕想\n变成什么样，\n我在想。",
            "narrator_zh": "绫水"
        },
        {
            "location": "252/TALK",
            "narrator": "つばめ",
            "text": "う～ん…将来ですかぁ…。",
            "zh": "唔……将来吗……。",
            "narrator_zh": "燕"
        },
        {
            "location": "253/TALK",
            "narrator": "アーヤ",
            "text": "あ、無理に言わなくて\nいいから。",
            "zh": "啊，不想说就\n不用说。",
            "narrator_zh": "绫水"
        },
        {
            "location": "254/TALK",
            "narrator": "アーヤ",
            "text": "秘密にしてるなら、\n無理に言わないで。",
            "zh": "要是保密，\n就别勉强说。",
            "narrator_zh": "绫水"
        },
        {
            "location": "255/TALK",
            "narrator": "つばめ",
            "text": "そうじゃないんです。\nただ、その…。",
            "zh": "不是那样。\n只是，那个……。",
            "narrator_zh": "燕"
        },
        {
            "location": "256/SEL",
            "narrator": "",
            "text": "なりたいものはないの？",
            "zh": "没有想成为的东西吗？",
            "narrator_zh": ""
        },
        {
            "location": "257/SEL",
            "narrator": "",
            "text": "一生トライナリー宣言！",
            "zh": "宣布一辈子三重奏！",
            "narrator_zh": ""
        },
        {
            "location": "258/SEL",
            "narrator": "",
            "text": "お嫁さんとかは？",
            "zh": "新娘之类的呢？",
            "narrator_zh": ""
        },
        {
            "location": "261/TALK",
            "narrator": "つばめ",
            "text": "どうしよう…\nわたし、そういうの\n考えたことないのに…。",
            "zh": "怎么办……\n我，那种事\n没想过……。",
            "narrator_zh": "燕"
        },
        {
            "location": "262/TALK",
            "narrator": "つばめ",
            "text": "でも、高校生にもなって\n将来の夢がないなんて、\nちょっと変かな？",
            "zh": "可是，都高中生了\n还没有将来的梦想，\n是不是有点奇怪？",
            "narrator_zh": "燕"
        },
        {
            "location": "263/TALK",
            "narrator": "つばめ",
            "text": "でも、他に言うこと\n思いつかないし…。",
            "zh": "可是，别的也\n想不出来……。",
            "narrator_zh": "燕"
        },
        {
            "location": "267/TALK",
            "narrator": "つばめ",
            "text": "実は、まだよくわからない\nんです。",
            "zh": "其实，还不太\n明白。",
            "narrator_zh": "燕"
        },
        {
            "location": "268/TALK",
            "narrator": "アーヤ",
            "text": "そうなの？",
            "zh": "是吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "269/TALK",
            "narrator": "つばめ",
            "text": "はい…",
            "zh": "是的……",
            "narrator_zh": "燕"
        },
        {
            "location": "271/TALK",
            "narrator": "つばめ",
            "text": "自分が何をしたいのか、\n何が得意なのか――",
            "zh": "自己想做什么，\n擅长什么——",
            "narrator_zh": "燕"
        },
        {
            "location": "272/TALK",
            "narrator": "つばめ",
            "text": "まだ、自分でもよく\nわかってなくて…。",
            "zh": "连我自己都还\n不太清楚……。",
            "narrator_zh": "燕"
        },
        {
            "location": "274/TALK",
            "narrator": "つばめ",
            "text": "…変ですか？",
            "zh": "……奇怪吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "275/TALK",
            "narrator": "アーヤ",
            "text": "どうかしら？\n私の周りにはいなかった\nタイプだけど――",
            "zh": "怎么样呢？\n我身边没有过\n这种类型——",
            "narrator_zh": "绫水"
        },
        {
            "location": "276/TALK",
            "narrator": "アーヤ",
            "text": "変とまでは思わないわ。",
            "zh": "也不至于觉得奇怪。",
            "narrator_zh": "绫水"
        },
        {
            "location": "277/TALK",
            "narrator": "つばめ",
            "text": "本当ですか？",
            "zh": "真的吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "278/TALK",
            "narrator": "アーヤ",
            "text": "ええ。",
            "zh": "嗯。",
            "narrator_zh": "绫水"
        },
        {
            "location": "280/TALK",
            "narrator": "アーヤ",
            "text": "将来の夢、\n早く見つかると\n良いわね。",
            "zh": "将来的梦想，\n早点找到\n就好了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "282/ACT",
            "narrator": "",
            "text": "なりたいものはないの？",
            "zh": "没有想成为的东西吗？",
            "narrator_zh": ""
        },
        {
            "location": "294/TALK",
            "narrator": "つばめ",
            "text": "ないの",
            "zh": "没有",
            "narrator_zh": "燕"
        },
        {
            "location": "295/TALK",
            "narrator": "つばめ",
            "text": "信じられないと思うけど、本当に…",
            "zh": "你可能不信，可是真的……",
            "narrator_zh": "燕"
        },
        {
            "location": "302/TALK",
            "narrator": "つばめ",
            "text": "実は、まだよくわからない\nんです。",
            "zh": "其实，还不太\n明白。",
            "narrator_zh": "燕"
        },
        {
            "location": "304/TALK",
            "narrator": "アーヤ",
            "text": "そうなの？",
            "zh": "是吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "306/TALK",
            "narrator": "つばめ",
            "text": "はい…",
            "zh": "是的……",
            "narrator_zh": "燕"
        },
        {
            "location": "307/TALK",
            "narrator": "つばめ",
            "text": "自分が何をしたいのか、\n何が得意なのか――",
            "zh": "自己想做什么，\n擅长什么——",
            "narrator_zh": "燕"
        },
        {
            "location": "308/TALK",
            "narrator": "つばめ",
            "text": "まだ、自分でもよく\nわかってなくて…。",
            "zh": "连我自己都还\n不太清楚……。",
            "narrator_zh": "燕"
        },
        {
            "location": "310/TALK",
            "narrator": "つばめ",
            "text": "…変ですか？",
            "zh": "……奇怪吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "311/TALK",
            "narrator": "アーヤ",
            "text": "どうかしら？\n私の周りにはいなかった\nタイプだけど――",
            "zh": "怎么样呢？\n我身边没有过\n这种类型——",
            "narrator_zh": "绫水"
        },
        {
            "location": "312/TALK",
            "narrator": "アーヤ",
            "text": "変とまでは思わないわ。",
            "zh": "也不至于觉得奇怪。",
            "narrator_zh": "绫水"
        },
        {
            "location": "313/TALK",
            "narrator": "つばめ",
            "text": "本当ですか？",
            "zh": "真的吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "314/TALK",
            "narrator": "アーヤ",
            "text": "ええ。",
            "zh": "嗯。",
            "narrator_zh": "绫水"
        },
        {
            "location": "316/TALK",
            "narrator": "アーヤ",
            "text": "将来の夢、\n早く見つかると\n良いわね。",
            "zh": "将来的梦想，\n早点找到\n就好了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "317/ACT",
            "narrator": "",
            "text": "一生トライナリー宣言",
            "zh": "宣布一辈子三重奏",
            "narrator_zh": ""
        },
        {
            "location": "329/TALK",
            "narrator": "つばめ",
            "text": "一生！？",
            "zh": "一辈子！？",
            "narrator_zh": "燕"
        },
        {
            "location": "331/TALK",
            "narrator": "つばめ",
            "text": "…一生、戦えるのかな？",
            "zh": "……一辈子，打得下去吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "337/TALK",
            "narrator": "つばめ",
            "text": "でも、今のわたしが\nできることといったら――",
            "zh": "可是，现在的我\n能做的事——",
            "narrator_zh": "燕"
        },
        {
            "location": "338/TALK",
            "narrator": "つばめ",
            "text": "トライナリーとして\n戦うことだけだし…。",
            "zh": "只有作为三重奏\n去战斗……。",
            "narrator_zh": "燕"
        },
        {
            "location": "341/TALK",
            "narrator": "つばめ",
            "text": "うん、決めた。\n今決めました。",
            "zh": "嗯，决定了。\n现在决定了。",
            "narrator_zh": "燕"
        },
        {
            "location": "342/TALK",
            "narrator": "つばめ",
            "text": "わたしの夢は生涯現役。\n一生トライナリーとして\n戦い続けます！",
            "zh": "我的梦想是终身现役。\n一辈子作为三重奏\n战斗下去！",
            "narrator_zh": "燕"
        },
        {
            "location": "344/TALK",
            "narrator": "アーヤ",
            "text": "い、一生！？\nそれ、かなり大変よ？",
            "zh": "一、一辈子！？\n那可相当辛苦哦？",
            "narrator_zh": "绫水"
        },
        {
            "location": "346/TALK",
            "narrator": "アーヤ",
            "text": "段々と身体もついて\nいかなくなると思うし。",
            "zh": "身体也会渐渐\n跟不上的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "347/TALK",
            "narrator": "つばめ",
            "text": "そうならないように、\n頑張って鍛えます！",
            "zh": "为了不变成那样，\n我会努力锻炼！",
            "narrator_zh": "燕"
        },
        {
            "location": "350/TALK",
            "narrator": "アーヤ",
            "text": "あはは…頼もしいわね。",
            "zh": "啊哈哈……真可靠。",
            "narrator_zh": "绫水"
        },
        {
            "location": "351/TALK",
            "narrator": "アーヤ",
            "text": "…けど、できれば私達が\n現役の間に――",
            "zh": "……不过，最好能在我们\n还在现役的时候——",
            "narrator_zh": "绫水"
        },
        {
            "location": "352/TALK",
            "narrator": "アーヤ",
            "text": "フェノメノン被害が\n収束して、トライナリーも\n解散――",
            "zh": "PhenoMENON的灾害\n收敛，三重奏也\n解散——",
            "narrator_zh": "绫水"
        },
        {
            "location": "353/TALK",
            "narrator": "アーヤ",
            "text": "そうなるのが一番よね。",
            "zh": "那样才是最好的吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "354/ACT",
            "narrator": "",
            "text": "お嫁さんとかは？",
            "zh": "新娘之类的呢？",
            "narrator_zh": ""
        },
        {
            "location": "368/TALK",
            "narrator": "つばめ",
            "text": "お嫁さんかぁ…",
            "zh": "新娘呀……",
            "narrator_zh": "燕"
        },
        {
            "location": "370/TALK",
            "narrator": "つばめ",
            "text": "…それ、いいかも",
            "zh": "……那个，也许不错",
            "narrator_zh": "燕"
        },
        {
            "location": "377/TALK",
            "narrator": "つばめ",
            "text": "あの…笑いませんか？",
            "zh": "那个……你不会笑吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "379/TALK",
            "narrator": "アーヤ",
            "text": "努力するわ。",
            "zh": "我会努力不笑。",
            "narrator_zh": "绫水"
        },
        {
            "location": "380/TALK",
            "narrator": "つばめ",
            "text": "えっと…お、お嫁さんに、\nなりたいなぁ、\nなんて…。",
            "zh": "那个……想、想当新娘，\n之类的，\n就是……。",
            "narrator_zh": "燕"
        },
        {
            "location": "381/TALK",
            "narrator": "アーヤ",
            "text": "……え？",
            "zh": "……诶？",
            "narrator_zh": "绫水"
        },
        {
            "location": "384/TALK",
            "narrator": "つばめ",
            "text": "ウエディングドレスに、\nちょっと憧れてるんです。",
            "zh": "婚纱，\n我有点憧憬。",
            "narrator_zh": "燕"
        },
        {
            "location": "385/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "386/TALK",
            "narrator": "つばめ",
            "text": "あ、アーヤさん？",
            "zh": "啊，绫水？",
            "narrator_zh": "燕"
        },
        {
            "location": "387/TALK",
            "narrator": "アーヤ",
            "text": "驚いた…。\nつばめって、そういうの\n興味ないと思ってたわ。",
            "zh": "吓了一跳……\n我还以为燕对那种事\n没兴趣。",
            "narrator_zh": "绫水"
        },
        {
            "location": "388/TALK",
            "narrator": "つばめ",
            "text": "ありますよ。\nだって、すっごく綺麗じゃ\nないですか！",
            "zh": "有的。\n因为，非常漂亮\n不是吗！",
            "narrator_zh": "燕"
        },
        {
            "location": "389/TALK",
            "narrator": "つばめ",
            "text": "前に、結婚式場の前で\n真っ白のドレスを着た\n人を見たことがあって――",
            "zh": "以前，在婚礼会场前\n看到过穿纯白礼服的\n人——",
            "narrator_zh": "燕"
        },
        {
            "location": "390/TALK",
            "narrator": "つばめ",
            "text": "それが本当に綺麗で、\nいつかはわたしも\n着るんだ、って――",
            "zh": "真的很漂亮，\n总有一天我也要\n穿上，就——",
            "narrator_zh": "燕"
        },
        {
            "location": "392/TALK",
            "narrator": "つばめ",
            "text": "そう思ってたんです。",
            "zh": "我是这么想的。",
            "narrator_zh": "燕"
        },
        {
            "location": "393/TALK",
            "narrator": "アーヤ",
            "text": "そうだったんだ？",
            "zh": "是这样啊？",
            "narrator_zh": "绫水"
        },
        {
            "location": "394/TALK",
            "narrator": "つばめ",
            "text": "…笑いませんか？",
            "zh": "……你不会笑吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "395/TALK",
            "narrator": "アーヤ",
            "text": "笑わないわよ。\n可愛くていい夢じゃない。",
            "zh": "不会笑的。\n又可爱，又是好梦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "396/TALK",
            "narrator": "アーヤ",
            "text": "それならまずは、\n素敵なパートナーを\n見つけないとね。",
            "zh": "那样的话，首先\n得找到一个\n好的伴侣。",
            "narrator_zh": "绫水"
        },
        {
            "location": "397/TALK",
            "narrator": "アーヤ",
            "text": "ウェディングドレスは\n相手がいないと着れないん\nだから。",
            "zh": "婚纱\n没有对方就\n穿不了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "398/TALK",
            "narrator": "つばめ",
            "text": "え？　あ、ああ…\nそういえばそうですね。",
            "zh": "诶？　啊，啊啊……\n说起来确实是。",
            "narrator_zh": "燕"
        },
        {
            "location": "400/TALK",
            "narrator": "つばめ",
            "text": "そっか…あれを着るなら\n結婚する人を見つけないと\nいけないんだよね。",
            "zh": "这样啊……要穿那个，\n就得找到要结婚的人\n才行呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "401/TALK",
            "narrator": "つばめ",
            "text": "でも、パートナーかぁ…\nそういうの、よくわから\nないんだけどなぁ…。",
            "zh": "不过，伴侣呀……\n那种事，我还不太\n明白……。",
            "narrator_zh": "燕"
        },
        {
            "location": "242/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>5月8日　11:15 AM</color>\nとある路地で、買い物の帰りに。",
            "zh": "<color=green>5月8日　11:15 AM</color>\n某个巷子里，买完东西回去的路上。",
            "narrator_zh": "Dialog_EventData"
        },
        {
            "location": "412/DIALOG",
            "narrator": "Dialog_GEThimegoto_ch01",
            "text": "【病める時も健やかな時も】",
            "zh": "【无论生病还是健康】",
            "narrator_zh": "Dialog_GEThimegoto_ch01"
        }
    ]
}
