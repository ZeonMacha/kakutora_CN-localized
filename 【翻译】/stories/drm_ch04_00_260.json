        },
        {
            "location": "393/TALK",
            "narrator": "繭",
            "text": "わかるかも",
            "zh": "我倒有点懂",
            "narrator_zh": "茧"
        },
        {
            "location": "394/TALK",
            "narrator": "みやび",
            "text": "光月さんは乙女と認定",
            "zh": "认定光月是乙女",
            "narrator_zh": "雅"
        },
        {
            "location": "417/TALK",
            "narrator": "男子高校生Ａ",
            "text": "だから、俺に聞かれても\nわからねぇって言ってる\nだろ？",
            "zh": "所以，我就说问我\n我也不知道\n吧？",
            "narrator_zh": "男高中生A"
        },
        {
            "location": "419/TALK",
            "narrator": "女子高校生Ａ",
            "text": "何で気にならないのよ！？\n二カ月も来てないなんて、\n絶対変よ！",
            "zh": "你怎么能不在意啊！？\n都两个月没消息了，\n绝对有问题！",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "428/TALK",
            "narrator": "繭",
            "text": "…あの、あまり\n聞き耳をたてるのも…。",
            "zh": "…那个，这样\n偷听也不太好……。",
            "narrator_zh": "茧"
        },
        {
            "location": "430/TALK",
            "narrator": "みやび",
            "text": "しっ！\n黙って耳を澄ましぃ。",
            "zh": "嘘！\n闭嘴竖起耳朵听。",
            "narrator_zh": "雅"
        },
        {
            "location": "439/TALK",
            "narrator": "女子高校生Ａ",
            "text": "あんたのを出したのに、\nどうしてそんなに\n無関心なのよ！？",
            "zh": "我把你的那份都寄出去了，\n你怎么这么\n无动于衷啊！？",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "441/TALK",
            "narrator": "男子高校生Ａ",
            "text": "無関心に決まってんだろ！",
            "zh": "当然无动于衷啊！",
            "narrator_zh": "男高中生A"
        },
        {
            "location": "442/TALK",
            "narrator": "男子高校生Ａ",
            "text": "俺の履歴書、勝手に\nオーディションなんかに\n送りやがって！",
            "zh": "我的简历，你居然\n擅自寄去什么\n选拔会！",
            "narrator_zh": "男高中生A"
        },
        {
            "location": "450/TALK",
            "narrator": "みやび",
            "text": "…は？",
            "zh": "……啊？",
            "narrator_zh": "雅"
        },
        {
            "location": "451/TALK",
            "narrator": "繭",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "茧"
        },
        {
            "location": "460/TALK",
            "narrator": "女子高校生Ａ",
            "text": "だって、よくテレビで\n見るじゃない。",
            "zh": "因为，电视上经常\n看到嘛。",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "461/TALK",
            "narrator": "女子高校生Ａ",
            "text": "友達が勝手に履歴書\n送ったら合格しちゃった、\nみたいなの。",
            "zh": "就像朋友擅自寄出简历\n结果被录取了，\n那种故事。",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "463/TALK",
            "narrator": "男子高校生Ａ",
            "text": "いや、俺はそういうのに\n興味ねぇし。",
            "zh": "不，我对那种事\n根本没兴趣。",
            "narrator_zh": "男高中生A"
        },
        {
            "location": "465/TALK",
            "narrator": "女子高校生Ａ",
            "text": "何よ！\nあんたがかっこいいと\n思ったから出したのに…。",
            "zh": "什么嘛！\n我是觉得你帅\n才寄出去的……。",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "474/TALK",
            "narrator": "繭",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "茧"
        },
        {
            "location": "476/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "481/TALK",
            "narrator": "みやび",
            "text": "痴話ゲンカか！！",
            "zh": "原来是两口子拌嘴啊！！",
            "narrator_zh": "雅"
        },
        {
            "location": "482/TALK",
            "narrator": "繭",
            "text": "修羅場でもなんでもない！！",
            "zh": "什么修罗场都不是！！",
            "narrator_zh": "茧"
        },
        {
            "location": "484/SEL",
            "narrator": "",
            "text": "仲良しカップルで安心した",
            "zh": "看到你们感情好，我就放心了",
            "narrator_zh": ""
        },
        {
            "location": "485/ACT",
            "narrator": "",
            "text": "仲良しカップルで安心した",
            "zh": "看到你们感情好，我就放心了",
            "narrator_zh": ""
        },
        {
            "location": "487/TALK",
            "narrator": "みやび",
            "text": "うちはちっくと腹が立つわ",
            "zh": "我倒是有点火大咯",
            "narrator_zh": "雅"
        },
        {
            "location": "490/TALK",
            "narrator": "繭",
            "text": "同じく",
            "zh": "我也是",
            "narrator_zh": "茧"
        },
        {
            "location": "491/TALK",
            "narrator": "繭",
            "text": "無駄な時間を過ごしました…",
            "zh": "度过了毫无意义的时间……",
            "narrator_zh": "茧"
