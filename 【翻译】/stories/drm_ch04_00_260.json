        {
            "location": "360/TALK",
            "narrator": "繭",
            "text": "愛だけでは生きていけないので",
            "zh": "毕竟光靠爱情是活不下去的",
            "narrator_zh": "茧"
        },
        {
            "location": "361/TALK",
            "narrator": "みやび",
            "text": "なるほど",
            "zh": "原来如此",
            "narrator_zh": "雅"
        },
        {
            "location": "362/TALK",
            "narrator": "みやび",
            "text": "得るものはある会話やね",
            "zh": "是有收获的对话咯",
            "narrator_zh": "雅"
        },
        {
            "location": "363/TALK",
            "narrator": "みやび",
            "text": "属性によって態度を変えるような人間かどうかは",
            "zh": "会不会因为属性不同就变态度，",
            "narrator_zh": "雅"
        },
        {
            "location": "364/TALK",
            "narrator": "みやび",
            "text": "早いうちにわかった方がダメージも少ない",
            "zh": "早点弄清楚伤害也比较小",
            "narrator_zh": "雅"
        },
        {
            "location": "366/TALK",
            "narrator": "繭",
            "text": "属性？",
            "zh": "属性？",
            "narrator_zh": "茧"
        },
        {
            "location": "367/TALK",
            "narrator": "繭",
            "text": "職業的な？",
            "zh": "职业上的？",
            "narrator_zh": "茧"
        },
        {
            "location": "368/TALK",
            "narrator": "みやび",
            "text": "ブルーカラーは嫌",
            "zh": "讨厌蓝领，",
            "narrator_zh": "雅"
        },
        {
            "location": "369/TALK",
            "narrator": "みやび",
            "text": "ホワイトカラーがえいの",
            "zh": "要白领才好，",
            "narrator_zh": "雅"
        },
        {
            "location": "370/TALK",
            "narrator": "みやび",
            "text": "的なヤツ",
            "zh": "之类的那种",
            "narrator_zh": "雅"
        },
        {
            "location": "372/TALK",
            "narrator": "繭",
            "text": "なるほど納得",
            "zh": "原来如此，我明白了",
            "narrator_zh": "茧"
        },
        {
            "location": "373/ACT",
            "narrator": "",
            "text": "人類の存亡について",
            "zh": "关于人类的存亡",
            "narrator_zh": ""
        },
        {
            "location": "374/TALK",
            "narrator": "みやび",
            "text": "イタタタタ",
            "zh": "哎哟哟哟",
            "narrator_zh": "雅"
        },
        {
            "location": "376/TALK",
            "narrator": "みやび",
            "text": "それはまた大きな話題やね",
            "zh": "那又是很大的话题咯",
            "narrator_zh": "雅"
        },
        {
            "location": "378/TALK",
            "narrator": "繭",
            "text": "厨二病？",
            "zh": "中二病？",
            "narrator_zh": "茧"
        },
        {
            "location": "379/TALK",
            "narrator": "みやび",
            "text": "ＳＦマニア？",
            "zh": "ＳＦ迷？",
            "narrator_zh": "雅"
        },
        {
            "location": "381/TALK",
            "narrator": "繭",
            "text": "破滅論者？",
            "zh": "灭世论者？",
            "narrator_zh": "茧"
        },
        {
            "location": "382/TALK",
            "narrator": "みやび",
            "text": "まあ",
            "zh": "嗯",
            "narrator_zh": "雅"
        },
        {
            "location": "383/TALK",
            "narrator": "みやび",
            "text": "恋愛中の相手がいなくなることが",
            "zh": "恋爱对象要是没了这种事，",
            "narrator_zh": "雅"
        },
        {
            "location": "384/TALK",
            "narrator": "みやび",
            "text": "人類存亡以上の重大事項になるらしい",
            "zh": "居然比人类存亡还重大似的",
            "narrator_zh": "雅"
        },
        {
            "location": "386/TALK",
            "narrator": "繭",
            "text": "個人にとっての世界なんて",
            "zh": "对个人来说的世界，",
            "narrator_zh": "茧"
        },
        {
            "location": "387/TALK",
            "narrator": "繭",
            "text": "結局視界の届く範囲でしかないですし",
            "zh": "终究只有视野所及的范围而已，",
            "narrator_zh": "茧"
        },
        {
            "location": "388/TALK",
            "narrator": "繭",
            "text": "あながち間違ってないと思います",
