            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "202/TALK",
            "narrator": "繭",
            "text": "…どうかしましたか？",
            "zh": "……出什么事了吗？",
            "narrator_zh": "茧"
        },
        {
            "location": "204/TALK",
            "narrator": "みやび",
            "text": "いや、隣がちょっと。",
            "zh": "不是，旁边有点。",
            "narrator_zh": "雅"
        },
        {
            "location": "206/TALK",
            "narrator": "繭",
            "text": "？",
            "zh": "？",
            "narrator_zh": "茧"
        },
        {
            "location": "215/TALK",
            "narrator": "女子高校生Ａ",
            "text": "ちょっと、真面目に\n聞いてるの？",
            "zh": "那个，你是认真\n在听吗？",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "217/TALK",
            "narrator": "男子高校生Ａ",
            "text": "聞いてるって。\nあんま大きな声出すなよ。",
            "zh": "听着呢。\n你别那么大声啊。",
            "narrator_zh": "男高中生A"
        },
        {
            "location": "218/TALK",
            "narrator": "女子高校生Ａ",
            "text": "だって、不安だし…",
            "zh": "因为，很不安嘛……",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "219/TALK",
            "narrator": "女子高校生Ａ",
            "text": "二カ月も来てないのよ？\n絶対変よ。",
            "zh": "都两个月没消息了\n绝对有问题！",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "220/TALK",
            "narrator": "男子高校生Ａ",
            "text": "知らねぇよ。\n俺が出したわけじゃ\nねぇんだし。",
            "zh": "我怎么知道。\n又不是我\n寄出去的。",
            "narrator_zh": "男高中生A"
        },
        {
            "location": "221/TALK",
            "narrator": "女子高校生Ａ",
            "text": "そんな、酷い！",
            "zh": "那种，太过分了！",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "230/TALK",
            "narrator": "繭",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "茧"
        },
        {
            "location": "232/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "237/TALK",
            "narrator": "みやび",
            "text": "光月さんよ",
            "zh": "光月呀",
            "narrator_zh": "雅"
        },
        {
            "location": "238/TALK",
            "narrator": "みやび",
            "text": "うちはドラマの世界に入ったようや",
            "zh": "我好像走进电视剧的世界咯",
            "narrator_zh": "雅"
        },
        {
            "location": "240/TALK",
            "narrator": "繭",
            "text": "ここは現実です",
            "zh": "这里是现实",
            "narrator_zh": "茧"
        },
        {
            "location": "241/TALK",
            "narrator": "みやび",
            "text": "マジ？",
            "zh": "真的假的？",
            "narrator_zh": "雅"
        },
        {
            "location": "242/TALK",
            "narrator": "みやび",
            "text": "異世界召喚されてない？",
            "zh": "该不会被召唤到异世界了吧？",
            "narrator_zh": "雅"
        },
        {
            "location": "243/TALK",
            "narrator": "みやび",
            "text": "ここ日本？",
            "zh": "这里是日本咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "245/TALK",
            "narrator": "繭",
            "text": "落ち着いて",
            "zh": "冷静点",
            "narrator_zh": "茧"
        },
        {
            "location": "246/TALK",
            "narrator": "繭",
            "text": "あれは修羅場ってるだけのカップル",
            "zh": "那只是正在修罗场的情侣",
            "narrator_zh": "茧"
        },
        {
            "location": "247/TALK",
            "narrator": "みやび",
            "text": "それ聞いて安心",
            "zh": "听你这么说我就放心了",
            "narrator_zh": "雅"
        },
        {
            "location": "250/TALK",
            "narrator": "繭",
            "text": "修羅場ってるカップルの隣でそのスタンプはどうかと",
            "zh": "在修罗场情侣旁边发那个表情合适吗",
            "narrator_zh": "茧"
        },
        {
            "location": "251/TALK",
            "narrator": "みやび",
            "text": "けんど",
            "zh": "但是",
            "narrator_zh": "雅"
        },
        {
            "location": "253/TALK",
            "narrator": "みやび",
            "text": "やっぱりアレかね",
            "zh": "果然还是那个吗",
            "narrator_zh": "雅"
        },
        {
            "location": "256/TALK",
            "narrator": "繭",
            "text": "ど、どうでしょうか",
            "zh": "怎、怎么样呢",
            "narrator_zh": "茧"
        },
        {
            "location": "257/TALK",
            "narrator": "みやび",
            "text": "明言を避けるか",
            "zh": "还是不明说咯",
            "narrator_zh": "雅"
        },
        {
            "location": "258/TALK",
            "narrator": "みやび",
            "text": "なら",
            "zh": "那",
            "narrator_zh": "雅"
        },
