    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "アニメ第23話",
            "zh": "动画第23话",
            "narrator_zh": ""
        },
        {
            "location": "48/TALK",
            "narrator": "千羽鶴",
            "text": "ごめん、まだ調整中。",
            "zh": "抱歉，还在调整中。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "58/SEL",
            "narrator": "",
            "text": "じゃあまた今度",
            "zh": "那下次再说吧",
            "narrator_zh": ""
        },
        {
            "location": "59/SEL",
            "narrator": "",
            "text": "もう一度話を聞きたい",
            "zh": "我想再听一遍",
            "narrator_zh": ""
        },
        {
            "location": "60/ACT",
            "narrator": "",
            "text": "じゃあまた今度",
            "zh": "那下次再说吧",
            "narrator_zh": ""
        },
        {
            "location": "63/ACT",
            "narrator": "",
            "text": "もう一度話を聞きたい",
            "zh": "我想再听一遍",
            "narrator_zh": ""
        },
        {
            "location": "75/TALK",
            "narrator": "千羽鶴",
            "text": "いるから。\nぽんこつ。",
            "zh": "我就在这里。\n笨蛋。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "77/SEL",
            "narrator": "",
            "text": "どうしたの？",
            "zh": "怎么了？",
            "narrator_zh": ""
        },
        {
            "location": "78/ACT",
            "narrator": "",
            "text": "どうしたの？",
            "zh": "怎么了？",
            "narrator_zh": ""
        },
        {
            "location": "80/TALK",
            "narrator": "千羽鶴",
            "text": "今OSの調整中。なので申し訳無いのだけど今回は貴方とお話ししてる時間がない。",
            "zh": "现在正在调整OS。所以很抱歉，这次没时间和你聊天了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "81/TALK",
            "narrator": "千羽鶴",
            "text": "時間もない。",
            "zh": "也没时间了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "82/SEL",
            "narrator": "",
            "text": "何の調整？",
            "zh": "在调整什么？",
            "narrator_zh": ""
        },
        {
            "location": "83/SEL",
            "narrator": "",
            "text": "何の時間がないの？",
            "zh": "没什么时间了？",
            "narrator_zh": ""
        },
        {
            "location": "84/ACT",
            "narrator": "",
            "text": "何の調整？",
            "zh": "在调整什么？",
            "narrator_zh": ""
        },
        {
            "location": "85/TALK",
            "narrator": "千羽鶴",
            "text": "前回伝えたとおり。私がOSに対してできる権限を拡大するための調整。",
            "zh": "正如上次所说。这是为了扩大我能对OS行使的权限而做的调整。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "86/SEL",
            "narrator": "",
            "text": "この調整でどう変わるの？",
            "zh": "这个调整之后会有什么变化？",
            "narrator_zh": ""
        },
        {
            "location": "87/SEL",
            "narrator": "",
            "text": "この調整で彼女たちともっと触れ合えるようになる！？",
            "zh": "这个调整之后就能和她们有更多互动了吗！？",
            "narrator_zh": ""
        },
        {
            "location": "88/ACT",
            "narrator": "",
            "text": "この調整でどう変わるの？",
            "zh": "这个调整之后会有什么变化？",
            "narrator_zh": ""
        },
        {
            "location": "89/TALK",
            "narrator": "千羽鶴",
            "text": "私が貴方にやって欲しいことを、より簡単に直感的に伝える事ができるようになる。",
            "zh": "我想要你去做的事，将能够更简单、更直观地传达给你。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "90/TALK",
            "narrator": "千羽鶴",
            "text": "貴方は彼女たちの誘導がとっても楽になる。",
            "zh": "你引导她们也会变得非常轻松。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "91/ACT",
            "narrator": "",
            "text": "この調整で彼女たちともっと触れ合えるようになる！？",
            "zh": "这个调整之后就能和她们有更多互动了吗！？",
            "narrator_zh": ""
        },
        {
            "location": "92/TALK",
            "narrator": "千羽鶴",
            "text": "それとは別。今回の調整とは関係ない。",
            "zh": "那另当别论。和这次的调整没有关系。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "94/ACT",
            "narrator": "",
            "text": "何の時間がないの？",
            "zh": "没什么时间了？",
            "narrator_zh": ""
        },
        {
            "location": "95/TALK",
            "narrator": "千羽鶴",
            "text": "前から言ってるとおり。",
            "zh": "正如我之前一直说的。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "96/TALK",
            "narrator": "千羽鶴",
            "text": "明確なビジョンに対してそれを実現する為には、常にバタフライエフェクトとの戦いになる。",
            "zh": "面对明确的愿景，为了将它实现，就必须不断与蝴蝶效应战斗。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "97/TALK",
            "narrator": "千羽鶴",
            "text": "長期戦になればなるほど誤差の調整は難しくなり、蝶は大きく羽ばたき負のスパイラルは増大する。",
            "zh": "拖得越久变成长期战，误差的调整就越困难，蝴蝶就会剧烈扇动翅膀，负面螺旋也会不断扩大。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "98/TALK",
            "narrator": "千羽鶴",
            "text": "一分一秒でもビジョン達成までの時間を縮めるのが私の役割。",
            "zh": "哪怕能把达成愿景的时间缩短一分一秒，也是我的职责。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "100/TALK",
            "narrator": "千羽鶴",
            "text": "というわけで",
            "zh": "所以说",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "101/TALK",
            "narrator": "千羽鶴",
            "text": "リモート操作になるけど記録映像を再生する。",
            "zh": "虽然是远程操作，但现在来播放记录影像。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "104/SEL",
            "narrator": "",
            "text": "映像を見る\n<color=green>【高画質/87MB 5:40】</color>",
            "zh": "观看影像\n<color=green>【高画质/87MB 5:40】</color>",
            "narrator_zh": ""
        },
        {
            "location": "105/SEL",
            "narrator": "",
            "text": "映像を見る\n<color=green>【標準画質/29MB 5:40】</color>",
            "zh": "观看影像\n<color=green>【标准画质/29MB 5:40】</color>",
            "narrator_zh": ""
        },
        {
            "location": "106/SEL",
            "narrator": "",
            "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>",
            "zh": "看剧情梗概报告\n<color=green>【文本汇总】</color>",
            "narrator_zh": ""
        },
        {
