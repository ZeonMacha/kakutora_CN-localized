            "narrator": "",
            "text": "映像を見る\n<color=green>【高画質/87MB 5:40】</color>",
            "zh": "观看影像\n<color=green>【高画质/87MB 5:40】</color>",
            "narrator_zh": ""
        },
        {
            "location": "114/ACT",
            "narrator": "",
            "text": "映像を見る\n<color=green>【標準画質/29MB 5:40】</color>",
            "zh": "观看影像\n<color=green>【标准画质/29MB 5:40】</color>",
            "narrator_zh": ""
        },
        {
            "location": "121/ACT",
            "narrator": "",
            "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>",
            "zh": "看剧情梗概报告\n<color=green>【文本汇总】</color>",
            "narrator_zh": ""
        },
        {
            "location": "166/TALK",
            "narrator": "みやびの元司書",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "雅的原司书"
        },
        {
            "location": "167/TALK",
            "narrator": "みやびの元司書",
            "text": "んー…",
            "zh": "嗯—……",
            "narrator_zh": "雅的原司书"
        },
        {
            "location": "168/SEL",
            "narrator": "",
            "text": "みやび！？",
            "zh": "雅！？",
            "narrator_zh": ""
        },
        {
            "location": "169/ACT",
            "narrator": "",
            "text": "みやび！？",
            "zh": "雅！？",
            "narrator_zh": ""
        },
        {
            "location": "172/TALK",
            "narrator": "みやびの元司書",
            "text": "む。",
            "zh": "唔。",
            "narrator_zh": "雅的原司书"
        },
        {
            "location": "175/TALK",
            "narrator": "みやびの元司書",
            "text": "おお。\n誰かと思えば相棒。\n奇遇やね。",
            "zh": "哦哦。\n还当是谁呢，原来是搭档。\n真巧咯。",
            "narrator_zh": "雅的原司书"
        },
        {
            "location": "176/TALK",
            "narrator": "みやびの元司書",
            "text": "しっかし、なんぞ\nここは真っ白やね。",
            "zh": "不过话说回来，做驷马\n这里白茫茫一片咯。",
            "narrator_zh": "雅的原司书"
        },
        {
            "location": "177/TALK",
            "narrator": "みやびの元司書",
            "text": "これはあれやね、\nうちの好きに壁紙貼って\nえいよ…ってことやか。",
            "zh": "这莫非就是那个咯，\n随便我贴壁纸\n都得的意思咩。",
            "narrator_zh": "雅的原司书"
        },
        {
            "location": "178/TALK",
            "narrator": "みやびの元司書",
            "text": "ほんだら――",
            "zh": "那就——",
            "narrator_zh": "雅的原司书"
        },
        {
            "location": "179/TALK",
            "narrator": "みやびの元司書",
            "text": "こ…れ…で……と。",
            "zh": "这……样……搞……定。",
            "narrator_zh": "雅的原司书"
        },
        {
            "location": "184/TALK",
            "narrator": "みやびの元司書",
            "text": "おお、\n賑やかになったね。",
            "zh": "哦哦，\n变得热闹起来了咯。",
            "narrator_zh": "雅的原司书"
        },
        {
            "location": "185/SEL",
            "narrator": "",
            "text": "素晴らしい壁紙だ！",
            "zh": "好棒的壁纸！",
            "narrator_zh": ""
        },
        {
            "location": "186/SEL",
            "narrator": "",
            "text": "洗脳されそう",
            "zh": "感觉要被洗脑了",
            "narrator_zh": ""
        },
        {
            "location": "187/ACT",
            "narrator": "",
            "text": "素晴らしい壁紙だ！",
            "zh": "好棒的壁纸！",
            "narrator_zh": ""
        },
        {
            "location": "188/TALK",
            "narrator": "みやびの元司書",
            "text": "うむ。\nさすがはうちの相棒。",
            "zh": "嗯。\n不愧是我的搭档。",
            "narrator_zh": "雅的原司书"
        },
        {
            "location": "189/ACT",
            "narrator": "",
            "text": "洗脳されそう",
            "zh": "感觉要被洗脑了",
            "narrator_zh": ""
        },
        {
            "location": "190/TALK",
            "narrator": "みやびの元司書",
            "text": "メンタル弱いね。",
            "zh": "心态好弱咯。",
            "narrator_zh": "雅的原司书"
        },
        {
            "location": "193/SEL",
            "narrator": "",
            "text": "ていうか、なにやってるの！？",
            "zh": "话说回来，你在干嘛啊！？",
            "narrator_zh": ""
        },
        {
            "location": "194/SEL",
            "narrator": "",
            "text": "ていうか、なんでここに来れるの？",
            "zh": "话说回来，你怎么能到这里来？",
            "narrator_zh": ""
        },
        {
            "location": "195/ACT",
            "narrator": "",
            "text": "ていうか、なにやってるの！？",
            "zh": "话说回来，你在干嘛啊！？",
            "narrator_zh": ""
        },
        {
            "location": "196/TALK",
            "narrator": "みやびの元司書",
            "text": "ん？\nんーまあ、ちくっと\n頼まれ事をな。",
            "zh": "嗯？\n嗯—嘛，受人之托\n办点小事嘛。",
            "narrator_zh": "雅的原司书"
        },
        {
            "location": "197/ACT",
            "narrator": "",
            "text": "ていうか、なんでここに来れるの？",
            "zh": "话说回来，你怎么能到这里来？",
            "narrator_zh": ""
        },
        {
            "location": "198/TALK",
            "narrator": "みやびの元司書",
            "text": "ん？\nんーまあ、とある人に\n教えてもろてな。",
            "zh": "嗯？\n嗯—嘛，有某个人\n教了我的嘛。",
            "narrator_zh": "雅的原司书"
        },
        {
            "location": "199/TALK",
            "narrator": "みやびの元司書",
            "text": "バイトしちゅうんよ。",
            "zh": "正在这里打工着啵。",
            "narrator_zh": "雅的原司书"
        },
        {
            "location": "201/SEL",
            "narrator": "",
            "text": "誰に？？",
            "zh": "谁啊？？",
            "narrator_zh": ""
        },
        {
            "location": "202/SEL",
            "narrator": "",
            "text": "何を頼まれたの？？",
            "zh": "拜托了什么事？？",
            "narrator_zh": ""
        },
        {
            "location": "203/SEL",
            "narrator": "",
            "text": "頑張って！",
            "zh": "加油！",
            "narrator_zh": ""
        },
        {
            "location": "204/ACT",
            "narrator": "",
            "text": "誰に？？",
            "zh": "谁啊？？",
            "narrator_zh": ""
        },
        {
            "location": "205/TALK",
            "narrator": "みやびの元司書",
            "text": "はぁ…。\n面倒くさいのと\nぶつかってもうたね…。",
            "zh": "唉……。\n怎么撞上个\n麻烦的家伙了咯……。",
            "narrator_zh": "雅的原司书"
        },
        {
            "location": "206/TALK",
            "narrator": "みやびの元司書",
            "text": "お前さんが\n知らない人や。",
            "zh": "是你\n不认识的人。",
            "narrator_zh": "雅的原司书"
        },
        {
            "location": "207/TALK",
            "narrator": "みやびの元司書",
            "text": "うちはもう\n忙しいき、\nそろそろえいか？",
            "zh": "我已经\n很忙了啵，\n差不多得了吧？",
            "narrator_zh": "雅的原司书"
        },
        {
            "location": "208/ACT",
            "narrator": "",
            "text": "何を頼まれたの？？",
            "zh": "拜托了什么事？？",
            "narrator_zh": ""
        },
        {
            "location": "209/TALK",
            "narrator": "みやびの元司書",
            "text": "はぁ…。\n面倒くさいのと\nぶつかってもうたね…。",
            "zh": "唉……。\n怎么撞上个\n麻烦的家伙了咯……。",
            "narrator_zh": "雅的原司书"
        },
        {
            "location": "210/TALK",
            "narrator": "みやびの元司書",
            "text": "ちくっと\n杭を打つだけや。\n大した事やない。",
            "zh": "也就去打一下\n桩而已。\n没驷马大不了的。",
            "narrator_zh": "雅的原司书"
        },
        {
            "location": "211/TALK",
            "narrator": "みやびの元司書",
            "text": "うちはもう\n忙しいき、\nそろそろえいか？",
            "zh": "我已经\n很忙了啵，\n差不多得了吧？",
            "narrator_zh": "雅的原司书"
        },
        {
            "location": "212/ACT",
            "narrator": "",
            "text": "頑張って！",
            "zh": "加油！",
            "narrator_zh": ""
        },
        {
            "location": "213/TALK",
            "narrator": "みやびの元司書",
            "text": "うむ。\nお前さんも頑張りや。\nうちはそろそろ行くき。",
            "zh": "嗯。\n你也要加油啵。\n我差不多要走了嘛。",
            "narrator_zh": "雅的原司书"
        },
        {
            "location": "223/SEL",
            "narrator": "",
            "text": "でも無事で良かった",
            "zh": "不过你没事真是太好了",
            "narrator_zh": ""
        },
        {
            "location": "224/ACT",
            "narrator": "",
            "text": "でも無事で良かった",
            "zh": "不过你没事真是太好了",
            "narrator_zh": ""
        },
        {
            "location": "226/TALK",
            "narrator": "みやびの元司書",
            "text": "ん？\nああ、ココロゲートでの\n話かね？",
            "zh": "嗯？\n啊啊，是说心之扉那里的\n事咩？",
            "narrator_zh": "雅的原司书"
        },
        {
            "location": "227/TALK",
            "narrator": "みやびの元司書",
            "text": "うちを誰やと\n思っちゅう！",
            "zh": "你以为我\n是谁啊！",
            "narrator_zh": "雅的原司书"
        },
        {
            "location": "228/TALK",
            "narrator": "みやびの元司書",
            "text": "……なんて、\n大口叩くと後で\n怒られるやもしれんね。",
            "zh": "……这种话，\n要是说太满，回头\n怕是要挨骂咯。",
            "narrator_zh": "雅的原司书"
        },
        {
            "location": "229/TALK",
            "narrator": "みやびの元司書",
            "text": "実はみやびさんの司書\nシンギュラリティーさんは\n一度死んだのだ！",
            "zh": "其实雅小姐的司书\n奇点小姐她\n曾经死过一次！",
            "narrator_zh": "雅的原司书"
        },
        {
            "location": "232/TALK",
            "narrator": "みやびの元司書",
            "text": "<size=40>ばーん！</size>",
            "zh": "<size=40>啪——！</size>",
            "narrator_zh": "雅的原司书"
        },
        {
            "location": "233/SEL",
            "narrator": "",
            "text": "なんだってー！",
            "zh": "你说什么——！",
            "narrator_zh": ""
        },
        {
            "location": "234/ACT",
            "narrator": "",
            "text": "なんだってー！",
            "zh": "你说什么——！",
            "narrator_zh": ""
        },
        {
            "location": "236/TALK",
            "narrator": "みやびの元司書",
            "text": "うちも今回ばかりは\nしくったと思うた。",
            "zh": "我也觉得光那一次\n真是搞砸了。",
            "narrator_zh": "雅的原司书"
        },
        {
            "location": "237/TALK",
            "narrator": "みやびの元司書",
            "text": "先走りすぎたかと。",
            "zh": "还以为太冒进了。",
            "narrator_zh": "雅的原司书"
        },
        {
            "location": "238/TALK",
            "narrator": "みやびの元司書",
            "text": "けんど、ある人が\n助けてくれたんよ。",
            "zh": "但是，有个人\n救了我啵。",
            "narrator_zh": "雅的原司书"
        },
        {
            "location": "239/SEL",
            "narrator": "",
            "text": "誰！？",
            "zh": "是谁！？",
            "narrator_zh": ""
        },
        {
            "location": "240/ACT",
            "narrator": "",
            "text": "誰！？",
            "zh": "是谁！？",
            "narrator_zh": ""
        },
        {
            "location": "242/TALK",
            "narrator": "みやびの元司書",
            "text": "それは…今は誰にも\n言えんよ。\n同じココロの人格にもな。",
            "zh": "这个……现在对谁\n都不能说啵。\n连同一个心灵的人格也不行。",
            "narrator_zh": "雅的原司书"
        },
        {
            "location": "243/TALK",
            "narrator": "みやびの元司書",
            "text": "ま、そんなわけやき、\nうちは作業に戻るぞね。",
            "zh": "嘛，就是这么回事，\n我要回去干活咧。",
            "narrator_zh": "雅的原司书"
        },
        {
            "location": "245/SEL",
            "narrator": "",
            "text": "そういえば、みやびは今回の記録映像見た？",
            "zh": "说起来，雅你看了这次的记录影像吗？",
            "narrator_zh": ""
        },
        {
            "location": "246/SEL",
            "narrator": "",
            "text": "行ってらっしゃい",
            "zh": "路上小心",
            "narrator_zh": ""
        },
        {
            "location": "247/ACT",
            "narrator": "",
            "text": "そういえば、みやびは今回の記録映像見た？",
            "zh": "说起来，雅你看了这次的记录影像吗？",
            "narrator_zh": ""
        },
        {
            "location": "248/TALK",
            "narrator": "みやびの元司書",
            "text": "いや、見ちょらんけんど。\nどういたが？",
            "zh": "没得，没看啵。\n做驷马了？",
            "narrator_zh": "雅的原司书"
        },
        {
            "location": "249/SEL",
            "narrator": "",
            "text": "神楽が大変なことに！",
            "zh": "神乐出大事了！",
            "narrator_zh": ""
        },
        {
            "location": "250/SEL",
            "narrator": "",
            "text": "千羽鶴は一体何者なの！？",
            "zh": "千羽鹤到底是什么人！？",
            "narrator_zh": ""
        },
        {
            "location": "251/ACT",
            "narrator": "",
            "text": "神楽が大変なことに！",
            "zh": "神乐出大事了！",
            "narrator_zh": ""
        },
        {
            "location": "252/TALK",
            "narrator": "みやびの元司書",
            "text": "ああ、それか。\n驚く程のことでもない。\n想像の範疇内やき。",
            "zh": "啊啊，那个啊。\n也没到吃惊的程度。\n算在预料范围里啵。",
            "narrator_zh": "雅的原司书"
        },
        {
            "location": "253/TALK",
            "narrator": "みやびの元司書",
            "text": "まあ、問題はあれやね、\n今後の対応を考えると\n頭が痛いゆうことや。",
            "zh": "嘛，问题是那个咯，\n一想到今后的应对\n就让人头疼。",
            "narrator_zh": "雅的原司书"
        },
        {
            "location": "254/TALK",
            "narrator": "みやびの元司書",
            "text": "仲間内も\n揉めるやろしね。",
            "zh": "同伴之间\n怕是也要闹矛盾咯。",
            "narrator_zh": "雅的原司书"
        },
        {
            "location": "255/ACT",
            "narrator": "",
            "text": "千羽鶴は一体何者なの！？",
            "zh": "千羽鹤到底是什么人！？",
            "narrator_zh": ""
        },
        {
            "location": "256/TALK",
            "narrator": "みやびの元司書",
            "text": "ナビゲーターやろ。\nうちも最近その存在を\n知ったんやけんどな。",
            "zh": "不就是导航角色咯。\n虽然我也是最近才知道\n有这么个存在嘛。",
            "narrator_zh": "雅的原司书"
        },
        {
            "location": "257/TALK",
            "narrator": "みやびの元司書",
            "text": "まあ、今うちがここに\nいるんは、その子が\n割と関係あるらしいね。",
            "zh": "嘛，我现在会在这里，\n好像和那丫头\n还蛮有关系的咯。",
            "narrator_zh": "雅的原司书"
        },
        {
            "location": "258/TALK",
            "narrator": "みやびの元司書",
            "text": "詳しいことは\nようは知らんが。",
            "zh": "具体情况我倒\n不太清楚。",
            "narrator_zh": "雅的原司书"
        },
        {
            "location": "260/TALK",
            "narrator": "みやびの元司書",
            "text": "おっと、\nそろそろ作業に戻らんと。",
            "zh": "哎呀，\n差不多得回去干活了。",
            "narrator_zh": "雅的原司书"
        },
        {
            "location": "261/TALK",
            "narrator": "みやびの元司書",
            "text": "ナビゲーターが\n外してる間だけが\nチャンスやゆうき。",
            "zh": "说是只有导航角色\n离开的这段时间\n才是机会嘛。",
            "narrator_zh": "雅的原司书"
        },
        {
            "location": "262/TALK",
            "narrator": "みやびの元司書",
            "text": "ほなまたな。",
            "zh": "那就回头见咧。",
            "narrator_zh": "雅的原司书"
        },
        {
            "location": "263/ACT",
            "narrator": "",
            "text": "行ってらっしゃい",
            "zh": "路上小心",
            "narrator_zh": ""
        },
        {
            "location": "264/TALK",
            "narrator": "みやびの元司書",
            "text": "うむ。\nほなまたな。",
            "zh": "嗯。\n回头见咧。",
            "narrator_zh": "雅的原司书"
        },
