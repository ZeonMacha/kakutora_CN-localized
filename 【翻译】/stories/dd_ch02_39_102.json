            "narrator": "",
            "text": "エリカさんのこと",
            "zh": "关于领火的事",
            "narrator_zh": ""
        },
        {
            "location": "864/SEL",
            "narrator": "",
            "text": "同僚だったんでしょ",
            "zh": "以前是同事吧",
            "narrator_zh": ""
        },
        {
            "location": "865/ACT",
            "narrator": "",
            "text": "エリカさんのこと",
            "zh": "关于领火的事",
            "narrator_zh": ""
        },
        {
            "location": "866/TALK",
            "narrator": "アーヤ",
            "text": "そうかも",
