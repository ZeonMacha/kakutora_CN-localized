{
    "dir": "chap39/daydra/dd_ch02_39_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "39205",
        "cid": "ayami",
        "title": "005 メインストーリー",
        "sub_title": "輝ける未来の空に＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "在光辉未来的天空中＜后篇＞"
    },
    "entry": [
        {
            "location": "658/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "659/TALK",
            "narrator": "小夜",
            "text": "急でびっくりしたと\n思うけど…。\n考えて欲しいな。",
            "zh": "虽然这么突然应该\n吓了你一跳……。\n还是希望你能考虑一下。",
            "narrator_zh": "小夜"
        },
        {
            "location": "662/TALK",
            "narrator": "ガブリエラ",
            "text": "急っていうか…。",
            "zh": "与其说突然……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "663/TALK",
            "narrator": "ガブリエラ",
            "text": "あたし、人形劇とか\nあんまり…。",
            "zh": "我对人偶剧什么的\n实在不太……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "664/TALK",
            "narrator": "小夜",
            "text": "そっか…。",
            "zh": "这样啊……。",
            "narrator_zh": "小夜"
        },
        {
            "location": "665/TALK",
            "narrator": "小夜",
            "text": "この前の人形劇の\nガブちゃん、\nアドリブもできたし。",
            "zh": "上次人偶剧的时候\n加布还会随机应变，\n临场发挥呢。",
            "narrator_zh": "小夜"
        },
        {
            "location": "666/TALK",
            "narrator": "小夜",
            "text": "ちゃんと練習したら\nきっともっと上手に\nできそうだなって。",
            "zh": "我原本觉得只要认真\n练习的话，\n你肯定能演得更好的。",
            "narrator_zh": "小夜"
        },
        {
            "location": "667/TALK",
            "narrator": "小夜",
            "text": "そう思ってたん\nだけど……。",
            "zh": "本来是这么想的\n来着……。",
            "narrator_zh": "小夜"
        },
        {
            "location": "669/TALK",
            "narrator": "ガブリエラ",
            "text": "あれは別に\nたまたまだし…。",
            "zh": "那不过是\n碰巧而已啦……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "671/TALK",
            "narrator": "アーヤ",
            "text": "たまたまなのが\nすごいんだと\n思うわ。",
            "zh": "碰巧就能演成那样\n才叫厉害\n吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "672/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤまで何！？",
            "zh": "怎么连绫水也这样！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "673/TALK",
            "narrator": "アーヤ",
            "text": "だって本当の\nことだもの。",
            "zh": "因为这是事实\n嘛。",
            "narrator_zh": "绫水"
        },
        {
            "location": "674/TALK",
            "narrator": "アーヤ",
            "text": "それとね。今回は\n打ち上げ代わりに\n長野に行くつもりなの。",
            "zh": "对了。这次我们还打算\n去长野，就当做\n庆功宴了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "675/TALK",
            "narrator": "アーヤ",
            "text": "前はバタバタだったから\nちょっとゆっくり観光も\n兼ねて。",
            "zh": "上次去的时候太匆忙了，\n这次顺便好好观光\n放松一下。",
            "narrator_zh": "绫水"
        },
        {
            "location": "676/TALK",
            "narrator": "ガブリエラ",
            "text": "えっ！",
            "zh": "哎！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "677/TALK",
            "narrator": "小夜",
            "text": "アーヤに色々案内して\nもらうつもりなの。",
            "zh": "我打算让绫水带我们\n好好逛逛呢。",
            "narrator_zh": "小夜"
        },
        {
            "location": "678/TALK",
            "narrator": "小夜",
            "text": "絶対楽しいと\n思うんだけどな。",
            "zh": "肯定会超开心的\n对吧。",
            "narrator_zh": "小夜"
        },
        {
            "location": "680/TALK",
            "narrator": "ガブリエラ",
            "text": "……わかったわよ。",
            "zh": "……我知道了啦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "681/TALK",
            "narrator": "小夜",
            "text": "本当！？\nありがとう！\nうれしい！",
            "zh": "真的吗！？\n谢谢你！\n太开心了！",
            "narrator_zh": "小夜"
        },
        {
            "location": "682/TALK",
            "narrator": "アーヤ",
            "text": "大変だと思うけど\nよろしくね。",
            "zh": "虽然会很辛苦，\n但就拜托你咯。",
            "narrator_zh": "绫水"
        },
        {
            "location": "683/TALK",
            "narrator": "ガブリエラ",
            "text": "…いいわよ別に。",
            "zh": "……也没什么大不了的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "684/TALK",
            "narrator": "ガブリエラ",
            "text": "あっでも！\n長野には絶対\n連れて行ってね！",
            "zh": "啊，不过！\n长野可一定要\n带我去哦！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "686/TALK",
            "narrator": "アーヤ",
            "text": "当然よ。",
            "zh": "那是当然。",
            "narrator_zh": "绫水"
        },
        {
            "location": "687/SEL",
            "narrator": "",
            "text": "うまく説得できたね",
            "zh": "说服得很顺利呢",
            "narrator_zh": ""
        },
        {
            "location": "688/ACT",
            "narrator": "",
            "text": "うまく説得できたね",
            "zh": "说服得很顺利呢",
            "narrator_zh": ""
        },
        {
            "location": "705/TALK",
            "narrator": "アーヤ",
            "text": "この前のギャヴィ楽しそうだったし",
            "zh": "上次看加维也挺开心的",
            "narrator_zh": "绫水"
        },
        {
            "location": "706/TALK",
            "narrator": "アーヤ",
            "text": "引き受けてくれるって思ってた",
            "zh": "我本来就觉得她会答应",
            "narrator_zh": "绫水"
        },
        {
            "location": "708/SEL",
            "narrator": "",
            "text": "そうなんだ",
            "zh": "原来如此",
            "narrator_zh": ""
        },
        {
            "location": "709/SEL",
            "narrator": "",
            "text": "声出す練習にもなるしね",
            "zh": "也能顺便练习发声呢",
            "narrator_zh": ""
        },
        {
            "location": "710/SEL",
            "narrator": "",
            "text": "日本語また上達するんじゃない",
            "zh": "日语说不定又能进步了",
            "narrator_zh": ""
        },
        {
            "location": "711/ACT",
            "narrator": "",
            "text": "そうなんだ",
            "zh": "原来如此",
            "narrator_zh": ""
        },
        {
            "location": "712/TALK",
            "narrator": "アーヤ",
            "text": "伊達に付き合い長くないのよ",
            "zh": "我们可不是白认识这么久的哦",
            "narrator_zh": "绫水"
        },
        {
            "location": "713/ACT",
            "narrator": "",
            "text": "声出す練習にもなるしね",
            "zh": "也能顺便练习发声呢",
            "narrator_zh": ""
        },
        {
            "location": "714/TALK",
            "narrator": "アーヤ",
            "text": "それもある",
            "zh": "也有这一层考量",
            "narrator_zh": "绫水"
        },
        {
            "location": "715/TALK",
            "narrator": "アーヤ",
            "text": "いきなりは難しいけどね",
            "zh": "不过一下子还是很难就是了",
            "narrator_zh": "绫水"
        },
        {
            "location": "716/ACT",
            "narrator": "",
            "text": "日本語また上達するんじゃない",
            "zh": "日语说不定又能进步了",
            "narrator_zh": ""
        },
        {
            "location": "717/TALK",
            "narrator": "アーヤ",
            "text": "現時点でもネイティブ並みだけどね",
            "zh": "虽然她现在就已经跟母语者差不多了",
            "narrator_zh": "绫水"
        },
        {
            "location": "718/TALK",
            "narrator": "アーヤ",
            "text": "あのこ努力家だし",
            "zh": "那孩子也很努力嘛",
            "narrator_zh": "绫水"
        },
        {
            "location": "730/TALK",
            "narrator": "アーヤ",
            "text": "じゃあ早速練習の\nスケジュールを\n立てましょう。",
            "zh": "那我们这就来\n制订一下练习的\n日程表吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "732/TALK",
            "narrator": "ガブリエラ",
            "text": "長野旅行のじゃ\nないの？",
            "zh": "不是制订长野旅行的\n日程吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "733/TALK",
            "narrator": "小夜",
            "text": "それは後でのお楽しみ。",
            "zh": "那个留到之后再慢慢期待。",
            "narrator_zh": "小夜"
        },
        {
            "location": "734/TALK",
            "narrator": "アーヤ",
            "text": "そうそう。まずは\n人形劇を成功\nさせなくちゃ。",
            "zh": "对对。首先得把\n人偶剧圆满\n完成才行。",
            "narrator_zh": "绫水"
        },
        {
            "location": "735/TALK",
            "narrator": "アーヤ",
            "text": "ビシビシやるから\n覚悟してね！",
            "zh": "我会严格督促的，\n做好觉悟吧！",
            "narrator_zh": "绫水"
        },
        {
            "location": "759/TALK",
            "narrator": "ガブリエラ",
            "text": "ねえアーヤ。\nここでの女の子の\n動作なんだけど…。",
            "zh": "我说绫水。\n女孩在这里的\n动作要怎么摆……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "761/TALK",
            "narrator": "アーヤ",
            "text": "ふふ。",
            "zh": "呵呵。",
            "narrator_zh": "绫水"
        },
        {
            "location": "762/TALK",
            "narrator": "ガブリエラ",
            "text": "…何よ？",
            "zh": "……干嘛啦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "763/TALK",
            "narrator": "アーヤ",
            "text": "ううん。\n真面目にやってくれて\nうれしいなってだけ。",
            "zh": "没什么。\n只是觉得你能这么认真排练，\n让我挺开心的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "765/TALK",
            "narrator": "ガブリエラ",
            "text": "当たり前でしょ！\n引き受けたからには\n真面目にやるわ。",
            "zh": "这不是理所当然的吗！\n既然接下了，\n我就会认真演完。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "766/TALK",
            "narrator": "ガブリエラ",
            "text": "…それに一応\n主役なんだし…。",
            "zh": "……再说好歹\n也是主角嘛……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "767/TALK",
            "narrator": "アーヤ",
            "text": "一応じゃないわ。\nギャヴィがいないと\n成り立たないもの。",
            "zh": "不是什么好歹。\n没有加维的话，\n这出戏可演不下去哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "768/TALK",
            "narrator": "ガブリエラ",
            "text": "おだてなくていいから！\nちゃんと長野に\n連れてってよね！",
            "zh": "用不着奉承我啦！\n记得一定要带我\n去长野哦！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "770/TALK",
            "narrator": "アーヤ",
            "text": "もちろん。",
            "zh": "当然了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "771/TALK",
            "narrator": "アーヤ",
            "text": "もう少し姉のことも\n調べたいし…。",
            "zh": "我也想再多调查一点\n姐姐的事……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "772/TALK",
            "narrator": "ガブリエラ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "773/TALK",
            "narrator": "アーヤ",
            "text": "あ、もちろん\n観光がメインよ。\n慰安旅行だもの。",
            "zh": "啊，不过当然还是\n以观光为主哦。\n毕竟是慰劳旅行嘛。",
            "narrator_zh": "绫水"
        },
        {
            "location": "774/TALK",
            "narrator": "アーヤ",
            "text": "小夜たちも一緒だし。",
            "zh": "小夜她们也会一起去。",
            "narrator_zh": "绫水"
        },
        {
            "location": "775/TALK",
            "narrator": "ガブリエラ",
            "text": "…それでいいの？",
            "zh": "……这样没关系吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "776/TALK",
            "narrator": "アーヤ",
            "text": "むしろそうしたいの。",
            "zh": "我反而想这么做。",
            "narrator_zh": "绫水"
        },
        {
            "location": "777/TALK",
            "narrator": "アーヤ",
            "text": "バタフライエフェクトの話\n憶えてる？",
            "zh": "蝴蝶效应的道理\n你还记得吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "778/TALK",
            "narrator": "アーヤ",
            "text": "お姉ちゃんは外の世界で\n死んだことになってる。\nでも実は死んでない。",
            "zh": "姐姐在外界\n被认定已经死了。\n但她其实还活着。",
            "narrator_zh": "绫水"
        },
        {
            "location": "779/TALK",
            "narrator": "アーヤ",
            "text": "だったらいつかきっと\n私の行動は姉に\nつながるはず。",
            "zh": "既然如此，总有一天\n我的行动也一定能\n与姐姐产生关联。",
            "narrator_zh": "绫水"
        },
        {
            "location": "780/TALK",
            "narrator": "アーヤ",
            "text": "この前は会い損ねたけど\nそのうちチャンスが来ると\n思ってる。",
            "zh": "虽然上次没能见到，\n但我觉得总会有\n机会到来的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "781/TALK",
            "narrator": "アーヤ",
            "text": "だからこれでいいの。",
            "zh": "所以这样就好了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "782/TALK",
            "narrator": "ガブリエラ",
            "text": "そういうもの？",
            "zh": "是那样的吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "783/TALK",
            "narrator": "アーヤ",
            "text": "勝手な人だけど\n嫌いじゃないしね\nお姉ちゃんのことは。",
            "zh": "她虽然是个任性的人，\n但我也不算讨厌\n姐姐就是了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "784/TALK",
            "narrator": "ガブリエラ",
            "text": "えっ！？",
            "zh": "哎！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "785/TALK",
            "narrator": "アーヤ",
            "text": "驚きすぎよ。",
            "zh": "你也太惊讶了吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "786/TALK",
            "narrator": "ガブリエラ",
            "text": "だって今まであんなに！",
            "zh": "因为你以前一直都那么……！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "787/SEL",
            "narrator": "",
            "text": "ガブリエラに同意",
            "zh": "赞同加布里埃拉",
            "narrator_zh": ""
        },
        {
            "location": "788/ACT",
            "narrator": "",
            "text": "ガブリエラに同意",
            "zh": "赞同加布里埃拉",
            "narrator_zh": ""
        },
        {
            "location": "805/TALK",
            "narrator": "アーヤ",
            "text": "そう？",
            "zh": "是吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "807/TALK",
            "narrator": "アーヤ",
            "text": "$handle$さんには結構本心見せてたと思うけど",
            "zh": "我觉得我在$handle$面前还是挺流露真心的",
            "narrator_zh": "绫水"
        },
        {
            "location": "809/SEL",
            "narrator": "",
            "text": "ツンデレの自覚はあるんだ",
            "zh": "原来你有意识到自己很傲娇啊",
            "narrator_zh": ""
        },
        {
            "location": "810/SEL",
            "narrator": "",
            "text": "もっともっと見たいな",
            "zh": "还想再多看看呢",
            "narrator_zh": ""
        },
        {
            "location": "811/ACT",
            "narrator": "",
            "text": "ツンデレの自覚はあるんだ",
            "zh": "原来你有意识到自己很傲娇啊",
            "narrator_zh": ""
        },
        {
            "location": "812/TALK",
            "narrator": "アーヤ",
            "text": "変な言い方しないで",
            "zh": "别用那种奇怪的说法",
            "narrator_zh": "绫水"
        },
        {
            "location": "813/TALK",
            "narrator": "アーヤ",
            "text": "もう！",
            "zh": "真是的！",
            "narrator_zh": "绫水"
        },
        {
            "location": "814/ACT",
            "narrator": "",
            "text": "もっともっと見たいな",
            "zh": "还想再多看看呢",
            "narrator_zh": ""
        },
        {
            "location": "815/TALK",
            "narrator": "アーヤ",
            "text": "$handle$さんが望むなら",
            "zh": "只要$handle$希望的话",
            "narrator_zh": "绫水"
        },
        {
            "location": "816/TALK",
            "narrator": "アーヤ",
            "text": "なんてね",
            "zh": "开个玩笑",
            "narrator_zh": "绫水"
        },
        {
            "location": "829/TALK",
            "narrator": "アーヤ",
            "text": "そんなことより\n劇の演出の話を\nしましょ。",
            "zh": "比起这个，\n我们来聊聊戏剧的\n编排吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "830/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょ…！\nそんなのどうでも…！",
            "zh": "等……！\n这种事怎样都……！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "834/TALK",
            "narrator": "真幌",
            "text": "どうした？",
            "zh": "怎么了？",
            "narrator_zh": "真幌"
        },
        {
            "location": "835/TALK",
            "narrator": "アーヤ",
            "text": "あ、館長。",
