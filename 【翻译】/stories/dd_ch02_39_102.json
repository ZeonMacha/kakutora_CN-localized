        },
        {
            "location": "839/TALK",
            "narrator": "ガブリエラ",
            "text": "来なくていいわよ！\n来なくていいから！",
            "zh": "不用来啦！\n绝对不用来了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "840/TALK",
            "narrator": "真幌",
            "text": "そう言われると\nますます気になるな。",
            "zh": "你越是这么说，\n我可就越在意了啊。",
            "narrator_zh": "真幌"
        },
        {
            "location": "841/TALK",
            "narrator": "ガブリエラ",
            "text": "えっちょっと！\nアーヤ！",
            "zh": "哎，等一下！\n绫水！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "842/TALK",
            "narrator": "真幌",
            "text": "それは台本か？\nどれどれ…。",
            "zh": "这就是剧本吗？\n我瞧瞧……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "843/SEL",
            "narrator": "",
            "text": "真幌は何か知ってるんじゃない？",
            "zh": "真幌是不是知道些什么？",
            "narrator_zh": ""
        },
        {
            "location": "844/ACT",
            "narrator": "",
            "text": "真幌は何か知ってるんじゃない？",
            "zh": "真幌是不是知道些什么？",
            "narrator_zh": ""
        },
        {
            "location": "861/TALK",
            "narrator": "アーヤ",
            "text": "何を？",
            "zh": "知道什么？",
            "narrator_zh": "绫水"
        },
        {
