            "location": "837/TALK",
            "narrator": "ガブリエラ",
            "text": "えっ…！",
            "zh": "哎……！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "838/TALK",
            "narrator": "真幌",
            "text": "舞台？\n面白そうだな。",
            "zh": "舞台剧？\n听起来挺有意思的啊。",
