            "narrator_zh": "绫水"
        },
        {
            "location": "836/TALK",
            "narrator": "アーヤ",
            "text": "館長もギャヴィの\n晴れ舞台、観に\n来ませんか？",
            "zh": "馆长要不要也来看\n加维的盛大登台\n呢？",
            "narrator_zh": "绫水"
        },
