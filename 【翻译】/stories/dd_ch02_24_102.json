    "entry": [
        {
            "location": "483/TALK",
            "narrator": "アーヤ",
            "text": "…ううん。\nやっぱり、ダメ！",
            "zh": "……不对。\n果然，不行！",
            "narrator_zh": "绫水"
        },
        {
            "location": "484/TALK",
            "narrator": "アーヤ",
            "text": "館長のことはもちろん\n気になるけど、それだけで\n動いたらいけないわ。",
            "zh": "我当然很担心\n馆长，但也不能\n光凭这个就贸然行动。",
            "narrator_zh": "绫水"
        },
        {
            "location": "485/TALK",
            "narrator": "アーヤ",
            "text": "館長がいない間は、\n私が代わりをしなきゃ\nいけないんだし。",
            "zh": "在馆长不在的期间，\n必须由我来\n顶替她的位置才行。",
            "narrator_zh": "绫水"
        },
        {
            "location": "486/TALK",
            "narrator": "アーヤ",
            "text": "…大丈夫。",
            "zh": "……没问题的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "487/TALK",
            "narrator": "アーヤ",
            "text": "私にはできるって、\n館長は信じてくれたん\nだから…。",
            "zh": "馆长她相信着\n我能做到才托付给我的\n……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "489/TALK",
            "narrator": "アーヤ",
            "text": "…ねえ、ギャヴィ。",
            "zh": "……呐，加维。",
            "narrator_zh": "绫水"
        },
        {
            "location": "492/TALK",
            "narrator": "ガブリエラ",
            "text": "ん？　なに？",
            "zh": "嗯？　怎么了？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "493/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "495/TALK",
            "narrator": "アーヤ",
            "text": "ううん、ごめん。\n何でもない。",
            "zh": "没、没事，抱歉。\n什么都没有。",
            "narrator_zh": "绫水"
        },
        {
            "location": "496/TALK",
            "narrator": "ガブリエラ",
            "text": "は？　何よそれ…。\nまあ、いいけど…。",
            "zh": "哈？　什么跟什么啊……。\n算了，随你便……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "497/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "509/TALK",
            "narrator": "アーヤ",
            "text": "みんなに聞けない質問",
            "zh": "有个没法问大家的问题",
            "narrator_zh": "绫水"
        },
        {
            "location": "511/TALK",
            "narrator": "アーヤ",
            "text": "聞いてくれる？(￣Д￣ )",
            "zh": "你愿意听听吗？(￣Д￣ )",
            "narrator_zh": "绫水"
        },
        {
            "location": "513/SEL",
            "narrator": "",
            "text": "そのために$me$がいる",
            "zh": "就是为了这个$me$才在的呀",
            "narrator_zh": ""
        },
        {
            "location": "514/ACT",
            "narrator": "",
            "text": "そのために$me$がいる",
            "zh": "就是为了这个$me$才在的呀",
            "narrator_zh": ""
        },
        {
            "location": "516/TALK",
            "narrator": "アーヤ",
            "text": "ありがと(^^",
            "zh": "谢谢(^^",
            "narrator_zh": "绫水"
        },
        {
            "location": "520/TALK",
            "narrator": "アーヤ",
            "text": "もしもだけど",
