            "text": "混乱してたみたい(´o｀；",
            "zh": "看来有点乱了阵脚(´o｀；",
            "narrator_zh": "绫水"
        },
        {
            "location": "623/TALK",
            "narrator": "アーヤ",
            "text": "そもそも館長って",
            "zh": "说到底，馆长她",
            "narrator_zh": "绫水"
        },
        {
            "location": "624/TALK",
            "narrator": "アーヤ",
            "text": "簡単にどうにかなるような",
            "zh": "本来就不是那种",
            "narrator_zh": "绫水"
        },
        {
            "location": "625/TALK",
            "narrator": "アーヤ",
            "text": "そんな人じゃなかったわ(^^",
            "zh": "会轻易出事的人呀(^^",
            "narrator_zh": "绫水"
        },
        {
            "location": "628/TALK",
            "narrator": "アーヤ",
            "text": "ちょっと",
            "zh": "我得",
            "narrator_zh": "绫水"
        },
        {
            "location": "629/TALK",
            "narrator": "アーヤ",
            "text": "落ち着かなくちゃ",
            "zh": "稍微冷静下来才行",
            "narrator_zh": "绫水"
        },
        {
            "location": "641/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "642/TALK",
            "narrator": "アーヤ",
            "text": "そうよね。",
            "zh": "是啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "643/TALK",
            "narrator": "アーヤ",
            "text": "館長が帰ってくる\nまでの代役なら、\n私にもできるはず。",
            "zh": "只是在馆长回来之前\n当个代班的话，\n我应该也做得到。",
            "narrator_zh": "绫水"
        },
        {
            "location": "645/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィ…。\n私、頑張るから。",
            "zh": "加维……。\n我会加油的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "647/TALK",
            "narrator": "ガブリエラ",
            "text": "は？",
            "zh": "哈？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "649/TALK",
            "narrator": "アーヤ",
            "text": "ううん…。\n聞いてもらいたかった\nだけ。",
            "zh": "没什么……。\n我只是想找个人\n听我说一声。",
            "narrator_zh": "绫水"
        },
        {
            "location": "650/TALK",
            "narrator": "ガブリエラ",
            "text": "…変なの。",
            "zh": "……莫名其妙。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "651/TALK",
            "narrator": "アーヤ",
            "text": "…代役くらいは、\n私が勤めます。",
            "zh": "……代班的话，\n我还是能胜任的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "652/TALK",
            "narrator": "アーヤ",
            "text": "だから…無事な顔を\n見せてくださいよ、\n館長…。",
            "zh": "所以……请一定\n要平安露面啊，\n馆长……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "663/DIALOG",
            "narrator": "Dialog_chapter_ch02",
            "text": "【20 ２０１６】",
            "zh": "【20 2016】",
            "narrator_zh": "Dialog_chapter_ch02"
        }
    ]
}
