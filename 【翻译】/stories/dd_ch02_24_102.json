            "narrator": "アーヤ",
            "text": "救出に行かないといけないの",
            "zh": "我们就必须去救她才行吧",
            "narrator_zh": "绫水"
        },
        {
            "location": "524/SEL",
            "narrator": "",
            "text": "ええと？",
            "zh": "呃？",
            "narrator_zh": ""
        },
        {
            "location": "525/SEL",
            "narrator": "",
            "text": "何？　ゲームの話？",
