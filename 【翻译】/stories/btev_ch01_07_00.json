{
    "dir": "chap07/battle/btev_ch01_07_00.js",
    "type": "",
    "info": {
        "story_id": "21010",
        "cid": "",
        "title": "010 ココロスフィアストーリー【Lv04】",
        "sub_title": "仁王門＜提起＞",
        "title_zh": "010 心灵领域故事【Lv04】",
        "sub_title_zh": "仁王门＜提起＞"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "仁王門",
            "zh": "仁王门",
            "narrator_zh": ""
        },
        {
            "location": "13/DIALOG",
            "narrator": "",
            "text": "<size=40>KOKORO-Lv. 04</size>\nTSUBAME - OHSE\n\n<size=45>仁王門</size>\n<size=35>～彼女が抱える家庭の事情～</size>",
            "zh": "<size=40>KOKORO-Lv. 04</size>\n逢濑燕\n\n<size=45>仁王门</size>\n<size=35>～她背负的家庭境况～</size>",
            "narrator_zh": ""
        },
        {
            "location": "25/TALK",
            "narrator": "啓介",
            "text": "おい、貴様！",
            "zh": "喂，你！",
            "narrator_zh": "启介"
        },
        {
            "location": "26/SEL",
            "narrator": "（選択肢）",
            "text": "はい",
            "zh": "是",
            "narrator_zh": "（选项）"
        },
        {
            "location": "27/SEL",
            "narrator": "（選択肢）",
            "text": "はい！お義父さん！",
            "zh": "是！岳父！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "28/SEL",
            "narrator": "（選択肢）",
            "text": "どちら様でしょうか？",
            "zh": "请问是哪位？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "29/ACT",
            "narrator": "",
            "text": "はい",
            "zh": "是",
            "narrator_zh": ""
        },
        {
            "location": "30/TALK",
            "narrator": "啓介",
            "text": "なぜここにいる！？",
            "zh": "你为什么在这里！？",
            "narrator_zh": "启介"
        },
        {
            "location": "31/ACT",
            "narrator": "",
            "text": "はい！お義父さん！",
            "zh": "是！岳父！",
            "narrator_zh": ""
        },
        {
            "location": "33/TALK",
            "narrator": "啓介",
            "text": "貴様なぞに\nお義父さん呼ばわり\nされる覚えは無い！",
            "zh": "我可不记得\n让你这种人\n叫我岳父！",
            "narrator_zh": "启介"
        },
        {
            "location": "34/TALK",
            "narrator": "啓介",
            "text": "なぜここにいる！？",
            "zh": "你为什么在这里！？",
            "narrator_zh": "启介"
        },
        {
            "location": "35/ACT",
            "narrator": "",
            "text": "どちら様でしょうか？",
            "zh": "请问是哪位？",
            "narrator_zh": ""
        },
        {
            "location": "36/TALK",
            "narrator": "啓介",
            "text": "貴様は知らなくても\nいいことだ。",
            "zh": "你不需要\n知道。",
            "narrator_zh": "启介"
        },
        {
            "location": "37/TALK",
            "narrator": "啓介",
            "text": "それより、\nなぜここにいる！？",
            "zh": "比起这个，\n你为什么在这里！？",
            "narrator_zh": "启介"
        },
        {
            "location": "39/SEL",
            "narrator": "（選択肢）",
            "text": "す、すみません！来るところを間違えました！",
            "zh": "对、对不起！我走错地方了！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "40/SEL",
            "narrator": "（選択肢）",
            "text": "つばめさんの友だちです！から",
            "zh": "我是燕的朋友！所以",
            "narrator_zh": "（选项）"
        },
        {
            "location": "41/SEL",
            "narrator": "（選択肢）",
            "text": "つばめさんのフィアンセですから",
            "zh": "因为我是燕的费昂塞",
            "narrator_zh": "（选项）"
        },
        {
            "location": "42/ACT",
            "narrator": "",
            "text": "す、すみません間違えました！",
            "zh": "对、对不起，我搞错了！",
            "narrator_zh": ""
        },
        {
            "location": "43/TALK",
            "narrator": "啓介",
            "text": "早くここから出ていけ！",
            "zh": "赶快从这里出去！",
            "narrator_zh": "启介"
        },
        {
            "location": "45/ACT",
            "narrator": "",
            "text": "つばめさんの友だちです！",
            "zh": "我是燕的朋友！",
            "narrator_zh": ""
        },
        {
            "location": "46/TALK",
            "narrator": "啓介",
            "text": "友だちだと？",
            "zh": "朋友？",
            "narrator_zh": "启介"
        },
        {
            "location": "47/TALK",
            "narrator": "啓介",
            "text": "ここは友だち如きが\n立ち入って良い場所\nではない！！",
            "zh": "这里不是什么朋友\n就能随便进来的\n地方！！",
            "narrator_zh": "启介"
        },
        {
            "location": "48/SEL",
            "narrator": "（選択肢）",
            "text": "すみません…",
            "zh": "对不起……",
            "narrator_zh": "（选项）"
        },
        {
            "location": "49/ACT",
            "narrator": "",
            "text": "すみません…",
            "zh": "对不起……",
            "narrator_zh": ""
        },
        {
            "location": "51/ACT",
            "narrator": "",
            "text": "つばめさんのフィアンセですから",
            "zh": "因为我是燕的费昂塞",
            "narrator_zh": ""
        },
        {
            "location": "53/TALK",
            "narrator": "啓介",
            "text": "…っ！？\n貴様正気か！？",
            "zh": "……！？\n你疯了吗！？",
            "narrator_zh": "启介"
        },
        {
            "location": "54/SEL",
            "narrator": "（選択肢）",
            "text": "つばめさんをくださいとお父さんにお願いしに来ました",
            "zh": "我是来请求爸爸把燕交给我的",
            "narrator_zh": "（选项）"
        },
        {
            "location": "55/ACT",
            "narrator": "",
            "text": "つばめさんをくださいとお父さんにお願いしに来ました",
            "zh": "我是来请求爸爸把燕交给我的",
            "narrator_zh": ""
        },
        {
            "location": "57/TALK",
            "narrator": "啓介",
            "text": "……なんだと！？",
            "zh": "……你说什么！？",
            "narrator_zh": "启介"
        },
        {
            "location": "58/TALK",
            "narrator": "啓介",
            "text": "どこの馬の骨かも\n分からんヤツに\nつばめをやるなど――",
            "zh": "把燕交给一个\n来路都不明的\n家伙——",
            "narrator_zh": "启介"
        },
        {
            "location": "60/TALK",
            "narrator": "つばめ",
            "text": "ちょっと！\nお父さんっ！！",
            "zh": "等一下！\n爸爸！！",
            "narrator_zh": "燕"
        },
        {
            "location": "66/TALK",
            "narrator": "啓介",
            "text": "つばめか。\nお前には関係無い。\n向こうへ行きなさい。",
            "zh": "燕啊。\n与你无关。\n到那边去。",
            "narrator_zh": "启介"
        },
        {
            "location": "67/TALK",
            "narrator": "つばめ",
            "text": "関係無くないよ！",
            "zh": "怎么会无关！",
            "narrator_zh": "燕"
        },
        {
            "location": "68/TALK",
            "narrator": "つばめ",
            "text": "なんでお父さんが\nわたしの心の中に\nいるわけ！？",
            "zh": "为什么爸爸\n会在我的心里\n啊！？",
            "narrator_zh": "燕"
        },
        {
            "location": "69/TALK",
            "narrator": "啓介",
            "text": "コイツに確かめたい\nことがあったからだ。",
            "zh": "因为我有事\n要向这家伙确认。",
            "narrator_zh": "启介"
        },
        {
            "location": "74/TALK",
            "narrator": "啓介",
            "text": "つばめを\nあの手この手で\n東京に誘い――",
            "zh": "用各种手段\n把燕引诱到\n东京——",
            "narrator_zh": "启介"
        },
        {
            "location": "75/TALK",
            "narrator": "啓介",
            "text": "それでも飽き足らず\n東京に住むよう仕組ん\nだのは貴様だろう！",
            "zh": "还不满足，安排她\n住在东京的，\n就是你吧！",
            "narrator_zh": "启介"
        },
        {
            "location": "78/TALK",
            "narrator": "つばめ",
            "text": "ちょっ！\nちょっと待ってよ！",
            "zh": "等！\n等一下呀！",
            "narrator_zh": "燕"
        },
        {
            "location": "80/TALK",
            "narrator": "啓介",
            "text": "かあぁぁっ！！",
            "zh": "喝啊啊啊！！",
            "narrator_zh": "启介"
        },
        {
            "location": "93/TALK",
            "narrator": "啓介",
            "text": "何のマネだ！",
            "zh": "搞什么名堂！",
            "narrator_zh": "启介"
        },
        {
            "location": "95/TALK",
            "narrator": "つばめ",
            "text": "勝手に\n攻撃しないでよ！",
            "zh": "不要擅自\n攻击呀！",
            "narrator_zh": "燕"
        },
        {
            "location": "96/SEL",
            "narrator": "（選択肢）",
            "text": "どうなってるの！？",
            "zh": "这是怎么回事！？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "97/ACT",
            "narrator": "",
            "text": "どうなってるの！？",
            "zh": "这是怎么回事！？",
            "narrator_zh": ""
        },
        {
            "location": "105/TALK",
            "narrator": "つばめ",
            "text": "ごめんなさい。",
            "zh": "对不起。",
            "narrator_zh": "燕"
        },
        {
            "location": "106/TALK",
            "narrator": "つばめ",
            "text": "なんか心の中で\nお父さんのイメージが\n暴走してるみたい。",
            "zh": "好像心里\n爸爸的形象\n失控了。",
            "narrator_zh": "燕"
        },
        {
            "location": "107/SEL",
            "narrator": "（選択肢）",
            "text": "イメージ？暴走？？",
            "zh": "形象？失控？？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "108/ACT",
            "narrator": "",
            "text": "イメージ？暴走？？",
            "zh": "形象？失控？？",
            "narrator_zh": ""
        },
        {
            "location": "110/TALK",
            "narrator": "つばめ",
            "text": "え、えっと！！",
            "zh": "那、那个！！",
            "narrator_zh": "燕"
        },
        {
            "location": "111/TALK",
            "narrator": "つばめ",
            "text": "後でちゃんと\n説明するから\nとにかく――",
            "zh": "之后我会好好\n解释的，\n总之——",
            "narrator_zh": "燕"
        },
        {
            "location": "112/TALK",
            "narrator": "つばめ",
            "text": "今はこの暴走しちゃっ\nてるお父さんを\n止めるの手伝って！",
            "zh": "现在先帮我\n制止这个失控的\n爸爸！",
            "narrator_zh": "燕"
        },
        {
            "location": "113/SEL",
            "narrator": "（選択肢）",
            "text": "えええっ！！",
            "zh": "诶诶诶！！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "114/ACT",
            "narrator": "",
            "text": "えええっ！！",
            "zh": "诶诶诶！！",
            "narrator_zh": ""
        },
        {
            "location": "121/TALK",
            "narrator": "つばめ",
            "text": "いくよっ！！",
            "zh": "上了！！",
            "narrator_zh": "燕"
        },
        {
            "location": "122/TALK",
            "narrator": "啓介",
            "text": "悪あがきしても\n無駄だ！！",
            "zh": "做无谓的挣扎\n也没用！！",
            "narrator_zh": "启介"
        },
        {
            "location": "124/TALK",
            "narrator": "啓介",
            "text": "出でよクラン！！\nこの不定な輩を\nたたき出せ！",
            "zh": "出来吧，库兰！！\n把这个来路不正的家伙\n打出去！",
            "narrator_zh": "启介"
        },
        {
            "location": "139/DIALOG",
            "narrator": "",
            "text": "<color=black><size=50><b>暴走する父を倒し、\nつばめのココロを落ち着かせよ！</b></size></color>\n\n\n\n本心では納得していない父を\n静岡に置いてきたまま\n東京に滞在しているつばめ。\n\n普段全く気にしていないつもりでも\n心の中では大波乱。\n\nつばめの心の中で暴れる父を倒し、\n気持ちを落ち着かせてあげよう。",
            "zh": "<color=black><size=50><b>打倒失控的父亲，\n让燕的心平静下来！</b></size></color>\n\n\n\n把心里并未接受的父亲\n留在静冈，\n燕自己留在了东京。\n\n她以为自己平时完全不在意，\n心里却是轩然大波。\n\n打倒在燕心里暴怒的父亲，\n让她的心情平静下来吧。",
            "narrator_zh": ""
        }
    ]
}
