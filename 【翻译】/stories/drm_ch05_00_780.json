            "narrator": "",
            "text": "そうじゃないけど",
            "zh": "也不是那样",
            "narrator_zh": ""
        },
        {
            "location": "171/SEL",
            "narrator": "",
            "text": "ちょっと相談してほしかったかも",
            "zh": "希望你能先跟我商量一下",
            "narrator_zh": ""
        },
        {
            "location": "172/SEL",
