    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "非公開でお願いします",
            "zh": "请不要公开",
            "narrator_zh": ""
        },
        {
            "location": "16/TALK",
            "narrator": "神楽",
            "text": "$handle$はさ？",
            "zh": "$handle$啊？",
            "narrator_zh": "神乐"
        },
        {
            "location": "17/TALK",
            "narrator": "神楽",
            "text": "私と一緒に\n緩やかに続いていく日常を\n選んでくれたでしょ。",
            "zh": "你选择了和我一起\n缓缓延续下去的\n日常对吧。",
            "narrator_zh": "神乐"
        },
        {
            "location": "18/TALK",
            "narrator": "神楽",
            "text": "私、それって実は\n奇跡なんだなって\n思ってる。",
            "zh": "其实我觉得\n那真的是个\n奇迹呢。",
            "narrator_zh": "神乐"
        },
        {
            "location": "19/SEL",
            "narrator": "",
            "text": "$me$も",
            "zh": "$me$也是",
            "narrator_zh": ""
        },
        {
            "location": "20/SEL",
            "narrator": "",
            "text": "そうかな～",
            "zh": "是吗～",
            "narrator_zh": ""
        },
        {
            "location": "21/SEL",
            "narrator": "",
            "text": "続けていこうよ",
            "zh": "继续下去吧",
            "narrator_zh": ""
        },
        {
            "location": "22/ACT",
            "narrator": "",
            "text": "$me$も",
            "zh": "$me$也是",
            "narrator_zh": ""
        },
        {
            "location": "23/TALK",
            "narrator": "神楽",
            "text": "やっぱりそう思う？",
            "zh": "你也这么想？",
            "narrator_zh": "神乐"
        },
        {
            "location": "24/ACT",
            "narrator": "",
            "text": "そうかな～",
            "zh": "是吗～",
            "narrator_zh": ""
        },
        {
            "location": "26/TALK",
            "narrator": "神楽",
            "text": "えー？",
            "zh": "诶——？",
            "narrator_zh": "神乐"
        },
        {
            "location": "27/TALK",
            "narrator": "神楽",
            "text": "当たり前すぎるって\n思ってる？",
            "zh": "你觉得太理所当然\n了吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "28/TALK",
            "narrator": "神楽",
            "text": "だったら一回\nリセットして……。",
            "zh": "那样的话就重置\n一次……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "29/TALK",
            "narrator": "神楽",
            "text": "ってウソウソ！\nそんなのやっぱりやだ！",
            "zh": "不不，骗你的！\n那种还是不要！",
            "narrator_zh": "神乐"
        },
        {
            "location": "30/TALK",
            "narrator": "神楽",
            "text": "もー！\n変なこと言わせないで！",
            "zh": "真是的！\n别让我说奇怪的话啦！",
            "narrator_zh": "神乐"
        },
        {
            "location": "31/ACT",
            "narrator": "",
            "text": "続けていこうよ",
            "zh": "继续下去吧",
            "narrator_zh": ""
        },
        {
            "location": "33/TALK",
            "narrator": "神楽",
            "text": "うん！",
            "zh": "嗯！",
            "narrator_zh": "神乐"
        },
        {
            "location": "34/TALK",
            "narrator": "神楽",
            "text": "そうしよう！",
            "zh": "就这么办！",
            "narrator_zh": "神乐"
        },
        {
            "location": "37/TALK",
            "narrator": "神楽",
            "text": "それでね……。",
            "zh": "然后呢……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "38/TALK",
            "narrator": "神楽",
            "text": "そんな日々に入る前に\nやっぱりけじめ的な\nことがしたいなって。",
            "zh": "在进入那样的日子之前，\n我还是想做个\n了断。",
            "narrator_zh": "神乐"
        },
        {
            "location": "39/SEL",
            "narrator": "",
            "text": "成人式かな？",
            "zh": "是成人礼吗？",
            "narrator_zh": ""
        },
        {
            "location": "40/SEL",
            "narrator": "",
            "text": "襲名披露？",
            "zh": "袭名仪式？",
            "narrator_zh": ""
        },
        {
            "location": "41/SEL",
            "narrator": "",
            "text": "なんでも付き合うよ",
            "zh": "什么都陪你",
            "narrator_zh": ""
        },
        {
            "location": "42/SEL",
            "narrator": "",
            "text": "期待していいのかな…",
            "zh": "可以期待吗……",
            "narrator_zh": ""
        },
        {
            "location": "43/ACT",
            "narrator": "",
            "text": "成人式かな？",
            "zh": "是成人礼吗？",
            "narrator_zh": ""
        },
        {
            "location": "44/TALK",
            "narrator": "神楽",
            "text": "なんでそうなるの……。",
            "zh": "为什么会那样呢……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "45/ACT",
            "narrator": "",
            "text": "襲名披露？",
            "zh": "袭名仪式？",
            "narrator_zh": ""
        },
        {
            "location": "47/TALK",
            "narrator": "神楽",
            "text": "二代目ぴょんこ参上！",
            "zh": "二代蹦子参上！",
            "narrator_zh": "神乐"
        },
        {
            "location": "48/TALK",
            "narrator": "神楽",
            "text": "って何させるの！？",
            "zh": "话说你要让我做什么！？",
            "narrator_zh": "神乐"
        },
        {
            "location": "49/ACT",
            "narrator": "",
            "text": "なんでも付き合うよ",
            "zh": "什么都陪你",
            "narrator_zh": ""
        },
        {
            "location": "50/TALK",
            "narrator": "神楽",
            "text": "うん。\nありがとう。",
            "zh": "嗯。\n谢谢。",
            "narrator_zh": "神乐"
        },
        {
            "location": "51/ACT",
            "narrator": "",
            "text": "期待していいのかな…",
            "zh": "可以期待吗……",
            "narrator_zh": ""
        },
        {
            "location": "52/TALK",
            "narrator": "神楽",
            "text": "多分ね？",
            "zh": "大概吧？",
            "narrator_zh": "神乐"
        },
        {
            "location": "55/TALK",
            "narrator": "神楽",
            "text": "えっと……。",
            "zh": "呃……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "56/TALK",
            "narrator": "神楽",
            "text": "えっとね？",
            "zh": "那个啊？",
            "narrator_zh": "神乐"
        },
        {
            "location": "57/TALK",
            "narrator": "神楽",
            "text": "その……。",
            "zh": "那个……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "58/TALK",
            "narrator": "神楽",
            "text": "あーどうしよう……。\nやっぱり照れる～！！！",
            "zh": "啊怎么办……。\n还是好害羞～！！！",
            "narrator_zh": "神乐"
        },
        {
            "location": "59/SEL",
            "narrator": "",
            "text": "頑張って！",
            "zh": "加油！",
            "narrator_zh": ""
        },
        {
            "location": "60/SEL",
            "narrator": "",
            "text": "レア神楽かわいい！",
            "zh": "稀有神乐好可爱！",
            "narrator_zh": ""
        },
        {
            "location": "61/SEL",
            "narrator": "",
            "text": "さっさと言って",
            "zh": "快说啦",
            "narrator_zh": ""
        },
        {
            "location": "62/SEL",
            "narrator": "",
            "text": "これは期待できる",
            "zh": "这个值得期待",
            "narrator_zh": ""
        },
        {
            "location": "63/SEL",
            "narrator": "",
            "text": "じゃあまた今度でも",
            "zh": "那就下次再说也行",
            "narrator_zh": ""
        },
        {
            "location": "64/ACT",
            "narrator": "",
            "text": "頑張って！",
            "zh": "加油！",
            "narrator_zh": ""
        },
        {
            "location": "65/TALK",
            "narrator": "神楽",
            "text": "えっあっ……。",
            "zh": "诶、啊……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "67/TALK",
            "narrator": "神楽",
            "text": "もー！\nがんばるし！",
            "zh": "真是的！\n我会加油的啦！",
            "narrator_zh": "神乐"
        },
        {
            "location": "68/ACT",
            "narrator": "",
            "text": "レア神楽かわいい！",
            "zh": "稀有神乐好可爱！",
            "narrator_zh": ""
        },
        {
            "location": "69/TALK",
            "narrator": "神楽",
            "text": "てへぺろ！",
            "zh": "吐舌！",
            "narrator_zh": "神乐"
        },
        {
            "location": "70/TALK",
            "narrator": "神楽",
            "text": "とかじゃなくてー！",
            "zh": "不是那个啦——！",
            "narrator_zh": "神乐"
        },
        {
            "location": "71/ACT",
            "narrator": "",
            "text": "さっさと言って",
            "zh": "快说啦",
            "narrator_zh": ""
        },
        {
            "location": "72/TALK",
            "narrator": "神楽",
            "text": "えっなんか……\n冷たいね……。",
            "zh": "诶总觉得……\n好冷淡啊……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "73/TALK",
            "narrator": "神楽",
            "text": "$handle$のバカ！\nバカー！",
            "zh": "$handle$你个笨蛋！\n笨蛋——！",
            "narrator_zh": "神乐"
        },
        {
            "location": "74/ACT",
            "narrator": "",
            "text": "これは期待できる",
            "zh": "这个值得期待",
            "narrator_zh": ""
        },
        {
            "location": "75/TALK",
            "narrator": "神楽",
            "text": "えっなんか上から目線？\n$handle$生意気！",
            "zh": "诶怎么一副居高临下的样子？\n$handle$好嚣张！",
            "narrator_zh": "神乐"
        },
        {
            "location": "76/ACT",
            "narrator": "",
            "text": "じゃあまた今度でも",
            "zh": "那就下次再说也行",
            "narrator_zh": ""
        },
        {
            "location": "78/TALK",
            "narrator": "神楽",
            "text": "何それ？\n気を遣ったつもり？",
            "zh": "什么啊那是？\n你以为是在体贴我吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "79/TALK",
            "narrator": "神楽",
            "text": "わかってないー！",
            "zh": "根本不懂嘛——！",
            "narrator_zh": "神乐"
        },
        {
            "location": "82/TALK",
            "narrator": "神楽",
            "text": "そのさ……。",
            "zh": "那个嘛……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "83/TALK",
            "narrator": "神楽",
            "text": "結婚式とか\nしたいなって……。",
            "zh": "我是想办个\n婚礼什么的……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "84/SEL",
            "narrator": "",
            "text": "$me$と！？",
            "zh": "跟$me$！？",
            "narrator_zh": ""
        },
        {
            "location": "85/SEL",
            "narrator": "",
            "text": "はい喜んで！",
            "zh": "好，我很乐意！",
            "narrator_zh": ""
        },
        {
            "location": "86/SEL",
            "narrator": "",
            "text": "やっとここまで来た……",
            "zh": "终于走到这里了……",
            "narrator_zh": ""
        },
        {
            "location": "87/SEL",
            "narrator": "",
            "text": "こちらこそよろしく",
            "zh": "我才要拜托你",
            "narrator_zh": ""
        },
        {
            "location": "88/SEL",
            "narrator": "",
            "text": "大事なところだよね",
            "zh": "这是很重要的地方呢",
            "narrator_zh": ""
        },
        {
            "location": "89/ACT",
            "narrator": "",
            "text": "$me$と！？",
            "zh": "跟$me$！？",
            "narrator_zh": ""
        },
        {
            "location": "90/TALK",
            "narrator": "神楽",
            "text": "他に誰がいるの？",
            "zh": "不然还有谁啊？",
            "narrator_zh": "神乐"
        },
        {
            "location": "91/ACT",
            "narrator": "",
            "text": "はい喜んで！",
            "zh": "好，我很乐意！",
            "narrator_zh": ""
        },
        {
            "location": "92/TALK",
            "narrator": "神楽",
            "text": "居酒屋みたいじゃない？",
            "zh": "听起来不像居酒屋一样吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "93/ACT",
            "narrator": "",
            "text": "やっとここまで来た……",
            "zh": "终于走到这里了……",
            "narrator_zh": ""
        },
        {
            "location": "94/TALK",
            "narrator": "神楽",
            "text": "やっとって言うかー…。",
            "zh": "与其说是终于——……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "95/ACT",
            "narrator": "",
            "text": "こちらこそよろしく",
            "zh": "我才要拜托你",
            "narrator_zh": ""
        },
        {
            "location": "96/TALK",
            "narrator": "神楽",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "97/TALK",
            "narrator": "神楽",
            "text": "はい。",
            "zh": "是。",
            "narrator_zh": "神乐"
        },
        {
            "location": "98/ACT",
            "narrator": "",
            "text": "大事なところだよね",
            "zh": "这是很重要的地方呢",
            "narrator_zh": ""
        },
        {
            "location": "99/TALK",
            "narrator": "神楽",
            "text": "うん。\nすごく大事なところ。",
            "zh": "嗯。\n是非常重要的地方。",
            "narrator_zh": "神乐"
        },
        {
            "location": "102/SEL",
            "narrator": "",
            "text": "やっぱりシャンパンタワー？",
            "zh": "果然是香槟塔？",
            "narrator_zh": ""
        },
        {
            "location": "103/SEL",
            "narrator": "",
            "text": "ゴンドラスモークだよね！",
            "zh": "是吊舱烟雾吧！",
            "narrator_zh": ""
        },
        {
            "location": "104/SEL",
            "narrator": "",
            "text": "象に乗って登場！",
            "zh": "骑着大象登场！",
            "narrator_zh": ""
        },
        {
            "location": "105/SEL",
            "narrator": "",
            "text": "スピーチ考えなきゃ……",
            "zh": "得准备演讲稿……",
            "narrator_zh": ""
        },
        {
            "location": "106/SEL",
            "narrator": "",
            "text": "希望とかある？",
            "zh": "你有什么期望吗？",
            "narrator_zh": ""
        },
        {
            "location": "107/ACT",
            "narrator": "",
            "text": "やっぱりシャンパンタワー？",
            "zh": "果然是香槟塔？",
            "narrator_zh": ""
        },
        {
            "location": "108/TALK",
            "narrator": "神楽",
            "text": "ホストクラブじゃ\nないんだから……。",
            "zh": "又不是在\n牛郎店啊……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "109/ACT",
            "narrator": "",
            "text": "ゴンドラスモークだよね！",
            "zh": "是吊舱烟雾吧！",
            "narrator_zh": ""
        },
        {
            "location": "110/TALK",
            "narrator": "神楽",
            "text": "本当にそんな式あるの？",
            "zh": "真有那种婚礼吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "111/ACT",
            "narrator": "",
            "text": "象に乗って登場！",
            "zh": "骑着大象登场！",
            "narrator_zh": ""
        },
        {
            "location": "112/TALK",
            "narrator": "神楽",
            "text": "バーチャルだったら\nありだけどー。",
            "zh": "要是虚拟的话\n倒也不是不行啦——。",
            "narrator_zh": "神乐"
        },
        {
            "location": "113/ACT",
            "narrator": "",
            "text": "スピーチ考えなきゃ……",
            "zh": "得准备演讲稿……",
            "narrator_zh": ""
        },
        {
            "location": "114/TALK",
            "narrator": "神楽",
            "text": "それはちょっと\n聞きたいかも……。",
            "zh": "那个我有点\n想听……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "115/ACT",
            "narrator": "",
            "text": "希望とかある？",
            "zh": "你有什么期望吗？",
            "narrator_zh": ""
        },
        {
            "location": "116/TALK",
            "narrator": "神楽",
            "text": "……聞いてくれる？",
            "zh": "……你愿意听我说吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "119/TALK",
            "narrator": "神楽",
            "text": "えっとね……。",
            "zh": "那个啊……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "120/TALK",
            "narrator": "神楽",
            "text": "私、プライベートでは\nあんまり派手なこと\nしたくないの。",
            "zh": "我在私人生活里\n不太想办什么\n太张扬的事。",
            "narrator_zh": "神乐"
        },
        {
            "location": "121/TALK",
            "narrator": "神楽",
            "text": "二人の気持ちが\n再確認できることが\n一番大事だし。",
            "zh": "能够再次确认\n彼此的心意\n才是最重要的。",
            "narrator_zh": "神乐"
        },
        {
            "location": "122/TALK",
            "narrator": "神楽",
            "text": "極々シンプルで\nいいと思ってる。",
            "zh": "我觉得越简单\n越好。",
            "narrator_zh": "神乐"
        },
        {
            "location": "123/SEL",
            "narrator": "",
            "text": "わかる",
            "zh": "我懂",
            "narrator_zh": ""
        },
        {
            "location": "124/SEL",
            "narrator": "",
            "text": "神楽がそう言うなら",
            "zh": "既然神乐这么说",
            "narrator_zh": ""
        },
        {
            "location": "125/SEL",
            "narrator": "",
            "text": "少しは盛り上げたい",
            "zh": "想稍微热闹一下",
            "narrator_zh": ""
        },
        {
            "location": "126/ACT",
            "narrator": "",
            "text": "わかる",
            "zh": "我懂",
            "narrator_zh": ""
        },
        {
            "location": "128/TALK",
            "narrator": "神楽",
            "text": "わかってくれる？",
            "zh": "你懂吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "129/ACT",
            "narrator": "",
            "text": "神楽がそう言うなら",
            "zh": "既然神乐这么说",
            "narrator_zh": ""
        },
        {
            "location": "130/TALK",
            "narrator": "神楽",
            "text": "$handle$は？",
            "zh": "$handle$呢？",
            "narrator_zh": "神乐"
        },
        {
            "location": "131/ACT",
            "narrator": "",
            "text": "少しは盛り上げたい",
            "zh": "想稍微热闹一下",
            "narrator_zh": ""
        },
        {
            "location": "132/TALK",
            "narrator": "神楽",
            "text": "……すごくじゃなくても\nいいでしょ？",
            "zh": "……不用特别热闹\n也可以吧？",
            "narrator_zh": "神乐"
        },
        {
            "location": "135/TALK",
            "narrator": "神楽",
            "text": "でね、考えてみた。",
            "zh": "然后呢，我想了想。",
            "narrator_zh": "神乐"
        },
        {
            "location": "136/TALK",
            "narrator": "神楽",
            "text": "シンプルだけど\n確実な約束ができるのは\nどこだろうって。",
            "zh": "简单但又能\n立下切实约定的地方\n究竟在哪里呢。",
            "narrator_zh": "神乐"
        },
        {
            "location": "137/SEL",
            "narrator": "",
            "text": "どこだった？",
            "zh": "是哪里来着？",
            "narrator_zh": ""
        },
        {
            "location": "138/SEL",
            "narrator": "",
            "text": "$me$の胸の中でしょ！",
            "zh": "是在$me$怀里吧！",
            "narrator_zh": ""
        },
        {
            "location": "139/SEL",
            "narrator": "",
            "text": "裁判所かな",
            "zh": "是法院吧",
            "narrator_zh": ""
        },
        {
            "location": "140/ACT",
            "narrator": "",
            "text": "どこだった？",
            "zh": "是哪里来着？",
            "narrator_zh": ""
        },
        {
            "location": "141/TALK",
            "narrator": "神楽",
            "text": "どこだと思う？",
            "zh": "你猜是哪里？",
            "narrator_zh": "神乐"
        },
        {
            "location": "142/ACT",
            "narrator": "",
            "text": "$me$の胸の中でしょ！",
            "zh": "是在$me$怀里吧！",
            "narrator_zh": ""
        },
        {
            "location": "143/TALK",
            "narrator": "神楽",
            "text": "上手いこと言った\nつもりなんでしょ！",
            "zh": "你还以为自己\n说得很漂亮吧！",
            "narrator_zh": "神乐"
        },
        {
            "location": "144/TALK",
            "narrator": "神楽",
            "text": "……もー……！",
            "zh": "……真是的……！",
            "narrator_zh": "神乐"
        },
        {
            "location": "145/ACT",
            "narrator": "",
            "text": "裁判所かな",
            "zh": "是法院吧",
            "narrator_zh": ""
        },
        {
            "location": "147/TALK",
            "narrator": "神楽",
            "text": "ないし！\nそれはないし！",
            "zh": "没有！\n那不可能有！",
            "narrator_zh": "神乐"
        },
        {
            "location": "150/TALK",
            "narrator": "神楽",
            "text": "……なんて。\n確実な約束なんて\n存在しないよね。",
            "zh": "……开玩笑的。\n切实的约定什么的\n根本不存在吧。",
            "narrator_zh": "神乐"
        },
        {
            "location": "151/SEL",
            "narrator": "",
            "text": "その話はもうやめよう",
            "zh": "那个话题就到此为止吧",
            "narrator_zh": ""
        },
        {
            "location": "152/SEL",
            "narrator": "",
            "text": "それでも意味はあるって結論でしょ",
            "zh": "结论就是还是有意义吧",
            "narrator_zh": ""
        },
        {
            "location": "153/SEL",
            "narrator": "",
            "text": "それでも神楽と約束したいよ",
            "zh": "可我还是想跟神乐约好",
            "narrator_zh": ""
        },
        {
            "location": "154/ACT",
            "narrator": "",
            "text": "その話はもうやめよう",
            "zh": "那个话题就到此为止吧",
            "narrator_zh": ""
        },
        {
            "location": "155/TALK",
            "narrator": "神楽",
            "text": "…うん。",
            "zh": "……嗯。",
            "narrator_zh": "神乐"
        },
        {
            "location": "156/ACT",
            "narrator": "",
            "text": "それでも意味はあるって結論でしょ",
            "zh": "结论就是还是有意义吧",
            "narrator_zh": ""
        },
        {
            "location": "157/TALK",
            "narrator": "神楽",
            "text": "だよね。",
            "zh": "是吧。",
            "narrator_zh": "神乐"
        },
        {
            "location": "158/ACT",
            "narrator": "",
            "text": "それでも神楽と約束したいよ",
            "zh": "可我还是想跟神乐约好",
            "narrator_zh": ""
        },
        {
            "location": "159/TALK",
            "narrator": "神楽",
            "text": "ありがとう。",
            "zh": "谢谢。",
            "narrator_zh": "神乐"
        },
        {
            "location": "162/TALK",
            "narrator": "神楽",
            "text": "約束の場所の\n話だったよね。",
            "zh": "刚才是在说\n约定地点的事对吧。",
            "narrator_zh": "神乐"
        },
        {
            "location": "163/TALK",
            "narrator": "神楽",
            "text": "ハネムーンを兼ねて\n江の島に行きたいなって\n思ってる。",
            "zh": "我想着干脆\n顺便去江之岛\n度个蜜月呢。",
            "narrator_zh": "神乐"
        },
        {
            "location": "164/TALK",
            "narrator": "神楽",
            "text": "どう？",
            "zh": "怎么样？",
            "narrator_zh": "神乐"
        },
        {
            "location": "165/SEL",
            "narrator": "",
            "text": "決まってたのか……",
            "zh": "原来是定好了的啊……",
            "narrator_zh": ""
        },
        {
            "location": "166/SEL",
            "narrator": "",
            "text": "なんでそのチョイス？",
            "zh": "为什么选这个？",
            "narrator_zh": ""
        },
        {
            "location": "167/SEL",
            "narrator": "",
            "text": "どこへなりとも、神楽様",
            "zh": "去哪儿都行，神乐大人",
            "narrator_zh": ""
        },
        {
            "location": "168/ACT",
            "narrator": "",
            "text": "決まってたのか……",
