            "text": "単に感想",
            "zh": "只是感想",
            "narrator_zh": ""
        },
        {
            "location": "173/ACT",
            "narrator": "",
            "text": "そうじゃないけど",
            "zh": "也不是那样",
            "narrator_zh": ""
        },
        {
            "location": "174/TALK",
            "narrator": "神楽",
            "text": "そうなの？",
            "zh": "是吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "175/ACT",
            "narrator": "",
            "text": "ちょっと相談してほしかったかも",
            "zh": "希望你能先跟我商量一下",
            "narrator_zh": ""
        },
        {
            "location": "176/TALK",
            "narrator": "神楽",
            "text": "今してるしー。",
            "zh": "我现在不就在商量嘛——。",
            "narrator_zh": "神乐"
        },
        {
            "location": "177/ACT",
            "narrator": "",
            "text": "単に感想",
            "zh": "只是感想",
            "narrator_zh": ""
        },
        {
            "location": "178/TALK",
            "narrator": "神楽",
            "text": "ふうん？",
