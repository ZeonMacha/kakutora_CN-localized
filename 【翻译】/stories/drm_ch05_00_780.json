        },
        {
            "location": "201/ACT",
            "narrator": "",
            "text": "よろしくー",
            "zh": "请多关照——",
            "narrator_zh": ""
        },
        {
            "location": "202/TALK",
            "narrator": "神楽",
            "text": "意外と適当？",
            "zh": "意外地挺敷衍啊？",
            "narrator_zh": "神乐"
        },
        {
            "location": "203/ACT",
            "narrator": "",
            "text": "キャラ作りすぎ…",
            "zh": "设定也太多了……",
            "narrator_zh": ""
        },
        {
            "location": "204/TALK",
            "narrator": "神楽",
            "text": "本当は好きなくせに！",
            "zh": "明明其实喜欢得要命！",
            "narrator_zh": "神乐"
        },
        {
            "location": "208/TALK",
            "narrator": "神楽",
            "text": "約束をした本人も\n探さなきゃわからなく\nなるような。",
            "zh": "连立下约定的本人\n不去找找看\n都会找不到的那种。",
            "narrator_zh": "神乐"
        },
        {
            "location": "209/TALK",
            "narrator": "神楽",
            "text": "でも重い約束が\nできる場所があるの。",
            "zh": "不过有能做\n沉重约定的地方。",
            "narrator_zh": "神乐"
        },
        {
            "location": "210/TALK",
            "narrator": "神楽",
            "text": "そういうのって\n$handle$と\n私らしいなって思って。",
            "zh": "那种事啊，\n我觉得很像\n$handle$和我。",
            "narrator_zh": "神乐"
        },
        {
            "location": "211/SEL",
            "narrator": "",
            "text": "わかる！",
            "zh": "我懂！",
            "narrator_zh": ""
        },
        {
            "location": "212/SEL",
            "narrator": "",
            "text": "じゃあ行ってみる",
            "zh": "那去看看吧",
            "narrator_zh": ""
        },
        {
            "location": "213/SEL",
            "narrator": "",
            "text": "もっと軽くてもいいよ？",
            "zh": "再轻松一点也行哦？",
            "narrator_zh": ""
        },
        {
            "location": "214/ACT",
            "narrator": "",
            "text": "わかる！",
            "zh": "我懂！",
            "narrator_zh": ""
        },
        {
            "location": "216/TALK",
            "narrator": "神楽",
            "text": "やっぱり？\nよかったー。",
            "zh": "果然吗？\n太好了——。",
            "narrator_zh": "神乐"
        },
        {
            "location": "217/ACT",
            "narrator": "",
            "text": "じゃあ行ってみる",
            "zh": "那去看看吧",
            "narrator_zh": ""
        },
        {
            "location": "218/TALK",
            "narrator": "神楽",
            "text": "前向きだね。\nそういうとこ好き。",
            "zh": "真积极呢。\n我就喜欢你这点。",
            "narrator_zh": "神乐"
        },
        {
            "location": "219/ACT",
            "narrator": "",
            "text": "もっと軽くてもいいよ？",
            "zh": "再轻松一点也行哦？",
            "narrator_zh": ""
        },
        {
            "location": "220/TALK",
            "narrator": "神楽",
            "text": "それじゃ安心できない。\n私ってそんな\n面倒なヒトだから…。",
            "zh": "那样就没法安心。\n因为我就是那么\n麻烦的人……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "223/TALK",
            "narrator": "神楽",
            "text": "一緒に来て\nくれるよね？",
            "zh": "你会跟我\n一起去的吧？",
            "narrator_zh": "神乐"
        },
        {
            "location": "224/SEL",
            "narrator": "",
            "text": "一応ね",
            "zh": "算是吧",
            "narrator_zh": ""
        },
        {
            "location": "225/SEL",
            "narrator": "",
            "text": "行くってば",
            "zh": "我都说会去了",
            "narrator_zh": ""
        },
        {
            "location": "226/SEL",
            "narrator": "",
            "text": "連れてって！",
            "zh": "带上我！",
            "narrator_zh": ""
        },
        {
            "location": "227/ACT",
            "narrator": "",
            "text": "一応ね",
            "zh": "算是吧",
            "narrator_zh": ""
        },
        {
            "location": "229/TALK",
            "narrator": "神楽",
            "text": "あっ偉そう！",
            "zh": "啊好嚣张！",
            "narrator_zh": "神乐"
        },
        {
            "location": "230/TALK",
            "narrator": "神楽",
            "text": "でもいいよ\n私にしか見せない\n顔だと思ってるから。",
