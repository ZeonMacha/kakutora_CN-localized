            "text": "ダメだった？",
            "zh": "不行吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "187/ACT",
            "narrator": "",
            "text": "いいところなのかー",
            "zh": "是个好地方啊——",
            "narrator_zh": ""
        },
        {
            "location": "188/TALK",
            "narrator": "神楽",
            "text": "いいところみたいよ？",
            "zh": "听说是个不错的地方哦？",
            "narrator_zh": "神乐"
        },
        {
            "location": "189/ACT",
            "narrator": "",
            "text": "よし任せた！",
            "zh": "好，交给你了！",
            "narrator_zh": ""
        },
        {
            "location": "191/TALK",
            "narrator": "神楽",
            "text": "やったー！",
            "zh": "太好了！",
            "narrator_zh": "神乐"
        },
        {
            "location": "193/ACT",
            "narrator": "",
            "text": "どこへなりとも、神楽様",
            "zh": "去哪儿都行，神乐大人",
            "narrator_zh": ""
        },
        {
            "location": "195/TALK",
            "narrator": "神楽",
            "text": "ふふふ。\n付いてらっしゃい？",
            "zh": "呵呵呵。\n跟上来吧？",
            "narrator_zh": "神乐"
        },
        {
            "location": "196/SEL",
            "narrator": "",
            "text": "ブヒー！",
            "zh": "噗嘻！",
            "narrator_zh": ""
        },
        {
            "location": "197/SEL",
            "narrator": "",
            "text": "よろしくー",
            "zh": "请多关照——",
            "narrator_zh": ""
        },
        {
            "location": "198/SEL",
            "narrator": "",
            "text": "キャラ作りすぎ…",
            "zh": "设定也太多了……",
            "narrator_zh": ""
        },
        {
            "location": "199/ACT",
            "narrator": "",
            "text": "ブヒー！",
            "zh": "噗嘻！",
            "narrator_zh": ""
        },
        {
            "location": "200/TALK",
            "narrator": "神楽",
            "text": "よしよし♪",
