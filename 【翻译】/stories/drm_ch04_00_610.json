{
 "dir": "dramatics/daydra/drm_ch04_00_610.js",
 "type": "Episode",
 "info": {
  "story_id": "4065",
  "cid": "miyabi",
  "title": "らぶとーく 第66話",
  "sub_title": "ヒロインのいるべき場所"
 },
 "entry": [
  {
   "location": "188/SCENARIO",
   "narrator": "",
   "text": "ヒロインのいるべき場所"
  },
  {
   "location": "206/TALK",
   "narrator": "みやび",
   "text": "…ふむ。",
   "zh": "……唔。",
   "narrator_zh": "雅"
  },
  {
   "location": "207/TALK",
   "narrator": "みやび",
   "text": "スマホは手軽で\n便利やけんど――"
  },
  {
   "location": "208/TALK",
   "narrator": "みやび",
   "text": "画面が小さいのが\n難点やねぇ。"
  },
  {
   "location": "209/TALK",
   "narrator": "みやび",
   "text": "タブレット忘れたのは\n痛手やな…。"
  },
  {
   "location": "212/TALK",
   "narrator": "みやび",
   "text": "…むっ！？\nこの記事は！！",
   "zh": "……嗯！？\n这条报道是！！",
   "narrator_zh": "雅"
  },
  {
   "location": "217/TALK",
   "narrator": "女子高校生Ａ",
   "text": "恋ヶ崎さん。\nちょっとお願いがあるん\nだけど。"
  },
  {
   "location": "223/TALK",
   "narrator": "みやび",
   "text": "…ん？",
   "zh": "……嗯？",
   "narrator_zh": "雅"
  },
  {
   "location": "226/TALK",
   "narrator": "みやび",
   "text": "何か用なが？"
  },
  {
   "location": "227/TALK",
   "narrator": "女子高校生Ａ",
   "text": "あのね、週末にバレー部の\n試合があるんだけど――"
  },
  {
   "location": "228/TALK",
   "narrator": "女子高校生Ａ",
   "text": "うちのクラスからも、\n種坂さんが出場するの。"
  },
  {
   "location": "230/TALK",
   "narrator": "みやび",
   "text": "…？\n誰やそれ？",
   "zh": "……？\n那是谁？",
   "narrator_zh": "雅"
  },
  {
   "location": "231/TALK",
   "narrator": "女子高校生Ａ",
   "text": "それで、クラスのみんなで\n応援しに行こう、って\nことになったんだけど――",
   "zh": "然后班上大家决定\n一起去\n加油，可是——",
   "narrator_zh": "女高中生A"
  },
  {
   "location": "232/TALK",
   "narrator": "女子高校生Ａ",
   "text": "恋ヶ崎さんも、\n良かったら一緒にどう？"
  },
  {
   "location": "234/TALK",
   "narrator": "みやび",
   "text": "トス。"
  },
  {
   "location": "235/TALK",
   "narrator": "みやび",
   "text": "じゃなくて、パスや。"
  },
  {
   "location": "238/TALK",
   "narrator": "みやび",
   "text": "うちはバレーボールとか、\nあんまし興味ないき。"
  },
  {
   "location": "239/TALK",
   "narrator": "女子高校生Ａ",
   "text": "そ、そう…。",
   "zh": "是、是吗……",
   "narrator_zh": "女高中生A"
  },
  {
   "location": "240/TALK",
   "narrator": "女子高校生Ａ",
   "text": "でも、終わったらみんなで\n食事に行こう、って話も\nしてて…。",
   "zh": "不过，大家还说\n结束之后一起去\n吃饭……",
   "narrator_zh": "女高中生A"
  },
  {
   "location": "241/TALK",
   "narrator": "みやび",
   "text": "騒がしいのは苦手やき、\nうちは遠慮しとくがよ。"
  },
  {
   "location": "242/TALK",
   "narrator": "女子高校生Ａ",
   "text": "そ、そっか…。\nちょっと残念…。",
   "zh": "这、这样啊……。\n有点遗憾……。",
   "narrator_zh": "女高中生A"
  },
  {
   "location": "246/TALK",
   "narrator": "みやび",
   "text": "…すまんけんど、\nスマホタイムやき。"
  },
  {
   "location": "248/TALK",
   "narrator": "女子高校生Ａ",
   "text": "あ、ごめんね。\nそれじゃ…。"
  },
  {
   "location": "252/TALK",
   "narrator": "みやび",
   "text": "…………。"
  },
  {
   "location": "253/TALK",
   "narrator": "みやび",
   "text": "いや、これでえい。\nうちはこれでえいがよ。"
  },
  {
   "location": "254/TALK",
   "narrator": "みやび",
   "text": "…………。"
  },
  {
   "location": "259/TALK",
   "narrator": "みやび",
   "text": "人付き合いを良くするために"
  },
  {
   "location": "260/TALK",
   "narrator": "みやび",
   "text": "己を殺して話を合わせる"
  },
  {
   "location": "261/TALK",
   "narrator": "みやび",
   "text": "うちもそうするべきか？"
  },
  {
   "location": "264/SEL",
   "narrator": "",
   "text": "断ったの気にしてる？",
   "zh": "你还在意拒绝了的事？",
   "narrator_zh": ""
  },
  {
   "location": "265/ACT",
   "narrator": "",
   "text": "断ったの気にしてる？",
   "zh": "你还在意拒绝了的事？",
   "narrator_zh": ""
  },
  {
   "location": "267/TALK",
   "narrator": "みやび",
   "text": "ちっくとな",
   "zh": "有点呢",
   "narrator_zh": "雅"
  },
  {
   "location": "268/TALK",
   "narrator": "みやび",
   "text": "一応クラスメイトからの誘いやし"
  },
  {
   "location": "269/TALK",
   "narrator": "みやび",
   "text": "クラスのほとんどが行くらしいし"
  },
  {
   "location": "270/TALK",
   "narrator": "みやび",
   "text": "うちも会話に乗って付いていくべきか？"
  },
  {
   "location": "271/TALK",
   "narrator": "みやび",
   "text": "微塵も興味ないが"
  },
  {
   "location": "273/SEL",
   "narrator": "",
   "text": "別にいいんじゃない",
   "zh": "也没什么不好吧",
   "narrator_zh": ""
  },
  {
   "location": "274/SEL",
   "narrator": "",
   "text": "そういうところも好きだけど",
   "zh": "这一点我也喜欢，不过",
   "narrator_zh": ""
  },
  {
   "location": "275/SEL",
   "narrator": "",
   "text": "擬態してみるのもいいかもね",
   "zh": "试着模仿一下也不错呢",
   "narrator_zh": ""
  },
  {
   "location": "276/ACT",
   "narrator": "",
   "text": "別にいいんじゃない",
   "zh": "也没什么不好吧",
   "narrator_zh": ""
  },
  {
   "location": "277/TALK",
   "narrator": "みやび",
   "text": "そう思う？",
   "zh": "你这么想？",
   "narrator_zh": "雅"
  },
  {
   "location": "278/TALK",
   "narrator": "みやび",
   "text": "ご機嫌取りで言うてるだけか？",
   "zh": "你只是嘴上哄我开心吧？",
   "narrator_zh": "雅"
  },
  {
   "location": "280/SEL",
   "narrator": "",
   "text": "自分にウソついてもバレる",
   "zh": "骗自己也会露馅的",
   "narrator_zh": ""
  },
  {
   "location": "281/ACT",
   "narrator": "",
   "text": "自分にウソついてもバレる",
   "zh": "骗自己也会露馅的",
   "narrator_zh": ""
  },
  {
   "location": "283/TALK",
   "narrator": "みやび",
   "text": "そうかもしれん",
   "zh": "说不准就是这样",
   "narrator_zh": "雅"
  },
  {
   "location": "284/TALK",
   "narrator": "みやび",
   "text": "無理しても仕方ない"
  },
  {
   "location": "285/TALK",
   "narrator": "みやび",
   "text": "うちにとっての普通と"
  },
  {
   "location": "286/TALK",
   "narrator": "みやび",
   "text": "世間一般の普通では尺度が違うき"
  },
  {
   "location": "287/TALK",
   "narrator": "みやび",
   "text": "規格が違うなら合うわけない"
  },
  {
   "location": "288/TALK",
   "narrator": "みやび",
   "text": "機械と一緒や"
  },
  {
   "location": "291/SEL",
   "narrator": "",
   "text": "それはそれで良いと思う",
   "zh": "我觉得那样也挺好",
   "narrator_zh": ""
  },
  {
   "location": "292/ACT",
   "narrator": "",
   "text": "それはそれで良いと思う",
   "zh": "我觉得那样也挺好",
   "narrator_zh": ""
  },
  {
   "location": "295/TALK",
   "narrator": "みやび",
   "text": "変わり者やね"
  },
  {
   "location": "296/TALK",
   "narrator": "みやび",
   "text": "ああ",
   "zh": "啊",
   "narrator_zh": "雅"
  },
  {
   "location": "297/TALK",
   "narrator": "みやび",
   "text": "これが類友",
   "zh": "这就是同类相吸",
   "narrator_zh": "雅"
  },
  {
   "location": "298/TALK",
   "narrator": "みやび",
   "text": "友！？"
  },
  {
   "location": "300/TALK",
   "narrator": "みやび",
   "text": "関係が後退した"
  },
  {
   "location": "302/SEL",
   "narrator": "",
   "text": "とにかく、今のままでいいと思う",
   "zh": "总之，我觉得现在这样就挺好",
   "narrator_zh": ""
  },
  {
   "location": "303/ACT",
   "narrator": "",
   "text": "とにかく、今のままでいいと思う",
   "zh": "总之，我觉得现在这样就挺好",
   "narrator_zh": ""
  },
  {
   "location": "305/TALK",
   "narrator": "みやび",
   "text": "そう思うが？",
   "zh": "你是那么想的？",
   "narrator_zh": "雅"
  },
  {
   "location": "306/TALK",
   "narrator": "みやび",
   "text": "まあ",
   "zh": "嗯",
   "narrator_zh": "雅"
  },
  {
   "location": "307/TALK",
   "narrator": "みやび",
   "text": "それならこのままでえいか",
   "zh": "那样就这样也行啵",
   "narrator_zh": "雅"
  },
  {
   "location": "308/TALK",
   "narrator": "みやび",
   "text": "そもそも",
   "zh": "说到底",
   "narrator_zh": "雅"
  },
  {
   "location": "309/TALK",
   "narrator": "みやび",
   "text": "変わるの絶対無理やろうし"
  },
  {
   "location": "310/TALK",
   "narrator": "みやび",
   "text": "今後も変化の無いうちをよろしく"
  },
  {
   "location": "311/ACT",
   "narrator": "",
   "text": "そういうところも好きだけど",
   "zh": "这一点我也喜欢，不过",
   "narrator_zh": ""
  },
  {
   "location": "312/TALK",
   "narrator": "みやび",
   "text": "うちが言うのもあれやが"
  },
  {
   "location": "313/TALK",
   "narrator": "みやび",
   "text": "変わり者め"
  },
  {
   "location": "314/TALK",
   "narrator": "みやび",
   "text": "趣味悪いとも言える"
  },
  {
   "location": "315/TALK",
   "narrator": "みやび",
   "text": "あ",
   "zh": "啊",
   "narrator_zh": "雅"
  },
  {
   "location": "316/TALK",
   "narrator": "みやび",
   "text": "だから気が合うのか",
   "zh": "所以才会合得来吧",
   "narrator_zh": "雅"
  },
  {
   "location": "318/TALK",
   "narrator": "みやび",
   "text": "納得！"
  },
  {
   "location": "320/SEL",
   "narrator": "",
   "text": "似たもの同士、イエーッ！",
   "zh": "同类之间，耶！",
   "narrator_zh": ""
  },
  {
   "location": "321/ACT",
   "narrator": "",
   "text": "似たもの同士、イエーッ！",
   "zh": "同类之间，耶！",
   "narrator_zh": ""
  },
  {
   "location": "323/TALK",
   "narrator": "みやび",
   "text": "ハイテンションやね"
  },
  {
   "location": "324/TALK",
   "narrator": "みやび",
   "text": "と",
   "zh": "那个",
   "narrator_zh": "雅"
  },
  {
   "location": "325/TALK",
   "narrator": "みやび",
   "text": "乗らずに傍観"
  },
  {
   "location": "326/TALK",
   "narrator": "みやび",
   "text": "世間一般の普通と尺度が違うな"
  },
  {
   "location": "327/TALK",
   "narrator": "みやび",
   "text": "マイノリティーコンビ"
  },
  {
   "location": "329/SEL",
   "narrator": "",
   "text": "それはそれで良いと思う",
   "zh": "我觉得那样也挺好",
   "narrator_zh": ""
  },
  {
   "location": "330/ACT",
   "narrator": "",
   "text": "それはそれで良いと思う",
   "zh": "我觉得那样也挺好",
   "narrator_zh": ""
  },
  {
   "location": "332/TALK",
   "narrator": "みやび",
   "text": "そうやね",
   "zh": "是这样咯",
   "narrator_zh": "雅"
  },
  {
   "location": "333/TALK",
   "narrator": "みやび",
   "text": "少なくとも"
  },
  {
   "location": "334/TALK",
   "narrator": "みやび",
   "text": "独りぼっちじゃないし"
  },
  {
   "location": "337/TALK",
   "narrator": "みやび",
   "text": "うむ",
   "zh": "嗯",
   "narrator_zh": "雅"
  },
  {
   "location": "339/TALK",
   "narrator": "みやび",
   "text": "問題なし！！"
  },
  {
   "location": "340/ACT",
   "narrator": "",
   "text": "擬態してみるのもいいかもね",
   "zh": "试着模仿一下也不错呢",
   "narrator_zh": ""
  },
  {
   "location": "341/TALK",
   "narrator": "みやび",
   "text": "擬態し近づき"
  },
  {
   "location": "342/TALK",
   "narrator": "みやび",
   "text": "食いつくす！"
  },
  {
   "location": "343/TALK",
   "narrator": "みやび",
   "text": "内部からクラスを崩壊へ！"
  },
  {
   "location": "344/TALK",
   "narrator": "みやび",
   "text": "なんてことはせんが",
   "zh": "我也不会做什么嘛",
   "narrator_zh": "雅"
  },
  {
   "location": "345/TALK",
   "narrator": "みやび",
   "text": "面白くはなさそうやね"
  },
  {
   "location": "347/SEL",
   "narrator": "",
   "text": "ストレス溜まるだけ",
   "zh": "只会积攒压力",
   "narrator_zh": ""
  },
  {
   "location": "348/ACT",
   "narrator": "",
   "text": "ストレス溜まるだけ",
   "zh": "只会积攒压力",
   "narrator_zh": ""
  },
  {
   "location": "350/TALK",
   "narrator": "みやび",
   "text": "胃と精神"
  },
  {
   "location": "351/TALK",
   "narrator": "みやび",
   "text": "どっちを先に壊すかのチキンレース",
   "zh": "比谁先弄坏的胆小鬼游戏嘛",
   "narrator_zh": "雅"
  },
  {
   "location": "352/TALK",
   "narrator": "みやび",
   "text": "世間一般の普通と尺度が違うと"
  },
  {
   "location": "354/TALK",
   "narrator": "みやび",
   "text": "まっこと疲れる"
  },
  {
   "location": "357/TALK",
   "narrator": "みやび",
   "text": "変わるべきか？"
  },
  {
   "location": "359/SEL",
   "narrator": "",
   "text": "やっぱり今のままが一番",
   "zh": "果然维持现状最好",
   "narrator_zh": ""
  },
  {
   "location": "360/ACT",
   "narrator": "",
   "text": "やっぱり今のままが一番",
   "zh": "果然维持现状最好",
   "narrator_zh": ""
  },
  {
   "location": "362/TALK",
   "narrator": "みやび",
   "text": "そうか",
   "zh": "这样哦",
   "narrator_zh": "雅"
  },
  {
   "location": "364/TALK",
   "narrator": "みやび",
   "text": "そう言うてくれる人間がいるゆうんは",
   "zh": "能有人对我说这种话咯",
   "narrator_zh": "雅"
  },
  {
   "location": "365/TALK",
   "narrator": "みやび",
   "text": "嬉しいもんやね"
  },
  {
   "location": "368/TALK",
   "narrator": "みやび",
   "text": "何となくな！"
  },
  {
   "location": "197/DIALOG",
   "narrator": "Dialog_EventData",
   "text": "<color=green>某月某日　 1:55 PM</color>\nとある平日、付属学園高等部みやびの教室にて"
  }
 ]
}
