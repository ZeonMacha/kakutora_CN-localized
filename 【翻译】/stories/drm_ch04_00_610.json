{
    "dir": "dramatics/daydra/drm_ch04_00_610.js",
    "type": "Episode",
    "info": {
        "story_id": "4065",
        "cid": "miyabi",
        "title": "らぶとーく 第66話",
        "sub_title": "ヒロインのいるべき場所",
        "title_zh": "恋爱漫谈 第66话",
        "sub_title_zh": "女主角应有的位置"
    },
    "entry": [
        {
            "location": "188/SCENARIO",
            "narrator": "",
            "text": "ヒロインのいるべき場所",
            "zh": "女主角应有的位置",
            "narrator_zh": ""
        },
        {
            "location": "206/TALK",
            "narrator": "みやび",
            "text": "…ふむ。",
            "zh": "……唔。",
            "narrator_zh": "雅"
        },
        {
            "location": "207/TALK",
            "narrator": "みやび",
            "text": "スマホは手軽で\n便利やけんど――",
            "zh": "手机虽然轻巧\n好用，但是——",
            "narrator_zh": "雅"
        },
        {
            "location": "208/TALK",
            "narrator": "みやび",
            "text": "画面が小さいのが\n難点やねぇ。",
            "zh": "屏幕小这一点\n是个缺点咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "209/TALK",
            "narrator": "みやび",
            "text": "タブレット忘れたのは\n痛手やな…。",
            "zh": "忘带平板电脑\n真是惨痛啊……。",
            "narrator_zh": "雅"
        },
        {
            "location": "212/TALK",
            "narrator": "みやび",
            "text": "…むっ！？\nこの記事は！！",
            "zh": "……嗯！？\n这条报道是！！",
            "narrator_zh": "雅"
        },
        {
            "location": "217/TALK",
            "narrator": "女子高校生Ａ",
            "text": "恋ヶ崎さん。\nちょっとお願いがあるん\nだけど。",
            "zh": "恋之崎同学。\n我有件事\n想拜托你。",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "223/TALK",
            "narrator": "みやび",
            "text": "…ん？",
            "zh": "……嗯？",
            "narrator_zh": "雅"
        },
        {
            "location": "226/TALK",
            "narrator": "みやび",
            "text": "何か用なが？",
            "zh": "有什么事咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "227/TALK",
            "narrator": "女子高校生Ａ",
            "text": "あのね、週末にバレー部の\n試合があるんだけど――",
            "zh": "那个，周末排球部\n有一场比赛——",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "228/TALK",
            "narrator": "女子高校生Ａ",
            "text": "うちのクラスからも、\n種坂さんが出場するの。",
            "zh": "我们班也有\n种坂同学出场哦。",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "230/TALK",
            "narrator": "みやび",
            "text": "…？\n誰やそれ？",
            "zh": "……？\n那是谁？",
            "narrator_zh": "雅"
        },
        {
            "location": "231/TALK",
            "narrator": "女子高校生Ａ",
            "text": "それで、クラスのみんなで\n応援しに行こう、って\nことになったんだけど――",
            "zh": "然后班上大家决定\n一起去\n加油，可是——",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "232/TALK",
            "narrator": "女子高校生Ａ",
            "text": "恋ヶ崎さんも、\n良かったら一緒にどう？",
            "zh": "恋之崎同学\n要是方便，一起去怎么样？",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "234/TALK",
            "narrator": "みやび",
            "text": "トス。",
            "zh": "托球。",
            "narrator_zh": "雅"
        },
        {
            "location": "235/TALK",
            "narrator": "みやび",
            "text": "じゃなくて、パスや。",
            "zh": "不对，是传球。",
            "narrator_zh": "雅"
        },
        {
            "location": "238/TALK",
            "narrator": "みやび",
            "text": "うちはバレーボールとか、\nあんまし興味ないき。",
            "zh": "排球什么的，\n我没多大兴趣啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "239/TALK",
            "narrator": "女子高校生Ａ",
            "text": "そ、そう…。",
            "zh": "是、是吗……",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "240/TALK",
            "narrator": "女子高校生Ａ",
            "text": "でも、終わったらみんなで\n食事に行こう、って話も\nしてて…。",
            "zh": "不过，大家还说\n结束之后一起去\n吃饭……",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "241/TALK",
            "narrator": "みやび",
            "text": "騒がしいのは苦手やき、\nうちは遠慮しとくがよ。",
            "zh": "吵吵闹闹的场合我受不了，\n我还是免了啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "242/TALK",
            "narrator": "女子高校生Ａ",
            "text": "そ、そっか…。\nちょっと残念…。",
            "zh": "这、这样啊……。\n有点遗憾……。",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "246/TALK",
            "narrator": "みやび",
            "text": "…すまんけんど、\nスマホタイムやき。",
            "zh": "……没好意思，不过\n现在是手机时间啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "248/TALK",
            "narrator": "女子高校生Ａ",
            "text": "あ、ごめんね。\nそれじゃ…。",
            "zh": "啊，抱歉哦。\n那就……。",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "252/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "253/TALK",
            "narrator": "みやび",
            "text": "いや、これでえい。\nうちはこれでえいがよ。",
            "zh": "不，这样就得了。\n我这样就得了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "254/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "259/TALK",
            "narrator": "みやび",
            "text": "人付き合いを良くするために",
            "zh": "为了搞好人际关系",
            "narrator_zh": "雅"
        },
        {
            "location": "260/TALK",
            "narrator": "みやび",
            "text": "己を殺して話を合わせる",
            "zh": "压抑自己迎合别人",
            "narrator_zh": "雅"
        },
        {
            "location": "261/TALK",
            "narrator": "みやび",
            "text": "うちもそうするべきか？",
            "zh": "我也该那么做咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "264/SEL",
            "narrator": "",
            "text": "断ったの気にしてる？",
            "zh": "你还在意拒绝了的事？",
            "narrator_zh": ""
        },
        {
            "location": "265/ACT",
            "narrator": "",
            "text": "断ったの気にしてる？",
            "zh": "你还在意拒绝了的事？",
            "narrator_zh": ""
        },
        {
            "location": "267/TALK",
            "narrator": "みやび",
            "text": "ちっくとな",
            "zh": "有点呢",
            "narrator_zh": "雅"
        },
        {
            "location": "268/TALK",
            "narrator": "みやび",
            "text": "一応クラスメイトからの誘いやし",
            "zh": "毕竟也是同班同学的邀请嘛",
            "narrator_zh": "雅"
        },
        {
            "location": "269/TALK",
            "narrator": "みやび",
            "text": "クラスのほとんどが行くらしいし",
            "zh": "何况听说班里大多数人都去",
            "narrator_zh": "雅"
        },
        {
            "location": "270/TALK",
            "narrator": "みやび",
            "text": "うちも会話に乗って付いていくべきか？",
            "zh": "我也该搭上话跟去凑热闹咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "271/TALK",
            "narrator": "みやび",
            "text": "微塵も興味ないが",
            "zh": "尽管我一点兴趣都没有",
            "narrator_zh": "雅"
        },
        {
            "location": "273/SEL",
            "narrator": "",
            "text": "別にいいんじゃない",
            "zh": "也没什么不好吧",
            "narrator_zh": ""
        },
        {
            "location": "274/SEL",
            "narrator": "",
            "text": "そういうところも好きだけど",
            "zh": "这一点我也喜欢，不过",
            "narrator_zh": ""
        },
        {
            "location": "275/SEL",
            "narrator": "",
            "text": "擬態してみるのもいいかもね",
            "zh": "试着模仿一下也不错呢",
            "narrator_zh": ""
        },
        {
            "location": "276/ACT",
            "narrator": "",
            "text": "別にいいんじゃない",
            "zh": "也没什么不好吧",
            "narrator_zh": ""
        },
        {
            "location": "277/TALK",
            "narrator": "みやび",
            "text": "そう思う？",
            "zh": "你这么想？",
            "narrator_zh": "雅"
        },
        {
            "location": "278/TALK",
            "narrator": "みやび",
            "text": "ご機嫌取りで言うてるだけか？",
            "zh": "你只是嘴上哄我开心吧？",
            "narrator_zh": "雅"
        },
        {
            "location": "280/SEL",
            "narrator": "",
            "text": "自分にウソついてもバレる",
            "zh": "骗自己也会露馅的",
            "narrator_zh": ""
        },
        {
            "location": "281/ACT",
            "narrator": "",
            "text": "自分にウソついてもバレる",
            "zh": "骗自己也会露馅的",
            "narrator_zh": ""
        },
        {
            "location": "283/TALK",
            "narrator": "みやび",
            "text": "そうかもしれん",
            "zh": "说不准就是这样",
            "narrator_zh": "雅"
        },
        {
            "location": "284/TALK",
            "narrator": "みやび",
            "text": "無理しても仕方ない",
            "zh": "勉强自己也没用",
            "narrator_zh": "雅"
        },
        {
            "location": "285/TALK",
            "narrator": "みやび",
            "text": "うちにとっての普通と",
            "zh": "对我来说的普通",
            "narrator_zh": "雅"
        },
        {
            "location": "286/TALK",
            "narrator": "みやび",
            "text": "世間一般の普通では尺度が違うき",
            "zh": "和世人一般的普通尺度就不一样啵",
            "narrator_zh": "雅"
        },
        {
            "location": "287/TALK",
            "narrator": "みやび",
            "text": "規格が違うなら合うわけない",
            "zh": "规格不一样就不可能合得上",
            "narrator_zh": "雅"
        },
        {
            "location": "288/TALK",
            "narrator": "みやび",
            "text": "機械と一緒や",
            "zh": "跟机器是一回事",
            "narrator_zh": "雅"
        },
        {
            "location": "291/SEL",
            "narrator": "",
            "text": "それはそれで良いと思う",
            "zh": "我觉得那样也挺好",
            "narrator_zh": ""
        },
        {
            "location": "292/ACT",
            "narrator": "",
            "text": "それはそれで良いと思う",
            "zh": "我觉得那样也挺好",
            "narrator_zh": ""
        },
        {
            "location": "295/TALK",
            "narrator": "みやび",
            "text": "変わり者やね",
            "zh": "你可真是个怪人咯",
            "narrator_zh": "雅"
        },
        {
            "location": "296/TALK",
            "narrator": "みやび",
            "text": "ああ",
            "zh": "啊",
            "narrator_zh": "雅"
        },
        {
            "location": "297/TALK",
            "narrator": "みやび",
            "text": "これが類友",
            "zh": "这就是所谓的「类友」",
            "narrator_zh": "雅"
        },
        {
            "location": "298/TALK",
            "narrator": "みやび",
            "text": "友！？",
            "zh": "友！？",
            "narrator_zh": "雅"
        },
        {
            "location": "300/TALK",
            "narrator": "みやび",
            "text": "関係が後退した",
            "zh": "关系反而倒退了",
            "narrator_zh": "雅"
        },
        {
            "location": "302/SEL",
            "narrator": "",
            "text": "とにかく、今のままでいいと思う",
            "zh": "总之，我觉得现在这样就挺好",
            "narrator_zh": ""
        },
        {
            "location": "303/ACT",
            "narrator": "",
            "text": "とにかく、今のままでいいと思う",
            "zh": "总之，我觉得现在这样就挺好",
            "narrator_zh": ""
        },
        {
            "location": "305/TALK",
            "narrator": "みやび",
            "text": "そう思うが？",
            "zh": "你是那么想的？",
            "narrator_zh": "雅"
        },
        {
            "location": "306/TALK",
            "narrator": "みやび",
            "text": "まあ",
            "zh": "嗯",
            "narrator_zh": "雅"
        },
        {
            "location": "307/TALK",
            "narrator": "みやび",
            "text": "それならこのままでえいか",
            "zh": "那样就这样也行啵",
            "narrator_zh": "雅"
        },
        {
            "location": "308/TALK",
            "narrator": "みやび",
            "text": "そもそも",
            "zh": "说到底",
            "narrator_zh": "雅"
        },
        {
            "location": "309/TALK",
            "narrator": "みやび",
            "text": "変わるの絶対無理やろうし",
            "zh": "反正要改也绝对改不了嘛",
            "narrator_zh": "雅"
        },
        {
            "location": "310/TALK",
            "narrator": "みやび",
            "text": "今後も変化の無いうちをよろしく",
            "zh": "往后也请多关照这个不会变的我",
            "narrator_zh": "雅"
        },
        {
            "location": "311/ACT",
            "narrator": "",
            "text": "そういうところも好きだけど",
            "zh": "这一点我也喜欢，不过",
            "narrator_zh": ""
        },
        {
            "location": "312/TALK",
            "narrator": "みやび",
            "text": "うちが言うのもあれやが",
            "zh": "这话由我自己说也有点那个",
            "narrator_zh": "雅"
        },
        {
            "location": "313/TALK",
            "narrator": "みやび",
            "text": "変わり者め",
            "zh": "你这个怪家伙",
            "narrator_zh": "雅"
        },
        {
            "location": "314/TALK",
            "narrator": "みやび",
            "text": "趣味悪いとも言える",
            "zh": "也可以说是品味恶劣",
            "narrator_zh": "雅"
        },
        {
            "location": "315/TALK",
            "narrator": "みやび",
            "text": "あ",
            "zh": "啊",
            "narrator_zh": "雅"
        },
        {
            "location": "316/TALK",
            "narrator": "みやび",
            "text": "だから気が合うのか",
            "zh": "所以才会合得来吧",
            "narrator_zh": "雅"
        },
        {
            "location": "318/TALK",
            "narrator": "みやび",
            "text": "納得！",
            "zh": "服了！",
            "narrator_zh": "雅"
        },
        {
            "location": "320/SEL",
            "narrator": "",
            "text": "似たもの同士、イエーッ！",
            "zh": "同类之间，耶！",
            "narrator_zh": ""
        },
        {
            "location": "321/ACT",
            "narrator": "",
            "text": "似たもの同士、イエーッ！",
            "zh": "同类之间，耶！",
            "narrator_zh": ""
        },
        {
            "location": "323/TALK",
            "narrator": "みやび",
            "text": "ハイテンションやね",
            "zh": "情绪可真高涨咯",
            "narrator_zh": "雅"
        },
        {
            "location": "324/TALK",
            "narrator": "みやび",
            "text": "と",
            "zh": "那个",
            "narrator_zh": "雅"
        },
        {
            "location": "325/TALK",
            "narrator": "みやび",
            "text": "乗らずに傍観",
            "zh": "不掺和，只管旁观",
            "narrator_zh": "雅"
        },
        {
            "location": "326/TALK",
            "narrator": "みやび",
            "text": "世間一般の普通と尺度が違うな",
            "zh": "跟一般世人的普通尺度不一样啊",
            "narrator_zh": "雅"
        },
        {
            "location": "327/TALK",
            "narrator": "みやび",
            "text": "マイノリティーコンビ",
            "zh": "少数派组合",
            "narrator_zh": "雅"
        },
        {
            "location": "329/SEL",
            "narrator": "",
            "text": "それはそれで良いと思う",
            "zh": "我觉得那样也挺好",
            "narrator_zh": ""
        },
        {
            "location": "330/ACT",
            "narrator": "",
            "text": "それはそれで良いと思う",
            "zh": "我觉得那样也挺好",
            "narrator_zh": ""
        },
        {
            "location": "332/TALK",
            "narrator": "みやび",
            "text": "そうやね",
            "zh": "是这样咯",
            "narrator_zh": "雅"
        },
        {
            "location": "333/TALK",
            "narrator": "みやび",
            "text": "少なくとも",
            "zh": "至少",
            "narrator_zh": "雅"
        },
        {
            "location": "334/TALK",
            "narrator": "みやび",
            "text": "独りぼっちじゃないし",
            "zh": "不是孤零零一个人嘛",
            "narrator_zh": "雅"
        },
        {
            "location": "337/TALK",
            "narrator": "みやび",
            "text": "うむ",
            "zh": "嗯",
            "narrator_zh": "雅"
        },
        {
            "location": "339/TALK",
            "narrator": "みやび",
            "text": "問題なし！！",
            "zh": "没问题！！",
            "narrator_zh": "雅"
        },
        {
            "location": "340/ACT",
            "narrator": "",
            "text": "擬態してみるのもいいかもね",
            "zh": "试着模仿一下也不错呢",
            "narrator_zh": ""
        },
        {
            "location": "341/TALK",
            "narrator": "みやび",
            "text": "擬態し近づき",
            "zh": "拟态接近",
            "narrator_zh": "雅"
        },
        {
            "location": "342/TALK",
            "narrator": "みやび",
            "text": "食いつくす！",
            "zh": "咬住不放，啃个精光！",
            "narrator_zh": "雅"
        },
        {
            "location": "343/TALK",
            "narrator": "みやび",
            "text": "内部からクラスを崩壊へ！",
            "zh": "从内部让班级崩坏！",
            "narrator_zh": "雅"
        },
        {
            "location": "344/TALK",
            "narrator": "みやび",
            "text": "なんてことはせんが",
            "zh": "我也不会做什么嘛",
            "narrator_zh": "雅"
        },
        {
            "location": "345/TALK",
            "narrator": "みやび",
            "text": "面白くはなさそうやね",
            "zh": "看来也不会有多有趣咯",
            "narrator_zh": "雅"
        },
        {
            "location": "347/SEL",
            "narrator": "",
            "text": "ストレス溜まるだけ",
            "zh": "只会积攒压力",
            "narrator_zh": ""
        },
        {
            "location": "348/ACT",
            "narrator": "",
            "text": "ストレス溜まるだけ",
            "zh": "只会积攒压力",
            "narrator_zh": ""
        },
