            "narrator_zh": "燕"
        },
        {
            "location": "144/TALK",
            "narrator": "つばめ",
            "text": "ひとつ大人になれたねヽ(〃´∀`〃)ﾉ",
            "zh": "又往大人迈进了一步呢ヽ(〃´∀`〃)ﾉ",
            "narrator_zh": "燕"
        },
        {
            "location": "145/ACT",
            "narrator": "",
            "text": "お酒飲んだの？",
            "zh": "你喝酒了？",
            "narrator_zh": ""
        },
        {
            "location": "148/TALK",
            "narrator": "つばめ",
            "text": "違うょ",
