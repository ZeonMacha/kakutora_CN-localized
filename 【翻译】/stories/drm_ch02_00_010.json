{
    "dir": "dramatics/daydra/drm_ch02_00_010.js",
    "type": "Episode",
    "info": {
        "story_id": "2001",
        "cid": "ayami",
        "title": "らぶとーく 第01話",
        "sub_title": "おねえさまとお茶会を",
        "title_zh": "恋爱漫谈 第01话",
        "sub_title_zh": "和姐姐大人的茶会"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "おねえさまとお茶会を",
            "zh": "和姐姐大人的茶会",
            "narrator_zh": ""
        },
        {
            "location": "23/TALK",
            "narrator": "千羽鶴",
            "text": "まずはおめでとう。",
            "zh": "先恭喜你。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "24/TALK",
            "narrator": "千羽鶴",
            "text": "貴方が今ここにいると\nいうことは、彼女との\n関係の開始を意味する。",
            "zh": "你现在在这里，\n就意味着，和她的\n关系开始了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "26/SEL",
            "narrator": "",
            "text": "関係の開始って、つまり…",
            "zh": "关系开始，也就是说……",
            "narrator_zh": ""
        },
        {
            "location": "27/ACT",
            "narrator": "",
            "text": "関係の開始って、つまり…",
            "zh": "关系开始，也就是说……",
            "narrator_zh": ""
        },
        {
            "location": "30/TALK",
            "narrator": "千羽鶴",
            "text": "そう。",
            "zh": "是的。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "31/TALK",
            "narrator": "千羽鶴",
            "text": "今この瞬間から、貴方と\n彼女は、真のパートナー\nとして歩み始める。",
            "zh": "从这一刻起，你和\n她，要作为真正的伙伴\n一起走下去。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "32/TALK",
            "narrator": "千羽鶴",
            "text": "その結果としては、\n恋人になったり、結婚\nしたりするかもしれない。",
            "zh": "结果也许是，\n成为恋人，\n或者结婚。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "33/TALK",
            "narrator": "千羽鶴",
            "text": "もちろんそれは、\nあくまで可能性でしか\nないけれども。",
            "zh": "当然，\n那也只是\n可能性而已。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "34/TALK",
            "narrator": "千羽鶴",
            "text": "１つだけ言えることは、\n全ては貴方の行動次第\nということ。",
            "zh": "只有一点能说，\n一切都看你\n怎么做。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "35/TALK",
            "narrator": "千羽鶴",
            "text": "何にしても、今後\n貴方と彼女の関係進展は、\n全てここで行われる。",
            "zh": "总之，往后\n你和她的关系进展，\n全都会在这里发生。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "36/TALK",
            "narrator": "千羽鶴",
            "text": "一見貴方に関係無いような\nお話が繰り広げられる事も\nあるけど、全部関係ある。",
            "zh": "看上去和你无关的\n故事，有时也会展开。\n但全部都有关系。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "37/TALK",
            "narrator": "千羽鶴",
            "text": "だから、彼女を大切に\n想うなら、ここでの物語は\n決して軽視しないよう。",
            "zh": "所以，要是珍惜她，\n这里的故事，\n千万别看轻。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "38/SEL",
            "narrator": "",
            "text": "これでもうパートナーは決まっちゃったの？",
            "zh": "这样伙伴就已经定下了吗？",
            "narrator_zh": ""
        },
        {
            "location": "39/ACT",
            "narrator": "",
            "text": "これでもうパートナーは決まっちゃったの？",
            "zh": "这样伙伴就已经定下了吗？",
            "narrator_zh": ""
        },
        {
            "location": "41/TALK",
            "narrator": "千羽鶴",
            "text": "まさか。\nまだ始まりに過ぎない。",
            "zh": "怎么会。\n这才刚开始。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "42/TALK",
            "narrator": "千羽鶴",
            "text": "もちろん、複数の子と\n関係を深められる。\nというか深めて欲しい。",
            "zh": "当然，可以和好几个女孩\n加深关系。\n不如说，希望你去加深。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "43/TALK",
            "narrator": "千羽鶴",
            "text": "最初にも言ったとおり、\n貴方には、全員の支えに\nなって欲しいと思ってる。",
            "zh": "一开始也说过。\n我希望你\n成为大家的支撑。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "44/TALK",
            "narrator": "千羽鶴",
            "text": "もちろん、\n強制はしないけど。",
            "zh": "当然，\n不会强迫。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "45/TALK",
            "narrator": "千羽鶴",
            "text": "貴方がしたいように、\n彼女たちとの物語を\n紡いでいけばいい。",
            "zh": "照你想的那样，\n和她们把故事\n讲下去就好。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "46/TALK",
            "narrator": "千羽鶴",
            "text": "それじゃ、頑張って。\n彼女のココロは、貴方の\n頑張りに委ねられている。",
            "zh": "那就，加油。\n她的心，\n交给你的努力了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "70/TALK",
            "narrator": "ガブリエラ",
            "text": "ふう……。\nやっぱり紅茶は\nレモンティーね。",
            "zh": "呼……。\n还是红茶，\n要柠檬红茶。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "71/TALK",
            "narrator": "アーヤ",
            "text": "ふふふ。\nギャヴィはレモンティー\n好きよね。",
            "zh": "呵呵。\n加维喜欢柠檬红茶\n吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "72/TALK",
            "narrator": "ガブリエラ",
            "text": "好きとか嫌いとかじゃ\nないのよ。",
            "zh": "不是喜欢\n不喜欢的问题。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "73/TALK",
            "narrator": "ガブリエラ",
            "text": "ミルクティーは子供の\n飲み物なの。\nポーランドではね。",
            "zh": "奶茶是小孩子\n喝的。\n在波兰是这样。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "74/TALK",
            "narrator": "アーヤ",
            "text": "不思議よね。\nその感覚。",
            "zh": "挺奇妙的。\n这种感觉。",
            "narrator_zh": "绫水"
        },
        {
            "location": "75/TALK",
            "narrator": "ガブリエラ",
            "text": "全然不思議じゃないわ。",
            "zh": "一点也不奇妙。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "76/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしに言わせれば\n外でミルクティーが\n飲める方が不思議よ。",
            "zh": "要我说，\n能在外面喝到奶茶\n才更奇妙。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "77/TALK",
            "narrator": "アーヤ",
            "text": "この前飲んでるの\n見かけたけど？",
            "zh": "之前我看到你在\n喝酒哦？",
            "narrator_zh": "绫水"
        },
        {
            "location": "78/TALK",
            "narrator": "ガブリエラ",
            "text": "…それは…。",
            "zh": "……那是……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "80/TALK",
            "narrator": "ガブリエラ",
            "text": "少しは日本文化に\n慣れた方がいいかなって\n思って…。",
            "zh": "我想着，\n多少该习惯一下\n日本的文化……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "81/TALK",
            "narrator": "アーヤ",
            "text": "揚げ足をとるつもりじゃ\nないのよ。",
            "zh": "我不是要\n抓你话柄。",
            "narrator_zh": "绫水"
        },
        {
            "location": "82/TALK",
            "narrator": "アーヤ",
            "text": "子供っぽいなんて\n思わないしね。",
            "zh": "也不会觉得\n你孩子气。",
            "narrator_zh": "绫水"
        },
        {
            "location": "83/TALK",
            "narrator": "ガブリエラ",
            "text": "…本当に…？",
            "zh": "…真的…？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "84/TALK",
            "narrator": "アーヤ",
            "text": "本当よ。",
            "zh": "真的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "85/TALK",
            "narrator": "アーヤ",
            "text": "そうだ。\n今度紅茶の専門店に\n行くのはどう？",
            "zh": "对。\n下次去红茶专卖店\n怎么样？",
            "narrator_zh": "绫水"
        },
        {
            "location": "87/TALK",
            "narrator": "ガブリエラ",
            "text": "行ってみたいわ！",
            "zh": "我想去！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "88/TALK",
            "narrator": "アーヤ",
            "text": "じゃあみんなの\n予定を聞いて…。",
            "zh": "那我问问\n大家的日程……",
            "narrator_zh": "绫水"
        },
        {
            "location": "89/TALK",
            "narrator": "ガブリエラ",
            "text": "…そうね。",
            "zh": "……也是。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "90/TALK",
            "narrator": "アーヤ",
            "text": "行きたいお店ね、\nアフタヌーンティーの\nプレートがあるの。",
            "zh": "我想去的那家，\n有下午茶的\n套盘。",
            "narrator_zh": "绫水"
        },
        {
            "location": "91/TALK",
            "narrator": "アーヤ",
            "text": "ケーキとサンドイッチが\n日替わりで\n選べるの。",
            "zh": "蛋糕和三明治\n每天换着\n可以选。",
            "narrator_zh": "绫水"
        },
        {
            "location": "93/TALK",
            "narrator": "アーヤ",
            "text": "みんなで行くと\nシェアできて\n楽しいわよ。",
            "zh": "大家一起去\n可以分着吃，\n会很好玩。",
            "narrator_zh": "绫水"
        },
        {
            "location": "94/TALK",
            "narrator": "ガブリエラ",
            "text": "うん。\n楽しそうね。",
            "zh": "嗯。\n听起来不错。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "102/TALK",
            "narrator": "アーヤ",
            "text": "みんなで紅茶専門店に行こうって言ったら、ギャヴィちょっと不機嫌みたい",
            "zh": "我说大家一起去红茶专卖店，加维好像有点不高兴",
            "narrator_zh": "绫水"
        },
        {
            "location": "103/TALK",
            "narrator": "アーヤ",
            "text": "二人で行きたかったのかしら",
            "zh": "是想两个人去吗",
            "narrator_zh": "绫水"
        },
        {
            "location": "104/TALK",
            "narrator": "アーヤ",
            "text": "紅茶専門店に、私と",
            "zh": "红茶专卖店，和我",
            "narrator_zh": "绫水"
        },
        {
            "location": "105/TALK",
            "narrator": "アーヤ",
            "text": "どう思う？",
            "zh": "你觉得呢？",
            "narrator_zh": "绫水"
        },
        {
            "location": "107/SEL",
            "narrator": "",
            "text": "そうなんじゃない",
            "zh": "不就是这样吗",
            "narrator_zh": ""
        },
        {
            "location": "108/SEL",
            "narrator": "",
            "text": "モテる人は大変だね",
            "zh": "受欢迎的人真辛苦呢",
            "narrator_zh": ""
        },
        {
            "location": "109/ACT",
            "narrator": "",
            "text": "そうなんじゃない",
            "zh": "不就是这样吗",
            "narrator_zh": ""
        },
        {
            "location": "110/TALK",
            "narrator": "アーヤ",
            "text": "やっぱり",
            "zh": "果然",
            "narrator_zh": "绫水"
        },
        {
            "location": "111/TALK",
            "narrator": "アーヤ",
            "text": "そうなのかしら",
            "zh": "是这样吗",
            "narrator_zh": "绫水"
        },
        {
            "location": "112/TALK",
            "narrator": "アーヤ",
            "text": "でもそれを直接聞くのも",
            "zh": "不过直接问那个也",
            "narrator_zh": "绫水"
        },
        {
            "location": "113/TALK",
            "narrator": "アーヤ",
            "text": "どうかと思うし",
            "zh": "我也觉得有点问题",
            "narrator_zh": "绫水"
        },
        {
            "location": "116/ACT",
            "narrator": "",
            "text": "モテる人は大変だね",
            "zh": "受欢迎的人真辛苦呢",
            "narrator_zh": ""
        },
        {
            "location": "117/TALK",
            "narrator": "アーヤ",
            "text": "そういうことじゃないし(--#)",
            "zh": "不是那么回事(--#)",
            "narrator_zh": "绫水"
        },
        {
            "location": "118/TALK",
            "narrator": "アーヤ",
            "text": "まあ",
            "zh": "嗯",
            "narrator_zh": "绫水"
        },
        {
            "location": "119/TALK",
            "narrator": "アーヤ",
            "text": "そんなに深刻に考えることじゃないって",
            "zh": "不是该想得那么严重的事",
            "narrator_zh": "绫水"
        },
        {
            "location": "120/TALK",
            "narrator": "アーヤ",
            "text": "そういうことよね",
            "zh": "就是那样吧",
            "narrator_zh": "绫水"
        },
        {
            "location": "128/TALK",
            "narrator": "アーヤ",
            "text": "ミルクティーしか\nないのは\nやっぱりダメ？",
            "zh": "只有奶茶\n的话\n果然不行？",
            "narrator_zh": "绫水"
        },
        {
            "location": "131/TALK",
            "narrator": "ガブリエラ",
            "text": "…そうじゃないわ。",
            "zh": "……不是那样。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "132/TALK",
            "narrator": "ガブリエラ",
            "text": "ただちょっと二人で\n行きたかっただけ。",
            "zh": "只是我想两个人\n去而已。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "133/TALK",
            "narrator": "アーヤ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "134/TALK",
            "narrator": "ガブリエラ",
            "text": "みんなで行くのが\n嫌なわけじゃないわ。",
            "zh": "不是讨厌\n大家一起去。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "135/TALK",
            "narrator": "アーヤ",
            "text": "そう？\nならいいんだけど…。",
            "zh": "是吧？\n那就好……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "136/TALK",
            "narrator": "ガブリエラ",
            "text": "秘密のお茶会とか\nいいなって思った\nだけだから。",
            "zh": "只是觉得\n秘密茶会什么的\n好像也不错。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "137/TALK",
            "narrator": "アーヤ",
            "text": "…ちょっとした\nサプライズでも\n仕込んでみる？",
            "zh": "……要不要\n准备一点\n小惊喜？",
            "narrator_zh": "绫水"
        },
        {
            "location": "138/TALK",
            "narrator": "ガブリエラ",
            "text": "…いいかも。",
            "zh": "……也许可以。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "139/TALK",
            "narrator": "アーヤ",
            "text": "何がいいかしら。",
            "zh": "什么比较好呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "140/TALK",
            "narrator": "ガブリエラ",
            "text": "楽しいサプライズね。\n悩むわね。",
            "zh": "要是开心的惊喜。\n挺伤脑筋的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "141/TALK",
            "narrator": "ガブリエラ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "142/TALK",
            "narrator": "アーヤ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "144/TALK",
            "narrator": "ガブリエラ",
            "text": "こういう時に\nお姉さんがいたら\n相談できるのにね。",
            "zh": "这种时候要是\n姐姐在，\n就能商量了呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "145/TALK",
            "narrator": "ガブリエラ",
            "text": "そう思わない？",
            "zh": "你不这么想吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "146/TALK",
            "narrator": "アーヤ",
            "text": "どうかしら。",
            "zh": "怎么样呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "147/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤはお姉さんに\n相談したりしないの？",
            "zh": "绫水不会找姐姐\n商量吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "148/TALK",
            "narrator": "アーヤ",
            "text": "いないし\nしないわ？",
            "zh": "人不在。\n也不会吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "149/TALK",
            "narrator": "ガブリエラ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "150/TALK",
            "narrator": "アーヤ",
            "text": "それより\nお茶会どうする？",
            "zh": "比起那个，\n茶会怎么办？",
            "narrator_zh": "绫水"
        },
        {
            "location": "151/TALK",
            "narrator": "アーヤ",
            "text": "最重要事項は\nそっちよね。",
            "zh": "最要紧的\n是那个吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "154/TALK",
            "narrator": "ガブリエラ",
            "text": "う、うん。\nそうよね…。",
            "zh": "嗯、嗯。\n是啊……",
