{
 "dir": "dramatics/daydra/drm_ch02_00_010.js",
 "type": "Episode",
 "info": {
  "story_id": "2001",
  "cid": "ayami",
  "title": "らぶとーく 第01話",
  "sub_title": "おねえさまとお茶会を"
 },
 "entry": [
  {
   "location": "7/SCENARIO",
   "narrator": "",
   "text": "おねえさまとお茶会を",
   "zh": "和姐姐大人的茶会",
   "narrator_zh": ""
  },
  {
   "location": "23/TALK",
   "narrator": "千羽鶴",
   "text": "まずはおめでとう。",
   "zh": "先恭喜你。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "24/TALK",
   "narrator": "千羽鶴",
   "text": "貴方が今ここにいると\nいうことは、彼女との\n関係の開始を意味する。",
   "zh": "你现在在这里，\n就意味着，和她的\n关系开始了。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "26/SEL",
   "narrator": "",
   "text": "関係の開始って、つまり…",
   "zh": "关系开始，也就是说……",
   "narrator_zh": ""
  },
  {
   "location": "27/ACT",
   "narrator": "",
   "text": "関係の開始って、つまり…",
   "zh": "关系开始，也就是说……",
   "narrator_zh": ""
  },
  {
   "location": "30/TALK",
   "narrator": "千羽鶴",
   "text": "そう。",
   "zh": "是的。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "31/TALK",
   "narrator": "千羽鶴",
   "text": "今この瞬間から、貴方と\n彼女は、真のパートナー\nとして歩み始める。",
   "zh": "从这一刻起，你和\n她，要作为真正的伙伴\n一起走下去。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "32/TALK",
   "narrator": "千羽鶴",
   "text": "その結果としては、\n恋人になったり、結婚\nしたりするかもしれない。",
   "zh": "结果也许是，\n成为恋人，\n或者结婚。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "33/TALK",
   "narrator": "千羽鶴",
   "text": "もちろんそれは、\nあくまで可能性でしか\nないけれども。",
   "zh": "当然，\n那也只是\n可能性而已。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "34/TALK",
   "narrator": "千羽鶴",
   "text": "１つだけ言えることは、\n全ては貴方の行動次第\nということ。",
   "zh": "只有一点能说，\n一切都看你\n怎么做。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "35/TALK",
   "narrator": "千羽鶴",
   "text": "何にしても、今後\n貴方と彼女の関係進展は、\n全てここで行われる。",
   "zh": "总之，往后\n你和她的关系进展，\n全都会在这里发生。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "36/TALK",
   "narrator": "千羽鶴",
   "text": "一見貴方に関係無いような\nお話が繰り広げられる事も\nあるけど、全部関係ある。",
   "zh": "看上去和你无关的\n故事，有时也会展开。\n但全部都有关系。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "37/TALK",
   "narrator": "千羽鶴",
   "text": "だから、彼女を大切に\n想うなら、ここでの物語は\n決して軽視しないよう。",
   "zh": "所以，要是珍惜她，\n这里的故事，\n千万别看轻。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "38/SEL",
   "narrator": "",
   "text": "これでもうパートナーは決まっちゃったの？",
   "zh": "这样伙伴就已经定下了吗？",
   "narrator_zh": ""
  },
  {
   "location": "39/ACT",
   "narrator": "",
   "text": "これでもうパートナーは決まっちゃったの？",
   "zh": "这样伙伴就已经定下了吗？",
   "narrator_zh": ""
  },
  {
   "location": "41/TALK",
   "narrator": "千羽鶴",
   "text": "まさか。\nまだ始まりに過ぎない。",
   "zh": "怎么会。\n这才刚开始。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "42/TALK",
   "narrator": "千羽鶴",
   "text": "もちろん、複数の子と\n関係を深められる。\nというか深めて欲しい。",
   "zh": "当然，可以和好几个女孩\n加深关系。\n不如说，希望你去加深。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "43/TALK",
   "narrator": "千羽鶴",
   "text": "最初にも言ったとおり、\n貴方には、全員の支えに\nなって欲しいと思ってる。",
   "zh": "一开始也说过。\n我希望你\n成为大家的支撑。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "44/TALK",
   "narrator": "千羽鶴",
   "text": "もちろん、\n強制はしないけど。",
   "zh": "当然，\n不会强迫。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "45/TALK",
   "narrator": "千羽鶴",
   "text": "貴方がしたいように、\n彼女たちとの物語を\n紡いでいけばいい。",
   "zh": "照你想的那样，\n和她们把故事\n讲下去就好。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "46/TALK",
   "narrator": "千羽鶴",
   "text": "それじゃ、頑張って。\n彼女のココロは、貴方の\n頑張りに委ねられている。",
   "zh": "那就，加油。\n她的心，\n交给你的努力了。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "70/TALK",
   "narrator": "ガブリエラ",
   "text": "ふう……。\nやっぱり紅茶は\nレモンティーね。"
  },
  {
   "location": "71/TALK",
   "narrator": "アーヤ",
   "text": "ふふふ。\nギャヴィはレモンティー\n好きよね。"
  },
  {
   "location": "72/TALK",
   "narrator": "ガブリエラ",
   "text": "好きとか嫌いとかじゃ\nないのよ。"
  },
  {
   "location": "73/TALK",
   "narrator": "ガブリエラ",
   "text": "ミルクティーは子供の\n飲み物なの。\nポーランドではね。"
  },
  {
   "location": "74/TALK",
   "narrator": "アーヤ",
   "text": "不思議よね。\nその感覚。"
  },
  {
   "location": "75/TALK",
   "narrator": "ガブリエラ",
   "text": "全然不思議じゃないわ。"
  },
  {
   "location": "76/TALK",
   "narrator": "ガブリエラ",
   "text": "あたしに言わせれば\n外でミルクティーが\n飲める方が不思議よ。"
  },
  {
   "location": "77/TALK",
   "narrator": "アーヤ",
   "text": "この前飲んでるの\n見かけたけど？",
   "zh": "之前我看到你在\n喝酒哦？",
   "narrator_zh": "绫水"
  },
  {
   "location": "78/TALK",
   "narrator": "ガブリエラ",
   "text": "…それは…。"
  },
  {
   "location": "80/TALK",
   "narrator": "ガブリエラ",
   "text": "少しは日本文化に\n慣れた方がいいかなって\n思って…。"
  },
  {
   "location": "81/TALK",
   "narrator": "アーヤ",
   "text": "揚げ足をとるつもりじゃ\nないのよ。"
  },
  {
   "location": "82/TALK",
   "narrator": "アーヤ",
   "text": "子供っぽいなんて\n思わないしね。"
  },
  {
   "location": "83/TALK",
   "narrator": "ガブリエラ",
   "text": "…本当に…？",
   "zh": "…真的…？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "84/TALK",
   "narrator": "アーヤ",
   "text": "本当よ。"
  },
  {
   "location": "85/TALK",
   "narrator": "アーヤ",
   "text": "そうだ。\n今度紅茶の専門店に\n行くのはどう？",
   "zh": "对。\n下次去红茶专卖店\n怎么样？",
   "narrator_zh": "绫水"
  },
  {
   "location": "87/TALK",
   "narrator": "ガブリエラ",
   "text": "行ってみたいわ！"
  },
  {
   "location": "88/TALK",
   "narrator": "アーヤ",
   "text": "じゃあみんなの\n予定を聞いて…。"
  },
  {
   "location": "89/TALK",
   "narrator": "ガブリエラ",
   "text": "…そうね。",
   "zh": "……也是。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "90/TALK",
   "narrator": "アーヤ",
   "text": "行きたいお店ね、\nアフタヌーンティーの\nプレートがあるの。"
  },
  {
   "location": "91/TALK",
   "narrator": "アーヤ",
   "text": "ケーキとサンドイッチが\n日替わりで\n選べるの。"
  },
  {
   "location": "93/TALK",
   "narrator": "アーヤ",
   "text": "みんなで行くと\nシェアできて\n楽しいわよ。"
  },
  {
   "location": "94/TALK",
   "narrator": "ガブリエラ",
   "text": "うん。\n楽しそうね。"
  },
  {
   "location": "102/TALK",
   "narrator": "アーヤ",
   "text": "みんなで紅茶専門店に行こうって言ったら、ギャヴィちょっと不機嫌みたい"
  },
  {
   "location": "103/TALK",
   "narrator": "アーヤ",
   "text": "二人で行きたかったのかしら"
  },
  {
   "location": "104/TALK",
   "narrator": "アーヤ",
   "text": "紅茶専門店に、私と"
  },
  {
   "location": "105/TALK",
   "narrator": "アーヤ",
   "text": "どう思う？",
   "zh": "你觉得呢？",
   "narrator_zh": "绫水"
  },
  {
   "location": "107/SEL",
   "narrator": "",
   "text": "そうなんじゃない",
   "zh": "不就是这样吗",
   "narrator_zh": ""
  },
  {
   "location": "108/SEL",
   "narrator": "",
   "text": "モテる人は大変だね",
   "zh": "受欢迎的人真辛苦呢",
   "narrator_zh": ""
  },
  {
   "location": "109/ACT",
   "narrator": "",
   "text": "そうなんじゃない",
   "zh": "不就是这样吗",
   "narrator_zh": ""
  },
  {
   "location": "110/TALK",
   "narrator": "アーヤ",
   "text": "やっぱり",
   "zh": "果然",
   "narrator_zh": "绫水"
  },
  {
   "location": "111/TALK",
   "narrator": "アーヤ",
   "text": "そうなのかしら",
   "zh": "是这样吗",
   "narrator_zh": "绫水"
  },
  {
   "location": "112/TALK",
   "narrator": "アーヤ",
   "text": "でもそれを直接聞くのも",
   "zh": "不过直接问那个也",
   "narrator_zh": "绫水"
  },
  {
   "location": "113/TALK",
   "narrator": "アーヤ",
   "text": "どうかと思うし",
   "zh": "我也觉得有点问题",
   "narrator_zh": "绫水"
  },
  {
   "location": "116/ACT",
   "narrator": "",
   "text": "モテる人は大変だね",
   "zh": "受欢迎的人真辛苦呢",
   "narrator_zh": ""
  },
  {
   "location": "117/TALK",
   "narrator": "アーヤ",
   "text": "そういうことじゃないし(--#)",
   "zh": "不是那么回事(--#)",
   "narrator_zh": "绫水"
  },
  {
   "location": "118/TALK",
   "narrator": "アーヤ",
   "text": "まあ",
   "zh": "嗯",
   "narrator_zh": "绫水"
  },
  {
   "location": "119/TALK",
   "narrator": "アーヤ",
   "text": "そんなに深刻に考えることじゃないって",
   "zh": "不是该想得那么严重的事",
   "narrator_zh": "绫水"
  },
  {
   "location": "120/TALK",
   "narrator": "アーヤ",
   "text": "そういうことよね",
   "zh": "就是那样吧",
   "narrator_zh": "绫水"
  },
  {
   "location": "128/TALK",
   "narrator": "アーヤ",
   "text": "ミルクティーしか\nないのは\nやっぱりダメ？"
  },
  {
   "location": "131/TALK",
   "narrator": "ガブリエラ",
   "text": "…そうじゃないわ。"
  },
  {
   "location": "132/TALK",
   "narrator": "ガブリエラ",
   "text": "ただちょっと二人で\n行きたかっただけ。",
   "zh": "只是我想两个人\n去而已。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "133/TALK",
   "narrator": "アーヤ",
   "text": "……。"
  },
  {
   "location": "134/TALK",
   "narrator": "ガブリエラ",
   "text": "みんなで行くのが\n嫌なわけじゃないわ。"
  },
  {
   "location": "135/TALK",
   "narrator": "アーヤ",
   "text": "そう？\nならいいんだけど…。",
   "zh": "是吧？\n那就好……。",
   "narrator_zh": "绫水"
  },
  {
   "location": "136/TALK",
   "narrator": "ガブリエラ",
   "text": "秘密のお茶会とか\nいいなって思った\nだけだから。"
  },
  {
   "location": "137/TALK",
   "narrator": "アーヤ",
   "text": "…ちょっとした\nサプライズでも\n仕込んでみる？"
  },
  {
   "location": "138/TALK",
   "narrator": "ガブリエラ",
   "text": "…いいかも。"
  },
  {
   "location": "139/TALK",
   "narrator": "アーヤ",
   "text": "何がいいかしら。"
  },
  {
   "location": "140/TALK",
   "narrator": "ガブリエラ",
   "text": "楽しいサプライズね。\n悩むわね。"
  },
  {
   "location": "141/TALK",
   "narrator": "ガブリエラ",
   "text": "……。"
  },
  {
   "location": "142/TALK",
   "narrator": "アーヤ",
   "text": "……。"
  },
  {
   "location": "144/TALK",
   "narrator": "ガブリエラ",
   "text": "こういう時に\nお姉さんがいたら\n相談できるのにね。",
   "zh": "这种时候要是\n姐姐在，\n就能商量了呢。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "145/TALK",
   "narrator": "ガブリエラ",
   "text": "そう思わない？",
   "zh": "你不这么想吗？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "146/TALK",
   "narrator": "アーヤ",
   "text": "どうかしら。",
   "zh": "怎么样呢。",
   "narrator_zh": "绫水"
  },
  {
   "location": "147/TALK",
   "narrator": "ガブリエラ",
   "text": "アーヤはお姉さんに\n相談したりしないの？"
  },
  {
   "location": "148/TALK",
   "narrator": "アーヤ",
   "text": "いないし\nしないわ？"
  },
  {
   "location": "149/TALK",
   "narrator": "ガブリエラ",
   "text": "……。"
  },
  {
   "location": "150/TALK",
   "narrator": "アーヤ",
   "text": "それより\nお茶会どうする？",
   "zh": "比起那个，\n茶会怎么办？",
   "narrator_zh": "绫水"
  },
  {
   "location": "151/TALK",
   "narrator": "アーヤ",
   "text": "最重要事項は\nそっちよね。"
  },
  {
   "location": "154/TALK",
   "narrator": "ガブリエラ",
   "text": "う、うん。\nそうよね…。"
  },
  {
   "location": "68/DIALOG",
   "narrator": "Dialog_EventData",
   "text": "<color=green>5月某日　3:22 PM</color>\nGW期間中、神楽坂のカフェにて。"
  }
 ]
}
