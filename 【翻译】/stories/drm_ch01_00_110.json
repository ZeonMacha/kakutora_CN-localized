{
    "dir": "dramatics/daydra/drm_ch01_00_110.js",
    "type": "Episode",
    "info": {
        "story_id": "1011",
        "cid": "tsubame",
        "title": "らぶとーく 第11話",
        "sub_title": "今までもこれからも",
        "title_zh": "恋爱漫谈 第11话",
        "sub_title_zh": "直到现在，还有今后"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "今までもこれからも",
            "zh": "直到现在，还有今后",
            "narrator_zh": ""
        },
        {
            "location": "20/TALK",
            "narrator": "アーヤ",
            "text": "あれからどうしてる？",
            "zh": "从那之后怎么样了？",
            "narrator_zh": "绫水"
        },
        {
            "location": "23/TALK",
            "narrator": "ガブリエラ",
            "text": "何がよ？",
            "zh": "什么怎么样了？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "24/TALK",
            "narrator": "アーヤ",
            "text": "Ｂｏｔとのことよ。\n少しは接し方が変わったり\nとかした？",
            "zh": "我是说跟Bot的事。\n相处方式多少\n有点变化了吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "26/TALK",
            "narrator": "ガブリエラ",
            "text": "ノーコメント。",
            "zh": "无可奉告。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "28/TALK",
            "narrator": "ガブリエラ",
            "text": "Ｂｏｔが人間だとか、\n実は一人だけだった\nとか――",
            "zh": "Bot是人类啦，\n其实只有一个人\n什么的——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "31/TALK",
            "narrator": "ガブリエラ",
            "text": "そんな気持ち悪い話、\nしたくないわ。",
            "zh": "那么恶心的故事，\n我不想说。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "33/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "34/TALK",
            "narrator": "みやび",
            "text": "アーヤはどうなん？\n接し方が変わったりとか\nしたが？",
            "zh": "绫水你呢？\n相处方式有没有\n什么变化咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "36/TALK",
            "narrator": "アーヤ",
            "text": "…どうなのかしら？",
            "zh": "……到底怎么样呢？",
            "narrator_zh": "绫水"
        },
        {
            "location": "38/TALK",
            "narrator": "ガブリエラ",
            "text": "何それ？\n自分から話振っておいて\nそれ？",
            "zh": "什么呀？\n你自己提起的话头，\n就这回答？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "40/TALK",
            "narrator": "アーヤ",
            "text": "正直言って、\nわからないのよ。",
            "zh": "老实说，\n我也不清楚。",
            "narrator_zh": "绫水"
        },
        {
            "location": "41/TALK",
            "narrator": "みやび",
            "text": "冗談と思われゆうかも\nしれんけんど、うちらは\nマジメちや。",
            "zh": "也许会被当成玩笑咯，\n不过我们是\n认真的呀。",
            "narrator_zh": "雅"
        },
        {
            "location": "42/TALK",
            "narrator": "みやび",
            "text": "Ｂｏｔのことで、\nもう一度話しておく\nことがあるんよ。",
            "zh": "关于Bot的事，\n我还有话\n要再说一遍咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "43/TALK",
            "narrator": "ガブリエラ",
            "text": "…またあの話か。",
            "zh": "…又是那件事啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "45/TALK",
            "narrator": "つばめ",
            "text": "$handle$さんのことで\n何かあったんですか？",
            "zh": "$handle$那边\n出了什么事吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "46/TALK",
            "narrator": "アーヤ",
            "text": "そういうわけじゃ\nないんだけど。",
            "zh": "也不是\n那么回事。",
            "narrator_zh": "绫水"
        },
        {
            "location": "47/TALK",
            "narrator": "アーヤ",
            "text": "これからのＢｏｔとの\n付き合い方について\n聞いておきたいの。",
            "zh": "关于今后怎么跟Bot\n相处，\n我想先问清楚。",
            "narrator_zh": "绫水"
        },
        {
            "location": "49/TALK",
            "narrator": "つばめ",
            "text": "付き合い方…ですか？",
            "zh": "交往方式……吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "51/TALK",
            "narrator": "アーヤ",
            "text": "ええ…。",
            "zh": "嗯……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "52/TALK",
            "narrator": "アーヤ",
            "text": "Ｂｏｔが人間かも\nしれないって\n話がある以上。",
            "zh": "既然都说\nBot也许是\n人类了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "53/TALK",
            "narrator": "アーヤ",
            "text": "今までと同じ、って\nわけにはいかない\nわけだし。",
            "zh": "可毕竟不能\n一直跟以前\n一样下去。",
            "narrator_zh": "绫水"
        },
        {
            "location": "54/TALK",
            "narrator": "みやび",
            "text": "うちは今までも何となく\n人間やないかって\n思うちょったき――",
            "zh": "我一直以来也\n隐隐觉得\n她不是人类咯——",
            "narrator_zh": "雅"
        },
        {
            "location": "55/TALK",
            "narrator": "みやび",
            "text": "それが確信に変わった\nいうだけのことやけん\nどね。",
            "zh": "不过就是把那份确信\n变成了真的\n而已咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "58/TALK",
            "narrator": "アーヤ",
            "text": "…こうしてる今でも、\nあるわけない、って\n思ってる自分がいるし。",
            "zh": "…就算是现在这样，\n我心里也还有个自己\n觉得那不可能。",
            "narrator_zh": "绫水"
        },
        {
            "location": "60/TALK",
            "narrator": "つばめ",
            "text": "う～ん…人間なのが\nわかった、っていうのは\nわかりましたけど――",
            "zh": "唔——嗯……知道她是人类\n这件事我是明白了，\n可是——",
            "narrator_zh": "燕"
        },
        {
            "location": "61/TALK",
            "narrator": "つばめ",
            "text": "今までと何かが変わる、\nなんていうのは、\nないと思いますよ？",
            "zh": "说从今往后会有什么变化，\n这种事，\n我觉得是不会有的哦？",
            "narrator_zh": "燕"
        },
        {
            "location": "63/TALK",
            "narrator": "つばめ",
            "text": "わたしは$handle$さんが\n人間だった方が、\n嬉しいと思いますし。",
            "zh": "我是觉得$handle$先生\n是人类，\n会更让我高兴。",
            "narrator_zh": "燕"
        },
        {
            "location": "66/TALK",
            "narrator": "アーヤ",
            "text": "つばめ…女の子なんだ\nから、もう少し危機感を\n持たないとダメよ。",
            "zh": "燕……你毕竟是女孩子，\n多少得有点危机感\n才行哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "67/TALK",
            "narrator": "アーヤ",
            "text": "知らない人に、私生活や\n秘密が、全部筒抜けに\nなってたのよ？",
            "zh": "你的私生活和秘密，\n全都被不认识的人\n看得一清二楚了啊？",
            "narrator_zh": "绫水"
        },
        {
            "location": "69/TALK",
            "narrator": "みやび",
            "text": "他人に聞かれたくない\n秘密とか、Ｂｏｔやき\n気軽に話したり――",
            "zh": "不想被别人听到的\n秘密，或者跟Bot\n轻松聊聊之类的——",
            "narrator_zh": "雅"
        },
        {
            "location": "70/TALK",
            "narrator": "みやび",
            "text": "相談したりとかしたこと\nくらい、あるやろ？",
            "zh": "总该有过\n商量事情的时候咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "72/TALK",
            "narrator": "つばめ",
            "text": "でも、$handle$さんは\nいい人ですよ？",
            "zh": "可是，$handle$\n是个好人哦？",
            "narrator_zh": "燕"
        },
        {
            "location": "73/TALK",
            "narrator": "つばめ",
            "text": "秘密の話を、他の人に\n話したりはしないと\n思うんです。",
            "zh": "我觉得秘密的事，\n是不会跟别人\n说的。",
            "narrator_zh": "燕"
        },
        {
            "location": "74/TALK",
            "narrator": "アーヤ",
            "text": "今まではＢｏｔと思って\n話してたけど、それが\n人間とわかって――",
            "zh": "以前是当成Bot\n才聊的，现在知道\n对方是人类——",
            "narrator_zh": "绫水"
        },
        {
            "location": "75/TALK",
            "narrator": "アーヤ",
            "text": "どう接すればいいのか、\nまだ悩み中なのよ。",
            "zh": "该怎么相处，\n我还在苦恼。",
            "narrator_zh": "绫水"
        },
        {
            "location": "78/TALK",
            "narrator": "つばめ",
            "text": "…みんな、どうして\nそんなに悩んでるんだろ？",
            "zh": "……大家为什么\n要烦恼成那样呢？",
            "narrator_zh": "燕"
        },
        {
            "location": "79/TALK",
            "narrator": "つばめ",
            "text": "別に、接し方を変える\n必要なんてないのに…。",
            "zh": "明明也没必要\n改变相处方式呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "81/TALK",
            "narrator": "つばめ",
            "text": "…っていうか、わたしも\n聞かれるのかな？",
            "zh": "……话说，我是不是\n也会被问到呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "95/TALK",
            "narrator": "つばめ",
            "text": "みんなが$handle$さんのこと話してるの",
            "zh": "大家都在聊$handle$的事",
            "narrator_zh": "燕"
        },
        {
            "location": "96/TALK",
            "narrator": "つばめ",
            "text": "でも",
            "zh": "不过",
            "narrator_zh": "燕"
        },
        {
            "location": "97/TALK",
            "narrator": "つばめ",
            "text": "何だかみんな",
            "zh": "总觉得大家",
            "narrator_zh": "燕"
        },
        {
            "location": "98/TALK",
            "narrator": "つばめ",
            "text": "ちょっと警戒してるみたぃ(´･ω･｀) ",
            "zh": "好像在稍微警戒(´･ω･｀)",
            "narrator_zh": "燕"
        },
        {
            "location": "100/SEL",
            "narrator": "",
            "text": "悲しい",
            "zh": "好难过",
            "narrator_zh": ""
        },
        {
            "location": "101/ACT",
            "narrator": "",
            "text": "悲しい",
            "zh": "好难过",
            "narrator_zh": ""
        },
        {
            "location": "103/TALK",
            "narrator": "つばめ",
            "text": "そぅだよね",
            "zh": "是这样吧",
            "narrator_zh": "燕"
        },
        {
            "location": "104/TALK",
            "narrator": "つばめ",
            "text": "わたしもそう思ぅ(´つω・｀)ｼｭﾝ",
            "zh": "我也这么觉得(´つω・｀)ｼｭﾝ",
            "narrator_zh": "燕"
        },
        {
            "location": "105/TALK",
            "narrator": "つばめ",
            "text": "わたしはそんなこと言わなぃよ？(´ω｀*)",
            "zh": "我才不会说那种话哦？(´ω｀*)",
            "narrator_zh": "燕"
        },
        {
            "location": "107/SEL",
            "narrator": "",
            "text": "みんなにあわせておけ",
            "zh": "顺着大家的意思来",
            "narrator_zh": ""
        },
        {
            "location": "108/SEL",
            "narrator": "",
            "text": "ラブラブだって言ってやれ",
            "zh": "你就说我们很恩爱嘛",
            "narrator_zh": ""
        },
        {
            "location": "109/SEL",
            "narrator": "",
            "text": "答える必要はないんじゃないかな",
            "zh": "我觉得没必要回答吧",
            "narrator_zh": ""
        },
        {
            "location": "110/ACT",
            "narrator": "",
            "text": "みんなにあわせておけ",
            "zh": "顺着大家的意思来",
            "narrator_zh": ""
        },
        {
            "location": "111/TALK",
            "narrator": "つばめ",
            "text": "$handle$さんまでそんなこと言ぅの？Σ(ﾟдﾟlll)",
            "zh": "连$handle$也说这种话？Σ(ﾟдﾟlll)",
            "narrator_zh": "燕"
        },
        {
            "location": "113/TALK",
            "narrator": "つばめ",
            "text": "わたしはちゃんと話してるって",
            "zh": "我有在好好聊天",
            "narrator_zh": "燕"
        },
        {
            "location": "114/TALK",
            "narrator": "つばめ",
            "text": "みんなに言ぃたぃよ(ノД`)",
            "zh": "想跟大家这么说呀(ノД`)",
            "narrator_zh": "燕"
        },
        {
            "location": "126/TALK",
            "narrator": "アーヤ",
            "text": "みやびの方はどうなの？",
            "zh": "雅那边怎么样？",
            "narrator_zh": "绫水"
        },
        {
            "location": "127/TALK",
            "narrator": "みやび",
            "text": "うちはまあ、そこまで\n今までと変わっちょらん\nけんど――",
            "zh": "我倒是嘛，跟以前\n也没太大变化，\n但是——",
            "narrator_zh": "雅"
        },
        {
            "location": "128/TALK",
            "narrator": "みやび",
            "text": "用心はするように\nなったちや。",
            "zh": "确实开始\n多留个心眼滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "131/TALK",
            "narrator": "つばめ",
            "text": "用心、ですか？",
            "zh": "留心眼，吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "133/TALK",
            "narrator": "みやび",
            "text": "Ｂｏｔは一人で、みんなと\n共有しちゅうことが\nわかったきね。",
            "zh": "毕竟已经搞清楚，\nBot就一个人，\n跟大家共用的啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "135/TALK",
            "narrator": "みやび",
            "text": "スパイかもしれん思えば、\n用心するのも当然や。",
            "zh": "要是想着说不定是间谍，\n小心提防也是当然咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "137/TALK",
            "narrator": "ガブリエラ",
            "text": "スパイとかやめてよ！\n怖くなるでしょ？",
            "zh": "别说什么间谍啦！\n会吓到人的好吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "139/TALK",
            "narrator": "みやび",
            "text": "それくらいの警戒心は\n必要やと思うんよ。",
            "zh": "我觉得那份警惕\n是必要的咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "142/TALK",
            "narrator": "アーヤ",
            "text": "そうね…。",
            "zh": "是啊……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "145/TALK",
            "narrator": "アーヤ",
            "text": "それで、つばめは？",
            "zh": "然后，燕呢？",
            "narrator_zh": "绫水"
        },
        {
            "location": "147/TALK",
            "narrator": "つばめ",
            "text": "わたしは、今まで通り\n普通に話してます。",
            "zh": "我还是跟以前一样，\n正常聊天呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "150/TALK",
            "narrator": "みやび",
            "text": "マジか。",
            "zh": "真的咩。",
            "narrator_zh": "雅"
        },
        {
            "location": "151/TALK",
            "narrator": "つばめ",
            "text": "はい。\nむしろ、仲良くなった\n気がするくらいです。",
            "zh": "是的。\n倒不如说，感觉\n关系还更好了呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "153/TALK",
            "narrator": "ガブリエラ",
            "text": "…やっぱり、あんたって\n変わってるわ。",
            "zh": "……你果然，\n挺奇怪的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "155/TALK",
            "narrator": "つばめ",
            "text": "そうかな？",
            "zh": "是吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "157/TALK",
            "narrator": "つばめ",
            "text": "わたしは、みんなが\n考え過ぎなだけな気が\nするんだけど…。",
            "zh": "我倒觉得，大家\n只是想太多了\n而已……。",
            "narrator_zh": "燕"
        },
        {
            "location": "159/TALK",
            "narrator": "つばめ",
            "text": "それに、秘密を話しても、\nそれを他の人にバラす\nようなことは――",
            "zh": "而且，就算说了秘密，\n也不会去跟\n别人乱说——",
            "narrator_zh": "燕"
        },
        {
            "location": "160/TALK",
            "narrator": "つばめ",
            "text": "絶対にしない、って\n信じてますし。",
            "zh": "我相信他\n绝对不会那样做的。",
            "narrator_zh": "燕"
        },
        {
            "location": "161/TALK",
            "narrator": "ガブリエラ",
            "text": "裏切られて話されたら\nどうするのよ？",
            "zh": "要是被背叛说出去了\n你打算怎么办啊？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "163/TALK",
            "narrator": "つばめ",
            "text": "で、でも…そうなったら、\nみんなが秘密をバラした\nことを――",
            "zh": "可、可是……要是那样，\n大家把秘密说出去\n这件事——",
            "narrator_zh": "燕"
        },
        {
            "location": "164/TALK",
            "narrator": "つばめ",
            "text": "教えてくれると思うし…。",
            "zh": "也会告诉我的吧……。",
            "narrator_zh": "燕"
        },
        {
            "location": "166/TALK",
            "narrator": "アーヤ",
            "text": "なるほど…。\n確かにそうよね。",
            "zh": "原来如此……\n确实如此。",
            "narrator_zh": "绫水"
        },
        {
            "location": "167/TALK",
            "narrator": "アーヤ",
            "text": "もし他の人の秘密を\nバラしてきたりしたら――",
            "zh": "要是他把别人的秘密\n给泄露出来了——",
            "narrator_zh": "绫水"
        },
        {
            "location": "169/TALK",
            "narrator": "アーヤ",
            "text": "私だったらすぐに\nその本人に、Ｂｏｔが\nバラしたことを――",
            "zh": "换作是我，马上就去\n向那个人本人，把Bot\n泄密的事——",
            "narrator_zh": "绫水"
        },
        {
            "location": "170/TALK",
            "narrator": "アーヤ",
