{
    "dir": "chap24/daydra/dd_ch02_24_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "24252",
        "cid": "ayami",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "憩いの時",
        "title_zh": "Extra002 额外剧情",
        "sub_title_zh": "小憩之时"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "憩いの時",
            "zh": "小憩之时",
            "narrator_zh": ""
        },
        {
            "location": "25/TALK",
            "narrator": "小夜",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "小夜"
        },
        {
            "location": "27/TALK",
            "narrator": "小夜",
            "text": "ま、そうよね…。\n今は大学に来る余裕なんて\nないだろうし…。",
            "zh": "嗯，也是呢……。\n现在大概也没那份余力\n来大学了吧……。",
            "narrator_zh": "小夜"
        },
        {
            "location": "31/TALK",
            "narrator": "アーヤ",
            "text": "おはよう、小夜。",
            "zh": "早安，小夜。",
            "narrator_zh": "绫水"
        },
        {
            "location": "32/TALK",
            "narrator": "小夜",
            "text": "あ、おはようアーヤ…。",
            "zh": "啊，早安，绫水……。",
            "narrator_zh": "小夜"
        },
        {
            "location": "34/TALK",
            "narrator": "小夜",
            "text": "…アーヤ！？",
            "zh": "……绫水！？",
            "narrator_zh": "小夜"
        },
        {
            "location": "36/TALK",
            "narrator": "アーヤ",
            "text": "わっ！？　な、なに！？\nどうして驚くの？",
            "zh": "哇！？　什、什么！？\n怎么吓成这样？",
            "narrator_zh": "绫水"
        },
        {
            "location": "37/TALK",
            "narrator": "小夜",
            "text": "そりゃ驚くでしょ！\n何で大学来てんの！？",
            "zh": "那肯定会吓一跳啊！\n你怎么来大学了！？",
            "narrator_zh": "小夜"
        },
        {
            "location": "38/TALK",
            "narrator": "アーヤ",
            "text": "何でって、私も一応\n大学生なんだけど…。",
            "zh": "什么怎么来了，我姑且也算个\n大学生好吧……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "39/TALK",
            "narrator": "小夜",
            "text": "そうじゃなくて…。",
            "zh": "我不是这个意思……。",
            "narrator_zh": "小夜"
        },
        {
            "location": "41/TALK",
            "narrator": "アーヤ",
            "text": "ごめん、何を言いたいかは\nわかってるから。",
            "zh": "抱歉，我知道你想\n说什么。",
            "narrator_zh": "绫水"
        },
        {
            "location": "42/TALK",
            "narrator": "アーヤ",
            "text": "今の状況で、どうして\n大学に来てるのか、って\n聞きたいんでしょ？",
            "zh": "你是想问，在这种状况下\n我怎么还跑来大学，\n对吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "43/TALK",
            "narrator": "小夜",
            "text": "う、うん…大丈夫なの？\n今って、大学来てる\n場合じゃないでしょ？",
            "zh": "嗯、嗯……不要紧吗？\n现在应该不是来大学的\n时候吧？",
            "narrator_zh": "小夜"
        },
        {
            "location": "44/TALK",
            "narrator": "アーヤ",
            "text": "そうなんだけど…、\nこれくらいしかすること\nないのよ。",
            "zh": "话是这么说……\n可眼下我也只能做做\n这种事了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "45/TALK",
            "narrator": "アーヤ",
            "text": "何かしようにも、\n自由に動けるような\n状況でもないし。",
            "zh": "就算想做点什么，\n现在的处境也没法\n自由行动。",
            "narrator_zh": "绫水"
        },
        {
            "location": "46/TALK",
            "narrator": "小夜",
            "text": "…そっか。",
            "zh": "……这样啊。",
            "narrator_zh": "小夜"
        },
        {
            "location": "47/TALK",
            "narrator": "アーヤ",
            "text": "うん、そういうこと。",
            "zh": "嗯，就是这么回事。",
            "narrator_zh": "绫水"
        },
        {
            "location": "51/TALK",
            "narrator": "アーヤ",
            "text": "まあ、話の続きは\n講義の後でね。",
            "zh": "好啦，剩下的话\n等下课后再说吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "52/TALK",
            "narrator": "小夜",
            "text": "うん…。",
            "zh": "嗯……。",
            "narrator_zh": "小夜"
        },
        {
            "location": "56/TALK",
            "narrator": "小夜",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "小夜"
        },
        {
            "location": "57/TALK",
            "narrator": "小夜",
            "text": "なんか…大変そうだなぁ…。",
            "zh": "总觉得……好像很棘手啊……。",
            "narrator_zh": "小夜"
        },
        {
            "location": "68/TALK",
            "narrator": "アーヤ",
            "text": "なるほど…ちょっと悲しい\n終わり方をするお話か…。",
            "zh": "原来如此……结局有点伤感的\n故事啊……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "70/TALK",
            "narrator": "小夜",
            "text": "うん、私達が劇にする\nお話って、いっつも\nハッピーエンドでしょ？",
            "zh": "嗯，我们排成剧的\n故事，平时不都是\n大团圆结局嘛？",
            "narrator_zh": "小夜"
        },
        {
            "location": "71/TALK",
            "narrator": "小夜",
            "text": "まあ、幼稚園児相手だから\n仕方なくはあるんだけどさ。",
            "zh": "虽说面向幼儿园小朋友\n这也是没办法的事啦。",
            "narrator_zh": "小夜"
        },
        {
            "location": "74/TALK",
            "narrator": "アーヤ",
            "text": "そうね…あんまり悲しい\n終わり方するのだと、\n子供たちが泣いちゃうし。",
            "zh": "是啊……结局要是\n太悲伤的话，\n孩子们会哭的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "75/TALK",
            "narrator": "小夜",
            "text": "いや、そこまで悲しいのは\nさすがにやらないわよ。",
            "zh": "不，真那么悲伤的\n我们也不至于去演啦。",
            "narrator_zh": "小夜"
        },
        {
            "location": "76/TALK",
            "narrator": "小夜",
            "text": "演じるこっちだって\n暗くなるし、アーヤなんか\n途中で泣いちゃいそうだし。",
            "zh": "演的人自己也会\n心情低落，而且绫水你\n说不定演到一半就哭出来了。",
            "narrator_zh": "小夜"
        },
        {
            "location": "78/TALK",
            "narrator": "アーヤ",
            "text": "な、泣かないわよ！\n子供向けの劇で泣くわけ\nないでしょ？",
            "zh": "才、才不会哭呢！\n面向小孩子的剧我怎么\n可能会哭啊？",
            "narrator_zh": "绫水"
        },
        {
            "location": "79/TALK",
            "narrator": "小夜",
            "text": "あれ？　確か図書室で\n絵本読んで泣いたのは\n誰だったかしら？",
            "zh": "咦？　我记得在图书室\n看绘本看哭的那个人\n是谁来着？",
            "narrator_zh": "小夜"
        },
        {
            "location": "81/TALK",
            "narrator": "アーヤ",
            "text": "あ、あれは特別よ。\n実話を基にした話だから、\nつい…。",
            "zh": "那、那是例外。\n因为是真实故事改编的，\n一时没忍住……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "82/TALK",
            "narrator": "小夜",
            "text": "あはは、まあとにかくさ、\n子供たちが泣かない程度に\n悲しい話を探してるわけ。",
            "zh": "啊哈哈，总之呢，\n我们正在找那种不至于让孩子们哭的\n伤感故事。",
            "narrator_zh": "小夜"
        },
        {
            "location": "83/TALK",
            "narrator": "小夜",
            "text": "どう？　何かいい話ある？",
            "zh": "怎么样？　有什么好故事吗？",
            "narrator_zh": "小夜"
        },
        {
            "location": "86/TALK",
            "narrator": "アーヤ",
            "text": "うーん…私はそんな話は\n見たことないかも…。",
            "zh": "唔……那样的故事\n我可能没看过……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "88/TALK",
            "narrator": "小夜",
            "text": "じゃあ、近いうちに\n図書館巡りね。",
            "zh": "那就趁这几天\n去逛逛图书馆吧。",
            "narrator_zh": "小夜"
        },
        {
            "location": "89/TALK",
            "narrator": "小夜",
            "text": "あ、もちろんアーヤの\n都合がよければだけど…。",
            "zh": "啊，当然前提是\n绫水你方便的话……。",
            "narrator_zh": "小夜"
        },
        {
            "location": "91/TALK",
            "narrator": "アーヤ",
            "text": "絶対とは言えないけど、\n何も起こらなければ\n一緒に行くわ。",
            "zh": "虽然不敢打保票，\n但只要没出什么事\n我就和你一起去。",
            "narrator_zh": "绫水"
        },
        {
            "location": "93/TALK",
            "narrator": "小夜",
            "text": "約束よ？",
            "zh": "说好了哦？",
            "narrator_zh": "小夜"
        },
        {
            "location": "95/TALK",
            "narrator": "小夜",
            "text": "っと、お茶切れちゃった…。\nおかわり入れてくるわ。",
            "zh": "哎呀，茶喝完了……。\n我去续一杯。",
            "narrator_zh": "小夜"
        },
        {
            "location": "96/TALK",
            "narrator": "アーヤ",
            "text": "あ、私も欲しいな。",
            "zh": "啊，我也想喝。",
            "narrator_zh": "绫水"
        },
        {
            "location": "98/TALK",
            "narrator": "小夜",
            "text": "ついでに持ってくるから、\nアーヤは待ってて。",
            "zh": "我顺便拿过来，\n绫水你等着。",
            "narrator_zh": "小夜"
        },
        {
            "location": "102/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "103/TALK",
            "narrator": "アーヤ",
            "text": "何やってるのかしら…。",
            "zh": "我这是在干什么啊……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "104/TALK",
            "narrator": "アーヤ",
            "text": "ちょっとサークルの話を\n振られただけなのに、\n夢中になっちゃうなんて。",
            "zh": "只不过被顺口提了句\n社团的事，\n居然就这么投入进去了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "106/TALK",
            "narrator": "アーヤ",
            "text": "今はサークルの話に\n夢中になってるような\n場合じゃないのに…。",
            "zh": "现在根本不是\n沉迷聊社团话题的\n时候啊……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "107/TALK",
            "narrator": "アーヤ",
            "text": "…まさか、この状況で\n気が抜けてる？",
            "zh": "……难道说，在这种节骨眼上\n我反而松懈了？",
            "narrator_zh": "绫水"
        },
        {
            "location": "111/TALK",
            "narrator": "アーヤ",
            "text": "…$handle2$に\n聞いてみようかしら。",
            "zh": "……要不要\n问问$handle2$呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "112/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "116/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "117/TALK",
            "narrator": "アーヤ",
            "text": "…本当、気が抜けてるわ。",
            "zh": "……真是的，太松懈了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "120/TALK",
            "narrator": "小夜",
            "text": "お待たせー。\nはい、アーヤのお茶。",
            "zh": "久等啦——。\n来，绫水的茶。",
            "narrator_zh": "小夜"
        },
        {
            "location": "123/TALK",
            "narrator": "アーヤ",
            "text": "ありがとう。",
            "zh": "谢谢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "124/TALK",
            "narrator": "小夜",
            "text": "それでさ、えっと…。",
            "zh": "话说回来，那个……。",
            "narrator_zh": "小夜"
        },
        {
            "location": "125/TALK",
            "narrator": "アーヤ",
            "text": "劇の話よ。\nちょっと悲しいお話を\nやりたいんでしょ？",
            "zh": "是说戏剧的事吧。\n你想演个稍微有点\n悲伤的故事，对吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "126/TALK",
            "narrator": "小夜",
            "text": "そうそう！",
            "zh": "对对！",
            "narrator_zh": "小夜"
        },
        {
            "location": "127/TALK",
            "narrator": "小夜",
            "text": "今ね、ちょっと考えて\nみたんだけど、\n例えば――",
            "zh": "刚才我稍微\n想了一下，\n比如说——",
            "narrator_zh": "小夜"
        },
        {
            "location": "140/TALK",
            "narrator": "小夜",
            "text": "今日ってこれからバイト？",
            "zh": "你今天待会儿还要打工？",
            "narrator_zh": "小夜"
        },
        {
            "location": "142/TALK",
            "narrator": "アーヤ",
            "text": "ええ、早番だから\n寄り道できないのよ。",
            "zh": "嗯，因为是早班，\n没法绕路去别处了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "143/TALK",
            "narrator": "小夜",
            "text": "そっか…もうちょっと、\n劇のこと話したかったん\nだけど…。",
            "zh": "这样啊……本来还想\n再多聊聊戏剧的事\n来着……。",
            "narrator_zh": "小夜"
        },
        {
            "location": "144/TALK",
            "narrator": "小夜",
            "text": "ま、明日でいっか。",
            "zh": "算了，明天再说吧。",
            "narrator_zh": "小夜"
        },
        {
            "location": "145/TALK",
            "narrator": "アーヤ",
            "text": "私も、何かいいお話が無いか\n探してみるわ。",
            "zh": "我也帮忙找找看\n有没有什么好故事。",
            "narrator_zh": "绫水"
        },
        {
            "location": "147/TALK",
            "narrator": "小夜",
            "text": "ありがと。\nじゃ、また明日ね。",
            "zh": "谢啦。\n那明天见咯。",
            "narrator_zh": "小夜"
        },
        {
            "location": "149/TALK",
            "narrator": "アーヤ",
            "text": "ん、また明日…。",
            "zh": "嗯，明天见……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "154/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "156/TALK",
            "narrator": "アーヤ",
            "text": "まあ…こんな日があっても\n悪くないわよね？",
            "zh": "算了……偶尔有这样的一天\n也不算坏吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "157/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "169/TALK",
            "narrator": "アーヤ",
            "text": "いけなかった？",
            "zh": "我不该这样吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "170/TALK",
            "narrator": "アーヤ",
            "text": "今日の私(-ω-;)",
            "zh": "今天的我(-ω-;)",
            "narrator_zh": "绫水"
        },
        {
            "location": "172/SEL",
            "narrator": "",
            "text": "どういうこと？",
            "zh": "怎么回事？",
            "narrator_zh": ""
        },
        {
            "location": "173/ACT",
            "narrator": "",
            "text": "どういうこと？",
            "zh": "怎么回事？",
            "narrator_zh": ""
        },
        {
            "location": "175/TALK",
            "narrator": "アーヤ",
            "text": "小夜とした",
            "zh": "就是和小夜聊了",
            "narrator_zh": "绫水"
        },
        {
            "location": "176/TALK",
            "narrator": "アーヤ",
            "text": "サークルの話のこと(｡-_-｡)",
            "zh": "社团的事(｡-_-｡)",
            "narrator_zh": "绫水"
        },
        {
            "location": "177/TALK",
            "narrator": "アーヤ",
            "text": "夢中になってた(´o｀；",
            "zh": "聊得太入迷了(´o｀；",
            "narrator_zh": "绫水"
        },
        {
            "location": "178/TALK",
            "narrator": "アーヤ",
            "text": "正直",
            "zh": "说实话",
            "narrator_zh": "绫水"
        },
        {
            "location": "179/TALK",
            "narrator": "アーヤ",
            "text": "卯月のこと抜けてたと思う(>_<)",
            "zh": "我觉得自己把卯月的事抛到脑后了(>_<)",
            "narrator_zh": "绫水"
        },
        {
            "location": "180/TALK",
            "narrator": "アーヤ",
            "text": "緊張感かけ過ぎ？(￣Д￣ )",
            "zh": "是不是太缺乏紧张感了？(￣Д￣ )",
            "narrator_zh": "绫水"
        },
        {
            "location": "181/TALK",
            "narrator": "アーヤ",
            "text": "ちょっと",
            "zh": "稍微",
            "narrator_zh": "绫水"
        },
        {
            "location": "182/TALK",
            "narrator": "アーヤ",
            "text": "罪悪感ある(´o｀；",
            "zh": "有点罪恶感(´o｀；",
            "narrator_zh": "绫水"
        },
        {
            "location": "185/SEL",
            "narrator": "",
            "text": "らしくはないけど、いいと思う",
            "zh": "虽然不像你的作风，但我觉得挺好的",
            "narrator_zh": ""
        },
        {
            "location": "186/SEL",
            "narrator": "",
            "text": "確かに気が抜け過ぎだ",
            "zh": "确实太松懈了",
            "narrator_zh": ""
        },
        {
            "location": "187/SEL",
            "narrator": "",
            "text": "それより話せなくて寂しかった",
            "zh": "比起那个，没能和你说话好寂寞",
            "narrator_zh": ""
        },
        {
            "location": "188/ACT",
            "narrator": "",
            "text": "らしくはないけど、いいと思う",
            "zh": "虽然不像你的作风，但我觉得挺好的",
            "narrator_zh": ""
        },
        {
            "location": "189/TALK",
            "narrator": "アーヤ",
            "text": "そう？",
            "zh": "是吗？",
            "narrator_zh": "绫水"
