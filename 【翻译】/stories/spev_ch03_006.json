{
    "dir": "chap00/daydra/spev_ch03_006.js",
    "type": "",
    "info": {
        "story_id": "3006",
        "cid": "",
        "title": "スペシャルエピソード",
        "sub_title": "冷えすぎにご注意",
        "title_zh": "特别篇",
        "sub_title_zh": "小心着凉"
    },
    "entry": [
        {
            "location": "23/TALK",
            "narrator": "透明ガブリエラ",
            "text": "はぁ～、やっぱり夏は\nかき氷よねー。",
            "zh": "哈～，果然夏天\n还是得吃刨冰呀——",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "24/TALK",
            "narrator": "透明神楽",
            "text": "ガブちゃん、\nお昼ご飯食べに来たの\n忘れたんですか？",
            "zh": "加布，\n你忘了我们是来\n吃午饭的吗？",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "25/TALK",
            "narrator": "透明ガブリエラ",
            "text": "いいじゃない。\n海に来てる時くらい、\n好きなの食べたって。",
            "zh": "有什么关系嘛。\n难得都来海边了，\n想吃什么就吃什么呗。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "27/TALK",
            "narrator": "透明つばめ",
            "text": "わたしは焼きそばに\nしようかなー？",
            "zh": "我要不要点\n炒面呀——？",
            "narrator_zh": "透明燕"
        },
        {
            "location": "28/TALK",
            "narrator": "透明神楽",
            "text": "海の家の焼きそばって、\nお祭りの時とは違う\n美味しさありますからね。",
            "zh": "海滨小屋的炒面，\n吃起来和祭典时候的\n有不一样的美味呢。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "29/TALK",
            "narrator": "透明ガブリエラ",
            "text": "なら、かき氷だって\nそうじゃない。",
            "zh": "那刨冰不也\n一样吗。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "30/TALK",
            "narrator": "透明神楽",
            "text": "そうですけど、\nご飯として食べるのは\n間違ってるような…。",
            "zh": "话是这么说，\n可拿来当正餐吃\n总觉得不太对……",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "31/TALK",
            "narrator": "透明神楽",
            "text": "いくら食べても\nお腹膨れませんし。",
            "zh": "再怎么吃\n也填不饱肚子呀。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "33/TALK",
            "narrator": "透明ガブリエラ",
            "text": "お腹減ってないから\nいいのよ。",
            "zh": "我又不饿，\n没事的。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "34/TALK",
            "narrator": "透明ガブリエラ",
            "text": "あたしのことはいいから、\nあんた達も食べたいもの\n食べればいいじゃない。",
            "zh": "别管我了，\n你们也各自点\n想吃的东西不就好了。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "36/TALK",
            "narrator": "透明神楽",
            "text": "もぅ…後でお腹減っても\n知りませんよ？",
            "zh": "真是的……待会儿饿了\n我可不管你哦？",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "38/TALK",
            "narrator": "透明ガブリエラ",
            "text": "まったく…海に来てるのに\nかき氷食べないなんて…。",
            "zh": "真是的……都来海边了\n竟然不吃刨冰……",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "40/TALK",
            "narrator": "透明ガブリエラ",
            "text": "そうだ。\nマルザンナだったら\nどう言うかしら？",
            "zh": "对了。\n要是玛尔赞娜的话\n会怎么说呢？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "42/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょっといいかしら？",
            "zh": "现在方便聊一下吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "43/TALK",
            "narrator": "ガブリエラ",
            "text": "海に来て食べるもの",
            "zh": "来到海边要吃的东西",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "44/TALK",
            "narrator": "ガブリエラ",
            "text": "マルザンナなら",
            "zh": "要是玛尔赞娜的话",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "45/TALK",
            "narrator": "ガブリエラ",
            "text": "まず何を思い浮かべる？",
            "zh": "最先会想到什么？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "46/SEL",
            "narrator": "（選択肢）",
            "text": "焼きそばとかラーメン？",
            "zh": "炒面或者拉面之类的？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "47/SEL",
            "narrator": "（選択肢）",
            "text": "かき氷かな",
            "zh": "大概是刨冰吧",
            "narrator_zh": "（选项）"
        },
        {
            "location": "48/ACT",
            "narrator": "",
            "text": "焼きそばとかラーメン？",
            "zh": "炒面或者拉面之类的？",
            "narrator_zh": ""
        },
        {
            "location": "49/TALK",
            "narrator": "ガブリエラ",
            "text": "マルザンナもそっちが好きなの？",
            "zh": "连玛尔赞娜也喜欢那边的吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "51/TALK",
            "narrator": "ガブリエラ",
            "text": "もちろん",
            "zh": "当然啦",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "52/TALK",
            "narrator": "ガブリエラ",
            "text": "それも魅力的よ？",
            "zh": "那些也是很有吸引力的哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "53/TALK",
            "narrator": "ガブリエラ",
            "text": "でも",
            "zh": "不过",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "54/TALK",
            "narrator": "ガブリエラ",
            "text": "かき氷もいいと思わない？",
            "zh": "你不觉得刨冰也挺好的吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "55/ACT",
            "narrator": "",
            "text": "かき氷かな",
            "zh": "大概是刨冰吧",
            "narrator_zh": ""
        },
        {
            "location": "56/TALK",
            "narrator": "ガブリエラ",
            "text": "そう言ってくれると信じてたわ",
            "zh": "我就相信你会这么说",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "57/TALK",
            "narrator": "ガブリエラ",
            "text": "やっぱり海ではかき氷",
            "zh": "果然在海边就该吃刨冰",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "58/TALK",
            "narrator": "ガブリエラ",
            "text": "これが一番よね",
            "zh": "这才是最棒的嘛",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "60/TALK",
            "narrator": "ガブリエラ",
            "text": "涼しい部屋で食べるんじゃなくて",
            "zh": "不是在凉快的屋子里吃",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "61/TALK",
            "narrator": "ガブリエラ",
            "text": "暑い太陽の下で",
            "zh": "而是在炎热的太阳底下",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "62/TALK",
            "narrator": "ガブリエラ",
            "text": "溶けちゃう前に早く食べるの",
            "zh": "趁它融化前快点吃掉",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "63/TALK",
            "narrator": "ガブリエラ",
            "text": "冷たさと甘さで",
            "zh": "那股冰凉和甘甜",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "65/TALK",
            "narrator": "ガブリエラ",
            "text": "キュッてするの",
            "zh": "让人一下子清爽透心",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "66/TALK",
            "narrator": "ガブリエラ",
            "text": "最高よね？",
            "zh": "超级棒对吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "67/SEL",
            "narrator": "（選択肢）",
            "text": "今のガブリエラが最高に可愛い",
            "zh": "现在的加布里埃拉才是最可爱的",
            "narrator_zh": "（选项）"
        },
        {
            "location": "68/SEL",
            "narrator": "（選択肢）",
            "text": "うん、わかる気がする",
            "zh": "嗯，感觉我能理解",
            "narrator_zh": "（选项）"
        },
        {
            "location": "69/ACT",
            "narrator": "",
            "text": "今のガブリエラが最高に可愛い",
            "zh": "现在的加布里埃拉才是最可爱的",
            "narrator_zh": ""
        },
        {
            "location": "72/TALK",
            "narrator": "ガブリエラ",
            "text": "かき氷の話をしているのよ？",
            "zh": "我们现在可是在聊刨冰好不好？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "74/TALK",
            "narrator": "ガブリエラ",
            "text": "マルザンナは",
            "zh": "玛尔赞娜真是的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "75/TALK",
            "narrator": "ガブリエラ",
            "text": "いつも私しか見ていないのね？",
            "zh": "眼睛里就总是只看着我呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "76/TALK",
            "narrator": "ガブリエラ",
            "text": "あまりいいとは言えないわ",
            "zh": "这可算不上什么好习惯哦",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "79/TALK",
            "narrator": "ガブリエラ",
            "text": "だからって",
            "zh": "话虽如此",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "80/TALK",
            "narrator": "ガブリエラ",
            "text": "嫌ではないけど///////",
            "zh": "我也并不讨厌就是了///////",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "81/ACT",
            "narrator": "",
            "text": "うん、わかる気がする",
            "zh": "嗯，感觉我能理解",
            "narrator_zh": ""
        },
        {
            "location": "82/TALK",
            "narrator": "ガブリエラ",
            "text": "わかってくれると思ってたわ",
            "zh": "我就知道你能理解",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "84/TALK",
            "narrator": "ガブリエラ",
            "text": "マルザンナとも",
            "zh": "真希望总有一天",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "85/TALK",
            "narrator": "ガブリエラ",
            "text": "いつか一緒にかき氷食べたいわ",
            "zh": "也能和玛尔赞娜一起吃刨冰呀",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "86/SEL",
            "narrator": "（選択肢）",
            "text": "その時はガブリエラのを一口もらう",
            "zh": "到时候分我一口加布里埃拉的吧",
            "narrator_zh": "（选项）"
        },
        {
            "location": "87/SEL",
            "narrator": "（選択肢）",
            "text": "海で？　もちろん水着だよね？",
            "zh": "在海边？　那当然是穿泳衣对吧？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "88/ACT",
            "narrator": "",
            "text": "その時はガブリエラのを一口もらう",
            "zh": "到时候分我一口加布里埃拉的吧",
            "narrator_zh": ""
        },
        {
            "location": "89/TALK",
            "narrator": "ガブリエラ",
            "text": "一緒に食べれば",
            "zh": "一起吃的话",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "90/TALK",
            "narrator": "ガブリエラ",
            "text": "二人で違う味頼めるものね",
            "zh": "两个人就能点不同的口味了嘛",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "92/TALK",
            "narrator": "ガブリエラ",
            "text": "でも",
            "zh": "不过",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "93/TALK",
            "narrator": "ガブリエラ",
            "text": "多分私",
            "zh": "我大概",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "95/TALK",
            "narrator": "ガブリエラ",
            "text": "三つくらい頼んじゃうと思うけど",
            "zh": "会一下子点上三份左右就是了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "96/ACT",
            "narrator": "",
            "text": "海で？　もちろん水着だよね？",
            "zh": "在海边？　那当然是穿泳衣对吧？",
            "narrator_zh": ""
        },
        {
            "location": "99/TALK",
            "narrator": "ガブリエラ",
            "text": "気のせい？",
            "zh": "是我的错觉吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "101/TALK",
            "narrator": "ガブリエラ",
            "text": "なんだか目的変わってる気がするんだけど",
            "zh": "总觉得你的目的好像歪掉了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "102/TALK",
            "narrator": "ガブリエラ",
            "text": "そんなことないわよね？",
            "zh": "不会是那样吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "105/TALK",
            "narrator": "ガブリエラ",
            "text": "かき氷なくなっちゃう",
            "zh": "刨冰快吃完了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "106/TALK",
            "narrator": "ガブリエラ",
            "text": "次は",
            "zh": "下一份",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "107/TALK",
            "narrator": "ガブリエラ",
            "text": "どの味にしようかしら？",
            "zh": "选什么口味好呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "108/SEL",
            "narrator": "（選択肢）",
            "text": "そろそろ温かいもの食べよう",
            "zh": "差不多吃点热乎的东西吧",
            "narrator_zh": "（选项）"
        },
        {
            "location": "109/SEL",
            "narrator": "（選択肢）",
            "text": "オーソドックスにイチゴとか？",
            "zh": "来个经典的草莓味怎么样？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "110/ACT",
            "narrator": "",
            "text": "そろそろ温かいものを食べよう",
            "zh": "差不多吃点热乎的东西吧",
            "narrator_zh": ""
        },
        {
            "location": "113/TALK",
            "narrator": "ガブリエラ",
            "text": "まだ平気よ",
            "zh": "还早着呢，没事的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "114/TALK",
            "narrator": "ガブリエラ",
            "text": "身体だって",
            "zh": "身体也",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "115/TALK",
            "narrator": "ガブリエラ",
            "text": "全然冷えてないし",
            "zh": "完全不觉得冷嘛",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "116/ACT",
            "narrator": "",
            "text": "オーソドックスにイチゴとか？",
            "zh": "来个经典的草莓味怎么样？",
            "narrator_zh": ""
        },
        {
            "location": "119/TALK",
            "narrator": "ガブリエラ",
            "text": "一番シンプルね",
            "zh": "最简单纯粹呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "120/TALK",
            "narrator": "ガブリエラ",
            "text": "でも",
            "zh": "不过",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "121/TALK",
            "narrator": "ガブリエラ",
            "text": "安心する甘さよね/////",
            "zh": "是让人很安心的甜味呢/////",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "122/TALK",
            "narrator": "ガブリエラ",
            "text": "つばめにも",
            "zh": "要不要也分给燕",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "123/TALK",
            "narrator": "ガブリエラ",
            "text": "一口上げようかしら？",
            "zh": "尝一口呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "125/TALK",
            "narrator": "ガブリエラ",
            "text": "それじゃ二杯目買ってくるわ",
            "zh": "那我去买第二碗了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "127/TALK",
            "narrator": "ガブリエラ",
            "text": "食べ終わったら",
            "zh": "等我吃完之后",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "128/TALK",
            "narrator": "ガブリエラ",
            "text": "またお話しましょ",
            "zh": "再聊吧",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "135/TALK",
            "narrator": "透明つばめ",
            "text": "美味しかったー。\nお腹いっぱいだよ。",
            "zh": "好好吃呀——。\n肚子吃得饱饱的啦。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "137/TALK",
            "narrator": "透明神楽",
            "text": "ふふっ、つばめさんって、\nどこでも美味しそうに\n食べますよね？",
            "zh": "呵呵，燕无论在\n哪里吃饭，都吃得\n好香呢？",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "138/TALK",
            "narrator": "透明つばめ",
            "text": "だって、本当にとっても\n美味しくて――",
            "zh": "因为，真的特别\n好吃嘛——",
            "narrator_zh": "透明燕"
        },
        {
            "location": "142/TALK",
            "narrator": "透明つばめ",
            "text": "って、ガブちゃん！\nまだかき氷食べてたの！？",
            "zh": "咦、加布！\n你还在吃刨冰呀！？",
            "narrator_zh": "透明燕"
        },
        {
            "location": "143/TALK",
            "narrator": "透明ガブリエラ",
            "text": "…これで最後にするわよ。",
            "zh": "……吃完这碗就是最后一碗了。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "144/TALK",
            "narrator": "透明神楽",
            "text": "ガブちゃん…もしかして、\nかき氷食べ過ぎて\n寒いんじゃ…。",
            "zh": "加布……你是不是\n刨冰吃太多，\n觉得冷了……",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "145/TALK",
            "narrator": "透明ガブリエラ",
            "text": "きゅ、急に来たのよ…。\nこれ食べるまでは、\nそんなこと――",
            "zh": "突、突然冷起来的嘛……\n在吃这碗之前，\n根本没有那种事——",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "149/TALK",
            "narrator": "透明ガブリエラ",
            "text": "ッ！？",
            "zh": "唔！？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "150/TALK",
            "narrator": "透明神楽",
            "text": "あっ！",
            "zh": "啊！",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "151/TALK",
            "narrator": "透明ガブリエラ",
            "text": "うっ…くぅーっ！\nあ、頭に…、\n頭に、キーンッ、って…。",
            "zh": "呜……唔呃！\n脑、脑袋……\n脑袋“嗡”地一下冰得直刺痛……",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "152/TALK",
            "narrator": "透明神楽",
            "text": "こんなに食べるまで\nなかったのが奇跡ですよ。",
            "zh": "吃了这么多才发作，\n简直是奇迹了。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "153/TALK",
            "narrator": "透明つばめ",
            "text": "わたし、温かいお茶\n買ってくるね。",
            "zh": "我去买杯热茶\n回来哦。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "154/TALK",
            "narrator": "透明神楽",
            "text": "もぅ、美味しいのは\nわかりますけど、\n限度を考えてくださいね？",
            "zh": "真是的，虽然我也知道\n刨冰好吃，但好歹\n考虑一下限度好吗？",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "156/TALK",
            "narrator": "透明ガブリエラ",
            "text": "うぅ…せ、説教は\n痛みが治まってからに\nしなさいよ…。",
            "zh": "呜……说、说教\n等我头不痛了\n再说啦……",
            "narrator_zh": "透明加布里埃拉"
        }
    ]
}
