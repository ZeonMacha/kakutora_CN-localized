{
    "dir": "chap11/daydra/dd_ch03_11_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "11356",
        "cid": "gabriella",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "片づけようか",
        "title_zh": "Extra006 额外剧情",
        "sub_title_zh": "来收拾一下吧"
    },
    "entry": [
        {
            "location": "295/SCENARIO",
            "narrator": "",
            "text": "片付けようか",
            "zh": "来收拾一下吧",
            "narrator_zh": ""
        },
        {
            "location": "315/TALK",
            "narrator": "神楽",
            "text": "楽屋の小物、\nかなり増えてきましたね。",
            "zh": "休息室里的小物件，\n变得相当多了呢。",
            "narrator_zh": "神乐"
        },
        {
            "location": "318/TALK",
            "narrator": "つばめ",
            "text": "卯月さんもそう思う？",
            "zh": "卯月你也这么觉得吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "319/TALK",
            "narrator": "つばめ",
            "text": "最近ね、小物が多過ぎて\n掃除するのが大変なの。",
            "zh": "最近呀，小物件太多了\n打扫起来可费劲啦。",
            "narrator_zh": "燕"
        },
        {
            "location": "323/TALK",
            "narrator": "ガブリエラ",
            "text": "つばめ、文句ばっか\n言ってないで\n手を動かしなさい。",
            "zh": "燕，别光顾着抱怨，\n赶紧把手脚\n动起来。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "325/TALK",
            "narrator": "つばめ",
            "text": "動かしたいけど、\nガブちゃんの小物が\n多過ぎて…。",
            "zh": "我也想动呀，\n可是加布的小物件\n实在是太多了…。",
            "narrator_zh": "燕"
        },
        {
            "location": "326/TALK",
            "narrator": "ガブリエラ",
            "text": "だから、文句を…！",
            "zh": "所以说，别抱怨…！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "329/TALK",
            "narrator": "神楽",
            "text": "仕方ないですよ、\nつばめさん。",
            "zh": "这也是没办法的事呀，\n燕。",
            "narrator_zh": "神乐"
        },
        {
            "location": "331/TALK",
            "narrator": "神楽",
            "text": "だってガブちゃんは、\n片付けられない女、\nっていうやつですから。",
            "zh": "因为加布就是那种\n所谓“不会收拾的女人”\n嘛。",
            "narrator_zh": "神乐"
        },
        {
            "location": "334/TALK",
            "narrator": "ガブリエラ",
            "text": "誰が片付けられない\n女よ！？",
            "zh": "谁是不会收拾的\n女人啊！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "337/TALK",
            "narrator": "神楽",
            "text": "だって、何でもかんでも\n置きっぱなしになってる\nじゃないですか。",
            "zh": "你看，不管什么东西都\n随手乱放着\n不是吗。",
            "narrator_zh": "神乐"
        },
        {
            "location": "338/TALK",
            "narrator": "神楽",
            "text": "これじゃどう見ても\n片付けられない女です。",
            "zh": "这怎么看都属于\n不会收拾的女人吧。",
            "narrator_zh": "神乐"
        },
        {
            "location": "340/TALK",
            "narrator": "神楽",
            "text": "ね、つばめさん？",
            "zh": "对吧，燕？",
            "narrator_zh": "神乐"
        },
        {
            "location": "344/TALK",
            "narrator": "つばめ",
            "text": "えっ！？　う、うん…\nちょっと、そう思われても\n仕方ないかも。",
            "zh": "咦！？　嗯、嗯…\n稍微有点，被这么认为\n好像也没办法呢。",
            "narrator_zh": "燕"
        },
        {
            "location": "347/TALK",
            "narrator": "ガブリエラ",
            "text": "…言ってくれるじゃない。",
            "zh": "…还真敢说啊你们。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "351/TALK",
            "narrator": "ガブリエラ",
            "text": "そんなに言うなら、\nあんた達が驚くくらい\n綺麗に片付けてやるわ。",
            "zh": "既然你们这么说，\n我就收拾得干干净净，\n让你们大吃一惊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "352/TALK",
            "narrator": "ガブリエラ",
            "text": "こう見えても、整理整頓は\n得意なんだから。",
            "zh": "别看我这样，整理收纳\n我可是很擅长的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "355/TALK",
            "narrator": "つばめ",
            "text": "本当！？\nそれ、凄く助かるよ！",
            "zh": "真的吗！？\n那可真是帮大忙了！",
            "narrator_zh": "燕"
        },
        {
            "location": "358/TALK",
            "narrator": "ガブリエラ",
            "text": "ふん、これくらい…。",
            "zh": "哼，这点小事…。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "359/TALK",
            "narrator": "ガブリエラ",
            "text": "って、冷静に見てみると\nかなり多いかも…。",
            "zh": "不对，冷静下来仔细一看，\n好像确实有点多…。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "360/TALK",
            "narrator": "ガブリエラ",
            "text": "こんなに沢山の小物、\n部屋に飾れないわ。",
            "zh": "这么多小物件，\n我房间里摆不下啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "372/TALK",
            "narrator": "ガブリエラ",
            "text": "どうしましょう、マルザンナ",
            "zh": "怎么办呀，玛尔赞娜",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "374/TALK",
            "narrator": "ガブリエラ",
            "text": "楽屋の小物を片付けるって言ったんだけど",
            "zh": "我刚才嘴硬说要把休息室的小物件收拾掉",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "375/TALK",
            "narrator": "ガブリエラ",
            "text": "思ったより置いてある小物が多かったの",
            "zh": "结果摆在那儿的小物件比我想象的还要多",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "376/TALK",
            "narrator": "ガブリエラ",
            "text": "これじゃ、私の部屋に飾りきれないわ",
            "zh": "这么多东西，我房间里根本摆不下",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "378/SEL",
            "narrator": "",
            "text": "ダンボールに仕舞っておこう",
            "zh": "先装进纸箱里收起来吧",
            "narrator_zh": ""
        },
        {
            "location": "379/SEL",
            "narrator": "",
            "text": "少し捨てるのは？",
            "zh": "稍微扔掉一点呢？",
            "narrator_zh": ""
        },
        {
            "location": "380/SEL",
            "narrator": "",
            "text": "映画館中に飾ろう",
            "zh": "摆到电影院各处去吧",
            "narrator_zh": ""
        },
        {
            "location": "381/ACT",
            "narrator": "",
            "text": "ダンボールに仕舞っておこう",
            "zh": "先装进纸箱里收起来吧",
            "narrator_zh": ""
        },
        {
            "location": "382/TALK",
            "narrator": "ガブリエラ",
            "text": "ダメよ！",
            "zh": "不行！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "383/TALK",
            "narrator": "ガブリエラ",
            "text": "インテリアとして置いて\nあるんだから",
            "zh": "那些本来就是作为装饰\n才摆出来的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "384/TALK",
            "narrator": "ガブリエラ",
            "text": "箱に入れたら意味がないじゃない！",
            "zh": "塞进箱子里不就没意义了吗！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "385/TALK",
            "narrator": "ガブリエラ",
            "text": "もう、マルザンナってば\nわかってないんだから…",
            "zh": "真是的，玛尔赞娜你呀\n根本不懂嘛…",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "386/TALK",
            "narrator": "ガブリエラ",
            "text": "自分で考えるわ",
            "zh": "我自己想办法",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "398/TALK",
            "narrator": "ガブリエラ",
            "text": "…とはいったものの、\n本当にこれだけの小物を\nどうするか…。",
            "zh": "…虽说是这么说了，\n这么多小物件到底该\n怎么办才好…。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "399/TALK",
            "narrator": "つばめ",
            "text": "ガブちゃん、\nこれ用意したから\n使ってみて。",
            "zh": "加布，\n我准备了这个，\n你用这个装吧。",
            "narrator_zh": "燕"
        },
        {
            "location": "402/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょ、やめてよ！\nダンボールになんて\n入れたくないわ。",
            "zh": "等、别这样！\n我才不想塞进\n纸箱里呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "405/TALK",
            "narrator": "つばめ",
            "text": "でも、いっぱいあるから\n手で部屋に持ってくのは\n無理じゃないかな？",
            "zh": "可是，东西这么多，\n光靠手捧着带回房间\n不太可能吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "408/TALK",
            "narrator": "ガブリエラ",
            "text": "そ、それはそうだけど…。",
            "zh": "这、话是这么说没错…。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "409/TALK",
            "narrator": "神楽",
            "text": "まあ、持って行く方法は\n何でもいいですけど――",
            "zh": "嘛，用什么方式拿走\n倒都无所谓——",
            "narrator_zh": "神乐"
        },
        {
            "location": "410/TALK",
            "narrator": "神楽",
            "text": "片付けられると言ったん\nですから、ちゃんと\n片付けてくださいね。",
            "zh": "既然你都放话能收拾好，\n那就请好好收拾\n干净哦。",
            "narrator_zh": "神乐"
        },
        {
            "location": "413/TALK",
            "narrator": "ガブリエラ",
            "text": "くっ…わ、わかったわよ。\nダンボールに入れるわよ。",
            "zh": "唔…我、我知道了啦。\n放进纸箱里就是了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "416/TALK",
            "narrator": "ガブリエラ",
            "text": "今だけは我慢するしか\nなさそう…。",
            "zh": "现在看来也只能先忍忍\n了…。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "417/TALK",
            "narrator": "ガブリエラ",
            "text": "ごめんね、ほとぼりが\n冷めたらまたこの部屋に\n戻してあげるからね。",
            "zh": "抱歉啦，等风头\n过去之后，我再把你们\n摆回这间屋子里哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "418/ACT",
            "narrator": "",
            "text": "少し捨てるのは？",
            "zh": "稍微扔掉一点呢？",
            "narrator_zh": ""
        },
        {
            "location": "429/TALK",
            "narrator": "ガブリエラ",
            "text": "ダメよ、捨てるなんて！",
            "zh": "不行，怎么能扔掉！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "431/TALK",
            "narrator": "ガブリエラ",
            "text": "どれもこれも素敵なものなんだから",
            "zh": "每一件都是很棒的宝贝",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "432/TALK",
            "narrator": "ガブリエラ",
            "text": "捨てられるものなんて存在しないの！",
            "zh": "根本不存在能扔掉的东西！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "443/TALK",
            "narrator": "ガブリエラ",
            "text": "失礼しちゃうわ、\nまったく…。",
            "zh": "太失礼了，\n真是的…。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "445/TALK",
            "narrator": "つばめ",
            "text": "ガブちゃん、これって\n本当に取っておく\n必要あるの？",
            "zh": "加布，这些东西\n真的有必要一直\n留着吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "446/TALK",
            "narrator": "つばめ",
            "text": "萎みきった水風船とか\n見つけたんですけど…。",
            "zh": "我还翻出了彻底瘪掉的\n水气球之类的东西…。",
            "narrator_zh": "燕"
        },
        {
            "location": "449/TALK",
            "narrator": "ガブリエラ",
            "text": "えっ？",
            "zh": "咦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "451/TALK",
            "narrator": "神楽",
            "text": "この棒って…あ、風車の\n羽根が取れちゃってる\nみたいですね。",
            "zh": "这根棍子…啊，好像是\n风车的叶片掉光了\n呢。",
            "narrator_zh": "神乐"
        },
        {
            "location": "452/TALK",
            "narrator": "つばめ",
            "text": "プラスチックの\n割れたお面は危ないと\n思うよ？",
            "zh": "破掉的塑料\n面具我觉得很危险\n哦？",
            "narrator_zh": "燕"
        },
        {
            "location": "455/TALK",
            "narrator": "ガブリエラ",
            "text": "…こんなもの、あたし\n拾ってきたっけ？",
            "zh": "…这种东西，我有\n捡回来过吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "456/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、なんとなくだけど\n見覚えがあるような…。",
            "zh": "不过，隐隐约约的\n好像又有点印象…。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "457/TALK",
            "narrator": "つばめ",
            "text": "あの、どうする？\n部屋に持ってくなら\n手伝うけど…。",
            "zh": "那个，怎么办？\n要拿回房间的话\n我可以帮忙…。",
            "narrator_zh": "燕"
        },
        {
            "location": "459/TALK",
            "narrator": "ガブリエラ",
            "text": "…よくわからないものは、\nおもいきって捨てるわ。",
            "zh": "…搞不清来历的东西，\n就干脆地扔掉吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "462/TALK",
            "narrator": "ガブリエラ",
            "text": "何でもかんでも持ってくる\nのは、少し控えよう。",
            "zh": "以后不能什么都往回拿，\n得稍微克制一下了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "479/ACT",
            "narrator": "",
            "text": "映画館中に飾ろう",
            "zh": "摆到电影院各处去吧",
            "narrator_zh": ""
        },
        {
            "location": "481/TALK",
            "narrator": "ガブリエラ",
            "text": "それよ！！",
            "zh": "就是这个！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "482/TALK",
            "narrator": "ガブリエラ",
            "text": "それなら置き場所に困らないわ",
            "zh": "那样就不愁没地方放了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "483/TALK",
            "narrator": "ガブリエラ",
            "text": "さすがだわ、マルザンナ！",
            "zh": "不愧是你，玛尔赞娜！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "496/TALK",
            "narrator": "ガブリエラ",
            "text": "それじゃあ、映画館中に\n配置してくるわ。",
            "zh": "那我就去把它们\n布置到电影院各处了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "499/TALK",
            "narrator": "つばめ",
            "text": "えっ！？\n片づけるんじゃ\nないの？",
            "zh": "咦！？\n不是要收拾\n起来吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "500/TALK",
            "narrator": "ガブリエラ",
            "text": "散らかって見えるのは、\n楽屋が小さいからよ。",
            "zh": "之所以看起来乱，\n是因为休息室太小了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "501/TALK",
            "narrator": "ガブリエラ",
            "text": "広い映画館のあちこちに\n配置すれば、そんな風には\n見えないはずよ！",
            "zh": "只要布置到宽敞的电影院\n各个角落，看起来肯定\n就不会这样了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "502/TALK",
            "narrator": "ガブリエラ",
            "text": "きっと見た人達から、\n素敵なインテリアね、って\n思われるわ。",
            "zh": "看过的人肯定都会觉得\n“真是很棒的室内装潢呢”\n的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "504/TALK",
            "narrator": "つばめ",
            "text": "…そ、そうかなぁ？",
            "zh": "…真、真的会这样吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "505/TALK",
            "narrator": "神楽",
            "text": "ボロボロ過ぎて、わけの\nわからなくなった物も\nあるんですけど…。",
            "zh": "还有些东西已经破破烂烂到\n完全看不出原本是啥了\n呢…。",
            "narrator_zh": "神乐"
        },
        {
            "location": "506/TALK",
            "narrator": "ガブリエラ",
            "text": "大丈夫だってば。\nあたしを信じなさい！",
            "zh": "我都说了没问题。\n相信我就好！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "509/TALK",
            "narrator": "神楽",
            "text": "…お客さんに、\nゴミと間違われなければ\nいいけど。",
            "zh": "…只要不被客人\n当成垃圾就好\n了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "511/TALK",
            "narrator": "つばめ",
            "text": "それより、アーヤさんや\n真幌さんが怒るのが先だと\n思うなぁ…。",
            "zh": "比起那个，我觉得绫水和\n真幌会先发火\n呢…。",
