    "entry": [
        {
            "location": "21/TALK",
            "narrator": "透明アーヤ",
            "text": "さて、らんちゅうさん。\nこれをかき混ぜて\nもらえる？",
            "zh": "那么，兰寿小姐。\n这个，能帮我\n搅拌吗？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "22/TALK",
            "narrator": "透明らんちゅうさん",
            "text": "わ、わかったよ～…。",
            "zh": "好、知道了……",
            "narrator_zh": "透明兰寿小姐"
        },
        {
            "location": "24/TALK",
            "narrator": "透明アーヤ",
            "text": "って、まだそっちの\n作業が\n終わってなかったのね…。",
            "zh": "咦，你那边的\n工作\n还没做完啊……",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "25/TALK",
            "narrator": "透明らんちゅうさん",
            "text": "ごめんなさい…。\n私、ゆっくり\nしすぎてて…。",
            "zh": "对不起……\n我做得\n太慢了……",
            "narrator_zh": "透明兰寿小姐"
        },
        {
            "location": "27/TALK",
            "narrator": "透明アーヤ",
            "text": "ううん、大丈夫よ。\n慌てないで\nゆっくりやってね。",
            "zh": "不，没关系。\n别着急，\n慢慢来。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "28/SEL",
            "narrator": "（選択肢）",
            "text": "らんちゅうさんとチョコ作り？",
            "zh": "在和兰寿小姐做巧克力？",
            "narrator_zh": "（选项）"
