    "entry": [
        {
            "location": "2604/DIALOG",
            "narrator": "",
            "text": "<color=green>某月某日　1:26 PM</color>\nとある休日、神楽坂トライナリー楽屋にて。",
            "zh": "<color=green>某月某日　1:26 PM</color>\n某个休息日，在神乐坂三重奏后台。",
            "narrator_zh": ""
        },
        {
            "location": "2605/TALK",
            "narrator": "神楽",
            "text": "――じゃあ、カフェの\nメニューはこれで\n決定としますね。",
            "zh": "——那么，咖啡馆的\n菜单就这样\n定下来了哦。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2606/TALK",
            "narrator": "アーヤ",
            "text": "ええ、わかったわ。",
            "zh": "嗯，知道了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "2607/TALK",
            "narrator": "みやび",
            "text": "ふぅ…、思うてたより\n長い道のりやったなぁ…。",
            "zh": "呼……比我想的\n还要折腾好久呐……",
            "narrator_zh": "雅"
        },
        {
            "location": "2609/TALK",
            "narrator": "神楽",
            "text": "二人とも、本当に\nお疲れ様でした。",
            "zh": "两位，真是\n辛苦啦。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2610/TALK",
            "narrator": "神楽",
            "text": "メニュー表は私の方で\n作成しておきますので、\nあとは任せてください。",
            "zh": "菜单牌就由我\n这边来制作吧，\n剩下的交给我好了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2611/TALK",
            "narrator": "みやび",
            "text": "よろしゅうな。",
            "zh": "那就麻烦你咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "2612/TALK",
            "narrator": "アーヤ",
            "text": "さてと、それじゃ私は\n先に上がらせてもらうわ。",
            "zh": "好啦，那我就\n先走一步了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "2613/TALK",
            "narrator": "神楽",
            "text": "珍しいですね。\nアーヤさんが先に\n上がるなんて…。",
            "zh": "真难得呢。\n绫水居然会\n先一步收工……",
            "narrator_zh": "神乐"
        },
        {
            "location": "2616/TALK",
            "narrator": "みやび",
            "text": "わかった、デートやろ？",
            "zh": "我懂，是去约会咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "2617/TALK",
            "narrator": "アーヤ",
            "text": "そんなわけないでしょ。\nちょっとやることがある\nだけよ。",
            "zh": "怎么可能呢。\n只不过有点事\n要做罢了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "2618/TALK",
            "narrator": "みやび",
            "text": "…そんなわけない\nっちゅう返しは、\nちくっと寂しいがよ。",
            "zh": "……直接回一句\n“怎么可能”，\n听着有点冷清咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "2619/TALK",
            "narrator": "神楽",
            "text": "そうですね…。",
            "zh": "就是啊……",
            "narrator_zh": "神乐"
        },
        {
            "location": "2620/TALK",
            "narrator": "アーヤ",
            "text": "お、大きなお世話よ。\nそういうわけだから、\nお先にね。",
            "zh": "多、多管闲事。\n总之就是这么回事，\n我先走啦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "2637/TALK",
            "narrator": "アーヤ",
            "text": "よし…できた！",
            "zh": "好……做好了！",
            "narrator_zh": "绫水"
        },
        {
            "location": "2638/TALK",
            "narrator": "アーヤ",
            "text": "思ったより時間が\n掛かっちゃったけど…。",
            "zh": "虽然比预想中\n多花了些时间……",
            "narrator_zh": "绫水"
        },
