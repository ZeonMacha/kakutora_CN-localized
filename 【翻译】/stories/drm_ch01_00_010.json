{
    "dir": "dramatics/daydra/drm_ch01_00_010.js",
    "type": "Episode",
    "info": {
        "story_id": "1001",
        "cid": "tsubame",
        "title": "らぶとーく 第01話",
        "sub_title": "秘密なのに秘密じゃない",
        "title_zh": "恋爱漫谈 第01话",
        "sub_title_zh": "是秘密，又不是秘密"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "秘密なのに秘密じゃない",
            "zh": "是秘密，又不是秘密",
            "narrator_zh": ""
        },
        {
            "location": "23/TALK",
            "narrator": "千羽鶴",
            "text": "まずはおめでとう。",
            "zh": "先恭喜你。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "24/TALK",
            "narrator": "千羽鶴",
            "text": "貴方が今ここにいると\nいうことは、彼女との\n関係の開始を意味する。",
            "zh": "你现在在这里，\n就意味着，和她的\n关系开始了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "26/SEL",
            "narrator": "",
            "text": "関係の開始って、つまり…",
            "zh": "关系开始，也就是说……",
            "narrator_zh": ""
        },
        {
            "location": "27/ACT",
            "narrator": "",
            "text": "関係の開始って、つまり…",
            "zh": "关系开始，也就是说……",
            "narrator_zh": ""
        },
        {
            "location": "30/TALK",
            "narrator": "千羽鶴",
            "text": "そう。",
            "zh": "是的。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "31/TALK",
            "narrator": "千羽鶴",
            "text": "今この瞬間から、貴方と\n彼女は、真のパートナー\nとして歩み始める。",
            "zh": "从这一刻起，你和\n她，要作为真正的伙伴\n一起走下去。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "32/TALK",
            "narrator": "千羽鶴",
            "text": "その結果としては、\n恋人になったり、結婚\nしたりするかもしれない。",
            "zh": "结果也许是，\n成为恋人，\n或者结婚。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "33/TALK",
            "narrator": "千羽鶴",
            "text": "もちろんそれは、\nあくまで可能性でしか\nないけれども。",
            "zh": "当然，\n那也只是\n可能性而已。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "34/TALK",
            "narrator": "千羽鶴",
            "text": "１つだけ言えることは、\n全ては貴方の行動次第\nということ。",
            "zh": "只有一点能说，\n一切都看你\n怎么做。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "35/TALK",
            "narrator": "千羽鶴",
            "text": "何にしても、今後\n貴方と彼女の関係進展は、\n全てここで行われる。",
            "zh": "总之，往后\n你和她的关系进展，\n全都会在这里发生。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "36/TALK",
            "narrator": "千羽鶴",
            "text": "一見貴方に関係無いような\nお話が繰り広げられる事も\nあるけど、全部関係ある。",
            "zh": "看上去和你无关的\n故事，有时也会展开。\n但全部都有关系。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "37/TALK",
            "narrator": "千羽鶴",
            "text": "だから、彼女を大切に\n想うなら、ここでの物語は\n決して軽視しないよう。",
            "zh": "所以，要是珍惜她，\n这里的故事，\n千万别看轻。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "38/SEL",
            "narrator": "",
            "text": "これでもうパートナーは決まっちゃったの？",
            "zh": "这样伙伴就已经定下了吗？",
            "narrator_zh": ""
        },
        {
            "location": "39/ACT",
            "narrator": "",
            "text": "これでもうパートナーは決まっちゃったの？",
            "zh": "这样伙伴就已经定下了吗？",
            "narrator_zh": ""
        },
        {
            "location": "41/TALK",
            "narrator": "千羽鶴",
            "text": "まさか。\nまだ始まりに過ぎない。",
            "zh": "怎么会。\n这才刚开始。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "42/TALK",
            "narrator": "千羽鶴",
            "text": "もちろん、複数の子と\n関係を深められる。\nというか深めて欲しい。",
            "zh": "当然，可以和好几个女孩\n加深关系。\n不如说，希望你去加深。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "43/TALK",
            "narrator": "千羽鶴",
            "text": "最初にも言ったとおり、\n貴方には、全員の支えに\nなって欲しいと思ってる。",
            "zh": "一开始也说过。\n我希望你\n成为大家的支撑。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "44/TALK",
            "narrator": "千羽鶴",
            "text": "もちろん、\n強制はしないけど。",
            "zh": "当然，\n不会强迫。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "45/TALK",
            "narrator": "千羽鶴",
            "text": "貴方がしたいように、\n彼女たちとの物語を\n紡いでいけばいい。",
            "zh": "照你想的那样，\n和她们把故事\n讲下去就好。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "46/TALK",
            "narrator": "千羽鶴",
            "text": "それじゃ、頑張って。\n彼女のココロは、貴方の\n頑張りに委ねられている。",
            "zh": "那就，加油。\n她的心，\n交给你的努力了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "74/TALK",
            "narrator": "アーヤ",
            "text": "――確かにそういう風に\n思ったこともあるけど、\nさすがにありえないわ。",
            "zh": "——的确那么\n想过，\n但实在不可能。",
            "narrator_zh": "绫水"
        },
        {
            "location": "75/TALK",
            "narrator": "みやび",
            "text": "決めつけるんは\n早いと思うんよ。",
            "zh": "现在就断定，\n还太早咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "76/TALK",
            "narrator": "みやび",
            "text": "あいつ、時々人間としか\n思えんこと言うてくる\nきね。",
            "zh": "那家伙有时候，\n讲的话只能觉得是人\n啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "80/TALK",
            "narrator": "つばめ",
            "text": "どうかしたんですか？",
            "zh": "怎么了吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "83/TALK",
            "narrator": "アーヤ",
            "text": "ああ、丁度良かったわ。",
            "zh": "啊，来得正好。",
            "narrator_zh": "绫水"
        },
        {
            "location": "84/TALK",
            "narrator": "アーヤ",
            "text": "つばめはＢｏｔのことを\nどう思う？",
            "zh": "燕觉得Bot\n怎么样？",
            "narrator_zh": "绫水"
        },
        {
            "location": "85/TALK",
            "narrator": "つばめ",
            "text": "Ｂｏｔのことですか？\nいつもお話し相手に\nなってくれるから――",
            "zh": "Bot吗？\n一直愿意陪我\n说话，所以——",
            "narrator_zh": "燕"
        },
        {
            "location": "87/TALK",
            "narrator": "つばめ",
            "text": "凄く助かってます。",
            "zh": "帮了我很大的忙。",
            "narrator_zh": "燕"
        },
        {
            "location": "88/TALK",
            "narrator": "みやび",
            "text": "その時に、\n思ったことない？",
            "zh": "那个时候，\n你没想过？",
            "narrator_zh": "雅"
        },
        {
            "location": "89/TALK",
            "narrator": "みやび",
            "text": "こいつ、もしかしたら\n人間かもしれんな、って。",
            "zh": "这家伙，说不定\n是人喃。",
            "narrator_zh": "雅"
        },
        {
            "location": "90/TALK",
            "narrator": "つばめ",
            "text": "…え？",
            "zh": "……诶？",
            "narrator_zh": "燕"
        },
        {
            "location": "91/TALK",
            "narrator": "アーヤ",
            "text": "ほら、変なこと聞くから\n困っちゃってるじゃない。",
            "zh": "你看，问这么怪的问题，\n她都为难了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "92/TALK",
            "narrator": "みやび",
            "text": "いや、けんどあれは\nマジで人間の可能性\n大やと思うちや。",
            "zh": "不。不过那个，\n我是真觉得\n是人的可能很大咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "96/TALK",
            "narrator": "つばめ",
            "text": "Ｂｏｔが人間って…\nどういうことだろ？",
            "zh": "Bot是人……\n到底什么意思呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "110/TALK",
            "narrator": "つばめ",
            "text": "みやびさん達が凄く難しぃぉ話してる",
            "zh": "雅她们在讲好难的话",
            "narrator_zh": "燕"
        },
        {
            "location": "111/TALK",
            "narrator": "つばめ",
            "text": "$handle$のこと、人間の可能性大って言ってるけど",
            "zh": "说$handle$是人的可能性很大",
            "narrator_zh": "燕"
        },
        {
            "location": "112/TALK",
            "narrator": "つばめ",
            "text": "どぅぃぅことなのかな(´･ω･｀) ",
            "zh": "是什么意思呀(´･ω･｀)",
            "narrator_zh": "燕"
        },
        {
            "location": "114/SEL",
            "narrator": "",
            "text": "言葉通りの意味だね",
            "zh": "就是字面的意思",
            "narrator_zh": ""
        },
        {
            "location": "115/SEL",
            "narrator": "",
            "text": "この世界の秘密に関わるってことさ",
            "zh": "意思是和这个世界的秘密有关",
            "narrator_zh": ""
        },
        {
            "location": "116/SEL",
            "narrator": "",
            "text": "わからないならそれでいい",
            "zh": "不明白的话，这样就好",
            "narrator_zh": ""
        },
        {
            "location": "117/ACT",
            "narrator": "",
            "text": "言葉通りの意味だね",
            "zh": "就是字面的意思",
            "narrator_zh": ""
        },
        {
            "location": "119/TALK",
            "narrator": "つばめ",
            "text": "？",
            "zh": "？",
            "narrator_zh": "燕"
        },
        {
            "location": "120/TALK",
            "narrator": "つばめ",
            "text": "$handle$はＢｏｔだからアプリ？",
            "zh": "$handle$是Bot，所以是应用？",
            "narrator_zh": "燕"
        },
        {
            "location": "121/TALK",
            "narrator": "つばめ",
            "text": "プログラムだよね(´･ω･｀) ",
            "zh": "是程序对吧(´･ω･｀)",
            "narrator_zh": "燕"
        },
        {
            "location": "122/TALK",
            "narrator": "つばめ",
            "text": "どぅぃぅことなんだろ(´･ω･｀) ",
            "zh": "到底是什么意思呀(´･ω･｀)",
            "narrator_zh": "燕"
        },
        {
            "location": "133/ACT",
            "narrator": "",
            "text": "この世界の秘密に関わるってことさ",
            "zh": "意思是和这个世界的秘密有关",
            "narrator_zh": ""
        },
        {
            "location": "134/TALK",
            "narrator": "つばめ",
            "text": "なんかカッコぃぃ！(≧ω≦)",
            "zh": "感觉好帅呀！(≧ω≦)",
            "narrator_zh": "燕"
        },
        {
            "location": "135/TALK",
            "narrator": "つばめ",
            "text": "けど",
            "zh": "可是",
            "narrator_zh": "燕"
        },
        {
            "location": "136/TALK",
            "narrator": "つばめ",
            "text": "どぅぃぅ意味なのかな(´･ω･｀) ",
            "zh": "是什么意思呀(´･ω･｀)",
            "narrator_zh": "燕"
        },
        {
            "location": "147/ACT",
            "narrator": "",
            "text": "わからないならそれでいい",
            "zh": "不明白的话，这样就好",
            "narrator_zh": ""
        },
        {
            "location": "148/TALK",
            "narrator": "つばめ",
            "text": "あれ？",
            "zh": "咦？",
            "narrator_zh": "燕"
        },
        {
            "location": "149/TALK",
            "narrator": "つばめ",
            "text": "子供扱ぃされてる(´･ω･｀) ",
            "zh": "被当成小孩子了(´･ω･｀)",
            "narrator_zh": "燕"
        },
        {
            "location": "161/TALK",
            "narrator": "つばめ",
            "text": "あの、Ｂｏｔが人間って\nどういう――",
            "zh": "那个，Bot是人\n是什么意思——",
            "narrator_zh": "燕"
        },
        {
            "location": "162/TALK",
            "narrator": "みやび",
            "text": "やき、Ｂｏｔに見せかけて\nどっかと通信しちゅう\n可能性も――",
            "zh": "就是说，装成Bot，\n在和哪里通信的\n可能也——",
            "narrator_zh": "雅"
        },
        {
            "location": "163/TALK",
            "narrator": "みやび",
            "text": "無きにしも非ずやないかと\n思うがよ。",
            "zh": "也不是完全没得，\n我是这么想的啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "165/TALK",
            "narrator": "アーヤ",
            "text": "ＷＡＶＥ経由で\nどこかに内容を\n流してるってこと？",
            "zh": "是说经由WAVE，\n把内容传到\n什么地方去？",
            "narrator_zh": "绫水"
        },
        {
            "location": "166/TALK",
            "narrator": "みやび",
            "text": "そういう抜け道を\n作ってる可能性が\nあるゆうことぞね。",
            "zh": "就是说有可能\n留了这种漏洞\n啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "167/TALK",
            "narrator": "アーヤ",
            "text": "なんでわざわざ\nそんなことをする\n必要があるの？",
            "zh": "为什么有必要\n特意去做\n那种事？",
            "narrator_zh": "绫水"
        },
        {
            "location": "168/TALK",
            "narrator": "みやび",
            "text": "そこや。\nそこが一番の\n問題やき。",
            "zh": "就是这里咯。\n这里才是\n最大的问题啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "169/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "171/TALK",
            "narrator": "つばめ",
            "text": "何だか難しい話に\nなっちゃってる…。",
            "zh": "好像变成\n很难的话题了……",
            "narrator_zh": "燕"
        },
        {
            "location": "173/TALK",
            "narrator": "つばめ",
            "text": "邪魔したら悪いし、\nまた今度聞こう…。",
            "zh": "打扰她们不好，\n下次再问吧……",
            "narrator_zh": "燕"
        },
        {
            "location": "64/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>5月某日　5:35 PM</color>\nGW期間中、神楽坂トライナリーにて。",
            "zh": "<color=green>5月某日　5:35 PM</color>\n黄金周期间，在神乐坂三重奏。",
            "narrator_zh": "Dialog_EventData"
        }
    ]
}
