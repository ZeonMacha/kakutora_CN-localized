   "narrator": "",
   "text": "おさわりする",
   "zh": "摸一摸",
   "narrator_zh": ""
  },
  {
   "location": "1040/TALK",
   "narrator": "みやび",
   "text": "なんぞ、\n頭に付いちょったが？",
   "zh": "么子，\n头上沾了东西喃？",
   "narrator_zh": "雅"
  },
  {
   "location": "1042/TALK",
   "narrator": "みやび",
   "text": "霊体験のようで\n面白いぞね。",
   "zh": "跟撞鬼一样，\n蛮好玩啵。",
   "narrator_zh": "雅"
  },
  {
   "location": "1048/TALK",
   "narrator": "みやび",
   "text": "…っと！\nいきなり何しゆう！",
   "zh": "……喂！\n突然搞么子！",
   "narrator_zh": "雅"
  },
  {
   "location": "1050/TALK",
   "narrator": "みやび",
   "text": "むっ。\n不当な暴力ぞね。",
   "zh": "哼。\n这算无理的暴力啵。",
   "narrator_zh": "雅"
  },
  {
   "location": "1056/TALK",
   "narrator": "みやび",
   "text": "あー、まったく。\nまたろくでもないヤツ\nに絡まれたねぇ……",
   "zh": "啊，真是的。\n又被个没出息的\n缠上了……",
   "narrator_zh": "雅"
  },
  {
   "location": "1058/TALK",
   "narrator": "みやび",
   "text": "所詮はあんたも\nオッパイ星人か。",
   "zh": "说到底你也是\n欧派星人嘛。",
   "narrator_zh": "雅"
  },
  {
   "location": "1064/TALK",
   "narrator": "みやび",
   "text": "なかなかえい\nおなかじゃろ。",
   "zh": "这肚子\n相当可以咯。",
   "narrator_zh": "雅"
  },
  {
   "location": "1066/TALK",
   "narrator": "みやび",
   "text": "これがいわゆる\nハラパンというヤツか。",
   "zh": "这就是所谓的\n露肚番咯。",
   "narrator_zh": "雅"
  },
  {
   "location": "1072/TALK",
   "narrator": "みやび",
   "text": "ちょっ！\nそこはいかんちや！",
   "zh": "喂！\n那里不行咯！",
   "narrator_zh": "雅"
  },
  {
   "location": "1074/TALK",
   "narrator": "みやび",
   "text": "うち、おなかは\nダメやき、堪忍してや。",
   "zh": "我这肚子\n碰不得啵，饶了我吧。",
   "narrator_zh": "雅"
  },
  {
   "location": "1083/TALK",
   "narrator": "千羽鶴",
   "text": "はい、お終い。",
   "zh": "好了，结束。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "1085/ACT",
