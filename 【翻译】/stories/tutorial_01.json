  "title": "002 チュートリアル　STEP 2",
  "sub_title": "ヒロイン紹介",
  "title_zh": "002 教程　STEP 2",
  "sub_title_zh": "女主角介绍"
 },
 "entry": [
  {
   "location": "443/SCENARIO",
   "narrator": "",
   "text": "チュートリアル_ヒロイン紹介",
   "zh": "女主角介绍",
   "narrator_zh": ""
  },
  {
   "location": "462/TALK",
   "narrator": "千羽鶴",
   "text": "それじゃ早速、\n貴方のフィアンセとの\nご対面といきましょうか。",
   "zh": "那就马上，\n和你的未婚妻\n见个面吧。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "483/TALK",
   "narrator": "千羽鶴",
   "text": "彼女たちは皆、\nトライナリーとして\n世界を守る傍ら――",
   "zh": "她们每个人，\n一边作为三重奏\n守护世界——",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "484/TALK",
   "narrator": "千羽鶴",
   "text": "勉強に、遊びに、そして\n恋に一生懸命な、\nごく普通の女の子。",
   "zh": "学习、玩耍，还有\n恋爱，都很认真的\n再普通不过的女孩子。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "486/TALK",
   "narrator": "千羽鶴",
   "text": "プロファイル０１、\n逢瀬つばめ\n１５歳、高校１年。",
   "zh": "档案01，\n逢濑燕\n15岁，高一。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "487/TALK",
   "narrator": "千羽鶴",
   "text": "いつも元気で天然系の\n前向き指向、まわりを\n笑顔にするのが得意。",
   "zh": "总是很有精神的天然呆，\n积极向上，最擅长\n让周围的人笑起来。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "488/TALK",
   "narrator": "千羽鶴",
   "text": "なかなか骨太な世間\n知らずのところがウザ\nカワイイ…かも。",
   "zh": "相当结实的不懂世事，\n这一点又烦又可爱\n……也许吧。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "489/TALK",
   "narrator": "千羽鶴",
   "text": "得意なことは……\n何かあったかしら。",
   "zh": "擅长的事……\n有什么来着。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "491/TALK",
   "narrator": "千羽鶴",
   "text": "プロファイル０２、\n國政綾水（あやみ）\n２１歳、大学３年。",
   "zh": "档案02，\n国政绫水\n21岁，大三。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "492/TALK",
   "narrator": "千羽鶴",
   "text": "４人の中で最年長の\nお姉さん的存在。",
   "zh": "四个人里年纪最大，\n是姐姐一样的人。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "493/TALK",
   "narrator": "千羽鶴",
   "text": "結構なカタブツだけど、\n面倒見は良く、頼りに\nなる存在だと思う。",
   "zh": "虽然相当古板，\n但很会照顾人，\n我觉得靠得住。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "494/TALK",
   "narrator": "千羽鶴",
   "text": "剣道をたしなみ、その\n腕は世界選手権で優勝\nした程。",
   "zh": "她修习剑道，那手本事\n到了世界锦标赛\n冠军的程度。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "496/TALK",
   "narrator": "千羽鶴",
   "text": "プロファイル０３、\nガブリエラ\n１４歳、中学３年。",
   "zh": "档案03，\n加布里埃拉\n14岁，初三。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "497/TALK",
   "narrator": "千羽鶴",
   "text": "４人中最年少の\nポーランドから来た\n留学生。",
   "zh": "四个人里最小的，\n从波兰来的\n留学生。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "498/TALK",
   "narrator": "千羽鶴",
   "text": "いつもツンツンしてる\nけど、本当はメルヘンな\nものが大好き。",
   "zh": "总是爱甩脸色，\n其实最喜欢\n童话一样的东西。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "499/TALK",
   "narrator": "千羽鶴",
   "text": "銃の腕前は\n世界で通用するレベル。",
   "zh": "枪法是\n世界通用的水平。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "501/TALK",
   "narrator": "千羽鶴",
   "text": "プロファイル０４、\n恋ヶ崎みやび\n１７歳、高校３年。",
   "zh": "档案04，\n恋之崎雅\n17岁，高三。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "502/TALK",
   "narrator": "千羽鶴",
   "text": "いつも突拍子も無い\nことを言って、周囲を\n惑わせる不思議ちゃん。",
   "zh": "总是说些没头没脑的话，\n把周围人绕晕的\n古怪女孩。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "503/TALK",
   "narrator": "千羽鶴",
   "text": "典型的な、\n『喋らなければ\n綺麗なお姉さん』ね。",
   "zh": "典型的，\n“不说话的话\n就是个漂亮姐姐”。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "504/TALK",
   "narrator": "千羽鶴",
   "text": "面倒くさがりでズボラ\nだけど、PCの腕は\nハッカークラス。",
   "zh": "嫌麻烦又邋遢，\n不过电脑的本事\n是黑客级的。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "506/TALK",
   "narrator": "千羽鶴",
   "text": "以上、簡単な\n紹介だったけど、\nもっと知りたい？",
   "zh": "以上，只是\n简单介绍，\n还想多了解吗？",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "507/SEL",
   "narrator": "",
   "text": "もちろん！",
   "zh": "当然！",
   "narrator_zh": ""
  },
  {
   "location": "508/SEL",
   "narrator": "",
   "text": "いえ、もういいです",
   "zh": "不用了",
   "narrator_zh": ""
  },
  {
   "location": "509/ACT",
   "narrator": "",
   "text": "もちろん！",
   "zh": "当然！",
   "narrator_zh": ""
  },
  {
   "location": "510/TALK",
   "narrator": "千羽鶴",
   "text": "わかった。",
   "zh": "好。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "511/TALK",
   "narrator": "千羽鶴",
   "text": "それじゃ、好きなだけ\n眺めて楽しんで。",
   "zh": "那就，想看多久\n就看个够吧。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "512/TALK",
   "narrator": "千羽鶴",
   "text": "今だけ特別、お触りも\nOKにしてあるから。",
   "zh": "只有现在破例，\n摸一摸也可以。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "514/SEL",
   "narrator": "",
   "text": "逢瀬つばめ",
   "zh": "逢濑燕",
   "narrator_zh": ""
  },
  {
   "location": "515/SEL",
   "narrator": "",
   "text": "國政綾水",
   "zh": "国政绫水",
   "narrator_zh": ""
  },
  {
   "location": "516/SEL",
   "narrator": "",
   "text": "ガブリエラ",
   "zh": "加布里埃拉",
   "narrator_zh": ""
  },
  {
   "location": "517/SEL",
   "narrator": "",
   "text": "恋ヶ崎みやび",
   "zh": "恋之崎雅",
   "narrator_zh": ""
  },
  {
   "location": "518/SEL",
   "narrator": "",
   "text": "千羽鶴",
   "zh": "千羽鹤",
   "narrator_zh": ""
  },
  {
   "location": "519/SEL",
   "narrator": "",
   "text": "十分堪能した！",
   "zh": "看够了！",
   "narrator_zh": ""
  },
  {
   "location": "520/ACT",
   "narrator": "",
   "text": "逢瀬つばめ",
   "zh": "逢濑燕",
   "narrator_zh": ""
  },
  {
   "location": "522/TALK",
   "narrator": "つばめ",
   "text": "は、はじめまして！\n逢瀬ちゅ…つ、\nつばめです！",
   "zh": "初、初次见面！\n逢濑燕……燕、\n我是燕！",
   "narrator_zh": "燕"
  },
  {
   "location": "523/TALK",
   "narrator": "つばめ",
   "text": "何の取り柄もないけど\n宜しくお願いします！",
   "zh": "虽然没什么长处，\n请多关照！",
   "narrator_zh": "燕"
  },
  {
   "location": "530/SEL",
   "narrator": "",
   "text": "チャットでイチャイチャ体験",
   "zh": "在聊天里腻歪一下",
   "narrator_zh": ""
  },
  {
   "location": "531/SEL",
   "narrator": "",
   "text": "おさわりする",
   "zh": "摸一摸",
   "narrator_zh": ""
  },
  {
   "location": "532/SEL",
   "narrator": "",
   "text": "戻る",
   "zh": "返回",
   "narrator_zh": ""
  },
  {
   "location": "533/ACT",
   "narrator": "",
   "text": "チャットでイチャイチャ体験",
   "zh": "在聊天里腻歪一下",
   "narrator_zh": ""
  },
  {
   "location": "546/ACT",
   "narrator": "",
   "text": "おさわりする",
   "zh": "摸一摸",
   "narrator_zh": ""
  },
  {
   "location": "614/TALK",
   "narrator": "つばめ",
   "text": "えへへ。",
   "zh": "诶嘿嘿。",
   "narrator_zh": "燕"
  },
  {
   "location": "616/TALK",
   "narrator": "つばめ",
   "text": "なんだか\nこそばゆいょ。",
   "zh": "总觉得\n有点难为情呀。",
   "narrator_zh": "燕"
  },
  {
   "location": "622/TALK",
   "narrator": "つばめ",
   "text": "うわっ！",
   "zh": "呜哇！",
   "narrator_zh": "燕"
  },
  {
   "location": "624/TALK",
   "narrator": "つばめ",
   "text": "いたたっ！\n許してください！",
   "zh": "好痛痛！\n请饶了我！",
   "narrator_zh": "燕"
  },
  {
   "location": "630/TALK",
   "narrator": "つばめ",
   "text": "きゃあっ！",
   "zh": "呀啊！",
   "narrator_zh": "燕"
  },
  {
   "location": "632/TALK",
   "narrator": "つばめ",
   "text": "もーっ！\nわたしが何も言わない\nからって！",
   "zh": "真是的！\n我什么都没说，\n你就这样呀！",
   "narrator_zh": "燕"
  },
  {
   "location": "638/TALK",
   "narrator": "つばめ",
   "text": "あははっ！\nなんか\nこそばゆいよう。",
   "zh": "啊哈哈！\n感觉\n痒痒的呀。",
   "narrator_zh": "燕"
  },
  {
   "location": "640/TALK",
   "narrator": "つばめ",
   "text": "ぷにぷにしてる？\n鍛えないとだめかなぁ。",
   "zh": "软软的吗？\n是不是该锻炼了呀。",
   "narrator_zh": "燕"
  },
  {
   "location": "646/TALK",
   "narrator": "つばめ",
   "text": "はああっ…",
   "zh": "哈啊啊……",
   "narrator_zh": "燕"
  },
  {
   "location": "648/TALK",
   "narrator": "つばめ",
   "text": "へんなかんじ。",
   "zh": "感觉怪怪的。",
   "narrator_zh": "燕"
  },
  {
   "location": "657/TALK",
   "narrator": "千羽鶴",
   "text": "はい、お終い。",
   "zh": "好了，结束。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "659/ACT",
   "narrator": "",
   "text": "戻る",
   "zh": "返回",
   "narrator_zh": ""
  },
  {
   "location": "662/ACT",
   "narrator": "",
   "text": "國政綾水",
   "zh": "国政绫水",
   "narrator_zh": ""
  },
  {
   "location": "664/TALK",
   "narrator": "アーヤ",
   "text": "はじめまして。\n國政綾水と申します。",
   "zh": "初次见面。\n我是国政绫水。",
   "narrator_zh": "绫水"
  },
  {
   "location": "665/TALK",
   "narrator": "アーヤ",
   "text": "貴方のサポート、\n楽しみにしてるわ。",
   "zh": "你的支援，\n我很期待。",
   "narrator_zh": "绫水"
  },
  {
   "location": "672/SEL",
   "narrator": "",
   "text": "チャットでイチャイチャ体験",
   "zh": "在聊天里腻歪一下",
   "narrator_zh": ""
  },
  {
   "location": "673/SEL",
   "narrator": "",
   "text": "おさわりする",
   "zh": "摸一摸",
   "narrator_zh": ""
  },
  {
   "location": "674/SEL",
   "narrator": "",
   "text": "戻る",
   "zh": "返回",
   "narrator_zh": ""
  },
  {
   "location": "675/ACT",
   "narrator": "",
   "text": "チャットでイチャイチャ体験",
   "zh": "在聊天里腻歪一下",
   "narrator_zh": ""
  },
  {
   "location": "688/ACT",
   "narrator": "",
   "text": "おさわりする",
   "zh": "摸一摸",
   "narrator_zh": ""
  },
  {
   "location": "756/TALK",
   "narrator": "アーヤ",
   "text": "ふふっ。",
   "zh": "呵呵。",
   "narrator_zh": "绫水"
  },
  {
   "location": "758/TALK",
   "narrator": "アーヤ",
   "text": "ちょっと\n不思議な気分。",
   "zh": "有点\n奇妙的感觉。",
   "narrator_zh": "绫水"
  },
  {
   "location": "764/TALK",
   "narrator": "アーヤ",
   "text": "きゃっ！？",
   "zh": "呀！？",
   "narrator_zh": "绫水"
  },
  {
   "location": "766/TALK",
   "narrator": "アーヤ",
   "text": "ちょ、ちょっと\n痛いってば！",
   "zh": "等、等一下，\n很痛！",
   "narrator_zh": "绫水"
  },
  {
   "location": "772/TALK",
   "narrator": "アーヤ",
   "text": "もうっ。\n調子に乗らないの。",
   "zh": "真是的。\n别得意忘形。",
   "narrator_zh": "绫水"
  },
  {
   "location": "774/TALK",
   "narrator": "アーヤ",
   "text": "ダメだって！",
   "zh": "说了不行！",
   "narrator_zh": "绫水"
  },
  {
   "location": "780/TALK",
   "narrator": "アーヤ",
   "text": "もうっ！\nくすぐったいってば。",
   "zh": "真是的！\n我说很痒。",
   "narrator_zh": "绫水"
  },
  {
   "location": "782/TALK",
   "narrator": "アーヤ",
   "text": "もしかして\nおなか出てる？",
   "zh": "难道\n肚子凸出来了？",
   "narrator_zh": "绫水"
  },
  {
   "location": "788/TALK",
   "narrator": "アーヤ",
   "text": "ふわっ！",
   "zh": "呼啊！",
   "narrator_zh": "绫水"
  },
  {
   "location": "790/TALK",
   "narrator": "アーヤ",
   "text": "なんか\n不思議な気持ち。",
   "zh": "总觉得\n有点奇妙。",
   "narrator_zh": "绫水"
  },
  {
   "location": "799/TALK",
   "narrator": "千羽鶴",
   "text": "はい、お終い。",
   "zh": "好了，结束。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "801/ACT",
   "narrator": "",
   "text": "戻る",
   "zh": "返回",
   "narrator_zh": ""
  },
  {
   "location": "804/ACT",
   "narrator": "",
   "text": "ガブリエラ",
   "zh": "加布里埃拉",
   "narrator_zh": ""
  },
  {
   "location": "806/TALK",
   "narrator": "ガブリエラ",
   "text": "ガブリエラよ。",
   "zh": "我是加布里埃拉。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "807/TALK",
   "narrator": "ガブリエラ",
   "text": "ていうか、\nあんた誰？",
   "zh": "话说，\n你是谁？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "814/SEL",
   "narrator": "",
   "text": "チャットでイチャイチャ体験",
   "zh": "在聊天里腻歪一下",
   "narrator_zh": ""
  },
  {
   "location": "815/SEL",
   "narrator": "",
   "text": "おさわりする",
   "zh": "摸一摸",
   "narrator_zh": ""
  },
  {
   "location": "816/SEL",
   "narrator": "",
   "text": "戻る",
   "zh": "返回",
   "narrator_zh": ""
  },
  {
   "location": "817/ACT",
   "narrator": "",
   "text": "チャットでイチャイチャ体験",
   "zh": "在聊天里腻歪一下",
   "narrator_zh": ""
  },
  {
   "location": "830/ACT",
   "narrator": "",
   "text": "おさわりする",
   "zh": "摸一摸",
   "narrator_zh": ""
  },
  {
   "location": "898/TALK",
   "narrator": "ガブリエラ",
   "text": "まあ、こういうのも\n悪くないわね。",
   "zh": "嘛，这样\n也不坏。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "900/TALK",
   "narrator": "ガブリエラ",
   "text": "もっとやって\nいいのよ？",
   "zh": "再多来一点\n也可以哦？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "906/TALK",
   "narrator": "ガブリエラ",
   "text": "きゃっ！\n突然なあに！？",
   "zh": "呀！\n突然干什么！？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "908/TALK",
   "narrator": "ガブリエラ",
   "text": "いてっ！\nもうっ！\n許さないわよ！",
   "zh": "好痛！\n真是的！\n我可不原谅你！",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "914/TALK",
   "narrator": "ガブリエラ",
   "text": "きゃああっ！\n何て事するのかしら！",
   "zh": "呀啊啊！\n你这是在干什么！",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "916/TALK",
   "narrator": "ガブリエラ",
   "text": "こらあっ！\n恥を知りなさい！",
   "zh": "给我住手！\n你知不知道羞！",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "922/TALK",
   "narrator": "ガブリエラ",
   "text": "ちょ、ちょっと\n何の真似！？",
   "zh": "等、等一下，\n搞什么名堂！？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "924/TALK",
   "narrator": "ガブリエラ",
   "text": "ああっ、もしかして\n肥ってるとか\n言いたいわけ！？",
   "zh": "啊，难道\n你是想说我胖了\n不成！？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "930/TALK",
   "narrator": "ガブリエラ",
   "text": "ちょっ、キモっ！\n変な感じっ！",
   "zh": "等、好恶心！\n感觉好奇怪！",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "932/TALK",
   "narrator": "ガブリエラ",
   "text": "べ、べつに気持ちよく\nなんてないんだから…",
   "zh": "才、才没有\n觉得舒服……",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "941/TALK",
   "narrator": "千羽鶴",
   "text": "はい、お終い。",
   "zh": "好了，结束。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "943/ACT",
   "narrator": "",
   "text": "戻る",
   "zh": "返回",
   "narrator_zh": ""
  },
  {
   "location": "946/ACT",
   "narrator": "",
   "text": "恋ヶ崎みやび",
   "zh": "恋之崎雅",
   "narrator_zh": ""
  },
  {
   "location": "948/TALK",
   "narrator": "みやび",
   "text": "ふむ。\n興味深い存在やね。",
   "zh": "嗯。\n蛮有意思的人咯。",
   "narrator_zh": "雅"
  },
  {
   "location": "949/TALK",
   "narrator": "みやび",
   "text": "ちゅうか、\nあんた本当に\n人間なが？",
   "zh": "话说，\n你真的是\n人喃？",
   "narrator_zh": "雅"
  },
  {
   "location": "956/SEL",
   "narrator": "",
   "text": "チャットでイチャイチャ体験",
