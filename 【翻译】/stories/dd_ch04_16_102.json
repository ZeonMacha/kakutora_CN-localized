{
    "dir": "chap16/daydra/dd_ch04_16_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "16405",
        "cid": "miyabi",
        "title": "005 メインストーリー",
        "sub_title": "大混乱の大根役者＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "大混乱的蹩脚演员＜后篇＞"
    },
    "entry": [
        {
            "location": "509/TALK",
            "narrator": "みやび",
            "text": "…アホらしい。\n何度もこんなことで\n悩むなんて…。",
            "zh": "……蠢死了。\n居然为这种事\n烦恼了那么多次……",
            "narrator_zh": "雅"
        },
        {
            "location": "510/TALK",
            "narrator": "みやび",
            "text": "言うか…ウサギに、\nうちの正体…。",
            "zh": "要说吗……对兔子，\n我的真面目……",
            "narrator_zh": "雅"
        },
        {
            "location": "511/TALK",
            "narrator": "みやび",
            "text": "わざわざ言う必要\nなんぞないんやろう\nけんど――",
            "zh": "虽然明明\n没必要特意\n说出口，但是——",
            "narrator_zh": "雅"
        },
        {
            "location": "512/TALK",
            "narrator": "みやび",
            "text": "ウサギを騙したまま\nっちゅうのは…、\n気分が悪いしな。",
            "zh": "把兔子一直蒙在\n鼓里这件事……，\n心里不是滋味啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "513/TALK",
            "narrator": "みやび",
            "text": "…ん、決まりや。",
            "zh": "……嗯，就这么定了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "514/TALK",
            "narrator": "みやび",
            "text": "この作業が\n終わったら――",
            "zh": "等这份工作\n做完之后——",
            "narrator_zh": "雅"
        },
        {
            "location": "515/TALK",
            "narrator": "みやび",
            "text": "何もかも、\n全部話そう…。",
            "zh": "所有一切，\n全部说出来……",
            "narrator_zh": "雅"
        },
        {
            "location": "516/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "518/TALK",
            "narrator": "みやび",
            "text": "なんか、気分が\nスッキリしたなぁ。",
            "zh": "总觉得，心情\n畅快多了啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "519/TALK",
            "narrator": "みやび",
            "text": "これで作業に\n集中できそうや！",
            "zh": "这下总算能\n专心干活了咯！",
            "narrator_zh": "雅"
        },
        {
            "location": "537/TALK",
            "narrator": "繭",
            "text": "…？",
            "zh": "……？",
            "narrator_zh": "茧"
        },
        {
            "location": "538/TALK",
            "narrator": "繭",
            "text": "何かおかしい…。\nクイーンから来る\n指示が――",
            "zh": "有哪里不对劲……\n女王发来的\n指示——",
            "narrator_zh": "茧"
        },
        {
            "location": "539/TALK",
            "narrator": "繭",
            "text": "全部、みやび先輩の\n作業を終えた後に\n来ている…。",
            "zh": "全部，都是在雅前辈\n完成作业之后\n才发来的……",
            "narrator_zh": "茧"
        },
        {
            "location": "540/TALK",
            "narrator": "繭",
            "text": "しかも、みやび先輩\nから来た作業の――",
            "zh": "而且，雅前辈\n发来的作业的——",
            "narrator_zh": "茧"
        },
        {
            "location": "541/TALK",
            "narrator": "繭",
            "text": "次の段階のものが、\nまるで狙ったかの\nように…。",
            "zh": "下一阶段的内容，\n简直就像算准了\n一样……",
            "narrator_zh": "茧"
        },
        {
            "location": "542/TALK",
            "narrator": "繭",
            "text": "…偶然？\nこんなに何度も、\nこの短時間に？",
            "zh": "……偶然？\n这么多次，\n还是在这么短时间内？",
            "narrator_zh": "茧"
        },
        {
            "location": "543/TALK",
            "narrator": "繭",
            "text": "でも、もしもこれが\n偶然じゃないと\nしたら――",
            "zh": "可是，如果这些\n不是偶然\n的话——",
            "narrator_zh": "茧"
        },
        {
            "location": "544/TALK",
            "narrator": "繭",
            "text": "まさか…、\nクイーンの正体は、\nみやび先輩！？",
            "zh": "难道说……\n女王的真面目，\n是雅前辈！？",
            "narrator_zh": "茧"
        },
        {
            "location": "545/TALK",
            "narrator": "繭",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "茧"
        },
        {
            "location": "546/TALK",
            "narrator": "繭",
            "text": "…みやび先輩からの\n指示も、さっきより\n格段に増えている。",
            "zh": "……来自雅前辈的\n指示，也比刚才\n明显增多了。",
            "narrator_zh": "茧"
        },
        {
            "location": "547/TALK",
            "narrator": "繭",
            "text": "まるで、人手が一人\n増えたみたいに…。",
            "zh": "简直就像多了\n一个人手一样……",
            "narrator_zh": "茧"
        },
        {
            "location": "548/TALK",
            "narrator": "繭",
            "text": "それも、クイーンが\n私に指示を出してきた\nタイミングで。",
            "zh": "而且，正好是在\n女王给我下指示的\n那个时间点。",
            "narrator_zh": "茧"
        },
        {
            "location": "549/TALK",
            "narrator": "繭",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "茧"
        },
        {
            "location": "550/TALK",
            "narrator": "繭",
            "text": "ごめんなさい…。\nみやび先輩、試させて\nいただきます！",
            "zh": "对不起……。\n雅前辈，请让我\n试一下！",
            "narrator_zh": "茧"
        },
        {
            "location": "554/TALK",
            "narrator": "繭",
            "text": "…よし、クイーンから\n来た指示を実行！",
            "zh": "……好，执行女王\n发来的指示！",
            "narrator_zh": "茧"
        },
        {
            "location": "555/TALK",
            "narrator": "繭",
            "text": "後はこの報告を、\nみやび先輩の方へ…。",
            "zh": "剩下的，就是把这份\n报告发给雅前辈……",
            "narrator_zh": "茧"
        },
        {
            "location": "556/TALK",
            "narrator": "繭",
            "text": "…木馬の侵入に成功\nいたしました、と。",
            "zh": "……木马已成功\n入侵，如此汇报。",
            "narrator_zh": "茧"
        },
        {
            "location": "561/TALK",
            "narrator": "繭",
            "text": "返事は…！？",
            "zh": "回复是……！？",
            "narrator_zh": "茧"
        },
        {
            "location": "562/TALK",
            "narrator": "繭",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "茧"
        },
        {
            "location": "563/TALK",
            "narrator": "繭",
            "text": "らじゃ、って…。\nみやび先輩…。",
            "zh": "就回了句「收到」……。\n雅前辈……",
            "narrator_zh": "茧"
        },
        {
            "location": "564/TALK",
            "narrator": "繭",
            "text": "正体バレた時の\nセリフにしては、\n間抜け過ぎですよ…。",
            "zh": "作为暴露身份时\n的台词，\n也太蠢了点吧……",
            "narrator_zh": "茧"
        },
        {
            "location": "565/TALK",
            "narrator": "繭",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "茧"
        },
        {
            "location": "566/TALK",
            "narrator": "繭",
            "text": "みやび先輩…、\nいえ、Ｆａｔａｌ\nＱｕｅｅｎ。",
            "zh": "雅前辈……\n不，Ｆａｔａｌ\nＱｕｅｅｎ。",
            "narrator_zh": "茧"
        },
        {
            "location": "567/TALK",
            "narrator": "繭",
            "text": "フェノメノンが収束\nしたときを、どうぞ\nお楽しみに…。",
            "zh": "PhenoMENON\n收敛之时，\n敬请期待……",
            "narrator_zh": "茧"
        },
        {
            "location": "578/DIALOG",
            "narrator": "Dialog_chapter_ch04",
            "text": "【13 電脳料理人】",
            "zh": "【13 电脑料理人】",
            "narrator_zh": "Dialog_chapter_ch04"
        }
    ]
}
