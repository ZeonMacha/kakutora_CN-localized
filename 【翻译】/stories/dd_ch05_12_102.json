{
    "dir": "chap12/daydra/dd_ch05_12_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "12505",
        "cid": "kagura",
        "title": "005 メインストーリー",
        "sub_title": "つばめさんを○したい？＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "想把燕○掉？＜后篇＞"
    },
    "entry": [
        {
            "location": "2497/TALK",
            "narrator": "神楽",
            "text": "…っ！？",
            "zh": "……唔！？",
            "narrator_zh": "神乐"
        },
        {
            "location": "2498/TALK",
            "narrator": "神楽",
            "text": "いけない。\n一瞬だけど意識が\n飛んでたみたい…。",
            "zh": "糟糕。\n虽然只是一瞬间，\n意识好像断片了……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2499/TALK",
            "narrator": "神楽",
            "text": "そ、そうだ！\n音羽を――！！",
            "zh": "对、对了！\n音羽她——！！",
            "narrator_zh": "神乐"
        },
        {
            "location": "2507/TALK",
            "narrator": "透明神楽",
            "text": "…あれ？",
            "zh": "……咦？",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "2508/TALK",
            "narrator": "透明神楽",
            "text": "なにか、話してる？",
            "zh": "是在说什么吗？",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "2509/TALK",
            "narrator": "透明つばめ",
            "text": "今日はね、わたし、\n半分お休みなの。",
            "zh": "今天呀，我，\n算是半休哦。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "2510/TALK",
            "narrator": "透明つばめ",
            "text": "でも、部屋の片付けも\nしなきゃだし…。",
            "zh": "不过，房间也得\n收拾才行……。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "2511/TALK",
            "narrator": "透明神楽",
            "text": "…どういうこと？",
            "zh": "……怎么回事？",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "2512/TALK",
            "narrator": "透明神楽",
            "text": "音羽を、傷つけに\n来たんじゃなかったの？",
            "zh": "她不是来伤害\n音羽的吗？",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "2513/TALK",
            "narrator": "透明つばめ",
            "text": "この間の浴衣の陰干しも\nあるし、やること沢山…。",
            "zh": "前几天穿的浴衣还得阴干，\n要做的事好多呀……。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "2514/TALK",
            "narrator": "透明神楽",
            "text": "…なによ、これ。",
            "zh": "……什么嘛，这算。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "2515/TALK",
            "narrator": "透明神楽",
            "text": "どうして、あんなに優しく\n話しかけてるの？",
            "zh": "为什么，要那么温柔地\n跟她说话？",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "2516/TALK",
            "narrator": "透明神楽",
            "text": "音羽をあんな風にしたのは、\nつばめさんなのに。",
            "zh": "把音羽害成那样的，\n明明就是燕啊。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "2517/TALK",
            "narrator": "透明神楽",
            "text": "それなのに、どうして…。",
            "zh": "可为什么，还要……。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "2518/TALK",
            "narrator": "透明つばめ",
            "text": "…あれ？",
            "zh": "……咦？",
            "narrator_zh": "透明燕"
        },
        {
            "location": "2538/TALK",
            "narrator": "つばめ",
            "text": "卯月さん。",
            "zh": "卯月。",
            "narrator_zh": "燕"
        },
        {
            "location": "2540/TALK",
            "narrator": "神楽",
            "text": "っ！？",
            "zh": "唔！？",
            "narrator_zh": "神乐"
        },
        {
            "location": "2541/TALK",
            "narrator": "神楽",
            "text": "いけない、\n見つかっちゃった！！",
            "zh": "糟糕，\n被发现了！！",
            "narrator_zh": "神乐"
        },
        {
            "location": "2542/TALK",
            "narrator": "神楽",
            "text": "なにか…何か言わないと。\nえっと…。",
            "zh": "得说点……得说点什么才行。\n那个……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2545/TALK",
            "narrator": "神楽",
            "text": "…カフェにでも\n行きませんか？",
            "zh": "……要不要去咖啡店\n之类的地方坐坐？",
            "narrator_zh": "神乐"
        },
        {
            "location": "2562/TALK",
            "narrator": "神楽",
            "text": "はぁ…。",
            "zh": "哈啊……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2563/TALK",
            "narrator": "神楽",
            "text": "…一応、伝えておいた方が\nいいのかな…。",
            "zh": "……姑且还是跟他说一声\n比较好吧……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2575/TALK",
            "narrator": "神楽",
            "text": "こんばんは",
            "zh": "晚上好",
            "narrator_zh": "神乐"
        },
        {
            "location": "2576/TALK",
            "narrator": "神楽",
            "text": "ちょっといいですか？",
            "zh": "现在方便吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "2579/SEL",
            "narrator": "",
            "text": "つばめと何かあったんだね？",
            "zh": "你和燕之间发生什么了吧？",
            "narrator_zh": ""
        },
        {
            "location": "2580/ACT",
            "narrator": "",
            "text": "つばめと何かあったんだね？",
            "zh": "你和燕之间发生什么了吧？",
            "narrator_zh": ""
        },
        {
            "location": "2582/TALK",
            "narrator": "神楽",
            "text": "全部お見通しですか",
            "zh": "全都被你看穿了吗",
            "narrator_zh": "神乐"
        },
        {
            "location": "2584/TALK",
            "narrator": "神楽",
            "text": "それとも",
            "zh": "还是说",
            "narrator_zh": "神乐"
        },
        {
            "location": "2585/TALK",
            "narrator": "神楽",
            "text": "こうなることも最初から知ってたとか？",
            "zh": "连会变成这样也是从一开始就知道？",
            "narrator_zh": "神乐"
        },
        {
            "location": "2587/SEL",
            "narrator": "",
            "text": "なんのことだか？",
            "zh": "什么跟什么啊？",
            "narrator_zh": ""
        },
        {
            "location": "2588/ACT",
            "narrator": "",
            "text": "なんのことだか？",
            "zh": "什么跟什么啊？",
            "narrator_zh": ""
        },
        {
            "location": "2590/TALK",
            "narrator": "神楽",
            "text": "だと思いました",
            "zh": "我就知道",
            "narrator_zh": "神乐"
        },
        {
            "location": "2592/TALK",
            "narrator": "神楽",
            "text": "とにかく",
            "zh": "总之",
            "narrator_zh": "神乐"
        },
        {
            "location": "2593/TALK",
            "narrator": "神楽",
            "text": "一応伝えておきます",
            "zh": "还是跟你说一声吧",
            "narrator_zh": "神乐"
        },
        {
            "location": "2594/TALK",
            "narrator": "神楽",
            "text": "今度つばめさんと一緒に",
            "zh": "下次我要和燕一起",
            "narrator_zh": "神乐"
        },
        {
            "location": "2595/TALK",
            "narrator": "神楽",
            "text": "秋葉原に行くことになりました",
            "zh": "去秋叶原了",
            "narrator_zh": "神乐"
        },
        {
            "location": "2598/TALK",
            "narrator": "神楽",
            "text": "あの街には",
            "zh": "那条街上",
            "narrator_zh": "神乐"
        },
        {
            "location": "2599/TALK",
            "narrator": "神楽",
            "text": "私の大好きなお店も沢山あって",
            "zh": "也有很多我非常喜欢的店",
            "narrator_zh": "神乐"
        },
        {
            "location": "2600/TALK",
            "narrator": "神楽",
            "text": "そこにつばめさんも",
            "zh": "我也打算带燕",
            "narrator_zh": "神乐"
        },
        {
            "location": "2601/TALK",
            "narrator": "神楽",
            "text": "連れて行こうと思って",
            "zh": "一起去",
            "narrator_zh": "神乐"
        },
        {
            "location": "2603/SEL",
            "narrator": "",
            "text": "どうしてそう思ったわけ？",
            "zh": "为什么会这么想呢？",
            "narrator_zh": ""
        },
        {
            "location": "2604/SEL",
            "narrator": "",
            "text": "一緒に遊びたかったの？",
            "zh": "你是想一起玩吗？",
            "narrator_zh": ""
        },
        {
            "location": "2605/ACT",
            "narrator": "",
            "text": "どうしてそう思ったわけ？",
            "zh": "为什么会这么想呢？",
            "narrator_zh": ""
        },
        {
            "location": "2606/TALK",
            "narrator": "神楽",
            "text": "どうしてって",
            "zh": "要说为什么",
            "narrator_zh": "神乐"
        },
        {
            "location": "2607/TALK",
            "narrator": "神楽",
            "text": "それは",
            "zh": "那是因为",
            "narrator_zh": "神乐"
        },
        {
            "location": "2608/ACT",
            "narrator": "",
            "text": "一緒に遊びたかったの？",
            "zh": "你是想一起玩吗？",
            "narrator_zh": ""
        },
        {
            "location": "2610/TALK",
            "narrator": "神楽",
            "text": "遊びたいわけじゃなくて",
            "zh": "并不是想一起玩",
            "narrator_zh": "神乐"
        },
        {
            "location": "2611/TALK",
            "narrator": "神楽",
            "text": "その",
            "zh": "那个",
            "narrator_zh": "神乐"
        },
        {
            "location": "2615/TALK",
            "narrator": "神楽",
            "text": "興味が出てきたんです",
            "zh": "我是产生兴趣了",
            "narrator_zh": "神乐"
        },
        {
            "location": "2616/TALK",
            "narrator": "神楽",
            "text": "つばめさんの素顔に",
            "zh": "对燕真实的一面",
            "narrator_zh": "神乐"
        },
        {
            "location": "2619/TALK",
            "narrator": "神楽",
            "text": "私がいつも見ているつばめさんは",
            "zh": "我平时见到的燕",
            "narrator_zh": "神乐"
        },
        {
            "location": "2620/TALK",
            "narrator": "神楽",
            "text": "可愛くて優しい子です",
            "zh": "是个可爱又温柔的孩子",
            "narrator_zh": "神乐"
        },
        {
            "location": "2621/TALK",
            "narrator": "神楽",
            "text": "でも",
            "zh": "可是",
            "narrator_zh": "神乐"
        },
        {
            "location": "2622/TALK",
            "narrator": "神楽",
            "text": "ドームで見せたあの冷徹な顔",
            "zh": "在穹顶里露出的那副冷酷模样",
            "narrator_zh": "神乐"
        },
        {
            "location": "2623/TALK",
            "narrator": "神楽",
            "text": "あれもつばめさんです",
            "zh": "那也是燕",
            "narrator_zh": "神乐"
        },
        {
            "location": "2627/TALK",
            "narrator": "神楽",
            "text": "あの時見せた冷徹な顔はなんだったのか？",
            "zh": "那时露出的冷酷模样究竟是什么？",
            "narrator_zh": "神乐"
        },
        {
            "location": "2628/TALK",
            "narrator": "神楽",
            "text": "知らなくても任務は達成できると思うんです",
            "zh": "我想就算不知道也能完成任务",
            "narrator_zh": "神乐"
        },
        {
            "location": "2629/TALK",
            "narrator": "神楽",
            "text": "でもそうなったら",
            "zh": "可是真那样的话",
            "narrator_zh": "神乐"
        },
        {
            "location": "2630/TALK",
            "narrator": "神楽",
            "text": "絶対に後悔すると思うから",
            "zh": "我觉得自己绝对会后悔",
            "narrator_zh": "神乐"
        },
        {
            "location": "2633/TALK",
            "narrator": "神楽",
            "text": "それに",
            "zh": "而且",
            "narrator_zh": "神乐"
        },
        {
            "location": "2634/TALK",
            "narrator": "神楽",
            "text": "もしも冷徹なつばめさんが本当で",
            "zh": "万一冷酷的燕才是真的",
            "narrator_zh": "神乐"
        },
        {
            "location": "2635/TALK",
            "narrator": "神楽",
            "text": "優しいつばめさんが演技だとしたら",
            "zh": "而温柔的燕只是演技的话",
            "narrator_zh": "神乐"
        },
        {
            "location": "2636/TALK",
            "narrator": "神楽",
            "text": "音羽が浮かばれません",
            "zh": "音羽就太冤了",
            "narrator_zh": "神乐"
        },
        {
            "location": "2637/TALK",
            "narrator": "神楽",
            "text": "あんな酷いことしておきながら",
            "zh": "明明做了那种过分的事",
            "narrator_zh": "神乐"
        },
        {
            "location": "2638/TALK",
            "narrator": "神楽",
            "text": "記憶がないフリをして",
            "zh": "还装作没有记忆",
            "narrator_zh": "神乐"
        },
        {
            "location": "2639/TALK",
            "narrator": "神楽",
            "text": "優しく話しかけていたなんて",
            "zh": "温柔地跟她搭话什么的",
            "narrator_zh": "神乐"
        },
        {
            "location": "2642/TALK",
            "narrator": "神楽",
            "text": "だから",
            "zh": "所以",
            "narrator_zh": "神乐"
        },
        {
            "location": "2643/TALK",
            "narrator": "神楽",
            "text": "本当はどうなのか？",
            "zh": "事实究竟如何？",
            "narrator_zh": "神乐"
        },
        {
            "location": "2644/TALK",
            "narrator": "神楽",
            "text": "それを知るヒントでもいいから探り出したいんです",
            "zh": "哪怕只是知道真相的线索也好，我想探查出来",
            "narrator_zh": "神乐"
        },
        {
            "location": "2646/SEL",
            "narrator": "",
            "text": "知ったら辛くなるかも",
            "zh": "知道了也许会更难受哦",
            "narrator_zh": ""
        },
        {
            "location": "2647/SEL",
            "narrator": "",
            "text": "てか、まだ演技だと疑ってるの？",
            "zh": "话说，你还在怀疑那是演出来的吗？",
            "narrator_zh": ""
        },
        {
            "location": "2648/ACT",
            "narrator": "",
            "text": "知ったら辛くなるかも",
            "zh": "知道了也许会更难受哦",
            "narrator_zh": ""
        },
        {
            "location": "2649/TALK",
            "narrator": "神楽",
            "text": "今でも辛いです",
            "zh": "现在也很难受",
            "narrator_zh": "神乐"
        },
        {
            "location": "2650/TALK",
            "narrator": "神楽",
            "text": "でも",
            "zh": "可是",
            "narrator_zh": "神乐"
        },
        {
            "location": "2651/TALK",
            "narrator": "神楽",
            "text": "知っても知らなくても辛いなら",
            "zh": "既然知不知道都同样难受",
            "narrator_zh": "神乐"
        },
        {
            "location": "2652/TALK",
            "narrator": "神楽",
            "text": "知って辛い方がマシ",
            "zh": "那还是知道后难受来得好",
            "narrator_zh": "神乐"
        },
        {
            "location": "2653/TALK",
            "narrator": "神楽",
            "text": "そう考えて",
            "zh": "我是这么想的",
            "narrator_zh": "神乐"
        },
        {
            "location": "2654/TALK",
            "narrator": "神楽",
            "text": "そう決めたです",
            "zh": "也是这么决定的",
            "narrator_zh": "神乐"
        },
        {
            "location": "2655/ACT",
            "narrator": "",
            "text": "てか、まだ演技だと疑ってるの？",
            "zh": "话说，你还在怀疑那是演出来的吗？",
            "narrator_zh": ""
        },
        {
            "location": "2656/TALK",
            "narrator": "神楽",
            "text": "演技じゃないという結論が出てない以上",
            "zh": "只要还没得出不是演技的结论",
            "narrator_zh": "神乐"
        },
        {
            "location": "2657/TALK",
            "narrator": "神楽",
            "text": "疑うのは当然です",
            "zh": "怀疑就是理所当然的",
            "narrator_zh": "神乐"
        },
        {
            "location": "2658/TALK",
            "narrator": "神楽",
            "text": "疑わないっていうのは",
            "zh": "不去怀疑",
            "narrator_zh": "神乐"
        },
        {
            "location": "2659/TALK",
            "narrator": "神楽",
            "text": "うやむやにするのと同じだし",
            "zh": "就跟含糊过去没什么两样",
            "narrator_zh": "神乐"
        },
        {
            "location": "2660/TALK",
            "narrator": "神楽",
            "text": "それだけは絶対イヤなんです",
            "zh": "唯独这点我绝对不能接受",
            "narrator_zh": "神乐"
        },
        {
            "location": "2662/TALK",
            "narrator": "神楽",
            "text": "だから任務遂行のタイムリミットまでに",
            "zh": "所以在完成任务的最后期限前",
            "narrator_zh": "神乐"
        },
        {
            "location": "2663/TALK",
            "narrator": "神楽",
            "text": "その真相を明かしたいんです",
            "zh": "我想把那个真相查明",
            "narrator_zh": "神乐"
        },
        {
            "location": "2664/TALK",
            "narrator": "神楽",
            "text": "そうすれば",
            "zh": "那样一来",
            "narrator_zh": "神乐"
        },
        {
            "location": "2665/TALK",
            "narrator": "神楽",
            "text": "私は",
            "zh": "我就",
            "narrator_zh": "神乐"
        },
        {
            "location": "2669/SEL",
            "narrator": "",
            "text": "任務に集中できる？",
            "zh": "就能专心做任务了？",
            "narrator_zh": ""
        },
        {
            "location": "2670/SEL",
            "narrator": "",
            "text": "つばめを破壊しない方法を探せる？",
            "zh": "就能找到不破坏燕的方法了？",
            "narrator_zh": ""
        },
        {
            "location": "2671/ACT",
            "narrator": "",
            "text": "任務に集中できる？",
            "zh": "就能专心做任务了？",
            "narrator_zh": ""
        },
        {
            "location": "2673/TALK",
            "narrator": "神楽",
            "text": "そうです",
            "zh": "是的",
            "narrator_zh": "神乐"
        },
        {
            "location": "2674/TALK",
            "narrator": "神楽",
            "text": "そういうことです",
            "zh": "就是这么回事",
            "narrator_zh": "神乐"
        },
        {
            "location": "2685/TALK",
            "narrator": "神楽",
            "text": "…そうよ。\nこれは、任務に集中する\nために必要なこと…。",
            "zh": "……没错。\n这是为了能专心完成任务\n所必需的事……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2686/TALK",
            "narrator": "神楽",
            "text": "それだけよ。\nそれ以外の理由なんて…。",
            "zh": "仅此而已。\n除此之外的理由什么的……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2687/TALK",
            "narrator": "神楽",
            "text": "…ないんだから。",
            "zh": "……是不存在的。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2688/ACT",
            "narrator": "",
            "text": "つばめを破壊しない方法を探せる？",
            "zh": "就能找到不破坏燕的方法了？",
            "narrator_zh": ""
        },
        {
            "location": "2700/TALK",
            "narrator": "神楽",
            "text": "…つばめさんを\n破壊しない方法、か。",
            "zh": "……不破坏燕的\n方法，吗。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2701/TALK",
            "narrator": "神楽",
            "text": "…バカみたい。",
            "zh": "……真像个傻瓜。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2703/TALK",
            "narrator": "神楽",
            "text": "夢みたいなことばかり\n言って、どこまで私を\n混乱させるつもりなの…？",
            "zh": "净说些做梦一样的话，\n你到底要把我搅乱到\n什么地步啊……？",
            "narrator_zh": "神乐"
        },
        {
            "location": "2704/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2705/TALK",
            "narrator": "神楽",
            "text": "でも…もし本当に、\nそんな方法があったら…。",
            "zh": "可是……如果真的\n有那种方法的话……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2706/TALK",
            "narrator": "神楽",
            "text": "私…私は、\nどうすれば…。",
            "zh": "我……我，\n该怎么办才好……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2709/TALK",
            "narrator": "神楽",
            "text": "…本当、バカみたい。",
            "zh": "……真是，像个傻瓜。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2710/TALK",
            "narrator": "神楽",
            "text": "そんな無駄な期待、\nしない方がいいに\n決まってるわ。",
            "zh": "那种白费力气的期待，\n不用想也知道还是\n不要抱比较好。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2711/TALK",
            "narrator": "神楽",
            "text": "そんな都合のいい方法が、\n上手く見つかるはずないん\nだから…。",
            "zh": "那么称心如意的方法，\n怎么可能这么顺利\n就找得到……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2721/DIALOG",
            "narrator": "Dialog_chapter_ch05",
            "text": "【10 江戸川橋物語】",
            "zh": "【10 江户川桥物语】",
            "narrator_zh": "Dialog_chapter_ch05"
        },
        {
            "location": "2733/DIALOG",
            "narrator": "Dialog_chapter_ch05",
            "text": "【10 江戸川橋物語】",
            "zh": "【10 江户川桥物语】",
            "narrator_zh": "Dialog_chapter_ch05"
        }
    ]
}
