{
    "dir": "chap15/daydra/dd_ch05_15_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "15505",
        "cid": "kagura",
        "title": "005 メインストーリー",
        "sub_title": "オンラインなのに＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "明明在线却＜后篇＞"
    },
    "entry": [
        {
            "location": "1925/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1927/TALK",
            "narrator": "つばめ",
            "text": "えっと…それで、卯月さん。\nわたしはどれを買えば\nいいのかな？",
            "zh": "那个……所以，卯月。\n我该买哪一本\n才好呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "1928/TALK",
            "narrator": "神楽",
            "text": "…それは――",
            "zh": "……那个——",
            "narrator_zh": "神乐"
        },
        {
            "location": "1929/TALK",
            "narrator": "つばめ",
            "text": "それは？",
            "zh": "那个？",
            "narrator_zh": "燕"
        },
        {
            "location": "1931/TALK",
            "narrator": "神楽",
            "text": "…自分で探してみて\nください。",
            "zh": "……请你自己\n找找看。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1932/TALK",
            "narrator": "つばめ",
            "text": "えぇっ！？\nわ、わたし一人で選ぶの？",
            "zh": "诶诶！？\n我、我一个人选吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "1933/TALK",
            "narrator": "神楽",
            "text": "なんの情報もない状態で、\nピンときた一冊を選ぶ、\nなんて経験は…。",
            "zh": "在什么情报都没有的时候，\n选出一眼看中的一本，\n这样的经验……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1934/TALK",
            "narrator": "神楽",
            "text": "まさに、この一回だけしか\nありません。",
            "zh": "真的，只有这一次\n而已。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1936/TALK",
            "narrator": "神楽",
            "text": "それを無駄にしたら、\n今後ずーっと後悔することに\nなっちゃいますよ？",
            "zh": "要是浪费掉，\n以后会一直后悔\n下去的哦？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1937/TALK",
            "narrator": "つばめ",
            "text": "そ、そっか…。\nうん、わかったよ。",
            "zh": "原、原来……。\n嗯，我知道了。",
            "narrator_zh": "燕"
        },
        {
            "location": "1938/TALK",
            "narrator": "つばめ",
            "text": "卯月さんの言うとおりに、\nわたし、自分で選んでくる！",
            "zh": "就照卯月说的，\n我自己去选！",
            "narrator_zh": "燕"
        },
        {
            "location": "1939/TALK",
            "narrator": "神楽",
            "text": "素敵な一冊が見つかることを\n祈ってますね。",
            "zh": "希望你能找到\n一本很好的书。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1940/TALK",
            "narrator": "つばめ",
            "text": "うん。\nそれじゃ、探してくるね！",
            "zh": "嗯。\n那我去找哦！",
            "narrator_zh": "燕"
        },
        {
            "location": "1943/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1955/TALK",
            "narrator": "神楽",
            "text": "自分なりの答えが出た気がします",
            "zh": "感觉得出属于我自己的答案了",
            "narrator_zh": "神乐"
        },
        {
            "location": "1956/TALK",
            "narrator": "神楽",
            "text": "もしかしたら",
            "zh": "也许",
            "narrator_zh": "神乐"
        },
        {
            "location": "1957/TALK",
            "narrator": "神楽",
            "text": "私の単なる誇大妄想に過ぎないかもしれませんけど",
            "zh": "也可能只不过是我在夸大妄想",
            "narrator_zh": "神乐"
        },
        {
            "location": "1958/TALK",
            "narrator": "神楽",
            "text": "聞いてもらえますか？",
            "zh": "能听我说吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1960/TALK",
            "narrator": "神楽",
            "text": "$handle$さんの答えが必要なので",
            "zh": "因为我需要$handle$的答案",
            "narrator_zh": "神乐"
        },
        {
            "location": "1962/SEL",
            "narrator": "",
            "text": "どういうこと？",
            "zh": "什么意思？",
            "narrator_zh": ""
        },
        {
            "location": "1963/ACT",
            "narrator": "",
            "text": "どういうこと？",
            "zh": "什么意思？",
            "narrator_zh": ""
        },
        {
            "location": "1965/TALK",
            "narrator": "神楽",
            "text": "私はこう思ってるんです",
            "zh": "我是这么想的",
            "narrator_zh": "神乐"
        },
        {
            "location": "1966/TALK",
            "narrator": "神楽",
            "text": "$handle$さんは多分",
            "zh": "$handle$大概",
            "narrator_zh": "神乐"
        },
        {
            "location": "1967/TALK",
            "narrator": "神楽",
            "text": "私達の未来でなにが起きるのかを知っている",
            "zh": "知道我们的未来会发生什么",
            "narrator_zh": "神乐"
        },
        {
            "location": "1968/TALK",
            "narrator": "神楽",
            "text": "それなのに",
            "zh": "即便如此",
            "narrator_zh": "神乐"
        },
        {
            "location": "1969/TALK",
            "narrator": "神楽",
            "text": "なにが起きるのかは言ってくれない",
            "zh": "却不告诉我会发生什么",
            "narrator_zh": "神乐"
        },
        {
            "location": "1972/TALK",
            "narrator": "神楽",
            "text": "言えないのかもしれませんが",
            "zh": "也许是不能说",
            "narrator_zh": "神乐"
        },
        {
            "location": "1973/TALK",
            "narrator": "神楽",
            "text": "だから今からする話を聞いて",
            "zh": "所以请听我接下来要说的",
            "narrator_zh": "神乐"
        },
        {
            "location": "1974/TALK",
            "narrator": "神楽",
            "text": "$handle$さんがいいと思うかどうか",
            "zh": "$handle$觉得这样好不好",
            "narrator_zh": "神乐"
        },
        {
            "location": "1975/TALK",
            "narrator": "神楽",
            "text": "それを聞きたいんです",
            "zh": "我想听听这个",
            "narrator_zh": "神乐"
        },
        {
            "location": "1977/SEL",
            "narrator": "",
            "text": "それくらいなら多分大丈夫",
            "zh": "这种程度的话大概没关系",
            "narrator_zh": ""
        },
        {
            "location": "1978/SEL",
            "narrator": "",
            "text": "とりあえず聞かせて",
            "zh": "总之先让我听听",
            "narrator_zh": ""
        },
        {
            "location": "1979/ACT",
            "narrator": "",
            "text": "それくらいなら多分大丈夫",
            "zh": "这种程度的话大概没关系",
            "narrator_zh": ""
        },
        {
            "location": "1980/TALK",
            "narrator": "神楽",
            "text": "だといいんですけど",
            "zh": "那样就好了",
            "narrator_zh": "神乐"
        },
        {
            "location": "1981/ACT",
            "narrator": "",
            "text": "とりあえず聞かせて",
            "zh": "总之先让我听听",
            "narrator_zh": ""
        },
        {
            "location": "1982/TALK",
            "narrator": "神楽",
            "text": "そうですね",
            "zh": "说得也是",
            "narrator_zh": "神乐"
        },
        {
            "location": "1983/TALK",
            "narrator": "神楽",
            "text": "判断はお任せします",
            "zh": "判断就交给你",
            "narrator_zh": "神乐"
        },
        {
            "location": "1985/TALK",
            "narrator": "神楽",
            "text": "私はここにいるつばめさんのことを",
            "zh": "我对在这里的燕",
            "narrator_zh": "神乐"
        },
        {
            "location": "1986/TALK",
            "narrator": "神楽",
            "text": "よく知ってます",
            "zh": "很了解",
            "narrator_zh": "神乐"
        },
        {
            "location": "1987/TALK",
            "narrator": "神楽",
            "text": "とっても優しくて",
            "zh": "非常温柔",
            "narrator_zh": "神乐"
        },
        {
            "location": "1988/TALK",
            "narrator": "神楽",
            "text": "色んなことに一生懸命の",
            "zh": "对什么都拼尽全力",
            "narrator_zh": "神乐"
        },
        {
            "location": "1989/TALK",
            "narrator": "神楽",
            "text": "可愛い普通の女の子です",
            "zh": "是个可爱的普通女孩",
            "narrator_zh": "神乐"
        },
        {
            "location": "1993/TALK",
            "narrator": "神楽",
            "text": "ドームでのことは今でも引っかかるけど",
            "zh": "穹顶那时的事，现在也还放不下",
            "narrator_zh": "神乐"
        },
        {
            "location": "1994/TALK",
            "narrator": "神楽",
            "text": "決めました",
            "zh": "我决定了",
            "narrator_zh": "神乐"
        },
        {
            "location": "1995/TALK",
            "narrator": "神楽",
            "text": "ずっとつばめさんの隣にいて感じたこと",
            "zh": "一直待在燕身边所感觉到的",
            "narrator_zh": "神乐"
        },
        {
            "location": "1996/TALK",
            "narrator": "神楽",
            "text": "それを信じてみようって",
            "zh": "我想试着去相信",
            "narrator_zh": "神乐"
        },
        {
            "location": "1997/TALK",
            "narrator": "神楽",
            "text": "だから私",
            "zh": "所以我",
            "narrator_zh": "神乐"
        },
        {
            "location": "2000/TALK",
            "narrator": "神楽",
            "text": "つばめさんを破壊しないで済む方法があるのなら",
            "zh": "如果有不用毁掉燕的办法",
            "narrator_zh": "神乐"
        },
        {
            "location": "2001/TALK",
            "narrator": "神楽",
            "text": "それを探したいんです",
            "zh": "我想去找",
            "narrator_zh": "神乐"
        },
        {
            "location": "2002/TALK",
            "narrator": "神楽",
            "text": "破壊しなければいけないタイミングがいつ来るのか",
            "zh": "必须毁掉她的时机什么时候到来",
            "narrator_zh": "神乐"
        },
        {
            "location": "2003/TALK",
            "narrator": "神楽",
            "text": "それは私にもわからないけど",
            "zh": "这个我也不知道",
            "narrator_zh": "神乐"
        },
        {
            "location": "2004/TALK",
            "narrator": "神楽",
            "text": "せめてそれまでは探してみよう",
            "zh": "至少在那之前，我想找找看",
            "narrator_zh": "神乐"
        },
        {
            "location": "2005/TALK",
            "narrator": "神楽",
            "text": "そう決めたんです",
            "zh": "我是这么决定的",
            "narrator_zh": "神乐"
        },
        {
            "location": "2008/TALK",
            "narrator": "神楽",
            "text": "どう思いますか？",
            "zh": "你怎么想？",
            "narrator_zh": "神乐"
        },
        {
            "location": "2009/TALK",
            "narrator": "神楽",
            "text": "私の出したこの答えについて",
            "zh": "关于我得出的这个答案",
            "narrator_zh": "神乐"
        },
        {
            "location": "2010/TALK",
            "narrator": "神楽",
            "text": "感想だけでも聞かせてほしいんです",
            "zh": "哪怕只是感想，也想听你说说",
            "narrator_zh": "神乐"
        },
        {
            "location": "2013/SEL",
            "narrator": "",
            "text": "全面的に応援するよ",
            "zh": "我全力支持你",
            "narrator_zh": ""
        },
        {
            "location": "2014/SEL",
            "narrator": "",
            "text": "破壊するのはやめないんだ？",
            "zh": "毁掉她这件事，不打算停吗？",
            "narrator_zh": ""
        },
        {
            "location": "2015/SEL",
            "narrator": "",
            "text": "時間の無駄だ",
            "zh": "是浪费时间",
            "narrator_zh": ""
        },
        {
            "location": "2016/ACT",
            "narrator": "",
            "text": "全面的に応援するよ",
            "zh": "我全力支持你",
            "narrator_zh": ""
        },
        {
            "location": "2017/TALK",
            "narrator": "神楽",
            "text": "ありがとうございます",
            "zh": "谢谢",
            "narrator_zh": "神乐"
        },
        {
            "location": "2018/TALK",
            "narrator": "神楽",
            "text": "私が求めていた答えの中でも",
            "zh": "在我想要的答案里",
            "narrator_zh": "神乐"
        },
        {
            "location": "2019/TALK",
            "narrator": "神楽",
            "text": "最高の答えです",
            "zh": "这也是最好的",
            "narrator_zh": "神乐"
        },
        {
            "location": "2030/TALK",
            "narrator": "神楽",
            "text": "…やっぱり、成功するか\nどうかは答えてくれな\nかったか。",
            "zh": "……果然，成功与否\n你还是没有\n回答我啊。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2031/TALK",
            "narrator": "神楽",
            "text": "でも、応援するって\n言ってくれたって\nことは…。",
            "zh": "不过，你说会\n支持我，\n那就意味着……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2032/TALK",
            "narrator": "神楽",
            "text": "成功する可能性が\nあるのかも！",
            "zh": "也许有成功的\n可能！",
            "narrator_zh": "神乐"
        },
        {
            "location": "2033/TALK",
            "narrator": "神楽",
            "text": "…やってみる価値は\nありそうね。",
            "zh": "……似乎值得\n试一试。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2034/ACT",
            "narrator": "",
            "text": "破壊するのはやめないんだ？",
            "zh": "毁掉她这件事，不打算停吗？",
            "narrator_zh": ""
        },
        {
            "location": "2035/TALK",
            "narrator": "神楽",
            "text": "それは当然です",
            "zh": "那是当然",
            "narrator_zh": "神乐"
        },
        {
            "location": "2036/TALK",
            "narrator": "神楽",
            "text": "私はつばめさん以外にも",
            "zh": "除了燕以外",
            "narrator_zh": "神乐"
        },
        {
            "location": "2037/TALK",
            "narrator": "神楽",
            "text": "お母さんや音羽のことも助けたい",
            "zh": "妈妈和音羽，我也想救",
            "narrator_zh": "神乐"
        },
        {
            "location": "2038/TALK",
            "narrator": "神楽",
            "text": "そして",
            "zh": "而且",
            "narrator_zh": "神乐"
        },
        {
            "location": "2039/TALK",
            "narrator": "神楽",
            "text": "お母さんと音羽と比べたら",
            "zh": "跟妈妈和音羽比起来",
            "narrator_zh": "神乐"
        },
        {
            "location": "2040/TALK",
            "narrator": "神楽",
            "text": "つばめさんはその下ですから",
            "zh": "燕是排在下面的",
            "narrator_zh": "神乐"
        },
        {
            "location": "2043/TALK",
            "narrator": "神楽",
            "text": "これだけは言っておきます",
            "zh": "这句话我先说清楚",
            "narrator_zh": "神乐"
        },
        {
            "location": "2044/TALK",
            "narrator": "神楽",
            "text": "お母さんと音羽を犠牲にしてまで",
            "zh": "要是得牺牲妈妈和音羽",
            "narrator_zh": "神乐"
        },
        {
            "location": "2045/TALK",
            "narrator": "神楽",
            "text": "つばめさんを助ける気はありません",
            "zh": "那我没打算去救燕",
            "narrator_zh": "神乐"
        },
        {
            "location": "2046/TALK",
            "narrator": "神楽",
            "text": "でももし",
            "zh": "但如果",
            "narrator_zh": "神乐"
        },
        {
            "location": "2047/TALK",
            "narrator": "神楽",
            "text": "三人とも幸せになる方法があるのであれば",
            "zh": "有让三个人都幸福的办法",
            "narrator_zh": "神乐"
        },
        {
            "location": "2048/TALK",
            "narrator": "神楽",
            "text": "それを探してみたい",
            "zh": "我想去找找看",
            "narrator_zh": "神乐"
        },
        {
            "location": "2049/TALK",
            "narrator": "神楽",
            "text": "そう思っただけなので",
            "zh": "我只是这么想",
            "narrator_zh": "神乐"
        },
        {
            "location": "2052/TALK",
            "narrator": "神楽",
            "text": "聞きたいことは聞けましたので",
            "zh": "想问的已经问到了",
            "narrator_zh": "神乐"
        },
        {
            "location": "2053/TALK",
            "narrator": "神楽",
            "text": "もういいです",
            "zh": "可以了",
            "narrator_zh": "神乐"
        },
        {
            "location": "2054/TALK",
            "narrator": "神楽",
            "text": "ありがとうございました",
            "zh": "谢谢你",
            "narrator_zh": "神乐"
        },
        {
            "location": "2065/TALK",
            "narrator": "神楽",
            "text": "いいと思うかどうかを\n聞きたかったのに。",
            "zh": "我明明只是想问\n你觉得好不好。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2066/TALK",
            "narrator": "神楽",
            "text": "これじゃあ、聞いた意味が\nなかったわ…。",
            "zh": "这样的话，问了\n也没有意义……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2067/ACT",
            "narrator": "",
            "text": "時間の無駄だ",
            "zh": "是浪费时间",
            "narrator_zh": ""
        },
        {
            "location": "2069/TALK",
            "narrator": "神楽",
            "text": "率直な意見ありがとうございました",
            "zh": "谢谢你坦率的意见",
            "narrator_zh": "神乐"
        },
        {
            "location": "2080/TALK",
            "narrator": "神楽",
            "text": "…時間の無駄って、\nなにそれ？",
            "zh": "……浪费时间，\n什么意思？",
            "narrator_zh": "神乐"
        },
        {
            "location": "2081/TALK",
            "narrator": "神楽",
            "text": "$handle$が\n知らないだけで…。",
            "zh": "只是$handle$\n不知道而已……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2082/TALK",
            "narrator": "神楽",
            "text": "もしかしたらいい方法が\nあるかもしれないのに…。",
            "zh": "也许会有\n好办法的……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2083/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2084/TALK",
            "narrator": "神楽",
            "text": "でも、もしも本当に\n時間の無駄だったら…。",
            "zh": "可是，如果真的\n是浪费时间……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2085/TALK",
            "narrator": "神楽",
            "text": "なにもせずに、\n私はその日が来るのを\n待つってこと？",
            "zh": "什么都不做，\n我就干等着\n那一天到来吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "2086/TALK",
            "narrator": "神楽",
            "text": "そんなこと…。",
            "zh": "那种事……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2091/TALK",
            "narrator": "つばめ",
            "text": "卯月さーん。",
            "zh": "卯月——。",
            "narrator_zh": "燕"
        },
        {
            "location": "2095/TALK",
            "narrator": "つばめ",
            "text": "ごめんねー。\nお待たせしちゃったかな？",
            "zh": "对不起呀。\n让你等很久了吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "2097/TALK",
            "narrator": "神楽",
            "text": "いえ…どうでした？\nなにか気になる本、\n見つかりましたか？",
            "zh": "没有……怎么样？\n有没有找到\n在意的书？",
            "narrator_zh": "神乐"
        },
        {
            "location": "2098/TALK",
            "narrator": "つばめ",
            "text": "うん。\nとっても面白そうな本、\n見つけてきたよ。",
            "zh": "嗯。\n找到一本看起来\n非常有意思的书哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "2100/TALK",
            "narrator": "神楽",
            "text": "本当ですか？\n早く見せてください。",
            "zh": "真的吗？\n快给我看看。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2101/TALK",
            "narrator": "つばめ",
            "text": "えへへ…わたしが\n見つけてきた本は、\nこれでーす！",
            "zh": "诶嘿嘿……我\n找到的书，\n就是这本——！",
            "narrator_zh": "燕"
        },
        {
            "location": "2102/TALK",
            "narrator": "神楽",
            "text": "これって…、\nスウィーティ・メルティ\nですか？",
            "zh": "这是……\n甜甜·融化\n吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "2104/TALK",
            "narrator": "つばめ",
            "text": "そうだよ。\nほら、この前の出撃のこと、\n覚えてる？",
            "zh": "对呀。\n你看，之前出击的事，\n还记得吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "2105/TALK",
            "narrator": "つばめ",
            "text": "現場に向かってるときに、\n車の中で卯月さんが…。",
            "zh": "去现场的路上，\n在车里，卯月……。",
            "narrator_zh": "燕"
        },
        {
            "location": "2106/TALK",
            "narrator": "つばめ",
            "text": "これの変身ポーズとか\n名乗りとか、\n教えてくれたでしょ？",
            "zh": "教过我这个的变身姿势\n还有报上名号，\n对吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "2108/TALK",
            "narrator": "神楽",
            "text": "あ、ああ…そういえば\nそんなこともありましたね。",
            "zh": "啊、啊啊……说起来\n是有这么回事。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2109/TALK",
            "narrator": "つばめ",
            "text": "この本を見つけたとき、\nその時のことを\n思い出したの。",
            "zh": "找到这本书的时候，\n就想起了\n那时候。",
            "narrator_zh": "燕"
        },
        {
            "location": "2110/TALK",
            "narrator": "つばめ",
            "text": "ちょっと恥ずかしかった\nけど…、楽しかったな、\nって…。",
            "zh": "虽然有点害羞……\n但是，很开心啊，\n之类的……。",
            "narrator_zh": "燕"
        },
        {
            "location": "2111/TALK",
            "narrator": "つばめ",
            "text": "だから、一度本物の\nメルティがどんなのかを\n見てみたくなったんだ。",
            "zh": "所以就想看看，\n真正的融化\n到底是什么样。",
            "narrator_zh": "燕"
        },
        {
            "location": "2112/TALK",
            "narrator": "神楽",
            "text": "なるほど…。\nふふっ。",
            "zh": "原来如此……。\n呵呵。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2113/TALK",
            "narrator": "つばめ",
            "text": "え、なんで笑うの？\nわたし変なこと言った？",
            "zh": "诶，为什么笑？\n我说了什么奇怪的话吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "2114/TALK",
            "narrator": "神楽",
            "text": "そうじゃないんです。",
            "zh": "不是那样的。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2115/TALK",
            "narrator": "神楽",
            "text": "私との思い出を理由に\n選んでくれたことが、\n嬉しくて…。",
            "zh": "你把和我的回忆\n当成挑选的理由，\n我很高兴……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2116/TALK",
            "narrator": "つばめ",
            "text": "えへへ…よかった。\n卯月さんにも\n喜んでもらえて。",
            "zh": "诶嘿嘿……太好了。\n卯月\n也很高兴。",
            "narrator_zh": "燕"
        },
        {
            "location": "2117/TALK",
            "narrator": "つばめ",
            "text": "それじゃ、ちょっと\n買ってくるね。",
            "zh": "那我去\n买一下哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "2131/TALK",
            "narrator": "つばめ",
            "text": "えへへ、面白そう。\n早く読みたいなぁ…。",
            "zh": "诶嘿嘿，好像很有意思。\n好想快点读……。",
            "narrator_zh": "燕"
        },
        {
            "location": "2132/TALK",
            "narrator": "つばめ",
            "text": "…あ、そうだ。",
            "zh": "……啊，对了。",
            "narrator_zh": "燕"
        },
        {
            "location": "2144/TALK",
            "narrator": "つばめ",
            "text": "$handle$さ～ん",
            "zh": "$handle$～",
            "narrator_zh": "燕"
        },
        {
            "location": "2145/TALK",
            "narrator": "つばめ",
            "text": "メルティのラノベ発見だょ(*≧∀≦*) ",
            "zh": "发现融化的轻小说啦(*≧∀≦*) ",
            "narrator_zh": "燕"
        },
        {
            "location": "2146/TALK",
            "narrator": "つばめ",
            "text": "前から読みたかったんだ～(´∀｀*)ｳﾌﾌ",
            "zh": "早就想读了～(´∀｀*)ｳﾌﾌ",
            "narrator_zh": "燕"
        },
        {
            "location": "2147/TALK",
            "narrator": "つばめ",
            "text": "近所になかったから",
            "zh": "因为附近没有",
            "narrator_zh": "燕"
        },
        {
            "location": "2148/TALK",
            "narrator": "つばめ",
            "text": "とっても嬉しぃ(*´∀｀*)ｖ",
            "zh": "超开心呀(*´∀｀*)ｖ",
            "narrator_zh": "燕"
        },
        {
            "location": "2150/SEL",
            "narrator": "",
            "text": "連れてきてくれた神楽に感謝だね",
            "zh": "得感谢带你来的神乐呀",
            "narrator_zh": ""
        },
        {
            "location": "2151/ACT",
            "narrator": "",
            "text": "連れてきてくれた神楽に感謝だね",
            "zh": "得感谢带你来的神乐呀",
            "narrator_zh": ""
        },
        {
            "location": "2153/TALK",
            "narrator": "つばめ",
            "text": "ぅん",
            "zh": "嗯……",
            "narrator_zh": "燕"
        },
        {
            "location": "2154/SEL",
            "narrator": "",
            "text": "つばめは神楽のことが好き？\n<color=blue>(※スルー可能）</color>",
            "zh": "燕喜欢神乐吗？\n<color=blue>(※可跳过）</color>",
            "narrator_zh": ""
        },
        {
            "location": "2155/TALK",
            "narrator": "つばめ",
            "text": "あ",
            "zh": "啊",
            "narrator_zh": "燕"
        },
        {
            "location": "2156/TALK",
            "narrator": "つばめ",
            "text": "レジ行かなくちゃ",
            "zh": "得去收银台了",
            "narrator_zh": "燕"
        },
        {
            "location": "2157/TALK",
            "narrator": "つばめ",
            "text": "それじゃ$handle$さん、またね",
            "zh": "那就$handle$，下次见",
            "narrator_zh": "燕"
        },
        {
            "location": "2158/TALK",
            "narrator": "つばめ",
            "text": "卯月さん待たせちゃってるから",
            "zh": "卯月还在等我",
            "narrator_zh": "燕"
        },
        {
            "location": "2177/ACT",
            "narrator": "",
            "text": "つばめは神楽のことが好き？\n<color=blue>(※スルー可能）</color>",
            "zh": "燕喜欢神乐吗？\n<color=blue>(※可跳过）</color>",
            "narrator_zh": ""
        },
        {
            "location": "2181/TALK",
            "narrator": "つばめ",
            "text": "えー",
            "zh": "诶——",
            "narrator_zh": "燕"
        },
        {
            "location": "2182/TALK",
            "narrator": "つばめ",
            "text": "もちろん好きだょ～～～",
            "zh": "当然喜欢呀～～～",
            "narrator_zh": "燕"
        },
        {
            "location": "2184/TALK",
            "narrator": "つばめ",
            "text": "卯月さんはいつもわたしに幸せを沢山くれるんだょ",
            "zh": "卯月总是给我好多幸福呀",
            "narrator_zh": "燕"
        },
        {
            "location": "2185/TALK",
            "narrator": "つばめ",
            "text": "今回だって、初めてのアキバだったけど、とっても楽しくて",
            "zh": "这次也是，虽然第一次来秋叶原，但特别开心",
            "narrator_zh": "燕"
        },
        {
            "location": "2186/TALK",
            "narrator": "つばめ",
            "text": "わたしも卯月さんに、なにかぉ礼したぃけど",
            "zh": "我也想给卯月送点回礼呀",
            "narrator_zh": "燕"
        },
        {
            "location": "2188/SEL",
            "narrator": "",
            "text": "お揃いのものを二人で持ったらすごく良さそう",
            "zh": "两个人拿成一对，好像会很好",
            "narrator_zh": ""
        },
        {
            "location": "2189/ACT",
            "narrator": "",
            "text": "お揃いのものを二人で持ったらすごく良さそう",
            "zh": "两个人拿成一对，好像会很好",
            "narrator_zh": ""
        },
        {
            "location": "2191/TALK",
            "narrator": "つばめ",
            "text": "それぃぃねぇ～～～！",
            "zh": "那个好呀～～～！",
            "narrator_zh": "燕"
        },
        {
            "location": "2194/TALK",
            "narrator": "つばめ",
            "text": "でも、ここじゃムリかも(´･ω･｀) ",
            "zh": "可是，在这里可能不行(´･ω･｀) ",
            "narrator_zh": "燕"
        },
        {
            "location": "2195/TALK",
            "narrator": "つばめ",
            "text": "本しか売ってなさそぅだし",
            "zh": "好像只卖书",
            "narrator_zh": "燕"
        },
        {
            "location": "2196/TALK",
            "narrator": "つばめ",
            "text": "ぉ礼は今度",
            "zh": "回礼就下次",
            "narrator_zh": "燕"
        },
        {
            "location": "2197/TALK",
            "narrator": "つばめ",
            "text": "改めてかな_(┐「ε:)_",
            "zh": "改日再说吧_(┐「ε:)_",
            "narrator_zh": "燕"
        },
        {
            "location": "2208/TALK",
            "narrator": "つばめ",
            "text": "…あれ？\nあそこに\n置いてあるのって――",
            "zh": "……咦？\n放在那边的\n该不会是——",
            "narrator_zh": "燕"
        },
        {
            "location": "2230/TALK",
            "narrator": "つばめ",
            "text": "ごめんねー。\nお待たせしちゃった\nかな？",
            "zh": "对不起呀。\n让你久等\n了吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "2232/TALK",
            "narrator": "神楽",
            "text": "いえ、私も新刊の\nチェックをしてたから\n大丈夫ですよ。",
            "zh": "没有，我也在看\n新刊，\n没关系哦。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2234/TALK",
            "narrator": "神楽",
            "text": "それじゃあ、\n次のお店へ案内しますね。",
            "zh": "那么，\n我带你去下一家店。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2235/TALK",
            "narrator": "つばめ",
            "text": "あ、ちょっと待って。\n実はレジの前で、\nこんなの見つけたんだ。",
            "zh": "啊，等一下。\n其实在收银台前面，\n我找到了这个。",
            "narrator_zh": "燕"
        },
        {
            "location": "2236/TALK",
            "narrator": "神楽",
            "text": "それは…ああ、\nメルティーの\nキーホルダーですね。",
            "zh": "那个是……啊，\n是融化的\n钥匙扣呢。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2237/TALK",
            "narrator": "つばめ",
            "text": "うん。ミルクティーと\nアップルティーので\n間違いないかな？",
            "zh": "嗯。是奶茶和\n苹果茶的，\n应该没错吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "2238/TALK",
            "narrator": "神楽",
            "text": "はい。でも、主役の\nスウィーティーは\n買わなかったんですか？",
            "zh": "是的。不过，主角\n甜甜\n你没买吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "2239/TALK",
            "narrator": "つばめ",
            "text": "うん…三つだと、\nスウィーティーだけ\n余っちゃうから…。",
            "zh": "嗯……三个的话，\n就只有甜甜\n会多出来……。",
            "narrator_zh": "燕"
        },
        {
            "location": "2240/TALK",
            "narrator": "つばめ",
            "text": "卯月さん。\nアップルティーの方、\nもらってくれる？",
            "zh": "卯月。\n苹果茶这边，\n能请你收下吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "2241/TALK",
            "narrator": "神楽",
            "text": "えっ？\nこれ、もらっちゃっても\nいいんですか？",
            "zh": "诶？\n这个，我收下\n也可以吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "2242/TALK",
            "narrator": "つばめ",
            "text": "うん、今日秋葉原に\n連れてきてくれた\nお礼だよ。",
            "zh": "嗯，今天带我来\n秋叶原的\n回礼哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "2243/TALK",
            "narrator": "つばめ",
            "text": "…本当は、ハンカチとか\nお菓子とかにしようかな\nって思ったんだけど…。",
            "zh": "……本来想买\n手帕或者点心\n什么的……。",
            "narrator_zh": "燕"
        },
        {
            "location": "2245/TALK",
            "narrator": "つばめ",
            "text": "秋葉原じゃ、そういうの\n売ってる気がしなくて…。",
            "zh": "在秋叶原，总觉得\n没在卖那种东西……。",
            "narrator_zh": "燕"
        },
        {
            "location": "2246/TALK",
            "narrator": "神楽",
            "text": "…そんな、気を遣わなくて\nいいのに…。",
            "zh": "……不用这么\n费心的……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2247/TALK",
            "narrator": "つばめ",
            "text": "ご、ごめんね。\nお礼がキーホルダー\nなんかで。",
            "zh": "对、对不起。\n回礼只是钥匙扣\n这种东西。",
            "narrator_zh": "燕"
        },
        {
            "location": "2248/TALK",
            "narrator": "つばめ",
            "text": "でも、さっきも言ったけど\n一緒にポーズの練習を\nしたの…。",
            "zh": "可是，刚才也说过，\n我们一起练了姿势\n……。",
            "narrator_zh": "燕"
        },
        {
            "location": "2249/TALK",
            "narrator": "つばめ",
            "text": "本当に楽しかったんだ。",
            "zh": "真的很开心。",
            "narrator_zh": "燕"
        },
        {
            "location": "2251/TALK",
            "narrator": "つばめ",
            "text": "だから、これが売ってるの\n見た瞬間に思ったの。",
            "zh": "所以，看到这个在卖，\n那一瞬间就这么想了。",
            "narrator_zh": "燕"
        },
        {
            "location": "2252/TALK",
            "narrator": "つばめ",
            "text": "卯月さんとお揃いで\n持てたら嬉しいな、って。",
            "zh": "要是能和卯月\n拿成一对，会很高兴。",
            "narrator_zh": "燕"
        },
        {
            "location": "2253/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2254/TALK",
            "narrator": "つばめ",
            "text": "って、ごめんね！\nムリに押しつけるつもりは\nないんだけど、えっと…。",
            "zh": "啊，对不起！\n我不是想硬塞给你，\n那个……。",
            "narrator_zh": "燕"
        },
        {
            "location": "2255/TALK",
            "narrator": "神楽",
            "text": "…ありがとう、\nつばめさん。",
            "zh": "……谢谢你，\n燕。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2256/TALK",
            "narrator": "神楽",
            "text": "このキーホルダー、\n大切にしますね。",
            "zh": "这个钥匙扣，\n我会珍惜的。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2257/TALK",
            "narrator": "つばめ",
            "text": "…ごめんね。\n押しつけたみたいに\nなっちゃったかな？",
            "zh": "……对不起。\n好像变成硬塞给你\n了？",
            "narrator_zh": "燕"
        },
        {
            "location": "2258/TALK",
            "narrator": "神楽",
            "text": "そんなことないです。\nつばめさんとお揃いなんて\nとっても嬉しいですよ。",
            "zh": "没有那回事。\n能和燕凑一对，\n我非常高兴。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2259/TALK",
            "narrator": "神楽",
            "text": "帰ったら、学校の鞄に\n付けさせてもらいますね。",
            "zh": "回去之后，我会把它\n挂到学校的书包上。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2260/TALK",
            "narrator": "つばめ",
            "text": "が、学校の鞄に付けるの？",
            "zh": "要、要挂在学校的书包上？",
            "narrator_zh": "燕"
        },
        {
            "location": "2261/TALK",
            "narrator": "神楽",
            "text": "はい。つばめさんも、\n帰ったら\n付けてくださいね。",
            "zh": "是的。燕也请\n回去之后\n挂上哦。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2263/TALK",
            "narrator": "つばめ",
            "text": "わ、わたしも！？",
            "zh": "我、我也！？",
            "narrator_zh": "燕"
        },
        {
            "location": "2264/TALK",
            "narrator": "神楽",
            "text": "もちろんです。\nせっかくつばめさんとの\nお揃いなんだから…。",
            "zh": "当然。\n好容易和燕\n凑成一对……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2265/TALK",
            "narrator": "神楽",
            "text": "一緒に付けて、私達が\nラブラブなところを\n見せつけちゃいましょう！",
            "zh": "一起挂上，把我们\n甜甜蜜蜜的样子\n展示给大家看吧！",
            "narrator_zh": "神乐"
        },
        {
            "location": "2266/TALK",
            "narrator": "つばめ",
            "text": "ら、ラブラブ！？",
            "zh": "甜、甜甜蜜蜜！？",
            "narrator_zh": "燕"
        },
        {
            "location": "2268/TALK",
            "narrator": "神楽",
            "text": "はい。\nペアリングみたいな\nものですし。",
            "zh": "是的。\n就跟对戒\n差不多。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2269/TALK",
            "narrator": "つばめ",
            "text": "えぇっ！？　そ、そういう\nつもりじゃなかったん\nだけど…。",
            "zh": "诶诶！？　我、我\n不是那个意思\n……。",
            "narrator_zh": "燕"
        },
        {
            "location": "2270/TALK",
            "narrator": "神楽",
            "text": "つ、つばめさんは、\n私のこと、\nキライなんですか…っ？",
            "zh": "燕、燕，\n你该不会\n讨厌我吧……？",
            "narrator_zh": "神乐"
        },
        {
            "location": "2272/TALK",
            "narrator": "つばめ",
            "text": "ち、違うよ！",
            "zh": "不、不是哦！",
            "narrator_zh": "燕"
        },
        {
            "location": "2273/TALK",
            "narrator": "つばめ",
            "text": "わたしも卯月さんのこと、\nとっても大好きだよ！",
            "zh": "我也很\n喜欢卯月哦！",
            "narrator_zh": "燕"
        },
        {
            "location": "2274/TALK",
            "narrator": "神楽",
            "text": "ちょ、声が大きいです！\n周りの人達に\n見られちゃってますから！",
            "zh": "等、声音太大了！\n周围的人\n都在看了！",
            "narrator_zh": "神乐"
        },
        {
            "location": "2276/TALK",
            "narrator": "つばめ",
            "text": "えっ、あ…、\nご、ごめんなさい…。",
            "zh": "诶，啊……\n对、对不起……。",
            "narrator_zh": "燕"
        },
        {
            "location": "2277/TALK",
            "narrator": "神楽",
            "text": "まあ、私は別に\n気にしませんけどねー。",
            "zh": "嘛，我倒是\n不怎么在意。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2278/TALK",
            "narrator": "つばめ",
            "text": "わ、わたしは\n気にするよー。",
            "zh": "我、我\n很在意的哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "2279/TALK",
            "narrator": "神楽",
            "text": "ふふっ…。",
            "zh": "呵呵……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2280/TALK",
            "narrator": "神楽",
            "text": "優しくて、可愛くて、\nちょっとだけ天然な\nつばめさん…。",
            "zh": "又温柔，又可爱，\n还有一点点天然呆的\n燕……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2282/TALK",
            "narrator": "神楽",
            "text": "…壊したくないな。\nこんないい子を…。",
            "zh": "……不想毁掉啊。\n这么好的孩子……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "2292/DIALOG",
            "narrator": "Dialog_chapter_ch05",
            "text": "【12 ピクシャル】",
            "zh": "【12 像素】",
            "narrator_zh": "Dialog_chapter_ch05"
        },
        {
            "location": "2304/DIALOG",
            "narrator": "Dialog_chapter_ch05",
            "text": "【12 ピクシャル】",
            "zh": "【12 像素】",
            "narrator_zh": "Dialog_chapter_ch05"
        }
    ]
}
