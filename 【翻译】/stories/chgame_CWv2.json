        "sub_title_zh": "CW神乐姬"
    },
    "entry": [
        {
            "location": "1778/SCENARIO",
            "narrator": "",
            "text": "CWかぐら姫",
            "zh": "CW神乐姬",
            "narrator_zh": ""
        },
        {
            "location": "1790/TALK",
            "narrator": "千羽鶴",
            "text": "ここには\n卯月神楽がいた。",
            "zh": "这里曾有\n卯月神乐。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1791/SEL",
            "narrator": "",
            "text": "確か、かぐら姫だっけｗ",
            "zh": "记得是神乐姬吧哈哈",
            "narrator_zh": ""
        },
        {
            "location": "1792/ACT",
            "narrator": "",
            "text": "確か、かぐら姫だっけｗ",
            "zh": "记得是神乐姬吧哈哈",
            "narrator_zh": ""
        },
        {
            "location": "1794/TALK",
            "narrator": "千羽鶴",
            "text": "そう。",
            "zh": "是的。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1795/TALK",
            "narrator": "千羽鶴",
            "text": "月の姫であるかぐやと、\n卯月神楽を\nかけ合わせてみた。",
            "zh": "把身为月之公主的辉夜，\n和卯月神乐\n组合到了一起。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1796/TALK",
            "narrator": "千羽鶴",
            "text": "我ながら\nナイスネーミングだと\n思う。",
            "zh": "连我自己都觉得，\n这名字起得\n真妙。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1797/TALK",
            "narrator": "千羽鶴",
            "text": "RPGゲームでの\n役割については、\n正直かなり悩んだ。",
            "zh": "至于她在RPG游戏里\n的定位，说实话\n纠结了很久。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1798/TALK",
            "narrator": "千羽鶴",
            "text": "この時点で卯月神楽は\nまだ、貴方にとっては\n未知数な存在だったから。",
            "zh": "因为在这个时间点，\n卯月神乐对你来说，\n还是个未知数。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1799/TALK",
            "narrator": "千羽鶴",
            "text": "結果として、ゴールまでの\n采配を決定づける、\n鍵として設定した。",
            "zh": "结果，就把她设定成了\n决定通往终点之主导权的\n关键。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1800/TALK",
            "narrator": "千羽鶴",
            "text": "彼女は２つのアイテムの\nうち、１つを貴方に\nプレゼントしてくれる。",
            "zh": "两件道具之中，\n她会把其中一件\n当作礼物送给你。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1801/TALK",
            "narrator": "千羽鶴",
            "text": "そのアイテムはどちらも\nクリアには欠かせない\nものだった。",
            "zh": "而那两件道具，\n无论哪件都是通关\n缺不得的。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1802/TALK",
            "narrator": "千羽鶴",
            "text": "すなわちそれは、\n当時の私のミッションに\nおいても同様だった。",
            "zh": "也就是说，这一点\n对当时我的任务而言\n同样成立。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1803/TALK",
            "narrator": "千羽鶴",
            "text": "私にとって彼女は、\n必要不可欠な\n存在だったから。",
            "zh": "因为对我来说，\n她是必不可少\n的存在。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1804/TALK",
            "narrator": "千羽鶴",
            "text": "そして――",
            "zh": "然后——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1805/TALK",
            "narrator": "千羽鶴",
            "text": "性質は変われど、\nその点については、\n今もかわらない。",
            "zh": "虽然性质变了，\n但这一点，\n现在也没变。",
            "narrator_zh": "千羽鹤"
        }
    ]
}
