{
    "dir": "chap05/daydra/dd_ch02_05_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "5252",
        "cid": "ayami",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "校庭",
        "title_zh": "Extra002 额外剧情",
        "sub_title_zh": "校园"
    },
    "entry": [
        {
            "location": "307/SCENARIO",
            "narrator": "",
            "text": "校庭",
            "zh": "校园",
            "narrator_zh": ""
        },
        {
            "location": "319/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤ？\nまさかもう帰るつもり？",
            "zh": "绫水？\n不会已经要回去了吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "321/TALK",
            "narrator": "アーヤ",
            "text": "うん。今日の講義は\n午前だけだったから――",
            "zh": "嗯。今天的课\n只有上午——",
            "narrator_zh": "绫水"
        },
        {
            "location": "322/TALK",
            "narrator": "アーヤ",
            "text": "どこかでランチでも\n食べて、先に帰ってるわ。",
            "zh": "我去哪吃个午餐，\n先回去了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "323/TALK",
            "narrator": "ガブリエラ",
            "text": "まったく、何がランチよ。\n大学生は気楽でいいわね。",
            "zh": "真是的，什么午餐。\n大学生可真轻松。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "325/TALK",
            "narrator": "ガブリエラ",
            "text": "こっちはまだまだ\n授業があるのに…。",
            "zh": "我这边可还有\n好多课……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "326/TALK",
            "narrator": "アーヤ",
            "text": "あのね、そんなわけ…。",
            "zh": "我说，不是那样……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "327/SEL",
            "narrator": "",
            "text": "アーヤも昔は中学生だった",
            "zh": "绫水以前也是中学生",
            "narrator_zh": ""
        },
        {
            "location": "328/SEL",
            "narrator": "",
            "text": "言わせとけ",
            "zh": "随她说",
            "narrator_zh": ""
        },
        {
            "location": "329/SEL",
            "narrator": "",
            "text": "うんと羨ましがらせろ",
            "zh": "使劲让她羡慕",
            "narrator_zh": ""
        },
        {
            "location": "333/TALK",
            "narrator": "アーヤ",
            "text": "って、何言ったところで\n無駄よね。",
            "zh": "不管说什么\n都没用。",
            "narrator_zh": "绫水"
        },
        {
            "location": "334/TALK",
            "narrator": "アーヤ",
            "text": "実際に大学生の辛さを\n経験したことがないと、\nわからないことだし。",
            "zh": "没实际体会过\n大学生的辛苦，\n是不会明白的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "337/TALK",
            "narrator": "アーヤ",
            "text": "ていうかランチの時間が\n始まっちゃうから、\nそろそろ行かないと。",
            "zh": "而且午餐时间\n要开始了，\n我得走了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "339/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィ、悪いけど\nそろそろ――",
            "zh": "加维，抱歉，\n我差不多——",
            "narrator_zh": "绫水"
        },
        {
            "location": "340/TALK",
            "narrator": "アーヤ",
            "text": "ランチタイムは\n混むから、早めに\n行きたいのよ。",
            "zh": "午餐时间\n会挤，我想\n早点去。",
            "narrator_zh": "绫水"
        },
        {
            "location": "341/TALK",
            "narrator": "ガブリエラ",
            "text": "何よ、\n言い返すくらいの\n時間もないの？",
            "zh": "什么嘛，\n连回嘴的\n时间都没有？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "342/TALK",
            "narrator": "アーヤ",
            "text": "ないわ。\nそれじゃ、劇場でね。",
            "zh": "没有。\n那就，剧场见。",
            "narrator_zh": "绫水"
        },
        {
            "location": "346/TALK",
            "narrator": "ガブリエラ",
            "text": "…本当、気楽そうで\nうらやましいわ。",
            "zh": "……真的，看起来好轻松，\n真羡慕。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "348/ACT",
            "narrator": "",
            "text": "アーヤも昔は中学生だった",
            "zh": "绫水以前也是中学生",
            "narrator_zh": ""
        },
        {
            "location": "352/TALK",
            "narrator": "アーヤ",
            "text": "メール？\nちょっと待って。",
            "zh": "邮件？\n等一下。",
            "narrator_zh": "绫水"
        },
        {
            "location": "367/TALK",
            "narrator": "アーヤ",
            "text": "そっか",
            "zh": "这样啊",
            "narrator_zh": "绫水"
        },
        {
            "location": "368/TALK",
            "narrator": "アーヤ",
            "text": "それ言えばわかってもらえるかも",
            "zh": "这么说也许能让她明白",
            "narrator_zh": "绫水"
        },
        {
            "location": "369/TALK",
            "narrator": "アーヤ",
            "text": "早速言ってみるわ(*^-ﾟ)v",
            "zh": "我这就去说(*^-ﾟ)v",
            "narrator_zh": "绫水"
        },
        {
            "location": "381/TALK",
            "narrator": "アーヤ",
            "text": "…大丈夫よ、ギャヴィ。",
            "zh": "……没事的，加维。",
            "narrator_zh": "绫水"
        },
        {
            "location": "382/TALK",
            "narrator": "アーヤ",
            "text": "私だって中学、高校と\n経験して大学生になったん\nだから。",
            "zh": "我也是读完中学、高中，\n才成为\n大学生的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "384/TALK",
            "narrator": "ガブリエラ",
            "text": "そ、そんなの\nわかってるわよ…。",
            "zh": "这、这点\n我知道……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "385/TALK",
            "narrator": "アーヤ",
            "text": "なら、羨ましがらなくても\nあんただって中学、高校を\n卒業すれば――",
            "zh": "那就不必羡慕，\n你也只要中学、高中\n毕业了——",
            "narrator_zh": "绫水"
        },
        {
            "location": "386/TALK",
            "narrator": "アーヤ",
            "text": "大学生になれる、って\nいうのもわかるでしょ？",
            "zh": "就能当大学生，\n这你也明白吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "388/TALK",
            "narrator": "ガブリエラ",
            "text": "…飛び級さえあれば、\nこんな思いしなくても\nすむのに。",
            "zh": "……要是有跳级，\n就不用受\n这种苦了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "389/TALK",
            "narrator": "アーヤ",
            "text": "日本にはないんだから、\n諦めなさい。",
            "zh": "日本没有，\n死心吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "391/TALK",
            "narrator": "アーヤ",
            "text": "とはいえ…外国生まれの\nギャヴィにとっては、\n窮屈なのも仕方ないわね。",
            "zh": "话虽如此……在外国出生的\n加维觉得憋屈，\n也是没办法。",
            "narrator_zh": "绫水"
        },
        {
            "location": "393/TALK",
            "narrator": "アーヤ",
            "text": "そう考えると、ちょっと\nかわいそうかも…。",
            "zh": "这么一想，有点\n可怜……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "394/ACT",
            "narrator": "",
            "text": "言わせとけ",
            "zh": "随她说",
            "narrator_zh": ""
        },
        {
            "location": "398/TALK",
            "narrator": "アーヤ",
            "text": "あ、ちょっと待って。\nメールみたいだから。",
            "zh": "啊，等一下。\n好像来邮件了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "413/TALK",
            "narrator": "アーヤ",
            "text": "確かに",
            "zh": "确实",
            "narrator_zh": "绫水"
        },
        {
            "location": "414/TALK",
            "narrator": "アーヤ",
            "text": "それが一番手っ取り早そう",
            "zh": "那样好像最快",
            "narrator_zh": "绫水"
        },
        {
            "location": "415/TALK",
            "narrator": "アーヤ",
            "text": "疲れそうだけど(；-_-) =3",
            "zh": "可能会很累(；-_-) =3",
            "narrator_zh": "绫水"
        },
        {
            "location": "428/TALK",
            "narrator": "アーヤ",
            "text": "…話の途中で悪かったわ。\nで、なんの話だっけ？",
            "zh": "……说到一半，抱歉。\n对了，刚才说到哪？",
            "narrator_zh": "绫水"
        },
        {
            "location": "429/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤは気楽で良いわね、\nって話よ。",
            "zh": "绫水很轻松，真好，\n说的是这个。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "430/TALK",
            "narrator": "ガブリエラ",
            "text": "ていうか、社会に出る\n直前の学生が――",
            "zh": "而且，马上就要\n进入社会的学生——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "431/TALK",
            "narrator": "ガブリエラ",
            "text": "毎日遊び半分で学生生活\n送ってるって問題だと\n思わない？",
            "zh": "每天玩着过一半的\n学生生活，你不觉得\n有问题吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "432/TALK",
            "narrator": "ガブリエラ",
            "text": "中学、高校のあたし達が\n必死で夕方まで勉強して\nるっていうのに――",
            "zh": "我们中学、高中\n拼到傍晚都在学习\n——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "433/TALK",
            "narrator": "ガブリエラ",
            "text": "大学生は午前だけだの\n休講だのと、普通は\n逆じゃないの？",
            "zh": "大学生却只有上午，\n还停课，一般\n不是反过来吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "435/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "437/TALK",
            "narrator": "ガブリエラ",
            "text": "あっ…ちょっと言い過ぎた\nかしら？",
            "zh": "啊……是不是说得\n有点过了？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "439/TALK",
            "narrator": "アーヤ",
            "text": "はぁ…気は済んだ？",
            "zh": "哈啊……说完了？",
            "narrator_zh": "绫水"
        },
        {
            "location": "441/TALK",
            "narrator": "ガブリエラ",
            "text": "な、なによそれ！？",
            "zh": "什、什么意思！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "442/TALK",
            "narrator": "アーヤ",
            "text": "まあ、貴方みたいな\n考え方をする人って、\n時々いるから――",
            "zh": "嘛，像你这样\n想的人，\n有时会有——",
            "narrator_zh": "绫水"
        },
        {
            "location": "443/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィも大学生に\nなれば、一度は言われる\nことになるはずよ。",
            "zh": "加维上了大学，\n也总会被人\n这么说一次。",
            "narrator_zh": "绫水"
        },
        {
            "location": "445/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "446/TALK",
            "narrator": "アーヤ",
            "text": "その時は今のように、\n落ち着いて対応できると\nいいわね。",
            "zh": "到时候，能像现在这样\n沉住气应对\n就好了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "448/TALK",
            "narrator": "ガブリエラ",
            "text": "う、うるさい！\n大きなお世話よ…。",
            "zh": "吵、吵死了！\n多管闲事……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "450/TALK",
            "narrator": "ガブリエラ",
            "text": "ていうか、なんか\n大学生ってストレス\n溜まりそうだから――",
            "zh": "而且，总觉得\n大学生好像很容易\n积压力——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "452/TALK",
            "narrator": "ガブリエラ",
            "text": "もうしばらくは\n中学生でいいわ…。",
            "zh": "再当一阵\n中学生就好……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "453/ACT",
            "narrator": "",
            "text": "うんと羨ましがらせろ",
            "zh": "使劲让她羡慕",
            "narrator_zh": ""
        },
        {
            "location": "466/TALK",
            "narrator": "アーヤ",
            "text": "あ、メールみたい。\nちょっと待って。",
            "zh": "啊，好像来邮件了。\n等一下。",
            "narrator_zh": "绫水"
        },
        {
            "location": "481/TALK",
            "narrator": "アーヤ",
            "text": "それ、面白そう！",
            "zh": "那个，好像很有意思！",
            "narrator_zh": "绫水"
        },
        {
            "location": "482/TALK",
            "narrator": "アーヤ",
            "text": "羨ましがられそうなことなら沢山あるから",
            "zh": "能让人羡慕的事，我有好多",
            "narrator_zh": "绫水"
        },
        {
            "location": "483/TALK",
            "narrator": "アーヤ",
            "text": "この際、うんと言っちゃう！",
            "zh": "这次就答应了！",
            "narrator_zh": "绫水"
        },
        {
            "location": "495/TALK",
            "narrator": "アーヤ",
            "text": "…ええ、そうよ。\nその通り！",
            "zh": "……对，就是这样。\n你说得对！",
            "narrator_zh": "绫水"
        },
        {
            "location": "497/TALK",
            "narrator": "ガブリエラ",
            "text": "は！？",
            "zh": "哈！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "498/TALK",
            "narrator": "アーヤ",
            "text": "中学高校に比べたら、\n大学生活って本当に\n楽しくて堪らないわ。",
            "zh": "比起中学高中，\n大学生活真的\n开心到不行。",
            "narrator_zh": "绫水"
        },
        {
            "location": "499/TALK",
            "narrator": "アーヤ",
            "text": "午前だけの時もあるし、\n午後に１講だけの\nこともあるし――",
            "zh": "有时只有上午，\n有时下午只有\n一节课——",
            "narrator_zh": "绫水"
        },
        {
            "location": "500/TALK",
            "narrator": "アーヤ",
            "text": "休講もあれば、出席だけ\nしてれば良いだけの\nものもあったりするし。",
            "zh": "有停课，也有只要\n出席一下就行的\n课。",
            "narrator_zh": "绫水"
        },
        {
            "location": "502/TALK",
            "narrator": "アーヤ",
            "text": "レポートさえ提出すれ\nば出席しなくてＯＫ\nなんて講義もあるもの。",
            "zh": "还有交了报告\n就不用出席也OK\n的课。",
            "narrator_zh": "绫水"
        },
        {
            "location": "503/TALK",
            "narrator": "アーヤ",
            "text": "本当、大学生活って\n最高よ！",
            "zh": "真的，大学生活\n最棒了！",
            "narrator_zh": "绫水"
        },
        {
            "location": "506/TALK",
            "narrator": "ガブリエラ",
            "text": "ぐっ、ぐぬぬぬぬ…！",
            "zh": "咕、咕唔唔唔唔……！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "507/TALK",
            "narrator": "アーヤ",
            "text": "あっ…。",
            "zh": "啊……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "510/TALK",
            "narrator": "アーヤ",
            "text": "しまった！\nちょっと\n言い過ぎたかも！",
            "zh": "糟了！\n好像\n说得有点过了！",
            "narrator_zh": "绫水"
        },
        {
            "location": "515/TALK",
            "narrator": "ガブリエラ",
            "text": "ああ、もう！\nどうして日本には飛び級\n制度がないのよ！？",
            "zh": "啊，真是的！\n为什么日本没有跳级\n制度！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "516/TALK",
            "narrator": "ガブリエラ",
            "text": "ポーランドにいたら、\n今頃とっくに大学に\n入学できてたのに！",
            "zh": "要是还在波兰，\n这会儿早就\n进大学了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "517/TALK",
            "narrator": "アーヤ",
            "text": "…やっぱり、\nちょっとだけ\n言い過ぎたみたい。",
            "zh": "……果然，\n说得有点\n过了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "518/TALK",
            "narrator": "アーヤ",
            "text": "本気で気楽にやってると\n思われたら嫌だなぁ…。",
            "zh": "要是被当成真的在轻松度日，\n我可不愿意……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "316/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>5月11日　11:42 AM</color>\nとある日の昼頃、\n附属学園校門にて。",
            "zh": "<color=green>5月11日　11:42 AM</color>\n某天中午，\n附属学园校门口。",
            "narrator_zh": "Dialog_EventData"
        },
        {
            "location": "459/DIALOG",
            "narrator": "Dialog_GETGokigen",
            "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！",
            "zh": "心情点数\n<size=40><color=red><b>300pt.</b></color></size>\n增加了！",
            "narrator_zh": "Dialog_GETGokigen"
        }
    ]
}
