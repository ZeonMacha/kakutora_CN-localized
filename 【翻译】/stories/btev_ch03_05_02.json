{
    "dir": "chap05/battle/btev_ch03_05_02.js",
    "type": "",
    "info": {
        "story_id": "23006",
        "cid": "",
        "title": "006 ココロスフィアストーリー【Lv02】",
        "sub_title": "壊されるココロⅠ＜帰結＞",
        "title_zh": "006 心灵领域故事【Lv02】",
        "sub_title_zh": "被弄坏的心Ⅰ＜归结＞"
    },
    "entry": [
        {
            "location": "172/SCENARIO",
            "narrator": "",
            "text": "壊されるココロ２",
            "zh": "被弄坏的心2",
            "narrator_zh": ""
        },
        {
            "location": "187/TALK",
            "narrator": "表層ガブリエラ",
            "text": "くっ……まさか\nここまでとはね。",
            "zh": "唔……没想到\n竟然到了这种地步。",
            "narrator_zh": "表层加布里埃拉"
        },
        {
            "location": "188/TALK",
            "narrator": "ガブリエラ",
            "text": "ざまぁ見なさいよ。",
            "zh": "活该，看你还敢不敢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "189/TALK",
            "narrator": "表層ガブリエラ",
            "text": "出直してくるわ。\nすぐに戻ってくるから\n覚悟しておきなさい。",
            "zh": "我先重整旗鼓。\n很快就会回来的，\n给我做好觉悟。",
            "narrator_zh": "表层加布里埃拉"
        },
        {
            "location": "199/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…。",
            "zh": "哈啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "213/TALK",
            "narrator": "ガブリエラ",
            "text": "改めてありがと。\n助かったわ。",
            "zh": "再次谢谢你。\n帮大忙了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "214/SEL",
            "narrator": "（選択肢）",
            "text": "つばめと仲良くなりたいのは本心なの？",
            "zh": "想和燕搞好关系是真的吗？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "215/ACT",
            "narrator": "",
            "text": "つばめと仲良くなりたいのは本心なの？",
            "zh": "想和燕搞好关系是真的吗？",
            "narrator_zh": ""
        },
        {
            "location": "217/TALK",
            "narrator": "ガブリエラ",
            "text": "は、はぁ！？\n何を突然\n言い出すのかしら？",
            "zh": "哈、哈啊！？\n怎么突然\n问起这个？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "218/TALK",
            "narrator": "ガブリエラ",
            "text": "当たり前でしょ！",
            "zh": "那还用说嘛！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "219/SEL",
            "narrator": "（選択肢）",
            "text": "ホントに？　下心とかない？",
            "zh": "真的？　没有别的企图？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "220/ACT",
            "narrator": "",
            "text": "ホントに？\n下心とかない？",
            "zh": "真的？\n没有别的企图？",
            "narrator_zh": ""
        },
        {
            "location": "222/TALK",
            "narrator": "ガブリエラ",
            "text": "いや、\nそれは……その…",
            "zh": "不，\n那个……就是……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "223/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…\nあんたには\n敵わないわ。",
            "zh": "哈啊……\n真拿你\n没办法。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "224/TALK",
            "narrator": "ガブリエラ",
            "text": "確かに無いと言えば\n嘘になるわね。",
            "zh": "要说完全没有，\n那确实是骗人的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "225/TALK",
            "narrator": "ガブリエラ",
            "text": "あんたはあたしに\n協力してくれたから\n教えてあげるわ。",
            "zh": "既然你协助了\n我，那就让我来\n告诉你吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "226/TALK",
            "narrator": "ガブリエラ",
            "text": "丁度アイツも\nいなくなってるし。",
            "zh": "反正那家伙\n也刚好不在了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "227/TALK",
            "narrator": "ガブリエラ",
            "text": "本当のこというと……",
            "zh": "其实说真的……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "228/TALK",
            "narrator": "ガブリエラ",
            "text": "あたし、つばめに\n壊して欲しいココロが\nあるの。",
            "zh": "我呀，希望燕能帮我\n破坏掉心里\n某一部分。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "229/SEL",
            "narrator": "（選択肢）",
            "text": "バカ、早まるな！",
            "zh": "笨蛋，别做傻事！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "230/ACT",
            "narrator": "",
            "text": "バカ、早まるな！",
            "zh": "笨蛋，别做傻事！",
            "narrator_zh": ""
        },
        {
            "location": "232/TALK",
            "narrator": "ガブリエラ",
            "text": "違うのよ。\nそれじゃ、こう言えば\nいいかしら？",
            "zh": "不是你想的那样。\n那这么说的话，\n你应该能明白吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "233/TALK",
            "narrator": "ガブリエラ",
            "text": "『消して欲しい\n記憶がある』って。",
            "zh": "『我有想要\n抹消掉的记忆』。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "234/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしのココロの\n中には、黒いヴェール\nに包まれた所がある。",
            "zh": "在我的心里，\n有一处被黑色面纱\n笼罩着的地方。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "235/TALK",
            "narrator": "ガブリエラ",
            "text": "その中にある記憶は\n封印されていて、出て\nくることは無いけど―",
            "zh": "里面的记忆\n已经被封印起来，\n不会再跑出来——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "236/TALK",
            "narrator": "ガブリエラ",
            "text": "その記憶はあたし\n全体にもの凄い\n不利益を与えてるの。",
            "zh": "但那段记忆，却在\n给我整个人带来\n极大的坏影响。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "237/SEL",
            "narrator": "（選択肢）",
            "text": "例えば？",
            "zh": "比如说？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "238/ACT",
            "narrator": "",
            "text": "例えば？",
            "zh": "比如说？",
            "narrator_zh": ""
        },
        {
            "location": "240/TALK",
            "narrator": "ガブリエラ",
            "text": "トラウマとか、\n…あと、恐怖症？",
            "zh": "心理创伤啦、\n……还有，恐怖症？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "241/SEL",
            "narrator": "（選択肢）",
            "text": "何の？",
            "zh": "对什么的？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "242/ACT",
            "narrator": "",
            "text": "何の？",
            "zh": "对什么的？",
            "narrator_zh": ""
        },
        {
            "location": "244/TALK",
            "narrator": "ガブリエラ",
            "text": "教えない。",
            "zh": "不告诉你。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "245/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、あんたと\n長い付き合いになる\nようなことがあれば―",
            "zh": "不过，要是以后\n我和你变成长期来往\n的关系的话——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "246/TALK",
            "narrator": "ガブリエラ",
            "text": "いずれ教える時も\n来るかもしれないわね。",
            "zh": "说不定总有一天\n也会告诉你吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "248/TALK",
            "narrator": "ガブリエラ",
            "text": "その前に、\n気づかれちゃうかも\nしれないけど。",
            "zh": "不过在那之前，\n说不定就已经\n被你察觉到了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "249/TALK",
            "narrator": "ガブリエラ",
            "text": "だから、\nその部分を粉々にして\nもらいたいのよ。",
            "zh": "所以，\n我才想让她把那部分\n砸个粉碎。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "250/TALK",
            "narrator": "ガブリエラ",
            "text": "つばめは壊した時の\n記憶がないって\n言ってるけど――",
            "zh": "虽说燕讲自己破坏东西时\n没有记忆\n——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "251/TALK",
            "narrator": "ガブリエラ",
            "text": "多分何らかの形で\nココロの奥底では\n認識してると思うの。",
            "zh": "但我觉得在内心深处，\n她多半还是以某种形式\n有所意识。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "252/SEL",
            "narrator": "（選択肢）",
            "text": "危険じゃない？",
            "zh": "这样不会很危险吗？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "253/ACT",
            "narrator": "",
            "text": "危険じゃない？",
            "zh": "这样不会很危险吗？",
            "narrator_zh": ""
        },
        {
            "location": "255/TALK",
            "narrator": "ガブリエラ",
            "text": "そうね。\nでも――",
            "zh": "是啊。\n可是——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "256/TALK",
            "narrator": "ガブリエラ",
            "text": "もう嫌なのよ。\n自分のトラウマと\nつき合っていくのは。",
            "zh": "我已经受够了\n一直和自己的心理创伤\n纠缠下去。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "257/SEL",
            "narrator": "（選択肢）",
            "text": "よし、そのトラウマを壊しにいこう！",
            "zh": "好，那就一起去破坏掉那个心理创伤吧！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "258/ACT",
            "narrator": "",
            "text": "よし、そのトラウマを壊しにいこう！",
            "zh": "好，那就一起去破坏掉那个心理创伤吧！",
            "narrator_zh": ""
        },
        {
            "location": "260/TALK",
            "narrator": "ガブリエラ",
            "text": "はあ！？\n何言ってるの！？",
            "zh": "哈啊！？\n你在胡说什么！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "261/SEL",
            "narrator": "（選択肢）",
            "text": "壊しちゃえば、そんな危険なことしなくて済むし",
            "zh": "只要破坏掉，就不用做那种危险的事了",
            "narrator_zh": "（选项）"
        },
        {
            "location": "262/ACT",
            "narrator": "",
            "text": "壊しちゃえば、そんな危険なことしなくて済むし",
            "zh": "只要破坏掉，就不用做那种危险的事了",
            "narrator_zh": ""
        },
        {
            "location": "264/TALK",
            "narrator": "ガブリエラ",
            "text": "それはそうだけど……",
            "zh": "话是这么说没错……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "265/TALK",
            "narrator": "ガブリエラ",
            "text": "トラウマや恐怖症って\n心の奥底にあるもの\nだし、すごい強固なの。",
            "zh": "可心理创伤和恐怖症\n是藏在心灵最深处的，\n非常顽固。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "266/TALK",
            "narrator": "ガブリエラ",
            "text": "そんな簡単に壊せる\nものじゃないわ。",
            "zh": "不是那么轻易\n就能破坏掉的东西。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "267/SEL",
            "narrator": "（選択肢）",
            "text": "やるだけやってみようよ",
            "zh": "总之先试试看吧",
            "narrator_zh": "（选项）"
        },
        {
            "location": "268/ACT",
            "narrator": "",
            "text": "やるだけやってみようよ",
            "zh": "总之先试试看吧",
            "narrator_zh": ""
        },
        {
            "location": "271/TALK",
            "narrator": "ガブリエラ",
            "text": "うーん……",
            "zh": "唔嗯……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "272/TALK",
            "narrator": "ガブリエラ",
            "text": "そうね、わかったわ。\n上手くいくかは\nわからないけど。",
            "zh": "好吧，我知道了。\n虽然不知道\n能不能顺利。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "273/TALK",
            "narrator": "ガブリエラ",
            "text": "次、あんたがココロの\n中に来たとき、そこへ\n案内してあげる。",
            "zh": "下次你再来我心里时，\n我就带你\n去那里看看。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "284/TALK",
            "narrator": "ガブリエラ",
            "text": "くっ……\n何て事なの？",
            "zh": "唔……\n怎么会这样？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "286/TALK",
            "narrator": "表層ガブリエラ",
            "text": "当然の結果ね。",
            "zh": "理所当然的结果。",
            "narrator_zh": "表层加布里埃拉"
        },
        {
            "location": "287/TALK",
            "narrator": "ガブリエラ",
            "text": "一度撤退ね。\nすぐに戻ってくるから\n待ってらっしゃい。",
            "zh": "暂时先撤退吧。\n我很快就会回来，\n给我等着。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "296/TALK",
            "narrator": "表層ガブリエラ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "表层加布里埃拉"
        },
        {
            "location": "307/TALK",
            "narrator": "表層ガブリエラ",
            "text": "ありがとう。\nお陰であたし自身を\n守ることができたわ。",
            "zh": "谢谢。\n多亏了你，\n我才保住了自己。",
            "narrator_zh": "表层加布里埃拉"
        },
        {
            "location": "308/TALK",
            "narrator": "表層ガブリエラ",
            "text": "でもまさか、あたしを\n支援してくれるとは\n思わなかった。",
            "zh": "不过真没想到，\n你居然会站在\n我这边。",
            "narrator_zh": "表层加布里埃拉"
        },
        {
            "location": "309/SEL",
            "narrator": "（選択肢）",
            "text": "つばめには裏があると思うから",
            "zh": "因为我觉得燕另有隐情",
            "narrator_zh": "（选项）"
        },
        {
            "location": "310/ACT",
            "narrator": "",
            "text": "つばめには裏があると思うから",
            "zh": "因为我觉得燕另有隐情",
            "narrator_zh": ""
        },
        {
            "location": "312/TALK",
            "narrator": "表層ガブリエラ",
            "text": "その通り。あの子に\n近づいてはダメ。",
            "zh": "说得没错。绝对\n不能靠近那孩子。",
            "narrator_zh": "表层加布里埃拉"
        },
        {
            "location": "313/TALK",
            "narrator": "表層ガブリエラ",
            "text": "ただでさえあたしは\n壊される可能性が\n高いんだから……",
            "zh": "本来我被她破坏的\n可能性就\n很高了……",
            "narrator_zh": "表层加布里埃拉"
        },
        {
            "location": "314/SEL",
            "narrator": "（選択肢）",
            "text": "え？どういうこと？",
            "zh": "诶？这是什么意思？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "315/ACT",
            "narrator": "",
            "text": "え？どういうこと？",
            "zh": "诶？这是什么意思？",
            "narrator_zh": ""
        },
        {
            "location": "317/TALK",
            "narrator": "表層ガブリエラ",
            "text": "え？　いえ、\nなんでもないのよ。",
            "zh": "诶？　没有，\n没什么呀。",
            "narrator_zh": "表层加布里埃拉"
        },
        {
            "location": "318/SEL",
            "narrator": "（選択肢）",
            "text": "え―――――― …",
            "zh": "诶—————— ……",
            "narrator_zh": "（选项）"
        },
        {
            "location": "319/ACT",
            "narrator": "",
            "text": "え―――――― …",
            "zh": "诶—————— ……",
            "narrator_zh": ""
        },
        {
            "location": "321/TALK",
            "narrator": "表層ガブリエラ",
            "text": "わ、わかったわよ。\nあんたには借りが\nあるし…仕方ないわね。",
            "zh": "知、知道了啦。\n毕竟我欠你个人情……\n真拿你没办法。",
            "narrator_zh": "表层加布里埃拉"
        },
        {
            "location": "322/TALK",
            "narrator": "表層ガブリエラ",
            "text": "あたし、\nフェノメノンを発症\nしやすい体質なのよ。",
            "zh": "我是那种\n很容易发症PhenoMENON的\n体质哦。",
            "narrator_zh": "表层加布里埃拉"
        },
        {
            "location": "323/SEL",
            "narrator": "（選択肢）",
            "text": "そういうの、あるの！？",
            "zh": "还有这种体质的吗！？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "324/ACT",
            "narrator": "",
            "text": "そういうの、あるの！？",
            "zh": "还有这种体质的吗！？",
            "narrator_zh": ""
        },
        {
            "location": "326/TALK",
            "narrator": "表層ガブリエラ",
            "text": "うーん、\nちょっと誤解を招く\n言い方だったかも。",
            "zh": "唔嗯，\n刚才的说法\n可能容易让人误会。",
            "narrator_zh": "表层加布里埃拉"
        },
        {
            "location": "327/TALK",
            "narrator": "表層ガブリエラ",
            "text": "ココロの中に大きな\nトラウマがあって――",
            "zh": "我心里藏着一个\n很大的心理创伤——",
            "narrator_zh": "表层加布里埃拉"
        },
        {
            "location": "329/TALK",
            "narrator": "表層ガブリエラ",
            "text": "発症のトリガーに\nなりやすいのよ。",
            "zh": "所以很容易成为\n发症的导火索。",
            "narrator_zh": "表层加布里埃拉"
        },
        {
            "location": "330/SEL",
            "narrator": "（選択肢）",
            "text": "なるほど…",
            "zh": "原来如此……",
            "narrator_zh": "（选项）"
        },
        {
            "location": "331/ACT",
            "narrator": "",
            "text": "なるほど…",
            "zh": "原来如此……",
            "narrator_zh": ""
        },
        {
            "location": "333/TALK",
            "narrator": "表層ガブリエラ",
            "text": "もし発症したら\n当然みんなに迷惑\nかけるし――",
            "zh": "要是真的发症了，\n肯定会给大家\n添麻烦——",
            "narrator_zh": "表层加布里埃拉"
        },
        {
            "location": "334/TALK",
            "narrator": "表層ガブリエラ",
            "text": "その時つばめに\n壊されちゃうかも\nしれない。",
            "zh": "到那时，说不定\n就会被燕\n破坏掉。",
            "narrator_zh": "表层加布里埃拉"
        },
        {
            "location": "335/TALK",
            "narrator": "表層ガブリエラ",
            "text": "だから、あたしの\n傍からつばめを\n排除しないと。",
            "zh": "所以，必须把燕\n从我的身边\n排除掉才行。",
            "narrator_zh": "表层加布里埃拉"
        },
        {
            "location": "336/TALK",
            "narrator": "表層ガブリエラ",
            "text": "目標は、\nトライナリーからの\n除隊よ！",
            "zh": "目标是，\n把她从三重奏\n除队！",
            "narrator_zh": "表层加布里埃拉"
        },
        {
            "location": "337/SEL",
            "narrator": "（選択肢）",
            "text": "つばめ、悲しむよ？",
            "zh": "燕会伤心的哦？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "338/SEL",
            "narrator": "（選択肢）",
            "text": "その通り！　除隊せよ！",
            "zh": "没错！　勒令退队！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "339/ACT",
            "narrator": "",
            "text": "つばめ、悲しむよ？",
            "zh": "燕会伤心的哦？",
            "narrator_zh": ""
        },
        {
            "location": "340/TALK",
            "narrator": "表層ガブリエラ",
            "text": "うっ……",
            "zh": "唔……",
            "narrator_zh": "表层加布里埃拉"
        },
        {
            "location": "341/TALK",
            "narrator": "表層ガブリエラ",
            "text": "うるさいわね。\nいいのよ、あんな奴。",
            "zh": "吵死了。\n管她呢，那种家伙。",
            "narrator_zh": "表层加布里埃拉"
        },
        {
            "location": "342/TALK",
            "narrator": "表層ガブリエラ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "表层加布里埃拉"
        },
        {
            "location": "343/TALK",
            "narrator": "表層ガブリエラ",
            "text": "なんて割り切れたら\nもっと事態は進展\nしてたかもね。",
            "zh": "要是真能这么干脆\n利落地割舍掉，\n事态说不定早就推进了。",
            "narrator_zh": "表层加布里埃拉"
        },
        {
            "location": "344/ACT",
            "narrator": "",
            "text": "その通り！\n除隊せよ！",
            "zh": "没错！\n勒令退队！",
            "narrator_zh": ""
        },
        {
            "location": "345/TALK",
            "narrator": "表層ガブリエラ",
            "text": "えっ……ええっ？\nなんかノリノリね！",
            "zh": "诶……诶诶？\n你干嘛这么起劲啊！",
            "narrator_zh": "表层加布里埃拉"
        },
        {
            "location": "346/TALK",
            "narrator": "表層ガブリエラ",
            "text": "ま、まあでも。",
            "zh": "那、那个不过嘛。",
            "narrator_zh": "表层加布里埃拉"
        },
        {
            "location": "347/TALK",
            "narrator": "表層ガブリエラ",
            "text": "鬼の中にも仏がいる\nって言うし。",
            "zh": "俗话说恶鬼之中\n也有慈悲的佛嘛。",
            "narrator_zh": "表层加布里埃拉"
        },
        {
            "location": "348/TALK",
            "narrator": "表層ガブリエラ",
            "text": "出来ればそうしないで\n何とか解決したい\nところよね。",
            "zh": "如果可以的话，\n还是想尽量不那样做\n就解决掉才好。",
            "narrator_zh": "表层加布里埃拉"
        },
        {
            "location": "350/SEL",
            "narrator": "（選択肢）",
            "text": "よし、そのトラウマを壊しにいこう！",
            "zh": "好，那就一起去破坏掉那个心理创伤吧！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "351/ACT",
            "narrator": "",
            "text": "よし、そのトラウマを壊しにいこう！",
            "zh": "好，那就一起去破坏掉那个心理创伤吧！",
            "narrator_zh": ""
        },
        {
            "location": "353/TALK",
            "narrator": "表層ガブリエラ",
            "text": "はあ！？\n何言ってるの！？",
            "zh": "哈啊！？\n你在胡说什么！？",
            "narrator_zh": "表层加布里埃拉"
        },
        {
            "location": "354/SEL",
            "narrator": "（選択肢）",
            "text": "壊しちゃえば、発症しにくくなるでしょ？",
            "zh": "只要破坏掉，就不容易发症了吧？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "355/ACT",
            "narrator": "",
            "text": "壊しちゃえば、発症しにくくなるでしょ？",
            "zh": "只要破坏掉，就不容易发症了吧？",
            "narrator_zh": ""
        },
        {
            "location": "357/TALK",
            "narrator": "表層ガブリエラ",
            "text": "それはそうだけど……",
            "zh": "话是这么说没错……",
            "narrator_zh": "表层加布里埃拉"
        },
        {
            "location": "358/TALK",
            "narrator": "表層ガブリエラ",
            "text": "トラウマや恐怖症って\n心の奥底にあるもの\nだし、すごい強固なの。",
            "zh": "可心理创伤和恐怖症\n是藏在心灵最深处的，\n非常顽固。",
            "narrator_zh": "表层加布里埃拉"
        },
        {
            "location": "359/TALK",
            "narrator": "表層ガブリエラ",
            "text": "そんな簡単に壊せる\nものじゃないわ。",
            "zh": "不是那么轻易\n就能破坏掉的东西。",
            "narrator_zh": "表层加布里埃拉"
        },
        {
            "location": "360/SEL",
            "narrator": "（選択肢）",
            "text": "やるだけやってみようよ",
            "zh": "总之先试试看吧",
            "narrator_zh": "（选项）"
        },
        {
            "location": "361/ACT",
            "narrator": "",
            "text": "やるだけやってみようよ",
            "zh": "总之先试试看吧",
            "narrator_zh": ""
        },
        {
            "location": "364/TALK",
            "narrator": "表層ガブリエラ",
            "text": "うーん……",
            "zh": "唔嗯……",
            "narrator_zh": "表层加布里埃拉"
        },
        {
            "location": "365/TALK",
            "narrator": "表層ガブリエラ",
            "text": "そうね、わかったわ。\n上手くいくかは\nわからないけど。",
            "zh": "好吧，我知道了。\n虽然不知道\n能不能顺利。",
            "narrator_zh": "表层加布里埃拉"
        },
        {
            "location": "366/TALK",
            "narrator": "表層ガブリエラ",
            "text": "次、あんたがココロの\n中に来たとき、そこへ\n案内してあげるわ。",
            "zh": "下次你再来我心里时，\n我就带你\n去那里看看。",
            "narrator_zh": "表层加布里埃拉"
        }
    ]
}
