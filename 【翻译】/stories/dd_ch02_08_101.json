{
    "dir": "chap08/daydra/dd_ch02_08_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "8202",
        "cid": "ayami",
        "title": "002 メインストーリー",
        "sub_title": "先輩会議＜前編＞",
        "title_zh": "002 主线剧情",
        "sub_title_zh": "前辈会议＜前篇＞"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "先輩会議",
            "zh": "前辈会议",
            "narrator_zh": ""
        },
        {
            "location": "38/TALK",
            "narrator": "みやび",
            "text": "このよもぎ地あん\nチーズ、マジ絶品\nぞね！",
            "zh": "这个艾草豆沙\n芝士，真是绝品\n啵！",
            "narrator_zh": "雅"
        },
        {
            "location": "40/TALK",
            "narrator": "ガブリエラ",
            "text": "だから言ったでしょ？\n一度は食べないと\n勿体ない、って。",
            "zh": "所以我才说过了吧？\n不吃一次的话\n太可惜了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "41/TALK",
            "narrator": "アーヤ",
            "text": "私には紅茶まん\n勧めたじゃない？",
            "zh": "你给我推荐的\n不是红茶馒头吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "44/TALK",
            "narrator": "ガブリエラ",
            "text": "それも美味しいから\nお勧めなのよ。",
            "zh": "那个也很好吃，\n所以才推荐的哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "46/TALK",
            "narrator": "みやび",
            "text": "さすがガブちゃんや。\nむぎまるマスターの\n称号を与えるぞね。",
            "zh": "不愧是加布咯。\n赐给你麦丸大师的\n称号啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "48/TALK",
            "narrator": "アーヤ",
            "text": "今度は逢瀬さん達も\n連れてきたいわね。",
            "zh": "下次把逢濑她们也\n带来吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "50/TALK",
            "narrator": "ガブリエラ",
            "text": "…必要ないわよ。\n新人は新人同士で\n仲良くやると思うし。",
            "zh": "……没必要吧。\n新人和新人之间\n应该能处得挺好的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "51/TALK",
            "narrator": "みやび",
            "text": "あの二人、中々運命\n的な出会い方しちょっ\nたき――",
            "zh": "那两个人，相遇得\n还蛮有宿命感的\n嘛——",
            "narrator_zh": "雅"
        },
        {
            "location": "53/TALK",
            "narrator": "みやび",
            "text": "熱い友情が生まれて、\n二人だけの世界を築き\n上げる可能性大ぞね。",
            "zh": "萌生出炽热的友情，\n筑起二人世界\n的可能性大得很啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "56/TALK",
            "narrator": "ガブリエラ",
            "text": "…二人だけの世界とか\n言うと、ちょっと\n怪しく聞こえるわよ？",
            "zh": "……说什么二人世界，\n听起来怎么有点\n怪怪的哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "58/TALK",
            "narrator": "みやび",
            "text": "絵になると思うがよ。\n二人とも外見は文句\nなしやきね。",
            "zh": "我觉得蛮有画面感咯。\n两个人外形都\n无可挑剔嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "61/TALK",
            "narrator": "アーヤ",
            "text": "はぁ…少し真面目に\n考えてよ。",
            "zh": "唉……稍微认真地\n想想啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "63/TALK",
            "narrator": "アーヤ",
            "text": "私達はあの二人の\n先輩なのよ？",
            "zh": "我们可是那两人的\n前辈哦？",
            "narrator_zh": "绫水"
        },
        {
            "location": "65/TALK",
            "narrator": "ガブリエラ",
            "text": "任務とバイト以外、\n無理に関わる\n必要もないんでしょ。",
            "zh": "除了任务和打工，\n也没必要硬去\n凑近乎吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "67/TALK",
            "narrator": "みやび",
            "text": "先輩にあんまし\nちょっかい出される\nゆうんも――",
            "zh": "老是被前辈\n去招惹\n什么的——",
            "narrator_zh": "雅"
        },
        {
            "location": "68/TALK",
            "narrator": "みやび",
            "text": "息苦しく思われる\nかもしれんがよ。",
            "zh": "说不定会被觉得\n喘不过气咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "69/TALK",
            "narrator": "アーヤ",
            "text": "とはいっても、\n放ってはおけない\nでしょ？",
            "zh": "话虽如此，\n也不能放着不管\n吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "70/TALK",
            "narrator": "アーヤ",
            "text": "特に、逢瀬さんは\n本当に普通の子なん\nだから…。",
            "zh": "尤其是逢濑，\n她真的只是个\n普通女孩……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "71/TALK",
            "narrator": "ガブリエラ",
            "text": "あれのどこが！？",
            "zh": "她哪里普通了！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "72/TALK",
            "narrator": "ガブリエラ",
            "text": "殺されても\n何故か生き返ったり\nする――",
            "zh": "就算被杀了\n也会莫名其妙地\n活过来——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "73/TALK",
            "narrator": "ガブリエラ",
            "text": "得体の知れない\n変な奴じゃない。",
            "zh": "根本是个来历不明的\n怪人好吗。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "74/TALK",
            "narrator": "アーヤ",
            "text": "そうかしら？",
            "zh": "是吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "75/TALK",
            "narrator": "ガブリエラ",
            "text": "そうよ！\nあいつ、絶対に裏が\nあるに違いないわ。",
            "zh": "就是啊！\n那家伙绝对有\n什么隐情。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "76/TALK",
            "narrator": "ガブリエラ",
            "text": "例えば、あたし達と\n敵対するような\n何か、とか…。",
            "zh": "比方说，会与我们\n为敌之类的\n什么东西……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "78/TALK",
            "narrator": "アーヤ",
            "text": "疑い過ぎじゃない？\nそこまで言うのは\nかわいそうよ。",
            "zh": "是不是疑心太重了？\n话说成那样\n也太可怜了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "79/TALK",
            "narrator": "ガブリエラ",
            "text": "得体のしれない奴を\n無条件で信じて、\n仲間に迎えるの？",
            "zh": "难道要无条件相信\n一个来历不明的家伙，\n接纳她当同伴吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "81/TALK",
            "narrator": "ガブリエラ",
            "text": "それ、リーダーとして\n無責任なんじゃない？",
            "zh": "那样作为队长，\n岂不是太不负责任了？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "82/TALK",
            "narrator": "アーヤ",
            "text": "なっ！？\nちょっとギャヴィ、\n今のは――",
            "zh": "什！？\n喂加维，\n你刚才那话——",
            "narrator_zh": "绫水"
        },
        {
            "location": "84/TALK",
            "narrator": "みやび",
            "text": "こうなったら、\nいよいよあの人の\n力を借りる時やね。",
            "zh": "事到如今，\n终于到向那位\n借力量的时候咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "86/TALK",
            "narrator": "ガブリエラ",
            "text": "あの人？",
            "zh": "那位？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "88/TALK",
            "narrator": "みやび",
            "text": "うむ、アーヤの姉に\nして、うちのゴッド。\nエリカさんや。",
            "zh": "嗯，既是绫水的姐姐，\n也是我的神。\n领火咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "92/TALK",
            "narrator": "アーヤ",
            "text": "いや、何でよ？\nうちの姉は関係ない\nでしょ？",
            "zh": "不是，为什么啊？\n我姐又没有关系\n吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "94/TALK",
            "narrator": "みやび",
            "text": "大ありや。\nあの人の経歴、知らん\nわけやないやろ？",
            "zh": "大有关系咯。\n她的履历，你不会\n不晓得吧？",
            "narrator_zh": "雅"
        },
        {
            "location": "96/TALK",
            "narrator": "ガブリエラ",
            "text": "心と量子の専門家で、\nフェノメノン研究の\n第一人者の博士で――",
            "zh": "心与量子领域的专家，\nPhenoMENON研究的\n第一人博士——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "98/TALK",
            "narrator": "ガブリエラ",
            "text": "付属大学の客員教授も\nやってたから、管理庁\nにも顔が利くのよね？",
            "zh": "还担任过附属大学的\n客座教授，在管理厅\n也吃得开对吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "101/TALK",
            "narrator": "みやび",
            "text": "うむ、完璧花丸\nＡプラス！\nよくできました。",
            "zh": "嗯，满分小红花\nA+！\n干得漂亮。",
            "narrator_zh": "雅"
        },
        {
            "location": "104/TALK",
            "narrator": "ガブリエラ",
            "text": "誰かさんに何度も\n聞かされたおかげよ。",
            "zh": "托某人反复唠叨\n好多遍的福呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "106/TALK",
            "narrator": "みやび",
            "text": "とまあ、そんな\nゴッドが身内にいらっ\nしゃるんやき――",
            "zh": "总之嘛，既然家里\n有这么一位神在\n啵——",
            "narrator_zh": "雅"
        },
        {
            "location": "108/TALK",
            "narrator": "みやび",
            "text": "つばめちゃん達の\nことも、お願いして\n調べてもらうがよ。",
            "zh": "燕她们的事，\n也拜托她\n帮着查一哈咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "111/TALK",
            "narrator": "アーヤ",
            "text": "却下！　あの人に\n連絡するなんて、\n嫌よ。",
            "zh": "驳回！让我去\n联系那个人，\n我才不要。",
            "narrator_zh": "绫水"
        },
        {
            "location": "114/TALK",
            "narrator": "ガブリエラ",
            "text": "実の姉に対して…、\n随分冷たいのね？",
            "zh": "对自己的亲姐姐……\n还真是冷淡呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "116/TALK",
            "narrator": "みやび",
            "text": "なんと贅沢な。\nうちがエリカさんの\n妹やったとしたら――",
            "zh": "真是太奢侈咯。\n我要是领火的\n妹妹的话——",
            "narrator_zh": "雅"
        },
        {
            "location": "117/TALK",
            "narrator": "みやび",
            "text": "もう２４時間いつでも\n隣でべったりやぞ？",
            "zh": "24小时随时都\n黏在她身边啵？",
            "narrator_zh": "雅"
        },
        {
            "location": "121/TALK",
            "narrator": "みやび",
            "text": "百合展開も喜んで\n受け入れるぞね。",
            "zh": "百合展开我也乐意\n接受啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "123/TALK",
            "narrator": "アーヤ",
            "text": "人の姉で変なこと\n考えるの、やめて\nもらえる？",
            "zh": "拿别人的姐姐\n想些奇怪的事，\n能停一停吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "126/TALK",
            "narrator": "アーヤ",
            "text": "第一、本当にあの人の\n妹になったら、そんな\n考えぶっ飛ぶから…。",
            "zh": "再说了，真当了\n那人的妹妹，那种\n念头早飞光了……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "129/TALK",
            "narrator": "みやび",
            "text": "けんど、エリカさんの\n協力はうちら全員の\n安全に関わることや。",
            "zh": "不过，领火的\n协助可是关系到我们\n全员的安全咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "130/TALK",
            "narrator": "みやび",
            "text": "それを嫌がるなら、\n理由を聞かんことには\n納得できんがよ。",
            "zh": "要是你不乐意，\n不听听理由\n可没法服气咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "132/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "133/TALK",
            "narrator": "アーヤ",
            "text": "…無駄よ。あの人、\n電話にもメールにも\n出たことないし――",
            "zh": "……没用的。那个人，\n电话和邮件\n从来都不回——",
            "narrator_zh": "绫水"
        },
        {
            "location": "134/TALK",
            "narrator": "アーヤ",
            "text": "返事もくれないん\nだから。",
            "zh": "也不会给我\n回信的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "136/TALK",
            "narrator": "みやび",
            "text": "ＷＡＶＥはどうや？\nＷＡＶＥアカウントは\n知ってるが？",
            "zh": "WAVE怎么样咯？\nWAVE账号总归\n晓得吧？",
            "narrator_zh": "雅"
        },
        {
            "location": "138/TALK",
            "narrator": "アーヤ",
            "text": "知ってはいるけど、\nもう何年も連絡して\nないから…。",
            "zh": "知道是知道，\n但已经好几年\n没联系过了……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "139/TALK",
            "narrator": "ガブリエラ",
            "text": "送れば見てはくれる\nかもしれないでしょ？",
            "zh": "发过去的话，说不定\n她会看一眼呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "140/TALK",
            "narrator": "みやび",
            "text": "ダメもとでもえいき、\n連絡くれと書きこんで\nみぃ。",
            "zh": "碰碰运气也要得嘛，\n发消息叫她\n联系你试试。",
            "narrator_zh": "雅"
        },
        {
            "location": "142/TALK",
            "narrator": "アーヤ",
            "text": "…わかったわよ。\nでも、返信なくても\n知らないわよ？",
            "zh": "……知道了。\n不过，她不回的话\n我可不管哦？",
            "narrator_zh": "绫水"
        },
        {
            "location": "152/TALK",
            "narrator": "アーヤ",
            "text": "どうしよう(>_<)",
            "zh": "怎么办呀(>_<)",
            "narrator_zh": "绫水"
        },
        {
            "location": "154/TALK",
            "narrator": "アーヤ",
            "text": "連絡取りたくないの",
            "zh": "不想联系她",
            "narrator_zh": "绫水"
        },
        {
            "location": "156/SEL",
            "narrator": "",
            "text": "そんなにお姉さんが嫌い？",
            "zh": "这么讨厌你姐姐吗？",
            "narrator_zh": ""
        },
        {
            "location": "157/ACT",
            "narrator": "",
            "text": "そんなにお姉さんが嫌い？",
            "zh": "这么讨厌你姐姐吗？",
            "narrator_zh": ""
        },
        {
            "location": "159/TALK",
            "narrator": "アーヤ",
            "text": "嫌いっていうか(-.-;)",
            "zh": "与其说是讨厌(-.-;)",
            "narrator_zh": "绫水"
        },
        {
            "location": "160/TALK",
            "narrator": "アーヤ",
            "text": "信用できない",
            "zh": "就是信不过",
            "narrator_zh": "绫水"
        },
        {
            "location": "161/TALK",
            "narrator": "アーヤ",
            "text": "いい加減だし(--#)",
            "zh": "又吊儿郎当的(--#)",
            "narrator_zh": "绫水"
        },
        {
            "location": "162/TALK",
            "narrator": "アーヤ",
            "text": "自分勝手でいい加減で",
            "zh": "既任性又敷衍",
            "narrator_zh": "绫水"
        },
        {
            "location": "163/TALK",
            "narrator": "アーヤ",
            "text": "家のことも全然顧みないで",
            "zh": "家里的事也完全不管不顾",
            "narrator_zh": "绫水"
        },
        {
            "location": "164/TALK",
            "narrator": "アーヤ",
            "text": "そんな人の力を借りるなんて",
            "zh": "要借那种人的力量什么的",
            "narrator_zh": "绫水"
        },
        {
            "location": "165/TALK",
            "narrator": "アーヤ",
            "text": "絶対嫌！(｀ヘ´)",
            "zh": "绝对不要！(｀ヘ´)",
            "narrator_zh": "绫水"
        },
        {
            "location": "168/SEL",
            "narrator": "",
            "text": "大変だったんだね",
            "zh": "真是辛苦你了",
            "narrator_zh": ""
        },
        {
            "location": "169/ACT",
            "narrator": "",
            "text": "大変だったんだね",
            "zh": "真是辛苦你了",
            "narrator_zh": ""
        },
        {
            "location": "171/TALK",
            "narrator": "アーヤ",
            "text": "ごめん",
            "zh": "抱歉",
            "narrator_zh": "绫水"
        },
        {
            "location": "173/TALK",
            "narrator": "アーヤ",
            "text": "愚痴聞かせて(-ω-;)",
            "zh": "让你听我发牢骚(-ω-;)",
            "narrator_zh": "绫水"
        },
        {
            "location": "174/TALK",
            "narrator": "アーヤ",
            "text": "今は、連絡を取らない方法を考えないとね",
            "zh": "现在得想想不跟她联系的办法才行",
            "narrator_zh": "绫水"
        },
        {
            "location": "176/SEL",
            "narrator": "",
            "text": "なら、話題を反らそう",
            "zh": "那，把话题岔开吧",
            "narrator_zh": ""
        },
        {
            "location": "177/ACT",
            "narrator": "",
            "text": "なら、話題を反らそう",
            "zh": "那，把话题岔开吧",
            "narrator_zh": ""
        },
        {
            "location": "179/TALK",
            "narrator": "アーヤ",
            "text": "どうするの？( ・_・)σﾞ",
            "zh": "要怎么做？( ・_・)σﾞ",
            "narrator_zh": "绫水"
        },
        {
            "location": "181/SEL",
            "narrator": "",
            "text": "神楽のことを話そうよ",
            "zh": "聊聊神乐的事吧",
            "narrator_zh": ""
        },
        {
            "location": "182/ACT",
            "narrator": "",
            "text": "神楽のことを話そうよ",
            "zh": "聊聊神乐的事吧",
            "narrator_zh": ""
        },
        {
            "location": "184/TALK",
            "narrator": "アーヤ",
            "text": "え？(-.-;)",
            "zh": "咦？(-.-;)",
            "narrator_zh": "绫水"
        },
        {
            "location": "187/TALK",
            "narrator": "アーヤ",
            "text": "でも",
            "zh": "可是",
            "narrator_zh": "绫水"
        },
        {
            "location": "189/TALK",
            "narrator": "アーヤ",
            "text": "あの子も色々",
            "zh": "那孩子也有各种",
            "narrator_zh": "绫水"
        },
        {
            "location": "190/TALK",
            "narrator": "アーヤ",
            "text": "ちょっと思うところが(-ω-;)",
            "zh": "我稍微有点想法(-ω-;)",
            "narrator_zh": "绫水"
        },
        {
            "location": "192/SEL",
            "narrator": "",
            "text": "だからこそじゃない？",
            "zh": "正因如此才要聊吧？",
            "narrator_zh": ""
        },
        {
            "location": "193/ACT",
            "narrator": "",
            "text": "だからこそじゃない？",
            "zh": "正因如此才要聊吧？",
            "narrator_zh": ""
        },
        {
            "location": "195/TALK",
            "narrator": "アーヤ",
            "text": "そうだけど(>_<)",
            "zh": "话是这么说(>_<)",
            "narrator_zh": "绫水"
        },
        {
            "location": "198/TALK",
            "narrator": "アーヤ",
            "text": "ううん",
            "zh": "不",
            "narrator_zh": "绫水"
        },
        {
            "location": "199/TALK",
            "narrator": "アーヤ",
            "text": "そうね",
            "zh": "也是呢",
            "narrator_zh": "绫水"
        },
        {
            "location": "201/TALK",
            "narrator": "アーヤ",
            "text": "このままじゃ",
            "zh": "照这样下去",
            "narrator_zh": "绫水"
        },
        {
            "location": "202/TALK",
            "narrator": "アーヤ",
            "text": "ずっと姉のこと詮索されそうだし(´o｀；",
            "zh": "估计她们会一直追问我姐的事(´o｀；",
            "narrator_zh": "绫水"
        },
        {
            "location": "205/TALK",
            "narrator": "アーヤ",
            "text": "どうしたものかしら",
            "zh": "该怎么办才好呢",
            "narrator_zh": "绫水"
        },
        {
            "location": "250/TALK",
            "narrator": "アーヤ",
            "text": "あー。",
            "zh": "啊—。",
            "narrator_zh": "绫水"
        },
        {
            "location": "251/TALK",
            "narrator": "アーヤ",
            "text": "まさかの３回連続\n姉問題とはね。",
            "zh": "没想到连续3次\n都是姐姐的问题。",
            "narrator_zh": "绫水"
        },
        {
            "location": "252/TALK",
            "narrator": "アーヤ",
            "text": "あなた、地雷踏むのが\n本当に上手ね。",
            "zh": "你踩地雷\n可真是有一套呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "253/SEL",
            "narrator": "",
            "text": "今回のは$me$からじゃないよ！",
            "zh": "这次真不是$me$挑起的！",
            "narrator_zh": ""
        },
        {
            "location": "254/ACT",
            "narrator": "",
            "text": "今回のは$me$からじゃないよ！",
            "zh": "这次真不是$me$挑起的！",
            "narrator_zh": ""
        },
        {
            "location": "256/TALK",
            "narrator": "アーヤ",
            "text": "ふふ、わかってる。",
            "zh": "呵呵，我知道。",
            "narrator_zh": "绫水"
        },
        {
            "location": "257/TALK",
            "narrator": "アーヤ",
            "text": "ちょっと意地悪して\nみたかっただけよ？",
            "zh": "只是想稍微\n捉弄你一下而已哦？",
            "narrator_zh": "绫水"
        },
        {
            "location": "258/SEL",
            "narrator": "",
            "text": "姉問題、根深いね",
            "zh": "姐姐的问题，真是根深蒂固啊",
            "narrator_zh": ""
        },
        {
            "location": "259/ACT",
            "narrator": "",
            "text": "姉問題、根深いね",
            "zh": "姐姐的问题，真是根深蒂固啊",
            "narrator_zh": ""
        },
        {
            "location": "261/TALK",
            "narrator": "アーヤ",
            "text": "ホントにね。",
            "zh": "真是的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "262/TALK",
            "narrator": "アーヤ",
            "text": "その実、単に意地を\n張ってるだけなんだ\nけどね。",
            "zh": "其实呀，说白了\n也只是在逞强\n而已。",
            "narrator_zh": "绫水"
        },
        {
            "location": "263/SEL",
            "narrator": "",
            "text": "え？そうなの？",
            "zh": "咦？是这样吗？",
            "narrator_zh": ""
        },
        {
            "location": "264/ACT",
            "narrator": "",
            "text": "え？そうなの？",
            "zh": "咦？是这样吗？",
            "narrator_zh": ""
        },
        {
            "location": "266/TALK",
            "narrator": "アーヤ",
            "text": "あぁ、もちろん理由は\n色々あるのよ？",
            "zh": "嗯，当然理由是\n有各种各样的哦？",
            "narrator_zh": "绫水"
        },
        {
            "location": "267/TALK",
            "narrator": "アーヤ",
            "text": "そりゃもう、ここでは\n語りきれないくらいに。",
            "zh": "多到在这里\n都说不完呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "268/TALK",
            "narrator": "アーヤ",
            "text": "ホントはそのお話も\nしてあげたいんだけどね、\nどうせヒマだし。",
            "zh": "其实我也想把那些事\n都讲给你听呀，\n反正闲着也是闲着。",
            "narrator_zh": "绫水"
        },
        {
            "location": "270/TALK",
            "narrator": "アーヤ",
            "text": "でも司書である私には\nその権利は無いのよ。",
            "zh": "不过身为司书的我\n并没有那个权利呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "272/TALK",
            "narrator": "アーヤ",
            "text": "…っと、無駄話してる\n場合じゃないわね。\n扉をコールしなくちゃ。",
            "zh": "……哎呀，现在可不是\n闲聊的时候。\n得呼叫心之扉了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "277/TALK",
            "narrator": "アーヤ",
            "text": "オープンプロセス、\n0x86D番地から\n0x513番地へ。",
            "zh": "开放进程，\n从0x86D地址\n到0x513地址。",
            "narrator_zh": "绫水"
        },
        {
            "location": "292/TALK",
            "narrator": "アーヤ",
            "text": "シーク完了。",
            "zh": "搜索完成。",
            "narrator_zh": "绫水"
        },
        {
            "location": "294/TALK",
            "narrator": "アーヤ",
            "text": "あー、でも\nちょっとラッキーかも。",
            "zh": "啊，不过\n说不定还有点走运。",
            "narrator_zh": "绫水"
        },
        {
            "location": "296/TALK",
            "narrator": "アーヤ",
            "text": "今回の案件、\n姉のことが主題じゃ\nなかったわよ。",
            "zh": "这次的案件，\n主题并不是\n姐姐的事哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "297/TALK",
            "narrator": "アーヤ",
            "text": "寧ろ、卯月神楽について\n思うところが\nあるみたいね。",
            "zh": "倒不如说，似乎是对\n卯月神乐有什么\n想法呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "298/SEL",
            "narrator": "",
            "text": "へー、そうなんだ",
            "zh": "咦——这样啊",
            "narrator_zh": ""
        },
        {
            "location": "299/ACT",
            "narrator": "",
            "text": "へー、そうなんだ",
            "zh": "咦——这样啊",
            "narrator_zh": ""
        },
        {
            "location": "301/TALK",
            "narrator": "アーヤ",
            "text": "意外でしょ。\n私も意外だったわ。",
            "zh": "很意外吧。\n我也挺意外的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "303/TALK",
            "narrator": "アーヤ",
            "text": "どうも私は、卯月に\nちょっとコンプレックス\nを抱いてるみたい。",
            "zh": "看样子我似乎对\n卯月稍微有点\n自卑感呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "304/SEL",
            "narrator": "",
            "text": "なんで？",
            "zh": "为什么？",
            "narrator_zh": ""
        },
        {
            "location": "305/ACT",
            "narrator": "",
            "text": "なんで？",
            "zh": "为什么？",
            "narrator_zh": ""
        },
        {
            "location": "307/TALK",
            "narrator": "アーヤ",
            "text": "スペックが高く見える\nみたいね。",
            "zh": "似乎是觉得她\n实力很强呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "308/TALK",
            "narrator": "アーヤ",
            "text": "前回の戦闘で\n随分活躍してたし。",
            "zh": "上次战斗里\n也相当活跃嘛。",
            "narrator_zh": "绫水"
        },
        {
            "location": "309/TALK",
            "narrator": "アーヤ",
            "text": "無意識のうちか\nわからないけど、\n他の子に指示してたり。",
            "zh": "不知是不是无意识的，\n她还会指挥\n其他孩子。",
            "narrator_zh": "绫水"
        },
        {
            "location": "310/TALK",
            "narrator": "アーヤ",
            "text": "私の直感が、天性の\nリーダー質を持ってると\n感じてるみたい。",
            "zh": "我的直觉似乎觉得\n她拥有天生的\n领导才能。",
            "narrator_zh": "绫水"
        },
        {
            "location": "311/TALK",
            "narrator": "アーヤ",
            "text": "その事が原因で、\n近い将来、自分の立場が\n危うくなるのではと。",
            "zh": "因为这件事，担心\n不久的将来，自己的\n立场会岌岌可危。",
            "narrator_zh": "绫水"
        },
        {
            "location": "312/TALK",
            "narrator": "アーヤ",
            "text": "そんな不安がクランを\n生んで、扉を閉ざした\nみたいね。",
            "zh": "似乎就是这种不安\n催生了库兰，把门\n关上了呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "313/TALK",
            "narrator": "アーヤ",
            "text": "まだ出逢って数日。\n全然わからないのに、\n私ってホント心配性。",
            "zh": "明明才认识几天，\n还完全不了解对方，\n我真是太爱操心了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "314/TALK",
            "narrator": "アーヤ",
            "text": "申し訳無いけど、\nクランを倒して不安を\n払拭してくれる？",
            "zh": "不好意思，能请你\n打倒库兰，帮我\n驱散这份不安吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "315/TALK",
            "narrator": "アーヤ",
            "text": "このままだと、\n何を考え出すか\nわからないから。",
            "zh": "再这样下去，\n还不知道会胡思乱想出\n什么来呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "316/SEL",
            "narrator": "",
            "text": "りょうかい",
            "zh": "明白",
            "narrator_zh": ""
        },
        {
            "location": "317/ACT",
            "narrator": "",
            "text": "りょうかい",
            "zh": "明白",
            "narrator_zh": ""
        },
        {
            "location": "320/TALK",
            "narrator": "アーヤ",
            "text": "ありがと。\nいつも助かるわ。",
            "zh": "谢谢。\n每次都多亏有你。",
            "narrator_zh": "绫水"
        },
        {
            "location": "321/TALK",
            "narrator": "アーヤ",
            "text": "$handle$さんと\n國政綾水にとって、\n素敵なココロの旅を！",
            "zh": "祝愿$handle$与\n国政绫水，\n拥有一场美好的心灵之旅！",
            "narrator_zh": "绫水"
        },
        {
            "location": "36/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>5月11日　4:20 PM</color>\n某高校でのフェノメノン戦の２日後、放課後むぎまるにて。",
            "zh": "<color=green>5月11日　4:20 PM</color>\n某高中PhenoMENON战的两天后，放学后的麦丸内。",
            "narrator_zh": "Dialog_EventData"
