{
    "dir": "chap24/daydra/dd_ch02_24_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "24256",
        "cid": "ayami",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "臨戦態勢ガブリエラ",
        "title_zh": "Extra006 额外剧情",
        "sub_title_zh": "临战状态的加布里埃拉"
    },
    "entry": [
        {
            "location": "299/SCENARIO",
            "narrator": "",
            "text": "臨戦態勢ガブリエラ",
            "zh": "临战状态的加布里埃拉",
            "narrator_zh": ""
        },
        {
            "location": "312/TALK",
            "narrator": "アーヤ",
            "text": "…あら？",
            "zh": "……哎呀？",
            "narrator_zh": "绫水"
        },
        {
            "location": "315/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ、はぁ…。",
            "zh": "呼、呼……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "316/TALK",
            "narrator": "アーヤ",
            "text": "おはよう、ギャヴィ…。\nもしかして走って来たの？",
            "zh": "早安，加维……。\n难道你是跑着回来的？",
            "narrator_zh": "绫水"
        },
        {
            "location": "318/TALK",
            "narrator": "ガブリエラ",
            "text": "当然でしょ…。\n何のために、合宿で鍛えたと\n思ってんのよ…。",
            "zh": "那当然了……。\n你以为我在集训里\n锻炼是为了什么呀……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "319/TALK",
            "narrator": "アーヤ",
            "text": "…どれくらい走ってきたの？\nすごく疲れてるように\n見えるけど…。",
            "zh": "……你跑了多远？\n看起来累得\n不行啊……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "320/TALK",
            "narrator": "ガブリエラ",
            "text": "二つ隣の駅まで行って\n帰ってきただけだから、\n大した距離じゃないわ。",
            "zh": "只是跑到隔两站的车站\n再折返而已，\n算不上多远。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "321/TALK",
            "narrator": "アーヤ",
            "text": "そんなに！？\n授業中に寝たりしない\nでしょうね？",
            "zh": "跑那么远！？\n可别上课的时候\n睡着了啊？",
            "narrator_zh": "绫水"
        },
        {
            "location": "323/TALK",
            "narrator": "ガブリエラ",
            "text": "中学の範囲程度、\nとっくにマスターしてるの\nわかってるでしょ？",
            "zh": "初中程度的课程，\n我早就全部掌握了，\n你不是知道吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "324/TALK",
            "narrator": "アーヤ",
            "text": "だからって…。",
            "zh": "就算这样……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "326/TALK",
            "narrator": "ガブリエラ",
            "text": "わかってる、寝ないわよ。\nだからこの話はおしまい！",
            "zh": "我知道了，不会睡的。\n所以这事到此为止！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "327/TALK",
            "narrator": "ガブリエラ",
            "text": "シャワー浴びるんだから、\n邪魔しないで。",
            "zh": "我要去冲个澡，\n别来打扰我。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "333/TALK",
            "narrator": "アーヤ",
            "text": "あ、ギャヴィ…。",
            "zh": "啊，加维……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "336/TALK",
            "narrator": "アーヤ",
            "text": "…あの子…大丈夫かしら？",
            "zh": "……那孩子……没问题吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "337/SEL",
            "narrator": "",
            "text": "ピリピリしてるね",
            "zh": "她绷得好紧啊",
            "narrator_zh": ""
        },
        {
            "location": "338/ACT",
            "narrator": "",
            "text": "ピリピリしてるね",
            "zh": "她绷得好紧啊",
            "narrator_zh": ""
        },
        {
            "location": "355/TALK",
            "narrator": "アーヤ",
            "text": "$handle2$も気づいた？(´o｀；",
            "zh": "$handle2$也注意到了？(´o｀；",
            "narrator_zh": "绫水"
        },
        {
            "location": "356/TALK",
            "narrator": "アーヤ",
            "text": "気持ちはわかるけど",
            "zh": "心情我能理解",
            "narrator_zh": "绫水"
        },
        {
            "location": "357/TALK",
            "narrator": "アーヤ",
            "text": "気持ち張り過ぎ(>_<)",
            "zh": "但精神绷得太紧了(>_<)",
            "narrator_zh": "绫水"
        },
        {
            "location": "358/TALK",
            "narrator": "アーヤ",
            "text": "あれじゃ",
            "zh": "这样下去",
            "narrator_zh": "绫水"
        },
        {
            "location": "359/TALK",
            "narrator": "アーヤ",
            "text": "気持ちが擦れちゃう(; ;)",
            "zh": "心神会磨垮的(; ;)",
            "narrator_zh": "绫水"
        },
        {
            "location": "360/TALK",
            "narrator": "アーヤ",
            "text": "どうにかしないと",
            "zh": "得想想办法才行",
            "narrator_zh": "绫水"
        },
        {
            "location": "362/SEL",
            "narrator": "",
            "text": "そうしてあげて",
            "zh": "那就拜托你了",
            "narrator_zh": ""
        },
        {
            "location": "363/ACT",
            "narrator": "",
            "text": "そうしてあげて",
            "zh": "那就拜托你了",
            "narrator_zh": ""
        },
        {
            "location": "365/TALK",
            "narrator": "アーヤ",
            "text": "任せて",
            "zh": "交给我吧",
            "narrator_zh": "绫水"
        },
        {
            "location": "388/TALK",
            "narrator": "ガブリエラ",
            "text": "…で、何の用事？\n放課後にこんなとこ\n呼び出して…。",
            "zh": "……所以，找我有什么事？\n放学后还特地叫到\n这种地方……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "390/TALK",
            "narrator": "アーヤ",
            "text": "うん…ちょっと、\n最近のギャヴィのことが\n気になって…。",
            "zh": "嗯……就是有点\n在意加维你\n最近的状态……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "391/TALK",
            "narrator": "ガブリエラ",
            "text": "何がよ？",
            "zh": "在意什么？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "392/TALK",
            "narrator": "アーヤ",
            "text": "それよ、その態度。",
            "zh": "就是这个，你这副态度。",
            "narrator_zh": "绫水"
        },
        {
            "location": "393/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィ…三戸浜から\n帰ってから、ちょっと\nピリピリし過ぎよ。",
            "zh": "加维……从三户滨\n回来之后，你未免\n绷得太紧了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "394/TALK",
            "narrator": "アーヤ",
            "text": "少しは落ち着かないと、\n身体も心も擦り切れ\nちゃうわ。",
            "zh": "不稍微静下心来的话，\n身体和精神都会\n吃不消的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "397/TALK",
            "narrator": "ガブリエラ",
            "text": "え？　ちょっと、何それ？",
            "zh": "哎？　等等，什么意思？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "398/TALK",
            "narrator": "ガブリエラ",
            "text": "この状況でピリピリしない\nわけないじゃない。",
            "zh": "在这种节骨眼上怎么可能\n不绷紧神经啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "399/TALK",
            "narrator": "アーヤ",
            "text": "そうかもしれないけど、\n限度ってものがあるでしょ？",
            "zh": "话是这么说，\n可凡事总得有个度吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "400/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしから言わせて\nもらえば、アーヤ達の方が\nおかしく見えるわ。",
            "zh": "要我说的话，\n倒是绫水你们几个\n看起来才奇怪吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "401/TALK",
            "narrator": "ガブリエラ",
            "text": "東京帰ってきてから、\n行く前と変わらない\n毎日じゃない。",
            "zh": "回到东京以后，\n每天过得跟去之前\n根本没什么两样嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "402/TALK",
            "narrator": "ガブリエラ",
            "text": "何考えてんのよ？\n三戸浜での特訓の成果を\n無駄にするつもり？",
            "zh": "你们在想什么啊？\n打算把在三户滨特训的\n成果全白费掉吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "403/TALK",
            "narrator": "アーヤ",
            "text": "無駄になんてしてないわ。\nみんな、ちゃんと訓練は\n続けてるんだから。",
            "zh": "才没有白费。\n大家也都有好好在\n坚持训练啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "405/TALK",
            "narrator": "ガブリエラ",
            "text": "真剣さが足りないのよ！",
            "zh": "认真程度根本不够！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "406/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤも、わかってんの？",
            "zh": "绫水你到底明不明白啊？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "407/TALK",
            "narrator": "ガブリエラ",
            "text": "相手はフェノメノンと\n神楽だけじゃない…。",
            "zh": "我们的对手可不止\nPhenoMENON和神乐……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "408/TALK",
            "narrator": "ガブリエラ",
            "text": "管理庁まで相手にしなきゃ\nいけなくなるかも\nしれないのよ！？",
            "zh": "搞不好连管理厅\n都要一起对付\n也说不定啊！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "410/TALK",
            "narrator": "ガブリエラ",
            "text": "なのに…どうしてみんな、\nちっとも真剣じゃないのよ？",
            "zh": "明明如此……为什么大家\n一点紧张感都没有啊？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "411/TALK",
            "narrator": "アーヤ",
            "text": "…それ、本気で言ってるの？",
            "zh": "……这话，你是认真的吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "412/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィは…私達が、\nこの状況下で不真面目に\n過ごしてると思ってるの？",
            "zh": "加维……你觉得我们\n是在这种状况下\n吊儿郎当地过日子吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "414/TALK",
            "narrator": "ガブリエラ",
            "text": "真面目なら、この状況で\n遊んだりできないはずよ。",
            "zh": "要是认真的话，在这种时候\n怎么还有心思去玩啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "415/TALK",
            "narrator": "アーヤ",
            "text": "逆よ、それは。",
            "zh": "恰恰相反，加维。",
            "narrator_zh": "绫水"
        },
        {
            "location": "416/TALK",
            "narrator": "アーヤ",
            "text": "これから先は、落ち着ける\n時間なんてほとんど\nなくなるはず。",
            "zh": "接下来，我们恐怕\n几乎不会再有能\n安稳喘口气的时间了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "417/TALK",
            "narrator": "アーヤ",
            "text": "それがわかってるから、\n今のうちにできることを\nしてるのよ。",
            "zh": "正因为明白这一点，\n才要趁现在去做\n力所能及的事。",
            "narrator_zh": "绫水"
        },
        {
            "location": "418/TALK",
            "narrator": "ガブリエラ",
            "text": "そんなの、全部終わらせた\n後だっていいじゃない。",
            "zh": "那种事，等全部结束了\n之后再做不就好了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "419/TALK",
            "narrator": "ガブリエラ",
            "text": "今気を緩めて、そのせいで\n戦いに負けたりしたら\nどうするつもりよ？",
            "zh": "要是现在松懈下来，结果\n在战斗里输了的话，\n你们打算怎么办啊？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "420/TALK",
            "narrator": "アーヤ",
            "text": "緩めてなんかいないわ。\n誰一人としてね。",
            "zh": "没有谁在松懈。\n没有一个人是那样的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "421/TALK",
            "narrator": "アーヤ",
            "text": "でも、気を張り過ぎて\n危なっかしいメンバーが、\n一人いるけど…。",
            "zh": "不过，倒是有一个人\n因为绷得太紧，\n让人捏一把汗呢……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "422/TALK",
            "narrator": "ガブリエラ",
            "text": "…なによ？\nそれ、あたしのこと？",
            "zh": "……什么意思？\n你这是在说我吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "423/TALK",
            "narrator": "アーヤ",
            "text": "他にいないでしょ。",
            "zh": "除了你还有谁。",
            "narrator_zh": "绫水"
        },
        {
            "location": "424/TALK",
            "narrator": "アーヤ",
            "text": "いい、ギャヴィ？\n大切なことだから\nよく聞いてちょうだい。",
            "zh": "听好了，加维？\n这是很重要的事，\n给我好好听着。",
            "narrator_zh": "绫水"
        },
        {
            "location": "425/TALK",
            "narrator": "アーヤ",
            "text": "気を引き締めてるだけなら、\n私だって何も言わないわ。",
            "zh": "如果只是绷紧神经，\n我什么也不会说。",
            "narrator_zh": "绫水"
        },
        {
            "location": "426/TALK",
            "narrator": "アーヤ",
            "text": "けど、ずっとピリピリした\n状態でいられたら、\n心配で放っておけない。",
            "zh": "可你要是一直处在\n一触即发的状态里，\n我实在放心不下。",
            "narrator_zh": "绫水"
        },
        {
            "location": "427/TALK",
            "narrator": "アーヤ",
            "text": "だからこうして――",
            "zh": "所以才像这样——",
            "narrator_zh": "绫水"
        },
        {
            "location": "428/TALK",
            "narrator": "ガブリエラ",
            "text": "いい加減にして！",
            "zh": "够了，适可而止吧！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "429/TALK",
            "narrator": "ガブリエラ",
            "text": "こっちはあんた達と違って、\nいつ戦闘になってもいい\n状態を保ってるの。",
            "zh": "我可跟你们不一样，\n一直都保持着随时\n能投入战斗的状态。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "431/TALK",
            "narrator": "ガブリエラ",
            "text": "なのに、そんなふうに\n意味の分からない文句ばっか\n言わないで！",
            "zh": "少在那里说些\n莫名其妙的\n牢骚了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "432/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "433/SEL",
            "narrator": "",
            "text": "ビシッと言い聞かせるんだ！",
            "zh": "狠下心好好跟她讲清楚！",
            "narrator_zh": ""
        },
        {
            "location": "434/SEL",
            "narrator": "",
            "text": "大丈夫、心配ないよ",
            "zh": "没关系，不用担心的",
            "narrator_zh": ""
        },
        {
            "location": "435/ACT",
            "narrator": "",
            "text": "ビシッと言い聞かせるんだ！",
            "zh": "狠下心好好跟她讲清楚！",
            "narrator_zh": ""
        },
        {
            "location": "452/TALK",
            "narrator": "アーヤ",
            "text": "そうするわ(｀ヘ´)",
            "zh": "我会这么做的(｀ヘ´)",
            "narrator_zh": "绫水"
        },
        {
            "location": "453/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィのことだから",
            "zh": "毕竟是加维",
            "narrator_zh": "绫水"
        },
        {
            "location": "454/TALK",
            "narrator": "アーヤ",
            "text": "心配ないと思ったけど",
            "zh": "原本还以为不用担心的",
            "narrator_zh": "绫水"
        },
        {
            "location": "455/TALK",
            "narrator": "アーヤ",
            "text": "そうでもないみたいだし(-ω-;)",
            "zh": "看来并非如此(-ω-;)",
            "narrator_zh": "绫水"
        },
        {
            "location": "458/TALK",
            "narrator": "アーヤ",
            "text": "ちょっと",
            "zh": "稍微",
            "narrator_zh": "绫水"
        },
        {
            "location": "459/TALK",
            "narrator": "アーヤ",
            "text": "残念かも(; ;)",
            "zh": "有点遗憾呢(; ;)",
            "narrator_zh": "绫水"
        },
        {
            "location": "471/TALK",
            "narrator": "アーヤ",
            "text": "あのね…意味わからないで\n終わらせたらダメでしょ？",
            "zh": "我说……不能用一句\n“莫名其妙”就敷衍过去吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "472/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィだけじゃなくて、\n仲間達みんなの命にだって\n関係あるんだから。",
            "zh": "这不只是加维的事，\n也关系到所有同伴的\n性命啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "473/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "474/TALK",
            "narrator": "アーヤ",
            "text": "そもそも、気を張るのが\n悪いと言ってるわけじゃ\nないのよ。",
            "zh": "说到底，我也并不是\n说绷紧神经\n有什么不对。",
            "narrator_zh": "绫水"
        },
        {
            "location": "475/TALK",
            "narrator": "アーヤ",
            "text": "ただ、張り過ぎると\n注意力が散漫になって、\n簡単に足元を――",
            "zh": "只是绷得太过头的话，\n注意力就会分散，\n很容易被人抓住破绽——",
            "narrator_zh": "绫水"
        },
        {
            "location": "478/TALK",
            "narrator": "ガブリエラ",
            "text": "うるさいなぁ…。",
            "zh": "好烦啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "479/TALK",
            "narrator": "アーヤ",
            "text": "なっ…うるさいって\nなによ！？",
            "zh": "什……说我烦\n是什么意思啊！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "480/TALK",
            "narrator": "ガブリエラ",
            "text": "余計なお世話だ、って\n言ってんのよ。",
            "zh": "就是说你多管闲事\n啦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "481/TALK",
            "narrator": "ガブリエラ",
            "text": "そんなのわね、\nアーヤに言われたくても\nわかってるわ。",
            "zh": "这种事就算\n不用绫水你说，\n我也明白。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "482/TALK",
            "narrator": "アーヤ",
            "text": "いや、わかってるなら\nどうしてそんなに――",
            "zh": "不对，既然明白，\n那你为什么还要那么——",
            "narrator_zh": "绫水"
        },
        {
            "location": "484/TALK",
            "narrator": "ガブリエラ",
            "text": "ピリピリする原因を\n作ってるのは、\nアーヤでしょ？",
            "zh": "害我这么焦躁的\n罪魁祸首，\n不就是绫水你吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "485/TALK",
            "narrator": "ガブリエラ",
            "text": "ただでさえ落ち着かない\n状況なのに、お説教まで\n追加されたら堪んないわ。",
            "zh": "眼下局势本来就够让人\n静不下心了，还要再\n听你说教，谁受得了啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "486/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "488/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしのことは、\nもう放っておいて。",
            "zh": "我的事，\n不用你管了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "489/TALK",
            "narrator": "ガブリエラ",
            "text": "…これ以上、あたしを\nイライラさせないでよ…。",
            "zh": "……别再让我\n更烦躁了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "494/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "495/TALK",
            "narrator": "アーヤ",
            "text": "私…余計なこと\nしたのかしら…。",
            "zh": "我……是不是做了\n多余的事……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "496/ACT",
            "narrator": "",
            "text": "大丈夫、心配ないよ",
            "zh": "没关系，不用担心的",
            "narrator_zh": ""
        },
        {
            "location": "514/TALK",
            "narrator": "アーヤ",
            "text": "心配よ(>_<)",
            "zh": "怎么会不担心(>_<)",
            "narrator_zh": "绫水"
        },
        {
            "location": "515/TALK",
            "narrator": "アーヤ",
            "text": "本当にこのままで",
            "zh": "放着不管的话",
            "narrator_zh": "绫水"
        },
        {
            "location": "516/TALK",
            "narrator": "アーヤ",
            "text": "心配ないと思う？",
            "zh": "真的不会出问题吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "518/SEL",
            "narrator": "",
            "text": "ガブリエラは愚かじゃない",
            "zh": "加布里埃拉可不是傻瓜",
            "narrator_zh": ""
        },
        {
            "location": "519/ACT",
            "narrator": "",
            "text": "ガブリエラは愚かじゃない",
            "zh": "加布里埃拉可不是傻瓜",
            "narrator_zh": ""
        },
        {
            "location": "522/TALK",
            "narrator": "アーヤ",
            "text": "そうね(-.-;)",
            "zh": "是啊(-.-;)",
            "narrator_zh": "绫水"
        },
        {
            "location": "523/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィは",
            "zh": "加维她",
            "narrator_zh": "绫水"
        },
        {
            "location": "524/TALK",
            "narrator": "アーヤ",
            "text": "私が一番信頼する仲間だし",
            "zh": "是我最信赖的同伴",
            "narrator_zh": "绫水"
        },
        {
            "location": "525/TALK",
            "narrator": "アーヤ",
            "text": "わからないはずないわね(｡-_-｡)",
            "zh": "怎么可能不明白呢(｡-_-｡)",
            "narrator_zh": "绫水"
        },
        {
            "location": "528/TALK",
            "narrator": "アーヤ",
            "text": "気づけなかったなんて",
            "zh": "连这点都没察觉到",
            "narrator_zh": "绫水"
        },
        {
            "location": "529/TALK",
            "narrator": "アーヤ",
            "text": "恥ずかしい(-ω-;)",
            "zh": "真是太丢脸了(-ω-;)",
            "narrator_zh": "绫水"
        },
        {
            "location": "543/TALK",
            "narrator": "アーヤ",
            "text": "はぁ…。",
            "zh": "唉……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "545/TALK",
            "narrator": "ガブリエラ",
            "text": "なによ、今度は？",
            "zh": "干嘛啦，这次又怎么了？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "546/TALK",
            "narrator": "アーヤ",
            "text": "ううん…なんか、\n余計なことしたかな、\nって…。",
            "zh": "没什么……我只是在想，\n自己是不是说了\n多余的话……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "547/TALK",
            "narrator": "ガブリエラ",
            "text": "…え？",
            "zh": "……哎？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "549/TALK",
            "narrator": "アーヤ",
            "text": "自分でわかってることを、\n他人に指摘されたら、\n気分悪いわよね？",
            "zh": "自己明明心里有数，\n还被别人指指点点，\n任谁都会不爽吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "551/TALK",
            "narrator": "アーヤ",
            "text": "…余計なこと言って\nごめんなさい。\nもう言わないわ。",
            "zh": "……说了多余的话，\n对不起。\n我不说了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "553/TALK",
            "narrator": "ガブリエラ",
            "text": "な、何よ…。\n急に態度変え過ぎよ？",
            "zh": "什、什么呀……。\n态度变得也太快了吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "555/TALK",
            "narrator": "アーヤ",
            "text": "反省したのよ…。\n本当、嫌な気持ちにさせて\nごめんなさい…。",
            "zh": "我反省过了……。\n实在抱歉，让你\n心里不痛快了……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "556/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "557/TALK",
            "narrator": "ガブリエラ",
            "text": "別に…謝ることないわよ。\nアーヤは間違ったこと、\n言ってないんだし…。",
            "zh": "你倒也……用不着道歉啦。\n绫水你又没有\n说错什么……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "558/TALK",
            "narrator": "アーヤ",
            "text": "…そうなの？",
            "zh": "……是吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "561/TALK",
            "narrator": "ガブリエラ",
            "text": "そうよ…わかった、\n認めるわ。",
            "zh": "是啊……好吧，\n我承认就是了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "563/TALK",
            "narrator": "ガブリエラ",
            "text": "今のあたしは、\nかなりピリピリしてるわ。",
            "zh": "现在的我，确实\n精神绷得太紧了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "565/TALK",
            "narrator": "ガブリエラ",
            "text": "今の状態じゃ、多分…、\n照準がブレて狙った場所に\n当てられないと思う。",
            "zh": "照现在这个状态，大概……\n准星也会晃得打不中\n瞄准的目标吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "566/TALK",
            "narrator": "アーヤ",
            "text": "…そう。",
            "zh": "……这样啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "567/TALK",
            "narrator": "ガブリエラ",
            "text": "…呆れた？",
            "zh": "……你无语了吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "568/TALK",
            "narrator": "アーヤ",
            "text": "まさか。話してくれて、\nほっとしたわ。",
            "zh": "怎么会。你能说出来，\n我反而松了口气。",
            "narrator_zh": "绫水"
        },
        {
            "location": "569/TALK",
            "narrator": "ガブリエラ",
            "text": "それはよかったわね。",
            "zh": "那还真是太好了呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "571/TALK",
            "narrator": "ガブリエラ",
            "text": "こっちも、正直に話して\n少し気持ちが軽くなった\n気がするわ。",
            "zh": "老实说出来之后，\n我也觉得心里好像\n稍微轻松了点。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "572/TALK",
            "narrator": "ガブリエラ",
            "text": "…でも、きっとすぐに\n元の状態に逆戻りだと\n思うけど。",
            "zh": "……不过，估计很快\n又会打回原形\n就是了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "573/TALK",
            "narrator": "アーヤ",
            "text": "…それだけ、卯月に対して\n怒ってるってことね。",
            "zh": "……这说明你对卯月\n有多生气呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "574/TALK",
            "narrator": "ガブリエラ",
            "text": "当然よ…。",
            "zh": "那当然了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "576/TALK",
            "narrator": "ガブリエラ",
            "text": "でも…そのせいでこれじゃ、\n何の意味もないわね…。\nかっこわるい…。",
            "zh": "可是……因为这样就搞成这副德行，\n不就毫无意义了吗……。\n真丢人……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "577/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "579/TALK",
            "narrator": "アーヤ",
            "text": "わかった…。\nギャヴィ、私にちょっと\n付き合って。",
            "zh": "我知道了……。\n加维，稍微陪我\n走一趟吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "581/TALK",
            "narrator": "ガブリエラ",
            "text": "えっ…どこによ？",
            "zh": "哎……去哪儿啊？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "582/TALK",
            "narrator": "アーヤ",
            "text": "ふふっ…。\n今のギャヴィに必要な物が\nあるところよ。",
            "zh": "呵呵……。\n去一个有现在的加维\n正需要的东西的地方。",
            "narrator_zh": "绫水"
        },
        {
            "location": "583/TALK",
            "narrator": "ガブリエラ",
            "text": "…？",
            "zh": "……？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "598/TALK",
            "narrator": "ウェイトレス",
            "text": "――それでは、\nごゆっくりどうぞ。",
            "zh": "——那么，\n请慢用。",
            "narrator_zh": "女服务员"
        },
        {
            "location": "602/TALK",
            "narrator": "アーヤ",
            "text": "さ、ギャヴィ。\n早く食べましょ。",
            "zh": "来吧，加维。\n趁早吃吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "603/TALK",
            "narrator": "ガブリエラ",
            "text": "え、えっと…。",
            "zh": "哎、那个……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "604/TALK",
            "narrator": "ガブリエラ",
            "text": "ごめん、アーヤ…。\nちょっとついてけないん\nだけど…。",
            "zh": "抱歉，绫水……。\n我有点没跟上你的\n思路……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "605/TALK",
            "narrator": "アーヤ",
            "text": "なにが？",
            "zh": "怎么了？",
            "narrator_zh": "绫水"
        },
        {
            "location": "606/TALK",
            "narrator": "ガブリエラ",
            "text": "一体このお店のどこに、\nあたしに必要な物が\nあるっていうのよ？",
            "zh": "这家店里到底哪儿\n有我现在正需要的\n东西啊？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "607/TALK",
            "narrator": "アーヤ",
            "text": "あるじゃない。\nほら、今目の前にあるのが\nそれよ。",
            "zh": "这不就有吗。\n喏，摆在你面前的\n就是啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "608/TALK",
            "narrator": "ガブリエラ",
            "text": "それって、パフェのこと？",
            "zh": "你说的难道是这杯芭菲？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "609/TALK",
            "narrator": "アーヤ",
            "text": "そうよ。",
            "zh": "没错。",
            "narrator_zh": "绫水"
        },
        {
            "location": "610/TALK",
            "narrator": "アーヤ",
            "text": "…ギャヴィ。\nあなたはね、とっても\n真面目な子なの。",
            "zh": "……加维。\n你呀，是个非常\n认真的孩子。",
            "narrator_zh": "绫水"
        },
        {
            "location": "611/TALK",
            "narrator": "アーヤ",
            "text": "だから今の私達の状況で、\n気を抜くのが悪いこと\nみたいに感じるんじゃない？",
            "zh": "所以处在我们现在这种境况下，\n你才会觉得稍微松口气\n就像做了坏事一样，对吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "613/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "614/TALK",
            "narrator": "アーヤ",
            "text": "気持ちはわかる。\n私も、ギャヴィと同じ\nだから…。",
            "zh": "你的心情我懂。\n因为我，也跟加维\n一样……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "615/TALK",
            "narrator": "アーヤ",
            "text": "でも、気だって休めないと、\nいざって時に引き締める\nこともできなくなるわ。",
            "zh": "可是，平时不让精神歇一歇，\n真到紧要关头的时候，\n反而会绷不紧的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "617/TALK",
            "narrator": "ガブリエラ",
            "text": "…だから？",
            "zh": "……所以呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "618/TALK",
            "narrator": "アーヤ",
            "text": "気分を変えろ、ってことよ。\nほら、私のブリュレも\n一口どう？",
            "zh": "所以就是要换换心情。\n来，我的焦糖布丁也\n尝一口怎么样？",
            "narrator_zh": "绫水"
        },
        {
            "location": "619/TALK",
            "narrator": "ガブリエラ",
            "text": "えっ、あ、いいから。\n自分で食べれるし！",
            "zh": "哎、啊，不用了。\n我自己会吃！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "620/TALK",
            "narrator": "アーヤ",
            "text": "いいから、あーん。",
            "zh": "别客气嘛，啊——。",
            "narrator_zh": "绫水"
        },
        {
            "location": "621/TALK",
            "narrator": "ガブリエラ",
            "text": "う…。",
            "zh": "唔……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "622/TALK",
            "narrator": "ガブリエラ",
            "text": "あ、あーん…。",
            "zh": "啊、啊嗯……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "623/TALK",
            "narrator": "アーヤ",
            "text": "…どう、美味しい？",
            "zh": "……怎么样，好吃吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "625/TALK",
            "narrator": "ガブリエラ",
            "text": "…ふふっ、ちょっと\nほろ苦くて、大人な味ね。",
            "zh": "……呵呵，有点\n微苦，是大人风味呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "626/TALK",
            "narrator": "アーヤ",
            "text": "甘いと思ったんだけど…、\n違うの注文すれば\nよかったかしら？",
            "zh": "我还以为会很甜呢……\n早知道点个别的\n就好了？",
            "narrator_zh": "绫水"
        },
        {
            "location": "627/TALK",
            "narrator": "ガブリエラ",
            "text": "じゃあ、お返しに\nあたしのパフェも\n一口あげるわ。",
            "zh": "那作为回礼，\n我的芭菲也\n分你一口好了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "628/TALK",
            "narrator": "アーヤ",
            "text": "いいの？\nそれじゃあ遠慮なく…。",
            "zh": "可以吗？\n那我就不客气了……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "629/TALK",
            "narrator": "ガブリエラ",
            "text": "うん…。",
            "zh": "嗯……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "630/TALK",
            "narrator": "ガブリエラ",
            "text": "…？\nいや、なにやってるの？",
            "zh": "……？\n不是，你在干嘛啊？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "631/TALK",
            "narrator": "アーヤ",
            "text": "なにって、食べさせて\nくれるの待ってるんだけど？",
            "zh": "干嘛，我在等你\n喂我吃呀？",
            "narrator_zh": "绫水"
        },
        {
            "location": "632/TALK",
            "narrator": "ガブリエラ",
            "text": "いや、しないから！\n自分で食べなさいよ！",
            "zh": "才、才不喂呢！\n你自己吃啦！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "633/TALK",
            "narrator": "アーヤ",
            "text": "なんでよ？\n私は食べさせてあげたのに。",
            "zh": "为什么呀？\n刚才我明明喂你了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "635/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤが勝手にやった\nだけでしょ？",
            "zh": "那是绫水你自己\n擅自喂的好吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "636/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしはやらないわよ。\nそんなの、恥ずかしいし…。",
            "zh": "我才不干呢。\n那种事，太害羞了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "637/TALK",
            "narrator": "アーヤ",
            "text": "残念…じゃ、失礼して…。",
            "zh": "真遗憾……那，我就不客气了……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "638/TALK",
            "narrator": "アーヤ",
            "text": "んっ、甘くて美味しい。",
            "zh": "唔，又甜又好吃。",
            "narrator_zh": "绫水"
        },
        {
            "location": "640/TALK",
            "narrator": "ガブリエラ",
            "text": "ふふっ…あたしより、\nアーヤの方が楽しんでる\nじゃない…。",
            "zh": "呵呵……怎么感觉\n绫水你比我还\n乐在其中啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "642/TALK",
            "narrator": "アーヤ",
            "text": "まあね…やっぱり、\nギャヴィと一緒だと\n楽しいし。",
            "zh": "还行吧……毕竟，\n跟加维在一起\n就很开心嘛。",
            "narrator_zh": "绫水"
        },
        {
            "location": "643/TALK",
            "narrator": "ガブリエラ",
            "text": "は、はいはい。\nお世辞はいいから\nさっさと食べるわよ。",
            "zh": "好、好好好。\n奉承话就免了，\n赶紧吃吧。",
            "narrator_zh": "加布里埃拉"
        },
