    "entry": [
        {
            "location": "1491/SCENARIO",
            "narrator": "",
            "text": "アキバ検定",
            "zh": "秋叶原认证",
            "narrator_zh": ""
        },
        {
            "location": "1505/TALK",
            "narrator": "神楽",
            "text": "…あ、こっちの方が\n近道ですから。",
            "zh": "……啊，走这边\n更近一点。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1507/TALK",
            "narrator": "つばめ",
            "text": "うん。\nふふっ。",
            "zh": "嗯。\n呵呵。",
            "narrator_zh": "燕"
        },
        {
            "location": "1508/TALK",
            "narrator": "神楽",
            "text": "どうかしましたか？",
            "zh": "怎么了？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1509/TALK",
            "narrator": "つばめ",
            "text": "ううん。\n卯月さんは本当に\nアキバに詳しいなって。",
            "zh": "没有啦。\n只是觉得卯月对秋叶原\n真的很熟呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "1510/SEL",
            "narrator": "",
            "text": "さすがはアキバの女王",
            "zh": "不愧是秋叶原的女王",
            "narrator_zh": ""
        },
        {
            "location": "1511/ACT",
            "narrator": "",
            "text": "さすがはアキバの女王",
            "zh": "不愧是秋叶原的女王",
            "narrator_zh": ""
        },
        {
            "location": "1528/TALK",
            "narrator": "神楽",
            "text": "その称号は",
            "zh": "那个头衔",
            "narrator_zh": "神乐"
        },
        {
            "location": "1529/TALK",
            "narrator": "神楽",
            "text": "ﾋﾞﾐｮｳ、、、",
            "zh": "好微妙、、、",
            "narrator_zh": "神乐"
        },
        {
            "location": "1532/SEL",
            "narrator": "",
            "text": "いやｶｺｲｲ！",
            "zh": "不，太帅了！",
            "narrator_zh": ""
        },
        {
            "location": "1533/SEL",
            "narrator": "",
            "text": "やっぱりそうかな～",
            "zh": "果然是这样吗～",
            "narrator_zh": ""
        },
        {
            "location": "1534/SEL",
            "narrator": "",
            "text": "つばめの気持ちを代弁しただけなのに",
            "zh": "我只是替燕说了她的心里话",
            "narrator_zh": ""
        },
        {
            "location": "1535/ACT",
            "narrator": "",
            "text": "いやｶｺｲｲ！",
            "zh": "不，太帅了！",
            "narrator_zh": ""
        },
        {
            "location": "1537/TALK",
            "narrator": "神楽",
            "text": "って騙されませんよ～♪",
            "zh": "才不会上当呢～♪",
            "narrator_zh": "神乐"
        },
        {
            "location": "1538/ACT",
            "narrator": "",
            "text": "やっぱりそうかな～",
            "zh": "果然是这样吗～",
            "narrator_zh": ""
        },
        {
            "location": "1539/TALK",
            "narrator": "神楽",
            "text": "わかってて言ってる？？？",
            "zh": "你是明知故问？？？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1540/ACT",
            "narrator": "",
            "text": "つばめの気持ちを代弁しただけなのに",
            "zh": "我只是替燕说了她的心里话",
            "narrator_zh": ""
        },
        {
            "location": "1541/TALK",
            "narrator": "神楽",
            "text": "いやそれは、、、",
            "zh": "不，那个……",
            "narrator_zh": "神乐"
        },
        {
            "location": "1543/TALK",
            "narrator": "神楽",
            "text": "本当にそうかもです、、、",
            "zh": "说不定真是那样呢……",
            "narrator_zh": "神乐"
        },
        {
            "location": "1545/TALK",
            "narrator": "神楽",
            "text": "その名前は謹んで遠慮しますねっ♪",
            "zh": "那个名字我就敬谢不敏了♪",
            "narrator_zh": "神乐"
        },
        {
            "location": "1547/SEL",
            "narrator": "",
            "text": "残念だ",
            "zh": "真遗憾",
            "narrator_zh": ""
        },
        {
            "location": "1548/SEL",
            "narrator": "",
            "text": "つばめとのデート楽しんで",
            "zh": "好好享受和燕的约会",
            "narrator_zh": ""
        },
        {
            "location": "1549/SEL",
            "narrator": "",
            "text": "今度$me$ともデートしてね",
            "zh": "下次也跟$me$约会哦",
            "narrator_zh": ""
        },
        {
            "location": "1550/ACT",
            "narrator": "",
            "text": "残念だ",
            "zh": "真遗憾",
            "narrator_zh": ""
        },
        {
            "location": "1551/TALK",
            "narrator": "神楽",
            "text": "$handle$さんがそう名乗っていいですよ♪",
            "zh": "$handle$用这个名字也可以哦♪",
            "narrator_zh": "神乐"
        },
        {
            "location": "1552/ACT",
            "narrator": "",
            "text": "つばめとのデート楽しんで",
            "zh": "好好享受和燕的约会",
            "narrator_zh": ""
        },
        {
            "location": "1553/TALK",
            "narrator": "神楽",
            "text": "そうですね～～～",
            "zh": "是啊～～～",
            "narrator_zh": "神乐"
        },
        {
            "location": "1554/TALK",
            "narrator": "神楽",
            "text": "楽しみますねｸﾞﾌﾌ、、、",
            "zh": "那我就好好享受啦嘿嘿……",
            "narrator_zh": "神乐"
        },
        {
            "location": "1555/ACT",
            "narrator": "",
            "text": "今度$me$ともデートしてね",
            "zh": "下次也跟$me$约会哦",
            "narrator_zh": ""
        },
        {
            "location": "1557/TALK",
            "narrator": "神楽",
            "text": "絶対ですよ？",
            "zh": "说定了哦？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1558/TALK",
            "narrator": "神楽",
            "text": "ぴょんこすっごく期待してますから♪",
            "zh": "蹦子可超级期待着哦♪",
            "narrator_zh": "神乐"
        },
        {
            "location": "1571/TALK",
            "narrator": "つばめ",
            "text": "こういうのも\n一種の秘密みたいな\nものだよね。",
            "zh": "这种事也\n算是种秘密\n一样的东西吧。",
            "narrator_zh": "燕"
        },
        {
            "location": "1573/TALK",
            "narrator": "神楽",
            "text": "…こういうのって？",
            "zh": "……这种事是指？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1574/TALK",
            "narrator": "つばめ",
            "text": "卯月さんがここまで\nアキバに詳しいのを\n知ってること。",
            "zh": "知道卯月对秋叶原\n居然这么熟的\n这件事。",
            "narrator_zh": "燕"
        },
        {
            "location": "1575/TALK",
            "narrator": "つばめ",
            "text": "たぶんわたしだけ\nだよね？",
            "zh": "大概只有我\n这样吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "1576/TALK",
            "narrator": "神楽",
            "text": "…ああ。\nそういうことですか。",
            "zh": "……啊啊。\n原来是这个意思啊。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1577/TALK",
            "narrator": "神楽",
            "text": "確かにそうかも\nしれませんね。",
            "zh": "确实可能\n是这样呢。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1578/TALK",
            "narrator": "神楽",
            "text": "別にオタク趣味を\n隠してるつもりは\nないですけど。",
            "zh": "虽然我倒也不是故意\n隐瞒自己的\n宅系爱好。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1579/TALK",
            "narrator": "神楽",
            "text": "一緒にアキバまでって\nなるとなかなか\n行く機会もないですし。",
            "zh": "毕竟也没什么机会\n专门和大家\n一起来秋叶原呀。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1580/TALK",
            "narrator": "つばめ",
            "text": "だよね？\nなんだかうれしいな。\nそういうの。",
            "zh": "是吧？\n总觉得很高兴。\n那种事。",
            "narrator_zh": "燕"
        },
        {
            "location": "1581/SEL",
            "narrator": "",
            "text": "$me$はちょっと嫉妬",
            "zh": "$me$有点吃醋",
            "narrator_zh": ""
        },
        {
            "location": "1582/ACT",
            "narrator": "",
            "text": "$me$はちょっと嫉妬",
            "zh": "$me$有点吃醋",
            "narrator_zh": ""
        },
        {
            "location": "1599/TALK",
            "narrator": "神楽",
            "text": "あらあらあらあら？",
            "zh": "哎呀哎呀哎呀哎呀？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1600/TALK",
            "narrator": "神楽",
            "text": "ちょっとだけ、ですか？",
            "zh": "就一点点，吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1602/SEL",
            "narrator": "",
            "text": "本当は超絶的に嫉妬してる",
            "zh": "其实嫉妒得不得了",
            "narrator_zh": ""
        },
        {
            "location": "1603/SEL",
            "narrator": "",
            "text": "$me$は大人だからね（フッ…",
            "zh": "因为$me$是大人嘛（呵…",
            "narrator_zh": ""
        },
        {
            "location": "1604/SEL",
            "narrator": "",
            "text": "別に全然してないし！",
            "zh": "我完全没在做呢！",
            "narrator_zh": ""
        },
        {
            "location": "1605/ACT",
            "narrator": "",
            "text": "本当は超絶的に嫉妬してる",
            "zh": "其实嫉妒得不得了",
            "narrator_zh": ""
        },
        {
            "location": "1607/TALK",
            "narrator": "神楽",
            "text": "なんて、信じてあげますね♪",
            "zh": "就当是真的，我信你哦♪",
            "narrator_zh": "神乐"
        },
        {
            "location": "1609/ACT",
            "narrator": "",
            "text": "$me$は大人だからね（フッ…",
            "zh": "因为$me$是大人嘛（呵…",
            "narrator_zh": ""
        },
        {
            "location": "1610/TALK",
            "narrator": "神楽",
            "text": "ｷｬｰｶｺｲｲーー",
            "zh": "呀啊好帅——",
            "narrator_zh": "神乐"
        },
        {
            "location": "1611/TALK",
            "narrator": "神楽",
            "text": "$handle$さんｽﾃｷ♪",
            "zh": "$handle$真棒♪",
            "narrator_zh": "神乐"
        },
        {
            "location": "1613/ACT",
            "narrator": "",
            "text": "別に全然してないし！",
            "zh": "我完全没在做呢！",
            "narrator_zh": ""
        },
        {
            "location": "1615/TALK",
            "narrator": "神楽",
            "text": "ずいぶんなツンデレさんですね♪",
            "zh": "还真是个大傲娇呢♪",
            "narrator_zh": "神乐"
        },
        {
            "location": "1629/TALK",
            "narrator": "神楽",
            "text": "…私もうれしいですよ。",
            "zh": "……我也很高兴哦。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1631/TALK",
            "narrator": "神楽",
            "text": "こうやってつばめさんと\nアキバデート\nできるのは。",
            "zh": "能像这样跟燕\n在秋叶原\n约会，",
            "narrator_zh": "神乐"
        },
        {
            "location": "1632/TALK",
            "narrator": "つばめ",
            "text": "デート！？",
            "zh": "约会！？",
            "narrator_zh": "燕"
        },
        {
            "location": "1633/TALK",
            "narrator": "神楽",
            "text": "…嫌ですか？\n私とデート\nするのは。",
            "zh": "……你讨厌吗？\n跟我\n约会。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1634/TALK",
            "narrator": "つばめ",
            "text": "え、えっと…。\n嫌っていうか…。",
            "zh": "诶、那个……。\n倒也不是讨厌……。",
            "narrator_zh": "燕"
        },
        {
            "location": "1635/TALK",
            "narrator": "神楽",
            "text": "ふふっ。\nつばめさんったら。",
            "zh": "呵呵。\n燕你真是的。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1636/TALK",
            "narrator": "神楽",
            "text": "冗談をすぐ本気に\nしちゃうんだから。",
            "zh": "开句玩笑而已，\n你立马就当真了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1637/TALK",
            "narrator": "つばめ",
            "text": "えっ！？　また\nからかわれたの！？",
            "zh": "诶！？　你又在\n捉弄我吧！？",
            "narrator_zh": "燕"
        },
        {
            "location": "1639/TALK",
            "narrator": "神楽",
            "text": "他に何があると\n思います？",
            "zh": "那你觉得还能\n是什么呀？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1640/TALK",
            "narrator": "つばめ",
            "text": "もー！！！！",
            "zh": "真是的！！！！",
            "narrator_zh": "燕"
        },
        {
            "location": "1641/TALK",
            "narrator": "神楽",
            "text": "あはははは…。",
            "zh": "啊哈哈哈哈……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1656/TALK",
            "narrator": "ボイスメール",
            "text": "ひみつのおんなのこ",
            "zh": "秘密的女孩子",
            "narrator_zh": "语音信箱"
        },
        {
