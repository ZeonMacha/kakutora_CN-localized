{
 "dir": "dramatics/daydra/drm_ch04_00_390.js",
 "type": "Episode",
 "info": {
  "story_id": "4039",
  "cid": "miyabi",
  "title": "らぶとーく 第40話",
  "sub_title": "ゴーゴーヘブンとはこれ如何に"
 },
 "entry": [
  {
   "location": "1579/SCENARIO",
   "narrator": "",
   "text": "ゴーゴーヘブンとはこれ如何に"
  },
  {
   "location": "1594/TALK",
   "narrator": "アーヤ",
   "text": "やっぱり、今日は夜まで\nこの調子みたいね。"
  },
  {
   "location": "1595/TALK",
   "narrator": "つばめ",
   "text": "はぁ…怖いなぁ。\n寝るまでには鳴り止んで\nくれればいいけど…。",
   "zh": "唉……好可怕啊。\n要是在睡前能\n停下来就好了……。",
   "narrator_zh": "燕"
  },
  {
   "location": "1597/TALK",
   "narrator": "ガブリエラ",
   "text": "そこまで鳴ってれば、\nいい加減慣れるでしょ？",
   "zh": "响到那个程度，\n也该习惯了吧？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "1599/TALK",
   "narrator": "つばめ",
   "text": "慣れないよぉ…。\n雷、凄く怖いし。"
  },
  {
   "location": "1601/TALK",
   "narrator": "つばめ",
   "text": "っていうか、ガブちゃんも\nさっき怖がってたし。",
   "zh": "话说，加布刚才\n也害怕了吧。",
   "narrator_zh": "燕"
  },
  {
   "location": "1603/TALK",
   "narrator": "ガブリエラ",
   "text": "あ、あれは違うわ！"
  },
  {
   "location": "1604/TALK",
   "narrator": "ガブリエラ",
   "text": "急に大きな音がしたから、\nちょっと驚いただけよ。"
  },
  {
   "location": "1606/TALK",
   "narrator": "アーヤ",
   "text": "…あっ、降ってきたわ。"
  },
  {
   "location": "1608/TALK",
   "narrator": "アーヤ",
   "text": "うわっ！？\n一気に大雨…凄いわね。"
  },
  {
   "location": "1610/TALK",
   "narrator": "つばめ",
   "text": "外にいる人達、\n大変ですね…。"
  },
  {
   "location": "1611/TALK",
   "narrator": "アーヤ",
   "text": "そうね。",
   "zh": "是啊。",
   "narrator_zh": "绫水"
  },
  {
   "location": "1612/TALK",
   "narrator": "アーヤ",
   "text": "私も、今日はバイクで\n出掛けるつもりだった\nのに…。"
  },
  {
   "location": "1613/TALK",
   "narrator": "みやび",
   "text": "…みんな、雷に対して\n不満ありのようやね。",
   "zh": "……看来大家对打雷\n都挺有意见嘛。",
   "narrator_zh": "雅"
  },
  {
   "location": "1616/TALK",
   "narrator": "ガブリエラ",
   "text": "当然じゃない。\nこれじゃ外にも出られ\nないし…。"
  },
  {
   "location": "1617/TALK",
   "narrator": "みやび",
   "text": "屋内で過ごせばえいやん。\n別に用事があるわけでも\nないやろうに。"
  },
  {
   "location": "1619/TALK",
   "narrator": "ガブリエラ",
   "text": "それはそうだけど…。",
   "zh": "话是这么说……。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "1621/TALK",
   "narrator": "つばめ",
   "text": "でも、屋内にいると\n憂鬱な気分になります。",
   "zh": "不过，待在室内\n心情会变得忧郁。",
   "narrator_zh": "燕"
  },
  {
   "location": "1622/TALK",
   "narrator": "つばめ",
   "text": "こんなに降ってたら、\nお外には出れないなぁ――",
   "zh": "下这么大的雨，\n就出不了门了呀——",
   "narrator_zh": "燕"
  },
  {
   "location": "1623/TALK",
   "narrator": "つばめ",
   "text": "って思ってると、気持ちが\nどんどん暗くなるんです。",
   "zh": "这么一想，心情就\n越来越暗了。",
   "narrator_zh": "燕"
  },
  {
   "location": "1625/TALK",
   "narrator": "みやび",
   "text": "そういうもん？",
   "zh": "是这么回事啵？",
   "narrator_zh": "雅"
  },
  {
   "location": "1627/TALK",
   "narrator": "アーヤ",
   "text": "まあ、インドア派の\nみやびにはわからない\nことかもしれないわね。"
  },
  {
   "location": "1629/TALK",
   "narrator": "みやび",
   "text": "ふむ…暗い気持ちなぁ…。"
  },
  {
   "location": "1641/TALK",
   "narrator": "みやび",
   "text": "うちの命を捧げるき"
  },
  {
   "location": "1642/TALK",
   "narrator": "みやび",
   "text": "一生の頼みを聞いてもらいたい"
  },
  {
   "location": "1644/SEL",
   "narrator": "",
   "text": "深刻だね、どうしたの？",
   "zh": "听起来挺严重的，怎么了？",
   "narrator_zh": ""
  },
  {
   "location": "1645/ACT",
   "narrator": "",
   "text": "深刻だね、どうしたの？",
   "zh": "听起来挺严重的，怎么了？",
   "narrator_zh": ""
  },
  {
   "location": "1647/TALK",
   "narrator": "みやび",
   "text": "聞いてくれるか？"
  },
  {
   "location": "1649/TALK",
   "narrator": "みやび",
   "text": "実はな"
  },
  {
   "location": "1650/TALK",
   "narrator": "みやび",
   "text": "雷を止めてほしいが"
  },
  {
   "location": "1652/SEL",
   "narrator": "",
   "text": "いや無理",
   "zh": "不行",
   "narrator_zh": ""
  },
  {
   "location": "1653/SEL",
   "narrator": "",
   "text": "そのうち晴れる"
  },
  {
   "location": "1654/SEL",
   "narrator": "",
   "text": "じゃあみやびがこっち来て",
   "zh": "那雅你过来一下",
   "narrator_zh": ""
  },
  {
   "location": "1655/ACT",
   "narrator": "",
   "text": "いや無理",
   "zh": "不行",
   "narrator_zh": ""
  },
  {
   "location": "1656/TALK",
   "narrator": "みやび",
   "text": "人が命かけた頼みをそう簡単に"
  },
  {
   "location": "1657/TALK",
   "narrator": "みやび",
   "text": "相棒は鬼や"
  },
  {
   "location": "1658/TALK",
   "narrator": "みやび",
   "text": "まあ",
   "zh": "嗯",
   "narrator_zh": "雅"
  },
  {
   "location": "1659/TALK",
   "narrator": "みやび",
   "text": "うちは心が広い"
  },
  {
   "location": "1660/TALK",
   "narrator": "みやび",
   "text": "代わりに"
  },
  {
   "location": "1661/TALK",
   "narrator": "みやび",
   "text": "雷に打たれる方法を教えてプリーズ"
  },
  {
   "location": "1663/SEL",
   "narrator": "",
   "text": "どっちも無理",
   "zh": "两个都不行",
   "narrator_zh": ""
  },
  {
   "location": "1664/ACT",
   "narrator": "",
   "text": "どっちも無理",
   "zh": "两个都不行",
   "narrator_zh": ""
  },
  {
   "location": "1666/TALK",
   "narrator": "みやび",
   "text": "残念"
  },
  {
   "location": "1668/TALK",
   "narrator": "みやび",
   "text": "うちのおヘソは取られてしまいました"
  },
  {
   "location": "1669/TALK",
   "narrator": "みやび",
   "text": "まあ",
   "zh": "嗯",
   "narrator_zh": "雅"
  },
  {
   "location": "1670/TALK",
   "narrator": "みやび",
   "text": "恋の雷的なものには"
  },
  {
   "location": "1671/TALK",
   "narrator": "みやび",
   "text": "常に打たれてるけんどな"
  },
  {
   "location": "1672/TALK",
   "narrator": "みやび",
   "text": "雷様もビックリ"
  },
  {
   "location": "1673/TALK",
   "narrator": "みやび",
   "text": "あ",
   "zh": "啊",
   "narrator_zh": "雅"
  },
  {
   "location": "1674/TALK",
   "narrator": "みやび",
   "text": "これヤバィ",
   "zh": "这可不妙",
   "narrator_zh": "雅"
  },
  {
   "location": "1675/TALK",
   "narrator": "みやび",
   "text": "聞くのは平気だが"
  },
  {
   "location": "1676/TALK",
   "narrator": "みやび",
   "text": "言うとメッチャ恥ずかしい"
  },
  {
   "location": "1678/SEL",
   "narrator": "",
   "text": "聞いてるのも恥ずかしいんだけど",
   "zh": "听着都怪不好意思的",
   "narrator_zh": ""
  },
  {
   "location": "1679/ACT",
   "narrator": "",
   "text": "聞いてるのも恥ずかしいんだけど",
   "zh": "听着都怪不好意思的",
   "narrator_zh": ""
  },
  {
   "location": "1681/TALK",
   "narrator": "みやび",
   "text": "かーわーいーいー",
   "zh": "好——可——爱——啊——",
   "narrator_zh": "雅"
  },
  {
   "location": "1682/TALK",
   "narrator": "みやび",
   "text": "照れ隠しかーわーいーいー"
  },
  {
   "location": "1683/TALK",
   "narrator": "みやび",
   "text": "うちも恥ずかしい"
  },
  {
   "location": "1685/TALK",
   "narrator": "みやび",
   "text": "退散"
  },
  {
   "location": "1697/ACT",
   "narrator": "",
   "text": "そのうち晴れる"
  },
  {
   "location": "1698/TALK",
   "narrator": "みやび",
   "text": "そうかもしれん",
   "zh": "说不准就是这样",
   "narrator_zh": "雅"
  },
  {
   "location": "1699/TALK",
   "narrator": "みやび",
   "text": "だがしかし",
   "zh": "然而",
   "narrator_zh": "雅"
  },
  {
   "location": "1700/TALK",
   "narrator": "みやび",
   "text": "雷でうちのＰＣがイカレたらヤバい"
  },
  {
   "location": "1701/TALK",
   "narrator": "みやび",
   "text": "泣ける"
  },
  {
   "location": "1702/TALK",
   "narrator": "みやび",
   "text": "想像しただけで"
  },
  {
   "location": "1704/TALK",
   "narrator": "みやび",
   "text": "それでもえいが？",
   "zh": "那样也行嘛？",
   "narrator_zh": "雅"
  },
  {
   "location": "1706/SEL",
   "narrator": "",
   "text": "対策してるでしょ？",
   "zh": "你有在做防护吧？",
   "narrator_zh": ""
  },
  {
   "location": "1707/ACT",
   "narrator": "",
   "text": "対策してるでしょ？",
   "zh": "你有在做防护吧？",
   "narrator_zh": ""
  },
  {
   "location": "1709/TALK",
   "narrator": "みやび",
   "text": "うわ",
   "zh": "哇",
   "narrator_zh": "雅"
  },
  {
   "location": "1711/TALK",
   "narrator": "みやび",
   "text": "バレてたか"
  },
  {
   "location": "1712/TALK",
   "narrator": "みやび",
   "text": "雷除けのお札貼ってる"
  },
  {
   "location": "1713/TALK",
   "narrator": "みやび",
   "text": "知ってたのか"
  },
  {
   "location": "1714/TALK",
   "narrator": "みやび",
   "text": "さすがは恋人",
   "zh": "不愧是恋人",
   "narrator_zh": "雅"
  },
  {
   "location": "1715/TALK",
   "narrator": "みやび",
   "text": "ダーリン",
   "zh": "亲爱的",
   "narrator_zh": "雅"
  },
  {
   "location": "1716/TALK",
   "narrator": "みやび",
   "text": "ハニーのことは物知りなのね"
  },
  {
   "location": "1718/SEL",
   "narrator": "",
   "text": "今後はダーリンハニーで行く？",
   "zh": "以后就用达令甜心来称呼？",
   "narrator_zh": ""
  },
  {
   "location": "1719/ACT",
   "narrator": "",
   "text": "今後はダーリンハニーで行く？",
   "zh": "以后就用达令甜心来称呼？",
   "narrator_zh": ""
  },
  {
   "location": "1721/TALK",
   "narrator": "みやび",
   "text": "キャラやない"
  },
  {
   "location": "1722/TALK",
   "narrator": "みやび",
   "text": "興味はある"
  },
  {
   "location": "1723/TALK",
   "narrator": "みやび",
   "text": "恥ずかしくもある"
  },
  {
   "location": "1724/TALK",
   "narrator": "みやび",
   "text": "さらば",
   "zh": "就此别过咯",
   "narrator_zh": "雅"
  },
  {
   "location": "1736/ACT",
   "narrator": "",
   "text": "じゃあみやびがこっち来て",
   "zh": "那雅你过来一下",
   "narrator_zh": ""
  },
  {
   "location": "1737/TALK",
   "narrator": "みやび",
   "text": "むっ？"
  },
  {
   "location": "1738/TALK",
   "narrator": "みやび",
   "text": "とんちか？",
   "zh": "是机智问答？",
   "narrator_zh": "雅"
  },
  {
   "location": "1739/TALK",
   "narrator": "みやび",
   "text": "さすがは相棒"
  },
  {
   "location": "1740/TALK",
   "narrator": "みやび",
   "text": "面白いことを言う"
  },
  {
   "location": "1741/TALK",
   "narrator": "みやび",
   "text": "うちの彼氏としては合格や"
  },
  {
   "location": "1744/SEL",
   "narrator": "",
   "text": "命は別の頼みの時に取っておきな",
   "zh": "命留着，别的请求的时候再取",
   "narrator_zh": ""
  },
  {
   "location": "1745/ACT",
   "narrator": "",
   "text": "命は別の頼みの時に取っておきな",
   "zh": "命留着，别的请求的时候再取",
   "narrator_zh": ""
  },
  {
   "location": "1747/TALK",
   "narrator": "みやび",
   "text": "ハードボイルド？"
  },
  {
   "location": "1748/TALK",
   "narrator": "みやび",
   "text": "人情味厚い男や"
  },
  {
   "location": "1749/TALK",
   "narrator": "みやび",
   "text": "よっ、男前"
  },
  {
   "location": "1750/TALK",
   "narrator": "みやび",
   "text": "顔知らんけんど",
   "zh": "我不认识他咯",
   "narrator_zh": "雅"
  },
  {
   "location": "1752/TALK",
   "narrator": "みやび",
   "text": "まあ",
   "zh": "嗯",
   "narrator_zh": "雅"
  },
  {
   "location": "1753/TALK",
   "narrator": "みやび",
   "text": "発言は男前"
  },
  {
   "location": "1754/TALK",
   "narrator": "みやび",
   "text": "それだけでも十分か",
   "zh": "光这样也够了吗",
   "narrator_zh": "雅"
  },
  {
   "location": "1756/SEL",
   "narrator": "",
   "text": "で、こっち来る？",
   "zh": "那，你过来吗？",
   "narrator_zh": ""
  },
  {
   "location": "1757/ACT",
   "narrator": "",
   "text": "で、こっち来る？",
   "zh": "那，你过来吗？",
   "narrator_zh": ""
  },
  {
   "location": "1759/TALK",
   "narrator": "みやび",
   "text": "雨の中行けと？"
  },
  {
   "location": "1760/TALK",
   "narrator": "みやび",
   "text": "まあ",
   "zh": "嗯",
   "narrator_zh": "雅"
  },
  {
   "location": "1761/TALK",
   "narrator": "みやび",
   "text": "もし行けたら"
  },
  {
   "location": "1762/TALK",
   "narrator": "みやび",
   "text": "その時は色々案内してもらうぞね",
   "zh": "那时候就让你带我到处看看咯",
   "narrator_zh": "雅"
  },
  {
   "location": "1764/TALK",
   "narrator": "みやび",
   "text": "これ",
   "zh": "这个",
   "narrator_zh": "雅"
  },
  {
   "location": "1765/TALK",
   "narrator": "みやび",
   "text": "デート"
  },
  {
   "location": "1767/SEL",
   "narrator": "",
   "text": "ドキッ！",
   "zh": "心动！",
   "narrator_zh": ""
  },
  {
   "location": "1768/ACT",
   "narrator": "",
   "text": "ドキッ！",
   "zh": "心动！",
   "narrator_zh": ""
  },
  {
   "location": "1770/TALK",
   "narrator": "みやび",
   "text": "相棒心肺停止"
  },
  {
   "location": "1771/TALK",
   "narrator": "みやび",
   "text": "チーン"
  },
  {
   "location": "1772/TALK",
   "narrator": "みやび",
   "text": "雷に打たれて生き返るとえいな"
  },
  {
   "location": "1773/TALK",
   "narrator": "みやび",
   "text": "ではさらば",
   "zh": "那么，再会",
   "narrator_zh": "雅"
  },
  {
   "location": "1786/TALK",
   "narrator": "みやび",
   "text": "…そうか。",
   "zh": "……这样啊。",
   "narrator_zh": "雅"
  },
  {
   "location": "1787/TALK",
   "narrator": "みやび",
   "text": "相棒のいるところは、\n晴れてるんか…。"
  },
  {
   "location": "1788/TALK",
   "narrator": "みやび",
   "text": "…意外と、遠いのかも\nしれんな…。",
   "zh": "……说不定比想的\n还要远咯……。",
   "narrator_zh": "雅"
  },
  {
   "location": "1790/TALK",
   "narrator": "みやび",
   "text": "次元が違うとか\nそういうレベルかも\nしれんしね……。"
  },
  {
   "location": "1803/TALK",
   "narrator": "みやび",
   "text": "非日常やねえ"
  },
  {
   "location": "1806/TALK",
   "narrator": "ボイスメール",
   "text": "波浪警報特別警戒"
  },
  {
   "location": "1591/DIALOG",
   "narrator": "Dialog_EventData",
   "text": "<color=green>某月某日　4:43 PM</color>\n神楽坂トライナリーにて。"
  },
  {
   "location": "1818/DIALOG",
   "narrator": "Dialog_GETVoice",
   "text": "<color=green>【みやび】</color>のボイスメール\n<color=red>【波浪警報特別警戒】</color>\nをゲットしました！"
  }
 ]
}
