{
    "dir": "chap07/daydra/dd_ch05_07_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "7505",
        "cid": "kagura",
        "title": "005 メインストーリー",
        "sub_title": "なれあい＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "和稀泥＜后篇＞"
    },
    "entry": [
        {
            "location": "643/TALK",
            "narrator": "つばめ",
            "text": "…卯月さん？",
            "zh": "……卯月？",
            "narrator_zh": "燕"
        },
        {
            "location": "645/TALK",
            "narrator": "神楽",
            "text": "え？\nなんですか？",
            "zh": "诶？\n什么事？",
            "narrator_zh": "神乐"
        },
        {
            "location": "646/TALK",
            "narrator": "つばめ",
            "text": "ううん。\n急に黙っちゃったから、\nどうしたのかな、って…。",
            "zh": "没有。\n你突然不说话了，\n我在想怎么了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "648/TALK",
            "narrator": "神楽",
            "text": "ごめんなさい。\nちょっと、考え事を\nしてただけです…。",
            "zh": "对不起。\n只是稍微，\n在想事情……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "649/TALK",
            "narrator": "神楽",
            "text": "…冷静にならなくちゃ。",
            "zh": "……得冷静下来。",
            "narrator_zh": "神乐"
        },
        {
            "location": "650/TALK",
            "narrator": "神楽",
            "text": "この子は、私の聞いてた\n逢瀬つばめとは、\nまったく違う子…。",
            "zh": "这孩子，和我听说的\n逢濑燕，\n完全不一样……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "651/TALK",
            "narrator": "神楽",
            "text": "でも、逢瀬つばめである\nことに間違いはない。",
            "zh": "可是，她是逢濑燕\n这一点没有错。",
            "narrator_zh": "神乐"
        },
        {
            "location": "652/TALK",
            "narrator": "神楽",
            "text": "その証拠に――",
            "zh": "证据就是——",
            "narrator_zh": "神乐"
        },
        {
            "location": "653/TALK",
            "narrator": "ガブリエラ",
            "text": "ここにいたの？",
            "zh": "原来在这里？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "658/TALK",
            "narrator": "ガブリエラ",
            "text": "新人同士、\n仲良くお喋り？",
            "zh": "两个新人，\n聊得挺热乎？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "660/TALK",
            "narrator": "神楽",
            "text": "はい…なにかご用ですか？",
            "zh": "是的……有什么事吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "662/TALK",
            "narrator": "ガブリエラ",
            "text": "用ってほどの事じゃ\nないんだけど…。",
            "zh": "也算不上\n什么事……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "663/TALK",
            "narrator": "ガブリエラ",
            "text": "まあ、先輩として\n一応言っておこうかと\n思ってね。",
            "zh": "嘛，作为前辈\n姑且说一声\n而已。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "665/TALK",
            "narrator": "ガブリエラ",
            "text": "神楽、あんた初陣のくせに\n中々やるじゃない。",
            "zh": "神乐，你才第一战\n就挺能干嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "666/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤもみやびも、\nあんたの動きを見て\n驚いてたわ。",
            "zh": "绫水和雅也是，\n看了你的动作\n都吓了一跳。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "667/TALK",
            "narrator": "神楽",
            "text": "あ、ありがとう\nございます。",
            "zh": "啊、\n谢谢。",
            "narrator_zh": "神乐"
        },
        {
            "location": "668/TALK",
            "narrator": "ガブリエラ",
            "text": "ま、カマを引っかけて\n転んだのを引いても、\n十分合格点よ。",
            "zh": "嘛，就算把你\n绊倒那次扣掉，\n也够及格了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "669/TALK",
            "narrator": "ガブリエラ",
            "text": "これからも頑張んなさい。",
            "zh": "以后也给我加油。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "671/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "672/TALK",
            "narrator": "つばめ",
            "text": "あ、あの、えっと…。",
            "zh": "那、那个……。",
            "narrator_zh": "燕"
        },
        {
            "location": "674/TALK",
            "narrator": "ガブリエラ",
            "text": "言うまでもないけど、\nあんたはダメダメよ。",
            "zh": "不用说也知道，\n你是不行不行。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "676/TALK",
            "narrator": "つばめ",
            "text": "あうっ…。",
            "zh": "啊呜……。",
            "narrator_zh": "燕"
        },
        {
            "location": "677/TALK",
            "narrator": "ガブリエラ",
            "text": "なんの活躍もしないで、\nピンチになるばっかりの\n足手まといだったし。",
            "zh": "什么表现都没有，\n净是陷入危机的\n累赘。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "678/TALK",
            "narrator": "ガブリエラ",
            "text": "そのくせ、最後の最後に\n美味しいとこだけ\n持ってくなんて…。",
            "zh": "偏偏到了最后，\n只把好处\n拿走……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "679/TALK",
            "narrator": "ガブリエラ",
            "text": "てか、コネクトの仕方\nアーヤに教わってたのに、\nなんでできなかったわけ？",
            "zh": "再说，连接的方法\n绫水都教过了，\n为什么做不到？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "681/TALK",
            "narrator": "つばめ",
            "text": "だ、だって、急なこと\nだったから…。",
            "zh": "因、因为，\n太突然了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "683/TALK",
            "narrator": "神楽",
            "text": "…そんな無防備な\n気持ちで、フェノメノンの\n中に入ったなんて。",
            "zh": "……就以那么毫无防备的\n心情，进入了\nPhenoMENON。",
            "narrator_zh": "神乐"
        },
        {
            "location": "684/TALK",
            "narrator": "神楽",
            "text": "ただの自殺行為…。\nそれとも、絶対的な\n自信があったから？",
            "zh": "简直是自杀行为……。\n还是说，你有\n绝对的自信？",
            "narrator_zh": "神乐"
        },
        {
            "location": "685/TALK",
            "narrator": "ガブリエラ",
            "text": "まあ、とりあえず\n今日のところは\n見逃すけど…。",
            "zh": "嘛，总之\n今天就\n放过你……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "686/TALK",
            "narrator": "ガブリエラ",
            "text": "次からは手抜きしないで、\n本気で戦いなさいよ？",
            "zh": "下次别偷懒，\n给我认真打？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "688/TALK",
            "narrator": "ガブリエラ",
            "text": "あんたと違って、\nこっちはみんな\n命がけなんだから…。",
            "zh": "和你不一样，\n我们这边每个人\n都是拼上命的……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "689/TALK",
            "narrator": "つばめ",
            "text": "て、手抜きなんか\nしてないよ！",
            "zh": "我、我才没有\n偷懒！",
            "narrator_zh": "燕"
        },
        {
            "location": "690/TALK",
            "narrator": "つばめ",
            "text": "確かに、今日は\nダメダメだったかも\nしれないけど…。",
            "zh": "确实，今天\n也许很不行\n也说不定……。",
            "narrator_zh": "燕"
        },
        {
            "location": "691/TALK",
            "narrator": "つばめ",
            "text": "わたし、本気で戦ったよ。\nわたしも、死にたいなんて\n思ってないから。",
            "zh": "我是认真打的。\n我也不想\n去死。",
            "narrator_zh": "燕"
        },
        {
            "location": "692/TALK",
            "narrator": "ガブリエラ",
            "text": "ウソでしょ？\n全然信じられないわ。",
            "zh": "骗人吧？\n完全没法相信。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "693/TALK",
            "narrator": "つばめ",
            "text": "ほ、本当だよ！",
            "zh": "是、是真的！",
            "narrator_zh": "燕"
        },
        {
            "location": "694/TALK",
            "narrator": "ガブリエラ",
            "text": "じゃあ、なんでこの間の\nドームの時みたいに――",
            "zh": "那你为什么不像\n上次穹顶那时候——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "695/TALK",
            "narrator": "つばめ",
            "text": "え？",
            "zh": "诶？",
            "narrator_zh": "燕"
        },
        {
            "location": "696/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "698/TALK",
            "narrator": "ガブリエラ",
            "text": "なんでもない…。\nもういいわよ。",
            "zh": "没什么……。\n已经够了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "699/TALK",
            "narrator": "つばめ",
            "text": "あ、あの、ガブちゃん。\nわたし、次は絶対に\nもっと頑張るから…。",
            "zh": "那、那个，加布。\n我下次一定\n更努力……。",
            "narrator_zh": "燕"
        },
        {
            "location": "702/TALK",
            "narrator": "ガブリエラ",
            "text": "も、もういいって\n言ってるでしょ！",
            "zh": "我、我不是说\n已经够了吗！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "703/TALK",
            "narrator": "ガブリエラ",
            "text": "とにかく、あたしからの\n話は以上だから。\nそれじゃ！",
            "zh": "总之，我要说的\n就这些。\n那就！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "707/TALK",
            "narrator": "つばめ",
            "text": "…どうしたんだろう？\n急に怒るのやめちゃった\nみたいだけど…。",
            "zh": "……怎么回事？\n好像突然\n不生气了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "708/TALK",
            "narrator": "神楽",
            "text": "…さあ？",
            "zh": "……谁知道？",
            "narrator_zh": "神乐"
        },
        {
            "location": "709/TALK",
            "narrator": "神楽",
            "text": "あのドーム戦で、\nこの子は確かに音羽の\nクランを破壊した。",
            "zh": "那场穹顶战里，\n这孩子确实把音羽的\n库兰破坏了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "710/TALK",
            "narrator": "神楽",
            "text": "逢瀬つばめであるという\n証拠は、それで十分。",
            "zh": "她是逢濑燕的证据，\n这样就够了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "712/TALK",
            "narrator": "つばめ",
            "text": "怒るのもイヤになる\nくらい、\n呆れさせちゃったのかな？",
            "zh": "是不是让人厌烦到\n连生气都不想\n生气了？",
            "narrator_zh": "燕"
        },
        {
            "location": "713/TALK",
            "narrator": "神楽",
            "text": "…さあ？\n私にもわからないです。",
            "zh": "……谁知道？\n我也不明白。",
            "narrator_zh": "神乐"
        },
        {
            "location": "714/TALK",
            "narrator": "神楽",
            "text": "警戒、もしくは怯えてたの\nどちらかに決まってるわ。",
            "zh": "不是警惕，就是害怕，\n两者必居其一。",
            "narrator_zh": "神乐"
        },
        {
            "location": "715/TALK",
            "narrator": "神楽",
            "text": "考えるまでもなく\nわかることなのに…。",
            "zh": "不用想\n也明白的事……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "717/TALK",
            "narrator": "つばめ",
            "text": "…どうしよう。\n謝りに行った方が\nいいかな？",
            "zh": "……怎么办。\n要不要去\n道歉？",
            "narrator_zh": "燕"
        },
        {
            "location": "718/TALK",
            "narrator": "神楽",
            "text": "…本気なのかしら？\nそれとも、演技？",
            "zh": "……是认真的吗？\n还是在演戏？",
            "narrator_zh": "神乐"
        },
        {
            "location": "719/TALK",
            "narrator": "神楽",
            "text": "私がカマを引っかけて、\nワザと転んだときの\nこともそう。",
            "zh": "我设下钩子、\n故意摔倒的时候\n也是。",
            "narrator_zh": "神乐"
        },
        {
            "location": "720/TALK",
            "narrator": "神楽",
            "text": "逢瀬つばめの力を\n引き出すために、\nわざとピンチになれば…。",
            "zh": "为了引出逢濑燕的力量，\n只要故意\n陷入危机……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "721/TALK",
            "narrator": "神楽",
            "text": "ドームで見せた力を\n発揮するかと思ったのに、\n結局なにもしなかった。",
            "zh": "本以为她会发挥\n穹顶里展示过的力量，\n结果什么都没做。",
            "narrator_zh": "神乐"
        },
        {
            "location": "722/TALK",
            "narrator": "神楽",
            "text": "それも含めて、すべてが\n逢瀬つばめの自分を\n偽る演技だとしたら――",
            "zh": "连这也算上，如果全部\n都是逢濑燕伪装自己的\n演技的话——",
            "narrator_zh": "神乐"
        },
        {
            "location": "723/TALK",
            "narrator": "神楽",
            "text": "相当な役者だわ…。\n仲間の命すら気にかけない\nくらいなんだから…。",
            "zh": "那可是相当的演员……。\n连同伴的命都不在意\n到这种程度……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "724/TALK",
            "narrator": "つばめ",
            "text": "ねえ、卯月さん。\nどうしたらいいと思う？",
            "zh": "呐，卯月。\n你觉得该怎么办？",
            "narrator_zh": "燕"
        },
        {
            "location": "725/TALK",
            "narrator": "神楽",
            "text": "…あまりしつこくしても\n気分を害するだけだと\n思いますし。",
            "zh": "……再纠缠下去，\n也只会让人\n不高兴。",
            "narrator_zh": "神乐"
        },
        {
            "location": "726/TALK",
            "narrator": "神楽",
            "text": "今度の出撃の時に\n頑張って、\n名誉挽回しましょう！",
            "zh": "下次出击的时候\n好好努力，\n挽回名誉吧！",
            "narrator_zh": "神乐"
        },
        {
            "location": "727/TALK",
            "narrator": "つばめ",
            "text": "…できるかな？",
            "zh": "……我做得到吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "728/TALK",
            "narrator": "神楽",
            "text": "私も手伝いますから、\n一緒に頑張りましょう。",
            "zh": "我也会帮忙，\n一起加油吧。",
            "narrator_zh": "神乐"
        },
        {
            "location": "729/TALK",
            "narrator": "つばめ",
            "text": "卯月さん…。\nありがとう。\nわたし、頑張れそうだよ！",
            "zh": "卯月……。\n谢谢。\n我好像能努力了！",
            "narrator_zh": "燕"
        },
        {
            "location": "730/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "731/TALK",
            "narrator": "神楽",
            "text": "どちらにせよ、この子が\n危険な存在であることに\n変わりはなんだから…。",
            "zh": "不管怎样，这孩子\n是危险的存在\n这一点不会变……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "732/TALK",
            "narrator": "神楽",
            "text": "なにがあろうと、\n警戒を怠らないように\n気をつけないと。",
            "zh": "无论发生什么，\n都得注意\n不要放松警惕。",
            "narrator_zh": "神乐"
        },
        {
            "location": "741/DIALOG",
            "narrator": "Dialog_chapter_ch05",
            "text": "【05 金色の髪のカグラ】",
            "zh": "【05 金发的神乐】",
            "narrator_zh": "Dialog_chapter_ch05"
        },
        {
            "location": "753/DIALOG",
            "narrator": "Dialog_chapter_ch05",
            "text": "【05 金色の髪のカグラ】",
            "zh": "【05 金发的神乐】",
            "narrator_zh": "Dialog_chapter_ch05"
        }
    ]
}
