        {
            "location": "465/TALK",
            "narrator": "つばめ",
            "text": "教室にぃた時",
            "zh": "在教室的时候",
            "narrator_zh": "燕"
        },
        {
            "location": "466/TALK",
            "narrator": "つばめ",
            "text": "きっとそぅかも！o(*･ﾛ･*)o、",
            "zh": "说不定真是那样！o(*･ﾛ･*)o、",
            "narrator_zh": "燕"
        },
        {
            "location": "467/TALK",
            "narrator": "つばめ",
            "text": "ぁりがと(*´︶`*)",
            "zh": "谢谢你(*´︶`*)",
            "narrator_zh": "燕"
        },
        {
            "location": "473/TALK",
            "narrator": "つばめ",
            "text": "…せんぱい、劇場に\n行く前に、カフェに\n寄りませんか？",
            "zh": "……前辈，去剧场\n之前，要不要去咖啡厅\n坐一会儿？",
            "narrator_zh": "燕"
        },
        {
            "location": "476/TALK",
            "narrator": "ガブリエラ",
            "text": "なんであんたと？",
            "zh": "干嘛要跟你一起？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "477/TALK",
            "narrator": "つばめ",
            "text": "あ、あの、わたし、\nせんぱいとお友達に\nなりたくて…。",
            "zh": "那、那个，我呀，\n想和前辈成为\n朋友……。",
            "narrator_zh": "燕"
        },
        {
            "location": "480/TALK",
            "narrator": "ガブリエラ",
            "text": "は、はあ！？\nあんた、さっきから\n何なのよ？",
            "zh": "哈、哈啊！？\n你从刚才开始\n到底在说什么啊？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "481/TALK",
            "narrator": "ガブリエラ",
            "text": "突拍子もないこと\nばっかり言って…。\nバカにしてるわけ？",
            "zh": "尽说些莫名其妙的\n话……。\n你在拿我开涮吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "482/TALK",
            "narrator": "つばめ",
            "text": "違います！\nわたし、本気です。",
            "zh": "不是的！\n我是认真的。",
            "narrator_zh": "燕"
        },
        {
            "location": "483/TALK",
            "narrator": "つばめ",
            "text": "本当にせんぱいと、\n友達になりたいと\n思ってるんです！",
            "zh": "我是真的想和前辈\n成为朋友才这么\n说的！",
            "narrator_zh": "燕"
        },
        {
            "location": "486/TALK",
            "narrator": "ガブリエラ",
            "text": "………………。",
            "zh": "………………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "490/TALK",
            "narrator": "ガブリエラ",
            "text": "…いや、ないから。\n却下よ、却下。",
            "zh": "……不，不可能。\n驳回，驳回。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "491/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしとあんたが\n友達なんて、絶対に\nありえないから。",
            "zh": "我和你成为朋友\n什么的，绝对\n不可能的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "494/TALK",
            "narrator": "ガブリエラ",
            "text": "だいたいあんた、\nもうクラスに沢山\n友達いたじゃない。",
            "zh": "再说了，你不是\n在班里已经有\n很多朋友了吗。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "497/TALK",
            "narrator": "ガブリエラ",
            "text": "ってか、友達作りに\n励んでる場合じゃない\nと思うんだけど？",
            "zh": "话说回来，现在也不是\n热衷于交朋友的\n时候吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "498/TALK",
            "narrator": "ガブリエラ",
            "text": "殆ど役に立ってないん\nだから、訓練の一つ\nでもしたらどうなの。",
            "zh": "你基本都派不上什么用场，\n还不如多去练练\n训练什么的呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "500/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "503/TALK",
            "narrator": "ガブリエラ",
            "text": "……なんて。\nちょっと先輩面\nしすぎたかしらね。",
            "zh": "……开玩笑的。\n是不是有点太摆\n前辈架子了呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "504/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、友達になろう\nなんて言われたの、\n今回が初めてかも…。",
            "zh": "不过，被人说想成为\n朋友什么的，这还是\n头一回吧……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "507/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょっとうれ……\n……っていうか\n悪くない感じだわ。",
            "zh": "稍微有点开……\n……应该说\n感觉倒也不坏啦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "511/TALK",
            "narrator": "つばめ",
            "text": "…そう、ですね。",
            "zh": "……说得、也是呢。",
            "narrator_zh": "燕"
        },
        {
            "location": "518/TALK",
            "narrator": "ガブリエラ",
            "text": "えっ？",
            "zh": "咦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "520/TALK",
            "narrator": "つばめ",
            "text": "わたし、また変なこと\n言って、せんぱいを\n困らせちゃいました。",
            "zh": "我又说了奇怪的话，\n让前辈感到\n困扰了。",
            "narrator_zh": "燕"
        },
        {
            "location": "524/TALK",
            "narrator": "つばめ",
            "text": "せんぱいの気持ちも\n知らないで、変なこと\n言ってごめんなさい。",
            "zh": "明明一点也不了解\n前辈的心情，还说些\n奇怪的话，对不起。",
            "narrator_zh": "燕"
        },
        {
            "location": "531/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょ、ちょっと、\n新人！？",
            "zh": "等、等一下，\n新人！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "533/TALK",
            "narrator": "つばめ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "燕"
        },
        {
            "location": "534/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょま、待ちなさい！\nこんなところで\nなにやって――っ！",
            "zh": "等、等一下啦！\n在这种地方\n干什么呢——！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "535/TALK",
            "narrator": "女子高校生Ａ",
            "text": "うわぁ…やっぱり\nガブリエラちゃん\nって、凄いわー。",
            "zh": "哇啊……小加布里埃拉\n果然\n好厉害啊—。",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "536/TALK",
            "narrator": "女子高校生Ｂ",
            "text": "高等部の先輩に\n頭下げさせてるよ。",
            "zh": "居然让高中部的前辈\n低头道歉了哦。",
            "narrator_zh": "女高中生B"
        },
        {
            "location": "537/TALK",
            "narrator": "女子高校生Ｂ",
            "text": "ヨーロッパの子って、\nみんなあんな感じで\n気が強いのかな。",
            "zh": "欧洲的女孩子，\n是不是都像那样\n性格很强势呀。",
            "narrator_zh": "女高中生B"
        },
        {
            "location": "538/TALK",
            "narrator": "女子高校生Ａ",
            "text": "てか、見て見て！\nあの先輩、ちょっと\n涙目じゃない！？",
            "zh": "话说，快看快看！\n那位前辈是不是\n有点眼眶湿了！？",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "540/TALK",
            "narrator": "ガブリエラ",
            "text": "ぐっ…。",
            "zh": "唔……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "542/TALK",
            "narrator": "ガブリエラ",
            "text": "ああっ、\nあたしのバカバカ！",
            "zh": "啊啊，\n我真是个大笨蛋！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "543/TALK",
            "narrator": "ガブリエラ",
            "text": "つばめが純粋すぎる\nのなんて、わかってた\nはずなのにっ！",
            "zh": "明明我早就该知道\n燕有多么单纯\n的才对啊！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "545/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょ……\nちょっと、新人？",
            "zh": "那个……\n我说，新人？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "546/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "548/TALK",
            "narrator": "ガブリエラ",
            "text": "……はぁ。\n何でこんな事に……。",
            "zh": "……哈啊。\n怎么会变成这样……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "550/TALK",
            "narrator": "ガブリエラ",
            "text": "…ほ、ほら！　もう\n頭上げなさいって。",
            "zh": "……好、好啦！快把\n头抬起来吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "551/TALK",
            "narrator": "ガブリエラ",
            "text": "もう怒ってないから、\nね、新人…つばめ？\nつばめさーん？",
            "zh": "我已经没生气了，\n好吗，新人……燕？\n燕小姐—？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "553/TALK",
            "narrator": "つばめ",
            "text": "はい……。",
            "zh": "是……。",
            "narrator_zh": "燕"
        },
        {
            "location": "555/TALK",
            "narrator": "ガブリエラ",
            "text": "ああもう！",
            "zh": "啊啊真是的！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "556/TALK",
            "narrator": "ガブリエラ",
            "text": "怒ってないって\n言ってるんだから、\nしゃんとしなさい！",
            "zh": "我都说了\n没生气啦，\n快打起精神来！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "558/TALK",
            "narrator": "つばめ",
            "text": "は、はい！\nガブリエラせんぱい！\nごめんなさい！",
            "zh": "是、是的！\n加布里埃拉前辈！\n对不起！",
            "narrator_zh": "燕"
        },
        {
            "location": "559/TALK",
            "narrator": "ガブリエラ",
            "text": "だから、せんぱいも\nここでは禁止よ！",
            "zh": "所以说，前辈这个词\n在这里也禁止啦！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "560/TALK",
            "narrator": "つばめ",
            "text": "はい、せんぱい！",
            "zh": "是，前辈！",
            "narrator_zh": "燕"
        },
        {
            "location": "561/TALK",
            "narrator": "つばめ",
            "text": "あっ！！",
            "zh": "啊！！",
            "narrator_zh": "燕"
        },
        {
            "location": "563/TALK",
            "narrator": "ガブリエラ",
            "text": "ダメだこりゃ……。",
            "zh": "没救了这孩子……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "575/DIALOG",
            "narrator": "Dialog_chapter_ch03",
            "text": "【07 愛，ロボット】",
            "zh": "【07 爱，机器人】",
            "narrator_zh": "Dialog_chapter_ch03"
        }
    ]
}
