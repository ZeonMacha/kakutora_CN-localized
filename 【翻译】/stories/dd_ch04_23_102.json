{
    "dir": "chap23/daydra/dd_ch04_23_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "23405",
        "cid": "miyabi",
        "title": "005 メインストーリー",
        "sub_title": "らしくないらしい＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "据说很不像她＜后篇＞"
    },
    "entry": [
        {
            "location": "764/TALK",
            "narrator": "みやび",
            "text": "ワガママすぎやと",
            "zh": "要说我太任性咯",
            "narrator_zh": "雅"
        },
        {
            "location": "765/TALK",
            "narrator": "みやび",
            "text": "気に入らないなら見なければよい",
            "zh": "不喜欢的话别看就好",
            "narrator_zh": "雅"
        },
        {
            "location": "766/TALK",
            "narrator": "みやび",
            "text": "ほい解決",
            "zh": "喏，解决",
            "narrator_zh": "雅"
        },
        {
            "location": "767/TALK",
            "narrator": "みやび",
            "text": "さよなら",
            "zh": "再见",
            "narrator_zh": "雅"
        },
        {
            "location": "773/TALK",
            "narrator": "みやび",
            "text": "…さあ、カレー食いに\n行くぞね。",
            "zh": "…来，去吃\n咖喱咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "775/TALK",
            "narrator": "繭",
            "text": "では、この近くにある\n有名なお店へ――",
            "zh": "那么，去附近那家\n有名的店——",
            "narrator_zh": "茧"
        },
        {
            "location": "776/TALK",
            "narrator": "みやび",
            "text": "つまらん。",
            "zh": "没劲。",
            "narrator_zh": "雅"
        },
        {
            "location": "778/TALK",
            "narrator": "みやび",
            "text": "検索して出てくるような\n有名店なんぞ行っても、\n面白味ないやろ？",
            "zh": "搜出来的那种\n有名店，去了也\n没驷马意思啵？",
            "narrator_zh": "雅"
        },
        {
            "location": "779/TALK",
            "narrator": "みやび",
            "text": "どうせなら、\n穴場探しするぞね。",
            "zh": "反正要吃，\n就找冷门好店咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "780/TALK",
            "narrator": "繭",
            "text": "…本気ですか？",
            "zh": "…是认真的吗？",
            "narrator_zh": "茧"
        },
        {
            "location": "781/TALK",
            "narrator": "みやび",
            "text": "嫌ならえいよ。\nうちだけで行くき。",
            "zh": "不愿意就算咯。\n我自己去啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "782/TALK",
            "narrator": "繭",
            "text": "…いえ。\nお供させていただきます。",
            "zh": "…不。\n请让我陪同前往。",
            "narrator_zh": "茧"
        },
        {
            "location": "807/TALK",
            "narrator": "みやび",
            "text": "…もう夜かぁ。\nちっくと遊び過ぎた\nかもしれんなぁ…。",
            "zh": "…已经到晚上了啊。\n可能玩得\n有点过头咯……",
            "narrator_zh": "雅"
        },
        {
            "location": "809/TALK",
            "narrator": "繭",
            "text": "気分転換も必要です。\n別に構わないと\n思いますよ？",
            "zh": "换心情也是必要的。\n我觉得完全\n没问题哦？",
            "narrator_zh": "茧"
        },
        {
            "location": "810/TALK",
            "narrator": "みやび",
            "text": "…そうやね。",
            "zh": "…也是咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "812/TALK",
            "narrator": "みやび",
            "text": "昼間に比べて、\n気持ちがスッキリ\nしたちや。",
            "zh": "比起白天，\n心情痛快\n多了滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "813/TALK",
            "narrator": "繭",
            "text": "スッキリしたと\nいうのであれば\n何よりです。",
            "zh": "能痛快的话，\n那再好\n不过了。",
            "narrator_zh": "茧"
        },
        {
            "location": "814/TALK",
            "narrator": "繭",
            "text": "しかし、まさか\n屋台のカレーを食べるとは\n思いませんでした。",
            "zh": "不过，没想到\n居然会吃\n路边摊的咖喱。",
            "narrator_zh": "茧"
        },
        {
            "location": "816/TALK",
            "narrator": "みやび",
            "text": "海軍カレーは横須賀来れば\nいつでも食えるやろ？",
            "zh": "海军咖喱只要来横须贺\n随时都能吃啵？",
            "narrator_zh": "雅"
        },
        {
            "location": "817/TALK",
            "narrator": "みやび",
            "text": "やき、屋台カレーの方が\nレア度が上と判断した\n結果ぞね。",
            "zh": "所以啵，判断下来\n路边摊咖喱的\n稀有度更高咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "818/TALK",
            "narrator": "繭",
            "text": "ふふっ…、\nみやび先輩らしいですね。",
            "zh": "呵呵……，\n真有雅前辈的作风。",
            "narrator_zh": "茧"
        },
        {
            "location": "819/TALK",
            "narrator": "繭",
            "text": "本当に、\n調子が戻ったようで\n安心しました。",
            "zh": "真的，感觉状态\n恢复过来了，\n我就放心了。",
            "narrator_zh": "茧"
        },
        {
            "location": "820/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "832/TALK",
            "narrator": "みやび",
            "text": "うちはウサギに",
            "zh": "我啊，被兔子",
            "narrator_zh": "雅"
        },
        {
            "location": "833/TALK",
            "narrator": "みやび",
            "text": "心配されちょったがよ",
            "zh": "担心了好一阵咯",
            "narrator_zh": "雅"
        },
        {
            "location": "835/SEL",
            "narrator": "",
            "text": "知ってたよ",
            "zh": "我早就知道哦",
            "narrator_zh": ""
        },
        {
            "location": "836/SEL",
            "narrator": "",
            "text": "いい子だよね",
            "zh": "是个好孩子呢",
            "narrator_zh": ""
        },
        {
            "location": "837/SEL",
            "narrator": "",
            "text": "気付いてなかったんだ……",
            "zh": "原来没注意到啊……",
            "narrator_zh": ""
        },
        {
            "location": "838/ACT",
            "narrator": "",
            "text": "知ってたよ",
            "zh": "我早就知道哦",
            "narrator_zh": ""
        },
        {
            "location": "839/TALK",
            "narrator": "みやび",
            "text": "なんと",
            "zh": "什么！",
            "narrator_zh": "雅"
        },
        {
            "location": "840/TALK",
            "narrator": "みやび",
            "text": "さすがは相棒",
            "zh": "不愧是搭档",
            "narrator_zh": "雅"
        },
        {
            "location": "841/ACT",
            "narrator": "",
            "text": "いい子だよね",
            "zh": "是个好孩子呢",
            "narrator_zh": ""
        },
        {
            "location": "842/TALK",
            "narrator": "みやび",
            "text": "その通りだ",
            "zh": "说得没错",
            "narrator_zh": "雅"
        },
        {
            "location": "843/TALK",
            "narrator": "みやび",
            "text": "当たり前すぎて青天の霹靂",
            "zh": "理所当然到堪称晴天霹雳",
            "narrator_zh": "雅"
        },
        {
            "location": "844/ACT",
            "narrator": "",
            "text": "気付いてなかったんだ……",
            "zh": "原来没注意到啊……",
            "narrator_zh": ""
        },
        {
            "location": "845/TALK",
            "narrator": "みやび",
            "text": "これは",
            "zh": "这话",
            "narrator_zh": "雅"
        },
        {
            "location": "846/TALK",
            "narrator": "みやび",
            "text": "うちの目が節穴だと言いたいのか",
            "zh": "是在说我是睁眼瞎咯",
            "narrator_zh": "雅"
        },
        {
            "location": "848/TALK",
            "narrator": "みやび",
            "text": "改めて礼を言うべきか否か",
            "zh": "该不该重新道谢呢",
            "narrator_zh": "雅"
        },
        {
            "location": "850/SEL",
            "narrator": "",
            "text": "好きにすれば",
            "zh": "随你喜欢咯",
            "narrator_zh": ""
        },
        {
            "location": "851/SEL",
            "narrator": "",
            "text": "言うのは野暮かな",
            "zh": "说出来就太煞风景了吧",
            "narrator_zh": ""
        },
        {
            "location": "852/SEL",
            "narrator": "",
            "text": "$me$にも言って",
            "zh": "也对$me$说说嘛",
            "narrator_zh": ""
        },
        {
            "location": "853/ACT",
            "narrator": "",
            "text": "好きにすれば",
            "zh": "随你喜欢咯",
            "narrator_zh": ""
        },
        {
            "location": "854/TALK",
            "narrator": "みやび",
            "text": "是非もなし",
            "zh": "别无选择",
            "narrator_zh": "雅"
        },
        {
            "location": "855/TALK",
            "narrator": "みやび",
            "text": "ということか",
            "zh": "是这么回事咯",
            "narrator_zh": "雅"
        },
        {
            "location": "856/TALK",
            "narrator": "みやび",
            "text": "答えになっとらん！",
            "zh": "根本不算回答！",
            "narrator_zh": "雅"
        },
        {
            "location": "857/ACT",
            "narrator": "",
            "text": "言うのは野暮かな",
            "zh": "说出来就太煞风景了吧",
            "narrator_zh": ""
        },
        {
            "location": "858/TALK",
            "narrator": "みやび",
            "text": "なんともまあ",
            "zh": "真是服了",
            "narrator_zh": "雅"
        },
        {
            "location": "859/TALK",
            "narrator": "みやび",
            "text": "日本人の奥ゆかしさよ",
            "zh": "这就是日本人的含蓄啊",
            "narrator_zh": "雅"
        },
        {
            "location": "860/ACT",
            "narrator": "",
            "text": "$me$にも言って",
            "zh": "也对$me$说说嘛",
            "narrator_zh": ""
        },
        {
            "location": "861/TALK",
            "narrator": "みやび",
            "text": "あざーっした",
            "zh": "谢啦——",
            "narrator_zh": "雅"
        },
        {
            "location": "878/TALK",
            "narrator": "繭",
            "text": "あっ…、\n上がりましたね。",
            "zh": "啊……，\n升起来了。",
            "narrator_zh": "茧"
        },
        {
            "location": "880/TALK",
            "narrator": "みやび",
            "text": "…ん。",
            "zh": "…嗯。",
            "narrator_zh": "雅"
        },
        {
            "location": "881/TALK",
            "narrator": "繭",
            "text": "綺麗です…。\nこんなに大きな\n花火なんですね。",
            "zh": "好漂亮……。\n原来有这么\n大的烟花啊。",
            "narrator_zh": "茧"
        },
        {
            "location": "882/TALK",
            "narrator": "みやび",
            "text": "そうやね…。",
            "zh": "是啊……。",
            "narrator_zh": "雅"
        },
        {
            "location": "907/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "910/TALK",
            "narrator": "みやび",
            "text": "すまんかった…。\n今日一日、\n振り回してしもうて…。",
            "zh": "没好意思……。\n今天一整天，\n都让你跟着折腾……",
            "narrator_zh": "雅"
        },
        {
            "location": "912/TALK",
            "narrator": "みやび",
            "text": "うちな、\n認めたくなかったんよ。",
            "zh": "我啊，\n一直不想承认咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "913/TALK",
            "narrator": "みやび",
            "text": "卯月がスパイや、\nっちゅうことを…。",
            "zh": "卯月是间谍，\n这件事……",
            "narrator_zh": "雅"
        },
        {
            "location": "916/TALK",
            "narrator": "繭",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "茧"
        },
        {
            "location": "918/TALK",
            "narrator": "みやび",
            "text": "けんど、\n現実はしっかり\n受け止めんといかん。",
            "zh": "但是，\n现实还是得\n好好面对咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "920/TALK",
            "narrator": "みやび",
            "text": "卯月がうちらを\n裏切ったゆうんは、\nまぎれもない事実や。",
            "zh": "卯月背叛了我们，\n这是无可辩驳的\n事实咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "921/TALK",
            "narrator": "みやび",
            "text": "第一、卯月神楽は\n管理庁のスパイや。",
            "zh": "首先，卯月神乐\n是管理厅的间谍。",
            "narrator_zh": "雅"
        },
        {
            "location": "922/TALK",
            "narrator": "みやび",
            "text": "最初からうちらを\n裏切ることを前提に、\n近づいたに違いない。",
            "zh": "从一开始，她就是\n抱着背叛我们的打算\n才接近的啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "923/TALK",
            "narrator": "繭",
            "text": "…そういうことに\nなりますね。",
            "zh": "…结果就变成\n这样了呢。",
            "narrator_zh": "茧"
        },
        {
            "location": "924/TALK",
            "narrator": "みやび",
            "text": "裏切り者とわかれば\nどういう結末が待つかは、\n考えんでもわかるやろ。",
            "zh": "既然知道是背叛者，\n等着她的是什么下场，\n不用想也懂啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "925/TALK",
            "narrator": "みやび",
            "text": "卯月も、その辺は\n覚悟の上で\n行動しちょったろう。",
            "zh": "卯月那家伙，\n也是带着觉悟\n才行动的咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "926/TALK",
            "narrator": "みやび",
            "text": "意外とばれたことで\n気は楽になったん\n違うかねえ。",
            "zh": "意外暴露了，\n说不定反倒\n松了口气咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "927/TALK",
            "narrator": "みやび",
            "text": "けんど、うちらは本気で\n相手せんと\nいかんろうね。",
            "zh": "但是，我们也不得\n不拿出真本事\n对付她了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "928/TALK",
            "narrator": "繭",
            "text": "…卯月神楽を、\n敵として見るという\nことですね？",
            "zh": "…就是说，要把卯月神乐\n当作敌人看待\n是这个意思呢？",
            "narrator_zh": "茧"
        },
        {
            "location": "929/TALK",
            "narrator": "みやび",
            "text": "そうやねえ…。",
            "zh": "是啊……。",
            "narrator_zh": "雅"
        },
        {
            "location": "930/TALK",
            "narrator": "みやび",
            "text": "…そういうことに\nなるねえ。",
            "zh": "…就是这么\n回事呢。",
            "narrator_zh": "雅"
        },
        {
            "location": "931/TALK",
            "narrator": "みやび",
            "text": "それに、今回の件で\n管理庁が真っ黒ゆう証拠も\n手に入れたことになる。",
            "zh": "而且，这次的事\n也等于拿到了管理厅\n黑得透透的证据。",
            "narrator_zh": "雅"
        },
        {
            "location": "932/TALK",
            "narrator": "繭",
            "text": "はい…これで向こうの\n活動も、ノンストップで\n行けますね。",
            "zh": "嗯……这样那边的\n活动也能\n一路畅通了呢。",
            "narrator_zh": "茧"
        },
        {
            "location": "933/TALK",
            "narrator": "みやび",
            "text": "…こんなうちやけんど、\n協力してもらえるか？",
            "zh": "…我这么个样子，\n你还愿意帮忙咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "934/TALK",
            "narrator": "繭",
            "text": "…もちろんです。\n最後までお付き合い\nいたします。",
            "zh": "…当然。\n我会奉陪到\n最后。",
            "narrator_zh": "茧"
        },
        {
            "location": "935/TALK",
            "narrator": "みやび",
            "text": "これからは、\n今まで以上に\n忙しくなるな…。",
            "zh": "从今往后，\n会比以前\n更忙咯……",
            "narrator_zh": "雅"
        },
        {
            "location": "936/TALK",
            "narrator": "繭",
            "text": "問題ありません。",
            "zh": "没有问题。",
            "narrator_zh": "茧"
        },
        {
            "location": "937/TALK",
            "narrator": "みやび",
            "text": "…報酬もないけんど、\nマジでえいが？",
            "zh": "…又没得报酬，\n真的得咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "938/TALK",
            "narrator": "繭",
            "text": "ふふっ…報酬は今日一日、\nたっぷりいただきました。",
            "zh": "呵呵……报酬在今天就\n已经收得足足的了。",
            "narrator_zh": "茧"
        },
        {
            "location": "939/TALK",
            "narrator": "繭",
            "text": "みやび先輩の可愛らしい\nレアな姿を、\n沢山見れましたので。",
            "zh": "雅前辈可爱又稀有的\n一面，我看到了\n好多好多。",
            "narrator_zh": "茧"
        },
        {
            "location": "941/TALK",
            "narrator": "みやび",
            "text": "…は！？",
            "zh": "…哈！？",
            "narrator_zh": "雅"
        },
        {
            "location": "942/TALK",
            "narrator": "みやび",
            "text": "ワガママ言いまくって\nウサギを振り回した\nだけやんか。",
            "zh": "我只是一个劲\n任性折腾兔子\n而已啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "943/TALK",
            "narrator": "繭",
            "text": "最高の報酬です！",
            "zh": "这是最好的报酬！",
            "narrator_zh": "茧"
        },
        {
            "location": "945/TALK",
            "narrator": "みやび",
            "text": "…まあ、ウサギが\nそれでえい言うなら、\nそれで構わんけんど…。",
            "zh": "…嘛，只要兔子\n说这样得，\n那我无所谓咯……",
            "narrator_zh": "雅"
        },
        {
            "location": "946/TALK",
            "narrator": "繭",
            "text": "構いません。\n今後も報酬は\nこの形を希望します。",
            "zh": "不介意。\n今后的报酬，\n也希望是这个形式。",
