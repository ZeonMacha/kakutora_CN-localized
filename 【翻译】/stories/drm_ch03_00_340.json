{
    "dir": "dramatics/daydra/drm_ch03_00_340.js",
    "type": "Episode",
    "info": {
        "story_id": "3034",
        "cid": "gabriella",
        "title": "らぶとーく  第34話",
        "sub_title": "恋のウィルス感染",
        "title_zh": "恋爱漫谈 第34话",
        "sub_title_zh": "恋爱病毒感染"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "恋のウィルス感染",
            "zh": "恋爱病毒感染"
        },
        {
            "location": "27/TALK",
            "narrator": "繭",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "茧"
        },
        {
            "location": "29/TALK",
            "narrator": "雛",
            "text": "繭ちん、何見てるの？",
            "zh": "小茧，在看什么？",
            "narrator_zh": "雏"
        },
        {
            "location": "31/TALK",
            "narrator": "繭",
            "text": "外…下校する人達。",
            "zh": "外面……放学的人们。",
            "narrator_zh": "茧"
        },
        {
            "location": "33/TALK",
            "narrator": "繭",
            "text": "なんか、やたらと\nカップルが多い気が\nする。",
            "zh": "总觉得\n情侣特别\n多。",
            "narrator_zh": "茧"
        },
        {
            "location": "35/TALK",
            "narrator": "ガブリエラ",
            "text": "えっ…あ、本当ね。\n手を繋いだり…。",
            "zh": "诶……啊，真的。\n有人牵着手……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "36/TALK",
            "narrator": "ガブリエラ",
            "text": "わっ、あそこの木の影！\nキスしてる人達まで\nいるし…。",
            "zh": "哇，那边的树荫！\n还有人在\n接吻……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "38/TALK",
            "narrator": "繭",
            "text": "うちの学校、こんなに\nカップルいた？",
            "zh": "我们学校，有这么多\n情侣吗？",
            "narrator_zh": "茧"
        },
        {
            "location": "39/TALK",
            "narrator": "雛",
            "text": "いなかったと思うよー？",
            "zh": "我觉得没有哦？",
            "narrator_zh": "雏"
        },
        {
            "location": "40/TALK",
            "narrator": "雛",
            "text": "けどほら、カップルは\n一組でもいれば――",
            "zh": "可是你看，只要有一对\n情侣——",
            "narrator_zh": "雏"
        },
        {
            "location": "41/TALK",
            "narrator": "雛",
            "text": "それを中心に爆発的に\n広がったりすることも\nあるからねー。",
            "zh": "也可能以那为中心\n爆发式地\n扩散开哦——",
            "narrator_zh": "雏"
        },
        {
            "location": "44/TALK",
            "narrator": "ガブリエラ",
            "text": "…なんか、ウイルス感染\nみたいで嫌なんだけど？",
            "zh": "……总觉得，像病毒\n感染一样，真讨厌。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "46/TALK",
            "narrator": "雛",
            "text": "似たようなもんでしょ。\nね、繭ちん？",
            "zh": "差不多吧。\n对吧，小茧？",
            "narrator_zh": "雏"
        },
        {
            "location": "47/TALK",
            "narrator": "繭",
            "text": "…わからなくもない。",
            "zh": "……也不是不能理解。",
            "narrator_zh": "茧"
        },
        {
            "location": "48/TALK",
            "narrator": "繭",
            "text": "恋はウイルスみたいな\nもの。",
            "zh": "恋爱就像\n病毒。",
            "narrator_zh": "茧"
        },
        {
            "location": "50/TALK",
            "narrator": "ガブリエラ",
            "text": "っていうか、あんた達\n凄いわかった風な感じで\n話してるけど――",
            "zh": "话说，你们\n一副特别懂的\n样子在说——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "51/TALK",
            "narrator": "ガブリエラ",
            "text": "好きな男の子でも\nいるの？",
            "zh": "有喜欢的\n男生吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "52/TALK",
            "narrator": "繭",
            "text": "いない。",
            "zh": "没有。",
            "narrator_zh": "茧"
        },
        {
            "location": "54/TALK",
            "narrator": "雛",
            "text": "恋愛感情は向けるのも\n向けられるのも苦手ー。",
            "zh": "恋爱感情，无论是对别人\n还是被别人，都不擅长。",
            "narrator_zh": "雏"
        },
        {
            "location": "55/TALK",
            "narrator": "ガブリエラ",
            "text": "それでよくそんなこと\n言えるわね？",
            "zh": "亏你能说出\n那种话？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "56/TALK",
            "narrator": "ガブリエラ",
            "text": "好きな男の子も彼氏も\nいないあんた達が――",
            "zh": "没有喜欢的男生也没有男朋友的\n你们——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "58/TALK",
            "narrator": "ガブリエラ",
            "text": "何言ったとしても\n説得力皆無よ？",
            "zh": "说什么都\n一点说服力都没有吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "60/TALK",
            "narrator": "雛",
            "text": "大丈夫だよー。\nほら、知識はあるから！",
            "zh": "没关系啦。\n你看，我有知识！",
            "narrator_zh": "雏"
        },
        {
            "location": "61/TALK",
            "narrator": "ガブリエラ",
            "text": "…耳年増ね。",
            "zh": "……真是耳朵长见识。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "62/TALK",
            "narrator": "雛",
            "text": "愛の伝道師は\n自分の恋愛より――",
            "zh": "爱的传道者\n比起自己的恋爱——",
            "narrator_zh": "雏"
        },
        {
            "location": "63/TALK",
            "narrator": "雛",
            "text": "他人の恋愛に重きを置く\n宿命なのさー。",
            "zh": "更把别人的恋爱放在首位，\n这是宿命呀。",
            "narrator_zh": "雏"
        },
        {
            "location": "65/TALK",
            "narrator": "繭",
            "text": "…他人からすれば\nはた迷惑なお節介、\nとも言う。",
            "zh": "……从别人看来，\n这也可以叫\n多管闲事。",
            "narrator_zh": "茧"
        },
        {
            "location": "66/TALK",
            "narrator": "ガブリエラ",
            "text": "それ以外の言い方\nないでしょ？",
            "zh": "没有别的说法\n了吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "68/TALK",
            "narrator": "雛",
            "text": "じゃあ、少なくとも\nあたし達よりは恋に\n身近なところにいる――",
            "zh": "那么，至少\n比我们更接近恋爱\n的——",
            "narrator_zh": "雏"
        },
        {
            "location": "69/TALK",
            "narrator": "雛",
            "text": "ガブリエラちゃんに\n教えてもらおっかなー？",
            "zh": "让加布里埃拉\n来教教我们吧？",
            "narrator_zh": "雏"
        },
        {
            "location": "71/TALK",
            "narrator": "ガブリエラ",
            "text": "えっ！？",
            "zh": "诶！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "74/TALK",
            "narrator": "繭",
            "text": "賛成。\n私も聞きたい。",
            "zh": "赞成。\n我也想听。",
            "narrator_zh": "茧"
        },
        {
            "location": "75/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょ、繭まで\n何言いだすのよ！？",
            "zh": "等、连茧都在说\n什么啊！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "76/TALK",
            "narrator": "雛",
            "text": "はいはい、それじゃ――",
            "zh": "好好，那么——",
            "narrator_zh": "雏"
        },
        {
            "location": "77/TALK",
            "narrator": "雛",
            "text": "ウイルスとかけまして、\n恋と解く！！",
            "zh": "把病毒比作，\n解作恋爱！！",
            "narrator_zh": "雏"
        },
        {
            "location": "78/TALK",
            "narrator": "繭",
            "text": "…その心は？",
            "zh": "……其心为何？",
            "narrator_zh": "茧"
        },
        {
            "location": "80/TALK",
            "narrator": "ガブリエラ",
            "text": "急過ぎよ！！",
            "zh": "太突然了！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "82/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょっと待って。\n今、考えるから…。",
            "zh": "等一下。\n我现在想想……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "94/TALK",
            "narrator": "ガブリエラ",
            "text": "$handle$、大至急答えて",
            "zh": "$handle$，赶紧回答",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "95/TALK",
            "narrator": "ガブリエラ",
            "text": "ウイルスとかけまして、恋と解く",
            "zh": "把病毒比作，解作恋爱",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "96/TALK",
            "narrator": "ガブリエラ",
            "text": "その心は？",
            "zh": "那份心是？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "98/SEL",
            "narrator": "",
            "text": "どちらも熱が出ます",
            "zh": "两个都会发烧",
            "narrator_zh": ""
        },
        {
            "location": "99/SEL",
            "narrator": "",
            "text": "身体が震えます",
            "zh": "我身体在发抖",
            "narrator_zh": ""
        },
        {
            "location": "100/SEL",
            "narrator": "",
            "text": "気が付いたら感染しています",
            "zh": "不知不觉就被感染了",
            "narrator_zh": ""
        },
        {
            "location": "101/ACT",
            "narrator": "",
            "text": "どちらも熱が出ます",
            "zh": "两个都会发烧",
            "narrator_zh": ""
        },
        {
            "location": "102/TALK",
            "narrator": "ガブリエラ",
            "text": "結構上手いわね",
            "zh": "相当不错呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "103/TALK",
            "narrator": "ガブリエラ",
            "text": "それならありじゃないかしら？",
            "zh": "那样不也可以吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "115/TALK",
            "narrator": "ガブリエラ",
            "text": "…その心は！\nどちらも熱が出ます。",
            "zh": "……其心为何！\n都会发烧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "117/TALK",
            "narrator": "繭",
            "text": "…驚いた。\n結構上手い。",
            "zh": "……真惊人。\n相当厉害。",
            "narrator_zh": "茧"
        },
        {
            "location": "119/TALK",
            "narrator": "雛",
            "text": "さっすが\nガブリエラちゃん！",
            "zh": "果然厉害\n加布里埃拉酱！",
            "narrator_zh": "雏"
        },
        {
            "location": "120/TALK",
            "narrator": "雛",
            "text": "恋愛真っ最中の子は、\n言うことも一味違うね！",
            "zh": "正在恋爱的人，\n说的话就是不一样呢！",
            "narrator_zh": "雏"
        },
        {
            "location": "122/TALK",
            "narrator": "繭",
            "text": "枯れてない。\n一緒にすんな。",
            "zh": "我可没枯萎。\n别把我算进去。",
            "narrator_zh": "茧"
        },
        {
            "location": "125/TALK",
            "narrator": "ガブリエラ",
            "text": "っていうか、二人とも\n本当に好きな男の子\nいないわけ？",
            "zh": "话说，你们两个人\n真的没有\n喜欢的男生吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "126/TALK",
            "narrator": "雛",
            "text": "綾水様より素敵な\n男の子がいないのが\n問題なんだよねー。",
            "zh": "问题是没有比\n绫水大人更棒的\n男生呀。",
            "narrator_zh": "雏"
        },
        {
            "location": "128/TALK",
            "narrator": "繭",
            "text": "男よりＰＣ。\nプログラムはウソを\nつかない。",
            "zh": "比起男生，是PC。\n程序不会\n说谎。",
            "narrator_zh": "茧"
        },
        {
            "location": "129/TALK",
            "narrator": "ガブリエラ",
            "text": "…本当、よくそれで\n恋だ恋愛だのと話が\n出来たものね。",
            "zh": "……真是的，就那样\n还能谈什么恋什么爱的，\n也真是厉害呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "132/TALK",
            "narrator": "ガブリエラ",
            "text": "…っていうか、\n片思いしてる分だけ――",
            "zh": "……话说，\n就凭我在单相思——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "133/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしの方が恋愛のこと\nわかってるじゃない。",
            "zh": "我对恋爱的了解\n不就比你多。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "134/TALK",
            "narrator": "ガブリエラ",
            "text": "…ふふっ。",
            "zh": "……呵呵。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "136/TALK",
            "narrator": "繭",
            "text": "…何？\n勝ち誇った顔してる。",
            "zh": "……什么？\n一脸得意的样子。",
            "narrator_zh": "茧"
        },
        {
            "location": "138/TALK",
            "narrator": "ガブリエラ",
            "text": "別に、なんでもないわ。",
            "zh": "没什么，什么都没有。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "140/TALK",
            "narrator": "雛",
            "text": "うっわ、絶対なんでも\nなくない！",
            "zh": "哇，绝对不是\n没什么！",
            "narrator_zh": "雏"
        },
        {
            "location": "142/TALK",
            "narrator": "ガブリエラ",
            "text": "ふふっ…。",
            "zh": "呵呵……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "143/TALK",
            "narrator": "ガブリエラ",
            "text": "やっぱり、あたしの方が\n大人ね。",
            "zh": "果然，我更\n像大人。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "144/ACT",
            "narrator": "",
            "text": "身体が震えます",
            "zh": "我身体在发抖",
            "narrator_zh": ""
        },
        {
            "location": "145/TALK",
            "narrator": "ガブリエラ",
            "text": "身体が震える！？",
            "zh": "身体会发抖！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "146/TALK",
            "narrator": "ガブリエラ",
            "text": "それって凄い重病じゃない？",
            "zh": "那不是很重的病吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "147/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、身体が震えるほどの恋なんて",
            "zh": "不过，让人身体发抖的恋爱什么的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "148/TALK",
            "narrator": "ガブリエラ",
            "text": "凄く情熱的かも///////",
            "zh": "也许非常热情///////",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "160/TALK",
            "narrator": "ガブリエラ",
            "text": "…その心は！\n身体が震えるわ。",
            "zh": "……其心为何！\n身体会发抖。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "161/TALK",
            "narrator": "繭",
            "text": "…は？",
            "zh": "……啊？",
            "narrator_zh": "茧"
        },
        {
            "location": "162/TALK",
            "narrator": "ガブリエラ",
            "text": "だから、\n身体が震えるのよ。",
            "zh": "所以，身体才会\n发抖。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "163/TALK",
            "narrator": "ガブリエラ",
            "text": "落雷を受けたような\n衝撃を覚えるくらいの\n恋なんて――",
            "zh": "像被雷劈中\n那样的冲击的\n恋爱——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "166/TALK",
            "narrator": "ガブリエラ",
            "text": "情熱的で素敵だと\n思わない？",
            "zh": "你不觉得\n热情又美好吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "167/TALK",
            "narrator": "雛",
            "text": "…ら、落雷？\n情熱？",
            "zh": "……打、打雷？\n热情？",
            "narrator_zh": "雏"
        },
        {
            "location": "168/TALK",
            "narrator": "繭",
            "text": "…ドン引き。",
            "zh": "……彻底无语。",
            "narrator_zh": "茧"
        },
        {
            "location": "170/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょっ！？\n何よそれ！？",
            "zh": "喂！？\n那是什么啊！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "171/TALK",
            "narrator": "ガブリエラ",
            "text": "恋ってそういう情熱的な\nものじゃないの？",
            "zh": "恋爱不就是这么热情的\n东西吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "173/TALK",
            "narrator": "雛",
            "text": "うーん…どうなのかな？\nまゆちんはどう思う？",
            "zh": "嗯……是吗？\n小茧怎么想？",
            "narrator_zh": "雏"
        },
        {
            "location": "174/TALK",
            "narrator": "繭",
            "text": "恋じゃなくて普通に\n病気と勘違いしそう。",
            "zh": "这不是恋爱，普通地\n会误当成生病。",
            "narrator_zh": "茧"
        },
        {
            "location": "176/TALK",
            "narrator": "雛",
            "text": "だよねー。\nあたしもそういうのは\n嫌かな。",
            "zh": "是吧——。\n那种我也\n讨厌呢。",
            "narrator_zh": "雏"
        },
        {
            "location": "180/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…\nわかってないわね。",
            "zh": "唉……\n还没明白呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "181/TALK",
            "narrator": "ガブリエラ",
            "text": "恋っていうのは、\nこれくらい衝撃が\n大きい方が――",
            "zh": "所谓恋爱，\n冲击要是\n这么大的话——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "182/TALK",
            "narrator": "ガブリエラ",
            "text": "する方も、される方も\n燃えるのよ？",
            "zh": "不管是爱上的一方，还是被爱上的一方\n都会燃烧吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "183/TALK",
            "narrator": "雛",
            "text": "そうかなー？",
            "zh": "是这样吗——？",
            "narrator_zh": "雏"
        },
        {
            "location": "184/TALK",
            "narrator": "ガブリエラ",
            "text": "そうに決まってる\nでしょ。",
            "zh": "那是当然。\n对吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "186/TALK",
            "narrator": "ガブリエラ",
            "text": "まあ、実際に恋を経験\nしたことのない\nひなこ達には――",
            "zh": "嘛，没真正谈过\n恋爱的\n雏子你们——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "188/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょっと難しかった\nかもしれないわね。",
            "zh": "也许有点\n难呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "190/TALK",
            "narrator": "雛",
            "text": "うっわ、凄い勝ち誇った\n顔してる！",
            "zh": "哇，一脸\n得意洋洋！",
            "narrator_zh": "雏"
        },
        {
            "location": "192/TALK",
            "narrator": "繭",
            "text": "あれが落雷にでも\n打たれた顔？",
            "zh": "那就是被雷\n劈中的脸？",
            "narrator_zh": "茧"
        },
        {
            "location": "194/TALK",
            "narrator": "ガブリエラ",
            "text": "違うわよ！",
            "zh": "才不是啦！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "195/ACT",
            "narrator": "",
            "text": "気が付いたら感染しています",
            "zh": "不知不觉就被感染了",
            "narrator_zh": ""
        },
        {
            "location": "196/TALK",
            "narrator": "ガブリエラ",
            "text": "そうなのよね～",
            "zh": "是这样呢～",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "197/TALK",
            "narrator": "ガブリエラ",
            "text": "あんたわかってるじゃない",
            "zh": "你倒是明白",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "208/TALK",
            "narrator": "ガブリエラ",
            "text": "…その心は！\n気が付いたら感染して\nいます。",
            "zh": "……其心为何！\n回过神来已经\n感染了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "209/TALK",
            "narrator": "繭",
            "text": "さっき話してたこと\nまんまじゃない？",
            "zh": "不就是刚才\n说过的吗？",
            "narrator_zh": "茧"
        },
        {
            "location": "211/TALK",
            "narrator": "ガブリエラ",
            "text": "その通りなんだから\n仕方ないでしょ。",
            "zh": "因为确实如此，\n也没办法吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "213/TALK",
            "narrator": "ガブリエラ",
            "text": "まあ、恋のきっかけ\nなんていうのは――",
            "zh": "嘛，恋爱的契机\n什么的——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "214/TALK",
            "narrator": "ガブリエラ",
            "text": "結局そんなものなんじゃ\nないかしら？",
            "zh": "归根结底不就是\n那种东西吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "215/TALK",
            "narrator": "雛",
            "text": "なるほどねー。",
            "zh": "原来如此——",
            "narrator_zh": "雏"
        },
        {
            "location": "216/TALK",
            "narrator": "雛",
            "text": "つまり外に見える\nカップル達は――",
            "zh": "也就是说，外面看到的\n那些情侣们——",
            "narrator_zh": "雏"
        },
        {
            "location": "217/TALK",
            "narrator": "雛",
            "text": "恋ウイルスに感染して、\nそれが発症した患者、\nってわけだね。",
            "zh": "感染了恋爱病毒，\n然后发病的患者，\n就是这么回事吧。",
            "narrator_zh": "雏"
        },
        {
            "location": "218/TALK",
            "narrator": "繭",
            "text": "ウイルス対策を怠る、\n自己管理の出来ていない\n人間たち。",
            "zh": "怠慢病毒对策、\n自我管理做不到的\n人们。",
            "narrator_zh": "茧"
        },
        {
            "location": "219/TALK",
            "narrator": "雛",
            "text": "予防接種受けなかったん\nだろうねー。\nダメダメじゃん。",
            "zh": "大概是没打\n预防针吧。\n不行不行。",
            "narrator_zh": "雏"
        },
        {
            "location": "220/TALK",
            "narrator": "ガブリエラ",
            "text": "例え話なんだから、\n本当にウイルスみたいな\n言い方しないでよ。",
            "zh": "只是比喻，\n别真的说得\n像病毒一样。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "222/TALK",
            "narrator": "ガブリエラ",
            "text": "っていうか、あんた達と\n恋バナするの、すっごい\n疲れるんだけど？",
            "zh": "话说，跟你们聊\n恋爱话题，真的\n超累的？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "223/TALK",
            "narrator": "雛",
            "text": "子供のガブリエラちゃん\nには、まだ恋バナは\n早かったかな？",
            "zh": "对小孩子加布里埃拉，\n恋爱话题\n还太早了吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "224/TALK",
            "narrator": "ガブリエラ",
            "text": "どう考えても、あたしが\n一番恋について\nわかってるわよ！",
            "zh": "怎么想都是我最懂\n恋爱\n吧！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "16/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>某月某日　4:45 PM</color>\nとある平日の放課後、高等部の教室にて",
            "zh": "<color=green>某月某日　4:45 PM</color>\n某个平日放学后，在高中部的教室",
            "narrator_zh": "Dialog_EventData"
        }
    ]
}
