  "title": "らぶとーく 第79話",
  "sub_title": "おとぎ話の幕切れは"
 },
 "entry": [
  {
   "location": "27/TALK",
   "narrator": "エリカ",
   "text": "コーンコン。\nエリカです。",
   "zh": "咚咚。\n我是领火。",
   "narrator_zh": "领火"
  },
  {
   "location": "28/SEL",
   "narrator": "",
   "text": "ビックリした！",
   "zh": "吓我一跳！",
   "narrator_zh": ""
  },
  {
   "location": "29/ACT",
   "narrator": "",
   "text": "ビックリした！",
   "zh": "吓我一跳！",
   "narrator_zh": ""
  },
  {
   "location": "31/TALK",
   "narrator": "エリカ",
   "text": "ああっ、ごめんね？\n急に出てきちゃって。",
   "zh": "啊，抱歉哦？\n突然就冒出来了。",
   "narrator_zh": "领火"
  },
  {
   "location": "33/TALK",
   "narrator": "エリカ",
   "text": "今回あなたとつばめちゃんに\nとって、とても重要な局面を\n迎えるでしょう？",
   "zh": "这次对你和燕来说，\n会迎来非常\n重要的局面吧？",
   "narrator_zh": "领火"
  },
  {
   "location": "35/TALK",
   "narrator": "エリカ",
   "text": "今回あなたと綾ちゃんに\nとって、とても重要な局面を\n迎えるでしょう？",
   "zh": "这次对你和绫来说，\n会迎来非常\n重要的局面吧？",
   "narrator_zh": "领火"
  },
  {
   "location": "37/TALK",
   "narrator": "エリカ",
   "text": "今回あなたとガブリエラ\nちゃんにとって、とても\n重要な局面を迎えるでしょ？",
   "zh": "这次对你和加布里埃拉\n来说，会迎来非常\n重要的局面吧？",
   "narrator_zh": "领火"
  },
  {
   "location": "39/TALK",
   "narrator": "エリカ",
   "text": "今回あなたとみやびちゃんに\nとって、とても重要な局面を\n迎えるでしょう？",
   "zh": "这次对你和雅来说，\n会迎来非常\n重要的局面吧？",
   "narrator_zh": "领火"
  },
  {
   "location": "41/TALK",
   "narrator": "エリカ",
   "text": "だから、ギリギリで\nちょっと心許なくは\nあるんだけど――",
   "zh": "所以，虽然是赶在最后关头，\n还是有点让人\n不放心——",
   "narrator_zh": "领火"
  },
  {
   "location": "42/TALK",
   "narrator": "エリカ",
   "text": "わたしからひとつ、\nふたりにプレゼントが\nあるの！",
   "zh": "我有个礼物，\n要送给你们\n两个人！",
   "narrator_zh": "领火"
  },
  {
   "location": "43/SEL",
   "narrator": "",
   "text": "ありがとう！！　なんだろう？",
   "zh": "谢谢！！　是什么呢？",
   "narrator_zh": ""
  },
  {
   "location": "44/SEL",
   "narrator": "",
   "text": "もしかしてニャボッ……",
   "zh": "难道是喵Bot……",
   "narrator_zh": ""
  },
  {
   "location": "45/ACT",
   "narrator": "",
   "text": "ありがとう！！　なんだろう？",
   "zh": "谢谢！！　是什么呢？",
   "narrator_zh": ""
  },
  {
   "location": "46/TALK",
   "narrator": "エリカ",
   "text": "えへへ。\n喜んでもらえると\nいいんだけど。",
   "zh": "嘿嘿。\n要是你能喜欢\n就好了。",
   "narrator_zh": "领火"
  },
  {
   "location": "47/TALK",
   "narrator": "エリカ",
   "text": "それじゃ、\nプレゼントしまーす！",
   "zh": "那么，\n礼物来啦！",
   "narrator_zh": "领火"
  },
  {
   "location": "48/ACT",
   "narrator": "",
   "text": "もしかしてニャボッ……",
   "zh": "难道是喵Bot……",
   "narrator_zh": ""
  },
  {
   "location": "49/TALK",
   "narrator": "エリカ",
   "text": "ちがうよぉ……。\nあれはまだ未完成だもん。",
   "zh": "不对啦……。\n那个还没做完嘛。",
   "narrator_zh": "领火"
  },
  {
   "location": "50/TALK",
   "narrator": "エリカ",
   "text": "でも、興味あるようなら、\n完成したらあなたにも\n教えるね！",
   "zh": "不过，你要是感兴趣，\n等做完了我也\n会告诉你的！",
   "narrator_zh": "领火"
  },
  {
   "location": "51/TALK",
   "narrator": "エリカ",
   "text": "それでね、\n今回のわたしからの\nプレゼントというのは――",
   "zh": "所以说呢，\n这次我准备的\n礼物是——",
   "narrator_zh": "领火"
  },
  {
   "location": "52/TALK",
   "narrator": "エリカ",
   "text": "じゃーん！\nこれでーす！",
   "zh": "锵！\n就是这个！",
   "narrator_zh": "领火"
  },
  {
   "location": "56/SEL",
   "narrator": "",
   "text": "直接お話できるってこと！？",
   "zh": "也就是说能直接说话！？",
   "narrator_zh": ""
  },
  {
   "location": "57/ACT",
   "narrator": "",
   "text": "直接お話できるってこと！？",
   "zh": "也就是说能直接说话！？",
   "narrator_zh": ""
  },
  {
   "location": "59/TALK",
   "narrator": "エリカ",
   "text": "その通りだよ！",
   "zh": "说得对！",
   "narrator_zh": "领火"
  },
  {
   "location": "60/TALK",
   "narrator": "エリカ",
   "text": "でも、ちょっと\nプログラムが間に合わなくて\n完全なものじゃないんだ。",
   "zh": "不过，程序有点\n赶不上，所以还\n不算完成品。",
   "narrator_zh": "领火"
  },
  {
   "location": "61/TALK",
   "narrator": "エリカ",
   "text": "だから、今回は\nこの先３回だけの限定\n利用にさせて欲しいの。",
   "zh": "所以，这次希望\n能限定使用\n接下来的3次。",
   "narrator_zh": "领火"
  },
  {
   "location": "62/TALK",
   "narrator": "エリカ",
   "text": "けど、今のわたしたちの\nように、ちゃんと向かい\n合ってお話できるから！",
   "zh": "但是，像现在的我们\n这样，也能好好面对面\n说话啦！",
   "narrator_zh": "领火"
  },
  {
   "location": "64/TALK",
   "narrator": "エリカ",
   "text": "だから、頑張って\nつばめちゃんと素敵な\n思い出を作ってきてね！",
   "zh": "所以，加油跟\n燕一起创造\n美好的回忆吧！",
   "narrator_zh": "领火"
  },
  {
   "location": "65/TALK",
   "narrator": "エリカ",
   "text": "あなたと\nつばめちゃんに\n素敵なココロの旅を！",
   "zh": "祝你和\n燕\n有一段美好的心之旅！",
   "narrator_zh": "领火"
  },
  {
   "location": "67/TALK",
   "narrator": "エリカ",
   "text": "だから、頑張って\n綾ちゃんと素敵な\n思い出を作ってきてね！",
   "zh": "所以，加油跟\n绫一起创造\n美好的回忆吧！",
   "narrator_zh": "领火"
  },
  {
   "location": "68/TALK",
   "narrator": "エリカ",
   "text": "あなたと\n綾ちゃんに\n素敵なココロの旅を！",
   "zh": "祝你和\n绫\n有一段美好的心之旅！",
   "narrator_zh": "领火"
  },
  {
   "location": "70/TALK",
   "narrator": "エリカ",
   "text": "だから、頑張って\nガブリエラちゃんと素敵な\n思い出を作ってきてね！",
   "zh": "所以，加油跟\n加布里埃拉一起创造\n美好的回忆吧！",
   "narrator_zh": "领火"
  },
  {
   "location": "71/TALK",
   "narrator": "エリカ",
   "text": "あなたと\nガブリエラちゃんに\n素敵なココロの旅を！",
   "zh": "祝你和\n加布里埃拉\n有一段美好的心之旅！",
   "narrator_zh": "领火"
  },
  {
   "location": "73/TALK",
   "narrator": "エリカ",
   "text": "だから、頑張って\nみやびちゃんと素敵な\n思い出を作ってきてね！",
   "zh": "所以，加油跟\n雅一起创造\n美好的回忆吧！",
   "narrator_zh": "领火"
  },
  {
   "location": "74/TALK",
   "narrator": "エリカ",
   "text": "あなたと\nみやびちゃんに\n素敵なココロの旅を！",
   "zh": "祝你和\n雅\n有一段美好的心之旅！",
   "narrator_zh": "领火"
  },
  {
   "location": "105/TALK",
   "narrator": "ガブリエラ",
   "text": "ねえ$handle$。",
   "zh": "喂$handle$。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "106/TALK",
   "narrator": "ガブリエラ",
   "text": "あたし不満に\n思っている\nことがあるのよ。"
  },
  {
   "location": "107/SEL",
   "narrator": "",
   "text": "$me$はガブリエラに\n不満なんてないよ",
   "zh": "$me$对加布里埃拉\n没有半点不满哦",
   "narrator_zh": ""
  },
  {
   "location": "108/SEL",
   "narrator": "",
   "text": "お腹が空いてるの？",
   "zh": "你饿了吗？",
   "narrator_zh": ""
  },
  {
   "location": "109/SEL",
   "narrator": "",
   "text": "眠くなっちゃったかな？",
   "zh": "是不是困了？",
   "narrator_zh": ""
  },
  {
   "location": "110/SEL",
   "narrator": "",
   "text": "$me$何かした？",
   "zh": "$me$做了什么吗？",
   "narrator_zh": ""
  },
  {
   "location": "111/SEL",
   "narrator": "",
   "text": "不満の根源は\n駆逐しよう",
   "zh": "不满的根源\n就赶走吧",
   "narrator_zh": ""
  },
  {
   "location": "112/ACT",
   "narrator": "",
   "text": "$me$はガブリエラに\n不満なんてないよ",
   "zh": "$me$对加布里埃拉\n没有半点不满哦",
   "narrator_zh": ""
  },
  {
   "location": "113/TALK",
   "narrator": "ガブリエラ",
   "text": "えっ！？\n本当に？",
   "zh": "诶！？\n真的吗？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "114/TALK",
   "narrator": "ガブリエラ",
   "text": "って、そんな話じゃ\nないのよ。",
   "zh": "啊，不是说\n那个。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "115/ACT",
   "narrator": "",
   "text": "お腹が空いてるの？",
   "zh": "你饿了吗？",
   "narrator_zh": ""
  },
  {
   "location": "116/TALK",
   "narrator": "ガブリエラ",
   "text": "なんでそうなるの！？",
   "zh": "为什么会那样！？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "117/TALK",
   "narrator": "ガブリエラ",
   "text": "違うから！",
   "zh": "当然不是！",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "118/ACT",
   "narrator": "",
   "text": "眠くなっちゃったかな？",
   "zh": "是不是困了？",
   "narrator_zh": ""
  },
  {
   "location": "119/TALK",
   "narrator": "ガブリエラ",
   "text": "すぐにあたしを\n子供扱い\nするんだから！"
  },
  {
   "location": "120/TALK",
   "narrator": "ガブリエラ",
   "text": "あたしはもう\n中学生なの！"
  },
  {
   "location": "121/ACT",
   "narrator": "",
   "text": "$me$何かした？",
   "zh": "$me$做了什么吗？",
   "narrator_zh": ""
  },
  {
   "location": "122/TALK",
   "narrator": "ガブリエラ",
   "text": "……えっと…\nまあそうなんだ\nけど……。"
  },
  {
   "location": "123/ACT",
   "narrator": "",
   "text": "不満の根源は\n駆逐しよう",
   "zh": "不满的根源\n就赶走吧",
   "narrator_zh": ""
  },
  {
   "location": "124/TALK",
   "narrator": "ガブリエラ",
   "text": "そんなこと\nしなくていいわよ！？",
   "zh": "那种事\n不用做哦！？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "125/TALK",
   "narrator": "ガブリエラ",
   "text": "あたしが寂しく\nなっちゃうし……。"
  },
  {
   "location": "127/TALK",
   "narrator": "ガブリエラ",
   "text": "えっとね、その…。"
  },
  {
   "location": "128/TALK",
   "narrator": "ガブリエラ",
   "text": "この前王子様に\nなってくれたでしょ？",
   "zh": "上次你不是当了我\n的王子吗？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "129/SEL",
   "narrator": "",
   "text": "キスしたってこと？",
   "zh": "也就说亲过了？",
   "narrator_zh": ""
  },
  {
   "location": "130/SEL",
   "narrator": "",
   "text": "本当は$me$も姫だけど",
   "zh": "其实$me$也是公主",
   "narrator_zh": ""
  },
  {
   "location": "131/SEL",
   "narrator": "",
   "text": "眠り足りないのかな\nお姫様は",
   "zh": "公主殿下\n是没睡够吧",
   "narrator_zh": ""
  },
  {
   "location": "132/SEL",
   "narrator": "",
   "text": "またしよう！",
   "zh": "下次再来！",
   "narrator_zh": ""
  },
  {
   "location": "133/ACT",
   "narrator": "",
   "text": "キスしたってこと？",
   "zh": "也就说亲过了？",
   "narrator_zh": ""
  },
  {
   "location": "135/TALK",
   "narrator": "ガブリエラ",
   "text": "！？！？！？！？"
  },
  {
   "location": "136/TALK",
   "narrator": "ガブリエラ",
   "text": "…そうだけど……。"
  },
  {
   "location": "137/ACT",
   "narrator": "",
   "text": "本当は$me$も姫だけど",
   "zh": "其实$me$也是公主",
   "narrator_zh": ""
  },
  {
   "location": "138/TALK",
   "narrator": "ガブリエラ",
   "text": "そうだったわね…。",
   "zh": "是这样呢……。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "139/TALK",
   "narrator": "ガブリエラ",
   "text": "そういえば…。",
   "zh": "说起来……。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "140/ACT",
   "narrator": "",
   "text": "眠り足りないのかな\nお姫様は",
   "zh": "公主殿下\n是没睡够吧",
   "narrator_zh": ""
  },
  {
   "location": "141/TALK",
   "narrator": "ガブリエラ",
   "text": "違うわよ。",
   "zh": "不是的哦。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "142/TALK",
   "narrator": "ガブリエラ",
   "text": "でもそういうこと\nなのかしら……。",
   "zh": "不过，是那么回事吗……。\n",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "143/ACT",
   "narrator": "",
   "text": "またしよう！",
   "zh": "下次再来！",
   "narrator_zh": ""
  },
  {
   "location": "145/TALK",
   "narrator": "ガブリエラ",
   "text": "えっえっ！？",
   "zh": "诶诶！？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "146/TALK",
   "narrator": "ガブリエラ",
   "text": "もうちょっと\nロマンチックに\n言ってちょうだい！"
  },
  {
   "location": "148/TALK",
   "narrator": "ガブリエラ",
   "text": "それでその時は\n納得したけど。",
   "zh": "那样当时\n我是接受了，可是。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "149/TALK",
   "narrator": "ガブリエラ",
   "text": "誓いを立てたとは\n言い辛いんじゃ\nないかしら。"
  },
  {
   "location": "150/SEL",
   "narrator": "",
   "text": "そうなのかな…？",
   "zh": "是这样吗…？",
   "narrator_zh": ""
  },
  {
   "location": "151/SEL",
   "narrator": "",
   "text": "もっとキスしたいんだね",
   "zh": "你还想多亲几下呢",
   "narrator_zh": ""
  },
  {
   "location": "152/SEL",
   "narrator": "",
   "text": "$me$のこと\n信じられない？",
   "zh": "你不信\n$me$吗？",
   "narrator_zh": ""
  },
  {
   "location": "153/ACT",
   "narrator": "",
   "text": "そうなのかな…？",
   "zh": "是这样吗…？",
   "narrator_zh": ""
  },
  {
   "location": "154/TALK",
   "narrator": "ガブリエラ",
   "text": "違うかしら？",
   "zh": "不对吗？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "155/ACT",
   "narrator": "",
   "text": "もっとキスしたいんだね",
   "zh": "你还想多亲几下呢",
   "narrator_zh": ""
  },
  {
   "location": "156/TALK",
   "narrator": "ガブリエラ",
   "text": "そっ！？",
   "zh": "就、就这！？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "157/TALK",
   "narrator": "ガブリエラ",
   "text": "…そうなんだけど\nそうじゃなくて…。"
  },
  {
   "location": "158/ACT",
   "narrator": "",
   "text": "$me$のこと\n信じられない？",
   "zh": "你不信\n$me$吗？",
   "narrator_zh": ""
  },
  {
   "location": "159/TALK",
   "narrator": "ガブリエラ",
   "text": "そういうわけじゃ\nなくて…。",
   "zh": "也不是\n那么回事……。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "161/TALK",
   "narrator": "ガブリエラ",
   "text": "やっぱり神様の\n前で誓わないと\nいけないと思うの。"
  },
  {
   "location": "162/TALK",
   "narrator": "ガブリエラ",
   "text": "きちんと誓いを\nするべきだと\n思うの。",
   "zh": "我觉得应该\n好好立个\n誓约的。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "163/SEL",
   "narrator": "",
   "text": "そういうこと",
   "zh": "原来是这样",
   "narrator_zh": ""
  },
  {
   "location": "164/SEL",
   "narrator": "",
   "text": "ガブリエラが望むなら",
   "zh": "如果加布里埃拉希望的话",
   "narrator_zh": ""
  },
  {
   "location": "165/SEL",
   "narrator": "",
   "text": "信心深いんだね",
   "zh": "你还挺虔诚呢",
   "narrator_zh": ""
  },
  {
   "location": "166/ACT",
   "narrator": "",
   "text": "そういうこと",
   "zh": "原来是这样",
   "narrator_zh": ""
  },
  {
   "location": "167/TALK",
   "narrator": "ガブリエラ",
   "text": "大事なことよ。"
  },
  {
   "location": "168/ACT",
   "narrator": "",
   "text": "ガブリエラが望むなら",
   "zh": "如果加布里埃拉希望的话",
   "narrator_zh": ""
  },
  {
   "location": "169/TALK",
   "narrator": "ガブリエラ",
   "text": "あたし次第なのね。"
  },
  {
   "location": "170/ACT",
   "narrator": "",
   "text": "信心深いんだね",
   "zh": "你还挺虔诚呢",
   "narrator_zh": ""
  },
  {
   "location": "171/TALK",
   "narrator": "ガブリエラ",
   "text": "そんなことないわ。\n普通のことよ。",
   "zh": "没有那种事。\n很普通哦。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "173/TALK",
   "narrator": "ガブリエラ",
   "text": "教会できちんと\n誓いを立てて。"
  },
  {
   "location": "175/TALK",
   "narrator": "ガブリエラ",
   "text": "それから\nハネムーンも\n絶対よ。",
   "zh": "还有\n蜜月也\n一定要。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "176/SEL",
   "narrator": "",
   "text": "本格的だ",
   "zh": "真够正式的",
   "narrator_zh": ""
  },
  {
   "location": "177/SEL",
   "narrator": "",
   "text": "そこまで考えてくれてて\nうれしい"
  },
  {
   "location": "178/SEL",
   "narrator": "",
   "text": "本気で言ってる？",
   "zh": "你是认真的？",
   "narrator_zh": ""
  },
  {
   "location": "179/ACT",
   "narrator": "",
   "text": "本格的だ",
   "zh": "真够正式的",
   "narrator_zh": ""
  },
  {
   "location": "180/TALK",
   "narrator": "ガブリエラ",
   "text": "そうよ。\n当然でしょ。",
   "zh": "对啊。\n当然的吧。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "181/ACT",
   "narrator": "",
   "text": "そこまで考えてくれてて\nうれしい"
  },
  {
   "location": "182/TALK",
   "narrator": "ガブリエラ",
   "text": "…本当に…？",
   "zh": "…真的…？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "183/ACT",
   "narrator": "",
   "text": "本気で言ってる？",
   "zh": "你是认真的？",
   "narrator_zh": ""
  },
  {
   "location": "184/TALK",
   "narrator": "ガブリエラ",
   "text": "あたしは\n本気だけど…？"
  },
  {
   "location": "186/TALK",
   "narrator": "ガブリエラ",
   "text": "$handle$とは\nスマホからしか\n話せなかったけど。",
   "zh": "虽然跟$handle$\n只能从手机\n说话。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "188/TALK",
   "narrator": "ガブリエラ",
   "text": "…今もあんまり\n変わらないかもって\n思う時もあるけど。",
   "zh": "……虽然有时候也会想，\n现在大概也\n没怎么变吧。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "190/TALK",
   "narrator": "ガブリエラ",
   "text": "それでも大事なことには\n変わりないわ。",
   "zh": "不过那依然是\n重要的事。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "191/TALK",
   "narrator": "ガブリエラ",
   "text": "だからこそ\nちゃんとしたいの。",
   "zh": "正因为如此\n我想好好做。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "192/SEL",
   "narrator": "",
   "text": "だよね",
   "zh": "就是嘛",
   "narrator_zh": ""
  },
  {
   "location": "193/SEL",
   "narrator": "",
   "text": "わかる",
   "zh": "我懂",
   "narrator_zh": ""
  },
  {
   "location": "194/SEL",
   "narrator": "",
   "text": "そっか",
   "zh": "这样啊",
   "narrator_zh": ""
  },
  {
   "location": "195/ACT",
   "narrator": "",
   "text": "だよね",
   "zh": "就是嘛",
   "narrator_zh": ""
  },
  {
   "location": "197/TALK",
   "narrator": "ガブリエラ",
   "text": "そうでしょう？",
   "zh": "对吧？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "198/ACT",
   "narrator": "",
   "text": "わかる",
   "zh": "我懂",
   "narrator_zh": ""
  },
  {
   "location": "200/TALK",
   "narrator": "ガブリエラ",
   "text": "そうよね。",
   "zh": "是啊。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "201/ACT",
   "narrator": "",
   "text": "そっか",
   "zh": "这样啊",
   "narrator_zh": ""
  },
  {
   "location": "202/TALK",
   "narrator": "ガブリエラ",
   "text": "…違うのかしら？",
   "zh": "……不是吗？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "204/TALK",
   "narrator": "ガブリエラ",
   "text": "あたしだって\n知ってるのよ。"
  },
  {
   "location": "205/TALK",
   "narrator": "ガブリエラ",
   "text": "$handle$と\nあたしが結婚したって\n言い張っても。",
   "zh": "就算我坚持说\n我跟$handle$\n结婚了。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "206/TALK",
   "narrator": "ガブリエラ",
   "text": "そのことを\nわかってもらえる\n可能性が低いことは。",
   "zh": "就是很难让人\n理解这件事\n这一点。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "207/TALK",
   "narrator": "ガブリエラ",
   "text": "それでもあたしと\n$handle$とは\n絆で結ばれてる。",
   "zh": "不过我和\n$handle$还是\n被羁绊连在一起的。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "208/TALK",
   "narrator": "ガブリエラ",
   "text": "そう思っちゃ\nいけない？",
   "zh": "这么想\n不行吗？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "209/SEL",
   "narrator": "",
   "text": "ダメじゃないよ",
   "zh": "又没说不行",
   "narrator_zh": ""
  },
  {
   "location": "210/SEL",
   "narrator": "",
   "text": "そうだと思ってた",
   "zh": "我就觉得是这样",
   "narrator_zh": ""
  },
  {
   "location": "211/SEL",
   "narrator": "",
   "text": "あえて言う必要もないよ",
   "zh": "也没必要特意说",
   "narrator_zh": ""
  },
  {
   "location": "212/ACT",
   "narrator": "",
   "text": "ダメじゃないよ",
   "zh": "又没说不行",
   "narrator_zh": ""
  },
  {
   "location": "213/TALK",
   "narrator": "ガブリエラ",
   "text": "本当に？",
   "zh": "真的吗？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "214/ACT",
   "narrator": "",
   "text": "そうだと思ってた",
   "zh": "我就觉得是这样",
   "narrator_zh": ""
  },
  {
   "location": "215/TALK",
   "narrator": "ガブリエラ",
   "text": "そうよね…。"
  },
  {
   "location": "216/ACT",
   "narrator": "",
   "text": "あえて言う必要もないよ",
   "zh": "也没必要特意说",
   "narrator_zh": ""
  },
  {
   "location": "217/TALK",
   "narrator": "ガブリエラ",
   "text": "うん。",
   "zh": "嗯。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "219/SEL",
   "narrator": "",
   "text": "ねえガブリエラ",
   "zh": "喂，加布里埃拉",
   "narrator_zh": ""
  },
  {
   "location": "220/ACT",
   "narrator": "",
   "text": "ねえガブリエラ",
   "zh": "喂，加布里埃拉",
   "narrator_zh": ""
  },
  {
   "location": "222/TALK",
   "narrator": "ガブリエラ",
   "text": "何かしら",
   "zh": "到底是什么呀",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "223/SEL",
   "narrator": "",
   "text": "結婚しよう",
   "zh": "我们结婚吧",
   "narrator_zh": ""
  },
  {
   "location": "224/SEL",
   "narrator": "",
   "text": "一生を捧げるよ",
   "zh": "我把一生都奉献给你",
   "narrator_zh": ""
  },
  {
   "location": "225/SEL",
   "narrator": "",
   "text": "出会えた奇跡に感謝する",
   "zh": "感谢能相遇的奇迹",
   "narrator_zh": ""
  },
  {
   "location": "226/ACT",
   "narrator": "",
   "text": "結婚しよう",
   "zh": "我们结婚吧",
   "narrator_zh": ""
  },
  {
   "location": "228/TALK",
   "narrator": "ガブリエラ",
   "text": "…はい。",
   "zh": "……是的。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "229/ACT",
   "narrator": "",
   "text": "一生を捧げるよ",
   "zh": "我把一生都奉献给你",
   "narrator_zh": ""
  },
  {
   "location": "232/TALK",
   "narrator": "ガブリエラ",
   "text": "…あたしもよ、\n$handle$。"
  },
  {
   "location": "233/ACT",
   "narrator": "",
   "text": "出会えた奇跡に感謝する",
   "zh": "感谢能相遇的奇迹",
   "narrator_zh": ""
  },
  {
   "location": "235/TALK",
   "narrator": "ガブリエラ",
   "text": "奇跡…。"
  },
  {
   "location": "236/TALK",
   "narrator": "ガブリエラ",
   "text": "そうね、奇跡だわ。",
   "zh": "是啊，真是奇迹。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "239/TALK",
   "narrator": "ガブリエラ",
   "text": "幸せになりましょうね\nあたしたち。"
  },
