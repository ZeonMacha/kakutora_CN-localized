        },
        {
            "location": "4328/SEL",
            "narrator": "",
            "text": "神楽がＰＲＧの主人公だったとは",
            "zh": "没想到神乐是PRG的主人公",
            "narrator_zh": ""
        },
        {
            "location": "4329/SEL",
            "narrator": "",
            "text": "ゲームのしすぎ",
            "zh": "游戏玩太多了",
            "narrator_zh": ""
        },
        {
            "location": "4330/SEL",
            "narrator": "",
            "text": "$me$もリセットされちゃうの？",
            "zh": "$me$也会被重置吗？",
            "narrator_zh": ""
        },
        {
            "location": "4331/ACT",
            "narrator": "",
            "text": "神楽がＰＲＧの主人公だったとは",
            "zh": "没想到神乐是PRG的主人公",
            "narrator_zh": ""
        },
        {
            "location": "4332/TALK",
            "narrator": "神楽",
            "text": "知らなかった？",
            "zh": "你不知道？",
            "narrator_zh": "神乐"
        },
        {
            "location": "4333/ACT",
            "narrator": "",
            "text": "ゲームのしすぎ",
            "zh": "游戏玩太多了",
            "narrator_zh": ""
        },
        {
            "location": "4334/TALK",
            "narrator": "神楽",
            "text": "違いますー",
            "zh": "不是的——",
            "narrator_zh": "神乐"
        },
        {
            "location": "4336/TALK",
            "narrator": "神楽",
            "text": "ラノベ読んだりアニメ見たりアニソン聞いたりもしてますー！",
            "zh": "轻小说也读，动画也看，动画歌也听——！",
            "narrator_zh": "神乐"
        },
        {
            "location": "4337/ACT",
            "narrator": "",
            "text": "$me$もリセットされちゃうの？",
            "zh": "$me$也会被重置吗？",
            "narrator_zh": ""
        },
        {
            "location": "4339/TALK",
            "narrator": "神楽",
            "text": "そうなるとぴょんことの愛のメモリーもリセットされちゃうね☆彡",
            "zh": "那样的话，和蹦子的爱的记忆也会被重置呢☆彡",
            "narrator_zh": "神乐"
        },
        {
            "location": "4340/TALK",
            "narrator": "神楽",
            "text": "それはぴょんことしては少し不本意",
            "zh": "这点蹦子有点不愿意",
            "narrator_zh": "神乐"
        },
        {
            "location": "4341/TALK",
            "narrator": "神楽",
            "text": "うーんやっぱりやめとこうかな",
            "zh": "嗯——果然还是算了吧",
            "narrator_zh": "神乐"
        },
        {
            "location": "4343/TALK",
            "narrator": "神楽",
            "text": "実際二周目の方が断然面白いＲＰＧとかあるけど",
            "zh": "实际上二周目绝对更好玩的RPG也是有的",
            "narrator_zh": "神乐"
        },
        {
            "location": "4345/TALK",
            "narrator": "神楽",
            "text": "あれはある程度その世界が理解できててなおかつシステム制限解禁とか隠しシナリオとか新しい要素があるから楽しいわけで",
            "zh": "那是因为对那个世界有一定理解，而且系统限制解除、隐藏剧情之类有新要素，所以才好玩",
            "narrator_zh": "神乐"
        },
        {
            "location": "4346/TALK",
            "narrator": "神楽",
            "text": "全く同じルートだったら周回する意味ないんだよねこれがまた",
            "zh": "完全相同的路线，再周回就没有意义了，这又是",
            "narrator_zh": "神乐"
