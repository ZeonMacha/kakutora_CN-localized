{
 "dir": "dramatics/daydra/drm_ch01_00_520.js",
 "type": "Episode",
 "info": {
  "story_id": "1052",
  "cid": "tsubame",
  "title": "らぶとーく 第52話",
  "sub_title": "全部が大事"
 },
 "entry": [
  {
   "location": "7/SCENARIO",
   "narrator": "",
   "text": "全部が大事"
  },
  {
   "location": "20/TALK",
   "narrator": "ガブリエラ",
   "text": "…で、どうするわけ？"
  },
  {
   "location": "22/TALK",
   "narrator": "みやび",
   "text": "どうする、っちゅうと？",
   "zh": "你说怎么办嘛？",
   "narrator_zh": "雅"
  },
  {
   "location": "23/TALK",
   "narrator": "ガブリエラ",
   "text": "これからのことよ。",
   "zh": "是今后的事哦。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "24/TALK",
   "narrator": "ガブリエラ",
   "text": "情報管理庁は信用\nできそうにないし――"
  },
  {
   "location": "26/TALK",
   "narrator": "ガブリエラ",
   "text": "神楽は裏切り者だし――"
  },
  {
   "location": "27/TALK",
   "narrator": "ガブリエラ",
   "text": "メチャクチャじゃない。\nいったい何がどうなってる\nのよ？"
  },
  {
   "location": "30/TALK",
   "narrator": "アーヤ",
   "text": "それを話し合うために\n集まってもらったの。",
   "zh": "就是为了商量那个\n才把大家叫来的。",
   "narrator_zh": "绫水"
  },
  {
   "location": "31/TALK",
   "narrator": "アーヤ",
   "text": "館長も怒ってたけど、\n私も情報管理庁に\n対して――"
  },
  {
   "location": "32/TALK",
   "narrator": "アーヤ",
   "text": "かなり怒りを感じてるし、\n信用もできなくなって\nきたし…。",
   "zh": "我感觉到了相当的愤怒，\n而且也越来越\n没法信任了……。",
   "narrator_zh": "绫水"
  },
  {
   "location": "35/TALK",
   "narrator": "みやび",
   "text": "同感やね。"
  },
  {
   "location": "36/TALK",
   "narrator": "みやび",
   "text": "ちゅうか、今までも\nなんか胡散臭い感じが\nしちょったき――",
   "zh": "就是说，其实一直以来\n我总觉得有点\n可疑咯——",
   "narrator_zh": "雅"
  },
  {
   "location": "38/TALK",
   "narrator": "みやび",
   "text": "ようやく本性現して\n来よったか、っちゅう\n気持ちやけんどね。"
  },
  {
   "location": "39/TALK",
   "narrator": "ガブリエラ",
   "text": "…情報管理庁は、\nあたし達の味方だと\n思ってたのに…。",
   "zh": "……我还以为情报管理厅\n是站在\n我们这边的呢……。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "42/TALK",
   "narrator": "みやび",
   "text": "まほさん以外の大人は、\n信用せん方がえいな。"
  },
  {
   "location": "44/TALK",
   "narrator": "つばめ",
   "text": "…で、でも！",
   "zh": "…可、可是！",
   "narrator_zh": "燕"
  },
  {
   "location": "45/TALK",
   "narrator": "つばめ",
   "text": "まだその、神楽ちゃんは\nわたし達を裏切ったって\n証拠はどこにも…。"
  },
  {
   "location": "47/TALK",
   "narrator": "ガブリエラ",
   "text": "…あんた、いい加減に\nしなさいよ。"
  },
  {
   "location": "48/TALK",
   "narrator": "ガブリエラ",
   "text": "つばめが卯月のことを\n大切に思っているのは\nわかるけど――",
   "zh": "我知道燕很珍视\n卯月，\n不过——",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "49/TALK",
   "narrator": "ガブリエラ",
   "text": "今は現実を見なさいよ！\nあいつはあんたを\n殺そうとして――"
  },
  {
   "location": "50/TALK",
   "narrator": "ガブリエラ",
   "text": "しかも、管理庁のヘリで\nどっか行っちゃったのよ？"
  },
  {
   "location": "52/TALK",
   "narrator": "つばめ",
   "text": "で、でも…。",
   "zh": "可、可是……。",
   "narrator_zh": "燕"
  },
  {
   "location": "53/TALK",
   "narrator": "ガブリエラ",
   "text": "うるさい！",
   "zh": "吵死了！",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "54/TALK",
   "narrator": "ガブリエラ",
   "text": "これ以上卯月を庇うような\nこと言うつもりなら、\n黙ってて！！",
   "zh": "如果你打算再说\n护着卯月的话，\n那就闭嘴！！",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "56/TALK",
   "narrator": "ガブリエラ",
   "text": "話が進まないわ。"
  },
  {
   "location": "58/TALK",
   "narrator": "つばめ",
   "text": "…………。"
  },
  {
   "location": "59/TALK",
   "narrator": "アーヤ",
   "text": "…まあ、とにかく――",
   "zh": "……嘛，总之——",
   "narrator_zh": "绫水"
  },
  {
   "location": "60/TALK",
   "narrator": "アーヤ",
   "text": "これからどうするかに\nついてだけど――",
   "zh": "关于接下来要\n怎么办——",
   "narrator_zh": "绫水"
  },
  {
   "location": "73/TALK",
   "narrator": "つばめ",
   "text": "$handle$さん、聞ぃて|д･´)",
   "zh": "$handle$，听我说|д･´)",
   "narrator_zh": "燕"
  },
  {
   "location": "74/TALK",
   "narrator": "つばめ",
   "text": "わたしね",
   "zh": "我呀",
   "narrator_zh": "燕"
  },
  {
   "location": "75/TALK",
   "narrator": "つばめ",
   "text": "ガブちゃんからは怒られたけど(´つω・｀)ｼｭﾝ"
  },
  {
   "location": "76/TALK",
   "narrator": "つばめ",
   "text": "ちゃんと自分の考えを言ぉぅと思うの",
   "zh": "我想好好说出自己的想法",
   "narrator_zh": "燕"
  },
  {
   "location": "77/TALK",
   "narrator": "つばめ",
   "text": "そぅじゃなぃと",
   "zh": "不然的话",
   "narrator_zh": "燕"
  },
  {
   "location": "78/TALK",
   "narrator": "つばめ",
   "text": "絶対に後悔すると思ぅから"
  },
  {
   "location": "79/TALK",
   "narrator": "つばめ",
   "text": "間違ってなぃよね？(´･ω･｀) ",
   "zh": "这样没错吧？(´･ω･｀) ",
   "narrator_zh": "燕"
  },
  {
   "location": "82/SEL",
   "narrator": "",
   "text": "大丈夫だよ",
   "zh": "没关系哦",
   "narrator_zh": ""
  },
  {
   "location": "83/SEL",
   "narrator": "",
   "text": "ここで練習する？",
   "zh": "在这里练习吗？",
   "narrator_zh": ""
  },
  {
   "location": "84/SEL",
   "narrator": "",
   "text": "アドバイスが必要かな",
   "zh": "需要点建议吗",
   "narrator_zh": ""
  },
  {
   "location": "85/ACT",
   "narrator": "",
   "text": "大丈夫だよ",
   "zh": "没关系哦",
   "narrator_zh": ""
  },
  {
   "location": "86/TALK",
   "narrator": "つばめ",
   "text": "ぁりがと(*´ω｀*)",
   "zh": "谢谢(*´ω｀*)",
   "narrator_zh": "燕"
  },
  {
   "location": "87/TALK",
   "narrator": "つばめ",
   "text": "$handle$さんにそぅ言ってもらぇて",
   "zh": "被$handle$这么说",
   "narrator_zh": "燕"
  },
  {
   "location": "88/TALK",
   "narrator": "つばめ",
   "text": "勇気出てきた(≧ω≦)"
  },
  {
   "location": "89/TALK",
   "narrator": "つばめ",
   "text": "見ててね"
  },
  {
   "location": "100/ACT",
   "narrator": "",
   "text": "ここで練習する？",
   "zh": "在这里练习吗？",
   "narrator_zh": ""
  },
  {
   "location": "101/TALK",
   "narrator": "つばめ",
   "text": "ぅぅん",
   "zh": "唔唔",
   "narrator_zh": "燕"
  },
  {
   "location": "102/TALK",
   "narrator": "つばめ",
   "text": "もぅ平気(*´ω｀*)"
  },
  {
   "location": "103/TALK",
   "narrator": "つばめ",
   "text": "$handle$さんに聞ぃてもらぇたから",
   "zh": "因为$handle$愿意听我说",
   "narrator_zh": "燕"
  },
  {
   "location": "104/TALK",
   "narrator": "つばめ",
   "text": "勇気出たよ！(๑･ㅂ･)و☆"
  },
  {
   "location": "115/ACT",
   "narrator": "",
   "text": "アドバイスが必要かな",
   "zh": "需要点建议吗",
   "narrator_zh": ""
  },
  {
   "location": "116/TALK",
   "narrator": "つばめ",
   "text": "大丈夫だよ(*´ω｀*)"
  },
  {
   "location": "117/TALK",
   "narrator": "つばめ",
   "text": "それはもぅもらったから",
   "zh": "那个我已经收到了",
   "narrator_zh": "燕"
  },
  {
   "location": "118/TALK",
   "narrator": "つばめ",
   "text": "見ててね(*´∀｀*)ｖ"
  },
  {
   "location": "131/TALK",
   "narrator": "アーヤ",
   "text": "やっぱり、卯月と管理庁は\n信用しない方向で――"
  },
  {
   "location": "133/TALK",
   "narrator": "つばめ",
   "text": "あ、あの！",
   "zh": "那、那个！",
   "narrator_zh": "燕"
  },
  {
   "location": "134/TALK",
   "narrator": "つばめ",
   "text": "やっぱりわたし…\n諦められません。"
  },
  {
   "location": "135/TALK",
   "narrator": "つばめ",
   "text": "神楽ちゃんも助けたいし、\nそれに…音羽さんのことも\n助けたい…。"
  },
  {
   "location": "137/TALK",
   "narrator": "ガブリエラ",
   "text": "はぁ…。",
   "zh": "哈啊……。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "139/TALK",
   "narrator": "アーヤ",
   "text": "…あのね、つばめ。\nあなたの言ってることは\nわからなくないけど…。"
  },
  {
   "location": "140/TALK",
   "narrator": "つばめ",
   "text": "わたし、\nみんな大切なんです！"
  },
  {
   "location": "141/TALK",
   "narrator": "つばめ",
   "text": "今が凄く大変な時だ、\nっていうのはわかります。"
  },
  {
   "location": "142/TALK",
   "narrator": "つばめ",
   "text": "けど、だからって大切な\nモノまで切り捨てるような\n選択は――",
   "zh": "可是，就算这样，也不该做出\n把重要的东西一刀切掉\n的选择——",
   "narrator_zh": "燕"
  },
  {
   "location": "143/TALK",
   "narrator": "つばめ",
   "text": "絶対にしたくなくて――"
  },
  {
   "location": "147/TALK",
   "narrator": "ガブリエラ",
   "text": "いい加減にして！！"
  },
  {
   "location": "152/TALK",
   "narrator": "ガブリエラ",
   "text": "さっきから聞いてれば、\nそれって全部綺麗事\n並べてるだけじゃない！"
  },
  {
   "location": "153/TALK",
   "narrator": "ガブリエラ",
   "text": "じゃあその大切な全部を\n助ける方法ってあるの？\n言ってみなさいよ。"
  },
  {
   "location": "154/TALK",
   "narrator": "つばめ",
   "text": "そ、それは…これから\nみんなで考えて――",
   "zh": "那、那个……以后\n大家一起想想——",
   "narrator_zh": "燕"
  },
  {
   "location": "156/TALK",
   "narrator": "ガブリエラ",
   "text": "何それ、他人任せ？"
  },
  {
   "location": "157/TALK",
   "narrator": "つばめ",
   "text": "そうじゃないよ！\nでも、わたし一人じゃ\nわからなくて…。",
   "zh": "不是那样哦！\n可是，我一个人\n搞不明白……。",
   "narrator_zh": "燕"
  },
  {
   "location": "159/TALK",
   "narrator": "みやび",
   "text": "…なあ、つばめちゃん。",
   "zh": "……我说，小燕。",
   "narrator_zh": "雅"
  },
  {
   "location": "160/TALK",
   "narrator": "みやび",
   "text": "うちはつばめちゃんの\nこと、結構好きぞね。"
  },
  {
   "location": "162/TALK",
   "narrator": "つばめ",
   "text": "…………。"
  },
  {
   "location": "164/TALK",
   "narrator": "みやび",
   "text": "けんど、今みたいな\nつばめちゃんは――",
   "zh": "不过，像现在这样的\n燕酱——",
   "narrator_zh": "雅"
  },
  {
   "location": "166/TALK",
   "narrator": "みやび",
   "text": "正直、そうは思えん。"
  },
  {
   "location": "167/TALK",
   "narrator": "みやび",
   "text": "理想を唱えて現実には\n目を向けん、厄介な\n理想主義者も同然や。"
  },
  {
   "location": "169/TALK",
   "narrator": "つばめ",
   "text": "そんな…。",
   "zh": "怎么会……。",
   "narrator_zh": "燕"
  },
  {
   "location": "170/TALK",
   "narrator": "アーヤ",
   "text": "…全部が大切、っていう\nつばめの気持ち…\n私は否定しないわ。",
   "zh": "……燕那份“全部都很重要”\n的心情……\n我不会否定。",
   "narrator_zh": "绫水"
  },
  {
   "location": "171/TALK",
   "narrator": "アーヤ",
   "text": "けど、今のつばめに、\nその大切なモノ全てを\n助ける力はある？",
   "zh": "可是，现在的燕，\n有力量把所有\n那些重要的东西都救下来吗？",
   "narrator_zh": "绫水"
  },
  {
   "location": "172/TALK",
   "narrator": "アーヤ",
   "text": "もし無いのだとしたら、\nそれはみやびの言う通り、\nただの理想よ。"
  },
  {
   "location": "173/TALK",
   "narrator": "アーヤ",
   "text": "理想のために現実を\n無視するようなこと、\n私たちにはできないわ。"
  },
  {
   "location": "174/TALK",
   "narrator": "つばめ",
   "text": "…………。"
  },
  {
   "location": "176/TALK",
   "narrator": "ガブリエラ",
   "text": "あたし達はつばめとは\n違って、現実を見てるの。"
  },
  {
   "location": "177/TALK",
   "narrator": "ガブリエラ",
   "text": "卯月はあんたを\n殺そうとした。"
  },
  {
   "location": "178/TALK",
   "narrator": "ガブリエラ",
   "text": "あたし達を裏切った。"
  },
  {
   "location": "179/TALK",
   "narrator": "ガブリエラ",
   "text": "管理庁も、あたし達に\n何かを隠している。"
  },
  {
   "location": "181/TALK",
   "narrator": "ガブリエラ",
   "text": "その現実が見えないなら、\nお願いだから黙って…。",
   "zh": "要是看不见那份现实，\n求你闭嘴……。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "183/TALK",
   "narrator": "つばめ",
   "text": "…………。"
  },
  {
   "location": "184/TALK",
   "narrator": "アーヤ",
   "text": "…じゃあ、続けるわ。\n今後の私達の方針と\nしては――"
  },
  {
   "location": "196/TALK",
   "narrator": "つばめ",
   "text": "わたし",
   "zh": "我",
   "narrator_zh": "燕"
  },
  {
   "location": "197/TALK",
   "narrator": "つばめ",
   "text": "間違ってるのかな？(´・ω・｀)"
  },
  {
   "location": "198/TALK",
   "narrator": "つばめ",
   "text": "わたしの言ってることって"
  },
  {
   "location": "199/TALK",
   "narrator": "つばめ",
   "text": "現実の見えてぃなぃ理想なのかな？(´つω・｀)ｼｭﾝ"
  },
  {
   "location": "201/SEL",
   "narrator": "",
   "text": "つばめは間違っていない",
   "zh": "燕没有错",
   "narrator_zh": ""
  },
  {
   "location": "202/ACT",
   "narrator": "",
   "text": "つばめは間違っていない",
   "zh": "燕没有错",
   "narrator_zh": ""
  },
  {
   "location": "204/TALK",
   "narrator": "つばめ",
   "text": "ぁりがと(*´︶`*)"
  },
  {
   "location": "205/TALK",
   "narrator": "つばめ",
   "text": "みんなは認めてくれなぃけど"
  },
  {
   "location": "206/TALK",
   "narrator": "つばめ",
   "text": "$handle$さんにそぅ言ってもらぇて安心した(●´ω｀●)",
   "zh": "$handle$这么说我就放心了(●´ω｀●)",
   "narrator_zh": "燕"
  },
  {
   "location": "207/TALK",
   "narrator": "つばめ",
   "text": "わたしはこれからも卯月さんを信じるし"
  },
  {
   "location": "208/TALK",
   "narrator": "つばめ",
   "text": "みんなを助ける方法を考ぇるねヽ(･ω･ )ゝ✧"
  },
  {
   "location": "19/DIALOG",
   "narrator": "Dialog_EventData",
   "text": "<color=green>某月某日　 4:52 PM</color>\n平日の夕方、神楽坂トライナリーにて"
  }
 ]
}
