{
    "dir": "chap19/daydra/dd_ch03_19_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "19305",
        "cid": "gabriella",
        "title": "005 メインストーリー",
        "sub_title": "気にしすぎの戦＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "过于在意之战＜后篇＞"
    },
    "entry": [
        {
            "location": "480/TALK",
            "narrator": "ガブリエラ",
            "text": "まあ",
            "zh": "嘛",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "481/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤだものね",
            "zh": "毕竟是绫水嘛",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "482/TALK",
            "narrator": "ガブリエラ",
            "text": "前からそうなんだし",
            "zh": "她从以前开始就这样了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "483/TALK",
            "narrator": "ガブリエラ",
            "text": "今更か",
            "zh": "事到如今也没啥好计较的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "484/TALK",
            "narrator": "ガブリエラ",
            "text": "ごめんなさいね$marzanna$",
            "zh": "抱歉啦$marzanna$",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "485/TALK",
            "narrator": "ガブリエラ",
            "text": "変な愚痴を言っちゃったわ",
            "zh": "跟你说了些莫名其妙的牢骚",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "496/TALK",
            "narrator": "ガブリエラ",
            "text": "…そうよね。",
            "zh": "……也是呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "497/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤなんだし、\n仕方ないわよ…。",
            "zh": "毕竟是绫水嘛，\n这也是没办法的事……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "500/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…。",
            "zh": "唉……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "501/TALK",
            "narrator": "アーヤ",
            "text": "？",
            "zh": "？",
            "narrator_zh": "绫水"
        },
        {
            "location": "502/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィったら、\nため息吐いてる…。",
            "zh": "加维这家伙，\n居然在叹气……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "503/TALK",
            "narrator": "アーヤ",
            "text": "…もしかして、\n本当は凄く疲れてるの\nかしら？",
            "zh": "……难道说，\n她其实已经\n累坏了吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "504/SEL",
            "narrator": "",
            "text": "アーヤ",
            "zh": "绫水",
            "narrator_zh": ""
        },
        {
            "location": "505/ACT",
            "narrator": "",
            "text": "アーヤ",
            "zh": "绫水",
            "narrator_zh": ""
        },
        {
            "location": "522/TALK",
            "narrator": "アーヤ",
            "text": "何か？",
            "zh": "怎么了？",
            "narrator_zh": "绫水"
        },
        {
            "location": "523/TALK",
            "narrator": "アーヤ",
            "text": "どうかした？(￣Д￣ )",
            "zh": "出什么事了吗？(￣Д￣ )",
            "narrator_zh": "绫水"
        },
        {
            "location": "525/SEL",
            "narrator": "",
            "text": "昔はガブリエラと二人だったんだっけ？",
            "zh": "以前只有你和加布里埃拉两个人来着吧？",
            "narrator_zh": ""
        },
        {
            "location": "526/ACT",
            "narrator": "",
            "text": "昔はガブリエラと二人だったんだっけ？",
            "zh": "以前只有你和加布里埃拉两个人来着吧？",
            "narrator_zh": ""
        },
        {
            "location": "528/TALK",
            "narrator": "アーヤ",
            "text": "そう(^^",
            "zh": "对(^^",
            "narrator_zh": "绫水"
        },
        {
            "location": "529/TALK",
            "narrator": "アーヤ",
            "text": "私の次に入隊したのが",
            "zh": "紧随我之后入队的就是",
            "narrator_zh": "绫水"
        },
        {
            "location": "530/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィで",
            "zh": "加维",
            "narrator_zh": "绫水"
        },
        {
            "location": "531/TALK",
            "narrator": "アーヤ",
            "text": "みやびが来るまでは",
            "zh": "在雅加入之前",
            "narrator_zh": "绫水"
        },
        {
            "location": "532/TALK",
            "narrator": "アーヤ",
            "text": "ずっと",
            "zh": "一直都是",
            "narrator_zh": "绫水"
        },
        {
            "location": "533/TALK",
            "narrator": "アーヤ",
            "text": "二人だったわ(￣∇￣)",
            "zh": "我们两个人哦(￣∇￣)",
            "narrator_zh": "绫水"
        },
        {
            "location": "536/TALK",
            "narrator": "アーヤ",
            "text": "考えてみると",
            "zh": "现在回想起来",
            "narrator_zh": "绫水"
        },
        {
            "location": "537/TALK",
            "narrator": "アーヤ",
            "text": "凄いかも(｡-_-｡)",
            "zh": "还挺厉害的呢(｡-_-｡)",
            "narrator_zh": "绫水"
        },
        {
            "location": "538/TALK",
            "narrator": "アーヤ",
            "text": "フェノメノン",
            "zh": "PhenoMENON",
            "narrator_zh": "绫水"
        },
        {
            "location": "539/TALK",
            "narrator": "アーヤ",
            "text": "二人で収束させたとか",
            "zh": "居然光靠两个人就平息了下来",
            "narrator_zh": "绫水"
        },
        {
            "location": "540/TALK",
            "narrator": "アーヤ",
            "text": "今じゃ信じられない(>_<)",
            "zh": "放到现在简直不敢相信(>_<)",
            "narrator_zh": "绫水"
        },
        {
            "location": "541/TALK",
            "narrator": "アーヤ",
            "text": "でも",
            "zh": "不过",
            "narrator_zh": "绫水"
        },
        {
            "location": "542/TALK",
            "narrator": "アーヤ",
            "text": "凄く大変だったわ(-ω-;)",
            "zh": "当时真的超辛苦啊(-ω-;)",
            "narrator_zh": "绫水"
        },
        {
            "location": "545/TALK",
            "narrator": "アーヤ",
            "text": "ごめん",
            "zh": "抱歉",
            "narrator_zh": "绫水"
        },
        {
            "location": "546/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィと話しあるから",
            "zh": "我要跟加维说点事",
            "narrator_zh": "绫水"
        },
        {
            "location": "547/TALK",
            "narrator": "アーヤ",
            "text": "ここまでね",
            "zh": "先聊到这儿哦",
            "narrator_zh": "绫水"
        },
        {
            "location": "559/TALK",
            "narrator": "アーヤ",
            "text": "…ねえ、ギャヴィ。\n覚えてる？",
            "zh": "……呐，加维。\n你还记得吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "562/TALK",
            "narrator": "ガブリエラ",
            "text": "え？　何が？",
            "zh": "哎？记得什么？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "563/TALK",
            "narrator": "アーヤ",
            "text": "二人だけだった頃\n凄いのと戦ったこと。",
            "zh": "以前还只有我们俩的时候，\n跟那个超厉害的家伙战斗的事。",
            "narrator_zh": "绫水"
        },
        {
            "location": "565/TALK",
            "narrator": "ガブリエラ",
            "text": "凄いの？",
            "zh": "超厉害的家伙？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "566/TALK",
            "narrator": "アーヤ",
            "text": "恐竜のことよ。\n一緒に戦ったでしょ？",
            "zh": "就是那头恐龙啊。\n我们一起打过的吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "568/TALK",
            "narrator": "ガブリエラ",
            "text": "…ああ！\nあったわね！",
            "zh": "……啊啊！\n是有过这么一回事！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "569/TALK",
            "narrator": "ガブリエラ",
            "text": "あれは恐竜って\n言えないでしょ？",
            "zh": "那个根本算不上\n恐龙了吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "570/TALK",
            "narrator": "ガブリエラ",
            "text": "どう考えても怪獣な\nティラノサウルス！",
            "zh": "怎么想都是大怪兽级别的\n霸王龙啊！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "572/TALK",
            "narrator": "アーヤ",
            "text": "そうそう。",
            "zh": "对对。",
            "narrator_zh": "绫水"
        },
        {
            "location": "573/TALK",
            "narrator": "アーヤ",
            "text": "三十メートルはある\n大きさで、口からは\n火まで吐いてたし。",
            "zh": "体型足足有三十米高，\n嘴里甚至还能\n喷出火来呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "576/TALK",
            "narrator": "ガブリエラ",
            "text": "声が衝撃波とか、\nマジでヤバかったわ、\nあの時は。",
            "zh": "连吼声都是冲击波什么的，\n那时候真是\n险象环生啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "578/TALK",
            "narrator": "ガブリエラ",
            "text": "あれはクリア条件が\n超単純だったから\nどうにかなったけど。",
            "zh": "亏得那次的通关条件\n超级单纯，\n才勉强混了过去。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "579/TALK",
            "narrator": "アーヤ",
            "text": "本当、そうね。",
            "zh": "确实如此呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "580/TALK",
            "narrator": "アーヤ",
            "text": "思えば、あの時が\n最初だったかしら？",
            "zh": "仔细想想，那次\n算是头一回吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "581/TALK",
            "narrator": "アーヤ",
            "text": "二人でコンビネー\nション攻撃したの\nって。",
            "zh": "我们两个人\n使出合体技攻击\n什么的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "582/TALK",
            "narrator": "ガブリエラ",
            "text": "う、うん。\nそう、そうよ！",
            "zh": "嗯、嗯。\n对、没错！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "583/TALK",
            "narrator": "アーヤ",
            "text": "懐かしいわねぇ…。",
            "zh": "真怀念啊……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "584/TALK",
            "narrator": "アーヤ",
            "text": "まあ、今思えば\nかなりメチャクチャな\n戦い方だったけど。",
            "zh": "嘛，现在回想起来，\n当时的打法还真是\n乱七八糟的呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "586/TALK",
            "narrator": "ガブリエラ",
            "text": "あはは、そうそう。\nタイミングとか全然\n合わなかったわねぇ。",
            "zh": "啊哈哈，就是说啊。\n时机什么的完全\n对不上呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "589/TALK",
            "narrator": "ガブリエラ",
            "text": "そっか…アーヤも\n覚えててくれたんだ。",
            "zh": "这样啊……原来绫水\n也一直记得呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "590/TALK",
            "narrator": "ガブリエラ",
            "text": "あたししか覚えて\nないと思ってた。",
            "zh": "我还以为只有我\n一个人记得呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "591/TALK",
            "narrator": "ガブリエラ",
            "text": "…普段鈍感なのに、\n時々こういうこと\n言ってくるのよね。",
            "zh": "……明明平时迟钝得要命，\n偏偏时不时会说出\n这种话来。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "592/TALK",
            "narrator": "ガブリエラ",
            "text": "だからドキッと\nさせられちゃう…。",
            "zh": "害得我每次都被她\n弄得小鹿乱撞……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "594/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…悔しいなぁ。",
            "zh": "唉……真不甘心啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "596/TALK",
            "narrator": "アーヤ",
            "text": "ん？　何が？",
            "zh": "嗯？什么不甘心？",
            "narrator_zh": "绫水"
        },
        {
            "location": "598/TALK",
            "narrator": "ガブリエラ",
            "text": "あ、ううん。",
            "zh": "啊，没什么。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "599/TALK",
            "narrator": "ガブリエラ",
            "text": "そういえば\n恋愛小説のも\n大変だったなって。",
            "zh": "说起来，\n那次恋爱小说的事件\n也挺折腾人的呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "601/TALK",
            "narrator": "アーヤ",
            "text": "あー…あれはもう、\n私のトラウマよ。",
            "zh": "啊——……那次简直\n成我的心理阴影了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "602/TALK",
            "narrator": "ガブリエラ",
            "text": "でしょ！\nだって、主人公と\nヒロインのことを――",
            "zh": "对吧！\n因为那时候，主人公和\n女主角他们俩——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "613/DIALOG",
            "narrator": "Dialog_chapter_ch03",
            "text": "【MV EXE_GARBiELa】",
            "zh": "【MV EXE_GARBiELa】",
            "narrator_zh": "Dialog_chapter_ch03"
        }
    ]
}
