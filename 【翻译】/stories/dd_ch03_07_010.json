{
    "dir": "chap07/daydra/dd_ch03_07_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "7352",
        "cid": "gabriella",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "電車に揺られて",
        "title_zh": "Extra002 额外剧情",
        "sub_title_zh": "随电车摇晃"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "電車に揺られて",
            "zh": "随电车摇晃",
            "narrator_zh": ""
        },
        {
            "location": "18/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ、はぁ…。",
            "zh": "哈啊、哈啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "20/TALK",
            "narrator": "ガブリエラ",
            "text": "大遅刻だわ。\nもう二時限目が終わる\n時間じゃない…。",
            "zh": "大迟到了啊。\n这不是都快到\n第二节课下课的时间了吗……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "23/TALK",
            "narrator": "アーヤ",
            "text": "ちょっと、ギャヴィ。\n今頃登校なの？",
            "zh": "我说，加维。\n怎么现在才来上学？",
            "narrator_zh": "绫水"
        },
        {
            "location": "27/TALK",
            "narrator": "ガブリエラ",
            "text": "うわっ、また面倒なのと\n会っちゃったわ…。",
            "zh": "唔哇，怎么又碰上\n这个麻烦的家伙了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "29/TALK",
            "narrator": "アーヤ",
            "text": "何か言った？",
            "zh": "你说什么了吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "32/TALK",
            "narrator": "ガブリエラ",
            "text": "べ、別に何も…。",
            "zh": "没、没什么……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "34/TALK",
            "narrator": "アーヤ",
            "text": "それより、こんな時間に\n登校なんて、\n何かあったの？",
            "zh": "话说回来，这个时间才来\n上学，\n出什么事了吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "36/TALK",
            "narrator": "アーヤ",
            "text": "トライナリーの出動以外で\n遅刻したこと、一度も\nなかったのに…。",
            "zh": "除了三重奏的出动之外，\n你一次都没有\n迟到过呀……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "37/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…やっぱり聞かれる\nわよね…。",
            "zh": "唉……果然还是会被\n问到呢……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "38/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、電車の中で寝ちゃった\nなんて言ったら、呆れられると\n思うし…。",
            "zh": "可是，要是说在电车里\n睡着了，肯定会被她\n无语的吧……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "39/SEL",
            "narrator": "",
            "text": "正直に言おう",
            "zh": "老实说吧",
            "narrator_zh": ""
        },
        {
            "location": "40/SEL",
            "narrator": "",
            "text": "遊んでた、と言おう",
            "zh": "就说在玩吧",
            "narrator_zh": ""
        },
        {
            "location": "41/SEL",
            "narrator": "",
            "text": "眠りの魔法に掛かってた",
            "zh": "中了沉睡魔法",
            "narrator_zh": ""
        },
        {
            "location": "44/TALK",
            "narrator": "アーヤ",
            "text": "…まあ、無理に言えとは\nいわないけど――",
            "zh": "……嘛，我也不是\n非要逼你说——",
            "narrator_zh": "绫水"
        },
        {
            "location": "45/TALK",
            "narrator": "アーヤ",
            "text": "事故とかに巻き込まれた\nわけじゃないのよね？",
            "zh": "你不是被卷进\n什么事故里了吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "47/TALK",
            "narrator": "ガブリエラ",
            "text": "そんなわけないでしょ？\nケガしてるわけじゃないん\nだし。",
            "zh": "怎么可能嘛？\n你看我也没\n受伤啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "48/TALK",
            "narrator": "アーヤ",
            "text": "そうだけど…。",
            "zh": "话是这么说……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "52/TALK",
            "narrator": "ガブリエラ",
            "text": "なんでもないってば。\nその…ちょっと色々\nあったの。",
            "zh": "都说没事了。\n那个……只是有点\n事情。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "54/TALK",
            "narrator": "アーヤ",
            "text": "色々って何よ？",
            "zh": "有点事情是什么啊？",
            "narrator_zh": "绫水"
        },
        {
            "location": "58/TALK",
            "narrator": "ガブリエラ",
            "text": "えっと…長くなるから\n帰ってからね。",
            "zh": "呃……说来话长，\n回去再说吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "60/TALK",
            "narrator": "ガブリエラ",
            "text": "それじゃ！",
            "zh": "那我先走了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "66/TALK",
            "narrator": "アーヤ",
            "text": "あ、ちょっと…！",
            "zh": "啊，等一下……！",
            "narrator_zh": "绫水"
        },
        {
            "location": "68/TALK",
            "narrator": "アーヤ",
            "text": "…まあ、何かあったわけじゃ\nないみたいだし、よかったわ。",
            "zh": "……算了，看起来也不像\n出了什么事，那就好。",
            "narrator_zh": "绫水"
        },
        {
            "location": "70/ACT",
            "narrator": "",
            "text": "正直に言おう",
            "zh": "老实说吧",
            "narrator_zh": ""
        },
        {
            "location": "76/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょっとごめん！",
            "zh": "抱歉稍等一下！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "92/TALK",
            "narrator": "ガブリエラ",
            "text": "…マルザンナは、私に正直でいろと言うのね？",
            "zh": "……玛尔赞娜是要我老实说对吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "93/TALK",
            "narrator": "ガブリエラ",
            "text": "わかったわ、私、正直になる！",
            "zh": "我知道了，我会老实说的！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "105/TALK",
            "narrator": "アーヤ",
            "text": "どうしたの？\n何か大切な用事？",
            "zh": "怎么了？\n有什么重要的事吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "107/TALK",
            "narrator": "ガブリエラ",
            "text": "うん、ちょっとね…。",
            "zh": "嗯，稍微有点……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "109/TALK",
            "narrator": "ガブリエラ",
            "text": "…正直に言うわ。",
            "zh": "……我老实说吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "111/TALK",
            "narrator": "ガブリエラ",
            "text": "いつもと同じ電車には\n乗ったんだけど、\nその――",
            "zh": "我明明坐上了\n和平时一样的电车，\n那个——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "112/TALK",
            "narrator": "ガブリエラ",
            "text": "いつの間にか寝ちゃって、\n目を覚ましたのが、\nついさっきで…。",
            "zh": "结果不知不觉睡着了，\n醒过来的时候，\n就已经是刚才了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "116/TALK",
            "narrator": "アーヤ",
            "text": "ついさっきって…\n二時間くらい電車で\n寝てたの！？",
            "zh": "刚才……\n你在电车里睡了\n大概两个小时吗！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "117/TALK",
            "narrator": "ガブリエラ",
            "text": "…まあ、そうなるわね。\n自分でもビックリだけど。",
            "zh": "……嘛，算起来是那样吧。\n连我自己都吓了一跳。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "118/TALK",
            "narrator": "アーヤ",
            "text": "はぁ…呆れた。\nよく電車の中で\nそんなに眠れたわね。",
            "zh": "唉……真服了你。\n亏你能在电车里\n睡这么久呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "121/TALK",
            "narrator": "ガブリエラ",
            "text": "し、仕方ないじゃない！\nあたしだってビックリ\nしてるんだから…。",
            "zh": "那、那也没办法嘛！\n连我自己也吓了\n一跳呢……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "122/TALK",
            "narrator": "アーヤ",
            "text": "夜更かしでもしたの？",
            "zh": "昨晚熬夜了吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "123/TALK",
            "narrator": "ガブリエラ",
            "text": "してないって！\n子供じゃないんだから！",
            "zh": "才没有！\n我又不是小孩子！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "124/TALK",
            "narrator": "アーヤ",
            "text": "そっか…。",
            "zh": "这样啊……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "125/TALK",
            "narrator": "アーヤ",
            "text": "…まあ、こういう日も\nあるわよね。",
            "zh": "……嘛，偶尔也会有\n这种时候呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "126/TALK",
            "narrator": "ガブリエラ",
            "text": "え？",
            "zh": "咦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "128/TALK",
            "narrator": "アーヤ",
            "text": "学校生活、バイト、それに\nトライナリー…。",
            "zh": "学校生活、打工，还有\n三重奏……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "129/TALK",
            "narrator": "アーヤ",
            "text": "そんな生活をしてれば、\n突然疲れが出るときも\nあるわよ。",
            "zh": "过着这样的生活，\n疲劳突然涌上来\n也是难免的哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "132/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "134/TALK",
            "narrator": "アーヤ",
            "text": "無理しないで、疲れたら\n早退しなさいよ。\nそれじゃ、また後で。",
            "zh": "别太勉强，累了的话\n就早退吧。\n那，回头见。",
            "narrator_zh": "绫水"
        },
        {
            "location": "136/TALK",
            "narrator": "ガブリエラ",
            "text": "…何よ、もっと怒るかと\n思ったのに。",
            "zh": "……什么嘛，我还以为她\n会更生气的呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "137/TALK",
            "narrator": "ガブリエラ",
            "text": "心配してくれたんだ…\nちょっと、嬉しいな。",
            "zh": "她是在担心我啊……\n有点，开心呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "138/ACT",
            "narrator": "",
            "text": "遊んでた、と言おう",
            "zh": "就说在玩吧",
            "narrator_zh": ""
        },
        {
            "location": "158/TALK",
            "narrator": "ガブリエラ",
            "text": "どうしちゃったの急に！？\nマルザンナしっかりして！",
            "zh": "突然怎么了！？\n玛尔赞娜你振作点！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "159/TALK",
            "narrator": "ガブリエラ",
            "text": "もしかして、具合でも悪かった？",
            "zh": "难道说，身体不舒服吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "160/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょっとゆっくりしてて。アーヤと話しちゃうから。",
            "zh": "你先休息一下。我这就去跟绫水说一声。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "171/TALK",
            "narrator": "アーヤ",
            "text": "何かあったの？\n凄い慌ててたみたい\nだけど…。",
            "zh": "出什么事了吗？\n看你好像慌慌张张\n的……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "172/TALK",
            "narrator": "ガブリエラ",
            "text": "うん。\n友達がちょっと、具合を\n悪くしちゃってて…。",
            "zh": "嗯。\n有个朋友稍微有点\n不太舒服……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "173/TALK",
            "narrator": "アーヤ",
            "text": "お友達が…？\nなるほど、それが遅れた\n理由ね。",
            "zh": "朋友……？\n原来如此，这就是你\n迟到的理由啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "175/TALK",
            "narrator": "ガブリエラ",
            "text": "え？",
            "zh": "咦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "177/TALK",
            "narrator": "アーヤ",
            "text": "具合が悪くなったお友達を\n家まで送り届けてたん\nでしょ？",
            "zh": "你是把身体不舒服的朋友\n一直送回家里去了\n对吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "178/TALK",
            "narrator": "アーヤ",
            "text": "それならそうと、\n早く言ってくれれば\nいいのに。",
            "zh": "要是这样的话，\n早点告诉我\n就好了嘛。",
            "narrator_zh": "绫水"
        },
        {
            "location": "180/TALK",
            "narrator": "ガブリエラ",
            "text": "…なんか、凄い勘違い\nされちゃってるけど、\nこれはラッキーだわ。",
            "zh": "……虽然总觉得被她\n严重误会了，\n不过这下真是走运。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "181/TALK",
            "narrator": "アーヤ",
            "text": "早く良くなるといいわね。\nそれじゃ、またね。",
            "zh": "希望她早点好起来呢。\n那，回头见。",
            "narrator_zh": "绫水"
        },
        {
            "location": "183/TALK",
            "narrator": "ガブリエラ",
            "text": "ふぅ…",
            "zh": "呼……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "184/TALK",
            "narrator": "ガブリエラ",
            "text": "って、落ち着いてる\n場合じゃないわ！",
            "zh": "不对，现在可不是\n松口气的时候！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "196/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょっと、マルザンナ！",
            "zh": "我说，玛尔赞娜！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "197/TALK",
            "narrator": "ガブリエラ",
            "text": "あなた本当に大丈夫なの？",
            "zh": "你真的没问题吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "199/SEL",
            "narrator": "",
            "text": "こうなることを予想してた",
            "zh": "我早料到会变成这样",
            "narrator_zh": ""
        },
        {
            "location": "200/SEL",
            "narrator": "",
            "text": "具合が悪いみたい",
            "zh": "好像有点不舒服",
            "narrator_zh": ""
        },
        {
            "location": "201/ACT",
            "narrator": "",
            "text": "こうなることを予想してた",
            "zh": "我早料到会变成这样",
            "narrator_zh": ""
        },
        {
            "location": "202/TALK",
            "narrator": "ガブリエラ",
            "text": "そ、そうだったの！？",
            "zh": "原、原来是这样吗！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "203/TALK",
            "narrator": "ガブリエラ",
            "text": "凄いわマルザンナ！",
            "zh": "好厉害啊玛尔赞娜！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "205/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、私を心配させたところだけは減点よ",
            "zh": "不过，害我担心了这一点要扣分哦",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "216/ACT",
            "narrator": "",
            "text": "具合が悪いみたい",
            "zh": "好像有点不舒服",
            "narrator_zh": ""
        },
        {
            "location": "217/TALK",
            "narrator": "ガブリエラ",
            "text": "やっぱりそうだったのね",
            "zh": "果然是这样啊",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "218/TALK",
            "narrator": "ガブリエラ",
            "text": "今日はゆっくり休んでいてね",
            "zh": "今天好好休息吧",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "230/ACT",
            "narrator": "",
            "text": "眠りの魔法に掛かってた",
            "zh": "中了沉睡魔法",
            "narrator_zh": ""
        },
        {
            "location": "251/TALK",
            "narrator": "ガブリエラ",
            "text": "マルザンナ、なんて素敵で可愛らしいことを言うの！？",
            "zh": "玛尔赞娜，你怎么说出这么美妙又可爱的话！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "252/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、きっとアーヤには通用しないわ",
            "zh": "不过，对绫水肯定行不通的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "253/TALK",
            "narrator": "ガブリエラ",
            "text": "そんなこと言ったら、物凄く怖い顔で怒られちゃう…",
            "zh": "要是这么说，她肯定会摆出超级可怕的表情生气的……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "254/TALK",
            "narrator": "ガブリエラ",
            "text": "だから、違う方法を考えてみるわ",
            "zh": "所以，我想想别的办法",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "266/TALK",
            "narrator": "ガブリエラ",
            "text": "…なんて言ったけど、\n何も浮かばないから\n相談したのよね…。",
            "zh": "……话是这么说，\n可我就是想不到办法\n才来商量的嘛……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "267/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィ…話の途中って\nこと忘れてない？",
            "zh": "加维……你没忘记\n话还说到一半吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "268/TALK",
            "narrator": "ガブリエラ",
            "text": "…し、信じてるわ、\nマルザンナ！",
            "zh": "……我、我相信你哦，\n玛尔赞娜！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "270/TALK",
            "narrator": "ガブリエラ",
            "text": "…ま…魔法が…。",
            "zh": "……魔……魔法……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "271/TALK",
            "narrator": "アーヤ",
            "text": "…は？",
            "zh": "……哈？",
            "narrator_zh": "绫水"
        },
        {
            "location": "272/TALK",
            "narrator": "ガブリエラ",
            "text": "魔法のせいで、その…",
            "zh": "因为魔法的缘故，那个……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "273/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "274/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "276/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィ、大丈夫？",
            "zh": "加维，你没事吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "280/TALK",
            "narrator": "ガブリエラ",
            "text": "えっ！？\nな、なに！？",
            "zh": "咦！？\n什、什么！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "282/TALK",
            "narrator": "アーヤ",
            "text": "具合が悪かったりしない？",
            "zh": "没有哪里不舒服吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "283/TALK",
            "narrator": "ガブリエラ",
            "text": "だ、大丈夫だから！\n変な心配しないでよ。",
            "zh": "没、没事啦！\n别瞎担心了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "286/TALK",
            "narrator": "アーヤ",
            "text": "魔法のせいで遅刻なんて\n言われたら、心配して\n当然でしょ！？",
            "zh": "听到别人说因为魔法\n才迟到，会担心\n不是理所当然的吗！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "287/TALK",
            "narrator": "アーヤ",
            "text": "まったく、具合が悪く\nなったら早退するのよ。",
            "zh": "真是的，要是不舒服\n就早退哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "293/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…変な勘違い\nされちゃったわ。",
            "zh": "唉……被她莫名其妙地\n误会了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "294/TALK",
            "narrator": "ガブリエラ",
            "text": "けど、本当の理由を\n聞かれないで乗り切れは\nしたわね。",
            "zh": "不过，总算在没被问出\n真正理由的情况下\n蒙混过关了呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "295/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、本当に驚いたわ。\nあんな理由で乗り切れる\nなんて、もしかして――",
            "zh": "但是，真是吓了一跳。\n那种理由居然也能\n蒙混过去，难道说——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "297/TALK",
            "narrator": "ガブリエラ",
            "text": "マルザンナこそ、\n本当は魔法使いなのかも\nしれないわね。",
            "zh": "玛尔赞娜你才是，\n说不定真的是个\n魔法使呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "17/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>5月18日　9:49 AM</color>\nとある朝、学園敷地内にて。",
            "zh": "<color=green>5月18日　9:49 AM</color>\n某个早晨，学园校舍内。",
            "narrator_zh": "Dialog_EventData"
        },
        {
