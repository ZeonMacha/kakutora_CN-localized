        },
        {
            "location": "32/TALK",
            "narrator": "アーヤ",
            "text": "大学の友達と食事に行ってきた",
            "zh": "刚和大学同学去吃了顿饭",
            "narrator_zh": "绫水"
        },
        {
            "location": "33/TALK",
            "narrator": "アーヤ",
            "text": "友達とよ(´o｀；",
            "zh": "是同学哦(´o｀；",
            "narrator_zh": "绫水"
        },
        {
            "location": "34/TALK",
            "narrator": "アーヤ",
            "text": "合コンじゃないからね",
            "zh": "才不是联谊呢",
            "narrator_zh": "绫水"
        },
        {
            "location": "36/SEL",
            "narrator": "",
            "text": "合コンと思ってた",
            "zh": "我以为是联谊",
            "narrator_zh": ""
        },
        {
            "location": "37/SEL",
            "narrator": "",
            "text": "食事、楽しかった？",
            "zh": "饭吃得开心吗？",
            "narrator_zh": ""
        },
        {
            "location": "38/SEL",
            "narrator": "",
            "text": "アーヤに合コンは早い！",
            "zh": "绫水去联谊还太早！",
            "narrator_zh": ""
        },
        {
            "location": "39/ACT",
            "narrator": "",
            "text": "合コンと思ってた",
            "zh": "我以为是联谊",
            "narrator_zh": ""
        },
        {
            "location": "40/TALK",
            "narrator": "アーヤ",
            "text": "なんでこう",
            "zh": "怎么就",
            "narrator_zh": "绫水"
        },
        {
            "location": "41/TALK",
            "narrator": "アーヤ",
            "text": "そうなるの",
            "zh": "变成这样了呢",
            "narrator_zh": "绫水"
        },
        {
            "location": "43/TALK",
            "narrator": "アーヤ",
            "text": "それとも東京の大学生って常に合コンしてるの？",
            "zh": "还是说东京的大学生天天都在联谊？",
            "narrator_zh": "绫水"
        },
        {
            "location": "44/TALK",
            "narrator": "アーヤ",
            "text": "ついてけないわ＼(◎o◎)／",
            "zh": "跟不上你们的节奏＼(◎o◎)／",
            "narrator_zh": "绫水"
        },
        {
            "location": "45/ACT",
            "narrator": "",
            "text": "食事、楽しかった？",
            "zh": "饭吃得开心吗？",
            "narrator_zh": ""
        },
        {
            "location": "46/TALK",
            "narrator": "アーヤ",
            "text": "もちろんよ",
            "zh": "当然开心",
            "narrator_zh": "绫水"
        },
        {
            "location": "47/TALK",
            "narrator": "アーヤ",
            "text": "やっぱりああいうところじゃないと話ってできなかったりするわ",
            "zh": "有些话果然还是那种场合才说得出口",
            "narrator_zh": "绫水"
        },
        {
            "location": "48/TALK",
            "narrator": "アーヤ",
            "text": "意外とね",
