        },
        {
            "location": "141/SEL",
            "narrator": "",
            "text": "その通り",
            "zh": "正是如此",
            "narrator_zh": ""
        },
        {
            "location": "142/SEL",
            "narrator": "",
            "text": "いやちょっと考えさせて",
            "zh": "不，让我想想",
