            "narrator": "",
            "text": "デジタルネイティブだから",
            "zh": "因为是数字原住民",
            "narrator_zh": ""
        },
        {
            "location": "125/TALK",
            "narrator": "みやび",
            "text": "ひとくくりか",
            "zh": "一概而论吗",
            "narrator_zh": "雅"
        },
        {
            "location": "126/ACT",
            "narrator": "",
            "text": "没個性こそ美徳",
            "zh": "没个性才是美德",
            "narrator_zh": ""
        },
        {
            "location": "127/TALK",
            "narrator": "みやび",
            "text": "日本人の思考か",
            "zh": "是日本人的想法吗",
            "narrator_zh": "雅"
        },
        {
            "location": "128/TALK",
            "narrator": "みやび",
            "text": "コピー＆ペースト時代の弊害か",
            "zh": "还是复制粘贴时代的弊端",
            "narrator_zh": "雅"
        },
        {
            "location": "129/ACT",
            "narrator": "",
            "text": "安定性と入手のたやすさを重視した結論",
            "zh": "是看重稳定和容易弄到之后的结论",
            "narrator_zh": ""
        },
        {
            "location": "131/TALK",
            "narrator": "みやび",
            "text": "左様",
            "zh": "正是",
            "narrator_zh": "雅"
        },
        {
            "location": "132/TALK",
            "narrator": "みやび",
            "text": "デファクトスタンダードには意味があり",
            "zh": "事实标准是有意义的",
            "narrator_zh": "雅"
        },
        {
            "location": "133/TALK",
            "narrator": "みやび",
            "text": "常に同じ環境を用意できるということは",
            "zh": "总能准备出同样的环境",
