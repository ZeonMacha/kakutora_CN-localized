            "narrator_zh": "雅"
        },
        {
            "location": "137/TALK",
            "narrator": "みやび",
            "text": "そもそも温もりとか体温とか言うならば",
            "zh": "说到底，要说温暖、体温的话",
            "narrator_zh": "雅"
        },
        {
            "location": "138/TALK",
            "narrator": "みやび",
            "text": "HDDから出る熱で充分だと思わんか",
