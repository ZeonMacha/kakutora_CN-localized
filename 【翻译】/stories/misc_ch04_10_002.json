        },
        {
            "location": "146/ACT",
            "narrator": "",
            "text": "その通り",
            "zh": "正是如此",
            "narrator_zh": ""
        },
        {
            "location": "147/TALK",
            "narrator": "みやび",
            "text": "ほう",
            "zh": "哦",
            "narrator_zh": "雅"
        },
        {
            "location": "148/TALK",
            "narrator": "みやび",
            "text": "これはまた",
            "zh": "这又是",
            "narrator_zh": "雅"
        },
        {
            "location": "149/ACT",
            "narrator": "",
            "text": "いやちょっと考えさせて",
