        },
        {
            "location": "126/ACT",
            "narrator": "",
            "text": "それがどうしたの",
            "zh": "那又怎样",
            "narrator_zh": ""
        },
        {
            "location": "127/TALK",
            "narrator": "みやび",
            "text": "所望する",
