        },
        {
            "location": "124/SEL",
            "narrator": "",
            "text": "それがどうしたの",
            "zh": "那又怎样",
            "narrator_zh": ""
        },
        {
            "location": "125/SEL",
            "narrator": "",
            "text": "欲しいなら届けようか",
