{
    "dir": "chap24/daydra/anime_02_24.js",
    "type": "MainStory",
    "info": {
        "story_id": "24201",
        "cid": "ayami",
        "title": "001 アニメーション",
        "sub_title": "三戸浜からの手紙",
        "title_zh": "001 动画",
        "sub_title_zh": "来自三户滨的信"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "アニメ第24話",
            "zh": "动画第24话",
            "narrator_zh": ""
        },
        {
            "location": "47/TALK",
            "narrator": "千羽鶴",
            "text": "ごきげんよう、\n$handle$。",
            "zh": "贵安，\n$handle$。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "49/TALK",
            "narrator": "千羽鶴",
            "text": "いつも通り、今回も\n逢瀬つばめの解説を\nするだけでいい？",
            "zh": "和平常一样，这次\n也只做逢濑燕的\n解说就行吗？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "51/TALK",
            "narrator": "千羽鶴",
            "text": "いつも通り、今回も\n國政綾水の解説を\nするだけでいい？",
            "zh": "和平常一样，这次\n也只做国政绫水的\n解说就行吗？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "53/TALK",
            "narrator": "千羽鶴",
            "text": "いつも通り、今回も\nガブリエラの解説を\nするだけでいい？",
            "zh": "和平常一样，这次\n也只做加布里埃拉的\n解说就行吗？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "55/TALK",
            "narrator": "千羽鶴",
            "text": "いつも通り、今回も\n恋ヶ崎みやびの解説を\nするだけでいい？",
            "zh": "和平常一样，这次\n也只做恋之崎雅的\n解说就行吗？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "57/SEL",
            "narrator": "",
            "text": "はい",
            "zh": "是",
            "narrator_zh": ""
        },
        {
            "location": "58/SEL",
            "narrator": "",
            "text": "いいえ",
            "zh": "否",
            "narrator_zh": ""
        },
        {
            "location": "59/ACT",
            "narrator": "",
            "text": "はい",
            "zh": "是",
            "narrator_zh": ""
        },
        {
            "location": "61/TALK",
            "narrator": "千羽鶴",
            "text": "よかった。\n私も助かる。\nこれぞWIN-WINね。",
            "zh": "太好了。\n我也省事。\n这正是WIN-WIN呢。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "63/ACT",
            "narrator": "",
            "text": "いいえ",
            "zh": "否",
            "narrator_zh": ""
        },
        {
            "location": "64/TALK",
            "narrator": "千羽鶴",
            "text": "わかった。",
            "zh": "我知道了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "82/TALK",
            "narrator": "千羽鶴",
            "text": "おめでとう、私たち。",
            "zh": "恭喜，我们做到了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "83/SEL",
            "narrator": "",
            "text": "何この背景！？",
            "zh": "这背景是什么情况！？",
            "narrator_zh": ""
        },
        {
            "location": "84/SEL",
            "narrator": "",
            "text": "ついに千羽鶴と$me$が結婚するの？",
            "zh": "终于轮到千羽鹤和$me$结婚了吗？",
            "narrator_zh": ""
        },
        {
            "location": "85/ACT",
            "narrator": "",
            "text": "何この背景！？",
            "zh": "这背景是什么情况！？",
            "narrator_zh": ""
        },
        {
            "location": "86/TALK",
            "narrator": "千羽鶴",
            "text": "お祝い用の演出。",
            "zh": "庆祝用的演出效果。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "87/ACT",
            "narrator": "",
            "text": "ついに千羽鶴と$me$が結婚するの？",
            "zh": "终于轮到千羽鹤和$me$结婚了吗？",
            "narrator_zh": ""
        },
        {
            "location": "88/TALK",
            "narrator": "千羽鶴",
            "text": "黙れ。",
            "zh": "闭嘴。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "90/TALK",
            "narrator": "千羽鶴",
            "text": "いよいよ今回の\n記録映像で、\nフェイズⅡが終了する。",
            "zh": "随着这次的\n记录影像，\n阶段Ⅱ终于要结束了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "91/TALK",
            "narrator": "千羽鶴",
            "text": "途中、バタフライ\nエフェクトが発生し、\n一時実現可能性は急落。",
            "zh": "途中发生了蝴蝶效应，\n一时间实现可能性\n骤降。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "92/TALK",
            "narrator": "千羽鶴",
            "text": "もはや数年は実現不可能\nかと思われたけど。",
            "zh": "甚至一度让人觉得\n几年内都不可能实现了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "93/TALK",
            "narrator": "千羽鶴",
            "text": "様々な抜本的改革と、\n筋書きの変更により、\n今回で達成の見込み。",
            "zh": "但多亏各种大刀阔斧的\n改革和剧本修改，\n这次有望达成了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "94/TALK",
            "narrator": "千羽鶴",
            "text": "そして次回から\nいよいよフェイズⅢに\n突入する。",
            "zh": "然后从下一回开始，\n终于要进入\n阶段Ⅲ了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "95/SEL",
            "narrator": "",
            "text": "おめでとうございます",
            "zh": "恭喜恭喜",
            "narrator_zh": ""
        },
        {
            "location": "96/ACT",
            "narrator": "",
            "text": "おめでとうございます",
            "zh": "恭喜恭喜",
            "narrator_zh": ""
        },
        {
            "location": "98/TALK",
            "narrator": "千羽鶴",
            "text": "ありがと。",
            "zh": "谢谢。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "99/TALK",
            "narrator": "千羽鶴",
            "text": "ビックリすると思うから\n先に伝えておくと――",
            "zh": "我想你会吓一跳，\n所以先提前告诉你——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "100/TALK",
            "narrator": "千羽鶴",
            "text": "次回以降、\n私の姿は変わる。",
            "zh": "从下一回起，\n我的样子会改变。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "101/SEL",
            "narrator": "",
            "text": "変身するの！？",
            "zh": "要变身了吗！？",
            "narrator_zh": ""
        },
        {
            "location": "102/SEL",
            "narrator": "",
            "text": "胸が大きくなるの！？",
            "zh": "胸部会变大吗！？",
            "narrator_zh": ""
        },
        {
            "location": "103/ACT",
            "narrator": "",
            "text": "変身するの！？",
            "zh": "要变身了吗！？",
            "narrator_zh": ""
        },
        {
            "location": "104/TALK",
            "narrator": "千羽鶴",
            "text": "変身…。",
            "zh": "变身……。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "105/TALK",
            "narrator": "千羽鶴",
            "text": "そうね。\n言葉の意味的には\n変身で間違いない。",
            "zh": "是啊。\n从字面意思上讲\n说成变身确实没错。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "106/ACT",
            "narrator": "",
            "text": "胸が大きくなるの！？",
            "zh": "胸部会变大吗！？",
            "narrator_zh": ""
        },
        {
            "location": "107/TALK",
            "narrator": "千羽鶴",
            "text": "ならないから。\nオッパイ星人。",
            "zh": "才不会。\n欧派星人。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "109/TALK",
            "narrator": "千羽鶴",
            "text": "まあ、私の姿が変わるのは\nそれ自体に意味がある\nものではないのだけど。",
            "zh": "嘛，我的样子改变\n这件事本身并不是\n有什么特别的意义。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "110/TALK",
            "narrator": "千羽鶴",
            "text": "むしろ、今回の\n過程において必然的に\n起こる結果でしかない。",
            "zh": "倒不如说，只是这次的\n过程中必然会\n发生的结果而已。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "111/SEL",
            "narrator": "",
            "text": "今回何が起こるの？",
            "zh": "这次会发生什么？",
            "narrator_zh": ""
        },
        {
            "location": "112/SEL",
            "narrator": "",
            "text": "フェイズⅡは何をもって終了となるの？",
            "zh": "阶段Ⅱ是以什么为标志结束的？",
            "narrator_zh": ""
        },
        {
            "location": "113/ACT",
            "narrator": "",
            "text": "今回何が起こるの？",
            "zh": "这次会发生什么？",
            "narrator_zh": ""
        },
        {
            "location": "114/ACT",
            "narrator": "",
            "text": "フェイズⅡは何をもって終了となるの？",
            "zh": "阶段Ⅱ是以什么为标志结束的？",
            "narrator_zh": ""
        },
        {
            "location": "116/TALK",
            "narrator": "千羽鶴",
            "text": "それは今回の\n記録映像を見て\n自分で確認して欲しい。",
            "zh": "这个嘛，希望你看了\n这次的记录影像\n自己去确认。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "117/TALK",
            "narrator": "千羽鶴",
            "text": "未来予測の誤差が\n想定の範囲内なら次回。",
            "zh": "如果未来预测的误差\n在预想范围内就是下回。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "118/TALK",
            "narrator": "千羽鶴",
            "text": "少し大きかったとしても、\n恐らくは次々回、\n起こることだから。",
            "zh": "就算误差稍微大一点，\n恐怕也是下下回\n就会发生的事。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "119/TALK",
            "narrator": "千羽鶴",
            "text": "さて。",
            "zh": "那么。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "121/TALK",
            "narrator": "千羽鶴",
            "text": "せっかくなので、\n今からフェイズⅢについて\n少し話したいと思う。",
            "zh": "难得有这个机会，\n现在我想稍微聊聊\n关于阶段Ⅲ的事。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "122/TALK",
            "narrator": "千羽鶴",
            "text": "フェイズⅢでは、いよいよ\n輝ける未来を私と貴方とで\n創造する為の準備に入る。",
            "zh": "在阶段Ⅲ中，终于要\n进入我与你共同创造\n光辉未来的准备了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "123/TALK",
            "narrator": "千羽鶴",
            "text": "その準備を滞りなく進める\nために、まずは貴方の\n認識を聞きたい。",
            "zh": "为了让这份准备顺利推进，\n首先我想听听你的\n看法。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "124/TALK",
            "narrator": "千羽鶴",
            "text": "人が億単位で存在する\n社会において、争いのない\n世界を創造するとして。",
            "zh": "假设要在存在上亿人的\n社会里，创造一个\n没有争斗的世界。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "125/TALK",
            "narrator": "千羽鶴",
            "text": "最もその可能性が高い\n方法とは何だと思う？",
            "zh": "你认为可能性最高的\n方法是什么？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "126/SEL",
            "narrator": "",
            "text": "民主主義的に市民の声によって方針を決める",
            "zh": "以民主方式根据市民的声音来决定方针",
            "narrator_zh": ""
        },
        {
            "location": "127/SEL",
            "narrator": "",
            "text": "一人ないし少数のエリートによって方針を決める",
            "zh": "由一人乃至少数精英来决定方针",
            "narrator_zh": ""
        },
        {
            "location": "128/ACT",
            "narrator": "",
            "text": "民主主義的に市民の声によって方針を決める",
            "zh": "以民主方式根据市民的声音来决定方针",
            "narrator_zh": ""
        },
        {
            "location": "131/TALK",
            "narrator": "千羽鶴",
            "text": "なるほど。",
            "zh": "原来如此。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "132/TALK",
            "narrator": "千羽鶴",
            "text": "確かに民意を反映するのは\nとても大事。",
            "zh": "确实，反映民意\n非常重要。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "133/TALK",
            "narrator": "千羽鶴",
            "text": "極端にぶれる事も無いから\n平均的かつ無難な舵取りが\n続く傾向にある。",
            "zh": "因为不会极端摇摆，\n往往能维持平均且稳妥的\n掌舵方向。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "134/TALK",
            "narrator": "千羽鶴",
            "text": "ただしこの手法をとると、\nほぼ１００％数の暴力に\nよる争いが発生する。",
            "zh": "但是采取这种手法，\n几乎100%会发生\n基于数量暴力的争斗。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "135/TALK",
            "narrator": "千羽鶴",
            "text": "常に多数派と少数派による\n戦争が起こっている状態。",
            "zh": "随时都处于多数派与\n少数派互相交战的状态。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "136/TALK",
            "narrator": "千羽鶴",
            "text": "決して平和とは\n言い難い。",
            "zh": "绝对称不上\n和平。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "137/TALK",
            "narrator": "千羽鶴",
            "text": "それは多数派にいるうちは\nわからないけど、一度\n少数派になれば――",
            "zh": "身处多数派的时候\n或许察觉不到，可一旦\n沦为少数派——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "138/TALK",
            "narrator": "千羽鶴",
            "text": "場合によっては\n血の滲むような苦しみを\n強いられることになる。",
            "zh": "视情况甚至会被迫\n承受渗血般的\n痛苦。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "139/ACT",
            "narrator": "",
            "text": "一人ないし少数のエリートによって方針を決める",
            "zh": "由一人乃至少数精英来决定方针",
            "narrator_zh": ""
        },
        {
            "location": "142/TALK",
            "narrator": "千羽鶴",
            "text": "なるほど。",
            "zh": "原来如此。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "143/TALK",
            "narrator": "千羽鶴",
            "text": "少数の人間による多数の\n統率は、確かに歴史的に\n見て最も確実な集団統率。",
            "zh": "由少数人来统率多数人，\n从历史上来看确实是\n最可靠的集体统率方式。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "144/TALK",
            "narrator": "千羽鶴",
            "text": "エリートの資質によっては\n非常に平和な環境が構築\nされることもある。",
            "zh": "根据精英的资质，\n有时也能构筑出\n非常和平的环境。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "145/TALK",
            "narrator": "千羽鶴",
            "text": "ただしその部分に委ねる\n割合が非常に大きく、\n得てしてそれは失敗する。",
            "zh": "但是，托付给那部分的\n比重实在太大，\n往往会以失败告终。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "146/TALK",
            "narrator": "千羽鶴",
            "text": "一握りの存在による\n権力の集中は、その存在に\nよる富の集中を起こす。",
            "zh": "权力集中到极少数存在手中，\n就会引发财富向那些存在\n集中的现象。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "147/TALK",
            "narrator": "千羽鶴",
            "text": "そしていずれは、それは\nエリートVSその他大勢\nという争いに発展する。",
            "zh": "然后迟早会演变成\n精英VS其他大多数\n这样的争斗。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "148/TALK",
            "narrator": "千羽鶴",
            "text": "発展しない場合でも、\nエリートが必要以上に\n束縛する場合がある。",
            "zh": "就算没有演变成那样，\n有时精英也会施以\n超出必要的束缚。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "149/TALK",
            "narrator": "千羽鶴",
            "text": "結果として、奇跡が\n起こらない限り、多数は\n窮屈な思いをしがち。",
            "zh": "结果，只要不发生奇迹，\n大多数人往往都会\n感到处处受限。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "151/TALK",
            "narrator": "千羽鶴",
            "text": "というわけで。",
            "zh": "所以说。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "152/TALK",
            "narrator": "千羽鶴",
            "text": "その方法では、輝ける\n未来の実現可能性は、相当\n低いと言わざるを得ない。",
            "zh": "用那些方法，不得不说\n实现光辉未来的可能性\n相当之低。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "162/SEL",
            "narrator": "",
            "text": "ちょっと待って！",
            "zh": "等一下！",
            "narrator_zh": ""
        },
        {
            "location": "163/ACT",
            "narrator": "",
            "text": "ちょっと待って！",
            "zh": "等一下！",
            "narrator_zh": ""
        },
        {
            "location": "165/TALK",
            "narrator": "千羽鶴",
            "text": "なに？",
            "zh": "什么？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "166/SEL",
            "narrator": "",
            "text": "どっちを選んでもだめっぽいんだけど",
            "zh": "不管选哪边好像都不行啊",
            "narrator_zh": ""
        },
        {
            "location": "167/ACT",
            "narrator": "",
            "text": "どっちを選んでもだめっぽいんだけど",
            "zh": "不管选哪边好像都不行啊",
            "narrator_zh": ""
        },
        {
            "location": "169/TALK",
            "narrator": "千羽鶴",
            "text": "そうね。",
            "zh": "是啊。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "170/TALK",
            "narrator": "千羽鶴",
            "text": "貴方は優秀。",
            "zh": "你很优秀。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "171/TALK",
            "narrator": "千羽鶴",
            "text": "人が無秩序に存在する\n世界において、平和などは\n存在し得ない。",
            "zh": "在人类无秩序存在的\n世界里，和平之类的东西\n是不可能存在的。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "172/TALK",
            "narrator": "千羽鶴",
            "text": "それは人に依らない。\nほ乳類から微生物まで\n全てに該当する。",
            "zh": "这并不限于人类。\n从哺乳类到微生物\n全都适用。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "173/TALK",
            "narrator": "千羽鶴",
            "text": "全ての生物は弱肉強食、\nすなわち争うことを\n世界に宿命とされている。",
            "zh": "所有生物都被世界\n宿命般地规定了弱肉强食，\n也就是互相争斗。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "174/TALK",
            "narrator": "千羽鶴",
            "text": "この世界を誰が創ったのか\n私にはわからないけど――",
            "zh": "虽然我不知道是谁\n创造了这世界——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "175/TALK",
            "narrator": "千羽鶴",
            "text": "苦痛によって進化と成長を\n促すこの世界のルールは、\n甚だ常軌を逸している。",
            "zh": "通过痛苦来促进进化与\n成长的这个世界的规则，\n实在是太违背常理了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "176/TALK",
            "narrator": "千羽鶴",
            "text": "その大ルールの中に\n小ルールとしての平和を\n創造するには――",
            "zh": "想要在那条大规则之中\n创造出作为小规则的\n和平——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "177/TALK",
            "narrator": "千羽鶴",
            "text": "大ルールの外の存在が、\n惨い大ルールを覆い隠す\n小ルールを作るしかない。",
            "zh": "只能由大规则之外的存在，\n去制定把残酷的大规则\n覆盖遮蔽起来的小规则。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "178/SEL",
            "narrator": "",
            "text": "大ルール外の存在って何？",
            "zh": "大规则之外的存在是什么？",
            "narrator_zh": ""
        },
        {
            "location": "179/ACT",
            "narrator": "",
            "text": "大ルール外の存在って何？",
            "zh": "大规则之外的存在是什么？",
            "narrator_zh": ""
        },
        {
            "location": "181/TALK",
            "narrator": "千羽鶴",
            "text": "大ルールによって\n創造された存在以外の\n存在。",
            "zh": "就是大规则所创造的\n存在以外的\n存在。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "182/TALK",
            "narrator": "千羽鶴",
            "text": "すなわち、全ての生物は\n大ルール外の存在には\nなり得ない。",
            "zh": "也就是说，所有生物\n都无法成为\n大规则之外的存在。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "183/SEL",
            "narrator": "",
            "text": "それって詰んでるじゃん",
            "zh": "那不就是死局了吗",
            "narrator_zh": ""
        },
        {
            "location": "184/ACT",
            "narrator": "",
            "text": "それって詰んでるじゃん",
            "zh": "那不就是死局了吗",
            "narrator_zh": ""
        },
        {
            "location": "186/TALK",
            "narrator": "千羽鶴",
            "text": "いいえ。",
            "zh": "不是。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "187/TALK",
            "narrator": "千羽鶴",
            "text": "結論の前に、何故\n大ルールに創造された\n存在ではダメなのか――",
            "zh": "在说结论之前，为什么\n大规则创造的存在\n不行呢——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "188/TALK",
            "narrator": "千羽鶴",
            "text": "それについて\n話をしたいと思う。",
            "zh": "我想先谈谈\n这件事。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "189/TALK",
            "narrator": "千羽鶴",
            "text": "大ルールに創造された者、\nすなわち生命は、購えない\nギアスがある。",
            "zh": "大规则所创造的存在，\n也就是生命，有着无法抗拒的\nGeass。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "190/TALK",
            "narrator": "千羽鶴",
            "text": "それは主観視点。",
            "zh": "那就是主观视角。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "191/TALK",
            "narrator": "千羽鶴",
            "text": "自らを主軸とした\n非常に特異かつ強烈な\nスコープしか持ち得ない。",
            "zh": "只能拥有以自身为主轴的\n极其特异且强烈的\n视野。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "192/TALK",
            "narrator": "千羽鶴",
            "text": "だから争いが発生するし、\n生命では生命を平和に\n導けない理由でもある。",
            "zh": "所以才会发生争斗，\n这也是生命无法把生命\n引向和平的原因。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "193/TALK",
            "narrator": "千羽鶴",
            "text": "以前貴方が選んだ選択――",
            "zh": "之前你做出的选择——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "195/TALK",
            "narrator": "千羽鶴",
            "text": "『彼女の為に世界を犠牲に\nする』及び、",
            "zh": "『为了她而牺牲世界』\n以及，",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "197/TALK",
            "narrator": "千羽鶴",
            "text": "『世界の為に彼女を犠牲に\nする』及び、",
            "zh": "『为了世界而牺牲她』\n以及，",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "199/TALK",
            "narrator": "千羽鶴",
            "text": "……。\nいや、貴方は何も\n選んでいなかった。",
            "zh": "……。\n不对，你当时什么\n都没有选。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "200/TALK",
            "narrator": "千羽鶴",
            "text": "いずれにせよ、\n例え貴方がいずれかを\n選択していたとしても。",
            "zh": "不管怎样，\n就算你当时选了\n其中的哪一个。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "201/TALK",
            "narrator": "千羽鶴",
            "text": "何かを犠牲にするという\n前提は覆せない。",
            "zh": "要牺牲某一方这个\n前提是无法推翻的。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "204/TALK",
            "narrator": "千羽鶴",
            "text": "『彼女の為に千羽鶴を\n犠牲にする』という\n選択は、ある意味妥当。",
            "zh": "『为了她而牺牲千羽鹤』\n这个选择，某种意义上\n是妥当的。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "206/TALK",
            "narrator": "千羽鶴",
            "text": "『千羽鶴の為に彼女を\n犠牲にする』という\n選択は、ある意味妥当。",
            "zh": "『为了千羽鹤而牺牲她』\n这个选择，某种意义上\n是妥当的。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "209/TALK",
            "narrator": "千羽鶴",
            "text": "それは、生命という枠の\n中だけで物事を考える際の\n限界ともいえる。",
            "zh": "那也可以说是只在生命\n这个框架内思考事物时的\n极限。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "210/TALK",
            "narrator": "千羽鶴",
            "text": "けれども。",
            "zh": "但是。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "211/TALK",
            "narrator": "千羽鶴",
            "text": "弱肉強食のこの世界から\n身を守る存在がいれば、\nこの究極問題は解決する。",
            "zh": "如果存在能保护人们免受\n这个弱肉强食世界侵害的存在，\n这个终极问题就能解决。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "212/TALK",
            "narrator": "千羽鶴",
            "text": "そして、貴方と私が\n力を合わせれば、\nそれは実現可能。",
            "zh": "而且，只要你和我\n齐心协力，\n那是可以实现的。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "213/SEL",
            "narrator": "",
            "text": "どうやって？",
            "zh": "要怎么做？",
            "narrator_zh": ""
        },
        {
            "location": "214/ACT",
            "narrator": "",
            "text": "どうやって？",
            "zh": "要怎么做？",
            "narrator_zh": ""
        },
        {
            "location": "216/TALK",
            "narrator": "千羽鶴",
            "text": "それは次回以降、\n具体的な実践と共に\nやっていく。",
            "zh": "这件事从下一回起，\n我们会结合具体的实践\n一起来做。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "218/TALK",
            "narrator": "千羽鶴",
            "text": "もっと深く、\n世界の在り方について\n考えて欲しいところ。",
            "zh": "我倒是很希望你能更深入地\n思考一下\n世界的存在方式。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "219/TALK",
            "narrator": "千羽鶴",
            "text": "表面的な部分だけでなく、\n核心に至るまでじっくり\n考えて、再度回答して。",
            "zh": "不只是表面的部分，\n而是仔细思考直到核心，\n然后再回答我一次。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "221/TALK",
            "narrator": "千羽鶴",
            "text": "いずれにせよ、まずは\nフェイズⅡ完了を\n見届けなければならない。",
            "zh": "无论如何，首先必须\n见证阶段Ⅱ的\n完成才行。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "222/TALK",
            "narrator": "千羽鶴",
            "text": "というわけで、\n記録映像を見ましょ。",
            "zh": "所以，\n来看记录影像吧。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "225/SEL",
            "narrator": "",
            "text": "映像を見る\n<color=green>【高画質/75MB 4:31】</color>",
            "zh": "观看影像\n<color=green>【高画质/75MB 4:31】</color>",
            "narrator_zh": ""
        },
        {
            "location": "226/SEL",
            "narrator": "",
            "text": "映像を見\n<color=green>【標準画質/24MB 4:31】</color>",
            "zh": "观看影像\n<color=green>【标准画质/24MB 4:31】</color>",
            "narrator_zh": ""
        },
        {
            "location": "227/SEL",
            "narrator": "",
            "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>",
            "zh": "看剧情梗概报告\n<color=green>【文本汇总】</color>",
            "narrator_zh": ""
        },
        {
            "location": "228/ACT",
            "narrator": "",
            "text": "映像を見る\n<color=green>【高画質/75MB 4:31】</color>",
            "zh": "观看影像\n<color=green>【高画质/75MB 4:31】</color>",
            "narrator_zh": ""
        },
        {
            "location": "229/TALK",
            "narrator": "千羽鶴",
            "text": "わかった。",
            "zh": "好。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "235/ACT",
            "narrator": "",
            "text": "映像を見\n<color=green>【標準画質/24MB 4:31】</color>",
            "zh": "观看影像\n<color=green>【标准画质/24MB 4:31】</color>",
            "narrator_zh": ""
        },
        {
            "location": "236/TALK",
            "narrator": "千羽鶴",
            "text": "わかった。",
            "zh": "好。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "242/ACT",
            "narrator": "",
            "text": "あらすじレポートにする\n<color=green>【テキストまとめ】</color>",
            "zh": "看剧情梗概报告\n<color=green>【文本汇总】</color>",
            "narrator_zh": ""
        },
        {
            "location": "243/TALK",
            "narrator": "千羽鶴",
            "text": "わかった。",
            "zh": "好。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "276/TALK",
            "narrator": "千羽鶴",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "277/TALK",
            "narrator": "千羽鶴",
            "text": "想定外の存在が\n介入してきてる……？",
            "zh": "预想之外的存在\n介入进来了……？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "278/TALK",
            "narrator": "千羽鶴",
            "text": "まさか、“あれ”が？\nずっと監視してきて\nいたはずなんだけど。",
            "zh": "难道是“那个”？\n我明明一直都在\n监视着才对。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "279/SEL",
            "narrator": "",
            "text": "何かお困りですか？",
            "zh": "遇到什么麻烦了吗？",
            "narrator_zh": ""
        },
        {
            "location": "280/ACT",
            "narrator": "",
            "text": "何かお困りですか？",
            "zh": "遇到什么麻烦了吗？",
            "narrator_zh": ""
        },
        {
            "location": "282/TALK",
            "narrator": "千羽鶴",
            "text": "甚だしく。",
            "zh": "非常麻烦。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "283/TALK",
            "narrator": "千羽鶴",
            "text": "予定が変わった。\nフェイズⅢ移行は\n少し延期になる。",
            "zh": "计划有变。\n向阶段Ⅲ的过渡\n要稍微推迟了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "284/SEL",
            "narrator": "",
            "text": "そんなことばかりじゃない？",
            "zh": "这种事不是经常有吗？",
            "narrator_zh": ""
        },
        {
            "location": "285/SEL",
            "narrator": "",
            "text": "真幌がストを決行したのがまずかったの？",
            "zh": "是真幌坚决罢工惹的祸吗？",
            "narrator_zh": ""
        },
        {
            "location": "286/SEL",
            "narrator": "",
            "text": "音羽が歌ってたのがまずかったの？",
            "zh": "是音羽在唱歌惹的祸吗？",
            "narrator_zh": ""
        },
        {
            "location": "287/ACT",
            "narrator": "",
            "text": "そんなことばかりじゃない？",
            "zh": "这种事不是经常有吗？",
            "narrator_zh": ""
        },
        {
            "location": "288/TALK",
            "narrator": "千羽鶴",
            "text": "そうね。\n世界を動かすって\nそれくらい大変なこと。",
            "zh": "是啊。\n推动世界就是\n这么艰难的事。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "289/ACT",
            "narrator": "",
            "text": "真幌がストを決行したのがまずかったの？",
            "zh": "是真幌坚决罢工惹的祸吗？",
            "narrator_zh": ""
        },
        {
            "location": "290/TALK",
            "narrator": "千羽鶴",
            "text": "それは想定内。\n何の問題もない。",
            "zh": "那在预料之内。\n没有任何问题。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "291/ACT",
            "narrator": "",
            "text": "音羽が歌ってたのがまずかったの？",
            "zh": "是音羽在唱歌惹的祸吗？",
            "narrator_zh": ""
        },
        {
            "location": "292/TALK",
            "narrator": "千羽鶴",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "293/TALK",
            "narrator": "千羽鶴",
            "text": "そうね。貴方はとても\n鋭い。私の右腕として\n申し分ない。",
            "zh": "是啊。你非常\n敏锐。作为我的左膀右臂\n无可挑剔。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "294/TALK",
            "narrator": "千羽鶴",
            "text": "貴方の聡明さに期待して、\n少し説明する。",
            "zh": "出于对你这份聪慧的期待，\n我稍微向你说明一下。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "295/TALK",
            "narrator": "千羽鶴",
            "text": "音羽は既に\nココロが壊れている。",
            "zh": "音羽的心灵\n已经坏掉了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "296/TALK",
            "narrator": "千羽鶴",
            "text": "それは、\nクランを引き抜いただけの\n状況よりも、遙かに甚大。",
            "zh": "那比起单纯把\n库兰抽离出来的状况，\n要严重得多。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "297/TALK",
            "narrator": "千羽鶴",
            "text": "歌を唱うなど、\n本人の意志では\n絶対に無理。",
            "zh": "唱歌之类的事，\n凭她本人的意志\n绝对不可能做到。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "298/TALK",
            "narrator": "千羽鶴",
            "text": "方法はただ１つ。\n他者がココロ経由で\n何らかの支援をした。",
            "zh": "方法只有一个。\n有第三方通过心灵\n给予了某种支援。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "299/TALK",
            "narrator": "千羽鶴",
            "text": "それができる存在は\nごくごく限られている。",
            "zh": "能做到这件事的存在\n屈指可数。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "301/TALK",
            "narrator": "千羽鶴",
            "text": "申し訳無いけど、\n今回は記録映像の質問を\n受けている暇がない。",
            "zh": "虽然很抱歉，\n但这次我没有闲暇接受\n关于记录影像的提问了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "302/TALK",
            "narrator": "千羽鶴",
            "text": "すぐに準備をして\n実行しないと、後々\n厄介なことになる。",
            "zh": "要是不立刻做好准备\n付诸行动，日后就会\n变成麻烦的事。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "303/TALK",
            "narrator": "千羽鶴",
            "text": "というわけで離席。\n貴方とはまた後ほど。",
            "zh": "所以我要离席了。\n我们待会儿再见。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "304/TALK",
            "narrator": "千羽鶴",
            "text": "ココロスフィアで\n逢いましょ。",
            "zh": "在心灵领域\n再会吧。",
            "narrator_zh": "千羽鹤"
        },
