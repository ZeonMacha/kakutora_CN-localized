 "entry": [
  {
   "location": "725/TALK",
   "narrator": "アーヤ",
   "text": "……じゃあそろそろ\n行きましょう。"
  },
  {
   "location": "726/SEL",
   "narrator": "",
   "text": "どこへ？",
   "zh": "去哪儿？",
   "narrator_zh": ""
  },
  {
   "location": "727/SEL",
   "narrator": "",
   "text": "アーヤの行くところなら\nどこでも",
   "zh": "只要是绫水去的地方\n哪儿都行",
   "narrator_zh": ""
  },
  {
   "location": "728/SEL",
   "narrator": "",
   "text": "これで終わり？",
   "zh": "这样就算完了？",
   "narrator_zh": ""
  },
  {
   "location": "729/ACT",
   "narrator": "",
   "text": "どこへ？",
   "zh": "去哪儿？",
   "narrator_zh": ""
  },
  {
   "location": "730/TALK",
   "narrator": "アーヤ",
   "text": "言ってなかったっけ。"
  },
  {
   "location": "731/ACT",
   "narrator": "",
   "text": "アーヤの行くところなら\nどこでも",
   "zh": "只要是绫水去的地方\n哪儿都行",
   "narrator_zh": ""
  },
  {
   "location": "733/TALK",
   "narrator": "アーヤ",
   "text": "あなたがいないと\n意味がないもの。"
  },
  {
   "location": "734/ACT",
   "narrator": "",
   "text": "これで終わり？",
   "zh": "这样就算完了？",
   "narrator_zh": ""
  },
  {
   "location": "735/TALK",
   "narrator": "アーヤ",
   "text": "そんなわけないわ。",
   "zh": "不可能。",
   "narrator_zh": "绫水"
  },
  {
   "location": "737/TALK",
   "narrator": "アーヤ",
   "text": "二人きりで\nバイクに乗って\nハネムーン。"
  },
  {
   "location": "738/SEL",
   "narrator": "",
   "text": "ドレスで！？",
   "zh": "穿礼服！？",
   "narrator_zh": ""
  },
  {
   "location": "739/SEL",
   "narrator": "",
   "text": "そう来たか",
   "zh": "还来这一套",
   "narrator_zh": ""
  },
  {
   "location": "740/SEL",
   "narrator": "",
   "text": "タンデムで",
   "zh": "双人座",
   "narrator_zh": ""
  },
  {
   "location": "741/ACT",
   "narrator": "",
   "text": "ドレスで！？",
   "zh": "穿礼服！？",
   "narrator_zh": ""
  },
  {
   "location": "742/TALK",
   "narrator": "アーヤ",
   "text": "そうよ。",
   "zh": "是呀。",
   "narrator_zh": "绫水"
  },
  {
   "location": "743/TALK",
   "narrator": "アーヤ",
   "text": "って\n言いたいところだけど\nさすがに無理ね。",
   "zh": "虽说是想\n这么说，\n果然还是不行呢。",
   "narrator_zh": "绫水"
  },
  {
   "location": "744/TALK",
   "narrator": "アーヤ",
   "text": "一旦着替えるわ。"
  },
  {
   "location": "745/ACT",
   "narrator": "",
   "text": "そう来たか",
   "zh": "还来这一套",
   "narrator_zh": ""
  },
  {
   "location": "746/TALK",
   "narrator": "アーヤ",
   "text": "必要でしょ。"
  },
  {
   "location": "747/ACT",
   "narrator": "",
   "text": "タンデムで",
   "zh": "双人座",
   "narrator_zh": ""
  },
  {
   "location": "748/TALK",
   "narrator": "アーヤ",
   "text": "…そうね。\nタンデムで。"
  },
  {
   "location": "750/TALK",
   "narrator": "アーヤ",
   "text": "こういう時って\nやっぱり海って\n思うのよ。",
   "zh": "这种时候，果然\n还是想到海边\n呀。",
   "narrator_zh": "绫水"
  },
  {
   "location": "751/SEL",
   "narrator": "",
   "text": "海なし県民乙",
   "zh": "内陆县人路过",
   "narrator_zh": ""
  },
  {
   "location": "752/SEL",
   "narrator": "",
   "text": "わかる",
   "zh": "我懂",
   "narrator_zh": ""
  },
  {
   "location": "753/SEL",
   "narrator": "",
   "text": "ベタすぎない？",
   "zh": "是不是太老套了？",
   "narrator_zh": ""
  },
  {
   "location": "754/ACT",
   "narrator": "",
   "text": "海なし県民乙",
   "zh": "内陆县人路过",
   "narrator_zh": ""
  },
  {
   "location": "755/TALK",
   "narrator": "アーヤ",
   "text": "それは関係ないわよ。",
   "zh": "那没关系哦。",
   "narrator_zh": "绫水"
  },
  {
   "location": "756/ACT",
   "narrator": "",
   "text": "わかる",
   "zh": "我懂",
   "narrator_zh": ""
  },
  {
   "location": "757/TALK",
   "narrator": "アーヤ",
   "text": "そうでしょ！",
   "zh": "对吧！",
   "narrator_zh": "绫水"
  },
  {
   "location": "758/ACT",
   "narrator": "",
   "text": "ベタすぎない？",
   "zh": "是不是太老套了？",
   "narrator_zh": ""
  },
  {
   "location": "759/TALK",
   "narrator": "アーヤ",
   "text": "そこがいいんじゃない。",
   "zh": "那里不就好了。",
   "narrator_zh": "绫水"
  },
  {
   "location": "762/TALK",
   "narrator": "アーヤ",
   "text": "素敵な景色を\n$handle$さんと\n見たりしながら。"
  },
  {
   "location": "763/TALK",
   "narrator": "アーヤ",
   "text": "海まで行って\nそこで写真を\n撮りたいの。"
  },
  {
   "location": "764/TALK",
   "narrator": "アーヤ",
   "text": "今日は好きなものだけに\n囲まれたいから。"
  },
  {
   "location": "765/TALK",
   "narrator": "アーヤ",
   "text": "それを記念に\n残したいから。",
   "zh": "因为我想留作\n纪念。",
   "narrator_zh": "绫水"
  },
  {
   "location": "766/SEL",
   "narrator": "",
   "text": "$me$より海が好きなの？",
   "zh": "你比$me$还喜欢海？",
   "narrator_zh": ""
  },
  {
   "location": "767/SEL",
   "narrator": "",
   "text": "アーヤらしいね",
   "zh": "很有绫水的风格",
   "narrator_zh": ""
  },
  {
   "location": "768/SEL",
   "narrator": "",
   "text": "この先も記念を\nいっぱい作ろうよ",
   "zh": "以后也一起\n留下好多纪念吧",
   "narrator_zh": ""
  },
  {
   "location": "769/ACT",
   "narrator": "",
   "text": "$me$より海が好きなの？",
   "zh": "你比$me$还喜欢海？",
   "narrator_zh": ""
  },
  {
   "location": "770/TALK",
   "narrator": "アーヤ",
   "text": "そんなわけないでしょ。",
   "zh": "不可能吧。",
   "narrator_zh": "绫水"
  },
  {
   "location": "771/ACT",
   "narrator": "",
   "text": "アーヤらしいね",
   "zh": "很有绫水的风格",
   "narrator_zh": ""
  },
  {
   "location": "772/TALK",
   "narrator": "アーヤ",
   "text": "…そう？"
  },
  {
   "location": "773/ACT",
   "narrator": "",
   "text": "この先も記念を\nいっぱい作ろうよ",
   "zh": "以后也一起\n留下好多纪念吧",
   "narrator_zh": ""
  },
  {
   "location": "774/TALK",
   "narrator": "アーヤ",
   "text": "そうね。\n作りましょう。",
   "zh": "是啊。\n做吧。",
   "narrator_zh": "绫水"
  },
  {
   "location": "787/TALK",
   "narrator": "アーヤ",
   "text": "荷物は大丈夫。"
  },
  {
   "location": "788/TALK",
   "narrator": "アーヤ",
   "text": "天気だっていいし。"
  },
  {
   "location": "789/TALK",
   "narrator": "アーヤ",
   "text": "地図も確認した。"
  },
  {
   "location": "790/TALK",
   "narrator": "アーヤ",
   "text": "じゃあ出発\nしましょうか。"
  },
  {
   "location": "791/SEL",
   "narrator": "",
   "text": "バイクに缶から\n付けないの？",
   "zh": "不先给摩托\n装个罐子吗？",
   "narrator_zh": ""
  },
  {
   "location": "792/SEL",
   "narrator": "",
   "text": "いつもと同じじゃない？",
   "zh": "不就跟平时一样吗？",
   "narrator_zh": ""
  },
  {
   "location": "793/SEL",
   "narrator": "",
   "text": "愛の逃避行だね",
   "zh": "是爱的私奔呢",
   "narrator_zh": ""
  },
  {
   "location": "794/ACT",
   "narrator": "",
   "text": "バイクに缶から\n付けないの？",
   "zh": "不先给摩托\n装个罐子吗？",
   "narrator_zh": ""
  },
  {
   "location": "795/TALK",
   "narrator": "アーヤ",
   "text": "公道は走れないもの。"
  },
  {
   "location": "796/SEL",
   "narrator": "",
   "text": "ですよねー",
   "zh": "就是说呀——",
   "narrator_zh": ""
  },
  {
   "location": "797/SEL",
   "narrator": "",
   "text": "する気だったんだ？",
   "zh": "原来你打算做？",
   "narrator_zh": ""
  },
  {
   "location": "798/ACT",
   "narrator": "",
   "text": "ですよねー",
   "zh": "就是说呀——",
   "narrator_zh": ""
  },
  {
   "location": "799/TALK",
   "narrator": "アーヤ",
   "text": "残念よね。"
  },
  {
   "location": "800/ACT",
   "narrator": "",
   "text": "する気だったんだ？",
   "zh": "原来你打算做？",
   "narrator_zh": ""
  },
  {
   "location": "801/TALK",
   "narrator": "アーヤ",
   "text": "…せっかくだから\nちょっとね…。"
  },
  {
   "location": "803/ACT",
   "narrator": "",
   "text": "いつもと同じじゃない？",
   "zh": "不就跟平时一样吗？",
   "narrator_zh": ""
  },
  {
   "location": "804/TALK",
   "narrator": "アーヤ",
   "text": "違うわよ。\nハネムーンよ。"
  },
  {
   "location": "805/SEL",
   "narrator": "",
   "text": "気持ちの問題だよね",
   "zh": "是心意的问题呢",
   "narrator_zh": ""
  },
  {
   "location": "806/SEL",
   "narrator": "",
   "text": "アーヤはいつもより\nきれいかな",
   "zh": "绫水好像比平时\n更漂亮了",
   "narrator_zh": ""
  },
  {
   "location": "807/ACT",
   "narrator": "",
   "text": "気持ちの問題だよね",
   "zh": "是心意的问题呢",
   "narrator_zh": ""
  },
  {
   "location": "808/TALK",
   "narrator": "アーヤ",
   "text": "そうよ。\nハネムーンだから。",
   "zh": "对啊。\n因为是蜜月。",
   "narrator_zh": "绫水"
  },
  {
   "location": "809/ACT",
   "narrator": "",
   "text": "アーヤはいつもより\nきれいかな",
   "zh": "绫水好像比平时\n更漂亮了",
   "narrator_zh": ""
  },
  {
   "location": "810/TALK",
   "narrator": "アーヤ",
   "text": "もう！",
   "zh": "真是！",
   "narrator_zh": "绫水"
  },
  {
   "location": "812/ACT",
   "narrator": "",
   "text": "愛の逃避行だね",
   "zh": "是爱的私奔呢",
   "narrator_zh": ""
  },
  {
   "location": "813/TALK",
   "narrator": "アーヤ",
   "text": "退廃的ね…\nちょっと格好いいけど。"
  },
  {
   "location": "814/SEL",
   "narrator": "",
   "text": "来世で幸せになろう",
   "zh": "下辈子一起幸福吧",
   "narrator_zh": ""
  },
  {
   "location": "815/SEL",
   "narrator": "",
   "text": "この世界に二人きり",
   "zh": "这世界里只有我们两个",
   "narrator_zh": ""
  },
  {
   "location": "816/SEL",
   "narrator": "",
   "text": "何人にもこの愛は\n止められない",
   "zh": "这份爱谁也\n阻止不了",
   "narrator_zh": ""
  },
  {
   "location": "817/ACT",
   "narrator": "",
   "text": "来世で幸せになろう",
   "zh": "下辈子一起幸福吧",
   "narrator_zh": ""
  },
  {
   "location": "818/TALK",
   "narrator": "アーヤ",
   "text": "それは約束できないわ。",
   "zh": "那个我没法保证。",
   "narrator_zh": "绫水"
  },
  {
   "location": "819/TALK",
   "narrator": "アーヤ",
   "text": "だって今幸せなんだもの。",
   "zh": "因为我现在很幸福。",
   "narrator_zh": "绫水"
  },
  {
   "location": "820/ACT",
   "narrator": "",
   "text": "この世界に二人きり",
   "zh": "这世界里只有我们两个",
   "narrator_zh": ""
  },
  {
   "location": "821/TALK",
   "narrator": "アーヤ",
   "text": "ずっとそれだと\n少しさみしいわ。"
  },
  {
   "location": "822/TALK",
   "narrator": "アーヤ",
   "text": "そんな瞬間は\n必要だと思うけど。",
   "zh": "我觉得那种瞬间\n是需要的。",
   "narrator_zh": "绫水"
  },
  {
   "location": "823/ACT",
   "narrator": "",
   "text": "何人にもこの愛は\n止められない",
   "zh": "这份爱谁也\n阻止不了",
   "narrator_zh": ""
  },
  {
   "location": "824/TALK",
   "narrator": "アーヤ",
   "text": "…人に言うことでも\nないわ。",
   "zh": "……也不是能对\n别人说的事。",
   "narrator_zh": "绫水"
  },
  {
   "location": "825/TALK",
   "narrator": "アーヤ",
   "text": "お互いがそう思っていれば\nそれでいいと思うの。",
   "zh": "只要彼此都这么想，\n我觉得就够了。",
   "narrator_zh": "绫水"
  },
  {
   "location": "832/TALK",
   "narrator": "アーヤ",
   "text": "ちょっと休憩。",
   "zh": "稍微休息一下。",
   "narrator_zh": "绫水"
  },
  {
   "location": "833/TALK",
   "narrator": "アーヤ",
   "text": "今日はお弁当を\n作ってきたのよ。"
  },
  {
   "location": "834/TALK",
   "narrator": "アーヤ",
   "text": "一口サイズの\nサンドイッチと\n野菜スティック。"
  },
  {
   "location": "835/TALK",
   "narrator": "アーヤ",
   "text": "フルーツも\n一口サイズに\nしてみたわ。"
  },
  {
   "location": "836/TALK",
   "narrator": "アーヤ",
   "text": "それからスープ。\nスープジャーって\n便利ね。",
   "zh": "然后是汤。\n焖烧罐真\n方便呢。",
   "narrator_zh": "绫水"
  },
  {
   "location": "837/SEL",
   "narrator": "",
   "text": "大変じゃなかった？",
   "zh": "是不是很辛苦？",
   "narrator_zh": ""
  },
  {
   "location": "838/SEL",
   "narrator": "",
   "text": "いいなー！",
   "zh": "真好啊——！",
   "narrator_zh": ""
  },
  {
   "location": "839/SEL",
   "narrator": "",
   "text": "$me$も食べたい！",
   "zh": "$me$也想吃！",
   "narrator_zh": ""
  },
  {
   "location": "840/ACT",
   "narrator": "",
   "text": "大変じゃなかった？",
   "zh": "是不是很辛苦？",
   "narrator_zh": ""
  },
  {
   "location": "842/TALK",
   "narrator": "アーヤ",
   "text": "せっかくだから\n張り切ったの。"
  },
  {
   "location": "843/ACT",
   "narrator": "",
   "text": "いいなー！",
   "zh": "真好啊——！",
   "narrator_zh": ""
  },
  {
   "location": "845/TALK",
   "narrator": "アーヤ",
   "text": "ふふふ。\n頑張ったわ。"
  },
  {
   "location": "846/ACT",
   "narrator": "",
   "text": "$me$も食べたい！",
   "zh": "$me$也想吃！",
   "narrator_zh": ""
  },
  {
   "location": "847/TALK",
   "narrator": "アーヤ",
   "text": "…会えた時は\n絶対食べてね。",
   "zh": "……见面的时候\n一定要吃哦。",
   "narrator_zh": "绫水"
  },
  {
   "location": "849/TALK",
   "narrator": "アーヤ",
   "text": "…そんなに凝ったもの\n作ったわけじゃ\nないけど。"
  },
  {
   "location": "850/TALK",
   "narrator": "アーヤ",
   "text": "我ながらなかなか\nいい出来よ。"
  },
  {
   "location": "851/TALK",
   "narrator": "アーヤ",
   "text": "見た目もいいし、\nおいしいし。"
  },
  {
   "location": "852/TALK",
   "narrator": "アーヤ",
   "text": "何より特別なお弁当って\n感じがするし。"
  },
  {
   "location": "853/TALK",
   "narrator": "アーヤ",
   "text": "外で食べると\nいつもよりちょっと\n美味しいって思うの。"
  },
  {
   "location": "854/TALK",
   "narrator": "アーヤ",
   "text": "これって何なのかしら？",
   "zh": "这到底是什么呢？",
   "narrator_zh": "绫水"
  },
  {
   "location": "855/SEL",
   "narrator": "",
   "text": "空気の違い",
   "zh": "空气不一样",
   "narrator_zh": ""
  },
  {
   "location": "856/SEL",
   "narrator": "",
   "text": "割れ窓理論",
   "zh": "破窗理论",
   "narrator_zh": ""
  },
  {
   "location": "857/SEL",
   "narrator": "",
   "text": "景色も味のうち",
   "zh": "景色也算味道的一部分",
   "narrator_zh": ""
  },
  {
   "location": "858/ACT",
   "narrator": "",
   "text": "空気の違い",
   "zh": "空气不一样",
   "narrator_zh": ""
  },
  {
   "location": "859/TALK",
   "narrator": "アーヤ",
   "text": "それはあるかもね。",
   "zh": "那也许有呢。",
   "narrator_zh": "绫水"
  },
  {
   "location": "860/ACT",
   "narrator": "",
   "text": "割れ窓理論",
   "zh": "破窗理论",
   "narrator_zh": ""
  },
  {
   "location": "861/TALK",
   "narrator": "アーヤ",
   "text": "それ絶対違うから。",
   "zh": "那绝对不对。",
   "narrator_zh": "绫水"
  },
  {
   "location": "862/ACT",
   "narrator": "",
   "text": "景色も味のうち",
   "zh": "景色也算味道的一部分",
   "narrator_zh": ""
  },
  {
   "location": "863/TALK",
   "narrator": "アーヤ",
   "text": "そうね。\nそういうことよね。",
   "zh": "是啊。\n就是这么回事呢。",
   "narrator_zh": "绫水"
  },
