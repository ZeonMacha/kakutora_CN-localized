        "title": "らぶとーく 第31話",
        "sub_title": "ザ・ショウ・マスト・ゴー・オン",
        "title_zh": "恋爱漫谈 第31话",
        "sub_title_zh": "演出必须继续"
    },
    "entry": [
        {
            "location": "146/SCENARIO",
            "narrator": "",
            "text": "ザ・ショウ・マスト・ゴー・オン",
            "zh": "演出必须继续",
            "narrator_zh": ""
        },
        {
            "location": "166/TALK",
            "narrator": "みやび",
            "text": "…ああ。\nここの関数が\nおかしい。",
            "zh": "……啊。\n这里的函数\n有问题。",
            "narrator_zh": "雅"
        },
        {
            "location": "167/TALK",
            "narrator": "みやび",
            "text": "ここの参照元を\n変えんと正しい\n結果は出んぞね。",
            "zh": "这里的参照源不\n改一下，是不会得出\n正确结果的咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "169/TALK",
            "narrator": "繭",
            "text": "うわ、本当ですね。\nなんで気がつかなかったん\nだろ…。",
            "zh": "哇，真的诶。\n为什么之前\n没发现呢……。",
            "narrator_zh": "茧"
        },
        {
            "location": "171/TALK",
            "narrator": "みやび",
            "text": "いいところまでは\nいってたと思うぞね。",
            "zh": "在那之前，\n思路我觉得都还挺对的咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "172/TALK",
            "narrator": "みやび",
            "text": "それに結果が\nおかしいと勘付けたのも\n中々ええ。",
            "zh": "而且察觉到结果\n不对劲，这一点\n也很不错。",
            "narrator_zh": "雅"
        },
        {
            "location": "173/TALK",
            "narrator": "みやび",
            "text": "バグがあるとエラーを\n出して止まるという\n先入観があるから。",
            "zh": "因为人们总有个先入之见，\n觉得出了bug\n就会报错停机。",
            "narrator_zh": "雅"
        },
        {
            "location": "174/TALK",
            "narrator": "みやび",
            "text": "動いてるというだけで\n安心する人は\n意外と多いぞね。",
            "zh": "光看到还在跑\n就放心的人，\n意外地多咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "176/TALK",
            "narrator": "繭",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "茧"
        },
        {
            "location": "177/TALK",
            "narrator": "繭",
            "text": "褒められてる、と\n思うことにします。",
            "zh": "我就当作\n是在夸我吧。",
            "narrator_zh": "茧"
        },
        {
            "location": "179/TALK",
            "narrator": "みやび",
            "text": "うちはお世辞は\n言わんけどねえ。",
            "zh": "不过我可是\n不说恭维话的咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "189/TALK",
            "narrator": "みやび",
            "text": "光月繭",
            "zh": "光月茧",
            "narrator_zh": "雅"
        },
        {
            "location": "190/TALK",
            "narrator": "みやび",
            "text": "彼女のプライドは如何ほどか",
            "zh": "她的自尊心有几分呢",
            "narrator_zh": "雅"
        },
        {
            "location": "192/SEL",
            "narrator": "",
            "text": "怒らせたの？",
            "zh": "你惹她生气了？",
            "narrator_zh": ""
        },
        {
            "location": "193/SEL",
            "narrator": "",
            "text": "みやびならわかるでしょ",
            "zh": "雅应该懂吧",
            "narrator_zh": ""
        },
        {
            "location": "194/SEL",
            "narrator": "",
            "text": "女王様クラス",
            "zh": "女王班",
            "narrator_zh": ""
        },
        {
            "location": "195/ACT",
            "narrator": "",
            "text": "怒らせたの？",
            "zh": "你惹她生气了？",
            "narrator_zh": ""
        },
        {
            "location": "196/TALK",
            "narrator": "みやび",
            "text": "というか",
            "zh": "或者说",
            "narrator_zh": "雅"
        },
        {
            "location": "197/TALK",
            "narrator": "みやび",
            "text": "失望させた感",
            "zh": "感觉是让她失望了",
            "narrator_zh": "雅"
        },
        {
            "location": "198/ACT",
            "narrator": "",
            "text": "みやびならわかるでしょ",
            "zh": "雅应该懂吧",
            "narrator_zh": ""
        },
        {
            "location": "199/TALK",
            "narrator": "みやび",
            "text": "わからんから",
            "zh": "就是因为不懂",
            "narrator_zh": "雅"
        },
        {
            "location": "200/TALK",
            "narrator": "みやび",
            "text": "聞いておるのだ",
            "zh": "才问的咧",
            "narrator_zh": "雅"
        },
        {
            "location": "201/TALK",
            "narrator": "みやび",
            "text": "ばかちんが",
            "zh": "这笨蛋",
            "narrator_zh": "雅"
        },
        {
            "location": "202/ACT",
            "narrator": "",
            "text": "女王様クラス",
            "zh": "女王班",
            "narrator_zh": ""
        },
        {
            "location": "203/TALK",
            "narrator": "みやび",
            "text": "現代日本の女王は特殊職の名称",
            "zh": "现代日本的女王是特殊职业的名称",
            "narrator_zh": "雅"
        },
        {
            "location": "204/TALK",
            "narrator": "みやび",
            "text": "身分ではない",
            "zh": "不是身份",
            "narrator_zh": "雅"
        },
        {
            "location": "205/TALK",
            "narrator": "みやび",
            "text": "そこをわかっておるのか？",
            "zh": "那点你明白嘛？",
            "narrator_zh": "雅"
        },
        {
            "location": "213/TALK",
            "narrator": "みやび",
            "text": "…今回の結果は\nどうなったかいね。",
            "zh": "……这次的结果\n怎么样了咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "214/TALK",
            "narrator": "繭",
            "text": "問題ない、と\n思います。",
            "zh": "我觉得\n没有问题。",
            "narrator_zh": "茧"
        },
        {
            "location": "215/TALK",
            "narrator": "みやび",
            "text": "あとは関連箇所の\n確認か。",
            "zh": "接下来就是\n确认相关位置了。",
            "narrator_zh": "雅"
        },
        {
            "location": "217/TALK",
            "narrator": "みやび",
            "text": "それにしても\n素直でわかりやすい\nええコードや。",
            "zh": "不过话说回来，\n那份坦率又好懂，\n是不错的代码咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "219/TALK",
            "narrator": "繭",
            "text": "みやび先輩って。",
            "zh": "说到雅前辈啊。",
            "narrator_zh": "茧"
        },
        {
            "location": "220/TALK",
            "narrator": "繭",
            "text": "プログラムのこと\n人格があるみたいに\n言うんですね。",
            "zh": "说起程序来，\n就像它们有人格\n一样呢。",
            "narrator_zh": "茧"
        },
        {
            "location": "221/TALK",
            "narrator": "みやび",
            "text": "…光月さんは\nそうは思わんのかね。",
            "zh": "……光月小姐\n没这么想嘛？",
            "narrator_zh": "雅"
        },
        {
            "location": "222/TALK",
            "narrator": "繭",
            "text": "…好きなものを\n恋人に例える人\nいますけど。",
            "zh": "……有人会把喜欢的\n东西比作\n恋人呢。",
            "narrator_zh": "茧"
        },
        {
            "location": "223/TALK",
            "narrator": "繭",
            "text": "私は恋人は\n欲しくないので。",
            "zh": "毕竟我并不\n想要恋人。",
            "narrator_zh": "茧"
        },
        {
            "location": "224/TALK",
            "narrator": "みやび",
            "text": "いたらいたで\nいいもんかも\nしれんろう。",
            "zh": "真有了的话，\n或许也不坏\n咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "225/TALK",
            "narrator": "繭",
            "text": "みやび先輩、\nいるんですか？\n気になる人。",
            "zh": "雅前辈，\n有吗？\n在意的人。",
            "narrator_zh": "茧"
        },
        {
            "location": "227/TALK",
            "narrator": "みやび",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "雅"
        },
        {
            "location": "240/TALK",
            "narrator": "みやび",
            "text": "いや。\n別におらんよ。",
            "zh": "不。\n倒也没有哦。",
            "narrator_zh": "雅"
        },
        {
            "location": "241/TALK",
            "narrator": "みやび",
            "text": "……そんな人は。",
            "zh": "……那种人啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "249/TALK",
            "narrator": "みやび",
            "text": "せいや",
            "zh": "好啦。",
            "narrator_zh": "雅"
        },
        {
            "location": "252/TALK",
            "narrator": "ボイスメール",
            "text": "あえて言っておくが",
            "zh": "我偏要说在前面",
            "narrator_zh": "语音信箱"
        },
        {
            "location": "154/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>某月某日　0:14 PM</color>\nとある平日の昼休み、学園学食にて。",
            "zh": "<color=green>某月某日　0:14 PM</color>\n某个平日的午休，学园食堂。",
            "narrator_zh": "Dialog_EventData"
        },
        {
            "location": "264/DIALOG",
            "narrator": "Dialog_GETVoice",
            "text": "<color=green>【みやび】</color>のボイスメール\n<color=red>【あえて言っておくが】</color>\nをゲットしました！",
            "zh": "<color=green>【雅】</color>的语音信箱\n<color=red>【我偏要说在前面】</color>\n拿到了！",
            "narrator_zh": "Dialog_GETVoice"
        }
    ]
}
