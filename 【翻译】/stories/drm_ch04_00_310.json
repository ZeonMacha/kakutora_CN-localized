{
 "dir": "dramatics/daydra/drm_ch04_00_310.js",
 "type": "Episode",
 "info": {
  "story_id": "4031",
  "cid": "miyabi",
  "title": "らぶとーく 第31話",
  "sub_title": "ザ・ショウ・マスト・ゴー・オン"
 },
 "entry": [
  {
   "location": "146/SCENARIO",
   "narrator": "",
   "text": "ザ・ショウ・マスト・ゴー・オン"
  },
  {
   "location": "166/TALK",
   "narrator": "みやび",
   "text": "…ああ。\nここの関数が\nおかしい。"
  },
  {
   "location": "167/TALK",
   "narrator": "みやび",
   "text": "ここの参照元を\n変えんと正しい\n結果は出んぞね。",
   "zh": "这里的参照源不\n改一下，是不会得出\n正确结果的咯。",
   "narrator_zh": "雅"
  },
  {
   "location": "169/TALK",
   "narrator": "繭",
   "text": "うわ、本当ですね。\nなんで気がつかなかったん\nだろ…。"
  },
  {
   "location": "171/TALK",
   "narrator": "みやび",
   "text": "いいところまでは\nいってたと思うぞね。"
  },
  {
   "location": "172/TALK",
   "narrator": "みやび",
   "text": "それに結果が\nおかしいと勘付けたのも\n中々ええ。",
   "zh": "而且察觉到结果\n不对劲，这一点\n也很不错。",
   "narrator_zh": "雅"
  },
  {
   "location": "173/TALK",
   "narrator": "みやび",
   "text": "バグがあるとエラーを\n出して止まるという\n先入観があるから。"
  },
  {
   "location": "174/TALK",
   "narrator": "みやび",
   "text": "動いてるというだけで\n安心する人は\n意外と多いぞね。"
  },
  {
   "location": "176/TALK",
   "narrator": "繭",
   "text": "……。"
  },
  {
   "location": "177/TALK",
   "narrator": "繭",
   "text": "褒められてる、と\n思うことにします。"
  },
  {
   "location": "179/TALK",
   "narrator": "みやび",
   "text": "うちはお世辞は\n言わんけどねえ。"
  },
  {
   "location": "189/TALK",
   "narrator": "みやび",
   "text": "光月繭"
  },
  {
   "location": "190/TALK",
   "narrator": "みやび",
   "text": "彼女のプライドは如何ほどか"
  },
  {
   "location": "192/SEL",
   "narrator": "",
   "text": "怒らせたの？",
   "zh": "你惹她生气了？",
   "narrator_zh": ""
  },
  {
   "location": "193/SEL",
   "narrator": "",
   "text": "みやびならわかるでしょ",
   "zh": "雅应该懂吧",
   "narrator_zh": ""
  },
  {
   "location": "194/SEL",
   "narrator": "",
   "text": "女王様クラス",
   "zh": "女王班",
   "narrator_zh": ""
  },
  {
   "location": "195/ACT",
   "narrator": "",
   "text": "怒らせたの？",
   "zh": "你惹她生气了？",
   "narrator_zh": ""
  },
  {
   "location": "196/TALK",
   "narrator": "みやび",
   "text": "というか",
   "zh": "或者说",
   "narrator_zh": "雅"
  },
  {
   "location": "197/TALK",
   "narrator": "みやび",
   "text": "失望させた感"
  },
  {
   "location": "198/ACT",
   "narrator": "",
   "text": "みやびならわかるでしょ",
   "zh": "雅应该懂吧",
   "narrator_zh": ""
  },
  {
   "location": "199/TALK",
   "narrator": "みやび",
   "text": "わからんから"
  },
  {
   "location": "200/TALK",
   "narrator": "みやび",
   "text": "聞いておるのだ",
   "zh": "我听说咯",
   "narrator_zh": "雅"
  },
  {
   "location": "201/TALK",
   "narrator": "みやび",
   "text": "ばかちんが",
   "zh": "这笨蛋",
   "narrator_zh": "雅"
  },
  {
   "location": "202/ACT",
   "narrator": "",
   "text": "女王様クラス",
   "zh": "女王班",
   "narrator_zh": ""
  },
  {
   "location": "203/TALK",
   "narrator": "みやび",
   "text": "現代日本の女王は特殊職の名称"
  },
  {
   "location": "204/TALK",
   "narrator": "みやび",
   "text": "身分ではない"
  },
  {
   "location": "205/TALK",
   "narrator": "みやび",
   "text": "そこをわかっておるのか？",
   "zh": "那点你明白嘛？",
   "narrator_zh": "雅"
  },
  {
   "location": "213/TALK",
   "narrator": "みやび",
   "text": "…今回の結果は\nどうなったかいね。",
   "zh": "……这次的结果\n到底怎么样了嘛。",
   "narrator_zh": "雅"
  },
  {
   "location": "214/TALK",
   "narrator": "繭",
   "text": "問題ない、と\n思います。"
  },
  {
   "location": "215/TALK",
   "narrator": "みやび",
   "text": "あとは関連箇所の\n確認か。"
  },
  {
   "location": "217/TALK",
   "narrator": "みやび",
   "text": "それにしても\n素直でわかりやすい\nええコードや。",
   "zh": "不过话说回来，\n那份坦率又好懂，\n是不错的代码咯。",
   "narrator_zh": "雅"
  },
  {
   "location": "219/TALK",
   "narrator": "繭",
   "text": "みやび先輩って。"
  },
  {
   "location": "220/TALK",
   "narrator": "繭",
   "text": "プログラムのこと\n人格があるみたいに\n言うんですね。"
  },
  {
   "location": "221/TALK",
   "narrator": "みやび",
   "text": "…光月さんは\nそうは思わんのかね。",
   "zh": "……光月小姐\n不这么想吗？",
   "narrator_zh": "雅"
  },
  {
   "location": "222/TALK",
   "narrator": "繭",
   "text": "…好きなものを\n恋人に例える人\nいますけど。",
   "zh": "……有人会把喜欢的\n东西比作\n恋人呢。",
   "narrator_zh": "茧"
  },
  {
   "location": "223/TALK",
   "narrator": "繭",
   "text": "私は恋人は\n欲しくないので。"
  },
  {
   "location": "224/TALK",
   "narrator": "みやび",
   "text": "いたらいたで\nいいもんかも\nしれんろう。"
  },
  {
   "location": "225/TALK",
   "narrator": "繭",
   "text": "みやび先輩、\nいるんですか？\n気になる人。"
  },
  {
   "location": "227/TALK",
   "narrator": "みやび",
   "text": "……。"
  },
  {
   "location": "240/TALK",
   "narrator": "みやび",
   "text": "いや。\n別におらんよ。"
  },
  {
   "location": "241/TALK",
   "narrator": "みやび",
   "text": "……そんな人は。"
  },
  {
   "location": "249/TALK",
   "narrator": "みやび",
   "text": "せいや"
  },
  {
   "location": "252/TALK",
   "narrator": "ボイスメール",
   "text": "あえて言っておくが"
  },
  {
   "location": "154/DIALOG",
   "narrator": "Dialog_EventData",
   "text": "<color=green>某月某日　0:14 PM</color>\nとある平日の昼休み、学園学食にて。"
  },
  {
   "location": "264/DIALOG",
   "narrator": "Dialog_GETVoice",
   "text": "<color=green>【みやび】</color>のボイスメール\n<color=red>【あえて言っておくが】</color>\nをゲットしました！"
  }
 ]
}
