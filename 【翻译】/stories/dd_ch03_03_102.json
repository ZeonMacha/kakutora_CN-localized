{
 "dir": "chap03/daydra/dd_ch03_03_102.js",
 "type": "MainStory",
 "info": {
  "story_id": "3304",
  "cid": "gabriella",
  "title": "004 メインストーリー",
  "sub_title": "ガブリエラという存在＜後編＞",
  "title_zh": "004 主线剧情",
  "sub_title_zh": "名为加布里埃拉的存在＜后篇＞"
 },
 "entry": [
  {
   "location": "458/SCENARIO",
   "narrator": "",
   "text": "ガブリエラという存在",
   "zh": "名为加布里埃拉的存在",
   "narrator_zh": ""
  },
  {
   "location": "483/TALK",
   "narrator": "千羽鶴",
   "text": "現実世界へ\nおかえりなさい。",
   "zh": "欢迎回到\n现实世界。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "484/TALK",
   "narrator": "千羽鶴",
   "text": "貴方が彼女のココロの中で\n奮闘してくれたお陰で、\n彼女の心は安定した。",
   "zh": "多亏你在她的心中\n奋战，\n她的心稳定了。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "485/TALK",
   "narrator": "千羽鶴",
   "text": "あとは貴方から直接、\n彼女にアドバイスをして、\n背中を一押しするだけ。",
   "zh": "剩下的，只要你直接\n给她建议，\n再推她一把。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "486/TALK",
   "narrator": "千羽鶴",
   "text": "さて、\nその方法だけど。",
   "zh": "那么，\n方法是这样。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "492/TALK",
   "narrator": "千羽鶴",
   "text": "WAVEというチャット\nツールのシステムを\n作ってみた。",
   "zh": "我做了个\n叫WAVE的聊天\n工具系统。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "493/TALK",
   "narrator": "千羽鶴",
   "text": "あなたの世界にも、\n似たものがあるかも\nしれないけど。",
   "zh": "你的世界里，\n也许也有\n类似的东西。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "494/TALK",
   "narrator": "千羽鶴",
   "text": "そして、彼女のWAVEに\nあなたを登録して\nおいた。",
   "zh": "然后，我已经把你\n登记进她的WAVE\n了。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "495/SEL",
   "narrator": "",
   "text": "なるほど",
   "zh": "原来如此",
   "narrator_zh": ""
  },
  {
   "location": "496/ACT",
   "narrator": "",
   "text": "なるほど",
   "zh": "原来如此",
   "narrator_zh": ""
  },
  {
   "location": "498/TALK",
   "narrator": "千羽鶴",
   "text": "でも「bot」として\nだけど。",
   "zh": "不过是作为“bot”\n而已。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "499/SEL",
   "narrator": "",
   "text": "なんでBot！？",
   "zh": "为什么是Bot！？",
   "narrator_zh": ""
  },
  {
   "location": "500/ACT",
   "narrator": "",
   "text": "なんでBot！？",
   "zh": "为什么是Bot！？",
   "narrator_zh": ""
  },
  {
   "location": "502/TALK",
   "narrator": "千羽鶴",
   "text": "いきなり知らない人が\nフレンド登録されて\nいたらまずいでしょう。",
   "zh": "要是突然被\n不认识的人加为好友，\n不太好吧。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "503/SEL",
   "narrator": "",
   "text": "そんなところにリアリティを持たせなくても",
   "zh": "那种地方没必要搞得那么有真实感",
   "narrator_zh": ""
  },
  {
   "location": "504/ACT",
   "narrator": "",
   "text": "そんなところにリアリティを持たせなくても",
   "zh": "那种地方没必要搞得那么有真实感",
   "narrator_zh": ""
  },
  {
   "location": "506/TALK",
   "narrator": "千羽鶴",
   "text": "「あなた」は「あなた」\nなんだから。",
   "zh": "“你”就是“你”，\n本来就是这样。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "507/TALK",
   "narrator": "千羽鶴",
   "text": "幼馴染み設定とか、\nそんな都合のいい\nものはないから。",
   "zh": "青梅竹马设定之类，\n那么方便的东西\n是没有的。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "508/TALK",
   "narrator": "千羽鶴",
   "text": "そこはリアリティを\n持って欲しい。",
   "zh": "这一点，\n希望你讲究真实。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "509/TALK",
   "narrator": "千羽鶴",
   "text": "そういうわけだから、\n彼女からの抵抗は\nあまり無いはず。",
   "zh": "所以，\n她应该不会\n怎么抗拒。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "510/SEL",
   "narrator": "",
   "text": "でもBotじゃねえ…",
   "zh": "可是Bot也太……",
   "narrator_zh": ""
  },
  {
   "location": "511/ACT",
   "narrator": "",
   "text": "でもBotじゃねえ…",
   "zh": "可是Bot也太……",
   "narrator_zh": ""
  },
  {
   "location": "513/TALK",
   "narrator": "千羽鶴",
   "text": "私はあくまで\n自然な出逢いと機会を\n与えただけ。",
   "zh": "我只是给了\n一次自然的相遇\n和机会。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "514/TALK",
   "narrator": "千羽鶴",
   "text": "どう運用するかは\nあなたが決めていい。",
   "zh": "怎么运用，\n由你来决定。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "515/TALK",
   "narrator": "千羽鶴",
   "text": "すぐに「bot」では\nないと伝えてもいいし、\nそのままでもいい。",
   "zh": "你可以马上说\n自己不是“bot”，\n也可以维持原样。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "516/TALK",
   "narrator": "千羽鶴",
   "text": "そこはあなたの\nセンスに任せる。",
   "zh": "这点\n交给你的品味。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "520/TALK",
   "narrator": "千羽鶴",
   "text": "さあ、彼女の新しい物語が\n始まろうとしている。",
   "zh": "来，她的新故事\n就要开始了。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "521/TALK",
   "narrator": "千羽鶴",
   "text": "チャットツールWAVEを\n使って、彼女を支えて\nいってほしい。",
   "zh": "请用聊天工具WAVE，\n去支持她\n走下去。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "534/TALK",
   "narrator": "ガブリエラ",
   "text": "落ち着いて！\n集中しなくちゃ…！",
   "zh": "冷静！\n必须集中精神……！",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "535/TALK",
   "narrator": "ガブリエラ",
   "text": "…………。",
   "zh": "…………。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "537/TALK",
   "narrator": "ガブリエラ",
   "text": "…あ、あれ？",
   "zh": "……啊、咦？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "540/TALK",
   "narrator": "ガブリエラ",
   "text": "なんか、急に気持ちが\n落ち着いて――。",
   "zh": "总觉得，心情忽然\n平静下来——。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "541/SEL",
   "narrator": "",
   "text": "どう？　落ち着いた？",
   "zh": "怎么样？　平静了吗？",
   "narrator_zh": ""
  },
  {
   "location": "542/ACT",
   "narrator": "",
   "text": "どう？　落ち着いた？",
   "zh": "怎么样？　平静了吗？",
   "narrator_zh": ""
  },
  {
   "location": "550/TALK",
   "narrator": "ガブリエラ",
   "text": "わっ！？\nだ、誰よ、こんな時に――",
   "zh": "哇！？\n是、是谁啊，这种时候——",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "562/TALK",
   "narrator": "ガブリエラ",
   "text": "え？　何これ…。\nBot？",
   "zh": "诶？　这是什么……。\nBot？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "563/TALK",
   "narrator": "ガブリエラ",
   "text": "Botって何？",
   "zh": "Bot是什么？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "564/TALK",
   "narrator": "ガブリエラ",
   "text": "そんな機能あったかしら？",
   "zh": "有这种功能吗？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "566/SEL",
   "narrator": "",
   "text": "今日からお世話になります",
   "zh": "从今天起请多关照",
   "narrator_zh": ""
  },
  {
   "location": "567/ACT",
   "narrator": "",
   "text": "今日からお世話になります",
   "zh": "从今天起请多关照",
   "narrator_zh": ""
  },
  {
   "location": "573/TALK",
   "narrator": "ガブリエラ",
   "text": "？",
   "zh": "？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "574/TALK",
   "narrator": "ガブリエラ",
   "text": "意味が分からない",
   "zh": "看不懂",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "575/TALK",
   "narrator": "ガブリエラ",
   "text": "説明してよ",
   "zh": "你解释一下",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "577/SEL",
   "narrator": "",
   "text": "心が落ち着いたのわかる？",
   "zh": "能感觉到心平静下来了吗？",
   "narrator_zh": ""
  },
  {
   "location": "578/ACT",
   "narrator": "",
   "text": "心が落ち着いたのわかる？",
   "zh": "能感觉到心平静下来了吗？",
   "narrator_zh": ""
  },
  {
   "location": "580/TALK",
   "narrator": "ガブリエラ",
   "text": "え？",
   "zh": "诶？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "581/TALK",
   "narrator": "ガブリエラ",
   "text": "何でそのこと知ってるの？",
   "zh": "你怎么知道这件事？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "583/SEL",
   "narrator": "",
   "text": "$me$が心の中を整理したから",
   "zh": "因为$me$整理了心里",
   "narrator_zh": ""
  },
  {
   "location": "584/ACT",
   "narrator": "",
   "text": "$me$が心の中を整理したから",
   "zh": "因为$me$整理了心里",
   "narrator_zh": ""
  },
  {
   "location": "586/TALK",
   "narrator": "ガブリエラ",
   "text": "は？",
   "zh": "哈？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "587/TALK",
   "narrator": "ガブリエラ",
   "text": "もっと詳しく説明して",
   "zh": "说得再详细点",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "589/SEL",
   "narrator": "",
   "text": "ガブリエラの心にダイブした",
   "zh": "潜入了加布里埃拉的心",
   "narrator_zh": ""
  },
  {
   "location": "590/ACT",
   "narrator": "",
   "text": "ガブリエラの心にダイブした",
   "zh": "潜入了加布里埃拉的心",
   "narrator_zh": ""
  },
  {
   "location": "593/TALK",
   "narrator": "ガブリエラ",
   "text": "？",
   "zh": "？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "595/TALK",
   "narrator": "ガブリエラ",
   "text": "意味が分からないから",
   "zh": "因为看不懂",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "596/TALK",
   "narrator": "ガブリエラ",
   "text": "っていうかダイブって何？",
   "zh": "话说，潜入是什么？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "597/TALK",
   "narrator": "ガブリエラ",
   "text": "人の心に勝手に入ったってこと？",
   "zh": "就是擅自进了别人的心里？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "598/TALK",
   "narrator": "ガブリエラ",
   "text": "ウソでもそういうこと言わないで",
   "zh": "就算是假的也别说这种话",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "599/TALK",
   "narrator": "ガブリエラ",
   "text": "ゾッとするわ",
   "zh": "听得我发冷",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "608/TALK",
   "narrator": "ガブリエラ",
   "text": "まったく、何なのよ今の？",
   "zh": "真是的，刚才那是什么？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "610/TALK",
   "narrator": "ガブリエラ",
   "text": "けど…なんだろう？",
   "zh": "可是……怎么回事？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "612/TALK",
   "narrator": "ガブリエラ",
   "text": "こんなに落ち着いた\n気持ちになったの、\n生まれて初めてかも…。",
   "zh": "心情变得这么平静，\n也许是\n有生以来第一次……。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "613/TALK",
   "narrator": "ガブリエラ",
   "text": "集中しようだなんて\n思わなくても、自然と\n集中できる…。",
   "zh": "就算没想着要集中，\n也能自然而然\n集中起来……。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "615/TALK",
   "narrator": "ガブリエラ",
   "text": "…もしかして――",
   "zh": "……难道说——",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "616/TALK",
   "narrator": "ガブリエラ",
   "text": "アーヤが前に言ってた\n『明鏡止水』って、\nこういうこと？",
   "zh": "绫水以前说过的\n『明镜止水』，\n就是这种事？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "618/TALK",
   "narrator": "ガブリエラ",
   "text": "…アーヤは、いつもこんな\n気持ちで剣道の試合を\nしてたのかしら？",
   "zh": "……绫水一直是\n以这种心情\n打剑道比赛的吗？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "619/TALK",
   "narrator": "ガブリエラ",
   "text": "だとしたら――",
   "zh": "那样的话——",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "621/TALK",
   "narrator": "ガブリエラ",
   "text": "何だか、素敵かも。",
   "zh": "总觉得，也许挺不错。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "622/TALK",
   "narrator": "ガブリエラ",
   "text": "…あの、[Bot]とかいう\n変な奴の言ってたこと、\n本当なのかしら？",
   "zh": "……那个叫[Bot]的\n怪人说的话，\n是真的吗？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "624/TALK",
   "narrator": "ガブリエラ",
   "text": "…って、ダメ。\n今は集中しないと。",
   "zh": "……不行。\n现在必须集中。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "625/TALK",
   "narrator": "ガブリエラ",
   "text": "あとで、全部まとめて\nまほに聞けばいいんだし。",
   "zh": "之后一起去问\n真幌就行了。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "626/SEL",
   "narrator": "",
   "text": "まほって誰？",
   "zh": "真幌是谁？",
   "narrator_zh": ""
  },
  {
   "location": "627/ACT",
   "narrator": "",
   "text": "まほって誰？",
   "zh": "真幌是谁？",
   "narrator_zh": ""
  },
  {
   "location": "633/TALK",
   "narrator": "ガブリエラ",
   "text": "うわっ！？\nまた来たし！",
   "zh": "呜哇！？\n又来了！",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "643/TALK",
   "narrator": "ガブリエラ",
   "text": "私達の隊長よ",
   "zh": "是我们的队长",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "644/TALK",
   "narrator": "ガブリエラ",
   "text": "特別攻撃隊の隊長で神楽坂トライナリーの館長の東雲真幌",
   "zh": "特别攻击队的队长，神乐坂三重奏的馆长，东云真幌",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "645/TALK",
   "narrator": "ガブリエラ",
   "text": "以上説明終わり",
   "zh": "说明完毕",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "646/TALK",
   "narrator": "ガブリエラ",
   "text": "集中するから帰るまで声かけ禁止！",
   "zh": "我要集中精神，回去之前禁止出声！",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "656/TALK",
   "narrator": "ガブリエラ",
   "text": "ふぅ…。",
   "zh": "呼……。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "658/TALK",
   "narrator": "ガブリエラ",
   "text": "よしっ！！",
   "zh": "好！！",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "666/TALK",
   "narrator": "ガブリエラ",
   "text": "…………。",
   "zh": "…………。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "667/TALK",
   "narrator": "ガブリエラ",
   "text": "大丈夫…今の様子なら、\nあいつはもうすぐ…。",
   "zh": "没事……照现在这样，\n那人马上就……。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "678/TALK",
   "narrator": "ガブリエラ",
   "text": "…よし、来る！！",
   "zh": "……好，来了！！",
