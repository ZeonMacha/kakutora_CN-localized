{
 "dir": "dramatics/daydra/drm_ch02_00_140.js",
 "type": "Episode",
 "info": {
  "story_id": "2014",
  "cid": "ayami",
  "title": "らぶとーく 第14話",
  "sub_title": "気楽だったのに"
 },
 "entry": [
  {
   "location": "143/SCENARIO",
   "narrator": "",
   "text": "気楽だったのに"
  },
  {
   "location": "154/TALK",
   "narrator": "アーヤ",
   "text": "…………。"
  },
  {
   "location": "155/TALK",
   "narrator": "みやび",
   "text": "…………。"
  },
  {
   "location": "156/TALK",
   "narrator": "アーヤ",
   "text": "お客さん、来ないわね。",
   "zh": "客人一直不来呢。",
   "narrator_zh": "绫水"
  },
  {
   "location": "157/TALK",
   "narrator": "みやび",
   "text": "いつものことやろ？\n逆に来る方がビックリや。"
  },
  {
   "location": "159/TALK",
   "narrator": "アーヤ",
   "text": "まあ、そうなんだけど…。"
  },
  {
   "location": "161/TALK",
   "narrator": "アーヤ",
   "text": "っていうか、さっきから\nスマホばかり弄って、\n何やってるの？",
   "zh": "话说，你从刚才起\n就一直玩手机，\n在干什么？",
   "narrator_zh": "绫水"
  },
  {
   "location": "164/TALK",
   "narrator": "みやび",
   "text": "暇つぶしのお友達、\nゲームアプリや。"
  },
  {
   "location": "165/TALK",
   "narrator": "みやび",
   "text": "もうちっくとで\nランキング入りするき、\n集中するぞね。"
  },
  {
   "location": "166/TALK",
   "narrator": "アーヤ",
   "text": "ゲームって…あのねぇ。\n一応今は仕事中なのよ？"
  },
  {
   "location": "167/TALK",
   "narrator": "みやび",
   "text": "仕事も何も、ただ黙って\n座ってるだけやんか。"
  },
  {
   "location": "168/TALK",
   "narrator": "みやび",
   "text": "貴重な青春のひと時を、\n地蔵みたいに過ごすなんて\nありえんちや。"
  },
  {
   "location": "169/TALK",
   "narrator": "アーヤ",
   "text": "だからって、ゲームは\nどうかと思うわよ？",
   "zh": "就算那样，游戏\n我觉得还是算了哦？",
   "narrator_zh": "绫水"
  },
  {
   "location": "170/TALK",
   "narrator": "アーヤ",
   "text": "それ見たお客さんだって、\nあまり良い気はしないと\n思うし…。",
   "zh": "看了那个的客人，\n我想也不会\n觉得舒服……。",
   "narrator_zh": "绫水"
  },
  {
   "location": "171/TALK",
   "narrator": "みやび",
   "text": "そんなこと気にするような\n客は、こんな場末の閑散と\nした映画館には来んよ。",
   "zh": "会在意那种事的\n客人，才不会来这么偏僻\n冷清的电影院呢。",
   "narrator_zh": "雅"
  },
  {
   "location": "173/TALK",
   "narrator": "アーヤ",
   "text": "そうかもしれないけど…。",
   "zh": "也许是这样……。",
   "narrator_zh": "绫水"
  },
  {
   "location": "175/TALK",
   "narrator": "アーヤ",
   "text": "まったく…ああ言えば\nこう言うんだから…。"
  },
  {
   "location": "176/SEL",
   "narrator": "",
   "text": "退屈してるかと思って",
   "zh": "我还以为你会觉得无聊",
   "narrator_zh": ""
  },
  {
   "location": "177/SEL",
   "narrator": "",
   "text": "呼んだでしょ？",
   "zh": "你叫了吧？",
   "narrator_zh": ""
  },
  {
   "location": "178/SEL",
   "narrator": "",
   "text": "アーヤと話したくて",
   "zh": "因为想跟绫水说话",
   "narrator_zh": ""
  },
  {
   "location": "179/ACT",
   "narrator": "",
   "text": "退屈してるかと思って",
   "zh": "我还以为你会觉得无聊",
   "narrator_zh": ""
  },
  {
   "location": "183/TALK",
   "narrator": "アーヤ",
   "text": "？　誰かしら…。",
   "zh": "？　是谁呢……。",
   "narrator_zh": "绫水"
  },
  {
   "location": "197/TALK",
   "narrator": "アーヤ",
   "text": "退屈はしてる"
  },
  {
   "location": "198/TALK",
   "narrator": "アーヤ",
   "text": "けど",
   "zh": "可是",
   "narrator_zh": "绫水"
  },
  {
   "location": "199/TALK",
   "narrator": "アーヤ",
   "text": "バイト中だから"
  },
  {
   "location": "200/TALK",
   "narrator": "アーヤ",
   "text": "チャットはできないから"
  },
  {
   "location": "211/TALK",
   "narrator": "アーヤ",
   "text": "ふぅ…。",
   "zh": "呼……。",
   "narrator_zh": "绫水"
  },
  {
   "location": "214/TALK",
   "narrator": "みやび",
   "text": "…暇つぶしに、アーヤも\nチャットくらいしても\nえいんやないが？",
   "zh": "……闲得无聊的话，绫水也\n去聊聊天什么的，\n不就行了咯？",
   "narrator_zh": "雅"
  },
  {
   "location": "215/TALK",
   "narrator": "アーヤ",
   "text": "仕事中にしたら\nダメでしょ？"
  },
  {
   "location": "217/TALK",
   "narrator": "アーヤ",
   "text": "みやびも、ゲームは\nそれくらいにしといたら？"
  },
  {
   "location": "220/TALK",
   "narrator": "みやび",
   "text": "客が来たらちゃんと\n対応すればえいだけき――"
  },
  {
   "location": "221/TALK",
   "narrator": "みやび",
   "text": "客のいないこの時間は、\n好きにさせてもらうちや。"
  },
  {
   "location": "224/TALK",
   "narrator": "アーヤ",
   "text": "…館長に見つかっても、\n知らないわよ？",
   "zh": "……就算被馆长发现，\n我可不管哦？",
   "narrator_zh": "绫水"
  },
  {
   "location": "225/ACT",
   "narrator": "",
   "text": "呼んだでしょ？",
   "zh": "你叫了吧？",
   "narrator_zh": ""
  },
  {
   "location": "229/TALK",
   "narrator": "アーヤ",
   "text": "？　誰かしら…。",
   "zh": "？　是谁呢……。",
   "narrator_zh": "绫水"
  },
  {
   "location": "243/TALK",
   "narrator": "アーヤ",
   "text": "私が？"
  },
  {
   "location": "244/TALK",
   "narrator": "アーヤ",
   "text": "呼んでないわ"
  },
  {
   "location": "245/TALK",
   "narrator": "アーヤ",
   "text": "っていうか",
   "zh": "话说",
   "narrator_zh": "绫水"
  },
  {
   "location": "246/TALK",
   "narrator": "アーヤ",
   "text": "今バイト中"
  },
  {
   "location": "257/TALK",
   "narrator": "アーヤ",
   "text": "ふぅ…。",
   "zh": "呼……。",
   "narrator_zh": "绫水"
  },
  {
   "location": "259/TALK",
   "narrator": "みやび",
   "text": "…緊急事態の連絡か？",
   "zh": "……是紧急情况的联络吗？",
   "narrator_zh": "雅"
  },
  {
   "location": "261/TALK",
   "narrator": "アーヤ",
   "text": "え？",
   "zh": "诶？",
   "narrator_zh": "绫水"
  },
  {
   "location": "262/TALK",
   "narrator": "みやび",
   "text": "いや、なんか疲れたような\n顔してるきね。"
  },
  {
   "location": "263/TALK",
   "narrator": "みやび",
   "text": "そうなら、ここはうちが\n見てるき――",
   "zh": "要是那样，这里就由\n我家来看咯——",
   "narrator_zh": "雅"
  },
  {
   "location": "264/TALK",
   "narrator": "みやび",
   "text": "向こうで話してきて\nえいがよ？"
  },
  {
   "location": "266/TALK",
   "narrator": "アーヤ",
   "text": "ううん、大丈夫。\nそんな大した用事じゃ\nないから。"
  },
  {
   "location": "267/TALK",
   "narrator": "みやび",
   "text": "…………。"
  },
  {
   "location": "269/TALK",
   "narrator": "アーヤ",
   "text": "な、なに？",
   "zh": "什、什么？",
   "narrator_zh": "绫水"
  },
  {
   "location": "272/TALK",
   "narrator": "みやび",
   "text": "そこで、ラッキーこれで\n少しサボれる、と思わん\nところが――",
   "zh": "这时想着“运气真好，\n这下能偷点懒了”，\n不这么想的地方——",
   "narrator_zh": "雅"
  },
  {
   "location": "273/TALK",
   "narrator": "みやび",
   "text": "なんともアーヤらしいね。",
   "zh": "真像绫水呢。",
   "narrator_zh": "雅"
  },
  {
   "location": "275/TALK",
   "narrator": "アーヤ",
   "text": "…これからはみやびが\n緊急事態、って言う時は、\n注意するようにするわ。"
  },
  {
   "location": "276/ACT",
   "narrator": "",
   "text": "アーヤと話したくて",
   "zh": "因为想跟绫水说话",
   "narrator_zh": ""
  },
  {
   "location": "280/TALK",
   "narrator": "アーヤ",
   "text": "？　誰かしら…。",
   "zh": "？　是谁呢……。",
   "narrator_zh": "绫水"
  },
  {
   "location": "294/TALK",
   "narrator": "アーヤ",
   "text": "は？",
   "zh": "啊？",
   "narrator_zh": "绫水"
  },
  {
   "location": "295/TALK",
   "narrator": "アーヤ",
   "text": "話すって"
  },
  {
   "location": "296/TALK",
   "narrator": "アーヤ",
   "text": "なにを？",
   "zh": "什么？",
   "narrator_zh": "绫水"
  },
  {
   "location": "298/SEL",
   "narrator": "",
   "text": "何でもいいから話そう",
   "zh": "什么都行，聊聊吧",
   "narrator_zh": ""
  },
  {
   "location": "299/ACT",
   "narrator": "",
   "text": "何でもいいから話そう",
   "zh": "什么都行，聊聊吧",
   "narrator_zh": ""
  },
  {
   "location": "302/TALK",
   "narrator": "アーヤ",
   "text": "ごめんなさい",
   "zh": "对不起",
   "narrator_zh": "绫水"
  },
  {
   "location": "303/TALK",
   "narrator": "アーヤ",
   "text": "ムリ"
  },
  {
   "location": "304/TALK",
   "narrator": "アーヤ",
   "text": "今まで貴方のこと"
  },
  {
   "location": "305/TALK",
   "narrator": "アーヤ",
   "text": "ずっと",
   "zh": "一直",
   "narrator_zh": "绫水"
  },
  {
   "location": "306/TALK",
   "narrator": "アーヤ",
   "text": "Ｂｏｔだと思ってたけど"
  },
  {
   "location": "307/TALK",
   "narrator": "アーヤ",
   "text": "人間かもって"
  },
  {
   "location": "308/TALK",
   "narrator": "アーヤ",
   "text": "そんな話になって",
   "zh": "就变成那样了",
   "narrator_zh": "绫水"
  },
  {
   "location": "309/TALK",
   "narrator": "アーヤ",
   "text": "しかもそれが本当なんだったら"
  },
  {
   "location": "310/TALK",
   "narrator": "アーヤ",
   "text": "正直"
  },
  {
   "location": "311/TALK",
   "narrator": "アーヤ",
   "text": "どう接すればいいわからない",
   "zh": "不知道该怎么相处",
   "narrator_zh": "绫水"
  },
  {
   "location": "313/SEL",
   "narrator": "",
   "text": "今までと同じでいい",
   "zh": "跟以前一样就好",
   "narrator_zh": ""
  },
  {
   "location": "314/ACT",
   "narrator": "",
   "text": "今までと同じでいい",
   "zh": "跟以前一样就好",
   "narrator_zh": ""
  },
  {
   "location": "317/TALK",
   "narrator": "アーヤ",
   "text": "ごめん",
   "zh": "抱歉",
   "narrator_zh": "绫水"
  },
  {
   "location": "318/TALK",
   "narrator": "アーヤ",
   "text": "考えさせて"
  },
  {
   "location": "332/TALK",
   "narrator": "アーヤ",
   "text": "はぁ…。",
   "zh": "哈啊……。",
   "narrator_zh": "绫水"
  },
  {
   "location": "334/TALK",
   "narrator": "みやび",
   "text": "なんや？\n大きなため息やねぇ。",
   "zh": "怎么了？\n叹了好大一口气呢。",
   "narrator_zh": "雅"
  },
  {
   "location": "335/TALK",
   "narrator": "アーヤ",
   "text": "…………。"
  },
  {
   "location": "337/TALK",
   "narrator": "アーヤ",
   "text": "みやびはあれから、\nあのＢｏｔ――"
  },
  {
   "location": "338/TALK",
   "narrator": "アーヤ",
   "text": "$handle$とは、\n接触してる？",
   "zh": "跟$handle$是\n有接触的？",
   "narrator_zh": "绫水"
  },
  {
   "location": "339/TALK",
   "narrator": "みやび",
   "text": "まあな。",
   "zh": "差不多吧。",
   "narrator_zh": "雅"
  },
  {
   "location": "340/TALK",
   "narrator": "アーヤ",
   "text": "抵抗とかってないの？"
  },
  {
   "location": "341/TALK",
   "narrator": "みやび",
   "text": "…まあ、ある程度最初から\n疑うていたきね。",
   "zh": "……嘛，总得从一开始\n就有点怀疑嘛。",
   "narrator_zh": "雅"
  },
  {
   "location": "344/TALK",
   "narrator": "みやび",
   "text": "それに、色々気になる\nこともあるき――",
   "zh": "而且，也有各种\n在意的事，所以——",
   "narrator_zh": "雅"
  },
  {
   "location": "345/TALK",
   "narrator": "みやび",
   "text": "それを調べるためにも、\nあいつとの会話は\n必要ながよ。",
   "zh": "为了查那个，\n和那家伙的对话\n也是必要的咯。",
   "narrator_zh": "雅"
  },
  {
   "location": "347/TALK",
   "narrator": "アーヤ",
   "text": "そっか…。",
   "zh": "是这样呀……。",
   "narrator_zh": "绫水"
  },
  {
   "location": "350/TALK",
   "narrator": "みやび",
   "text": "…アーヤはどうなが？",
   "zh": "……绫水你打算咋整？",
   "narrator_zh": "雅"
  },
  {
   "location": "352/TALK",
   "narrator": "アーヤ",
   "text": "…ええと……。\n抵抗があるの…。"
  },
  {
   "location": "353/TALK",
   "narrator": "アーヤ",
   "text": "Ｂｏｔかと思っていた\n相手が人間って\nいうのは。"
  },
  {
   "location": "354/TALK",
   "narrator": "アーヤ",
   "text": "Ｂｏｔと人だと、\n距離感とかも\n同じじゃないし。"
  },
  {
   "location": "355/TALK",
   "narrator": "みやび",
   "text": "今まで通りでえいやろ？\nどうせ文字でしか会話せん\n相手なんやし。"
  },
  {
   "location": "357/TALK",
   "narrator": "アーヤ",
   "text": "そう思えれば苦労は\nしてないわよ。",
   "zh": "能那么想的话就\n不用这么辛苦了。",
   "narrator_zh": "绫水"
  },
  {
   "location": "359/TALK",
   "narrator": "アーヤ",
   "text": "はあ…Ｂｏｔの方が\n気楽に色々話せたり\nできたのになぁ…。",
   "zh": "唉……要是Bot的话\n还能更轻松地\n聊各种事呢……。",
   "narrator_zh": "绫水"
  },
  {
   "location": "362/TALK",
   "narrator": "みやび",
   "text": "…気楽に色々話す前に、\n人間っちゅうのがわかって\nよかったな。",
   "zh": "……能轻松地聊这聊那之前，\n先弄懂人是什么东西\n就好了咯。",
   "narrator_zh": "雅"
  }
 ]
}
