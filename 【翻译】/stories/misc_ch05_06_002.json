            "text": "垂れ耳ウサギは草を食む",
            "zh": "垂耳兔在啃草",
            "narrator_zh": "神乐"
        },
        {
            "location": "649/TALK",
            "narrator": "神楽",
            "text": "日がな一日草を食む",
            "zh": "从早到晚都在啃草",
            "narrator_zh": "神乐"
        },
        {
            "location": "651/SEL",
            "narrator": "",
            "text": "神楽のこと？",
            "zh": "是在说神乐？",
            "narrator_zh": ""
        },
        {
            "location": "652/SEL",
            "narrator": "",
            "text": "ウサギ肉って美味しいらしいね",
            "zh": "兔肉好像很好吃呢",
            "narrator_zh": ""
        },
        {
            "location": "653/SEL",
            "narrator": "",
            "text": "ほのぼの系？",
            "zh": "是温馨系？",
            "narrator_zh": ""
        },
        {
            "location": "654/ACT",
            "narrator": "",
            "text": "神楽のこと？",
            "zh": "是在说神乐？",
            "narrator_zh": ""
        },
        {
            "location": "656/TALK",
            "narrator": "神楽",
            "text": "暗喩かつ隠喩",
            "zh": "既是暗喻，也是隐喻",
            "narrator_zh": "神乐"
        },
        {
            "location": "657/TALK",
            "narrator": "神楽",
            "text": "なんてわけじゃないけど",
            "zh": "倒也不是那个意思",
            "narrator_zh": "神乐"
        },
        {
            "location": "659/TALK",
            "narrator": "神楽",
            "text": "退屈な一日を望む日だってありますからねぴょんこにだって",
            "zh": "也有想要无聊一天的日子，蹦子也是",
            "narrator_zh": "神乐"
        },
        {
            "location": "660/ACT",
            "narrator": "",
            "text": "ウサギ肉って美味しいらしいね",
            "zh": "兔肉好像很好吃呢",
            "narrator_zh": ""
        },
        {
            "location": "661/TALK",
            "narrator": "神楽",
            "text": "食うなよ！！！！",
            "zh": "不许吃！！！！",
            "narrator_zh": "神乐"
        },
        {
            "location": "663/TALK",
            "narrator": "神楽",
            "text": "でも旨いのはガチ",
            "zh": "不过好吃是真的",
            "narrator_zh": "神乐"
        },
        {
            "location": "664/ACT",
            "narrator": "",
            "text": "ほのぼの系？",
            "zh": "是温馨系？",
            "narrator_zh": ""
        },
        {
            "location": "665/TALK",
            "narrator": "神楽",
            "text": "そういうことにしておいて",
            "zh": "就先这么算吧",
            "narrator_zh": "神乐"
        },
        {
            "location": "667/TALK",
            "narrator": "神楽",
            "text": "本物の動物って何考えてるかわかんない",
            "zh": "真正的动物，根本不知道在想什么",
            "narrator_zh": "神乐"
        },
        {
            "location": "668/TALK",
            "narrator": "神楽",
            "text": "意思疎通ってできなくない？",
            "zh": "根本没法沟通吧？",
            "narrator_zh": "神乐"
        },
        {
            "location": "669/TALK",
            "narrator": "神楽",
            "text": "なんなんだろうなあれ",
            "zh": "那到底是什么啊",
            "narrator_zh": "神乐"
        },
        {
            "location": "670/TALK",
            "narrator": "神楽",
            "text": "$handlek$とだったらそれなりに話ができるのにそれ以下",
            "zh": "和$handlek$至少还能好好说话，它们连这都不如",
            "narrator_zh": "神乐"
        },
        {
            "location": "671/TALK",
            "narrator": "神楽",
            "text": "でも創作のモチーフとしては全然アリ",
            "zh": "不过当创作的素材，完全可以",
            "narrator_zh": "神乐"
        },
        {
            "location": "672/TALK",
            "narrator": "神楽",
            "text": "生き物を飼うのは空想の中だけでいいな",
            "zh": "养生物，只在空想里就好",
            "narrator_zh": "神乐"
        }
    ]
