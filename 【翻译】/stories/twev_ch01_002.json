        "title": "Twitter Archive 001",
        "sub_title": "卯月画廊：カワイイコスチューム",
        "title_zh": "推特 存档 001",
        "sub_title_zh": "卯月画廊：可爱服装"
    },
    "entry": [
        {
            "location": "172/TALK",
            "narrator": "透明つばめ",
            "text": "可愛いなぁ…。\nこの服、本当にあったら\nいいのに…。",
            "zh": "好可爱呀……。\n这件衣服要是真有\n就好了……。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "173/TALK",
            "narrator": "透明神楽",
            "text": "つ、つばめさーん。\nいい加減その絵、\n返してください。",
            "zh": "燕、燕小——姐。\n请你适可而止，\n把那幅画还给我吧。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "175/TALK",
            "narrator": "透明つばめ",
            "text": "もうちょっとだけー。\n卯月さんの絵、\nとっても可愛いよ。",
            "zh": "再让我看一会儿嘛。\n卯月的画，\n真的超可爱哦。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "176/TALK",
            "narrator": "透明みやび",
            "text": "いつも見せちょるやろ？\nなんでこれだけ\n恥ずかしがるんや？",
            "zh": "平时不都一直拿去给人看，是没是？\n怎么偏偏就这幅\n害羞成这样咩？",
            "narrator_zh": "透明雅"
        },
        {
            "location": "178/TALK",
            "narrator": "透明神楽",
            "text": "だって、その絵はまだ\n見せるタイミングのじゃ\nありませんでしたし…。",
            "zh": "因为那幅画还没到\n可以给人看的时机\n呀……。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "179/TALK",
            "narrator": "透明ガブリエラ",
            "text": "いや、恥ずかしいのは\nあたしの方だから！",
            "zh": "不对，害羞的\n可是我这边呀！",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "180/TALK",
            "narrator": "透明ガブリエラ",
            "text": "みやびも、どうして\nわざわざこの絵を\nネットに載せたのよ？",
            "zh": "雅也是，为什么\n非要特意把这幅画\n传到网上呀？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "181/TALK",
            "narrator": "透明みやび",
            "text": "一人一人に聞くの\n面倒やったがよ。",
            "zh": "一个个去问\n太麻烦了咯。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "183/TALK",
            "narrator": "透明ガブリエラ",
            "text": "まったく…神楽が\nカレー屋にノートを\n忘れたりしなければ…。",
            "zh": "真是的……要不是神乐\n把笔记本忘在\n咖喱店里……。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "184/TALK",
            "narrator": "透明神楽",
            "text": "わ、私のせいですか！？",
            "zh": "怎、怎么成我的错了！？",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "185/TALK",
            "narrator": "透明ガブリエラ",
            "text": "そりゃそうでしょ？\n持ち主なんだから。",
            "zh": "那不是当然的吗？\n谁让你是失主。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "186/TALK",
            "narrator": "透明みやび",
            "text": "ちゅうか、どの絵を\n載せるかでかなり\n悩んだちや。",
            "zh": "话说回来，传哪幅\n上去，我可纠结了\n好一阵子滴。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "187/TALK",
            "narrator": "透明みやび",
            "text": "載せた瞬間アカウント\n凍結しそうな際どいのも\nあったき。",
            "zh": "还有几张一传上去\n账号怕是要冻结的\n危险货色啵。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "189/TALK",
            "narrator": "透明神楽",
            "text": "ちょ！？　それ以上は\n言わないでください！",
            "zh": "等下！？再多的话\n就请别说了！",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "190/TALK",
            "narrator": "透明ガブリエラ",
            "text": "神楽！\nあんた普段どんな絵\n描いてんのよ！？",
            "zh": "神乐！\n你平时到底都画的\n些什么呀！？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "192/TALK",
            "narrator": "透明つばめ",
            "text": "ふふっ、可愛いなぁ…。\nそうだ！",
            "zh": "呵呵，好可爱呀……。\n对了！",
            "narrator_zh": "透明燕"
        },
        {
            "location": "194/TALK",
            "narrator": "つばめ",
            "text": "ジャーン！！ヽ(･ω･ )ゝ✧",
            "zh": "锵锵！！ヽ(･ω･ )ゝ✧",
            "narrator_zh": "燕"
        },
        {
            "location": "195/TALK",
            "narrator": "つばめ",
            "text": "この絵見て",
            "zh": "看看这幅画",
            "narrator_zh": "燕"
        },
        {
            "location": "196/TALK",
            "narrator": "つばめ",
            "text": "神楽ちゃんが描ぃたの(*≧∀≦*) ",
            "zh": "是神乐画的哟(*≧∀≦*) ",
            "narrator_zh": "燕"
        },
        {
            "location": "197/SEL",
            "narrator": "（選択肢）",
            "text": "つばめ可愛いね",
            "zh": "燕真可爱呢",
            "narrator_zh": "（选项）"
        },
        {
            "location": "198/SEL",
            "narrator": "（選択肢）",
            "text": "ガブリエラ可愛いね",
            "zh": "加布里埃拉真可爱呢",
            "narrator_zh": "（选项）"
        },
        {
            "location": "199/ACT",
            "narrator": "",
            "text": "つばめ可愛いね",
            "zh": "燕真可爱呢",
            "narrator_zh": ""
        },
        {
            "location": "200/TALK",
            "narrator": "つばめ",
            "text": "ぇへへ(´ω｀*)",
            "zh": "嘿嘿(´ω｀*)",
            "narrator_zh": "燕"
        },
        {
            "location": "202/TALK",
            "narrator": "つばめ",
            "text": "わたしも気に入ってるの",
            "zh": "我自己也很喜欢哦",
            "narrator_zh": "燕"
        },
        {
            "location": "203/TALK",
            "narrator": "つばめ",
            "text": "かわぃぃよね(´∀｀*)",
            "zh": "很可爱吧(´∀｀*)",
            "narrator_zh": "燕"
        },
        {
            "location": "204/TALK",
            "narrator": "つばめ",
            "text": "この服",
            "zh": "这件衣服",
            "narrator_zh": "燕"
        },
        {
            "location": "205/TALK",
            "narrator": "つばめ",
            "text": "ちょっと",
            "zh": "有点",
            "narrator_zh": "燕"
        },
        {
            "location": "207/TALK",
            "narrator": "つばめ",
            "text": "恥ずかしいけど(/ω＼)",
            "zh": "让人害羞呢(/ω＼)",
            "narrator_zh": "燕"
        },
        {
            "location": "208/ACT",
            "narrator": "",
            "text": "ガブリエラ可愛いね",
            "zh": "加布里埃拉真可爱呢",
            "narrator_zh": ""
        },
        {
            "location": "209/TALK",
            "narrator": "つばめ",
            "text": "かわぃぃけど",
            "zh": "可爱是可爱啦",
            "narrator_zh": "燕"
        },
        {
            "location": "210/TALK",
            "narrator": "つばめ",
            "text": "わたしの着てる方の服",
            "zh": "但我身上穿的这件",
            "narrator_zh": "燕"
        },
        {
            "location": "211/TALK",
            "narrator": "つばめ",
            "text": "こっちを",
            "zh": "这边这身哦",
            "narrator_zh": "燕"
        },
        {
            "location": "214/TALK",
            "narrator": "つばめ",
            "text": "でも",
            "zh": "不过",
            "narrator_zh": "燕"
        },
        {
            "location": "215/TALK",
            "narrator": "つばめ",
            "text": "あの時話したことが",
            "zh": "那时聊过的事",
            "narrator_zh": "燕"
        },
        {
            "location": "216/TALK",
            "narrator": "つばめ",
            "text": "絵になるなんて",
            "zh": "居然能变成画",
            "narrator_zh": "燕"
        },
        {
            "location": "217/TALK",
            "narrator": "つばめ",
            "text": "思わなかったな(･Д･｀)",
            "zh": "真没想到呀(･Д･｀)",
            "narrator_zh": "燕"
        },
        {
            "location": "218/SEL",
            "narrator": "（選択肢）",
            "text": "何か話したの？",
            "zh": "你们聊过什么吗？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "219/SEL",
            "narrator": "（選択肢）",
            "text": "何を話したっけ？",
            "zh": "聊了什么来着？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "220/ACT",
            "narrator": "",
            "text": "何か話したの？",
            "zh": "你们聊过什么吗？",
            "narrator_zh": ""
        },
        {
            "location": "221/ACT",
            "narrator": "",
            "text": "何を話したっけ？",
            "zh": "聊了什么来着？",
            "narrator_zh": ""
        },
        {
            "location": "223/TALK",
            "narrator": "つばめ",
            "text": "神楽ちゃんと",
            "zh": "我跟神乐",
            "narrator_zh": "燕"
        },
        {
            "location": "224/TALK",
            "narrator": "つばめ",
            "text": "コスプレの話をしたの(｡･ω･｡)",
            "zh": "聊过cosplay的话题(｡･ω･｡)",
            "narrator_zh": "燕"
        },
        {
            "location": "225/TALK",
            "narrator": "つばめ",
            "text": "そのとき",
            "zh": "那时候",
            "narrator_zh": "燕"
        },
        {
            "location": "226/TALK",
            "narrator": "つばめ",
            "text": "わたしはゥサギかネコが似合ぅ",
            "zh": "兔子还是猫咪更适合我",
            "narrator_zh": "燕"
        },
        {
            "location": "227/TALK",
            "narrator": "つばめ",
            "text": "そぅ言われたの(≧艸≦*)",
            "zh": "她是这么说的哟(≧艸≦*)",
            "narrator_zh": "燕"
        },
        {
            "location": "228/SEL",
            "narrator": "（選択肢）",
            "text": "$me$もネコっぽいと思う",
            "zh": "$me$也觉得你像猫",
            "narrator_zh": "（选项）"
        },
        {
            "location": "229/SEL",
            "narrator": "（選択肢）",
            "text": "ウサギっぽいけどなぁ",
            "zh": "明明更像兔子呀",
            "narrator_zh": "（选项）"
        },
        {
            "location": "230/ACT",
            "narrator": "",
            "text": "$me$もネコっぽいと思う",
            "zh": "$me$也觉得你像猫",
            "narrator_zh": ""
        },
        {
            "location": "231/TALK",
            "narrator": "つばめ",
            "text": "$handle$さんも？",
            "zh": "$handle$也这么觉得？",
            "narrator_zh": "燕"
        },
        {
            "location": "232/TALK",
            "narrator": "つばめ",
            "text": "わたし",
            "zh": "原来我",
            "narrator_zh": "燕"
        },
        {
            "location": "233/TALK",
            "narrator": "つばめ",
            "text": "やっぱりネコっぽいんだ？(*´ω｀*)",
            "zh": "果然像猫呀？(*´ω｀*)",
            "narrator_zh": "燕"
        },
        {
            "location": "234/TALK",
            "narrator": "つばめ",
            "text": "自分じゃわからなぃけど",
            "zh": "虽然我自己看不出来",
            "narrator_zh": "燕"
        },
        {
            "location": "235/TALK",
            "narrator": "つばめ",
            "text": "かわいいから",
            "zh": "但既然可爱",
            "narrator_zh": "燕"
        },
        {
            "location": "236/TALK",
            "narrator": "つばめ",
            "text": "嬉しいよ(*≧∀≦*) ",
            "zh": "就很开心哟(*≧∀≦*) ",
            "narrator_zh": "燕"
        },
        {
            "location": "237/TALK",
            "narrator": "つばめ",
            "text": "にゃんにゃーん",
            "zh": "喵喵——",
            "narrator_zh": "燕"
        },
        {
            "location": "240/ACT",
            "narrator": "",
            "text": "ウサギっぽいけどなぁ",
            "zh": "明明更像兔子呀",
            "narrator_zh": ""
        },
        {
            "location": "241/TALK",
            "narrator": "つばめ",
            "text": "そぅなの？",
            "zh": "是这样吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "242/TALK",
            "narrator": "つばめ",
            "text": "わたし",
            "zh": "我",
            "narrator_zh": "燕"
        },
        {
            "location": "243/TALK",
            "narrator": "つばめ",
            "text": "ピョンピョンしてるィメージ",
            "zh": "蹦蹦跳跳的印象",
            "narrator_zh": "燕"
        },
        {
            "location": "244/TALK",
            "narrator": "つばめ",
            "text": "ぁるのかな？(´･ω･｀) ",
            "zh": "有吗？(´･ω･｀) ",
            "narrator_zh": "燕"
        },
        {
            "location": "246/TALK",
            "narrator": "つばめ",
            "text": "気に入った絵だから",
            "zh": "因为是我中意的画",
            "narrator_zh": "燕"
        },
        {
            "location": "247/TALK",
            "narrator": "つばめ",
            "text": "$handle$さんにも",
            "zh": "能让$handle$也",
            "narrator_zh": "燕"
        },
        {
            "location": "248/TALK",
            "narrator": "つばめ",
            "text": "見てもらぇてよかった(´∀｀*)ｳﾌﾌ",
            "zh": "看到真是太好了(´∀｀*)嘿嘿",
            "narrator_zh": "燕"
        },
        {
            "location": "249/SEL",
            "narrator": "（選択肢）",
            "text": "今度は本当に着て見せてね",
            "zh": "下次真的要穿来给我看哦",
            "narrator_zh": "（选项）"
        },
        {
            "location": "250/SEL",
            "narrator": "（選択肢）",
            "text": "可愛いかったよ、ありがと",
            "zh": "很可爱哦，谢谢你",
            "narrator_zh": "（选项）"
        },
        {
            "location": "251/ACT",
            "narrator": "",
            "text": "今度は本当に着て見せてね",
            "zh": "下次真的要穿来给我看哦",
            "narrator_zh": ""
        },
        {
            "location": "252/TALK",
            "narrator": "つばめ",
            "text": "ムリだよーーー！",
            "zh": "做不到啦——！",
            "narrator_zh": "燕"
        },
        {
            "location": "254/TALK",
            "narrator": "つばめ",
            "text": "でも",
            "zh": "不过",
            "narrator_zh": "燕"
        },
        {
            "location": "255/TALK",
            "narrator": "つばめ",
            "text": "どぅしてもっていぅなら",
            "zh": "如果你非要的话",
            "narrator_zh": "燕"
        },
        {
            "location": "257/TALK",
            "narrator": "つばめ",
            "text": "やっぱり無理！ヾ(｡>﹏<｡)ﾉﾞ",
            "zh": "果然还是不行！ヾ(｡>﹏<｡)ﾉﾞ",
            "narrator_zh": "燕"
        },
        {
            "location": "259/TALK",
            "narrator": "つばめ",
            "text": "ごめんね",
            "zh": "对不起啦",
            "narrator_zh": "燕"
        },
        {
            "location": "260/ACT",
            "narrator": "",
            "text": "可愛かったよ、ありがと",
