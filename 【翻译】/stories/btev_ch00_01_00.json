{
    "dir": "chap01/battle/btev_ch00_01_00.js",
    "type": "",
    "info": {
        "story_id": "21000",
        "cid": "",
        "title": "000 ココロスフィア解説",
        "sub_title": "ココロの深淵へようこそ",
        "title_zh": "000 心灵领域解说",
        "sub_title_zh": "欢迎来到心灵深渊"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "ココロスフィア導入つばめ",
            "zh": "心灵领域导入 燕",
            "narrator_zh": ""
        },
        {
            "location": "13/DIALOG",
            "narrator": "",
            "text": "<size=40>DOOR-No. 000</size>\nCHIHARU\n\n<size=40>Kokoro.Initialize();</size>\n<size=25>～深層ココロスフィアの概念について～</size>",
            "zh": "<size=40>DOOR-No. 000</size>\n千羽鹤\n\n<size=40>Kokoro.Initialize();</size>\n<size=25>～关于深层心灵领域的概念～</size>",
            "narrator_zh": ""
        },
        {
            "location": "22/TALK",
            "narrator": "千羽鶴",
            "text": "ようこそ、\n逢瀬つばめの\n深層世界へ。",
            "zh": "欢迎来到\n逢濑燕的\n深层世界。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "24/TALK",
            "narrator": "千羽鶴",
            "text": "前にもしてるけど、\n深層世界についての説明、\nもう一度聞く？",
            "zh": "之前也讲过了，\n关于深层世界的说明，\n还要再听一遍吗？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "25/SEL",
            "narrator": "（選択肢）",
            "text": "はい",
            "zh": "要",
            "narrator_zh": "（选项）"
        },
        {
            "location": "26/SEL",
            "narrator": "（選択肢）",
            "text": "いいえ",
            "zh": "不用",
            "narrator_zh": "（选项）"
        },
        {
            "location": "27/ACT",
            "narrator": "",
            "text": "はい",
            "zh": "要",
            "narrator_zh": ""
        },
        {
            "location": "28/TALK",
            "narrator": "千羽鶴",
            "text": "わかった。\nそれじゃもう一度、\n深層世界の話をする。",
            "zh": "知道了。\n那我就再讲一次\n深层世界的事。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "30/ACT",
            "narrator": "",
            "text": "いいえ",
            "zh": "不用",
            "narrator_zh": ""
        },
        {
            "location": "31/TALK",
            "narrator": "千羽鶴",
            "text": "そう、助かる。",
            "zh": "是吗，省事了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "47/TALK",
            "narrator": "千羽鶴",
            "text": "さて。",
            "zh": "好了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "48/TALK",
            "narrator": "千羽鶴",
            "text": "改めて、\nここは逢瀬つばめの\n深層世界。",
            "zh": "重新介绍一下，\n这里是逢濑燕的\n深层世界。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "49/TALK",
            "narrator": "千羽鶴",
            "text": "彼女は普段から\n見ていても分かる通り、\n非常に楽天的。",
            "zh": "就像你平时\n看到的那样，\n她非常乐天。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "50/TALK",
            "narrator": "千羽鶴",
            "text": "深い悩みなんて\n無さそうに見えるけど……",
            "zh": "看起来好像\n没什么深层烦恼……",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "51/TALK",
            "narrator": "千羽鶴",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "52/TALK",
            "narrator": "千羽鶴",
            "text": "実際、あまり\n無いかもしれない。",
            "zh": "实际上，说不定\n还真没多少。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "53/SEL",
            "narrator": "（選択肢）",
            "text": "あー、やっぱり。そんな気がした",
            "zh": "啊——，果然。我也觉得是这样",
            "narrator_zh": "（选项）"
        },
        {
            "location": "54/SEL",
            "narrator": "（選択肢）",
            "text": "嘘ばっか",
            "zh": "全是谎话",
            "narrator_zh": "（选项）"
        },
        {
            "location": "55/ACT",
            "narrator": "",
            "text": "あー、やっぱり。そんな気がした",
            "zh": "啊——，果然。我也觉得是这样",
            "narrator_zh": ""
        },
        {
            "location": "56/TALK",
            "narrator": "千羽鶴",
            "text": "嘘です。",
            "zh": "骗你的。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "57/TALK",
            "narrator": "千羽鶴",
            "text": "当然、ある。",
            "zh": "当然有。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "58/TALK",
            "narrator": "千羽鶴",
            "text": "彼女は生きてる。",
            "zh": "她是个活生生的人。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "59/TALK",
            "narrator": "千羽鶴",
            "text": "生きてる以上、当然\n悩みのひとつやふたつ――",
            "zh": "只要还活着，当然\n一两个烦恼——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "62/TALK",
            "narrator": "千羽鶴",
            "text": "<color=red><size=40>必ずある！</size></color>",
            "zh": "<color=red><size=40>肯定会有！</size></color>",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "63/TALK",
            "narrator": "千羽鶴",
            "text": "逢瀬つばめがいつも\n考え無しのように見える\nからって見くびらないで。",
            "zh": "别看逢濑燕平时\n一副没心没肺的样子，\n就小瞧她了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "64/SEL",
            "narrator": "（選択肢）",
            "text": "擁護してるように見えるけど実はディスってない？",
            "zh": "听着像是在护着她，其实是在黑她吧？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "65/ACT",
            "narrator": "",
            "text": "擁護してるように見えるけど実はディスってない？",
            "zh": "听着像是在护着她，其实是在黑她吧？",
            "narrator_zh": ""
        },
        {
            "location": "67/TALK",
            "narrator": "千羽鶴",
            "text": "……いいえ。",
            "zh": "……没有。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "68/SEL",
            "narrator": "（選択肢）",
            "text": "今一瞬間があった！",
            "zh": "刚才停顿了一下！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "69/ACT",
            "narrator": "",
            "text": "今一瞬間があった！",
            "zh": "刚才停顿了一下！",
            "narrator_zh": ""
        },
        {
            "location": "71/TALK",
            "narrator": "千羽鶴",
            "text": "いいえ。",
            "zh": "没有。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "72/SEL",
            "narrator": "（選択肢）",
            "text": "本心を言え！",
            "zh": "说真心话！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "73/ACT",
            "narrator": "",
            "text": "本心を言え！",
            "zh": "说真心话！",
            "narrator_zh": ""
        },
        {
            "location": "75/TALK",
            "narrator": "千羽鶴",
            "text": "いいからもう先に進む！",
            "zh": "行了，继续往下走！",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "76/ACT",
            "narrator": "",
            "text": "嘘ばっか",
            "zh": "全是谎话",
            "narrator_zh": ""
        },
        {
            "location": "77/TALK",
            "narrator": "千羽鶴",
            "text": "あらまあ。\n簡単に見破られた。\n優秀なダイバーね。",
            "zh": "哎呀呀。\n轻易就被看穿了。\n真是个优秀的潜行者。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "78/TALK",
            "narrator": "千羽鶴",
            "text": "それとも、実は\n過去に誰かの心の中に\nダイブしたことがある？",
            "zh": "还是说，其实你\n以前就潜入过\n谁的心里？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "79/SEL",
            "narrator": "（選択肢）",
            "text": "そんなわけない",
            "zh": "怎么可能",
            "narrator_zh": "（选项）"
        },
        {
            "location": "80/SEL",
            "narrator": "（選択肢）",
            "text": "はい、実は",
            "zh": "是的，其实……",
            "narrator_zh": "（选项）"
        },
        {
            "location": "81/ACT",
            "narrator": "",
            "text": "そんなわけない",
            "zh": "怎么可能",
            "narrator_zh": ""
        },
        {
            "location": "82/TALK",
            "narrator": "千羽鶴",
            "text": "分かってて聞いた。\n普通、日常的に心の中に\nダイブする事なんてない。",
            "zh": "我是明知故问。\n平时哪有人会动不动\n潜入别人的心里。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "83/ACT",
            "narrator": "",
            "text": "はい、実は",
            "zh": "是的，其实……",
            "narrator_zh": ""
        },
        {
            "location": "84/TALK",
            "narrator": "千羽鶴",
            "text": "更にまあ。\nもしかして、\nその手のプロ？",
            "zh": "这还真是。\n难道说，\n你是这方面的行家？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "85/TALK",
            "narrator": "千羽鶴",
            "text": "だとしたら\n彼女も私も心強い。",
            "zh": "如果是那样，\n她和我都踏实多了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "88/TALK",
            "narrator": "千羽鶴",
            "text": "とにかく。",
            "zh": "总之。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "89/TALK",
            "narrator": "千羽鶴",
            "text": "逢瀬つばめにだって、\n人並みに悩みがある。",
            "zh": "哪怕是逢濑燕，\n也跟常人一样有烦恼。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "90/TALK",
            "narrator": "千羽鶴",
            "text": "あんな悩みなさそうな\n彼女にもある悩みなんて、\nちょっと興味ない？",
            "zh": "看起来那样没烦恼的她\n心里到底藏着什么烦恼，\n难道不好奇吗？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "91/SEL",
            "narrator": "（選択肢）",
            "text": "はい",
            "zh": "好奇",
            "narrator_zh": "（选项）"
        },
        {
            "location": "92/SEL",
            "narrator": "（選択肢）",
            "text": "いいえ",
            "zh": "不好奇",
            "narrator_zh": "（选项）"
        },
        {
            "location": "93/SEL",
            "narrator": "（選択肢）",
            "text": "千羽鶴の方が興味ある",
            "zh": "我对千羽鹤更感兴趣",
            "narrator_zh": "（选项）"
        },
        {
            "location": "94/ACT",
            "narrator": "",
            "text": "はい",
            "zh": "好奇",
            "narrator_zh": ""
        },
        {
            "location": "95/TALK",
            "narrator": "千羽鶴",
            "text": "まあでも。",
            "zh": "不过嘛。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "96/ACT",
            "narrator": "",
            "text": "いいえ",
            "zh": "不好奇",
            "narrator_zh": ""
        },
        {
            "location": "97/TALK",
            "narrator": "千羽鶴",
            "text": "そう。まあ確かに、\n実際に見てみたら\nくだらないことかも。",
            "zh": "是吗。也对，\n真要看的话，说不定\n只是些无聊的小事。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "98/ACT",
            "narrator": "",
            "text": "千羽鶴の方が興味ある",
            "zh": "我对千羽鹤更感兴趣",
            "narrator_zh": ""
        },
        {
            "location": "101/TALK",
            "narrator": "千羽鶴",
            "text": "もうここでは\n何も出ませんよ。",
            "zh": "这里已经\n什么都不会出来了哦。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "102/TALK",
            "narrator": "千羽鶴",
            "text": "そんなことより、\n逢瀬つばめのココロを\n癒してあげて。",
            "zh": "比起这个，\n快去治愈逢濑燕的\n心吧。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "107/TALK",
            "narrator": "千羽鶴",
            "text": "……ほんとに。",
            "zh": "……真是的。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "108/TALK",
            "narrator": "千羽鶴",
            "text": "ホントにしつこい人。",
            "zh": "真是够纠缠不休的人。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "109/TALK",
            "narrator": "千羽鶴",
            "text": "そんなに私の\n心の中を見たい？",
            "zh": "就这么想看\n我的心里吗？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "110/SEL",
            "narrator": "（選択肢）",
            "text": "はい",
            "zh": "想",
            "narrator_zh": "（选项）"
        },
        {
            "location": "111/SEL",
            "narrator": "（選択肢）",
            "text": "いいえ",
            "zh": "不想",
            "narrator_zh": "（选项）"
        },
        {
            "location": "112/ACT",
            "narrator": "",
            "text": "はい",
            "zh": "想",
            "narrator_zh": ""
        },
        {
            "location": "113/TALK",
            "narrator": "千羽鶴",
            "text": "おぞましすぎて、\n現実に帰って来れなく\nなるかもしれないけど。",
            "zh": "可能会骇人到\n让你再也回不到\n现实里去哦。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "114/TALK",
            "narrator": "千羽鶴",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "115/TALK",
            "narrator": "千羽鶴",
            "text": "まあ、それでもと言うなら\nいずれ何か見せられる日が\n来るかもしれない。",
            "zh": "不过，既然你非要这么说，\n日后说不定会有能给你\n看点什么的一天吧。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "116/ACT",
            "narrator": "",
            "text": "いいえ",
            "zh": "不想",
            "narrator_zh": ""
        },
        {
            "location": "117/TALK",
            "narrator": "千羽鶴",
            "text": "それが正しい判断。\n私の中を覗いても、\nろくなことがないから。",
            "zh": "这才是明智判断。\n偷窥我的内心，\n也不会有什么好事。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "119/TALK",
            "narrator": "千羽鶴",
            "text": "とにかく。\n貴方の実直すぎるアホに\n免じて、ご褒美あげる。",
            "zh": "总之。\n看在你这过于耿直的傻劲\n分上，给你点奖励。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "129/TALK",
            "narrator": "千羽鶴",
            "text": "何にしても今は、\n逢瀬つばめのココロを\n癒してあげて。",
            "zh": "不管怎样，现在\n先去治愈逢濑燕的\n心吧。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "133/TALK",
            "narrator": "千羽鶴",
            "text": "しつこいです。\nさっさと逢瀬つばめの\nココロを癒してあげて。",
            "zh": "太纠缠了。\n快点去治愈逢濑燕的\n心吧。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "137/TALK",
            "narrator": "千羽鶴",
            "text": "だから、私は\nチュートリアルキャラ。\nココロなんて存在しない。",
            "zh": "我都说了，我是\n教程角色。\n根本不存在什么心。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "138/TALK",
            "narrator": "千羽鶴",
            "text": "さっさと逢瀬つばめの\nココロを癒してあげて。",
            "zh": "快点去治愈逢濑燕的\n心吧。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "142/TALK",
            "narrator": "千羽鶴",
            "text": "残念だけど、私は単なる\nチュートリアルキャラ。\nココロなんて存在しない。",
            "zh": "遗憾的是，我只是个\n教程角色。\n根本不存在什么心。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "143/TALK",
            "narrator": "千羽鶴",
            "text": "今は逢瀬つばめの\nココロを癒すことに\n集中して。",
            "zh": "现在请专注于\n治愈逢濑燕的\n心。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "148/TALK",
            "narrator": "千羽鶴",
            "text": "話を戻すけど。",
            "zh": "言归正传。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "150/TALK",
            "narrator": "千羽鶴",
            "text": "彼女の悩みは、\n貴方にとっては大したこと\nではないかもしれない。",
            "zh": "她的烦恼，\n对你来说或许\n算不上什么大事。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "151/TALK",
            "narrator": "千羽鶴",
            "text": "けど、彼女にとっては、\n人生を左右する重大な\nことなの。",
            "zh": "但对她而言，\n却是足以左右人生的\n大事。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "152/TALK",
            "narrator": "千羽鶴",
            "text": "だから是非、\n真摯に向かい合って\n支えてあげてほしい。",
