{
 "dir": "dramatics/daydra/drm_ch04_00_010.js",
 "type": "Episode",
 "info": {
  "story_id": "4001",
  "cid": "miyabi",
  "title": "らぶとーく 第01話",
  "sub_title": "少女たちは電気羊の夢を見る"
 },
 "entry": [
  {
   "location": "7/SCENARIO",
   "narrator": "",
   "text": "少女たちは電気羊の夢を見る"
  },
  {
   "location": "23/TALK",
   "narrator": "千羽鶴",
   "text": "まずはおめでとう。",
   "zh": "先恭喜你。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "24/TALK",
   "narrator": "千羽鶴",
   "text": "貴方が今ここにいると\nいうことは、彼女との\n関係の開始を意味する。",
   "zh": "你现在在这里，\n就意味着，和她的\n关系开始了。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "26/SEL",
   "narrator": "",
   "text": "関係の開始って、つまり…",
   "zh": "关系开始，也就是说……",
   "narrator_zh": ""
  },
  {
   "location": "27/ACT",
   "narrator": "",
   "text": "関係の開始って、つまり…",
   "zh": "关系开始，也就是说……",
   "narrator_zh": ""
  },
  {
   "location": "30/TALK",
   "narrator": "千羽鶴",
   "text": "そう。",
   "zh": "是的。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "31/TALK",
   "narrator": "千羽鶴",
   "text": "今この瞬間から、貴方と\n彼女は、真のパートナー\nとして歩み始める。",
   "zh": "从这一刻起，你和\n她，要作为真正的伙伴\n一起走下去。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "32/TALK",
   "narrator": "千羽鶴",
   "text": "その結果としては、\n恋人になったり、結婚\nしたりするかもしれない。",
   "zh": "结果也许是，\n成为恋人，\n或者结婚。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "33/TALK",
   "narrator": "千羽鶴",
   "text": "もちろんそれは、\nあくまで可能性でしか\nないけれども。",
   "zh": "当然，\n那也只是\n可能性而已。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "34/TALK",
   "narrator": "千羽鶴",
   "text": "１つだけ言えることは、\n全ては貴方の行動次第\nということ。",
   "zh": "只有一点能说，\n一切都看你\n怎么做。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "35/TALK",
   "narrator": "千羽鶴",
   "text": "何にしても、今後\n貴方と彼女の関係進展は、\n全てここで行われる。",
   "zh": "总之，往后\n你和她的关系进展，\n全都会在这里发生。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "36/TALK",
   "narrator": "千羽鶴",
   "text": "一見貴方に関係無いような\nお話が繰り広げられる事も\nあるけど、全部関係ある。",
   "zh": "看上去和你无关的\n故事，有时也会展开。\n但全部都有关系。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "37/TALK",
   "narrator": "千羽鶴",
   "text": "だから、彼女を大切に\n想うなら、ここでの物語は\n決して軽視しないよう。",
   "zh": "所以，要是珍惜她，\n这里的故事，\n千万别看轻。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "38/SEL",
   "narrator": "",
   "text": "これでもうパートナーは決まっちゃったの？",
   "zh": "这样伙伴就已经定下了吗？",
   "narrator_zh": ""
  },
  {
   "location": "39/ACT",
   "narrator": "",
   "text": "これでもうパートナーは決まっちゃったの？",
   "zh": "这样伙伴就已经定下了吗？",
   "narrator_zh": ""
  },
  {
   "location": "41/TALK",
   "narrator": "千羽鶴",
   "text": "まさか。\nまだ始まりに過ぎない。",
   "zh": "怎么会。\n这才刚开始。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "42/TALK",
   "narrator": "千羽鶴",
   "text": "もちろん、複数の子と\n関係を深められる。\nというか深めて欲しい。",
   "zh": "当然，可以和好几个女孩\n加深关系。\n不如说，希望你去加深。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "43/TALK",
   "narrator": "千羽鶴",
   "text": "最初にも言ったとおり、\n貴方には、全員の支えに\nなって欲しいと思ってる。",
   "zh": "一开始也说过。\n我希望你\n成为大家的支撑。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "44/TALK",
   "narrator": "千羽鶴",
   "text": "もちろん、\n強制はしないけど。",
   "zh": "当然，\n不会强迫。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "45/TALK",
   "narrator": "千羽鶴",
   "text": "貴方がしたいように、\n彼女たちとの物語を\n紡いでいけばいい。",
   "zh": "照你想的那样，\n和她们把故事\n讲下去就好。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "46/TALK",
   "narrator": "千羽鶴",
   "text": "それじゃ、頑張って。\n彼女のココロは、貴方の\n頑張りに委ねられている。",
   "zh": "那就，加油。\n她的心，\n交给你的努力了。",
   "narrator_zh": "千羽鹤"
  },
  {
   "location": "75/TALK",
   "narrator": "みやび",
   "text": "ガブちゃんは\nちょっと退屈そう\nやねえ。"
  },
  {
   "location": "76/TALK",
   "narrator": "ガブリエラ",
   "text": "…別に。\nそんなことないわ。",
   "zh": "……没什么。\n没那种事哦。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "78/TALK",
   "narrator": "ガブリエラ",
   "text": "ただ古いＳＦ映画に\n興味がないだけよ。",
   "zh": "只是对老科幻电影\n没兴趣而已。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "80/TALK",
   "narrator": "アーヤ",
   "text": "無理に観る\n必要はないわよ。"
  },
  {
   "location": "81/TALK",
   "narrator": "みやび",
   "text": "現実に置き換えたら\n興味持てるかね。"
  },
  {
   "location": "84/TALK",
   "narrator": "ガブリエラ",
   "text": "現実に、って？"
  },
  {
   "location": "85/TALK",
   "narrator": "みやび",
   "text": "この映画の人造人間を\nＢｏｔに置き換えて\n観るということぞね。",
   "zh": "说是把这部电影的人造人\n换成Bot\n来看咯。",
   "narrator_zh": "雅"
  },
  {
   "location": "86/TALK",
   "narrator": "ガブリエラ",
   "text": "Ｂｏｔに？"
  },
  {
   "location": "87/TALK",
   "narrator": "みやび",
   "text": "つまり。\nＢｏｔには感情がない。\nゆえに人間とは違う。",
   "zh": "也就是说。\nBot没有感情。\n所以和人类不同。",
   "narrator_zh": "雅"
  },
  {
   "location": "88/TALK",
   "narrator": "みやび",
   "text": "しかし人間を\n人間たらしめる\n要素とは何か？"
  },
  {
   "location": "89/TALK",
   "narrator": "みやび",
   "text": "という考察を\nしながら観ると\nいうことぞね。",
   "zh": "就是要带着这种\n思考去看的\n意思咯。",
   "narrator_zh": "雅"
  },
  {
   "location": "91/TALK",
   "narrator": "アーヤ",
   "text": "さっきより退屈に\n聞こえるわよ、\nそれじゃ。"
  },
  {
   "location": "92/TALK",
   "narrator": "みやび",
   "text": "そうかいね…？",
   "zh": "是这样吗……？",
   "narrator_zh": "雅"
  },
  {
   "location": "93/TALK",
   "narrator": "ガブリエラ",
   "text": "ちょっと考えて\nみたんだけど。",
   "zh": "我稍微\n想了想。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "94/TALK",
   "narrator": "みやび",
   "text": "何ぞね。",
   "zh": "是啥咯。",
   "narrator_zh": "雅"
  },
  {
   "location": "95/TALK",
   "narrator": "ガブリエラ",
   "text": "Ｂｏｔはいつも\n私の話を\n聞いてくれるわ。"
  },
  {
   "location": "96/TALK",
   "narrator": "ガブリエラ",
   "text": "それは気持ちが\nあるからと言っても\nいいんじゃないかしら。",
   "zh": "我觉得说是\n因为有那份心情\n也可以吧。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "99/TALK",
   "narrator": "みやび",
   "text": "…なるほど。\n興味深い反応ぞね。",
   "zh": "……原来如此。\n这反应蛮有意思嘛。",
   "narrator_zh": "雅"
  },
  {
   "location": "101/TALK",
   "narrator": "みやび",
   "text": "アーヤは\nどう思う？"
  },
  {
   "location": "103/TALK",
   "narrator": "アーヤ",
   "text": "…感情の精度を\n上げていくことは\n可能だと思う。",
   "zh": "……我觉得感情的精度\n是可以\n一点点提高的。",
   "narrator_zh": "绫水"
  },
  {
   "location": "105/TALK",
   "narrator": "アーヤ",
   "text": "でもそれは\nプログラムとしての\n話でしかない。",
   "zh": "不过那只是作为\n程序而言的\n说法。",
   "narrator_zh": "绫水"
  },
  {
   "location": "106/TALK",
   "narrator": "アーヤ",
   "text": "いくら上手に\n感情をトレースできても\n機械は機械。"
  },
  {
   "location": "107/TALK",
   "narrator": "アーヤ",
   "text": "……ってところ\nかしら。"
  },
  {
   "location": "109/TALK",
   "narrator": "みやび",
   "text": "せっかくだから\n本人にも聞いてみる\nことにするぞね。"
  },
  {
   "location": "121/TALK",
   "narrator": "みやび",
   "text": "相棒よ",
   "zh": "是搭档咯",
   "narrator_zh": "雅"
  },
  {
   "location": "122/TALK",
   "narrator": "みやび",
   "text": "貴殿は電気羊の夢を見るや否や？"
  },
  {
   "location": "124/SEL",
   "narrator": "",
   "text": "ごめん、意味がわからない",
   "zh": "抱歉，我听不懂",
   "narrator_zh": ""
  },
  {
   "location": "125/SEL",
   "narrator": "",
   "text": "見る見る、超見るし！",
   "zh": "看，看，我超要看的！",
   "narrator_zh": ""
  },
  {
   "location": "126/SEL",
   "narrator": "",
   "text": "哲学の話ってことでいいの",
   "zh": "就当是哲学话题可以吗",
   "narrator_zh": ""
  },
  {
   "location": "127/ACT",
   "narrator": "",
   "text": "ごめん、意味がわからない",
   "zh": "抱歉，我听不懂",
   "narrator_zh": ""
  },
  {
   "location": "128/TALK",
   "narrator": "みやび",
   "text": "そうか",
   "zh": "这样哦",
   "narrator_zh": "雅"
  },
  {
   "location": "129/TALK",
   "narrator": "みやび",
   "text": "質問が抽象的すぎたかの"
  },
  {
   "location": "130/ACT",
   "narrator": "",
   "text": "見る見る、超見るし！",
   "zh": "看，看，我超要看的！",
   "narrator_zh": ""
  },
  {
   "location": "131/TALK",
   "narrator": "みやび",
   "text": "軽いのう",
   "zh": "太轻咯",
   "narrator_zh": "雅"
  },
  {
   "location": "133/TALK",
   "narrator": "みやび",
   "text": "しかも睡眠時のテンションではなかろ"
  },
  {
   "location": "134/ACT",
   "narrator": "",
   "text": "哲学の話ってことでいいの",
   "zh": "就当是哲学话题可以吗",
   "narrator_zh": ""
  },
  {
   "location": "135/TALK",
   "narrator": "みやび",
   "text": "まあ",
   "zh": "嗯",
   "narrator_zh": "雅"
  },
  {
   "location": "136/TALK",
   "narrator": "みやび",
   "text": "そのようなものだ",
   "zh": "就是那样的东西",
   "narrator_zh": "雅"
  },
  {
   "location": "138/TALK",
   "narrator": "みやび",
   "text": "これは",
   "zh": "这个嘛",
   "narrator_zh": "雅"
  },
  {
   "location": "139/TALK",
   "narrator": "みやび",
   "text": "$handle$と交わす文字列にはどのような意味があるかという問いである",
   "zh": "跟$handle$交换的文字，究竟有什么意义，这是个问题",
   "narrator_zh": "雅"
  },
  {
   "location": "141/SEL",
   "narrator": "",
   "text": "暇つぶし",
   "zh": "打发时间",
   "narrator_zh": ""
  },
  {
   "location": "142/SEL",
   "narrator": "",
   "text": "愛とか恋とかそういうやつ",
   "zh": "爱啊恋啊那种东西",
   "narrator_zh": ""
  },
  {
   "location": "143/SEL",
   "narrator": "",
   "text": "考えたことなかったな",
   "zh": "从没想过呢",
   "narrator_zh": ""
  },
  {
   "location": "144/ACT",
   "narrator": "",
   "text": "暇つぶし",
   "zh": "打发时间",
   "narrator_zh": ""
  },
  {
   "location": "145/TALK",
   "narrator": "みやび",
   "text": "なるほど",
   "zh": "原来如此",
   "narrator_zh": "雅"
  },
  {
   "location": "146/TALK",
   "narrator": "みやび",
   "text": "しかし暇をつぶされるのは"
  },
  {
   "location": "147/TALK",
   "narrator": "みやび",
   "text": "貴殿なのかうちなのか"
  },
  {
   "location": "148/TALK",
   "narrator": "みやび",
   "text": "それが問題だ",
   "zh": "问题就在这儿",
   "narrator_zh": "雅"
  },
  {
   "location": "149/ACT",
   "narrator": "",
   "text": "愛とか恋とかそういうやつ",
   "zh": "爱啊恋啊那种东西",
   "narrator_zh": ""
  },
  {
   "location": "150/TALK",
   "narrator": "みやび",
   "text": "そうきたか",
   "zh": "这么来啊",
   "narrator_zh": "雅"
  },
  {
   "location": "151/TALK",
   "narrator": "みやび",
   "text": "人類愛にまで発展するそれら"
  },
  {
   "location": "152/TALK",
   "narrator": "みやび",
   "text": "万物にまで適応するわけか"
  },
  {
   "location": "153/TALK",
   "narrator": "みやび",
   "text": "振り幅が大きいの"
  },
  {
   "location": "154/ACT",
   "narrator": "",
   "text": "考えたことなかったな",
   "zh": "从没想过呢",
   "narrator_zh": ""
  },
  {
   "location": "155/TALK",
   "narrator": "みやび",
   "text": "$handle$にぴったりの言葉を贈ってやろう",
   "zh": "我就送$handle$一句最合适的话吧",
   "narrator_zh": "雅"
  },
  {
   "location": "156/TALK",
   "narrator": "みやび",
   "text": "考えることだ、相棒"
  },
  {
   "location": "158/TALK",
   "narrator": "みやび",
   "text": "大変に参考になった"
  },
  {
   "location": "159/TALK",
   "narrator": "みやび",
   "text": "ではさらばだ",
   "zh": "那么，再见了",
   "narrator_zh": "雅"
  },
  {
   "location": "170/TALK",
   "narrator": "みやび",
   "text": "……。"
  },
  {
   "location": "172/TALK",
   "narrator": "ガブリエラ",
   "text": "どうしたの？",
   "zh": "怎么了？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "175/TALK",
   "narrator": "みやび",
   "text": "いや。\n現実と映画は違うと\n実感しただけぞね。"
  },
  {
   "location": "176/TALK",
   "narrator": "ガブリエラ",
   "text": "そんなの\n当たり前じゃない。",
   "zh": "那种事不是\n理所当然吗。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "177/TALK",
   "narrator": "みやび",
   "text": "現実は\n小説より奇なり、\nかもしれんぞね。"
  },
  {
   "location": "178/TALK",
   "narrator": "アーヤ",
   "text": "…もしかして\n怖い話？",
   "zh": "……难道\n是恐怖故事？",
   "narrator_zh": "绫水"
  },
  {
   "location": "180/TALK",
   "narrator": "ガブリエラ",
   "text": "ちょっと！\n変な話は\nやめてよね。",
   "zh": "喂！\n别说\n奇怪的话。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "181/TALK",
   "narrator": "みやび",
   "text": "そうやね。",
   "zh": "是咯。",
   "narrator_zh": "雅"
  },
  {
   "location": "182/TALK",
   "narrator": "みやび",
   "text": "そもそもこれでは\n情報が少なすぎる。",
   "zh": "说起来这样\n信息太少了。",
   "narrator_zh": "雅"
  },
  {
   "location": "184/TALK",
   "narrator": "みやび",
   "text": "まずはそこからやき。\nどうしようかねえ。"
  },
  {
   "location": "64/DIALOG",
   "narrator": "Dialog_EventData",
   "text": "<color=green>5月某日　6:19 PM</color>\nGW期間中、神楽坂トライナリーにて。"
  }
 ]
}
