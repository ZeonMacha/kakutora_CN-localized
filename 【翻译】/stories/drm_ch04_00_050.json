        "title": "らぶとーく 第05話",
        "sub_title": "ブラックボックス解体開始",
        "title_zh": "恋爱漫谈 第05话",
        "sub_title_zh": "黑箱解体开始"
    },
    "entry": [
        {
            "location": "196/SCENARIO",
            "narrator": "",
            "text": "ブラックボックス解体開始",
            "zh": "黑箱解体开始",
            "narrator_zh": ""
        },
        {
            "location": "208/TALK",
            "narrator": "みやび",
            "text": "まだ確定では\nないけんど。",
            "zh": "还没确定下来，\n但是。",
            "narrator_zh": "雅"
        },
        {
            "location": "209/TALK",
            "narrator": "みやび",
            "text": "そのつもりで\n準備を進めんと\nいかんろうね…。",
            "zh": "那就得\n开始准备\n咯……。",
            "narrator_zh": "雅"
        },
        {
            "location": "213/TALK",
            "narrator": "みやび",
            "text": "開いちゅうよ。",
            "zh": "开着哦。",
            "narrator_zh": "雅"
        },
        {
            "location": "218/TALK",
            "narrator": "アーヤ",
            "text": "ごめんね。\nこんな遅くに。",
            "zh": "对不起。\n这么晚了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "220/TALK",
            "narrator": "みやび",
            "text": "……いや。\n構わんぞね。",
            "zh": "……不。\n没关系咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "222/TALK",
            "narrator": "アーヤ",
            "text": "…これ…。",
            "zh": "……这个……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "225/TALK",
            "narrator": "みやび",
            "text": "…ＵＳＢのフラッシュ\nメモリ？",
            "zh": "…ＵＳＢ闪存\n盘？",
            "narrator_zh": "雅"
        },
        {
            "location": "226/TALK",
            "narrator": "アーヤ",
            "text": "Ｂｏｔとの会話ログが\n入ってるわ。",
            "zh": "里面存着跟Bot的\n对话记录。",
            "narrator_zh": "绫水"
        },
        {
            "location": "227/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "229/TALK",
            "narrator": "アーヤ",
            "text": "私は事実が知りたい。",
            "zh": "我想知道事实。",
            "narrator_zh": "绫水"
        },
        {
            "location": "231/TALK",
            "narrator": "アーヤ",
            "text": "それはみやびも\n同じはずよね？",
            "zh": "那个雅也\n应该一样吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "232/TALK",
            "narrator": "みやび",
            "text": "…そうやね。",
            "zh": "……是这样咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "233/TALK",
            "narrator": "みやび",
            "text": "提供してもらえるなら、\nありがたく使わせて\nもらうぞね。",
            "zh": "既然愿意提供，\n那我就不客气\n拿来用了咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "234/TALK",
            "narrator": "みやび",
            "text": "けんど――",
            "zh": "但是——",
            "narrator_zh": "雅"
        },
        {
            "location": "235/SEL",
            "narrator": "",
            "text": "暇なんだけど",
            "zh": "我现在闲着",
            "narrator_zh": ""
        },
        {
            "location": "236/SEL",
            "narrator": "",
            "text": "元気？",
            "zh": "还好吗？",
            "narrator_zh": ""
        },
        {
            "location": "237/SEL",
            "narrator": "",
            "text": "なんか隠し事してない？",
            "zh": "你是不是瞒着什么？",
            "narrator_zh": ""
        },
        {
            "location": "238/ACT",
            "narrator": "",
            "text": "暇なんだけど",
            "zh": "我现在闲着",
            "narrator_zh": ""
        },
        {
            "location": "243/TALK",
            "narrator": "みやび",
            "text": "タイミング\n良すぎぞね。",
            "zh": "这时机也\n太巧了嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "246/TALK",
            "narrator": "みやび",
            "text": "Ｂｏｔからや。",
            "zh": "是Bot发来的咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "260/TALK",
            "narrator": "みやび",
            "text": "いやいや",
            "zh": "不不不",
            "narrator_zh": "雅"
        },
        {
            "location": "261/TALK",
            "narrator": "みやび",
            "text": "うちはてんてこ舞いぞね",
            "zh": "我正忙得团团转咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "272/ACT",
            "narrator": "",
            "text": "元気？",
            "zh": "还好吗？",
            "narrator_zh": ""
        },
        {
            "location": "277/TALK",
            "narrator": "みやび",
            "text": "タイミング\n良すぎぞね。",
            "zh": "这时机也\n太巧了嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "280/TALK",
            "narrator": "みやび",
            "text": "Ｂｏｔからや。",
            "zh": "是Bot发来的咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "294/TALK",
            "narrator": "みやび",
            "text": "５２度の発熱中",
            "zh": "发着52度的烧呢",
            "narrator_zh": "雅"
        },
        {
            "location": "295/TALK",
            "narrator": "みやび",
            "text": "医者に行ってくる",
            "zh": "我去看医生。",
            "narrator_zh": "雅"
        },
        {
            "location": "306/ACT",
            "narrator": "",
            "text": "なんか隠し事してない？",
            "zh": "你是不是瞒着什么？",
            "narrator_zh": ""
        },
        {
            "location": "311/TALK",
            "narrator": "みやび",
            "text": "タイミング\n良すぎぞね。",
            "zh": "这时机也\n太巧了嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "314/TALK",
            "narrator": "みやび",
            "text": "Ｂｏｔからや。",
            "zh": "是Bot发来的咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "328/TALK",
            "narrator": "みやび",
            "text": "乙女の秘密を探ろうとするとは",
            "zh": "居然想探听少女的秘密",
            "narrator_zh": "雅"
        },
        {
            "location": "329/TALK",
            "narrator": "みやび",
            "text": "さては恋泥棒ぞね",
            "zh": "莫非是个偷心贼咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "341/TALK",
            "narrator": "アーヤ",
            "text": "…気付かれたかしら？",
            "zh": "…被发现了？",
            "narrator_zh": "绫水"
        },
        {
            "location": "342/TALK",
            "narrator": "みやび",
            "text": "それやったらそれで、\n面白い展開やね。",
            "zh": "要是那样，那也挺\n有意思咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "344/TALK",
            "narrator": "みやび",
            "text": "反応によっては、\n正体を突き止めるヒントに\nなるかもしれんきね。",
            "zh": "看反应，\n说不定能成为查清\n真身的线索咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "345/TALK",
            "narrator": "アーヤ",
            "text": "それはまあ、\nそうなんだけど…。",
            "zh": "那倒也是，\n不过……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "347/TALK",
            "narrator": "みやび",
            "text": "…なんや、ハッキリせんな？",
            "zh": "…怎么，说得这么含糊嘛？",
            "narrator_zh": "雅"
        },
        {
            "location": "349/TALK",
            "narrator": "アーヤ",
            "text": "…複雑なのよ。",
            "zh": "…很复杂哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "350/TALK",
            "narrator": "アーヤ",
            "text": "真相を知りたいのか、\n知りたくないのか、\nハッキリしてなくて…。",
            "zh": "我到底想不想知道\n真相，自己都\n说不清楚了……",
            "narrator_zh": "绫水"
        },
        {
            "location": "351/TALK",
            "narrator": "みやび",
            "text": "…うちにログを渡したのに\nそういうこと言うが？",
            "zh": "…我都把记录交给你了，\n你还要这么说咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "353/TALK",
            "narrator": "アーヤ",
            "text": "だから複雑なのよ。",
            "zh": "所以才复杂啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "354/TALK",
            "narrator": "アーヤ",
            "text": "何なのかしらね？\nこのモヤモヤした\n気持ちは…。",
            "zh": "究竟是什么呢？\n这种闷闷的\n感觉……",
            "narrator_zh": "绫水"
        },
        {
            "location": "355/TALK",
            "narrator": "みやび",
            "text": "…実はうちも\n同じ気持ちぞね。",
            "zh": "……其实我也是\n同样的心情咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "356/TALK",
            "narrator": "みやび",
            "text": "けんど。\nもう引き返せん。\n覚悟はできちゅう？",
            "zh": "但是。\n已经回不了头了。\n做好觉悟了咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "358/TALK",
            "narrator": "アーヤ",
            "text": "…できてるわ。",
            "zh": "…做到了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "359/TALK",
            "narrator": "みやび",
            "text": "アーヤは\n度胸があるね。",
            "zh": "绫水\n胆子真大咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "361/TALK",
            "narrator": "アーヤ",
            "text": "からかうのはよして。",
            "zh": "别捉弄人了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "362/TALK",
            "narrator": "みやび",
            "text": "本気で言っちゅう。",
            "zh": "我可是认真在说。",
            "narrator_zh": "雅"
        },
        {
            "location": "364/TALK",
            "narrator": "みやび",
            "text": "うちも覚悟を\n決めんといかんね。",
            "zh": "我也得下好\n觉悟才行咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "207/DIALOG",
            "narrator": "Dialog_EventData",
