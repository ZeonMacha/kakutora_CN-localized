{
    "dir": "chap00/daydra/spev_ch04_005.js",
    "type": "",
    "info": {
        "story_id": "4005",
        "cid": "",
        "title": "スペシャルエピソード",
        "sub_title": "来世までお預け",
        "title_zh": "特别篇",
        "sub_title_zh": "留到下辈子再说"
    },
    "entry": [
        {
            "location": "22/TALK",
            "narrator": "透明みやび",
            "text": "はぁ…どうしてうちまで\nこんな息苦しい服着んと\nいかんのやろか…。",
            "zh": "唉……为驷马连我也得\n穿这种憋得慌的衣服\n不可咯……",
            "narrator_zh": "透明雅"
        },
        {
            "location": "23/TALK",
            "narrator": "透明みやび",
            "text": "こっちは結婚する予定も\n相手もいない女子高生\nやぞ？",
            "zh": "我可是连结婚打算和对象\n都没得的女高中生\n咯？",
            "narrator_zh": "透明雅"
        },
        {
            "location": "24/TALK",
            "narrator": "透明みやび",
            "text": "みんなも相手もおらん\nっちゅうのに…、\n乙女心は面倒やなぁ…。",
            "zh": "大家明明也都\n没得对象嘛……，\n少女心真是麻烦咯……",
            "narrator_zh": "透明雅"
        },
        {
            "location": "26/TALK",
            "narrator": "透明みやび",
            "text": "はぁ…。",
            "zh": "唉……",
            "narrator_zh": "透明雅"
        },
        {
            "location": "27/SEL",
            "narrator": "（選択肢）",
            "text": "素敵だね",
            "zh": "真好看呢",
            "narrator_zh": "（选项）"
        },
        {
            "location": "28/ACT",
            "narrator": "",
            "text": "素敵だね",
            "zh": "真好看呢",
            "narrator_zh": ""
        },
        {
            "location": "33/TALK",
            "narrator": "透明みやび",
            "text": "…見られちょったか。\nまあ、予想通りやけんど。",
            "zh": "……被你看到了咩。\n嘛，虽然都在预料之中就是了。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "38/TALK",
            "narrator": "みやび",
            "text": "そりゃどうも",
            "zh": "那还真是多谢",
            "narrator_zh": "雅"
        },
        {
            "location": "40/TALK",
            "narrator": "みやび",
            "text": "サンキューメルシー",
            "zh": "Thank you Merci",
            "narrator_zh": "雅"
        },
        {
            "location": "41/TALK",
            "narrator": "みやび",
            "text": "では脱ぐとしよう",
            "zh": "那么这就脱了吧",
            "narrator_zh": "雅"
        },
        {
            "location": "42/SEL",
            "narrator": "（選択肢）",
            "text": "いや、まだ早いでしょ！？",
            "zh": "不，这也太早了吧！？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "43/SEL",
            "narrator": "（選択肢）",
            "text": "じゃあ、また後で",
            "zh": "那就，待会儿再说",
            "narrator_zh": "（选项）"
        },
        {
            "location": "44/ACT",
            "narrator": "",
            "text": "いや、まだ早いでしょ！？",
            "zh": "不，这也太早了吧！？",
            "narrator_zh": ""
        },
        {
            "location": "45/TALK",
            "narrator": "みやび",
            "text": "早いも遅いもない",
            "zh": "没得早不早的说法",
            "narrator_zh": "雅"
        },
        {
            "location": "46/TALK",
            "narrator": "みやび",
            "text": "ウエディングドレスの試着をした",
            "zh": "我试穿了婚纱",
            "narrator_zh": "雅"
        },
        {
            "location": "47/TALK",
            "narrator": "みやび",
            "text": "し終わったら脱ぐ",
            "zh": "试穿完了就脱掉",
            "narrator_zh": "雅"
        },
        {
            "location": "48/TALK",
            "narrator": "みやび",
            "text": "これ当然",
            "zh": "天经地义",
            "narrator_zh": "雅"
        },
        {
            "location": "49/TALK",
            "narrator": "みやび",
            "text": "故に脱ぐのだ",
            "zh": "所以就要脱掉",
            "narrator_zh": "雅"
        },
        {
            "location": "50/ACT",
            "narrator": "",
            "text": "じゃあ、また後で",
            "zh": "那就，待会儿再说",
            "narrator_zh": ""
        },
        {
            "location": "51/TALK",
            "narrator": "みやび",
            "text": "うむ",
            "zh": "嗯",
            "narrator_zh": "雅"
        },
        {
            "location": "55/SEL",
            "narrator": "（選択肢）",
            "text": "もうちょっと見せてよ",
            "zh": "再多给我看一会儿嘛",
            "narrator_zh": "（选项）"
        },
        {
            "location": "56/ACT",
            "narrator": "",
            "text": "もうちょっと見せてよ",
            "zh": "再多给我看一会儿嘛",
            "narrator_zh": ""
        },
        {
            "location": "59/TALK",
            "narrator": "みやび",
            "text": "それは構わんが",
            "zh": "那倒无所谓",
            "narrator_zh": "雅"
        },
        {
            "location": "60/TALK",
            "narrator": "みやび",
            "text": "楽しいか？",
            "zh": "有那么开心咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "62/TALK",
            "narrator": "みやび",
            "text": "うちのこんな姿見て",
            "zh": "看我这副样子",
            "narrator_zh": "雅"
        },
        {
            "location": "63/TALK",
            "narrator": "みやび",
            "text": "何が楽しい？",
            "zh": "有驷马好看的？",
            "narrator_zh": "雅"
        },
        {
            "location": "64/SEL",
            "narrator": "（選択肢）",
            "text": "すごく綺麗だから",
            "zh": "因为真的非常漂亮",
            "narrator_zh": "（选项）"
        },
        {
            "location": "65/SEL",
            "narrator": "（選択肢）",
            "text": "滅多に見られないと思うから",
            "zh": "因为觉得难得能见到一次",
            "narrator_zh": "（选项）"
        },
        {
            "location": "66/ACT",
            "narrator": "",
            "text": "すごく綺麗だから",
            "zh": "因为真的非常漂亮",
            "narrator_zh": ""
        },
        {
            "location": "69/TALK",
            "narrator": "みやび",
            "text": "そうであろう",
            "zh": "那可不是嘛",
            "narrator_zh": "雅"
        },
        {
            "location": "71/TALK",
            "narrator": "みやび",
            "text": "えい生地のウエディングドレスである",
            "zh": "这婚纱面料倒是蛮好的",
            "narrator_zh": "雅"
        },
        {
            "location": "72/TALK",
            "narrator": "みやび",
            "text": "触り心地はよい",
            "zh": "摸起来手感不错",
            "narrator_zh": "雅"
        },
        {
            "location": "73/TALK",
            "narrator": "みやび",
            "text": "締め付けは拷問",
            "zh": "勒得跟酷刑一样",
            "narrator_zh": "雅"
        },
        {
            "location": "74/SEL",
            "narrator": "（選択肢）",
            "text": "いや、みやびのことだよ",
            "zh": "不，我是在说雅你啦",
            "narrator_zh": "（选项）"
        },
        {
            "location": "75/ACT",
            "narrator": "",
            "text": "いや、みやびのことだよ",
            "zh": "不，我是在说雅你啦",
            "narrator_zh": ""
        },
        {
            "location": "79/TALK",
            "narrator": "みやび",
            "text": "いや",
            "zh": "不是",
            "narrator_zh": "雅"
        },
        {
            "location": "80/TALK",
            "narrator": "みやび",
            "text": "冗談にマジ返しはズルい",
            "zh": "对玩笑话认真回击也太赖皮了",
            "narrator_zh": "雅"
        },
        {
            "location": "82/TALK",
            "narrator": "みやび",
            "text": "空気嫁",
            "zh": "读空妻",
            "narrator_zh": "雅"
        },
        {
            "location": "84/TALK",
            "narrator": "みやび",
            "text": "読め",
            "zh": "是读空气",
            "narrator_zh": "雅"
        },
        {
            "location": "85/TALK",
            "narrator": "みやび",
            "text": "そしてうちをからかうな",
            "zh": "还有别拿我寻开心",
            "narrator_zh": "雅"
        },
        {
            "location": "86/ACT",
            "narrator": "",
            "text": "滅多に見られないと思うから",
            "zh": "因为觉得难得能见到一次",
            "narrator_zh": ""
        },
        {
            "location": "88/TALK",
            "narrator": "みやび",
            "text": "当然過ぎる",
            "zh": "再正常不过了",
            "narrator_zh": "雅"
        },
        {
            "location": "89/TALK",
            "narrator": "みやび",
            "text": "頻繁にウエディングドレス着るとか",
            "zh": "动不动就穿婚纱什么的",
            "narrator_zh": "雅"
        },
        {
            "location": "90/TALK",
            "narrator": "みやび",
            "text": "普通はない",
            "zh": "一般人哪会干",
            "narrator_zh": "雅"
        },
        {
            "location": "91/TALK",
            "narrator": "みやび",
            "text": "結婚詐欺師か",
            "zh": "难道是结婚欺诈师",
            "narrator_zh": "雅"
        },
        {
            "location": "92/TALK",
            "narrator": "みやび",
            "text": "ウエディングドレス専門モデルか？",
            "zh": "还是婚纱专用模特咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "94/TALK",
            "narrator": "みやび",
            "text": "まあ",
            "zh": "嘛",
            "narrator_zh": "雅"
        },
        {
            "location": "95/TALK",
            "narrator": "みやび",
            "text": "もう脱いでえいな？",
            "zh": "现在可以脱了得咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "96/SEL",
            "narrator": "（選択肢）",
            "text": "結婚式に憧れないの",
            "zh": "你不向往婚礼吗",
            "narrator_zh": "（选项）"
        },
        {
            "location": "97/ACT",
            "narrator": "",
            "text": "結婚式に憧れないの",
            "zh": "你不向往婚礼吗",
            "narrator_zh": ""
        },
        {
            "location": "100/TALK",
            "narrator": "みやび",
            "text": "ない",
            "zh": "没得",
            "narrator_zh": "雅"
        },
        {
            "location": "101/TALK",
            "narrator": "みやび",
            "text": "面倒くさい",
            "zh": "太麻烦",
            "narrator_zh": "雅"
        },
        {
            "location": "103/TALK",
            "narrator": "みやび",
            "text": "金かかる",
            "zh": "又花钱",
            "narrator_zh": "雅"
        },
        {
            "location": "104/TALK",
            "narrator": "みやび",
            "text": "ウエディングドレスマジ息苦しい",
            "zh": "婚纱实在勒得喘不过气",
            "narrator_zh": "雅"
        },
        {
            "location": "105/TALK",
            "narrator": "みやび",
            "text": "何故する必要が？",
            "zh": "为驷马非办不可？",
            "narrator_zh": "雅"
        },
        {
            "location": "106/SEL",
            "narrator": "（選択肢）",
            "text": "可愛いみやびを見てもらいたい",
            "zh": "想让大家看看可爱的雅",
            "narrator_zh": "（选项）"
        },
        {
            "location": "107/SEL",
            "narrator": "（選択肢）",
            "text": "きっと楽しいよ",
            "zh": "肯定会很开心的哦",
            "narrator_zh": "（选项）"
        },
        {
            "location": "108/ACT",
            "narrator": "",
            "text": "可愛いみやびを見てもらいたい",
            "zh": "想让大家看看可爱的雅",
            "narrator_zh": ""
        },
        {
            "location": "110/TALK",
            "narrator": "みやび",
            "text": "意味不明",
            "zh": "莫名其妙",
            "narrator_zh": "雅"
        },
        {
            "location": "111/TALK",
            "narrator": "みやび",
            "text": "何故相棒がそう思う？",
            "zh": "搭档为驷马会那么想？",
            "narrator_zh": "雅"
        },
        {
            "location": "112/SEL",
            "narrator": "（選択肢）",
            "text": "未来の夫なので",
            "zh": "因为我是未来的丈夫嘛",
            "narrator_zh": "（选项）"
        },
        {
            "location": "113/SEL",
            "narrator": "（選択肢）",
            "text": "可愛いからみんなに見せたい",
            "zh": "因为很可爱所以想让大家看看",
            "narrator_zh": "（选项）"
        },
        {
            "location": "114/ACT",
            "narrator": "",
            "text": "未来の夫なので",
            "zh": "因为我是未来的丈夫嘛",
            "narrator_zh": ""
        },
        {
            "location": "115/TALK",
            "narrator": "みやび",
            "text": "あらまあビックリ",
            "zh": "哎呀妈呀吓我一跳",
            "narrator_zh": "雅"
        },
        {
            "location": "116/TALK",
            "narrator": "みやび",
            "text": "いつからそんなことに？",
            "zh": "几时变成那样的事了？",
            "narrator_zh": "雅"
        },
        {
            "location": "117/TALK",
            "narrator": "みやび",
            "text": "初耳過ぎてついて行けん",
            "zh": "头一回听得太突然，完全跟不上节奏",
            "narrator_zh": "雅"
        },
        {
            "location": "118/ACT",
            "narrator": "",
            "text": "可愛いからみんなに見せたい",
            "zh": "因为很可爱所以想让大家看看",
            "narrator_zh": ""
        },
        {
            "location": "120/TALK",
            "narrator": "みやび",
            "text": "いや",
            "zh": "不对",
            "narrator_zh": "雅"
        },
        {
            "location": "121/TALK",
            "narrator": "みやび",
            "text": "理由になってない",
            "zh": "这根本不算理由",
            "narrator_zh": "雅"
        },
        {
            "location": "122/TALK",
            "narrator": "みやび",
            "text": "それと重大な頼みを言う",
            "zh": "还有，提个重要请求",
            "narrator_zh": "雅"
        },
        {
            "location": "123/TALK",
            "narrator": "みやび",
            "text": "可愛い可愛い連呼するな",
            "zh": "别连着喊可爱可爱的",
            "narrator_zh": "雅"
        },
        {
            "location": "124/TALK",
            "narrator": "みやび",
            "text": "さすがにうちも",
            "zh": "再怎么说我也是会",
            "narrator_zh": "雅"
        },
        {
            "location": "125/TALK",
            "narrator": "みやび",
            "text": "顔が熱くなる",
            "zh": "脸发烫的",
            "narrator_zh": "雅"
        },
        {
            "location": "127/ACT",
            "narrator": "",
            "text": "きっと楽しいよ",
            "zh": "肯定会很开心的哦",
            "narrator_zh": ""
        },
        {
            "location": "129/TALK",
            "narrator": "みやび",
            "text": "そうだろうか？",
            "zh": "会那样咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "130/TALK",
            "narrator": "みやび",
            "text": "いや",
            "zh": "不过",
            "narrator_zh": "雅"
        },
        {
            "location": "131/TALK",
            "narrator": "みやび",
            "text": "ブーケ投げは楽しそうだ",
            "zh": "抛捧花倒是挺好玩的",
            "narrator_zh": "雅"
        },
        {
            "location": "132/TALK",
            "narrator": "みやび",
            "text": "未婚の売れ残りよ",
            "zh": "未婚的剩女们啊",
            "narrator_zh": "雅"
        },
        {
            "location": "133/TALK",
            "narrator": "みやび",
            "text": "うちの花を奪い合え！",
            "zh": "来争抢我的捧花吧！",
            "narrator_zh": "雅"
        },
        {
            "location": "135/TALK",
            "narrator": "みやび",
            "text": "そう言いながら投げる",
            "zh": "一边这么喊一边扔出去",
            "narrator_zh": "雅"
        },
        {
            "location": "136/TALK",
            "narrator": "みやび",
            "text": "言うのはもちろん",
            "zh": "当然要喊出口的",
            "narrator_zh": "雅"
        },
        {
            "location": "137/TALK",
            "narrator": "みやび",
            "text": "心の中で",
            "zh": "是在心里喊",
            "narrator_zh": "雅"
        },
        {
            "location": "140/TALK",
            "narrator": "みやび",
            "text": "何であれ",
            "zh": "不管怎么说",
            "narrator_zh": "雅"
        },
        {
            "location": "141/TALK",
            "narrator": "みやび",
            "text": "次に着るのは何十年後？",
            "zh": "下回再穿会是几十年后？",
            "narrator_zh": "雅"
        },
        {
            "location": "142/TALK",
            "narrator": "みやび",
            "text": "または来世？",
            "zh": "还是下辈子？",
            "narrator_zh": "雅"
        },
        {
            "location": "143/TALK",
            "narrator": "みやび",
            "text": "次回をお楽しみに",
            "zh": "敬请期待下回",
            "narrator_zh": "雅"
        },
        {
            "location": "144/TALK",
            "narrator": "みやび",
            "text": "※来ない可能性もありますが当方は一切の責任を負いません",
            "zh": "※也存在永远不会到来的可能性，本方对此概不负责",
            "narrator_zh": "雅"
        },
        {
            "location": "146/TALK",
            "narrator": "透明みやび",
            "text": "ふむ…さてと、\nさっさと脱いで…。",
            "zh": "唔……那么，\n赶紧脱掉……",
            "narrator_zh": "透明雅"
        },
        {
            "location": "147/TALK",
            "narrator": "透明ガブリエラ",
            "text": "みやびー。\nまだなの？",
            "zh": "雅——。\n还没好吗？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "149/TALK",
            "narrator": "透明みやび",
            "text": "ん？　ガブちゃん？",
            "zh": "嗯？　加布？",
            "narrator_zh": "透明雅"
        },
        {
            "location": "150/TALK",
            "narrator": "透明ガブリエラ",
            "text": "みんな準備できてるん\nだから、みやびも早く\n出てきなさいよ。",
            "zh": "大家都准备好了，\n雅你也快点\n出来呀。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "151/TALK",
            "narrator": "透明神楽",
            "text": "記念撮影しますから、\nみやびさんも\n早く出てきてください。",
            "zh": "要拍纪念照了，\n雅也\n快点出来吧。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "152/TALK",
            "narrator": "透明みやび",
            "text": "いや、うちは…。",
            "zh": "不，我就算了……",
            "narrator_zh": "透明雅"
        },
