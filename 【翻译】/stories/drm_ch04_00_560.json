    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "480_祭りだ祭りだ",
            "zh": "480_祭典啦祭典啦",
            "narrator_zh": ""
        },
        {
            "location": "32/TALK",
            "narrator": "みやび",
            "text": "お内裏様とお雛様",
            "zh": "男雏人偶和女雏人偶咯",
            "narrator_zh": "雅"
        },
        {
            "location": "33/TALK",
            "narrator": "みやび",
            "text": "今日は楽しいひな祭り",
            "zh": "今天是快乐的女儿节",
            "narrator_zh": "雅"
        },
        {
            "location": "35/SEL",
            "narrator": "",
            "text": "今夜はご馳走だ！",
            "zh": "今晚吃大餐！",
            "narrator_zh": ""
        },
        {
            "location": "36/SEL",
            "narrator": "",
            "text": "日付をお間違えでは",
            "zh": "你是不是把日子搞错了",
            "narrator_zh": ""
        },
        {
            "location": "37/SEL",
            "narrator": "",
            "text": "$me$とみやびのことだよね",
            "zh": "是$me$和雅的事吧",
            "narrator_zh": ""
        },
        {
            "location": "38/ACT",
            "narrator": "",
            "text": "今夜はご馳走だ！",
            "zh": "今晚吃大餐！",
            "narrator_zh": ""
        },
        {
            "location": "39/TALK",
            "narrator": "みやび",
            "text": "ちらし寿司だ！",
            "zh": "散寿司！",
            "narrator_zh": "雅"
        },
        {
            "location": "41/TALK",
            "narrator": "みやび",
            "text": "雛あられだ！",
            "zh": "女儿节米果！",
            "narrator_zh": "雅"
        },
        {
            "location": "42/ACT",
            "narrator": "",
            "text": "日付をお間違えでは",
            "zh": "你是不是把日子搞错了",
            "narrator_zh": ""
        },
        {
            "location": "43/TALK",
            "narrator": "みやび",
            "text": "物の例えだ",
            "zh": "只是打个比方",
            "narrator_zh": "雅"
        },
        {
            "location": "44/TALK",
            "narrator": "みやび",
            "text": "ばかちんが",
            "zh": "这笨蛋",
            "narrator_zh": "雅"
        },
        {
            "location": "45/ACT",
            "narrator": "",
            "text": "$me$とみやびのことだよね",
            "zh": "是$me$和雅的事吧",
            "narrator_zh": ""
        },
        {
            "location": "55/TALK",
            "narrator": "みやび",
            "text": "何を言うか",
            "zh": "说什么呢",
            "narrator_zh": "雅"
        },
        {
            "location": "56/TALK",
            "narrator": "みやび",
            "text": "$handle$め",
            "zh": "$handle$这家伙",
            "narrator_zh": "雅"
        },
        {
            "location": "57/TALK",
            "narrator": "みやび",
            "text": "もっとこう",
            "zh": "再这样一点",
            "narrator_zh": "雅"
        },
        {
            "location": "58/TALK",
            "narrator": "みやび",
            "text": "洒落た言い方はできぬのか",
            "zh": "就不能来点潇洒的说法吗",
            "narrator_zh": "雅"
        },
        {
            "location": "59/TALK",
            "narrator": "みやび",
            "text": "朴念仁め",
            "zh": "真是个木头人",
            "narrator_zh": "雅"
        },
        {
            "location": "61/TALK",
            "narrator": "みやび",
            "text": "ガブちゃんあたりなら",
            "zh": "要是加布的话",
            "narrator_zh": "雅"
        },
        {
            "location": "62/TALK",
            "narrator": "みやび",
            "text": "アメリカのアニメのお姫様あたりを",
            "zh": "八成会想象美国动画里",
            "narrator_zh": "雅"
        },
        {
            "location": "63/TALK",
            "narrator": "みやび",
            "text": "想像するのだろうが",
            "zh": "的那种公主吧",
            "narrator_zh": "雅"
        },
        {
            "location": "64/TALK",
            "narrator": "みやび",
            "text": "うちにとってはお姫様とは",
            "zh": "但对我来说，公主嘛",
            "narrator_zh": "雅"
        },
        {
            "location": "65/TALK",
            "narrator": "みやび",
            "text": "こんな感じぞね",
            "zh": "就是这种感觉咯",
            "narrator_zh": "雅"
        },
        {
            "location": "67/SEL",
            "narrator": "",
            "text": "みやびらしいね",
            "zh": "很有雅的风格",
            "narrator_zh": ""
        },
        {
            "location": "68/SEL",
            "narrator": "",
            "text": "じゃあ$me$はお内裏様だね",
            "zh": "那$me$就是男娃娃了呢",
            "narrator_zh": ""
        },
        {
            "location": "69/SEL",
            "narrator": "",
            "text": "四民平等！",
            "zh": "四民平等！",
            "narrator_zh": ""
        },
        {
            "location": "70/ACT",
            "narrator": "",
            "text": "みやびらしいね",
            "zh": "很有雅的风格",
            "narrator_zh": ""
        },
        {
            "location": "71/TALK",
            "narrator": "みやび",
            "text": "うむ",
            "zh": "嗯",
            "narrator_zh": "雅"
        },
        {
            "location": "72/TALK",
            "narrator": "みやび",
            "text": "そうかもしれん",
            "zh": "说不准就是这样",
            "narrator_zh": "雅"
        },
        {
            "location": "73/ACT",
            "narrator": "",
            "text": "じゃあ$me$はお内裏様だね",
            "zh": "那$me$就是男娃娃了呢",
            "narrator_zh": ""
        },
        {
            "location": "74/TALK",
            "narrator": "みやび",
            "text": "なるほど",
            "zh": "原来如此",
            "narrator_zh": "雅"
        },
        {
            "location": "75/TALK",
            "narrator": "みやび",
            "text": "それもいいかもしれん",
            "zh": "那也许也好咯",
            "narrator_zh": "雅"
        },
        {
            "location": "76/ACT",
            "narrator": "",
            "text": "四民平等！",
            "zh": "四民平等！",
            "narrator_zh": ""
        },
        {
            "location": "77/TALK",
            "narrator": "みやび",
            "text": "日本史か",
            "zh": "这是扯到日本史了吗",
            "narrator_zh": "雅"
        },
        {
            "location": "79/TALK",
            "narrator": "みやび",
            "text": "時代錯誤め",
            "zh": "时代错乱的家伙",
            "narrator_zh": "雅"
        },
        {
            "location": "81/TALK",
            "narrator": "みやび",
            "text": "女子はお姫様に憧れると言うので",
            "zh": "既然都说女孩子憧憬公主",
            "narrator_zh": "雅"
        },
        {
            "location": "82/TALK",
            "narrator": "みやび",
            "text": "ちょっと想像してみたが",
            "zh": "我稍微想象了一下嘛",
            "narrator_zh": "雅"
        },
        {
            "location": "83/TALK",
            "narrator": "みやび",
            "text": "こういうのではない気がしてきた",
            "zh": "我渐渐觉得好像不是这种咯",
            "narrator_zh": "雅"
        },
        {
            "location": "85/SEL",
            "narrator": "",
            "text": "ちやほやされたいってことじゃない",
            "zh": "不是想让人捧我",
            "narrator_zh": ""
        },
        {
            "location": "86/SEL",
            "narrator": "",
            "text": "実生活は窮屈だと思うよ",
            "zh": "我觉得现实生活很拘束哦",
            "narrator_zh": ""
        },
        {
            "location": "87/ACT",
            "narrator": "",
            "text": "ちやほやされたいってことじゃない",
            "zh": "不是想让人捧我",
            "narrator_zh": ""
        },
        {
            "location": "88/TALK",
            "narrator": "みやび",
            "text": "そういうことなのか",
            "zh": "是这么回事啊",
            "narrator_zh": "雅"
        },
        {
            "location": "89/ACT",
            "narrator": "",
            "text": "実生活は窮屈だと思うよ",
            "zh": "我觉得现实生活很拘束哦",
            "narrator_zh": ""
        },
        {
            "location": "90/TALK",
            "narrator": "みやび",
            "text": "ロイヤルファミリーか",
            "zh": "是说王室吗",
            "narrator_zh": "雅"
        },
        {
            "location": "92/TALK",
            "narrator": "みやび",
            "text": "せっかくだ",
            "zh": "机会难得嘛",
            "narrator_zh": "雅"
        },
        {
            "location": "93/TALK",
            "narrator": "みやび",
            "text": "$handle$はうちをお姫さま扱いせい",
            "zh": "$handle$要把我当公主对待咯",
            "narrator_zh": "雅"
        },
        {
            "location": "95/SEL",
            "narrator": "",
            "text": "良きに計らえ",
            "zh": "你看着办吧",
            "narrator_zh": ""
        },
        {
            "location": "96/SEL",
            "narrator": "",
            "text": "みやび姫ー！",
            "zh": "雅公主——！",
            "narrator_zh": ""
        },
        {
            "location": "97/SEL",
            "narrator": "",
            "text": "まず設定を固めないと",
            "zh": "得先定好设定才行",
            "narrator_zh": ""
        },
        {
            "location": "98/ACT",
            "narrator": "",
            "text": "良きに計らえ",
            "zh": "你看着办吧",
            "narrator_zh": ""
        },
        {
            "location": "99/TALK",
            "narrator": "みやび",
            "text": "それでは$handle$が姫役ではないか",
            "zh": "那么不就该$handle$来当公主吗",
            "narrator_zh": "雅"
        },
        {
            "location": "100/TALK",
            "narrator": "みやび",
            "text": "$handle$姫め",
            "zh": "$handle$公主咯",
            "narrator_zh": "雅"
        },
        {
            "location": "103/ACT",
            "narrator": "",
            "text": "みやび姫ー！",
            "zh": "雅公主——！",
            "narrator_zh": ""
        },
        {
            "location": "104/TALK",
            "narrator": "みやび",
            "text": "やはり",
            "zh": "果然",
            "narrator_zh": "雅"
        },
        {
            "location": "105/TALK",
            "narrator": "みやび",
            "text": "和風から脱却できんの",
            "zh": "就摆脱不了和风吗",
            "narrator_zh": "雅"
        },
        {
            "location": "106/ACT",
            "narrator": "",
            "text": "まず設定を固めないと",
            "zh": "得先定好设定才行",
            "narrator_zh": ""
        },
        {
            "location": "107/TALK",
            "narrator": "みやび",
            "text": "いやいや",
            "zh": "不不不",
            "narrator_zh": "雅"
        },
        {
            "location": "108/TALK",
            "narrator": "みやび",
            "text": "役作りをしたいわけではない",
            "zh": "又不是要入戏扮角色",
            "narrator_zh": "雅"
        },
        {
            "location": "110/TALK",
            "narrator": "みやび",
            "text": "そういえば",
            "zh": "说起来",
            "narrator_zh": "雅"
        },
        {
            "location": "111/TALK",
            "narrator": "みやび",
            "text": "$handle$に憧れているものはないのか",
            "zh": "就没有什么让$handle$憧憬的东西吗",
            "narrator_zh": "雅"
        },
        {
            "location": "113/SEL",
            "narrator": "",
            "text": "大統領？",
            "zh": "总统？",
            "narrator_zh": ""
        },
        {
            "location": "114/SEL",
            "narrator": "",
            "text": "大魔王",
            "zh": "大魔王",
            "narrator_zh": ""
        },
        {
            "location": "115/SEL",
            "narrator": "",
            "text": "仙人かな",
            "zh": "是仙人吗",
            "narrator_zh": ""
        },
        {
            "location": "116/ACT",
            "narrator": "",
            "text": "大統領？",
            "zh": "总统？",
            "narrator_zh": ""
        },
        {
            "location": "117/TALK",
            "narrator": "みやび",
            "text": "ここは日本だし",
            "zh": "这里是日本嘛",
            "narrator_zh": "雅"
        },
        {
            "location": "119/TALK",
            "narrator": "みやび",
            "text": "聞かれてもな",
            "zh": "就算你这么问啊",
            "narrator_zh": "雅"
        },
        {
            "location": "120/ACT",
            "narrator": "",
            "text": "大魔王",
            "zh": "大魔王",
            "narrator_zh": ""
        },
        {
            "location": "121/TALK",
            "narrator": "みやび",
            "text": "大のつく魔王か",
            "zh": "是带「大」字的魔王啊",
            "narrator_zh": "雅"
        },
        {
            "location": "122/TALK",
            "narrator": "みやび",
            "text": "ひと味違うな",
            "zh": "档次就是不一样啊",
            "narrator_zh": "雅"
        },
        {
            "location": "123/ACT",
            "narrator": "",
            "text": "仙人かな",
            "zh": "是仙人吗",
            "narrator_zh": ""
        },
        {
            "location": "124/TALK",
            "narrator": "みやび",
            "text": "何もかもを超越したいのか",
            "zh": "是想超越一切吗",
            "narrator_zh": "雅"
        },
        {
            "location": "125/TALK",
            "narrator": "みやび",
            "text": "無我の境地か",
            "zh": "这是要入无我之境吗",
            "narrator_zh": "雅"
        },
        {
            "location": "127/TALK",
            "narrator": "みやび",
            "text": "それにしても",
            "zh": "话说",
            "narrator_zh": "雅"
        },
        {
            "location": "128/TALK",
            "narrator": "みやび",
            "text": "ネタ回答で返すとは",
            "zh": "居然拿梗来回答",
            "narrator_zh": "雅"
        },
        {
            "location": "129/TALK",
            "narrator": "みやび",
            "text": "乙女心のわからんやつめ",
            "zh": "不懂少女心的家伙",
            "narrator_zh": "雅"
        },
        {
            "location": "51/DIALOG",
            "narrator": "Dialog_GETGokigen",
