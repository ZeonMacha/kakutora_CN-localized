        {
            "location": "325/TALK",
            "narrator": "ガブリエラ",
            "text": "善光寺って、こういう見た目なのね？",
            "zh": "善光寺是长这样的呀？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "327/TALK",
            "narrator": "ガブリエラ",
            "text": "名前は聞いたことあるけど、見たことはなかったの",
            "zh": "名字倒是听说过，样子还是头一回见",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "330/SEL",
            "narrator": "",
            "text": "ガブリエラが知らなかったのが驚き",
            "zh": "加布里埃拉居然会不知道才让人惊讶呢",
            "narrator_zh": ""
        },
        {
            "location": "331/ACT",
            "narrator": "",
            "text": "ガブリエラが知らなかったのが驚き",
            "zh": "加布里埃拉居然会不知道才让人惊讶呢",
            "narrator_zh": ""
        },
        {
            "location": "334/TALK",
            "narrator": "ガブリエラ",
            "text": "何でも知ってると思わないでよ",
            "zh": "别以为我什么都懂哦",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "335/TALK",
            "narrator": "ガブリエラ",
            "text": "っていうか、知らないことの方が多いんだし",
            "zh": "再说了，不知道的事才更多呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "336/TALK",
            "narrator": "ガブリエラ",
            "text": "善光寺だって、名前は知ってるけど",
            "zh": "就说善光寺吧，名字我倒是知道",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "337/TALK",
            "narrator": "ガブリエラ",
            "text": "それ以外のことはさっぱりなんだから",
            "zh": "除此之外就一无所知了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "340/SEL",
            "narrator": "",
            "text": "見た目がわかってよかったね",
            "zh": "知道长什么样了，挺好的呢",
            "narrator_zh": ""
        },
        {
            "location": "341/ACT",
            "narrator": "",
            "text": "見た目がわかってよかったね",
            "zh": "知道长什么样了，挺好的呢",
            "narrator_zh": ""
        },
        {
            "location": "344/TALK",
            "narrator": "ガブリエラ",
            "text": "ええ、そうね",
            "zh": "嗯，是啊",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "345/TALK",
            "narrator": "ガブリエラ",
            "text": "っていうか、想像してたより立派かも",
            "zh": "或者说，比我想象的还要气派",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "346/TALK",
            "narrator": "ガブリエラ",
            "text": "せっかくだし、ちょっと調べてみようかしら？",
            "zh": "难得来一趟，要不要稍微查一查呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "347/TALK",
            "narrator": "ガブリエラ",
            "text": "調べておけば、お参りに行ったときに",
            "zh": "提前查好的话，去参拜的时候",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "348/TALK",
            "narrator": "ガブリエラ",
            "text": "説明とか見なくて済むし",
            "zh": "就不用再看说明了",
            "narrator_zh": "加布里埃拉"
        }
    ]
