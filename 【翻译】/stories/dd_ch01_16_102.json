        },
        {
            "location": "414/ACT",
            "narrator": "",
            "text": "やめた方がいいと思うよ",
            "zh": "我觉得还是算了",
            "narrator_zh": ""
        },
        {
            "location": "416/TALK",
            "narrator": "つばめ",
            "text": "そうなのかな？",
