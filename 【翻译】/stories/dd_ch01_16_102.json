        },
        {
            "location": "446/TALK",
            "narrator": "つばめ",
            "text": "わかったよ",
            "zh": "我知道了",
            "narrator_zh": "燕"
        },
        {
            "location": "447/TALK",
            "narrator": "つばめ",
            "text": "みやびさんからも",
            "zh": "雅也",
            "narrator_zh": "燕"
        },
        {
            "location": "448/TALK",
            "narrator": "つばめ",
            "text": "監視するよぅに言われたし(*´︶`*)",
            "zh": "让我看着她(*´︶`*)",
            "narrator_zh": "燕"
        },
        {
            "location": "449/TALK",
            "narrator": "つばめ",
            "text": "卯月さんには",
            "zh": "对卯月",
            "narrator_zh": "燕"
        },
        {
            "location": "450/TALK",
            "narrator": "つばめ",
            "text": "内緒にしてぉくねヾ(｡>﹏<｡)ﾉﾞ",
            "zh": "就先保密吧ヾ(｡>﹏<｡)ﾉﾞ",
            "narrator_zh": "燕"
        },
        {
            "location": "452/SEL",
            "narrator": "",
            "text": "神楽のこと、見ててあげてね",
            "zh": "神乐的事，帮我看着她",
            "narrator_zh": ""
        },
        {
            "location": "453/ACT",
            "narrator": "",
            "text": "神楽のこと、見ててあげてね",
            "zh": "神乐的事，帮我看着她",
            "narrator_zh": ""
        },
        {
            "location": "455/TALK",
            "narrator": "つばめ",
            "text": "ぅん",
            "zh": "嗯",
            "narrator_zh": "燕"
        },
        {
            "location": "456/TALK",
            "narrator": "つばめ",
            "text": "任せて(๑･ㅂ･)و☆",
