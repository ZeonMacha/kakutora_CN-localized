        {
            "location": "55/TALK",
            "narrator": "つばめ",
            "text": "ぁ、これ、ゎたしのすきなカムカムの応募券！(灬・ω・灬)",
            "zh": "啊，这个，是我喜欢的卡姆卡姆抽奖券！(灬・ω・灬)",
            "narrator_zh": "燕"
        },
        {
            "location": "59/SEL",
            "narrator": "",
            "text": "カムカムって？",
            "zh": "卡姆卡姆是什么？",
            "narrator_zh": ""
        },
        {
            "location": "60/ACT",
            "narrator": "",
            "text": "カムカムって？",
            "zh": "卡姆卡姆是什么？",
            "narrator_zh": ""
        },
        {
            "location": "63/TALK",
            "narrator": "つばめ",
            "text": "いちごのジュースだょ。コンビニとか学校の自販機で売ってるの",
            "zh": "是草莓汁呀。便利店，还有学校的自动售货机都有卖",
            "narrator_zh": "燕"
        },
        {
            "location": "64/TALK",
            "narrator": "つばめ",
            "text": "応募券集めるとカムカムちゃんポシェット当たるんだ(≧ω≦)",
            "zh": "集齐抽奖券就能抽到卡姆卡姆小包(≧ω≦)",
            "narrator_zh": "燕"
        },
        {
            "location": "65/TALK",
            "narrator": "つばめ",
            "text": "ゎたしにくれるの？",
            "zh": "要给我吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "68/SEL",
            "narrator": "",
            "text": "もちろんだよ",
            "zh": "当然啦",
            "narrator_zh": ""
        },
        {
            "location": "69/ACT",
            "narrator": "",
            "text": "もちろんだよ",
            "zh": "当然啦",
            "narrator_zh": ""
        },
        {
            "location": "72/TALK",
            "narrator": "つばめ",
            "text": "ぁりがとヾ(o´∀｀o)ﾉ",
            "zh": "谢谢ヾ(o´∀｀o)ﾉ",
            "narrator_zh": "燕"
        },
        {
            "location": "75/SEL",
            "narrator": "",
            "text": "カムカムよく飲むの？",
            "zh": "卡姆卡姆经常喝吗？",
            "narrator_zh": ""
        },
        {
            "location": "76/ACT",
            "narrator": "",
            "text": "カムカムよく飲むの？",
            "zh": "卡姆卡姆经常喝吗？",
            "narrator_zh": ""
        },
        {
            "location": "79/TALK",
            "narrator": "つばめ",
            "text": "うん、学校でもよく買ぅの",
            "zh": "嗯，在学校也经常买",
