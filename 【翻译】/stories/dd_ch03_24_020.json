{
    "dir": "chap24/daydra/dd_ch03_24_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "24356",
        "cid": "gabriella",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "放課後のサプライズ",
        "title_zh": "Extra006 额外剧情",
        "sub_title_zh": "放学后的惊喜"
    },
    "entry": [
        {
            "location": "320/SCENARIO",
            "narrator": "",
            "text": "放課後のサプライズ",
            "zh": "放学后的惊喜",
            "narrator_zh": ""
        },
        {
            "location": "338/TALK",
            "narrator": "ガブリエラ",
            "text": "さてと…バイトもないし、\n放課後は何しようかしら？",
            "zh": "好啦……今天也没有打工，\n放学后要做点什么呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "341/TALK",
            "narrator": "雛",
            "text": "ガブリエラちゃん、いる？",
            "zh": "加布里埃拉，你在吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "343/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょ、ひなこ！？\n何で教室に来て――",
            "zh": "等、雏子！？\n怎么跑到教室来了——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "347/TALK",
            "narrator": "つばめ",
            "text": "よかった、\nまだ帰ってなくて…。",
            "zh": "太好了，\n你还没回去……。",
            "narrator_zh": "燕"
        },
        {
            "location": "348/TALK",
            "narrator": "ガブリエラ",
            "text": "いや、待って待って！\n何なのよいったい！？",
            "zh": "不是，等等等等！\n到底怎么回事啊！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "349/TALK",
            "narrator": "ガブリエラ",
            "text": "っていうか、目立つから\n静かにしてよ！",
            "zh": "而且这样很显眼的，\n你给我安静点啦！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "350/TALK",
            "narrator": "雛",
            "text": "それどころじゃないよ！\nガブリエラちゃん、\nもう時間がないの。",
            "zh": "现在不是说这个的时候啦！\n加布里埃拉，\n已经没时间了。",
            "narrator_zh": "雏"
        },
        {
            "location": "351/TALK",
            "narrator": "雛",
            "text": "あたし達と一緒に来て！",
            "zh": "跟我们一起走吧！",
            "narrator_zh": "雏"
        },
        {
            "location": "352/TALK",
            "narrator": "ガブリエラ",
            "text": "えっ？",
            "zh": "诶？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "353/TALK",
            "narrator": "つばめ",
            "text": "大変なことになったの！",
            "zh": "出大事了！",
            "narrator_zh": "燕"
        },
        {
            "location": "354/TALK",
            "narrator": "つばめ",
            "text": "もう時間もなくて…、\nだからお願い！\n一緒に来て！",
            "zh": "已经没有时间了……，\n所以拜托啦！\n跟我们一起来吧！",
            "narrator_zh": "燕"
        },
        {
            "location": "355/TALK",
            "narrator": "ガブリエラ",
            "text": "こんなに慌てて…、\n何かあったのかしら？",
            "zh": "这么慌慌张张的……，\n发生什么事了吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "356/TALK",
            "narrator": "ガブリエラ",
            "text": "…わかった。\n案内して。",
            "zh": "……我知道了。\n带路吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "357/TALK",
            "narrator": "つばめ",
            "text": "やった！",
            "zh": "太好啦！",
            "narrator_zh": "燕"
        },
        {
            "location": "359/TALK",
            "narrator": "雛",
            "text": "遅くなっちゃうし、\n急ぐよー。",
            "zh": "再不走要晚了，\n快点出发咯—。",
            "narrator_zh": "雏"
        },
        {
            "location": "360/TALK",
            "narrator": "ガブリエラ",
            "text": "それで、場所はどこ？",
            "zh": "所以，地方在哪儿？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "361/TALK",
            "narrator": "つばめ",
            "text": "うん、えっとね――",
            "zh": "嗯，那个呀——",
            "narrator_zh": "燕"
        },
        {
            "location": "376/TALK",
            "narrator": "つばめ",
            "text": "よ、よかったぁ。\n何とか時間ぎりぎり\n間に合ったね。",
            "zh": "太、太好了呀。\n总算卡在时间点上\n赶到了呢。",
            "narrator_zh": "燕"
        },
        {
            "location": "378/TALK",
            "narrator": "つばめ",
            "text": "これも全部\nひなこちゃんの\nおかげだよ。",
            "zh": "这也全都是\n多亏了雏子\n才能赶上哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "379/TALK",
            "narrator": "雛",
            "text": "ふふん、鉄道を極める者は\n時間を制す、ってねー。",
            "zh": "哼哼，所谓精通铁道之人\n便能掌控时间，就是这么回事咯—。",
            "narrator_zh": "雏"
        },
        {
            "location": "381/TALK",
            "narrator": "繭",
            "text": "…その趣味、初めて人の\n役に立ったんじゃない？",
            "zh": "……你那爱好，还是头一次\n派上用场吧？",
            "narrator_zh": "茧"
        },
        {
            "location": "383/TALK",
            "narrator": "雛",
            "text": "じゃあ普段から頼ってよ。\nそしたらもっともっと\n役に立てるんだからさー。",
            "zh": "那平时就多依赖我嘛。\n这样我就能派上\n更多更多的用场了呀—。",
            "narrator_zh": "雏"
        },
        {
            "location": "385/TALK",
            "narrator": "ガブリエラ",
            "text": "…ちょっと。",
            "zh": "……等一下。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "387/TALK",
            "narrator": "繭",
            "text": "あ、忘れてた。\nチケットね。",
            "zh": "啊，差点忘了。\n给，门票。",
            "narrator_zh": "茧"
        },
        {
            "location": "388/TALK",
            "narrator": "ガブリエラ",
            "text": "そうじゃなくて。",
            "zh": "我不是说这个。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "390/TALK",
            "narrator": "ガブリエラ",
            "text": "何よこれ！？\nどうして遊園地に\n連れてきたのよ！？",
            "zh": "这到底是怎么回事！？\n为什么带我来\n游乐园啊！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "391/TALK",
            "narrator": "雛",
            "text": "遊ぶためだよー。\nねー？",
            "zh": "当然是为了玩呀—。\n对吧—？",
            "narrator_zh": "雏"
        },
        {
            "location": "392/TALK",
            "narrator": "つばめ",
            "text": "ねー。",
            "zh": "对吧—。",
            "narrator_zh": "燕"
        },
        {
            "location": "393/TALK",
            "narrator": "ガブリエラ",
            "text": "あ、あのねぇ…。",
            "zh": "我、我说你们啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "394/TALK",
            "narrator": "繭",
            "text": "気まぐれでやった\nネットのくじで当てたの。",
            "zh": "心血来潮参加了\n网上的抽奖，结果抽中了这个。",
            "narrator_zh": "茧"
        },
        {
            "location": "395/TALK",
            "narrator": "繭",
            "text": "夕方から入場できる\nパスポート券…四人分。",
            "zh": "傍晚起可以入场的\n通票……一共四张。",
            "narrator_zh": "茧"
        },
        {
            "location": "396/TALK",
            "narrator": "ガブリエラ",
            "text": "…なるほどね。",
            "zh": "……原来如此。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "397/TALK",
            "narrator": "繭",
            "text": "興味ないから忘れてて、\n気づいたら有効期限が\n今日だった。",
            "zh": "我不感兴趣就给忘了，\n等想起来的时候发现\n有效期就到今天。",
            "narrator_zh": "茧"
        },
        {
            "location": "398/TALK",
            "narrator": "ガブリエラ",
            "text": "…で？　一人分余ったから\nあたしを連れてきたわけ？",
            "zh": "……然后呢？ 因为多出一张\n所以就把我带来了？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "399/TALK",
            "narrator": "雛",
            "text": "そういうこと。",
            "zh": "就是这样。",
            "narrator_zh": "雏"
        },
        {
            "location": "401/TALK",
            "narrator": "雛",
            "text": "ガブリエラちゃん、\n最近すっごいピリピリ\nしてるでしょ？",
            "zh": "加布里埃拉，\n你最近神经绷得\n可紧了对吧？",
            "narrator_zh": "雏"
        },
        {
            "location": "402/TALK",
            "narrator": "雛",
            "text": "だから、ちょっと遊んで\n気分転換してほしいな、\nって思ったんだー。",
            "zh": "所以我想着，稍微出来玩玩\n转换一下心情也不错嘛，\n就这样—。",
            "narrator_zh": "雏"
        },
        {
            "location": "404/TALK",
            "narrator": "繭",
            "text": "…並ばなくていいの？\n急いできた意味なくなる\nわよ？",
            "zh": "……不去排队没关系吗？\n不然特意赶过来就\n没意义了吧？",
            "narrator_zh": "茧"
        },
        {
            "location": "405/TALK",
            "narrator": "雛",
            "text": "うん。とりあえず\nなに乗ろっか？",
            "zh": "嗯。总之\n先去坐什么好呢？",
            "narrator_zh": "雏"
        },
        {
            "location": "406/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょっと、あたしは\n遊んでる暇なんか――",
            "zh": "喂，我哪有\n闲工夫在这里玩——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "409/TALK",
            "narrator": "つばめ",
            "text": "メリーゴーランドとか、\nガブちゃん好きそうかも。",
            "zh": "像是旋转木马什么的，\n加布好像会喜欢哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "410/TALK",
            "narrator": "ガブリエラ",
            "text": "いや、好きじゃないし！\nっていうか乗らないから！",
            "zh": "才、才不喜欢呢！\n再说我也不会去坐的！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "412/TALK",
            "narrator": "雛",
            "text": "まゆちん、最初は\nどれから攻める？",
            "zh": "小茧，一开始\n要先攻略哪一个？",
            "narrator_zh": "雏"
        },
        {
            "location": "414/TALK",
            "narrator": "繭",
            "text": "…ジェットコースター。\n景気づけに最適だと思う。",
            "zh": "……过山车。\n最适合用来提振士气。",
            "narrator_zh": "茧"
        },
        {
            "location": "416/TALK",
            "narrator": "雛",
            "text": "じゃ、決まりね。\nほら行くよー。",
            "zh": "那就这么定了。\n走咯—。",
            "narrator_zh": "雏"
        },
        {
            "location": "417/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょ、引っ張らないで！",
            "zh": "喂、别拉我啊！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "433/TALK",
            "narrator": "つばめ",
            "text": "はぁ～…すごかったねぇ。",
            "zh": "哈啊~……好厉害啊……。",
            "narrator_zh": "燕"
        },
        {
            "location": "434/TALK",
            "narrator": "雛",
            "text": "うん…久々に乗ったけど、\nあんな速かったっけ？",
            "zh": "嗯……好久没坐了，\n以前有这么快吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "435/TALK",
            "narrator": "繭",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "茧"
        },
        {
            "location": "438/TALK",
            "narrator": "つばめ",
            "text": "あれ、まゆちん？",
            "zh": "哎呀，小茧？",
            "narrator_zh": "燕"
        },
        {
            "location": "439/TALK",
            "narrator": "繭",
            "text": "…ちょっと酔った。\nすぐよくなるから平気。",
            "zh": "……有点晕了。\n马上就会好，没事。",
            "narrator_zh": "茧"
        },
        {
            "location": "440/TALK",
            "narrator": "ガブリエラ",
            "text": "…だらしないわねぇ。\nみんなボロボロじゃない。",
            "zh": "……真没出息呀……。\n一个个全都不行了嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "442/TALK",
            "narrator": "つばめ",
            "text": "あ、あはは…。",
            "zh": "啊、哈哈……。",
            "narrator_zh": "燕"
        },
        {
            "location": "444/TALK",
            "narrator": "雛",
            "text": "ガブリエラちゃんは\n平気そうだねー？",
            "zh": "加布里埃拉看起来\n倒是挺游刃有余的嘛—？",
            "narrator_zh": "雏"
        },
        {
            "location": "447/TALK",
            "narrator": "ガブリエラ",
            "text": "当然よ。\nジェットコースターで\nへばる鍛え方してないわ。",
            "zh": "那当然了。\n我平时的锻炼可不至于\n被区区过山车累垮。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "449/TALK",
            "narrator": "つばめ",
            "text": "すごいなぁ…。\nわたしも見習わなくちゃ。",
            "zh": "好厉害呀……。\n我也得向你学习才行。",
            "narrator_zh": "燕"
        },
        {
            "location": "452/TALK",
            "narrator": "ガブリエラ",
            "text": "あのね…三戸浜での\n訓練の成果は\nどこ行っちゃったのよ？",
            "zh": "我说你们……在三户滨的\n训练成果\n都丢到哪儿去了呀？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "453/TALK",
            "narrator": "雛",
            "text": "まあまあ。\nじゃ、次はゆったりできる\n乗り物にしよ。",
            "zh": "好啦好啦。\n那下一个，咱们去坐点\n轻松悠闲的游乐设施吧。",
            "narrator_zh": "雏"
        },
        {
            "location": "455/TALK",
            "narrator": "繭",
            "text": "…ショーがいい。\nちょうど、始まるところ\nだから…。",
            "zh": "……看表演就好。\n刚好，马上要开场了\n就看那个吧……。",
            "narrator_zh": "茧"
        },
        {
            "location": "457/TALK",
            "narrator": "雛",
            "text": "じゃ、休憩がてら\nショーを見るってことで。",
            "zh": "那就顺便当休息，\n去看表演吧。",
            "narrator_zh": "雏"
        },
        {
            "location": "460/TALK",
            "narrator": "ガブリエラ",
            "text": "乗り物、まだ一つしか\n乗ってないんだけど？",
            "zh": "游乐设施，不是才\n坐了一个而已吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "462/TALK",
            "narrator": "つばめ",
            "text": "でも、ショーだって\n楽しいと思うよ？",
            "zh": "可是，看表演\n也很有趣的呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "463/TALK",
            "narrator": "ガブリエラ",
            "text": "そうかしら？\n屋内のショーなんて、\n大したことは――",
            "zh": "是吗？\n室内的表演什么的，\n能有多大意思——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "479/TALK",
            "narrator": "ガブリエラ",
            "text": "は～…ダンスも歌も、\nとっても素敵で最高の\nショーだったわ！",
            "zh": "呼~……无论舞蹈还是歌唱，\n都精彩绝伦，\n真是太棒的表演了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "480/TALK",
            "narrator": "つばめ",
            "text": "うん！　あの主役の人、\nとっても素敵だったね。",
            "zh": "嗯！ 那个演主角的人，\n真的超级棒呢。",
            "narrator_zh": "燕"
        },
        {
            "location": "481/TALK",
            "narrator": "雛",
            "text": "あたし、感動して\nちょっと泣いちゃいそう\nだったよー。",
            "zh": "我呀，感动得\n差点都要\n哭出来了呢—。",
            "narrator_zh": "雏"
        },
        {
            "location": "483/TALK",
            "narrator": "つばめ",
            "text": "あ、ちょっと涙出てる。\nハンカチ使う？",
            "zh": "啊，有点流眼泪了。\n要用手帕吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "485/TALK",
            "narrator": "雛",
            "text": "あ、大丈夫大丈夫。\nえへへ、恥ずかしいな…。",
            "zh": "啊，没事没事。\n诶嘿嘿，怪不好意思的……。",
            "narrator_zh": "雏"
        },
        {
            "location": "487/TALK",
            "narrator": "ガブリエラ",
            "text": "恥じることないって。\n他にも泣いてる人、\n結構いたわよ？",
            "zh": "这有什么好害羞的。\n其他看哭的人，\n也有不少呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "490/TALK",
            "narrator": "雛",
            "text": "そうなの？\n気づかなかったよー。",
            "zh": "是这样吗？\n我完全没注意到呢—。",
            "narrator_zh": "雏"
        },
        {
            "location": "492/TALK",
            "narrator": "つばめ",
            "text": "そういえば、\nまゆちん、具合は？",
            "zh": "说起来，\n小茧，感觉好些了吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "494/TALK",
            "narrator": "繭",
            "text": "仮眠取って完全回復。\nもう平気。",
            "zh": "小睡了一觉完全恢复。\n已经没事了。",
            "narrator_zh": "茧"
        },
        {
            "location": "496/TALK",
            "narrator": "ガブリエラ",
            "text": "寝てたの！？\n勿体ないわね…。",
            "zh": "你睡着了啊！？\n也太浪费了吧……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "498/TALK",
            "narrator": "繭",
            "text": "で、次は？\nお化け屋敷？\nフリーフォール？",
            "zh": "那么，接下来呢？\n鬼屋？\n还是自由落体？",
            "narrator_zh": "茧"
        },
        {
            "location": "499/TALK",
            "narrator": "ガブリエラ",
            "text": "フリーフォールなんて\nあるの？",
            "zh": "这里还有\n自由落体吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "501/TALK",
            "narrator": "繭",
            "text": "ある。\nこの前できたばかりの\n新しいヤツ。",
            "zh": "有的。\n前阵子刚建好的\n新项目。",
            "narrator_zh": "茧"
        },
        {
            "location": "503/TALK",
            "narrator": "ガブリエラ",
            "text": "楽しそうね、それ。\nあたしは賛成よ。",
            "zh": "听起来挺好玩的嘛。\n我赞成哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "506/TALK",
            "narrator": "雛",
            "text": "フリーフォールかぁ…。\n楽しいけど、あれ結構\nキツいんだよねー。",
            "zh": "自由落体啊……。\n好玩是好玩，可那个\n还是挺刺激难受的呢—。",
            "narrator_zh": "雏"
        },
        {
            "location": "508/TALK",
            "narrator": "繭",
            "text": "それがいい。",
            "zh": "这样才好。",
            "narrator_zh": "茧"
        },
        {
            "location": "509/TALK",
            "narrator": "ガブリエラ",
            "text": "ジェットコースターで\nグロッキーしてたのは\n誰だったかしら？",
            "zh": "刚才坐过山车\n趴窝的人\n是谁来着？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "510/TALK",
            "narrator": "繭",
            "text": "授業で疲れてただけ。\nもう平気。",
            "zh": "只是上课太累了而已。\n现在已经没事了。",
            "narrator_zh": "茧"
        },
        {
            "location": "513/TALK",
            "narrator": "雛",
            "text": "ってことらしいけど、\nどうするー？",
            "zh": "虽然她是这么说啦，\n大家觉得呢—？",
            "narrator_zh": "雏"
        },
        {
            "location": "516/TALK",
            "narrator": "つばめ",
            "text": "わたしも賛成。\n乗ったことないから\n楽しみだよ。",
            "zh": "我也赞成。\n因为还没坐过，\n好期待呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "519/TALK",
            "narrator": "ガブリエラ",
            "text": "じゃ、急ぎましょ。\nあれって人気だから、\n結構並ぶはずよ。",
            "zh": "那赶紧走吧。\n那个项目很热门，\n应该要排挺久的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "524/TALK",
            "narrator": "つばめ",
            "text": "あっ、待ってガブちゃん！",
            "zh": "啊，等等我呀加布！",
            "narrator_zh": "燕"
        },
        {
            "location": "530/TALK",
            "narrator": "雛",
            "text": "…よかったねー。\n作戦通り！",
            "zh": "……太好了呢。\n一切按计划进行！",
            "narrator_zh": "雏"
        },
        {
            "location": "532/TALK",
            "narrator": "繭",
            "text": "…チケットのこと\n思い出してよかった。",
            "zh": "……幸好我想起了\n门票的事。",
            "narrator_zh": "茧"
        },
        {
            "location": "533/TALK",
            "narrator": "ガブリエラ",
            "text": "何やってんのー！？\n早く来ないと\nはぐれるわよ！",
            "zh": "磨磨蹭蹭干嘛呢—！？\n不快点过来\n要走散了哦！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "553/TALK",
            "narrator": "雛",
            "text": "んーっっっっ！！！\n遊んだねーっ！",
            "zh": "嗯————！！！\n玩得好痛快呀—！",
            "narrator_zh": "雏"
        },
        {
            "location": "554/TALK",
            "narrator": "つばめ",
            "text": "楽しかったぁ…。",
            "zh": "好开心呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "556/TALK",
            "narrator": "つばめ",
            "text": "でも、フリーフォールは\nもういいかな…。",
            "zh": "不过，自由落体\n以后还是算了吧……。",
            "narrator_zh": "燕"
        },
        {
            "location": "558/TALK",
            "narrator": "ガブリエラ",
            "text": "あの時のつばめ、\n本気で叫んでたでしょ？",
            "zh": "那时候的燕，\n真是拼了命在尖叫呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "560/TALK",
            "narrator": "つばめ",
            "text": "さ、叫んでないよ。\nビックリはしたけど…。",
            "zh": "我、我才没尖叫啦。\n虽然确实吓了一跳……。",
            "narrator_zh": "燕"
        },
        {
            "location": "561/TALK",
            "narrator": "ガブリエラ",
            "text": "ウソよ。\n隣で凄い声したもの。",
            "zh": "骗人。\n就在我旁边发出好大一声呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "563/TALK",
            "narrator": "雛",
            "text": "あたしも聞いたよー。\nはひぇぇぇぇ、だっけ？",
            "zh": "我也听到了哦—。\n是“哈咿呀呀呀”，对吧？",
            "narrator_zh": "雏"
        },
        {
            "location": "565/TALK",
            "narrator": "繭",
            "text": "ひゃぃぃぃぃ、に\n聞こえたけど？",
            "zh": "我怎么听起来像\n“呀咿呀呀呀”呢？",
            "narrator_zh": "茧"
        },
        {
            "location": "567/TALK",
            "narrator": "つばめ",
            "text": "お、思い出さないでよぉ。",
            "zh": "别、别再去回忆了啦。",
            "narrator_zh": "燕"
        },
        {
            "location": "569/TALK",
            "narrator": "ガブリエラ",
            "text": "あはは…。",
            "zh": "哈哈……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "571/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "572/TALK",
            "narrator": "ガブリエラ",
            "text": "結局…閉園間際まで\n楽しんじゃってる…。",
            "zh": "结果……一直玩到了\n快闭园的时候呢……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "575/TALK",
            "narrator": "ガブリエラ",
            "text": "こんなことしてる\n状況じゃないって、\nわかってたのに…。",
            "zh": "明明知道现在\n不是做这种事的\n状况……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "576/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "591/TALK",
            "narrator": "ガブリエラ",
            "text": "ダメね",
            "zh": "不行了呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "593/TALK",
            "narrator": "ガブリエラ",
            "text": "私ったら",
            "zh": "我真是的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "594/TALK",
            "narrator": "ガブリエラ",
            "text": "おもいっきり遊んじゃったわ",
            "zh": "结果放开了玩了一通",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "596/SEL",
            "narrator": "",
            "text": "すごく楽しそうだった",
            "zh": "看起来玩得超开心呀",
            "narrator_zh": ""
        },
        {
            "location": "597/ACT",
            "narrator": "",
            "text": "すごく楽しそうだった",
            "zh": "看起来玩得超开心呀",
            "narrator_zh": ""
        },
        {
            "location": "599/TALK",
            "narrator": "ガブリエラ",
            "text": "うん",
            "zh": "嗯",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "600/TALK",
            "narrator": "ガブリエラ",
            "text": "とっても楽しかったわ",
            "zh": "真的超级开心",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "601/TALK",
            "narrator": "ガブリエラ",
            "text": "楽し過ぎて",
            "zh": "开心到什么地步呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "602/TALK",
            "narrator": "ガブリエラ",
            "text": "遊んでる間",
            "zh": "玩的时候",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "603/TALK",
            "narrator": "ガブリエラ",
            "text": "一度も神楽のこと考えなかった",
            "zh": "一次都没有想起神乐的事",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "606/TALK",
            "narrator": "ガブリエラ",
            "text": "なんか",
            "zh": "总觉得",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "607/TALK",
            "narrator": "ガブリエラ",
            "text": "スッキリしたわ",
            "zh": "心里一下子痛快多了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "609/SEL",
            "narrator": "",
            "text": "それはよかった",
            "zh": "那真是太好了",
            "narrator_zh": ""
        },
        {
            "location": "610/ACT",
            "narrator": "",
            "text": "それはよかった",
            "zh": "那真是太好了",
            "narrator_zh": ""
        },
        {
            "location": "612/TALK",
            "narrator": "ガブリエラ",
            "text": "ええ",
            "zh": "嗯",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "614/TALK",
            "narrator": "ガブリエラ",
            "text": "雛達にも",
            "zh": "对雏她们",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "615/TALK",
            "narrator": "ガブリエラ",
            "text": "感謝しないとね",
            "zh": "也得好好道个谢才行呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "616/TALK",
            "narrator": "ガブリエラ",
            "text": "多分",
            "zh": "大概",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "617/TALK",
            "narrator": "ガブリエラ",
            "text": "最近の私や",
            "zh": "是看到最近的我和",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "618/TALK",
            "narrator": "ガブリエラ",
            "text": "つばめの様子を見て",
            "zh": "燕的样子",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "619/TALK",
            "narrator": "ガブリエラ",
            "text": "気を使ってくれたんだと思うの",
            "zh": "才特意费心照顾我们的吧",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "622/TALK",
            "narrator": "ガブリエラ",
            "text": "ちゃんとお礼言わないと",
            "zh": "得好好道个谢才行",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "623/TALK",
            "narrator": "ガブリエラ",
            "text": "気を使わせたって",
            "zh": "谢谢你们费心了，这样",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "624/SEL",
            "narrator": "",
            "text": "楽しかった、の一言でいい",
            "zh": "就说一句“很开心”就好",
            "narrator_zh": ""
        },
        {
            "location": "625/TALK",
            "narrator": "ガブリエラ",
            "text": "本当",
            "zh": "真的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "626/TALK",
            "narrator": "ガブリエラ",
            "text": "二人のおかげで",
            "zh": "多亏了她们俩",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "627/TALK",
            "narrator": "ガブリエラ",
            "text": "スッキリできたから",
            "zh": "我才能这么畅快",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "640/TALK",
            "narrator": "ガブリエラ",
            "text": "…気を使わせたわね。",
            "zh": "……让你们费心了呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "641/TALK",
            "narrator": "雛",
            "text": "え？",
            "zh": "诶？",
            "narrator_zh": "雏"
        },
        {
            "location": "644/TALK",
            "narrator": "ガブリエラ",
            "text": "今日のこと…、\nこれ、あたし達のために\n誘ってくれたんでしょ？",
            "zh": "今天的事……，\n这其实是为了我们，\n才特意邀请我们的吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "645/TALK",
            "narrator": "繭",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "茧"
        },
        {
            "location": "648/TALK",
            "narrator": "つばめ",
            "text": "何のこと？",
            "zh": "什么意思呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "652/TALK",
            "narrator": "ガブリエラ",
            "text": "あのね…普通に考えれば\nわかるでしょ？",
            "zh": "我说……正常想一想\n就能明白吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "653/TALK",
            "narrator": "ガブリエラ",
            "text": "あたし達が大変で、\nピリピリしてる時に――",
            "zh": "偏偏在我们情况棘手、\n神经紧绷的时候——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "654/TALK",
            "narrator": "ガブリエラ",
            "text": "都合よく遊園地の\nチケットが手に入った、\nなんてあると思う？",
            "zh": "哪有这么巧合正好弄到\n游乐园门票\n这种事啊？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "656/TALK",
            "narrator": "つばめ",
            "text": "…え？",
            "zh": "……诶？",
            "narrator_zh": "燕"
        },
        {
            "location": "659/TALK",
            "narrator": "つばめ",
            "text": "じゃ、じゃあ、\nもしかして！",
            "zh": "那、那这么说，\n难道！",
            "narrator_zh": "燕"
        },
        {
            "location": "661/TALK",
            "narrator": "雛",
            "text": "あははー…さすがは\nガブリエラちゃんだね。",
            "zh": "啊哈哈—……真不愧是\n加布里埃拉呢。",
            "narrator_zh": "雏"
        },
        {
            "location": "663/TALK",
            "narrator": "繭",
            "text": "あからさま過ぎたみたい。",
            "zh": "看来演得还是太明显了。",
            "narrator_zh": "茧"
        },
        {
            "location": "664/TALK",
            "narrator": "つばめ",
            "text": "えーっ！\nそうだったの！？",
            "zh": "诶—！\n原来是这样吗！？",
            "narrator_zh": "燕"
        },
        {
            "location": "666/TALK",
            "narrator": "ガブリエラ",
            "text": "あんたは…ほんっとう、\n天然なんだから…。",
            "zh": "你呀……真是的，\n太天然呆了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "669/TALK",
            "narrator": "つばめ",
            "text": "うう、ごめんなさい…。",
            "zh": "呜呜，对不起……。",
            "narrator_zh": "燕"
        },
        {
            "location": "671/TALK",
            "narrator": "雛",
            "text": "ああ、いいのいいの。\nそれが目的だったんだし。",
            "zh": "啊，没事啦没事啦。\n本来目的就是这个嘛。",
            "narrator_zh": "雏"
        },
        {
            "location": "672/TALK",
            "narrator": "雛",
            "text": "色んなこと考えて、\nずっとモヤモヤしてた\nみたいだから――",
            "zh": "你们俩想了那么多事，\n一直都闷闷不乐的\n样子——",
            "narrator_zh": "雏"
        },
        {
            "location": "673/TALK",
            "narrator": "雛",
            "text": "今日くらい、二人には\n嫌なこと忘れて\nほしかったんだー。",
            "zh": "至少今天，我想让你们俩\n把不开心的事都\n忘掉呀—。",
            "narrator_zh": "雏"
        },
        {
            "location": "675/TALK",
            "narrator": "ガブリエラ",
            "text": "やっぱりね…。",
            "zh": "果然呢……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "676/TALK",
            "narrator": "ガブリエラ",
            "text": "…って、あれ？\nじゃあもしかして…。",
            "zh": "……咦，等下？\n那难道说……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "677/TALK",
            "narrator": "雛",
            "text": "けど、そうだよね…。\nガブリエラちゃんには\nさすがに気づかれるかー。",
            "zh": "不过，说得也是呢……。\n如果是加布里埃拉的话，\n果然还是会被发现吧—。",
            "narrator_zh": "雏"
        },
        {
            "location": "680/TALK",
            "narrator": "ガブリエラ",
            "text": "しまった…。\n気づいてないフリして\nおくべきだったわ…。",
            "zh": "糟了……。\n早知道刚才就该装作\n没察觉到的……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "682/TALK",
            "narrator": "繭",
            "text": "でも、楽しんでもらえた\nならそれでいい。",
            "zh": "不过，只要你们能玩得开心，\n那就足够了。",
            "narrator_zh": "茧"
        },
        {
            "location": "683/TALK",
            "narrator": "繭",
            "text": "チケットが余ってたのは\n事実だから、有益に使えて\nこっちも満足だし。",
            "zh": "门票多出来是事实，\n能派上用场\n我这边也很满意。",
            "narrator_zh": "茧"
        },
        {
            "location": "684/TALK",
            "narrator": "ガブリエラ",
            "text": "え、ええ…もちろん、\n今日はとっても\n楽しかったわ。",
            "zh": "嗯、嗯……那是当然，\n今天真的\n非常开心。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "686/TALK",
            "narrator": "つばめ",
            "text": "二人とも、\n今日はありがと。",
            "zh": "你们两个，\n今天谢谢啦。",
            "narrator_zh": "燕"
        },
        {
            "location": "687/TALK",
            "narrator": "雛",
            "text": "喜んでもらえたなら、\nこっちも嬉しいよー。",
            "zh": "只要你们高兴，\n我们这边也很开心哦—。",
            "narrator_zh": "雏"
        },
        {
            "location": "689/TALK",
            "narrator": "ガブリエラ",
            "text": "…今だけは、つばめの\n天然が羨ましいわ…。",
            "zh": "……唯有现在，\n我真羡慕燕的天然呆……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "690/ACT",
            "narrator": "",
            "text": "楽しかった、の一言でいい",
            "zh": "就说一句“很开心”就好",
            "narrator_zh": ""
        },
        {
            "location": "692/TALK",
            "narrator": "ガブリエラ",
            "text": "どうしてよ？",
            "zh": "为什么呀？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "693/TALK",
            "narrator": "ガブリエラ",
            "text": "お礼を言うのって変？",
            "zh": "道个谢很奇怪吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "694/TALK",
            "narrator": "ガブリエラ",
            "text": "礼儀でしょ？",
            "zh": "这是礼貌吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "696/SEL",
            "narrator": "",
            "text": "気を使ったと気づかれたくないはず",
            "zh": "她们肯定不想被你发现是在刻意照顾你",
            "narrator_zh": ""
        },
        {
            "location": "697/ACT",
            "narrator": "",
            "text": "気を使ったと気づかれたくないはず",
            "zh": "她们肯定不想被你发现是在刻意照顾你",
            "narrator_zh": ""
        },
        {
            "location": "701/TALK",
            "narrator": "ガブリエラ",
            "text": "そっか",
            "zh": "这样啊",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "705/TALK",
            "narrator": "ガブリエラ",
            "text": "気を使ってるって",
            "zh": "就是因为不想被察觉到",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "706/TALK",
            "narrator": "ガブリエラ",
            "text": "バレないようにしてくれてるんだから",
            "zh": "她们在费心照顾我们",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "707/TALK",
            "narrator": "ガブリエラ",
            "text": "私が言ったら",
            "zh": "如果我说破了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "708/TALK",
            "narrator": "ガブリエラ",
            "text": "台無しだものね",
            "zh": "反而就白费苦心了呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "709/TALK",
            "narrator": "ガブリエラ",
            "text": "ありがと",
            "zh": "谢谢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "710/TALK",
            "narrator": "ガブリエラ",
            "text": "あとはこっちでやるわ",
            "zh": "剩下的交给我处理吧",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "722/TALK",
            "narrator": "ガブリエラ",
            "text": "…とっても楽しかったわ。",
            "zh": "……今天真的非常开心。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "724/TALK",
            "narrator": "雛",
            "text": "ほんと？",
            "zh": "真的吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "725/TALK",
            "narrator": "ガブリエラ",
            "text": "ええ…最初はどこに\n連れてかれるのかと\n思ったけどね。",
            "zh": "嗯……虽然一开始还在想\n你们要把我带到\n什么地方去呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "726/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、来てよかったわ。",
            "zh": "不过，能来真是太好了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "728/TALK",
            "narrator": "つばめ",
            "text": "わたしも、\nほんと楽しかった！",
            "zh": "我也是，\n真的玩得好开心！",
            "narrator_zh": "燕"
        },
        {
            "location": "730/TALK",
            "narrator": "つばめ",
            "text": "まゆちん、\nチケットありがと！",
            "zh": "小茧，\n谢谢你的门票！",
            "narrator_zh": "燕"
        },
        {
            "location": "732/TALK",
            "narrator": "繭",
            "text": "…気にしないで。\n余りものだから。",
            "zh": "……不用在意。\n反正是多余的。",
            "narrator_zh": "茧"
        },
        {
            "location": "734/TALK",
            "narrator": "雛",
            "text": "…えへへ。",
            "zh": "……诶嘿嘿。",
            "narrator_zh": "雏"
        },
        {
            "location": "736/TALK",
            "narrator": "つばめ",
            "text": "ん？　どうしたの？",
            "zh": "嗯？ 怎么了？",
            "narrator_zh": "燕"
        },
        {
            "location": "737/TALK",
            "narrator": "雛",
            "text": "あ、ううん。\nなんでもないよー。",
            "zh": "啊，没事。\n没什么呀—。",
            "narrator_zh": "雏"
        },
        {
            "location": "739/TALK",
            "narrator": "繭",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "茧"
        },
        {
            "location": "741/TALK",
            "narrator": "ガブリエラ",
            "text": "…ほんと、感謝するわ。",
            "zh": "……真的，非常感谢你们。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "329/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>9月1日　 4:03 PM</color>\nとある平日の放課後、付属学園ガブリエラの教室にて",
            "zh": "<color=green>9月1日　 4:03 PM</color>\n某个平日的放学后，在附属学园加布里埃拉的教室里",
            "narrator_zh": "Dialog_EventData"
        },
        {
            "location": "752/DIALOG",
            "narrator": "Dialog_GEThimegoto_ch03",
            "text": "【野暮でもいいのに】",
            "zh": "【不懂风情也无妨】",
            "narrator_zh": "Dialog_GEThimegoto_ch03"
        }
    ]
}
