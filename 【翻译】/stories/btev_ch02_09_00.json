        "title": "016 ココロスフィアストーリー【Lv06】",
        "sub_title": "チャプター９＜提起＞",
        "title_zh": "016 心灵领域故事【Lv06】",
        "sub_title_zh": "第9章＜提起＞"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "姉妹の隔絶・後編１",
            "zh": "姐妹间的隔阂·后篇1",
            "narrator_zh": ""
        },
        {
            "location": "14/DIALOG",
            "narrator": "",
            "text": "<size=40>DOOR-No. 502</size>\nAYAMI - KUNIMASA\n\n<size=45>姉妹の隔絶・前編</size>\n<size=35>～その核心に関する調査～</size>",
            "zh": "<size=40>DOOR-No. 502</size>\n国政绫水\n\n<size=45>姐妹间的隔阂·前篇</size>\n<size=35>～关于其核心的调查～</size>",
            "narrator_zh": ""
        },
        {
            "location": "23/TALK",
            "narrator": "潜在アーヤ",
            "text": "ふふ。\n待ってたわよ。",
            "zh": "呵呵。\n我在等你哦。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "24/TALK",
            "narrator": "潜在アーヤ",
            "text": "絶対に\n来てくれると\n思ってたわ。",
            "zh": "我就知道\n你一定会\n过来的。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "25/TALK",
            "narrator": "潜在アーヤ",
            "text": "さあ、それじゃ今日も\n張り切って、姉と和解\n大作戦始めましょうか。",
            "zh": "来吧，那今天也\n鼓足干劲，开始与姐姐\n和解的大作战吧。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "27/TALK",
            "narrator": "表層アーヤ",
            "text": "残念だけど、\n今回は貴方の思い通り\nにはいかないわよ？",
            "zh": "很遗憾，\n这次可不会\n随你的意哦？",
            "narrator_zh": "表层绫水"
        },
        {
            "location": "29/TALK",
            "narrator": "潜在アーヤ",
            "text": "現れたわね！\n鉄仮面！",
            "zh": "你出来啦！\n铁面具！",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "30/TALK",
            "narrator": "表層アーヤ",
            "text": "誰が鉄仮面よ。",
            "zh": "谁是铁面具啊。",
            "narrator_zh": "表层绫水"
        },
        {
            "location": "31/TALK",
            "narrator": "潜在アーヤ",
            "text": "今回も前回に引き続き\n私の思い通りにいく\nわよ。だって私には―",
            "zh": "这次也会接续上次，\n照我的想法发展\n哦。毕竟我可是——",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "32/TALK",
            "narrator": "潜在アーヤ",
            "text": "素敵な\n$handle$さんが\nついてるんだもの。",
            "zh": "有这么棒的\n$handle$\n站在我这边嘛。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "34/TALK",
            "narrator": "潜在アーヤ",
            "text": "ねー？　今回も\n私と一緒に\n頑張りましょうね。",
            "zh": "对吧？　这次也\n和我一起\n加油吧。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "35/TALK",
            "narrator": "表層アーヤ",
            "text": "毎度思うんだけど、\n私のイメージを誤解\nさせる仕草――",
            "zh": "每次我都想说，\n那种让人误解\n我形象的举动——",
            "narrator_zh": "表层绫水"
        },
        {
            "location": "36/TALK",
            "narrator": "表層アーヤ",
            "text": "やめてもらえない\nかしら？",
            "zh": "可以请你\n别再那样了吗？",
            "narrator_zh": "表层绫水"
        },
        {
            "location": "38/TALK",
            "narrator": "潜在アーヤ",
            "text": "あら、失礼ね。\n私だって貴方と同じ、\n私の一部なのよ？",
            "zh": "哎呀，真失礼。\n我明明也和你一样，\n是我的一部分哦？",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "39/TALK",
            "narrator": "潜在アーヤ",
            "text": "誤解なんかじゃなく\n正真正銘、私の潜在\n的な欲求の１つなの。",
            "zh": "才不是什么误解，\n我可是货真价实的，\n我潜在欲求之一哦。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "40/TALK",
            "narrator": "表層アーヤ",
            "text": "認めない。",
            "zh": "我不承认。",
            "narrator_zh": "表层绫水"
        },
        {
            "location": "41/TALK",
            "narrator": "潜在アーヤ",
            "text": "認めてくれなくても\nいいわよ。だって――",
            "zh": "你不肯承认也\n没关系哦。毕竟——",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "42/TALK",
            "narrator": "潜在アーヤ",
            "text": "貴方はここで\n消える運命に\nあるんだから！",
            "zh": "你注定\n就要在这里\n消失了嘛！",
            "narrator_zh": "潜在绫水"
        }
    ]
}
