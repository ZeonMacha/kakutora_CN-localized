{
    "dir": "chap11/daydra/dd_ch04_11_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "11452",
        "cid": "miyabi",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "ケーキだ！！",
        "title_zh": "Extra002 额外剧情",
        "sub_title_zh": "是蛋糕！！"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "ケーキだ！！",
            "zh": "是蛋糕！！",
            "narrator_zh": ""
        },
        {
            "location": "29/TALK",
            "narrator": "みやび",
            "text": "凄いケーキやね。\nこんなに沢山どうしたが？",
            "zh": "好厉害的蛋糕咯。\n这么多是怎么弄来的？",
            "narrator_zh": "雅"
        },
        {
            "location": "31/TALK",
            "narrator": "つばめ",
            "text": "まゆちんが、みんなで\n食べてください、って\n置いていったんです。",
            "zh": "是小茧留下来说\n「大家请吃」，\n然后就走了哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "33/TALK",
            "narrator": "ガブリエラ",
            "text": "こんなに沢山！？\nお金、大丈夫かしら？",
            "zh": "这么多！？\n钱不要紧吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "35/TALK",
            "narrator": "つばめ",
            "text": "バイト先で貰ったとか\n言ってたよ。",
            "zh": "听说是打工的地方\n拿的哦",
            "narrator_zh": "燕"
        },
        {
            "location": "37/TALK",
            "narrator": "アーヤ",
            "text": "光月さんって、\nケーキ屋でアルバイト\nしてるの？",
            "zh": "光月是在\n蛋糕店打工\n吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "39/TALK",
            "narrator": "つばめ",
            "text": "さあ？\n聞いても教えて\nくれないんです。",
            "zh": "谁知道呀？\n就算问，她也不肯\n告诉我。",
            "narrator_zh": "燕"
        },
        {
            "location": "41/TALK",
            "narrator": "ガブリエラ",
            "text": "そんなのどうだって\nいいじゃない。",
            "zh": "那种事怎么都\n无所谓吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "43/TALK",
            "narrator": "ガブリエラ",
            "text": "早くケーキ食べようよ！",
            "zh": "快点吃蛋糕啦！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "45/TALK",
            "narrator": "つばめ",
            "text": "うん、そうしよ。\nみなさん、どのケーキが\n良いですか？",
            "zh": "嗯，就这么办。\n大家想选哪块\n蛋糕呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "48/TALK",
            "narrator": "アーヤ",
            "text": "色々あるから迷うわね。\nう～ん…。",
            "zh": "种类太多，难选了。\n唔……",
            "narrator_zh": "绫水"
        },
        {
            "location": "49/TALK",
            "narrator": "ガブリエラ",
            "text": "あたし、マスカットの\n載ったやつがいいわ。",
            "zh": "我要有\n麝香葡萄的那块。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "51/TALK",
            "narrator": "アーヤ",
            "text": "あ、それ美味しそう。",
            "zh": "啊，那个看起来很好吃。",
            "narrator_zh": "绫水"
        },
        {
            "location": "54/TALK",
            "narrator": "ガブリエラ",
            "text": "早い者勝ちよ。",
            "zh": "先到先得哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "56/TALK",
            "narrator": "みやび",
            "text": "ふむ…\nうちはどれにしよう…。",
            "zh": "唔……\n我选哪块好呢……。",
            "narrator_zh": "雅"
        },
        {
            "location": "58/TALK",
            "narrator": "みやび",
            "text": "ソースの掛かった\nチーズケーキも\n美味しそうやけんど――",
            "zh": "淋了酱汁的\n芝士蛋糕也好吃，\n不过——",
            "narrator_zh": "雅"
        },
        {
            "location": "60/TALK",
            "narrator": "みやび",
            "text": "こっちは、タルト生地か？\nフルーツも山盛りで\n良さそうやなぁ…。",
            "zh": "这边是水果塔的皮吗？\n水果也堆得满满，\n看着不错嘛……。",
            "narrator_zh": "雅"
        },
        {
            "location": "62/TALK",
            "narrator": "みやび",
            "text": "じゃあ、うちはそこの――",
            "zh": "那我就要那边的——",
            "narrator_zh": "雅"
        },
        {
            "location": "65/TALK",
            "narrator": "つばめ",
            "text": "わたし、このケーキ\n貰いますね。",
            "zh": "我要拿这块\n蛋糕哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "66/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "68/TALK",
            "narrator": "みやび",
            "text": "出遅れたか…。\nすっと決めとくん\nやったわ…。",
            "zh": "慢了一步吗……。\n早知道就快点\n定下来……。",
            "narrator_zh": "雅"
        },
        {
            "location": "69/SEL",
            "narrator": "",
            "text": "端末操作：つばめと会話",
            "zh": "终端操作：与燕对话",
            "narrator_zh": ""
        },
        {
            "location": "71/TALK",
            "narrator": "アーヤ",
            "text": "う～ん…なかなか\n決まらないわ…。",
            "zh": "唔……怎么也\n定不下来……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "72/TALK",
            "narrator": "アーヤ",
            "text": "普通のショートケーキも\n美味しそうだけど、\nティラミスも…。",
            "zh": "普通的草莓奶油蛋糕\n也不错，但提拉米苏\n也……",
            "narrator_zh": "绫水"
        },
        {
            "location": "73/TALK",
            "narrator": "ガブリエラ",
            "text": "もう、本当に優柔不断\nなんだから。",
            "zh": "真是的，你可真\n够优柔寡断的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "75/TALK",
            "narrator": "アーヤ",
            "text": "みやびはどれにするの？",
            "zh": "雅你选哪个？",
            "narrator_zh": "绫水"
        },
        {
            "location": "79/TALK",
            "narrator": "みやび",
            "text": "…じゃあ、うちは\nザッハトルテもらうきね。",
            "zh": "……那我就\n要萨赫蛋糕了啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "82/TALK",
            "narrator": "みやび",
            "text": "ほれ、アーヤ。\nいつまでも悩んでたら\nみんなが食べられんぞ？",
            "zh": "来，绫水。\n你再犹豫下去，\n大家可就吃不成咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "85/TALK",
            "narrator": "アーヤ",
            "text": "そ、そうね…。\nじゃあ、やっぱりショート\nケーキにするわ。",
            "zh": "也、也是……。\n那就果然还是\n草莓奶油蛋糕吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "89/TALK",
            "narrator": "ガブリエラ",
            "text": "シンプルだけどいいの？",
            "zh": "这么简单真的可以吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "91/TALK",
            "narrator": "アーヤ",
            "text": "ショートケーキは\nケーキの王様よ。",
            "zh": "草莓奶油蛋糕\n可是蛋糕之王哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "93/TALK",
            "narrator": "みやび",
            "text": "決まったな。\nじゃあ、お茶でも\n入れるがよ。",
            "zh": "都定好了。\n那我去给大家\n泡点茶咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "96/TALK",
            "narrator": "つばめ",
            "text": "わたしも手伝います。",
            "zh": "我也来帮忙。",
            "narrator_zh": "燕"
        },
        {
            "location": "98/ACT",
            "narrator": "",
            "text": "端末操作：つばめと会話",
            "zh": "终端操作：与燕对话",
            "narrator_zh": ""
        },
        {
            "location": "104/TALK",
            "narrator": "つばめ",
            "text": "あれ？",
            "zh": "咦？",
            "narrator_zh": "燕"
        },
        {
            "location": "116/TALK",
            "narrator": "つばめ",
            "text": "どうかしたの？",
            "zh": "怎么了吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "118/SEL",
            "narrator": "",
            "text": "みやびもそれ食べたいって",
            "zh": "说雅也想吃那块来着",
            "narrator_zh": ""
        },
        {
            "location": "119/SEL",
            "narrator": "",
            "text": "モンブランは？",
            "zh": "蒙布朗呢？",
            "narrator_zh": ""
        },
        {
            "location": "120/SEL",
            "narrator": "",
            "text": "他に食べたいのないの？",
            "zh": "没有其他想吃的吗？",
            "narrator_zh": ""
        },
        {
            "location": "121/ACT",
            "narrator": "",
            "text": "みやびもそれ食べたいって",
            "zh": "说雅也想吃那块来着",
            "narrator_zh": ""
        },
        {
            "location": "122/TALK",
            "narrator": "つばめ",
            "text": "あっ、そうだったんだ？",
            "zh": "啊，原来是这样呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "123/TALK",
            "narrator": "つばめ",
            "text": "教えてくれてありがと",
            "zh": "谢谢告诉我哦",
            "narrator_zh": "燕"
        },
        {
            "location": "134/TALK",
            "narrator": "みやび",
            "text": "さてと、うちはどれに\nしようか…。",
            "zh": "那么，我该选\n哪块好呢……。",
            "narrator_zh": "雅"
        },
        {
            "location": "136/TALK",
            "narrator": "つばめ",
            "text": "あ、あの…よかったら\nこのケーキ、どうぞ。",
            "zh": "那、那个……如果可以的话，\n这块蛋糕给你。",
            "narrator_zh": "燕"
        },
        {
            "location": "138/TALK",
            "narrator": "みやび",
            "text": "え？",
            "zh": "诶？",
            "narrator_zh": "雅"
        },
        {
            "location": "139/TALK",
            "narrator": "つばめ",
            "text": "果物いっぱい載ってるし、\nサクサクのタルト生地で\n美味しいと思うんです。",
            "zh": "上面水果很多，\n塔皮又酥酥的，\n我觉得会很好吃哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "140/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "142/TALK",
            "narrator": "つばめ",
            "text": "えっと…こういうケーキ\n嫌いですか？",
            "zh": "那个……你讨厌\n这种蛋糕吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "143/TALK",
            "narrator": "みやび",
            "text": "えいが？\n食べたい思っちゅうがやろ？",
            "zh": "难道不好咩？\n我是想吃才对，是没是？",
            "narrator_zh": "雅"
        },
        {
            "location": "146/TALK",
            "narrator": "つばめ",
            "text": "えへへ…実は、もう一つ\n気になってたケーキも\nあったんで…。",
            "zh": "嘿嘿……其实，还有一块\n我也很在意的\n蛋糕来着……。",
            "narrator_zh": "燕"
        },
        {
            "location": "148/TALK",
            "narrator": "みやび",
            "text": "そういうことなら、\nありがたく貰うぞね。",
            "zh": "既然你都这么说了，\n那我就不客气收下咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "149/TALK",
            "narrator": "みやび",
            "text": "実は、これが食べたい\n思うてたんよ。",
            "zh": "其实，我想吃的\n就是这个哦。",
            "narrator_zh": "雅"
        },
        {
            "location": "150/TALK",
            "narrator": "つばめ",
            "text": "良かった…。\nじゃあ、わたしは\nこっちのケーキを――",
            "zh": "太好了……。\n那我就拿\n这边的蛋糕——",
            "narrator_zh": "燕"
        },
        {
            "location": "153/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "165/TALK",
            "narrator": "みやび",
            "text": "相棒、聞きたいことがあるんやけんど",
            "zh": "搭档，有件事想问问你。",
            "narrator_zh": "雅"
        },
        {
            "location": "166/TALK",
            "narrator": "みやび",
            "text": "つばめちゃんに、ケーキのことで何か言ったがか？",
            "zh": "你是不是跟燕说了什么关于蛋糕的事咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "168/SEL",
            "narrator": "",
            "text": "みやびも食べたい、って",
            "zh": "说了「雅也想吃」来着",
            "narrator_zh": ""
        },
        {
            "location": "169/ACT",
            "narrator": "",
            "text": "みやびも食べたい、って",
            "zh": "说了「雅也想吃」来着",
            "narrator_zh": ""
        },
        {
            "location": "171/TALK",
            "narrator": "みやび",
            "text": "うちのことを思うてしてくれたんはわかっちゅうけんど",
            "zh": "我知道你是为我着想才这么做的，",
            "narrator_zh": "雅"
        },
        {
            "location": "172/TALK",
            "narrator": "みやび",
            "text": "うちが食べたいいうの知ったら、つばめちゃんが譲ろうとするんわかるちや？",
            "zh": "可要是她知道我想吃，燕就会让出来，这你懂滴吧？",
            "narrator_zh": "雅"
        },
        {
            "location": "173/TALK",
            "narrator": "みやび",
            "text": "こういうズル、うちは大嫌いや",
            "zh": "这种投机取巧，我最讨厌了。",
            "narrator_zh": "雅"
        },
        {
            "location": "174/TALK",
            "narrator": "みやび",
            "text": "二度と勝手な真似は許さんきな",
            "zh": "下次再自作主张，我可不会原谅你啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "185/ACT",
            "narrator": "",
            "text": "モンブランは？",
            "zh": "蒙布朗呢？",
            "narrator_zh": ""
        },
        {
            "location": "187/TALK",
            "narrator": "つばめ",
            "text": "モンブランはよく食べるから、今日はこれがいいの",
            "zh": "蒙布朗我经常吃，今天想要这块啦",
            "narrator_zh": "燕"
        },
        {
            "location": "188/TALK",
            "narrator": "つばめ",
            "text": "それに、貰った中にモンブランはなさそうだし",
            "zh": "而且收到的里面好像也没有蒙布朗",
            "narrator_zh": "燕"
        },
        {
            "location": "200/TALK",
            "narrator": "つばめ",
            "text": "…あれ？\nそこのケーキって\n何ですか？",
            "zh": "……咦？\n那边的蛋糕\n是什么呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "202/TALK",
            "narrator": "アーヤ",
            "text": "これ？　えっと…\nモンブランじゃない？",
            "zh": "这个？　那个……\n不是蒙布朗吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "204/TALK",
            "narrator": "つばめ",
            "text": "えっ、これが！？",
            "zh": "诶，这个是！？",
            "narrator_zh": "燕"
        },
        {
            "location": "206/TALK",
            "narrator": "ガブリエラ",
            "text": "クリームの量が凄いわね。\nタワーみたいに\nなってるし。",
            "zh": "奶油量好惊人啊。\n简直像座塔\n一样。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "207/TALK",
            "narrator": "つばめ",
            "text": "こんなに凄いモンブラン、\n見たことなくて\nわかりませんでした…。",
            "zh": "这么厉害的蒙布朗，\n我从来没见过，\n所以没认出来……。",
            "narrator_zh": "燕"
        },
        {
            "location": "208/TALK",
            "narrator": "つばめ",
            "text": "…いいなぁ。\nモンブランにすれば\nよかったなぁ。",
            "zh": "……真好呀。\n要是选蒙布朗\n就好了呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "210/TALK",
            "narrator": "みやび",
            "text": "交換すればえいよ。\n手を付けたわけや\nないがやし。",
            "zh": "换一下就得咯。\n反正都还没\n动过嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "212/TALK",
            "narrator": "つばめ",
            "text": "いいんですか？",
            "zh": "真的可以吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "214/TALK",
            "narrator": "みやび",
            "text": "えいよ、うちとしても\nありがたいき。",
            "zh": "得，我这边\n也是求之不得啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "215/TALK",
            "narrator": "みやび",
            "text": "つばめちゃんの持ってる\nケーキ、食べたい思うて\nたんよ。",
            "zh": "燕拿着的那个蛋糕，\n我本来就想\n吃那个哦。",
            "narrator_zh": "雅"
        },
        {
            "location": "216/TALK",
            "narrator": "つばめ",
            "text": "そうだったんですか？\nじゃあ、どうぞ。",
            "zh": "原来是这样呀？\n那就给你。",
            "narrator_zh": "燕"
        },
        {
            "location": "217/TALK",
            "narrator": "みやび",
            "text": "ん、ありがとな。",
            "zh": "嗯，谢了。",
            "narrator_zh": "雅"
        },
        {
            "location": "218/TALK",
            "narrator": "アーヤ",
            "text": "みやびって、そういう\nケーキが好きだったんだ？",
            "zh": "雅你喜欢这种\n蛋糕呀？",
            "narrator_zh": "绫水"
        },
        {
            "location": "221/TALK",
            "narrator": "みやび",
            "text": "意外かえ？\n果物が載ったケーキは、\n特別な感じがするきね。",
            "zh": "很意外咩？\n放了水果的蛋糕，\n感觉就是特别啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "223/TALK",
            "narrator": "みやび",
            "text": "まっこと美味そうやねぇ。\n先に食べててえいが？",
            "zh": "看着就蛮好吃咯。\n我先开吃好咩？",
