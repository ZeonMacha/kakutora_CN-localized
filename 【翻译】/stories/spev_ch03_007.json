{
    "dir": "chap00/daydra/spev_ch03_007.js",
    "type": "",
    "info": {
        "story_id": "3007",
        "cid": "",
        "title": "スペシャルエピソード",
        "sub_title": "神楽ちゃんとアルバイト",
        "title_zh": "特别篇",
        "sub_title_zh": "和神乐一起打工"
    },
    "entry": [
        {
            "location": "34/TALK",
            "narrator": "透明神楽",
            "text": "きゃーっ！\n思った通りです！",
            "zh": "呀——！\n果然和我料想的一样！",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "35/TALK",
            "narrator": "透明神楽",
            "text": "やっぱりガブちゃんは\nメイド服が似合いますね。",
            "zh": "加布果然\n很适合穿女仆装呢。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "36/TALK",
            "narrator": "透明ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "38/TALK",
            "narrator": "透明神楽",
            "text": "もぅ、ダメですよ。\nメイドさんなんだから\n笑顔にならないと。",
            "zh": "真是的，这样不行哦。\n既然当了女仆，\n就得露出笑容才行。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "41/TALK",
            "narrator": "透明ガブリエラ",
            "text": "あのね…アルバイトする\nとは聞いてたけど…。",
            "zh": "那个啊……虽然听说过\n要来打工……",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "42/TALK",
            "narrator": "透明ガブリエラ",
            "text": "いきなりメイド喫茶に\n連れてこられたら、\n心の準備ができないわよ。",
            "zh": "突然被带到\n女仆咖啡厅来，\n我根本来不及做心理准备呀。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "43/TALK",
            "narrator": "透明神楽",
            "text": "でも、ガブちゃんに土木\n作業や治験のバイトなんて\nさせられませんし…。",
            "zh": "可是，我也不能让加布\n去做土木工程\n或者试药员之类的打工呀……",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "44/TALK",
            "narrator": "透明ガブリエラ",
            "text": "それは無理だから！\nそのどっちかだったら、\n絶対却下してたわ。",
            "zh": "那种事绝对免谈！\n要是那两个里的任何一个，\n我早就一口回绝了。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "45/TALK",
            "narrator": "透明神楽",
            "text": "じゃあ、却下しなかった\nメイド喫茶は合格って\nことですね？",
            "zh": "这么说，没有被回绝的\n女仆咖啡厅就算是\n合格了呢？",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "46/TALK",
            "narrator": "透明ガブリエラ",
            "text": "…せめて、前日の夜には\n教えてほしかった、って\n言ってるの！",
            "zh": "……我是说，起码\n前一天晚上\n也该告诉我一声吧！",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "48/TALK",
            "narrator": "透明神楽",
            "text": "そんなに緊張しちゃい\nますか？",
            "zh": "有这么紧张\n吗？",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "49/TALK",
            "narrator": "透明ガブリエラ",
            "text": "当然でしょ！？\nいきなりメイド服着て\n給仕しろだなんて…。",
            "zh": "这不是废话吗！？\n突然让我换上女仆装\n去端茶倒水什么的……",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "51/TALK",
            "narrator": "透明神楽",
            "text": "うーん…。",
            "zh": "唔……",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "53/TALK",
            "narrator": "透明神楽",
            "text": "その割には、\n更衣室で嬉しそうに\n自撮りしてたような…。",
            "zh": "话虽如此，刚才好像\n还有人在更衣室里\n兴高采烈地自拍来着……",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "55/TALK",
            "narrator": "透明ガブリエラ",
            "text": "ちょっと、聞いてるの？",
            "zh": "等下，你有在听吗？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "56/TALK",
            "narrator": "透明神楽",
            "text": "あ、はい。\nちゃんと聞いてますよ。",
            "zh": "啊，在听。\n我有好好听着哦。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "57/TALK",
            "narrator": "透明神楽",
            "text": "でも、デートコースは\n当日まで秘密にして\nおいた方が…。",
            "zh": "不过，约会行程\n一直保密到当天\n再揭晓的话……",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "58/TALK",
            "narrator": "透明神楽",
            "text": "ドキドキ感あって\n楽しいと思いませんか？",
            "zh": "不是更有心跳加速的感觉，\n更让人期待吗？",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "61/TALK",
            "narrator": "透明ガブリエラ",
            "text": "あくまでもこれを\nデートって言うのね…。",
            "zh": "你打定主意管这叫\n约会了是吧……",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "63/TALK",
            "narrator": "透明ガブリエラ",
            "text": "まあ、いいわ。\nとにかく今はこのお店の\nメイドさんなんだから…。",
            "zh": "算了，行吧。\n总之现在我就是这家店的\n女仆了……",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "64/TALK",
            "narrator": "透明ガブリエラ",
            "text": "やる以上は、このお店で\n一番のメイドさんを\n目指すわ。",
            "zh": "既然要做，我就要以\n这家店的头牌女仆\n为目标。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "66/TALK",
            "narrator": "透明神楽",
            "text": "素敵です！",
            "zh": "太棒了！",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "67/TALK",
            "narrator": "透明神楽",
            "text": "なんだかんだ言っても、\nそう言ってくれると\n信じてました。",
            "zh": "不管嘴上怎么说，\n我就相信你\n一定会这么说的。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "68/TALK",
            "narrator": "透明ガブリエラ",
            "text": "無理言ってお店に\nお願いしたんでしょ？",
            "zh": "也是你硬着头皮\n去求店里的吧？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "69/TALK",
            "narrator": "透明ガブリエラ",
            "text": "なのに、中途半端な\n仕事なんてできないわ。",
            "zh": "既然如此，我就更不能\n马马虎虎地干活了。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "70/TALK",
            "narrator": "透明神楽",
            "text": "…あ、お店の中を\n覗いている人が\nいますね。",
            "zh": "……啊，有人在\n往店里面\n张望呢。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "72/TALK",
            "narrator": "透明ガブリエラ",
            "text": "入ってくるかしら？\n神楽、あたしのメイド服、\n変になってない？",
            "zh": "会走进来吗？\n神乐，我的女仆装，\n没穿歪吧？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "73/TALK",
            "narrator": "透明神楽",
            "text": "文句なしの完璧です。\nとっても可愛いですよ。",
            "zh": "无可挑剔，完美极了。\n特别可爱哦。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "74/TALK",
            "narrator": "透明ガブリエラ",
            "text": "そう…。",
            "zh": "是吗……",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "75/TALK",
            "narrator": "透明ガブリエラ",
            "text": "…神楽の方も、\n悪くないわよ。",
            "zh": "……神乐你穿得，\n也还不赖嘛。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "77/TALK",
            "narrator": "透明神楽",
            "text": "えっ？",
            "zh": "诶？",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "78/TALK",
            "narrator": "透明ガブリエラ",
            "text": "ほ、ほら、準備して！",
            "zh": "快、快点做好准备啦！",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "82/TALK",
            "narrator": "透明ガブリエラ",
            "text": "お帰りなさいませ、\nご主人さ…。",
            "zh": "欢迎回来，\n主……",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "83/TALK",
            "narrator": "透明真幌",
            "text": "…おっ、二人とも\nやってるな？",
            "zh": "……哦，你们两个\n正在干活呢？",
            "narrator_zh": "透明真幌"
        },
        {
            "location": "85/TALK",
            "narrator": "透明ガブリエラ",
            "text": "ま、まほ！？",
            "zh": "真、真幌！？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "87/TALK",
            "narrator": "透明神楽",
            "text": "あ、お帰りなさい、\n真幌お嬢様！",
            "zh": "啊，欢迎回来，\n真幌大小姐！",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "89/TALK",
            "narrator": "透明ガブリエラ",
            "text": "ちょ、なんで！？\nどうしてまほがここに！？",
            "zh": "等、为什么！？\n真幌怎么会在这里！？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "90/TALK",
            "narrator": "透明真幌",
            "text": "いや、卯月がギャヴィと\n一日だけメイドをやると\n言われてな。",
            "zh": "嗯，卯月来找我说，\n她要和加维去\n当一天女仆嘛。",
            "narrator_zh": "透明真幌"
        },
        {
            "location": "91/TALK",
            "narrator": "透明真幌",
            "text": "多分、恥ずかしくて\nいきなり接客は無理だと\n思うから…。",
            "zh": "她说你大概会害羞，\n一下子直接接待客人\n恐怕应付不来……",
            "narrator_zh": "透明真幌"
        },
        {
            "location": "92/TALK",
            "narrator": "透明真幌",
            "text": "少しでも慣れるように、\n客として来てくれと\n頼まれたんだ。",
            "zh": "为了让你多少适应一下，\n她便拜托我作为客人\n过来捧场了。",
            "narrator_zh": "透明真幌"
        },
        {
            "location": "93/TALK",
            "narrator": "透明ガブリエラ",
            "text": "か、神楽…あんたねぇ！",
            "zh": "神、神乐……你真是够了啊！",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "94/TALK",
            "narrator": "透明神楽",
            "text": "ほら、ガブちゃん。\nお嬢様をお席に\n案内してください。",
            "zh": "来吧，加布。\n请带大小姐\n到座位上就座吧。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "95/TALK",
            "narrator": "透明真幌",
            "text": "ギャヴィ、仕事中だろ？\nメイドに徹しろ。",
            "zh": "加维，还在工作吧？\n好好拿出女仆的样子来。",
            "narrator_zh": "透明真幌"
        },
        {
            "location": "97/TALK",
            "narrator": "透明ガブリエラ",
            "text": "うっ…こ、こちらです、\nお嬢様…。",
            "zh": "唔……这、这边请，\n大小姐……",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "98/TALK",
            "narrator": "透明真幌",
            "text": "ふむ…しかし似合うな。\nとっても可愛いぞ、\nギャヴィ。",
            "zh": "唔……不过还挺衬你的。\n非常可爱啊，\n加维。",
            "narrator_zh": "透明真幌"
        },
        {
            "location": "99/TALK",
            "narrator": "透明ガブリエラ",
            "text": "っ！？",
            "zh": "唔！？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "100/TALK",
            "narrator": "透明神楽",
            "text": "ですよね！\n私もずーっとそう思って\nいたんですよ。",
            "zh": "就是说啊！\n我也一直\n这么觉得呢。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "101/TALK",
            "narrator": "透明真幌",
            "text": "だが卯月、おまえだって\nとても可愛いぞ。",
            "zh": "不过卯月，你自己\n也很可爱啊。",
            "narrator_zh": "透明真幌"
        },
        {
            "location": "102/TALK",
            "narrator": "透明神楽",
            "text": "ありがとうございます！",
            "zh": "非常感谢！",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "104/TALK",
            "narrator": "透明神楽",
            "text": "実は、さっき\nガブちゃんにも\n褒めてもらったんです。",
            "zh": "其实，刚才\n加布也夸过我\n了哦。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "105/TALK",
            "narrator": "透明真幌",
            "text": "ギャヴィが素直に\n褒めるとは、珍しいことも\nあるものだ。",
            "zh": "加维居然会老老实实\n夸人，还真是件\n稀罕事啊。",
            "narrator_zh": "透明真幌"
        },
        {
            "location": "106/TALK",
            "narrator": "透明ガブリエラ",
            "text": "ちょ！？　わ、悪くない\nって言っただけでしょ！？",
            "zh": "等！？　我、我明明只说了\n“还不赖”而已吧！？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "107/TALK",
            "narrator": "透明真幌",
            "text": "ははは、まあ今日一日、\n仲良くメイドとして\n励むんだな。",
            "zh": "哈哈哈，行了，今天就一天，\n和和睦睦地作为女仆\n好好努力吧。",
            "narrator_zh": "透明真幌"
        },
        {
            "location": "109/TALK",
            "narrator": "透明ガブリエラ",
            "text": "…本当、なんのバイトを\nするのか確認しとけば\nよかった…。",
            "zh": "……真的，早知道\n先问清楚到底要打什么工\n就好了……",
            "narrator_zh": "透明加布里埃拉"
        }
    ]
}
