{
    "dir": "chap09/daydra/dd_ch01_09_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "9102",
        "cid": "tsubame",
        "title": "002 メインストーリー",
        "sub_title": "激務日和＜前編＞",
        "title_zh": "002 主线剧情",
        "sub_title_zh": "忙得正好＜前篇＞"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "激務日和",
            "zh": "忙得正好",
            "narrator_zh": ""
        },
        {
            "location": "39/TALK",
            "narrator": "つばめ",
            "text": "んーっ、ようやく\n放課後だよ…。",
            "zh": "嗯——，终于\n放学了呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "40/TALK",
            "narrator": "神楽",
            "text": "バイトまでは、\nまだ時間あります\nよね？",
            "zh": "到打工之前，\n还有时间\n吧？",
            "narrator_zh": "神乐"
        },
        {
            "location": "44/TALK",
            "narrator": "つばめ",
            "text": "そうだね。\nどこか寄ってこうか？",
            "zh": "是呀。\n要不要顺路去哪里？",
            "narrator_zh": "燕"
        },
        {
            "location": "46/TALK",
            "narrator": "雛",
            "text": "二人とも、\nおつかれー。",
            "zh": "你们两个，\n辛苦了——。",
            "narrator_zh": "雏"
        },
        {
            "location": "48/TALK",
            "narrator": "つばめ",
            "text": "あ、ひなこちゃん。",
            "zh": "啊，雏。",
            "narrator_zh": "燕"
        },
        {
            "location": "49/TALK",
            "narrator": "雛",
            "text": "ねえねえ、この後\nだけど、時間ある？",
            "zh": "呐呐，之后\n有时间吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "52/TALK",
            "narrator": "神楽",
            "text": "ええ、まあ…。\n行きたいところでも\nあるんですか？",
            "zh": "嗯，嘛……。\n有想去的地方\n吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "53/TALK",
            "narrator": "雛",
            "text": "えっとね、まずは\n市ヶ谷から有楽町線\nでしょ。",
            "zh": "那个呀，首先\n从市谷坐有乐町线\n对吧。",
            "narrator_zh": "雏"
        },
        {
            "location": "54/TALK",
            "narrator": "雛",
            "text": "新木場まで行って\nりんかい線に\n乗り換えて――",
            "zh": "坐到新木场\n换乘\n临海线——",
            "narrator_zh": "雏"
        },
        {
            "location": "55/TALK",
            "narrator": "雛",
            "text": "天王洲アイルから\nモノレール！",
            "zh": "从天王洲Isle\n坐单轨！",
            "narrator_zh": "雏"
        },
        {
            "location": "56/TALK",
            "narrator": "雛",
            "text": "帰りは京急山の手\n中央緩行線、って\nところでどう？",
            "zh": "回来坐京急山手\n中央缓行线，\n怎么样？",
            "narrator_zh": "雏"
        },
        {
            "location": "58/TALK",
            "narrator": "神楽",
            "text": "えっと…それで、\n目的地はどこなん\nですか？",
            "zh": "那个……这样的话，\n目的地是\n哪里？",
            "narrator_zh": "神乐"
        },
        {
            "location": "62/TALK",
            "narrator": "キリト",
            "text": "どこへも行かねぇん\nだよ、コイツは。\nただ電車に乗るだけ。",
            "zh": "哪也不去\n哦，这家伙。\n只是坐电车而已。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "63/TALK",
            "narrator": "ヒカル",
            "text": "ひなこさんにとっての\n電車は、手段ではなく\n目的ですからね。",
            "zh": "对雏来说，\n电车不是手段，\n是目的。",
            "narrator_zh": "光"
        },
        {
            "location": "66/TALK",
            "narrator": "つばめ",
            "text": "？　どういうこと？",
            "zh": "？什么意思？",
            "narrator_zh": "燕"
        },
        {
            "location": "68/TALK",
            "narrator": "キリト",
            "text": "ひなこは筋金入りの\n鉄道マニアでな――",
            "zh": "雏是铁杆\n铁路迷——",
            "narrator_zh": "圣翔"
        },
        {
            "location": "69/TALK",
            "narrator": "キリト",
            "text": "本当に、ただ電車に\n乗るだけで楽しめる\n変わり者なんだよ。",
            "zh": "真的，只是坐电车\n就能开心的\n怪人哦。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "72/TALK",
            "narrator": "雛",
            "text": "戦艦マニアの\nキリトよりは\n普通だと思うけど？",
            "zh": "比起战舰迷的\n圣翔，\n我觉得普通吧？",
            "narrator_zh": "雏"
        },
        {
            "location": "74/TALK",
            "narrator": "キリト",
            "text": "戦艦は普通だろ？",
            "zh": "战舰很普通吧？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "76/TALK",
            "narrator": "ヒカル",
            "text": "戦艦という時点で、\nもう普通ではないと\n思いますよ？",
            "zh": "说到战舰，\n就已经不算\n普通了吧？",
            "narrator_zh": "光"
        },
        {
            "location": "80/TALK",
            "narrator": "神楽",
            "text": "っていうか、キリト\nくん達とひなこさん\nって――",
            "zh": "话说，圣翔\n你们和雏\n是——",
            "narrator_zh": "神乐"
        },
        {
            "location": "81/TALK",
            "narrator": "神楽",
            "text": "お友達同士だったん\nですね？",
            "zh": "朋友\n吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "83/TALK",
            "narrator": "ヒカル",
            "text": "そういえば、\n話していません\nでしたね。",
            "zh": "说起来，\n还没\n说过呀。",
            "narrator_zh": "光"
        },
        {
            "location": "85/TALK",
            "narrator": "神楽",
            "text": "はい…高等部に\n入る前からの\n仲なんですか？",
            "zh": "是……升上高中部\n之前就\n要好吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "86/TALK",
            "narrator": "ヒカル",
            "text": "僕とひなこさんは\nそうですね。",
            "zh": "我和雏\n是这样。",
            "narrator_zh": "光"
        },
        {
            "location": "88/TALK",
            "narrator": "雛",
            "text": "キリトとまゆちんは、\n子供の頃からの\n幼馴染なんだよー。",
            "zh": "圣翔和茧，\n是从小的\n青梅竹马哦——。",
            "narrator_zh": "雏"
        },
        {
            "location": "92/TALK",
            "narrator": "繭",
            "text": "小学校からの腐れ縁。",
            "zh": "从小学起的孽缘。",
            "narrator_zh": "茧"
        },
        {
            "location": "95/TALK",
            "narrator": "キリト",
            "text": "幼馴染でいいだろ？",
            "zh": "说青梅竹马就行了吧？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "98/TALK",
            "narrator": "つばめ",
            "text": "ふーん。\nそうだったんだ…。",
            "zh": "嗯——。\n原来是这样……。",
            "narrator_zh": "燕"
        },
        {
            "location": "99/TALK",
            "narrator": "雛",
            "text": "そういうこと。\nそれはそうと――",
            "zh": "就是这么回事。\n那先不说——",
            "narrator_zh": "雏"
        },
        {
            "location": "102/TALK",
            "narrator": "雛",
            "text": "まゆちんはどうする？\nたまには電車乗りに\n行こうよー。",
            "zh": "茧怎么办？\n偶尔也去\n坐电车呀——。",
            "narrator_zh": "雏"
        },
        {
            "location": "104/TALK",
            "narrator": "繭",
            "text": "無理。\n私、これからバイト\nだから。",
            "zh": "不行。\n我接下来要\n打工。",
            "narrator_zh": "茧"
        },
        {
            "location": "106/TALK",
            "narrator": "つばめ",
            "text": "まゆちんって、\n何のアルバイト\nしてるの？",
            "zh": "茧，\n在打什么工\n呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "108/TALK",
            "narrator": "繭",
            "text": "黙秘権施行！",
            "zh": "行使沉默权！",
            "narrator_zh": "茧"
        },
        {
            "location": "111/TALK",
            "narrator": "キリト",
            "text": "ちっ！　いい加減\n教えてくれても\nいいじゃねぇか。",
            "zh": "啧！你也该\n告诉我了\n吧。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "114/TALK",
            "narrator": "雛",
            "text": "ほらほら、寂しくて\nキリトがすねちゃっ\nてるよ？",
            "zh": "看看看，寂寞得\n圣翔在\n闹别扭哦？",
            "narrator_zh": "雏"
        },
        {
            "location": "116/TALK",
            "narrator": "キリト",
            "text": "いや、違ぇから！",
            "zh": "才不是！",
            "narrator_zh": "圣翔"
        },
        {
            "location": "119/TALK",
            "narrator": "雛",
            "text": "って、こんなこと\n話してる暇はないよ。",
            "zh": "说这些\n没时间了呀。",
            "narrator_zh": "雏"
        },
        {
            "location": "120/TALK",
            "narrator": "雛",
            "text": "今なら１５時２３分\n発に乗れるよー。",
            "zh": "现在还能赶上\n15点23分开的车哦——。",
            "narrator_zh": "雏"
        },
        {
            "location": "124/TALK",
            "narrator": "神楽",
            "text": "…どうしましょうか、\nつばめさん？",
            "zh": "……怎么办，\n燕？",
            "narrator_zh": "神乐"
        },
        {
            "location": "126/TALK",
            "narrator": "つばめ",
            "text": "うーん…時間まで、\n一緒に行こうかな？",
            "zh": "嗯……到时间之前，\n要不要一起去呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "133/TALK",
            "narrator": "ガブリエラ",
            "text": "おいこら、新人共！",
            "zh": "喂，你们这些新人！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "140/TALK",
            "narrator": "つばめ",
            "text": "うわっ！？",
            "zh": "哇！？",
            "narrator_zh": "燕"
        },
        {
            "location": "142/TALK",
            "narrator": "みやび",
            "text": "つばめちゃん、\n驚き過ぎや。",
            "zh": "燕，\n吓过头了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "143/TALK",
            "narrator": "つばめ",
            "text": "が、ガブちゃん、\nそれにみやびさん。",
            "zh": "加、加布，\n还有雅。",
            "narrator_zh": "燕"
        },
        {
            "location": "145/TALK",
            "narrator": "ガブリエラ",
            "text": "だからー！\nあんたはガブちゃん\n禁止って――",
            "zh": "所以说——！\n不许你叫\n加布——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "146/TALK",
            "narrator": "ガブリエラ",
            "text": "何回も言ってる\nじゃん！",
            "zh": "我说了\n多少次了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "148/TALK",
            "narrator": "つばめ",
            "text": "ご、ごめんなさい…。",
            "zh": "对、对不起……。",
            "narrator_zh": "燕"
        },
        {
            "location": "150/TALK",
            "narrator": "雛",
            "text": "ちょ、ちょっと、\nうちのクラスに\nトライナリー――",
            "zh": "等、等一下，\n我们班里\n三重奏——",
            "narrator_zh": "雏"
        },
        {
            "location": "151/TALK",
            "narrator": "雛",
            "text": "概ね全員集合\nなんですけど！？",
            "zh": "基本上全员集合\n了呀！？",
            "narrator_zh": "雏"
        },
        {
            "location": "154/TALK",
            "narrator": "繭",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "茧"
        },
        {
            "location": "157/TALK",
            "narrator": "みやび",
            "text": "むっ？\nうちに熱い視線向け\nちょる子がおるな。",
            "zh": "唔？\n有人在朝我\n抛热视线咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "158/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "159/TALK",
            "narrator": "繭",
            "text": "っ！？",
            "zh": "っ！？",
            "narrator_zh": "茧"
        },
        {
            "location": "161/TALK",
            "narrator": "ヒカル",
            "text": "あ、繭さん。\nペンを落とし\nましたよ。",
            "zh": "啊，茧。\n笔掉了\n哦。",
            "narrator_zh": "光"
        },
        {
            "location": "163/TALK",
            "narrator": "繭",
            "text": "あ、ありがとう…。",
            "zh": "啊，谢谢……。",
            "narrator_zh": "茧"
        },
        {
            "location": "165/TALK",
            "narrator": "繭",
            "text": "…何たる失態。\n絶対見つめてたの\n気付かれた…。",
            "zh": "……何等失态。\n绝对被发现\n我在看了……。",
            "narrator_zh": "茧"
        },
        {
            "location": "167/TALK",
            "narrator": "ガブリエラ",
            "text": "ほら、ぐずぐずして\nないで、行くわよ。",
            "zh": "来，别磨蹭了，\n走了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "169/TALK",
            "narrator": "つばめ",
            "text": "い、行くって、\nどこへ？",
            "zh": "走、走是去\n哪里？",
            "narrator_zh": "燕"
        },
        {
            "location": "172/TALK",
            "narrator": "ガブリエラ",
            "text": "バイトに決まってる\nでしょ？\nバ・イ・ト！",
            "zh": "当然是打工\n吧？\n打·工！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "173/TALK",
            "narrator": "つばめ",
            "text": "で、でも、バイトの\n時間まではまだ\n余裕あるし…。",
            "zh": "可、可是，到打工\n时间之前还有\n空余……。",
            "narrator_zh": "燕"
        },
        {
            "location": "175/TALK",
            "narrator": "ガブリエラ",
            "text": "まさか、遊びに行く\nとか言うんじゃない\nでしょうね？",
            "zh": "该不会要说\n去玩\n吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "177/TALK",
            "narrator": "つばめ",
            "text": "うっ！？",
            "zh": "呜！？",
            "narrator_zh": "燕"
        },
        {
            "location": "180/TALK",
            "narrator": "神楽",
            "text": "あの、サボろうと\nしてたわけじゃ\nないんですよ？",
            "zh": "那个，并不是\n想偷懒\n哦？",
            "narrator_zh": "神乐"
        },
        {
            "location": "181/TALK",
            "narrator": "神楽",
            "text": "ただ、バイトの時間\nまで遊ぼうかな、と\n思っただけで…。",
            "zh": "只是想着，到打工\n时间之前去玩玩\n而已……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "182/TALK",
            "narrator": "ガブリエラ",
            "text": "ド新人にそんな時間\nあるわけないでしょ！",
            "zh": "超级新人哪有\n那种时间！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "183/TALK",
            "narrator": "ガブリエラ",
            "text": "一に掃除、二に掃除！\n三四も掃除で\n五も掃除！",
            "zh": "第一是打扫，第二是打扫！\n三四也是打扫，\n第五还是打扫！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "184/TALK",
            "narrator": "つばめ",
            "text": "で、でも、まだ\nバイトまで２時間は\nありますよ？",
            "zh": "可、可是，到打工\n还有两个小时\n呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "185/TALK",
            "narrator": "神楽",
            "text": "そうですよ。\nさすがに早過ぎじゃ\nないですか？",
            "zh": "就是呀。\n这也太早了\n吧？",
            "narrator_zh": "神乐"
        },
        {
            "location": "188/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…そういうのは\n新人を卒業してから\n言うことよ。",
            "zh": "哈啊……那种话\n等你不当新人了\n再说。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "189/TALK",
            "narrator": "ガブリエラ",
            "text": "それに、掃除以外にも\n仕事は山のように\nあるんだから――",
            "zh": "而且，除了打扫\n工作还堆成\n山——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "190/TALK",
            "narrator": "ガブリエラ",
            "text": "文句は、それを\n全部覚えてから\n言いなさい。",
            "zh": "有意见，等这些\n全部记住了\n再说。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "191/TALK",
            "narrator": "つばめ",
            "text": "そ、そんなに覚える\nことあるんですか！？",
            "zh": "有、有那么多\n要记的吗！？",
            "narrator_zh": "燕"
        },
        {
            "location": "192/TALK",
            "narrator": "神楽",
            "text": "ないと思いますよ？\nお客さんもほとんど\n来ないんですし…。",
            "zh": "我觉得没有哦？\n客人也几乎\n不来……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "193/TALK",
            "narrator": "ガブリエラ",
            "text": "お、お客が来なくても\nやらなきゃいけない\nことは沢山あるの！！",
            "zh": "没、没客人来\n也有好多\n必须做的事！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "194/TALK",
            "narrator": "ガブリエラ",
            "text": "だから、文句言わずに\n劇場行くわよ。",
            "zh": "所以，别抱怨，\n去剧场了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "195/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "196/SEL",
            "narrator": "",
