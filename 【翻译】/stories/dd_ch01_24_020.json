{
    "dir": "chap24/daydra/dd_ch01_24_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "24156",
        "cid": "tsubame",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "壊れゆく日常",
        "title_zh": "Extra006 额外剧情",
        "sub_title_zh": "正在坏掉的日常"
    },
    "entry": [
        {
            "location": "301/SCENARIO",
            "narrator": "",
            "text": "壊れゆく日常",
            "zh": "正在坏掉的日常",
            "narrator_zh": ""
        },
        {
            "location": "320/TALK",
            "narrator": "つばめ",
            "text": "…忘れ物はなし、と。",
            "zh": "……没有忘带的，好。",
            "narrator_zh": "燕"
        },
        {
            "location": "323/TALK",
            "narrator": "つばめ",
            "text": "神楽ちゃん、\n今日は帰り――",
            "zh": "神乐，\n今天回去——",
            "narrator_zh": "燕"
        },
        {
            "location": "324/TALK",
            "narrator": "つばめ",
            "text": "あっ…。",
            "zh": "啊……。",
            "narrator_zh": "燕"
        },
        {
            "location": "328/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "331/TALK",
            "narrator": "雛",
            "text": "つーばめちゃんっ！",
            "zh": "燕——！",
            "narrator_zh": "雏"
        },
        {
            "location": "333/TALK",
            "narrator": "つばめ",
            "text": "わわっ！？\nひ、ひなこちゃん…。",
            "zh": "哇哇！？\n小、小雏……。",
            "narrator_zh": "燕"
        },
        {
            "location": "334/TALK",
            "narrator": "雛",
            "text": "やっと放課後なのに、\n暗い顔してるなんて\nもったいないよ？",
            "zh": "好不容易放学了，\n还摆着一张暗脸，\n太可惜了吧？",
            "narrator_zh": "雏"
        },
        {
            "location": "335/TALK",
            "narrator": "つばめ",
            "text": "あ、あはは…そうだよね。",
            "zh": "啊、啊哈哈……是呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "336/TALK",
            "narrator": "雛",
            "text": "はぁ…、つばめちゃんって\n本当わかりやすいなぁ…。",
            "zh": "唉……燕你\n真的太好懂了……。",
            "narrator_zh": "雏"
        },
        {
            "location": "338/TALK",
            "narrator": "つばめ",
            "text": "そ、そうかな？",
            "zh": "是、是吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "339/TALK",
            "narrator": "雛",
            "text": "うん、超わかりやすいよ。",
            "zh": "嗯，超好懂的。",
            "narrator_zh": "雏"
        },
        {
            "location": "340/TALK",
            "narrator": "雛",
            "text": "そうだ！　こういう時は\n甘いものでも食べながら\nお話しようよ！",
            "zh": "对了！　这种时候\n就吃着甜的\n来聊吧！",
            "narrator_zh": "雏"
        },
        {
            "location": "341/TALK",
            "narrator": "雛",
            "text": "きっと、ちょっとは\n気分転換になると思うし。",
            "zh": "我觉得，多少\n能换换心情。",
            "narrator_zh": "雏"
        },
        {
            "location": "343/TALK",
            "narrator": "つばめ",
            "text": "…うん。\nわたしも、ちょっと\nお話ししたいな。",
            "zh": "……嗯。\n我也有点\n想聊聊。",
            "narrator_zh": "燕"
        },
        {
            "location": "344/TALK",
            "narrator": "雛",
            "text": "決まり！\nじゃ、まゆちん\n呼んでくるねー。",
            "zh": "就这么定了！\n那我去叫\n小茧哦。",
            "narrator_zh": "雏"
        },
        {
            "location": "361/TALK",
            "narrator": "雛",
            "text": "――でね、夏休みの宿題が\nずーっと終わらなくて、\n最終日徹夜だったのよー。",
            "zh": "——然后呢，暑假作业\n一直做不完，\n最后一天熬了个通宵哦。",
            "narrator_zh": "雏"
        },
        {
            "location": "363/TALK",
            "narrator": "つばめ",
            "text": "あはは、そうだったんだ。",
            "zh": "啊哈哈，是这样呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "364/TALK",
            "narrator": "雛",
            "text": "うん…つばめちゃんは\nちゃんと終わらせられた？",
            "zh": "嗯……燕\n有好好做完吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "365/TALK",
            "narrator": "つばめ",
            "text": "みやびさんの家で\n終わらせたよ。",
            "zh": "在雅家里\n做完的呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "366/TALK",
            "narrator": "つばめ",
            "text": "まあ、ガブちゃんにも\nちょっと手伝っては\nもらったけど…。",
            "zh": "不过，也让加布\n帮了一点\n忙……。",
            "narrator_zh": "燕"
        },
        {
            "location": "367/TALK",
            "narrator": "繭",
            "text": "…ガブリエラって、\n下級生だけど？",
            "zh": "……加布里埃拉，\n可是低年级的吧？",
            "narrator_zh": "茧"
        },
        {
            "location": "370/TALK",
            "narrator": "つばめ",
            "text": "あ、あはは…、\nちょっとカッコ悪いけど、\n色々教わっちゃった…。",
            "zh": "啊、啊哈哈……、\n有点丢脸，\n被她教了好多……。",
            "narrator_zh": "燕"
        },
        {
            "location": "372/TALK",
            "narrator": "雛",
            "text": "いいなー。あたしも\nガブリエラちゃんに\n教えてほしかったなー。",
            "zh": "真好啊。我也想\n让加布里埃拉\n教教我啊。",
            "narrator_zh": "雏"
        },
        {
            "location": "373/TALK",
            "narrator": "つばめ",
            "text": "頼めば教えてくれると\n思うけど、\nとっても厳しいよ？",
            "zh": "拜托的话她应该\n会教，\n不过非常严格哦？",
            "narrator_zh": "燕"
        },
        {
            "location": "374/TALK",
            "narrator": "繭",
            "text": "逆にガブリエラが\n優しく教えたら怖いと\n思うけど？",
            "zh": "反过来，加布里埃拉要是\n温柔地教，才\n更吓人吧？",
            "narrator_zh": "茧"
        },
        {
            "location": "376/TALK",
            "narrator": "雛",
            "text": "あはは、確かに。",
            "zh": "啊哈哈，确实。",
            "narrator_zh": "雏"
        },
        {
            "location": "379/TALK",
            "narrator": "つばめ",
            "text": "ふふっ…。",
            "zh": "呵呵……。",
            "narrator_zh": "燕"
        },
        {
            "location": "381/TALK",
            "narrator": "つばめ",
            "text": "…そういえば、\nキリトくん達からは\n連絡あった？",
            "zh": "……说起来，\n圣翔他们\n有联系吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "383/TALK",
            "narrator": "雛",
            "text": "ううん、ぜーんぜん。\nＷＡＶＥの既読すら\nつかないよ。",
            "zh": "没有，完全没有。\nWAVE连已读\n都没有哦。",
            "narrator_zh": "雏"
        },
        {
            "location": "384/TALK",
            "narrator": "つばめ",
            "text": "そっか…。",
            "zh": "这样啊……。",
            "narrator_zh": "燕"
        },
        {
            "location": "385/TALK",
            "narrator": "繭",
            "text": "…仕方ないわ。\n通常攻撃隊は待機命令が\n出てるんだし。",
            "zh": "……没办法。\n普通攻击队\n已经下达待命命令了。",
            "narrator_zh": "茧"
        },
        {
            "location": "386/TALK",
            "narrator": "繭",
            "text": "学校にも来てないのに、\n外部との連絡に制限が\nかけられてないと思う？",
            "zh": "学校都没来，\n你觉得对外联系\n会不被限制吗？",
            "narrator_zh": "茧"
        },
        {
            "location": "388/TALK",
            "narrator": "つばめ",
            "text": "待機命令…。\nどういうことなんだろ？",
            "zh": "待命命令……。\n是怎么回事呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "389/SEL",
            "narrator": "",
            "text": "嫌な予感がするよ",
            "zh": "有种不祥的预感哦",
            "narrator_zh": ""
        },
        {
            "location": "392/TALK",
            "narrator": "雛",
            "text": "さーねー？\n先生に聞いてみたけど、\n教えてもらえなかったよ。",
            "zh": "谁知道呢？\n我问过老师，\n可是没告诉我哦。",
            "narrator_zh": "雏"
        },
        {
            "location": "394/TALK",
            "narrator": "繭",
            "text": "一般教諭には\n知らされてないはず。",
            "zh": "普通教师\n应该没被告知。",
            "narrator_zh": "茧"
        },
        {
            "location": "396/TALK",
            "narrator": "雛",
            "text": "情報漏洩を防ぐため？",
            "zh": "为了防止情报泄露？",
            "narrator_zh": "雏"
        },
        {
            "location": "397/TALK",
            "narrator": "繭",
            "text": "当然。",
            "zh": "当然。",
            "narrator_zh": "茧"
        },
        {
            "location": "401/TALK",
            "narrator": "つばめ",
            "text": "…みんな、こうやって\nどんどん忙しくなるの\nかな？",
            "zh": "……大家，会这样\n越来越忙\n下去吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "402/TALK",
            "narrator": "繭",
            "text": "…それも仕方ないわ。\n私達の学校は、他と違って\n特殊なんだから…。",
            "zh": "……这也没办法。\n我们的学校跟别处不一样，\n是特殊的……。",
            "narrator_zh": "茧"
        },
        {
            "location": "405/TALK",
            "narrator": "雛",
            "text": "そうだよねー。",
            "zh": "是呀。",
            "narrator_zh": "雏"
        },
        {
            "location": "406/TALK",
            "narrator": "雛",
            "text": "…じゃあ、段々と\nみんな揃うことも、\n減ってくのかな？",
            "zh": "……那，渐渐地\n大家凑齐的时候，\n也会变少吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "408/TALK",
            "narrator": "繭",
            "text": "…今よりかは減ると思う。\n進級とかすれば、確実に。",
            "zh": "……我觉得会比现在少。\n要是升了年级，那就肯定。",
            "narrator_zh": "茧"
        },
        {
            "location": "410/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "424/TALK",
            "narrator": "つばめ",
            "text": "…みんなが揃うことも、\n段々減ってく、か…。",
            "zh": "……大家凑齐的时候，\n也会渐渐变少，吗……。",
            "narrator_zh": "燕"
        },
        {
            "location": "425/TALK",
            "narrator": "つばめ",
            "text": "…でも、そうだよね。",
            "zh": "……可是，也是呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "426/TALK",
            "narrator": "つばめ",
            "text": "今はみんな一緒でも、\n進級や、進学すれば\nバラバラになるんだし…。",
            "zh": "现在大家还在一起，\n可一升年级、一升学\n就会分开的……。",
            "narrator_zh": "燕"
        },
        {
            "location": "427/TALK",
            "narrator": "つばめ",
            "text": "…せっかく、\nお友達になれたのに…。",
            "zh": "……好不容易，\n能成为朋友了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "429/TALK",
            "narrator": "つばめ",
            "text": "はぁ…。",
            "zh": "唉……。",
            "narrator_zh": "燕"
        },
        {
            "location": "432/TALK",
            "narrator": "ガブリエラ",
            "text": "…それ、あたしに対しての\nため息かしら？",
            "zh": "……那声叹气，\n是冲着我的吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "434/TALK",
            "narrator": "つばめ",
            "text": "えっ！？　あ、違うよ！\nちょっと考え事してて…。",
            "zh": "哎！？　啊，不是呀！\n我只是在想事情……。",
            "narrator_zh": "燕"
        },
        {
            "location": "435/TALK",
            "narrator": "ガブリエラ",
            "text": "何を考えてたのよ？",
            "zh": "你在想什么？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "437/TALK",
            "narrator": "つばめ",
            "text": "うん…いつかはみんな、\nバラバラになる日が\n来るのかなぁ、って…。",
            "zh": "嗯……总有一天，大家\n会不会有分开的日子\n到来呀，之类的……。",
            "narrator_zh": "燕"
        },
        {
            "location": "438/TALK",
            "narrator": "つばめ",
            "text": "進級とか、進学とか…、\n実家に帰るとか、\n理由は違うと思うけど。",
            "zh": "升年级啦，升学啦……、\n回老家啦，\n理由大概都不一样。",
            "narrator_zh": "燕"
        },
        {
            "location": "439/TALK",
            "narrator": "つばめ",
            "text": "そうやって、離ればなれに\nなる日は…来るんだよね？",
            "zh": "像那样，要分开的\n日子……会来的吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "440/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "441/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "442/TALK",
            "narrator": "ガブリエラ",
            "text": "いや、当然じゃん。\nってか考えるまでもない\nことでしょ、それ？",
            "zh": "不是，这不是明摆着的。\n这种事，\n想都不用想吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "444/TALK",
            "narrator": "つばめ",
            "text": "えっ…そ、そうかな？",
            "zh": "哎……是、是吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "445/TALK",
            "narrator": "ガブリエラ",
            "text": "じゃあ何よ？\nつばめは一生あの寮で\n暮らすつもりなわけ？",
            "zh": "那又怎样？\n燕打算在那宿舍\n住一辈子吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "447/TALK",
            "narrator": "つばめ",
            "text": "そ、そんなことは\nないけど…。",
            "zh": "没、没有\n那种打算……。",
            "narrator_zh": "燕"
        },
        {
            "location": "448/TALK",
            "narrator": "ガブリエラ",
            "text": "でしょ？",
            "zh": "对吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "451/TALK",
            "narrator": "ガブリエラ",
            "text": "そんな当たり前のこと\n考えてため息吐くとか、\n本当、お子ちゃまよね…。",
            "zh": "这种理所当然的事\n还要叹气，\n真是个小孩子……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "453/TALK",
            "narrator": "つばめ",
            "text": "で、でも、ガブちゃんは\nそれで平気なの？",
            "zh": "可、可是，加布\n这样也没关系吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "454/TALK",
            "narrator": "つばめ",
            "text": "バラバラになったら、\n中々会うこともできなく\nなっちゃうんだよ？",
            "zh": "要是分开了，\n就很难见面\n了呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "455/TALK",
            "narrator": "つばめ",
            "text": "それに…もしかしたら、\nもう会えなくなったりも\nするかもしれないし…。",
            "zh": "而且……说不定，\n还会变成再也\n见不到面……。",
            "narrator_zh": "燕"
        },
        {
            "location": "457/TALK",
            "narrator": "ガブリエラ",
            "text": "そりゃ、そういうことも\nなくはないでしょ。",
            "zh": "那当然，这种事\n也不是没有吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "459/TALK",
            "narrator": "つばめ",
            "text": "そんな…。",
            "zh": "怎么会……。",
            "narrator_zh": "燕"
        },
        {
            "location": "460/TALK",
            "narrator": "ガブリエラ",
            "text": "…まさかとは思うけど、\n寂しいからイヤだ、とか\n言わないわよね？",
            "zh": "……我觉得你不至于，\n说什么因为寂寞所以讨厌，\n那种话吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "462/TALK",
            "narrator": "つばめ",
            "text": "…ガブちゃんは、\n寂しくないの？",
            "zh": "……加布，\n不寂寞吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "464/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…あんたねぇ…。",
            "zh": "唉……你啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "466/TALK",
            "narrator": "ガブリエラ",
            "text": "そりゃさ…まあ、あたしも\nちょっとは寂しいと\n思わなくもないけど…。",
            "zh": "那是……嘛，我也\n不是一点都不\n觉得寂寞……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "468/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、それであたし達の\n繋がりが消えるわけじゃ\nないでしょ？",
            "zh": "可是，那样\n我们之间的联系\n也不会消失吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "470/TALK",
            "narrator": "つばめ",
            "text": "…え？",
            "zh": "……哎？",
            "narrator_zh": "燕"
        },
        {
            "location": "472/TALK",
            "narrator": "ガブリエラ",
            "text": "あのね…同じ戦場で、\n背中護り合って戦った\n仲間なのよ？",
            "zh": "我说……我们可是在\n同一片战场上，互相护过后背\n的同伴吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "473/TALK",
            "narrator": "ガブリエラ",
            "text": "それが、離ればなれに\nなっただけで気持ちが\nバラバラになると思う？",
            "zh": "就只是分开了，\n你觉得心情\n也会散掉吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "474/TALK",
            "narrator": "つばめ",
            "text": "お、思わないよ。\nそんなこと…。",
            "zh": "不、不会这么想呀。\n那种事……。",
            "narrator_zh": "燕"
        },
        {
            "location": "476/TALK",
            "narrator": "ガブリエラ",
            "text": "本当かしら？",
            "zh": "真的吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "477/TALK",
            "narrator": "つばめ",
            "text": "本当だよ！",
            "zh": "是真的呀！",
            "narrator_zh": "燕"
        },
        {
            "location": "478/TALK",
            "narrator": "ガブリエラ",
            "text": "じゃあ、何でそんなに\n不安になってんのよ？",
            "zh": "那你为什么\n那么不安？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "479/TALK",
            "narrator": "ガブリエラ",
            "text": "相手を信じられるなら、\nそんな不安になるはず\nないでしょ？",
            "zh": "要是信得过对方，\n就不该\n那么不安吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "480/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "482/TALK",
            "narrator": "ガブリエラ",
            "text": "…まあさ、あたしも…、\nもしもよ？",
            "zh": "……嘛，我也……、\n假如哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "483/TALK",
            "narrator": "ガブリエラ",
            "text": "もし、本当にみんなと\nバラバラになるような\nことになったらよ？",
            "zh": "假如，真的变成\n要跟大家分开\n那种情况呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "484/TALK",
            "narrator": "ガブリエラ",
            "text": "そうなったら…、\n会いたい、って…、\n時々は思うだろうし…。",
            "zh": "到了那时候……、\n想见，这种……、\n偶尔还是会想的吧……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "485/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "487/TALK",
            "narrator": "ガブリエラ",
            "text": "と、時々よ！？\nいつもじゃないから、\nわかってる？",
            "zh": "是、是偶尔！？\n不是一直这样，\n你明白吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "488/TALK",
            "narrator": "つばめ",
            "text": "…大丈夫だよ。",
            "zh": "……没关系的呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "489/TALK",
            "narrator": "つばめ",
            "text": "もしガブちゃんが、\n寂しいって気持ちに\nなったとしたら――",
            "zh": "如果加布\n心里觉得寂寞\n的话——",
            "narrator_zh": "燕"
        },
        {
            "location": "490/TALK",
            "narrator": "つばめ",
            "text": "わたし、世界中の\nどこでもガブちゃんに\n会いに行くから。",
            "zh": "我，不管是世界\n哪里，都会去\n见加布的。",
            "narrator_zh": "燕"
        },
        {
            "location": "491/TALK",
            "narrator": "ガブリエラ",
            "text": "…いや、無理でしょそれ？\nあんた海外旅行したこと\nあるの？",
            "zh": "……不对，那不可能吧？\n你出过\n国旅行吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "492/TALK",
            "narrator": "つばめ",
            "text": "な、ないけど…、\n頑張って会いに行くよ！",
            "zh": "没、没有……、\n可我会努力去见你的呀！",
            "narrator_zh": "燕"
        },
        {
            "location": "493/TALK",
            "narrator": "ガブリエラ",
            "text": "まったく信用できないん\nだけど…。",
            "zh": "根本就\n信不过……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "494/TALK",
            "narrator": "ガブリエラ",
            "text": "ていうか、考え事の\n答えは出たの？",
            "zh": "话说，想的事情\n有答案了吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "496/TALK",
            "narrator": "つばめ",
            "text": "うん…ガブちゃんの\nおかげだよ。",
            "zh": "嗯……多亏了\n加布呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "497/TALK",
            "narrator": "つばめ",
            "text": "わたしは、ガブちゃん達や\nひなこちゃん達のこと、\n本当に信じてる。",
            "zh": "我，对加布你们，\n还有小雏她们，\n是真的相信的。",
            "narrator_zh": "燕"
        },
        {
            "location": "498/TALK",
            "narrator": "つばめ",
            "text": "だから、もしバラバラに\nなったとしても、気持ちは\n繋がってると思う。",
            "zh": "所以，就算分开了，\n心情也\n还连在一起，我是这么想的。",
            "narrator_zh": "燕"
        },
        {
            "location": "499/TALK",
            "narrator": "つばめ",
            "text": "気持ちが繋がってれば…、\nきっと、また会うことは\nできるよね？",
            "zh": "心情要是连着……、\n一定还能再见面\n的吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "500/TALK",
            "narrator": "ガブリエラ",
            "text": "繋がってないよりかは\n可能性あるんじゃない？",
            "zh": "比起没连着，\n总有可能吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "501/TALK",
            "narrator": "つばめ",
            "text": "うん…そうだよね…。",
            "zh": "嗯……是呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "502/TALK",
            "narrator": "ガブリエラ",
            "text": "まったく…暗かったり、\n急に元気になったり、\n落ち着かないんだから…。",
            "zh": "真是的……一会儿消沉，\n一会儿突然有精神，\n安分一点行不行……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "503/TALK",
            "narrator": "つばめ",
            "text": "えへへ…。",
            "zh": "诶嘿嘿……。",
            "narrator_zh": "燕"
        },
        {
            "location": "504/TALK",
            "narrator": "つばめ",
            "text": "気持ちが繋がってれば、\nまた会える、か…。",
            "zh": "心情要是连着，\n就能再见面，吗……。",
            "narrator_zh": "燕"
        },
        {
            "location": "506/TALK",
            "narrator": "つばめ",
            "text": "…ねえ、ガブちゃん。",
            "zh": "……我说，加布。",
            "narrator_zh": "燕"
        },
        {
            "location": "507/TALK",
            "narrator": "つばめ",
            "text": "神楽ちゃんの気持ちは、\nわたし達と繋がってると\n思う？",
            "zh": "神乐的心情，\n跟我们还连着，\n你觉得吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "508/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "509/TALK",
            "narrator": "つばめ",
            "text": "わたしは、今でも\n神楽ちゃんのことを\n信じてるよ。",
            "zh": "我到现在\n也还相信\n神乐呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "510/TALK",
            "narrator": "つばめ",
            "text": "きっとまた仲良くなれて、\n一緒にいられるように\nなる、って…。",
            "zh": "一定还能和好，\n还能在一起\n的……。",
            "narrator_zh": "燕"
        },
        {
            "location": "511/TALK",
            "narrator": "つばめ",
            "text": "どうかな？\n神楽ちゃんも、\n思ってくれてるかな？",
            "zh": "怎么样呀？\n神乐，\n也会这么想吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "513/TALK",
            "narrator": "ガブリエラ",
            "text": "…知らないわよ、\nあんな奴のことなんて。",
            "zh": "……我才不管，\n那种人的事。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "517/TALK",
            "narrator": "つばめ",
            "text": "あっ…。",
            "zh": "啊……。",
            "narrator_zh": "燕"
        },
        {
            "location": "519/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "520/TALK",
            "narrator": "つばめ",
            "text": "今のは…わたしが\nいけなかったよね…。",
            "zh": "刚才那句……是我\n不好吧……。",
            "narrator_zh": "燕"
        },
        {
            "location": "521/ACT",
            "narrator": "",
            "text": "嫌な予感がするよ",
            "zh": "有种不祥的预感哦",
            "narrator_zh": ""
        },
        {
            "location": "533/TALK",
            "narrator": "つばめ",
            "text": "嫌な予感？(･Д･｀)",
            "zh": "不祥的预感？(･Д･｀)",
            "narrator_zh": "燕"
        },
        {
            "location": "534/TALK",
            "narrator": "つばめ",
            "text": "それ",
            "zh": "那是",
            "narrator_zh": "燕"
        },
        {
            "location": "535/TALK",
            "narrator": "つばめ",
            "text": "どんなの？(´・ω・｀)",
            "zh": "什么样的呀？(´・ω・｀)",
            "narrator_zh": "燕"
        },
        {
            "location": "537/SEL",
            "narrator": "",
            "text": "管理庁が何かしてくるかも",
            "zh": "管理厅也许会搞出什么来",
            "narrator_zh": ""
        },
        {
            "location": "538/ACT",
            "narrator": "",
            "text": "管理庁が何かしてくるかも",
            "zh": "管理厅也许会搞出什么来",
            "narrator_zh": ""
        },
        {
            "location": "540/TALK",
            "narrator": "つばめ",
            "text": "どぅかな？",
            "zh": "会吗呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "541/TALK",
            "narrator": "つばめ",
            "text": "さすがに",
            "zh": "再怎么说",
            "narrator_zh": "燕"
        },
        {
            "location": "542/TALK",
            "narrator": "つばめ",
            "text": "なぃと思ぅけど(´ｪ｀；)三(；´ｪ｀)",
            "zh": "应该不会吧(´ｪ｀；)三(；´ｪ｀)",
            "narrator_zh": "燕"
        },
        {
            "location": "543/TALK",
            "narrator": "つばめ",
            "text": "だって",
            "zh": "因为",
            "narrator_zh": "燕"
        },
        {
            "location": "544/TALK",
            "narrator": "つばめ",
            "text": "神楽ちゃんがヽ(･ω･ )ゝ☆",
            "zh": "有神乐在ヽ(･ω･ )ゝ☆",
            "narrator_zh": "燕"
        },
        {
            "location": "547/TALK",
            "narrator": "つばめ",
            "text": "ぅぅん",
            "zh": "唔……",
            "narrator_zh": "燕"
        },
        {
            "location": "548/TALK",
            "narrator": "つばめ",
            "text": "なんでもなぃ(o´Д`)=з",
            "zh": "没什么呀(o´Д`)=з",
            "narrator_zh": "燕"
        },
        {
            "location": "549/TALK",
            "narrator": "つばめ",
            "text": "ごめんね",
            "zh": "对不起呀",
            "narrator_zh": "燕"
        },
        {
            "location": "550/TALK",
            "narrator": "つばめ",
            "text": "また後でね",
            "zh": "待会见哦",
            "narrator_zh": "燕"
        },
        {
            "location": "557/TALK",
            "narrator": "つばめ",
            "text": "…神楽ちゃんがいるから、\n管理庁に何かさせたりは\nしないはず…。",
            "zh": "……因为有神乐在，\n应该不会让管理厅\n搞出什么……。",
            "narrator_zh": "燕"
        },
        {
            "location": "559/TALK",
            "narrator": "つばめ",
            "text": "なんて…そんなこと\n思ったなんて、\nさすがに言えないよね。",
            "zh": "什么的……居然\n会这么想，\n果然说不出口呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "560/TALK",
            "narrator": "つばめ",
            "text": "そんなこと言ったら、\n絶対に怒られちゃうし…。",
            "zh": "要是说了那种话，\n绝对会被骂的……。",
            "narrator_zh": "燕"
        },
        {
            "location": "562/TALK",
            "narrator": "雛",
            "text": "つばめちゃん、大丈夫？",
            "zh": "燕，没事吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "565/TALK",
            "narrator": "つばめ",
            "text": "う、うん、大丈夫…。",
            "zh": "嗯、嗯，没事……。",
            "narrator_zh": "燕"
        },
        {
            "location": "566/TALK",
            "narrator": "つばめ",
            "text": "でも、キリトくん達\n授業にも出れないくらい\n忙しいなんて、大変だね。",
            "zh": "可是，圣翔他们\n忙到连课都上不了，\n真不容易呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "567/TALK",
            "narrator": "繭",
            "text": "キリト達だけじゃない。\n私達だって、段々と\n忙しくなるから。",
            "zh": "不只是圣翔他们。\n我们也会，渐渐\n忙起来的。",
            "narrator_zh": "茧"
        },
        {
            "location": "568/TALK",
            "narrator": "繭",
            "text": "うちは特殊な学校だから、\n普通のところに比べて、\n学ぶことも多いし…。",
            "zh": "我们学校很特殊，\n比起普通的地方，\n要学的也多……。",
            "narrator_zh": "茧"
        },
        {
            "location": "310/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>9月2日　 4:05 PM</color>\nとある平日の放課後、付属学園つばめの教室にて",
            "zh": "<color=green>9月2日　 4:05 PM</color>\n某个工作日的放学后，在附属学园燕的教室。",
            "narrator_zh": "Dialog_EventData"
        }
    ]
}
