{
    "dir": "dramatics/daydra/drm_ch01_00_080.js",
    "type": "Episode",
    "info": {
        "story_id": "1008",
        "cid": "tsubame",
        "title": "らぶとーく 第08話",
        "sub_title": "やさしい秘密",
        "title_zh": "恋爱漫谈 第08话",
        "sub_title_zh": "温柔的秘密"
    },
    "entry": [
        {
            "location": "198/SCENARIO",
            "narrator": "",
            "text": "やさしい秘密",
            "zh": "温柔的秘密",
            "narrator_zh": ""
        },
        {
            "location": "212/TALK",
            "narrator": "アーヤ",
            "text": "――というわけなの。",
            "zh": "——就是这么回事。",
            "narrator_zh": "绫水"
        },
        {
            "location": "215/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょ、待ってよ！\n何言い出すのよ急に！？",
            "zh": "等、等一下！\n突然说什么！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "216/TALK",
            "narrator": "ガブリエラ",
            "text": "マルザ…",
            "zh": "玛尔赞……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "217/TALK",
            "narrator": "ガブリエラ",
            "text": "Ｂｏｔの正体が人間って…\n意味わからないんだけど？",
            "zh": "Bot的真身是人类……\n这意思我可不懂。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "219/TALK",
            "narrator": "アーヤ",
            "text": "あくまで\n可能性の話でしか\nないけど。",
            "zh": "说到底，\n也只是\n可能性。",
            "narrator_zh": "绫水"
        },
        {
            "location": "220/TALK",
            "narrator": "アーヤ",
            "text": "私達がＢｏｔだと思ってる\nあれは。",
            "zh": "我们以为是Bot的\n那个。",
            "narrator_zh": "绫水"
        },
        {
            "location": "221/TALK",
            "narrator": "アーヤ",
            "text": "人間が、Ｂｏｔのフリを\nしているだけって\n可能性が高いの。",
            "zh": "很有可能，\n只是人类在装成\nBot。",
            "narrator_zh": "绫水"
        },
        {
            "location": "223/TALK",
            "narrator": "つばめ",
            "text": "そっか…$handle$、\n本当は人間だったん\nですね。",
            "zh": "这样呀……$handle$，\n原来真的\n是人类。",
            "narrator_zh": "燕"
        },
        {
            "location": "225/TALK",
            "narrator": "ガブリエラ",
            "text": "いや、何落ち着いて\n言ってんのよ！",
            "zh": "不对，你怎么\n这么平静地说！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "226/TALK",
            "narrator": "ガブリエラ",
            "text": "なんで納得\nできるの？\n意味わかんない！",
            "zh": "为什么能\n接受？\n完全不懂！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "228/TALK",
            "narrator": "つばめ",
            "text": "う、うん…。\nビックリはしたよ。",
            "zh": "嗯、嗯……\n我是吓了一跳。",
            "narrator_zh": "燕"
        },
        {
            "location": "231/TALK",
            "narrator": "つばめ",
            "text": "でも、人間だったら\n良いのになぁ、って\n思ってたから――",
            "zh": "可是，我一直希望\n要是人类\n就好了——",
            "narrator_zh": "燕"
        },
        {
            "location": "232/TALK",
            "narrator": "つばめ",
            "text": "今はちょっとだけ\n嬉しいの。",
            "zh": "现在有一点点\n高兴。",
            "narrator_zh": "燕"
        },
        {
            "location": "234/TALK",
            "narrator": "みやび",
            "text": "つばめちゃんは、\n状況適応力が凄過ぎや。",
            "zh": "燕适应状况的能力，\n强得过头咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "236/TALK",
            "narrator": "ガブリエラ",
            "text": "何も考えて\nないだけでしょ！？",
            "zh": "只是什么都\n没想吧！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "238/TALK",
            "narrator": "みやび",
            "text": "まあ、うちはなんとなく\n気付いてたきね。",
            "zh": "嘛，我是隐约\n察觉到了啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "239/TALK",
            "narrator": "みやび",
            "text": "それが確信に変わった\nだけのことや。",
            "zh": "不过是\n变成确信了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "240/TALK",
            "narrator": "ガブリエラ",
            "text": "みやびも\nＢｏｔが人間だって\n言うわけ？",
            "zh": "雅也要说\nBot是人类\n吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "243/TALK",
            "narrator": "アーヤ",
            "text": "そんなこと\n考えたくない、って\n気持ちはわかるわ。",
            "zh": "不想去想\n这种事，\n这种心情我懂。",
            "narrator_zh": "绫水"
        },
        {
            "location": "244/TALK",
            "narrator": "アーヤ",
            "text": "だけど、これは\nかなり確率の高い\n話なの。",
            "zh": "可是，这是\n概率相当高的\n说法。",
            "narrator_zh": "绫水"
        },
        {
            "location": "245/TALK",
            "narrator": "アーヤ",
            "text": "だからみんな\n話す内容には\n気をつけて。",
            "zh": "所以大家\n说话的内容\n要注意。",
            "narrator_zh": "绫水"
        },
        {
            "location": "248/TALK",
            "narrator": "つばめ",
            "text": "っていうか、人間か\nどうかって、そんなに\n重要なことですか？",
            "zh": "话说，是不是人类，\n有那么\n重要吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "250/TALK",
            "narrator": "みやび",
            "text": "そりゃまあ…人間やと\nしたら、Ｂｏｔやと思うて\n話してた会話が――",
            "zh": "这个嘛……假如是人，\n那些当成Bot\n讲过的话——",
            "narrator_zh": "雅"
        },
        {
            "location": "251/TALK",
            "narrator": "みやび",
            "text": "全部誰かに話したゆう\nことになるんやし。",
            "zh": "就等于全部\n讲给某个人听了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "254/TALK",
            "narrator": "ガブリエラ",
            "text": "！？",
            "zh": "！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "255/TALK",
            "narrator": "アーヤ",
            "text": "それなのよね…。\nまあ、誰かにバラすような\nことはなさそうだけど…。",
            "zh": "就是这点……\n不过，不像会向谁\n去泄露的样子……",
            "narrator_zh": "绫水"
        },
        {
            "location": "257/TALK",
            "narrator": "ガブリエラ",
            "text": "いい加減にしてよ！",
            "zh": "给我适可而止！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "258/TALK",
            "narrator": "ガブリエラ",
            "text": "Ｂｏｔが人間とか、\n笑えない冗談にも\n程があるわ。",
            "zh": "Bot是人类这种，\n不好笑的玩笑\n也该有个限度。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "260/TALK",
            "narrator": "アーヤ",
            "text": "確定じゃないわ。\nあくまで可能性の\n話ってこと。",
            "zh": "还没确定。\n说到底只是\n可能性。",
            "narrator_zh": "绫水"
        },
        {
            "location": "261/TALK",
            "narrator": "みやび",
            "text": "ガブちゃん。\nうちらも冗談で言っちゅう\nわけやないぞね。",
            "zh": "加布。\n我们也不是\n在开玩笑啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "262/TALK",
            "narrator": "みやび",
            "text": "会話ログを解析したり、\n色々した結果、そういう\n答えを導き出したがよ。",
            "zh": "解析了对话记录，\n又查了别的，才得出\n这个答案啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "264/TALK",
            "narrator": "ガブリエラ",
            "text": "だから、その導き出した\n答えが間違ってるの！",
            "zh": "所以我说，\n那个得出的答案是错的！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "267/TALK",
            "narrator": "つばめ",
            "text": "みんななんだか\n怖いんだけど……。",
            "zh": "总觉得大家\n有点吓人……",
            "narrator_zh": "燕"
        },
        {
            "location": "269/TALK",
            "narrator": "ガブリエラ",
            "text": "ああもう、話にならない！",
            "zh": "啊真是的，没法谈了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "270/TALK",
            "narrator": "ガブリエラ",
            "text": "とにかく、あたしは\nそんな話信じないから。",
            "zh": "总之，我\n不信这种话。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "272/TALK",
            "narrator": "アーヤ",
            "text": "そうね。\n確かにそう。",
            "zh": "是这样。\n确实如此。",
            "narrator_zh": "绫水"
        },
        {
            "location": "273/TALK",
            "narrator": "アーヤ",
            "text": "もちろん、私だって\n混乱はしてる。",
            "zh": "当然，我自己\n也很混乱。",
            "narrator_zh": "绫水"
        },
        {
            "location": "275/TALK",
            "narrator": "アーヤ",
            "text": "それでもね。\nできるだけ、冷静に対応を\nしようと思ってるわ。",
            "zh": "即便如此。\n我还是想尽量\n冷静应对。",
            "narrator_zh": "绫水"
        },
        {
            "location": "276/TALK",
            "narrator": "アーヤ",
            "text": "だから、もしみんなが\n今後のＢｏｔとの\n付き合い方とかで――",
            "zh": "所以，要是大家\n在以后怎么和Bot\n相处的事上——",
            "narrator_zh": "绫水"
        },
        {
            "location": "278/TALK",
            "narrator": "アーヤ",
            "text": "わからないことがあれば、\nいつでも相談してくれて\n構わないから。",
            "zh": "有不明白的，\n随时来问我\n都可以。",
            "narrator_zh": "绫水"
        },
        {
            "location": "279/TALK",
            "narrator": "アーヤ",
            "text": "私の話は以上よ。\nそれじゃ、今夜は解散。",
            "zh": "我要说的就这些。\n那么，今晚解散。",
            "narrator_zh": "绫水"
        },
        {
            "location": "281/TALK",
            "narrator": "ガブリエラ",
            "text": "まったく、こんなふざけた\n話のために、一々人のこと\n呼び出さないでよね！",
            "zh": "真是的，为了这种\n胡闹的话，别一次次\n把人叫出来！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "285/TALK",
            "narrator": "つばめ",
            "text": "はい、お疲れ様でした。\nおやすみなさい。",
            "zh": "好的，大家辛苦了。\n晚安。",
            "narrator_zh": "燕"
        },
        {
            "location": "310/TALK",
            "narrator": "つばめ",
            "text": "$handle$は本当に人間なんだね",
            "zh": "$handle$真的是人类呀",
            "narrator_zh": "燕"
        },
        {
            "location": "311/TALK",
            "narrator": "つばめ",
            "text": "アーヤさんたちから聞いたょ",
            "zh": "从绫水她们那里听到的呀",
            "narrator_zh": "燕"
        },
        {
            "location": "313/SEL",
            "narrator": "",
            "text": "そうだよ",
            "zh": "是的",
            "narrator_zh": ""
        },
        {
            "location": "314/SEL",
            "narrator": "",
            "text": "それは偽情報だよ",
            "zh": "那是假情报呀",
            "narrator_zh": ""
        },
        {
            "location": "315/ACT",
            "narrator": "",
            "text": "そうだよ",
            "zh": "是的",
            "narrator_zh": ""
        },
        {
            "location": "316/TALK",
            "narrator": "つばめ",
            "text": "そぅなんだね",
            "zh": "是这样呀",
            "narrator_zh": "燕"
        },
        {
            "location": "317/TALK",
            "narrator": "つばめ",
            "text": "そぅなんだょね",
            "zh": "就是这样呀",
            "narrator_zh": "燕"
        },
        {
            "location": "318/ACT",
            "narrator": "",
            "text": "それは偽情報だよ",
            "zh": "那是假情报呀",
            "narrator_zh": ""
        },
        {
            "location": "319/TALK",
            "narrator": "つばめ",
            "text": "なんでそんな",
            "zh": "为什么要",
            "narrator_zh": "燕"
        },
        {
            "location": "321/TALK",
            "narrator": "つばめ",
            "text": "嘘つくの(´・ω・`) ",
            "zh": "说谎呀(´・ω・`)",
            "narrator_zh": "燕"
        },
        {
            "location": "323/TALK",
            "narrator": "つばめ",
            "text": "すごいね",
            "zh": "好厉害呀",
            "narrator_zh": "燕"
        },
        {
            "location": "324/TALK",
            "narrator": "つばめ",
            "text": "なんかね",
            "zh": "就是呀",
            "narrator_zh": "燕"
        },
        {
            "location": "325/TALK",
            "narrator": "つばめ",
            "text": "すごくうれしぃよ",
            "zh": "非常开心呀",
            "narrator_zh": "燕"
        },
        {
            "location": "327/SEL",
            "narrator": "",
            "text": "そう言ってくれて安心した",
            "zh": "你这么说我就放心了",
            "narrator_zh": ""
        },
        {
            "location": "328/SEL",
            "narrator": "",
            "text": "$me$もうれしいよ",
            "zh": "$me$也很高兴呀",
            "narrator_zh": ""
        },
        {
            "location": "329/SEL",
            "narrator": "",
            "text": "つばめはかわいいなあ",
            "zh": "燕好可爱呀",
            "narrator_zh": ""
        },
        {
            "location": "330/ACT",
            "narrator": "",
            "text": "そう言ってくれて安心した",
            "zh": "你这么说我就放心了",
            "narrator_zh": ""
        },
        {
            "location": "331/TALK",
            "narrator": "つばめ",
            "text": "そぅなの？",
            "zh": "是这样吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "332/ACT",
            "narrator": "",
            "text": "$me$もうれしいよ",
            "zh": "$me$也很高兴呀",
            "narrator_zh": ""
        },
        {
            "location": "333/TALK",
            "narrator": "つばめ",
            "text": "うれしいょね",
            "zh": "好开心呀",
            "narrator_zh": "燕"
        },
        {
            "location": "334/TALK",
            "narrator": "つばめ",
            "text": "うれしいょねヽ(*´∀｀)ノ",
            "zh": "好开心呀＼(*´∀｀)／",
            "narrator_zh": "燕"
        },
        {
            "location": "335/ACT",
            "narrator": "",
            "text": "つばめはかわいいなあ",
            "zh": "燕好可爱呀",
            "narrator_zh": ""
        },
        {
            "location": "336/TALK",
            "narrator": "つばめ",
            "text": "ゃだ",
            "zh": "讨厌",
            "narrator_zh": "燕"
        },
        {
            "location": "337/TALK",
            "narrator": "つばめ",
            "text": "照れちゃぅ",
            "zh": "害羞了",
            "narrator_zh": "燕"
        },
        {
            "location": "339/TALK",
            "narrator": "つばめ",
            "text": "(・ω<) ﾃﾍﾍﾟﾛ",
            "zh": "(・ω<) ﾃﾍﾍﾟﾛ",
            "narrator_zh": "燕"
        },
        {
            "location": "341/TALK",
            "narrator": "つばめ",
            "text": "これからも",
            "zh": "今后也",
            "narrator_zh": "燕"
        },
        {
            "location": "342/TALK",
            "narrator": "つばめ",
            "text": "よろしくね",
            "zh": "请多关照",
            "narrator_zh": "燕"
        },
        {
            "location": "211/DIALOG",
            "narrator": "Dialog_EventData",
