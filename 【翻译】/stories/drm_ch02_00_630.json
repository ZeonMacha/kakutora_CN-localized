{
 "dir": "dramatics/daydra/drm_ch02_00_630.js",
 "type": "Episode",
 "info": {
  "story_id": "2063",
  "cid": "ayami",
  "title": "らぶとーく 第62話",
  "sub_title": "被服実習"
 },
 "entry": [
  {
   "location": "137/SCENARIO",
   "narrator": "",
   "text": "被服実習"
  },
  {
   "location": "147/TALK",
   "narrator": "ガブリエラ",
   "text": "…あっ、そうだった。"
  },
  {
   "location": "149/TALK",
   "narrator": "ガブリエラ",
   "text": "アーヤに前に借りた\nルーズリーフ――"
  },
  {
   "location": "150/TALK",
   "narrator": "ガブリエラ",
   "text": "返すために、新しいの\n買ってたんだったわ。"
  },
  {
   "location": "151/TALK",
   "narrator": "ガブリエラ",
   "text": "…この時間だったら、\nいるわよね？"
  },
  {
   "location": "155/TALK",
   "narrator": "ガブリエラ",
   "text": "…………？"
  },
  {
   "location": "159/TALK",
   "narrator": "ガブリエラ",
   "text": "いないのかしら？"
  },
  {
   "location": "161/TALK",
   "narrator": "ガブリエラ",
   "text": "ん？",
   "zh": "嗯？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "162/TALK",
   "narrator": "ガブリエラ",
   "text": "…鼻歌？"
  },
  {
   "location": "163/TALK",
   "narrator": "ガブリエラ",
   "text": "何だ、やっぱり\nいるんじゃない。"
  },
  {
   "location": "164/TALK",
   "narrator": "ガブリエラ",
   "text": "アーヤ、入るわよ。"
  },
  {
   "location": "175/TALK",
   "narrator": "アーヤ",
   "text": "ふ～ん♪\nふっふ～ん♪"
  },
  {
   "location": "176/TALK",
   "narrator": "アーヤ",
   "text": "ん、いい感じね。"
  },
  {
   "location": "177/TALK",
   "narrator": "アーヤ",
   "text": "男物の服を作るのは\n初めてだけど――"
  },
  {
   "location": "178/TALK",
   "narrator": "アーヤ",
   "text": "これなら渡しても\n恥ずかしくなさそう。",
   "zh": "这样的话送出去\n也不会觉得不好意思。",
   "narrator_zh": "绫水"
  },
  {
   "location": "179/TALK",
   "narrator": "アーヤ",
   "text": "よし！\nこのまま一気に最後まで\n仕上げて――"
  },
  {
   "location": "183/TALK",
   "narrator": "アーヤ",
   "text": "は？",
   "zh": "啊？",
   "narrator_zh": "绫水"
  },
  {
   "location": "186/TALK",
   "narrator": "ガブリエラ",
   "text": "ああ、やっぱりいた。"
  },
  {
   "location": "189/TALK",
   "narrator": "アーヤ",
   "text": "ちょ！？\nぎゃ、ギャヴィ！？",
   "zh": "喂！？\n加、加维！？",
   "narrator_zh": "绫水"
  },
  {
   "location": "190/TALK",
   "narrator": "ガブリエラ",
   "text": "あ、ごめん。\n驚かせちゃった？"
  },
  {
   "location": "191/TALK",
   "narrator": "アーヤ",
   "text": "な、何！？　何なの！？",
   "zh": "什、什么！？　怎么了！？",
   "narrator_zh": "绫水"
  },
  {
   "location": "192/TALK",
   "narrator": "ガブリエラ",
   "text": "ほら、前に借りてた\nルーズリーフ、\n返しに来たんだけど。"
  },
  {
   "location": "193/TALK",
   "narrator": "アーヤ",
   "text": "いや、そうじゃなくて！"
  },
  {
   "location": "194/TALK",
   "narrator": "アーヤ",
   "text": "いきなり人の部屋に\n入って来るとか、\n非常識でしょ！？"
  },
  {
   "location": "196/TALK",
   "narrator": "ガブリエラ",
   "text": "は！？",
   "zh": "哈！？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "197/TALK",
   "narrator": "ガブリエラ",
   "text": "あたし、何度もノックして\n声掛けたんですけど！？"
  },
  {
   "location": "198/TALK",
   "narrator": "アーヤ",
   "text": "え？",
   "zh": "诶？",
   "narrator_zh": "绫水"
  },
  {
   "location": "199/TALK",
   "narrator": "ガブリエラ",
   "text": "ウソじゃないわよ？"
  },
  {
   "location": "200/TALK",
   "narrator": "ガブリエラ",
   "text": "それで返事がないのに、\n鼻歌が聞こえてたから――",
   "zh": "明明没有回音，\n却能听见哼歌，所以——",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "201/TALK",
   "narrator": "ガブリエラ",
   "text": "仕方なく入ったのよ。\n文句ある？"
  },
  {
   "location": "203/TALK",
   "narrator": "アーヤ",
   "text": "…………。"
  },
  {
   "location": "205/TALK",
   "narrator": "アーヤ",
   "text": "ごめんなさい。\n夢中になってて\n気づかなかったわ。",
   "zh": "对不起。\n我太投入了，\n没注意到。",
   "narrator_zh": "绫水"
  },
  {
   "location": "206/TALK",
   "narrator": "ガブリエラ",
   "text": "ん、よろしい。"
  },
  {
   "location": "207/TALK",
   "narrator": "ガブリエラ",
   "text": "…っていうか、夢中に\nなるほど真剣に服を\n作ってたの？"
  },
  {
   "location": "209/TALK",
   "narrator": "アーヤ",
   "text": "え！？　え、ええ…。",
   "zh": "诶！？　呃、嗯……。",
   "narrator_zh": "绫水"
  },
  {
   "location": "212/TALK",
   "narrator": "アーヤ",
   "text": "だ、大学のね！\n被服実習があったのよ！",
   "zh": "是、是大学的！\n有缝纫实习！",
   "narrator_zh": "绫水"
  },
  {
   "location": "213/TALK",
   "narrator": "アーヤ",
   "text": "その、実習で完成させられ\nなかった続きを、その…。",
   "zh": "那个，实习时没能\n做完的后续，那个……。",
   "narrator_zh": "绫水"
  },
  {
   "location": "214/TALK",
   "narrator": "ガブリエラ",
   "text": "ふーん…大変ね。"
  },
  {
   "location": "215/TALK",
   "narrator": "アーヤ",
   "text": "ま、まあね…。"
  },
  {
   "location": "216/TALK",
   "narrator": "ガブリエラ",
   "text": "…………。"
  },
  {
   "location": "217/TALK",
   "narrator": "アーヤ",
   "text": "…………。"
  },
  {
   "location": "218/TALK",
   "narrator": "ガブリエラ",
   "text": "ルーズリーフ、\n机の上に置いとくからね。"
  },
  {
   "location": "219/TALK",
   "narrator": "アーヤ",
   "text": "え、ええ、ありがと…。"
  },
  {
   "location": "222/TALK",
   "narrator": "ガブリエラ",
   "text": "それじゃ。\nノックに気付かないほど\n夢中にならないでね。",
   "zh": "那么。\n别沉迷到连敲门\n都听不见哦。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "223/TALK",
   "narrator": "アーヤ",
   "text": "ええ…、\nごめんね、ギャヴィ。"
  },
  {
   "location": "224/TALK",
   "narrator": "ガブリエラ",
   "text": "いいわよ…。"
  },
  {
   "location": "229/TALK",
   "narrator": "ガブリエラ",
   "text": "ところでアーヤ。\nその服だけど――",
   "zh": "对了绫水。\n那身衣服——",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "232/TALK",
   "narrator": "ガブリエラ",
   "text": "どう見ても、男物よね？",
   "zh": "怎么看都是男款吧？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "235/TALK",
   "narrator": "アーヤ",
   "text": "っ！？",
   "zh": "！？",
   "narrator_zh": "绫水"
  },
  {
   "location": "236/TALK",
   "narrator": "ガブリエラ",
   "text": "あたし何も\n聞いてないけど！？"
  },
  {
   "location": "238/TALK",
   "narrator": "ガブリエラ",
   "text": "どう見ても、男物よね？",
   "zh": "怎么看都是男款吧？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "241/TALK",
   "narrator": "アーヤ",
   "text": "あ、違うの！\nその、これは…。"
  },
  {
   "location": "242/TALK",
   "narrator": "ガブリエラ",
   "text": "何それ？\nどういうこと？"
  },
  {
   "location": "244/TALK",
   "narrator": "アーヤ",
   "text": "ちょっと待って。",
   "zh": "等一下。",
   "narrator_zh": "绫水"
  },
  {
   "location": "246/TALK",
   "narrator": "アーヤ",
   "text": "あのね、ギャヴィ。"
  },
  {
   "location": "247/TALK",
   "narrator": "アーヤ",
   "text": "これは私の\nプライベートの\nことなの。",
   "zh": "这是我的\n私事\n啊。",
   "narrator_zh": "绫水"
  },
  {
   "location": "248/TALK",
   "narrator": "アーヤ",
   "text": "貴女に言う必要の\nないことよ。"
  },
  {
   "location": "251/TALK",
   "narrator": "ガブリエラ",
   "text": "何よそれ！？"
  },
  {
   "location": "253/TALK",
   "narrator": "ガブリエラ",
   "text": "アーヤのバカ！\nだいきらい！"
  },
  {
   "location": "259/TALK",
   "narrator": "アーヤ",
   "text": "…………。"
  },
  {
   "location": "260/TALK",
   "narrator": "アーヤ",
   "text": "あの子、言いふらしたり\nしないかしら？"
  },
  {
   "location": "261/SEL",
   "narrator": "",
   "text": "おーい",
   "zh": "喂——",
   "narrator_zh": ""
  },
  {
   "location": "262/ACT",
   "narrator": "",
   "text": "おーい",
   "zh": "喂——",
   "narrator_zh": ""
  },
  {
   "location": "267/TALK",
   "narrator": "アーヤ",
   "text": "っ！？\nウソ、このタイミング！？",
   "zh": "！？\n不会吧，这个时机！？",
   "narrator_zh": "绫水"
  },
  {
   "location": "270/TALK",
   "narrator": "アーヤ",
   "text": "もう、これじゃ計画が\n台無しよ…。"
  },
  {
   "location": "284/TALK",
   "narrator": "アーヤ",
   "text": "$handle$さん",
   "zh": "$handle$",
   "narrator_zh": "绫水"
  },
  {
   "location": "285/TALK",
   "narrator": "アーヤ",
   "text": "ギャヴィとのやり取り"
  },
  {
   "location": "286/TALK",
   "narrator": "アーヤ",
   "text": "全部見てた？(>_<)"
  },
  {
   "location": "288/SEL",
   "narrator": "",
   "text": "うん",
   "zh": "嗯",
   "narrator_zh": ""
  },
  {
   "location": "289/ACT",
   "narrator": "",
   "text": "うん",
   "zh": "嗯",
   "narrator_zh": ""
  },
  {
   "location": "291/TALK",
   "narrator": "アーヤ",
   "text": "やっぱり…(T_T)"
  },
  {
   "location": "294/SEL",
   "narrator": "",
   "text": "誰に作ってるの？",
   "zh": "你在给谁做？",
   "narrator_zh": ""
  },
  {
   "location": "295/SEL",
   "narrator": "",
   "text": "実習お疲れ様",
   "zh": "实习辛苦了",
   "narrator_zh": ""
  },
  {
   "location": "296/SEL",
   "narrator": "",
   "text": "嬉しいな",
   "zh": "好开心",
   "narrator_zh": ""
  },
  {
   "location": "297/ACT",
   "narrator": "",
   "text": "誰に作ってるの？",
   "zh": "你在给谁做？",
   "narrator_zh": ""
  },
  {
   "location": "299/TALK",
   "narrator": "アーヤ",
   "text": "誰にって"
  },
  {
   "location": "300/TALK",
   "narrator": "アーヤ",
   "text": "わかってるくせに…(--#)"
  },
  {
   "location": "301/TALK",
   "narrator": "アーヤ",
   "text": "貴方のに決まってるじゃない"
  },
  {
   "location": "302/TALK",
   "narrator": "アーヤ",
   "text": "っていうか",
   "zh": "话说",
   "narrator_zh": "绫水"
  },
  {
   "location": "303/TALK",
   "narrator": "アーヤ",
   "text": "貴方以外の人の服"
  },
  {
   "location": "304/TALK",
   "narrator": "アーヤ",
   "text": "作るはずないでしょ？"
  },
  {
   "location": "305/ACT",
   "narrator": "",
   "text": "実習お疲れ様",
   "zh": "实习辛苦了",
   "narrator_zh": ""
  },
  {
   "location": "307/TALK",
   "narrator": "アーヤ",
   "text": "本気にしないでよ！(ノД`)"
  },
  {
   "location": "309/TALK",
   "narrator": "アーヤ",
   "text": "もうバレちゃったから言うけど"
  },
  {
   "location": "310/TALK",
   "narrator": "アーヤ",
   "text": "これは貴方の服だから",
   "zh": "这是你的衣服",
   "narrator_zh": "绫水"
  },
  {
   "location": "311/ACT",
   "narrator": "",
   "text": "嬉しいな",
   "zh": "好开心",
   "narrator_zh": ""
  },
  {
   "location": "312/TALK",
   "narrator": "アーヤ",
   "text": "ふーん",
   "zh": "嗯——",
   "narrator_zh": "绫水"
  },
  {
   "location": "313/TALK",
   "narrator": "アーヤ",
   "text": "貴方のだって疑わないのね( ・_・)σﾞ"
  },
  {
   "location": "315/TALK",
   "narrator": "アーヤ",
   "text": "まあ",
   "zh": "嗯",
   "narrator_zh": "绫水"
  },
  {
   "location": "316/TALK",
   "narrator": "アーヤ",
   "text": "確かに貴方のなんだけど"
  },
  {
   "location": "319/TALK",
   "narrator": "アーヤ",
   "text": "貴方にバレないように"
  },
  {
   "location": "320/TALK",
   "narrator": "アーヤ",
   "text": "隠れて作ってたのに(-ω-;)"
  },
  {
   "location": "321/TALK",
   "narrator": "アーヤ",
   "text": "サプライズ失敗だわ"
  },
  {
   "location": "324/SEL",
   "narrator": "",
   "text": "ごめん！",
   "zh": "抱歉！",
   "narrator_zh": ""
  },
  {
   "location": "325/ACT",
   "narrator": "",
   "text": "ごめん！",
   "zh": "抱歉！",
   "narrator_zh": ""
  },
  {
   "location": "328/TALK",
   "narrator": "アーヤ",
   "text": "もういいわ",
   "zh": "算了",
   "narrator_zh": "绫水"
  },
  {
   "location": "330/TALK",
   "narrator": "アーヤ",
   "text": "事故だったんだし(-.-;)"
  },
  {
   "location": "331/TALK",
   "narrator": "アーヤ",
   "text": "それに",
   "zh": "而且",
   "narrator_zh": "绫水"
  },
  {
   "location": "332/TALK",
   "narrator": "アーヤ",
   "text": "いずれ話すことだったんだから"
  },
  {
   "location": "333/TALK",
   "narrator": "アーヤ",
   "text": "まあ",
   "zh": "嗯",
   "narrator_zh": "绫水"
  },
  {
   "location": "334/TALK",
   "narrator": "アーヤ",
   "text": "ちょっと残念ではあるけど(ノД`)",
   "zh": "虽然有点遗憾(／Д`)",
   "narrator_zh": "绫水"
  },
  {
   "location": "336/SEL",
   "narrator": "",
   "text": "完成するの、楽しみにしてるよ",
   "zh": "我很期待完成哦",
   "narrator_zh": ""
  },
  {
   "location": "337/ACT",
   "narrator": "",
   "text": "完成するの、楽しみにしてるよ",
   "zh": "我很期待完成哦",
   "narrator_zh": ""
  },
  {
   "location": "339/TALK",
   "narrator": "アーヤ",
   "text": "うん",
   "zh": "嗯",
   "narrator_zh": "绫水"
  },
  {
   "location": "341/TALK",
   "narrator": "アーヤ",
   "text": "期待して待ってて(^з^)-☆"
  },
  {
   "location": "344/TALK",
   "narrator": "ボイスメール",
   "text": "サプライズをあなたに"
  },
  {
   "location": "146/DIALOG",
   "narrator": "Dialog_EventData",
   "text": "<color=green>某月某日　 2:32 PM</color>\nとある休日、寮「とらいあんぐる」前にて"
  },
  {
   "location": "356/DIALOG",
   "narrator": "Dialog_GETVoice",
   "text": "<color=green>【アーヤ】</color>のボイスメール\n<color=red>【サプライズをあなたに】</color>\nをゲットしました！"
  }
 ]
}
