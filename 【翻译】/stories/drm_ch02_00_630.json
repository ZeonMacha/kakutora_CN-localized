        "title": "らぶとーく 第62話",
        "sub_title": "被服実習",
        "title_zh": "恋爱漫谈 第62话",
        "sub_title_zh": "缝纫实习"
    },
    "entry": [
        {
            "location": "137/SCENARIO",
            "narrator": "",
            "text": "被服実習",
            "zh": "缝纫实习",
            "narrator_zh": ""
        },
        {
            "location": "147/TALK",
            "narrator": "ガブリエラ",
            "text": "…あっ、そうだった。",
            "zh": "…啊，对了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "149/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤに前に借りた\nルーズリーフ――",
            "zh": "之前跟绫水借的\n活页纸——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "150/TALK",
            "narrator": "ガブリエラ",
            "text": "返すために、新しいの\n買ってたんだったわ。",
            "zh": "为了还她，买了新的\n来着。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "151/TALK",
            "narrator": "ガブリエラ",
            "text": "…この時間だったら、\nいるわよね？",
            "zh": "…这个时间的话，\n她应该在吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "155/TALK",
            "narrator": "ガブリエラ",
            "text": "…………？",
            "zh": "…………？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "159/TALK",
            "narrator": "ガブリエラ",
            "text": "いないのかしら？",
            "zh": "不在吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "161/TALK",
            "narrator": "ガブリエラ",
            "text": "ん？",
            "zh": "嗯？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "162/TALK",
            "narrator": "ガブリエラ",
            "text": "…鼻歌？",
            "zh": "…哼歌声？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "163/TALK",
            "narrator": "ガブリエラ",
            "text": "何だ、やっぱり\nいるんじゃない。",
            "zh": "什么嘛，果然\n在啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "164/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤ、入るわよ。",
            "zh": "绫水，我进来咯。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "175/TALK",
            "narrator": "アーヤ",
            "text": "ふ～ん♪\nふっふ～ん♪",
            "zh": "哼～♪\n哼哼～♪",
            "narrator_zh": "绫水"
        },
        {
            "location": "176/TALK",
            "narrator": "アーヤ",
            "text": "ん、いい感じね。",
            "zh": "嗯，感觉不错呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "177/TALK",
            "narrator": "アーヤ",
            "text": "男物の服を作るのは\n初めてだけど――",
            "zh": "虽然是第一次做\n男装——",
            "narrator_zh": "绫水"
        },
        {
            "location": "178/TALK",
            "narrator": "アーヤ",
            "text": "これなら渡しても\n恥ずかしくなさそう。",
            "zh": "这样的话送出去\n也不会觉得不好意思。",
            "narrator_zh": "绫水"
        },
        {
            "location": "179/TALK",
            "narrator": "アーヤ",
            "text": "よし！\nこのまま一気に最後まで\n仕上げて――",
            "zh": "好！\n就这样一口气做到\n最后——",
            "narrator_zh": "绫水"
        },
        {
            "location": "183/TALK",
            "narrator": "アーヤ",
            "text": "は？",
            "zh": "啊？",
            "narrator_zh": "绫水"
        },
        {
            "location": "186/TALK",
            "narrator": "ガブリエラ",
            "text": "ああ、やっぱりいた。",
            "zh": "啊，果然在。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "189/TALK",
            "narrator": "アーヤ",
            "text": "ちょ！？\nぎゃ、ギャヴィ！？",
            "zh": "喂！？\n加、加维！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "190/TALK",
            "narrator": "ガブリエラ",
            "text": "あ、ごめん。\n驚かせちゃった？",
            "zh": "啊，抱歉。\n吓到你了？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "191/TALK",
            "narrator": "アーヤ",
            "text": "な、何！？　何なの！？",
            "zh": "什、什么！？　怎么了！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "192/TALK",
            "narrator": "ガブリエラ",
            "text": "ほら、前に借りてた\nルーズリーフ、\n返しに来たんだけど。",
            "zh": "喏，之前借的\n活页纸，\n我来还的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "193/TALK",
            "narrator": "アーヤ",
            "text": "いや、そうじゃなくて！",
            "zh": "不，不是那个问题！",
            "narrator_zh": "绫水"
        },
        {
            "location": "194/TALK",
            "narrator": "アーヤ",
            "text": "いきなり人の部屋に\n入って来るとか、\n非常識でしょ！？",
            "zh": "随便就闯进\n别人房间，\n太没常识了吧！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "196/TALK",
            "narrator": "ガブリエラ",
            "text": "は！？",
            "zh": "哈！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "197/TALK",
            "narrator": "ガブリエラ",
            "text": "あたし、何度もノックして\n声掛けたんですけど！？",
            "zh": "我敲了好几次门\n还出声叫了你！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "198/TALK",
            "narrator": "アーヤ",
            "text": "え？",
            "zh": "诶？",
            "narrator_zh": "绫水"
        },
        {
            "location": "199/TALK",
            "narrator": "ガブリエラ",
            "text": "ウソじゃないわよ？",
            "zh": "我没骗你哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "200/TALK",
            "narrator": "ガブリエラ",
            "text": "それで返事がないのに、\n鼻歌が聞こえてたから――",
            "zh": "明明没有回音，\n却能听见哼歌，所以——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "201/TALK",
            "narrator": "ガブリエラ",
            "text": "仕方なく入ったのよ。\n文句ある？",
            "zh": "我是没办法才进去的。\n有意见？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "203/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "205/TALK",
            "narrator": "アーヤ",
            "text": "ごめんなさい。\n夢中になってて\n気づかなかったわ。",
            "zh": "对不起。\n我太投入了，\n没注意到。",
            "narrator_zh": "绫水"
        },
        {
            "location": "206/TALK",
            "narrator": "ガブリエラ",
            "text": "ん、よろしい。",
            "zh": "嗯，很好。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "207/TALK",
            "narrator": "ガブリエラ",
            "text": "…っていうか、夢中に\nなるほど真剣に服を\n作ってたの？",
            "zh": "…话说，你有认真到\n做衣服做得\n那么入迷？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "209/TALK",
            "narrator": "アーヤ",
            "text": "え！？　え、ええ…。",
            "zh": "诶！？　呃、嗯……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "212/TALK",
            "narrator": "アーヤ",
            "text": "だ、大学のね！\n被服実習があったのよ！",
            "zh": "是、是大学的！\n有缝纫实习！",
            "narrator_zh": "绫水"
        },
        {
            "location": "213/TALK",
            "narrator": "アーヤ",
            "text": "その、実習で完成させられ\nなかった続きを、その…。",
            "zh": "那个，实习时没能\n做完的后续，那个……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "214/TALK",
            "narrator": "ガブリエラ",
            "text": "ふーん…大変ね。",
            "zh": "哦……真是辛苦呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "215/TALK",
            "narrator": "アーヤ",
            "text": "ま、まあね…。",
            "zh": "也、也算吧……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "216/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "217/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "218/TALK",
            "narrator": "ガブリエラ",
            "text": "ルーズリーフ、\n机の上に置いとくからね。",
            "zh": "活页纸\n我放桌上了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "219/TALK",
            "narrator": "アーヤ",
            "text": "え、ええ、ありがと…。",
            "zh": "嗯、嗯，谢谢……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "222/TALK",
            "narrator": "ガブリエラ",
            "text": "それじゃ。\nノックに気付かないほど\n夢中にならないでね。",
            "zh": "那么。\n别沉迷到连敲门\n都听不见哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "223/TALK",
            "narrator": "アーヤ",
            "text": "ええ…、\nごめんね、ギャヴィ。",
            "zh": "嗯……，\n抱歉啊，加维。",
            "narrator_zh": "绫水"
        },
        {
            "location": "224/TALK",
            "narrator": "ガブリエラ",
            "text": "いいわよ…。",
            "zh": "没事啦……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "229/TALK",
            "narrator": "ガブリエラ",
            "text": "ところでアーヤ。\nその服だけど――",
            "zh": "对了绫水。\n那身衣服——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "232/TALK",
            "narrator": "ガブリエラ",
            "text": "どう見ても、男物よね？",
            "zh": "怎么看都是男款吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "235/TALK",
            "narrator": "アーヤ",
            "text": "っ！？",
            "zh": "！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "236/TALK",
            "narrator": "ガブリエラ",
            "text": "あたし何も\n聞いてないけど！？",
            "zh": "我可什么都\n没听说过！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "238/TALK",
            "narrator": "ガブリエラ",
            "text": "どう見ても、男物よね？",
            "zh": "怎么看都是男款吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "241/TALK",
            "narrator": "アーヤ",
            "text": "あ、違うの！\nその、これは…。",
            "zh": "啊，不是的！\n那个，这是……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "242/TALK",
            "narrator": "ガブリエラ",
            "text": "何それ？\nどういうこと？",
            "zh": "那是什么？\n怎么回事？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "244/TALK",
            "narrator": "アーヤ",
            "text": "ちょっと待って。",
            "zh": "等一下。",
            "narrator_zh": "绫水"
        },
        {
            "location": "246/TALK",
            "narrator": "アーヤ",
            "text": "あのね、ギャヴィ。",
            "zh": "那个啊，加维。",
            "narrator_zh": "绫水"
        },
        {
            "location": "247/TALK",
            "narrator": "アーヤ",
            "text": "これは私の\nプライベートの\nことなの。",
            "zh": "这是我的\n私事\n啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "248/TALK",
            "narrator": "アーヤ",
            "text": "貴女に言う必要の\nないことよ。",
            "zh": "是没有必要\n告诉你的事哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "251/TALK",
            "narrator": "ガブリエラ",
            "text": "何よそれ！？",
            "zh": "那算什么！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "253/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤのバカ！\nだいきらい！",
            "zh": "绫水笨蛋！\n最讨厌你了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "259/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "260/TALK",
            "narrator": "アーヤ",
            "text": "あの子、言いふらしたり\nしないかしら？",
            "zh": "那孩子不会\n说出去吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "261/SEL",
            "narrator": "",
            "text": "おーい",
            "zh": "喂——",
            "narrator_zh": ""
        },
        {
            "location": "262/ACT",
            "narrator": "",
            "text": "おーい",
            "zh": "喂——",
            "narrator_zh": ""
        },
        {
            "location": "267/TALK",
            "narrator": "アーヤ",
            "text": "っ！？\nウソ、このタイミング！？",
            "zh": "！？\n不会吧，这个时机！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "270/TALK",
            "narrator": "アーヤ",
            "text": "もう、これじゃ計画が\n台無しよ…。",
            "zh": "真是的，这下计划\n全泡汤了……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "284/TALK",
            "narrator": "アーヤ",
            "text": "$handle$さん",
            "zh": "$handle$",
            "narrator_zh": "绫水"
        },
        {
            "location": "285/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィとのやり取り",
            "zh": "和加维的对话",
            "narrator_zh": "绫水"
        },
        {
            "location": "286/TALK",
            "narrator": "アーヤ",
            "text": "全部見てた？(>_<)",
            "zh": "全都被看到了？(>_<)",
            "narrator_zh": "绫水"
        },
        {
            "location": "288/SEL",
            "narrator": "",
            "text": "うん",
            "zh": "嗯",
            "narrator_zh": ""
        },
        {
            "location": "289/ACT",
            "narrator": "",
            "text": "うん",
            "zh": "嗯",
            "narrator_zh": ""
        },
        {
            "location": "291/TALK",
            "narrator": "アーヤ",
            "text": "やっぱり…(T_T)",
            "zh": "果然……(T_T)",
            "narrator_zh": "绫水"
        },
        {
            "location": "294/SEL",
            "narrator": "",
            "text": "誰に作ってるの？",
            "zh": "你在给谁做？",
            "narrator_zh": ""
        },
        {
            "location": "295/SEL",
            "narrator": "",
            "text": "実習お疲れ様",
            "zh": "实习辛苦了",
            "narrator_zh": ""
        },
        {
            "location": "296/SEL",
            "narrator": "",
            "text": "嬉しいな",
            "zh": "好开心",
            "narrator_zh": ""
        },
        {
            "location": "297/ACT",
            "narrator": "",
            "text": "誰に作ってるの？",
            "zh": "你在给谁做？",
            "narrator_zh": ""
        },
        {
            "location": "299/TALK",
            "narrator": "アーヤ",
            "text": "誰にって",
            "zh": "你问给谁",
            "narrator_zh": "绫水"
        },
        {
            "location": "300/TALK",
            "narrator": "アーヤ",
            "text": "わかってるくせに…(--#)",
            "zh": "明明知道还问……(--#)",
            "narrator_zh": "绫水"
        },
        {
            "location": "301/TALK",
            "narrator": "アーヤ",
            "text": "貴方のに決まってるじゃない",
            "zh": "当然是给你做的啊",
            "narrator_zh": "绫水"
        },
        {
            "location": "302/TALK",
            "narrator": "アーヤ",
            "text": "っていうか",
            "zh": "话说",
            "narrator_zh": "绫水"
        },
        {
            "location": "303/TALK",
            "narrator": "アーヤ",
            "text": "貴方以外の人の服",
            "zh": "除了你以外的人的衣服",
            "narrator_zh": "绫水"
        },
        {
            "location": "304/TALK",
            "narrator": "アーヤ",
            "text": "作るはずないでしょ？",
            "zh": "我怎么可能做吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "305/ACT",
            "narrator": "",
            "text": "実習お疲れ様",
            "zh": "实习辛苦了",
            "narrator_zh": ""
        },
        {
            "location": "307/TALK",
            "narrator": "アーヤ",
            "text": "本気にしないでよ！(ノД`)",
            "zh": "别当真啊！(ノД`)",
            "narrator_zh": "绫水"
        },
        {
            "location": "309/TALK",
            "narrator": "アーヤ",
            "text": "もうバレちゃったから言うけど",
            "zh": "反正都被发现了就直说吧",
            "narrator_zh": "绫水"
        },
        {
            "location": "310/TALK",
            "narrator": "アーヤ",
            "text": "これは貴方の服だから",
            "zh": "这是你的衣服",
            "narrator_zh": "绫水"
        },
        {
            "location": "311/ACT",
            "narrator": "",
            "text": "嬉しいな",
            "zh": "好开心",
            "narrator_zh": ""
        },
        {
            "location": "312/TALK",
            "narrator": "アーヤ",
            "text": "ふーん",
            "zh": "嗯——",
            "narrator_zh": "绫水"
        },
        {
            "location": "313/TALK",
            "narrator": "アーヤ",
            "text": "貴方のだって疑わないのね( ・_・)σﾞ",
            "zh": "你倒是毫不犹豫就相信是你的呢( ・_・)σﾞ",
            "narrator_zh": "绫水"
        },
        {
            "location": "315/TALK",
            "narrator": "アーヤ",
            "text": "まあ",
            "zh": "嗯",
            "narrator_zh": "绫水"
        },
        {
            "location": "316/TALK",
            "narrator": "アーヤ",
            "text": "確かに貴方のなんだけど",
            "zh": "确实是给你的没错",
            "narrator_zh": "绫水"
        },
        {
