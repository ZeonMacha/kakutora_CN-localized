    "entry": [
        {
            "location": "617/SCENARIO",
            "narrator": "",
            "text": "TGS神楽",
            "zh": "TGS神乐",
            "narrator_zh": ""
        },
        {
            "location": "634/TALK",
            "narrator": "神楽",
            "text": "ふふっ…なんだか、\n夢みたいです。",
            "zh": "呵呵……总感觉，\n像做梦一样。",
            "narrator_zh": "神乐"
        },
        {
            "location": "635/TALK",
            "narrator": "神楽",
            "text": "あなたと二人っきりで\n海に来てるなんて…。",
            "zh": "居然能和你两个人\n独处来到海边……",
            "narrator_zh": "神乐"
        },
        {
            "location": "636/SEL",
            "narrator": "",
            "text": "楽しそうだね",
            "zh": "看起来很开心呢",
            "narrator_zh": ""
        },
        {
            "location": "637/ACT",
            "narrator": "",
            "text": "楽しそうだね",
            "zh": "看起来很开心呢",
            "narrator_zh": ""
        },
        {
            "location": "639/TALK",
            "narrator": "神楽",
            "text": "あら？　あなたの方は\n楽しくないんですか？",
            "zh": "哎呀？是你那边\n不开心吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "640/SEL",
            "narrator": "",
            "text": "楽しいに決まってるじゃないか",
            "zh": "当然开心了",
            "narrator_zh": ""
        },
        {
            "location": "641/SEL",
            "narrator": "",
            "text": "楽しいっていうか、嬉しい",
            "zh": "与其说开心，不如说高兴",
            "narrator_zh": ""
        },
        {
            "location": "642/ACT",
            "narrator": "",
            "text": "楽しいに決まってるじゃないか",
            "zh": "当然开心了",
            "narrator_zh": ""
        },
        {
            "location": "643/TALK",
            "narrator": "神楽",
            "text": "ふふっ、気が合いますね。",
            "zh": "呵呵，我们真合拍呢。",
            "narrator_zh": "神乐"
        },
        {
            "location": "645/TALK",
            "narrator": "神楽",
            "text": "まあ、だからデートを\nするような関係にも\nなれたんでしょうけど…。",
            "zh": "嘛，也是因为这样，\n才会变成能一起\n约会的关系吧……",
            "narrator_zh": "神乐"
        },
        {
            "location": "646/ACT",
            "narrator": "",
            "text": "楽しいっていうか、嬉しい",
            "zh": "与其说开心，不如说高兴",
            "narrator_zh": ""
        },
        {
            "location": "648/TALK",
            "narrator": "神楽",
            "text": "…そんな風に言われると、\nなんだか照れちゃいます。",
            "zh": "……被你这么一说，\n总觉得有点害羞了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "649/TALK",
            "narrator": "神楽",
            "text": "私とのデートを、\nそんなに嬉しいと\n思ってもらえるなんて…。",
            "zh": "和我的约会，\n居然能让你觉得\n这么高兴……",
            "narrator_zh": "神乐"
        },
        {
            "location": "650/TALK",
            "narrator": "神楽",
            "text": "始まったばかりなのに、\n嬉しくて胸がいっぱいな\n感じです。",
            "zh": "才刚刚开始，\n就已经高兴得\n心里满满的了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "653/TALK",
            "narrator": "神楽",
            "text": "でも、まさかこんなに\n静かな海に来るとは\n思いませんでした。",
            "zh": "不过，没想到\n会来到这么\n安静的海边。",
            "narrator_zh": "神乐"
        },
        {
            "location": "654/TALK",
            "narrator": "神楽",
            "text": "見てくださいよ。\n私たち以外、誰もいない\n貸し切り状態ですよ！",
            "zh": "你看哦。\n除了我们一个人都没有，\n完全是包场哦！",
            "narrator_zh": "神乐"
        },
        {
            "location": "655/TALK",
            "narrator": "神楽",
            "text": "つまり、ここであなたが\n私に何かしたとしても、\n証人がいないんです。",
            "zh": "也就是说，就算你\n在这里对我做什么，\n也没有证人哦。",
            "narrator_zh": "神乐"
        },
        {
            "location": "656/TALK",
            "narrator": "神楽",
            "text": "…なんて言ったら、\n変な気起こしそうに\nなっちゃいますか？",
            "zh": "……要是这么说，\n你会不会\n起坏心思呀？",
            "narrator_zh": "神乐"
        },
        {
            "location": "657/SEL",
            "narrator": "",
            "text": "神楽が悲しむようなことはしない",
            "zh": "不会做让神乐难过的事",
            "narrator_zh": ""
        },
        {
            "location": "658/SEL",
            "narrator": "",
            "text": "ずっとそんな気持ちを抑えてる",
            "zh": "会一直压抑着那种心思",
            "narrator_zh": ""
        },
        {
            "location": "659/ACT",
            "narrator": "",
            "text": "神楽が悲しむようなことはしない",
            "zh": "不会做让神乐难过的事",
            "narrator_zh": ""
        },
        {
            "location": "660/TALK",
            "narrator": "神楽",
            "text": "…ごめんなさい。\nちょっと、悪ふざけが\n過ぎちゃいましたね。",
            "zh": "……对不起。\n玩笑开得\n稍微过头了呢。",
            "narrator_zh": "神乐"
        },
        {
            "location": "661/TALK",
            "narrator": "神楽",
            "text": "でも…ちょっとだけ\n誤解してます。",
            "zh": "不过……你稍微\n误会了一点哦。",
            "narrator_zh": "神乐"
        },
        {
            "location": "662/TALK",
            "narrator": "神楽",
            "text": "変な気起こしたとしても、\nそれで私が悲しんだりは\nしませんよ。",
            "zh": "就算你起了坏心思，\n我也不会因此\n难过哦。",
            "narrator_zh": "神乐"
        },
        {
            "location": "664/TALK",
            "narrator": "神楽",
            "text": "ふふっ…なんてね。\n冗談なのか本気なのかの\n判断は、お任せします。",
            "zh": "呵呵……开玩笑的。\n是玩笑还是真心，\n就交给你判断了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "665/ACT",
            "narrator": "",
            "text": "ずっとそんな気持ちを抑えてる",
            "zh": "会一直压抑着那种心思",
            "narrator_zh": ""
        },
        {
            "location": "666/TALK",
            "narrator": "神楽",
            "text": "そ、そうだったん\nですか！？",
            "zh": "是、是这样\n吗！？",
            "narrator_zh": "神乐"
        },
        {
            "location": "667/TALK",
            "narrator": "神楽",
            "text": "…あなたは、そういうこと\n考えるような人じゃないと\n思っていました。",
            "zh": "……我原以为，\n你不是会想\n那种事情的人。",
            "narrator_zh": "神乐"
        },
        {
            "location": "668/TALK",
            "narrator": "神楽",
            "text": "あ、別に悲しんだり\n軽蔑してるわけじゃ\nないんです！",
            "zh": "啊，我并不是\n难过或者\n看不起你哦！",
            "narrator_zh": "神乐"
        },
        {
            "location": "670/TALK",
            "narrator": "神楽",
            "text": "ただ…私に対しても、\nそんな気持ちになって\nくれるんだなぁ、って…。",
            "zh": "只是……原来你对\n我也会生出\n那种心思啊……",
            "narrator_zh": "神乐"
        },
        {
            "location": "671/TALK",
            "narrator": "神楽",
            "text": "ちょっと嬉しいな…。\nなんて、思っちゃったり\nして…。",
            "zh": "有点开心呢……\n什么的，也就\n随口说说而已……",
            "narrator_zh": "神乐"
        },
        {
            "location": "673/SEL",
            "narrator": "",
            "text": "神楽に触りたい",
            "zh": "想摸摸神乐",
            "narrator_zh": ""
        },
        {
            "location": "674/ACT",
            "narrator": "",
            "text": "神楽に触りたい",
            "zh": "想摸摸神乐",
            "narrator_zh": ""
        },
        {
            "location": "676/TALK",
            "narrator": "神楽",
            "text": "…だ、大胆なんですね。",
            "zh": "……真、真大胆呢。",
            "narrator_zh": "神乐"
        },
        {
            "location": "677/TALK",
            "narrator": "神楽",
            "text": "ふふっ、でも正直に\nお願いしてくれたから、\n許可しちゃいます。",
            "zh": "呵呵，不过你老实\n地提出了请求，\n那我就批准吧。",
            "narrator_zh": "神乐"
        },
        {
            "location": "696/TALK",
            "narrator": "神楽",
            "text": "あんっ、ツンツンする\nイタズラしてるの、\n誰ですかぁ？",
            "zh": "呀，戳来戳去\n捣乱的，是\n哪一位呀？",
            "narrator_zh": "神乐"
        },
        {
            "location": "698/TALK",
            "narrator": "神楽",
            "text": "…こうされるのって、\n嬉しいんですね。",
            "zh": "……被这样对待，\n还挺开心的呢。",
            "narrator_zh": "神乐"
        },
        {
            "location": "704/TALK",
            "narrator": "神楽",
            "text": "きゃぁっ！？",
            "zh": "呀！？",
            "narrator_zh": "神乐"
        },
        {
            "location": "705/TALK",
            "narrator": "神楽",
            "text": "…今の、事故じゃ\nないですよね？",
            "zh": "……刚才那下，\n不是意外吧？",
            "narrator_zh": "神乐"
        },
        {
            "location": "707/TALK",
            "narrator": "神楽",
            "text": "…誰かのと、\n比べてませんよね？",
            "zh": "……没有拿我和\n别人比吧？",
            "narrator_zh": "神乐"
        },
        {
            "location": "713/TALK",
            "narrator": "神楽",
            "text": "なんか…お腹の方が、\n胸より恥ずかしいです…。",
            "zh": "总觉得……肚子这边，\n比胸还要让人害羞……",
            "narrator_zh": "神乐"
        },
        {
            "location": "715/TALK",
            "narrator": "神楽",
            "text": "ひゃわっ！？",
            "zh": "哇呀！？",
            "narrator_zh": "神乐"
        },
        {
            "location": "716/TALK",
            "narrator": "神楽",
            "text": "お、お腹は弱いんです！\n変な声出ちゃったじゃ\nないですかぁ…。",
            "zh": "肚、肚子很弱的！\n不是都发出\n怪声了嘛……",
            "narrator_zh": "神乐"
        },
        {
            "location": "722/TALK",
            "narrator": "神楽",
            "text": "ふふっ、\n褒めてくれてるんですか？",
            "zh": "呵呵，\n你是在夸我吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "724/TALK",
            "narrator": "神楽",
            "text": "…こうされるのって、\n嬉しいんですね。",
            "zh": "……被这样对待，\n还挺开心的呢。",
            "narrator_zh": "神乐"
        },
        {
            "location": "730/TALK",
            "narrator": "神楽",
