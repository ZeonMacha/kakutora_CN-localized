{
    "dir": "chap08/daydra/dd_ch04_08_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "8402",
        "cid": "miyabi",
        "title": "002 メインストーリー",
        "sub_title": "大胆勝負～Case3～＜前編＞",
        "title_zh": "002 主线剧情",
        "sub_title_zh": "大胆胜负～Case3～＜前篇＞"
    },
    "entry": [
        {
            "location": "8/SCENARIO",
            "narrator": "",
            "text": "大胆勝負～Case3～",
            "zh": "大胆胜负～Case3～",
            "narrator_zh": ""
        },
        {
            "location": "28/TALK",
            "narrator": "真幌",
            "text": "しかし、逢瀬と卯月が\n入隊してくれて、\n本当に助かった。",
            "zh": "不过，逢濑和卯月\n肯入队，\n真是帮了大忙。",
            "narrator_zh": "真幌"
        },
        {
            "location": "29/TALK",
            "narrator": "真幌",
            "text": "戦力も増え、ようやく\nひと安心といった\nところだ。",
            "zh": "战力也增加了，\n总算能\n松一口气了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "30/TALK",
            "narrator": "真幌",
            "text": "それに、劇場の方の\n人員も増えたし――",
            "zh": "而且，剧场那边\n人手也增加了——",
            "narrator_zh": "真幌"
        },
        {
            "location": "33/TALK",
            "narrator": "真幌",
            "text": "これでどうにか\nそれなりの形には\nなったな。",
            "zh": "这样总算\n弄出个像样的\n架子了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "35/TALK",
            "narrator": "みやび",
            "text": "ちゅうか、まほさん。\n前から疑問だったが\nですけんど――",
            "zh": "说起来，真幌。\n我从前就有一个\n疑问，但是——",
            "narrator_zh": "雅"
        },
        {
            "location": "37/TALK",
            "narrator": "みやび",
            "text": "うちらがここの\nバイトする必要、\nあるがですか？",
            "zh": "我们有必要\n在这里打工\n咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "39/TALK",
            "narrator": "真幌",
            "text": "営業してない劇場に、\n年頃の女子が\n集まるのか？",
            "zh": "不营业的剧场，\n却聚着一群\n妙龄女子？",
            "narrator_zh": "真幌"
        },
        {
            "location": "40/TALK",
            "narrator": "真幌",
            "text": "どう考えても\n目立つし、噂にも\nなるだろ。",
            "zh": "怎么想都\n太显眼，也会\n招来闲话吧。",
            "narrator_zh": "真幌"
        },
        {
            "location": "42/TALK",
            "narrator": "みやび",
            "text": "なら、バイトなんぞ\nさせないで――",
            "zh": "那就别让我们\n搞驷马打工——",
            "narrator_zh": "雅"
        },
        {
            "location": "43/TALK",
            "narrator": "みやび",
            "text": "自由にさせて\nくれればいいじゃ\nないですか。",
            "zh": "让我们自由\n不就好了\n是没是？",
            "narrator_zh": "雅"
        },
        {
            "location": "46/TALK",
            "narrator": "真幌",
            "text": "ある程度の人数を、\nいつも決まった場所に\n集めておいた方が――",
            "zh": "把一定数量的人\n平时就集中在\n同一个地方——",
            "narrator_zh": "真幌"
        },
        {
            "location": "47/TALK",
            "narrator": "真幌",
            "text": "急な出動の時に\n困らないだろ。",
            "zh": "紧急出动的时候\n才不会抓瞎。",
            "narrator_zh": "真幌"
        },
        {
            "location": "51/TALK",
            "narrator": "みやび",
            "text": "…まあ、そんな理由\nだとは思うてました\nけんどね。",
            "zh": "……嘛，我也料到\n理由是这种，\n但是呢。",
            "narrator_zh": "雅"
        },
        {
            "location": "52/TALK",
            "narrator": "みやび",
            "text": "とりあえず、劇場の\n人員が増えたことには\n違いないき――",
            "zh": "总之，剧场的人手\n变多了这回事\n是没错啵——",
            "narrator_zh": "雅"
        },
        {
            "location": "53/TALK",
            "narrator": "みやび",
            "text": "そこは素直に\n喜んでおくか。",
            "zh": "这点就老实\n高兴一下咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "54/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "55/TALK",
            "narrator": "みやび",
            "text": "ところで、まほさん。\nつばめちゃんのこと\nですけんど――",
            "zh": "话说回来，真幌。\n是关于燕的事，\n但是——",
            "narrator_zh": "雅"
        },
        {
            "location": "56/TALK",
            "narrator": "みやび",
            "text": "あの子、このまま\nうちにいても平気なが\nですか？",
            "zh": "那孩子就这样\n待在我们这儿，\n真没关系咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "57/TALK",
            "narrator": "真幌",
            "text": "どういう意味だ？",
            "zh": "什么意思？",
            "narrator_zh": "真幌"
        },
        {
            "location": "58/TALK",
            "narrator": "みやび",
            "text": "あの子、意外と\n危なっかしい\nドジッ子さんやき――",
            "zh": "那孩子意外地\n冒冒失失，是个\n小迷糊嘛——",
            "narrator_zh": "雅"
        },
        {
            "location": "59/TALK",
            "narrator": "みやび",
            "text": "トライナリーとして\n戦いに出すんは、\n危険と思うがですよ。",
            "zh": "让她作为三重奏\n出战，我觉得\n很危险咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "60/TALK",
            "narrator": "真幌",
            "text": "ふむ…まあ、おまえの\n心配はわからなくも\nないな。",
            "zh": "嗯……嘛，你的担心\n也不是\n不能理解。",
            "narrator_zh": "真幌"
        },
        {
            "location": "61/TALK",
            "narrator": "真幌",
            "text": "私も、今日の戦闘での\n活躍を見るまでは、\n少々不安だった。",
            "zh": "我也一样，在看到\n今天战斗中的\n表现之前，有些不安。",
            "narrator_zh": "真幌"
        },
        {
            "location": "62/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "65/TALK",
            "narrator": "真幌",
            "text": "まあ、それを抜きに\nしても――",
            "zh": "嘛，就算\n撇开这个不谈——",
            "narrator_zh": "真幌"
        },
        {
            "location": "66/TALK",
            "narrator": "真幌",
            "text": "あいつはトライ\nガジェットの所持者\nだからな。",
            "zh": "那家伙可是\nTri-Gadget 的\n持有者啊。",
            "narrator_zh": "真幌"
        },
        {
            "location": "67/TALK",
            "narrator": "真幌",
            "text": "戦う力がある以上、\n戦闘には出てもら\nわんと困るんだよ。",
            "zh": "既然拥有战斗之力，\n不出战的话，\n我可很为难。",
            "narrator_zh": "真幌"
        },
        {
            "location": "69/TALK",
            "narrator": "みやび",
            "text": "…それ言うたら、\nあれですか？",
            "zh": "……这么说，\n是那个意思咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "70/TALK",
            "narrator": "みやび",
            "text": "トライガジェットを\n持っちょるんが――",
            "zh": "凡是持有\nTri-Gadget 的——",
            "narrator_zh": "雅"
        },
        {
            "location": "71/TALK",
            "narrator": "みやび",
            "text": "赤ん坊や婆ちゃん\nでも、スカウトする\nゆうことですか？",
            "zh": "就算是婴儿老太婆，\n也要招募进来，\n是这意思咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "73/TALK",
            "narrator": "真幌",
            "text": "…当然だ。",
            "zh": "……当然。",
            "narrator_zh": "真幌"
        },
        {
            "location": "75/TALK",
            "narrator": "みやび",
            "text": "なっ！？",
            "zh": "啥！？",
            "narrator_zh": "雅"
        },
        {
            "location": "77/TALK",
            "narrator": "真幌",
            "text": "コネクトが出来れば、\nそれが赤子だろうが\n老人だろうが――",
            "zh": "只要能连接，\n不管对方是婴儿\n还是老人——",
            "narrator_zh": "真幌"
        },
        {
            "location": "78/TALK",
            "narrator": "真幌",
            "text": "戦う力を得られる\nということなの\nだからな。",
            "zh": "都能得到\n战斗的力量，\n就是这么回事。",
            "narrator_zh": "真幌"
        },
        {
            "location": "80/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "81/TALK",
            "narrator": "真幌",
            "text": "…ふっ。",
            "zh": "……呵。",
            "narrator_zh": "真幌"
        },
        {
            "location": "82/TALK",
            "narrator": "真幌",
            "text": "まあ、だからといって\n赤子を戦場に出す気は\nないがな。",
            "zh": "嘛，话虽如此，\n我也没打算把婴儿\n送上战场就是了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "83/TALK",
            "narrator": "真幌",
            "text": "力を得ても、\n言葉も喋れない\nような状態では――",
            "zh": "就算得到了力量，\n连话都不会说的\n状态下——",
            "narrator_zh": "真幌"
        },
        {
            "location": "84/TALK",
            "narrator": "真幌",
            "text": "戦うことなどできん\nだろうからな。",
            "zh": "也打不了\n什么仗吧。",
            "narrator_zh": "真幌"
        },
        {
            "location": "86/TALK",
            "narrator": "みやび",
            "text": "…ですね。\nそれ聞いてちくっと\n安心しました。",
            "zh": "……是呢。\n听你这么一说，\n我有点安心了。",
            "narrator_zh": "雅"
        },
        {
            "location": "88/TALK",
            "narrator": "真幌",
            "text": "まあ、逢瀬と卯月に\n関していえば、\n何も問題はないさ。",
            "zh": "嘛，就逢濑和卯月\n来说，\n没有任何问题。",
            "narrator_zh": "真幌"
        },
        {
            "location": "90/TALK",
            "narrator": "みやび",
            "text": "…つばめちゃんの、\nあの謎の力のことに\nついては？",
            "zh": "……那燕的\n那个谜之力量\n又是怎么说？",
            "narrator_zh": "雅"
        },
        {
            "location": "93/TALK",
            "narrator": "真幌",
            "text": "現時点では管理庁も、\nあの力がどういった\nものかについて――",
            "zh": "现阶段，管理厅\n对那股力量究竟是\n什么东西——",
            "narrator_zh": "真幌"
        },
        {
            "location": "94/TALK",
            "narrator": "真幌",
            "text": "明確な答えを\n出せていない。",
            "zh": "也拿不出\n明确的答案。",
            "narrator_zh": "真幌"
        },
        {
            "location": "95/TALK",
            "narrator": "真幌",
            "text": "なので、その件は\n私に一任されている\n状況だ。",
            "zh": "所以那件事，\n目前全权\n交给我处理。",
            "narrator_zh": "真幌"
        },
        {
            "location": "97/TALK",
            "narrator": "みやび",
            "text": "…で、まほさんと\nしてはどう思うてるが\nですか？",
            "zh": "……那么真幌你\n是怎么\n想的咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "99/TALK",
            "narrator": "真幌",
            "text": "…ここだけの話では\nあるが――",
            "zh": "……这话只限于\n我们之间说——",
            "narrator_zh": "真幌"
        },
        {
            "location": "100/TALK",
            "narrator": "真幌",
            "text": "正直、若干ではあるが\n危険視はしている。",
            "zh": "老实说，虽然不重，\n我是有些把她当危险看的。",
            "narrator_zh": "真幌"
        },
        {
            "location": "101/TALK",
            "narrator": "真幌",
            "text": "だが、それを理由に\n入隊させないのも、\n不安ではある。",
            "zh": "但以那个为理由\n不让她入队，\n我也不放心。",
            "narrator_zh": "真幌"
        },
        {
            "location": "102/TALK",
            "narrator": "真幌",
            "text": "今まで確認された\nことのない、恐るべき\n力だからな。",
            "zh": "毕竟那是从未\n确认过的、\n可怕的力量。",
            "narrator_zh": "真幌"
        },
        {
            "location": "103/TALK",
            "narrator": "真幌",
            "text": "なので、手元に置いて\nおくのが一番安心だと\n判断した。",
            "zh": "所以我认为，\n放在手边看着\n才最安心。",
            "narrator_zh": "真幌"
        },
        {
            "location": "105/TALK",
            "narrator": "みやび",
            "text": "…なるほど。\nそうですか。",
            "zh": "……原来如此。\n是这样啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "107/TALK",
            "narrator": "みやび",
            "text": "まほさんの言うてる\nことも、わからなくは\nないな。",
            "zh": "真幌你说的\n也不是\n不能懂咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "108/TALK",
            "narrator": "みやび",
            "text": "放置は危険やき、\n手元に置くっちゅう\nのも納得や。",
            "zh": "放着不管很危险嘛，\n所以放在手边\n看着，我也理解咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "109/TALK",
            "narrator": "みやび",
            "text": "けんど…逆に言うたら\n何かあればうちらは\n大ピンチや。",
            "zh": "但是……反过来说，\n万一出事，我们\n就是大危机咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "110/TALK",
            "narrator": "みやび",
            "text": "あの強力な力が\n暴走なんぞしてみぃ。",
            "zh": "那股强大的力量\n要是给我搞驷马暴走试试。",
            "narrator_zh": "雅"
        },
        {
            "location": "111/TALK",
            "narrator": "みやび",
            "text": "トライナリーが\n一発で壊滅っちゅう\nこともありえる。",
            "zh": "三重奏也有可能\n一击就\n全灭咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "112/TALK",
            "narrator": "みやび",
            "text": "それがわかっちょらん\nはずもないし。\nだとすると――",
            "zh": "这一点她不可能\n不知道。\n那么——",
            "narrator_zh": "雅"
        },
        {
            "location": "113/TALK",
            "narrator": "みやび",
            "text": "大丈夫だっちゅう、\n確証がある…？",
            "zh": "“没问题”这种确证，\n真的有咩……？",
            "narrator_zh": "雅"
        },
        {
            "location": "114/TALK",
            "narrator": "みやび",
            "text": "やはり、逢瀬つばめは\nうちらを内部から\n監視する――",
            "zh": "果然，逢濑燕是\n从内部监视\n我们的——",
            "narrator_zh": "雅"
        },
        {
            "location": "115/TALK",
            "narrator": "みやび",
            "text": "スパイっちゅう\n可能性は高いな…。",
            "zh": "间谍的可能性\n很高咯……。",
            "narrator_zh": "雅"
        },
        {
            "location": "116/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "117/TALK",
            "narrator": "真幌",
            "text": "なんだ？\nまだ何かあるのか？",
            "zh": "怎么了？\n还有别的事？",
            "narrator_zh": "真幌"
        },
        {
            "location": "118/TALK",
            "narrator": "みやび",
            "text": "…カマかけてみるか。",
            "zh": "……套个话试试看吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "120/TALK",
            "narrator": "みやび",
            "text": "実はまほさん。\nうち、あの力のこと\nなんですけんど――",
            "zh": "其实呢，真幌。\n我啊，是想说那股\n力量的事，但是——",
            "narrator_zh": "雅"
        },
        {
            "location": "121/TALK",
            "narrator": "みやび",
            "text": "もしかしたら、\n解明できるかも\nしれないがですよ。",
            "zh": "说不定，\n能把它弄清楚\n也不一定咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "122/TALK",
            "narrator": "真幌",
            "text": "…どういうことだ？",
            "zh": "……什么意思？",
            "narrator_zh": "真幌"
        },
        {
            "location": "124/TALK",
            "narrator": "みやび",
            "text": "前に、うちが管理庁の\nサーバーにハッキング\nした時に――",
            "zh": "之前，我黑进\n管理厅服务器\n的时候——",
            "narrator_zh": "雅"
        },
        {
            "location": "125/TALK",
            "narrator": "みやび",
            "text": "怪しいデータを\n引っ張って来たが\nです。",
            "zh": "拉了一份\n可疑的数据\n回来咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "127/TALK",
            "narrator": "みやび",
            "text": "そのデータが、\nどうもつばめちゃんの\nあの力に関する――",
            "zh": "那份数据，\n看样子是关于燕\n那股力量的——",
            "narrator_zh": "雅"
        },
        {
            "location": "128/TALK",
            "narrator": "みやび",
            "text": "秘密ファイルっぽい\n内容みたいながです。",
            "zh": "秘密文件一样的\n内容咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "129/TALK",
            "narrator": "真幌",
            "text": "マジか！？",
            "zh": "真的假的！？",
            "narrator_zh": "真幌"
        },
        {
            "location": "130/TALK",
            "narrator": "真幌",
            "text": "そんな物が管理庁の\nサーバーにあったと\nいうのか！？",
            "zh": "那种东西居然\n在管理厅的\n服务器里！？",
            "narrator_zh": "真幌"
        },
        {
            "location": "131/TALK",
            "narrator": "みやび",
            "text": "驚きましたけんどね。",
            "zh": "不过我也吓了一跳咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "133/TALK",
            "narrator": "真幌",
            "text": "なんてこった…。\nもしそのファイルが\n本物なら――",
            "zh": "怎么会这样……。\n如果那份文件\n是真的——",
            "narrator_zh": "真幌"
        },
        {
            "location": "134/TALK",
            "narrator": "真幌",
            "text": "管理庁は、我々現場に\n隠し事をしていた\nということになるぞ。",
            "zh": "那就等于说管理厅\n对我们一线\n隐瞒了事情。",
            "narrator_zh": "真幌"
        },
        {
            "location": "136/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "137/TALK",
            "narrator": "みやび",
            "text": "まあ、\nそうなりますね。",
            "zh": "嘛，\n就是这样咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "138/TALK",
            "narrator": "真幌",
            "text": "うーん…そのデータが\nもし本物だったら――",
            "zh": "唔……那份数据\n如果是真的——",
            "narrator_zh": "真幌"
        },
        {
            "location": "139/TALK",
            "narrator": "真幌",
            "text": "上と揉めんといけない\nことになりそうだ…。",
            "zh": "搞不好就得和\n上头闹一场了……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "140/TALK",
            "narrator": "真幌",
            "text": "はぁ…面倒なことに\nならんといいが…。",
            "zh": "唉……但愿别\n闹出麻烦事……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "141/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "143/TALK",
            "narrator": "真幌",
            "text": "しかし、もしそれが\n本物だとしておまえが\n解析を進め――",
            "zh": "不过，假如那玩意\n是真的，你把\n解析推进下去——",
            "narrator_zh": "真幌"
        },
        {
            "location": "144/TALK",
            "narrator": "真幌",
            "text": "あの力の正体を\n解明すれば、\n大手柄間違いなしだ。",
            "zh": "解开那股力量的\n真面目，\n就是铁定的大功。",
            "narrator_zh": "真幌"
        },
        {
            "location": "145/TALK",
            "narrator": "真幌",
            "text": "その調子で、解析を\n進めてくれ。",
            "zh": "就照这个势头，\n把解析推进下去。",
            "narrator_zh": "真幌"
        },
        {
            "location": "147/TALK",
            "narrator": "みやび",
            "text": "…わかりました。",
            "zh": "……明白了。",
            "narrator_zh": "雅"
        },
        {
            "location": "148/TALK",
            "narrator": "みやび",
            "text": "…まほさんは\n白のようやな。",
            "zh": "……真幌这个人，\n看来是白的咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "149/TALK",
            "narrator": "みやび",
            "text": "真面目モードにも\nならんで、\n素で驚いちょるし。",
            "zh": "连认真模式\n都没切，是真的\n在吃惊咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "151/TALK",
            "narrator": "みやび",
            "text": "だとすると、他に\nつばめちゃんが――",
            "zh": "这样的话，能证明\n燕是间谍的——",
            "narrator_zh": "雅"
        },
        {
            "location": "152/TALK",
            "narrator": "みやび",
            "text": "スパイだと\n証明する方法は…。",
            "zh": "其他方法，\n是……",
            "narrator_zh": "雅"
        },
        {
            "location": "196/TALK",
            "narrator": "みやび",
            "text": "……　…",
            "zh": "……　…",
            "narrator_zh": "雅"
        },
        {
            "location": "210/TALK",
            "narrator": "みやび",
            "text": "ぶひ",
            "zh": "哼哧",
            "narrator_zh": "雅"
        },
        {
            "location": "214/TALK",
            "narrator": "みやび",
            "text": "ぶひ",
            "zh": "哼哧",
            "narrator_zh": "雅"
        },
        {
            "location": "218/TALK",
            "narrator": "みやび",
            "text": "ぶひ",
            "zh": "哼哧",
            "narrator_zh": "雅"
        },
        {
            "location": "226/TALK",
            "narrator": "みやび",
            "text": "引っかかったーっ！",
            "zh": "上钩了——！",
            "narrator_zh": "雅"
        },
        {
            "location": "227/SEL",
            "narrator": "",
            "text": "……は？",
            "zh": "……哈？",
            "narrator_zh": ""
        },
        {
            "location": "228/ACT",
            "narrator": "",
            "text": "……は？",
            "zh": "……哈？",
            "narrator_zh": ""
        },
        {
            "location": "232/TALK",
            "narrator": "みやび",
            "text": "うちがいつも寝ちゅうと\n思うちょったら\n大間違いや！",
            "zh": "以为我整天\n都在睡觉，那你就\n大错特错了！",
            "narrator_zh": "雅"
        },
        {
            "location": "234/TALK",
            "narrator": "みやび",
            "text": "引っ掛けてやろうと思うて\nずっと起きちょったんよ？",
            "zh": "我为了钓你上钩，\n可是一直醒着的咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "235/SEL",
            "narrator": "",
            "text": "……ヒマなの？",
            "zh": "……你很闲吗？",
            "narrator_zh": ""
        },
        {
            "location": "236/SEL",
            "narrator": "",
            "text": "これは一本取られましたな",
            "zh": "这局被你拿下一城了",
            "narrator_zh": ""
        },
        {
            "location": "237/ACT",
            "narrator": "",
            "text": "……ヒマなの？",
            "zh": "……你很闲吗？",
            "narrator_zh": ""
        },
        {
            "location": "238/TALK",
            "narrator": "みやび",
            "text": "うむ。\n大変ヒマ。",
            "zh": "嗯。\n闲得要命。",
            "narrator_zh": "雅"
        },
        {
            "location": "239/ACT",
            "narrator": "",
            "text": "これは一本取られましたな",
            "zh": "这局被你拿下一城了",
            "narrator_zh": ""
        },
        {
            "location": "240/TALK",
            "narrator": "みやび",
            "text": "ふむ。\n気が済んだ。",
            "zh": "嗯。\n心里舒坦了。",
            "narrator_zh": "雅"
        },
        {
            "location": "242/SEL",
            "narrator": "",
            "text": "そしたら仕事してください",
            "zh": "那请去干活",
            "narrator_zh": ""
        },
        {
            "location": "243/ACT",
            "narrator": "",
            "text": "そしたら仕事してください",
            "zh": "那请去干活",
            "narrator_zh": ""
        },
        {
            "location": "245/TALK",
            "narrator": "みやび",
            "text": "まあ、しゃーないな。\n職場放棄をするつもりは\nないし。",
            "zh": "嘛，没法子咯。\n丢下工作不管\n这种事我可不干。",
            "narrator_zh": "雅"
        },
        {
            "location": "248/TALK",
            "narrator": "みやび",
            "text": "さて、と。\n今回はどんなクランが\n蔓延っちょるんかね、と。",
            "zh": "那么。\n这次蔓延的\n是驷马库兰咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "253/TALK",
            "narrator": "みやび",
            "text": "オープンプロセス、\n0x112番地から\n0x95D番地へ。",
            "zh": "开放进程，\n从0x112地址\n到0x95D地址。",
            "narrator_zh": "雅"
        },
        {
            "location": "268/TALK",
            "narrator": "みやび",
            "text": "完了。",
            "zh": "完成。",
            "narrator_zh": "雅"
        },
        {
            "location": "270/TALK",
            "narrator": "みやび",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "雅"
        },
        {
            "location": "272/TALK",
            "narrator": "みやび",
            "text": "………。",
            "zh": "………。",
            "narrator_zh": "雅"
        },
        {
            "location": "273/TALK",
            "narrator": "みやび",
            "text": "あー、なるほど。",
            "zh": "啊，原来如此。",
            "narrator_zh": "雅"
        },
        {
            "location": "274/TALK",
            "narrator": "みやび",
            "text": "うち、なんか\n焦っちゅうんかね。",
            "zh": "我，好像\n有点着急咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "275/SEL",
            "narrator": "",
            "text": "どういうこと？",
            "zh": "什么意思？",
            "narrator_zh": ""
        },
        {
            "location": "276/ACT",
            "narrator": "",
            "text": "どういうこと？",
            "zh": "什么意思？",
            "narrator_zh": ""
        },
        {
            "location": "278/TALK",
            "narrator": "みやび",
            "text": "ココロファイルナンバー\n04-154-77を見るとなぁ。",
            "zh": "翻开心之档案编号\n04-154-77一看。",
            "narrator_zh": "雅"
        },
        {
            "location": "279/TALK",
            "narrator": "みやび",
            "text": "まだつばめちゃんが\nスパイやとか確定する前に\n黒と決めつけちゅう。",
            "zh": "燕是间谍什么的\n还没定下来，\n就先认定她是黑的咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "280/TALK",
            "narrator": "みやび",
            "text": "このまま暴走しゆうと\nちょっと面倒なことに\nなりそうやね。",
            "zh": "照这样暴走下去，\n怕是要变成\n有点麻烦的局面咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "281/TALK",
            "narrator": "みやび",
            "text": "まあ、きっかけが何かは\nうちには判らんけんど、\nマジに対処が必要かと。",
            "zh": "嘛，虽然没懂\n导火索是驷马，\n但真心得处理一下了。",
            "narrator_zh": "雅"
        },
        {
            "location": "282/SEL",
            "narrator": "",
            "text": "クランを倒せばいい？",
            "zh": "打倒库兰就行？",
            "narrator_zh": ""
        },
        {
            "location": "283/ACT",
            "narrator": "",
            "text": "クランを倒せばいい？",
            "zh": "打倒库兰就行？",
            "narrator_zh": ""
        },
        {
            "location": "285/TALK",
            "narrator": "みやび",
            "text": "うむ。\nその通りや。",
            "zh": "嗯。\n正是这样咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "286/TALK",
            "narrator": "みやび",
            "text": "何か焦る要因になっちゅう\nクランを倒して、うちを\n冷静にしてや。",
            "zh": "把让我干着急的\n那些库兰打倒，\n让我冷静下来吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "287/TALK",
            "narrator": "みやび",
            "text": "しっかし、あれやね。",
            "zh": "不过话说回来，就是这么回事咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "288/TALK",
            "narrator": "みやび",
            "text": "うちも一旦火がつくと\nかなり視野が狭くなるき。",
            "zh": "我也是一旦上了头，\n视野就变得相当窄啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "289/TALK",
            "narrator": "みやび",
            "text": "クランを生みやすい\n性格なんかねぇ。",
            "zh": "真是个容易生出\n库兰的性格咯……",
            "narrator_zh": "雅"
        },
        {
            "location": "290/TALK",
            "narrator": "みやび",
            "text": "何にしても、\nよろしゅうね。",
            "zh": "总之，\n拜托你了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "292/TALK",
            "narrator": "みやび",
            "text": "うちと$handle$に\nえいココロの旅を！",
            "zh": "献给我和$handle$的\n美妙的心灵之旅！",
            "narrator_zh": "雅"
        },
        {
            "location": "26/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>5月9日　7:01 PM</color>\n高校でのフェノメノン戦の後、神楽坂トライナリー劇場ホワイエにて。",
            "zh": "<color=green>5月9日　7:01 PM</color>\n高中的PhenoMENON战之后，于神乐坂三重奏剧场休息室。",
            "narrator_zh": "Dialog_EventData"
        },
        {
            "location": "164/DIALOG",
            "narrator": "BattleInit/Dialog_BATTLE_ch04",
            "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n",
            "zh": "<color=black><size=50><b>恋之崎雅的心中\n战斗开始了。</b></size></color>\n\n\n\n\n\n她的心中，\n产生了很大的挣扎。\n\n请潜入心灵领域，\n化解恋之崎雅心中的挣扎。\n\n\n\n",
            "narrator_zh": "BattleInit/Dialog_BATTLE_ch04"
        },
        {
            "location": "201/DIALOG",
            "narrator": "INFO",
            "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n接続されました。\n\n画面をタップして相手に\n感覚を伝えましょう。",
            "zh": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\n触摸交流\n已连接。\n\n点击画面，向对方\n传达感觉吧。",
            "narrator_zh": "INFO"
        },
        {
            "location": "223/DIALOG",
            "narrator": "NOTICE",
            "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n切断されました。",
            "zh": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\n触摸交流\n已断开。",
            "narrator_zh": "NOTICE"
        }
    ]
}
