   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "80/TALK",
   "narrator": "ガブリエラ",
   "text": "$handle$が必要だって思ったのよ",
   "zh": "我觉得需要$handle$",
   "narrator_zh": "加布里埃拉"
  },
  {
