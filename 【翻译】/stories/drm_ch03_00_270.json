 "entry": [
  {
   "location": "7/SCENARIO",
   "narrator": "",
   "text": "270_恋愛以前"
  },
  {
   "location": "32/TALK",
   "narrator": "ガブリエラ",
   "text": "すごく不思議なのよね"
  },
  {
   "location": "33/TALK",
   "narrator": "ガブリエラ",
   "text": "雛は恋愛が苦手なんですって"
  },
  {
   "location": "34/TALK",
   "narrator": "ガブリエラ",
   "text": "う～ん・・・",
   "zh": "唔～嗯……",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "35/TALK",
   "narrator": "ガブリエラ",
   "text": "ちょっと違うわね",
   "zh": "有点不对呢",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "36/TALK",
   "narrator": "ガブリエラ",
   "text": "周りの恋愛話は大好きだけど、自分自身のは苦手なんですって"
  },
  {
   "location": "38/SEL",
   "narrator": "",
   "text": "そういう人いるよね",
   "zh": "有那种人哦",
   "narrator_zh": ""
  },
  {
   "location": "39/SEL",
   "narrator": "",
   "text": "$handle$もそうかも",
   "zh": "$handle$也许也是吧",
   "narrator_zh": ""
  },
  {
   "location": "40/SEL",
   "narrator": "",
   "text": "ガブと$handle$の恋愛なら大歓迎",
   "zh": "加布和$handle$谈恋爱的话我非常欢迎",
   "narrator_zh": ""
  },
  {
   "location": "42/TALK",
   "narrator": "ガブリエラ",
   "text": "どう思う？",
   "zh": "你觉得呢？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "44/TALK",
   "narrator": "ガブリエラ",
   "text": "不思議じゃないこと？"
  },
  {
   "location": "46/ACT",
   "narrator": "",
   "text": "そういう人いるよね",
   "zh": "有那种人哦",
   "narrator_zh": ""
  },
  {
   "location": "47/TALK",
   "narrator": "ガブリエラ",
   "text": "あら",
   "zh": "哦",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "48/TALK",
   "narrator": "ガブリエラ",
   "text": "そういうものなの？",
   "zh": "是这样吗？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "49/TALK",
   "narrator": "ガブリエラ",
   "text": "ふ～ん",
   "zh": "嗯——",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "50/ACT",
   "narrator": "",
   "text": "$handle$もそうかも",
   "zh": "$handle$也许也是吧",
   "narrator_zh": ""
  },
  {
   "location": "51/TALK",
   "narrator": "ガブリエラ",
   "text": "それは少し困っちゃうわ",
   "zh": "那有点让人为难",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "52/TALK",
   "narrator": "ガブリエラ",
   "text": "ううん",
   "zh": "不是的",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "53/TALK",
   "narrator": "ガブリエラ",
   "text": "むしろその方が相談しやすくていいかしら"
  },
  {
   "location": "54/ACT",
   "narrator": "",
   "text": "ガブと$handle$の恋愛なら大歓迎",
   "zh": "加布和$handle$谈恋爱的话我非常欢迎",
   "narrator_zh": ""
  },
  {
   "location": "64/TALK",
   "narrator": "ガブリエラ",
   "text": "だから何度も言っているけど",
   "zh": "所以我说了好多次",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "65/TALK",
   "narrator": "ガブリエラ",
   "text": "貴方は！！！！"
  },
  {
   "location": "67/TALK",
   "narrator": "ガブリエラ",
   "text": "そういうんじゃないんだから！！",
   "zh": "不是那个啦",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "69/TALK",
   "narrator": "ガブリエラ",
   "text": "それでね",
   "zh": "然后呀",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "70/TALK",
   "narrator": "ガブリエラ",
   "text": "雛は"
  },
  {
   "location": "71/TALK",
   "narrator": "ガブリエラ",
   "text": "相談だったら聞きたいし、アドバイスはしたいみたいなの"
  },
  {
   "location": "72/TALK",
   "narrator": "ガブリエラ",
   "text": "でも自分自身はそういうのは嫌なんですって",
   "zh": "不过她说自己不喜欢那样",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "73/TALK",
   "narrator": "ガブリエラ",
   "text": "そんな女の子もいるのね・・・・",
   "zh": "也有那样的女孩子啊……",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "75/SEL",
   "narrator": "",
   "text": "いろんな人がいるからね",
   "zh": "毕竟有各种各样的人啊",
   "narrator_zh": ""
  },
  {
   "location": "76/SEL",
   "narrator": "",
   "text": "一番かわいいのはガブリエラだよ",
   "zh": "最可爱的是加布里埃拉哦",
   "narrator_zh": ""
  },
  {
   "location": "77/ACT",
   "narrator": "",
   "text": "いろんな人がいるからね",
   "zh": "毕竟有各种各样的人啊",
   "narrator_zh": ""
  },
  {
   "location": "78/TALK",
