        },
        {
            "location": "32/TALK",
            "narrator": "神楽",
            "text": "$handle$さんに質問です",
            "zh": "向$handle$提个问题",
            "narrator_zh": "神乐"
        },
        {
            "location": "33/TALK",
            "narrator": "神楽",
            "text": "あなたは何者なんでしょうか？",
            "zh": "你究竟是什么人呢？",
            "narrator_zh": "神乐"
        },
        {
            "location": "35/SEL",
            "narrator": "",
            "text": "神楽の味方",
            "zh": "我是神乐这边的",
            "narrator_zh": ""
        },
        {
            "location": "36/SEL",
            "narrator": "",
            "text": "恋人候補",
            "zh": "恋人候补",
            "narrator_zh": ""
        },
        {
            "location": "37/SEL",
            "narrator": "",
            "text": "$me$は$me$だよ？",
            "zh": "$me$就是$me$哦？",
            "narrator_zh": ""
        },
        {
            "location": "38/ACT",
            "narrator": "",
            "text": "神楽の味方",
            "zh": "我是神乐这边的",
            "narrator_zh": ""
        },
        {
            "location": "39/TALK",
            "narrator": "神楽",
            "text": "そうなんですね",
            "zh": "是这样啊",
            "narrator_zh": "神乐"
        },
        {
            "location": "40/TALK",
            "narrator": "神楽",
            "text": "なんて",
            "zh": "之类的",
            "narrator_zh": "神乐"
        },
        {
            "location": "41/TALK",
            "narrator": "神楽",
            "text": "あっさり信じられると思いますか？",
            "zh": "你觉得我会这么干脆地相信吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "42/ACT",
            "narrator": "",
            "text": "恋人候補",
            "zh": "恋人候补",
            "narrator_zh": ""
        },
        {
            "location": "43/TALK",
            "narrator": "神楽",
            "text": "なんでそうなるんですか？",
            "zh": "为什么会那样呢？",
            "narrator_zh": "神乐"
        },
        {
            "location": "45/TALK",
            "narrator": "神楽",
            "text": "わけがわかりません",
            "zh": "简直莫名其妙",
            "narrator_zh": "神乐"
        },
        {
            "location": "46/ACT",
            "narrator": "",
            "text": "$me$は$me$だよ？",
            "zh": "$me$就是$me$哦？",
            "narrator_zh": ""
        },
        {
            "location": "47/TALK",
            "narrator": "神楽",
            "text": "全く答えになってないですね",
            "zh": "完全没回答到点子上呢",
            "narrator_zh": "神乐"
        },
        {
            "location": "49/TALK",
            "narrator": "神楽",
            "text": "私はこの世界に理由があって送り込まれました",
            "zh": "我是带着理由被送到这个世界来的",
            "narrator_zh": "神乐"
        },
        {
            "location": "50/TALK",
            "narrator": "神楽",
            "text": "それなのに",
            "zh": "可是偏偏",
            "narrator_zh": "神乐"
        },
        {
            "location": "51/TALK",
            "narrator": "神楽",
            "text": "この世界でまた面倒な人間に会いました",
            "zh": "在这个世界里又遇到了麻烦的人",
            "narrator_zh": "神乐"
        },
        {
            "location": "53/SEL",
            "narrator": "",
            "text": "千羽鶴のこと？",
            "zh": "千羽鹤的事？",
            "narrator_zh": ""
        },
        {
            "location": "54/SEL",
            "narrator": "",
            "text": "つばめのことかな？",
            "zh": "是说燕的事吗？",
            "narrator_zh": ""
        },
        {
            "location": "55/SEL",
            "narrator": "",
            "text": "$me$は神楽のことが好きなだけだよ",
            "zh": "$me$只是喜欢神乐而已",
            "narrator_zh": ""
        },
        {
            "location": "56/ACT",
            "narrator": "",
            "text": "千羽鶴のこと？",
            "zh": "千羽鹤的事？",
            "narrator_zh": ""
        },
        {
            "location": "57/TALK",
            "narrator": "神楽",
            "text": "そうですね",
            "zh": "是啊",
            "narrator_zh": "神乐"
        },
        {
            "location": "58/ACT",
            "narrator": "",
            "text": "つばめのことかな？",
            "zh": "是说燕的事吗？",
            "narrator_zh": ""
        },
        {
            "location": "59/TALK",
            "narrator": "神楽",
            "text": "いずれ会うことになっていますが",
            "zh": "虽说迟早是会见面的",
            "narrator_zh": "神乐"
        },
        {
            "location": "60/TALK",
            "narrator": "神楽",
            "text": "現段階では接触していません",
            "zh": "现阶段还没有接触",
            "narrator_zh": "神乐"
        },
        {
            "location": "61/ACT",
            "narrator": "",
            "text": "$me$は神楽のことが好きなだけだよ",
            "zh": "$me$只是喜欢神乐而已",
            "narrator_zh": ""
        },
        {
            "location": "62/TALK",
            "narrator": "神楽",
            "text": "あなたの話はしていません",
            "zh": "我说的不是你的事",
            "narrator_zh": "神乐"
        },
        {
            "location": "63/TALK",
            "narrator": "神楽",
            "text": "千羽鶴の話をしています",
            "zh": "我说的是千羽鹤的事",
            "narrator_zh": "神乐"
        },
        {
            "location": "65/TALK",
            "narrator": "神楽",
            "text": "千羽鶴は面倒ではありますが",
            "zh": "千羽鹤虽然确实麻烦",
            "narrator_zh": "神乐"
        },
        {
            "location": "66/TALK",
            "narrator": "神楽",
            "text": "私に接触した理由ははっきりしています",
            "zh": "她接触我的理由倒是很明确",
            "narrator_zh": "神乐"
        },
        {
            "location": "67/TALK",
            "narrator": "神楽",
            "text": "だからそれは構わない",
            "zh": "所以那个没问题",
            "narrator_zh": "神乐"
        },
        {
            "location": "68/TALK",
            "narrator": "神楽",
            "text": "でも",
            "zh": "不过",
            "narrator_zh": "神乐"
        },
        {
            "location": "69/TALK",
            "narrator": "神楽",
            "text": "あなたはなぜ私と関わりを持とうとするんですか？",
            "zh": "那你为什么要主动来和我扯上关系呢？",
            "narrator_zh": "神乐"
        },
        {
            "location": "71/SEL",
            "narrator": "",
            "text": "あなたじゃなくて$handle$って呼んでよ",
            "zh": "别叫“你”了，叫我$handle$吧",
            "narrator_zh": ""
        },
        {
            "location": "72/SEL",
            "narrator": "",
            "text": "神楽が好きだから",
            "zh": "因为喜欢神乐",
            "narrator_zh": ""
        },
        {
            "location": "73/SEL",
            "narrator": "",
            "text": "神楽とラブラブになりたいから（ｷﾘｯ",
            "zh": "因为我想和神乐恩爱（严肃",
            "narrator_zh": ""
        },
        {
            "location": "74/ACT",
            "narrator": "",
            "text": "あなたじゃなくて$handle$って呼んでよ",
            "zh": "别叫“你”了，叫我$handle$吧",
            "narrator_zh": ""
        },
        {
            "location": "75/TALK",
            "narrator": "神楽",
            "text": "いや",
            "zh": "不对",
            "narrator_zh": "神乐"
        },
        {
            "location": "76/TALK",
            "narrator": "神楽",
            "text": "だから",
            "zh": "所以",
            "narrator_zh": "神乐"
        },
        {
            "location": "77/ACT",
            "narrator": "",
            "text": "神楽が好きだから",
            "zh": "因为喜欢神乐",
            "narrator_zh": ""
        },
        {
            "location": "78/TALK",
            "narrator": "神楽",
            "text": "そんなのは",
            "zh": "那种事",
            "narrator_zh": "神乐"
        },
        {
            "location": "79/TALK",
            "narrator": "神楽",
            "text": "理由とは認めない",
            "zh": "我可不承认那算理由",
            "narrator_zh": "神乐"
        },
        {
            "location": "80/ACT",
            "narrator": "",
            "text": "神楽とラブラブになりたいから（ｷﾘｯ",
            "zh": "因为我想和神乐恩爱（严肃",
            "narrator_zh": ""
        },
        {
            "location": "81/TALK",
            "narrator": "神楽",
            "text": "は？",
            "zh": "啊？",
            "narrator_zh": "神乐"
        },
        {
            "location": "82/TALK",
            "narrator": "神楽",
            "text": "寝言にもほどがありますね",
            "zh": "说梦话也得有个限度吧",
            "narrator_zh": "神乐"
        },
        {
            "location": "84/TALK",
            "narrator": "神楽",
            "text": "この世界を作り直したいからとか",
            "zh": "说是想把这个世界上重建一遍之类的",
            "narrator_zh": "神乐"
        },
        {
            "location": "85/TALK",
            "narrator": "神楽",
            "text": "自分の望む世界に改変したいならまだわかります",
            "zh": "如果是想把世界改造成自己期望的样子，倒还算能理解",
            "narrator_zh": "神乐"
        },
        {
            "location": "86/TALK",
            "narrator": "神楽",
            "text": "でもあなたの理由は個人的すぎるし意味もない",
            "zh": "不过你的理由太个人了，也没意义",
            "narrator_zh": "神乐"
        },
        {
            "location": "88/SEL",
            "narrator": "",
            "text": "だって個人的な理由なんだもん",
            "zh": "因为是私人理由嘛",
            "narrator_zh": ""
        },
        {
            "location": "89/SEL",
            "narrator": "",
            "text": "意味はあるよ！",
            "zh": "是有意义的！",
            "narrator_zh": ""
        },
        {
            "location": "90/SEL",
            "narrator": "",
            "text": "$me$と神楽でこの世界を満たしたいだけ",
            "zh": "只是想让$me$和神乐填满这个世界",
            "narrator_zh": ""
        },
        {
            "location": "91/ACT",
            "narrator": "",
            "text": "だって個人的な理由なんだもん",
            "zh": "因为是私人理由嘛",
            "narrator_zh": ""
        },
        {
            "location": "92/TALK",
            "narrator": "神楽",
            "text": "この話をしても平行線のままみたいですね",
            "zh": "就算说这些，好像还是平行线呢",
            "narrator_zh": "神乐"
        },
        {
            "location": "93/TALK",
            "narrator": "神楽",
            "text": "もういいです",
            "zh": "不用了",
            "narrator_zh": "神乐"
        },
        {
            "location": "94/ACT",
            "narrator": "",
            "text": "意味はあるよ！",
            "zh": "是有意义的！",
            "narrator_zh": ""
        },
        {
            "location": "95/TALK",
            "narrator": "神楽",
            "text": "私にとってはないです",
            "zh": "对我来说毫无意义",
            "narrator_zh": "神乐"
        },
        {
            "location": "96/ACT",
            "narrator": "",
            "text": "$me$と神楽でこの世界を満たしたいだけ",
            "zh": "只是想让$me$和神乐填满这个世界",
            "narrator_zh": ""
        },
        {
            "location": "97/TALK",
            "narrator": "神楽",
            "text": "はぁぁぁぁぁ！？",
            "zh": "哈啊啊啊啊啊！？",
            "narrator_zh": "神乐"
        },
        {
            "location": "98/TALK",
            "narrator": "神楽",
            "text": "何それ",
            "zh": "那是什么",
            "narrator_zh": "神乐"
        },
        {
            "location": "100/TALK",
            "narrator": "神楽",
            "text": "ぶっちゃけキモいですあなた",
            "zh": "老实说你很恶心啊",
            "narrator_zh": "神乐"
        },
        {
            "location": "101/TALK",
            "narrator": "神楽",
            "text": "ちゃんと私に納得のいく説明もできないのにそんなことばかり言って",
            "zh": "连让我信服的解释都给不出，还说那种话",
            "narrator_zh": "神乐"
        },
        {
            "location": "102/TALK",
            "narrator": "神楽",
            "text": "こうやって私はちゃんとあなたと会話しようとしているのに",
            "zh": "我明明像这样在好好跟你对话",
            "narrator_zh": "神乐"
        },
        {
            "location": "103/TALK",
            "narrator": "神楽",
            "text": "もういいです",
            "zh": "不用了",
            "narrator_zh": "神乐"
        }
    ]
