{
    "dir": "chap09/battle/btev_ch01_09_02.js",
    "type": "",
    "info": {
        "story_id": "21018",
        "cid": "",
        "title": "018 ココロスフィアストーリー【Lv06】",
        "sub_title": "チャプター９＜帰結＞",
        "title_zh": "018 心灵领域故事【Lv06】",
        "sub_title_zh": "第9章＜归结＞"
    },
    "entry": [
        {
            "location": "6/SCENARIO",
            "narrator": "",
            "text": "微笑の裏にあるものは",
            "zh": "微笑背后隐藏着什么",
            "narrator_zh": ""
        },
        {
            "location": "25/TALK",
            "narrator": "潜在つばめ",
            "text": "なるほど、\n大したものだよ。",
            "zh": "原来如此，\n真有两下子。",
            "narrator_zh": "潜在燕"
        },
        {
            "location": "26/TALK",
            "narrator": "潜在つばめ",
            "text": "まさか深層世界でも\nあなたに負けるなんて。",
            "zh": "没想到在深层世界\n也会输给你。",
            "narrator_zh": "潜在燕"
        },
        {
            "location": "27/TALK",
            "narrator": "表層つばめ",
            "text": "続き、\n見せてくれるよね？",
            "zh": "后面的，\n会给我看吧？",
            "narrator_zh": "表层燕"
        },
        {
            "location": "28/TALK",
            "narrator": "潜在つばめ",
            "text": "もちろんだよ。\nそれはココロの中の\n約束事だもん。",
            "zh": "当然呀。\n这是心里的\n约定。",
            "narrator_zh": "潜在燕"
        },
        {
            "location": "29/TALK",
            "narrator": "潜在つばめ",
            "text": "でも何度も言うけど、\n知った後の気持ちの\n処理は自己責任で。",
            "zh": "不过我再说一遍，\n知道之后的心情\n怎么处理，后果自负。",
            "narrator_zh": "潜在燕"
        },
        {
            "location": "30/TALK",
            "narrator": "潜在つばめ",
            "text": "それだけは、\nよろしくね。",
            "zh": "这一点，\n拜托你了。",
            "narrator_zh": "潜在燕"
        },
        {
            "location": "31/TALK",
            "narrator": "表層つばめ",
            "text": "……うん。",
            "zh": "……嗯。",
            "narrator_zh": "表层燕"
        },
        {
            "location": "52/DIALOG",
            "narrator": "",
            "text": "静岡での高校入学後、\n初めてできた友達と帰宅中、\nそのうちの一人がスマホを\n池に落としてしまった。\n\nそしてその翌日のこと――",
            "zh": "在静冈上高中后，\n和第一次交到的朋友回家时，\n其中一个人把手机\n掉进了池塘里。\n\n然后到了第二天——",
            "narrator_zh": ""
        },
        {
            "location": "54/TALK",
            "narrator": "つばめ",
            "text": "おはよう！",
            "zh": "早上好！",
            "narrator_zh": "燕"
        },
        {
            "location": "55/TALK",
            "narrator": "女子高校生Ａ",
            "text": "あ、おはよー、\nつばめちゃん。",
            "zh": "啊，早呀——，\n燕。",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "56/TALK",
            "narrator": "つばめ",
            "text": "あ、っと……",
            "zh": "啊，那个……",
            "narrator_zh": "燕"
        },
        {
            "location": "61/TALK",
            "narrator": "つばめ",
            "text": "これ！\n見つけたよ！",
            "zh": "这个！\n我找到了！",
            "narrator_zh": "燕"
        },
        {
            "location": "62/TALK",
            "narrator": "女子高校生Ａ",
            "text": "え…",
            "zh": "诶……",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "63/TALK",
            "narrator": "女子高校生Ａ",
            "text": "ええええっ！！\nそれって昨日落とした\n私のスマホ！？",
            "zh": "诶诶诶诶！！\n那不是昨天掉的\n我的手机吗！？",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "65/TALK",
            "narrator": "つばめ",
            "text": "うんっ！\n見つかって良かったよ。",
            "zh": "嗯！\n能找到真是太好了。",
            "narrator_zh": "燕"
        },
        {
            "location": "66/TALK",
            "narrator": "女子高校生Ａ",
            "text": "いや……その…\nでも、あのため池、\n超汚くなかった？",
            "zh": "不……那个……\n可是，那个池塘\n不是脏得要命吗？",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "67/TALK",
            "narrator": "つばめ",
            "text": "ちょっと、だけ、\nえへへ…",
            "zh": "就一点点，\n诶嘿嘿……",
            "narrator_zh": "燕"
        },
        {
            "location": "68/TALK",
            "narrator": "つばめ",
            "text": "ああでも大丈夫だよ！\nお風呂で念入りに\n身体洗ったし！",
            "zh": "啊，不过没事的！\n我在浴室里仔细\n洗过澡了！",
            "narrator_zh": "燕"
        },
        {
            "location": "69/TALK",
            "narrator": "つばめ",
            "text": "臭くないよね？",
            "zh": "不臭吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "70/TALK",
            "narrator": "女子高校生Ａ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "71/TALK",
            "narrator": "女子高校生Ａ",
            "text": "あり……がとう……",
            "zh": "谢……谢你……",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "72/TALK",
            "narrator": "つばめ",
            "text": "…どうしたの？",
            "zh": "……怎么了？",
            "narrator_zh": "燕"
        },
        {
            "location": "73/TALK",
            "narrator": "女子高校生Ａ",
            "text": "はぁ…。\nちょっと待って。",
            "zh": "哈啊……。\n等一下。",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "77/TALK",
            "narrator": "女子高校生Ａ",
            "text": "はいこれ。\n約束の１万円。\nこれでいい？",
            "zh": "给，这个。\n说好的一万日元。\n这样可以吧？",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "79/TALK",
            "narrator": "つばめ",
            "text": "ええええっ！！\nいいいいらないよ！",
            "zh": "诶诶诶诶！！\n不、不用的！",
            "narrator_zh": "燕"
        },
        {
            "location": "80/TALK",
            "narrator": "女子高校生Ａ",
            "text": "え？\nなんで？",
            "zh": "诶？\n为什么？",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "81/TALK",
            "narrator": "つばめ",
            "text": "わたしは、みさき\nちゃんが喜んでくれ\nたらってそれだけで…",
            "zh": "我只是想着，\n只要美咲能高兴，\n那样就……",
            "narrator_zh": "燕"
        },
        {
            "location": "82/TALK",
            "narrator": "つばめ",
            "text": "とにかく、見つかって\n良かったよ。\nそれじゃまた後でね！",
            "zh": "总之，能找到\n真是太好了。\n那就回头见！",
            "narrator_zh": "燕"
        },
        {
            "location": "86/TALK",
            "narrator": "女子高校生Ａ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "88/TALK",
            "narrator": "女子高校生Ｂ",
            "text": "おはよー！",
            "zh": "早上好——！",
            "narrator_zh": "女高中生B"
        },
        {
            "location": "89/TALK",
            "narrator": "女子高校生Ｂ",
            "text": "って、あれ？\nどうしたの？",
            "zh": "诶，咦？\n怎么了？",
            "narrator_zh": "女高中生B"
        },
        {
            "location": "90/TALK",
            "narrator": "女子高校生Ａ",
            "text": "いや、\nつばめちゃんがさ……",
            "zh": "没什么，\n燕她呀……",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "99/TALK",
            "narrator": "女子高校生Ｂ",
            "text": "ええっ！\nマジで？\n信じらんない。",
            "zh": "诶诶！\n真的假的？\n不敢相信。",
            "narrator_zh": "女高中生B"
        },
        {
            "location": "100/TALK",
            "narrator": "女子高校生Ｂ",
            "text": "で、そのスマホ\nどうすんの？",
            "zh": "那，那部手机\n打算怎么办？",
            "narrator_zh": "女高中生B"
        },
        {
            "location": "101/TALK",
            "narrator": "女子高校生Ａ",
            "text": "使わないよ、\n新しいの買って\nもらっちゃったし。",
            "zh": "不用啦，\n家里已经给我买\n新的了。",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "102/TALK",
            "narrator": "女子高校生Ａ",
            "text": "それに汚いじゃん…？",
            "zh": "而且也很脏吧……？",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "103/TALK",
            "narrator": "女子高校生Ｂ",
            "text": "だよねー！",
            "zh": "就是说呀！",
            "narrator_zh": "女高中生B"
        },
        {
            "location": "104/TALK",
            "narrator": "女子高校生Ａ",
            "text": "つばめちゃんってさぁ、\nなんかちょっと別の\n世界に生きてるよね。",
            "zh": "燕那个人呀，\n总觉得有点活在\n另一个世界呢。",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "105/TALK",
            "narrator": "女子高校生Ｂ",
            "text": "あそうそうそう！\n私もそう思ってたん\nだよね！！",
            "zh": "啊对对对！\n我也这么\n觉得的！！",
            "narrator_zh": "女高中生B"
        },
        {
            "location": "106/TALK",
            "narrator": "女子高校生Ａ",
            "text": "やっていける自信\nないわー。\n眩しすぎて！",
            "zh": "我可没信心\n跟她处下去。\n耀眼过头了！",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "107/TALK",
            "narrator": "女子高校生Ｂ",
            "text": "同感～～。\n気が合うねえ。",
            "zh": "同感～～。\n我们真合得来呀。",
            "narrator_zh": "女高中生B"
        },
        {
            "location": "108/TALK",
            "narrator": "女子高校生Ｂ",
            "text": "みさきちゃんとは\nズッ友でいられそう。",
            "zh": "感觉能和美咲\n做一辈子的朋友呢。",
            "narrator_zh": "女高中生B"
        },
        {
            "location": "109/TALK",
            "narrator": "女子高校生Ａ",
            "text": "ズッ友だよー。\n当然じゃん。",
            "zh": "是一辈子的朋友呀——。\n这还用说嘛。",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "110/TALK",
            "narrator": "女子高校生Ｂ",
            "text": "あはは～よかった！",
            "zh": "啊哈哈～太好了！",
            "narrator_zh": "女高中生B"
        },
        {
            "location": "112/TALK",
            "narrator": "女子高校生Ｂ",
            "text": "あ、そうだ！\n今日学校終わったらさ、\n二人で――",
            "zh": "啊，对了！\n今天放学之后，\n我们两个——",
            "narrator_zh": "女高中生B"
        },
        {
            "location": "135/TALK",
            "narrator": "潜在つばめ",
            "text": "…どうかな？\n何かのヒントに\nなった？",
            "zh": "……怎么样？\n有没有成为\n什么线索？",
            "narrator_zh": "潜在燕"
        },
        {
            "location": "136/TALK",
            "narrator": "表層つばめ",
            "text": "わからない。\nでも……",
            "zh": "不知道。\n可是……",
            "narrator_zh": "表层燕"
        },
        {
            "location": "137/TALK",
            "narrator": "表層つばめ",
            "text": "わたしのこと、\n後であんな風に\n話されてたんだ。",
            "zh": "我的事，\n后来竟然被她们\n那样议论了呀。",
            "narrator_zh": "表层燕"
        },
        {
            "location": "138/TALK",
            "narrator": "表層つばめ",
            "text": "全然忘れてたよ。",
            "zh": "我完全忘了。",
            "narrator_zh": "表层燕"
        },
        {
            "location": "139/TALK",
            "narrator": "潜在つばめ",
            "text": "忘れてたわけじゃ\nないよ。",
            "zh": "并不是\n忘掉了。",
            "narrator_zh": "潜在燕"
        },
        {
            "location": "140/TALK",
            "narrator": "潜在つばめ",
            "text": "心の奥で繋がってる\n集合的無意識から拾っ\nてきちゃってるだけ。",
            "zh": "只是从连在心底的\n集体无意识里\n捡出来的而已。",
            "narrator_zh": "潜在燕"
        },
        {
            "location": "141/TALK",
            "narrator": "潜在つばめ",
            "text": "そういうことも\nあるんだよ。",
            "zh": "也会有\n这种事的。",
            "narrator_zh": "潜在燕"
        },
        {
            "location": "142/TALK",
            "narrator": "潜在つばめ",
            "text": "だから「ヒントだけで\n済めばいいけど」って\n言ったの。",
            "zh": "所以我才说过\n“但愿只当作线索\n就够了”。",
            "narrator_zh": "潜在燕"
        },
        {
            "location": "143/TALK",
            "narrator": "表層つばめ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "表层燕"
        },
        {
            "location": "145/TALK",
            "narrator": "潜在つばめ",
            "text": "…と、わたしそろそろ\nエネルギー切れみたい。",
            "zh": "……好了，我好像也\n快没能量了。",
            "narrator_zh": "潜在燕"
        },
        {
            "location": "147/TALK",
            "narrator": "潜在つばめ",
            "text": "約束はちゃんと\n果たしたよね。",
            "zh": "约定已经\n好好履行了哦。",
            "narrator_zh": "潜在燕"
        },
        {
            "location": "148/TALK",
            "narrator": "潜在つばめ",
            "text": "あとはじっくり\n考えてみるといいと\n思うよ。",
            "zh": "剩下的，\n我觉得你好好\n想一想就行。",
            "narrator_zh": "潜在燕"
        },
        {
            "location": "164/TALK",
            "narrator": "表層つばめ",
            "text": "わたし……",
            "zh": "我……",
            "narrator_zh": "表层燕"
        },
        {
            "location": "165/SEL",
            "narrator": "（選択肢）",
            "text": "つばめ、かわいい！",
            "zh": "燕，好可爱！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "166/SEL",
            "narrator": "（選択肢）",
            "text": "純粋すぎるんだね",
            "zh": "你太纯粹了呀",
            "narrator_zh": "（选项）"
        },
        {
            "location": "167/SEL",
            "narrator": "（選択肢）",
            "text": "確かに引くわ、これは",
            "zh": "这确实让人想躲开",
            "narrator_zh": "（选项）"
        },
        {
            "location": "168/ACT",
            "narrator": "",
            "text": "つばめ、かわいい！",
            "zh": "燕，好可爱！",
            "narrator_zh": ""
        },
        {
            "location": "170/TALK",
            "narrator": "表層つばめ",
            "text": "ええええっ！\nなんでそうなるの？",
            "zh": "诶诶诶诶！\n怎么会变成这样？",
            "narrator_zh": "表层燕"
        },
        {
            "location": "171/SEL",
            "narrator": "（選択肢）",
            "text": "今のでもっとつばめが好きになった",
            "zh": "刚才那样，我更喜欢燕了",
            "narrator_zh": "（选项）"
        },
        {
            "location": "172/ACT",
            "narrator": "",
            "text": "今のでもっとつばめが好きになった",
            "zh": "刚才那样，我更喜欢燕了",
            "narrator_zh": ""
        },
        {
            "location": "174/TALK",
            "narrator": "表層つばめ",
            "text": "そ、そうなの？\nよくわかんないけど―",
            "zh": "是、是吗？\n我不太明白——",
            "narrator_zh": "表层燕"
        },
        {
            "location": "176/TALK",
            "narrator": "表層つばめ",
            "text": "でも、あんだけ困って\nたら、助けたいって\n思わないのかな。",
            "zh": "可是，看她那么为难，\n难道不会想\n帮她吗。",
            "narrator_zh": "表层燕"
        },
        {
            "location": "177/SEL",
            "narrator": "（選択肢）",
            "text": "なるよ！",
            "zh": "会的！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "178/SEL",
            "narrator": "（選択肢）",
            "text": "人によるかな",
            "zh": "看人吧",
            "narrator_zh": "（选项）"
        },
        {
            "location": "179/ACT",
            "narrator": "",
            "text": "なるよ！",
            "zh": "会的！",
            "narrator_zh": ""
        },
        {
            "location": "180/TALK",
            "narrator": "表層つばめ",
            "text": "そっか、\n少し安心したよ。",
            "zh": "是吗，\n稍稍安心了。",
            "narrator_zh": "表层燕"
        },
        {
            "location": "181/TALK",
            "narrator": "表層つばめ",
            "text": "わたしだけ\n何かおかしいのかと\n思っちゃってた。",
            "zh": "我还以为\n只有我\n哪里不对劲呀。",
            "narrator_zh": "表层燕"
        },
        {
            "location": "182/ACT",
            "narrator": "",
            "text": "人によるかな",
            "zh": "看人吧",
            "narrator_zh": ""
        },
        {
            "location": "183/TALK",
            "narrator": "表層つばめ",
            "text": "そっか。確かに、\n人それぞれだもんね。",
            "zh": "是吗。确实，\n每个人都不一样呀。",
            "narrator_zh": "表层燕"
        },
        {
            "location": "185/ACT",
            "narrator": "",
            "text": "純粋すぎるんだね",
            "zh": "你太纯粹了呀",
            "narrator_zh": ""
        },
        {
            "location": "186/TALK",
            "narrator": "表層つばめ",
            "text": "そんなことないよ。\nわたし、そんなに\n綺麗じゃないよ？",
            "zh": "才没有。\n我才没有\n那么纯洁呀？",
            "narrator_zh": "表层燕"
        },
        {
            "location": "187/TALK",
            "narrator": "表層つばめ",
            "text": "すぐに怒っちゃうし、\nいやなことも\n考えちゃうし……",
            "zh": "动不动就生气，\n也会胡思乱想\n讨厌的事……",
            "narrator_zh": "表层燕"
        },
        {
            "location": "188/SEL",
            "narrator": "（選択肢）",
            "text": "普通だよ",
            "zh": "很普通呀",
            "narrator_zh": "（选项）"
        },
        {
            "location": "189/ACT",
            "narrator": "",
            "text": "普通だよ",
