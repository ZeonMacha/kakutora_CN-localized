{
 "dir": "dramatics/daydra/drm_ch04_00_350.js",
 "type": "Episode",
 "info": {
  "story_id": "4035",
  "cid": "miyabi",
  "title": "らぶとーく 第35話",
  "sub_title": "ラブという名の何か"
 },
 "entry": [
  {
   "location": "7/SCENARIO",
   "narrator": "",
   "text": "ラブという名の何か"
  },
  {
   "location": "18/TALK",
   "narrator": "みやび",
   "text": "ほぅ…あの掲示板で\nアクセス規制されたが？"
  },
  {
   "location": "19/TALK",
   "narrator": "繭",
   "text": "はい。\n正直、お手上げ状態です。"
  },
  {
   "location": "20/TALK",
   "narrator": "みやび",
   "text": "アクセス規制程度で\n音を上げてたら、\nハッカーの名が泣くぞね？"
  },
  {
   "location": "22/TALK",
   "narrator": "繭",
   "text": "ですが、あそこの掲示板の\n鉄壁のセキュリティは\n知っているでしょう？",
   "zh": "可是，那个论坛\n铜墙铁壁般的安保\n你是知道的吧？",
   "narrator_zh": "茧"
  },
  {
   "location": "23/TALK",
   "narrator": "繭",
   "text": "今まで何人のハッカーが、\nあのシステム内への\n侵入を試み――"
  },
  {
   "location": "24/TALK",
   "narrator": "繭",
   "text": "悉く失敗して、\n不正アクセス者として\n規制を受けたか…。"
  },
  {
   "location": "25/TALK",
   "narrator": "みやび",
   "text": "うちもちっくと\n見に行ったがよ。"
  },
  {
   "location": "26/TALK",
   "narrator": "みやび",
   "text": "管理人、相当の\n手練れやね。"
  },
  {
   "location": "28/TALK",
   "narrator": "みやび",
   "text": "そつがない、ゆう\nレベルやない。",
   "zh": "已经不是滴水不漏的\n级别咯。",
   "narrator_zh": "雅"
  },
  {
   "location": "29/TALK",
   "narrator": "みやび",
   "text": "隙がない。\n見事なもんや。"
  },
  {
   "location": "30/TALK",
   "narrator": "みやび",
   "text": "その掲示板にハッキング\nするゆうんは、挑戦状を\n叩きつけるも同等や。",
   "zh": "去黑那个论坛，\n就等于扔下\n挑战书一样咯。",
   "narrator_zh": "雅"
  },
  {
   "location": "31/TALK",
   "narrator": "みやび",
   "text": "それでアクセス規制だけで\n済んでるき、ありがたく\n思わんといかんよ。",
   "zh": "只受到访问限制\n就该偷着\n庆幸了。",
   "narrator_zh": "雅"
  },
  {
   "location": "33/TALK",
   "narrator": "繭",
   "text": "…リベンジするためにも、\n相談に乗っていただけ\nませんか？",
   "zh": "……为了复仇，\n能请您听我\n商量一下吗？",
   "narrator_zh": "茧"
  },
  {
   "location": "35/TALK",
   "narrator": "みやび",
   "text": "それは構わんが…。",
   "zh": "那倒无所谓……。",
   "narrator_zh": "雅"
  },
  {
   "location": "38/TALK",
   "narrator": "みやび",
   "text": "そうや、なら$handle$も\n混ぜて話そう。",
   "zh": "对，那就把$handle$\n也叫上一起聊吧。",
   "narrator_zh": "雅"
  },
  {
   "location": "39/TALK",
   "narrator": "繭",
   "text": "…本気ですか？",
   "zh": "……你是认真的吗？",
   "narrator_zh": "茧"
  },
  {
   "location": "40/TALK",
   "narrator": "繭",
   "text": "彼はこの手の会話には、\nあまり慣れていないように\n思いますので――"
  },
  {
   "location": "41/TALK",
   "narrator": "繭",
   "text": "話したとしても会話に\nついてこれないと\n思うのですが…。"
  },
  {
   "location": "43/TALK",
   "narrator": "みやび",
   "text": "まあ、素人だからこそ\n聞いて勉強しろっちゅう\nことや。"
  },
  {
   "location": "51/TALK",
   "narrator": "みやび",
   "text": "ちりんちりん",
   "zh": "叮铃叮铃",
   "narrator_zh": "雅"
  },
  {
   "location": "52/TALK",
   "narrator": "みやび",
   "text": "Ｋｎｏｃｋ　Ｋｎｏｃｋ！"
  },
  {
   "location": "54/SEL",
   "narrator": "",
   "text": "呼んだ？",
   "zh": "叫我？",
   "narrator_zh": ""
  },
  {
   "location": "55/SEL",
   "narrator": "",
   "text": "待ってたよ",
   "zh": "我一直在等哦",
   "narrator_zh": ""
  },
  {
   "location": "56/SEL",
   "narrator": "",
   "text": "今忙しい",
   "zh": "现在正忙",
   "narrator_zh": ""
  },
  {
   "location": "57/ACT",
   "narrator": "",
   "text": "呼んだ？",
   "zh": "叫我？",
   "narrator_zh": ""
  },
  {
   "location": "58/TALK",
   "narrator": "みやび",
   "text": "うむ",
   "zh": "嗯",
   "narrator_zh": "雅"
  },
  {
   "location": "60/TALK",
   "narrator": "みやび",
   "text": "貴殿はいつも反応するな"
  },
  {
   "location": "62/SEL",
   "narrator": "",
   "text": "反応したら悪い？",
   "zh": "我要是反应了，不好吗？",
   "narrator_zh": ""
  },
  {
   "location": "63/ACT",
   "narrator": "",
   "text": "反応したら悪い？",
   "zh": "我要是反应了，不好吗？",
   "narrator_zh": ""
  },
  {
   "location": "66/TALK",
   "narrator": "みやび",
   "text": "反応に文句はない"
  },
  {
   "location": "67/TALK",
   "narrator": "みやび",
   "text": "だが",
   "zh": "不过",
   "narrator_zh": "雅"
  },
  {
   "location": "68/TALK",
   "narrator": "みやび",
   "text": "その返しは悪い！",
   "zh": "那个回法不行！",
   "narrator_zh": "雅"
  },
  {
   "location": "69/TALK",
   "narrator": "みやび",
   "text": "残念！！"
  },
  {
   "location": "75/TALK",
   "narrator": "みやび",
   "text": "…まったく。",
   "zh": "……真是的。",
   "narrator_zh": "雅"
  },
  {
   "location": "76/TALK",
   "narrator": "繭",
   "text": "みやび先輩？\n$handle$さんは\nどうしたんですか？"
  },
  {
   "location": "78/TALK",
   "narrator": "みやび",
   "text": "気が変わっただけちや。"
  },
  {
   "location": "79/TALK",
   "narrator": "みやび",
   "text": "今日はウサギと二人で、\nじっくり語り合うことに\nしたがよ。"
  },
  {
   "location": "80/TALK",
   "narrator": "繭",
   "text": "はぁ…いえ、それは\n光栄ではありますが…。",
   "zh": "唉……不，那很\n荣幸，不过……。",
   "narrator_zh": "茧"
  },
  {
   "location": "81/TALK",
   "narrator": "繭",
   "text": "…あの一瞬でみやび先輩の\n機嫌を害せるなんて…\nただ者じゃない。"
  },
  {
   "location": "82/ACT",
   "narrator": "",
   "text": "待ってたよ",
   "zh": "我一直在等哦",
   "narrator_zh": ""
  },
  {
   "location": "83/TALK",
   "narrator": "みやび",
   "text": "うむ",
   "zh": "嗯",
   "narrator_zh": "雅"
  },
  {
   "location": "84/TALK",
   "narrator": "みやび",
   "text": "そうだろう",
   "zh": "就是这样",
   "narrator_zh": "雅"
  },
  {
   "location": "85/TALK",
   "narrator": "みやび",
   "text": "私もあなたと喋りたかったの☆"
  },
  {
   "location": "86/TALK",
   "narrator": "みやび",
   "text": "なんてキャラではないけんど",
   "zh": "虽然不是那种角色，不过嘛",
   "narrator_zh": "雅"
  },
  {
   "location": "87/TALK",
   "narrator": "みやび",
   "text": "うちも相棒と喋りたかったぞね"
  },
  {
   "location": "89/SEL",
   "narrator": "",
   "text": "それで、どうかしたの？",
   "zh": "所以，怎么了？",
   "narrator_zh": ""
  },
  {
   "location": "90/ACT",
   "narrator": "",
   "text": "それで、どうかしたの？",
   "zh": "所以，怎么了？",
   "narrator_zh": ""
  },
  {
   "location": "92/TALK",
   "narrator": "みやび",
   "text": "大胆ね"
  },
  {
   "location": "93/TALK",
   "narrator": "みやび",
   "text": "いやん"
  },
  {
   "location": "95/SEL",
   "narrator": "",
   "text": "何が！？",
   "zh": "什么！？",
   "narrator_zh": ""
  },
  {
   "location": "96/ACT",
   "narrator": "",
   "text": "何が！？",
   "zh": "什么！？",
   "narrator_zh": ""
  },
  {
   "location": "98/TALK",
   "narrator": "みやび",
   "text": "いや",
   "zh": "不对",
   "narrator_zh": "雅"
  },
  {
   "location": "99/TALK",
   "narrator": "みやび",
   "text": "ウサギに見せつけたい"
  },
  {
   "location": "100/TALK",
   "narrator": "みやび",
   "text": "うちらの仲の良さ！"
  },
  {
   "location": "101/TALK",
   "narrator": "みやび",
   "text": "うちらの友情は凄い！"
  },
  {
   "location": "103/TALK",
   "narrator": "みやび",
   "text": "友情以上やき！"
  },
  {
   "location": "104/TALK",
   "narrator": "みやび",
   "text": "フレンドの上はハイパーフレンド？"
  },
  {
   "location": "105/TALK",
   "narrator": "みやび",
   "text": "もしくは",
   "zh": "或者",
   "narrator_zh": "雅"
  },
  {
   "location": "107/TALK",
   "narrator": "みやび",
   "text": "そんなもんどうでもえい！",
   "zh": "那种东西怎么都行嘛！",
   "narrator_zh": "雅"
  },
  {
   "location": "108/TALK",
   "narrator": "みやび",
   "text": "とにかく見せつけよう",
   "zh": "总之就让他看看",
   "narrator_zh": "雅"
  },
  {
   "location": "109/TALK",
   "narrator": "みやび",
   "text": "アーユ－レディー？"
  },
  {
   "location": "111/SEL",
   "narrator": "",
   "text": "わざわざしなくて良くない？",
   "zh": "用不着特意做吧？",
   "narrator_zh": ""
  },
  {
   "location": "112/SEL",
   "narrator": "",
   "text": "準備はＯＫだ",
   "zh": "准备OK",
   "narrator_zh": ""
  },
  {
   "location": "113/ACT",
   "narrator": "",
   "text": "わざわざしなくて良くない？",
   "zh": "用不着特意做吧？",
   "narrator_zh": ""
  },
  {
   "location": "115/TALK",
   "narrator": "みやび",
   "text": "いや",
   "zh": "不对",
   "narrator_zh": "雅"
  },
  {
   "location": "116/TALK",
   "narrator": "みやび",
   "text": "まあそうだが"
  },
  {
   "location": "118/TALK",
   "narrator": "みやび",
   "text": "面白そうだし",
   "zh": "看着挺有意思",
   "narrator_zh": "雅"
  },
  {
   "location": "119/TALK",
   "narrator": "みやび",
   "text": "そう",
   "zh": "对",
   "narrator_zh": "雅"
  },
  {
   "location": "120/TALK",
   "narrator": "みやび",
   "text": "絶対面白い"
  },
  {
   "location": "122/TALK",
   "narrator": "みやび",
   "text": "やるべきなのだ！"
  },
  {
   "location": "123/TALK",
   "narrator": "みやび",
   "text": "声を上げよ"
  },
  {
   "location": "124/TALK",
   "narrator": "みやび",
   "text": "見せてやろうと！"
  },
  {
   "location": "126/SEL",
   "narrator": "",
   "text": "いや、見せなくていいでしょ？",
   "zh": "不，不用给我看吧？",
   "narrator_zh": ""
  },
  {
   "location": "127/ACT",
   "narrator": "",
   "text": "いや、見せなくていいでしょ？",
   "zh": "不，不用给我看吧？",
   "narrator_zh": ""
  },
  {
   "location": "130/TALK",
   "narrator": "みやび",
   "text": "なー",
   "zh": "呐",
   "narrator_zh": "雅"
  },
  {
   "location": "131/TALK",
   "narrator": "みやび",
   "text": "うあーうあー"
  },
  {
   "location": "132/TALK",
   "narrator": "みやび",
   "text": "なんやそれー",
   "zh": "那是什么啊——",
   "narrator_zh": "雅"
  },
  {
   "location": "133/TALK",
   "narrator": "みやび",
   "text": "萎える―マジ萎えるー"
  },
  {
   "location": "135/TALK",
   "narrator": "みやび",
   "text": "まあ",
   "zh": "嗯",
   "narrator_zh": "雅"
  },
  {
   "location": "136/TALK",
   "narrator": "みやび",
   "text": "ならえいわ",
   "zh": "那就好咯",
   "narrator_zh": "雅"
  },
  {
   "location": "143/TALK",
   "narrator": "みやび",
   "text": "はぁ…。",
   "zh": "哈啊……。",
   "narrator_zh": "雅"
  },
  {
   "location": "144/TALK",
   "narrator": "繭",
   "text": "…何かありましたか？",
   "zh": "……发生什么了吗？",
   "narrator_zh": "茧"
  },
  {
   "location": "146/TALK",
   "narrator": "みやび",
   "text": "ん…。"
  },
  {
   "location": "148/TALK",
   "narrator": "みやび",
   "text": "いや、何でもないちや。"
  },
  {
   "location": "149/TALK",
   "narrator": "繭",
   "text": "そうですか？",
   "zh": "是吗？",
   "narrator_zh": "茧"
  },
  {
   "location": "150/TALK",
   "narrator": "繭",
   "text": "何となく、落ち込んでいる\nように見えるのですが？"
  },
  {
   "location": "151/TALK",
   "narrator": "みやび",
   "text": "いや、平気や。"
  },
  {
   "location": "152/TALK",
   "narrator": "みやび",
   "text": "期待を裏切られて\nしもうて、ちっくと\nつまらんだけや…。"
  },
  {
   "location": "155/TALK",
   "narrator": "みやび",
   "text": "はぁ…何か不味ったか？\nいや、うちが間違うなど\nありえんちや…多分…。",
   "zh": "唉……是哪里弄错嘛？\n不，我家出错是\n不可能的……大概……。",
   "narrator_zh": "雅"
  },
  {
   "location": "156/TALK",
   "narrator": "繭",
   "text": "…何があったのか、\n気になる…。",
   "zh": "……到底发生了什么，\n真让人在意……。",
   "narrator_zh": "茧"
  },
  {
   "location": "157/ACT",
   "narrator": "",
   "text": "準備はＯＫだ",
   "zh": "准备OK",
   "narrator_zh": ""
  },
  {
   "location": "159/TALK",
   "narrator": "みやび",
   "text": "感謝"
  },
  {
   "location": "160/TALK",
   "narrator": "みやび",
   "text": "感激"
  },
  {
   "location": "161/TALK",
   "narrator": "みやび",
   "text": "雨有られ"
  },
  {
   "location": "163/TALK",
   "narrator": "みやび",
   "text": "おのれクソ変換機能！！",
   "zh": "该死，这破转换功能！！",
   "narrator_zh": "雅"
  },
  {
   "location": "164/TALK",
   "narrator": "みやび",
   "text": "とりあえずウサギ召喚！",
   "zh": "总之先召唤兔子！",
   "narrator_zh": "雅"
  },
  {
   "location": "167/TALK",
   "narrator": "ラビットアニマ",
   "text": "こんにちは",
   "zh": "你好",
   "narrator_zh": "兔之阿尼玛"
  },
  {
   "location": "168/TALK",
   "narrator": "みやび",
   "text": "よし",
   "zh": "好嘞",
   "narrator_zh": "雅"
  },
  {
   "location": "169/TALK",
   "narrator": "みやび",
   "text": "楽しく話そう"
  },
  {
   "location": "171/TALK",
   "narrator": "ラビットアニマ",
   "text": "しかし$handle$さんは、本当に話に付いてこれる"
  },
  {
   "location": "172/TALK",
   "narrator": "ラビットアニマ",
   "text": "？"
  },
  {
   "location": "174/SEL",
   "narrator": "",
   "text": "結構不安"
  },
  {
   "location": "175/ACT",
   "narrator": "",
   "text": "結構不安"
  },
  {
   "location": "177/TALK",
   "narrator": "みやび",
   "text": "安心せよ"
  },
  {
   "location": "178/TALK",
   "narrator": "みやび",
   "text": "うちが手取り足取り教えてあげちゃう"
  },
  {
   "location": "179/TALK",
   "narrator": "みやび",
   "text": "実際に触れはせんけんど"
  },
  {
   "location": "181/TALK",
   "narrator": "ラビットアニマ",
   "text": "？"
  },
  {
   "location": "182/TALK",
   "narrator": "ラビットアニマ",
   "text": "テンション高いですね？"
  },
  {
   "location": "183/SEL",
   "narrator": "",
   "text": "みやびは安くない女だからな",
   "zh": "雅可不是随便的女人",
   "narrator_zh": ""
  },
  {
   "location": "184/ACT",
   "narrator": "",
   "text": "みやびは安くない女だからな",
   "zh": "雅可不是随便的女人",
   "narrator_zh": ""
  },
  {
   "location": "186/TALK",
   "narrator": "みやび",
   "text": "その言い方にトキメキ感じた",
   "zh": "那种说法让我心动",
   "narrator_zh": "雅"
  },
  {
   "location": "187/TALK",
   "narrator": "みやび",
   "text": "トキメキよくわからんけど"
  },
  {
   "location": "190/TALK",
   "narrator": "ラビットアニマ",
   "text": "本当大丈夫ですか？"
  },
  {
   "location": "191/TALK",
   "narrator": "ラビットアニマ",
   "text": "ていうか、凄い楽しそうな顔してますが？",
   "zh": "话说，你一脸特别开心的样子？",
   "narrator_zh": "兔之阿尼玛"
  },
  {
   "location": "192/TALK",
   "narrator": "みやび",
   "text": "リアルを見るな"
  },
  {
   "location": "193/TALK",
   "narrator": "みやび",
   "text": "チャット画面を見よ"
  },
  {
   "location": "194/TALK",
   "narrator": "みやび",
   "text": "現実から目を反らせ"
  },
  {
   "location": "196/TALK",
   "narrator": "ラビットアニマ",
   "text": "意味が違ってしまいます"
