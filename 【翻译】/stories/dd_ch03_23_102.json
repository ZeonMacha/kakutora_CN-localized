{
    "dir": "chap23/daydra/dd_ch03_23_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "23305",
        "cid": "gabriella",
        "title": "005 メインストーリー",
        "sub_title": "銃撃発言＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "枪击发言＜后篇＞"
    },
    "entry": [
        {
            "location": "1011/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…やめやめ。",
            "zh": "哈啊……算了算了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1012/TALK",
            "narrator": "ガブリエラ",
            "text": "気持ち切り替えて\nいかなきゃ、\nイライラするだけよ。",
            "zh": "必须调整好\n心情才行，\n不然只会越想越气。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1013/TALK",
            "narrator": "ガブリエラ",
            "text": "…うん、そうよ。\n落ち込んでても仕方ない！",
            "zh": "……嗯，没错。\n光沮丧也没用！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1015/TALK",
            "narrator": "ガブリエラ",
            "text": "あ～…そう思ったら、\nなんかすっごい\nスッキリしたかも！",
            "zh": "啊～……这么一想，\n总觉得整个人都\n痛快多了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1016/SEL",
            "narrator": "",
            "text": "急にどうしたの？",
            "zh": "怎么突然这样？",
            "narrator_zh": ""
        },
        {
            "location": "1017/ACT",
            "narrator": "",
            "text": "急にどうしたの？",
            "zh": "怎么突然这样？",
            "narrator_zh": ""
        },
        {
            "location": "1029/TALK",
            "narrator": "ガブリエラ",
            "text": "別に何でもないわ",
            "zh": "也没什么啦",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1030/TALK",
            "narrator": "ガブリエラ",
            "text": "怒ったからかしら？",
            "zh": "是因为发过火了吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1031/TALK",
            "narrator": "ガブリエラ",
            "text": "とってもスッキリした気持ちで気分がいいの",
            "zh": "现在心里特别痛快，心情很好哦",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1033/SEL",
            "narrator": "",
            "text": "メンタル強いな！？",
            "zh": "心态这么强的吗！？",
            "narrator_zh": ""
        },
        {
            "location": "1034/SEL",
            "narrator": "",
            "text": "お、おう",
            "zh": "哦、哦",
            "narrator_zh": ""
        },
        {
            "location": "1035/SEL",
            "narrator": "",
            "text": "機嫌が直って何よりだよ",
            "zh": "心情好转比什么都强",
            "narrator_zh": ""
        },
        {
            "location": "1036/SEL",
            "narrator": "",
            "text": "ならいいんだけど…",
            "zh": "那就好，不过……",
            "narrator_zh": ""
        },
        {
            "location": "1037/ACT",
            "narrator": "",
            "text": "メンタル強いな！？",
            "zh": "心态这么强的吗！？",
            "narrator_zh": ""
        },
        {
            "location": "1038/ACT",
            "narrator": "",
            "text": "お、おう",
            "zh": "哦、哦",
            "narrator_zh": ""
        },
        {
            "location": "1039/ACT",
            "narrator": "",
            "text": "機嫌が直って何よりだよ",
            "zh": "心情好转比什么都强",
            "narrator_zh": ""
        },
        {
            "location": "1040/ACT",
            "narrator": "",
            "text": "ならいいんだけど…",
            "zh": "那就好，不过……",
            "narrator_zh": ""
        },
        {
            "location": "1048/TALK",
            "narrator": "ガブリエラ",
            "text": "…よし！\n花火が始まるまで、\nまだ時間あるわね。",
            "zh": "……好！\n离烟花开始，\n还有点时间呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1049/TALK",
            "narrator": "ガブリエラ",
            "text": "せっかくだし、屋台でも\n見て回ろうかしら！",
            "zh": "难得来一趟，去逛逛\n摊位什么的吧！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1050/SEL",
            "narrator": "",
            "text": "話の続きを聞いてもいい？",
            "zh": "可以继续听你讲刚才的事吗？",
            "narrator_zh": ""
        },
        {
            "location": "1051/ACT",
            "narrator": "",
            "text": "話の続きを聞いてもいい？",
            "zh": "可以继续听你讲刚才的事吗？",
            "narrator_zh": ""
        },
        {
            "location": "1069/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1086/TALK",
            "narrator": "ガブリエラ",
            "text": "ふぅ…ちょっと\n遊び過ぎたかしら？",
            "zh": "呼……是不是\n玩得有点太疯了？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1087/TALK",
            "narrator": "ガブリエラ",
            "text": "でもまあ、たまには\nいいわよね。",
            "zh": "不过嘛，偶尔这样\n也不错吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1088/TALK",
            "narrator": "ガブリエラ",
            "text": "それに、今は\nプライベートの\n時間なんだし。",
            "zh": "而且，现在也是\n私人\n时间嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1089/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1091/TALK",
            "narrator": "ガブリエラ",
            "text": "あっ。",
            "zh": "啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1096/TALK",
            "narrator": "ガブリエラ",
            "text": "…綺麗。",
            "zh": "……真漂亮。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1097/TALK",
            "narrator": "ガブリエラ",
            "text": "さっさと帰らないで、\n夜まで残って、\n正解だったわ。",
            "zh": "没有急着回去，\n留到晚上，\n果然是对的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1099/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1100/SEL",
            "narrator": "",
            "text": "さっきの話、嘘だよね？",
            "zh": "刚才的话，是骗人的吧？",
            "narrator_zh": ""
        },
        {
            "location": "1101/SEL",
            "narrator": "",
            "text": "ごめんね、言いたくないこと聞いて",
            "zh": "对不起，问了你不想说的事",
            "narrator_zh": ""
        },
        {
            "location": "1102/SEL",
            "narrator": "",
            "text": "…冗談だよね？",
            "zh": "……是玩笑吧？",
            "narrator_zh": ""
        },
        {
            "location": "1103/ACT",
            "narrator": "",
            "text": "さっきの話、嘘だよね？",
            "zh": "刚才的话，是骗人的吧？",
            "narrator_zh": ""
        },
        {
            "location": "1114/ACT",
            "narrator": "",
            "text": "ごめんね、言いたくないこと聞いて",
            "zh": "对不起，问了你不想说的事",
            "narrator_zh": ""
        },
        {
            "location": "1124/ACT",
            "narrator": "",
            "text": "…冗談だよね？",
            "zh": "……是玩笑吧？",
            "narrator_zh": ""
        },
        {
            "location": "1135/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1136/TALK",
            "narrator": "ガブリエラ",
            "text": "ねえ、$marzanna$。",
            "zh": "喂，$marzanna$。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1137/TALK",
            "narrator": "ガブリエラ",
            "text": "あんた、どうせ\nあたしの声が\n聞こえてるんでしょ？",
            "zh": "你反正\n听得见我的\n声音吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1138/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1139/TALK",
            "narrator": "ガブリエラ",
            "text": "昼間話したこと、\n覚えてる？",
            "zh": "白天说过的话，\n还记得吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1140/TALK",
            "narrator": "ガブリエラ",
            "text": "あれ、日本に来てからは、\nまだ誰にも話したこと\nないの。",
            "zh": "那件事，我来日本之后，\n还从来没对任何人\n说过。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1141/TALK",
            "narrator": "ガブリエラ",
            "text": "…まほは多分、\n知ってることだと\n思うけど。",
            "zh": "……真幌大概是\n知道的\n吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1142/TALK",
            "narrator": "ガブリエラ",
            "text": "他のみんなには…、\nアーヤにも\n話したことがないわ。",
            "zh": "至于其他所有人……\n就连绫水，我也\n从来没说过。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1143/TALK",
            "narrator": "ガブリエラ",
            "text": "つまり、あんたは\nあたしの秘密を知る、\n数少ない一人になったの。",
            "zh": "也就是说，你成了\n少数知道我秘密的\n人之一。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1145/TALK",
            "narrator": "ガブリエラ",
            "text": "だから、その話を\n他人に漏らすのは禁止。",
            "zh": "所以，禁止把那件事\n泄露给别人。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1146/TALK",
            "narrator": "ガブリエラ",
            "text": "もちろん、あたしに対して\nこれ以上聞くのも禁止よ。",
            "zh": "当然，也禁止再对我\n继续追问了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1148/TALK",
            "narrator": "ガブリエラ",
            "text": "特に…この話を\n誰かに言ったら",
            "zh": "尤其是……要是把这件事\n告诉了谁",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1151/TALK",
            "narrator": "ガブリエラ",
            "text": "許さないから。",
            "zh": "我不会原谅你的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1152/TALK",
            "narrator": "ガブリエラ",
            "text": "絶対に\n許さないから。",
            "zh": "绝对\n不会原谅你的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1158/TALK",
            "narrator": "ガブリエラ",
            "text": "…本当、\n綺麗な花火ね…。",
            "zh": "……真是\n绚丽的烟花啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1172/DIALOG",
            "narrator": "Dialog_chapter_ch03",
            "text": "【19 三戸浜からの手紙】",
            "zh": "【19 来自三户滨的信】",
            "narrator_zh": "Dialog_chapter_ch03"
        }
    ]
}
