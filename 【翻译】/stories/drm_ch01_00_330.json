{
    "dir": "dramatics/daydra/drm_ch01_00_330.js",
    "type": "Episode",
    "info": {
        "story_id": "1033",
        "cid": "tsubame",
        "title": "らぶとーく 第33話",
        "sub_title": "そっとしておけ",
        "title_zh": "恋爱漫谈 第33话",
        "sub_title_zh": "放着别管"
    },
    "entry": [
        {
            "location": "315/SCENARIO",
            "narrator": "",
            "text": "そっとしておけ",
            "zh": "放着别管",
            "narrator_zh": ""
        },
        {
            "location": "325/TALK",
            "narrator": "つばめ",
            "text": "…ここにもいない。",
            "zh": "……这里也不在。",
            "narrator_zh": "燕"
        },
        {
            "location": "327/TALK",
            "narrator": "つばめ",
            "text": "卯月さん、\nどこに行ったんだろ？",
            "zh": "卯月，\n到底去哪里了呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "329/TALK",
            "narrator": "つばめ",
            "text": "卯月さーん。\nどこ行ったのー？",
            "zh": "卯月——。\n去哪儿了呀——？",
            "narrator_zh": "燕"
        },
        {
            "location": "332/TALK",
            "narrator": "真幌",
            "text": "逢瀬。",
            "zh": "逢濑。",
            "narrator_zh": "真幌"
        },
        {
            "location": "334/TALK",
            "narrator": "つばめ",
            "text": "あ、真幌さん。\n卯月さん、\n見ませんでしたか？",
            "zh": "啊，真幌。\n你有没有\n看到卯月呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "335/TALK",
            "narrator": "真幌",
            "text": "いや、見ていないが…。",
            "zh": "不，没看到……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "336/TALK",
            "narrator": "真幌",
            "text": "それより、少しいいか？\n話があるんだが…。",
            "zh": "比起那个，能打扰一下吗？\n我有话要说……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "337/SEL",
            "narrator": "",
            "text": "後にしてもらえば？",
            "zh": "让人家往后排不就好了？",
            "narrator_zh": ""
        },
        {
            "location": "338/SEL",
            "narrator": "",
            "text": "聞いといた方が良いんじゃない",
            "zh": "是不是先问一下比较好",
            "narrator_zh": ""
        },
        {
            "location": "339/SEL",
            "narrator": "",
            "text": "逃げ出せ！",
            "zh": "快逃！",
            "narrator_zh": ""
        },
        {
            "location": "341/TALK",
            "narrator": "つばめ",
            "text": "えっ…今ですか？",
            "zh": "诶……现在吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "342/TALK",
            "narrator": "真幌",
            "text": "何だ、都合が悪いのか？",
            "zh": "怎么，不方便吗？",
            "narrator_zh": "真幌"
        },
        {
            "location": "343/TALK",
            "narrator": "つばめ",
            "text": "えっと――",
            "zh": "那个——",
            "narrator_zh": "燕"
        },
        {
            "location": "346/TALK",
            "narrator": "つばめ",
            "text": "…いえ、大丈夫です。\nお話って何ですか？",
            "zh": "……不，没关系的。\n你要说什么事呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "349/TALK",
            "narrator": "真幌",
            "text": "いや…余計なお世話かも\nしれんのだが――",
            "zh": "不……也许是我\n多管闲事了——",
            "narrator_zh": "真幌"
        },
        {
            "location": "351/TALK",
            "narrator": "真幌",
            "text": "逢瀬は、卯月に対して\n少し肩入れし過ぎだ。",
            "zh": "逢濑，你对卯月\n多少有些太偏袒了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "353/TALK",
            "narrator": "つばめ",
            "text": "…えっ？",
            "zh": "……诶？",
            "narrator_zh": "燕"
        },
        {
            "location": "354/TALK",
            "narrator": "真幌",
            "text": "卯月が何を悩んでいる\nのかは、私にもわからん。",
            "zh": "卯月究竟在烦恼什么，\n我也不清楚。",
            "narrator_zh": "真幌"
        },
        {
            "location": "355/TALK",
            "narrator": "真幌",
            "text": "逢瀬は、そのことを\n心配し、力になろうと\n思っているのだろう？",
            "zh": "逢濑你是在担心那件事，\n想着去帮她一把，\n对吧？",
            "narrator_zh": "真幌"
        },
        {
            "location": "357/TALK",
            "narrator": "つばめ",
            "text": "…はい。",
            "zh": "……是的。",
            "narrator_zh": "燕"
        },
        {
            "location": "358/TALK",
            "narrator": "真幌",
            "text": "…逢瀬は優しいな。",
            "zh": "……逢濑真是温柔啊。",
            "narrator_zh": "真幌"
        },
        {
            "location": "359/TALK",
            "narrator": "真幌",
            "text": "だがな、時には力に\nなろうとするより――",
            "zh": "可是啊，有时候比起\n想成为助力——",
            "narrator_zh": "真幌"
        },
        {
            "location": "360/TALK",
            "narrator": "真幌",
            "text": "何もせず、そっとして\nおく優しさというのも\n必要だぞ。",
            "zh": "什么都不做，不去打扰\n也是一种温柔，\n有时也是必要的。",
            "narrator_zh": "真幌"
        },
        {
            "location": "362/TALK",
            "narrator": "つばめ",
            "text": "…それって、放っておけ\nってことですか？",
            "zh": "……那是叫我\n干脆不管的意思吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "363/TALK",
            "narrator": "真幌",
            "text": "放っておくのと、\nそっとしておくのは、\n似ているようで違う。",
            "zh": "干脆不管，\n和不去打扰，\n听着相似实则不同。",
            "narrator_zh": "真幌"
        },
        {
            "location": "364/TALK",
            "narrator": "真幌",
            "text": "心配はしろ。\nだが、向こうが助けを\n求めてくるまでは――",
            "zh": "关心是应该的。\n但在她主动向你\n求助之前——",
            "narrator_zh": "真幌"
        },
        {
            "location": "365/TALK",
            "narrator": "真幌",
            "text": "そっとしておいた方が\nいいこともある。",
            "zh": "有些事还是\n放着不管比较好。",
            "narrator_zh": "真幌"
        },
        {
            "location": "366/TALK",
            "narrator": "真幌",
            "text": "…話は以上だ。\nじゃあな。",
            "zh": "……话就说到这里。\n那我走了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "369/TALK",
            "narrator": "つばめ",
            "text": "…そっとしておくのも、\n優しさ…。",
            "zh": "……不去打扰，\n也是一种温柔……。",
            "narrator_zh": "燕"
        },
        {
            "location": "370/TALK",
            "narrator": "つばめ",
            "text": "でも、友達が悩んでるのを\n放っておくなんて、\nそんなの…！",
            "zh": "可是，朋友在烦恼\n就这么放着不管，\n那种事……！",
            "narrator_zh": "燕"
        },
        {
            "location": "372/TALK",
            "narrator": "つばめ",
            "text": "でも…肩入れし過ぎ\nなの、かな…？",
            "zh": "不过……是不是\n太偏袒了……？",
            "narrator_zh": "燕"
        },
        {
            "location": "373/TALK",
            "narrator": "つばめ",
            "text": "…わたしのしてること、\n間違いなのかな？",
            "zh": "……我做的事，\n难道是错的吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "375/ACT",
            "narrator": "",
            "text": "後にしてもらえば？",
            "zh": "让人家往后排不就好了？",
            "narrator_zh": ""
        },
        {
            "location": "392/TALK",
            "narrator": "つばめ",
            "text": "うん",
            "zh": "嗯",
            "narrator_zh": "燕"
        },
        {
            "location": "393/TALK",
            "narrator": "つばめ",
            "text": "それが良いよね(´・ω・`) ",
            "zh": "那样挺好吧(´·ω·`)",
            "narrator_zh": "燕"
        },
        {
            "location": "405/TALK",
            "narrator": "つばめ",
            "text": "すみません。\n後にしてもらえますか？",
            "zh": "对不起。\n能改天再说吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "407/TALK",
            "narrator": "真幌",
            "text": "…卯月を見つけるのが、\n何よりも優先か？",
            "zh": "……找到卯月，\n比什么都优先吗？",
            "narrator_zh": "真幌"
        },
        {
            "location": "409/TALK",
            "narrator": "つばめ",
            "text": "す、すみません…。",
            "zh": "对、对不起……。",
            "narrator_zh": "燕"
        },
        {
            "location": "411/TALK",
            "narrator": "つばめ",
            "text": "でも、見つかったら\nすぐに真幌さんのお話を\n聞きに戻りますから――",
            "zh": "不过，要是被发现了\n我马上就回去\n听真幌说话——",
            "narrator_zh": "燕"
        },
        {
            "location": "412/TALK",
            "narrator": "真幌",
            "text": "それが問題なんだ、\nという話をしようと\n思っていたんだ。",
            "zh": "我就想谈谈，\n那个问题的\n所在。",
            "narrator_zh": "真幌"
        },
        {
            "location": "413/TALK",
            "narrator": "つばめ",
            "text": "…どういうことですか？",
            "zh": "……这是怎么回事？",
            "narrator_zh": "燕"
        },
        {
            "location": "414/TALK",
            "narrator": "真幌",
            "text": "人には事情がある、\nということだ。",
            "zh": "我是说，每个人\n都有自己的难处。",
            "narrator_zh": "真幌"
        },
        {
            "location": "415/TALK",
            "narrator": "真幌",
            "text": "逢瀬が卯月のことを\n想うのは悪いことでは\nない。",
            "zh": "逢濑关心卯月，\n这本身并不是\n什么坏事。",
            "narrator_zh": "真幌"
        },
        {
            "location": "416/TALK",
            "narrator": "真幌",
            "text": "だが、肩入れし過ぎて、\nその事情に踏み入るような\n事態になるのは――",
            "zh": "可是，要是太偏袒，\n变成介入那件事的\n局面——",
            "narrator_zh": "真幌"
        },
        {
            "location": "417/TALK",
            "narrator": "真幌",
            "text": "あまり良いとは言えんぞ。",
            "zh": "可算不上什么好事。",
            "narrator_zh": "真幌"
        },
        {
            "location": "420/TALK",
            "narrator": "つばめ",
            "text": "で、でも…だからって、\n放っておけないです。",
            "zh": "可、可是……就算这样，\n我也不能不管。",
            "narrator_zh": "燕"
        },
        {
            "location": "422/TALK",
            "narrator": "つばめ",
            "text": "悩んでいる卯月さんを、\n放っておくなんて…。",
            "zh": "把正在烦恼的卯月\n放着不管什么的……。",
            "narrator_zh": "燕"
        },
        {
            "location": "423/TALK",
            "narrator": "真幌",
            "text": "一人で悩む時間も、\n必要なんじゃないか？",
            "zh": "一个人独自烦恼的时间，\n不也是需要的吗？",
            "narrator_zh": "真幌"
        },
        {
            "location": "424/TALK",
            "narrator": "真幌",
            "text": "逢瀬の優しさもわかる。",
            "zh": "我也能理解逢濑的好心。",
            "narrator_zh": "真幌"
        },
        {
            "location": "425/TALK",
            "narrator": "真幌",
            "text": "だが、そのせいで一人で\n悩むのを、邪魔することに\nなるかもしれないんだ。",
            "zh": "可是，那样也许会\n妨碍他一个人\n烦恼。",
            "narrator_zh": "真幌"
        },
        {
            "location": "427/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "428/TALK",
            "narrator": "真幌",
            "text": "…まあ、話は以上だ。",
            "zh": "……嘛，话就说到这里。",
            "narrator_zh": "真幌"
        },
        {
            "location": "429/TALK",
            "narrator": "真幌",
            "text": "あとはどうするかは、\n逢瀬の判断に任せよう。",
            "zh": "之后该怎么去做，\n就交给逢濑自己判断吧。",
            "narrator_zh": "真幌"
        },
        {
            "location": "432/TALK",
            "narrator": "つばめ",
            "text": "…一人で悩む時間も、\n必要なのかな？",
            "zh": "……一个人烦恼的时间，\n也是需要的吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "433/TALK",
            "narrator": "つばめ",
            "text": "わたしも、一人でじっくり\n考えたくなる時もあるし。",
            "zh": "其实我也有想一个人\n静静思考的时候呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "434/TALK",
            "narrator": "つばめ",
            "text": "でも、友達が悩んでるのを\n放っておくなんて、\nそんなの…！",
            "zh": "可是，朋友在烦恼\n就这么放着不管，\n那种事……！",
            "narrator_zh": "燕"
        },
        {
            "location": "435/TALK",
            "narrator": "つばめ",
            "text": "…真幌さんの言う通り、\n肩入れし過ぎなのかな？",
            "zh": "……就像真幌说的，\n我是不是太偏袒了呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "436/TALK",
            "narrator": "つばめ",
            "text": "わたし、どうすれば\nいいんだろう…。",
            "zh": "我到底该怎么做\n才好呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "437/ACT",
            "narrator": "",
            "text": "聞いといた方が良いんじゃない",
            "zh": "是不是先问一下比较好",
            "narrator_zh": ""
        },
        {
            "location": "454/TALK",
            "narrator": "つばめ",
            "text": "そぅだね",
            "zh": "是呀",
            "narrator_zh": "燕"
        },
        {
            "location": "455/TALK",
            "narrator": "つばめ",
            "text": "何か大切な話かもしれなぃし",
            "zh": "说不定是什么重要的事呢",
            "narrator_zh": "燕"
        },
        {
            "location": "467/TALK",
            "narrator": "つばめ",
            "text": "お話って、何ですか？",
            "zh": "你说的谈话，是什么事？",
            "narrator_zh": "燕"
        },
        {
            "location": "469/ACT",
            "narrator": "",
            "text": "逃げ出せ！",
            "zh": "快逃！",
            "narrator_zh": ""
        },
        {
            "location": "486/TALK",
            "narrator": "つばめ",
            "text": "無理だよΣ(･ω･;|||",
            "zh": "那怎么行呀Σ(･ω･;|||",
            "narrator_zh": "燕"
        },
        {
            "location": "487/TALK",
            "narrator": "つばめ",
            "text": "流石にそぅぃぅわけにはぃかなぃから",
            "zh": "毕竟那样做实在太失礼了",
            "narrator_zh": "燕"
        },
        {
            "location": "488/TALK",
            "narrator": "つばめ",
            "text": "とりあぇず聞ぃてみるよ(´・ω・`) ",
            "zh": "总之先问问看(´·ω·`)",
            "narrator_zh": "燕"
        },
        {
            "location": "500/TALK",
            "narrator": "つばめ",
            "text": "お話って、何ですか？",
            "zh": "你说的谈话，是什么事？",
            "narrator_zh": "燕"
        }
    ]
}
