{
 "dir": "dramatics/daydra/drm_ch02_00_730.js",
 "type": "Episode",
 "info": {
  "story_id": "2073",
  "cid": "ayami",
  "title": "らぶとーく 第72話",
  "sub_title": "恋することのもどかしさ"
 },
 "entry": [
  {
   "location": "166/SCENARIO",
   "narrator": "",
   "text": "恋することのもどかしさ"
  },
  {
   "location": "178/TALK",
   "narrator": "小夜",
   "text": "いつもながら身も蓋も\nなさすぎよね。\nあの講義。"
  },
  {
   "location": "181/TALK",
   "narrator": "アーヤ",
   "text": "…確かにね。",
   "zh": "……确实呢。",
   "narrator_zh": "绫水"
  },
  {
   "location": "182/TALK",
   "narrator": "小夜",
   "text": "女子学生の\n学歴と収入の\n相関関係とか。"
  },
  {
   "location": "183/TALK",
   "narrator": "小夜",
   "text": "数字にされると\n生々しすぎよね。"
  },
  {
   "location": "184/TALK",
   "narrator": "アーヤ",
   "text": "…学生のうちに\n知っておけるのは\nいいことだと思うわ。",
   "zh": "……趁着还是学生\n能先知道这些，\n我觉得是件好事。",
   "narrator_zh": "绫水"
  },
  {
   "location": "185/TALK",
   "narrator": "小夜",
   "text": "アーヤってホント\nアーヤよね。"
  },
  {
   "location": "187/TALK",
   "narrator": "アーヤ",
   "text": "何よそれ。"
  },
  {
   "location": "188/TALK",
   "narrator": "小夜",
   "text": "それよりさー。",
   "zh": "比起那个啦——",
   "narrator_zh": "小夜"
  },
  {
   "location": "189/TALK",
   "narrator": "小夜",
   "text": "恋愛関係にも\n容赦ない発言\nしてくるよね。"
  },
  {
   "location": "190/TALK",
   "narrator": "小夜",
   "text": "恋愛って娯楽でしか\nないのかなって\n思っちゃう。"
  },
  {
   "location": "191/TALK",
   "narrator": "アーヤ",
   "text": "…娯楽？"
  },
  {
   "location": "192/TALK",
   "narrator": "小夜",
   "text": "だってそうでしょ？",
   "zh": "因为就是这样吧？",
   "narrator_zh": "小夜"
  },
  {
   "location": "193/TALK",
   "narrator": "小夜",
   "text": "恋愛は現代の婚姻制度を\n存続するための幻想、\nなんて言われたら。"
  },
  {
   "location": "194/TALK",
   "narrator": "小夜",
   "text": "極論だなって\n思ったりもするけど。"
  },
  {
   "location": "195/TALK",
   "narrator": "小夜",
   "text": "同性婚とか事実婚とか\nいったケースは\n入ってないしね。"
  },
  {
   "location": "196/TALK",
   "narrator": "小夜",
   "text": "なんて。",
   "zh": "什么嘛。",
   "narrator_zh": "小夜"
  },
  {
   "location": "197/TALK",
   "narrator": "小夜",
   "text": "結構真面目に\n聞いてるのよ\nあの講義。"
  },
  {
   "location": "198/TALK",
   "narrator": "アーヤ",
   "text": "……。"
  },
  {
   "location": "199/SEL",
   "narrator": "",
   "text": "おーい",
   "zh": "喂——",
   "narrator_zh": ""
  },
  {
   "location": "200/ACT",
   "narrator": "",
   "text": "おーい",
   "zh": "喂——",
   "narrator_zh": ""
  },
  {
   "location": "218/TALK",
   "narrator": "アーヤ",
   "text": "何？"
  },
  {
   "location": "220/SEL",
   "narrator": "",
   "text": "$me$もその話に混ぜて",
   "zh": "也让$me$加入这个话题嘛",
   "narrator_zh": ""
  },
  {
   "location": "221/SEL",
   "narrator": "",
   "text": "難しい話してる？",
   "zh": "在聊难的话题？",
   "narrator_zh": ""
  },
  {
   "location": "222/SEL",
   "narrator": "",
   "text": "楽しい話をしようよ",
   "zh": "聊点开心的事吧",
   "narrator_zh": ""
  },
  {
   "location": "223/ACT",
   "narrator": "",
   "text": "$me$もその話に混ぜて",
   "zh": "也让$me$加入这个话题嘛",
   "narrator_zh": ""
  },
  {
   "location": "224/TALK",
   "narrator": "アーヤ",
   "text": "無理よ"
  },
  {
   "location": "225/TALK",
   "narrator": "アーヤ",
   "text": "小夜がいるんだから"
  },
  {
   "location": "226/ACT",
   "narrator": "",
   "text": "難しい話してる？",
   "zh": "在聊难的话题？",
   "narrator_zh": ""
  },
  {
   "location": "227/TALK",
   "narrator": "アーヤ",
   "text": "難しいっていうか"
  },
  {
   "location": "228/TALK",
   "narrator": "アーヤ",
   "text": "勉強の話だから"
  },
  {
   "location": "229/ACT",
   "narrator": "",
   "text": "楽しい話をしようよ",
   "zh": "聊点开心的事吧",
   "narrator_zh": ""
  },
  {
   "location": "230/TALK",
   "narrator": "アーヤ",
   "text": "そうね",
   "zh": "说得对",
   "narrator_zh": "绫水"
  },
  {
   "location": "231/TALK",
   "narrator": "アーヤ",
   "text": "この後でね",
   "zh": "等一下呢",
   "narrator_zh": "绫水"
  },
  {
   "location": "243/TALK",
   "narrator": "アーヤ",
   "text": "……。"
  },
  {
   "location": "245/TALK",
   "narrator": "アーヤ",
   "text": "…恋愛の先って\n婚姻じゃないと\nいけないのかしら。",
   "zh": "……恋爱的尽头\n就一定得是\n婚姻吗。",
   "narrator_zh": "绫水"
  },
  {
   "location": "246/TALK",
   "narrator": "小夜",
   "text": "え？\nアーヤ？",
   "zh": "诶？\n绫水？",
   "narrator_zh": "小夜"
  },
  {
   "location": "249/TALK",
   "narrator": "アーヤ",
   "text": "そもそも恋愛の\n定義って？",
   "zh": "说起来恋爱的\n定义是什么？",
   "narrator_zh": "绫水"
  },
  {
   "location": "250/TALK",
   "narrator": "小夜",
   "text": "えと…悩みでも\nあるの？",
   "zh": "那个……是有什么\n烦恼吗？",
   "narrator_zh": "小夜"
  },
  {
   "location": "252/TALK",
   "narrator": "アーヤ",
   "text": "悩みっていうか\n小夜の意見を\n聞きたいんだけど。"
  },
  {
   "location": "253/TALK",
   "narrator": "アーヤ",
   "text": "会ったことのない人を\n恋人っていうことは\n可能だと思う？"
  },
  {
   "location": "254/TALK",
   "narrator": "アーヤ",
   "text": "会ったことのない人と\n結婚することは\n可能だと思う？"
  },
  {
   "location": "255/TALK",
   "narrator": "小夜",
   "text": "そうね…ＳＮＳで\n繋がってそこから\n発展した相手なら。",
   "zh": "是啊……如果是在SNS上\n连上，从那里\n发展起来的对象的话。",
   "narrator_zh": "小夜"
  },
  {
   "location": "256/TALK",
   "narrator": "小夜",
   "text": "会ったことがない\n恋人と言えなくは\nないんじゃない？"
  },
  {
   "location": "257/TALK",
   "narrator": "小夜",
   "text": "でも会う前に\n恋人同士には\nならないだろうけど。",
   "zh": "不过见面之前\n应该还不会\n成为恋人吧。",
   "narrator_zh": "小夜"
  },
  {
   "location": "258/TALK",
   "narrator": "小夜",
   "text": "結婚は想像つかない。\nリアリティ\nなさすぎて。"
  },
  {
   "location": "259/TALK",
   "narrator": "アーヤ",
   "text": "……。"
  },
  {
   "location": "260/TALK",
   "narrator": "小夜",
   "text": "なあに？\n後輩ちゃんが\n変なの？",
   "zh": "什么？\n后辈妹妹\n怪怪的？",
   "narrator_zh": "小夜"
  },
  {
   "location": "262/TALK",
   "narrator": "アーヤ",
   "text": "……。"
  },
  {
   "location": "263/TALK",
   "narrator": "小夜",
   "text": "…私も詳しくは\n聞かないけど。",
   "zh": "……我也不会\n细问。",
   "narrator_zh": "小夜"
  },
  {
   "location": "264/TALK",
   "narrator": "小夜",
   "text": "多分それ、\nごっこ遊び\nなんじゃないかな。"
  },
  {
   "location": "265/TALK",
   "narrator": "小夜",
   "text": "普段と違う自分に\nなれたり、かっこつけたり\nできるし。"
  },
  {
   "location": "266/TALK",
   "narrator": "小夜",
   "text": "会わずにすむ相手\nだからちょっと\n羽目外してるだけ。"
  },
  {
   "location": "267/TALK",
   "narrator": "小夜",
   "text": "そういうのが\n楽しいんじゃない？",
   "zh": "那种的不正是\n乐趣所在吗？",
   "narrator_zh": "小夜"
  },
  {
   "location": "268/TALK",
   "narrator": "小夜",
   "text": "そのうち飽きるわよ。",
   "zh": "迟早会腻的哦。",
   "narrator_zh": "小夜"
  },
  {
   "location": "269/TALK",
   "narrator": "アーヤ",
   "text": "……。"
  },
  {
   "location": "271/TALK",
   "narrator": "アーヤ",
   "text": "そうね。\nそのうち飽きるわ。\nきっと。",
   "zh": "是啊。\n总有一天会腻的。\n一定。",
   "narrator_zh": "绫水"
  },
  {
   "location": "286/TALK",
   "narrator": "ボイスメール",
   "text": "ハートのささやき",
   "zh": "心的低语",
   "narrator_zh": "语音信箱"
  },
  {
   "location": "177/DIALOG",
   "narrator": "Dialog_EventData",
   "text": "<color=green>某月某日　 12:32 PM</color>\nとある平日、付属学園食堂でのこと"
  },
  {
   "location": "298/DIALOG",
   "narrator": "Dialog_GETVoice",
   "text": "<color=green>【アーヤ】</color>のボイスメール\n<color=red>【ハートのささやき】</color>\nをゲットしました！"
  }
 ]
}
