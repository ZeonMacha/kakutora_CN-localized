{
    "dir": "dramatics/daydra/drm_ch02_00_730.js",
    "type": "Episode",
    "info": {
        "story_id": "2073",
        "cid": "ayami",
        "title": "らぶとーく 第72話",
        "sub_title": "恋することのもどかしさ",
        "title_zh": "恋爱漫谈 第72话",
        "sub_title_zh": "恋爱的煎熬"
    },
    "entry": [
        {
            "location": "166/SCENARIO",
            "narrator": "",
            "text": "恋することのもどかしさ",
            "zh": "恋爱的煎熬",
            "narrator_zh": ""
        },
        {
            "location": "178/TALK",
            "narrator": "小夜",
            "text": "いつもながら身も蓋も\nなさすぎよね。\nあの講義。",
            "zh": "跟往常一样，\n那堂课讲话\n实在不留情面呢。",
            "narrator_zh": "小夜"
        },
        {
            "location": "181/TALK",
            "narrator": "アーヤ",
            "text": "…確かにね。",
            "zh": "……确实呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "182/TALK",
            "narrator": "小夜",
            "text": "女子学生の\n学歴と収入の\n相関関係とか。",
            "zh": "什么女学生的\n学历和收入的\n相关关系之类的。",
            "narrator_zh": "小夜"
        },
        {
            "location": "183/TALK",
            "narrator": "小夜",
            "text": "数字にされると\n生々しすぎよね。",
            "zh": "一变成数字，\n就太过赤裸裸了。",
            "narrator_zh": "小夜"
        },
        {
            "location": "184/TALK",
            "narrator": "アーヤ",
            "text": "…学生のうちに\n知っておけるのは\nいいことだと思うわ。",
            "zh": "……趁着还是学生\n能先知道这些，\n我觉得是件好事。",
            "narrator_zh": "绫水"
        },
        {
            "location": "185/TALK",
            "narrator": "小夜",
            "text": "アーヤってホント\nアーヤよね。",
            "zh": "绫水真是\n够绫水的呢。",
            "narrator_zh": "小夜"
        },
        {
            "location": "187/TALK",
            "narrator": "アーヤ",
            "text": "何よそれ。",
            "zh": "那算什么。",
            "narrator_zh": "绫水"
        },
        {
            "location": "188/TALK",
            "narrator": "小夜",
            "text": "それよりさー。",
            "zh": "比起那个啦——",
            "narrator_zh": "小夜"
        },
        {
            "location": "189/TALK",
            "narrator": "小夜",
            "text": "恋愛関係にも\n容赦ない発言\nしてくるよね。",
            "zh": "恋爱的话题上\n也是发言\n毫不留情呢。",
            "narrator_zh": "小夜"
        },
        {
            "location": "190/TALK",
            "narrator": "小夜",
            "text": "恋愛って娯楽でしか\nないのかなって\n思っちゃう。",
            "zh": "我都开始觉得\n恋爱是不是\n只是种娱乐。",
            "narrator_zh": "小夜"
        },
        {
            "location": "191/TALK",
            "narrator": "アーヤ",
            "text": "…娯楽？",
            "zh": "…娱乐？",
            "narrator_zh": "绫水"
        },
        {
            "location": "192/TALK",
            "narrator": "小夜",
            "text": "だってそうでしょ？",
            "zh": "因为就是这样吧？",
            "narrator_zh": "小夜"
        },
        {
            "location": "193/TALK",
            "narrator": "小夜",
            "text": "恋愛は現代の婚姻制度を\n存続するための幻想、\nなんて言われたら。",
            "zh": "要是听到人说，\n恋爱不过是维系现代\n婚姻制度的幻想，",
            "narrator_zh": "小夜"
        },
        {
            "location": "194/TALK",
            "narrator": "小夜",
            "text": "極論だなって\n思ったりもするけど。",
            "zh": "虽然也会觉得\n这是极端的说法。",
            "narrator_zh": "小夜"
        },
        {
            "location": "195/TALK",
            "narrator": "小夜",
            "text": "同性婚とか事実婚とか\nいったケースは\n入ってないしね。",
            "zh": "而且同性婚姻、事实婚姻\n这类情况\n都没算进去呢。",
            "narrator_zh": "小夜"
        },
        {
            "location": "196/TALK",
            "narrator": "小夜",
            "text": "なんて。",
            "zh": "什么嘛。",
            "narrator_zh": "小夜"
        },
        {
            "location": "197/TALK",
            "narrator": "小夜",
            "text": "結構真面目に\n聞いてるのよ\nあの講義。",
            "zh": "那堂课我可是\n听得相当认真的\n哦。",
            "narrator_zh": "小夜"
        },
        {
            "location": "198/TALK",
            "narrator": "アーヤ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "199/SEL",
            "narrator": "",
            "text": "おーい",
            "zh": "喂——",
            "narrator_zh": ""
        },
        {
            "location": "200/ACT",
            "narrator": "",
            "text": "おーい",
            "zh": "喂——",
            "narrator_zh": ""
        },
        {
            "location": "218/TALK",
            "narrator": "アーヤ",
            "text": "何？",
            "zh": "干嘛？",
            "narrator_zh": "绫水"
        },
        {
            "location": "220/SEL",
            "narrator": "",
            "text": "$me$もその話に混ぜて",
            "zh": "也让$me$加入这个话题嘛",
            "narrator_zh": ""
        },
        {
            "location": "221/SEL",
            "narrator": "",
            "text": "難しい話してる？",
            "zh": "在聊难的话题？",
            "narrator_zh": ""
        },
        {
            "location": "222/SEL",
            "narrator": "",
            "text": "楽しい話をしようよ",
            "zh": "聊点开心的事吧",
            "narrator_zh": ""
        },
        {
            "location": "223/ACT",
            "narrator": "",
            "text": "$me$もその話に混ぜて",
            "zh": "也让$me$加入这个话题嘛",
            "narrator_zh": ""
        },
        {
            "location": "224/TALK",
            "narrator": "アーヤ",
            "text": "無理よ",
            "zh": "不行哦",
            "narrator_zh": "绫水"
        },
        {
            "location": "225/TALK",
            "narrator": "アーヤ",
            "text": "小夜がいるんだから",
            "zh": "因为小夜在嘛",
            "narrator_zh": "绫水"
        },
        {
            "location": "226/ACT",
            "narrator": "",
            "text": "難しい話してる？",
            "zh": "在聊难的话题？",
            "narrator_zh": ""
        },
        {
            "location": "227/TALK",
            "narrator": "アーヤ",
            "text": "難しいっていうか",
            "zh": "倒不是难",
            "narrator_zh": "绫水"
        },
        {
            "location": "228/TALK",
            "narrator": "アーヤ",
            "text": "勉強の話だから",
            "zh": "只是在聊功课",
            "narrator_zh": "绫水"
        },
        {
            "location": "229/ACT",
            "narrator": "",
            "text": "楽しい話をしようよ",
            "zh": "聊点开心的事吧",
            "narrator_zh": ""
        },
        {
            "location": "230/TALK",
            "narrator": "アーヤ",
            "text": "そうね",
            "zh": "说得对",
            "narrator_zh": "绫水"
        },
        {
            "location": "231/TALK",
            "narrator": "アーヤ",
            "text": "この後でね",
            "zh": "等一下呢",
            "narrator_zh": "绫水"
        },
        {
            "location": "243/TALK",
            "narrator": "アーヤ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "245/TALK",
            "narrator": "アーヤ",
            "text": "…恋愛の先って\n婚姻じゃないと\nいけないのかしら。",
            "zh": "……恋爱的尽头\n就一定得是\n婚姻吗。",
            "narrator_zh": "绫水"
        },
        {
            "location": "246/TALK",
            "narrator": "小夜",
            "text": "え？\nアーヤ？",
            "zh": "诶？\n绫水？",
            "narrator_zh": "小夜"
        },
        {
            "location": "249/TALK",
            "narrator": "アーヤ",
            "text": "そもそも恋愛の\n定義って？",
            "zh": "说起来恋爱的\n定义是什么？",
            "narrator_zh": "绫水"
        },
        {
            "location": "250/TALK",
            "narrator": "小夜",
            "text": "えと…悩みでも\nあるの？",
            "zh": "那个……是有什么\n烦恼吗？",
            "narrator_zh": "小夜"
        },
        {
            "location": "252/TALK",
            "narrator": "アーヤ",
            "text": "悩みっていうか\n小夜の意見を\n聞きたいんだけど。",
            "zh": "倒不是烦恼，\n我是想听听\n小夜的意见。",
            "narrator_zh": "绫水"
        },
        {
            "location": "253/TALK",
            "narrator": "アーヤ",
            "text": "会ったことのない人を\n恋人っていうことは\n可能だと思う？",
            "zh": "没见过面的人\n也能当恋人，\n你觉得可能吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "254/TALK",
            "narrator": "アーヤ",
            "text": "会ったことのない人と\n結婚することは\n可能だと思う？",
            "zh": "和没见过面的人\n结婚，\n你觉得可能吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "255/TALK",
            "narrator": "小夜",
            "text": "そうね…ＳＮＳで\n繋がってそこから\n発展した相手なら。",
            "zh": "是啊……如果是在SNS上\n连上，从那里\n发展起来的对象的话。",
            "narrator_zh": "小夜"
        },
        {
            "location": "256/TALK",
            "narrator": "小夜",
            "text": "会ったことがない\n恋人と言えなくは\nないんじゃない？",
            "zh": "说是没见过面的\n恋人，倒也\n不能说不行吧？",
            "narrator_zh": "小夜"
        },
        {
            "location": "257/TALK",
            "narrator": "小夜",
            "text": "でも会う前に\n恋人同士には\nならないだろうけど。",
            "zh": "不过见面之前\n应该还不会\n成为恋人吧。",
            "narrator_zh": "小夜"
        },
        {
            "location": "258/TALK",
            "narrator": "小夜",
            "text": "結婚は想像つかない。\nリアリティ\nなさすぎて。",
            "zh": "结婚没法想象。\n实在\n太没真实感了。",
            "narrator_zh": "小夜"
        },
        {
            "location": "259/TALK",
            "narrator": "アーヤ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "260/TALK",
            "narrator": "小夜",
            "text": "なあに？\n後輩ちゃんが\n変なの？",
            "zh": "什么？\n后辈妹妹\n怪怪的？",
            "narrator_zh": "小夜"
        },
        {
            "location": "262/TALK",
            "narrator": "アーヤ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "263/TALK",
            "narrator": "小夜",
            "text": "…私も詳しくは\n聞かないけど。",
            "zh": "……我也不会\n细问。",
            "narrator_zh": "小夜"
        },
        {
            "location": "264/TALK",
            "narrator": "小夜",
            "text": "多分それ、\nごっこ遊び\nなんじゃないかな。",
            "zh": "大概那个，\n其实是扮家家酒\n之类的吧。",
            "narrator_zh": "小夜"
        },
        {
            "location": "265/TALK",
            "narrator": "小夜",
            "text": "普段と違う自分に\nなれたり、かっこつけたり\nできるし。",
            "zh": "能变成和平时不同的自己，\n还能耍耍帅，\n什么的。",
            "narrator_zh": "小夜"
        },
        {
            "location": "266/TALK",
            "narrator": "小夜",
            "text": "会わずにすむ相手\nだからちょっと\n羽目外してるだけ。",
            "zh": "反正是不用见面的对象，\n只是稍微\n放飞自我罢了。",
            "narrator_zh": "小夜"
        },
        {
            "location": "267/TALK",
            "narrator": "小夜",
            "text": "そういうのが\n楽しいんじゃない？",
            "zh": "那种的不正是\n乐趣所在吗？",
            "narrator_zh": "小夜"
        },
        {
            "location": "268/TALK",
            "narrator": "小夜",
            "text": "そのうち飽きるわよ。",
            "zh": "迟早会腻的哦。",
            "narrator_zh": "小夜"
        },
        {
            "location": "269/TALK",
            "narrator": "アーヤ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "271/TALK",
            "narrator": "アーヤ",
            "text": "そうね。\nそのうち飽きるわ。\nきっと。",
            "zh": "是啊。\n总有一天会腻的。\n一定。",
            "narrator_zh": "绫水"
        },
        {
            "location": "286/TALK",
            "narrator": "ボイスメール",
            "text": "ハートのささやき",
            "zh": "心的低语",
            "narrator_zh": "语音信箱"
        },
        {
            "location": "177/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>某月某日　 12:32 PM</color>\nとある平日、付属学園食堂でのこと",
            "zh": "<color=green>某月某日　 12:32 PM</color>\n某个平日，在附属学园食堂里",
            "narrator_zh": "Dialog_EventData"
        },
        {
            "location": "298/DIALOG",
            "narrator": "Dialog_GETVoice",
            "text": "<color=green>【アーヤ】</color>のボイスメール\n<color=red>【ハートのささやき】</color>\nをゲットしました！",
            "zh": "<color=green>【绫水】</color>的语音信箱\n<color=red>【心的低语】</color>\n已入手！",
            "narrator_zh": "Dialog_GETVoice"
        }
    ]
}
