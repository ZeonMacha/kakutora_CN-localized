{
 "dir": "dramatics/daydra/drm_ch03_00_240.js",
 "type": "Episode",
 "info": {
  "story_id": "3024",
  "cid": "gabriella",
  "title": "らぶとーく  第24話",
  "sub_title": "使用人として"
 },
 "entry": [
  {
   "location": "7/SCENARIO",
   "narrator": "",
   "text": "使用人として"
  },
  {
   "location": "26/TALK",
   "narrator": "つばめ",
   "text": "美味しい！\nやっぱり思った通り\nです。"
  },
  {
   "location": "27/TALK",
   "narrator": "つばめ",
   "text": "テレビで見て\n美味しそうだなぁ、って\n思ってたんですよ。"
  },
  {
   "location": "29/TALK",
   "narrator": "みやび",
   "text": "良かったね。\nようやっと食べられて。"
  },
  {
   "location": "32/TALK",
   "narrator": "つばめ",
   "text": "はい！",
   "zh": "是的！",
   "narrator_zh": "燕"
  },
  {
   "location": "34/TALK",
   "narrator": "アーヤ",
   "text": "それにしても、\nいいお店ね。",
   "zh": "不过话说回来，\n真是家好店呢。",
   "narrator_zh": "绫水"
  },
  {
   "location": "35/TALK",
   "narrator": "アーヤ",
   "text": "覚えておいて、\nまた近くに来たとき\n入ろうかしら？"
  },
  {
   "location": "39/TALK",
   "narrator": "つばめ",
   "text": "ガブちゃん、ありがと。\n一緒に来てくれて。"
  },
  {
   "location": "41/TALK",
   "narrator": "ガブリエラ",
   "text": "…っていうか、どうして\nあたしまで来なきゃ\nいけないのよ？"
  },
  {
   "location": "42/TALK",
   "narrator": "ガブリエラ",
   "text": "店の場所は知ってるん\nだから、つばめ達だけ\nでも来れたでしょ？"
  },
  {
   "location": "44/TALK",
   "narrator": "つばめ",
   "text": "それはそうだけど。",
   "zh": "话是这么说。",
   "narrator_zh": "燕"
  },
  {
   "location": "45/TALK",
   "narrator": "つばめ",
   "text": "みんなで来た方が\n楽しいんじゃないかな、\nって思って。"
  },
  {
   "location": "46/TALK",
   "narrator": "つばめ",
   "text": "だから、ガブちゃんにも\n来て欲しかったの。",
   "zh": "所以，我也希望\n加布来。",
   "narrator_zh": "燕"
  },
  {
   "location": "48/TALK",
   "narrator": "ガブリエラ",
   "text": "いや、つばめはそう思う\nかもしれないけど。"
  },
  {
   "location": "51/TALK",
   "narrator": "ガブリエラ",
   "text": "あたしは別に\nそんなに興味\nなかったし。"
  },
  {
   "location": "53/TALK",
   "narrator": "アーヤ",
   "text": "その割には\n気に入ってる\nみたいだけど？",
   "zh": "可是\n看起来还挺喜欢\n的？",
   "narrator_zh": "绫水"
  },
  {
   "location": "54/TALK",
   "narrator": "みやび",
   "text": "あれよ。"
  },
  {
   "location": "55/TALK",
   "narrator": "みやび",
   "text": "本当はガブちゃんは\n一緒に来たい人が\nおるがで。"
  },
  {
   "location": "58/TALK",
   "narrator": "つばめ",
   "text": "えっ？\nそうなんですか！？",
   "zh": "诶？\n是这样吗！？",
   "narrator_zh": "燕"
  },
  {
   "location": "60/TALK",
   "narrator": "みやび",
   "text": "そうよ。\nけんど言い出せん。",
   "zh": "对啊。\n可是说不出口咯。",
   "narrator_zh": "雅"
  },
  {
   "location": "61/TALK",
   "narrator": "みやび",
   "text": "まっこと\nガブちゃんは\nかわいいねえ。"
  },
  {
   "location": "64/TALK",
   "narrator": "ガブリエラ",
   "text": "ちょ、ちょっとみやび！\nつばめも！　そんな人\nいないから！",
   "zh": "等、等一下，雅！\n燕也是！根本没有\n那种人！",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "65/TALK",
   "narrator": "アーヤ",
   "text": "あら、そうなの？"
  },
  {
   "location": "66/TALK",
   "narrator": "ガブリエラ",
   "text": "い、いないったら！",
   "zh": "不、不在就是不在！",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "74/TALK",
   "narrator": "ガブリエラ",
   "text": "ねえ、$handle$",
   "zh": "喂，$handle$",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "75/TALK",
   "narrator": "ガブリエラ",
   "text": "この話を止めたいんだけど、どうすればいいと思う？",
   "zh": "我想停下这个话题，你觉得该怎么办？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "77/SEL",
   "narrator": "",
   "text": "怒るべきだろう",
   "zh": "生气是应该的吧",
   "narrator_zh": ""
  },
  {
   "location": "78/SEL",
   "narrator": "",
   "text": "お礼を言えば",
   "zh": "说句谢谢就好",
   "narrator_zh": ""
  },
  {
   "location": "79/SEL",
   "narrator": "",
   "text": "のろけてみれば",
   "zh": "试着秀一下恩爱嘛",
   "narrator_zh": ""
  },
  {
   "location": "80/ACT",
   "narrator": "",
   "text": "怒るべきだろう",
   "zh": "生气是应该的吧",
   "narrator_zh": ""
  },
  {
   "location": "81/TALK",
   "narrator": "ガブリエラ",
   "text": "…やっぱり、それしかないわよね",
   "zh": "……果然，只能那样了吧。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "87/TALK",
   "narrator": "ガブリエラ",
   "text": "…でも、ここではあまり\n怒りたくないような…。"
  },
  {
   "location": "88/TALK",
   "narrator": "ガブリエラ",
   "text": "っていうか、いつもなら\nもっと早い段階で怒って\nるはずなのに…。",
   "zh": "话说，要是平常，\n应该更早一点\n就发火了才对……。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "90/TALK",
   "narrator": "アーヤ",
   "text": "ふふ。\nうまくいくと\nいいわね。"
  },
  {
   "location": "93/TALK",
   "narrator": "つばめ",
   "text": "あっ！\nもしかして\n恋の話ですか？"
  },
  {
   "location": "95/TALK",
   "narrator": "ガブリエラ",
   "text": "なっ！？",
   "zh": "什！？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "98/TALK",
   "narrator": "ガブリエラ",
   "text": "何言ってんのよ！\nそんな話全然\nないわよ！？"
  },
  {
   "location": "100/TALK",
   "narrator": "つばめ",
   "text": "そうなんですか……。",
   "zh": "是这样吗……。",
   "narrator_zh": "燕"
  },
  {
   "location": "101/TALK",
   "narrator": "ガブリエラ",
   "text": "そうよ！",
   "zh": "就是这样！",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "104/TALK",
   "narrator": "ガブリエラ",
   "text": "それにか、仮に、\nそうだった\nとしても！",
   "zh": "而且就算，\n就算真是\n那样！",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "106/TALK",
   "narrator": "ガブリエラ",
   "text": "そんなこと、他人に\n決めつけられたく\nないわ。",
   "zh": "那种事，我不想被\n别人\n一口咬定。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "107/TALK",
   "narrator": "ガブリエラ",
   "text": "あたしのことで、\n勝手なこと言わないで！"
  },
  {
   "location": "109/TALK",
   "narrator": "アーヤ",
   "text": "もぉ、ギャヴィ。\nそれくらいにしたら？"
  },
  {
   "location": "111/TALK",
   "narrator": "ガブリエラ",
   "text": "何であたしなのよ？"
  },
  {
   "location": "112/TALK",
   "narrator": "ガブリエラ",
   "text": "怒らせるようなこと\n言ったのは、つばめ達\nじゃない。"
  },
  {
   "location": "114/TALK",
   "narrator": "アーヤ",
   "text": "そうかもしれないけど、\nあなたも落ち着きなさい\nって。",
   "zh": "也许是这样，\n你也冷静一点\n吧。",
   "narrator_zh": "绫水"
  },
  {
   "location": "115/TALK",
   "narrator": "アーヤ",
   "text": "そんなに怒ってたら、\n美味しいデザートが\n台無しよ？",
   "zh": "生那么大的气，\n好吃的甜点\n都要毁了哦？",
   "narrator_zh": "绫水"
  },
  {
   "location": "117/TALK",
   "narrator": "ガブリエラ",
   "text": "…………。"
  },
  {
   "location": "120/TALK",
   "narrator": "つばめ",
   "text": "そ、そうですね。\nほら、ガブちゃん。\n早く食べよ。",
   "zh": "是、是啊。\n来，加布。\n快点吃吧。",
   "narrator_zh": "燕"
  },
  {
   "location": "122/TALK",
   "narrator": "みやび",
   "text": "もうこの話はせんき、\n機嫌直しぃ。"
  },
  {
   "location": "124/TALK",
   "narrator": "ガブリエラ",
   "text": "…ふんっ。",
   "zh": "……哼。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "125/ACT",
   "narrator": "",
   "text": "お礼を言えば",
   "zh": "说句谢谢就好",
   "narrator_zh": ""
  },
  {
   "location": "126/TALK",
   "narrator": "ガブリエラ",
   "text": "何でそうなるのよ？",
   "zh": "怎么会变成这样啊？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "127/TALK",
   "narrator": "ガブリエラ",
   "text": "私が言ったこと、ちゃんと聞いてたの？"
  },
  {
   "location": "128/TALK",
   "narrator": "ガブリエラ",
   "text": "まったく、使用人のクセに使えないわね"
  },
  {
   "location": "130/SEL",
   "narrator": "",
   "text": "ヒカルと仲良くなれるかもよ",
   "zh": "说不定能和光处好关系哦",
   "narrator_zh": ""
  },
  {
   "location": "131/ACT",
   "narrator": "",
   "text": "ヒカルと仲良くなれるかもよ",
   "zh": "说不定能和光处好关系哦",
   "narrator_zh": ""
  },
  {
   "location": "133/TALK",
   "narrator": "ガブリエラ",
   "text": "えっ///////////////"
  },
  {
   "location": "134/TALK",
   "narrator": "ガブリエラ",
   "text": "そんな都合のいいことあるのかしら//////",
   "zh": "会有那么凑巧的事吗//////",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "135/TALK",
   "narrator": "ガブリエラ",
   "text": "それに別にまだ何にもしてもらってないし",
   "zh": "而且其实还什么都没让人帮过",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "136/TALK",
   "narrator": "ガブリエラ",
   "text": "それなのにお礼なんて…",
   "zh": "明明这样还要道谢……",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "138/SEL",
   "narrator": "",
   "text": "言った方がいいと思うな",
   "zh": "我觉得说出来比较好",
   "narrator_zh": ""
  },
  {
   "location": "139/ACT",
   "narrator": "",
   "text": "言った方がいいと思うな",
   "zh": "我觉得说出来比较好",
   "narrator_zh": ""
  },
  {
   "location": "141/TALK",
   "narrator": "ガブリエラ",
   "text": "…じゃあ、百歩譲って"
  },
  {
   "location": "142/TALK",
   "narrator": "ガブリエラ",
   "text": "ここに来るのに付き合ってあげたことに対して、みんなが私にお礼を言ったら",
   "zh": "陪你来这里，大家该向我道谢才对",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "143/TALK",
   "narrator": "ガブリエラ",
   "text": "私もお礼を返すことにするわ"
  },
  {
   "location": "151/TALK",
   "narrator": "アーヤ",
   "text": "一緒に来たい人って\n誰なのか\n聞いてもいい？"
  },
  {
   "location": "153/TALK",
   "narrator": "ガブリエラ",
   "text": "い、いないったら！",
   "zh": "不、不在就是不在！",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "154/TALK",
   "narrator": "ガブリエラ",
   "text": "いないから\nこうやってみんなと\n来たんでしょ？"
  },
  {
   "location": "156/TALK",
   "narrator": "みやび",
   "text": "うんうん。\nみんなでな。"
  },
  {
   "location": "159/TALK",
   "narrator": "ガブリエラ",
   "text": "…何よ、お礼でも\n言ってもらいたいわけ？",
   "zh": "……干嘛呀，你是想让我\n跟你说声谢谢？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "160/TALK",
   "narrator": "みやび",
   "text": "そんなつもりは\nないけんど。",
   "zh": "我倒是没\n那个意思咯。",
   "narrator_zh": "雅"
  },
  {
   "location": "161/TALK",
   "narrator": "みやび",
   "text": "ガブちゃんが言いたい\nいうなら、喜んで\n聞かせてもらうちや。"
  },
  {
   "location": "164/TALK",
   "narrator": "ガブリエラ",
   "text": "言ってほしいなら、\nとりあえずあんた達から\n先にお礼を言いなさい。"
  },
  {
   "location": "165/TALK",
   "narrator": "ガブリエラ",
   "text": "ここに来るの\nわざわざ付き合って\nあげたんだから。",
   "zh": "可是特地陪你\n来这里\n的哦。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "166/TALK",
   "narrator": "ガブリエラ",
   "text": "そのことのお礼を\n言ってくれたら、\nあたしも言うわ。",
   "zh": "你要是为那件事\n道谢的话，\n我也说。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "167/TALK",
   "narrator": "みやび",
   "text": "…マジか？",
   "zh": "……真的假的？",
   "narrator_zh": "雅"
  },
  {
   "location": "168/TALK",
   "narrator": "ガブリエラ",
   "text": "何よ？\nあたしがウソついてる\nっていうの！？"
  },
  {
   "location": "169/TALK",
   "narrator": "みやび",
   "text": "それは疑っちょらん\nけんど。",
   "zh": "那个我\n并不怀疑咯。",
   "narrator_zh": "雅"
  },
  {
   "location": "170/TALK",
   "narrator": "みやび",
   "text": "本命に\nとっといた方が\nえいと思うぞね。"
  },
  {
   "location": "173/TALK",
   "narrator": "アーヤ",
   "text": "そうね。",
   "zh": "是啊。",
   "narrator_zh": "绫水"
  },
  {
   "location": "174/TALK",
   "narrator": "アーヤ",
   "text": "好きな相手には\n素直にならなきゃ。"
  },
  {
   "location": "176/TALK",
   "narrator": "ガブリエラ",
   "text": "なっ！？\n何でそうなるのよ！！",
   "zh": "什！？\n为什么会那样！！",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "177/TALK",
   "narrator": "アーヤ",
   "text": "だって、ちゃんと\n言わないと\n伝わらないもの。",
   "zh": "因为，不好好说出来\n就传达\n不到啊。",
   "narrator_zh": "绫水"
  },
  {
   "location": "180/TALK",
   "narrator": "つばめ",
   "text": "そうですよね…。",
   "zh": "是这样吧……。",
   "narrator_zh": "燕"
  },
  {
   "location": "181/TALK",
   "narrator": "みやび",
   "text": "そうそう。\n素直が一番ぞね。",
   "zh": "对对。\n坦率最重要咯。",
   "narrator_zh": "雅"
  },
  {
   "location": "182/TALK",
   "narrator": "ガブリエラ",
   "text": "好きな人なんて\nいないって\n言ってるでしょ！？"
  },
  {
   "location": "186/TALK",
   "narrator": "つばめ",
   "text": "それはちょっと\n残念…。",
   "zh": "那有点\n遗憾……。",
   "narrator_zh": "燕"
  },
  {
   "location": "188/TALK",
   "narrator": "ガブリエラ",
   "text": "うるさい！\nもうこの話おしまい！"
  },
  {
   "location": "189/ACT",
   "narrator": "",
   "text": "のろけてみれば",
   "zh": "试着秀一下恩爱嘛",
   "narrator_zh": ""
  },
  {
   "location": "191/TALK",
   "narrator": "ガブリエラ",
   "text": "なっ！？",
   "zh": "什！？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "192/TALK",
   "narrator": "ガブリエラ",
   "text": "どうしてそうなるのよ！",
   "zh": "为什么会那样！",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "193/TALK",
   "narrator": "ガブリエラ",
   "text": "大体、のろけるようなことなんてないわ"
  },
  {
   "location": "194/TALK",
   "narrator": "ガブリエラ",
   "text": "あたしとヒカルくんは、そういう関係じゃないんだし"
  },
  {
   "location": "195/TALK",
   "narrator": "ガブリエラ",
   "text": "$handle$だって知ってるでしょ？",
   "zh": "$handle$你也知道吧？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "203/TALK",
   "narrator": "アーヤ",
   "text": "…ふふっ。\nまんざらでもない\nみたいね。",
   "zh": "……呵呵。\n看来你也不是\n完全没那个意思呢。",
   "narrator_zh": "绫水"
  },
  {
   "location": "205/TALK",
   "narrator": "ガブリエラ",
   "text": "…えっ？\nな、何よ、人の顔\nジロジロ見て…。"
  },
  {
   "location": "209/TALK",
   "narrator": "つばめ",
   "text": "ガブちゃん、\n顔真っ赤だよ。"
  },
  {
   "location": "210/TALK",
   "narrator": "つばめ",
   "text": "やっぱり\n好きな人が\nいるんだね。"
  },
  {
   "location": "211/TALK",
   "narrator": "ガブリエラ",
   "text": "は、はぁ！？\nないない！！\nいないから！！",
   "zh": "是、哈！？\n不可能不可能！！\n根本没有！！",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "212/TALK",
   "narrator": "みやび",
   "text": "けんど、少しは\n意識しとる\n感じやね？",
