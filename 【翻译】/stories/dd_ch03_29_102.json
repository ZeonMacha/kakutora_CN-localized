{
    "dir": "chap29/daydra/dd_ch03_29_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "29305",
        "cid": "gabriella",
        "title": "005 メインストーリー",
        "sub_title": "かしこみかしこみ＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "诚惶诚恐＜后篇＞"
    },
    "entry": [
        {
            "location": "489/SCENARIO",
            "narrator": "",
            "text": "未来に触れるなら",
            "zh": "若要触及未来",
            "narrator_zh": ""
        },
        {
            "location": "517/TALK",
            "narrator": "ガブリエラ",
            "text": "もう！\nみやびが変なこと\n言うから！",
            "zh": "真是的！\n都怪雅说些\n奇怪的话！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "520/TALK",
            "narrator": "みやび",
            "text": "うちは可能性の\n話をしただけぞね。",
            "zh": "我只是说说各种可能性\n而已啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "521/TALK",
            "narrator": "ガブリエラ",
            "text": "でもあたし思ったの。",
            "zh": "不过我刚才在想啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "522/TALK",
            "narrator": "ガブリエラ",
            "text": "本当のことは\nわからないけど。",
            "zh": "真正的事情\n虽然还不清楚。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "523/TALK",
            "narrator": "ガブリエラ",
            "text": "少なくともつばめは\nあたしたちのこと\n嫌いじゃないって。",
            "zh": "但至少燕她\n对我们\n并不是讨厌才对。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "526/TALK",
            "narrator": "みやび",
            "text": "理由は？",
            "zh": "理由呢？",
            "narrator_zh": "雅"
        },
        {
            "location": "528/TALK",
            "narrator": "ガブリエラ",
            "text": "だってそうでなきゃ\nまたあたしたちを\n集めたりしない。",
            "zh": "因为要不是那样的话，\n她也不会再把我们\n聚集到一起了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "529/TALK",
            "narrator": "ガブリエラ",
            "text": "そうでしょ？",
            "zh": "你说对吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "530/SEL",
            "narrator": "",
            "text": "$me$もそう思う",
            "zh": "$me$也这么觉得",
            "narrator_zh": ""
        },
        {
            "location": "531/SEL",
            "narrator": "",
            "text": "楽天主義だね",
            "zh": "真是乐观主义呢",
            "narrator_zh": ""
        },
        {
            "location": "532/SEL",
            "narrator": "",
            "text": "それはどうかな…",
            "zh": "那可不好说啊……",
            "narrator_zh": ""
        },
        {
            "location": "533/ACT",
            "narrator": "",
            "text": "$me$もそう思う",
            "zh": "$me$也这么觉得",
            "narrator_zh": ""
        },
        {
            "location": "534/ACT",
            "narrator": "",
            "text": "楽天主義だね",
            "zh": "真是乐观主义呢",
            "narrator_zh": ""
        },
        {
            "location": "535/ACT",
            "narrator": "",
            "text": "それはどうかな…",
            "zh": "那可不好说啊……",
            "narrator_zh": ""
        },
        {
            "location": "553/TALK",
            "narrator": "ガブリエラ",
            "text": "違うかしら",
            "zh": "难道不是吗",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "555/SEL",
            "narrator": "",
            "text": "違わないよ",
            "zh": "没有那回事哦",
            "narrator_zh": ""
        },
        {
            "location": "556/SEL",
            "narrator": "",
            "text": "友情って感じだね",
            "zh": "很有友情的感觉呢",
            "narrator_zh": ""
        },
        {
            "location": "557/SEL",
            "narrator": "",
            "text": "$me$もまた出会いたい",
            "zh": "$me$也想再和大家相遇",
            "narrator_zh": ""
        },
        {
            "location": "558/ACT",
            "narrator": "",
            "text": "違わないよ",
            "zh": "没有那回事哦",
            "narrator_zh": ""
        },
        {
            "location": "559/TALK",
            "narrator": "ガブリエラ",
            "text": "そうよね",
            "zh": "就是说嘛",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "560/TALK",
            "narrator": "ガブリエラ",
            "text": "よかったわ",
            "zh": "太好了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "562/ACT",
            "narrator": "",
            "text": "友情って感じだね",
            "zh": "很有友情的感觉呢",
            "narrator_zh": ""
        },
        {
            "location": "563/TALK",
            "narrator": "ガブリエラ",
            "text": "そうかもしれないわ",
            "zh": "说不定是这样呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "564/TALK",
            "narrator": "ガブリエラ",
            "text": "先輩と後輩だけど",
            "zh": "虽然一个是前辈一个是后辈",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "566/ACT",
            "narrator": "",
            "text": "$me$もまた出会いたい",
            "zh": "$me$也想再和大家相遇",
            "narrator_zh": ""
        },
        {
            "location": "567/TALK",
            "narrator": "ガブリエラ",
            "text": "そんなのｖｖｖ",
            "zh": "那种事vvv",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "568/TALK",
            "narrator": "ガブリエラ",
            "text": "当たり前よね///////////////",
            "zh": "那不是理所当然的嘛///////////////",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "584/TALK",
            "narrator": "みやび",
            "text": "夜の魔法はすごいねえ。",
            "zh": "夜晚的魔法真厉害咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "585/TALK",
            "narrator": "ガブリエラ",
            "text": "へ？",
            "zh": "诶？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "586/TALK",
            "narrator": "みやび",
            "text": "ガブちゃんがこんなに\n素直にデレるところが\n拝めるとは。",
            "zh": "居然能见识到加布\n这么坦率地撒娇娇羞的模样，\n真是稀奇咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "589/TALK",
            "narrator": "ガブリエラ",
            "text": "何よそれ！",
            "zh": "你在胡说什么呀！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "592/TALK",
            "narrator": "アーヤ",
            "text": "私もギャヴィと\n同じことを考えてた。",
            "zh": "其实我也和加维\n想的是同一件事。",
            "narrator_zh": "绫水"
        },
        {
            "location": "593/TALK",
            "narrator": "アーヤ",
            "text": "つばめの期待に\n応えないとね。",
            "zh": "我们可得回应\n燕的期待才行呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "595/TALK",
            "narrator": "ガブリエラ",
            "text": "…う、うん…。",
            "zh": "……嗯、嗯……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "597/TALK",
            "narrator": "アーヤ",
            "text": "ところでみやび。\nあなたも禊ぎ、\nしておかない？",
            "zh": "话说雅。\n你也要不要\n行个禊？",
            "narrator_zh": "绫水"
        },
        {
            "location": "599/TALK",
            "narrator": "みやび",
            "text": "うちか……。",
            "zh": "我啊……。",
            "narrator_zh": "雅"
        },
        {
            "location": "601/TALK",
            "narrator": "みやび",
            "text": "正直面倒やけんど。\nその衣装は着てみたいき。\nしとこうかねえ。",
            "zh": "说实话蛮麻烦的，不过。\n那身衣服我倒想穿一穿啵。\n那就行个禊咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "602/TALK",
            "narrator": "アーヤ",
            "text": "だったら早速。\n着付けは問題\nないわね。",
            "zh": "那我们这就去吧。\n穿衣方面应该\n没问题吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "605/TALK",
            "narrator": "みやび",
            "text": "いや、袴は\nわからんぞね…。",
            "zh": "不是，这袴\n我不晓得怎么穿啵……。",
            "narrator_zh": "雅"
        },
        {
            "location": "637/TALK",
            "narrator": "みやび",
            "text": "ふむ。\nこれはこれで。",
            "zh": "嗯。\n倒也别有一番风味。",
            "narrator_zh": "雅"
        },
        {
            "location": "638/TALK",
            "narrator": "アーヤ",
            "text": "ふふ。",
            "zh": "呵呵。",
            "narrator_zh": "绫水"
        },
        {
            "location": "641/TALK",
            "narrator": "みやび",
            "text": "どういた？",
            "zh": "怎么了喃？",
            "narrator_zh": "雅"
        },
        {
            "location": "643/TALK",
            "narrator": "アーヤ",
            "text": "５月まではこの三人\nだったなって。",
            "zh": "我在想，５月之前\n一直都是我们三个人啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "645/TALK",
            "narrator": "ガブリエラ",
            "text": "確かにそうね。\nある意味原点回帰？",
            "zh": "确实是呢。\n某种意义上算是回归原点？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "647/TALK",
            "narrator": "アーヤ",
            "text": "かもしれないわ。",
            "zh": "说不定吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "649/TALK",
            "narrator": "アーヤ",
            "text": "では、成功を\n祈願して――。",
            "zh": "那么，为了祈愿\n行动成功——。",
            "narrator_zh": "绫水"
        },
        {
            "location": "664/DIALOG",
            "narrator": "Dialog_chapter_ch03",
            "text": "【MV EXE_MiYABi】",
            "zh": "【MV EXE_MiYABi】",
            "narrator_zh": "Dialog_chapter_ch03"
        }
    ]
}
