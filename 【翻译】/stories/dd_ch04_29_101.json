{
    "dir": "chap29/daydra/dd_ch04_29_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "29402",
        "cid": "miyabi",
        "title": "002 メインストーリー",
        "sub_title": "向かい合わせの鏡＜前編＞",
        "title_zh": "002 主线剧情",
        "sub_title_zh": "相向之镜＜前篇＞"
    },
    "entry": [
        {
            "location": "8/SCENARIO",
            "narrator": "",
            "text": "平行世界サバイバル",
            "zh": "平行世界求生记",
            "narrator_zh": ""
        },
        {
            "location": "27/TALK",
            "narrator": "みやび",
            "text": "…うちの方で\nわかったことは\n以上です。",
            "zh": "……我这边\n查明的事，\n就是以上这些。",
            "narrator_zh": "雅"
        },
        {
            "location": "28/TALK",
            "narrator": "真幌",
            "text": "そうか。\nご苦労さん。",
            "zh": "这样啊。\n辛苦了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "29/TALK",
            "narrator": "真幌",
            "text": "音羽を連れて来いと\nいうのはそういう\n理由だったのか。",
            "zh": "要带上音羽过来，\n原来是出于\n这个理由啊。",
            "narrator_zh": "真幌"
        },
        {
            "location": "31/TALK",
            "narrator": "真幌",
            "text": "ううん……。",
            "zh": "唔嗯……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "32/TALK",
            "narrator": "みやび",
            "text": "…まほさん。",
            "zh": "……真幌。",
            "narrator_zh": "雅"
        },
        {
            "location": "33/TALK",
            "narrator": "みやび",
            "text": "エリカさんと\nまほさんってどういう\n関係ですか？",
            "zh": "领火和真幌\n到底是什么\n关系？",
            "narrator_zh": "雅"
        },
        {
            "location": "34/TALK",
            "narrator": "真幌",
            "text": "…んー。",
            "zh": "……嗯——。",
            "narrator_zh": "真幌"
        },
        {
            "location": "36/TALK",
            "narrator": "真幌",
            "text": "知り合いだ、と\nいうだけでは\n納得できないか。",
            "zh": "只说是熟人，\n你们没法\n信服吗。",
            "narrator_zh": "真幌"
        },
        {
            "location": "37/TALK",
            "narrator": "みやび",
            "text": "それと。",
            "zh": "还有。",
            "narrator_zh": "雅"
        },
        {
            "location": "38/TALK",
            "narrator": "みやび",
            "text": "今エリカさんは\nどこにおるんですか？",
            "zh": "现在领火\n人在哪里？",
            "narrator_zh": "雅"
        },
        {
            "location": "40/TALK",
            "narrator": "真幌",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "42/TALK",
            "narrator": "真幌",
            "text": "外の空気を\n吸いに行こうか。",
            "zh": "出去\n透透气吧。",
            "narrator_zh": "真幌"
        },
        {
            "location": "59/TALK",
            "narrator": "真幌",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "60/TALK",
            "narrator": "みやび",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "雅"
        },
        {
            "location": "61/TALK",
            "narrator": "真幌",
            "text": "こういうところで\n余生を暮らすのも\n悪くないな。",
            "zh": "在这种地方\n度过余生，\n也不坏啊。",
            "narrator_zh": "真幌"
        },
        {
            "location": "63/TALK",
            "narrator": "みやび",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "雅"
        },
        {
            "location": "65/TALK",
            "narrator": "真幌",
            "text": "そうは思わないか？",
            "zh": "你不这么觉得吗？",
            "narrator_zh": "真幌"
        },
        {
            "location": "69/TALK",
            "narrator": "みやび",
            "text": "…うちには\n無理そうです。\nそういう生活は。",
            "zh": "……对我来说，\n好像没法\n过那种生活。",
            "narrator_zh": "雅"
        },
        {
            "location": "70/TALK",
            "narrator": "みやび",
            "text": "こう言うたら悪いかも\nしれんけんど、\nサバイバルすぎます。",
            "zh": "这么说或许失礼，\n但是，\n这也太荒野求生了。",
            "narrator_zh": "雅"
        },
        {
            "location": "71/TALK",
            "narrator": "真幌",
            "text": "そうか？",
            "zh": "是吗？",
            "narrator_zh": "真幌"
        },
        {
            "location": "72/TALK",
            "narrator": "真幌",
            "text": "ここには電気もある。\n水道もガスもある。\n住民に戦闘意思もない。",
            "zh": "这里有电。\n自来水燃气俱全。\n居民也无战斗之意。",
            "narrator_zh": "真幌"
        },
        {
            "location": "73/TALK",
            "narrator": "真幌",
            "text": "通貨の使用もできるし\n罠を仕掛けられる\nこともないぞ。",
            "zh": "货币可以照常使用，\n也不会有人\n设陷阱害你。",
            "narrator_zh": "真幌"
        },
        {
            "location": "74/SEL",
            "narrator": "",
            "text": "真幌って何者？",
            "zh": "真幌到底是什么人？",
            "narrator_zh": ""
        },
        {
            "location": "75/SEL",
            "narrator": "",
            "text": "すごいこと言い出したよ！？",
            "zh": "突然说好惊人的话！？",
            "narrator_zh": ""
        },
        {
            "location": "76/SEL",
            "narrator": "",
            "text": "冒険活劇開幕！",
            "zh": "冒险活剧开幕！",
            "narrator_zh": ""
        },
        {
            "location": "77/ACT",
            "narrator": "",
            "text": "真幌って何者？",
            "zh": "真幌到底是什么人？",
            "narrator_zh": ""
        },
        {
            "location": "78/ACT",
            "narrator": "",
            "text": "すごいこと言い出したよ！？",
            "zh": "突然说好惊人的话！？",
            "narrator_zh": ""
        },
        {
            "location": "79/ACT",
            "narrator": "",
            "text": "冒険活劇開幕！",
            "zh": "冒险活剧开幕！",
            "narrator_zh": ""
        },
        {
            "location": "96/TALK",
            "narrator": "みやび",
            "text": "$handle$は",
            "zh": "$handle$你",
            "narrator_zh": "雅"
        },
        {
            "location": "97/TALK",
            "narrator": "みやび",
            "text": "何も知らぬのか？",
            "zh": "什么都不知道？",
            "narrator_zh": "雅"
        },
        {
            "location": "99/SEL",
            "narrator": "",
            "text": "知ってるわけない",
            "zh": "怎么可能知道",
            "narrator_zh": ""
        },
        {
            "location": "100/SEL",
            "narrator": "",
            "text": "いろいろ聞き出してよ",
            "zh": "多套点话来嘛",
            "narrator_zh": ""
        },
        {
            "location": "101/SEL",
            "narrator": "",
            "text": "元傭兵か何かなのかな？",
            "zh": "是前雇佣兵之类的吗？",
            "narrator_zh": ""
        },
        {
            "location": "102/ACT",
            "narrator": "",
            "text": "知ってるわけない",
            "zh": "怎么可能知道",
            "narrator_zh": ""
        },
        {
            "location": "103/TALK",
            "narrator": "みやび",
            "text": "そうか",
            "zh": "这样啊",
            "narrator_zh": "雅"
        },
        {
            "location": "104/TALK",
            "narrator": "みやび",
            "text": "残念だの",
            "zh": "遗憾呐。",
            "narrator_zh": "雅"
        },
        {
            "location": "105/ACT",
            "narrator": "",
            "text": "いろいろ聞き出してよ",
            "zh": "多套点话来嘛",
            "narrator_zh": ""
        },
        {
            "location": "106/TALK",
            "narrator": "みやび",
            "text": "確かに",
            "zh": "确实",
            "narrator_zh": "雅"
        },
        {
            "location": "107/TALK",
            "narrator": "みやび",
            "text": "気になるの",
            "zh": "很好奇嘛",
            "narrator_zh": "雅"
        },
        {
            "location": "108/ACT",
            "narrator": "",
            "text": "元傭兵か何かなのかな？",
            "zh": "是前雇佣兵之类的吗？",
            "narrator_zh": ""
        },
        {
            "location": "109/TALK",
            "narrator": "みやび",
            "text": "どうにも",
            "zh": "总觉得",
            "narrator_zh": "雅"
        },
        {
            "location": "110/TALK",
            "narrator": "みやび",
            "text": "そんな言い草",
            "zh": "这个说法啊……",
            "narrator_zh": "雅"
        },
        {
            "location": "123/TALK",
            "narrator": "みやび",
            "text": "まほさんは\nそんな経験が\nあるんですか？",
            "zh": "真幌您\n有过那种\n经历吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "125/TALK",
            "narrator": "真幌",
            "text": "…ものの例えと\nいうことにして\nおいてくれ。",
            "zh": "……就当作是\n打个比方，\n别追问了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "126/TALK",
            "narrator": "真幌",
            "text": "それより今は\nエリカのことだろ。",
            "zh": "比起这个，现在\n该谈领火的事了吧。",
            "narrator_zh": "真幌"
        },
        {
            "location": "127/TALK",
            "narrator": "みやび",
            "text": "…そうですね。",
            "zh": "……也是呢。",
            "narrator_zh": "雅"
        },
        {
            "location": "131/TALK",
            "narrator": "みやび",
            "text": "正直何もかもが\n現実離れしすぎてて\n理解がおいつかないです。",
            "zh": "老实说，一切都\n脱离现实得厉害，\n我理解跟不上。",
            "narrator_zh": "雅"
        },
        {
            "location": "132/TALK",
            "narrator": "みやび",
            "text": "いっそ全てが冗談やと\n言われた方がいいような\n気すらします。",
            "zh": "倒不如说全都\n是玩笑，我反而\n好受些。",
            "narrator_zh": "雅"
        },
        {
            "location": "133/TALK",
            "narrator": "真幌",
            "text": "確かにな。",
            "zh": "确实啊。",
            "narrator_zh": "真幌"
        },
        {
            "location": "134/TALK",
            "narrator": "真幌",
            "text": "だが最悪の事態は\n避けられている。\nつばめのおかげで。",
            "zh": "但最坏的事态\n已经避开了。\n多亏了燕。",
            "narrator_zh": "真幌"
        },
        {
            "location": "135/TALK",
            "narrator": "みやび",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "雅"
        },
        {
            "location": "136/TALK",
            "narrator": "真幌",
            "text": "違うか？",
            "zh": "不对吗？",
            "narrator_zh": "真幌"
        },
        {
            "location": "137/TALK",
            "narrator": "みやび",
            "text": "そうかもしれん。",
            "zh": "也许是这样。",
            "narrator_zh": "雅"
        },
        {
            "location": "138/TALK",
            "narrator": "みやび",
            "text": "けんど、それはあくまで\nこの世界の中にいて\n思っているだけの話。",
            "zh": "但是，那终究只是\n身在这世界之中\n才有的想法。",
            "narrator_zh": "雅"
        },
        {
            "location": "140/TALK",
            "narrator": "みやび",
            "text": "「そう思わされてるだけ」\nじゃないと誰が言える？",
            "zh": "又有谁能说这不是\n「只是被灌输了这种想法」呢？",
            "narrator_zh": "雅"
        },
        {
            "location": "188/TALK",
            "narrator": "みやび",
            "text": "　",
            "zh": "　",
            "narrator_zh": "雅"
        },
        {
            "location": "208/TALK",
            "narrator": "みやびの新司書",
            "text": "ようこそ。",
            "zh": "欢迎。",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "209/SEL",
            "narrator": "",
            "text": "新しい司書か",
            "zh": "是新司书啊",
            "narrator_zh": ""
        },
        {
            "location": "210/ACT",
            "narrator": "",
            "text": "新しい司書か",
            "zh": "是新司书啊",
            "narrator_zh": ""
        },
        {
            "location": "212/TALK",
            "narrator": "みやびの新司書",
            "text": "うむ。\nよう逃げずに来たね。",
            "zh": "唔。\n没逃，来得很好。",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "213/TALK",
            "narrator": "みやびの新司書",
            "text": "逃げちょったら\nシンギュラリティは既に\nお前さんを忘れちょった。",
            "zh": "要是你逃了，\n奇点这会儿\n早就把你忘光咯。",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "214/TALK",
            "narrator": "みやびの新司書",
            "text": "ほんだら早速やけんど、\n最終的な回答を\n聞きたいと思う。",
            "zh": "那就，开门见山，\n我想听听你的\n最终回答。",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "215/TALK",
            "narrator": "みやびの新司書",
            "text": "現実のうちとの回線を\n切断するか。",
            "zh": "是切断与现实的\n我之间的线路，",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "216/TALK",
            "narrator": "みやびの新司書",
            "text": "シンギュラリティの\n記憶を操作するか。",
            "zh": "还是篡改奇点的\n记忆。",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "217/SEL",
            "narrator": "",
            "text": "回線を切断する",
            "zh": "切断线路",
            "narrator_zh": ""
        },
        {
            "location": "218/SEL",
            "narrator": "",
            "text": "回線を切断しない",
            "zh": "不切断线路",
            "narrator_zh": ""
        },
        {
            "location": "219/ACT",
            "narrator": "",
            "text": "回線を切断する",
            "zh": "切断线路",
            "narrator_zh": ""
        },
        {
            "location": "220/TALK",
            "narrator": "みやびの新司書",
            "text": "うむ、わかった。\nえい心がけやね。",
            "zh": "唔，明白了。\n是个好决心咯。",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "221/TALK",
            "narrator": "みやびの新司書",
            "text": "今まで長い間\nうちをひっかき回して\nくれてありがとう。",
            "zh": "这长期以来，\n把我搅得天翻地覆，\n多谢了。",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "222/TALK",
            "narrator": "みやびの新司書",
            "text": "ほんだら、さよなら。",
            "zh": "那就，再见。",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "232/ACT",
            "narrator": "",
            "text": "回線を切断しない",
            "zh": "不切断线路",
            "narrator_zh": ""
        },
        {
            "location": "234/TALK",
            "narrator": "みやびの新司書",
            "text": "ふむ。",
            "zh": "唔。",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "235/TALK",
            "narrator": "みやびの新司書",
            "text": "シンギュラリティは\n切って問題なしと\nゆうことやね。",
            "zh": "也就是说，奇点\n切了也没问题，\n是这意思咯。",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "236/TALK",
            "narrator": "みやびの新司書",
            "text": "１つヒントをやる。",
            "zh": "给你个提示。",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "237/TALK",
            "narrator": "みやびの新司書",
            "text": "以後のココロの司書は\nうちになる。",
            "zh": "今后的心之司书，\n由我来当。",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "238/TALK",
            "narrator": "みやびの新司書",
            "text": "てことは、今ここで\nうちとの回線を切断\nしようがしまいが――",
            "zh": "也就是说，现在\n不管你切不切断\n与我的线路——",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "239/TALK",
            "narrator": "みやびの新司書",
            "text": "結局のところ、現実の\nうちとはこれ以上の仲には\nなれんちゅうことや。",
            "zh": "归根结底，你和\n现实的我，都再也\n无法更进一步了咯。",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "240/SEL",
            "narrator": "",
            "text": "何故？",
            "zh": "为什么？",
            "narrator_zh": ""
        },
        {
            "location": "241/ACT",
            "narrator": "",
            "text": "何故？",
            "zh": "为什么？",
            "narrator_zh": ""
        },
        {
            "location": "243/TALK",
            "narrator": "みやびの新司書",
            "text": "まず第一に、\nシンギュラリティの記憶を\n消してしまうこと。",
            "zh": "第一，\n是要消掉\n奇点的记忆。",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "244/TALK",
            "narrator": "みやびの新司書",
            "text": "あやつはお前さんと\n現実のうちとの、潜在的な\nキューピット役やった。",
            "zh": "那家伙，\n原本是你和现实的我之间\n潜在的丘比特。",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "245/TALK",
            "narrator": "みやびの新司書",
            "text": "その記憶を失えば、\n現実のうちもまた、\nお前さんに興味を失う。",
            "zh": "失掉那份记忆，\n现实的我，\n也会对你失去兴趣。",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "246/TALK",
            "narrator": "みやびの新司書",
            "text": "もちろん完全にではないが\nそれでもダメージは\nそれなりにある筈や。",
            "zh": "当然不至于全失，\n但受到的打击，\n照样小不了。",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "247/TALK",
            "narrator": "みやびの新司書",
            "text": "第二には、うちが\nココロの司書になることで\nお前さんに否定的になる。",
            "zh": "第二，\n由我当上心之司书后，\n会对你持否定态度。",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "248/TALK",
            "narrator": "みやびの新司書",
            "text": "そうすれば、ココロの中\n全体でお前さんの評判は\n下落し――",
            "zh": "这样一来，整个\n内心世界里你的名声\n都会下滑——",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "249/TALK",
            "narrator": "みやびの新司書",
            "text": "現実のうちもまた、\nお前さんに対して\n疑心暗鬼になるわけやね。",
            "zh": "现实的我，\n自然也会对你\n疑神疑鬼咯。",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "250/SEL",
            "narrator": "",
            "text": "なるほど",
            "zh": "原来如此",
            "narrator_zh": ""
        },
        {
            "location": "251/SEL",
            "narrator": "",
            "text": "$me$に心を開けばいいんだよね？",
            "zh": "只要$me$打开心扉就行了吧？",
            "narrator_zh": ""
        },
        {
            "location": "252/ACT",
            "narrator": "",
            "text": "なるほど",
            "zh": "原来如此",
            "narrator_zh": ""
        },
        {
            "location": "253/TALK",
            "narrator": "みやびの新司書",
            "text": "やき、今のうちに\n撤退しておいた方が、\nお前さんの傷も浅い。",
            "zh": "嘛，趁现在收手，\n你的伤\n也能浅一些。",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "254/TALK",
            "narrator": "みやびの新司書",
            "text": "これはむしろ、\n良心から助言しちゅう\nことやき。",
            "zh": "这甚至，\n算是出于良心\n给你的忠告啵。",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "255/TALK",
            "narrator": "みやびの新司書",
            "text": "考え直したか？",
            "zh": "要重新考虑吗？",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "256/SEL",
            "narrator": "",
            "text": "はい",
            "zh": "是",
            "narrator_zh": ""
        },
        {
            "location": "257/SEL",
            "narrator": "",
            "text": "いいえ",
            "zh": "不是",
            "narrator_zh": ""
        },
        {
            "location": "258/ACT",
            "narrator": "",
            "text": "はい",
            "zh": "是",
            "narrator_zh": ""
        },
        {
            "location": "259/TALK",
            "narrator": "みやびの新司書",
            "text": "うむ、わかった。\nえい心がけやね。",
            "zh": "唔，明白了。\n是个好决心咯。",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "260/TALK",
            "narrator": "みやびの新司書",
            "text": "今まで長い間\nうちをひっかき回して\nくれてありがとう。",
            "zh": "这长期以来，\n把我搅得天翻地覆，\n多谢了。",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "261/TALK",
            "narrator": "みやびの新司書",
            "text": "ほんだら、さよなら。",
            "zh": "那就，再见。",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "271/ACT",
            "narrator": "",
            "text": "いいえ",
            "zh": "不是",
            "narrator_zh": ""
        },
        {
            "location": "275/ACT",
            "narrator": "",
            "text": "$me$に心を開けばいいんだよね？",
            "zh": "只要$me$打开心扉就行了吧？",
            "narrator_zh": ""
        },
        {
            "location": "278/TALK",
            "narrator": "みやびの新司書",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "279/TALK",
            "narrator": "みやびの新司書",
            "text": "頭悪いね。",
            "zh": "真笨呐。",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "280/TALK",
            "narrator": "みやびの新司書",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "281/TALK",
            "narrator": "みやびの新司書",
            "text": "そうやね、\nほんだら、これで\n手を打たんかね。",
            "zh": "是咯，\n那就，拿这个\n来谈笔交易如何。",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "282/TALK",
            "narrator": "みやびの新司書",
            "text": "近々また、なごちゃんの\n慰霊祭をやるがやけんど、\nそれに参加してくれんか。",
            "zh": "近期还要再办一次\n七五的慰灵祭，\n你愿意来参加吗。",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "283/TALK",
            "narrator": "みやびの新司書",
            "text": "してくれるがやったら、\nお前さんもシンギュラリ\nティも、少し猶予をやる。",
            "zh": "肯来的话，\n你和奇点，\n我就多宽限些时日。",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "284/SEL",
            "narrator": "",
            "text": "いいよ",
            "zh": "好啊",
            "narrator_zh": ""
        },
        {
            "location": "285/SEL",
            "narrator": "",
            "text": "どんな儀式？",
            "zh": "什么样的仪式？",
            "narrator_zh": ""
        },
        {
            "location": "286/ACT",
            "narrator": "",
            "text": "いいよ",
            "zh": "好啊",
            "narrator_zh": ""
        },
        {
            "location": "287/TALK",
            "narrator": "みやびの新司書",
            "text": "うむ。\n契約成立やね。",
            "zh": "唔。\n契约成立咯。",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "288/ACT",
            "narrator": "",
            "text": "どんな儀式？",
            "zh": "什么样的仪式？",
            "narrator_zh": ""
        },
        {
            "location": "290/TALK",
            "narrator": "みやびの新司書",
            "text": "名前の通り、\nなごちゃんを\n慰霊する会やよ。",
            "zh": "顾名思义，\n就是慰祭七五\n的集会咯。",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "291/TALK",
            "narrator": "みやびの新司書",
            "text": "それ以上でも\nそれ以下でもない。",
            "zh": "既不多，\n也不少。",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "292/SEL",
            "narrator": "",
            "text": "いいよ　",
            "zh": "好啊　",
            "narrator_zh": ""
        },
        {
            "location": "293/SEL",
            "narrator": "",
            "text": "いやだ",
            "zh": "不要",
            "narrator_zh": ""
        },
        {
            "location": "294/ACT",
            "narrator": "",
            "text": "いいよ　",
            "zh": "好啊　",
            "narrator_zh": ""
        },
        {
            "location": "296/TALK",
            "narrator": "みやびの新司書",
            "text": "うむ。\n契約成立やね。",
            "zh": "唔。\n契约成立咯。",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "297/ACT",
            "narrator": "",
            "text": "いやだ",
            "zh": "不要",
            "narrator_zh": ""
        },
        {
            "location": "298/TALK",
            "narrator": "みやびの新司書",
            "text": "はぁ…。",
            "zh": "哈啊……。",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "299/TALK",
            "narrator": "みやびの新司書",
            "text": "アレもダメ、これもダメ。\nわがまま小僧か。",
            "zh": "这也不行，那也不行。\n真是个任性小鬼。",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "301/TALK",
            "narrator": "みやびの新司書",
            "text": "時間切れ。",
            "zh": "时间到。",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "314/TALK",
            "narrator": "みやびの新司書",
            "text": "次回はなごちゃんの所へ\n一緒に行くき。\n準備しとき。",
            "zh": "下回就带你去\n七五那里咧。\n做好准备。",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "315/TALK",
            "narrator": "みやびの新司書",
            "text": "おやつは300円までな。\nバナナは別や。",
            "zh": "点心预算300円以内。\n香蕉另算。",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "316/TALK",
            "narrator": "みやびの新司書",
            "text": "ほな、またな――",
            "zh": "那就，回见——",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "317/SEL",
            "narrator": "",
            "text": "心の葛藤は！？",
            "zh": "心里的挣扎呢！？",
            "narrator_zh": ""
        },
        {
            "location": "318/ACT",
            "narrator": "",
            "text": "心の葛藤は！？",
            "zh": "心里的挣扎呢！？",
            "narrator_zh": ""
        },
        {
            "location": "320/TALK",
            "narrator": "みやびの新司書",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "321/TALK",
            "narrator": "みやびの新司書",
            "text": "別に心配せんでもえいよ？",
            "zh": "不用那么担心的咯？",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "322/TALK",
            "narrator": "みやびの新司書",
            "text": "葛藤を解消せんでも、\nうちはなんも困りはせん。",
            "zh": "就算不解开挣扎，\n我也没得任何困扰。",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "323/TALK",
            "narrator": "みやびの新司書",
            "text": "まあしかし、確かに今回\nまでは、普通の振る舞いを\nしておいた方がえいね。",
            "zh": "不过话说回来，\n到这次为止，确实还是\n装得普通些比较好咯。",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "324/TALK",
            "narrator": "みやびの新司書",
            "text": "次回からは、うちが\nココロの司書として\n徹底ブロックするけんど。",
            "zh": "但是，下回开始，\n我就会以心之司书的身份\n彻底封锁咯。",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "325/TALK",
            "narrator": "みやびの新司書",
            "text": "ほな、いくぞね。",
            "zh": "那就，出发咯。",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "355/TALK",
            "narrator": "みやびの新司書",
            "text": "……頭ごちゃごちゃやね。",
            "zh": "……脑袋里乱糟糟的咯。",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "356/TALK",
            "narrator": "みやびの新司書",
            "text": "少しクランの数を減らして\n頭整理せんと、アホな質問\n連発しゆうき。",
            "zh": "不清掉几个库兰\n整理下脑袋的话，\n蠢问题要连发了咧。",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "357/TALK",
            "narrator": "みやびの新司書",
            "text": "いい感じに\nやったってや。",
            "zh": "干得\n蛮漂亮的嘛。",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "358/TALK",
            "narrator": "みやびの新司書",
            "text": "ほな、\nうちとなごちゃんに\n素敵なココロの旅を。",
            "zh": "那么，\n祝我和七五\n一场美妙的心灵之旅。",
            "narrator_zh": "雅的新司书"
        },
        {
            "location": "26/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>9月5日　 3:36 PM</color>\n合宿中、みやびの実家でのこと",
            "zh": "<color=green>9月5日　 3:36 PM</color>\n合宿期间，在雅的老家发生的事",
            "narrator_zh": "Dialog_EventData"
        },
        {
