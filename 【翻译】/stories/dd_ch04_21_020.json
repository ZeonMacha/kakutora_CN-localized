{
    "dir": "chap21/daydra/dd_ch04_21_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "21456",
        "cid": "miyabi",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "落ち着く場所",
        "title_zh": "Extra006 额外剧情",
        "sub_title_zh": "让人安心的地方"
    },
    "entry": [
        {
            "location": "363/SCENARIO",
            "narrator": "",
            "text": "落ち着く場所",
            "zh": "让人安心的地方",
            "narrator_zh": ""
        },
        {
            "location": "376/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "380/TALK",
            "narrator": "真幌",
            "text": "どうかしたのか？",
            "zh": "怎么了？",
            "narrator_zh": "真幌"
        },
        {
            "location": "385/TALK",
            "narrator": "みやび",
            "text": "まほさん…\nいえ、特にどうもして\nないがですよ。",
            "zh": "真幌……\n不，我没觉得\n哪里不对哦。",
            "narrator_zh": "雅"
        },
        {
            "location": "386/TALK",
            "narrator": "真幌",
            "text": "そうか？",
            "zh": "是吗？",
            "narrator_zh": "真幌"
        },
        {
            "location": "387/TALK",
            "narrator": "みやび",
            "text": "…うち、何か変なとこ\nあります？",
            "zh": "……我有什么\n奇怪的地方吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "388/TALK",
            "narrator": "真幌",
            "text": "いや、ただ珍しいと\n思ってな。",
            "zh": "不，只是觉得\n稀奇而已。",
            "narrator_zh": "真幌"
        },
        {
            "location": "389/TALK",
            "narrator": "真幌",
            "text": "ＰＣの前ならまだしも、\n縁側でぼんやり\nしているなんて。",
            "zh": "坐在电脑前也就罢了，\n居然在檐廊上\n发呆。",
            "narrator_zh": "真幌"
        },
        {
            "location": "390/TALK",
            "narrator": "みやび",
            "text": "…言われてみて、\n自分でもビックリです。\nレアですよ。",
            "zh": "……被人一说，\n我自己也吓一跳。\n很稀有哦。",
            "narrator_zh": "雅"
        },
        {
            "location": "391/TALK",
            "narrator": "真幌",
            "text": "だろ？　だから何か\nあったのかと思ったん\nだが…。",
            "zh": "对吧？　所以我还以为\n出了什么事\n呢……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "392/TALK",
            "narrator": "みやび",
            "text": "…いや、本当に\n何でもないがです。",
            "zh": "……不，真的\n没什么事哦。",
            "narrator_zh": "雅"
        },
        {
            "location": "394/TALK",
            "narrator": "みやび",
            "text": "ただ…実家はやっぱし\n落ち着くな、と――",
            "zh": "只是……老家果然\n还是让人安心呢——",
            "narrator_zh": "雅"
        },
        {
            "location": "397/TALK",
            "narrator": "みやび",
            "text": "そんな気持ちになっちゅう\nだけですき。",
            "zh": "只是有了\n那种心情而已咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "398/TALK",
            "narrator": "真幌",
            "text": "…そうだったか。",
            "zh": "……是这样啊。",
            "narrator_zh": "真幌"
        },
        {
            "location": "400/TALK",
            "narrator": "みやび",
            "text": "…不思議なもんですね。",
            "zh": "……真不可思议呢。",
            "narrator_zh": "雅"
        },
        {
            "location": "401/TALK",
            "narrator": "みやび",
            "text": "高校に上がってから、\n三戸浜に引っ越して\nきて――",
            "zh": "上高中以后，\n搬到了三户滨\n——",
            "narrator_zh": "雅"
        },
        {
            "location": "403/TALK",
            "narrator": "みやび",
            "text": "一年ちょっとで、\nうちだけは東京の\n今の寮に引っ越したき――",
            "zh": "才过了一年多，\n就只有我搬去了东京\n现在的宿舍——",
            "narrator_zh": "雅"
        },
        {
            "location": "404/TALK",
            "narrator": "みやび",
            "text": "正直、土佐の家に比べて\n思い出なんかこれっぽっち\nもないがです。",
            "zh": "说实话，比起土佐的\n老家，回忆什么的\n一点点都没有哦。",
            "narrator_zh": "雅"
        },
        {
            "location": "405/TALK",
            "narrator": "みやび",
            "text": "なのに、ここを実家だと\n思えて安心しちゅう\n自分が――",
            "zh": "明明这样，我却\n把这里当成老家，\n安安心心地待着——",
            "narrator_zh": "雅"
        },
        {
            "location": "407/TALK",
            "narrator": "みやび",
            "text": "なんか、不思議で\n堪らんがです。",
            "zh": "总觉得，不可思议得\n不得了哦。",
            "narrator_zh": "雅"
        },
        {
            "location": "409/TALK",
            "narrator": "真幌",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "真幌"
        },
        {
            "location": "410/TALK",
            "narrator": "真幌",
            "text": "驚いたな。",
            "zh": "真吃惊啊。",
            "narrator_zh": "真幌"
        },
        {
            "location": "411/TALK",
            "narrator": "真幌",
            "text": "みやびは、そういった\n感情が薄いとばかり\n思っていたのだが――",
            "zh": "我本来一直觉得，\n雅对这种感情\n很淡薄——",
            "narrator_zh": "真幌"
        },
        {
            "location": "412/TALK",
            "narrator": "真幌",
            "text": "どうやら、私に\n見えていなかった\nだけのようだ。",
            "zh": "看来只是\n我没看到\n而已。",
            "narrator_zh": "真幌"
        },
        {
            "location": "414/TALK",
            "narrator": "みやび",
            "text": "うちも、今の今まで\n気付きませんでしたし。",
            "zh": "我也是刚才\n才注意到呢。",
            "narrator_zh": "雅"
        },
        {
            "location": "415/SEL",
            "narrator": "",
            "text": "東京に帰りたくない？",
            "zh": "不想回东京吗？",
            "narrator_zh": ""
        },
        {
            "location": "416/SEL",
            "narrator": "",
            "text": "家族とも話そうよ",
            "zh": "也跟家人聊聊吧",
            "narrator_zh": ""
        },
        {
            "location": "418/TALK",
            "narrator": "みやび",
            "text": "…これが普通ながです？",
            "zh": "……这样很正常吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "419/TALK",
            "narrator": "真幌",
            "text": "私に聞かれてもな。\n生まれも育ちも、\n今も東京だし…。",
            "zh": "这问我可没用。\n我生在东京长在东京，\n现在也在东京……",
            "narrator_zh": "真幌"
        },
        {
            "location": "420/TALK",
            "narrator": "真幌",
            "text": "だが、別におかしなこと\nではないと思うぞ。",
            "zh": "但我并不觉得\n这有什么奇怪的。",
            "narrator_zh": "真幌"
        },
        {
            "location": "422/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "427/TALK",
            "narrator": "みやび",
            "text": "…らしくないことを\n言うてますね。\n忘れてください。",
            "zh": "……我说了不像\n自己的话呢。\n请忘掉吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "428/TALK",
            "narrator": "真幌",
            "text": "それは無理だが、\n心の奥にしまっておくと\nしよう。",
            "zh": "那可办不到，\n就把它收进\n心底深处吧。",
            "narrator_zh": "真幌"
        },
        {
            "location": "430/TALK",
            "narrator": "真幌",
            "text": "…邪魔したら悪いのでな、\n私は退散するぞ。",
            "zh": "……再待下去碍事，\n我就先撤了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "434/TALK",
            "narrator": "みやび",
            "text": "さてと、うちもそろそろ\n部屋に…。",
            "zh": "那么，我也差不多\n该回房间了……",
            "narrator_zh": "雅"
        },
        {
            "location": "435/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "436/TALK",
            "narrator": "みやび",
            "text": "もうちっくと、\nのんびりするか…。",
            "zh": "再多待一会儿，\n悠闲一下吧……",
            "narrator_zh": "雅"
        },
        {
            "location": "438/ACT",
            "narrator": "",
            "text": "東京に帰りたくない？",
            "zh": "不想回东京吗？",
            "narrator_zh": ""
        },
        {
            "location": "458/TALK",
            "narrator": "みやび",
            "text": "帰りたくないか、と聞かれれば",
            "zh": "要问是不是不想回去",
            "narrator_zh": "雅"
        },
        {
            "location": "459/TALK",
            "narrator": "みやび",
            "text": "そうやね…帰りたくないかもしれん",
            "zh": "是啊……可能真不想回去咯",
            "narrator_zh": "雅"
        },
        {
            "location": "471/TALK",
            "narrator": "みやび",
            "text": "…しばらく、\n東京に帰りたくないです。",
            "zh": "……暂时，\n不想回东京。",
            "narrator_zh": "雅"
        },
        {
            "location": "473/TALK",
            "narrator": "真幌",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "真幌"
        },
        {
            "location": "474/TALK",
            "narrator": "真幌",
            "text": "実家のＰＣを弄れる\nからか？",
            "zh": "是因为能玩\n老家的电脑吗？",
            "narrator_zh": "真幌"
        },
        {
            "location": "476/TALK",
            "narrator": "みやび",
            "text": "…バレましたか。",
            "zh": "……被看穿了吗。",
            "narrator_zh": "雅"
        },
        {
            "location": "478/TALK",
            "narrator": "みやび",
            "text": "この流れやったら、\nホームシックにでも\nなったのか――",
            "zh": "照这个走向，\n我还以为你是担心我\n得了思乡病——",
            "narrator_zh": "雅"
        },
        {
            "location": "479/TALK",
            "narrator": "みやび",
            "text": "って、心配してくれる\n思うたんですけんど。",
            "zh": "——本来还以为\n你是来关心我的呢。",
            "narrator_zh": "雅"
        },
        {
            "location": "480/TALK",
            "narrator": "真幌",
            "text": "意外な一面が見れた\nことは認めるが――",
            "zh": "能看到你意外的一面，\n这点我承认——",
            "narrator_zh": "真幌"
        },
        {
            "location": "481/TALK",
            "narrator": "真幌",
            "text": "実家の空気恋しさだけで、\nそんなことを言うような\nタマじゃないだろ。",
            "zh": "但你不是那种光凭\n想念老家空气\n就说这种话的人吧。",
            "narrator_zh": "真幌"
        },
        {
            "location": "484/TALK",
            "narrator": "みやび",
            "text": "流石ですね、まほさん。\n降参します。",
            "zh": "不愧是你啊，真幌。\n我认输了。",
            "narrator_zh": "雅"
        },
        {
            "location": "486/TALK",
            "narrator": "真幌",
            "text": "ふっ…とはいえ、\nもうしばらくは\nこっちにいることになる。",
            "zh": "哼……不过话说回来，\n接下来还得\n在这里待上一阵。",
            "narrator_zh": "真幌"
        },
        {
            "location": "487/TALK",
            "narrator": "真幌",
            "text": "その気持ちが少しでも\nあるなら、親孝行の\n一つでもしておけ。",
            "zh": "既然多少有那份心，\n就做上一件\n孝顺父母的事吧。",
            "narrator_zh": "真幌"
        },
        {
            "location": "489/TALK",
            "narrator": "真幌",
            "text": "おまえの帰る家を、\n護ってくれている\n人達なのだからな。",
            "zh": "守护着你回去的\n那个家的，可是\n那些人啊。",
            "narrator_zh": "真幌"
        },
        {
            "location": "493/TALK",
            "narrator": "みやび",
            "text": "…面倒やなぁ。",
            "zh": "……好麻烦啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "494/TALK",
            "narrator": "みやび",
            "text": "…けんど、うちの帰る\n場所、護ってくれてる\n人達…か…。",
            "zh": "……但是，守护着\n我回去的\n那些人……吗……",
            "narrator_zh": "雅"
        },
        {
            "location": "495/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "498/TALK",
            "narrator": "みやび",
            "text": "夕飯作る手伝いくらい、\nしてもえいか…。",
            "zh": "帮忙做做晚饭\n什么的，也算好吧……",
            "narrator_zh": "雅"
        },
        {
            "location": "499/ACT",
            "narrator": "",
            "text": "家族とも話そうよ",
            "zh": "也跟家人聊聊吧",
            "narrator_zh": ""
        },
        {
            "location": "521/TALK",
            "narrator": "みやび",
            "text": "そういえば、帰ってきてからまともに話しとらんかったな",
            "zh": "说起来，回来之后还没跟他们正经说过话咧",
            "narrator_zh": "雅"
        },
        {
            "location": "532/TALK",
            "narrator": "みやび",
            "text": "…いや、話も何も、\n特に話すようなこと\nないんやが――",
            "zh": "……不，也说不上话，\n本来就没有什么\n特别要说的——",
            "narrator_zh": "雅"
        },
        {
            "location": "533/TALK",
            "narrator": "みやび",
            "text": "向こうからも、\n特に聞いてもこないし。",
            "zh": "那边也没有\n特意来问什么。",
            "narrator_zh": "雅"
        },
        {
            "location": "534/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "535/TALK",
            "narrator": "みやび",
            "text": "すみません、まほさん。\nうち、ちっくと親のとこ\n行ってきます。",
            "zh": "不好意思，真幌。\n我去一下父母\n那边。",
            "narrator_zh": "雅"
        },
        {
            "location": "537/TALK",
            "narrator": "真幌",
            "text": "ん？",
            "zh": "嗯？",
            "narrator_zh": "真幌"
        },
        {
            "location": "539/TALK",
            "narrator": "みやび",
            "text": "そろそろ夕飯の支度を\n始める頃やき、手伝い\nですよ。",
            "zh": "差不多到开始\n准备晚饭的点了啵，\n我去帮忙。",
            "narrator_zh": "雅"
        },
        {
            "location": "540/TALK",
            "narrator": "真幌",
            "text": "ん、わかった…。",
            "zh": "嗯，知道了……",
            "narrator_zh": "真幌"
        },
        {
            "location": "542/TALK",
            "narrator": "みやび",
            "text": "じゃあ…。",
            "zh": "那就……",
            "narrator_zh": "雅"
        },
        {
            "location": "543/TALK",
            "narrator": "真幌",
            "text": "みやび、親と会話できる\n機会は、大切にしろよ。",
            "zh": "雅，能和父母说话的\n机会，要珍惜。",
            "narrator_zh": "真幌"
        },
        {
            "location": "546/TALK",
            "narrator": "みやび",
            "text": "…努力します。",
            "zh": "……我会努力。",
            "narrator_zh": "雅"
        },
        {
            "location": "548/TALK",
            "narrator": "みやび",
            "text": "…まあ、顔合わせれば\n話題くらい見つかるか。",
            "zh": "……嘛，见了面总能\n找到点话题吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "375/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>8月25日　 6:12 PM</color>\n合宿中、みやびの実家、縁側でのこと",
            "zh": "<color=green>8月25日　 6:12 PM</color>\n合宿期间，雅的老家，发生在檐廊上的事",
            "narrator_zh": "Dialog_EventData"
        },
        {
            "location": "559/DIALOG",
            "narrator": "Dialog_GEThimegoto_ch04",
            "text": "【一家らんらん】",
            "zh": "【一家和乐】",
            "narrator_zh": "Dialog_GEThimegoto_ch04"
        }
    ]
}
