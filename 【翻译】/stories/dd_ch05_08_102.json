{
    "dir": "chap08/daydra/dd_ch05_08_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "8505",
        "cid": "kagura",
        "title": "005 メインストーリー",
        "sub_title": "一触即発＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "一触即发＜后篇＞"
    },
    "entry": [
        {
            "location": "1327/TALK",
            "narrator": "神楽",
            "text": "…いけない。\nちょっと熱く\nなりすぎたかも。",
            "zh": "……不行。\n好像有点\n太激动了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1329/TALK",
            "narrator": "神楽",
            "text": "気持ちを\n落ち着けないと…。",
            "zh": "得把心情\n冷静下来……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1330/TALK",
            "narrator": "神楽",
            "text": "ふぅ…。",
            "zh": "呼……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1342/TALK",
            "narrator": "神楽",
            "text": "$handle$さん",
            "zh": "$handle$",
            "narrator_zh": "神乐"
        },
        {
            "location": "1343/TALK",
            "narrator": "神楽",
            "text": "今って大丈夫ですか？",
            "zh": "现在方便吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1345/SEL",
            "narrator": "",
            "text": "もちろんいいよ",
            "zh": "当然可以",
            "narrator_zh": ""
        },
        {
            "location": "1346/SEL",
            "narrator": "",
            "text": "音羽との話は終わったの？",
            "zh": "和音羽的话说完了吗？",
            "narrator_zh": ""
        },
        {
            "location": "1347/ACT",
            "narrator": "",
            "text": "もちろんいいよ",
            "zh": "当然可以",
            "narrator_zh": ""
        },
        {
            "location": "1348/TALK",
            "narrator": "神楽",
            "text": "ありがとうございます",
            "zh": "谢谢",
            "narrator_zh": "神乐"
        },
        {
            "location": "1349/ACT",
            "narrator": "",
            "text": "音羽との話は終わったの？",
            "zh": "和音羽的话说完了吗？",
            "narrator_zh": ""
        },
        {
            "location": "1350/TALK",
            "narrator": "神楽",
            "text": "伝えたいことは一通り話したので",
            "zh": "想说的大体都说了",
            "narrator_zh": "神乐"
        },
        {
            "location": "1352/TALK",
            "narrator": "神楽",
            "text": "ちょっと冷静さを欠いていたようなので",
            "zh": "好像有点不够冷静",
            "narrator_zh": "神乐"
        },
        {
            "location": "1354/TALK",
            "narrator": "神楽",
            "text": "落ち着くためにお話ししたくて",
            "zh": "想说说话让自己冷静下来",
            "narrator_zh": "神乐"
        },
        {
            "location": "1356/SEL",
            "narrator": "",
            "text": "冷静さを欠く気持ちはわかる",
            "zh": "不够冷静的心情我懂",
            "narrator_zh": ""
        },
        {
            "location": "1357/SEL",
            "narrator": "",
            "text": "今は平気なの？",
            "zh": "现在没事了吗？",
            "narrator_zh": ""
        },
        {
            "location": "1358/ACT",
            "narrator": "",
            "text": "冷静さを欠く気持ちはわかる",
            "zh": "不够冷静的心情我懂",
            "narrator_zh": ""
        },
        {
            "location": "1359/TALK",
            "narrator": "神楽",
            "text": "そう言ってもらえると少し気持ちがラクになります",
            "zh": "你这么说，心情会轻松一点",
            "narrator_zh": "神乐"
        },
        {
            "location": "1360/TALK",
            "narrator": "神楽",
            "text": "でもいけないことですよ",
            "zh": "可是这样不行哦",
            "narrator_zh": "神乐"
        },
        {
            "location": "1361/TALK",
            "narrator": "神楽",
            "text": "それが原因で任務失敗なんてことになったら",
            "zh": "要是因为这个任务失败了",
            "narrator_zh": "神乐"
        },
        {
            "location": "1362/TALK",
            "narrator": "神楽",
            "text": "意味がなくなっちゃいますし",
            "zh": "就没有意义了",
            "narrator_zh": "神乐"
        },
        {
            "location": "1363/ACT",
            "narrator": "",
            "text": "今は平気なの？",
            "zh": "现在没事了吗？",
            "narrator_zh": ""
        },
        {
            "location": "1364/TALK",
            "narrator": "神楽",
            "text": "とりあえずは",
            "zh": "眼下还好",
            "narrator_zh": "神乐"
        },
        {
            "location": "1365/TALK",
            "narrator": "神楽",
            "text": "スッキリとまではいきませんけど",
            "zh": "还谈不上痛快",
            "narrator_zh": "神乐"
        },
        {
            "location": "1367/TALK",
            "narrator": "神楽",
            "text": "任務に就く前から色々と準備はしていたけど",
            "zh": "就任任务之前做了各种准备",
            "narrator_zh": "神乐"
        },
        {
            "location": "1368/TALK",
            "narrator": "神楽",
            "text": "いざとなるとダメなもんですね",
            "zh": "事到临头还是不行呢",
            "narrator_zh": "神乐"
        },
        {
            "location": "1369/TALK",
            "narrator": "神楽",
            "text": "もっと",
            "zh": "还得",
            "narrator_zh": "神乐"
        },
        {
            "location": "1370/TALK",
            "narrator": "神楽",
            "text": "心を強く持たないと",
            "zh": "把心握得更紧",
            "narrator_zh": "神乐"
        },
        {
            "location": "1372/SEL",
            "narrator": "",
            "text": "無理はしないでね",
            "zh": "别太勉强哦",
            "narrator_zh": ""
        },
        {
            "location": "1373/SEL",
            "narrator": "",
            "text": "辛くなったら手伝うからね",
            "zh": "难受的话我会帮忙的",
            "narrator_zh": ""
        },
        {
            "location": "1374/ACT",
            "narrator": "",
            "text": "無理はしないでね",
            "zh": "别太勉强哦",
            "narrator_zh": ""
        },
        {
            "location": "1375/TALK",
            "narrator": "神楽",
            "text": "しないですめばいいんですけど",
            "zh": "能不勉强就好了",
            "narrator_zh": "神乐"
        },
        {
            "location": "1377/TALK",
            "narrator": "神楽",
            "text": "どうなるかわかりませんね",
            "zh": "还不知道会怎样呢",
            "narrator_zh": "神乐"
        },
        {
            "location": "1388/TALK",
            "narrator": "神楽",
            "text": "…無理するな、か。",
            "zh": "……别勉强，吗。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1389/TALK",
            "narrator": "神楽",
            "text": "本当、甘い人…。",
            "zh": "真是，心软的人……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1390/ACT",
            "narrator": "",
            "text": "辛くなったら手伝うからね",
            "zh": "难受的话我会帮忙的",
            "narrator_zh": ""
        },
        {
            "location": "1391/TALK",
            "narrator": "神楽",
            "text": "じゃあまた今日みたいなときには",
            "zh": "那以后再有今天这样的时候",
            "narrator_zh": "神乐"
        },
        {
            "location": "1392/TALK",
            "narrator": "神楽",
            "text": "お話相手になってくださいね",
            "zh": "请再当我的说话对象哦",
            "narrator_zh": "神乐"
        },
        {
            "location": "1403/TALK",
            "narrator": "神楽",
            "text": "…$handle$さん、か。",
            "zh": "……$handle$，吗。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1404/TALK",
            "narrator": "神楽",
            "text": "私の目的を知っていても\n優しくしてくれるし…。",
            "zh": "明明知道我的目的\n还是对我很温柔……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1405/TALK",
            "narrator": "神楽",
            "text": "味方、と思って\nいいのかな…？",
            "zh": "可以当成\n自己人吗……？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1411/TALK",
            "narrator": "神楽",
            "text": "…あっ。",
            "zh": "……啊。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1417/TALK",
            "narrator": "神楽",
            "text": "…はい、卯月です。",
            "zh": "……是，我是卯月。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1419/TALK",
            "narrator": "千羽鶴",
            "text": "こんばんは。\n初めての出撃、\nお疲れ様。",
            "zh": "晚上好。\n第一次出击，\n辛苦了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1420/TALK",
            "narrator": "神楽",
            "text": "…どうも。",
            "zh": "……你好。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1421/TALK",
            "narrator": "千羽鶴",
            "text": "逢瀬つばめとの\n接触についての\n報告を聞きたい。",
            "zh": "关于和逢濑燕\n接触的情况，\n我想听报告。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1422/TALK",
            "narrator": "神楽",
            "text": "はい。フェノメノン内部で\nファーストコンタクトに\n成功し…。",
            "zh": "是。在PhenoMENON内部\n初次接触\n成功了……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1423/TALK",
            "narrator": "神楽",
            "text": "彼女のピンチを救った\nことで、自然と近づく\nことができました。",
            "zh": "救了她的危机，\n自然而然地\n靠近了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1424/TALK",
            "narrator": "神楽",
            "text": "その後の様子から見て、\n上手く友好な関係を\n作っていけそうです。",
            "zh": "从那之后的样子来看，\n友好的关系\n好像能建立起来。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1425/TALK",
            "narrator": "千羽鶴",
            "text": "なるほど。\nフェノメノン収束後にも、\nなにかあった？",
            "zh": "原来如此。\nPhenoMENON收敛之后，\n还有什么事吗？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1426/TALK",
            "narrator": "神楽",
            "text": "はい、新人同士なので\n今日はほとんどの時間を\n一緒に過ごし…。",
            "zh": "是的，因为都是新人\n今天大部分时间\n都在一起……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1427/TALK",
            "narrator": "神楽",
            "text": "さっきまで、劇場隣の\nテルマエに\n行っていました。",
            "zh": "直到刚才，还去了\n剧场旁边的\n浴场。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1428/TALK",
            "narrator": "千羽鶴",
            "text": "…驚いた。\n初日でそこまでの\n接近に成功するなんて。",
            "zh": "……真让人吃惊。\n第一天就能\n接近到这个地步。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1429/TALK",
            "narrator": "神楽",
            "text": "ですが――",
            "zh": "可是——",
            "narrator_zh": "神乐"
        },
        {
            "location": "1430/TALK",
            "narrator": "神楽",
            "text": "一点だけ、わからない\nことがあるんです。",
            "zh": "只有一点，\n有不明白的事。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1431/TALK",
            "narrator": "神楽",
            "text": "逢瀬つばめは、\n私が思っていたのとは、\n全くの別人でした。",
            "zh": "逢濑燕，\n和我以为的，\n完全是另一个人。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1432/TALK",
            "narrator": "千羽鶴",
            "text": "と、いうと？",
            "zh": "你是说？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1433/TALK",
            "narrator": "神楽",
            "text": "ドームでの記憶がない。\n本人はそう言って\nいました。",
            "zh": "没有穹顶的记忆。\n本人是\n这么说的。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1434/TALK",
            "narrator": "神楽",
            "text": "見たところ演技には\n思えませんでしたし、\nそうなると――",
            "zh": "看上去不像是\n在演戏，\n那样的话——",
            "narrator_zh": "神乐"
        },
        {
            "location": "1435/TALK",
            "narrator": "千羽鶴",
            "text": "余計なことは\n考えなくていい。",
            "zh": "多余的事\n不用去想。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1436/TALK",
            "narrator": "千羽鶴",
            "text": "あなたが今日会ったのは、\n間違いなく\n逢瀬つばめ本人。",
            "zh": "你今天见到的，\n毫无疑问\n是逢濑燕本人。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1437/TALK",
            "narrator": "千羽鶴",
            "text": "記憶もなにも関係ない。\nあなたは自分の任務に\n集中すればいいだけ。",
            "zh": "记忆什么的都没关系。\n你只要专心\n自己的任务就行。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1438/TALK",
            "narrator": "神楽",
            "text": "…わかりました。",
            "zh": "……我知道了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1439/TALK",
            "narrator": "千羽鶴",
            "text": "健闘を祈る。\n引き続き頑張って。",
            "zh": "祝你奋战。\n继续加油。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1445/TALK",
            "narrator": "神楽",
            "text": "…頑張れ、か。\nこっちの気も知らないで、\n簡単に…。",
            "zh": "……加油，吗。\n也不知道我这边的心情，\n说得真轻松……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1446/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1454/TALK",
            "narrator": "透明神楽",
            "text": "…でも、やらないと。",
            "zh": "……可是，不做不行。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "1455/TALK",
            "narrator": "透明神楽",
            "text": "そのために、\n私はここまで\n来たんだから…。",
            "zh": "为此，\n我才走到了\n这里……。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "1456/TALK",
            "narrator": "透明神楽",
            "text": "音羽…私、頑張るからね。",
            "zh": "音羽……我会加油的。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "1465/DIALOG",
            "narrator": "Dialog_chapter_ch05",
            "text": "【06 史上最愛の作戦】",
            "zh": "【06 史上最爱的作战】",
            "narrator_zh": "Dialog_chapter_ch05"
        },
        {
            "location": "1477/DIALOG",
            "narrator": "Dialog_chapter_ch05",
            "text": "【06 史上最愛の作戦】",
            "zh": "【06 史上最爱的作战】",
            "narrator_zh": "Dialog_chapter_ch05"
        }
    ]
}
