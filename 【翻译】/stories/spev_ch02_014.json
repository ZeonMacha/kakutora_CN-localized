        {
            "location": "152/TALK",
            "narrator": "透明アーヤ",
            "text": "ヒストンシャペロン、\n私にも注いで。",
            "zh": "组蛋白伴侣，\n也给我倒一点。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "153/TALK",
            "narrator": "シャペロン",
            "text": "あ、すみません。\n私ばかり…どうぞ。",
            "zh": "啊，不好意思。\n光顾着我自己了……请。",
            "narrator_zh": "沙佩隆"
        },
        {
            "location": "154/TALK",
            "narrator": "透明アーヤ",
            "text": "ありがとう。\nんっ…。",
            "zh": "谢谢。\n嗯……",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "155/TALK",
            "narrator": "シャペロン",
            "text": "…意外でした。\nアーヤも、\nお酒を飲むんですね。",
            "zh": "……有点意外。\n绫水也\n会喝酒啊。",
            "narrator_zh": "沙佩隆"
        },
        {
            "location": "158/TALK",
            "narrator": "透明アーヤ",
            "text": "そりゃそうよ。\n大学生ではあるけど、\n成人してるし。",
            "zh": "那当然。\n虽然是大学生，\n但已经成年了。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "159/TALK",
            "narrator": "透明アーヤ",
            "text": "友達や館長と食事に\n行ったりすると、\n毎回飲むのよ？",
            "zh": "和朋友、还有馆长\n去吃饭的时候，\n每次都会喝？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "160/TALK",
            "narrator": "シャペロン",
            "text": "そうでしたか…。",
            "zh": "是这样啊……",
            "narrator_zh": "沙佩隆"
        },
        {
            "location": "161/TALK",
            "narrator": "透明アーヤ",
            "text": "ま、館長みたいに\n酔っ払うほど飲みは\nしないけど…。",
            "zh": "不过，我不会\n喝到像馆长那样\n醉……",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "162/TALK",
            "narrator": "シャペロン",
            "text": "…アーヤ、早速グラスが\n空いたようですね。\nおかわりをどうぞ。",
            "zh": "……绫水，酒杯\n好像已经空了。\n再来一杯。",
            "narrator_zh": "沙佩隆"
        },
        {
            "location": "163/TALK",
            "narrator": "透明アーヤ",
            "text": "ふふっ、まさか私を\n酔わせるつもりじゃ\nないでしょうね？",
            "zh": "呵呵，该不会\n是想把我\n灌醉吧？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "164/TALK",
            "narrator": "シャペロン",
            "text": "いえ…ただ、私はまだ\nアーヤの知らないところが\n色々あるようなので…。",
            "zh": "不……只是，我还有\n很多不了解绫水的地方，\n所以……",
            "narrator_zh": "沙佩隆"
        },
        {
            "location": "165/TALK",
            "narrator": "シャペロン",
            "text": "お酒を酌み交わしながら、\nじっくりと話をするのも\n楽しいかと思ったんです。",
            "zh": "一边对饮，\n一边慢慢聊，\n我觉得也会很开心。",
            "narrator_zh": "沙佩隆"
        },
        {
            "location": "166/TALK",
            "narrator": "透明アーヤ",
            "text": "そういえば、\n今までそういう機会って\nなかったわね。",
            "zh": "说起来，\n到现在都没有\n这样的机会。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "169/TALK",
            "narrator": "透明アーヤ",
            "text": "…うん、いいかも。\n今日はじっくりと、\n話し合いましょ。",
            "zh": "……嗯，也许不错。\n今天就慢慢地\n聊聊吧。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "170/TALK",
            "narrator": "シャペロン",
            "text": "…ありがとうございます。",
            "zh": "……谢谢。",
            "narrator_zh": "沙佩隆"
        },
        {
            "location": "171/TALK",
            "narrator": "シャペロン",
            "text": "では、前からずっと\n聞きたかったのですが、\nアーヤは――",
            "zh": "那么，有件事我一直\n想问，\n绫水你——",
            "narrator_zh": "沙佩隆"
        }
    ]
}
