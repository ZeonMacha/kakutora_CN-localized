    "entry": [
        {
            "location": "31/TALK",
            "narrator": "シャペロン",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "沙佩隆"
        },
        {
            "location": "32/TALK",
            "narrator": "透明アーヤ",
            "text": "ほ、ほら、ヒストン\nシャペロン。\nグラスが空いてるわ。",
            "zh": "来、来，\n组蛋白伴侣。\n酒杯空了。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "34/TALK",
            "narrator": "透明アーヤ",
            "text": "沢山あるんだから、\nどんどん飲んでね。",
            "zh": "还有很多，\n尽管喝。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "35/TALK",
            "narrator": "シャペロン",
            "text": "ええ、ありがとう\nございます。",
            "zh": "嗯，\n谢谢。",
            "narrator_zh": "沙佩隆"
        },
        {
            "location": "36/TALK",
            "narrator": "透明アーヤ",
            "text": "…せっかくのクリスマス\nなんだから、楽しまないと\n勿体ないわよ？",
            "zh": "……难得的圣诞节，\n不好好享受的话\n太可惜了吧？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "37/TALK",
            "narrator": "シャペロン",
            "text": "アーヤは楽しんでますか？",
            "zh": "绫水玩得开心吗？",
            "narrator_zh": "沙佩隆"
        },
        {
            "location": "38/TALK",
            "narrator": "透明アーヤ",
            "text": "ええ…ヒストン\nシャペロンも\n着てくれたしね。",
            "zh": "是啊……\n组蛋白伴侣也\n穿上了。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "39/TALK",
            "narrator": "シャペロン",
            "text": "それでしたら、私も\n参加した甲斐があったと\nいうものですね。",
            "zh": "那样的话，我也\n没有白参加\n这一趟。",
            "narrator_zh": "沙佩隆"
        },
        {
            "location": "41/TALK",
            "narrator": "透明アーヤ",
            "text": "…あ、あなたももっと\n楽しまないとダメよ？",
            "zh": "……啊，你也得\n更尽情地享受才行吧？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "42/TALK",
            "narrator": "透明アーヤ",
            "text": "せっかくのクリスマス\nパーティーなんだから…。",
            "zh": "难得的圣诞\n派对……",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "43/TALK",
            "narrator": "透明アーヤ",
            "text": "おもいっきり\n楽しまなきゃ損よ。",
            "zh": "不玩个痛快\n就亏了。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "44/TALK",
            "narrator": "シャペロン",
            "text": "大丈夫ですよ。\nこれでも、ちゃんと\n楽しんでますから。",
            "zh": "没关系。\n我这样，也好好\n享受着呢。",
            "narrator_zh": "沙佩隆"
        },
        {
            "location": "45/TALK",
            "narrator": "透明アーヤ",
            "text": "そ、そう…。",
            "zh": "是、是吗……",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "46/TALK",
            "narrator": "シャペロン",
            "text": "ええ、そうですよ。",
            "zh": "嗯，是的。",
            "narrator_zh": "沙佩隆"
        },
        {
            "location": "47/TALK",
            "narrator": "透明アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "49/TALK",
            "narrator": "アーヤ",
