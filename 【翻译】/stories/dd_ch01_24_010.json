{
    "dir": "chap24/daydra/dd_ch01_24_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "24152",
        "cid": "tsubame",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "心を許せる親友",
        "title_zh": "Extra002 额外剧情",
        "sub_title_zh": "能交心的挚友"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "心を許せる親友",
            "zh": "能交心的挚友",
            "narrator_zh": ""
        },
        {
            "location": "26/TALK",
            "narrator": "つばめ",
            "text": "…そっか。\n二人とも、ガブちゃんから\n話は聞いてるんだ？",
            "zh": "……这样啊。\n你们两个，都从加布那里\n听说了吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "28/TALK",
            "narrator": "雛",
            "text": "うん…神楽ちゃんが、\nつばめちゃん達のことを\n裏切った、って…。",
            "zh": "嗯……神乐，\n背叛了燕你们，\n之类的……。",
            "narrator_zh": "雏"
        },
        {
            "location": "29/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "30/TALK",
            "narrator": "雛",
            "text": "つばめちゃん…大丈夫？",
            "zh": "燕……没事吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "32/TALK",
            "narrator": "つばめ",
            "text": "う、うん…。\nわたしは平気だよ。",
            "zh": "嗯、嗯……。\n我没事的呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "34/TALK",
            "narrator": "繭",
            "text": "うそ。",
            "zh": "骗人。",
            "narrator_zh": "茧"
        },
        {
            "location": "35/TALK",
            "narrator": "繭",
            "text": "仲間が裏切られて、\n平気なわけがない。",
            "zh": "同伴被背叛了，\n不可能没事。",
            "narrator_zh": "茧"
        },
        {
            "location": "37/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "39/TALK",
            "narrator": "雛",
            "text": "言いたいこととか、\n話したいことがあったら、\n何でも聞くよ。",
            "zh": "有想说的，\n有想聊的，\n我都听。",
            "narrator_zh": "雏"
        },
        {
            "location": "40/TALK",
            "narrator": "雛",
            "text": "それくらいしか、\nあたし達にはできない\nから…。",
            "zh": "我们也只能\n做到这个地步\n了……。",
            "narrator_zh": "雏"
        },
        {
            "location": "41/TALK",
            "narrator": "繭",
            "text": "…強制はしないから。\n言いたくないなら\n言わないでいい。",
            "zh": "……不强迫你。\n不想说的话\n不说也行。",
            "narrator_zh": "茧"
        },
        {
            "location": "42/TALK",
            "narrator": "繭",
            "text": "でも、言えば少しはラクに\nなるかもしれないわ。",
            "zh": "不过，说出来也许\n会轻松一点。",
            "narrator_zh": "茧"
        },
        {
            "location": "45/TALK",
            "narrator": "つばめ",
            "text": "…ありがと。\nひなこちゃん、まゆちん。",
            "zh": "……谢谢。\n小雏，小茧。",
            "narrator_zh": "燕"
        },
        {
            "location": "47/TALK",
            "narrator": "つばめ",
            "text": "でも…本当に平気なの。",
            "zh": "可是……我真的没事呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "48/TALK",
            "narrator": "つばめ",
            "text": "本当は、落ち込んでないと\n変だと思うけど…。",
            "zh": "按理说，要是不消沉\n才奇怪……。",
            "narrator_zh": "燕"
        },
        {
            "location": "49/TALK",
            "narrator": "つばめ",
            "text": "何か、平気なの。\nだから心配しないで。",
            "zh": "不知怎么的，我没事。\n所以别担心呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "50/TALK",
            "narrator": "雛",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雏"
        },
        {
            "location": "51/TALK",
            "narrator": "繭",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "茧"
        },
        {
            "location": "52/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "53/SEL",
            "narrator": "",
            "text": "二人とも気まずそう",
            "zh": "两个人看起来都很尴尬",
            "narrator_zh": ""
        },
        {
            "location": "54/ACT",
            "narrator": "",
            "text": "二人とも気まずそう",
            "zh": "两个人看起来都很尴尬",
            "narrator_zh": ""
        },
        {
            "location": "72/TALK",
            "narrator": "つばめ",
            "text": "そぅかも(´・ω・｀)",
            "zh": "也许是这样呀(´・ω・｀)",
            "narrator_zh": "燕"
        },
        {
            "location": "73/TALK",
            "narrator": "つばめ",
            "text": "やっぱり",
            "zh": "果然",
            "narrator_zh": "燕"
        },
        {
            "location": "75/TALK",
            "narrator": "つばめ",
            "text": "わたしのせぃだよね(´つω・｀)ｼｭﾝ",
            "zh": "是我的错呀(´つω・｀)蔫",
            "narrator_zh": "燕"
        },
        {
            "location": "76/TALK",
            "narrator": "つばめ",
            "text": "どぅしたらぃぃのかな？(o´Д`)=з",
            "zh": "该怎么办呀？(o´Д`)=з",
            "narrator_zh": "燕"
        },
        {
            "location": "78/SEL",
            "narrator": "",
            "text": "二人には甘えていいんだよ",
            "zh": "可以对她们撒娇的呀",
            "narrator_zh": ""
        },
        {
            "location": "79/SEL",
            "narrator": "",
            "text": "どこか遊びに行こう",
            "zh": "找个地方去玩吧",
            "narrator_zh": ""
        },
        {
            "location": "80/ACT",
            "narrator": "",
            "text": "二人には甘えていいんだよ",
            "zh": "可以对她们撒娇的呀",
            "narrator_zh": ""
        },
        {
            "location": "84/TALK",
            "narrator": "つばめ",
            "text": "でも",
            "zh": "可是",
            "narrator_zh": "燕"
        },
        {
            "location": "85/TALK",
            "narrator": "つばめ",
            "text": "わたしのもんだぃだし(･Д･｀)",
            "zh": "这是我的问题呀(･Д･｀)",
            "narrator_zh": "燕"
        },
        {
            "location": "86/TALK",
            "narrator": "つばめ",
            "text": "二人に",
            "zh": "给她们两个",
            "narrator_zh": "燕"
        },
        {
            "location": "87/TALK",
            "narrator": "つばめ",
            "text": "迷惑かけられなぃよ・゜・(ノД`)・゜・",
            "zh": "不能添麻烦呀・゜・(ノД`)・゜・",
            "narrator_zh": "燕"
        },
        {
            "location": "89/SEL",
            "narrator": "",
            "text": "それは迷惑じゃない",
            "zh": "那不算添麻烦",
            "narrator_zh": ""
        },
        {
            "location": "90/ACT",
            "narrator": "",
            "text": "それは迷惑じゃない",
            "zh": "那不算添麻烦",
            "narrator_zh": ""
        },
        {
            "location": "103/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "104/TALK",
            "narrator": "つばめ",
            "text": "いいの、かな？",
            "zh": "可以吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "105/TALK",
            "narrator": "つばめ",
            "text": "本当に…わたし、\nひなこちゃん達に\n甘えちゃって…。",
            "zh": "真的……我，\n对小雏她们\n撒娇了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "107/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "109/ACT",
            "narrator": "",
            "text": "どこか遊びに行こう",
            "zh": "找个地方去玩吧",
            "narrator_zh": ""
        },
        {
            "location": "110/TALK",
            "narrator": "つばめ",
            "text": "そぅだね",
            "zh": "是呀",
            "narrator_zh": "燕"
        },
        {
            "location": "111/TALK",
            "narrator": "つばめ",
            "text": "それがぃぃかも(≧ω≦)",
            "zh": "那样也许比较好(≧ω≦)",
            "narrator_zh": "燕"
        },
        {
            "location": "113/TALK",
            "narrator": "つばめ",
            "text": "その方が",
            "zh": "那样的话",
            "narrator_zh": "燕"
        },
        {
            "location": "114/TALK",
            "narrator": "つばめ",
            "text": "気を使わせなぃですむしヽ(･ω･ )ゝ☆",
            "zh": "也不用让她们顾虑ヽ(･ω･ )ゝ☆",
            "narrator_zh": "燕"
        },
        {
            "location": "126/TALK",
            "narrator": "つばめ",
            "text": "…そうだ！\n二人とも、今日の放課後\n遊びに行かない？",
            "zh": "……对了！\n你们两个，今天放学后\n要不要去玩？",
            "narrator_zh": "燕"
        },
        {
            "location": "129/TALK",
            "narrator": "雛",
            "text": "えっ？",
            "zh": "哎？",
            "narrator_zh": "雏"
        },
        {
            "location": "130/TALK",
            "narrator": "繭",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "茧"
        },
        {
            "location": "131/TALK",
            "narrator": "つばめ",
            "text": "この前始まったばかりの\n映画で見たいのが――",
            "zh": "前阵子刚上映的\n电影，有我想看的——",
            "narrator_zh": "燕"
        },
        {
            "location": "132/TALK",
            "narrator": "雛",
            "text": "行かない。",
            "zh": "不去。",
            "narrator_zh": "雏"
        },
        {
            "location": "133/TALK",
            "narrator": "雛",
            "text": "あたし…今はそういう\n気分じゃないし…。",
            "zh": "我……现在\n没那个心情……。",
            "narrator_zh": "雏"
        },
        {
            "location": "134/TALK",
            "narrator": "繭",
            "text": "同じく。",
            "zh": "一样。",
            "narrator_zh": "茧"
        },
        {
            "location": "135/TALK",
            "narrator": "つばめ",
            "text": "そ、そっか…。",
            "zh": "这、这样啊……。",
            "narrator_zh": "燕"
        },
        {
            "location": "136/TALK",
            "narrator": "つばめ",
            "text": "じゃあ、何か甘い物でも\n食べに行くとかは？",
            "zh": "那，去吃点\n甜的怎么样？",
            "narrator_zh": "燕"
        },
        {
            "location": "137/TALK",
            "narrator": "雛",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雏"
        },
        {
            "location": "138/TALK",
            "narrator": "つばめ",
            "text": "だめ？",
            "zh": "不行吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "139/TALK",
            "narrator": "雛",
            "text": "…別に、映画でも、\nお茶しに行くんでも、\nあたし達は構わないの。",
            "zh": "……倒也不是，电影也好，\n去喝茶也好，\n我们都无所谓。",
            "narrator_zh": "雏"
        },
        {
            "location": "140/TALK",
            "narrator": "雛",
            "text": "けど、それをして\nつばめちゃんは、\n本当に楽しいと思える？",
            "zh": "可是，做了这些，\n燕\n真的会开心吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "141/TALK",
            "narrator": "繭",
            "text": "逢瀬さんが私達を\n楽しませようとしてるのは\nわかってる。",
            "zh": "逢濑想让我们\n开心这件事，\n我知道。",
            "narrator_zh": "茧"
        },
        {
            "location": "142/TALK",
            "narrator": "繭",
            "text": "けど、あなたが楽しいと\n思えないなら、一緒にいる\n私達も楽しめない。",
            "zh": "可是，要是你并不\n觉得开心，在一起的\n我们也开心不了。",
            "narrator_zh": "茧"
        },
        {
            "location": "143/TALK",
            "narrator": "繭",
            "text": "気を使わせないために\n言ってるとしたら、\n完全逆効果だから。",
            "zh": "要是说这话是为了\n不让我们顾虑，\n那完全适得其反。",
            "narrator_zh": "茧"
        },
        {
            "location": "144/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "146/TALK",
            "narrator": "雛",
            "text": "…ちょっと悲しいな。",
            "zh": "……有点难过。",
            "narrator_zh": "雏"
        },
        {
            "location": "147/TALK",
            "narrator": "雛",
            "text": "落ち込んでる友達を\n元気づけたいのに、\n逆に気を使わるんだもん。",
            "zh": "明明想给消沉的朋友\n打气，\n结果反倒被她顾虑。",
            "narrator_zh": "雏"
        },
        {
            "location": "148/TALK",
            "narrator": "雛",
            "text": "なんか…情けないな…。",
            "zh": "总觉得……好窝囊……。",
            "narrator_zh": "雏"
        },
        {
            "location": "150/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "154/TALK",
            "narrator": "つばめ",
            "text": "辛いよ…。",
            "zh": "很难受呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "156/TALK",
            "narrator": "つばめ",
            "text": "わたしも…神楽ちゃんが\nいなくなっちゃって、\nとっても辛い…。",
            "zh": "我也好……神乐\n不在了，\n难受得很……。",
            "narrator_zh": "燕"
        },
        {
            "location": "158/TALK",
            "narrator": "つばめ",
            "text": "だって神楽ちゃんは…、\n神楽ちゃんは、わたしの\n大切なお友達だもん。",
            "zh": "因为神乐……、\n神乐是我\n很重要的朋友呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "160/TALK",
            "narrator": "つばめ",
            "text": "なのに…こんな形で\n離ればなれになっちゃう\nなんて…。",
            "zh": "可是……竟然会\n以这种形式\n分开……。",
            "narrator_zh": "燕"
        },
        {
            "location": "162/TALK",
            "narrator": "雛",
            "text": "つばめちゃん…。",
            "zh": "燕……。",
            "narrator_zh": "雏"
        },
        {
            "location": "163/TALK",
            "narrator": "雛",
            "text": "ありがと…ちゃんと、\n辛いって正直に話して\nくれて。",
            "zh": "谢谢……你肯\n老实说\n自己很难受。",
            "narrator_zh": "雏"
        },
        {
            "location": "164/TALK",
            "narrator": "つばめ",
            "text": "うっ、ううっ…。",
            "zh": "呜、呜呜……。",
            "narrator_zh": "燕"
        },
        {
            "location": "165/TALK",
            "narrator": "雛",
            "text": "ありがと。\nあたし達のために、\n明るく振る舞ってくれて。",
            "zh": "谢谢。\n为了我们，\n还装得那么开朗。",
            "narrator_zh": "雏"
        },
        {
            "location": "166/TALK",
            "narrator": "雛",
            "text": "でもね、いいんだよ？\nあたし達の前では、\n変に気を使わなくて。",
            "zh": "不过呀，没关系的？\n在我们面前，\n不用特意顾虑。",
            "narrator_zh": "雏"
        },
        {
            "location": "167/TALK",
            "narrator": "つばめ",
            "text": "ご、ごめんね…。\nわたし、こんな弱いとこ\n見せたくなくて…。",
            "zh": "对、对不起……。\n这么软弱的样子，\n我不想被看见……。",
            "narrator_zh": "燕"
        },
        {
            "location": "168/TALK",
            "narrator": "雛",
            "text": "弱くなんかないよ。\nつばめちゃんは、\nとっても強い子だよ。",
            "zh": "你才不软弱。\n燕\n是很坚强的孩子呀。",
            "narrator_zh": "雏"
        },
        {
            "location": "169/TALK",
            "narrator": "雛",
            "text": "辛いの我慢して、\nあたし達に気を使って\n明るく振る舞ったし。",
            "zh": "忍着难受，\n顾虑我们，\n还装得开朗。",
            "narrator_zh": "雏"
        },
        {
            "location": "170/TALK",
            "narrator": "繭",
            "text": "…無理してるの\nバレバレだったけど。",
            "zh": "……虽然硬撑\n一眼就看出来了。",
            "narrator_zh": "茧"
        },
        {
            "location": "172/TALK",
            "narrator": "つばめ",
            "text": "えっ…？",
            "zh": "哎……？",
            "narrator_zh": "燕"
        },
        {
            "location": "173/TALK",
            "narrator": "雛",
            "text": "うん、つばめちゃん、\n演技力なさ過ぎだよ。",
            "zh": "嗯，燕，\n演技也太差了。",
            "narrator_zh": "雏"
        },
        {
            "location": "174/TALK",
            "narrator": "雛",
            "text": "頑張ってくれてるのは\nわかったけど、\n見てて辛かったよ…。",
            "zh": "知道你在努力，\n可看着\n也好难受……。",
            "narrator_zh": "雏"
        },
        {
            "location": "175/TALK",
            "narrator": "繭",
            "text": "逆効果。\nただただ痛々し過ぎた。",
            "zh": "适得其反。\n只是看着太惨了。",
            "narrator_zh": "茧"
        },
        {
            "location": "178/TALK",
            "narrator": "つばめ",
            "text": "ご、ごめんなさい…。",
            "zh": "对、对不起……。",
            "narrator_zh": "燕"
        },
        {
            "location": "179/TALK",
            "narrator": "雛",
            "text": "謝ることないって。\nつばめちゃんは\n何も悪くないよー。",
            "zh": "没什么好道歉的。\n燕\n什么错都没有哦。",
            "narrator_zh": "雏"
        },
        {
            "location": "180/TALK",
            "narrator": "雛",
            "text": "それに…、悪いのは\n神楽ちゃんでしょ？",
            "zh": "而且……，错的是\n神乐吧？",
            "narrator_zh": "雏"
        },
        {
            "location": "182/TALK",
            "narrator": "つばめ",
            "text": "え？",
            "zh": "哎？",
            "narrator_zh": "燕"
        },
        {
            "location": "183/TALK",
            "narrator": "雛",
            "text": "ずっと友達のフリして、\nあたし達のことを\n騙してたんだよ？",
            "zh": "一直假装是朋友，\n骗了我们\n呀？",
            "narrator_zh": "雏"
        },
        {
            "location": "184/TALK",
            "narrator": "雛",
            "text": "しかも、つばめちゃんに\n酷いことして…、\n絶対に許せない。",
            "zh": "而且还对燕\n做了那么过分的事……、\n绝对不能原谅。",
            "narrator_zh": "雏"
        },
        {
            "location": "185/TALK",
            "narrator": "繭",
            "text": "…何としてでも、\n卯月神楽には\n代償を支払わせないと。",
            "zh": "……不管怎样，\n都得让卯月神乐\n付出代价。",
            "narrator_zh": "茧"
        },
        {
            "location": "186/TALK",
            "narrator": "つばめ",
            "text": "や、やめて！",
            "zh": "别、别这样！",
            "narrator_zh": "燕"
        },
        {
            "location": "187/TALK",
            "narrator": "つばめ",
            "text": "二人とも、神楽ちゃんを\n悪く言わないであげて！",
            "zh": "你们两个，别说\n神乐的坏话！",
            "narrator_zh": "燕"
        },
        {
            "location": "188/TALK",
            "narrator": "雛",
            "text": "なんで！？\nつばめちゃん達を\n裏切ったんだよ！？",
            "zh": "为什么！？\n她背叛了燕你们\n呀！？",
            "narrator_zh": "雏"
        },
        {
            "location": "189/TALK",
            "narrator": "つばめ",
            "text": "違うよ！　神楽ちゃんは\n誰も裏切ってない。\n誤解だよ！",
            "zh": "不是的呀！　神乐\n谁都没有背叛。\n是误会呀！",
            "narrator_zh": "燕"
        },
        {
            "location": "190/TALK",
            "narrator": "繭",
            "text": "…何でそう言えるの？\n彼女に何をされたか、\n忘れた？",
            "zh": "……你怎么能这么说？\n她对你做了什么，\n忘了？",
            "narrator_zh": "茧"
        },
        {
            "location": "192/TALK",
            "narrator": "つばめ",
            "text": "忘れてない。\nちゃんと覚えてるよ。",
            "zh": "没忘。\n我记得清清楚楚呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "193/TALK",
            "narrator": "つばめ",
            "text": "神楽ちゃんに\n攻撃されたことも――",
            "zh": "被神乐\n攻击的事也——",
            "narrator_zh": "燕"
        },
        {
            "location": "194/TALK",
            "narrator": "つばめ",
            "text": "神楽ちゃんが…、\nずっと何かに苦しんで\nいたことも…。",
            "zh": "还有神乐……、\n一直被什么折磨着\n这件事……。",
            "narrator_zh": "燕"
        },
        {
            "location": "195/TALK",
            "narrator": "つばめ",
            "text": "わたし、全部見てきた。\n神楽ちゃんのこと、\nちゃんと見てきたから。",
            "zh": "我全都看见了。\n神乐的事，\n我一直都看着。",
            "narrator_zh": "燕"
        },
        {
            "location": "196/TALK",
            "narrator": "つばめ",
            "text": "だからわかるの。\n神楽ちゃんは、裏切ったり\nなんかしてない、って。",
            "zh": "所以我明白。\n神乐没有\n背叛什么的。",
            "narrator_zh": "燕"
        },
        {
            "location": "197/TALK",
            "narrator": "雛",
            "text": "でも、実際管理庁の人達と\n行っちゃったんでしょ？",
            "zh": "可是，她实际上跟管理厅的人\n一起走了吧？",
            "narrator_zh": "雏"
        },
        {
            "location": "198/TALK",
            "narrator": "雛",
            "text": "つばめちゃんや、\nみんなにも攻撃したのに？",
            "zh": "还攻击了燕，\n还有大家，对吧？",
            "narrator_zh": "雏"
        },
        {
            "location": "199/TALK",
            "narrator": "つばめ",
            "text": "事情があるんだよ！",
            "zh": "她有苦衷的呀！",
            "narrator_zh": "燕"
        },
        {
            "location": "200/TALK",
            "narrator": "つばめ",
            "text": "きっと、どうしても\nわたし達を裏切らないと\nいけない事情が…。",
            "zh": "一定有，不管怎样\n都必须背叛我们的\n苦衷……。",
            "narrator_zh": "燕"
        },
        {
            "location": "201/TALK",
            "narrator": "雛",
            "text": "いや、事情って…。",
            "zh": "不是，苦衷什么的……。",
            "narrator_zh": "雏"
        },
        {
            "location": "202/TALK",
            "narrator": "つばめ",
            "text": "誰かを人質に取られてる\nとか、何か秘密を握られ\nてるとか…。",
            "zh": "比如有人被抓去当人质，\n或者什么秘密被\n人抓住了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "203/TALK",
            "narrator": "雛",
            "text": "ちょ、何それ！？\nいくらなんでも\nぶっ飛び過ぎだよ！",
            "zh": "等、那是什么！？\n怎么想都\n太离谱了！",
            "narrator_zh": "雏"
        },
        {
            "location": "204/TALK",
            "narrator": "繭",
            "text": "その可能性は皆無に近い。",
            "zh": "那种可能性近乎为零。",
            "narrator_zh": "茧"
        },
        {
            "location": "205/TALK",
            "narrator": "つばめ",
            "text": "けど、\nゼロじゃないでしょ！？",
            "zh": "可是，\n不是零吧！？",
            "narrator_zh": "燕"
        },
        {
            "location": "206/TALK",
            "narrator": "つばめ",
            "text": "なら、わたしは\n神楽ちゃんを信じるよ。",
            "zh": "那就，我\n相信神乐呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "207/TALK",
            "narrator": "つばめ",
            "text": "やりたくないけど、\n仕方ないからやってるん\nだと思う。",
            "zh": "她不想做，\n可没办法才这么做的，\n我是这么想的。",
            "narrator_zh": "燕"
        },
        {
            "location": "208/TALK",
            "narrator": "つばめ",
            "text": "だからあんなに苦しんで、\n自暴自棄になって…。",
            "zh": "所以才那么痛苦，\n自暴自弃……。",
            "narrator_zh": "燕"
        },
        {
            "location": "209/TALK",
            "narrator": "繭",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "茧"
        },
        {
            "location": "211/TALK",
            "narrator": "つばめ",
            "text": "絶対そうだよ…。\n神楽ちゃんは、\n裏切ったりしてないよ…。",
            "zh": "绝对是这样……。\n神乐\n没有背叛呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "212/TALK",
            "narrator": "つばめ",
            "text": "…みんなは、神楽ちゃんを\n裏切り者とか…敵とか、\n酷いこと沢山言ってる。",
            "zh": "……大家把神乐\n说成叛徒啦……敌人啦，\n说了好多过分的话。",
            "narrator_zh": "燕"
        },
        {
            "location": "213/TALK",
            "narrator": "つばめ",
            "text": "けど、お願い。\n二人には、そんな風には\n思ってほしくないの。",
            "zh": "可是，拜托了。\n我不想让你们两个\n也这么想。",
            "narrator_zh": "燕"
        },
        {
            "location": "214/TALK",
            "narrator": "雛",
            "text": "で、でも…。",
            "zh": "可、可是……。",
            "narrator_zh": "雏"
        },
        {
            "location": "216/TALK",
            "narrator": "つばめ",
            "text": "お願い、お願いします。",
            "zh": "拜托了，拜托你们。",
            "narrator_zh": "燕"
        },
        {
            "location": "217/TALK",
            "narrator": "つばめ",
            "text": "わたしのこと、少しでも\n信じてくれてるなら――",
            "zh": "要是你们哪怕一点点\n相信我的话——",
            "narrator_zh": "燕"
        },
        {
            "location": "218/TALK",
            "narrator": "つばめ",
            "text": "神楽ちゃんのことも、\nちょっとでいいから\n信じてあげて！",
            "zh": "神乐的事也，\n哪怕一点点就好，\n请相信她！",
            "narrator_zh": "燕"
        },
        {
            "location": "220/TALK",
            "narrator": "雛",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雏"
        },
        {
            "location": "221/TALK",
            "narrator": "繭",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "茧"
        },
        {
            "location": "222/TALK",
            "narrator": "つばめ",
            "text": "お願い！",
            "zh": "拜托了！",
            "narrator_zh": "燕"
        },
        {
            "location": "224/TALK",
            "narrator": "雛",
            "text": "はぁ…。",
            "zh": "唉……。",
            "narrator_zh": "雏"
        },
        {
            "location": "225/TALK",
            "narrator": "雛",
            "text": "つばめちゃんって…、\nどんなことがあっても\nつばめちゃんだね…。",
            "zh": "燕你啊……、\n不管发生什么\n都还是燕……。",
            "narrator_zh": "雏"
        },
        {
            "location": "226/TALK",
            "narrator": "つばめ",
            "text": "…え？",
            "zh": "……哎？",
            "narrator_zh": "燕"
        },
        {
            "location": "228/TALK",
            "narrator": "雛",
            "text": "いや、普通はこういう時、\nあいつ絶対許せない、って\n怒るとこでしょ？",
            "zh": "不是，一般这种时候，\n会怒着说绝对不能\n原谅那家伙吧？",
            "narrator_zh": "雏"
        },
        {
            "location": "229/TALK",
            "narrator": "雛",
            "text": "なのに、まさか全力で\n庇うなんて…。",
            "zh": "结果你居然全力\n护着她……。",
            "narrator_zh": "雏"
        },
        {
            "location": "230/TALK",
            "narrator": "つばめ",
            "text": "…変、かな？",
            "zh": "……奇怪吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "231/TALK",
            "narrator": "繭",
            "text": "変。",
            "zh": "奇怪。",
            "narrator_zh": "茧"
        },
        {
            "location": "234/TALK",
            "narrator": "つばめ",
            "text": "うう…。",
            "zh": "呜呜……。",
            "narrator_zh": "燕"
        },
        {
            "location": "235/TALK",
            "narrator": "繭",
            "text": "でも、逢瀬さんらしい。\n甘いと思うけど、\n嫌いじゃないわ。",
            "zh": "不过，很像逢濑。\n我觉得太天真了，\n但并不讨厌。",
            "narrator_zh": "茧"
        },
        {
            "location": "236/TALK",
            "narrator": "雛",
            "text": "第一、つばめちゃんが\n誰かを悪く言うところ、\n想像できなかったし。",
            "zh": "再说，燕\n说别人坏话的样子，\n我根本想象不出来。",
            "narrator_zh": "雏"
        },
        {
            "location": "237/TALK",
            "narrator": "雛",
            "text": "どんな悪い人でも\n庇っちゃうのが\nつばめちゃんだもんね。",
            "zh": "不管多坏的人\n都会护着，\n这就是燕呀。",
            "narrator_zh": "雏"
        },
        {
            "location": "239/TALK",
            "narrator": "つばめ",
            "text": "そ、そうかな？",
            "zh": "是、是这样吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "240/TALK",
            "narrator": "雛",
            "text": "そうだよ。",
            "zh": "就是这样。",
            "narrator_zh": "雏"
        },
        {
            "location": "241/TALK",
            "narrator": "雛",
            "text": "つばめちゃんの\nそういうところ、\nスゴいと思うよ。",
            "zh": "燕的\n这一点，\n我觉得很厉害。",
            "narrator_zh": "雏"
        },
        {
            "location": "242/TALK",
            "narrator": "雛",
            "text": "かっこいいなー、とも\nちょっと思う。",
            "zh": "也有点觉得\n好帅啊。",
            "narrator_zh": "雏"
        },
        {
            "location": "243/TALK",
            "narrator": "雛",
            "text": "だから…つばめちゃんが\nそう言うなら、あたしも\n信じるよ。",
            "zh": "所以……燕这么说的话，\n我也\n相信。",
            "narrator_zh": "雏"
        },
        {
            "location": "244/TALK",
            "narrator": "雛",
            "text": "神楽ちゃんには\n何か事情があったんだ、\nって。",
            "zh": "神乐\n是有什么苦衷的，\n这么想。",
            "narrator_zh": "雏"
        },
        {
            "location": "245/TALK",
            "narrator": "繭",
            "text": "…不本意ではあるけど、\n私も信じるわ。",
            "zh": "……虽然不情愿，\n我也相信。",
            "narrator_zh": "茧"
        },
        {
            "location": "248/TALK",
            "narrator": "つばめ",
            "text": "…ほんとう？",
            "zh": "……真的吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "249/TALK",
            "narrator": "雛",
            "text": "もちろん。",
            "zh": "当然。",
            "narrator_zh": "雏"
        },
        {
            "location": "251/TALK",
            "narrator": "雛",
            "text": "…でも、つばめちゃんを\n傷つけたことに関しては、\n許さないけどねー。",
            "zh": "……不过，伤害了燕\n这件事，\n我可不原谅哦。",
            "narrator_zh": "雏"
        },
        {
            "location": "252/TALK",
            "narrator": "繭",
            "text": "当然。\nただ許すのは無理。\n代償は支払ってもらう。",
            "zh": "当然。\n就这么原谅做不到。\n代价还是要她付。",
            "narrator_zh": "茧"
        },
        {
            "location": "253/TALK",
            "narrator": "つばめ",
            "text": "で、でも、神楽ちゃんは！",
            "zh": "可、可是，神乐她！",
            "narrator_zh": "燕"
        },
        {
            "location": "254/TALK",
            "narrator": "雛",
            "text": "どんな事情があっても、\nつばめちゃんを傷つけた\n事実は変わらないよ。",
            "zh": "不管有什么苦衷，\n伤害了燕\n这个事实不会变。",
            "narrator_zh": "雏"
        },
        {
            "location": "255/TALK",
            "narrator": "雛",
            "text": "だから、今度会ったら\nそのことは超怒るよ。",
            "zh": "所以，下次见到她\n这件事我会超级生气。",
            "narrator_zh": "雏"
        },
        {
            "location": "256/TALK",
            "narrator": "雛",
            "text": "あたしの友達に\nなんてことするんだ！\nふざけるな、って…。",
            "zh": "对我朋友\n做这种事！\n开什么玩笑，之类的……。",
            "narrator_zh": "雏"
        },
        {
            "location": "257/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "258/TALK",
            "narrator": "雛",
            "text": "でも、怒るだけ怒ったら、\nもうおしまい。",
            "zh": "不过，气归气，\n气完就结束。",
            "narrator_zh": "雏"
        },
        {
            "location": "259/TALK",
            "narrator": "雛",
            "text": "あとは、つばめちゃんの\n望む通り、友達に戻る\n努力をするよー。",
            "zh": "之后，就按燕\n所希望的，努力重新\n做回朋友哦。",
            "narrator_zh": "雏"
        },
        {
            "location": "260/TALK",
            "narrator": "繭",
            "text": "…逢瀬さんが許す以上、\n私達が怒り続けるのも\nおかしいし。",
            "zh": "……既然逢濑都原谅了，\n我们一直生气下去\n也不对劲。",
            "narrator_zh": "茧"
        },
        {
            "location": "261/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "262/TALK",
            "narrator": "雛",
            "text": "今すぐに許すって\n約束はできない。",
            "zh": "现在立刻就原谅，\n这个约定我做不到。",
            "narrator_zh": "雏"
        },
        {
            "location": "263/TALK",
            "narrator": "雛",
            "text": "でも…また四人で、\n遊んだりお買い物行ったり\nしたいと思うから。",
            "zh": "可是……还想\n四个人再一起玩、一起\n去买东西。",
            "narrator_zh": "雏"
        },
        {
            "location": "264/TALK",
            "narrator": "雛",
            "text": "あたしも、精一杯努力して\n友達に戻れるよう頑張る。",
            "zh": "我也会尽全力，\n努力重新做回朋友。",
            "narrator_zh": "雏"
        },
        {
            "location": "265/TALK",
            "narrator": "雛",
            "text": "だから、とりあえず\n今はそれで\n納得してもらいたいなー？",
            "zh": "所以，暂时\n先这样，\n希望你能接受——？",
            "narrator_zh": "雏"
        },
        {
            "location": "266/TALK",
            "narrator": "つばめ",
            "text": "…うん。",
            "zh": "……嗯。",
            "narrator_zh": "燕"
        },
        {
            "location": "268/TALK",
            "narrator": "つばめ",
            "text": "ありがとう…。\nごめんね…、\nワガママ言って…。",
            "zh": "谢谢……。\n对不起……、\n说了任性的话……。",
            "narrator_zh": "燕"
        },
        {
            "location": "270/TALK",
            "narrator": "雛",
            "text": "ま、つばめちゃんの\n友達やってるんだもん。\n覚悟はしてるってー。",
            "zh": "嘛，我可是\n在当燕的朋友。\n早就有觉悟了哦。",
            "narrator_zh": "雏"
        },
        {
            "location": "271/TALK",
            "narrator": "繭",
            "text": "子供はワガママを\n言うものだから。",
            "zh": "小孩就是会\n说任性的话。",
            "narrator_zh": "茧"
        },
        {
            "location": "272/TALK",
            "narrator": "つばめ",
            "text": "こ、子供って…、\n同い年なのにぃ…。",
            "zh": "小、小孩……、\n明明同年的呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "273/TALK",
            "narrator": "雛",
            "text": "あはは、まあいいじゃん。\nチャームポイントだと\n思うしー。",
            "zh": "啊哈哈，无所谓啦。\n我觉得这是\n魅力点哦。",
            "narrator_zh": "雏"
        },
        {
            "location": "274/TALK",
            "narrator": "雛",
            "text": "とにかくさ、あたし達は\nつばめちゃんのこと\n応援してるよ。",
