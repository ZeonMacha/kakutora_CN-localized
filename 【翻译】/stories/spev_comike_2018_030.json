{
    "dir": "chap00/daydra/spev_comike_2018_030.js",
    "type": "",
    "info": {
        "story_id": "91073",
        "cid": "",
        "title": "がすとちゃんサマー大作戦♪",
        "sub_title": "作戦３：ソラノキヲク秘密の打合せ♪",
        "title_zh": "GUST酱的夏日大作战♪",
        "sub_title_zh": "作战3：《天空的记忆》秘密商谈♪"
    },
    "entry": [
        {
            "location": "695/SCENARIO",
            "narrator": "",
            "text": "メノウ",
            "zh": "MENOW",
            "narrator_zh": ""
        },
        {
            "location": "715/DIALOG",
            "narrator": "",
            "text": "このエピソードは、とある夜のWAVEによる打ち合わせをそのまま記録したものです。\n\n一部、ネタバレ要素であると感じてしまう箇所もあるかもしれませんので、視聴は自己責任でお願いします。\n\nエピソードを見ますか？",
            "zh": "本篇剧情是把某天夜里通过WAVE进行的商谈原封不动记录下来的内容。\n\n其中可能存在让人觉得涉及剧透的部分，观看请自负风险。\n\n要观看这段剧情吗？",
            "narrator_zh": ""
        },
        {
            "location": "721/TALK",
            "narrator": "神楽",
            "text": "んーと…",
            "zh": "嗯——我想想……",
            "narrator_zh": "神乐"
        },
        {
            "location": "722/TALK",
            "narrator": "神楽",
            "text": "『FreyMENOWとして、\nファンの皆様へ』",
            "zh": "『作为FreyMENOW，\n致各位粉丝』",
            "narrator_zh": "神乐"
        },
        {
            "location": "723/TALK",
            "narrator": "神楽",
            "text": "『卯月神楽として、\nトライナリーのみんなへ』",
            "zh": "『作为卯月神乐，\n致三重奏的大家』",
            "narrator_zh": "神乐"
        },
        {
            "location": "724/TALK",
            "narrator": "神楽",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "725/TALK",
            "narrator": "神楽",
            "text": "『そして』",
            "zh": "『然后』",
            "narrator_zh": "神乐"
        },
        {
            "location": "726/TALK",
            "narrator": "神楽",
            "text": "『遠い彼方の世界にいる』",
            "zh": "『致远在彼方世界的』",
            "narrator_zh": "神乐"
        },
        {
            "location": "727/TALK",
            "narrator": "神楽",
            "text": "………。",
            "zh": "………",
            "narrator_zh": "神乐"
        },
        {
            "location": "728/TALK",
            "narrator": "神楽",
            "text": "『私の大切な人へ』",
            "zh": "『我重要的人』",
            "narrator_zh": "神乐"
        },
        {
            "location": "729/TALK",
            "narrator": "神楽",
            "text": "……うーん、\nどうしよ……。",
            "zh": "……唔——，\n怎么办好呢……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "730/TALK",
            "narrator": "神楽",
            "text": "ちょっと電波？\nていうか、",
            "zh": "会不会有点电波？\n应该说，",
            "narrator_zh": "神乐"
        },
        {
            "location": "731/TALK",
            "narrator": "神楽",
            "text": "なんかこれだと\n恋人いる宣言みたいかな…",
            "zh": "总觉得这样写\n像是公开自己有恋人的宣言似的……",
            "narrator_zh": "神乐"
        },
        {
            "location": "732/TALK",
            "narrator": "神楽",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "733/TALK",
            "narrator": "神楽",
            "text": "まあ、恋愛禁止の\nアイドルじゃ\nあるまいし――",
            "zh": "嘛，反正我也不是\n什么禁止恋爱的\n偶像——",
            "narrator_zh": "神乐"
        },
        {
            "location": "734/TALK",
            "narrator": "神楽",
            "text": "うーん……でも、",
            "zh": "唔……不过，",
            "narrator_zh": "神乐"
        },
        {
            "location": "735/TALK",
            "narrator": "神楽",
            "text": "やっぱり\n発狂する人\n出るかなぁ。",
            "zh": "果然还是\n会有人发狂\n的吧。",
            "narrator_zh": "神乐"
        },
        {
            "location": "736/TALK",
            "narrator": "神楽",
            "text": "ほんと、\n後書きって難しい。",
            "zh": "真是的，\n后记好难写啊。",
            "narrator_zh": "神乐"
        },
        {
            "location": "743/TALK",
            "narrator": "SAKI@USS",
            "text": "こんばんは、アップサイドの早希です。",
            "zh": "晚上好，我是Upside的早希。",
            "narrator_zh": "SAKI@USS"
        },
        {
            "location": "745/TALK",
            "narrator": "神楽",
            "text": "こんばんは～",
            "zh": "晚上好～",
            "narrator_zh": "神乐"
        },
        {
            "location": "747/TALK",
            "narrator": "SAKI@USS",
            "text": "早速ですが、色校上がりましたのでご確認お願いします。",
            "zh": "恕我直言进入正题，印前校色稿已经出来了，请确认。",
            "narrator_zh": "SAKI@USS"
        },
        {
            "location": "748/TALK",
            "narrator": "神楽",
            "text": "ほんとですか！早く！！",
            "zh": "真的吗！快发来！！",
            "narrator_zh": "神乐"
        },
        {
            "location": "750/TALK",
            "narrator": "SAKI@USS",
            "text": "ジャケです。",
            "zh": "这是封面图。",
            "narrator_zh": "SAKI@USS"
        },
        {
            "location": "751/TALK",
            "narrator": "SAKI@USS",
            "text": "デザイナーから上がってきたのはもっと原色でしたけど、歌詞が絵の具をテーマにしていましたので、淡い感じに修正してもらいました。如何ですか？",
            "zh": "设计师初稿交上来的颜色还要更偏原色一些，不过歌词是以颜料为主题的，所以我请对方调整成了淡雅一些的感觉。您觉得如何？",
            "narrator_zh": "SAKI@USS"
        },
        {
            "location": "752/TALK",
            "narrator": "神楽",
            "text": "すごく素敵です！！",
            "zh": "超级好看！！",
            "narrator_zh": "神乐"
        },
        {
            "location": "753/TALK",
            "narrator": "神楽",
            "text": "これで！",
            "zh": "就用这个！",
            "narrator_zh": "神乐"
        },
        {
            "location": "755/TALK",
            "narrator": "SAKI@USS",
            "text": "承知しました。では次に",
            "zh": "明白。那么接下来",
            "narrator_zh": "SAKI@USS"
        },
        {
            "location": "756/TALK",
            "narrator": "SAKI@USS",
            "text": "ブックですね",
            "zh": "是书本部分",
            "narrator_zh": "SAKI@USS"
        },
        {
            "location": "757/TALK",
            "narrator": "SAKI@USS",
            "text": "絵本と同じ仕様の上製本ですので、１C箔押し風印刷です。箔ではありませんが、高級感と渋みを前に押し出す感じにしてみました",
            "zh": "因为是和绘本相同规格的精装书，所以采用了单色仿烫金风格印刷。虽然不是真烫金，不过试着把高级感与内敛沉稳的质感凸显了出来",
            "narrator_zh": "SAKI@USS"
        },
        {
            "location": "758/TALK",
            "narrator": "神楽",
            "text": "すごーーーーい！",
            "zh": "好厉害————！",
            "narrator_zh": "神乐"
        },
        {
            "location": "760/TALK",
            "narrator": "SAKI@USS",
            "text": "ではこれで。",
            "zh": "那就用这个了。",
            "narrator_zh": "SAKI@USS"
        },
        {
            "location": "761/TALK",
            "narrator": "SAKI@USS",
            "text": "CDのレーベル面です。",
            "zh": "这是CD的盘面。",
            "narrator_zh": "SAKI@USS"
        },
        {
            "location": "762/TALK",
            "narrator": "SAKI@USS",
            "text": "これだけ入稿が早いので、このWAVEでFIXとさせて欲しいのですが、問題有ればすぐに突っ込み入れて下さい。",
            "zh": "只有这部分的交稿尤其赶，希望能就在这次WAVE里拍板定稿，如果有什么问题请马上提出来。",
            "narrator_zh": "SAKI@USS"
        },
        {
            "location": "763/TALK",
            "narrator": "神楽",
            "text": "かわいい！！",
            "zh": "好可爱！！",
            "narrator_zh": "神乐"
        },
        {
            "location": "764/TALK",
            "narrator": "神楽",
            "text": "ていうか、もしかしてこれって",
            "zh": "话说，难道说这个是",
            "narrator_zh": "神乐"
        },
        {
            "location": "765/TALK",
            "narrator": "神楽",
            "text": "あれですか！？！？",
            "zh": "那个吗！？！？",
            "narrator_zh": "神乐"
        },
        {
            "location": "766/TALK",
            "narrator": "神楽",
            "text": "イルカの置物あるし！！",
            "zh": "居然还有海豚摆件！！",
            "narrator_zh": "神乐"
        },
        {
            "location": "768/TALK",
            "narrator": "SAKI@USS",
            "text": "気づいてもらえてよかったです。アレですね。",
            "zh": "您能注意到真是太好了。正是那个。",
            "narrator_zh": "SAKI@USS"
        },
        {
            "location": "769/TALK",
            "narrator": "神楽",
            "text": "すごい！！！ちょっと感動しました。そうきたか！",
            "zh": "太厉害了！！！我有点感动了。居然来这一手！",
            "narrator_zh": "神乐"
        },
        {
            "location": "770/TALK",
            "narrator": "神楽",
            "text": "これ、皆さんすごい感動すると思います！よく考えつきましたね、さすが早希さん",
            "zh": "我觉得大家看到肯定都会超级感动的！这都能想出来，不愧是早希",
            "narrator_zh": "神乐"
        },
        {
            "location": "772/TALK",
            "narrator": "SAKI@USS",
            "text": "いえ、何となく今までのメノウさんの傾向から、こういうのが良いのかなと思いまして。ちょっと博打でしたが、喜んでもらえて何よりです。",
            "zh": "哪里，只是隐约从MENOW以往的倾向猜想，觉得做成这样大概会不错。虽然有点赌一把的意思，您能喜欢就太好了。",
            "narrator_zh": "SAKI@USS"
        },
        {
            "location": "773/TALK",
            "narrator": "神楽",
            "text": "喜びました！とても！！",
            "zh": "非常喜欢！特别开心！！",
            "narrator_zh": "神乐"
        },
        {
            "location": "775/TALK",
            "narrator": "SAKI@USS",
            "text": "ありがとうございます。ではこれで進めても？",
            "zh": "谢谢。那么就按这个推进可以吗？",
            "narrator_zh": "SAKI@USS"
        },
        {
            "location": "776/TALK",
            "narrator": "神楽",
            "text": "是非！！",
            "zh": "务必！！",
            "narrator_zh": "神乐"
        },
        {
            "location": "778/TALK",
            "narrator": "SAKI@USS",
            "text": "では進めます。",
            "zh": "那就按此推进。",
            "narrator_zh": "SAKI@USS"
        },
        {
            "location": "779/TALK",
            "narrator": "SAKI@USS",
            "text": "というわけで、本文以外はこれでFIXですね、",
            "zh": "如此一来，除正文以外就都定稿了吧，",
            "narrator_zh": "SAKI@USS"
        },
        {
            "location": "780/TALK",
            "narrator": "SAKI@USS",
            "text": "残りは本文なのですが",
            "zh": "剩下的就是正文部分了",
            "narrator_zh": "SAKI@USS"
        },
        {
            "location": "781/TALK",
            "narrator": "SAKI@USS",
            "text": "現在、物語は既に戴いてますので、残りはメノウさんの後書きと、奥付ですね。",
            "zh": "目前故事已经收到了，剩下的就是MENOW的后记，还有版权页呢。",
            "narrator_zh": "SAKI@USS"
        },
        {
            "location": "782/TALK",
            "narrator": "SAKI@USS",
            "text": "後書きは明日の朝が〆切ですが、何とかなりそうでしょうか？",
            "zh": "后记明天早上就截止了，能赶得上吗？",
            "narrator_zh": "SAKI@USS"
        },
        {
            "location": "783/TALK",
            "narrator": "神楽",
            "text": "大丈夫だと思います。今半分くらい書き上げましたので",
            "zh": "应该没问题。现在已经写完一半左右了",
            "narrator_zh": "神乐"
        },
        {
            "location": "784/TALK",
            "narrator": "神楽",
            "text": "ところで、丁度いいのでひとつご意見を伺いたいのですけど",
            "zh": "对了，正好借这个机会我想请教一下你的意见",
            "narrator_zh": "神乐"
        },
        {
            "location": "786/TALK",
            "narrator": "SAKI@USS",
            "text": "もちろんです",
            "zh": "当然可以",
            "narrator_zh": "SAKI@USS"
        },
        {
            "location": "787/TALK",
            "narrator": "神楽",
            "text": "『そして、遠い彼方の世界にいる、私の大切な人へ――』",
            "zh": "『然后，致远在彼方世界的、我重要的人——』",
            "narrator_zh": "神乐"
        },
        {
            "location": "788/TALK",
            "narrator": "神楽",
            "text": "これ、ファン視点で見たときに、どう思います？危険ですかね？",
            "zh": "这句要是从粉丝视角来看的话，你觉得怎么样？会很危险吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "791/TALK",
            "narrator": "SAKI@USS",
            "text": "私の主観ですが、恐らくはさほど大きな問題にはならないかと思います。決定的なことは言ってませんから、何か炎上が発生しても、ファンの方の自浄作用が働くかと",
            "zh": "仅代表我个人看法，我觉得大概不至于闹出太大的问题。因为没有说出什么决定性的话，就算引起什么争议，粉丝们自身的净化机制应该也会发挥作用",
            "narrator_zh": "SAKI@USS"
        },
        {
            "location": "792/TALK",
            "narrator": "SAKI@USS",
            "text": "あ、ちなみに、",
            "zh": "啊，顺带一问，",
            "narrator_zh": "SAKI@USS"
        },
        {
            "location": "793/TALK",
            "narrator": "SAKI@USS",
            "text": "これって、あの方の事ですよね？メノウさんがいつも仰ってる、別世界の",
            "zh": "这指的是那位吧？就是MENOW经常提起的、另一个世界的",
            "narrator_zh": "SAKI@USS"
        },
        {
            "location": "795/TALK",
            "narrator": "神楽",
            "text": "そうですそうです！",
            "zh": "对对对！",
            "narrator_zh": "神乐"
        },
        {
            "location": "796/TALK",
            "narrator": "神楽",
            "text": "今回、異世界盤も同時リリースしますよね、だからどうしても伝えたいんですけど",
            "zh": "这次异世界版也会同步发行嘛，所以我无论如何都想把这份心情传达过去",
            "narrator_zh": "神乐"
        },
        {
            "location": "797/TALK",
            "narrator": "神楽",
            "text": "本音を言えば、ファンの皆さんにも私のことをちゃんと知って欲しくて",
            "zh": "说心里话，我也希望各位粉丝能好好了解一下真实的我",
            "narrator_zh": "神乐"
        },
        {
            "location": "798/TALK",
            "narrator": "神楽",
            "text": "ほら、新しい事務所作ったのだって、そういう想いからですし、一貫したものにしたいなって",
            "zh": "你看，我之所以成立新的事务所，也是出于这样的想法，希望能够做到贯彻始终",
            "narrator_zh": "神乐"
        },
        {
            "location": "800/TALK",
            "narrator": "SAKI@USS",
            "text": "想いはわかります",
            "zh": "您的心意我明白",
            "narrator_zh": "SAKI@USS"
        },
        {
            "location": "801/TALK",
            "narrator": "神楽",
            "text": "なので、わりとチャレンジャーなのは承知の上ですが",
            "zh": "所以，虽然明知道这样做相当具有挑战性",
            "narrator_zh": "神乐"
        },
        {
            "location": "803/TALK",
            "narrator": "SAKI@USS",
            "text": "そこまでお考えであれば、全く問題無いかと思います",
            "zh": "既然您都已经考虑得这么周全，我想完全没有问题",
            "narrator_zh": "SAKI@USS"
        },
        {
            "location": "804/TALK",
            "narrator": "SAKI@USS",
            "text": "むしろ、そこまで想われている彼方の大切な人が羨ましい限りです",
            "zh": "倒不如说，能被这样深深挂念着的那位彼方重要之人，真是令人羡慕得不得了呢",
            "narrator_zh": "SAKI@USS"
        },
        {
            "location": "805/TALK",
            "narrator": "神楽",
            "text": "むー",
            "zh": "唔——",
            "narrator_zh": "神乐"
        },
        {
            "location": "806/TALK",
            "narrator": "神楽",
            "text": "ちょっと恥ずかしいのでやめてください！",
            "zh": "有点害羞，请别打趣啦！",
            "narrator_zh": "神乐"
        },
        {
            "location": "808/TALK",
            "narrator": "SAKI@USS",
            "text": "独身女へのお駄賃だと想っていただければ",
            "zh": "您就当成是赏给单身女子的一点慰藉吧",
            "narrator_zh": "SAKI@USS"
        },
        {
            "location": "809/TALK",
            "narrator": "神楽",
            "text": "早希さん美人なんですから、すぐにいい人見つかりますよ",
            "zh": "早希你这么漂亮，肯定很快就能找到好对象的啦",
            "narrator_zh": "神乐"
        },
        {
            "location": "810/TALK",
            "narrator": "神楽",
            "text": "ていうか、私当ててあげましょうか",
            "zh": "话说，要不我来猜猜原因？",
            "narrator_zh": "神乐"
        },
        {
            "location": "812/TALK",
            "narrator": "SAKI@USS",
            "text": "どっきりどきどき",
            "zh": "好紧张好紧张",
            "narrator_zh": "SAKI@USS"
        },
        {
            "location": "813/TALK",
            "narrator": "神楽",
            "text": "自分からわざと恋人作らないようにしてますよね",
            "zh": "其实是你自己故意不交男朋友的吧",
            "narrator_zh": "神乐"
        },
        {
            "location": "815/TALK",
            "narrator": "SAKI@USS",
            "text": "仕事相手とは厳禁ですから",
            "zh": "因为和工作对象谈恋爱是严禁的嘛",
            "narrator_zh": "SAKI@USS"
        },
        {
            "location": "816/TALK",
            "narrator": "神楽",
            "text": "それ、わかります",
            "zh": "这点我懂",
            "narrator_zh": "神乐"
        },
        {
            "location": "817/TALK",
            "narrator": "神楽",
            "text": "私もそう思ってましたし今もそう思ってますしおすし",
