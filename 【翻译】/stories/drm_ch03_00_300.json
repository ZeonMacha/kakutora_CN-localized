{
    "dir": "dramatics/daydra/drm_ch03_00_300.js",
    "type": "Episode",
    "info": {
        "story_id": "3030",
        "cid": "gabriella",
        "title": "らぶとーく  第30話",
        "sub_title": "幼い恋",
        "title_zh": "恋爱漫谈 第30话",
        "sub_title_zh": "稚嫩的恋情"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "幼い恋",
            "zh": "稚嫩的恋情",
            "narrator_zh": ""
        },
        {
            "location": "19/TALK",
            "narrator": "ガブリエラ",
            "text": "えっと、買い物は\nこれで全部だった\nかしら？",
            "zh": "那个，要买的东西\n就这些了\n吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "20/TALK",
            "narrator": "ガブリエラ",
            "text": "他に必要なものは…。",
            "zh": "还有需要的东西吗……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "22/TALK",
            "narrator": "ガブリエラ",
            "text": "っ！？",
            "zh": "！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "29/TALK",
            "narrator": "ヒカル",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "光"
        },
        {
            "location": "39/TALK",
            "narrator": "ガブリエラ",
            "text": "うそっ！？\nまたヒカルくんだ…。",
            "zh": "不会吧！？\n又是光……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "40/TALK",
            "narrator": "ガブリエラ",
            "text": "それも、この前\n会った場所で\nまた会うなんて…。",
            "zh": "而且居然在前些天\n见过的地方\n又见面了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "42/TALK",
            "narrator": "ガブリエラ",
            "text": "これって、やっぱり…。",
            "zh": "这个，果然是……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "55/TALK",
            "narrator": "ガブリエラ",
            "text": "運命よね/////////",
            "zh": "是命运吧/////////",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "57/SEL",
            "narrator": "",
            "text": "なにが？",
            "zh": "什么？",
            "narrator_zh": ""
        },
        {
            "location": "58/ACT",
            "narrator": "",
            "text": "なにが？",
            "zh": "什么？",
            "narrator_zh": ""
        },
        {
            "location": "60/TALK",
            "narrator": "ガブリエラ",
            "text": "あそこにヒカルくんがいるの",
            "zh": "光就在那里",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "61/TALK",
            "narrator": "ガブリエラ",
            "text": "この前会った場所でまたヒカルくんと会えたの",
            "zh": "上次见面的地方又见到光君了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "62/TALK",
            "narrator": "ガブリエラ",
            "text": "これって運命よね？",
            "zh": "这就是命运吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "63/TALK",
            "narrator": "ガブリエラ",
            "text": "映画やドラマであるような",
            "zh": "像电影和电视剧里那样",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "65/TALK",
            "narrator": "ガブリエラ",
            "text": "超ロマンチックな/////////",
            "zh": "超级浪漫的/////////",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "67/SEL",
            "narrator": "",
            "text": "ただの偶然",
            "zh": "只是偶然",
            "narrator_zh": ""
        },
        {
            "location": "68/SEL",
            "narrator": "",
            "text": "うん、運命じゃない",
            "zh": "嗯，才不是命运",
            "narrator_zh": ""
        },
        {
            "location": "69/SEL",
            "narrator": "",
            "text": "仕込んでおきました",
            "zh": "已经准备好了",
            "narrator_zh": ""
        },
        {
            "location": "70/ACT",
            "narrator": "",
            "text": "ただの偶然",
            "zh": "只是偶然",
            "narrator_zh": ""
        },
        {
            "location": "72/TALK",
            "narrator": "ガブリエラ",
            "text": "わかってないのね",
            "zh": "你没明白呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "73/TALK",
            "narrator": "ガブリエラ",
            "text": "一度だけなら偶然だけど",
            "zh": "一次的话是偶然",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "74/TALK",
            "narrator": "ガブリエラ",
            "text": "重なれば運命よ",
            "zh": "重叠起来就是命运",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "75/ACT",
            "narrator": "",
            "text": "うん、運命じゃない",
            "zh": "嗯，才不是命运",
            "narrator_zh": ""
        },
        {
            "location": "77/TALK",
            "narrator": "ガブリエラ",
            "text": "だとしたら必然ってやつね",
            "zh": "那样的话就是必然呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "78/ACT",
            "narrator": "",
            "text": "仕込んでおきました",
            "zh": "已经准备好了",
            "narrator_zh": ""
        },
        {
            "location": "80/TALK",
            "narrator": "ガブリエラ",
            "text": "気が利くじゃない、$handle$",
            "zh": "挺机灵的嘛，$handle$",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "81/TALK",
            "narrator": "ガブリエラ",
            "text": "流石は私の使用人ね",
            "zh": "不愧是我的用人",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "83/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょっと挨拶してくるわ",
            "zh": "我去打个招呼",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "94/TALK",
            "narrator": "ガブリエラ",
            "text": "…この前みたいに、\nまた服の裾を引っ張って\nみようかしら？",
            "zh": "……要不要像上次那样，\n再拉一下\n衣角？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "97/TALK",
            "narrator": "ヒカル",
            "text": "……あれ？",
            "zh": "……咦？",
            "narrator_zh": "光"
        },
        {
            "location": "98/TALK",
            "narrator": "ヒカル",
            "text": "あ、ガブリエラさん。",
            "zh": "啊，加布里埃拉。",
            "narrator_zh": "光"
        },
        {
            "location": "101/TALK",
            "narrator": "ガブリエラ",
            "text": "っ！？",
            "zh": "！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "102/TALK",
            "narrator": "ガブリエラ",
            "text": "うそっ！？\nヒカルくんの方から\n気付いてくれた！？",
            "zh": "不会吧！？\n光先\n注意到我了！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "103/TALK",
            "narrator": "ヒカル",
            "text": "こんにちは。\nお買い物ですか？",
            "zh": "你好。\n来买东西吗？",
            "narrator_zh": "光"
        },
        {
            "location": "105/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "106/TALK",
            "narrator": "ガブリエラ",
            "text": "い、いけない！\n早く答えないと。",
            "zh": "不、不好！\n得快点回。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "108/TALK",
            "narrator": "ガブリエラ",
            "text": "えっと…そうです。\nヒカルくんもですか？\nっと…。",
            "zh": "那个……是的。\n光也是吗？\n发送……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "109/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "110/TALK",
            "narrator": "ヒカル",
            "text": "はい。\nいつも買ってる雑誌を\n買いに来たんです。",
            "zh": "是的。\n我来买一直在买的\n杂志。",
            "narrator_zh": "光"
        },
        {
            "location": "111/TALK",
            "narrator": "ヒカル",
            "text": "今は買い忘れがないかを\nチェックしてて…。",
            "zh": "现在在确认\n有没有忘买的……",
            "narrator_zh": "光"
        },
        {
            "location": "113/TALK",
            "narrator": "ガブリエラ",
            "text": "そうだったんだ…。",
            "zh": "原来是这样…。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "114/TALK",
            "narrator": "ヒカル",
            "text": "それにしても、\n本当に奇遇ですね。",
            "zh": "不过话说回来，\n真是奇遇呢。",
            "narrator_zh": "光"
        },
        {
            "location": "115/TALK",
            "narrator": "ヒカル",
            "text": "確か、この前会ったのも\nこの場所でしたし――",
            "zh": "上次见面\n好像也是这个地方——",
            "narrator_zh": "光"
        },
        {
            "location": "116/TALK",
            "narrator": "ヒカル",
            "text": "こんな偶然が二回も\n続くなんて、ちょっと\n驚きです。",
            "zh": "这样的偶然连着\n发生两次，真是\n有点吃惊。",
            "narrator_zh": "光"
        },
        {
            "location": "119/TALK",
            "narrator": "ガブリエラ",
            "text": "えっ！？",
            "zh": "诶！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "120/TALK",
            "narrator": "ガブリエラ",
            "text": "私も同じことを\n考えていました、っと。",
            "zh": "我也在想\n同样的事，发送。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "121/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "122/TALK",
            "narrator": "ヒカル",
            "text": "あはは、そうですよね。",
            "zh": "啊哈哈，是啊。",
            "narrator_zh": "光"
        },
        {
            "location": "123/TALK",
            "narrator": "ヒカル",
            "text": "この様子だと、そんなに\n遠くないうちに――",
            "zh": "照这情形来看，应该不用\n太久——",
            "narrator_zh": "光"
        },
        {
            "location": "124/TALK",
            "narrator": "ヒカル",
            "text": "三回目の偶然が\nありそうですね。",
            "zh": "感觉会有\n第三次偶然呢。",
            "narrator_zh": "光"
        },
        {
            "location": "126/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "127/TALK",
            "narrator": "ガブリエラ",
            "text": "…私もそう思います。",
            "zh": "……我也这么想。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "128/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "129/TALK",
            "narrator": "ヒカル",
            "text": "ですよね。",
            "zh": "是啊。",
            "narrator_zh": "光"
        },
        {
            "location": "131/TALK",
            "narrator": "ヒカル",
            "text": "そうだ。\n三回目はどっちが先に\n見つけるか――",
            "zh": "对。\n第三次就看谁先\n找到——",
            "narrator_zh": "光"
        },
        {
            "location": "132/TALK",
            "narrator": "ヒカル",
            "text": "競争とかしたら\n面白そうですね。",
            "zh": "要是比赛的话\n好像很有趣呢。",
            "narrator_zh": "光"
        },
        {
            "location": "134/TALK",
            "narrator": "ガブリエラ",
            "text": "負けません！",
            "zh": "我不会输！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "135/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "136/TALK",
            "narrator": "ヒカル",
            "text": "僕も楽しみです。",
            "zh": "我也很期待。",
            "narrator_zh": "光"
        },
        {
            "location": "137/TALK",
            "narrator": "ガブリエラ",
            "text": "ヒカルくんも、\nあたしと会うのが\n楽しみなんて――",
            "zh": "光也，\n期待和我见面\n什么的——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "138/TALK",
            "narrator": "ガブリエラ",
            "text": "凄く嬉しい！",
            "zh": "超级高兴！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "140/TALK",
            "narrator": "ヒカル",
            "text": "あっ、いけない。\nそろそろ帰らないと…。",
            "zh": "啊，不好。\n差不多该回去了……",
            "narrator_zh": "光"
        },
        {
            "location": "141/TALK",
            "narrator": "ヒカル",
            "text": "それじゃ、\nガブリエラさん。\nまた学校で。",
            "zh": "那么，\n加布里埃拉。\n学校再见。",
            "narrator_zh": "光"
        },
        {
            "location": "142/TALK",
            "narrator": "ガブリエラ",
            "text": "はい、それじゃあ。",
            "zh": "好，那就。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "144/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "145/TALK",
            "narrator": "ヒカル",
            "text": "ガブリエラさんも、\n気を付けて帰って\nくださいね。",
            "zh": "加布里埃拉也\n路上小心\n哦。",
            "narrator_zh": "光"
        },
        {
            "location": "149/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "161/TALK",
            "narrator": "ガブリエラ",
            "text": "聞いた、$handle$？",
            "zh": "听到了吗，$handle$？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "162/TALK",
            "narrator": "ガブリエラ",
            "text": "ヒカルくんも",
            "zh": "光也",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "163/TALK",
            "narrator": "ガブリエラ",
            "text": "また私と会うのが楽しみって言ってたわ///////////",
            "zh": "说了期待再和我见面///////////",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "164/TALK",
            "narrator": "ガブリエラ",
            "text": "やっぱり運命だったのよ！",
            "zh": "果然是命运！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "165/TALK",
            "narrator": "ガブリエラ",
            "text": "これからはこの道を通る度にドキドキしちゃいそう",
            "zh": "以后每次走过这条路，好像都会心跳加速",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "177/TALK",
            "narrator": "ガブリエラ",
            "text": "ふふっ、早く三回目が\n来るといいな…。",
            "zh": "呵呵，希望第三次\n快点来……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "17/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>某月某日　3:18 PM</color>\nとある休日の午後、町中にて。",
            "zh": "<color=green>某月某日　3:18 PM</color>\n某个休息日的下午，街上。",
            "narrator_zh": "Dialog_EventData"
        }
    ]
}
