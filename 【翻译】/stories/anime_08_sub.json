    },
    "entry": [
        {
            "location": "473/SCENARIO",
            "narrator": "",
            "text": "アニメ第08話みやびサブ",
            "zh": "动画第08话雅子剧情",
            "narrator_zh": ""
        },
        {
            "location": "475/SEL",
            "narrator": "",
            "text": "ところで、みやびの心配事は、千羽鶴的にはどうだったの？",
            "zh": "不过，雅担心的事，在千羽鹤看来怎么样？",
            "narrator_zh": ""
        },
        {
            "location": "476/ACT",
            "narrator": "",
            "text": "ところで、みやびの心配事は、千羽鶴的にはどうだったの？",
            "zh": "不过，雅担心的事，在千羽鹤看来怎么样？",
            "narrator_zh": ""
        },
        {
            "location": "478/TALK",
            "narrator": "千羽鶴",
            "text": "的中した。",
            "zh": "说中了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "479/SEL",
            "narrator": "",
            "text": "みやびが、つばめたちを信用していないってこと？",
            "zh": "是说雅不信任燕她们吗？",
            "narrator_zh": ""
        },
        {
            "location": "480/SEL",
            "narrator": "",
            "text": "みやびが、情報管理庁を信用していないってこと？",
            "zh": "是说雅不信任情报管理厅吗？",
            "narrator_zh": ""
        },
        {
            "location": "481/ACT",
            "narrator": "",
            "text": "みやびが、つばめたちを信用していないってこと？",
            "zh": "是说雅不信任燕她们吗？",
            "narrator_zh": ""
        },
        {
            "location": "482/ACT",
            "narrator": "",
            "text": "みやびが、情報管理庁を信用していないってこと？",
            "zh": "是说雅不信任情报管理厅吗？",
            "narrator_zh": ""
        },
        {
            "location": "485/TALK",
            "narrator": "千羽鶴",
            "text": "ええ、まあ。\nそんなところ。",
            "zh": "嗯，算是吧。\n差不多就是那样。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "486/TALK",
            "narrator": "千羽鶴",
            "text": "まあでも、\nしばらくは貴方の判断に\n委ねることにする。",
            "zh": "不过嘛，\n暂时还是交由你来\n判断吧。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "487/TALK",
            "narrator": "千羽鶴",
            "text": "すぐに危機的状況に\nなるとは考えにくいし――",
            "zh": "短期内也不太可能\n变成危机状况——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "489/SEL",
            "narrator": "",
            "text": "今ときめいた",
            "zh": "刚才心动了",
            "narrator_zh": ""
        },
        {
            "location": "490/SEL",
            "narrator": "",
            "text": "今ゾッとした",
            "zh": "刚才吓出一身冷汗",
            "narrator_zh": ""
        },
        {
            "location": "491/ACT",
            "narrator": "",
            "text": "今ときめいた",
            "zh": "刚才心动了",
            "narrator_zh": ""
        },
        {
            "location": "493/TALK",
            "narrator": "千羽鶴",
            "text": "よかった。",
            "zh": "那太好了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "494/TALK",
            "narrator": "千羽鶴",
            "text": "貴方が今想像したとおり、\n私は貴方のことを\n信頼してる。",
            "zh": "就跟你刚才想象的一样，\n我可是很信任\n你的。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "496/TALK",
            "narrator": "千羽鶴",
            "text": "これからも、ちーのために\n頑張って働いてね？\nおねがい。",
            "zh": "今后也要为了小千\n好好努力工作哦？\n拜托啦。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "498/TALK",
            "narrator": "千羽鶴",
            "text": "24時間365日休むことなく。",
            "zh": "24小时365天全年无休。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "499/ACT",
            "narrator": "",
            "text": "今ゾッとした",
            "zh": "刚才吓出一身冷汗",
            "narrator_zh": ""
        },
        {
            "location": "501/TALK",
            "narrator": "千羽鶴",
            "text": "あら、失礼ね。",
            "zh": "哎呀，真失礼。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "502/TALK",
            "narrator": "千羽鶴",
            "text": "私がこうやって優しい顔を\nしながらも、実は裏で何か\n企んでいて――",
            "zh": "我这样摆出一副温柔的笑脸，\n其实背地里在\n密谋着什么——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "503/TALK",
            "narrator": "千羽鶴",
            "text": "もう引き返せない所まで\n来たときに貴方に無理な\n要求を押しつけて――",
            "zh": "等到了你已经无法回头\n的地步时，再强行\n对你提出无理的要求——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "504/TALK",
            "narrator": "千羽鶴",
            "text": "『そ、そんなこと\n　$me$にはできないよ！』",
            "zh": "『这、这种事\n　$me$做不到啊！』",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "505/TALK",
            "narrator": "千羽鶴",
            "text": "『そう、ならば\n　彼女はこれでさよならね』",
            "zh": "『这样啊，那她\n　就到此为止了呢』",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "506/TALK",
            "narrator": "千羽鶴",
            "text": "『き、きたない！\n　汚いぞ千羽鶴！』",
            "zh": "『好、好卑鄙！\n　你真卑鄙啊千羽鹤！』",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "507/TALK",
            "narrator": "千羽鶴",
            "text": "『フッ…』",
            "zh": "『哼……』",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "509/TALK",
            "narrator": "千羽鶴",
            "text": "なんてことを\n想像したりしてる？",
            "zh": "你是不是在想象\n诸如此类的展开呀？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "510/SEL",
            "narrator": "",
            "text": "はい",
            "zh": "是",
            "narrator_zh": ""
        },
        {
            "location": "511/SEL",
            "narrator": "",
            "text": "いいえ",
            "zh": "不是",
            "narrator_zh": ""
        },
        {
            "location": "512/SEL",
            "narrator": "",
            "text": "寧ろご褒美",
            "zh": "倒不如说是奖励",
            "narrator_zh": ""
        },
        {
            "location": "513/ACT",
            "narrator": "",
            "text": "はい",
            "zh": "是",
            "narrator_zh": ""
        },
        {
            "location": "514/TALK",
            "narrator": "千羽鶴",
            "text": "映画の見過ぎ。",
            "zh": "电影看太多了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "515/TALK",
            "narrator": "千羽鶴",
            "text": "とはいえ、\nそういうのもちょっと\n面白いかもしれない…。",
            "zh": "话虽如此，\n那种展开说不定\n也挺有意思的……。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "516/ACT",
            "narrator": "",
            "text": "いいえ",
            "zh": "不是",
            "narrator_zh": ""
        },
        {
            "location": "517/TALK",
            "narrator": "千羽鶴",
            "text": "そう…。\n勘が外れた。",
            "zh": "这样啊……。\n猜错了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "518/TALK",
            "narrator": "千羽鶴",
            "text": "まあ、何を考えていたかは\n聞かないことにしておく。",
            "zh": "算了，至于你在想什么\n我就不打听了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "519/ACT",
            "narrator": "",
            "text": "寧ろご褒美",
            "zh": "倒不如说是奖励",
            "narrator_zh": ""
        },
        {
            "location": "520/TALK",
            "narrator": "千羽鶴",
            "text": "…もしかして貴方、\nドエム？",
            "zh": "……难道说你，\n是个抖M？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "522/TALK",
            "narrator": "千羽鶴",
            "text": "いろんなこと\nしてあげたい。",
            "zh": "好想对你做\n各种各样的事啊。",
            "narrator_zh": "千羽鹤"
        }
    ]
}
