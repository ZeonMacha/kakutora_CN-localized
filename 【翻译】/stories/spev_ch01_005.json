  },
  {
   "location": "114/TALK",
   "narrator": "つばめ",
   "text": "特別な感じしなくなっちゃって",
   "zh": "就不特别了",
   "narrator_zh": "燕"
  },
  {
   "location": "115/TALK",
   "narrator": "つばめ",
