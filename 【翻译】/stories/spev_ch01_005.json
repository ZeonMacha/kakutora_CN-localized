  },
  {
   "location": "109/TALK",
   "narrator": "つばめ",
   "text": "綺麗とは思ってたけど",
   "zh": "觉得好看是觉得好看",
   "narrator_zh": "燕"
  },
  {
   "location": "110/TALK",
   "narrator": "つばめ",
   "text": "着たぃとは",
