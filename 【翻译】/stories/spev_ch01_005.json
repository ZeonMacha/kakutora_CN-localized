{
 "dir": "chap00/daydra/spev_ch01_005.js",
 "type": "",
 "info": {
  "story_id": "1005",
  "cid": "",
  "title": "スペシャルエピソード",
  "sub_title": "二人の花嫁",
  "title_zh": "特别篇",
  "sub_title_zh": "两个新娘"
 },
 "entry": [
  {
   "location": "22/TALK",
   "narrator": "透明神楽",
   "text": "キャー！！\nつばめさん、素敵です！\n素敵過ぎます！",
   "zh": "呀啊！！\n燕，太好看了！\n好看过头了！",
   "narrator_zh": "透明神乐"
  },
  {
   "location": "23/TALK",
   "narrator": "透明つばめ",
   "text": "ちょ、神楽ちゃん。\n声が大きいよ…。",
   "zh": "等、神乐。\n声音太大了……",
   "narrator_zh": "透明燕"
  },
  {
   "location": "24/TALK",
   "narrator": "透明神楽",
   "text": "だって、つばめさんが\n素敵過ぎるから\n仕方ないじゃないですか。",
   "zh": "因为燕\n好看过头了，\n这也没办法呀。",
   "narrator_zh": "透明神乐"
  },
  {
   "location": "25/TALK",
   "narrator": "透明つばめ",
   "text": "そ、そうかなぁ？\n神楽ちゃんの方が\n素敵だと思うけど…。",
   "zh": "是、是吗？\n我觉得神乐\n更好看……",
   "narrator_zh": "透明燕"
  },
  {
   "location": "26/TALK",
   "narrator": "透明神楽",
   "text": "いいえ。\nつばめさんの方が\nもっと可愛いですよ。",
   "zh": "不。\n燕\n更可爱。",
   "narrator_zh": "透明神乐"
  },
  {
   "location": "28/TALK",
   "narrator": "透明つばめ",
   "text": "…ありがと。",
   "zh": "……谢谢。",
   "narrator_zh": "透明燕"
  },
  {
   "location": "30/TALK",
   "narrator": "透明つばめ",
   "text": "こんなに素敵なドレス\n着たの初めてだから、\nちょっと心配だったんだ。",
   "zh": "这么好看的礼服\n我第一次穿，\n有点担心。",
   "narrator_zh": "透明燕"
  },
  {
   "location": "31/TALK",
   "narrator": "透明つばめ",
   "text": "似合ってなかったら\nどうしよう、って…。",
   "zh": "要是不适合\n怎么办……",
   "narrator_zh": "透明燕"
  },
  {
   "location": "32/TALK",
   "narrator": "透明神楽",
   "text": "心配無用です。\n本物のお嫁さんに\n見えますよ。",
   "zh": "不用担心。\n看起来就像\n真正的新娘。",
   "narrator_zh": "透明神乐"
  },
  {
   "location": "34/TALK",
   "narrator": "透明つばめ",
   "text": "えへへ…恥ずかしいけど、\n嬉しいな…。",
   "zh": "诶嘿嘿……虽然害羞，\n但是好高兴……",
   "narrator_zh": "透明燕"
  },
  {
   "location": "35/TALK",
   "narrator": "透明つばめ",
   "text": "そうだ、あとで一緒に\n記念写真撮ろ？",
   "zh": "对了，待会儿一起\n拍纪念照吧？",
   "narrator_zh": "透明燕"
  },
  {
   "location": "36/TALK",
   "narrator": "透明神楽",
   "text": "もちろんです。\nつばめさんの写真、\n待ち受けにしますね。",
   "zh": "当然。\n燕的照片，\n我要设成待机画面。",
   "narrator_zh": "透明神乐"
  },
  {
   "location": "39/TALK",
   "narrator": "透明つばめ",
   "text": "そ、それはちょっと\n恥ずかし過ぎるかも…。",
   "zh": "那、那个\n也许太害羞了……",
   "narrator_zh": "透明燕"
  },
  {
   "location": "40/TALK",
   "narrator": "透明神楽",
   "text": "…っていうか、\n正直記念写真よりも、\nしたいことがあるんです。",
   "zh": "……说起来，\n比起纪念照，\n我更想做一件事。",
   "narrator_zh": "透明神乐"
  },
  {
   "location": "41/TALK",
   "narrator": "透明つばめ",
   "text": "したいこと？",
   "zh": "想做的事？",
   "narrator_zh": "透明燕"
  },
  {
   "location": "43/TALK",
   "narrator": "透明神楽",
   "text": "はい…つばめさんと、\nこのまま結婚式を\n挙げちゃおうかな、って。",
   "zh": "嗯……想就这样\n和燕\n办一场婚礼。",
   "narrator_zh": "透明神乐"
  },
  {
   "location": "46/TALK",
   "narrator": "透明つばめ",
   "text": "え…えぇっ！？",
   "zh": "诶……诶诶！？",
   "narrator_zh": "透明燕"
  },
  {
   "location": "47/TALK",
   "narrator": "透明神楽",
   "text": "っていうか、これって\nいいタイミングだと\n思いませんか？",
   "zh": "说起来，你不觉得\n现在时机\n正好吗？",
   "narrator_zh": "透明神乐"
  },
  {
   "location": "48/TALK",
   "narrator": "透明神楽",
   "text": "お互いにウエディング\nドレス着て、準備完了の\n状態なんですし。",
   "zh": "我们都穿着\n婚纱，准备\n也做好了。",
   "narrator_zh": "透明神乐"
  },
  {
   "location": "49/TALK",
   "narrator": "透明神楽",
   "text": "このままチャペルで\n誓いの言葉を言っても\n変じゃないと思うんです。",
   "zh": "就这样在礼拜堂里\n说誓词，\n也不奇怪。",
   "narrator_zh": "透明神乐"
  },
  {
   "location": "50/TALK",
   "narrator": "透明つばめ",
   "text": "ちょ、神楽ちゃん！？\nわたしたち女の子同士\nなんだけど…。",
   "zh": "等、神乐！？\n我们可都是\n女孩子……",
   "narrator_zh": "透明燕"
  },
  {
   "location": "51/TALK",
   "narrator": "透明神楽",
   "text": "式を挙げるだけなら、\n問題ありません。",
   "zh": "只是办个仪式的话，\n没问题。",
   "narrator_zh": "透明神乐"
  },
  {
   "location": "52/TALK",
   "narrator": "透明神楽",
   "text": "本当に婚姻届けを出す\nわけじゃないんですから、\n気にすることないですよ。",
   "zh": "又不是真的去交\n结婚申请，\n不用在意。",
   "narrator_zh": "透明神乐"
  },
  {
   "location": "56/TALK",
   "narrator": "透明つばめ",
   "text": "気にするよぉ！",
   "zh": "我会在意的！",
   "narrator_zh": "透明燕"
  },
  {
   "location": "57/TALK",
   "narrator": "透明神楽",
   "text": "ふふっ…、\nそういうところも、\n可愛いところですよ。",
   "zh": "呵呵……\n这一点，\n也很可爱。",
   "narrator_zh": "透明神乐"
  },
  {
   "location": "58/TALK",
   "narrator": "透明つばめ",
   "text": "え？",
   "zh": "诶？",
   "narrator_zh": "透明燕"
  },
  {
   "location": "59/TALK",
   "narrator": "透明神楽",
   "text": "すぐ冗談を本気にしちゃう\nところですよ。",
   "zh": "一下子就把玩笑\n当真的地方。",
   "narrator_zh": "透明神乐"
  },
  {
   "location": "60/TALK",
   "narrator": "透明つばめ",
   "text": "も、もぉ！\nまたわたしのこと\nからかって…。",
   "zh": "真、真是的！\n又拿我\n开玩笑……",
   "narrator_zh": "透明燕"
  },
  {
   "location": "62/TALK",
   "narrator": "透明神楽",
   "text": "ふふっ、ごめんなさい。",
   "zh": "呵呵，对不起。",
   "narrator_zh": "透明神乐"
  },
  {
   "location": "63/TALK",
   "narrator": "透明つばめ",
   "text": "もぉ…。",
   "zh": "真是的……",
   "narrator_zh": "透明燕"
  },
  {
   "location": "65/TALK",
   "narrator": "透明つばめ",
   "text": "…そうだ。\n$handle$さんにも\n見てもらおっと。",
   "zh": "……对了。\n也让$handle$\n看看吧。",
   "narrator_zh": "透明燕"
  },
  {
   "location": "68/TALK",
   "narrator": "つばめ",
   "text": "$handle$さーんヽ(*´∀｀)ノ",
   "zh": "$handle$——ヽ(*´∀｀)ノ",
   "narrator_zh": "燕"
  },
  {
   "location": "69/TALK",
   "narrator": "つばめ",
   "text": "見てみて",
   "zh": "快看",
   "narrator_zh": "燕"
  },
  {
   "location": "70/TALK",
   "narrator": "つばめ",
   "text": "どぅかな？(´ω｀*)",
   "zh": "怎么样？(´ω｀*)",
   "narrator_zh": "燕"
  },
  {
   "location": "71/TALK",
   "narrator": "つばめ",
   "text": "ゥェディングドレス",
   "zh": "婚纱",
   "narrator_zh": "燕"
  },
  {
   "location": "72/TALK",
   "narrator": "つばめ",
   "text": "初めて着てみたのヾ(｡>﹏<｡)ﾉﾞ",
   "zh": "我第一次穿上了ヾ(｡>﹏<｡)ﾉﾞ",
   "narrator_zh": "燕"
  },
  {
   "location": "73/SEL",
