  },
  {
   "location": "105/ACT",
   "narrator": "",
   "text": "着たいとは思ってたの？",
   "zh": "你以前就想穿吗？",
   "narrator_zh": ""
  },
  {
   "location": "106/TALK",
   "narrator": "つばめ",
   "text": "よくわからなぃ(´･ω･｀) ",
   "zh": "我也不太清楚(´･ω･｀)",
   "narrator_zh": "燕"
  },
  {
   "location": "107/TALK",
   "narrator": "つばめ",
   "text": "結婚とか",
