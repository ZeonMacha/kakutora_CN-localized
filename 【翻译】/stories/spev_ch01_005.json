  },
  {
   "location": "90/TALK",
   "narrator": "つばめ",
   "text": "冗談だよね？(･Д･｀)",
   "zh": "是开玩笑吧？(･Д･｀)",
   "narrator_zh": "燕"
  },
  {
   "location": "91/TALK",
   "narrator": "つばめ",
   "text": "もし本気だったら",
   "zh": "要是认真的",
   "narrator_zh": "燕"
  },
  {
   "location": "93/TALK",
   "narrator": "つばめ",
   "text": "そぅだったら",
   "zh": "要是那样的话",
   "narrator_zh": "燕"
  },
  {
   "location": "95/TALK",
   "narrator": "つばめ",
   "text": "嬉しぃな",
   "zh": "我会很高兴呀",
   "narrator_zh": "燕"
  },
  {
   "location": "98/TALK",
   "narrator": "つばめ",
   "text": "でも",
   "zh": "不过",
   "narrator_zh": "燕"
  },
  {
   "location": "99/TALK",
   "narrator": "つばめ",
   "text": "不思議な気分(´・ω・`) ",
   "zh": "感觉好奇怪(´・ω・`)",
   "narrator_zh": "燕"
  },
  {
   "location": "101/TALK",
   "narrator": "つばめ",
   "text": "結婚するわけじゃなぃのに",
   "zh": "明明不是要结婚",
   "narrator_zh": "燕"
  },
  {
   "location": "102/TALK",
   "narrator": "つばめ",
   "text": "ゥェディングドレス着てるなんて(*´﹃｀*)",
   "zh": "却穿着婚纱(*´﹃｀*)",
   "narrator_zh": "燕"
  },
  {
   "location": "103/SEL",
   "narrator": "（選択肢）",
   "text": "着たいとは思ってたの？",
