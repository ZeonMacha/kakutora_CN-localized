{
    "dir": "chap05/daydra/dd_ch01_05_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "5153",
        "cid": "tsubame",
        "title": "Extra003 プレミアムストーリー",
        "sub_title": "みやび襲来",
        "title_zh": "Extra003 额外剧情",
        "sub_title_zh": "雅来袭"
    },
    "entry": [
        {
            "location": "327/SCENARIO",
            "narrator": "",
            "text": "みやび襲来",
            "zh": "雅来袭",
            "narrator_zh": ""
        },
        {
            "location": "346/TALK",
            "narrator": "みやび",
            "text": "つばめちゃん。",
            "zh": "燕。",
            "narrator_zh": "雅"
        },
        {
            "location": "349/TALK",
            "narrator": "つばめ",
            "text": "あれ？　みやびさん。\nどうかしたんですか？",
            "zh": "咦？　雅。\n怎么了吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "350/TALK",
            "narrator": "みやび",
            "text": "一緒にお昼ご飯を\n食べようかと思うて\n来たがよ。",
            "zh": "想来一起\n吃午饭，\n所以过来了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "351/TALK",
            "narrator": "みやび",
            "text": "けんど、先約がある\nいうなら、別の日に\n出直すちや。",
            "zh": "不过，要是已经有约，\n我就改天\n再来咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "353/TALK",
            "narrator": "つばめ",
            "text": "う～ん、\nどうしよう…。",
            "zh": "唔……\n怎么办……。",
            "narrator_zh": "燕"
        },
        {
            "location": "354/TALK",
            "narrator": "つばめ",
            "text": "今日は、真幌さんと\n一緒に食べる約束\nしてるんだけど…。",
            "zh": "今天，已经和真幌\n约好一起吃了，\n就是……。",
            "narrator_zh": "燕"
        },
        {
            "location": "355/SEL",
            "narrator": "",
            "text": "連絡すれば平気だよ",
            "zh": "联系一下就没事哦",
            "narrator_zh": ""
        },
        {
            "location": "356/SEL",
            "narrator": "",
            "text": "約束守らないとダメだよ",
            "zh": "约定不能不守哦",
            "narrator_zh": ""
        },
        {
            "location": "357/SEL",
            "narrator": "",
            "text": "夕飯を一緒に食べるのは？",
            "zh": "晚饭一起吃怎么样？",
            "narrator_zh": ""
        },
        {
            "location": "359/TALK",
            "narrator": "つばめ",
            "text": "学校のこととか、\n色々話してくれる、\nって言ってたし。",
            "zh": "学校的事之类，\n会跟我讲很多，\n她这么说的。",
            "narrator_zh": "燕"
        },
        {
            "location": "360/TALK",
            "narrator": "つばめ",
            "text": "…あ、でも、他の人と\n約束が入った時は――",
            "zh": "……啊，不过，要是和别人\n有了约定——",
            "narrator_zh": "燕"
        },
        {
            "location": "361/TALK",
            "narrator": "つばめ",
            "text": "そっちを優先しろ、\nって言われたんだ。",
            "zh": "那边优先，\n她是这么说的。",
            "narrator_zh": "燕"
        },
        {
            "location": "362/TALK",
            "narrator": "つばめ",
            "text": "でも、ギリギリで\n断るのは悪いかな？",
            "zh": "可是，临到头\n再拒绝，不好吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "366/TALK",
            "narrator": "つばめ",
            "text": "う～ん…。",
            "zh": "唔……。",
            "narrator_zh": "燕"
        },
        {
            "location": "368/TALK",
            "narrator": "みやび",
            "text": "…えいがよ。\n別の日に出直すき。",
            "zh": "……要得咯。\n我改天再来啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "370/TALK",
            "narrator": "つばめ",
            "text": "え？",
            "zh": "诶？",
            "narrator_zh": "燕"
        },
        {
            "location": "371/TALK",
            "narrator": "みやび",
            "text": "先約が入ってるみたい\nやき、そっちを優先\nせんといかんちや。",
            "zh": "看起来已经有约啵，\n那边得优先，\n没办法咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "373/TALK",
            "narrator": "つばめ",
            "text": "す、すみません…。\nわざわざ来てもらった\nのに…。",
            "zh": "对、对不起……\n特意过来了，\n结果……。",
            "narrator_zh": "燕"
        },
        {
            "location": "375/TALK",
            "narrator": "みやび",
            "text": "気にせんでえいよ。\n近いうちに、\nまた誘いにくるぞね。",
            "zh": "别在意，要得。\n过不久，\n我再来约你啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "377/TALK",
            "narrator": "つばめ",
            "text": "はい！\n楽しみにしてますね。",
            "zh": "好！\n我等着哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "379/ACT",
            "narrator": "",
            "text": "連絡すれば平気だよ",
            "zh": "联系一下就没事哦",
            "narrator_zh": ""
        },
        {
            "location": "400/TALK",
            "narrator": "つばめ",
            "text": "そうかな？",
            "zh": "是吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "402/SEL",
            "narrator": "",
            "text": "友達と食べてる方が、真幌も安心する",
            "zh": "和朋友一起吃的话，真幌也放心",
            "narrator_zh": ""
        },
        {
            "location": "403/ACT",
            "narrator": "",
            "text": "友達と食べてる方が、真幌も安心する",
            "zh": "和朋友一起吃的话，真幌也放心",
            "narrator_zh": ""
        },
        {
            "location": "405/TALK",
            "narrator": "つばめ",
            "text": "友達っていうか",
            "zh": "与其说朋友",
            "narrator_zh": "燕"
        },
        {
            "location": "406/TALK",
            "narrator": "つばめ",
            "text": "先輩なんだけど",
            "zh": "是前辈",
            "narrator_zh": "燕"
        },
        {
            "location": "408/TALK",
            "narrator": "つばめ",
            "text": "でも",
            "zh": "不过",
            "narrator_zh": "燕"
        },
        {
            "location": "409/TALK",
            "narrator": "つばめ",
            "text": "今日はみやびさんと食べようかな？",
            "zh": "今天和雅一起吃吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "410/TALK",
            "narrator": "つばめ",
            "text": "せっかく",
            "zh": "难得",
            "narrator_zh": "燕"
        },
        {
            "location": "411/TALK",
            "narrator": "つばめ",
            "text": "誘いに来てくれたんだし",
            "zh": "特意来约我了",
            "narrator_zh": "燕"
        },
        {
            "location": "422/TALK",
            "narrator": "つばめ",
            "text": "真幌さんには、\nメールで謝って\nおこう。",
            "zh": "跟真幌，\n我发邮件道个歉\n吧。",
            "narrator_zh": "燕"
        },
        {
            "location": "424/TALK",
            "narrator": "つばめ",
            "text": "わかりました。\n一緒に食べましょう。",
            "zh": "好的。\n一起吃吧。",
            "narrator_zh": "燕"
        },
        {
            "location": "425/TALK",
            "narrator": "みやび",
            "text": "いや、先約があるなら\n無理せんでえいがよ。",
            "zh": "不，有先约的话\n别勉强，要得咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "426/TALK",
            "narrator": "つばめ",
            "text": "平気です。",
            "zh": "没关系。",
            "narrator_zh": "燕"
        },
        {
            "location": "429/TALK",
            "narrator": "つばめ",
            "text": "それに、みやびさんと\n二人で食べるの初めて\nだから――",
            "zh": "而且，和雅\n两个人吃是第一次，\n所以——",
            "narrator_zh": "燕"
        },
        {
            "location": "431/TALK",
            "narrator": "つばめ",
            "text": "わたしも楽しみです。",
            "zh": "我也很期待。",
            "narrator_zh": "燕"
        },
        {
            "location": "432/TALK",
            "narrator": "みやび",
            "text": "うちを喜ばしても、\n温泉旅行くらいしか\n出せんちや？",
            "zh": "就算想让我高兴，\n也就出得起温泉旅行\n咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "433/TALK",
            "narrator": "みやび",
            "text": "当然、費用は全額\nつばめちゃん負担\nやけんど。",
            "zh": "当然，费用全额\n燕来出，\n不过。",
            "narrator_zh": "雅"
        },
        {
            "location": "435/TALK",
            "narrator": "つばめ",
            "text": "そうだと思いました。",
            "zh": "我就知道。",
            "narrator_zh": "燕"
        },
        {
            "location": "436/TALK",
            "narrator": "つばめ",
            "text": "ご飯、天気が良いし\n外で食べませんか？",
            "zh": "午饭，天气好，\n在外面吃吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "438/TALK",
            "narrator": "みやび",
            "text": "えいよ。\nそれじゃあ、すっと\n移動するぞね。",
            "zh": "要得。\n那就，麻利\n出发啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "439/ACT",
            "narrator": "",
            "text": "約束守らないとダメだよ",
            "zh": "约定不能不守哦",
            "narrator_zh": ""
        },
        {
            "location": "460/TALK",
            "narrator": "つばめ",
            "text": "そうだよね",
            "zh": "也是哦",
            "narrator_zh": "燕"
        },
        {
            "location": "461/TALK",
            "narrator": "つばめ",
            "text": "最初に約束したのは",
            "zh": "最先约好的是",
            "narrator_zh": "燕"
        },
        {
            "location": "462/TALK",
            "narrator": "つばめ",
            "text": "真幌さんだし",
            "zh": "真幌嘛",
            "narrator_zh": "燕"
        },
        {
            "location": "475/TALK",
            "narrator": "つばめ",
            "text": "あの…お昼は\n真幌さんと食べる\n約束しちゃってて…。",
            "zh": "那个……午饭\n已经和真幌\n约好了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "476/TALK",
            "narrator": "みやび",
            "text": "そうやったか…。",
            "zh": "是这样啊……。",
            "narrator_zh": "雅"
        },
        {
            "location": "478/TALK",
            "narrator": "つばめ",
            "text": "ごめんなさい。\nせっかく誘いに来て\nもらったのに…。",
            "zh": "对不起。\n难得你来约，\n结果……。",
            "narrator_zh": "燕"
        },
        {
            "location": "479/TALK",
            "narrator": "みやび",
            "text": "えいよ。\nうちも急に思い立って\n来たんやし。",
            "zh": "要得。\n我也是一时兴起\n才来的。",
            "narrator_zh": "雅"
        },
        {
            "location": "480/TALK",
            "narrator": "みやび",
            "text": "日を改めるき、\n今度は一緒に\n食べるちや。",
            "zh": "改天再约啵，\n下次一起\n吃咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "483/TALK",
            "narrator": "つばめ",
            "text": "はい。\n楽しみにしてます！",
            "zh": "好。\n我等着！",
            "narrator_zh": "燕"
        },
        {
            "location": "484/ACT",
            "narrator": "",
            "text": "夕飯を一緒に食べるのは？",
            "zh": "晚饭一起吃怎么样？",
            "narrator_zh": ""
        },
        {
            "location": "514/TALK",
            "narrator": "つばめ",
            "text": "みやびさんって、凄い料理上手だもんね",
            "zh": "雅做饭特别厉害嘛",
            "narrator_zh": "燕"
        },
        {
            "location": "515/TALK",
            "narrator": "つばめ",
            "text": "ちょっと言ってみるよ",
            "zh": "我去说说看",
            "narrator_zh": "燕"
        },
        {
            "location": "528/TALK",
            "narrator": "つばめ",
            "text": "あの、ごめんなさい。\n真幌さんと\n約束してるんです。",
            "zh": "那个，对不起。\n已经和真幌\n约好了。",
            "narrator_zh": "燕"
        },
        {
            "location": "529/TALK",
            "narrator": "みやび",
            "text": "そうやったか。\nじゃあ、日を改めて\n誘いに――",
            "zh": "是这样啊。\n那，我改天\n再来约——",
            "narrator_zh": "雅"
        },
        {
            "location": "530/TALK",
            "narrator": "つばめ",
            "text": "それで、もしよければ\n夕飯を一緒に食べま\nせんか？",
            "zh": "所以，如果可以的话\n晚饭要不要一起\n吃？",
            "narrator_zh": "燕"
        },
        {
            "location": "532/TALK",
            "narrator": "みやび",
            "text": "構わんけんど、\nつばめちゃんが\n作ってくれるが？",
            "zh": "倒不碍事，不过，\n是燕来\n做吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "533/TALK",
            "narrator": "つばめ",
            "text": "あ、え、えっと――",
            "zh": "啊，诶，那个——",
            "narrator_zh": "燕"
        },
        {
            "location": "535/TALK",
            "narrator": "つばめ",
            "text": "め、目玉焼きとかなら、\nどうにか！",
            "zh": "煎、煎蛋之类的话，\n我还能对付！",
            "narrator_zh": "燕"
        },
        {
            "location": "536/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "537/TALK",
            "narrator": "つばめ",
            "text": "だ、ダメですよね…。",
            "zh": "不、不行吧……。",
            "narrator_zh": "燕"
        },
        {
            "location": "538/TALK",
            "narrator": "みやび",
            "text": "まあ、誰にでも\n得意不得意はあるき、\n気にせんでえいよ。",
            "zh": "算了，谁都有\n擅长不擅长啵，\n别在意，要得。",
            "narrator_zh": "雅"
        },
        {
            "location": "539/TALK",
            "narrator": "みやび",
            "text": "代わりに、うちが\n腕を振るえばえい\nだけやき。",
            "zh": "换成我来露一手\n就要得，\n就这样啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "540/TALK",
            "narrator": "つばめ",
            "text": "いいんですか？",
            "zh": "可以吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "541/TALK",
            "narrator": "みやび",
            "text": "和食限定やけんど、\nそれでえいならな。",
            "zh": "只做日式，不过。\n那样要得就行。",
            "narrator_zh": "雅"
        },
        {
            "location": "543/TALK",
            "narrator": "つばめ",
            "text": "やったぁ！\n楽しみにしてます！",
            "zh": "太好啦！\n我等着！",
            "narrator_zh": "燕"
        },
        {
            "location": "544/TALK",
            "narrator": "みやび",
            "text": "…そんな素直に\n期待されたら――",
            "zh": "……这么坦率地\n被你期待——",
            "narrator_zh": "雅"
        },
        {
            "location": "546/TALK",
            "narrator": "みやび",
            "text": "簡単な物オンリーに\nできんやないか…。",
            "zh": "就不能只做\n简单的了……。",
            "narrator_zh": "雅"
        },
        {
            "location": "335/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>5月5日　11:45 AM</color>\nドーム戦の２日後、神楽坂トライナリー劇場にて。",
            "zh": "<color=green>5月5日　11:45 AM</color>\n穹顶之战两天后，在神乐坂三重奏剧场。",
            "narrator_zh": "Dialog_EventData"
        },
        {
            "location": "490/DIALOG",
            "narrator": "Dialog_GETGokigen",
            "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！",
            "zh": "心情点数\n<size=40><color=red><b>300pt.</b></color></size>\n增加了！",
            "narrator_zh": "Dialog_GETGokigen"
        }
    ]
}
