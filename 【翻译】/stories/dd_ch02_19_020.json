{
    "dir": "chap19/daydra/dd_ch02_19_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "19256",
        "cid": "ayami",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "メルティー",
        "title_zh": "Extra006 额外剧情",
        "sub_title_zh": "融化"
    },
    "entry": [
        {
            "location": "350/SCENARIO",
            "narrator": "",
            "text": "メルティー",
            "zh": "融化",
            "narrator_zh": ""
        },
        {
            "location": "376/TALK",
            "narrator": "神楽",
            "text": "それにしても――",
            "zh": "话说回来——",
            "narrator_zh": "神乐"
        },
        {
            "location": "378/TALK",
            "narrator": "神楽",
            "text": "まさか、合宿中に\nフェノメノンが出るとは\n思いませんでした。",
            "zh": "真没想到，集训期间\n居然会出现\nPhenoMENON。",
            "narrator_zh": "神乐"
        },
        {
            "location": "379/TALK",
            "narrator": "神楽",
            "text": "しかも、海もない\n都内のど真ん中で、\n水着で戦うとか――",
            "zh": "而且，还是在连海都没有的\n东京都正中心，\n穿着泳装战斗什么的——",
            "narrator_zh": "神乐"
        },
        {
            "location": "380/TALK",
            "narrator": "神楽",
            "text": "人権侵害で訴えたい\n気分ですよ。",
            "zh": "简直想告他们\n侵犯人权了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "382/TALK",
            "narrator": "ガブリエラ",
            "text": "文句ばっか言ってんじゃ\nないわよ。",
            "zh": "少在那里净说\n些抱怨话了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "384/TALK",
            "narrator": "ガブリエラ",
            "text": "水着くらい、大して\n騒ぐことじゃないわ。",
            "zh": "区区泳装而已，算不上\n什么值得大惊小怪的事。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "386/TALK",
            "narrator": "アーヤ",
            "text": "そんなことはないと\n思うけど…。",
            "zh": "我觉得倒也不是\n那样吧……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "388/TALK",
            "narrator": "神楽",
            "text": "そうですよ。",
            "zh": "就是啊。",
            "narrator_zh": "神乐"
        },
        {
            "location": "389/TALK",
            "narrator": "神楽",
            "text": "私、ガブちゃんが\n一番嫌がってたのかと\n思ったのに…。",
            "zh": "我还以为，加布才是最\n讨厌穿泳装的那个\n呢……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "391/TALK",
            "narrator": "ガブリエラ",
            "text": "もちろん嫌では\nあるけど…。",
            "zh": "我当然也是\n讨厌的啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "394/TALK",
            "narrator": "真幌",
            "text": "ミルクティーメルティと\nアップルティーメルティに\n比べれば――",
            "zh": "跟奶茶融化还有\n苹果茶融化\n比起来——",
            "narrator_zh": "真幌"
        },
        {
            "location": "395/TALK",
            "narrator": "真幌",
            "text": "水着くらい、騒ぐような\nことではないのだろう。",
            "zh": "区区泳装，大概确实算不上\n什么值得大惊小怪的事吧。",
            "narrator_zh": "真幌"
        },
        {
            "location": "399/TALK",
            "narrator": "アーヤ",
            "text": "ちょ、館長！？",
            "zh": "等、馆长！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "401/TALK",
            "narrator": "雛",
            "text": "えっ、なんですかそれ？",
            "zh": "哎，那是什么呀？",
            "narrator_zh": "雏"
        },
        {
            "location": "403/TALK",
            "narrator": "真幌",
            "text": "そうか、おまえ達は\n知らないんだったな。",
            "zh": "对了，你们几个\n还不知道这事啊。",
            "narrator_zh": "真幌"
        },
        {
            "location": "404/TALK",
            "narrator": "真幌",
            "text": "ちょっと前に出た\nフェノメノンの中で\nあったことなんだが――",
            "zh": "那是前阵子出现的\nPhenoMENON里面\n发生的事——",
            "narrator_zh": "真幌"
        },
        {
            "location": "405/TALK",
            "narrator": "真幌",
            "text": "あの時は、アーヤと\nギャヴィが色んな意味で\n大活躍してな。",
            "zh": "那时候，绫水和\n加维在各种意义上都\n大显身手了呢。",
            "narrator_zh": "真幌"
        },
        {
            "location": "406/TALK",
            "narrator": "真幌",
            "text": "歌も踊りも、\n中々上手かったし。",
            "zh": "唱歌和跳舞，\n也都挺像模像样的。",
            "narrator_zh": "真幌"
        },
        {
            "location": "410/TALK",
            "narrator": "ガブリエラ",
            "text": "まほ！\nその話はしないで！",
            "zh": "真幌！\n别提那件事了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "412/TALK",
            "narrator": "アーヤ",
            "text": "そうですよ！\nっていうか、ちょっと\n飲み過ぎですよ！？",
            "zh": "就是说啊！\n话说回来，您未免也\n喝太多了吧！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "413/TALK",
            "narrator": "真幌",
            "text": "いいじゃないか。\nこいつらだって、\nおまえ達のために――",
            "zh": "有什么关系嘛。\n这几个家伙，不也是\n为了你们——",
            "narrator_zh": "真幌"
        },
        {
            "location": "414/TALK",
            "narrator": "真幌",
            "text": "日頃頑張ってくれている\n仲間じゃないか。",
            "zh": "平日里一直努力的\n同伴嘛。",
            "narrator_zh": "真幌"
        },
        {
            "location": "415/TALK",
            "narrator": "キリト",
            "text": "さすが東雲教官！\nそれで、何があったん\nすか？",
            "zh": "不愧是东云教官！\n那，当时到底发生\n什么了？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "416/TALK",
            "narrator": "真幌",
            "text": "順番に説明しよう。\nそもそもの発端は――",
            "zh": "让我按顺序解释吧。\n事情的起因原本是——",
            "narrator_zh": "真幌"
        },
        {
            "location": "417/TALK",
            "narrator": "ガブリエラ",
            "text": "だ、ダメだって！\n話さないでってば！",
            "zh": "不、不行！\n说了叫你别讲了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "419/TALK",
            "narrator": "真幌",
            "text": "ははは、恥ずかしがるな。\nあの時のギャヴィは\n最高に可愛かったぞ？",
            "zh": "哈哈哈，别害羞嘛。\n那时候的加维可是\n可爱到极点了哦？",
            "narrator_zh": "真幌"
        },
        {
            "location": "422/TALK",
            "narrator": "アーヤ",
            "text": "…完全に酔っぱらってる\nみたいね。",
            "zh": "……看来是完全\n喝醉了呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "424/TALK",
            "narrator": "ガブリエラ",
            "text": "ああもう、言わないでって\n言ってるのにー！",
            "zh": "啊真是的，都说了\n不要讲出来了嘛——！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "439/TALK",
            "narrator": "アーヤ",
            "text": "どうしよう、館長凄い酔っぱらってるみたい",
            "zh": "怎么办，馆长好像喝得醉醺醺的",
            "narrator_zh": "绫水"
        },
        {
            "location": "441/SEL",
            "narrator": "",
            "text": "いつものことじゃん",
            "zh": "这不是常有的事吗",
            "narrator_zh": ""
        },
        {
            "location": "442/ACT",
            "narrator": "",
            "text": "いつものことじゃん",
            "zh": "这不是常有的事吗",
            "narrator_zh": ""
        },
        {
            "location": "444/TALK",
            "narrator": "アーヤ",
            "text": "私とギャヴィがメルティになった時の話をしようとしてるの！",
            "zh": "她正打算把我和加维变成融化那时候的事说出来！",
            "narrator_zh": "绫水"
        },
        {
            "location": "445/TALK",
            "narrator": "アーヤ",
            "text": "何言っても聞かなそうだし、何かいい方法ない？",
            "zh": "看样子说什么她都听不进去，有什么好办法吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "447/SEL",
            "narrator": "",
            "text": "歌ってやりなよ",
            "zh": "你给她唱一首呗",
            "narrator_zh": ""
        },
        {
            "location": "448/SEL",
            "narrator": "",
            "text": "あの時のアーヤ、可愛かった",
            "zh": "那时候的绫水，挺可爱的",
            "narrator_zh": ""
        },
        {
            "location": "449/ACT",
            "narrator": "",
            "text": "歌ってやりなよ",
            "zh": "你给她唱一首呗",
            "narrator_zh": ""
        },
        {
            "location": "452/TALK",
            "narrator": "アーヤ",
            "text": "本気！？",
            "zh": "认真的！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "453/TALK",
            "narrator": "アーヤ",
            "text": "っていうか、それで止まるの？",
            "zh": "话说回来，那样就能阻止她吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "465/TALK",
            "narrator": "アーヤ",
            "text": "でも、説得しても今の\n館長は止められそうに\nないし…。",
            "zh": "可是，光靠劝说好像也\n拦不住现在的\n馆长……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "466/TALK",
            "narrator": "真幌",
            "text": "とまあ、フェノメノンの\n発生した理由はそういう\nことなんだが――",
            "zh": "总之呢，PhenoMENON\n发生的理由就是这么\n一回事——",
            "narrator_zh": "真幌"
        },
        {
            "location": "467/TALK",
            "narrator": "真幌",
            "text": "それを止めるために、\nアーヤとガブリエラが――",
            "zh": "为了阻止它，\n绫水和加布里埃拉就——",
            "narrator_zh": "真幌"
        },
        {
            "location": "469/TALK",
            "narrator": "アーヤ",
            "text": "…甘酸っぱい。",
            "zh": "……酸酸甜甜。",
            "narrator_zh": "绫水"
        },
        {
            "location": "471/TALK",
            "narrator": "真幌",
            "text": "んっ？",
            "zh": "嗯？",
            "narrator_zh": "真幌"
        },
        {
            "location": "473/TALK",
            "narrator": "アーヤ",
            "text": "…甘酸っぱい\n恋の妖精あっぷる♪",
            "zh": "……酸酸甜甜的\n恋爱妖精小苹果♪",
            "narrator_zh": "绫水"
        },
        {
            "location": "475/TALK",
            "narrator": "雛",
            "text": "えっ！？",
            "zh": "哎！？",
            "narrator_zh": "雏"
        },
        {
            "location": "477/TALK",
            "narrator": "キリト",
            "text": "はぁ！？",
            "zh": "哈啊！？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "479/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょ、アーヤ！？",
            "zh": "等、绫水！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "480/TALK",
            "narrator": "アーヤ",
            "text": "はっぴぃな夢見る\n乙女みるく♪",
            "zh": "做着Happy美梦的\n少女牛奶♪",
            "narrator_zh": "绫水"
        },
        {
            "location": "481/TALK",
            "narrator": "キリト",
            "text": "えっ…は、はっぴぃ？\n夢見る乙女？",
            "zh": "哎……Ha、Happy？\n做着美梦的少女？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "482/TALK",
            "narrator": "雛",
            "text": "…あ、綾水様？\nその…急にどうしたん\nですか？",
            "zh": "……绫、绫水大人？\n那个……突然怎么\n了？",
            "narrator_zh": "雏"
        },
        {
            "location": "484/TALK",
            "narrator": "アーヤ",
            "text": "みんなが、メルティに\n凄く興味がありそう\nだったから――",
            "zh": "看大家好像都对\n融化特别感兴趣\n的样子——",
            "narrator_zh": "绫水"
        },
        {
            "location": "486/TALK",
            "narrator": "アーヤ",
            "text": "それなら、実際に\n聞かせた方がいいかな、\nって思ったのよ。",
            "zh": "我想着既然这样，不如\n直接唱给大家听\n比较好呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "488/TALK",
            "narrator": "雛",
            "text": "…な、なんか綾水様、\n目が笑ってないような？",
            "zh": "……总、总觉得绫水大人，\n眼神好像没有在笑呢？",
            "narrator_zh": "雏"
        },
        {
            "location": "490/TALK",
            "narrator": "アーヤ",
            "text": "今歌ったのは出だしの\n部分だけど――",
            "zh": "刚才唱的还只是\n开头部分而已——",
            "narrator_zh": "绫水"
        },
        {
            "location": "492/TALK",
            "narrator": "アーヤ",
            "text": "最後まで聞きたい、\nって人…いる？",
            "zh": "有没有人……\n想听到最后的？",
            "narrator_zh": "绫水"
        },
        {
            "location": "493/TALK",
            "narrator": "キリト",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "494/TALK",
            "narrator": "雛",
            "text": "超聞いてみたい！！",
            "zh": "超想听听看！！",
            "narrator_zh": "雏"
        },
        {
            "location": "495/TALK",
            "narrator": "雛",
            "text": "けど、なーんか後が\n怖そうだし、黙っといた\n方がいいかもー…。",
            "zh": "不过，总觉得之后会\n很可怕的样子，还是\n闭嘴比较妙哦——……。",
            "narrator_zh": "雏"
        },
        {
            "location": "497/TALK",
            "narrator": "アーヤ",
            "text": "…うん、よろしい。\n館長も、それでいい\nですか？",
            "zh": "……嗯，很好。\n馆长，您也没意见\n了吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "499/TALK",
            "narrator": "真幌",
            "text": "やれやれ…話せるような\n空気じゃなくなったしな。",
            "zh": "哎呀呀……搞得都没法\n继续往下讲的气氛了呢。",
            "narrator_zh": "真幌"
        },
        {
            "location": "501/TALK",
            "narrator": "キリト",
            "text": "…聞いちゃいけない話\nだったみてぇだな？",
            "zh": "……看来是不该\n打听的事啊？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "503/TALK",
            "narrator": "雛",
            "text": "出だしの部分だけでも\nあの破壊力だからねー。\nなんかわかるかも…。",
            "zh": "光开头部分就已经\n有那种破坏力了嘛——。\n总觉得能明白……。",
            "narrator_zh": "雏"
        },
        {
            "location": "504/TALK",
            "narrator": "神楽",
            "text": "あの時は凄く可愛いな、\nって思いましたけど――",
            "zh": "我当时是觉得\n非常可爱啦——",
            "narrator_zh": "神乐"
        },
        {
            "location": "505/TALK",
            "narrator": "神楽",
            "text": "さすがに、衣装も何も\nない状態で歌われる\nのは――",
            "zh": "不过，在连服装什么都\n没有的状态下被这样\n唱出来——",
            "narrator_zh": "神乐"
        },
        {
            "location": "507/TALK",
            "narrator": "神楽",
            "text": "アーヤさんのイメージが\n崩壊しそうで、ちょっと\n怖いです…。",
            "zh": "感觉绫水的形象都要\n崩塌了，有点\n吓人呢……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "508/TALK",
            "narrator": "ガブリエラ",
            "text": "…助かったわ。\nあたし達の恥が広まるのを\n阻止できて…。",
            "zh": "……得救了。\n总算阻止了我们的黑历史\n传出去……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "509/TALK",
            "narrator": "ガブリエラ",
            "text": "けど、どうして未だに\nあの歌詞覚えてるの？",
            "zh": "不过，为什么你到现在\n还记得那段歌词啊？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "511/TALK",
            "narrator": "アーヤ",
            "text": "さ、最初の部分だけ、\n偶々覚えてただけよ。",
            "zh": "我、我只是碰巧只记得\n最开头那一段而已啦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "512/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "514/TALK",
            "narrator": "アーヤ",
            "text": "ほ、本当よ！\nほら、もうこの話は\nおしまいにしましょ！",
            "zh": "真、真的啦！\n好了，这个话题就到此\n为止吧！",
            "narrator_zh": "绫水"
        },
        {
            "location": "531/ACT",
            "narrator": "",
            "text": "あの時のアーヤ、可愛かった",
            "zh": "那时候的绫水，挺可爱的",
            "narrator_zh": ""
        },
        {
            "location": "533/TALK",
            "narrator": "アーヤ",
            "text": "まあ、ここだけの話",
            "zh": "不过，仅限你我之间的话",
            "narrator_zh": "绫水"
        },
        {
            "location": "534/TALK",
            "narrator": "アーヤ",
            "text": "嫌ではなかったわ、メルティ…(*´ω｀*)",
            "zh": "其实我也并不讨厌哦，融化……(*´ω｀*)",
            "narrator_zh": "绫水"
        },
        {
            "location": "535/TALK",
            "narrator": "アーヤ",
            "text": "でも、私は可愛くない",
            "zh": "不过，我不可爱",
            "narrator_zh": "绫水"
        },
        {
            "location": "536/TALK",
            "narrator": "アーヤ",
            "text": "私の年齢であんな格好したら、イタいだけよ",
            "zh": "以我这把年纪穿成那样，只会显得很惨不忍睹啦",
            "narrator_zh": "绫水"
        },
        {
            "location": "548/TALK",
            "narrator": "キリト",
            "text": "えっ…な、なんですか、\nそれって？",
            "zh": "哎……那、那是什么，\n怎么回事？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "550/TALK",
            "narrator": "真幌",
            "text": "だから、ミルクティー\nメルティとアップルティー\nメルティってのは――",
            "zh": "所以说啊，奶茶\n融化和苹果茶\n融化呢——",
            "narrator_zh": "真幌"
        },
        {
            "location": "551/TALK",
            "narrator": "真幌",
            "text": "フリフリの衣装着て、\n魔法のステッキ持った\n魔法少女なんだ。",
            "zh": "就是穿着荷叶边服装、\n拿着魔法手杖的\n魔法少女。",
            "narrator_zh": "真幌"
        },
        {
            "location": "552/TALK",
            "narrator": "真幌",
            "text": "それを、アーヤと\nガブリエラがやることに\nなってな…。",
            "zh": "当时就决定由绫水和\n加布里埃拉来\n扮演了呢……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "553/TALK",
            "narrator": "キリト",
            "text": "ま、魔法少女って…\nうわぁ、マジかよ？",
            "zh": "魔、魔法少女……\n哇，真的假的啊？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "555/TALK",
            "narrator": "アーヤ",
            "text": "いけない！\nいつの間にか話が\n進んでる！？",
            "zh": "不好！\n不知不觉间话题又\n继续下去了！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "557/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょっとまほ！\nそれ以上話したら\n本当許さないわよ！？",
            "zh": "喂真幌！\n你要是再敢往下说\n我真不原谅你了哦！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "558/TALK",
            "narrator": "真幌",
            "text": "しかも、ただの魔法少女\nではなくてな。",
            "zh": "而且，还不是普通的\n魔法少女哦。",
            "narrator_zh": "真幌"
        },
        {
            "location": "559/TALK",
            "narrator": "真幌",
            "text": "歌って踊れる魔法少女、\nという設定だったから――",
            "zh": "因为设定上是能唱能跳的\n魔法少女——",
            "narrator_zh": "真幌"
        },
        {
            "location": "560/TALK",
            "narrator": "真幌",
            "text": "アーヤ達が身体を張って、\n頑張ってくれたんだ。",
            "zh": "绫水她们豁出去了，\n非常努力呢。",
            "narrator_zh": "真幌"
        },
        {
            "location": "562/TALK",
            "narrator": "雛",
            "text": "え？　綾水様が？\nフリフリの衣装で、\n歌って踊る…？",
            "zh": "哎？绫水大人吗？\n穿着荷叶边服装，\n又唱又跳……？",
            "narrator_zh": "雏"
        },
        {
            "location": "563/TALK",
            "narrator": "雛",
            "text": "…ど、どういうこと？\nあたし、耳おかしく\nなっちゃったかなー？",
            "zh": "……这、这是怎么回事？\n我的耳朵是不是\n出毛病了呀——？",
            "narrator_zh": "雏"
        },
        {
            "location": "564/TALK",
            "narrator": "キリト",
            "text": "俺も…なんか、\n変なことを聞いた\nようなするんだが…。",
            "zh": "我也……总觉得，\n好像听到了什么\n奇怪的话……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "567/TALK",
            "narrator": "アーヤ",
            "text": "も、もうそれくらいで\n十分です！",
            "zh": "已、已经够了，\n说到这就行了！",
            "narrator_zh": "绫水"
        },
        {
            "location": "568/TALK",
            "narrator": "アーヤ",
            "text": "それ以上話す必要は\nないですよ！",
            "zh": "没必要再继续\n往下说了吧！",
            "narrator_zh": "绫水"
        },
        {
            "location": "570/TALK",
            "narrator": "真幌",
            "text": "あのな…おまえ達に\nとっては恥ずかしいこと\nかもしれんが――",
            "zh": "我说啊……对你们来说\n或许是件羞耻的事，\n不过——",
            "narrator_zh": "真幌"
        },
        {
            "location": "571/TALK",
            "narrator": "真幌",
            "text": "フェノメノンでの戦闘で\nある以上、あれだって\n立派な武勇伝だぞ？",
            "zh": "既然是在PhenoMENON里的\n战斗，那也算是一段\n了不起的英勇事迹哦？",
            "narrator_zh": "真幌"
        },
        {
            "location": "572/TALK",
            "narrator": "真幌",
            "text": "恥ずかしがらないで、\n胸を張れ！",
            "zh": "别害羞，\n挺起胸膛来！",
            "narrator_zh": "真幌"
        },
        {
            "location": "573/TALK",
            "narrator": "ガブリエラ",
            "text": "あれを恥ずかしいと\n思えなくなったら\nおしまいだから！",
            "zh": "要是连那种事都觉得\n不羞耻了，那才真是\n彻底完蛋了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "575/TALK",
            "narrator": "真幌",
            "text": "さっきも言ったが、\nギャヴィは本当に\n可愛かったぞ？",
            "zh": "刚才也说过了，\n加维当时真的\n非常可爱哦？",
            "narrator_zh": "真幌"
        },
        {
            "location": "577/TALK",
            "narrator": "真幌",
            "text": "ただ、アーヤは年齢的に\n色々ヤバくて――",
            "zh": "只是，绫水在年龄上\n各方面都有点悬——",
            "narrator_zh": "真幌"
        },
        {
            "location": "578/TALK",
            "narrator": "真幌",
            "text": "正直、見ていて\nイタイタしくて\n堪らなかったが…。",
            "zh": "老实说，看着\n实在尴尬得让人\n受不了……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "579/TALK",
            "narrator": "神楽",
            "text": "何言ってるんですか！？\nそれが良いんじゃない\nですか！！",
            "zh": "你在说什么呀！？\n那样不是挺好的\n吗！！",
            "narrator_zh": "神乐"
        },
        {
            "location": "580/TALK",
            "narrator": "神楽",
            "text": "年齢不相応の服を着て\n恥じらう可愛さが――",
            "zh": "穿着与年龄不相称的衣服\n害羞的可爱之处——",
            "narrator_zh": "神乐"
        },
        {
            "location": "581/TALK",
            "narrator": "神楽",
            "text": "文句なしのパーフェクト\nでしたよ！",
            "zh": "简直是无可挑剔的\n完美啊！",
            "narrator_zh": "神乐"
        },
        {
            "location": "583/TALK",
            "narrator": "雛",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雏"
        },
        {
            "location": "585/TALK",
            "narrator": "雛",
            "text": "…わかるかも！",
            "zh": "……我好像能懂！",
            "narrator_zh": "雏"
        },
        {
            "location": "587/TALK",
            "narrator": "神楽",
            "text": "さすがひなこさんです！",
            "zh": "不愧是雏子！",
            "narrator_zh": "神乐"
        },
        {
            "location": "590/TALK",
            "narrator": "アーヤ",
            "text": "…か、館長？\nそろそろ酔いを醒ました\n方が良いですよ？",
            "zh": "……馆、馆长？\n差不多该醒醒酒\n了吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "592/TALK",
            "narrator": "ガブリエラ",
            "text": "うん…ちょっとハメを\n外し過ぎてるわ…。",
            "zh": "嗯……稍微有点\n得意忘形过头了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "594/TALK",
            "narrator": "真幌",
            "text": "わかったわかった…。",
            "zh": "知道了知道了……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "596/TALK",
            "narrator": "真幌",
            "text": "じゃあ、最後に二人が\nノリノリで歌った歌を\n聞かせて――",
            "zh": "那么，最后就来听听\n两人兴致勃勃唱的那首歌\n吧——",
            "narrator_zh": "真幌"
        },
        {
            "location": "598/TALK",
            "narrator": "アーヤ",
            "text": "館長！",
            "zh": "馆长！",
            "narrator_zh": "绫水"
        },
        {
            "location": "600/TALK",
            "narrator": "ガブリエラ",
            "text": "頭冷やせ！",
            "zh": "冷静一下头脑！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "604/TALK",
            "narrator": "真幌",
            "text": "んぁ？　わぷっ！！",
            "zh": "嗯啊？哇噗！！",
            "narrator_zh": "真幌"
        },
        {
            "location": "607/TALK",
            "narrator": "雛",
            "text": "うわっ！？\nし、東雲教官！？",
            "zh": "哇！？\n东、东云教官！？",
            "narrator_zh": "雏"
        },
        {
            "location": "609/TALK",
            "narrator": "神楽",
            "text": "…コップの水、\n掛けられちゃいましたね。",
            "zh": "……被泼了一杯水\n呢。",
            "narrator_zh": "神乐"
        },
        {
            "location": "611/TALK",
            "narrator": "神楽",
            "text": "まあ、調子に乗り過ぎた\n真幌さんの、自業自得\nですけど。",
            "zh": "不过，这也是太忘乎所以的\n真幌咎由自取\n就是了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "612/TALK",
            "narrator": "アーヤ",
            "text": "…さてと、他に話の\n続きを聞きたい、って\n人はいるかしら？",
            "zh": "……那么，还有谁\n想听故事的后续\n吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "613/TALK",
            "narrator": "ガブリエラ",
            "text": "いたら挙手しなさい。\n頭から水ぶっかけて\nやるから。",
            "zh": "有的话就举手。\n我直接从头顶给你\n浇一盆水下去。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "616/TALK",
            "narrator": "キリト",
            "text": "い、いや、いいっす…。",
            "zh": "不、不用了……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "618/TALK",
            "narrator": "雛",
            "text": "まあ、もう十分過ぎる\nくらい聞いちゃった\n気もするんだけど…。",
            "zh": "嘛，总觉得也已经\n听得够多了就是了\n……。",
            "narrator_zh": "雏"
        },
        {
            "location": "375/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>8月23日　 0:08 PM</color>\n合宿中、みやびの実家にて",
            "zh": "<color=green>8月23日　 0:08 PM</color>\n集训中，在雅的老家",
            "narrator_zh": "Dialog_EventData"
        },
        {
            "location": "525/DIALOG",
            "narrator": "Dialog_GEThimegoto_ch02",
            "text": "【みんなでうた】",
            "zh": "【大家一起唱】",
            "narrator_zh": "Dialog_GEThimegoto_ch02"
        }
    ]
}
