{
    "dir": "chap15/daydra/dd_ch01_15_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "15105",
        "cid": "tsubame",
        "title": "005 メインストーリー",
        "sub_title": "薄い本の森＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "同人志之森＜后篇＞"
    },
    "entry": [
        {
            "location": "520/TALK",
            "narrator": "つばめ",
            "text": "うーん…。",
            "zh": "嗯……。",
            "narrator_zh": "燕"
        },
        {
            "location": "522/TALK",
            "narrator": "つばめ",
            "text": "…や、やっぱり、\nちょっとだけ\n読んでみようかなぁ？",
            "zh": "……还、还是，\n就一点点\n读读看呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "523/TALK",
            "narrator": "つばめ",
            "text": "そ、そーっと…。",
            "zh": "悄、悄悄地……。",
            "narrator_zh": "燕"
        },
        {
            "location": "524/TALK",
            "narrator": "つばめ",
            "text": "だ、ダメ！\nやっぱり恥ずかしい！",
            "zh": "不、不行！\n果然还是害羞！",
            "narrator_zh": "燕"
        },
        {
            "location": "525/TALK",
            "narrator": "つばめ",
            "text": "…でも、やっぱり\nちょっとくらいは\n見てみないと。",
            "zh": "……可是，果然\n多少还是得\n看一看。",
            "narrator_zh": "燕"
        },
        {
            "location": "526/TALK",
            "narrator": "つばめ",
            "text": "せっかく卯月さんが\n連れてきてくれたん\nだし…。",
            "zh": "难得卯月\n带我来了\n……。",
            "narrator_zh": "燕"
        },
        {
            "location": "527/TALK",
            "narrator": "つばめ",
            "text": "…この辺のサンプル、\n見てみようかな。",
            "zh": "……这边的试读，\n看看吧。",
            "narrator_zh": "燕"
        },
        {
            "location": "533/TALK",
            "narrator": "神楽",
            "text": "…ふふっ、つばめさん、\nあんなに慌てて…。",
            "zh": "……呵呵，燕，\n慌成那样……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "535/TALK",
            "narrator": "つばめ",
            "text": "…あれ？\nこれどうなってるん\nだろう…。",
            "zh": "……咦？\n这是怎么\n回事……。",
            "narrator_zh": "燕"
        },
        {
            "location": "536/TALK",
            "narrator": "つばめ",
            "text": "えっと、この人の身体が\nこうくっついていて、\nそれで…。",
            "zh": "那个，这个人的身体\n这样贴在一起，\n然后……。",
            "narrator_zh": "燕"
        },
        {
            "location": "538/TALK",
            "narrator": "つばめ",
            "text": "っ！？",
            "zh": "唔！？",
            "narrator_zh": "燕"
        },
        {
            "location": "540/TALK",
            "narrator": "つばめ",
            "text": "…わ、わたしは何も\n見てません。",
            "zh": "……我、我什么\n都没看。",
            "narrator_zh": "燕"
        },
        {
            "location": "541/TALK",
            "narrator": "つばめ",
            "text": "こ、こっちのは…。",
            "zh": "这、这边这个……。",
            "narrator_zh": "燕"
        },
        {
            "location": "542/TALK",
            "narrator": "つばめ",
            "text": "…えぇー。\nこれ、何なんだろ？",
            "zh": "……诶——。\n这是什么呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "543/TALK",
            "narrator": "つばめ",
            "text": "この人、何でこんな\n格好してるのに\n恥ずかしくないの？",
            "zh": "这个人，穿成这样\n为什么\n不害羞？",
            "narrator_zh": "燕"
        },
        {
            "location": "544/TALK",
            "narrator": "つばめ",
            "text": "…よくわからない\n漫画だなぁ。",
            "zh": "……完全看不懂的\n漫画呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "545/TALK",
            "narrator": "つばめ",
            "text": "こっちのは…。",
            "zh": "这边这个……。",
            "narrator_zh": "燕"
        },
        {
            "location": "546/TALK",
            "narrator": "つばめ",
            "text": "…露骨過ぎて、\nタイトルだけで\nわかっちゃうよ…。",
            "zh": "……露骨过头了，\n光看标题\n就明白了呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "548/TALK",
            "narrator": "神楽",
            "text": "…くすくす。",
            "zh": "……嘿嘿。",
            "narrator_zh": "神乐"
        },
        {
            "location": "550/TALK",
            "narrator": "つばめ",
            "text": "じゃ、じゃあ、\nこっちは…。",
            "zh": "那、那么，\n这边这个……。",
            "narrator_zh": "燕"
        },
        {
            "location": "553/TALK",
            "narrator": "神楽",
            "text": "つーばーめーさんっ！",
            "zh": "燕————！",
            "narrator_zh": "神乐"
        },
        {
            "location": "556/TALK",
            "narrator": "つばめ",
            "text": "ひゃぁぁぁっ！！\nう、卯月さん！？",
            "zh": "呀啊啊啊！！\n卯、卯月！？",
            "narrator_zh": "燕"
        },
        {
            "location": "557/TALK",
            "narrator": "神楽",
            "text": "ふふっ、一人にされて\n戸惑ってるつばめさん、\n可愛かったですよ。",
            "zh": "呵呵，被一个人留下、\n不知所措的燕，\n很可爱哦。",
            "narrator_zh": "神乐"
        },
        {
            "location": "559/TALK",
            "narrator": "つばめ",
            "text": "もしかして、わたしに\n見せたい本がある、って\nいうのは…。",
            "zh": "难道，有想给我\n看的书，\n是……。",
            "narrator_zh": "燕"
        },
        {
            "location": "560/TALK",
            "narrator": "神楽",
            "text": "もちろん、つばめさんの\n可愛い姿を見るための\n冗談です。",
            "zh": "当然是为了看\n燕可爱的样子\n开的玩笑。",
            "narrator_zh": "神乐"
        },
        {
            "location": "561/TALK",
            "narrator": "つばめ",
            "text": "それなら、\nもう少し早く戻ってきて\nほしかったよ…。",
            "zh": "那样的话，\n希望你再早一点\n回来呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "562/TALK",
            "narrator": "神楽",
            "text": "ごめんなさい。\nでも、なんだか真剣に\n本を見てましたよね？",
            "zh": "对不起。\n不过，你看得\n挺认真的吧？",
            "narrator_zh": "神乐"
        },
        {
            "location": "563/TALK",
            "narrator": "神楽",
            "text": "だから邪魔をしたら\nいけないと思って、\n少し待ってたんです。",
            "zh": "所以觉得打扰了\n不好，\n就等了一会儿。",
            "narrator_zh": "神乐"
        },
        {
            "location": "566/TALK",
            "narrator": "つばめ",
            "text": "みみみ、見てないよ！\nわたし、ちょっとしか\n見てないから…。",
            "zh": "没没没，没看呀！\n我只看了\n一点点……。",
            "narrator_zh": "燕"
        },
        {
            "location": "567/TALK",
            "narrator": "神楽",
            "text": "ちょっとは\n見てくれたんですね！",
            "zh": "还是看了\n一点点呀！",
            "narrator_zh": "神乐"
        },
        {
            "location": "568/TALK",
            "narrator": "神楽",
            "text": "つばめさんが、薄い本の\n沼に興味を持ってくれて\n嬉しいですっ！",
            "zh": "燕对同人志\n这个坑有了兴趣，\n我好高兴！",
            "narrator_zh": "神乐"
        },
        {
            "location": "572/TALK",
            "narrator": "つばめ",
            "text": "ご、誤解だよぉ！",
            "zh": "是、是误会呀！",
            "narrator_zh": "燕"
        },
        {
            "location": "573/TALK",
            "narrator": "つばめ",
            "text": "興味があったわけ\nじゃなくて、\nえっと――",
            "zh": "不是因为\n有兴趣，\n那个——",
            "narrator_zh": "燕"
        },
        {
            "location": "575/TALK",
            "narrator": "つばめ",
            "text": "あ、絵だよ、絵！\n絵が可愛いなぁ、って\n思っただけだから…。",
            "zh": "啊，是画，画！\n只是觉得画\n很可爱……。",
            "narrator_zh": "燕"
        },
        {
            "location": "577/TALK",
            "narrator": "神楽",
            "text": "もぅ、そんなに\n恥ずかしがらなくても\nいいんですよ？",
            "zh": "真是的，不用\n那么害羞\n哦？",
            "narrator_zh": "神乐"
        },
        {
            "location": "578/TALK",
            "narrator": "つばめ",
            "text": "本当なのにぃ…。",
            "zh": "是真的呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "579/TALK",
            "narrator": "つばめ",
            "text": "…そうだ、じゃあ――",
            "zh": "……对了，那么——",
            "narrator_zh": "燕"
        },
        {
            "location": "591/TALK",
            "narrator": "つばめ",
            "text": "$handle$さーん",
            "zh": "$handle$——",
            "narrator_zh": "燕"
        },
        {
            "location": "592/TALK",
            "narrator": "つばめ",
            "text": "卯月さんが",
            "zh": "卯月",
            "narrator_zh": "燕"
        },
        {
            "location": "594/TALK",
            "narrator": "つばめ",
            "text": "信じてくれなぃの(´つω・｀)ｼｭﾝ",
            "zh": "不相信我呀(´つω・｀)ｼｭﾝ",
            "narrator_zh": "燕"
        },
        {
            "location": "595/TALK",
            "narrator": "つばめ",
            "text": "$handle$さんなら",
            "zh": "要是$handle$",
            "narrator_zh": "燕"
        },
        {
            "location": "596/TALK",
            "narrator": "つばめ",
            "text": "わかるよね？(*´ω｀*)",
            "zh": "明白的吧？(*´ω｀*)",
            "narrator_zh": "燕"
        },
        {
            "location": "597/TALK",
            "narrator": "つばめ",
            "text": "わたしが",
            "zh": "我",
            "narrator_zh": "燕"
        },
        {
            "location": "598/TALK",
            "narrator": "つばめ",
            "text": "こぅぃぅのに",
            "zh": "对这种东西",
            "narrator_zh": "燕"
        },
        {
            "location": "599/TALK",
            "narrator": "つばめ",
            "text": "興味ぁったわけじゃなぃって(/ω＼)",
            "zh": "并没有兴趣呀(/ω＼)",
            "narrator_zh": "燕"
        },
        {
            "location": "601/SEL",
            "narrator": "",
            "text": "信じるよ",
            "zh": "我相信",
            "narrator_zh": ""
        },
        {
            "location": "602/SEL",
            "narrator": "",
            "text": "興味あるんでしょ？",
            "zh": "有兴趣吧？",
            "narrator_zh": ""
        },
        {
            "location": "603/SEL",
            "narrator": "",
            "text": "つばめはムッツリだなぁ",
            "zh": "燕真闷骚呀",
            "narrator_zh": ""
        },
        {
            "location": "604/ACT",
            "narrator": "",
            "text": "信じるよ",
            "zh": "我相信",
            "narrator_zh": ""
        },
        {
            "location": "605/TALK",
            "narrator": "つばめ",
            "text": "ぁりがとぅ(●´ω｀●)",
            "zh": "谢谢呀(●´ω｀●)",
            "narrator_zh": "燕"
        },
        {
            "location": "606/TALK",
            "narrator": "つばめ",
            "text": "わたしも",
            "zh": "我也",
            "narrator_zh": "燕"
        },
        {
            "location": "607/TALK",
            "narrator": "つばめ",
            "text": "$handle$さんなら",
            "zh": "要是$handle$",
            "narrator_zh": "燕"
        },
        {
            "location": "608/TALK",
            "narrator": "つばめ",
            "text": "わかってくれるって",
            "zh": "会明白的",
            "narrator_zh": "燕"
        },
        {
            "location": "609/TALK",
            "narrator": "つばめ",
            "text": "信じてたよ(●´ω｀●)ゞｴﾍﾍ",
            "zh": "我相信的呀(●´ω｀●)ゞｴﾍﾍ",
            "narrator_zh": "燕"
        },
        {
            "location": "622/TALK",
            "narrator": "つばめ",
            "text": "ほら、見たでしょ？\n$handle$も\n信じてくれるって。",
            "zh": "你看，看到了吧？\n$handle$也\n相信我呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "623/TALK",
            "narrator": "つばめ",
            "text": "だから、卯月さんにも\n信じてもらいたいな。",
            "zh": "所以，也想让卯月\n相信我呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "625/TALK",
            "narrator": "神楽",
            "text": "つばめさん…、\nこんなの信じたら\nダメですよ。",
            "zh": "燕……，\n这种话不能信\n哦。",
            "narrator_zh": "神乐"
        },
        {
            "location": "626/TALK",
            "narrator": "神楽",
            "text": "つばめさんの味方を\nして、好感度を上げ\nたいだけですから。",
            "zh": "只是站在燕这边，\n想把好感度\n刷上去而已。",
            "narrator_zh": "神乐"
        },
        {
            "location": "628/TALK",
            "narrator": "つばめ",
            "text": "えぇっ！？\nそんなことないと\n思うけど…。",
            "zh": "诶诶！？\n我觉得不会\n是那样……。",
            "narrator_zh": "燕"
        },
        {
            "location": "630/TALK",
            "narrator": "神楽",
            "text": "あるんです。",
            "zh": "会的。",
            "narrator_zh": "神乐"
        },
        {
            "location": "631/TALK",
            "narrator": "神楽",
            "text": "つばめさんは\n初心だから\nわからないんです。",
            "zh": "燕\n太纯情了，\n所以不明白。",
            "narrator_zh": "神乐"
        },
        {
            "location": "632/TALK",
            "narrator": "つばめ",
            "text": "そ、そうなのかなぁ？",
            "zh": "是、是这样吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "634/TALK",
            "narrator": "神楽",
            "text": "そうですよ。\nだからそういうことを\n勉強するために――",
            "zh": "是呀。\n所以为了学\n这种事——",
            "narrator_zh": "神乐"
        },
        {
            "location": "635/TALK",
            "narrator": "神楽",
            "text": "急いで次のお店に\n行きましょう。",
            "zh": "赶紧去\n下一家店吧。",
            "narrator_zh": "神乐"
        },
        {
            "location": "637/TALK",
            "narrator": "つばめ",
            "text": "あ、う、卯月さん。\n引っ張らないで―！",
            "zh": "啊、卯、卯月。\n别拉我——！",
            "narrator_zh": "燕"
        },
        {
            "location": "638/ACT",
            "narrator": "",
            "text": "興味あるんでしょ？",
            "zh": "有兴趣吧？",
            "narrator_zh": ""
        },
        {
            "location": "639/TALK",
            "narrator": "つばめ",
            "text": "なぃよ(ﾟ△ﾟ;ﾉ)ﾉ",
            "zh": "没有呀(ﾟ△ﾟ;ﾉ)ﾉ",
            "narrator_zh": "燕"
        },
        {
            "location": "640/TALK",
            "narrator": "つばめ",
            "text": "本当",
            "zh": "真的",
            "narrator_zh": "燕"
        },
        {
            "location": "641/TALK",
            "narrator": "つばめ",
            "text": "興味ぁって",
            "zh": "有兴趣什么的",
            "narrator_zh": "燕"
        },
        {
            "location": "642/TALK",
            "narrator": "つばめ",
            "text": "見てたわけじゃなぃのに",
            "zh": "我又不是因为那个才看的",
            "narrator_zh": "燕"
        },
        {
            "location": "643/TALK",
            "narrator": "つばめ",
            "text": "(´つω・｀)ｼｭﾝ",
            "zh": "(´つω・｀)ｼｭﾝ",
            "narrator_zh": "燕"
        },
        {
            "location": "655/TALK",
            "narrator": "つばめ",
            "text": "はぁ…。",
            "zh": "唉……。",
            "narrator_zh": "燕"
        },
        {
            "location": "657/TALK",
            "narrator": "神楽",
            "text": "疑われてましたね？",
            "zh": "被怀疑了吧？",
            "narrator_zh": "神乐"
        },
        {
            "location": "659/TALK",
            "narrator": "つばめ",
            "text": "で、でも、本当に\n誤解だからね！？",
            "zh": "可、可是，真的是\n误会呀！？",
            "narrator_zh": "燕"
        },
        {
            "location": "660/TALK",
            "narrator": "つばめ",
            "text": "$handle$も、\nきっと冗談で\n言ったんだと思うし。",
            "zh": "$handle$也，\n一定是开玩笑\n说的。",
            "narrator_zh": "燕"
        },
        {
            "location": "661/TALK",
            "narrator": "神楽",
            "text": "まあまあ、\n落ち着いてください。",
            "zh": "好了好了，\n冷静一下。",
            "narrator_zh": "神乐"
        },
        {
            "location": "662/TALK",
            "narrator": "神楽",
            "text": "私は信じますから。",
            "zh": "我相信的。",
            "narrator_zh": "神乐"
        },
        {
            "location": "663/TALK",
            "narrator": "つばめ",
            "text": "…本当？",
            "zh": "……真的？",
            "narrator_zh": "燕"
        },
        {
            "location": "665/TALK",
            "narrator": "神楽",
            "text": "もちろんです。\nだってつばめさん――",
            "zh": "当然。\n因为燕——",
            "narrator_zh": "神乐"
        },
        {
            "location": "666/TALK",
            "narrator": "神楽",
            "text": "今も、本を手に持った\nままですし…。",
            "zh": "现在手里\n还拿着书……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "669/TALK",
            "narrator": "つばめ",
            "text": "え？　あっ！",
            "zh": "诶？　啊！",
            "narrator_zh": "燕"
        },
        {
            "location": "671/TALK",
            "narrator": "神楽",
            "text": "ふふっ…どうです？\n薄い本の魅力が\nわかってきましたか？",
            "zh": "呵呵……怎么样？\n同人志的魅力，\n明白了吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "673/TALK",
            "narrator": "つばめ",
            "text": "もーっ！！",
            "zh": "真是的！！",
            "narrator_zh": "燕"
        },
        {
            "location": "674/TALK",
            "narrator": "つばめ",
            "text": "こんなエッチな本\nばっかりなお店は\n来ちゃだめだよ！",
            "zh": "这种净是色色的书\n的店，\n不能来呀！",
            "narrator_zh": "燕"
        },
        {
            "location": "675/ACT",
            "narrator": "",
            "text": "つばめはムッツリだなぁ",
            "zh": "燕真闷骚呀",
            "narrator_zh": ""
        },
        {
            "location": "676/TALK",
            "narrator": "つばめ",
            "text": "ムッツリ？",
            "zh": "闷骚？",
            "narrator_zh": "燕"
        },
        {
            "location": "677/TALK",
            "narrator": "つばめ",
            "text": "ムッツリって何？(*´﹃｀*)",
            "zh": "闷骚是什么？(*´﹃｀*)",
            "narrator_zh": "燕"
        },
        {
            "location": "679/SEL",
            "narrator": "",
            "text": "神楽に聞いた方がいいかも",
            "zh": "也许问神乐比较好",
            "narrator_zh": ""
        },
        {
            "location": "680/ACT",
            "narrator": "",
            "text": "神楽に聞いた方がいいかも",
            "zh": "也许问神乐比较好",
            "narrator_zh": ""
        },
        {
            "location": "682/TALK",
            "narrator": "つばめ",
            "text": "卯月さんに？(･Д･｀)",
            "zh": "问卯月？(･Д･｀)",
            "narrator_zh": "燕"
        },
        {
            "location": "683/TALK",
            "narrator": "つばめ",
            "text": "よくわからなぃけど",
            "zh": "虽然不太明白",
            "narrator_zh": "燕"
        },
        {
            "location": "684/TALK",
            "narrator": "つばめ",
            "text": "聞ぃてみるね(´∀｀*)",
            "zh": "我去问问看哦(´∀｀*)",
            "narrator_zh": "燕"
        },
        {
            "location": "688/TALK",
            "narrator": "つばめ",
            "text": "…ねえ、卯月さん。\nこんなこと言われたん\nだけど。",
            "zh": "……喂，卯月。\n被人这么说了\n……。",
            "narrator_zh": "燕"
        },
        {
            "location": "690/TALK",
            "narrator": "神楽",
            "text": "えっと…。",
            "zh": "那个……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "691/TALK",
            "narrator": "神楽",
            "text": "ぶふっ！！",
            "zh": "噗！！",
            "narrator_zh": "神乐"
        },
        {
            "location": "692/TALK",
            "narrator": "つばめ",
            "text": "卯月さん？",
            "zh": "卯月？",
            "narrator_zh": "燕"
        },
        {
            "location": "696/TALK",
            "narrator": "神楽",
            "text": "ふ、ふふっ…さあ？\nわ、私には、その…、\n何が何だか…クスッ。",
            "zh": "呵呵……这个嘛？\n我、我这，那个……，\n完全搞不清楚……噗。",
            "narrator_zh": "神乐"
        },
        {
            "location": "697/TALK",
            "narrator": "つばめ",
            "text": "本当かなぁ？\n何だか、知ってるのに\n隠されてるような…。",
            "zh": "真的吗？\n总觉得你明明知道，\n却在瞒着……。",
            "narrator_zh": "燕"
        },
        {
            "location": "699/TALK",
            "narrator": "神楽",
            "text": "ほ、本当ですよ。\n私を信じてください！",
            "zh": "是、是真的。\n请相信我！",
            "narrator_zh": "神乐"
        },
        {
            "location": "702/TALK",
            "narrator": "神楽",
            "text": "でも、もし本当に\nムッツリだと\nしても――",
            "zh": "不过，就算真的是\n闷骚\n——",
            "narrator_zh": "神乐"
        },
        {
            "location": "703/TALK",
            "narrator": "神楽",
            "text": "つばめさんは、\n変わらず可愛い\n女の子です。",
            "zh": "燕，\n还是可爱的\n女孩子。",
            "narrator_zh": "神乐"
        },
        {
            "location": "705/TALK",
            "narrator": "神楽",
            "text": "だから、ムッツリでも\n何も問題なですよ！",
            "zh": "所以，就算闷骚\n也完全没问题哦！",
            "narrator_zh": "神乐"
        },
        {
            "location": "707/TALK",
            "narrator": "つばめ",
            "text": "えっと、問題とか\nそういうこと言ってる\nわけじゃなくて…。",
            "zh": "那个，我不是在说\n有没有问题\n……。",
            "narrator_zh": "燕"
        },
        {
            "location": "709/TALK",
            "narrator": "つばめ",
            "text": "っていうか、\n絶対ムッツリの意味\n知ってるよね？",
            "zh": "话说，\n你绝对知道闷骚\n是什么意思吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "712/TALK",
            "narrator": "神楽",
            "text": "…いいえー、\n知りませんよー。",
            "zh": "……不——是，\n我不知道——。",
            "narrator_zh": "神乐"
        },
        {
            "location": "714/TALK",
            "narrator": "つばめ",
            "text": "…きっと、いい意味の\n言葉じゃないんだろう\nなぁ…。",
            "zh": "……大概，不是什么\n好词\n吧……。",
            "narrator_zh": "燕"
        },
        {
            "location": "726/DIALOG",
            "narrator": "Dialog_chapter_ch01",
            "text": "【12 ピクシャル】",
            "zh": "【12 像素】",
            "narrator_zh": "Dialog_chapter_ch01"
        }
    ]
}
