{
    "dir": "chap06/daydra/dd_ch01_06_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "6152",
        "cid": "tsubame",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "化粧品",
        "title_zh": "Extra002 额外剧情",
        "sub_title_zh": "化妆品"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "化粧品",
            "zh": "化妆品",
            "narrator_zh": ""
        },
        {
            "location": "24/TALK",
            "narrator": "つばめ",
            "text": "…真幌さん、\nまだかなぁ？",
            "zh": "……真幌，\n还没来吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "25/TALK",
            "narrator": "つばめ",
            "text": "入隊手続きの用紙を\n持ってくるだけの\nはずなのに――",
            "zh": "只是去拿入队手续的\n表格而已，\n应该很快——",
            "narrator_zh": "燕"
        },
        {
            "location": "26/TALK",
            "narrator": "つばめ",
            "text": "もう十分も経ってる。\nもしかして、\n見つからないのかな？",
            "zh": "都过了十分钟了。\n难道，\n找不到吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "27/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "29/TALK",
            "narrator": "つばめ",
            "text": "っていうかこの部屋、\nどうしてこんなに\n散らかってるの！？",
            "zh": "话说这房间，\n为什么这么\n乱！？",
            "narrator_zh": "燕"
        },
        {
            "location": "30/TALK",
            "narrator": "つばめ",
            "text": "片づけよう、って\n思う人はいないの\nかなぁ？",
            "zh": "就没有人想着\n收拾一下\n吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "31/TALK",
            "narrator": "つばめ",
            "text": "…なんか、ちょっと\nストレス溜まるかも。",
            "zh": "……总觉得，有点\n压力要积起来了。",
            "narrator_zh": "燕"
        },
        {
            "location": "32/TALK",
            "narrator": "つばめ",
            "text": "はぁ…雑誌も読んだら\n読みっぱなしだし…。",
            "zh": "哈啊……杂志看完\n也不放回去……。",
            "narrator_zh": "燕"
        },
        {
            "location": "34/TALK",
            "narrator": "つばめ",
            "text": "ファッション雑誌\nみたいだけど…、\nアーヤさんのかな？",
            "zh": "像是时尚杂志，\n不过……\n是绫水的吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "35/TALK",
            "narrator": "つばめ",
            "text": "綺麗な人がいっぱい。\n大人の女の人って\nかっこいいなぁ…。",
            "zh": "好多人真漂亮。\n成年女性\n好帅呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "37/TALK",
            "narrator": "つばめ",
            "text": "…わたしも、いい加減\nお化粧くらいできる\nようになりたいな。",
            "zh": "……我也想，差不多\n至少会化个妆\n了。",
            "narrator_zh": "燕"
        },
        {
            "location": "49/TALK",
            "narrator": "つばめ",
            "text": "ねえねえ、相談があるの",
            "zh": "喂喂，有件事想商量",
            "narrator_zh": "燕"
        },
        {
            "location": "51/SEL",
            "narrator": "",
            "text": "なに？",
            "zh": "什么？",
            "narrator_zh": ""
        },
        {
            "location": "52/ACT",
            "narrator": "",
            "text": "なに？",
            "zh": "什么？",
            "narrator_zh": ""
        },
        {
            "location": "54/TALK",
            "narrator": "つばめ",
            "text": "お化粧の練習をしたいんだけど",
            "zh": "我想练习化妆",
            "narrator_zh": "燕"
        },
        {
            "location": "55/TALK",
            "narrator": "つばめ",
            "text": "誰に聞くのがいいと思う？",
            "zh": "你觉得问谁比较好？",
            "narrator_zh": "燕"
        },
        {
            "location": "58/TALK",
            "narrator": "つばめ",
            "text": "やっぱり、アーヤさんがいいかな？",
            "zh": "果然，问绫水比较好吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "59/TALK",
            "narrator": "つばめ",
            "text": "この本も",
            "zh": "这本书也是",
            "narrator_zh": "燕"
        },
        {
            "location": "60/TALK",
            "narrator": "つばめ",
            "text": "アーヤさんのみたいだし",
            "zh": "好像是绫水的",
            "narrator_zh": "燕"
        },
        {
            "location": "62/SEL",
            "narrator": "",
            "text": "アーヤに聞こう",
            "zh": "去问绫水吧",
            "narrator_zh": ""
        },
        {
            "location": "63/SEL",
            "narrator": "",
            "text": "真幌に聞こう",
            "zh": "去问真幌吧",
            "narrator_zh": ""
        },
        {
            "location": "64/ACT",
            "narrator": "",
            "text": "アーヤに聞こう",
            "zh": "去问绫水吧",
            "narrator_zh": ""
        },
        {
            "location": "65/TALK",
            "narrator": "つばめ",
            "text": "うん",
            "zh": "嗯",
            "narrator_zh": "燕"
        },
        {
            "location": "66/TALK",
            "narrator": "つばめ",
            "text": "それじゃあ、ちょっと聞いてくるね",
            "zh": "那我去问一下哦",
            "narrator_zh": "燕"
        },
        {
            "location": "90/TALK",
            "narrator": "アーヤ",
            "text": "そっか。\n逢瀬さんは化粧した\nことなかったんだ？",
            "zh": "这样啊。\n逢濑没化过\n妆吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "92/TALK",
            "narrator": "つばめ",
            "text": "はい。だからアーヤ\nさんに教えてもらえ\nたら嬉しいな、って…。",
            "zh": "是的。所以要是绫水\n肯教我的话，\n我会很高兴……。",
            "narrator_zh": "燕"
        },
        {
            "location": "93/TALK",
            "narrator": "アーヤ",
            "text": "私でよければ\n力になるわ。",
            "zh": "我来的话，\n可以帮忙。",
            "narrator_zh": "绫水"
        },
        {
            "location": "94/TALK",
            "narrator": "つばめ",
            "text": "よ、よろしく\nお願いします！",
            "zh": "请、请多\n关照！",
            "narrator_zh": "燕"
        },
        {
            "location": "95/TALK",
            "narrator": "アーヤ",
            "text": "でも、私も得意って\nわけじゃないから――",
            "zh": "不过，我也不是\n特别擅长——",
            "narrator_zh": "绫水"
        },
        {
            "location": "96/TALK",
            "narrator": "アーヤ",
            "text": "プロなのは\n期待しないでね。",
            "zh": "别指望我是\n专业的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "99/TALK",
            "narrator": "つばめ",
            "text": "わたしも、あんまり\n凄いのはちょっと…。",
            "zh": "我也是，太厉害的\n有点……。",
            "narrator_zh": "燕"
        },
        {
            "location": "103/TALK",
            "narrator": "つばめ",
            "text": "初心者向けので\nお願いしたいんです。",
            "zh": "想请你教\n适合初学者的。",
            "narrator_zh": "燕"
        },
        {
            "location": "105/TALK",
            "narrator": "アーヤ",
            "text": "だとすると…下地と\nコンシーラ、ファンデー\nションくらいかしら？",
            "zh": "那样的话……妆前和\n遮瑕、粉底\n左右吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "107/TALK",
            "narrator": "アーヤ",
            "text": "目は必要ないかな？\nパッチリした\n可愛い目をしてるし。",
            "zh": "眼睛就不用了吧？\n眼睛又大又\n可爱。",
            "narrator_zh": "绫水"
        },
        {
            "location": "108/TALK",
            "narrator": "つばめ",
            "text": "そ、そうですか？",
            "zh": "是、是吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "109/TALK",
            "narrator": "アーヤ",
            "text": "そうよ。\nちょっと羨ましいわ。",
            "zh": "是啊。\n有点羡慕。",
            "narrator_zh": "绫水"
        },
        {
            "location": "112/TALK",
            "narrator": "つばめ",
            "text": "えへへ…。",
            "zh": "诶嘿嘿……。",
            "narrator_zh": "燕"
        },
        {
            "location": "113/TALK",
            "narrator": "アーヤ",
            "text": "でも、眉毛は少し\n整えた方がいいかも。",
            "zh": "不过，眉毛稍微\n修一下也许更好。",
            "narrator_zh": "绫水"
        },
        {
            "location": "115/TALK",
            "narrator": "つばめ",
            "text": "眉毛って、\n自分で整えたり\nするものなんですか？",
            "zh": "眉毛，\n是要自己修的\n吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "116/TALK",
            "narrator": "アーヤ",
            "text": "そりゃそうよ。\n髪の毛と同じで\n伸びるんだから。",
            "zh": "当然啊。\n和头发一样，\n会长长的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "117/TALK",
            "narrator": "つばめ",
            "text": "あ、そっか。\n気付きませんでした。",
            "zh": "啊，这样啊。\n我没注意到。",
            "narrator_zh": "燕"
        },
        {
            "location": "118/TALK",
            "narrator": "アーヤ",
            "text": "ふふっ…\n本当に初心者なのね。",
            "zh": "呵呵……\n真是初学者。",
            "narrator_zh": "绫水"
        },
        {
            "location": "119/TALK",
            "narrator": "アーヤ",
            "text": "それじゃ、最初から\n説明するわね。\nまずは――",
            "zh": "那么，从头\n说明吧。\n首先——",
            "narrator_zh": "绫水"
        },
        {
            "location": "123/TALK",
            "narrator": "つばめ",
            "text": "…やっぱり、アーヤさんに\n聞いて正解だったみたい。",
            "zh": "……果然，问绫水\n是问对了。",
            "narrator_zh": "燕"
        },
        {
            "location": "125/TALK",
            "narrator": "アーヤ",
            "text": "――っと、\nそういえば……。",
            "zh": "——说起来，\n对了……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "127/TALK",
            "narrator": "つばめ",
            "text": "はいっ！",
            "zh": "是！",
            "narrator_zh": "燕"
        },
        {
            "location": "128/TALK",
            "narrator": "アーヤ",
            "text": "館長ってもう\n手続き書類\n持ってきたの？",
            "zh": "馆长已经把\n手续文件\n拿来了吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "129/TALK",
            "narrator": "つばめ",
            "text": "あああっ！\nそうでした！！",
            "zh": "啊啊啊！\n对了！！",
            "narrator_zh": "燕"
        },
        {
            "location": "132/TALK",
            "narrator": "つばめ",
            "text": "すっかり\n忘れてたよ…。",
            "zh": "彻底\n忘了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "133/ACT",
            "narrator": "",
            "text": "真幌に聞こう",
            "zh": "去问真幌吧",
            "narrator_zh": ""
        },
        {
            "location": "135/TALK",
            "narrator": "つばめ",
            "text": "大人の真幌さんなら、色んなテクニックを知ってそうだね",
            "zh": "成年的真幌，好像知道很多技巧",
            "narrator_zh": "燕"
        },
        {
            "location": "136/TALK",
            "narrator": "つばめ",
            "text": "真幌さんが戻って来たら",
            "zh": "等真幌回来",
            "narrator_zh": "燕"
        },
        {
            "location": "137/TALK",
            "narrator": "つばめ",
            "text": "早速聞いてみる",
            "zh": "马上问",
            "narrator_zh": "燕"
        },
        {
            "location": "149/TALK",
            "narrator": "真幌",
            "text": "すまん、待たせたな。\n中々用紙が見つから\nなくて――",
            "zh": "抱歉，让你久等了。\n表格怎么都\n找不到——",
            "narrator_zh": "真幌"
        },
        {
            "location": "150/TALK",
            "narrator": "つばめ",
            "text": "あの、真幌さん。\nちょっと、聞きたい\nことがあって…。",
            "zh": "那个，真幌。\n有件事，想\n问一下……。",
            "narrator_zh": "燕"
        },
        {
            "location": "152/TALK",
            "narrator": "真幌",
            "text": "構わんぞ。\n答えられるような\n質問ならばな。",
            "zh": "没关系。\n只要是我答得上的\n问题。",
            "narrator_zh": "真幌"
        },
        {
            "location": "153/TALK",
            "narrator": "つばめ",
            "text": "あの…真幌さんって、\nお化粧得意ですか？",
            "zh": "那个……真幌，\n化妆擅长吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "154/TALK",
            "narrator": "真幌",
            "text": "…………は？",
            "zh": "…………哈？",
            "narrator_zh": "真幌"
        },
        {
            "location": "155/TALK",
            "narrator": "つばめ",
            "text": "す、すみません…。\nわたし、お化粧って\nやったことなくて…。",
            "zh": "对、对不起……\n我，化妆\n还没做过……。",
            "narrator_zh": "燕"
        },
        {
            "location": "156/TALK",
            "narrator": "つばめ",
            "text": "興味はあるんです。\nでも、教わったこと\nないから、その…。",
            "zh": "我有兴趣。\n可是，没人教过，\n所以，那个……。",
            "narrator_zh": "燕"
        },
        {
            "location": "157/TALK",
            "narrator": "真幌",
            "text": "…ふふっ。",
            "zh": "……呵呵。",
            "narrator_zh": "真幌"
        },
        {
            "location": "158/TALK",
            "narrator": "真幌",
            "text": "あはははは！\n予想外の可愛らしい\n相談だ。",
            "zh": "啊哈哈哈哈！\n没想到是这么\n可爱的商量。",
            "narrator_zh": "真幌"
        },
        {
            "location": "159/TALK",
            "narrator": "つばめ",
            "text": "す、すみません…。",
            "zh": "对、对不起……。",
            "narrator_zh": "燕"
        },
        {
            "location": "160/TALK",
            "narrator": "真幌",
            "text": "いや、構わん。\nしかし運がいいな。",
            "zh": "不，没关系。\n不过你运气不错。",
            "narrator_zh": "真幌"
        },
        {
            "location": "161/TALK",
            "narrator": "真幌",
            "text": "私は化粧に関しては\nプロフェッショナル\nなんだ。",
            "zh": "化妆这件事，\n我可是\n专业的。",
            "narrator_zh": "真幌"
        },
        {
            "location": "163/TALK",
            "narrator": "つばめ",
            "text": "本当ですか！？",
            "zh": "真的吗！？",
            "narrator_zh": "燕"
        },
        {
            "location": "164/TALK",
            "narrator": "真幌",
            "text": "ああ、本当だ。\n私に全部任せておけ！",
            "zh": "啊，真的。\n全部交给我就行！",
            "narrator_zh": "真幌"
        },
        {
            "location": "166/TALK",
            "narrator": "つばめ",
            "text": "お願いします！",
            "zh": "拜托了！",
            "narrator_zh": "燕"
        },
        {
            "location": "168/TALK",
            "narrator": "真幌",
            "text": "さてと、それじゃ早速\n始めるわけだが…。",
            "zh": "那么，这就\n开始吧……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "170/TALK",
            "narrator": "真幌",
            "text": "どこの国の人間に\nなりたい？",
            "zh": "你想变成\n哪个国家的人？",
            "narrator_zh": "真幌"
        },
        {
            "location": "171/TALK",
            "narrator": "つばめ",
            "text": "はい！\n最初はやっぱり…。",
            "zh": "好！\n一开始果然还是……。",
            "narrator_zh": "燕"
        },
        {
            "location": "172/TALK",
            "narrator": "つばめ",
            "text": "って、あれ？\n今、なんて言いました？",
            "zh": "诶，咦？\n刚才，你说什么？",
            "narrator_zh": "燕"
        },
        {
            "location": "173/TALK",
            "narrator": "真幌",
            "text": "どこの国の人間に\nなりたいかと\n聞いたんだ。",
            "zh": "我问的是，\n你想变成\n哪个国家的人。",
            "narrator_zh": "真幌"
        },
        {
            "location": "174/TALK",
            "narrator": "真幌",
            "text": "それによって\n肌の色をどうするかが\n決まるだろ？",
            "zh": "因为这个会决定\n肤色要怎么\n处理吧？",
            "narrator_zh": "真幌"
        },
        {
            "location": "176/TALK",
            "narrator": "つばめ",
            "text": "そんなことまで\nできちゃうんですか！？",
            "zh": "连这种事\n都能做到吗！？",
            "narrator_zh": "燕"
        },
        {
            "location": "177/TALK",
            "narrator": "真幌",
            "text": "練習次第でな。",
            "zh": "看练习了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "179/TALK",
            "narrator": "つばめ",
            "text": "す、凄いです真幌さん！\nやっぱり真幌さんに\n相談して正解でした。",
            "zh": "好、好厉害，真幌！\n果然找真幌\n商量是对的。",
            "narrator_zh": "燕"
        },
        {
            "location": "180/TALK",
            "narrator": "真幌",
            "text": "ならその期待に応えて\nお前をハリウッド\n女優の顔にしてやろう。",
            "zh": "那就回应这份期待，\n把你弄成好莱坞\n女演员的脸吧。",
            "narrator_zh": "真幌"
        },
        {
            "location": "183/TALK",
            "narrator": "つばめ",
            "text": "…えっ？",
            "zh": "……诶？",
            "narrator_zh": "燕"
        },
        {
            "location": "184/TALK",
            "narrator": "真幌",
            "text": "心配はいらないぞ！\n時間は掛かるが\n瓜二つにしてみせよう。",
            "zh": "不用担心！\n要花时间，\n不过我会弄得一模一样。",
            "narrator_zh": "真幌"
        },
        {
            "location": "185/TALK",
            "narrator": "真幌",
            "text": "さあ、そこへ座れ。\n彫りを深くするために\n頬に陰影をつけて――",
            "zh": "来，坐到那边。\n为了让五官更深，\n在脸颊上打出阴影——",
            "narrator_zh": "真幌"
        },
        {
            "location": "191/TALK",
            "narrator": "つばめ",
            "text": "…これ、\n化粧じゃなくて\n特殊メイクなんじゃ？",
