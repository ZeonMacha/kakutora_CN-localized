        {
            "location": "109/TALK",
            "narrator": "みやび",
            "text": "いや",
            "zh": "不",
            "narrator_zh": "雅"
        },
        {
            "location": "110/TALK",
            "narrator": "みやび",
            "text": "なんとなく",
            "zh": "没什么",
            "narrator_zh": "雅"
        },
        {
            "location": "113/TALK",
            "narrator": "みやび",
            "text": "要は",
            "zh": "说到底",
            "narrator_zh": "雅"
        },
        {
            "location": "114/TALK",
            "narrator": "みやび",
            "text": "人はどうやって自分自身と他者の区別をつけているのか",
            "zh": "人是怎么区分自己和他人的",
            "narrator_zh": "雅"
        },
        {
            "location": "115/TALK",
            "narrator": "みやび",
            "text": "また他者をどうやって認識しているのかという問い",
            "zh": "又是怎么认识他人的，这个问题",
            "narrator_zh": "雅"
        },
        {
            "location": "117/SEL",
            "narrator": "",
            "text": "雰囲気とか",
            "zh": "气氛之类的",
            "narrator_zh": ""
        },
        {
            "location": "118/SEL",
            "narrator": "",
            "text": "見た目が100パーセント",
            "zh": "外表占百分之百",
            "narrator_zh": ""
        },
        {
            "location": "119/SEL",
            "narrator": "",
            "text": "$me$は何があってもみやびを認識するよ",
            "zh": "不管发生什么，$me$都认得雅",
            "narrator_zh": ""
        },
        {
            "location": "120/ACT",
            "narrator": "",
            "text": "雰囲気とか",
            "zh": "气氛之类的",
            "narrator_zh": ""
        },
        {
            "location": "121/TALK",
            "narrator": "みやび",
            "text": "その雰囲気自体を偽装されたらどうする？",
            "zh": "要是连那气氛本身都被伪装了，怎么办？",
            "narrator_zh": "雅"
        },
        {
            "location": "122/ACT",
            "narrator": "",
            "text": "見た目が100パーセント",
            "zh": "外表占百分之百",
            "narrator_zh": ""
        },
        {
            "location": "123/TALK",
            "narrator": "みやび",
            "text": "世の中には",
            "zh": "这世上",
            "narrator_zh": "雅"
        },
        {
            "location": "124/TALK",
            "narrator": "みやび",
            "text": "眼鏡をかけるだけでもう他人と認識してしまうような輩もおるのだぞ",
            "zh": "也有那种只戴上眼镜就被认成另一个人的家伙",
            "narrator_zh": "雅"
        },
        {
            "location": "125/ACT",
            "narrator": "",
            "text": "$me$は何があってもみやびを認識するよ",
            "zh": "不管发生什么，$me$都认得雅",
            "narrator_zh": ""
        },
        {
            "location": "127/TALK",
            "narrator": "みやび",
            "text": "それは魂のレベルでということか",
            "zh": "是说在灵魂的层面上吗",
            "narrator_zh": "雅"
        },
        {
            "location": "128/TALK",
            "narrator": "みやび",
            "text": "できる自信があるのか",
            "zh": "有自信做得到吗",
            "narrator_zh": "雅"
        },
        {
            "location": "129/TALK",
            "narrator": "みやび",
            "text": "よく言った",
            "zh": "说得好",
            "narrator_zh": "雅"
        },
        {
            "location": "131/TALK",
            "narrator": "みやび",
            "text": "実際な",
            "zh": "实际上啊",
