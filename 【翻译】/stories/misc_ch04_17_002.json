        {
            "location": "132/TALK",
            "narrator": "みやび",
            "text": "役者ならある程度のことまではできると思うのだ",
            "zh": "我觉得演员能做到某种程度",
            "narrator_zh": "雅"
        },
        {
            "location": "133/TALK",
            "narrator": "みやび",
            "text": "しかしその状態のまま",
            "zh": "但是保持那个状态",
