{
    "dir": "dramatics/daydra/drm_ch02_00_780.js",
    "type": "Episode",
    "info": {
        "story_id": "2078",
        "cid": "ayami",
        "title": "らぶとーく 第77話",
        "sub_title": "昨日までの私と、明日からのあなた",
        "title_zh": "恋爱漫谈 第77话",
        "sub_title_zh": "昨天的我，与明天的你"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "昨日までの私と、明日からのあなた",
            "zh": "昨天的我，与明天的你",
            "narrator_zh": ""
        },
        {
            "location": "18/TALK",
            "narrator": "アーヤ",
            "text": "よしよし。\nここもキレイに\nなったし。",
            "zh": "好了好了。\n这里也\n干净了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "20/TALK",
            "narrator": "アーヤ",
            "text": "後は元通り\n組み立てるだけね。",
            "zh": "接下来只要\n原样装回去就好呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "21/TALK",
            "narrator": "アーヤ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "22/TALK",
            "narrator": "アーヤ",
            "text": "…人の気持ちも\nこうやって分解して\n確認できればいいのに。",
            "zh": "……要是人的心情也能\n这样拆开来\n确认就好了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "23/TALK",
            "narrator": "アーヤ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "24/SEL",
            "narrator": "",
            "text": "持て余しちゃうよね",
            "zh": "确实会嫌多呢",
            "narrator_zh": ""
        },
        {
            "location": "25/ACT",
            "narrator": "",
            "text": "持て余しちゃうよね",
            "zh": "确实会嫌多呢",
            "narrator_zh": ""
        },
        {
            "location": "43/TALK",
            "narrator": "アーヤ",
            "text": "何が？",
            "zh": "什么？",
            "narrator_zh": "绫水"
        },
        {
            "location": "45/SEL",
            "narrator": "",
            "text": "$me$が退屈で",
            "zh": "$me$很无聊",
            "narrator_zh": ""
        },
        {
            "location": "46/SEL",
            "narrator": "",
            "text": "アーヤがかわいくて",
            "zh": "绫水好可爱",
            "narrator_zh": ""
        },
        {
            "location": "47/ACT",
            "narrator": "",
            "text": "$me$が退屈で",
            "zh": "$me$很无聊",
            "narrator_zh": ""
        },
        {
            "location": "48/TALK",
            "narrator": "アーヤ",
            "text": "今手が離せないのよ",
            "zh": "现在腾不出手哦",
            "narrator_zh": "绫水"
        },
        {
            "location": "49/TALK",
            "narrator": "アーヤ",
            "text": "また後でね",
            "zh": "待会儿见哦",
            "narrator_zh": "绫水"
        },
        {
            "location": "50/ACT",
            "narrator": "",
            "text": "アーヤがかわいくて",
            "zh": "绫水好可爱",
            "narrator_zh": ""
        },
        {
            "location": "51/TALK",
            "narrator": "アーヤ",
            "text": "そんなの",
            "zh": "那样",
            "narrator_zh": "绫水"
        },
        {
            "location": "53/TALK",
            "narrator": "アーヤ",
            "text": "いつものことでしょ",
            "zh": "不是老一套吗",
            "narrator_zh": "绫水"
        },
        {
            "location": "54/TALK",
            "narrator": "アーヤ",
            "text": "それに私",
            "zh": "而且我",
            "narrator_zh": "绫水"
        },
        {
            "location": "55/TALK",
            "narrator": "アーヤ",
            "text": "かわいいより格好いいって",
            "zh": "与其说可爱，不如说是帅气",
            "narrator_zh": "绫水"
        },
        {
            "location": "56/TALK",
            "narrator": "アーヤ",
            "text": "言われたいから(=^0^=)",
            "zh": "我就是想被那么说(=^0^=)",
            "narrator_zh": "绫水"
        },
        {
            "location": "73/TALK",
            "narrator": "真幌",
            "text": "バイクの整備か。",
            "zh": "是在保养摩托啊。",
            "narrator_zh": "真幌"
        },
        {
            "location": "75/TALK",
            "narrator": "アーヤ",
            "text": "はい。",
            "zh": "是。",
            "narrator_zh": "绫水"
        },
        {
            "location": "76/TALK",
            "narrator": "真幌",
            "text": "しかしさっき\nスマホを手に\nしていたような。",
            "zh": "不过刚才，\n你好像还拿着\n手机吧。",
            "narrator_zh": "真幌"
        },
        {
            "location": "77/TALK",
            "narrator": "アーヤ",
            "text": "あ、ＷＡＶＥの\n着信があったので。",
            "zh": "啊，因为WAVE\n有来电。",
            "narrator_zh": "绫水"
        },
        {
            "location": "78/TALK",
            "narrator": "真幌",
            "text": "終わってから\nゆっくり返信\nすればいいのに。",
            "zh": "明明可以等完事\n再慢慢\n回复的。",
            "narrator_zh": "真幌"
        },
        {
            "location": "79/TALK",
            "narrator": "アーヤ",
            "text": "…まあ、\nそうですね。",
            "zh": "……嗯，\n是这样呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "80/TALK",
            "narrator": "アーヤ",
            "text": "でもちょうど\n一段落ついたところ\nでしたし。",
            "zh": "不过正好\n告一段落\n了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "81/SEL",
            "narrator": "",
            "text": "めんどくさい話になってる？",
            "zh": "聊成麻烦话题了？",
            "narrator_zh": ""
        },
        {
            "location": "82/ACT",
            "narrator": "",
            "text": "めんどくさい話になってる？",
            "zh": "聊成麻烦话题了？",
            "narrator_zh": ""
        },
        {
            "location": "112/TALK",
            "narrator": "真幌",
            "text": "ん？\n返信しなくて\nいいのか？",
            "zh": "嗯？\n不回复\n没关系吗？",
            "narrator_zh": "真幌"
        },
        {
            "location": "114/TALK",
            "narrator": "アーヤ",
            "text": "急用では\nなかったので\n大丈夫です。",
            "zh": "不是急事，\n所以\n没关系的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "115/TALK",
            "narrator": "真幌",
            "text": "ならいいが。",
            "zh": "那就好。",
            "narrator_zh": "真幌"
        },
        {
            "location": "116/TALK",
            "narrator": "真幌",
            "text": "…それにしても\nスマホは便利なようで\n不便だな。",
            "zh": "…话说回来，\n手机看似方便，\n实则不便啊。",
            "narrator_zh": "真幌"
        },
        {
            "location": "117/TALK",
            "narrator": "アーヤ",
            "text": "…そうですね。",
            "zh": "…是啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "118/TALK",
            "narrator": "真幌",
            "text": "着信があると\nつい手にしてしまう。",
            "zh": "一有来电，\n总会忍不住拿起来。",
            "narrator_zh": "真幌"
        },
        {
            "location": "119/TALK",
            "narrator": "真幌",
            "text": "目の前のことだけ\n見ている方が\n集中できるのにな。",
            "zh": "明明只看着眼前的事\n更容易\n集中精神。",
            "narrator_zh": "真幌"
        },
        {
            "location": "120/TALK",
            "narrator": "アーヤ",
            "text": "ですね。",
            "zh": "是啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "121/TALK",
            "narrator": "真幌",
            "text": "だからといって\n電源を切ってしまっては\n本末転倒だし。",
            "zh": "就算这么说，\n要是把电源关掉，\n那就本末倒置了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "122/TALK",
            "narrator": "真幌",
            "text": "悩みどころだよな。",
            "zh": "真是让人头疼啊。",
            "narrator_zh": "真幌"
        },
        {
            "location": "123/TALK",
            "narrator": "アーヤ",
            "text": "…ああ。\n切ってしまうの、\n手ですよね。",
            "zh": "…是啊。\n动手关掉的，\n还是手吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "124/TALK",
            "narrator": "アーヤ",
            "text": "そうすれば\n考えてる途中で\n鳴らないですから。",
            "zh": "只要那样\n在想到一半的时候\n就不会响。",
            "narrator_zh": "绫水"
        },
        {
            "location": "125/TALK",
            "narrator": "真幌",
            "text": "いやいや。\n人の話を\n聞いていたのか？",
            "zh": "不是不是。\n你有在听\n我说话吗？",
            "narrator_zh": "真幌"
        },
        {
            "location": "126/TALK",
            "narrator": "アーヤ",
            "text": "聞いてたから\n気付いたんですよ。",
            "zh": "正因为听了\n才注意到的哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "127/TALK",
            "narrator": "真幌",
            "text": "…いや、まあ、\nいいか。",
            "zh": "…算了，嗯，\n也行吧。",
            "narrator_zh": "真幌"
        },
        {
            "location": "128/TALK",
            "narrator": "真幌",
            "text": "そのくらい\n思い切った方が\nいい時もあるだろうし。",
            "zh": "有时候还是\n那样下决心\n比较好。",
            "narrator_zh": "真幌"
        },
        {
            "location": "130/TALK",
            "narrator": "アーヤ",
            "text": "ですよね！",
            "zh": "对吧！",
            "narrator_zh": "绫水"
        },
        {
            "location": "131/TALK",
            "narrator": "真幌",
            "text": "常に全力で集中\nするのは不可能だし。",
            "zh": "总是全神贯注\n本来就不可能。",
            "narrator_zh": "真幌"
        },
        {
            "location": "132/TALK",
            "narrator": "アーヤ",
            "text": "…休息が必要\nということですか？",
            "zh": "……是说需要\n休息吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "133/TALK",
            "narrator": "真幌",
            "text": "それもあるし。",
            "zh": "也有那个原因。",
            "narrator_zh": "真幌"
        },
        {
            "location": "134/TALK",
            "narrator": "真幌",
            "text": "後は比較検討\nする時間なんかだな。",
            "zh": "再就是用来\n比较斟酌的时间嘛。",
            "narrator_zh": "真幌"
        },
        {
            "location": "135/TALK",
            "narrator": "アーヤ",
            "text": "ああ。わかります。",
            "zh": "啊。我懂。",
            "narrator_zh": "绫水"
        },
        {
            "location": "136/TALK",
            "narrator": "真幌",
            "text": "実は悩む時間が\n一番楽しいって\n知っているか？",
            "zh": "你知道吗，其实\n烦恼的时间\n才最快乐？",
            "narrator_zh": "真幌"
        },
        {
            "location": "137/TALK",
            "narrator": "アーヤ",
            "text": "え。そうなんですか？",
            "zh": "诶。是这样吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "138/TALK",
            "narrator": "真幌",
            "text": "決まったらもう\n結果を出すために\n行動するだけだからな。",
            "zh": "一旦定了，\n就只剩为了结果\n去行动了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "139/TALK",
            "narrator": "真幌",
            "text": "責任と行動力が\n必要になってくる。",
            "zh": "就得需要\n责任感和行动力了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "140/TALK",
            "narrator": "真幌",
            "text": "だが決めるまでは\nそんなものは\n必要ない。",
            "zh": "可是在决定之前，\n那些东西都\n不需要。",
            "narrator_zh": "真幌"
        },
        {
            "location": "141/TALK",
            "narrator": "真幌",
            "text": "だから本心は\n決まっていても\n悩むもんなんだ。",
            "zh": "所以即使本心已经\n定了，也还是会\n烦恼的。",
            "narrator_zh": "真幌"
        },
        {
            "location": "142/TALK",
            "narrator": "アーヤ",
            "text": "なるほど……。",
            "zh": "原来如此……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "143/TALK",
            "narrator": "真幌",
            "text": "だから大いに悩め。",
            "zh": "所以你就好好烦恼吧。",
            "narrator_zh": "真幌"
        },
        {
            "location": "144/TALK",
            "narrator": "アーヤ",
            "text": "悩めって……。",
            "zh": "让我烦恼……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "145/TALK",
            "narrator": "真幌",
            "text": "どうも整備に集中\nできてないように\n見えてたからな。",
            "zh": "看起来你好像没法\n集中精力\n维护呢。",
            "narrator_zh": "真幌"
        },
        {
            "location": "146/TALK",
            "narrator": "アーヤ",
            "text": "…そんなことは…。",
            "zh": "…才没有那种事……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "147/TALK",
            "narrator": "真幌",
            "text": "勘違いなら\n聞き流せ。\n邪魔したな。",
            "zh": "是我弄错的话\n就别放在心上。\n打扰了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "148/TALK",
            "narrator": "アーヤ",
            "text": "…あ、はい…。",
            "zh": "…啊，好的……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "151/TALK",
            "narrator": "アーヤ",
            "text": "うーん…。",
            "zh": "嗯……",
            "narrator_zh": "绫水"
        },
        {
            "location": "153/TALK",
            "narrator": "アーヤ",
            "text": "結局私、どうするか\n決めてるのに\n踏み出せないだけなの…？",
            "zh": "说到底，明明已经\n决定好怎么做，\n我却只是迈不出那一步吗……？",
            "narrator_zh": "绫水"
        },
        {
            "location": "17/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>某月某日　 3:12 PM</color>\nとある平日、神楽坂トライナリーにて",
            "zh": "<color=green>某月某日　 3:12 PM</color>\n某个平日，神乐坂三重奏",
            "narrator_zh": "Dialog_EventData"
        }
    ]
}
