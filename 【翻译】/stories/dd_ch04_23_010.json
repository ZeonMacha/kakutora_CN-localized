{
    "dir": "chap23/daydra/dd_ch04_23_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "23452",
        "cid": "miyabi",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "本気かお世辞かそれとも…",
        "title_zh": "Extra002 额外剧情",
        "sub_title_zh": "是真心，是客套，还是……"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "本気かお世辞かそれとも…",
            "zh": "是真心，是客套，还是……",
            "narrator_zh": ""
        },
        {
            "location": "18/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "24/TALK",
            "narrator": "みやび",
            "text": "…ん？　卯月か。\nこんなとこで\n何やっちゅうが？",
            "zh": "…嗯？　是卯月啊。\n在这种地方\n搞驷马咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "26/TALK",
            "narrator": "神楽",
            "text": "あ、えっと…。",
            "zh": "啊，那个……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "28/TALK",
            "narrator": "神楽",
            "text": "あはは…ちょっと、\nボーッとしちゃって\nました。",
            "zh": "啊哈哈……刚才，\n有点发\n呆了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "29/TALK",
            "narrator": "みやび",
            "text": "退屈やろ？\n田舎やし、うちにも\n何の娯楽も無いき。",
            "zh": "闷得慌，是没是？\n乡下地方，我这边\n也没得什么娱乐啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "30/TALK",
            "narrator": "神楽",
            "text": "いえ、そんなこと\nないです。",
            "zh": "没有，\n没那回事。",
            "narrator_zh": "神乐"
        },
        {
            "location": "31/TALK",
            "narrator": "神楽",
            "text": "私、みやびさんのお家、\nとっても気に入ってます。",
            "zh": "雅的家，\n我特别中意。",
            "narrator_zh": "神乐"
        },
        {
            "location": "32/TALK",
            "narrator": "みやび",
            "text": "まっこと？",
            "zh": "真的咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "33/TALK",
            "narrator": "神楽",
            "text": "はい…こうしてると、\n何だか落ち着いた気持ちに\nなれるんです。",
            "zh": "嗯……像这样待着，\n不知怎么就觉得\n心里很安稳。",
            "narrator_zh": "神乐"
        },
        {
            "location": "34/TALK",
            "narrator": "みやび",
            "text": "落ち着いた気持ちなぁ…。\nうちにはわからんな。",
            "zh": "心里安稳这种感觉啊……\n我是没懂咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "36/TALK",
            "narrator": "神楽",
            "text": "ふふっ…。",
            "zh": "呵呵……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "37/TALK",
            "narrator": "神楽",
            "text": "…でも、もう少ししたら\n東京に帰らないと\nいけないんですよね…。",
            "zh": "…可是，再过一阵子\n我就不得不回\n东京去了……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "38/TALK",
            "narrator": "神楽",
            "text": "それを考えると、\nちょっと寂しいです…。",
            "zh": "一想到这个，\n就有点寂寞……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "39/TALK",
            "narrator": "みやび",
            "text": "ふむ…。",
            "zh": "唔……。",
            "narrator_zh": "雅"
        },
        {
            "location": "40/TALK",
            "narrator": "みやび",
            "text": "なら、また遊びにくれば\nえいやろ。",
            "zh": "那就，再过来玩\n就好了嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "41/TALK",
            "narrator": "神楽",
            "text": "え？",
            "zh": "诶？",
            "narrator_zh": "神乐"
        },
        {
            "location": "42/TALK",
            "narrator": "みやび",
            "text": "知っちょるやろ？\nうちが頻繁に実家に\n帰っちょるの。",
            "zh": "晓得的啵？\n我经常回老家\n这回事。",
            "narrator_zh": "雅"
        },
        {
            "location": "43/TALK",
            "narrator": "みやび",
            "text": "卯月の予定が合えば、\nその時について来れば\nえいやん。",
            "zh": "卯月日程对得上，\n到时候跟着来\n不就好了嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "44/TALK",
            "narrator": "神楽",
            "text": "いいんですか？\nみやびさんのご迷惑に\nなるんじゃ…。",
            "zh": "可以吗？\n会不会给雅\n添麻烦……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "45/TALK",
            "narrator": "みやび",
            "text": "うちは自室で不可思議\n触っちょるやろうき、\nほとんど相手はできん。",
            "zh": "我只会在自室\n摆弄不可思议嘛，\n基本是没法陪你。",
            "narrator_zh": "雅"
        },
        {
            "location": "47/TALK",
            "narrator": "みやび",
            "text": "けんど、それでもえいなら\nうちは構わん。\nいつでもウェルカムや。",
            "zh": "但是，就算这样也不打紧，\n我无所谓。\n随时欢迎咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "48/TALK",
            "narrator": "神楽",
            "text": "ありがとうございます！\nそれじゃあ――",
            "zh": "非常感谢！\n那么我就——",
            "narrator_zh": "神乐"
        },
        {
            "location": "49/TALK",
            "narrator": "神楽",
            "text": "あ…。",
            "zh": "啊……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "50/TALK",
            "narrator": "みやび",
            "text": "…どうした？",
            "zh": "…怎么了？",
            "narrator_zh": "雅"
        },
        {
            "location": "52/TALK",
            "narrator": "神楽",
            "text": "い、いえ…ただその…、\nう、嬉し過ぎちゃって…。",
            "zh": "不、不是…只是那个…、\n太、太高兴过头了……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "53/TALK",
            "narrator": "みやび",
            "text": "…そういう感じには\n見えんけんど？",
            "zh": "…不过看上去\n不像是这样咧？",
            "narrator_zh": "雅"
        },
        {
            "location": "54/TALK",
            "narrator": "みやび",
            "text": "何か気になることでも\nあるなら、一応言うてみぃ。",
            "zh": "要是有什么在意的事，\n姑且说出来听听。",
            "narrator_zh": "雅"
        },
        {
            "location": "57/TALK",
            "narrator": "神楽",
            "text": "大丈夫です。\n本当、そういうのは\nないんで…。",
            "zh": "请放心。\n真的，并没有\n那种事……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "59/TALK",
            "narrator": "神楽",
            "text": "じゃあ、私はちょっと、\nやることがあるので…。",
            "zh": "那么，我先失陪，\n还有点事要处理……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "64/TALK",
            "narrator": "みやび",
            "text": "ウソが下手やなぁ…。\nまあ、上手な奴よりは\n親しみ持てるけんど。",
            "zh": "谎撒得真烂啊……\n嘛，但是比起高明的骗子，\n反倒更有亲近感。",
            "narrator_zh": "雅"
        },
        {
            "location": "65/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "77/TALK",
            "narrator": "みやび",
            "text": "謎",
            "zh": "谜",
            "narrator_zh": "雅"
        },
        {
            "location": "78/TALK",
            "narrator": "みやび",
            "text": "卯月の反応は見たな？",
            "zh": "卯月的反应，看到了啵？",
            "narrator_zh": "雅"
        },
        {
            "location": "79/TALK",
            "narrator": "みやび",
            "text": "あの表情は何かある",
            "zh": "那个表情有情况",
            "narrator_zh": "雅"
        },
        {
            "location": "80/TALK",
            "narrator": "みやび",
            "text": "何を隠しているのか？",
            "zh": "在隐瞒着什么？",
            "narrator_zh": "雅"
        },
        {
            "location": "81/TALK",
            "narrator": "みやび",
            "text": "相棒のシックスセンスに協力要請",
            "zh": "向搭档的第六感请求协助",
            "narrator_zh": "雅"
        },
        {
            "location": "82/TALK",
            "narrator": "みやび",
            "text": "どう思う？",
            "zh": "你怎么看？",
            "narrator_zh": "雅"
        },
        {
            "location": "84/SEL",
            "narrator": "",
            "text": "もしかして、もう来れないから？",
            "zh": "难道是，以后来不了了？",
            "narrator_zh": ""
        },
        {
            "location": "85/SEL",
            "narrator": "",
            "text": "お世辞だったからじゃない？",
            "zh": "难道只是客套话？",
            "narrator_zh": ""
        },
        {
            "location": "86/ACT",
            "narrator": "",
            "text": "もしかして、もう来れないから？",
            "zh": "难道是，以后来不了了？",
            "narrator_zh": ""
        },
        {
            "location": "89/TALK",
            "narrator": "みやび",
            "text": "来れないとは？",
            "zh": "来不了，是指？",
            "narrator_zh": "雅"
        },
        {
            "location": "90/TALK",
            "narrator": "みやび",
            "text": "うちが帰る時に",
            "zh": "我回老家的时候",
            "narrator_zh": "雅"
        },
        {
            "location": "91/TALK",
            "narrator": "みやび",
            "text": "ついて来ればいいだけのこと",
            "zh": "跟着来就行了",
            "narrator_zh": "雅"
        },
        {
            "location": "92/TALK",
            "narrator": "みやび",
            "text": "なのに来れない？",
            "zh": "却说来不了？",
            "narrator_zh": "雅"
        },
        {
            "location": "93/TALK",
            "narrator": "みやび",
            "text": "意味が分からん",
            "zh": "没懂什么意思",
            "narrator_zh": "雅"
        },
        {
            "location": "94/TALK",
            "narrator": "みやび",
            "text": "結論",
            "zh": "结论",
            "narrator_zh": "雅"
        },
        {
            "location": "96/TALK",
            "narrator": "みやび",
            "text": "相棒にシックスセンスはなかった",
            "zh": "搭档没有第六感",
            "narrator_zh": "雅"
        },
        {
            "location": "107/TALK",
            "narrator": "みやび",
            "text": "…もう来れん、か…。",
            "zh": "…来不了了，咩……。",
            "narrator_zh": "雅"
        },
        {
            "location": "108/TALK",
            "narrator": "みやび",
            "text": "絶対にありえん、とも\n思えんな。",
            "zh": "倒也不能说\n绝对不可能。",
            "narrator_zh": "雅"
        },
        {
            "location": "109/TALK",
            "narrator": "みやび",
            "text": "けんど、もしそれが\n事実やったとすると、\nその理由は…？",
            "zh": "但是，假如那\n是事实的话，\n理由是……？",
            "narrator_zh": "雅"
        },
        {
            "location": "110/TALK",
            "narrator": "みやび",
            "text": "…ふむ。\nやはり、あれか？",
            "zh": "…唔。\n果然，是那事咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "111/TALK",
            "narrator": "みやび",
            "text": "卯月はスパイやき、\nそれは出来んっちゅうこと\nなのかもしれん。",
            "zh": "卯月是间谍啵，\n所以来不了这种事，\n说不定就是这么回事。",
            "narrator_zh": "雅"
        },
        {
            "location": "112/TALK",
            "narrator": "みやび",
            "text": "だとすると、正体を明かす\n日が近い、っちゅうこと\nなんやろか？",
            "zh": "那样的话，意思是说，\n她亮明真面目的日子\n近了咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "113/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "114/TALK",
            "narrator": "みやび",
            "text": "いや、先走り過ぎやな。",
            "zh": "不，想得太超前了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "115/TALK",
            "narrator": "みやび",
            "text": "今のとこ、スパイである\n確証もないんやし…。",
            "zh": "现在嘛，她是不是间谍\n连确证都没得……",
            "narrator_zh": "雅"
        },
        {
            "location": "116/TALK",
            "narrator": "みやび",
            "text": "ちゅうか、こんなこと\n考えること事態、\nおかしなことや。",
            "zh": "说起来，琢磨这种事\n这个行为本身，\n就已经够怪咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "117/TALK",
            "narrator": "みやび",
            "text": "…結局、直接聞かな\nなーんもわからん、\nっちゅうことか…。",
            "zh": "…到头来，不直接问\n就什么都搞没懂，\n是这么回事咩……。",
            "narrator_zh": "雅"
        },
        {
            "location": "118/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "119/TALK",
            "narrator": "みやび",
            "text": "別に…今急いで聞かんでも\nえいよな？",
            "zh": "倒也不是非得现在问……\n不急这一时也行啵？",
            "narrator_zh": "雅"
        },
        {
            "location": "120/TALK",
            "narrator": "みやび",
            "text": "こういうのはタイミングが\n重要やと思うし…。",
            "zh": "这种事嘛，我觉得\n时机很重要……",
            "narrator_zh": "雅"
        },
        {
            "location": "121/TALK",
            "narrator": "みやび",
            "text": "…うん、そうや。\nタイミング見て、\n近いうちに聞けばえいか…。",
            "zh": "…嗯，是这样。\n看准时机，\n近日里问了就好咯……",
            "narrator_zh": "雅"
        },
        {
            "location": "138/ACT",
            "narrator": "",
            "text": "お世辞だったからじゃない？",
            "zh": "难道只是客套话？",
            "narrator_zh": ""
        },
        {
            "location": "139/TALK",
            "narrator": "みやび",
            "text": "１００パー本気はありえん",
            "zh": "不可能有百分之百的真心",
            "narrator_zh": "雅"
        },
        {
            "location": "140/TALK",
            "narrator": "みやび",
            "text": "なんパーかはお世辞だろう",
            "zh": "总有几个点是客套",
            "narrator_zh": "雅"
        },
        {
            "location": "141/TALK",
            "narrator": "みやび",
            "text": "それは確実",
            "zh": "这倒确实",
            "narrator_zh": "雅"
        },
        {
            "location": "142/TALK",
            "narrator": "みやび",
            "text": "しかし",
            "zh": "但是",
            "narrator_zh": "雅"
        },
        {
            "location": "143/TALK",
            "narrator": "みやび",
            "text": "だとするとあの表情に違和感を覚える",
            "zh": "那样的话，那个表情就让人在意",
            "narrator_zh": "雅"
        },
        {
            "location": "144/TALK",
            "narrator": "みやび",
            "text": "何か違う気がする",
            "zh": "总觉得哪里不一样",
            "narrator_zh": "雅"
        },
        {
            "location": "145/TALK",
            "narrator": "みやび",
            "text": "もっとこう",
            "zh": "更像是那种",
            "narrator_zh": "雅"
        },
        {
            "location": "146/TALK",
            "narrator": "みやび",
            "text": "違う何かが",
            "zh": "不一样的什么东西",
            "narrator_zh": "雅"
        },
        {
            "location": "148/TALK",
            "narrator": "みやび",
            "text": "少し考える",
            "zh": "想了想",
            "narrator_zh": "雅"
        },
        {
            "location": "159/TALK",
            "narrator": "みやび",
            "text": "微かやけんど、\nあの表情には\n悲しみが見えた。",
            "zh": "虽然很淡，但是\n那个表情里\n看到了悲伤。",
            "narrator_zh": "雅"
        },
        {
            "location": "160/TALK",
            "narrator": "みやび",
            "text": "何故悲しむ？\n卯月が悲しまんといかん\n理由とはなんや？",
            "zh": "为什么会悲伤？\n卯月有驷马理由\n不得不悲伤？",
            "narrator_zh": "雅"
        },
        {
            "location": "161/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "162/TALK",
            "narrator": "みやび",
            "text": "…いや…待て待て。",
            "zh": "…不对……等等等等。",
            "narrator_zh": "雅"
        },
        {
            "location": "163/TALK",
            "narrator": "みやび",
            "text": "うち、何やっちゅうが？",
            "zh": "我，在搞驷马咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "164/TALK",
            "narrator": "みやび",
            "text": "スパイ疑惑がある卯月を\n心配しちゅうが？",
            "zh": "在担心有间谍嫌疑的\n卯月，搞驷马咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "165/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "167/TALK",
            "narrator": "みやび",
            "text": "ははっ…うちも、\nまだまだ甘いなぁ…。",
            "zh": "哈哈……我也，\n还嫩得很啊……",
            "narrator_zh": "雅"
        },
        {
            "location": "17/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>8月20日　 1:02 PM</color>\n合宿中、みやびの実家でのこと",
            "zh": "<color=green>8月20日　 1:02 PM</color>\n合宿期间，在雅的老家发生的事",
            "narrator_zh": "Dialog_EventData"
        },
        {
            "location": "132/DIALOG",
            "narrator": "Dialog_GEThimegoto_ch04",
            "text": "【うそうその嘘】",
            "zh": "【谎上加谎的谎言】",
            "narrator_zh": "Dialog_GEThimegoto_ch04"
        }
    ]
}
