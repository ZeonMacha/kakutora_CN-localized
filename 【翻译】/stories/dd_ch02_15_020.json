{
    "dir": "chap15/daydra/dd_ch02_15_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "15256",
        "cid": "ayami",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "大学の友達との付き合い",
        "title_zh": "Extra006 额外剧情",
        "sub_title_zh": "和大学朋友的聚会"
    },
    "entry": [
        {
            "location": "167/SCENARIO",
            "narrator": "",
            "text": "大学の友達との付き合い",
            "zh": "和大学朋友的聚会",
            "narrator_zh": ""
        },
        {
            "location": "187/TALK",
            "narrator": "アーヤ",
            "text": "じゃあ、先に上がらせて\nもらいますね。",
            "zh": "那我就先\n下班了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "189/TALK",
            "narrator": "真幌",
            "text": "おお…珍しいな。\nアーヤが一番先に\n上がるなんて。",
            "zh": "哦……真稀奇啊。\n绫水居然会第一个\n下班。",
            "narrator_zh": "真幌"
        },
        {
            "location": "191/TALK",
            "narrator": "アーヤ",
            "text": "今日はこの後、\n大学の友人と食事をする\n約束があるんです。",
            "zh": "今天待会儿\n我和大学朋友约了\n一起吃饭。",
            "narrator_zh": "绫水"
        },
        {
            "location": "192/TALK",
            "narrator": "真幌",
            "text": "ほう…友人だと？",
            "zh": "哦……朋友吗？",
            "narrator_zh": "真幌"
        },
        {
            "location": "193/TALK",
            "narrator": "アーヤ",
            "text": "はい。",
            "zh": "是的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "194/TALK",
            "narrator": "アーヤ",
            "text": "久しぶりの食事会なので、\n少しおめかしもしようかと\n思ってまして…。",
            "zh": "因为是久违的聚餐，\n想着稍微打扮一下\n再过去……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "197/TALK",
            "narrator": "みやび",
            "text": "ほほう…おめかしか。",
            "zh": "哦吼……打扮一番咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "201/TALK",
            "narrator": "みやび",
            "text": "まほさん、これはあれで\n決まりですな。",
            "zh": "真幌，这下基本\n就是那件事了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "203/TALK",
            "narrator": "真幌",
            "text": "うむ、間違いない。",
            "zh": "嗯，错不了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "207/TALK",
            "narrator": "真幌",
            "text": "合コン、頑張ってこいよ。",
            "zh": "联谊，加油去吧。",
            "narrator_zh": "真幌"
        },
        {
            "location": "210/TALK",
            "narrator": "アーヤ",
            "text": "何でそうなるんですか…。",
            "zh": "怎么就变成那样了啊……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "212/TALK",
            "narrator": "真幌",
            "text": "夜にめかしこんで行く\n食事会となれば――",
            "zh": "大晚上打扮得漂漂亮亮\n去参加的聚餐——",
            "narrator_zh": "真幌"
        },
        {
            "location": "213/TALK",
            "narrator": "真幌",
            "text": "合コンと概ね決まって\nいるからな。",
            "zh": "十有八九就是\n联谊了吧。",
            "narrator_zh": "真幌"
        },
        {
            "location": "216/TALK",
            "narrator": "みやび",
            "text": "とうとう、アーヤにも\n春が来るかもしれんがか。",
            "zh": "说不定绫水的春天\n终于也要来了啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "218/TALK",
            "narrator": "みやび",
            "text": "上手くいったら\n報告するがよ。\n赤飯炊いて待ってるき。",
            "zh": "成了的话记得\n来报告啵。\n我煮好红豆饭等着咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "220/TALK",
            "narrator": "アーヤ",
            "text": "あ、あのねぇ…。",
            "zh": "喂、我说你们啊……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "221/TALK",
            "narrator": "真幌",
            "text": "というか、どんな男が\n来るのかわかっている\nのか？",
            "zh": "话说回来，你知道\n那边会来什么样的\n男人吗？",
            "narrator_zh": "真幌"
        },
        {
            "location": "222/TALK",
            "narrator": "みやび",
            "text": "それより、アーヤの\n好みのタイプって\nどんな奴なが？",
            "zh": "比起那个，绫水\n喜欢的类型是\n哪号人喃？",
            "narrator_zh": "雅"
        },
        {
            "location": "225/TALK",
            "narrator": "アーヤ",
            "text": "…ダメだわ。\n全然私の話聞いて\nくれない…。",
            "zh": "……没救了。\n完全不听我说话\n啊……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "226/SEL",
            "narrator": "",
            "text": "合コンだな！？",
            "zh": "是联谊吧！？",
            "narrator_zh": ""
        },
        {
            "location": "227/SEL",
            "narrator": "",
            "text": "端末操作：着信音",
            "zh": "终端操作：来电铃声",
            "narrator_zh": ""
        },
        {
            "location": "230/TALK",
            "narrator": "アーヤ",
            "text": "っていうか、どうして\nこの手の話題が出ると――",
            "zh": "话说回来，为什么\n一聊到这种话题——",
            "narrator_zh": "绫水"
        },
        {
            "location": "231/TALK",
            "narrator": "アーヤ",
            "text": "こんなに大げさなほど\n騒がしくなるのかしら？",
            "zh": "就会闹腾得这么\n夸张呢？",
            "narrator_zh": "绫水"
        },
        {
            "location": "232/TALK",
            "narrator": "アーヤ",
            "text": "…やっぱり、女性だらけの\n職場だから？",
            "zh": "……果然是因为职场里\n全是女性吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "233/TALK",
            "narrator": "アーヤ",
            "text": "って、待ち合わせの\n時間に遅れちゃうし、\n早くここを離れないと…。",
            "zh": "哎呀，要赶不上约好的\n时间了，得赶紧\n离开这里才行……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "238/TALK",
            "narrator": "アーヤ",
            "text": "…ご想像にお任せします。",
            "zh": "……就留给你们自己想象吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "240/TALK",
            "narrator": "真幌",
            "text": "…なんだと？",
            "zh": "……你说什么？",
            "narrator_zh": "真幌"
        },
        {
            "location": "242/TALK",
            "narrator": "みやび",
            "text": "否定も怒りもせんとは…。",
            "zh": "既不否认也不生气……。",
            "narrator_zh": "雅"
        },
        {
            "location": "243/TALK",
            "narrator": "みやび",
            "text": "まさか、本当に合コンに\n行くが？",
            "zh": "该不会真的要去\n联谊喃？",
            "narrator_zh": "雅"
        },
        {
            "location": "245/TALK",
            "narrator": "アーヤ",
            "text": "ご想像に任せるってば。",
            "zh": "都说了任凭你们想象啦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "246/TALK",
            "narrator": "アーヤ",
            "text": "一々否定してたら\n時間に間に合わないし。",
            "zh": "一个个否认下去的话\n时间就要来不及了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "250/TALK",
            "narrator": "みやび",
            "text": "まほさん、\nこれは事件ながですよ。",
            "zh": "真幌，\n这可是大事件咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "251/TALK",
            "narrator": "みやび",
            "text": "冗談のつもりやった\nけんど、本当に合コン\nっぽい雰囲気です。",
            "zh": "本来只是开玩笑的，\n不过听着还真有\n几分像联谊咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "253/TALK",
            "narrator": "真幌",
            "text": "ああ…\nだが、めでたいことだ。",
            "zh": "嗯……\n不过，这也是件好事。",
            "narrator_zh": "真幌"
        },
        {
            "location": "255/TALK",
            "narrator": "真幌",
            "text": "アーヤ、めかしこむのは\n良いが、あまり露出が\n激しいのは避けるんだぞ。",
            "zh": "绫水，打扮一下倒无妨，\n但别穿得太暴露\n了啊。",
            "narrator_zh": "真幌"
        },
        {
            "location": "256/TALK",
            "narrator": "真幌",
            "text": "男は適度な露出を好む\n生き物だからな。",
            "zh": "男人可是最喜欢适度\n露肤的生物。",
            "narrator_zh": "真幌"
        },
        {
            "location": "259/TALK",
            "narrator": "みやび",
            "text": "飲み過ぎにも\n注意するがよ。",
            "zh": "也注意别喝\n太多啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "261/TALK",
            "narrator": "みやび",
            "text": "男は狼や、グリズリーや、\n飢えたライオンや！",
            "zh": "男人都是狼、是灰熊、\n是饥饿的狮子咯！",
            "narrator_zh": "雅"
        },
        {
            "location": "265/TALK",
            "narrator": "アーヤ",
            "text": "はいはい…とにかく、\n行ってきますね。",
            "zh": "好好好……总之，\n我先走了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "266/TALK",
            "narrator": "真幌",
            "text": "朝帰りは許さんからな！",
            "zh": "不准夜不归宿啊！",
            "narrator_zh": "真幌"
        },
        {
            "location": "269/TALK",
            "narrator": "アーヤ",
            "text": "しません！\nまったく…。",
            "zh": "不会的！\n真是的……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "273/TALK",
            "narrator": "アーヤ",
            "text": "…でも、そういう\nオシャレもできるように、\n練習しておこうかしら？",
            "zh": "……不过，为了以后也能\n那样打扮，要不要事先\n练习一下呢？",
            "narrator_zh": "绫水"
        },
        {
            "location": "291/ACT",
            "narrator": "",
            "text": "合コンだな！？",
            "zh": "是联谊吧！？",
            "narrator_zh": ""
        },
        {
            "location": "311/TALK",
            "narrator": "アーヤ",
            "text": "あなたまで何言い出すの！？",
            "zh": "怎么连你也跟着起哄！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "312/TALK",
            "narrator": "アーヤ",
            "text": "ってか、そういうタイプじゃないでしょ、私(＞＜*)",
            "zh": "再说我也不是那种类型吧(＞＜*)",
            "narrator_zh": "绫水"
        },
        {
            "location": "323/TALK",
            "narrator": "アーヤ",
            "text": "盛り上がってる空気\n壊しますけど――",
            "zh": "虽然要扫一下\n大家的兴——",
            "narrator_zh": "绫水"
        },
        {
            "location": "325/TALK",
            "narrator": "アーヤ",
            "text": "本当に普通の\n食事会ですから。",
            "zh": "其实真的只是\n普通的聚餐而已。",
            "narrator_zh": "绫水"
        },
        {
            "location": "326/TALK",
            "narrator": "アーヤ",
            "text": "男性参加者ゼロの、\n完全な女子会です。",
            "zh": "男性参与者为零，\n彻头彻尾的女生聚会。",
            "narrator_zh": "绫水"
        },
        {
            "location": "328/TALK",
            "narrator": "真幌",
            "text": "…男は一人も来ないのか？",
            "zh": "……一个男的都不来吗？",
            "narrator_zh": "真幌"
        },
        {
            "location": "330/TALK",
            "narrator": "アーヤ",
            "text": "来ませんし、誘うような\n男の知り合いもいません。",
            "zh": "不来，而且也没有能\n叫来一起吃饭的男性熟人。",
            "narrator_zh": "绫水"
        },
        {
            "location": "332/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "334/TALK",
            "narrator": "みやび",
            "text": "まあ、そんなことかとは\n思うてたがよ。",
            "zh": "嘛，我原本也猜到\n多半是这么回事咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "336/TALK",
            "narrator": "真幌",
            "text": "だな…アーヤのことだ、\nまず合コンなんて\nありえんからな。",
            "zh": "也是……以绫水的性格，\n压根不可能去联谊\n的。",
            "narrator_zh": "真幌"
        },
        {
            "location": "338/TALK",
            "narrator": "アーヤ",
            "text": "もう…やっぱり\nからかってたんですね？",
            "zh": "真是的……果然\n是在逗我玩对吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "339/TALK",
            "narrator": "真幌",
            "text": "すまんすまん。",
            "zh": "抱歉抱歉。",
            "narrator_zh": "真幌"
        },
        {
            "location": "340/TALK",
            "narrator": "真幌",
            "text": "だが、アーヤだって\nもう子供じゃないんだ。",
            "zh": "不过，绫水你也\n不是小孩子了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "341/TALK",
            "narrator": "真幌",
            "text": "一度くらいは経験しても\nいいと、私は思うぞ。",
            "zh": "我倒觉得偶尔体验\n一回也不错啊。",
            "narrator_zh": "真幌"
        },
        {
            "location": "344/TALK",
            "narrator": "アーヤ",
            "text": "今はいいです。\nそれより、時間ないんで\nそろそろ行きますね。",
            "zh": "现在还不用。\n比起这个，时间不早了\n我先走了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "348/TALK",
            "narrator": "みやび",
            "text": "…まだしばらくは、\nアーヤの春は来そうに\nないがですね。",
            "zh": "……看来再过阵子，\n绫水的春天也还是\n来不了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "350/TALK",
            "narrator": "真幌",
            "text": "…おまえが言うな。",
            "zh": "……轮得到你说吗。",
            "narrator_zh": "真幌"
        },
        {
            "location": "351/ACT",
            "narrator": "",
            "text": "端末操作：着信音",
            "zh": "终端操作：来电铃声",
            "narrator_zh": ""
        },
        {
            "location": "358/TALK",
            "narrator": "アーヤ",
            "text": "あっ…！",
            "zh": "啊……！",
            "narrator_zh": "绫水"
        },
        {
            "location": "359/TALK",
            "narrator": "真幌",
            "text": "ん？\n待ち合わせ相手からか？",
            "zh": "嗯？\n是约好的人打来的吗？",
            "narrator_zh": "真幌"
        },
        {
            "location": "362/TALK",
            "narrator": "アーヤ",
            "text": "そうみたいです。\n遅れそうなので、\nそろそろ行きます。",
            "zh": "好像是的。\n快要迟到了，\n我先走了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "363/TALK",
            "narrator": "みやび",
            "text": "楽しんできいや。",
            "zh": "玩得开心啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "370/TALK",
            "narrator": "アーヤ",
            "text": "ふぅ…。",
            "zh": "呼……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "382/TALK",
            "narrator": "アーヤ",
            "text": "ナイスタイミング(≧∇≦)b",
            "zh": "时机太棒了(≧∇≦)b",
            "narrator_zh": "绫水"
        },
        {
            "location": "384/TALK",
            "narrator": "アーヤ",
            "text": "おかげで助かったわ",
            "zh": "多亏你才脱身了",
            "narrator_zh": "绫水"
        },
        {
            "location": "386/SEL",
            "narrator": "",
            "text": "からかわれてたみたいだね",
            "zh": "好像被她们逗了一通呢",
            "narrator_zh": ""
        },
        {
            "location": "387/ACT",
            "narrator": "",
            "text": "からかわれてたみたいだね",
            "zh": "好像被她们逗了一通呢",
            "narrator_zh": ""
        },
        {
            "location": "389/TALK",
            "narrator": "アーヤ",
            "text": "うん",
            "zh": "嗯",
            "narrator_zh": "绫水"
        },
        {
            "location": "390/TALK",
            "narrator": "アーヤ",
            "text": "館長達も、本気で合コンに行くとは思ってないはず",
            "zh": "馆长她们应该也不是真觉得我会去联谊",
            "narrator_zh": "绫水"
        },
        {
            "location": "394/TALK",
            "narrator": "アーヤ",
            "text": "けど、",
            "zh": "不过，",
            "narrator_zh": "绫水"
        },
        {
            "location": "396/TALK",
            "narrator": "アーヤ",
            "text": "もしかしたら、とは思ってるのかも…(-ω-;)",
            "zh": "说不定心里还真有过一丁点这种念头……(-ω-;)",
            "narrator_zh": "绫水"
        },
        {
            "location": "397/TALK",
            "narrator": "アーヤ",
            "text": "やっぱり、この年で一度も行ったことないのは、マズいかしら？",
            "zh": "果然，到这个年纪一次联谊都没去过，不太妙吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "398/TALK",
            "narrator": "アーヤ",
            "text": "…考えても仕方ないことだけどね",
            "zh": "……虽然想了也没用就是了",
            "narrator_zh": "绫水"
        },
        {
            "location": "176/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>7月17日　5:45 PM</color>\nとある平日の夕方、神楽坂トライナリー劇場にて。",
            "zh": "<color=green>7月17日　5:45 PM</color>\n某天平日傍晚，在神乐坂三重奏剧场。",
            "narrator_zh": "Dialog_EventData"
        },
        {
            "location": "284/DIALOG",
            "narrator": "Dialog_GEThimegoto_ch02",
            "text": "【コンは来んのコン】",
            "zh": "【联谊是不会来的联】",
            "narrator_zh": "Dialog_GEThimegoto_ch02"
        }
    ]
}
