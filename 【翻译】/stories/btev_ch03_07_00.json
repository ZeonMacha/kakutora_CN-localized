{
    "dir": "chap07/battle/btev_ch03_07_00.js",
    "type": "",
    "info": {
        "story_id": "23010",
        "cid": "",
        "title": "010 ココロスフィアストーリー【Lv04】",
        "sub_title": "オールニーズユー＜提起＞",
        "title_zh": "010 心灵领域故事【Lv04】",
        "sub_title_zh": "大家都需要你＜提起＞"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "オールニーズユー",
            "zh": "大家都需要你",
            "narrator_zh": ""
        },
        {
            "location": "13/DIALOG",
            "narrator": "",
            "text": "<size=40>KOKORO-Lv. 04</size>\nGABRIELLA\n\n<size=45>オールニーズユー</size>\n<size=35>～あたしは如何ほど必要ですか？～</size>",
            "zh": "<size=40>KOKORO-Lv. 04</size>\n加布里埃拉\n\n<size=45>大家都需要你</size>\n<size=35>～我究竟有多被需要？～</size>",
            "narrator_zh": ""
        },
        {
            "location": "26/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィさん。",
            "zh": "加维。",
            "narrator_zh": "绫水"
        },
        {
            "location": "28/TALK",
            "narrator": "ガブリエラ",
            "text": "は、はい、國政部長。\nなんでしょうか？",
            "zh": "是、是的，国政部长。\n请问有什么事？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "31/TALK",
            "narrator": "アーヤ",
            "text": "あなた、確か……\n銃器スキルの\n専門だったっけ？",
            "zh": "你我记得……\n是专精枪械技能\n来着吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "32/TALK",
            "narrator": "ガブリエラ",
            "text": "は、はい！\nそうです！",
            "zh": "是、是的！\n没错！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "33/TALK",
            "narrator": "アーヤ",
            "text": "他に何か、役にたつ\nスキルって\n持ってたかしら？",
            "zh": "除此之外，\n你还有什么派得上用场的\n技能吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "36/TALK",
            "narrator": "ガブリエラ",
            "text": "え？\nそれは……\n特に無いです。",
            "zh": "诶？\n那个……\n特别拿手的倒是没有。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "39/TALK",
            "narrator": "アーヤ",
            "text": "そう。",
            "zh": "这样啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "42/TALK",
            "narrator": "アーヤ",
            "text": "正直今、我が社では\n銃器スキルは\n要らないのよね。",
            "zh": "说实话，我们公司现在\n用不上枪械技能\n了哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "44/TALK",
            "narrator": "ガブリエラ",
            "text": "え！？",
            "zh": "诶！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "48/TALK",
            "narrator": "千羽鶴",
            "text": "それじゃ。\n健闘を祈る。",
            "zh": "那么。\n祝你好运。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "53/TALK",
            "narrator": "アーヤ",
            "text": "今年の社のビジョンが\n【突撃と破壊】に\nなったから。",
            "zh": "因为今年公司的愿景\n变成了\n【突击与破坏】。",
            "narrator_zh": "绫水"
        },
        {
            "location": "55/TALK",
            "narrator": "アーヤ",
            "text": "正直もう\nスキル的に\n役に立たないのよ。",
            "zh": "说实话，从技能上讲，\n已经派不上\n用场了哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "57/TALK",
            "narrator": "ガブリエラ",
            "text": "そ、そんな！\nいきなりは酷いです！",
            "zh": "怎、怎么这样！\n这也太突然了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "58/TALK",
            "narrator": "アーヤ",
            "text": "そうは言っても\n会社の方針だから。",
            "zh": "话虽如此，\n这也是公司的方针。",
            "narrator_zh": "绫水"
        },
        {
            "location": "59/TALK",
            "narrator": "アーヤ",
            "text": "まあ、銃のスキルを\n必要としてる会社も\nあると思うし――",
            "zh": "嘛，我想应该也有\n需要枪械技能的公司\n——",
            "narrator_zh": "绫水"
        },
        {
            "location": "60/TALK",
            "narrator": "アーヤ",
            "text": "この機会にその\nキャリアを活かせる\n会社に転職する方が…",
            "zh": "趁这个机会，跳槽去\n能发挥这身履历的公司\n说不定更……",
            "narrator_zh": "绫水"
        },
        {
            "location": "61/SEL",
            "narrator": "（選択肢）",
            "text": "残りたいって言うんだ！",
            "zh": "快说你想留下来！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "62/SEL",
            "narrator": "（選択肢）",
            "text": "こんな会社やめちまえ！",
            "zh": "这种破公司干脆辞了算了！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "63/ACT",
            "narrator": "",
            "text": "残りたいって言うんだ！",
            "zh": "快说你想留下来！",
            "narrator_zh": ""
        },
        {
            "location": "66/TALK",
            "narrator": "ガブリエラ",
            "text": "え！？\nあ、うん。",
            "zh": "诶！？\n啊，嗯。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "68/TALK",
            "narrator": "ガブリエラ",
            "text": "の、残りたいです！",
            "zh": "我、我想留下来！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "71/TALK",
            "narrator": "アーヤ",
            "text": "うーん、\nそうは言ってもね。",
            "zh": "唔嗯，\n话虽这么说。",
            "narrator_zh": "绫水"
        },
        {
            "location": "73/TALK",
            "narrator": "アーヤ",
            "text": "うちに残っても、\n今後何のチャンスも\n無いわよ？",
            "zh": "就算留在我们这儿，\n今后也不会有任何\n机会了哦？",
            "narrator_zh": "绫水"
        },
        {
            "location": "74/ACT",
            "narrator": "",
            "text": "こんな会社やめちまえ！",
            "zh": "这种破公司干脆辞了算了！",
            "narrator_zh": ""
        },
        {
            "location": "75/TALK",
            "narrator": "ガブリエラ",
            "text": "えええっ！？",
            "zh": "诶诶诶！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "77/TALK",
            "narrator": "ガブリエラ",
            "text": "そんな急に無理よ！！",
            "zh": "这么突然怎么可能办得到！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "82/TALK",
            "narrator": "アーヤ",
            "text": "まあ、よく考えてみて。\nそれと、\n残念だけど――",
            "zh": "嘛，你好好考虑一下吧。\n还有，\n虽然很遗憾——",
            "narrator_zh": "绫水"
        },
        {
            "location": "83/TALK",
            "narrator": "アーヤ",
            "text": "今期からギャヴィさん\n配属プロジェクトは\n特に無いから。",
            "zh": "从这一季开始，\n加维并没有\n被分派到什么项目。",
            "narrator_zh": "绫水"
        },
        {
            "location": "84/TALK",
            "narrator": "アーヤ",
            "text": "それじゃ。",
            "zh": "就这样吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "86/TALK",
            "narrator": "アーヤ",
            "text": "はぁ、忙しい忙しい。",
            "zh": "哈啊，真忙啊真忙啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "89/TALK",
            "narrator": "ガブリエラ",
            "text": "…そ、そんな……。",
            "zh": "……怎、怎么会……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "100/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ……\nまさかこんな事に\nなるなんて。",
            "zh": "哈啊……\n没想到会变成\n这样。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "101/TALK",
            "narrator": "ガブリエラ",
            "text": "銃器スキル以外にも\n色んなキャリアを\n積んでおけばよかった。",
            "zh": "要是除了枪械技能以外，\n还多攒点别的履历\n就好了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "102/TALK",
            "narrator": "ガブリエラ",
            "text": "……銃も\nおもちゃのコルク銃に\n替えられちゃったし。",
            "zh": "……连枪\n都被换成玩具\n软木塞枪了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "104/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ……。",
            "zh": "哈啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "106/TALK",
            "narrator": "つばめ",
            "text": "せんぱい！",
            "zh": "前辈！",
            "narrator_zh": "燕"
        },
        {
            "location": "108/TALK",
            "narrator": "ガブリエラ",
            "text": "あら、つばめ。",
            "zh": "哎呀，燕。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "109/TALK",
            "narrator": "つばめ",
            "text": "わたし来期から\n新プロジェクトの\n副主任になりました！",
            "zh": "我从下一季开始\n要担任新项目的\n副主任了！",
            "narrator_zh": "燕"
        },
        {
            "location": "111/TALK",
            "narrator": "ガブリエラ",
            "text": "え！？\nあ、そう……。\nよ、よかったわね。",
            "zh": "诶！？\n啊，是吗……。\n那、那真是太好了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "113/TALK",
            "narrator": "つばめ",
            "text": "せんぱいは次は\n何のプロジェクト\nやるんですか？",
            "zh": "前辈接下来\n要负责什么\n项目呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "114/TALK",
            "narrator": "ガブリエラ",
            "text": "え？\n何だっていいでしょ？",
            "zh": "诶？\n管我负责什么呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "115/TALK",
            "narrator": "つばめ",
            "text": "えー、\nもったいぶらずに\n教えてくださいよ。",
            "zh": "诶——，\n别藏着掖着了，\n告诉我嘛。",
            "narrator_zh": "燕"
        },
        {
            "location": "116/TALK",
            "narrator": "ガブリエラ",
            "text": "……あんた、\nあたしのこと\n聞いてないの？",
            "zh": "……你，\n没听说我的\n事吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "117/TALK",
            "narrator": "つばめ",
            "text": "もちろん聞いてますよ。\nわざとに決まってる\nじゃないですか！",
            "zh": "当然听说过哦。\n我肯定是故意的\n嘛！",
            "narrator_zh": "燕"
        },
        {
            "location": "118/TALK",
            "narrator": "ガブリエラ",
            "text": "まさか、いじめ！？\n……まさか、\nまさかね。",
            "zh": "难道这是职场欺凌！？\n……不至于，\n不至于吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "122/TALK",
            "narrator": "つばめ",
            "text": "それにしても、\nなんかオフィスが\n暑くないですか？",
            "zh": "话说回来，\n办公室是不是\n有点热呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "123/TALK",
            "narrator": "ガブリエラ",
            "text": "……誰かが\nエアコンの設定\n触ったんじゃないの？",
            "zh": "……是谁碰了\n空调设定\n吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "124/TALK",
            "narrator": "つばめ",
            "text": "せんぱい、温度\n下げてもらって\nいいですか？",
            "zh": "前辈，能麻烦你\n把温度调低\n一点吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "125/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ！？\nなんであたしが！",
            "zh": "哈啊！？\n为什么偏要我去！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "126/TALK",
            "narrator": "つばめ",
            "text": "せんぱいならここから\n銃で、壁にあるリモコン\nボタン押せますよね？",
            "zh": "前辈的话，从这里用枪\n就能打中墙上遥控器的\n按钮吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "127/TALK",
            "narrator": "ガブリエラ",
            "text": "いや、それくらい\nできるけど……",
            "zh": "不，这点事倒是\n做得到……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "128/TALK",
            "narrator": "つばめ",
            "text": "もう銃スキルなんて\nそれくらいの価値しか\nないんですから――",
            "zh": "反正枪械技能现在\n也就只剩这点价值了\n——",
            "narrator_zh": "燕"
        },
        {
            "location": "129/TALK",
            "narrator": "つばめ",
            "text": "早くリモコンの温度\n下げるボタンを狙い\n撃ちしてください！",
            "zh": "快点瞄准遥控器上\n调低温度的按钮\n开枪吧！",
            "narrator_zh": "燕"
        },
        {
            "location": "131/TALK",
            "narrator": "ガブリエラ",
            "text": "…っ……。\nわ、わかったわよ。",
            "zh": "……唔……。\n知、知道了啦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "183/TALK",
            "narrator": "ガブリエラ",
            "text": "…はい。\n３℃度下げたわよ。",
            "zh": "……好了。\n调低3℃了哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "184/TALK",
            "narrator": "つばめ",
            "text": "ありがとう\nございます！",
            "zh": "谢谢\n前辈！",
            "narrator_zh": "燕"
        },
        {
            "location": "185/TALK",
            "narrator": "つばめ",
            "text": "それじゃせんぱい、\nわたし会議なので\n行きますね！",
            "zh": "那前辈，\n我要去开会了，\n先走一步啦！",
            "narrator_zh": "燕"
        },
        {
            "location": "186/TALK",
            "narrator": "つばめ",
            "text": "新しい職場でも\n頑張ってください！",
            "zh": "在新的职场\n也要加油哦！",
            "narrator_zh": "燕"
        },
        {
            "location": "190/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょ！\nちょっと…",
            "zh": "等！\n等一下……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "193/TALK",
            "narrator": "みやび",
            "text": "ガブちゃん！",
            "zh": "加布！",
            "narrator_zh": "雅"
        },
        {
            "location": "194/TALK",
            "narrator": "ガブリエラ",
            "text": "あら、みやび……。",
            "zh": "哎呀，雅……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "195/TALK",
            "narrator": "みやび",
            "text": "すまんがちくっと\n喉が渇いたき――",
            "zh": "没好意思，我有点\n口渴了啵——",
            "narrator_zh": "雅"
        },
        {
            "location": "196/TALK",
            "narrator": "みやび",
            "text": "そこの窓から外の\n自販機でほうじ茶\n買うてくれんか。",
            "zh": "从那边的窗户，在外面\n自动贩卖机给我买瓶\n焙茶得咩。",
            "narrator_zh": "雅"
        },
        {
            "location": "197/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ！？\n自分で買いに\n行きなさいよ！",
            "zh": "哈啊！？\n你自己去买\n不行吗！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "198/TALK",
            "narrator": "みやび",
            "text": "ガブちゃん……\nここ、５階やぞ？",
            "zh": "加布……\n这里可是五楼啵？",
            "narrator_zh": "雅"
        },
        {
            "location": "199/TALK",
            "narrator": "みやび",
            "text": "うちを１階まで\n行かせる気か？",
            "zh": "你想让我\n走到一楼去咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "201/TALK",
            "narrator": "ガブリエラ",
            "text": "……はあ！？",
            "zh": "……哈啊！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "202/TALK",
            "narrator": "みやび",
            "text": "その無価値な\n銃器スキルに価値を\n見いだしてやったのに。",
            "zh": "我还特意给你那\n毫无价值的枪械技能\n找到了用处咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "204/TALK",
            "narrator": "みやび",
            "text": "…ここから買うて\nくれれば次の部会で\nヨイショしちゃるよ？",
            "zh": "……只要从这儿买来，\n下次部会上我给你\n捧一哈场咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "205/TALK",
            "narrator": "ガブリエラ",
            "text": "わ、わかったわよ！",
            "zh": "知、知道了啦！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "233/TALK",
            "narrator": "みやび",
            "text": "流石ガブちゃん。\n的確にほうじ茶の\nボタン押したね。",
            "zh": "不愧是加布。\n准准按中了焙茶\n的按钮呀。",
            "narrator_zh": "雅"
        },
        {
            "location": "235/TALK",
            "narrator": "みやび",
            "text": "それじゃ、すぐに\n取ってきてや。",
            "zh": "那就，快点\n去拿上来啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "237/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ！？\nなっ……",
            "zh": "哈啊！？\n什……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "238/TALK",
            "narrator": "ガブリエラ",
            "text": "それじゃここから\n銃でボタン押す意味\n無いじゃない……！",
            "zh": "那样的话，从这儿\n用枪按按钮不就毫无\n意义了吗……！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "241/TALK",
            "narrator": "神楽",
            "text": "ガブちゃん。",
            "zh": "加布。",
            "narrator_zh": "神乐"
        },
        {
            "location": "242/TALK",
            "narrator": "ガブリエラ",
            "text": "神楽……。\nまさか、あんたも…",
            "zh": "神乐……。\n难道说，连你也……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "244/TALK",
            "narrator": "神楽",
            "text": "どうしたんですか？\nそんな険しい顔して。",
            "zh": "怎么了吗？\n摆出这么严肃的表情。",
            "narrator_zh": "神乐"
        },
        {
            "location": "245/TALK",
            "narrator": "ガブリエラ",
            "text": "あんたもあたしに\n何か頼み事を\nしに来たのかしら…？",
            "zh": "难道你也是来\n拜托我帮忙\n跑腿的吗……？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "247/TALK",
            "narrator": "神楽",
            "text": "違いますよ。\nお花を摘みに行った\n帰りです。",
            "zh": "才不是呢。\n我是去摘了朵花\n刚回来。",
            "narrator_zh": "神乐"
        },
        {
            "location": "248/TALK",
            "narrator": "ガブリエラ",
            "text": "なんだ、\nよかったわ…。",
            "zh": "原来是这样，\n那就好……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "251/TALK",
            "narrator": "ガブリエラ",
            "text": "……？",
            "zh": "……？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "253/TALK",
            "narrator": "ガブリエラ",
            "text": "なんか水の音が\nするんだけど……？",
            "zh": "怎么好像听见\n流水的声音……？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "255/TALK",
            "narrator": "神楽",
            "text": "ああっ！\nそういえば！",
            "zh": "啊啊！\n说起来！",
            "narrator_zh": "神乐"
        },
        {
            "location": "256/TALK",
            "narrator": "神楽",
            "text": "手を洗ってそのまま\n水道出しっ放し\nでした…っ！",
            "zh": "我洗完手之后，\n水龙头忘关\n一直流着呢……！",
            "narrator_zh": "神乐"
        },
        {
            "location": "259/TALK",
            "narrator": "ガブリエラ",
            "text": "何やってるんだか…。",
            "zh": "真是搞什么呀……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "260/TALK",
            "narrator": "神楽",
            "text": "すみません、\nガブちゃん水道の蛇口\n締めてください！",
            "zh": "不好意思，\n加布，麻烦你把\n水龙头拧紧吧！",
            "narrator_zh": "神乐"
        },
        {
            "location": "261/TALK",
            "narrator": "ガブリエラ",
            "text": "何であたしが！",
            "zh": "凭什么是我去啊！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "262/TALK",
            "narrator": "神楽",
            "text": "銃でここから蛇口\n狙い撃ちすれば\n締められますよね？",
            "zh": "从这里用枪瞄准\n水龙头开一枪，\n就能关上了吧？",
            "narrator_zh": "神乐"
        },
        {
            "location": "263/TALK",
            "narrator": "神楽",
            "text": "それくらいしか\n価値が無いスキル\nなんですから――",
            "zh": "毕竟是只剩下这点\n价值的技能\n嘛——",
            "narrator_zh": "神乐"
        },
        {
            "location": "266/TALK",
            "narrator": "神楽",
            "text": "やってくれたって\nいいじゃないですか。",
            "zh": "帮我打一下\n不也挺好的嘛。",
            "narrator_zh": "神乐"
        },
        {
            "location": "267/TALK",
            "narrator": "ガブリエラ",
            "text": "…っ。\nなんで？なんで\nあたしがこんな目に！",
            "zh": "……唔。\n为什么？为什么\n我要沦落到这种地步！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "297/TALK",
            "narrator": "神楽",
            "text": "さすが\nガブちゃんですっ！",
            "zh": "真不愧是\n加布呀！",
            "narrator_zh": "神乐"
        },
        {
            "location": "298/TALK",
            "narrator": "神楽",
            "text": "それじゃ私、\nこれから役員会に\n行ってきますね。",
            "zh": "那么我接下来\n要去参加董事会议，\n先走一步了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "299/TALK",
            "narrator": "ガブリエラ",
            "text": "あんた、いつの間に\n役員になってるのよ！",
            "zh": "你、你什么时候\n混成董事了啊！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "300/TALK",
            "narrator": "神楽",
            "text": "入社してすぐですよ。\nだって私は――",
            "zh": "一进公司就是了呀。\n因为我可是——",
            "narrator_zh": "神乐"
        },
        {
            "location": "301/TALK",
            "narrator": "神楽",
            "text": "鎌、飛行、柔術、\nアクロバットに\n斬撃、突撃――",
            "zh": "镰刀、飞行、柔术、\n杂技外加\n斩击、突击——",
            "narrator_zh": "神乐"
        },
        {
            "location": "302/TALK",
            "narrator": "神楽",
            "text": "更に歌って踊れて\n絵もお話も\n描けちゃいますから♪",
            "zh": "而且还能唱能跳，\n画画和写故事\n全都拿手哦♪",
            "narrator_zh": "神乐"
        },
        {
            "location": "306/TALK",
            "narrator": "神楽",
            "text": "一点集中型の\nガブちゃんと違って\n潰しがきくんですよっ。",
            "zh": "和一点集中型的\n加布不一样，\n我可是到处都派得上用场哦。",
            "narrator_zh": "神乐"
        },
        {
            "location": "308/TALK",
            "narrator": "神楽",
            "text": "それじゃです♪",
            "zh": "那就失陪啦♪",
            "narrator_zh": "神乐"
        },
        {
            "location": "312/TALK",
            "narrator": "ガブリエラ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "313/TALK",
            "narrator": "ガブリエラ",
            "text": "………。",
            "zh": "………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "314/TALK",
            "narrator": "ガブリエラ",
            "text": "こんな会社、\nもうやめたい……。",
            "zh": "这种破公司，\n真不想干了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "315/TALK",
            "narrator": "ガブリエラ",
            "text": "やめてやる！",
            "zh": "我不干了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "316/SEL",
            "narrator": "（選択肢）",
            "text": "待って待って！",
            "zh": "等等等等！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "317/SEL",
            "narrator": "（選択肢）",
            "text": "そうだそうだ！",
            "zh": "说得对说得对！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "318/ACT",
            "narrator": "",
            "text": "待って待って！",
            "zh": "等等等等！",
            "narrator_zh": ""
        },
        {
            "location": "320/TALK",
            "narrator": "ガブリエラ",
            "text": "ううん、もう無理！",
            "zh": "不行，我已经受够了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "321/ACT",
            "narrator": "",
            "text": "そうだそうだ！",
            "zh": "说得对说得对！",
            "narrator_zh": ""
        },
        {
            "location": "323/TALK",
            "narrator": "ガブリエラ",
            "text": "$handle$もそう\n思ってくれるのね！",
            "zh": "连$handle$也\n这么觉得对吧！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "326/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしは雑用や鞄持ち\nみたいな仕事する為に\n来たんじゃないわ！",
            "zh": "我可不是为了\n做杂役和拎包小妹\n这种活才来的！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "327/TALK",
            "narrator": "ガブリエラ",
            "text": "こんなことしか\n出来ないなら\n別の仕事につく！",
            "zh": "要是只能干这种事，\n我还不如去\n找别的工作！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "332/TALK",
            "narrator": "アーヤ",
            "text": "そうね。\nそれがいいと思うわ。",
            "zh": "是啊。\n我觉得这样挺好。",
            "narrator_zh": "绫水"
        },
        {
            "location": "334/TALK",
            "narrator": "ガブリエラ",
            "text": "部長！？",
            "zh": "部长！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "336/TALK",
            "narrator": "アーヤ",
            "text": "貴方の力を必要とする\n場所は他に沢山ある。\n例えば――",
            "zh": "需要你力量\n的地方还有很多。\n比如说——",
            "narrator_zh": "绫水"
        },
        {
            "location": "337/TALK",
            "narrator": "アーヤ",
            "text": "ポーランドとか。",
            "zh": "波兰之类的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "339/TALK",
            "narrator": "ガブリエラ",
            "text": "…っ。",
            "zh": "……唔。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "340/TALK",
            "narrator": "アーヤ",
            "text": "今、祖国は\n内戦状態なんでしょ？",
            "zh": "现在你的祖国\n不是正在内战状态吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "341/TALK",
            "narrator": "アーヤ",
            "text": "貴方の力が\n役にたつと\n思うんだけど？",
            "zh": "我觉得你的力量\n在那里能派上\n用场吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "343/TALK",
            "narrator": "ガブリエラ",
            "text": "……そうね。",
            "zh": "……是啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "344/SEL",
            "narrator": "（選択肢）",
            "text": "待て！コイツを倒そう！",
            "zh": "慢着！打倒这家伙！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "345/SEL",
            "narrator": "（選択肢）",
            "text": "確かに、それがいいかもね",
            "zh": "确实，那样也许不错呢",
            "narrator_zh": "（选项）"
        },
        {
            "location": "346/ACT",
            "narrator": "",
            "text": "待て！コイツを倒そう！",
            "zh": "慢着！打倒这家伙！",
            "narrator_zh": ""
        },
        {
            "location": "352/DIALOG",
            "narrator": "",
            "text": "ゴキゲンポイントが\n<size=40><color=red><b>500pt.</b></color></size>\nアップしました！",
            "zh": "心情点数\n<size=40><color=red><b>500pt.</b></color></size>\n增加了！",
            "narrator_zh": ""
        },
        {
            "location": "358/TALK",
            "narrator": "ガブリエラ",
            "text": "え、えええ！？\n國政部長を！？\n無理よそんなの！",
            "zh": "诶、诶诶诶！？\n打倒国政部长！？\n那种事怎么可能办得到！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "359/SEL",
            "narrator": "（選択肢）",
            "text": "これはアーヤじゃないよ",
            "zh": "这不是绫水哦",
            "narrator_zh": "（选项）"
        },
        {
            "location": "360/ACT",
            "narrator": "",
            "text": "これはアーヤじゃないよ",
            "zh": "这不是绫水哦",
            "narrator_zh": ""
        },
        {
            "location": "363/TALK",
            "narrator": "ガブリエラ",
            "text": "何を言ってるの！？",
            "zh": "你在胡说什么呀！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "364/SEL",
            "narrator": "（選択肢）",
            "text": "ガブリエラの別人格が化けてると思う",
            "zh": "我觉得是加布里埃拉的别的人格变装的",
            "narrator_zh": "（选项）"
        },
        {
            "location": "365/ACT",
            "narrator": "",
            "text": "ガブリエラの別人格が化けてると思う",
            "zh": "我觉得是加布里埃拉的别的人格变装的",
            "narrator_zh": ""
        },
        {
            "location": "367/TALK",
            "narrator": "ガブリエラ",
            "text": "そんなハズは…",
            "zh": "怎么可能……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "368/SEL",
            "narrator": "（選択肢）",
            "text": "今までもそうだったよ",
            "zh": "之前不也一直这样吗",
            "narrator_zh": "（选项）"
        },
        {
            "location": "369/ACT",
            "narrator": "",
            "text": "今までもそうだったよ",
            "zh": "之前不也一直这样吗",
            "narrator_zh": ""
        },
        {
            "location": "372/TALK",
            "narrator": "ガブリエラ",
            "text": "信じられない！",
            "zh": "简直不敢相信！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "373/SEL",
            "narrator": "（選択肢）",
            "text": "いいから信じろ！！",
            "zh": "别管了相信我就是了！！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "374/SEL",
            "narrator": "（選択肢）",
            "text": "本当だよ！",
            "zh": "是真的哦！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "375/ACT",
            "narrator": "",
            "text": "いいから信じろ！！",
            "zh": "别管了相信我就是了！！",
            "narrator_zh": ""
        },
        {
            "location": "381/DIALOG",
            "narrator": "",
            "text": "ゴキゲンポイントが\n<size=40><color=red><b>500pt.</b></color></size>\nアップしました！",
            "zh": "心情点数\n<size=40><color=red><b>500pt.</b></color></size>\n增加了！",
            "narrator_zh": ""
        },
        {
            "location": "385/TALK",
            "narrator": "ガブリエラ",
            "text": "ひっ……！！",
            "zh": "噫……！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "386/TALK",
            "narrator": "ガブリエラ",
            "text": "わ、わかったわ。\nどうすればいいの…？",
            "zh": "知、知道了啦。\n要怎么做才好……？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "387/SEL",
            "narrator": "（選択肢）",
            "text": "アーヤを攻撃して倒す。その銃でね。",
            "zh": "攻击并打倒绫水。就用那把枪。",
            "narrator_zh": "（选项）"
        },
        {
            "location": "388/ACT",
            "narrator": "",
            "text": "アーヤを攻撃して倒す。その銃でね。",
            "zh": "攻击并打倒绫水。就用那把枪。",
            "narrator_zh": ""
        },
        {
            "location": "391/TALK",
            "narrator": "アーヤ",
            "text": "ちょっと貴方。\n何を言ってるの！？",
            "zh": "我说你。\n在胡说些什么！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "393/TALK",
            "narrator": "アーヤ",
            "text": "上司に逆らったら\n即刻クビよ！？",
            "zh": "违抗上司的话\n可是会被立刻裁掉的哦！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "396/TALK",
            "narrator": "ガブリエラ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "397/TALK",
            "narrator": "ガブリエラ",
            "text": "…っ！",
            "zh": "……唔！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "398/TALK",
            "narrator": "アーヤ",
            "text": "…そう。わかった。\nそれじゃお望み通り\nクビにしてあげる。",
            "zh": "……这样。明白了。\n那就如你所愿，\n把你裁掉吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "399/TALK",
            "narrator": "アーヤ",
            "text": "物理的に\n首を切ることでね！",
            "zh": "用物理上\n把脖子砍断的方式哦！",
            "narrator_zh": "绫水"
        },
        {
            "location": "401/TALK",
            "narrator": "ガブリエラ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "402/TALK",
            "narrator": "アーヤ",
            "text": "出でよ、クラン！",
            "zh": "出来吧，库兰！",
            "narrator_zh": "绫水"
        },
        {
            "location": "414/DIALOG",
            "narrator": "",
            "text": "<color=black><size=50><b>パワハラ上司と化した\nアーヤを倒せ！</b></size></color>\n\n\n\nガブリエラの心の中で\nとある心配が元となって暴走した\nアーヤのイメージ。\n\n無理難題を吹っかけてくる\nアーヤの虚像を倒し、\nその出現のルーツを探ろう。",
            "zh": "<color=black><size=50><b>打倒化身职权骚扰上司的\n绫水！</b></size></color>\n\n\n\n在加布里埃拉的心中，\n源于某种担忧而失控暴走的\n绫水形象。\n\n打倒不断提出无理刁难的\n绫水虚像，\n去探寻她出现的根源吧。",
            "narrator_zh": ""
        },
        {
            "location": "416/ACT",
            "narrator": "",
            "text": "本当だよ！",
            "zh": "是真的哦！",
            "narrator_zh": ""
        },
        {
            "location": "417/TALK",
            "narrator": "ガブリエラ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "419/TALK",
            "narrator": "ガブリエラ",
            "text": "やっぱり無理。\nあたし、ポーランドに\n帰ろうかしら。",
            "zh": "果然还是不行。\n我啊，要不回波兰\n算了。",
            "narrator_zh": "加布里埃拉"
