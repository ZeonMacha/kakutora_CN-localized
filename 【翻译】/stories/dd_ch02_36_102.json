{
    "dir": "chap36/daydra/dd_ch02_36_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "36205",
        "cid": "ayami",
        "title": "005 メインストーリー",
        "sub_title": "日常の中の約束を＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "日常之中的约定＜后篇＞"
    },
    "entry": [
        {
            "location": "434/SCENARIO",
            "narrator": "",
            "text": "二重写しの真実を",
            "zh": "双重映射的真相",
            "narrator_zh": ""
        },
        {
            "location": "453/TALK",
            "narrator": "アーヤ",
            "text": "何これ…？\nお姉ちゃんが死んだ？\nお姉ちゃんは死んでた？",
            "zh": "怎么回事……？\n姐姐死了？\n姐姐本来已经死了吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "454/TALK",
            "narrator": "アーヤ",
            "text": "そんなことない！",
            "zh": "不可能有这种事！",
            "narrator_zh": "绫水"
        },
        {
            "location": "455/TALK",
            "narrator": "アーヤ",
            "text": "だってあの後も連絡\nくれたじゃない。",
            "zh": "因为那之后她明明\n还联系过我啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "456/TALK",
            "narrator": "アーヤ",
            "text": "変なロボットとか\nメッセージとか。\nそれにビデオだって。",
            "zh": "奇怪的机器人啊\n消息之类的。\n还有视频也是。",
            "narrator_zh": "绫水"
        },
        {
            "location": "457/TALK",
            "narrator": "アーヤ",
            "text": "……頭、痛い……。",
            "zh": "……头，好痛……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "458/TALK",
            "narrator": "アーヤ",
            "text": "ねえ。",
            "zh": "呐。",
            "narrator_zh": "绫水"
        },
        {
            "location": "459/TALK",
            "narrator": "アーヤ",
            "text": "お姉ちゃんって本当は\n生きてるの？\n死んでるの？",
            "zh": "姐姐她其实\n是活着的？\n还是死了？",
            "narrator_zh": "绫水"
        },
        {
            "location": "460/SEL",
            "narrator": "",
            "text": "わからない",
            "zh": "不知道",
            "narrator_zh": ""
        },
        {
            "location": "461/SEL",
            "narrator": "",
            "text": "きっと死んでない",
            "zh": "她一定没死",
            "narrator_zh": ""
        },
        {
            "location": "462/SEL",
            "narrator": "",
            "text": "どこか別の世界にいるんだよ",
            "zh": "说不定是在某个别的世界里哦",
            "narrator_zh": ""
        },
        {
            "location": "463/ACT",
            "narrator": "",
            "text": "わからない",
            "zh": "不知道",
            "narrator_zh": ""
        },
        {
            "location": "465/TALK",
            "narrator": "アーヤ",
            "text": "そう……。",
            "zh": "这样啊……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "466/SEL",
            "narrator": "",
            "text": "ごめんね",
            "zh": "抱歉",
            "narrator_zh": ""
        },
        {
            "location": "467/SEL",
            "narrator": "",
            "text": "アーヤはどう思う？",
            "zh": "绫水自己怎么想？",
            "narrator_zh": ""
        },
        {
            "location": "468/SEL",
            "narrator": "",
            "text": "思い出せることはない？",
            "zh": "有没有能想起来的事？",
            "narrator_zh": ""
        },
        {
            "location": "469/ACT",
            "narrator": "",
            "text": "ごめんね",
            "zh": "抱歉",
            "narrator_zh": ""
        },
        {
            "location": "471/TALK",
            "narrator": "アーヤ",
            "text": "こっちこそ変なこと\n聞いてごめんね。",
            "zh": "该说抱歉的是我才对，\n突然问这种奇怪的话。",
            "narrator_zh": "绫水"
        },
        {
            "location": "472/ACT",
            "narrator": "",
            "text": "アーヤはどう思う？",
            "zh": "绫水自己怎么想？",
            "narrator_zh": ""
        },
        {
            "location": "473/TALK",
            "narrator": "アーヤ",
            "text": "……どっちも本当で\nどっちも嘘のような\n気がする。",
            "zh": "……感觉两边都像真的，\n又感觉两边都像假的\n一样。",
            "narrator_zh": "绫水"
        },
        {
            "location": "474/ACT",
            "narrator": "",
            "text": "思い出せることはない？",
            "zh": "有没有能想起来的事？",
            "narrator_zh": ""
        },
        {
            "location": "475/TALK",
            "narrator": "アーヤ",
            "text": "………………。",
            "zh": "………………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "476/TALK",
            "narrator": "アーヤ",
            "text": "いっぱいあるような、\n全然思い浮かばない\nような……。",
            "zh": "好像有很多，\n又好像完全想不起来\n似的……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "478/ACT",
            "narrator": "",
            "text": "きっと死んでない",
            "zh": "她一定没死",
            "narrator_zh": ""
        },
        {
            "location": "479/TALK",
            "narrator": "アーヤ",
            "text": "そうね。\nそうに決まってる。",
            "zh": "是啊。\n肯定没死。",
            "narrator_zh": "绫水"
        },
        {
            "location": "480/TALK",
            "narrator": "アーヤ",
            "text": "…でも研究所から\n届いた手紙を憶えてる。",
            "zh": "……可我还记得\n研究所寄来的那封信。",
            "narrator_zh": "绫水"
        },
        {
            "location": "481/TALK",
            "narrator": "アーヤ",
            "text": "それからうちに挨拶に\n来たことも。",
            "zh": "还有他们来家里\n吊唁致意的事。",
            "narrator_zh": "绫水"
        },
        {
            "location": "482/TALK",
            "narrator": "アーヤ",
            "text": "あれは何なの…？",
            "zh": "那些又算什么……？",
            "narrator_zh": "绫水"
        },
        {
            "location": "483/ACT",
            "narrator": "",
            "text": "どこか別の世界にいるんだよ",
            "zh": "说不定是在某个别的世界里哦",
            "narrator_zh": ""
        },
        {
            "location": "484/TALK",
            "narrator": "アーヤ",
            "text": "…何それ？",
            "zh": "……那是什么？",
            "narrator_zh": "绫水"
        },
        {
            "location": "485/TALK",
            "narrator": "アーヤ",
            "text": "別次元に\n姉がいますって？",
            "zh": "你是说姐姐\n在别的次元吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "486/TALK",
            "narrator": "アーヤ",
            "text": "そんなこと言ったら\n本格的におかしくなった\nって思われるわよ。",
            "zh": "要是说出这种话，\n会被当成彻底\n疯掉的哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "487/TALK",
            "narrator": "アーヤ",
            "text": "……でもお姉ちゃんなら\nいても不思議じゃ\nないような気がする。",
            "zh": "……不过如果是姐姐的话，\n总觉得就算真在那里\n也不奇怪呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "489/TALK",
            "narrator": "アーヤ",
            "text": "ちょっと整理するわね。",
            "zh": "我稍微整理一下思绪。",
            "narrator_zh": "绫水"
        },
        {
            "location": "490/TALK",
            "narrator": "アーヤ",
            "text": "私の記憶が二重に\nなってるのは\n私が高校生の時。",
            "zh": "我的记忆出现\n双重重叠，是在\n我高中时候的事。",
            "narrator_zh": "绫水"
        },
        {
            "location": "491/TALK",
            "narrator": "アーヤ",
            "text": "姉がらみのできごとで、\nひとつは姉は死亡した。\nもうひとつは生きている。",
            "zh": "关于姐姐的事情，\n一份记忆里姐姐死了。\n另一份里她还活着。",
            "narrator_zh": "绫水"
        },
        {
            "location": "492/TALK",
            "narrator": "アーヤ",
            "text": "今の私は大学生。\nトライナリーに\n所属してる。",
            "zh": "现在的我是大学生。\n隶属于\n三重奏。",
            "narrator_zh": "绫水"
        },
        {
            "location": "493/TALK",
            "narrator": "アーヤ",
            "text": "ただしつばめの\nフェノメノンの中で。",
            "zh": "不过是在燕的\nPhenoMENON之中。",
            "narrator_zh": "绫水"
        },
        {
            "location": "494/SEL",
            "narrator": "",
            "text": "よくできました",
            "zh": "整理得很好",
            "narrator_zh": ""
        },
        {
            "location": "495/SEL",
            "narrator": "",
            "text": "なるほどね",
            "zh": "原来如此",
            "narrator_zh": ""
        },
        {
            "location": "496/SEL",
            "narrator": "",
            "text": "真実ってひとつだけなの？",
            "zh": "真相就只有一个吗？",
            "narrator_zh": ""
        },
        {
            "location": "497/ACT",
            "narrator": "",
            "text": "よくできました",
            "zh": "整理得很好",
            "narrator_zh": ""
        },
        {
            "location": "498/TALK",
            "narrator": "アーヤ",
            "text": "…本当に？",
            "zh": "……真的吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "499/ACT",
            "narrator": "",
            "text": "なるほどね",
            "zh": "原来如此",
            "narrator_zh": ""
        },
        {
            "location": "501/ACT",
            "narrator": "",
            "text": "真実ってひとつだけなの？",
            "zh": "真相就只有一个吗？",
            "narrator_zh": ""
        },
        {
            "location": "504/TALK",
            "narrator": "アーヤ",
            "text": "…それでね。\nやっぱり少しおかしい。\n姉の生死のことは。",
            "zh": "……然后呢。\n果然还是有点奇怪。\n姐姐的生死这件事。",
            "narrator_zh": "绫水"
        },
        {
            "location": "505/TALK",
            "narrator": "アーヤ",
            "text": "本来なら今いるここが\nフェノメノンの中でも\n外でも変わらないはず。",
            "zh": "按理说现在所在的这里，\n无论是在PhenoMENON里面\n还是外面都该是一样的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "506/TALK",
            "narrator": "アーヤ",
            "text": "だけど私は二つの記憶を\n持ってる。",
            "zh": "但我却拥有\n两份记忆。",
            "narrator_zh": "绫水"
        },
        {
            "location": "507/TALK",
            "narrator": "アーヤ",
            "text": "姉が生きてるセカイと\n死んでるセカイ。",
            "zh": "姐姐活着的世界\n和死去的世界。",
            "narrator_zh": "绫水"
        },
        {
            "location": "508/TALK",
            "narrator": "アーヤ",
            "text": "これはすごく重要な\nことじゃない？",
            "zh": "这难道不是一件\n非常重要的事吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "509/SEL",
            "narrator": "",
            "text": "そうだね",
            "zh": "是啊",
            "narrator_zh": ""
        },
        {
            "location": "510/SEL",
            "narrator": "",
            "text": "そうかも",
            "zh": "也许吧",
            "narrator_zh": ""
        },
        {
            "location": "511/SEL",
            "narrator": "",
            "text": "どうかなあ",
            "zh": "这可说不好",
            "narrator_zh": ""
        },
        {
            "location": "512/ACT",
            "narrator": "",
            "text": "そうだね",
            "zh": "是啊",
            "narrator_zh": ""
        },
        {
            "location": "513/TALK",
            "narrator": "アーヤ",
            "text": "でしょ？",
            "zh": "对吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "514/ACT",
            "narrator": "",
            "text": "そうかも",
            "zh": "也许吧",
            "narrator_zh": ""
        },
        {
            "location": "515/TALK",
            "narrator": "アーヤ",
            "text": "違うかしら？",
            "zh": "难道不是吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "516/ACT",
            "narrator": "",
            "text": "どうかなあ",
            "zh": "这可说不好",
            "narrator_zh": ""
        },
        {
            "location": "517/TALK",
            "narrator": "アーヤ",
            "text": "ちょっと\n不安になるわ…。",
            "zh": "我会有点\n不安的啊……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "519/TALK",
            "narrator": "アーヤ",
            "text": "だからね。\n私、探す。姉の真実を。",
            "zh": "所以呢。\n我要去寻找，关于姐姐的真相。",
            "narrator_zh": "绫水"
        },
        {
            "location": "520/TALK",
            "narrator": "アーヤ",
            "text": "生きているのか\n死んでいるのか。",
            "zh": "她究竟是活着\n还是死了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "521/TALK",
            "narrator": "アーヤ",
            "text": "生きているなら\nどこにいるのか。",
            "zh": "如果还活着的话，\n她又在哪里。",
            "narrator_zh": "绫水"
        },
        {
            "location": "522/SEL",
            "narrator": "",
            "text": "$me$も手伝う",
            "zh": "$me$也来帮忙",
            "narrator_zh": ""
        },
        {
            "location": "523/SEL",
            "narrator": "",
            "text": "$me$と一緒にだよね？",
            "zh": "是和$me$一起对吧？",
            "narrator_zh": ""
        },
        {
            "location": "524/SEL",
            "narrator": "",
            "text": "$me$にも協力させてよ",
            "zh": "也让$me$来搭把手吧",
            "narrator_zh": ""
        },
        {
            "location": "525/ACT",
            "narrator": "",
            "text": "$me$も手伝う",
            "zh": "$me$也来帮忙",
            "narrator_zh": ""
        },
        {
            "location": "526/TALK",
            "narrator": "アーヤ",
            "text": "…ありがとう。",
            "zh": "……谢谢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "527/TALK",
            "narrator": "アーヤ",
            "text": "そう言ってくれるって\n思ってた。",
            "zh": "我就知道你会\n这么说。",
            "narrator_zh": "绫水"
        },
        {
            "location": "528/ACT",
            "narrator": "",
            "text": "$me$と一緒にだよね？",
            "zh": "是和$me$一起对吧？",
            "narrator_zh": ""
        },
        {
            "location": "529/TALK",
            "narrator": "アーヤ",
            "text": "もちろんよ。",
            "zh": "当然了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "530/TALK",
            "narrator": "アーヤ",
            "text": "あなたと一緒なら\nきっと見つけられる。",
            "zh": "只要和你一起，\n就一定能找到的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "531/ACT",
            "narrator": "",
            "text": "$me$にも協力させてよ",
            "zh": "也让$me$来搭把手吧",
            "narrator_zh": ""
        },
        {
            "location": "532/TALK",
            "narrator": "アーヤ",
            "text": "私から言おうと\n思ってたのに。",
            "zh": "明明我正打算\n主动向你开口的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "534/TALK",
            "narrator": "アーヤ",
            "text": "改めて言うわ。\n協力ありがとう。\n頼りにしてる。",
            "zh": "那我再正式说一次哦。\n谢谢你的协助。\n就拜托你了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "536/TALK",
            "narrator": "アーヤ",
            "text": "よし。",
            "zh": "好。",
            "narrator_zh": "绫水"
        },
        {
            "location": "537/TALK",
            "narrator": "アーヤ",
            "text": "そう決まったら\nぼんやりなんて\nしてられないわ。",
            "zh": "既然决定了，\n可不能再继续\n发呆下去了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "538/SEL",
            "narrator": "",
            "text": "あせりは禁物",
            "zh": "切忌心急",
            "narrator_zh": ""
        },
        {
            "location": "539/SEL",
            "narrator": "",
            "text": "どーんと行こう！",
            "zh": "大步往前冲吧！",
            "narrator_zh": ""
        },
        {
            "location": "540/SEL",
            "narrator": "",
            "text": "根詰めすぎないでね",
            "zh": "别太勉强自己哦",
            "narrator_zh": ""
        },
        {
            "location": "541/ACT",
            "narrator": "",
            "text": "あせりは禁物",
            "zh": "切忌心急",
            "narrator_zh": ""
        },
        {
            "location": "542/TALK",
            "narrator": "アーヤ",
            "text": "そうね。\n気を付けるわ。",
            "zh": "是啊。\n我会注意的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "543/TALK",
            "narrator": "アーヤ",
            "text": "でもそうなったら\n$handle$さんが\n言ってくれるでしょ？",
            "zh": "不过真要那样的话，\n$handle$会\n提醒我的吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "544/ACT",
            "narrator": "",
            "text": "どーんと行こう！",
            "zh": "大步往前冲吧！",
            "narrator_zh": ""
        },
        {
            "location": "545/TALK",
            "narrator": "アーヤ",
            "text": "それしかないわね。",
            "zh": "也只能这样了呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "546/TALK",
            "narrator": "アーヤ",
            "text": "$handle$さんも\nついててくれるんだし。",
            "zh": "而且还有$handle$\n陪在我身边呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "547/ACT",
            "narrator": "",
            "text": "根詰めすぎないでね",
            "zh": "别太勉强自己哦",
            "narrator_zh": ""
        },
        {
            "location": "548/TALK",
            "narrator": "アーヤ",
            "text": "そうなっちゃうかもね。",
            "zh": "说不定真会那样呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "549/TALK",
            "narrator": "アーヤ",
            "text": "でもそんな時は\n$handle$さんが\n助けてくれるでしょ？",
            "zh": "不过到那种时候，\n$handle$会\n拉我一把的吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "551/TALK",
            "narrator": "アーヤ",
            "text": "…もしお姉ちゃんが\nこの世にいないって\n確定しても。",
            "zh": "……就算最后确定\n姐姐真的已经\n不在人世了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "552/TALK",
            "narrator": "アーヤ",
            "text": "$handle$さんが\n側にいてくれる。",
            "zh": "$handle$也会\n留在我身边。",
            "narrator_zh": "绫水"
        },
        {
            "location": "553/TALK",
            "narrator": "アーヤ",
            "text": "……ううん。今は\nそんなこと考えない。",
            "zh": "……不。现在\n不去想那种事。",
            "narrator_zh": "绫水"
        },
