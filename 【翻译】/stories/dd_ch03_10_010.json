{
    "dir": "chap10/daydra/dd_ch03_10_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "10352",
        "cid": "gabriella",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "相撲のチケット",
        "title_zh": "Extra002 额外剧情",
        "sub_title_zh": "相扑门票"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "相撲のチケット",
            "zh": "相扑门票",
            "narrator_zh": ""
        },
        {
            "location": "24/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…失敗したわ。",
            "zh": "唉……失算了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "38/TALK",
            "narrator": "ガブリエラ",
            "text": "どうしたらいいと思う？",
            "zh": "你说该怎么办才好？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "40/SEL",
            "narrator": "",
            "text": "何が？",
            "zh": "怎么了？",
            "narrator_zh": ""
        },
        {
            "location": "41/ACT",
            "narrator": "",
            "text": "何が？",
            "zh": "怎么了？",
            "narrator_zh": ""
        },
        {
            "location": "43/TALK",
            "narrator": "ガブリエラ",
            "text": "相撲のチケットを買ったの",
            "zh": "我买了相扑的门票",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "44/TALK",
            "narrator": "ガブリエラ",
            "text": "けど、間違えて",
            "zh": "可是，不小心",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "45/TALK",
            "narrator": "ガブリエラ",
            "text": "二枚買っちゃってたの",
            "zh": "买成两张了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "47/SEL",
            "narrator": "",
            "text": "返品はできるの？",
            "zh": "能退票吗？",
            "narrator_zh": ""
        },
        {
            "location": "48/ACT",
            "narrator": "",
            "text": "返品はできるの？",
            "zh": "能退票吗？",
            "narrator_zh": ""
        },
        {
            "location": "52/TALK",
            "narrator": "ガブリエラ",
            "text": "出来るとは思うけど",
            "zh": "我想应该能退吧，不过",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "54/TALK",
            "narrator": "ガブリエラ",
            "text": "せっかくだから誰か誘おうかしら？",
            "zh": "难得买都买了，要不找个人一起去？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "55/TALK",
            "narrator": "ガブリエラ",
            "text": "相撲はまだ行ったことないから",
            "zh": "我还没去看过相扑呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "56/TALK",
            "narrator": "ガブリエラ",
            "text": "誰かと一緒の方がいいかもしれないし",
            "zh": "说不定找个人一起去会比较好",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "58/SEL",
            "narrator": "",
            "text": "みやびを誘おう",
            "zh": "约雅吧",
            "narrator_zh": ""
        },
        {
            "location": "59/SEL",
            "narrator": "",
            "text": "アーヤを誘おう",
            "zh": "约绫水吧",
            "narrator_zh": ""
        },
        {
            "location": "60/SEL",
            "narrator": "",
            "text": "つばめを誘おう",
            "zh": "约燕吧",
            "narrator_zh": ""
        },
        {
            "location": "61/ACT",
            "narrator": "",
            "text": "みやびを誘おう",
            "zh": "约雅吧",
            "narrator_zh": ""
        },
        {
            "location": "62/TALK",
            "narrator": "ガブリエラ",
            "text": "みやび？",
            "zh": "雅？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "63/TALK",
            "narrator": "ガブリエラ",
            "text": "確かに相撲とか好きそうな感じかも",
            "zh": "确实，她给人的感觉好像会喜欢相扑呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "64/TALK",
            "narrator": "ガブリエラ",
            "text": "声かけてみるわ",
            "zh": "我去问问她吧",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "77/TALK",
            "narrator": "ガブリエラ",
            "text": "さてと、教室に行けば\nいるかしら？",
            "zh": "好了，去教室的话\n她会在吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "88/TALK",
            "narrator": "みやび",
            "text": "…花も恥らう女子中学生、\nしかも留学生から――",
            "zh": "……被如花似玉的初中女生，\n而且还是留学生——",
            "narrator_zh": "雅"
        },
        {
            "location": "90/TALK",
            "narrator": "みやび",
            "text": "何が悲しくて相撲なんぞに\n誘われなあかんのか…。",
            "zh": "是走了什么背运，要被约去\n看相扑这种么子……。",
            "narrator_zh": "雅"
        },
        {
            "location": "91/TALK",
            "narrator": "ガブリエラ",
            "text": "何よ、文句あるの？",
            "zh": "什么嘛，你有意见啊？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "92/TALK",
            "narrator": "みやび",
            "text": "いんや、ガブちゃんは\n特別やなぁと感心した\nだけやき。",
            "zh": "没得，我只是感叹\n加布还真是特别\n而已啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "93/TALK",
            "narrator": "みやび",
            "text": "えいよ。その誘い、\nありがたく受けるがよ。",
            "zh": "要得。这邀请，\n我就心怀感激地收下咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "94/TALK",
            "narrator": "ガブリエラ",
            "text": "まったく…ちゃんと\n予定空けときなさいよ？",
            "zh": "真是的……你可得把\n时间给我好好空出来哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "95/TALK",
            "narrator": "みやび",
            "text": "わかっとるき、安心せい。",
            "zh": "晓得啵，放心好咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "96/TALK",
            "narrator": "みやび",
            "text": "しっかし、相撲か…\nうちも一度行ってみたい\n思うてたんよ。",
            "zh": "不过话又说回来，相扑啊……\n我其实也一直想亲眼去\n看一趟咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "97/TALK",
            "narrator": "ガブリエラ",
            "text": "へぇ、そうだったんだ？",
            "zh": "哦，原来是这样啊？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "99/TALK",
            "narrator": "みやび",
            "text": "うん。一度でえいから\nおもいっきり座布団を\n投げてみたくてな…。",
            "zh": "嗯。哪怕就一次也行，\n好想使足力气把坐垫\n扔出去试试看咯……。",
            "narrator_zh": "雅"
        },
        {
            "location": "101/TALK",
            "narrator": "ガブリエラ",
            "text": "…ちゃんと相撲も\n見なさいよ？",
            "zh": "……你也给我好好看\n相扑比赛啊？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "102/ACT",
            "narrator": "",
            "text": "アーヤを誘おう",
            "zh": "约绫水吧",
            "narrator_zh": ""
        },
        {
            "location": "103/TALK",
            "narrator": "ガブリエラ",
            "text": "まあ無難な人選よね",
            "zh": "倒也是最稳妥的人选呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "104/TALK",
            "narrator": "ガブリエラ",
            "text": "ていうか",
            "zh": "话说回来",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "105/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤくらいしかいないし",
            "zh": "也就只有绫水能约了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "123/TALK",
            "narrator": "アーヤ",
            "text": "相撲のチケットって…\n凄いもの買ったわね？",
            "zh": "相扑门票……\n你买了挺不得了的东西呢？",
            "narrator_zh": "绫水"
        },
        {
            "location": "124/TALK",
            "narrator": "ガブリエラ",
            "text": "一度、実際にこの目で\n見てみたかったのよ。",
            "zh": "我是想亲眼去现场\n看一次嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "126/TALK",
            "narrator": "アーヤ",
            "text": "まあ、私もテレビでしか\n見たことがないから、\nちょっと興味あるかも。",
            "zh": "嗯，我也只在电视上\n看过，所以\n倒也有点兴趣。",
            "narrator_zh": "绫水"
        },
        {
            "location": "127/TALK",
            "narrator": "アーヤ",
            "text": "けど、私でいいの？\n力士の名前はまったく\n知らないんだけど…。",
            "zh": "不过，叫我去真的好吗？\n我连力士的名字\n一个都不知道……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "129/TALK",
            "narrator": "ガブリエラ",
            "text": "いいんじゃない？\nあたしも有名な人くらい\nしかしらないんだし。",
            "zh": "有什么关系？\n反正我也只知道\n几个有名的而已。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "130/TALK",
            "narrator": "アーヤ",
            "text": "それなら、ありがたく\nご一緒させてもらうわ。",
            "zh": "既然这样，那我就\n荣幸地陪你去一趟吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "131/TALK",
            "narrator": "ガブリエラ",
            "text": "決まりね。\n当日はちゃんと予定\n空けておいてよ？",
            "zh": "那就说定了。\n当天记得把时间\n好好空出来哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "132/TALK",
            "narrator": "ガブリエラ",
            "text": "まあ、アーヤなら断らない\nとは思ってたから、\n予想通りの結果ね。",
            "zh": "嘛，我就知道绫水肯定\n不会拒绝，也算是\n意料之中的结果啦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "133/ACT",
            "narrator": "",
            "text": "つばめを誘おう",
            "zh": "约燕吧",
            "narrator_zh": ""
        },
        {
            "location": "136/TALK",
            "narrator": "ガブリエラ",
            "text": "もぉ、どうして新人を誘わなきゃいけないのよ",
            "zh": "真是的，为什么非得约那个新人不可啊",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "137/TALK",
            "narrator": "ガブリエラ",
            "text": "てか",
            "zh": "再说了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "138/TALK",
            "narrator": "ガブリエラ",
            "text": "相撲に興味を持ってもいなさそうなのに",
            "zh": "她看起来也不像是对相扑有兴趣的样子",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "139/TALK",
            "narrator": "ガブリエラ",
            "text": "やっぱり、アーヤでも誘うわ",
            "zh": "我还是去约绫水好了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "150/TALK",
            "narrator": "ガブリエラ",
            "text": "まったく…。",
            "zh": "真是的……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "152/TALK",
            "narrator": "ガブリエラ",
            "text": "あ、でもこれって\n良いチャンスかも。",
            "zh": "啊，不过这说不定\n是个好机会。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "153/TALK",
            "narrator": "ガブリエラ",
            "text": "相撲なんて見に行ったこと\nなさそうな新人に――",
            "zh": "让一看就没去看过相扑的\n新人去见识一下——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "154/TALK",
            "narrator": "ガブリエラ",
            "text": "人生経験を積ませて、\n先輩のありがたさを\n教えられそうだし。",
            "zh": "既能让她积累人生经验，\n又能让她体会到前辈的\n恩德。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "155/TALK",
            "narrator": "ガブリエラ",
            "text": "…まあ、気は乗らないけど\n仕方ないわね。",
            "zh": "……算了，虽然不太情愿，\n但也没办法了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "163/TALK",
            "narrator": "ガブリエラ",
            "text": "というわけで、新人。\nあんたにこのチケットを\nあげるわ。",
            "zh": "所以呢，新人。\n这张票就\n赐给你吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "165/TALK",
            "narrator": "つばめ",
            "text": "わぁ、本当にいいん\nですか！？",
            "zh": "哇，真的可以\n吗！？",
            "narrator_zh": "燕"
        },
        {
            "location": "167/TALK",
            "narrator": "ガブリエラ",
            "text": "ええ…まあ、あんたが\n相撲見ても楽しいとは\n思えないだろうけど――",
            "zh": "嗯……嘛，虽然我觉得你\n去看相扑多半也不会觉得\n有什么意思——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "168/TALK",
            "narrator": "ガブリエラ",
            "text": "人生経験を積むって\nことで、一度くらいは…。",
            "zh": "就当是积累人生经验，\n好歹也去看一次……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "170/TALK",
            "narrator": "つばめ",
            "text": "すっごく嬉しいです！",
            "zh": "我超级开心的！",
            "narrator_zh": "燕"
        },
        {
            "location": "173/TALK",
            "narrator": "ガブリエラ",
            "text": "…え？",
            "zh": "……咦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "174/TALK",
            "narrator": "つばめ",
            "text": "わたし、一度お相撲を\n見に行ってみたかったん\nです。",
            "zh": "我一直都想亲眼去\n看一次相扑\n呢。",
            "narrator_zh": "燕"
        },
        {
            "location": "175/TALK",
            "narrator": "つばめ",
            "text": "せんぱいは、実際に\n見に行ったことは\nあるんですか？",
            "zh": "前辈你之前\n亲眼去现场看\n过吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "176/TALK",
            "narrator": "ガブリエラ",
            "text": "な、ないけど…。",
            "zh": "没、没有过啦……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "177/TALK",
            "narrator": "つばめ",
            "text": "じゃあ、お互い\n初めて同士ですね。",
            "zh": "那我们俩正好\n都是第一次呢。",
            "narrator_zh": "燕"
        },
        {
            "location": "178/TALK",
            "narrator": "つばめ",
            "text": "早く見に行きたいなぁ…\n当日が待ち遠しいよぉ。",
            "zh": "好想快点去看呀……\n真盼着那天快点到来呢。",
            "narrator_zh": "燕"
        },
        {
            "location": "180/TALK",
            "narrator": "ガブリエラ",
            "text": "…なんか、めちゃくちゃ\n喜んでるみたい。",
            "zh": "……总觉得，她好像\n开心得不得了啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "181/TALK",
            "narrator": "ガブリエラ",
            "text": "本当は、アーヤとかの方が\nよかった気もするけど――",
            "zh": "虽然我本来觉得，约绫水\n她们会更好一些——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "183/TALK",
            "narrator": "ガブリエラ",
            "text": "今回ばかりは、新人を\n誘ってよかったかも。",
            "zh": "不过就这一次而言，约了\n新人或许还挺不错的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "15/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>6月15日　10:20 AM</color>\nとある平日の午前中、\n附属学園廊下にて。",
            "zh": "<color=green>6月15日　10:20 AM</color>\n某个平日的上午，\n在附属学园的走廊上。",
            "narrator_zh": "Dialog_EventData"
        },
        {
            "location": "195/DIALOG",
            "narrator": "Dialog_GEThimegoto_ch03",
            "text": "【平成立ち合いスモウガール】",
            "zh": "【平成架势相扑少女】",
            "narrator_zh": "Dialog_GEThimegoto_ch03"
        }
    ]
}
