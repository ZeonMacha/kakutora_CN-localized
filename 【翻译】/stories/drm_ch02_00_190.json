        "cid": "ayami",
        "title": "らぶとーく 第19話",
        "sub_title": "平行線",
        "title_zh": "恋爱漫谈 第19话",
        "sub_title_zh": "平行线"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "平行線",
            "zh": "平行线",
            "narrator_zh": ""
        },
        {
            "location": "19/TALK",
            "narrator": "アーヤ",
            "text": "ごめん、二人とも。\nちょっと本屋寄って\n帰るわ。",
            "zh": "抱歉，你们两个。\n我去一趟书店\n就回去了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "21/TALK",
            "narrator": "つばめ",
            "text": "何か読みたい本でも\nあるんですか？",
            "zh": "是有什么\n想看的书吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "23/TALK",
            "narrator": "アーヤ",
            "text": "うーん…っていうか、\n暇つぶしかな？",
            "zh": "嗯……或者该说，\n打发时间吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "25/TALK",
            "narrator": "ガブリエラ",
            "text": "いいわよね。\nあたし達なんか、これから\nバイトだってのに…。",
            "zh": "真好啊。\n我们这边，接下来\n还要打工……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "26/TALK",
            "narrator": "アーヤ",
            "text": "昨日休みだったでしょ？\nほら、急がないと時間に\n遅れるわよ？",
            "zh": "昨天休息了吧？\n来，不快点的话\n要迟到了哦？",
            "narrator_zh": "绫水"
        },
        {
            "location": "29/TALK",
            "narrator": "ガブリエラ",
            "text": "もう…行くわよ、つばめ。",
            "zh": "真是……走了，燕。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "32/TALK",
            "narrator": "つばめ",
            "text": "あ、ガブちゃん待って！",
            "zh": "啊，加布等等！",
            "narrator_zh": "燕"
        },
        {
            "location": "37/TALK",
            "narrator": "アーヤ",
            "text": "…ふぅ。",
            "zh": "……呼。",
            "narrator_zh": "绫水"
        },
        {
            "location": "39/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "41/TALK",
            "narrator": "アーヤ",
            "text": "あ、そっか。\n本屋行くんだったわ…。",
            "zh": "啊，对了。\n我要去书店的……",
            "narrator_zh": "绫水"
        },
        {
            "location": "42/SEL",
            "narrator": "",
            "text": "アーヤ",
            "zh": "绫水",
            "narrator_zh": ""
        },
        {
            "location": "43/ACT",
            "narrator": "",
            "text": "アーヤ",
            "zh": "绫水",
            "narrator_zh": ""
        },
        {
            "location": "47/TALK",
            "narrator": "アーヤ",
            "text": "？",
            "zh": "？",
            "narrator_zh": "绫水"
        },
        {
            "location": "61/TALK",
            "narrator": "アーヤ",
            "text": "ああ",
            "zh": "啊",
            "narrator_zh": "绫水"
        },
        {
            "location": "62/TALK",
            "narrator": "アーヤ",
            "text": "どうかした？",
            "zh": "怎么了？",
            "narrator_zh": "绫水"
        },
        {
            "location": "64/SEL",
            "narrator": "",
            "text": "退屈してない？",
            "zh": "你没有觉得无聊吧？",
            "narrator_zh": ""
        },
        {
            "location": "65/SEL",
            "narrator": "",
            "text": "元気かなって",
            "zh": "不知道她还好吗",
            "narrator_zh": ""
        },
        {
            "location": "66/SEL",
            "narrator": "",
            "text": "アーヤと話したい",
            "zh": "想和绫水说话",
            "narrator_zh": ""
        },
        {
            "location": "67/ACT",
            "narrator": "",
            "text": "退屈してない？",
            "zh": "你没有觉得无聊吧？",
            "narrator_zh": ""
        },
        {
            "location": "68/TALK",
            "narrator": "アーヤ",
            "text": "退屈はしてない",
            "zh": "倒也不无聊",
            "narrator_zh": "绫水"
        },
        {
            "location": "69/TALK",
            "narrator": "アーヤ",
            "text": "けど",
            "zh": "可是",
            "narrator_zh": "绫水"
        },
        {
            "location": "70/TALK",
            "narrator": "アーヤ",
            "text": "時間はあるわ",
            "zh": "时间是有的",
            "narrator_zh": "绫水"
        },
        {
            "location": "73/SEL",
            "narrator": "",
            "text": "最近、避けられてる気がした",
            "zh": "最近感觉你在躲着我",
            "narrator_zh": ""
        },
        {
            "location": "74/ACT",
            "narrator": "",
            "text": "最近、避けられてる気がした",
            "zh": "最近感觉你在躲着我",
            "narrator_zh": ""
        },
        {
            "location": "76/TALK",
            "narrator": "アーヤ",
            "text": "ごめんなさい",
            "zh": "对不起",
            "narrator_zh": "绫水"
        },
        {
            "location": "78/TALK",
            "narrator": "アーヤ",
            "text": "でも",
            "zh": "不过",
            "narrator_zh": "绫水"
        },
        {
            "location": "79/TALK",
            "narrator": "アーヤ",
            "text": "避けてるわけじゃない",
            "zh": "不是在躲",
            "narrator_zh": "绫水"
        },
        {
            "location": "80/TALK",
            "narrator": "アーヤ",
            "text": "そういうことじゃないの",
            "zh": "不是那么回事",
            "narrator_zh": "绫水"
        },
        {
            "location": "87/SEL",
            "narrator": "",
            "text": "自分は最初から同じだから気にしないでもらえると嬉しい",
            "zh": "我一开始就是这样，所以希望你别在意",
            "narrator_zh": ""
        },
        {
            "location": "88/ACT",
            "narrator": "",
            "text": "自分は最初から同じだから気にしないでもらえると嬉しい",
            "zh": "我一开始就是这样，所以希望你别在意",
            "narrator_zh": ""
        },
        {
            "location": "90/TALK",
            "narrator": "アーヤ",
            "text": "それはわかってる",
            "zh": "那我知道",
            "narrator_zh": "绫水"
        },
        {
            "location": "91/TALK",
            "narrator": "アーヤ",
            "text": "けど",
            "zh": "可是",
            "narrator_zh": "绫水"
        },
        {
            "location": "92/TALK",
            "narrator": "アーヤ",
            "text": "無理",
            "zh": "不行",
            "narrator_zh": "绫水"
        },
        {
            "location": "93/TALK",
            "narrator": "アーヤ",
            "text": "普通に考えて無理",
            "zh": "正常想想就知道不行",
            "narrator_zh": "绫水"
        },
        {
            "location": "97/SEL",
            "narrator": "",
            "text": "抵抗ある？",
            "zh": "你有抵触？",
            "narrator_zh": ""
        },
        {
            "location": "98/ACT",
            "narrator": "",
            "text": "抵抗ある？",
            "zh": "你有抵触？",
            "narrator_zh": ""
        },
        {
            "location": "101/TALK",
            "narrator": "アーヤ",
            "text": "時間がほしい",
            "zh": "我想要时间",
            "narrator_zh": "绫水"
        },
        {
            "location": "102/TALK",
            "narrator": "アーヤ",
            "text": "それじゃあ",
            "zh": "那就",
            "narrator_zh": "绫水"
        },
        {
            "location": "103/ACT",
            "narrator": "",
            "text": "元気かなって",
            "zh": "不知道她还好吗",
            "narrator_zh": ""
        },
        {
            "location": "104/TALK",
            "narrator": "アーヤ",
            "text": "まあまあってところ？",
            "zh": "马马虎虎？",
            "narrator_zh": "绫水"
        },
        {
            "location": "105/TALK",
            "narrator": "アーヤ",
            "text": "そんな感じよ",
            "zh": "就是那种感觉",
            "narrator_zh": "绫水"
        },
        {
            "location": "107/TALK",
            "narrator": "アーヤ",
            "text": "そっちは？",
            "zh": "你那边呢？",
            "narrator_zh": "绫水"
        },
        {
            "location": "109/SEL",
            "narrator": "",
            "text": "元気ない",
            "zh": "没精神",
            "narrator_zh": ""
        },
        {
            "location": "110/ACT",
            "narrator": "",
            "text": "元気ない",
            "zh": "没精神",
            "narrator_zh": ""
        },
        {
            "location": "112/TALK",
            "narrator": "アーヤ",
            "text": "そんなこと言われても",
            "zh": "就算你这么说",
            "narrator_zh": "绫水"
        },
        {
            "location": "114/TALK",
            "narrator": "アーヤ",
            "text": "困るのよ",
            "zh": "我会为难的",
            "narrator_zh": "绫水"
        },
        {
            "location": "116/ACT",
            "narrator": "",
            "text": "アーヤと話したい",
            "zh": "想和绫水说话",
            "narrator_zh": ""
        },
        {
            "location": "117/TALK",
            "narrator": "アーヤ",
            "text": "私と？",
            "zh": "和我？",
            "narrator_zh": "绫水"
        },
        {
            "location": "118/TALK",
            "narrator": "アーヤ",
            "text": "えとね",
            "zh": "那个呢",
            "narrator_zh": "绫水"
        },
        {
            "location": "119/TALK",
            "narrator": "アーヤ",
            "text": "何を話すの？",
            "zh": "要说什么？",
            "narrator_zh": "绫水"
        },
        {
            "location": "120/TALK",
            "narrator": "アーヤ",
            "text": "私にはないわ",
            "zh": "我没有",
            "narrator_zh": "绫水"
        },
        {
            "location": "121/TALK",
            "narrator": "アーヤ",
            "text": "ないのよ。",
            "zh": "没有哦。",
            "narrator_zh": "绫水"
        }
    ]
}
