   "narrator_zh": "绫水"
  },
  {
   "location": "79/TALK",
   "narrator": "アーヤ",
   "text": "避けてるわけじゃない"
  },
  {
   "location": "80/TALK",
   "narrator": "アーヤ",
   "text": "そういうことじゃないの",
   "zh": "不是那么回事",
   "narrator_zh": "绫水"
  },
  {
   "location": "87/SEL",
   "narrator": "",
   "text": "自分は最初から同じだから気にしないでもらえると嬉しい",
   "zh": "我一开始就是这样，所以希望你别在意",
   "narrator_zh": ""
  },
  {
   "location": "88/ACT",
   "narrator": "",
   "text": "自分は最初から同じだから気にしないでもらえると嬉しい",
