   "text": "平行線"
  },
  {
   "location": "19/TALK",
   "narrator": "アーヤ",
   "text": "ごめん、二人とも。\nちょっと本屋寄って\n帰るわ。",
   "zh": "抱歉，你们两个。\n我去一趟书店\n就回去了。",
   "narrator_zh": "绫水"
  },
  {
   "location": "21/TALK",
   "narrator": "つばめ",
   "text": "何か読みたい本でも\nあるんですか？"
  },
  {
   "location": "23/TALK",
   "narrator": "アーヤ",
   "text": "うーん…っていうか、\n暇つぶしかな？"
  },
  {
   "location": "25/TALK",
   "narrator": "ガブリエラ",
   "text": "いいわよね。\nあたし達なんか、これから\nバイトだってのに…。"
  },
  {
   "location": "26/TALK",
   "narrator": "アーヤ",
   "text": "昨日休みだったでしょ？\nほら、急がないと時間に\n遅れるわよ？"
  },
  {
   "location": "29/TALK",
   "narrator": "ガブリエラ",
   "text": "もう…行くわよ、つばめ。"
  },
  {
   "location": "32/TALK",
   "narrator": "つばめ",
   "text": "あ、ガブちゃん待って！"
  },
  {
   "location": "37/TALK",
   "narrator": "アーヤ",
   "text": "…ふぅ。",
   "zh": "……呼。",
   "narrator_zh": "绫水"
  },
  {
   "location": "39/TALK",
   "narrator": "アーヤ",
   "text": "…………。"
  },
  {
   "location": "41/TALK",
   "narrator": "アーヤ",
   "text": "あ、そっか。\n本屋行くんだったわ…。"
  },
  {
   "location": "42/SEL",
   "narrator": "",
   "text": "アーヤ",
   "zh": "绫水",
   "narrator_zh": ""
  },
  {
   "location": "43/ACT",
   "narrator": "",
   "text": "アーヤ",
   "zh": "绫水",
   "narrator_zh": ""
  },
  {
   "location": "47/TALK",
   "narrator": "アーヤ",
   "text": "？"
  },
  {
   "location": "61/TALK",
   "narrator": "アーヤ",
   "text": "ああ",
   "zh": "啊",
   "narrator_zh": "绫水"
  },
  {
   "location": "62/TALK",
   "narrator": "アーヤ",
   "text": "どうかした？",
   "zh": "怎么了？",
   "narrator_zh": "绫水"
  },
  {
   "location": "64/SEL",
   "narrator": "",
   "text": "退屈してない？",
   "zh": "你没有觉得无聊吧？",
   "narrator_zh": ""
  },
  {
   "location": "65/SEL",
   "narrator": "",
   "text": "元気かなって",
   "zh": "不知道她还好吗",
   "narrator_zh": ""
  },
  {
   "location": "66/SEL",
   "narrator": "",
   "text": "アーヤと話したい",
   "zh": "想和绫水说话",
   "narrator_zh": ""
  },
  {
   "location": "67/ACT",
   "narrator": "",
   "text": "退屈してない？",
   "zh": "你没有觉得无聊吧？",
   "narrator_zh": ""
  },
  {
   "location": "68/TALK",
   "narrator": "アーヤ",
   "text": "退屈はしてない"
  },
  {
   "location": "69/TALK",
   "narrator": "アーヤ",
   "text": "けど",
   "zh": "可是",
   "narrator_zh": "绫水"
  },
  {
   "location": "70/TALK",
   "narrator": "アーヤ",
   "text": "時間はあるわ"
  },
  {
   "location": "73/SEL",
   "narrator": "",
   "text": "最近、避けられてる気がした",
   "zh": "最近感觉你在躲着我",
