{
    "dir": "chap22/daydra/dd_ch02_22_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "22202",
        "cid": "ayami",
        "title": "002 メインストーリー",
        "sub_title": "覚悟＜前編＞",
        "title_zh": "002 主线剧情",
        "sub_title_zh": "觉悟＜前篇＞"
    },
    "entry": [
        {
            "location": "24/TALK",
            "narrator": "アーヤ",
            "text": "…そろそろお夕飯の\n時間ね。",
            "zh": "……差不多快到\n吃晚饭的时间了呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "25/TALK",
            "narrator": "アーヤ",
            "text": "私も準備くらいは\n手伝わないと…。",
            "zh": "我也得去帮忙\n准备一下才行……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "32/TALK",
            "narrator": "アーヤ",
            "text": "あ、はい。\nもしもし？",
            "zh": "啊，是。\n喂？",
            "narrator_zh": "绫水"
        },
        {
            "location": "33/TALK",
            "narrator": "透明真幌",
            "text": "私だ。\nこの後、何か予定は\n入っているか？",
            "zh": "是我。\n待会儿，你有什么\n安排吗？",
            "narrator_zh": "透明真幌"
        },
        {
            "location": "34/TALK",
            "narrator": "アーヤ",
            "text": "いえ、食事の後は\n特に…。",
            "zh": "没有，吃完晚饭后\n没什么特别的……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "35/TALK",
            "narrator": "透明真幌",
            "text": "今から飲みに行こうと\n思うのだが\n一緒にどうだ？",
            "zh": "我正打算等会儿\n去喝一杯，\n要一起来吗？",
            "narrator_zh": "透明真幌"
        },
        {
            "location": "37/TALK",
            "narrator": "アーヤ",
            "text": "わかりました。\nでは、夕飯は\nそちらにします。",
            "zh": "我知道了。\n那晚饭我就在\n那边吃了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "38/TALK",
            "narrator": "透明真幌",
            "text": "ああ、すまんな。",
            "zh": "嗯，麻烦你了。",
            "narrator_zh": "透明真幌"
        },
        {
            "location": "59/TALK",
            "narrator": "真幌",
            "text": "…どうした？\nあまり酒が進んでない\nようだが？",
            "zh": "……怎么了？\n看你好像没怎么\n动酒杯啊？",
            "narrator_zh": "真幌"
        },
        {
            "location": "61/TALK",
            "narrator": "アーヤ",
            "text": "…館長。\nそれ言うの、これで\n三回目ですよ？",
            "zh": "……馆长。\n这句话你已经\n问了三遍了哦？",
            "narrator_zh": "绫水"
        },
        {
            "location": "62/TALK",
            "narrator": "真幌",
            "text": "そうだったか？\nとにかく、おまえも\nもっと飲め。",
            "zh": "是吗？\n总之，你也\n多喝点。",
            "narrator_zh": "真幌"
        },
        {
            "location": "63/TALK",
            "narrator": "アーヤ",
            "text": "もう…あんまり\n飲み過ぎないで\nくださいね？",
            "zh": "真是的……你也\n别喝得太过了\n好吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "64/TALK",
            "narrator": "アーヤ",
            "text": "まだそんなに\n遅い時間でも\nないんですし。",
            "zh": "现在时间也\n还这么早\n不是吗。",
            "narrator_zh": "绫水"
        },
        {
            "location": "65/TALK",
            "narrator": "真幌",
            "text": "なんだ？\nおまえももう少し\n飲んでたいのか？",
            "zh": "怎么？\n你也想再多\n喝一会儿吗？",
            "narrator_zh": "真幌"
        },
        {
            "location": "66/TALK",
            "narrator": "アーヤ",
            "text": "お酒を飲みながら\n話すのは、嫌いじゃ\nありませんから。",
            "zh": "一边喝酒一边\n聊天，我倒并不\n讨厌就是了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "67/TALK",
            "narrator": "真幌",
            "text": "そうか…まあ、私も\n酔いつぶれるほど\n飲んだりはしないさ。",
            "zh": "这样啊……嘛，我也\n不会喝到烂醉如泥\n的地步啦。",
            "narrator_zh": "真幌"
        },
        {
            "location": "68/TALK",
            "narrator": "真幌",
            "text": "ただ…少し酒を\n入れなければならん\nわけがあるんだ…。",
            "zh": "只是……今天确实有\n必须借点酒劲才能说的\n缘由在……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "69/TALK",
            "narrator": "アーヤ",
            "text": "…何か話があるから\n呼び出したんだとは\n思ってましたけど。",
            "zh": "……我就猜你是\n有事要谈才把我\n叫出来的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "70/TALK",
            "narrator": "アーヤ",
            "text": "重要なことなん\nですか？",
            "zh": "是什么很重要的事\n吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "71/TALK",
            "narrator": "真幌",
            "text": "ああ…少し前に、\nみやびから相談を\n受けたんだ。",
            "zh": "嗯……前阵子，\n雅找我商量过\n一件事。",
            "narrator_zh": "真幌"
        },
        {
            "location": "73/TALK",
            "narrator": "真幌",
            "text": "フェノメノンが、\n人為的に起こされて\nいる可能性がある、と。",
            "zh": "她说，PhenoMENON\n有可能是被人为\n引发的。",
            "narrator_zh": "真幌"
        },
        {
            "location": "75/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "76/TALK",
            "narrator": "真幌",
            "text": "…何だ、アーヤは\nとっくに聞いていた\nようだな。",
            "zh": "……怎么，看样子绫水\n早就已经听说过\n这件事了啊。",
            "narrator_zh": "真幌"
        },
        {
            "location": "78/TALK",
            "narrator": "アーヤ",
            "text": "…すみません。\n館長には、すぐに\n報告するべきでした。",
            "zh": "……非常抱歉。\n我本该立刻向馆长\n汇报的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "79/TALK",
            "narrator": "真幌",
            "text": "いや、構わん。",
            "zh": "没事，无所谓。",
            "narrator_zh": "真幌"
        },
        {
            "location": "80/TALK",
            "narrator": "真幌",
            "text": "それより、おまえは\nどこまで聞いている？",
            "zh": "比起那个，\n你都听说了多少？",
            "narrator_zh": "真幌"
        },
        {
            "location": "81/TALK",
            "narrator": "アーヤ",
            "text": "人為的に起こされた\n可能性がある、としか\n聞いてませんけど…。",
            "zh": "我只听说是\n有可能被人为引发的\n……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "82/TALK",
            "narrator": "アーヤ",
            "text": "…続きがあるん\nですか？",
            "zh": "……还有后续\n吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "83/TALK",
            "narrator": "真幌",
            "text": "ああ…。",
            "zh": "嗯……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "84/TALK",
            "narrator": "真幌",
            "text": "我々のいる\nこの空間全体に歪みが\n生じているらしい。",
            "zh": "我们所处的\n这整个空间，似乎\n正在产生某种扭曲。",
            "narrator_zh": "真幌"
        },
        {
            "location": "85/TALK",
            "narrator": "アーヤ",
            "text": "歪み…ですか？",
            "zh": "扭曲……吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "86/TALK",
            "narrator": "真幌",
            "text": "そうだ。",
            "zh": "没错。",
            "narrator_zh": "真幌"
        },
        {
            "location": "87/TALK",
            "narrator": "真幌",
            "text": "ただ、その歪みが\n何であるかまでは\n解析できていない。",
            "zh": "只不过，那份扭曲\n究竟是什么，目前还\n没能解析出来。",
            "narrator_zh": "真幌"
        },
        {
            "location": "88/TALK",
            "narrator": "アーヤ",
            "text": "…ふう…。",
            "zh": "……呼……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "89/TALK",
            "narrator": "アーヤ",
            "text": "調べれば調べるほど\n謎が深まっていってる\nみたい……。",
            "zh": "越是深入调查，\n谜团就越是加深了\n似的……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "90/TALK",
            "narrator": "アーヤ",
            "text": "そんな気が\nしませんか？",
            "zh": "你不觉得\n是这样吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "91/TALK",
            "narrator": "真幌",
            "text": "同感だ…。",
            "zh": "同感啊……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "92/TALK",
            "narrator": "真幌",
            "text": "フェノメノンは\n負の感情から生まれた\n竜巻のようなもの。",
            "zh": "PhenoMENON 是\n由负面情绪诞生的\n龙卷风一样的东西。",
            "narrator_zh": "真幌"
        },
        {
            "location": "93/TALK",
            "narrator": "真幌",
            "text": "それを人為的に起こす\nメリットは？",
            "zh": "人为去引发它，\n究竟有什么好处呢？",
            "narrator_zh": "真幌"
        },
        {
            "location": "94/TALK",
            "narrator": "アーヤ",
            "text": "…どちらにしろ\n平和な話には\nならないですよね…。",
            "zh": "……不管怎么想，\n都不会是什么\n好事吧……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "95/TALK",
            "narrator": "真幌",
            "text": "そうだな…。",
            "zh": "是啊……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "96/TALK",
            "narrator": "真幌",
            "text": "とにかく、一日も\n早く全容を\n明かしたい。",
            "zh": "总之，希望能\n尽早把全貌\n查明。",
            "narrator_zh": "真幌"
        },
        {
            "location": "97/TALK",
            "narrator": "真幌",
            "text": "今はみやびに頑張って\nもらわなければ\nいかんな。",
            "zh": "现在就只能让雅\n多加把劲\n了啊。",
            "narrator_zh": "真幌"
        },
        {
            "location": "98/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "99/TALK",
            "narrator": "真幌",
            "text": "ん？　どうした？",
            "zh": "嗯？　怎么了？",
            "narrator_zh": "真幌"
        },
        {
            "location": "100/TALK",
            "narrator": "アーヤ",
            "text": "いえ…。",
            "zh": "没什么……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "102/TALK",
            "narrator": "アーヤ",
            "text": "こんな調子で\n本当に全容を\n明かせるんでしょうか…。",
            "zh": "照这种势头下去，\n真的能查明\n全貌吗……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "103/TALK",
            "narrator": "真幌",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "104/TALK",
            "narrator": "アーヤ",
            "text": "これだけ調べても、\n確かなことは何一つ\nわかってないんです。",
            "zh": "明明调查了这么多，\n却连一件确定的事\n都还没弄明白。",
            "narrator_zh": "绫水"
        },
        {
            "location": "105/TALK",
            "narrator": "アーヤ",
            "text": "なのに、全容を明かす\nなんて、どれだけ先の\nことになるのか…。",
            "zh": "可你说要查明全貌，\n那到底还要等到\n什么时候呢……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "106/TALK",
            "narrator": "真幌",
            "text": "おいおい、珍しく\n弱気じゃないか？",
            "zh": "喂喂，你这可真少见，\n居然说起丧气话了？",
            "narrator_zh": "真幌"
        },
        {
            "location": "107/TALK",
            "narrator": "真幌",
            "text": "おまえには、もっと\nちゃんとしてもらい\nたいんだがな。",
            "zh": "我还指望你能\n更振作一点，\n撑起局面呢。",
            "narrator_zh": "真幌"
        },
        {
            "location": "108/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "109/TALK",
            "narrator": "真幌",
            "text": "…まあ、気持ちは\nわからんでもない\nがな。",
            "zh": "……嘛，你的心情\n我也不是不能理解\n就是了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "110/TALK",
            "narrator": "真幌",
            "text": "だが、すまん。",
            "zh": "不过，抱歉了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "111/TALK",
            "narrator": "真幌",
            "text": "…私も、そう長くは\nないかもしれん。",
            "zh": "……我大概，也剩不下\n多少时间了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "112/TALK",
            "narrator": "アーヤ",
            "text": "…え？",
            "zh": "……诶？",
            "narrator_zh": "绫水"
        },
        {
            "location": "113/TALK",
            "narrator": "真幌",
            "text": "私に何かあったら、\nトライナリーや\n劇場を仕切れ。",
            "zh": "如果我出了什么事，\n三重奏和剧场\n就由你来掌管。",
            "narrator_zh": "真幌"
        },
        {
            "location": "114/TALK",
            "narrator": "真幌",
            "text": "おまえに\n任せたぞ。",
            "zh": "就拜托\n你了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "115/TALK",
            "narrator": "アーヤ",
            "text": "…そんな冗談\nやめてください！",
            "zh": "……别开这种\n玩笑了！",
            "narrator_zh": "绫水"
        },
        {
            "location": "119/TALK",
            "narrator": "アーヤ",
            "text": "…それともやっぱり\n…本気なのかしら？",
            "zh": "……还是说，其实\n……你是认真的吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "120/TALK",
            "narrator": "アーヤ",
            "text": "もし本気\nなんだとしても。",
            "zh": "就算你真的是\n认真的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "121/TALK",
            "narrator": "アーヤ",
            "text": "隊長の任期が\n終わるとか\nそういう意味よ。",
            "zh": "肯定也只是指\n队长的任期快到了\n之类的意思吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "124/TALK",
            "narrator": "アーヤ",
            "text": "絶対…。",
            "zh": "一定是的……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "188/TALK",
            "narrator": "アーヤ",
            "text": "　",
            "zh": "　",
            "narrator_zh": "绫水"
        },
        {
            "location": "204/TALK",
            "narrator": "アーヤ",
            "text": "[ココロゲート]へ\nいらっしゃい。\n$handle$さん。",
            "zh": "欢迎来到\n[心之扉]。\n$handle$。",
            "narrator_zh": "绫水"
        },
        {
            "location": "205/TALK",
            "narrator": "アーヤ",
            "text": "さて、早速だけど。",
            "zh": "好了，事不宜迟。",
            "narrator_zh": "绫水"
        },
        {
            "location": "206/TALK",
            "narrator": "アーヤ",
            "text": "前回の行動が一体どういう\nことなのか、説明して\nもらいましょうか。",
            "zh": "上次那个行动究竟是\n怎么回事，能请你给我\n解释一下吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "207/SEL",
            "narrator": "",
            "text": "ただ誘導されただけです",
            "zh": "我只是被诱导过去了而已",
            "narrator_zh": ""
        },
        {
            "location": "208/SEL",
            "narrator": "",
            "text": "そっちこそ、嘘ついてたじゃない",
            "zh": "你那边不也一样在说谎吗",
            "narrator_zh": ""
        },
        {
            "location": "209/ACT",
            "narrator": "",
            "text": "ただ誘導されただけです",
            "zh": "我只是被诱导过去了而已",
            "narrator_zh": ""
        },
        {
            "location": "210/TALK",
            "narrator": "アーヤ",
            "text": "なるほど。",
            "zh": "原来如此。",
            "narrator_zh": "绫水"
        },
        {
            "location": "211/TALK",
            "narrator": "アーヤ",
            "text": "誘導されれば簡単に\n行っちゃうような\n人なのね。",
            "zh": "你就是那种只要有人\n诱导，就会乖乖跟着\n走的人呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "212/TALK",
            "narrator": "アーヤ",
            "text": "よかった。それじゃ今後は\n私もしっかり誘導するから\nよろしくお願いね。",
            "zh": "太好了。那今后我也会\n好好诱导你的，\n请多关照啦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "213/ACT",
            "narrator": "",
            "text": "そっちこそ、嘘ついてたじゃない",
            "zh": "你那边不也一样在说谎吗",
            "narrator_zh": ""
        },
        {
            "location": "214/TALK",
            "narrator": "アーヤ",
            "text": "必要悪よ。",
            "zh": "那是必要之恶。",
            "narrator_zh": "绫水"
        },
        {
            "location": "215/TALK",
            "narrator": "アーヤ",
            "text": "急に交代なんて言われたら\n貴方も困るでしょ？",
            "zh": "要是突然跟你说换人了，\n你也会很困扰吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "216/TALK",
            "narrator": "アーヤ",
            "text": "説明するのだって\n大変だし。",
            "zh": "解释起来也\n很麻烦的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "217/SEL",
            "narrator": "",
            "text": "司書は嘘をつかないって言ってたよ",
            "zh": "不是说司书不会说谎吗",
            "narrator_zh": ""
        },
        {
            "location": "218/ACT",
            "narrator": "",
            "text": "司書は嘘をつかないって言ってたよ",
            "zh": "不是说司书不会说谎吗",
            "narrator_zh": ""
        },
        {
            "location": "220/TALK",
            "narrator": "アーヤ",
            "text": "誰が？\nそんなルールは\n知らないから。",
            "zh": "谁说的？\n我可不知道有\n那种规矩。",
            "narrator_zh": "绫水"
        },
        {
            "location": "221/TALK",
            "narrator": "アーヤ",
            "text": "だいたい、嘘を全く\nつかないなんて発言自体が\n嘘の賜物じゃない。",
            "zh": "再说了，完全不说谎\n这种发言本身，\n不就是谎言的结晶吗。",
            "narrator_zh": "绫水"
        },
        {
            "location": "222/TALK",
            "narrator": "アーヤ",
            "text": "人と関わりつつ生きていく\n世界では、善悪問わず\n嘘は絶対に出てしまう。",
            "zh": "只要活在需要与人\n打交道的世界里，无论善恶\n都绝对会产生谎言的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "223/TALK",
            "narrator": "アーヤ",
            "text": "まあ、でも、\nあれでしょう？\n言ってたのは前任でしょ？",
            "zh": "不过嘛，\n那个吧？\n说这话的是前任对吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "224/SEL",
            "narrator": "",
            "text": "そうだよ",
            "zh": "是的",
            "narrator_zh": ""
        },
        {
            "location": "225/SEL",
            "narrator": "",
            "text": "つばめの元司書です",
            "zh": "是燕的原司书说的",
            "narrator_zh": ""
        },
        {
            "location": "226/ACT",
            "narrator": "",
            "text": "そうだよ",
            "zh": "是的",
            "narrator_zh": ""
        },
        {
            "location": "227/TALK",
            "narrator": "アーヤ",
            "text": "やっぱり。",
            "zh": "果然。",
            "narrator_zh": "绫水"
        },
        {
            "location": "228/ACT",
            "narrator": "",
            "text": "つばめの元司書です",
            "zh": "是燕的原司书说的",
            "narrator_zh": ""
        },
        {
            "location": "229/TALK",
            "narrator": "アーヤ",
            "text": "そうなのね。\nつばめの元司書も\n言ってたか。",
            "zh": "这样啊。\n连燕的原司书也\n这么说过吗。",
            "narrator_zh": "绫水"
        },
        {
            "location": "230/TALK",
            "narrator": "アーヤ",
            "text": "何か取り決めでも\nしていたのかしら？",
            "zh": "难道说她们之间\n订过什么约定吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "232/TALK",
            "narrator": "アーヤ",
            "text": "平和ぼけしている\n0xの言いそうな事だわ。",
            "zh": "真是被和平冲昏了头的\n0x 会说出来的话呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "233/TALK",
            "narrator": "アーヤ",
            "text": "何にしても、\nこれからは私が\n司書なんだから。",
            "zh": "不管怎样，\n从今往后由我来\n担任司书。",
            "narrator_zh": "绫水"
        },
        {
            "location": "234/TALK",
            "narrator": "アーヤ",
            "text": "私に従って頂戴。",
            "zh": "请你听从我的指示。",
            "narrator_zh": "绫水"
        },
        {
            "location": "236/TALK",
            "narrator": "アーヤ",
            "text": "前任のせいで、だいぶ\n進捗遅れちゃってるし。",
            "zh": "因为前任的缘故，\n进度已经拖慢了很多。",
            "narrator_zh": "绫水"
        },
        {
            "location": "237/TALK",
            "narrator": "アーヤ",
            "text": "お陰でこんな所に\n派遣させられちゃって。\nホント迷惑だわ。",
            "zh": "害得我被派遣到\n这种地方来。\n真是麻烦死了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "238/SEL",
            "narrator": "",
            "text": "随分な言いぐさだね",
            "zh": "你这说法也太不客气了吧",
            "narrator_zh": ""
        },
        {
            "location": "239/SEL",
            "narrator": "",
            "text": "進捗ってなに？",
            "zh": "进度是指什么？",
            "narrator_zh": ""
        },
        {
            "location": "240/ACT",
            "narrator": "",
            "text": "随分な言いぐさだね",
            "zh": "你这说法也太不客气了吧",
            "narrator_zh": ""
        },
        {
            "location": "241/TALK",
            "narrator": "アーヤ",
            "text": "自分が同じ立場に立てば\n愚痴りたくなるのも\nわかるわよ？",
            "zh": "要是你站在同样的立场上，\n也能明白为什么会想\n发牢骚了哦？",
            "narrator_zh": "绫水"
        },
        {
            "location": "242/TALK",
            "narrator": "アーヤ",
            "text": "もし貴方が\n会社勤めの人だったら――",
            "zh": "如果你是个在公司\n上班的打工人——",
            "narrator_zh": "绫水"
        },
        {
            "location": "243/TALK",
            "narrator": "アーヤ",
            "text": "辞めた前任の引き継ぎを\n殆ど資料無しにやりつつ\n次の納期が来週で。",
            "zh": "要在几乎没有交接资料的\n情况下接手离职前任的工作，\n而下个交期就在下周。",
            "narrator_zh": "绫水"
        },
        {
            "location": "244/TALK",
            "narrator": "アーヤ",
            "text": "しかも６ヶ月かけて\n進捗率１０％だったら\nどうする？",
            "zh": "而且花了六个月\n进度率才 10%，\n你会怎么办？",
            "narrator_zh": "绫水"
        },
        {
            "location": "245/SEL",
            "narrator": "",
            "text": "会社辞めます",
            "zh": "辞职走人",
            "narrator_zh": ""
        },
        {
            "location": "246/SEL",
            "narrator": "",
            "text": "頑張って完成させてカリスマになります",
            "zh": "努力做完成为业界传奇",
            "narrator_zh": ""
        },
        {
            "location": "247/ACT",
            "narrator": "",
            "text": "会社辞めます",
            "zh": "辞职走人",
            "narrator_zh": ""
        },
        {
            "location": "248/TALK",
            "narrator": "アーヤ",
            "text": "その気持ち、わかる。",
            "zh": "我懂你的心情。",
            "narrator_zh": "绫水"
        },
        {
            "location": "249/ACT",
            "narrator": "",
            "text": "頑張って完成させてカリスマになります",
            "zh": "努力做完成为业界传奇",
            "narrator_zh": ""
        },
        {
            "location": "250/TALK",
            "narrator": "アーヤ",
            "text": "ポジティブな思考を\n持ってるのね。",
            "zh": "思维还挺积极的\n嘛。",
            "narrator_zh": "绫水"
        },
        {
            "location": "251/TALK",
            "narrator": "アーヤ",
            "text": "その調子で頑張って\n二人でカリスマを\n目指しましょ。",
            "zh": "就保持这股劲头加油，\n我们俩一起以成为\n业界传奇为目标吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "253/ACT",
            "narrator": "",
            "text": "進捗ってなに？",
            "zh": "进度是指什么？",
            "narrator_zh": ""
        },
        {
            "location": "254/TALK",
            "narrator": "アーヤ",
            "text": "世界線誤差。",
            "zh": "世界线误差。",
            "narrator_zh": "绫水"
        },
        {
            "location": "255/TALK",
            "narrator": "アーヤ",
            "text": "今おおよそ１０の\nマイナス８乗程度の\n世界線誤差がある。",
            "zh": "目前大约存在 10 的\n负 8 次方左右的\n世界线误差。",
            "narrator_zh": "绫水"
        },
        {
            "location": "256/TALK",
            "narrator": "アーヤ",
            "text": "これをマイナス２８乗\n以上の所まで持って\nいかなければならない。",
            "zh": "必须把这个数值\n推进到负 28 次方\n以上才行。",
            "narrator_zh": "绫水"
        },
        {
            "location": "257/TALK",
            "narrator": "アーヤ",
            "text": "そうしないと、私たちの\n世界は終わってしまうかも\nしれないの。",
            "zh": "否则的话，我们的\n世界说不定就会\n终结了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "258/SEL",
            "narrator": "",
            "text": "すごい精度だね",
            "zh": "好高的精度要求啊",
            "narrator_zh": ""
        },
        {
            "location": "259/SEL",
            "narrator": "",
            "text": "他のトライナリーもそこに収める必要があるの？",
            "zh": "其他的三重奏成员也需要控制在这个范围内吗？",
            "narrator_zh": ""
        },
        {
            "location": "260/ACT",
            "narrator": "",
            "text": "すごい精度だね",
            "zh": "好高的精度要求啊",
            "narrator_zh": ""
        },
        {
            "location": "261/TALK",
            "narrator": "アーヤ",
            "text": "平行世界の理論からすれば\n大した精度じゃないわ。",
            "zh": "按平行世界的理论来说，\n这并不算多高的精度。",
            "narrator_zh": "绫水"
        },
        {
            "location": "262/ACT",
            "narrator": "",
            "text": "他のトライナリーもそこに収める必要があるの？",
            "zh": "其他的三重奏成员也需要控制在这个范围内吗？",
            "narrator_zh": ""
        },
        {
            "location": "263/TALK",
            "narrator": "アーヤ",
            "text": "もちろん。",
            "zh": "那是当然。",
            "narrator_zh": "绫水"
        },
        {
            "location": "266/TALK",
            "narrator": "アーヤ",
            "text": "だから、\nどうかお願いだから\n協力して欲しい。",
            "zh": "所以，\n拜托你了，请务必\n配合我。",
            "narrator_zh": "绫水"
        },
        {
            "location": "267/TALK",
            "narrator": "アーヤ",
            "text": "私だって本当は、貴方と\nキャッキャウフフ\nしたいけど――",
            "zh": "其实我本来也很想\n和你欢天喜地地腻歪一番\n——",
            "narrator_zh": "绫水"
        },
        {
            "location": "268/TALK",
            "narrator": "アーヤ",
            "text": "こんな状況じゃ、\n我慢して鬼になるしか\nないのよ。",
            "zh": "但眼下这种状况，\n我也只能忍痛\n当回恶人了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "269/TALK",
            "narrator": "アーヤ",
            "text": "そこ、わかって？",
            "zh": "这点，能理解吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "270/SEL",
            "narrator": "",
            "text": "まあ、わかった",
            "zh": "行吧，我知道了",
            "narrator_zh": ""
        },
        {
            "location": "271/SEL",
            "narrator": "",
            "text": "今後の行動次第かな",
            "zh": "那要看你今后的表现了",
            "narrator_zh": ""
        },
        {
            "location": "272/ACT",
            "narrator": "",
            "text": "まあ、わかった",
            "zh": "行吧，我知道了",
            "narrator_zh": ""
        },
        {
            "location": "273/TALK",
            "narrator": "アーヤ",
            "text": "ありがと。",
            "zh": "谢谢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "274/ACT",
            "narrator": "",
            "text": "今後の行動次第かな",
            "zh": "那要看你今后的表现了",
            "narrator_zh": ""
        },
        {
            "location": "275/TALK",
            "narrator": "アーヤ",
            "text": "はいはい。\n随分と上から目線なのね。",
            "zh": "好好好。\n你这居高临下的架子还真不小呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "276/TALK",
            "narrator": "アーヤ",
            "text": "でもこれだけは\n本当に言っておくから。",
            "zh": "不过有一点我必须\n提前说清楚。",
            "narrator_zh": "绫水"
        },
        {
            "location": "277/TALK",
            "narrator": "アーヤ",
            "text": "今私たちが暮らしてる\n世界は、本当に脆い。",
            "zh": "现在我们所生活的\n这个世界，真的很脆弱。",
            "narrator_zh": "绫水"
        },
        {
            "location": "278/TALK",
            "narrator": "アーヤ",
            "text": "例えるなら、風船のように\n針が一本刺さっただけで\n壊れてしまう。",
            "zh": "打个比方，就像气球一样，\n只要扎进一根针\n就会瞬间破灭。",
            "narrator_zh": "绫水"
        },
        {
            "location": "279/TALK",
            "narrator": "アーヤ",
            "text": "だから、\n本当に國政綾水のことを\n大切に想ってるなら……",
            "zh": "所以，\n如果你真的珍视\n国政绫水的话……",
            "narrator_zh": "绫水"
        },
        {
            "location": "280/TALK",
            "narrator": "アーヤ",
            "text": "私の事を嫌ってくれても\n構わないけど、指示に\nだけは従って欲しい。",
            "zh": "你讨厌我也\n无所谓，但至少\n请听从我的指示。",
            "narrator_zh": "绫水"
        },
        {
            "location": "282/TALK",
            "narrator": "アーヤ",
            "text": "それじゃ、今回も\n回すわよ。",
            "zh": "那么，这次也要\n开始运转了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "287/TALK",
            "narrator": "アーヤ",
            "text": "オープンプロセス、\n0x556番地から\n0x192番地へ。",
            "zh": "开放进程，\n从0x556号地址\n到0x192号地址。",
            "narrator_zh": "绫水"
        },
        {
            "location": "309/TALK",
            "narrator": "アーヤ",
            "text": "シーク完了。",
            "zh": "搜索完毕。",
            "narrator_zh": "绫水"
        },
        {
            "location": "312/TALK",
            "narrator": "アーヤ",
            "text": "さて、と。\n今回は……",
            "zh": "那么，\n这次是……",
            "narrator_zh": "绫水"
        },
        {
            "location": "314/TALK",
            "narrator": "アーヤ",
            "text": "館長の心配ね。",
            "zh": "在担心馆长呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "315/TALK",
            "narrator": "アーヤ",
            "text": "ここはそんなに\n思い詰めなくても、気楽に\n話していればいいのに。",
            "zh": "这种事其实根本不用\n钻牛角尖，放轻松点\n聊聊天不就好了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "316/TALK",
            "narrator": "アーヤ",
            "text": "OSの回答にも\nそうあるけど、\n私も同感ね。",
            "zh": "OS 的回答里\n也是这么写的，\n我完全赞同。",
            "narrator_zh": "绫水"
        },
        {
            "location": "317/TALK",
            "narrator": "アーヤ",
            "text": "館長のことは、私本人も\n知らない昔のことから\nよく知ってるけど――",
            "zh": "关于馆长的事，我连她\n自己都不知道的过去\n都一清二楚——",
            "narrator_zh": "绫水"
        },
        {
            "location": "318/TALK",
            "narrator": "アーヤ",
            "text": "殺しても絶対に\n死ぬような\nタマじゃないから。",
            "zh": "她可不是那种就算\n被杀也绝对会死的\n角色。",
            "narrator_zh": "绫水"
        },
        {
            "location": "319/SEL",
            "narrator": "",
            "text": "なんでそんなこと知ってるの？",
            "zh": "为什么你会知道那种事？",
            "narrator_zh": ""
        },
        {
            "location": "320/SEL",
            "narrator": "",
            "text": "急に性格変わってない？",
            "zh": "怎么感觉你性格突然变了？",
            "narrator_zh": ""
        },
        {
            "location": "321/ACT",
            "narrator": "",
            "text": "なんでそんなこと知ってるの？",
            "zh": "为什么你会知道那种事？",
            "narrator_zh": ""
        },
        {
            "location": "322/TALK",
            "narrator": "アーヤ",
            "text": "私は1xだから。",
            "zh": "因为我是 1x 嘛。",
            "narrator_zh": "绫水"
        },
        {
            "location": "323/ACT",
            "narrator": "",
            "text": "それにしても、急に性格変わってない？",
            "zh": "话虽如此，怎么感觉你性格突然变了？",
            "narrator_zh": ""
        },
        {
            "location": "324/TALK",
            "narrator": "アーヤ",
            "text": "まあ、今までは貴方を\n驚かせまいとして、前任の\n性格に合わせてたから。",
            "zh": "嘛，毕竟之前为了\n不吓到你，我一直刻意\n配合着前任的性格。",
            "narrator_zh": "绫水"
        },
        {
            "location": "325/TALK",
            "narrator": "アーヤ",
            "text": "それに、さっきも\n言ったけど、本当に\n今は焦ってるから。",
            "zh": "而且刚才也说了，\n现在我真的\n很焦急。",
            "narrator_zh": "绫水"
        },
        {
            "location": "326/TALK",
            "narrator": "アーヤ",
            "text": "だからどうしても、\n言葉尻も粗くなっちゃう。",
            "zh": "所以说话的语气，\n难免也会变得粗糙一点。",
            "narrator_zh": "绫水"
        },
        {
            "location": "327/TALK",
            "narrator": "アーヤ",
            "text": "もう少し精度が上がって\nくれば、落ち着いてくると\n思うから、ごめんね。",
            "zh": "等精度再稍微提升一点，\n应该就能冷静下来了，\n抱歉啦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "329/TALK",
            "narrator": "アーヤ",
            "text": "それじゃ、そろそろ\n行ってきてもらいます。",
            "zh": "那么，差不多\n该请你出发了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "330/TALK",
            "narrator": "アーヤ",
            "text": "$handle$と\n國政綾水にとって、\n素敵なココロの旅を。",
            "zh": "祝$handle$与\n国政绫水，\n拥有一段美妙的心灵之旅。",
            "narrator_zh": "绫水"
        },
        {
            "location": "23/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>8月27日　 18:17 PM</color>\n合宿中、みやびの実家でのこと",
            "zh": "<color=green>8月27日　 18:17 PM</color>\n集训期间，在雅的老家",
            "narrator_zh": "Dialog_EventData"
        },
        {
            "location": "153/DIALOG",
            "narrator": "BattleInit/Dialog_BATTLE_ch01",
            "text": "<color=black><size=50><b>逢瀬つばめのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n逢瀬つばめの心の葛藤を解消してください。\n\n\n\n",
