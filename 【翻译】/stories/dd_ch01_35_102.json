{
    "dir": "chap35/daydra/dd_ch01_35_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "35105",
        "cid": "tsubame",
        "title": "005 メインストーリー",
        "sub_title": "相容れないもの＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "不能相容之物＜后篇＞"
    },
    "entry": [
        {
            "location": "422/TALK",
            "narrator": "千羽鶴",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "424/TALK",
            "narrator": "千羽鶴",
            "text": "なるほど。\n状況は把握した。",
            "zh": "原来如此。\n情况我知道了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "425/TALK",
            "narrator": "音羽",
            "text": "貴方に勝ち目はない。",
            "zh": "你没有胜算。",
            "narrator_zh": "音羽"
        },
        {
            "location": "426/TALK",
            "narrator": "音羽",
            "text": "私は既につばめちゃんと\nコネクトしてるし――",
            "zh": "我已经和燕\n连接上了——",
            "narrator_zh": "音羽"
        },
        {
            "location": "427/TALK",
            "narrator": "音羽",
            "text": "イシュリールを司る\n人格、カレンもまだ\n生きてる。",
            "zh": "掌管Ishreal的人格，\n卡莲\n也还活着。",
            "narrator_zh": "音羽"
        },
        {
            "location": "429/TALK",
            "narrator": "千羽鶴",
            "text": "……そうみたいね。",
            "zh": "……看来是这样。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "430/TALK",
            "narrator": "千羽鶴",
            "text": "で？\nどうするというの？",
            "zh": "然后？\n你打算怎么办？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "431/TALK",
            "narrator": "音羽",
            "text": "勘違いしないで欲しいのは\n私は貴方に危害を加える\nことが目的じゃない。",
            "zh": "希望你别误会，\n我的目的不是\n加害于你。",
            "narrator_zh": "音羽"
        },
        {
            "location": "432/TALK",
            "narrator": "音羽",
            "text": "だから、これ以上何も\nしなければ、私も貴方に\n何もするつもりはない。",
            "zh": "所以，只要你不再\n多做什么，我也不打算\n对你做什么。",
            "narrator_zh": "音羽"
        },
        {
            "location": "433/TALK",
            "narrator": "音羽",
            "text": "貴方には、神楽のこと\nとかで、色々と責任を\n果たす義務があるから。",
            "zh": "因为你有义务\n为神乐的事之类，\n承担种种责任。",
            "narrator_zh": "音羽"
        },
        {
            "location": "434/TALK",
            "narrator": "千羽鶴",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "435/TALK",
            "narrator": "音羽",
            "text": "けど、それは最悪、\n貴方で無くとも、\nできる事も知ってる。",
            "zh": "可是我知道，\n那件事最坏的情况下，\n就算没有你也能做到。",
            "narrator_zh": "音羽"
        },
        {
            "location": "436/TALK",
            "narrator": "音羽",
            "text": "だから、\n大人しくしていて。",
            "zh": "所以，\n老实待着。",
            "narrator_zh": "音羽"
        },
        {
            "location": "437/TALK",
            "narrator": "千羽鶴",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "438/TALK",
            "narrator": "音羽",
            "text": "つばめちゃん、\n早くこっちへ！",
            "zh": "燕，\n快到这边来！",
            "narrator_zh": "音羽"
        },
        {
            "location": "439/TALK",
            "narrator": "つばめ",
            "text": "は、はい！！",
            "zh": "好、好的！！",
            "narrator_zh": "燕"
        },
        {
            "location": "440/TALK",
            "narrator": "つばめ",
            "text": "お邪魔します！",
            "zh": "打扰啦！",
            "narrator_zh": "燕"
        },
        {
            "location": "447/TALK",
            "narrator": "千羽鶴",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "449/SEL",
            "narrator": "",
            "text": "千羽鶴、大丈夫？\n何でも協力するよ？",
            "zh": "千羽鹤，你没事吗？\n什么忙我都帮？",
            "narrator_zh": ""
        },
        {
            "location": "450/ACT",
            "narrator": "",
            "text": "千羽鶴、大丈夫？\n何でも協力するよ？",
            "zh": "千羽鹤，你没事吗？\n什么忙我都帮？",
            "narrator_zh": ""
        },
        {
            "location": "452/TALK",
            "narrator": "千羽鶴",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "453/SEL",
            "narrator": "",
            "text": "おーい",
            "zh": "喂——",
            "narrator_zh": ""
        },
        {
            "location": "454/ACT",
            "narrator": "",
            "text": "おーい",
            "zh": "喂——",
            "narrator_zh": ""
        },
        {
            "location": "457/SEL",
            "narrator": "",
            "text": "またロクでもないこと企んでるな！？",
            "zh": "又在打什么坏主意吧！？",
            "narrator_zh": ""
        },
        {
            "location": "458/ACT",
            "narrator": "",
            "text": "またロクでもないこと企んでるな！？",
            "zh": "又在打什么坏主意吧！？",
            "narrator_zh": ""
        },
        {
            "location": "460/TALK",
            "narrator": "千羽鶴",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "461/SEL",
            "narrator": "",
            "text": "おい返事しろ！",
            "zh": "喂，回句话！",
            "narrator_zh": ""
        },
        {
            "location": "462/ACT",
            "narrator": "",
            "text": "おい返事しろ！",
            "zh": "喂，回句话！",
            "narrator_zh": ""
        },
        {
            "location": "465/SEL",
            "narrator": "",
            "text": "千羽鶴、何を考えてるの！？",
            "zh": "千羽鹤，你在想什么！？",
            "narrator_zh": ""
        },
        {
            "location": "466/ACT",
            "narrator": "",
            "text": "千羽鶴、何を考えてるの！？",
            "zh": "千羽鹤，你在想什么！？",
            "narrator_zh": ""
        },
        {
            "location": "468/TALK",
            "narrator": "千羽鶴",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "469/SEL",
            "narrator": "",
            "text": "聞こえてない！？\n千羽鶴！！",
            "zh": "没听见吗！？\n千羽鹤！！",
            "narrator_zh": ""
        },
        {
            "location": "470/ACT",
            "narrator": "",
            "text": "聞こえてない！？\n千羽鶴！！",
            "zh": "没听见吗！？\n千羽鹤！！",
            "narrator_zh": ""
        },
        {
            "location": "483/TALK",
            "narrator": "つばめ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "燕"
        },
        {
            "location": "485/TALK",
            "narrator": "つばめ",
            "text": "ここが、\n音羽さんの世界？",
            "zh": "这里，\n是音羽的世界？",
            "narrator_zh": "燕"
        },
        {
            "location": "486/TALK",
            "narrator": "音羽",
            "text": "そう、\nわたしの世界。",
            "zh": "对，\n是我的世界。",
            "narrator_zh": "音羽"
        },
        {
            "location": "487/TALK",
            "narrator": "音羽",
            "text": "そして、つばめちゃんと\n神楽をご招待するために\n作った世界。",
            "zh": "也是为了招待\n燕和神乐\n而造出来的世界。",
            "narrator_zh": "音羽"
        },
        {
            "location": "489/TALK",
            "narrator": "つばめ",
            "text": "作った……世界？",
            "zh": "造出来的……世界？",
            "narrator_zh": "燕"
        },
        {
            "location": "491/TALK",
            "narrator": "つばめ",
            "text": "そういえば、\nどこかで見たような……",
            "zh": "这么一说，\n好像在哪里见过……",
            "narrator_zh": "燕"
        },
        {
            "location": "492/TALK",
            "narrator": "つばめ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "燕"
        },
        {
            "location": "494/TALK",
            "narrator": "つばめ",
            "text": "あっ！\nこれってもしかして！！",
            "zh": "啊！\n该不会是！！",
            "narrator_zh": "燕"
        },
        {
            "location": "495/TALK",
            "narrator": "音羽",
            "text": "そう、Wishreal…\nイシュリールの世界。",
            "zh": "对，Wishreal……\nIshreal的世界。",
            "narrator_zh": "音羽"
        },
        {
            "location": "496/TALK",
            "narrator": "音羽",
            "text": "イシュリールの物語に\n出てきた、\nエルカドールの謳う丘。",
            "zh": "Ishreal的故事里\n出现过的，\n艾尔卡多尔的歌之丘。",
            "narrator_zh": "音羽"
        },
        {
            "location": "499/TALK",
            "narrator": "つばめ",
            "text": "すごい……\n本当に謳う丘に\nいるみたい……！！",
            "zh": "好厉害……\n好像真的\n站在歌之丘上……！！",
            "narrator_zh": "燕"
        },
        {
            "location": "500/TALK",
            "narrator": "音羽",
            "text": "気に入って貰えて嬉しい。",
            "zh": "你能喜欢，我很高兴。",
            "narrator_zh": "音羽"
        },
        {
            "location": "501/TALK",
            "narrator": "音羽",
            "text": "でも、この世界は\n私の作り物だから、私が\n消えたら無くなるけど。",
            "zh": "不过，这个世界\n是我做出来的，我若\n消失，它也会消失。",
            "narrator_zh": "音羽"
        },
        {
            "location": "502/TALK",
            "narrator": "音羽",
            "text": "その時は、つばめちゃんも\n強制的に追い出される。\nごめんね。",
            "zh": "那时候，燕\n也会被强行赶出去。\n对不起哦。",
            "narrator_zh": "音羽"
        },
        {
            "location": "504/TALK",
            "narrator": "つばめ",
            "text": "そんな、気にしなくても\n大丈夫です。",
            "zh": "哪有，\n不用在意的。",
            "narrator_zh": "燕"
        },
        {
            "location": "505/TALK",
            "narrator": "つばめ",
            "text": "たとえ、今無くなっ\nちゃったとしても、\nとても嬉しいから。",
            "zh": "就算它现在\n就消失掉，\n我也很高兴。",
            "narrator_zh": "燕"
        },
        {
            "location": "506/TALK",
            "narrator": "つばめ",
            "text": "わたしを……\nわたしの生きる力を\n支えてくれた世界だから。",
            "zh": "因为这是……\n支撑过我、\n支撑我活下去的世界。",
            "narrator_zh": "燕"
        },
        {
            "location": "507/TALK",
            "narrator": "音羽",
            "text": "……そっか。",
            "zh": "……是吗。",
            "narrator_zh": "音羽"
        },
        {
            "location": "508/TALK",
            "narrator": "音羽",
            "text": "それじゃ今から、\n神楽を呼び込むけど。",
            "zh": "那现在，\n我要把神乐叫进来。",
            "narrator_zh": "音羽"
        },
        {
            "location": "509/TALK",
            "narrator": "音羽",
            "text": "その前にちょっとだけ\n眠っていて欲しいの。",
            "zh": "在那之前，\n希望你先睡一会儿。",
            "narrator_zh": "音羽"
        },
        {
            "location": "511/TALK",
            "narrator": "つばめ",
            "text": "え？\nそうなの？",
            "zh": "诶？\n是这样吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "512/TALK",
            "narrator": "音羽",
            "text": "うん。",
            "zh": "嗯。",
            "narrator_zh": "音羽"
        },
        {
            "location": "513/TALK",
            "narrator": "音羽",
            "text": "つばめちゃんに対しても\n大事な準備があるから。",
            "zh": "对燕，\n也有要紧的准备要做。",
            "narrator_zh": "音羽"
        },
        {
            "location": "514/TALK",
            "narrator": "音羽",
            "text": "信用してもらえるか\nわからないけど、\nお願い出来る？",
            "zh": "不知道你肯不肯相信，\n不过，\n可以拜托你吗？",
            "narrator_zh": "音羽"
        },
        {
            "location": "516/TALK",
            "narrator": "つばめ",
            "text": "もちろんです。\n宜しくお願いします！",
            "zh": "当然。\n拜托你啦！",
            "narrator_zh": "燕"
        },
        {
            "location": "517/TALK",
            "narrator": "音羽",
            "text": "ありがとう。",
            "zh": "谢谢。",
            "narrator_zh": "音羽"
        },
        {
            "location": "518/TALK",
            "narrator": "音羽",
            "text": "それじゃ、つばめちゃん\n目を瞑って。",
            "zh": "那么，燕，\n闭上眼睛。",
            "narrator_zh": "音羽"
        },
        {
            "location": "519/TALK",
            "narrator": "つばめ",
            "text": "…はい。",
            "zh": "……好的。",
            "narrator_zh": "燕"
        },
        {
            "location": "520/TALK",
            "narrator": "音羽",
            "text": "少しゆっくり休んでね。",
            "zh": "稍微安心休息一下哦。",
            "narrator_zh": "音羽"
        },
        {
            "location": "521/TALK",
            "narrator": "音羽",
            "text": "つばめちゃんと\n神楽に、\n素敵なココロの旅を――",
            "zh": "愿燕\n和神乐，\n有一场美妙的心灵之旅——",
            "narrator_zh": "音羽"
        },
        {
            "location": "418/DIALOG",
            "narrator": "NOTICE",
            "text": "<color=green>【TRI-OS Plug-in:Interrupt】</color>\nSystem Interrupted.\n\n必須選択肢が選ばれていません。\n\n<color=green>『STORY27：シン・カグラ』</color>\nにて、選択を行ってから\n再度アクセスしてください。\n",
            "zh": "<color=green>【TRI-OS Plug-in:Interrupt】</color>\nSystem Interrupted.\n\n尚未选择必须选项。\n\n<color=green>『STORY27：新·神乐』</color>\n请在其中做出选择后\n再次访问。\n",
            "narrator_zh": "NOTICE"
        },
        {
            "location": "534/DIALOG",
            "narrator": "Dialog_chapter_ch01",
            "text": "【29 羽とアリス】",
            "zh": "【29 羽与爱丽丝】",
            "narrator_zh": "Dialog_chapter_ch01"
        }
    ]
