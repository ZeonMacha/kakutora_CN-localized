   "text": "殺人事件が起こるやつだ"
  },
  {
   "location": "681/ACT",
   "narrator": "",
   "text": "お召し列車だ",
   "zh": "这是御用列车",
   "narrator_zh": ""
  },
  {
   "location": "682/TALK",
   "narrator": "みやび",
   "text": "宮家ゆかりの人物なのは"
  },
  {
   "location": "683/TALK",
   "narrator": "みやび",
   "text": "うちなのか"
  },
  {
   "location": "684/TALK",
   "narrator": "みやび",
   "text": "$handle$なのか",
   "zh": "是$handle$啊",
   "narrator_zh": "雅"
  },
  {
   "location": "685/ACT",
   "narrator": "",
   "text": "流行ってるよね",
   "zh": "挺流行的吧",
   "narrator_zh": ""
  },
  {
   "location": "686/TALK",
   "narrator": "みやび",
   "text": "うむ",
   "zh": "嗯",
   "narrator_zh": "雅"
  },
  {
   "location": "688/TALK",
   "narrator": "みやび",
   "text": "どちらかというと",
   "zh": "要说的话",
   "narrator_zh": "雅"
  },
  {
   "location": "689/TALK",
   "narrator": "みやび",
   "text": "年配向けだがの"
  },
  {
   "location": "692/SEL",
   "narrator": "",
   "text": "ところで",
   "zh": "对了",
   "narrator_zh": ""
  },
  {
   "location": "693/SEL",
   "narrator": "",
   "text": "ええと",
   "zh": "那个",
   "narrator_zh": ""
  },
  {
   "location": "694/SEL",
   "narrator": "",
   "text": "ちょっと聞きたい",
   "zh": "想问一下",
   "narrator_zh": ""
  },
  {
   "location": "695/ACT",
   "narrator": "",
   "text": "ところで",
   "zh": "对了",
   "narrator_zh": ""
  },
  {
   "location": "696/TALK",
   "narrator": "みやび",
   "text": "うむ",
   "zh": "嗯",
   "narrator_zh": "雅"
  },
  {
   "location": "697/ACT",
   "narrator": "",
   "text": "ええと",
   "zh": "那个",
   "narrator_zh": ""
  },
  {
   "location": "698/TALK",
   "narrator": "みやび",
   "text": "何か思い出したか"
  },
  {
   "location": "699/ACT",
   "narrator": "",
   "text": "ちょっと聞きたい",
   "zh": "想问一下",
   "narrator_zh": ""
  },
  {
   "location": "700/TALK",
   "narrator": "みやび",
   "text": "答えられることなら何でも"
  },
  {
   "location": "703/SEL",
   "narrator": "",
   "text": "直接話そうよ",
   "zh": "我们直接聊吧",
   "narrator_zh": ""
  },
  {
   "location": "704/SEL",
   "narrator": "",
   "text": "何でチャットなの",
   "zh": "为什么用聊天",
   "narrator_zh": ""
  },
  {
   "location": "705/SEL",
   "narrator": "",
   "text": "意外と応用利かないタイプ？",
   "zh": "是意外地不会变通的类型？",
   "narrator_zh": ""
  },
  {
   "location": "706/ACT",
   "narrator": "",
   "text": "直接話そうよ",
   "zh": "我们直接聊吧",
   "narrator_zh": ""
  },
  {
   "location": "707/TALK",
   "narrator": "みやび",
   "text": "まあそういう"
  },
  {
   "location": "708/TALK",
   "narrator": "みやび",
   "text": "意見もあるな"
  },
  {
   "location": "709/ACT",
   "narrator": "",
   "text": "何でチャットなの",
   "zh": "为什么用聊天",
   "narrator_zh": ""
  },
  {
   "location": "711/TALK",
   "narrator": "みやび",
   "text": "なんでと",
   "zh": "为什么",
   "narrator_zh": "雅"
  },
  {
   "location": "712/TALK",
   "narrator": "みやび",
   "text": "聞かれても",
   "zh": "就算你这么问",
   "narrator_zh": "雅"
  },
  {
   "location": "713/ACT",
   "narrator": "",
   "text": "意外と応用利かないタイプ？",
   "zh": "是意外地不会变通的类型？",
   "narrator_zh": ""
  },
  {
   "location": "714/TALK",
   "narrator": "みやび",
   "text": "なんと",
   "zh": "岂料",
   "narrator_zh": "雅"
  },
  {
   "location": "715/TALK",
   "narrator": "みやび",
   "text": "それは",
   "zh": "这个",
   "narrator_zh": "雅"
  },
  {
   "location": "716/TALK",
   "narrator": "みやび",
   "text": "聞き捨てならん"
  },
  {
   "location": "717/TALK",
   "narrator": "みやび",
   "text": "うちに対して"
  },
  {
   "location": "718/TALK",
   "narrator": "みやび",
   "text": "なんということを",
   "zh": "怎么会这样",
   "narrator_zh": "雅"
  },
  {
   "location": "719/TALK",
   "narrator": "みやび",
   "text": "不敬である"
  },
  {
   "location": "720/TALK",
   "narrator": "みやび",
   "text": "その考えは",
   "zh": "那个想法",
   "narrator_zh": "雅"
  },
  {
   "location": "721/TALK",
   "narrator": "みやび",
   "text": "早急に改めるべきだぞ"
  },
  {
   "location": "722/TALK",
   "narrator": "みやび",
   "text": "$handle$め",
   "zh": "$handle$这家伙",
   "narrator_zh": "雅"
  },
  {
   "location": "729/TALK",
   "narrator": "みやび",
   "text": "こうやって話したら\n満足なんかね？\n$handle$は。",
   "zh": "这样聊过就\n满足了吗？\n$handle$。",
   "narrator_zh": "雅"
  },
  {
   "location": "730/SEL",
   "narrator": "",
   "text": "一応は",
   "zh": "算是吧",
   "narrator_zh": ""
  },
  {
   "location": "731/SEL",
   "narrator": "",
   "text": "本当はどっちでもいい",
   "zh": "其实哪个都行",
   "narrator_zh": ""
  },
  {
   "location": "732/SEL",
   "narrator": "",
   "text": "大満足！"
  },
  {
   "location": "733/ACT",
   "narrator": "",
   "text": "一応は",
   "zh": "算是吧",
   "narrator_zh": ""
  },
  {
   "location": "734/TALK",
   "narrator": "みやび",
   "text": "その程度の話かね。",
   "zh": "是这种程度的事嘛。",
   "narrator_zh": "雅"
  },
  {
   "location": "735/ACT",
   "narrator": "",
   "text": "本当はどっちでもいい",
   "zh": "其实哪个都行",
   "narrator_zh": ""
  },
  {
   "location": "736/TALK",
   "narrator": "みやび",
   "text": "心が広いと言えなくは\nないかもしれん。"
  },
  {
   "location": "737/TALK",
   "narrator": "みやび",
   "text": "…結局どっちぞね？",
   "zh": "……最后到底是哪边咯？",
   "narrator_zh": "雅"
  },
  {
   "location": "738/ACT",
   "narrator": "",
   "text": "大満足！"
  },
  {
   "location": "739/TALK",
   "narrator": "みやび",
   "text": "妙な評価サイトの\n評価みたいに…。"
  },
  {
   "location": "741/TALK",
   "narrator": "みやび",
   "text": "そういうのもどうかと\n思うちや。",
   "zh": "那种我觉得\n有点那个咯。",
   "narrator_zh": "雅"
  },
  {
   "location": "743/TALK",
   "narrator": "みやび",
   "text": "それはそれとして。",
   "zh": "这件事另说。",
   "narrator_zh": "雅"
  },
  {
   "location": "744/TALK",
   "narrator": "みやび",
   "text": "$handle$は\n水族館で\nよかったんかね？",
   "zh": "$handle$去水族馆\n就好咯？\n",
   "narrator_zh": "雅"
  },
  {
   "location": "745/SEL",
   "narrator": "",
   "text": "いいも悪いもないよ",
   "zh": "也没什么好不好的",
   "narrator_zh": ""
  },
  {
   "location": "746/SEL",
   "narrator": "",
   "text": "もっと遠いところのに\n行きたかった"
  },
  {
   "location": "747/SEL",
   "narrator": "",
   "text": "すごく楽しみにしてる",
   "zh": "特别期待",
   "narrator_zh": ""
  },
  {
   "location": "748/ACT",
   "narrator": "",
   "text": "いいも悪いもないよ",
   "zh": "也没什么好不好的",
   "narrator_zh": ""
  },
  {
   "location": "749/TALK",
   "narrator": "みやび",
   "text": "嫌も応もという風には\n話してないつもりや\nけんど。"
  },
  {
   "location": "750/TALK",
   "narrator": "みやび",
   "text": "見解の相違ちう\nやつかねえ。"
  },
  {
   "location": "751/ACT",
   "narrator": "",
   "text": "もっと遠い水族館に\n行きたかった"
  },
  {
   "location": "752/TALK",
   "narrator": "みやび",
   "text": "それは今度\n行けばいいぞね。",
   "zh": "那个下次\n去就行了咯。",
   "narrator_zh": "雅"
  },
  {
   "location": "753/TALK",
   "narrator": "みやび",
   "text": "それではいかんかね？",
   "zh": "那样不行嘛？",
   "narrator_zh": "雅"
  },
  {
   "location": "754/ACT",
   "narrator": "",
   "text": "すごく楽しみにしてる",
   "zh": "特别期待",
   "narrator_zh": ""
  },
  {
   "location": "755/TALK",
   "narrator": "みやび",
   "text": "$handle$は\n意外とマニアぞね。",
   "zh": "$handle$意外还挺小众咯。\n",
   "narrator_zh": "雅"
  },
  {
   "location": "756/TALK",
   "narrator": "みやび",
   "text": "あそこのよさが\nわかるとは。"
  },
  {
   "location": "758/TALK",
   "narrator": "みやび",
   "text": "東京湾に注ぐ川の\n展示は地味すぎて\nむしろ楽しいし。"
  },
  {
   "location": "759/TALK",
   "narrator": "みやび",
   "text": "ブーム初期に導入した\nクラゲ水槽たちは\n納得の地味さ。"
  },
  {
   "location": "760/TALK",
   "narrator": "みやび",
   "text": "ベタにアマゾンの\n魚たちもおるが\nやはり地味。"
  },
  {
   "location": "762/TALK",
   "narrator": "みやび",
   "text": "うち的には地味さが\n大変に好ましいぞね。"
  },
  {
   "location": "763/SEL",
   "narrator": "",
   "text": "えと…ディスってる？",
   "zh": "那个…是在说我坏话？",
   "narrator_zh": ""
  },
  {
   "location": "764/SEL",
   "narrator": "",
   "text": "ふれあうのも\n難しそうだしね",
   "zh": "想碰一碰\n好像也挺难的",
   "narrator_zh": ""
  },
  {
   "location": "765/SEL",
   "narrator": "",
   "text": "そんなところに\nなんでわざわざ…",
   "zh": "那种地方\n何必特地……",
   "narrator_zh": ""
  },
  {
   "location": "766/ACT",
   "narrator": "",
   "text": "えと…ディスってる？",
   "zh": "那个…是在说我坏话？",
   "narrator_zh": ""
  },
  {
   "location": "767/TALK",
   "narrator": "みやび",
   "text": "まさか。",
   "zh": "怎么会。",
   "narrator_zh": "雅"
  },
  {
   "location": "768/TALK",
   "narrator": "みやび",
   "text": "$handle$は\n悪い風にとりすぎぞね。",
   "zh": "$handle$想得太坏了咯。\n",
   "narrator_zh": "雅"
  },
  {
   "location": "769/ACT",
   "narrator": "",
   "text": "ふれあうのも\n難しそうだしね",
   "zh": "想碰一碰\n好像也挺难的",
   "narrator_zh": ""
  },
  {
   "location": "770/TALK",
   "narrator": "みやび",
   "text": "それが実は\nふれあいコーナーも\nあるきね。",
   "zh": "其实那里也\n还有亲密接触\n角咯。",
   "narrator_zh": "雅"
  },
  {
   "location": "771/TALK",
   "narrator": "みやび",
   "text": "地味ながらポイントは\n押さえた展示を\nしちゅう。"
  },
  {
   "location": "772/ACT",
   "narrator": "",
   "text": "そんなところに\nなんでわざわざ…",
   "zh": "那种地方\n何必特地……",
   "narrator_zh": ""
  },
  {
   "location": "773/TALK",
   "narrator": "みやび",
   "text": "わびとさびと風流が\nあるきね。"
  },
  {
   "location": "774/TALK",
   "narrator": "みやび",
   "text": "しみじみとした\nよさを味わいに\n行くぞね。"
  },
  {
   "location": "792/TALK",
   "narrator": "みやび",
   "text": "見てみい、\n$handle$。"
  },
  {
   "location": "793/TALK",
   "narrator": "みやび",
   "text": "東京湾に注ぐ\n吃水域が見事に\n再現されとるろう。"
  },
  {
   "location": "794/SEL",
   "narrator": "",
   "text": "お、おう",
   "zh": "哦、哦",
   "narrator_zh": ""
  },
  {
   "location": "795/SEL",
   "narrator": "",
   "text": "予想以上に地味…",
   "zh": "比预想的还朴素……",
   "narrator_zh": ""
  },
  {
   "location": "796/SEL",
   "narrator": "",
   "text": "もう実際東京湾に\n見に行った方が\nよくない？",
   "zh": "不如真的去东京湾\n亲眼看看，\n不是更好吗？",
   "narrator_zh": ""
  },
  {
   "location": "797/ACT",
   "narrator": "",
   "text": "お、おう",
   "zh": "哦、哦",
   "narrator_zh": ""
  },
  {
   "location": "799/TALK",
   "narrator": "みやび",
   "text": "盛り上がりに欠ける\n反応やねえ。"
  },
  {
   "location": "800/ACT",
   "narrator": "",
   "text": "予想以上に地味…",
   "zh": "比预想的还朴素……",
   "narrator_zh": ""
  },
  {
   "location": "801/TALK",
   "narrator": "みやび",
   "text": "これがリアルぞね。",
   "zh": "这才是真实咯。",
   "narrator_zh": "雅"
  },
  {
   "location": "802/ACT",
   "narrator": "",
   "text": "もう実際東京湾に\n見に行った方が\nよくない？",
   "zh": "不如真的去东京湾\n亲眼看看，\n不是更好吗？",
   "narrator_zh": ""
  },
  {
   "location": "803/TALK",
   "narrator": "みやび",
   "text": "そういうわけには\nいかんき。",
   "zh": "可不能\n那样咯。",
   "narrator_zh": "雅"
  },
  {
   "location": "804/TALK",
   "narrator": "みやび",
   "text": "素人が適当に\nウロウロしても。"
  },
  {
   "location": "805/TALK",
   "narrator": "みやび",
   "text": "ここまで色々は\n生き物を\n見つけられん。",
   "zh": "到这里为止，很多\n生物就\n找不到了。",
   "narrator_zh": "雅"
  },
  {
   "location": "806/TALK",
   "narrator": "みやび",
   "text": "それに生き物を\n見つけても。",
   "zh": "而且就算发现了\n生物。",
   "narrator_zh": "雅"
  },
  {
   "location": "807/TALK",
   "narrator": "みやび",
   "text": "その先の解説は\n自力で検索する\n必要があるろう。",
   "zh": "那之后的解说\n大概得自己\n去查啵。",
   "narrator_zh": "雅"
  },
  {
   "location": "808/TALK",
   "narrator": "みやび",
   "text": "素人にとって\n種の同定は意外と\n難問ぞね。"
  },
  {
   "location": "809/TALK",
   "narrator": "みやび",
   "text": "そう考えると\nやはりここがベストと\n言えんかねえ。",
   "zh": "这么一想，果然还是\n这里最合适，\n不能这么说嘛。",
   "narrator_zh": "雅"
  },
  {
   "location": "810/SEL",
   "narrator": "",
   "text": "そういう趣味が\nあったんだ？",
   "zh": "原来你有\n那种爱好？",
   "narrator_zh": ""
  },
  {
   "location": "811/SEL",
   "narrator": "",
   "text": "なんか意外すぎる",
   "zh": "太意外了",
   "narrator_zh": ""
  },
  {
   "location": "812/SEL",
   "narrator": "",
   "text": "本当は焼けるのが\n嫌なだけでしょ",
   "zh": "其实你只是不想\n被晒吧",
   "narrator_zh": ""
  },
  {
   "location": "813/ACT",
   "narrator": "",
   "text": "そういう趣味が\nあったんだ？",
   "zh": "原来你有\n那种爱好？",
   "narrator_zh": ""
  },
  {
   "location": "814/TALK",
   "narrator": "みやび",
   "text": "そうみたいぞね。",
   "zh": "好像是那样咯。",
   "narrator_zh": "雅"
  },
  {
   "location": "815/ACT",
