   "text": "なんとゴージャスな",
   "zh": "多么华丽",
   "narrator_zh": "雅"
  },
  {
   "location": "679/TALK",
   "narrator": "みやび",
   "text": "しかしそれは"
  },
  {
   "location": "680/TALK",
