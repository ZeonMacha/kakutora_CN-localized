{
    "dir": "chap18/daydra/dd_ch04_18_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "18405",
        "cid": "miyabi",
        "title": "005 メインストーリー",
        "sub_title": "WAREZ＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "WAREZ＜后篇＞"
    },
    "entry": [
        {
            "location": "478/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "479/TALK",
            "narrator": "みやび",
            "text": "いや…もう悩むのは\nやめやな。",
            "zh": "算了……别再\n烦恼下去咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "480/TALK",
            "narrator": "みやび",
            "text": "警戒は緩められん\nけんど。",
            "zh": "但是警戒\n不能松。",
            "narrator_zh": "雅"
        },
        {
            "location": "481/TALK",
            "narrator": "みやび",
            "text": "ウサギに会いたい\n気持ちは本当やき。",
            "zh": "想见兔子的\n心情是真的啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "482/TALK",
            "narrator": "みやび",
            "text": "…オッサンやない\nことを祈ってるぞね。",
            "zh": "…就祈祷你\n不是个大叔咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "507/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "508/TALK",
            "narrator": "みやび",
            "text": "ウサギ…おるんか？",
            "zh": "兔子……在吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "509/TALK",
            "narrator": "みやび",
            "text": "言う通りに来たがよ。\nおるんやったら\n姿現しぃ。",
            "zh": "照你说的来咯。\n要是在的话\n就现身咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "511/TALK",
            "narrator": "みやび",
            "text": "……ん？",
            "zh": "……嗯？",
            "narrator_zh": "雅"
        },
        {
            "location": "517/TALK",
            "narrator": "繭",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "茧"
        },
        {
            "location": "518/TALK",
            "narrator": "みやび",
            "text": "…光月さん？",
            "zh": "…光月？",
            "narrator_zh": "雅"
        },
        {
            "location": "519/TALK",
            "narrator": "繭",
            "text": "こんにちは、\nみやび先輩。",
            "zh": "你好，\n雅前辈。",
            "narrator_zh": "茧"
        },
        {
            "location": "520/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "521/TALK",
            "narrator": "繭",
            "text": "みやび先輩？",
            "zh": "雅前辈？",
            "narrator_zh": "茧"
        },
        {
            "location": "522/TALK",
            "narrator": "みやび",
            "text": "あ、すまん。\nこんにちは。",
            "zh": "啊，没好意思。\n你好。",
            "narrator_zh": "雅"
        },
        {
            "location": "524/TALK",
            "narrator": "みやび",
            "text": "…マジか。\nこのタイミングで\n屋上におるとは。",
            "zh": "…真的假的。\n居然挑这个时机\n待在天台。",
            "narrator_zh": "雅"
        },
        {
            "location": "525/TALK",
            "narrator": "みやび",
            "text": "ちっくとタイミング\n悪過ぎぞね。",
            "zh": "这时机\n也差得太巧了咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "527/TALK",
            "narrator": "みやび",
            "text": "光月さん、\n申し訳ないけんど\n今からここで――",
            "zh": "光月，\n没好意思，但现在\n我要在这里——",
            "narrator_zh": "雅"
        },
        {
            "location": "528/TALK",
            "narrator": "繭",
            "text": "お待ちしてました、\nみやび先輩。",
            "zh": "恭候多时了，\n雅前辈。",
            "narrator_zh": "茧"
        },
        {
            "location": "529/TALK",
            "narrator": "みやび",
            "text": "…ん？",
            "zh": "…嗯？",
            "narrator_zh": "雅"
        },
        {
            "location": "530/TALK",
            "narrator": "繭",
            "text": "驚きました…。\nまさか、こんなにも\n近くにいたなんて…。",
            "zh": "我好惊讶……。\n没想到，居然\n离得这么近……。",
            "narrator_zh": "茧"
        },
        {
            "location": "531/TALK",
            "narrator": "みやび",
            "text": "…なんや？\n光月さんは、\n何を言うてるが？",
            "zh": "…驷马？\n光月你在\n说驷马咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "532/TALK",
            "narrator": "繭",
            "text": "…わかりませんか？\nみやび先輩。",
            "zh": "…还不明白吗？\n雅前辈。",
            "narrator_zh": "茧"
        },
        {
            "location": "533/TALK",
            "narrator": "繭",
            "text": "いえ…Ｆａｔａｌ\nＱｕｅｅｎ。",
            "zh": "不……Ｆａｔａｌ\nＱｕｅｅｎ。",
            "narrator_zh": "茧"
        },
        {
            "location": "537/TALK",
            "narrator": "みやび",
            "text": "っ！？",
            "zh": "——！？",
            "narrator_zh": "雅"
        },
        {
            "location": "538/TALK",
            "narrator": "みやび",
            "text": "どういうことや！？\nどうして光月さんが\n何故その名を…。",
            "zh": "这是驷马情况！？\n光月你为什么\n会知道这个名字……。",
            "narrator_zh": "雅"
        },
        {
            "location": "539/TALK",
            "narrator": "みやび",
            "text": "まさか…この子が？",
            "zh": "难道说……这孩子就是？",
            "narrator_zh": "雅"
        },
        {
            "location": "541/TALK",
            "narrator": "みやび",
            "text": "…うちのハンドル\nネーム、まさか\n知っちょるとはね。",
            "zh": "…我的网名，\n居然会被\n知道咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "542/TALK",
            "narrator": "みやび",
            "text": "それで？\nそれがどうかしたが？",
            "zh": "所以呢？\n那又怎么样咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "543/TALK",
            "narrator": "繭",
            "text": "えっ！？\nまだお気づきに\nなりませんか？",
            "zh": "诶！？\n还没注意到\n吗？",
            "narrator_zh": "茧"
        },
        {
            "location": "544/TALK",
            "narrator": "繭",
            "text": "私です！\nＲＡＢＢＩＴ\nＡＮＩＭＡですよ！",
            "zh": "是我呀！\n就是ＲＡＢＢＩＴ\nＡＮＩＭＡ！",
            "narrator_zh": "茧"
        },
        {
            "location": "546/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "548/TALK",
            "narrator": "みやび",
            "text": "え？　いや、\nちっくと待ちぃ。",
            "zh": "诶？不，\n等子先。",
            "narrator_zh": "雅"
        },
        {
            "location": "550/TALK",
            "narrator": "みやび",
            "text": "つまり…光月さんが、\nウサギ？",
            "zh": "也就是说……光月\n就是兔子？",
            "narrator_zh": "雅"
        },
        {
            "location": "551/TALK",
            "narrator": "繭",
            "text": "はい！\nウサギですよ、\nクイーン。",
            "zh": "是的！\n我就是兔子，\n女王。",
            "narrator_zh": "茧"
        },
        {
            "location": "553/TALK",
            "narrator": "みやび",
            "text": "……う……",
            "zh": "……呜……",
            "narrator_zh": "雅"
        },
        {
            "location": "556/TALK",
            "narrator": "みやび",
            "text": "嘘やろーっ！？",
            "zh": "骗人的吧——！？",
            "narrator_zh": "雅"
        },
        {
            "location": "557/TALK",
            "narrator": "みやび",
            "text": "まっこと！？\nまっことＲＡＢＢＩＴ\nＡＮＩＭＡなんか！？",
            "zh": "真的！？\n真的是ＲＡＢＢＩＴ\nＡＮＩＭＡ什么的！？",
            "narrator_zh": "雅"
        },
        {
            "location": "559/TALK",
            "narrator": "繭",
            "text": "そうです！\n私がＲＡＢＢＩＴ\nＡＮＩＭＡです。",
            "zh": "是的！\n我就是ＲＡＢＢＩＴ\nＡＮＩＭＡ。",
            "narrator_zh": "茧"
        },
        {
            "location": "560/TALK",
            "narrator": "繭",
            "text": "あ、オフでは…、\n初めまして…。",
            "zh": "啊，线下见面的话……\n初次见面……。",
            "narrator_zh": "茧"
        },
        {
            "location": "561/TALK",
            "narrator": "みやび",
            "text": "…はは、あははは！",
            "zh": "…哈哈，啊哈哈哈哈！",
            "narrator_zh": "雅"
        },
        {
            "location": "562/TALK",
            "narrator": "みやび",
            "text": "そうか！\nそうかぁ！",
            "zh": "原来如此！\n原来如此啊！",
            "narrator_zh": "雅"
        },
        {
            "location": "563/TALK",
            "narrator": "みやび",
            "text": "光月さんがウサギ\nやったかぁ！",
            "zh": "光月居然\n是兔子啊！",
            "narrator_zh": "雅"
        },
        {
            "location": "564/TALK",
            "narrator": "繭",
            "text": "はい、そうです！",
            "zh": "是的，没错！",
            "narrator_zh": "茧"
        },
        {
            "location": "565/TALK",
            "narrator": "みやび",
            "text": "そうか…光月さんが\nウサギやったかぁ…。",
            "zh": "原来如此……光月\n居然是兔子啊……。",
            "narrator_zh": "雅"
        },
        {
            "location": "566/TALK",
            "narrator": "みやび",
            "text": "…ん？　けんど、\nなんでわかったが？",
            "zh": "…嗯？但是，\n你是怎么发现的咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "567/TALK",
            "narrator": "繭",
            "text": "前回フェノメノンが\n出現した時\nなんですけど。",
            "zh": "是上次 PhenoMENON\n出现的时候\n的事情。",
            "narrator_zh": "茧"
        },
        {
            "location": "568/TALK",
            "narrator": "繭",
            "text": "私は光月繭として、\nみやび先輩に手伝いを\n申し出ましたよね？",
            "zh": "我以光月茧的身份，\n向雅前辈提出过\n帮忙来着，对吧？",
            "narrator_zh": "茧"
        },
        {
            "location": "569/TALK",
            "narrator": "繭",
            "text": "その際、光月繭の方へ\n送った作業は、簡単な\nものばかりでした。",
            "zh": "当时分给光月茧\n那边的工作，\n净是简单的活。",
            "narrator_zh": "茧"
        },
        {
            "location": "570/TALK",
            "narrator": "みやび",
            "text": "それは…光月さんが\nウサギとは思わん\nかったきね。",
            "zh": "那是因为……没想过\n光月你会是\n兔子啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "571/TALK",
            "narrator": "みやび",
            "text": "そこまで出来る\n人間とは知らんかった\nがよ。",
            "zh": "没料到你是\n本事大到这种地步的\n人类咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "572/TALK",
            "narrator": "繭",
            "text": "仕方ありません。\n意図的にそう見せて\nいましたので。",
            "zh": "没办法。\n那是我故意装出来\n的样子。",
            "narrator_zh": "茧"
        },
        {
            "location": "573/TALK",
            "narrator": "みやび",
            "text": "…あ、わかった！",
            "zh": "…啊，我懂了！",
            "narrator_zh": "雅"
        },
        {
            "location": "574/TALK",
            "narrator": "みやび",
            "text": "光月さんに頼んだ\n作業の結果を\nウサギに送った。",
            "zh": "我把拜托光月做的\n工作成果，\n送给了兔子。",
            "narrator_zh": "雅"
        },
        {
            "location": "575/TALK",
            "narrator": "みやび",
            "text": "やき、うちが\nＦａｔａｌＱｕｅｅｎと\nわかったんやろ？",
            "zh": "所以啵，就是这样\n发现我是\nＦａｔａｌＱｕｅｅｎ的吧？",
            "narrator_zh": "雅"
        },
        {
            "location": "576/TALK",
            "narrator": "繭",
            "text": "惜しいですが、\n違います。",
            "zh": "很遗憾，\n不对。",
            "narrator_zh": "茧"
        },
        {
            "location": "577/TALK",
            "narrator": "繭",
            "text": "それはきっかけに\nなっただけなんです。",
            "zh": "那只是\n契机而已。",
            "narrator_zh": "茧"
        },
        {
            "location": "578/TALK",
            "narrator": "繭",
            "text": "確信に至ったのは、\n私の報告に対する\n返答です。",
            "zh": "让我确信的，\n是我报告之后\n得到的答复。",
            "narrator_zh": "茧"
        },
        {
            "location": "579/TALK",
            "narrator": "みやび",
            "text": "…返答？\nうち、何かしたが？",
            "zh": "…答复？\n我做过驷马咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "580/TALK",
            "narrator": "繭",
            "text": "覚えていませんか？\nトロイの木馬の\n件ですよ。",
            "zh": "不记得了吗？\n就是特洛伊木马\n那件事呀。",
            "narrator_zh": "茧"
        },
        {
            "location": "581/TALK",
            "narrator": "みやび",
            "text": "ああ、侵入させろって\nウサギに指示したはず\nやけんど…。",
            "zh": "啊，放它进来的指示，\n我确实下给\n兔子了咯……。",
            "narrator_zh": "雅"
        },
        {
            "location": "582/TALK",
            "narrator": "繭",
            "text": "光月繭の方で、\n侵入させた報告を\n返したんです。",
            "zh": "而光月茧这边，\n回报了已经\n放进来的报告。",
            "narrator_zh": "茧"
        },
        {
            "location": "583/TALK",
            "narrator": "繭",
            "text": "そしたらみやび先輩、\nらじゃ、って返して\nきましたよね？",
            "zh": "然后雅前辈就回了\n一句『收到』，\n对吧？",
            "narrator_zh": "茧"
        },
        {
            "location": "587/TALK",
            "narrator": "みやび",
            "text": "は！？\nうち、そんなこと\nしたが！？",
            "zh": "哈！？\n我做过\n那种事咯！？",
            "narrator_zh": "雅"
        },
        {
            "location": "590/TALK",
            "narrator": "繭",
            "text": "ふふっ…。\nぬかりましたね、\nクイーン。",
            "zh": "呵呵……。\n大意了呢，\n女王。",
            "narrator_zh": "茧"
        },
        {
            "location": "591/TALK",
            "narrator": "みやび",
            "text": "はぁ～…。\nうちも、まだまだ\nツメが甘いなぁ…。",
            "zh": "哈啊～…。\n我还差得远，\n爪子太嫩咯……。",
            "narrator_zh": "雅"
        },
        {
            "location": "593/TALK",
            "narrator": "みやび",
            "text": "…けんど、おかげで\nリアルで会える\nことになったぞね。",
            "zh": "…但是，托你的福，\n我们才能在线下\n见上面咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "594/TALK",
            "narrator": "みやび",
            "text": "しょうまっこと\n嬉しいちや、\nウサギ。",
            "zh": "实在是\n太高兴了滴，\n兔子。",
            "narrator_zh": "雅"
        },
        {
            "location": "597/TALK",
            "narrator": "繭",
            "text": "私もです…、\nクイーン。",
            "zh": "我也是……、\n女王。",
            "narrator_zh": "茧"
        },
        {
            "location": "609/TALK",
            "narrator": "雛",
            "text": "…あっ、いたいた！\nこっちだよー！",
            "zh": "…啊，找到了找到了！\n在这边——！",
            "narrator_zh": "雏"
        },
        {
            "location": "627/TALK",
            "narrator": "雛",
            "text": "まゆちん、発見！",
            "zh": "小茧，发现！",
            "narrator_zh": "雏"
        },
        {
            "location": "629/TALK",
            "narrator": "キリト",
            "text": "屋上なんかで\n何やってんだよ？",
            "zh": "你跑天台上\n干嘛呢？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "631/TALK",
            "narrator": "繭",
            "text": "…何しに来たの？",
            "zh": "……你们来做什么？",
            "narrator_zh": "茧"
        },
        {
            "location": "632/TALK",
            "narrator": "雛",
            "text": "お昼なのにいないから\n探しに来たんだよー。",
            "zh": "都到午饭时间了还不见人，\n我们才来找你的呀——。",
            "narrator_zh": "雏"
        },
        {
            "location": "633/TALK",
            "narrator": "キリト",
            "text": "みやび先輩と\n約束してたのか？",
            "zh": "是和雅前辈\n有约吗？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "634/TALK",
            "narrator": "繭",
            "text": "…違う。\nそういう約束した\nわけじゃない。",
            "zh": "……不是。\n也不是那种\n约定。",
            "narrator_zh": "茧"
        },
        {
            "location": "635/TALK",
            "narrator": "キリト",
            "text": "じゃあ、どんな？",
            "zh": "那是什么约？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "636/TALK",
            "narrator": "繭",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "茧"
        },
        {
            "location": "646/TALK",
            "narrator": "つばめ",
            "text": "はぁ、はぁ…。\nひなこちゃん達、\n早過ぎだよぉ…。",
            "zh": "呼、呼……。\n小雏你们，\n跑得太快了呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "648/TALK",
            "narrator": "つばめ",
            "text": "って、あれ？\nみやびさん。",
            "zh": "咦，那不是……\n雅吗。",
            "narrator_zh": "燕"
        },
        {
            "location": "649/TALK",
            "narrator": "みやび",
            "text": "つばめちゃんまで\n来たが？",
            "zh": "连燕都\n来咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "650/TALK",
            "narrator": "つばめ",
            "text": "はい…。\nみやびさん達は、\n何してたんですか？",
            "zh": "嗯……。\n雅你们刚才，\n在做什么呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "651/TALK",
            "narrator": "みやび",
            "text": "大したことやない。",
            "zh": "不是什么大事。",
            "narrator_zh": "雅"
        },
        {
            "location": "652/TALK",
            "narrator": "みやび",
            "text": "ちっくと、親友と\n友情を深め合うてた\nだけやきね。",
            "zh": "就一小会儿，和好朋友\n加深了下\n友情而已啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "654/TALK",
            "narrator": "雛",
            "text": "はい？",
            "zh": "嗯？",
            "narrator_zh": "雏"
        },
        {
            "location": "655/TALK",
            "narrator": "キリト",
            "text": "親友？　繭が？",
            "zh": "好朋友？茧？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "657/TALK",
            "narrator": "みやび",
            "text": "そうながよ。\nな、ウサギ？",
            "zh": "就是那么回事咯。\n对吧，兔子？",
            "narrator_zh": "雅"
        },
        {
            "location": "659/TALK",
            "narrator": "繭",
            "text": "…そうですね。\nク――",
            "zh": "……是啊。\n女——",
            "narrator_zh": "茧"
        },
        {
            "location": "660/TALK",
            "narrator": "繭",
            "text": "いえ…みやび先輩。",
            "zh": "不……雅前辈。",
            "narrator_zh": "茧"
        },
        {
            "location": "661/TALK",
            "narrator": "キリト",
            "text": "ウサギって、\n繭のあだ名か？",
            "zh": "兔子，\n是茧的外号吗？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "662/TALK",
            "narrator": "雛",
            "text": "かわいいー！\nあたしもウサギって\n呼ぼうかなー？",
            "zh": "好可爱——！\n我也要叫你\n兔子好了——！",
            "narrator_zh": "雏"
        },
        {
            "location": "664/TALK",
            "narrator": "繭",
            "text": "呼ぶな。\nサルって呼び返すぞ？",
            "zh": "不许叫。\n小心我回叫你猴子。",
            "narrator_zh": "茧"
        },
        {
            "location": "665/TALK",
            "narrator": "つばめ",
            "text": "まゆちん、いつの間に\nみやびさんとそんなに\n仲良しになったの？",
            "zh": "小茧，什么时候\n和雅变得\n这么要好了？",
            "narrator_zh": "燕"
        },
        {
            "location": "667/TALK",
            "narrator": "繭",
            "text": "…の、ノーコメント。",
            "zh": "…不、无可奉告。",
            "narrator_zh": "茧"
        },
        {
            "location": "668/TALK",
            "narrator": "キリト",
            "text": "それくらい教えろよ。\n気になるじゃねぇか。",
            "zh": "这点事就说说呗。\n好奇死了啊。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "669/TALK",
            "narrator": "雛",
            "text": "ていうか、どうして\nウサギなのー？",
            "zh": "话说回来，为什么\n是兔子呀——？",
            "narrator_zh": "雏"
        },
        {
            "location": "671/TALK",
            "narrator": "みやび",
            "text": "ははっ…しばらくは\n質問攻めが続きそう\nやねぇ…。",
            "zh": "哈哈……看来这\n提问攻势还得\n持续一阵咯……。",
            "narrator_zh": "雅"
        },
        {
            "location": "673/SEL",
            "narrator": "",
            "text": "繭がＲＡＢＢＩＴＡＮＩＭＡだったんだね",
            "zh": "茧原来就是ＲＡＢＢＩＴＡＮＩＭＡ啊",
            "narrator_zh": ""
        },
        {
            "location": "674/ACT",
            "narrator": "",
            "text": "繭がＲＡＢＢＩＴＡＮＩＭＡだったんだね",
            "zh": "茧原来就是ＲＡＢＢＩＴＡＮＩＭＡ啊",
            "narrator_zh": ""
        },
        {
            "location": "691/TALK",
            "narrator": "みやび",
            "text": "うむ",
            "zh": "嗯",
            "narrator_zh": "雅"
        },
        {
            "location": "692/TALK",
            "narrator": "みやび",
            "text": "あまりに予想外過ぎてアンビリバブル",
            "zh": "实在是意外过头，难以置信",
            "narrator_zh": "雅"
        },
        {
            "location": "693/TALK",
            "narrator": "みやび",
            "text": "けんど",
            "zh": "但是",
            "narrator_zh": "雅"
        },
        {
            "location": "694/TALK",
            "narrator": "みやび",
            "text": "嬉しい結果に大満足ぞね",
            "zh": "对这份高兴的结果大满足咧",
            "narrator_zh": "雅"
        },
        {
            "location": "696/SEL",
            "narrator": "",
            "text": "やっぱりオッサンじゃなかったから？",
            "zh": "果然是因为不是大叔？",
            "narrator_zh": ""
        },
        {
            "location": "697/SEL",
            "narrator": "",
            "text": "相手が繭だったから？",
            "zh": "还是因为对方是茧？",
            "narrator_zh": ""
        },
        {
            "location": "698/ACT",
            "narrator": "",
            "text": "やっぱりオッサンじゃなかったから？",
            "zh": "果然是因为不是大叔？",
            "narrator_zh": ""
        },
        {
            "location": "699/TALK",
            "narrator": "みやび",
            "text": "いや違う",
            "zh": "不，不对",
            "narrator_zh": "雅"
        },
        {
            "location": "700/TALK",
            "narrator": "みやび",
            "text": "オッサンだったとしても",
            "zh": "就算是大叔",
            "narrator_zh": "雅"
        },
        {
            "location": "701/TALK",
            "narrator": "みやび",
            "text": "会えたら嬉しいと思ってた",
            "zh": "我也觉得能见到就很高兴",
            "narrator_zh": "雅"
        },
        {
            "location": "702/TALK",
            "narrator": "みやび",
            "text": "はず",
            "zh": "才对",
            "narrator_zh": "雅"
        },
        {
            "location": "705/TALK",
            "narrator": "みやび",
            "text": "まあ",
            "zh": "嘛",
            "narrator_zh": "雅"
        },
        {
            "location": "706/TALK",
            "narrator": "みやび",
            "text": "安心したのも事実",
            "zh": "松了口气也是事实",
            "narrator_zh": "雅"
        },
        {
            "location": "707/TALK",
            "narrator": "みやび",
            "text": "オッサンじゃなくてよかったのかもしれん",
            "zh": "也许不是大叔确实该庆幸",
            "narrator_zh": "雅"
        },
        {
            "location": "709/TALK",
            "narrator": "みやび",
            "text": "けんど",
            "zh": "但是",
            "narrator_zh": "雅"
        },
        {
            "location": "710/TALK",
            "narrator": "みやび",
            "text": "超渋いコード書きよるきね",
            "zh": "写的代码超老辣啵",
            "narrator_zh": "雅"
        },
        {
            "location": "711/TALK",
            "narrator": "みやび",
            "text": "うちより年下なのに",
            "zh": "明明比我还小",
            "narrator_zh": "雅"
        },
        {
            "location": "712/TALK",
            "narrator": "みやび",
            "text": "まったく",
            "zh": "真是的",
            "narrator_zh": "雅"
        },
        {
            "location": "713/TALK",
            "narrator": "みやび",
            "text": "面白い子や",
            "zh": "真有意思的孩子",
            "narrator_zh": "雅"
        },
        {
            "location": "724/ACT",
            "narrator": "",
            "text": "相手が繭だったから？",
            "zh": "还是因为对方是茧？",
            "narrator_zh": ""
        },
        {
            "location": "725/TALK",
            "narrator": "みやび",
            "text": "どうだろうか？",
            "zh": "谁知道呢？",
            "narrator_zh": "雅"
        },
        {
            "location": "728/TALK",
            "narrator": "みやび",
            "text": "いや",
            "zh": "不",
            "narrator_zh": "雅"
        },
        {
            "location": "729/TALK",
            "narrator": "みやび",
            "text": "それはあるかもしれん",
            "zh": "那说不定有",
            "narrator_zh": "雅"
        },
        {
            "location": "730/TALK",
            "narrator": "みやび",
            "text": "リアルでＰＣの話できるの",
            "zh": "能在线下聊电脑的",
            "narrator_zh": "雅"
        },
        {
            "location": "731/TALK",
            "narrator": "みやび",
            "text": "光月さんくらいやったし",
            "zh": "也就光月一个咯",
            "narrator_zh": "雅"
        },
        {
            "location": "732/TALK",
            "narrator": "みやび",
            "text": "よくわからん子やったけんど",
            "zh": "虽然之前是个看不透的孩子，但是",
            "narrator_zh": "雅"
        },
        {
            "location": "733/TALK",
            "narrator": "みやび",
            "text": "趣味合うたし",
            "zh": "兴趣也合得来",
            "narrator_zh": "雅"
        },
        {
            "location": "734/TALK",
            "narrator": "みやび",
            "text": "気に入ってたのは事実",
            "zh": "喜欢她也是事实",
            "narrator_zh": "雅"
        },
        {
            "location": "735/TALK",
            "narrator": "みやび",
            "text": "つまり",
            "zh": "也就是说",
            "narrator_zh": "雅"
        },
        {
            "location": "736/TALK",
            "narrator": "みやび",
            "text": "光月さんがウサギで良かった思うてるがよ",
            "zh": "光月是兔子这件事，我觉得挺好咯",
            "narrator_zh": "雅"
        },
        {
            "location": "739/TALK",
            "narrator": "みやび",
            "text": "ウサギには内緒やけんどな",
            "zh": "不过这话要对兔子保密咯",
            "narrator_zh": "雅"
        },
        {
            "location": "761/DIALOG",
            "narrator": "Dialog_chapter_ch04",
            "text": "【15 弾の数だけ抱きしめて】",
            "zh": "【15 数着弹数紧紧相拥】",
            "narrator_zh": "Dialog_chapter_ch04"
        }
    ]
}
