{
    "dir": "chap00/daydra/spev_notice_cd_01_07.js",
    "type": "",
    "info": {
        "story_id": "91057",
        "cid": "",
        "title": "007 アフターストーリー",
        "sub_title": "卯月神楽の思い出",
        "title_zh": "007 后日谈",
        "sub_title_zh": "卯月神乐的回忆"
    },
    "entry": [
        {
            "location": "1804/DIALOG",
            "narrator": "",
            "text": "<color=green>某月某日　1:35 PM</color>\nとある休日、神楽坂トライナリー楽屋にて。",
            "zh": "<color=green>某月某日　1:35 PM</color>\n某个休息日，在神乐坂三重奏后台。",
            "narrator_zh": ""
        },
        {
            "location": "1805/TALK",
            "narrator": "神楽",
            "text": "――というわけで、\nイベント時には\n客席の方も解放して…。",
            "zh": "——总之就是这样，\n办活动的时候\n也把观众席那边开放出来……",
            "narrator_zh": "神乐"
        },
        {
            "location": "1806/TALK",
            "narrator": "神楽",
            "text": "映画の上映や、\nちょっとした舞台として\n使おうと思ってるんです。",
            "zh": "我想着可以用来放电影，\n或者当成\n一个小小舞台。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1807/TALK",
            "narrator": "真幌",
            "text": "なるほどな…。\nそのイベントに合った\n映画を流すということか。",
            "zh": "原来如此啊……\n意思是要配合那场活动\n放相应的电影吗。",
            "narrator_zh": "真幌"
        },
        {
            "location": "1809/TALK",
            "narrator": "神楽",
            "text": "はい、その通りです。",
            "zh": "嗯，正是如此。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1810/TALK",
            "narrator": "神楽",
            "text": "それで、イベントを\n行う際には、アーヤさんの\n助けも必要なんです。",
            "zh": "不过，举办活动的\n时候，也还需要\n绫水的帮忙才行。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1811/TALK",
            "narrator": "神楽",
            "text": "そのイベントに合わせた、\n限定メニューがあった方が\nいいと思いませんか？",
            "zh": "配合那场活动的\n限定菜单，你不觉得\n有的话会更好吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1812/TALK",
            "narrator": "アーヤ",
            "text": "あ～…、なるほどね。\n確かに必要かも…。",
            "zh": "啊——……原来如此。\n确实或许有必要呢……",
            "narrator_zh": "绫水"
        },
        {
            "location": "1813/TALK",
            "narrator": "真幌",
            "text": "限定という言葉で\n注文を増やすつもりか？",
            "zh": "打算靠“限定”两个字\n来增加点单量吗？",
            "narrator_zh": "真幌"
        },
        {
            "location": "1814/TALK",
            "narrator": "神楽",
            "text": "限定の魔力は\n凄まじいんですよ？",
            "zh": "“限定”的魔力\n可是很惊人的哦？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1815/TALK",
            "narrator": "神楽",
            "text": "つばめさん。\nこの前発売したメノウの\n限定ファンブック…。",
            "zh": "燕。\n前阵子发售的MENOW\n限定粉丝书……",
            "narrator_zh": "神乐"
        },
        {
            "location": "1816/TALK",
            "narrator": "神楽",
            "text": "確か、二冊くらい\n買ってましたよね？",
            "zh": "记得你好像\n买了两本吧？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1818/TALK",
            "narrator": "つばめ",
            "text": "う、うん…限定なのに、\n破れたり汚れたりしたら\nイヤだったから、つい…。",
            "zh": "嗯、嗯……毕竟是限定的，\n要是破了或者弄脏了\n会舍不得嘛，不知不觉就……",
            "narrator_zh": "燕"
        },
        {
            "location": "1819/TALK",
            "narrator": "神楽",
            "text": "ね？",
            "zh": "对吧？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1820/TALK",
            "narrator": "真幌",
            "text": "なるほど。\n限定の言葉の魔力は\n理解した。",
            "zh": "原来如此。\n“限定”这个词的魔力\n我算是理解了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "1822/TALK",
            "narrator": "アーヤ",
            "text": "やっぱり、卯月を\nイベント担当にしたのは\n正解だったわね。",
            "zh": "果然，让卯月来当\n活动负责人\n是个正确的决定呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "1823/TALK",
            "narrator": "神楽",
            "text": "それは、開店後に\n実際のイベントを\n開催して…。",
            "zh": "这个嘛，得等开店后\n实际办起活动\n试试看……",
            "narrator_zh": "神乐"
        },
        {
            "location": "1824/TALK",
            "narrator": "神楽",
            "text": "その結果を見てからじゃ\nないと、わかりませんよ？",
            "zh": "不看到实际结果的话，\n可还说不准哦？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1827/TALK",
            "narrator": "つばめ",
            "text": "大丈夫だよ。\n絶対成功するって\n信じてるよ！",
            "zh": "没问题的啦。\n我绝对相信\n一定会成功的！",
            "narrator_zh": "燕"
        },
        {
            "location": "1829/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………",
            "narrator_zh": "神乐"
        },
        {
            "location": "1831/TALK",
            "narrator": "神楽",
            "text": "じゃ、じゃあ、まずは\n開店イベントについて、\nアーヤさん…。",
            "zh": "那、那么，首先\n关于开店活动的事，\n绫水……",
            "narrator_zh": "神乐"
        },
        {
            "location": "1832/TALK",
            "narrator": "神楽",
            "text": "あと、みやびさんも\n一緒に打ち合わせ\nしたいんですが。",
            "zh": "还有，也想请雅\n一起过来\n开个会才行。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1833/TALK",
            "narrator": "アーヤ",
            "text": "わかったわ。\nつばめ、みやびのこと\n呼んできてもらえる？",
            "zh": "我知道了。\n燕，能帮我\n去叫一下雅吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "1834/TALK",
            "narrator": "つばめ",
            "text": "わかりましたー。",
            "zh": "知道啦——。",
            "narrator_zh": "燕"
        },
        {
            "location": "1835/TALK",
            "narrator": "神楽",
            "text": "お願いしますね、\nつばめさん。",
            "zh": "那就拜托你了哦，\n燕。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1856/TALK",
            "narrator": "神楽",
            "text": "ふぅ…。\nお風呂、\n先にいただきましたー。",
            "zh": "呼……\n澡我已经\n先洗好啦——。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1857/TALK",
            "narrator": "つばめ",
            "text": "さっぱりした？",
            "zh": "洗清爽了吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "1858/TALK",
            "narrator": "神楽",
            "text": "はい。すみません、\n先にいただいちゃって。",
            "zh": "嗯。不好意思，\n我先去洗了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1859/TALK",
            "narrator": "つばめ",
            "text": "お泊まりに来た人を\n待たせられないよ。",
            "zh": "不能让来借宿的客人\n一直等着嘛。",
            "narrator_zh": "燕"
        },
        {
            "location": "1860/TALK",
            "narrator": "神楽",
            "text": "そうじゃなくて、\n一緒に入りたかったなぁ、\nってことなんですけど…。",
            "zh": "不是那个意思啦，\n我是说本来还想\n一起洗来着的……",
            "narrator_zh": "神乐"
        },
        {
            "location": "1861/TALK",
            "narrator": "つばめ",
            "text": "う、うちのお風呂に\n二人で入るのは\n狭いと思うよ？",
            "zh": "我、我家的浴缸\n两个人一起泡\n会太挤啦？",
            "narrator_zh": "燕"
        },
        {
            "location": "1862/TALK",
            "narrator": "神楽",
            "text": "……そうでしょうか？",
            "zh": "……会吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1864/TALK",
            "narrator": "つばめ",
            "text": "えぇっ！？\nえ、えっと…。",
            "zh": "诶诶！？\n那、那个……",
            "narrator_zh": "燕"
        },
        {
            "location": "1865/TALK",
            "narrator": "つばめ",
            "text": "あ、そういえば！\n神楽ちゃんはアレ、\nなににするか決めたの？",
            "zh": "啊，说起来！\n神乐你那个，\n想好要选什么了吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "1866/TALK",
            "narrator": "神楽",
            "text": "アレっていうと、\n食器のことですよね？",
            "zh": "“那个”，是指\n餐具的事对吧？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1867/TALK",
            "narrator": "神楽",
            "text": "みんなもう決めたのに、\n待たせてしまって\nますよね…。",
            "zh": "明明大家都定好了，\n只有我还在让大伙儿\n干等着呢……",
            "narrator_zh": "神乐"
        },
        {
            "location": "1868/TALK",
            "narrator": "つばめ",
            "text": "あ、急かしてるわけじゃ\nないよ。",
            "zh": "啊，我不是\n在催你啦。",
            "narrator_zh": "燕"
        },
        {
            "location": "1870/TALK",
            "narrator": "つばめ",
            "text": "ただ、神楽ちゃんが\nなにを選ぶのか、\nちょっと気になって…。",
            "zh": "只是稍微有点好奇\n神乐会选\n什么而已……",
            "narrator_zh": "燕"
        },
        {
            "location": "1871/TALK",
            "narrator": "神楽",
            "text": "…マグカップ。",
            "zh": "……马克杯。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1872/TALK",
            "narrator": "つばめ",
            "text": "え？",
            "zh": "诶？",
            "narrator_zh": "燕"
        },
        {
            "location": "1873/TALK",
            "narrator": "神楽",
            "text": "私、マグカップに\nしようかな？",
            "zh": "我，选马克杯\n怎么样呢？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1874/TALK",
            "narrator": "つばめ",
            "text": "マグカップ？",
            "zh": "马克杯？",
            "narrator_zh": "燕"
        },
        {
            "location": "1875/TALK",
            "narrator": "神楽",
            "text": "はい。マグカップです。",
            "zh": "是的。马克杯。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1876/TALK",
            "narrator": "神楽",
            "text": "私の大好きなラノベに、\nちょっと憧れてるシーンが\nあって…。",
            "zh": "我最喜欢的一部轻小说里，\n有个我稍微有点向往的\n场景……",
            "narrator_zh": "神乐"
        },
        {
            "location": "1877/TALK",
            "narrator": "つばめ",
            "text": "どんなの？",
            "zh": "什么样的？",
            "narrator_zh": "燕"
        },
        {
            "location": "1878/TALK",
            "narrator": "神楽",
            "text": "主人公とヒロインが、\n最後の最後でようやく\n結ばれて…。",
            "zh": "主人公和女主角，\n在最后的最后终于\n走到了一起……",
            "narrator_zh": "神乐"
        },
        {
            "location": "1880/TALK",
            "narrator": "神楽",
            "text": "朝を迎えるんです。",
            "zh": "迎来了清晨。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1881/TALK",
            "narrator": "つばめ",
            "text": "えっ！？",
            "zh": "诶！？",
            "narrator_zh": "燕"
        },
        {
            "location": "1883/TALK",
            "narrator": "神楽",
            "text": "その時、二人揃って\n同じマグカップを使って、\nお茶を飲むんですけど…。",
            "zh": "那时候，两人一齐\n用着同一款马克杯，\n喝起了茶……",
            "narrator_zh": "神乐"
        },
        {
            "location": "1884/TALK",
            "narrator": "神楽",
            "text": "そのシーンに、\nずっと前から憧れてて…。",
            "zh": "那个场景，\n我从好久以前就一直很憧憬了……",
            "narrator_zh": "神乐"
        },
        {
            "location": "1885/TALK",
            "narrator": "つばめ",
            "text": "そ、そうなんだ…。\nなんか、ちょっとだけ\n大人なラノベだね。",
            "zh": "这、这样啊……\n总觉得，是稍微有点\n大人的轻小说呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "1887/TALK",
            "narrator": "神楽",
            "text": "興味がおありなら\nお貸ししますよ？",
            "zh": "要是有兴趣的话，\n我可以借给你哦？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1888/TALK",
            "narrator": "つばめ",
            "text": "えぇっ！？\nえ、えっとぉ…。",
            "zh": "诶诶！？\n那、那个……",
            "narrator_zh": "燕"
        },
        {
            "location": "1889/TALK",
            "narrator": "つばめ",
            "text": "わ、わたしも、\nお風呂行ってくるね！",
            "zh": "我、我也去\n洗澡了哦！",
            "narrator_zh": "燕"
        },
        {
            "location": "1895/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………",
            "narrator_zh": "神乐"
        },
        {
            "location": "1896/TALK",
            "narrator": "神楽",
            "text": "ごめんなさい、\nつばめさん。\nウソついちゃって…。",
            "zh": "对不起，\n燕。\n居然撒了个谎……",
            "narrator_zh": "神乐"
        },
        {
            "location": "1897/SEL",
            "narrator": "（選択肢）",
            "text": "ウソだったの？",
            "zh": "是假的吗？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "1898/ACT",
            "narrator": "",
            "text": "ウソだったの？",
            "zh": "是假的吗？",
            "narrator_zh": ""
        },
        {
            "location": "1916/TALK",
            "narrator": "神楽",
            "text": "呪",
            "zh": "咒",
            "narrator_zh": "神乐"
        },
        {
            "location": "1917/TALK",
            "narrator": "神楽",
            "text": "ああ、不幸な$handle$。貴方に罪はありません。ただ貴方は前世のカルマを抱えているだけなのです。たまたまぴょんこのウソバレの瞬間に立ち会ってしまい、その真実を知ってしまっただけなのです。それを知った者は呪われ、未来永劫、何千回何万回輪廻転生しようとも、苦しみ続ける魂となってしまうのです。",
            "zh": "啊，不幸的$handle$。你并没有罪。你只是背负着前世的业力罢了。只是碰巧撞见了蹦子谎言败露的瞬间，知晓了那个真相罢了。知晓真相之人必遭诅咒，未来永劫，无论轮回转生几千次几万次，都将化作持续受苦的灵魂。",
            "narrator_zh": "神乐"
        },
        {
            "location": "1918/TALK",
            "narrator": "神楽",
            "text": "呪呪呪呪呪呪呪呪呪",
            "zh": "咒咒咒咒咒咒咒咒咒",
            "narrator_zh": "神乐"
        },
        {
            "location": "1920/SEL",
            "narrator": "（選択肢）",
            "text": "ごめんなさい",
            "zh": "对不起",
            "narrator_zh": "（选项）"
        },
        {
            "location": "1921/SEL",
            "narrator": "（選択肢）",
            "text": "いつも見てるのくらい知ってるでしょ",
            "zh": "我一直都在看，这你总知道吧",
            "narrator_zh": "（选项）"
        },
        {
            "location": "1922/ACT",
            "narrator": "",
            "text": "ごめんなさい",
            "zh": "对不起",
            "narrator_zh": ""
        },
        {
            "location": "1923/TALK",
            "narrator": "神楽",
            "text": "冗談ぴょん♪",
            "zh": "骗你的pyon♪",
            "narrator_zh": "神乐"
        },
        {
            "location": "1924/TALK",
            "narrator": "神楽",
            "text": "ああー$handle$のかわいさに癒されるーーー",
            "zh": "啊啊——被$handle$的可爱治愈了———",
            "narrator_zh": "神乐"
        },
        {
            "location": "1925/ACT",
            "narrator": "",
            "text": "いつも見てるのくらい知ってるでしょ",
            "zh": "我一直都在看，这你总知道吧",
            "narrator_zh": ""
        },
        {
            "location": "1926/TALK",
            "narrator": "神楽",
            "text": "うざ",
            "zh": "好烦",
            "narrator_zh": "神乐"
        },
        {
            "location": "1927/TALK",
            "narrator": "神楽",
            "text": "だいたい人のプライバシー勝手に覗き見ておいて何その態度",
            "zh": "说到底擅自偷窥别人隐私还摆出那种态度算什么啊",
            "narrator_zh": "神乐"
        },
        {
            "location": "1928/TALK",
            "narrator": "神楽",
            "text": "どうせ今の姿だって見えてるんでしょラッキースケベ",
            "zh": "反正我现在这副样子你也正看着吧，幸运色狼",
            "narrator_zh": "神乐"
        },
        {
            "location": "1929/TALK",
            "narrator": "神楽",
            "text": "あなたがわざとやってるわけじゃないのもわかってるし、それを回避できないのもわかってるけど、その自覚あるならもうちょっと言い方ってものがあるとおもうんだけど、ホントしねよ",
            "zh": "虽然我知道你也不是故意要这么干的，也知道这事没法回避，可既然有这个自觉好歹注意一下说话方式吧，真的去死吧",
            "narrator_zh": "神乐"
        },
        {
            "location": "1931/TALK",
            "narrator": "神楽",
            "text": "まあ、さっきの理由がウソっていうのは本当",
            "zh": "嘛，刚才那个理由是编的倒是真的",
            "narrator_zh": "神乐"
        },
        {
            "location": "1932/TALK",
            "narrator": "神楽",
            "text": "真実は別の扉の中に",
            "zh": "真相藏在另一扇门扉之中",
            "narrator_zh": "神乐"
        },
        {
