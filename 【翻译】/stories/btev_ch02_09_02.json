{
    "dir": "chap09/battle/btev_ch02_09_02.js",
    "type": "",
    "info": {
        "story_id": "22018",
        "cid": "",
        "title": "018 ココロスフィアストーリー【Lv06】",
        "sub_title": "チャプター９＜帰結＞",
        "title_zh": "018 心灵领域故事【Lv06】",
        "sub_title_zh": "第9章＜归结＞"
    },
    "entry": [
        {
            "location": "52/SCENARIO",
            "narrator": "",
            "text": "姉妹の隔絶・後編２",
            "zh": "姐妹间的隔阂·后篇2",
            "narrator_zh": ""
        },
        {
            "location": "61/TALK",
            "narrator": "表層アーヤ",
            "text": "どうして……？\nなぜそこまで…",
            "zh": "为什么……？\n为什么要做到这种地步……",
            "narrator_zh": "表层绫水"
        },
        {
            "location": "62/TALK",
            "narrator": "潜在アーヤ",
            "text": "もうそれくらいに\n嫌気がさしてるって\nことよ。",
            "zh": "就是已经\n厌烦到那种程度了\n嘛。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "63/TALK",
            "narrator": "潜在アーヤ",
            "text": "$handle$さんも\n同意してるから\n力を貸してくれてる。",
            "zh": "$handle$\n也赞同我，\n才会借给我力量。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "64/TALK",
            "narrator": "表層アーヤ",
            "text": "同意…ね。\nちょっと卑怯なんじゃ\nないかしら？",
            "zh": "赞同……啊。\n你不觉得\n有点卑鄙吗？",
            "narrator_zh": "表层绫水"
        },
        {
            "location": "65/TALK",
            "narrator": "潜在アーヤ",
            "text": "…何が？",
            "zh": "……什么？",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "66/TALK",
            "narrator": "表層アーヤ",
            "text": "姉と私たちの関係\n伝えてはいたけど、\n全部じゃないわよね。",
            "zh": "姐姐和我们的关系，\n你虽然讲了，\n但并不是全部吧。",
            "narrator_zh": "表层绫水"
        },
        {
            "location": "67/TALK",
            "narrator": "表層アーヤ",
            "text": "貴方が今伝えてある\nは、前提程度でしか\nない。",
            "zh": "你刚才说出来的，\n也不过是\n前提程度罢了。",
            "narrator_zh": "表层绫水"
        },
        {
            "location": "68/TALK",
            "narrator": "表層アーヤ",
            "text": "私たちが本当に姉に\n裏切られたと思ってる\n所は話してない。",
            "zh": "我们真正觉得\n被姐姐背叛的部分，\n你还没说呢。",
            "narrator_zh": "表层绫水"
        },
        {
            "location": "69/TALK",
            "narrator": "潜在アーヤ",
            "text": "話したところで\n変わらないわよ。",
            "zh": "就算说了，\n也不会改变什么哦。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "70/TALK",
            "narrator": "表層アーヤ",
            "text": "どうかしら。",
            "zh": "那可难说。",
            "narrator_zh": "表层绫水"
        },
        {
            "location": "71/TALK",
            "narrator": "表層アーヤ",
            "text": "まあいいわ。\n私はもうここに存在\nすることはできない。",
            "zh": "算了。\n我已经无法\n继续留在这里了。",
            "narrator_zh": "表层绫水"
        },
        {
            "location": "72/TALK",
            "narrator": "表層アーヤ",
            "text": "これ以上貴方と\nやりあうことは\nできないけど――",
            "zh": "虽然没法再和\n你交手下去了\n——",
            "narrator_zh": "表层绫水"
        },
        {
            "location": "74/TALK",
            "narrator": "表層アーヤ",
            "text": "もし$handle$に\n良心があれば代わりに\n問い詰めるでしょう。",
            "zh": "如果$handle$\n还有良心的话，应该会\n替我追问到底吧。",
            "narrator_zh": "表层绫水"
        },
        {
            "location": "75/TALK",
            "narrator": "潜在アーヤ",
            "text": "…っ。",
            "zh": "……唔。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "77/TALK",
            "narrator": "表層アーヤ",
            "text": "それじゃグッド\nラック。私とは\n息が合わない私さん。",
            "zh": "那就祝你好运吧，\n和我合不来的\n“我”小姐。",
            "narrator_zh": "表层绫水"
        },
        {
            "location": "87/TALK",
            "narrator": "潜在アーヤ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "96/SEL",
            "narrator": "（選択肢）",
            "text": "で、どういうこと？",
            "zh": "所以，是怎么回事？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "97/SEL",
            "narrator": "（選択肢）",
            "text": "何も言わなくていいよ",
            "zh": "什么都不用说哦",
            "narrator_zh": "（选项）"
        },
        {
            "location": "98/ACT",
            "narrator": "",
            "text": "で、どういうこと？",
            "zh": "所以，是怎么回事？",
            "narrator_zh": ""
        },
        {
            "location": "99/TALK",
            "narrator": "潜在アーヤ",
            "text": "はぁ、わかったわよ。\n教える。",
            "zh": "哈啊，我知道了。\n告诉你就是。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "100/ACT",
            "narrator": "",
            "text": "何も言わなくていいよ",
            "zh": "什么都不用说哦",
            "narrator_zh": ""
        },
        {
            "location": "101/TALK",
            "narrator": "潜在アーヤ",
            "text": "ふふ、ありがと。\n貴方は優しいのね。",
            "zh": "呵呵，谢谢。\n你真温柔啊。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "102/TALK",
            "narrator": "潜在アーヤ",
            "text": "でも、本当に重要だと\n思う時は、ちゃんと\n言っていいのよ？",
            "zh": "不过，觉得真的很重要的\n时候，其实可以\n直说出来的哦？",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "104/TALK",
            "narrator": "潜在アーヤ",
            "text": "私自身も、フェアじゃ\nなかったってちょっと\n反省してるし。",
            "zh": "我自己也觉得\n刚才那样不太公平，\n有点在反省呢。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "108/TALK",
            "narrator": "潜在アーヤ",
            "text": "５０１号室で\nしたお話には、\n続きがあるのよ。",
            "zh": "在501号室\n讲过的故事，\n还有后续哦。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "109/TALK",
            "narrator": "潜在アーヤ",
            "text": "今からそれを\n話すわ。",
            "zh": "现在我就\n把它讲给你听。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "123/DIALOG",
            "narrator": "",
            "text": "高校も３年になり、\n私も進路を考えなければ\nならない時期が来た。",
            "zh": "到了高三，\n我也迎来了不得不考虑\n今后出路的时候。",
            "narrator_zh": ""
        },
        {
            "location": "124/DIALOG",
            "narrator": "",
            "text": "当時、剣道の全国大会で優勝し、\n世界選手権ジュニア部門の\n最有力候補になっていた私は\n東京や大阪といった所にある\n幾つかの大学から\nオファーがかかっていたの。",
            "zh": "当时，我在剑道全国大赛中夺冠，\n成了世界锦标赛青少年组\n最有力的夺冠热门，\n好几所位于东京和大阪的\n大学都向我\n发出了招揽邀请。",
            "narrator_zh": ""
        },
        {
            "location": "125/DIALOG",
            "narrator": "",
            "text": "家のことは心配だったけど\n姉も実家に隠っていたし、\n大学くらいは\n遠いところで一人暮らししても\n大丈夫だろう、なんて思っていた。",
            "zh": "虽然很担心家里，\n但姐姐也一直宅在老家，\n我还想着至少上大学时\n去远一点的地方独居，\n应该没问题吧。",
            "narrator_zh": ""
        },
        {
            "location": "126/DIALOG",
            "narrator": "",
            "text": "けど――",
            "zh": "可是——",
            "narrator_zh": ""
        },
        {
            "location": "129/TALK",
            "narrator": "高校生アーヤ",
            "text": "あれ？",
            "zh": "咦？",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "130/TALK",
            "narrator": "高校生アーヤ",
            "text": "お姉ちゃんは？",
            "zh": "姐姐呢？",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "131/DIALOG",
            "narrator": "",
            "text": "ある日、高校から帰ると\n姉はいなかった。\n\n姉の部屋の荷物も\n全部無くなっていた。",
            "zh": "有一天，从高中回到家时，\n姐姐不在了。\n\n姐姐房间里的行李\n也全都清空了。",
            "narrator_zh": ""
        },
        {
            "location": "132/DIALOG",
            "narrator": "",
            "text": "母が言うには、\n『すごい研究所から\nオファーがかかったから\nフランスへ行く』\nって――",
            "zh": "听妈妈说，\n“因为有很厉害的研究所\n发来了邀请，\n所以去法国了”\n——",
            "narrator_zh": ""
        },
        {
            "location": "133/TALK",
            "narrator": "高校生アーヤ",
            "text": "……なにそれ。",
            "zh": "……那算什么。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "134/TALK",
            "narrator": "高校生アーヤ",
            "text": "最低…",
            "zh": "真过分……",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "135/TALK",
            "narrator": "高校生アーヤ",
            "text": "……最低よ…　…",
            "zh": "……太过分了……",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "136/DIALOG",
            "narrator": "",
            "text": "私、そんなこと\n一言も\n教えてもらってないよ――",
            "zh": "这种事，她连一句\n都没对我\n说过呀——",
            "narrator_zh": ""
        },
        {
            "location": "139/DIALOG",
            "narrator": "",
            "text": "バカ姉。",
            "zh": "笨蛋姐姐。",
            "narrator_zh": ""
        },
        {
            "location": "157/DIALOG",
            "narrator": "",
            "text": "その後私は\n何日もかけて考えて、\n結果として\n長野に残ることにした。",
            "zh": "那之后，我\n想了好多天，\n结果还是决定\n留在长野。",
            "narrator_zh": ""
        },
        {
            "location": "158/DIALOG",
            "narrator": "",
            "text": "ずっと信州の山中に住んでいた私は、\nやはり年頃ってこともあって、\n東京の大学に行けることを\n内心凄くわくわくしてたんだけどね。",
            "zh": "一直住在信州深山里的我，\n毕竟也正值那个年纪，\n一想到能去东京读大学，\n其实心里兴奋得不得了呢。",
            "narrator_zh": ""
        },
        {
            "location": "159/SEL",
            "narrator": "（選択肢）",
            "text": "そこまでしなくても良かったのでは？",
            "zh": "其实不用做到那种地步吧？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "160/SEL",
            "narrator": "（選択肢）",
            "text": "大変だったんだね。",
            "zh": "当时一定很辛苦吧。",
            "narrator_zh": "（选项）"
        },
        {
            "location": "161/ACT",
            "narrator": "",
            "text": "そこまでしなくても良かったのでは？",
            "zh": "其实不用做到那种地步吧？",
            "narrator_zh": ""
        },
        {
            "location": "164/TALK",
            "narrator": "アーヤ",
            "text": "そうね。\nまあ普通の家なら\nそうかもしれない。",
            "zh": "是呀。\n嗯，如果是普通家庭，\n或许是那样吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "165/TALK",
            "narrator": "アーヤ",
            "text": "でもうちは両親ともに\n高齢で、結構仕事も\nハードだったし――",
            "zh": "不过我家父母年纪都大了，\n工作也\n相当繁重——",
            "narrator_zh": "绫水"
        },
        {
            "location": "166/ACT",
            "narrator": "",
            "text": "大変だったんだね。",
            "zh": "当时一定很辛苦吧。",
            "narrator_zh": ""
        },
        {
            "location": "169/TALK",
            "narrator": "アーヤ",
            "text": "ありがと。\nあの時は本当に、精神\n的に大変だったわ。",
            "zh": "谢谢。\n那时候，心理上的确\n挺煎熬的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "170/TALK",
            "narrator": "アーヤ",
            "text": "うちは両親ともに\n高齢で、結構仕事も\nハードだったし――",
            "zh": "我家父母年纪都大了，\n工作也\n相当繁重——",
            "narrator_zh": "绫水"
        },
        {
            "location": "172/TALK",
            "narrator": "アーヤ",
            "text": "家も山の上にあるから\n私も姉もいない状態で\n生きていけるか心配で。",
            "zh": "家又建在山上，\n要是连我和姐姐都不在，\n真担心他们怎么生活。",
            "narrator_zh": "绫水"
        },
        {
            "location": "174/TALK",
            "narrator": "アーヤ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "191/TALK",
            "narrator": "アーヤ",
            "text": "とまあ、\nこんな経緯よ。",
            "zh": "嗯，事情的经过\n大致就是这样。",
            "narrator_zh": "绫水"
        },
        {
            "location": "192/TALK",
            "narrator": "アーヤ",
            "text": "これでだいたい、\n全部お話した。",
            "zh": "到这里，\n差不多全告诉你了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "193/SEL",
            "narrator": "（選択肢）",
            "text": "東京行きを断念したのが辛かったんだね。",
            "zh": "放弃去东京让你很难受吧。",
            "narrator_zh": "（选项）"
        },
        {
            "location": "194/SEL",
            "narrator": "（選択肢）",
            "text": "お姉さんが何も言わずに行ってしまったのが辛かったんだね。",
            "zh": "姐姐什么都没说就走了让你很难受吧。",
            "narrator_zh": "（选项）"
        },
        {
            "location": "195/ACT",
            "narrator": "",
            "text": "東京行きを断念したのが辛かったんだね。",
            "zh": "放弃去东京让你很难受吧。",
            "narrator_zh": ""
        },
        {
            "location": "196/TALK",
            "narrator": "アーヤ",
            "text": "そうね。",
            "zh": "是啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "197/TALK",
            "narrator": "アーヤ",
            "text": "なんで姉ばっかり自由\nに生きて、私ばかり…\nって思ってた。",
            "zh": "凭什么只有姐姐能自由\n自在地活，偏偏我要……\n我当时就是这么想的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "198/TALK",
            "narrator": "アーヤ",
            "text": "でもそれは、\n私が自分で決めて\nやってることだもの。",
            "zh": "不过那也是\n我自己决定\n要做的事嘛。",
            "narrator_zh": "绫水"
        },
        {
            "location": "199/SEL",
            "narrator": "（選択肢）",
            "text": "責任感あるんだね",
            "zh": "你很有责任感呢",
            "narrator_zh": "（选项）"
        },
        {
            "location": "200/ACT",
            "narrator": "",
            "text": "責任感あるんだね",
            "zh": "你很有责任感呢",
            "narrator_zh": ""
        },
        {
            "location": "202/TALK",
            "narrator": "アーヤ",
            "text": "どうかしらね。",
            "zh": "谁知道呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "203/TALK",
            "narrator": "アーヤ",
            "text": "何だかんだで、\n事情はあれ、結局\n今は東京にいるし。",
            "zh": "说到底，虽然各有缘由，\n结果我现在不也\n还是待在东京了嘛。",
            "narrator_zh": "绫水"
        },
        {
            "location": "204/TALK",
            "narrator": "アーヤ",
            "text": "案外\nチャランポランよ？",
            "zh": "没准我意外地\n很不靠谱哦？",
            "narrator_zh": "绫水"
        },
        {
            "location": "205/ACT",
            "narrator": "",
            "text": "お姉さんが何も言わずに行ってしまったのが辛かったんだね。",
            "zh": "姐姐什么都没说就走了让你很难受吧。",
            "narrator_zh": ""
        },
        {
            "location": "206/TALK",
            "narrator": "アーヤ",
            "text": "それはない！",
            "zh": "才没有这回事！",
            "narrator_zh": "绫水"
        },
        {
            "location": "207/TALK",
            "narrator": "アーヤ",
            "text": "寧ろいなくなって\n胸をなで下ろしたわ。",
            "zh": "倒不如说她走了，\n我还松了口气呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "208/SEL",
            "narrator": "（選択肢）",
            "text": "じゃあなんで、いなくなったとき泣いてたの？",
            "zh": "那她走的时候，你为什么在哭呀？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "209/ACT",
            "narrator": "",
            "text": "じゃあなんで、いなくなったとき泣いてたの？",
            "zh": "那她走的时候，你为什么在哭呀？",
            "narrator_zh": ""
        },
        {
            "location": "211/TALK",
            "narrator": "アーヤ",
            "text": "え！？",
            "zh": "诶！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "212/TALK",
            "narrator": "アーヤ",
            "text": "あれは…",
            "zh": "那是……",
            "narrator_zh": "绫水"
        },
        {
            "location": "213/TALK",
            "narrator": "アーヤ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "214/TALK",
            "narrator": "アーヤ",
            "text": "…あまりに腹が立って\n泣けてきちゃっただけ。",
            "zh": "……只是实在太气人了，\n气得掉眼泪而已。",
            "narrator_zh": "绫水"
        },
        {
            "location": "216/TALK",
            "narrator": "アーヤ",
            "text": "さあ、この話は\nもうおしまい！",
            "zh": "好，这个话题\n到此为止！",
            "narrator_zh": "绫水"
        },
        {
            "location": "217/TALK",
            "narrator": "アーヤ",
            "text": "とにかく私は\nもうそんな過去のこと\n引きずりたくないの。",
            "zh": "总之，我已经\n不想再被那种过去的事\n拖着走了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "218/TALK",
            "narrator": "アーヤ",
            "text": "それより今は、\n姉と話して事情を\n聞きたい。",
            "zh": "比起那个，我现在\n想和姐姐谈谈，\n问清楚缘由。",
            "narrator_zh": "绫水"
        },
        {
            "location": "219/TALK",
            "narrator": "アーヤ",
            "text": "いろんなことを\n全部――",
            "zh": "把各种各样的事，\n全都——",
            "narrator_zh": "绫水"
        },
        {
            "location": "220/TALK",
            "narrator": "アーヤ",
            "text": "だから反対派が弱まっ\nて、現実の私が軟化す\nるまで戦い続けるわ。",
            "zh": "所以我会继续战斗，\n直到反对派变弱、\n现实里的我态度软化为止。",
            "narrator_zh": "绫水"
        },
        {
            "location": "221/TALK",
            "narrator": "アーヤ",
            "text": "だから、これからも\nよろしくね。",
            "zh": "所以，今后也\n请多指教了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "223/TALK",
            "narrator": "アーヤ",
            "text": "それじゃ、\nまた逢えるのを\n楽しみにしてるわ。",
            "zh": "那么，\n期待着与你\n再次相见哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "232/SEL",
            "narrator": "（選択肢）",
            "text": "ちょっと待った！",
            "zh": "等一下！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "233/ACT",
            "narrator": "",
            "text": "ちょっと待った！",
            "zh": "等一下！",
            "narrator_zh": ""
        },
        {
            "location": "244/TALK",
            "narrator": "アーヤ",
            "text": "え？？",
            "zh": "诶？？",
            "narrator_zh": "绫水"
        },
        {
            "location": "245/SEL",
            "narrator": "（選択肢）",
            "text": "デートは！？",
            "zh": "约会呢！？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "246/ACT",
            "narrator": "",
            "text": "デートは！？",
            "zh": "约会呢！？",
            "narrator_zh": ""
        },
        {
            "location": "248/TALK",
            "narrator": "アーヤ",
            "text": "すごい！\nよく覚えてたわね。",
            "zh": "真厉害！\n你竟然还记得啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "249/TALK",
            "narrator": "アーヤ",
            "text": "そうね。\n約束だものね。",
            "zh": "也是呢。\n毕竟约好了嘛。",
            "narrator_zh": "绫水"
        },
        {
            "location": "250/TALK",
            "narrator": "アーヤ",
            "text": "それじゃ、\nどこへ行こうか？",
            "zh": "那么，\n我们去哪里好呢？",
            "narrator_zh": "绫水"
        },
        {
            "location": "251/SEL",
            "narrator": "（選択肢）",
            "text": "海",
            "zh": "海边",
            "narrator_zh": "（选项）"
        },
        {
            "location": "252/SEL",
            "narrator": "（選択肢）",
            "text": "カフェ",
            "zh": "咖啡馆",
            "narrator_zh": "（选项）"
        },
        {
            "location": "253/SEL",
            "narrator": "（選択肢）",
            "text": "エヴェレット脳科学研究所",
            "zh": "艾弗雷特脑科学研究所",
            "narrator_zh": "（选项）"
        },
        {
            "location": "254/ACT",
            "narrator": "",
            "text": "海",
            "zh": "海边",
            "narrator_zh": ""
        },
        {
            "location": "256/TALK",
            "narrator": "アーヤ",
            "text": "はいはい、海ね。\n何を期待してるの？",
            "zh": "好好好，去海边是吧。\n你在期待什么呢？",
            "narrator_zh": "绫水"
        },
        {
            "location": "258/TALK",
            "narrator": "アーヤ",
            "text": "服はこのままよ？",
            "zh": "衣服就穿这身哦？",
            "narrator_zh": "绫水"
        },
        {
            "location": "264/ACT",
            "narrator": "",
            "text": "カフェ",
            "zh": "咖啡馆",
            "narrator_zh": ""
        },
        {
            "location": "265/TALK",
            "narrator": "アーヤ",
            "text": "カフェ？\nいいわね。",
            "zh": "咖啡馆？\n挺好的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "271/ACT",
            "narrator": "",
            "text": "エヴェレット脳科学研究所",
            "zh": "艾弗雷特脑科学研究所",
            "narrator_zh": ""
        },
        {
            "location": "272/TALK",
            "narrator": "アーヤ",
            "text": "は？\nなにそれ。",
            "zh": "哈？\n那是什么。",
            "narrator_zh": "绫水"
        },
        {
            "location": "273/TALK",
            "narrator": "アーヤ",
            "text": "そんな所\n知らない。",
            "zh": "那种地方，\n我不知道。",
            "narrator_zh": "绫水"
        },
        {
            "location": "274/SEL",
            "narrator": "（選択肢）",
            "text": "え？　でも選択肢に…",
            "zh": "诶？　可选项里明明写了……",
            "narrator_zh": "（选项）"
        },
        {
            "location": "275/SEL",
            "narrator": "（選択肢）",
            "text": "いや、本当は知ってるんでしょ？",
            "zh": "不对，你其实知道的吧？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "276/ACT",
            "narrator": "",
            "text": "え？　でも選択肢に…",
            "zh": "诶？　可选项里明明写了……",
            "narrator_zh": ""
        },
        {
            "location": "277/ACT",
            "narrator": "",
            "text": "いや、本当は知ってるんでしょ？",
            "zh": "不对，你其实知道的吧？",
            "narrator_zh": ""
        },
        {
            "location": "279/TALK",
            "narrator": "アーヤ",
            "text": "知らないって\n言ってるでしょ！！",
            "zh": "我都说了\n不知道了！！",
            "narrator_zh": "绫水"
        },
        {
            "location": "280/TALK",
            "narrator": "アーヤ",
            "text": "もういい。\n気が変わった。\n今日はもうお終いよ。",
            "zh": "算了。\n我改变主意了。\n今天就到此为止。",
            "narrator_zh": "绫水"
        },
        {
            "location": "281/TALK",
            "narrator": "アーヤ",
            "text": "じゃね。",
            "zh": "再见。",
            "narrator_zh": "绫水"
        },
        {
            "location": "288/TALK",
            "narrator": "アーヤ",
            "text": "ココロの中って\n便利よね。",
            "zh": "心灵里面\n可真方便呀。",
            "narrator_zh": "绫水"
        },
        {
            "location": "289/TALK",
            "narrator": "アーヤ",
            "text": "妄想だけで、どこに\nでも行けちゃう。",
            "zh": "光靠妄想，\n想去哪里都能去呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "290/SEL",
            "narrator": "（選択肢）",
            "text": "来て終わり？",
            "zh": "来了就结束了吗？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "291/ACT",
            "narrator": "",
            "text": "来て終わり？",
            "zh": "来了就结束了吗？",
            "narrator_zh": ""
        },
        {
            "location": "293/TALK",
            "narrator": "アーヤ",
            "text": "え？",
            "zh": "诶？",
            "narrator_zh": "绫水"
        },
        {
            "location": "294/TALK",
            "narrator": "アーヤ",
            "text": "うーん、そうね…",
            "zh": "嗯——，是呀……",
            "narrator_zh": "绫水"
        },
        {
            "location": "295/TALK",
            "narrator": "アーヤ",
            "text": "じゃあ、\nちょっとだけなら\n触っていいわよ？",
            "zh": "那，\n只是稍微碰一下的话，\n可以哦？",
            "narrator_zh": "绫水"
        },
        {
            "location": "301/DIALOG",
            "narrator": "",
            "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n接続されました。\n\n画面をタップして相手に\n感覚を伝えましょう。",
            "zh": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\n触摸交流\n已连接。\n\n点击画面，向对方\n传达感觉吧。",
            "narrator_zh": ""
        },
        {
            "location": "365/TALK",
            "narrator": "アーヤ",
            "text": "ふふっ。",
            "zh": "呵呵。",
            "narrator_zh": "绫水"
        },
        {
            "location": "367/TALK",
            "narrator": "アーヤ",
            "text": "ちょっと\n不思議な気分。",
            "zh": "感觉\n有点不可思议。",
            "narrator_zh": "绫水"
        },
        {
            "location": "373/TALK",
            "narrator": "アーヤ",
            "text": "きゃっ！？",
            "zh": "呀！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "375/TALK",
            "narrator": "アーヤ",
            "text": "ちょ、ちょっと\n痛いってば！",
            "zh": "等、等一下，\n很痛的啦！",
            "narrator_zh": "绫水"
        },
        {
            "location": "381/TALK",
            "narrator": "アーヤ",
            "text": "もうっ。\n調子に乗らないの。",
            "zh": "真是的。\n别得意忘形呀。",
            "narrator_zh": "绫水"
        },
        {
            "location": "383/TALK",
            "narrator": "アーヤ",
            "text": "ダメだって！",
            "zh": "说不行啦！",
            "narrator_zh": "绫水"
        },
        {
            "location": "390/TALK",
            "narrator": "アーヤ",
            "text": "もうっ！\nくすぐったいってば。",
            "zh": "真是的！\n好痒的啦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "392/TALK",
            "narrator": "アーヤ",
            "text": "もしかして\nおなか出てる？",
            "zh": "难道说\n小肚子鼓起来了？",
            "narrator_zh": "绫水"
        },
        {
            "location": "399/TALK",
            "narrator": "アーヤ",
            "text": "ふわっ！",
            "zh": "呼哇！",
            "narrator_zh": "绫水"
        },
        {
            "location": "401/TALK",
            "narrator": "アーヤ",
            "text": "なんか\n不思議な気持ち。",
            "zh": "总觉得\n心情很奇妙。",
            "narrator_zh": "绫水"
        },
        {
            "location": "407/DIALOG",
            "narrator": "",
            "text": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\nタッチコミュニケーションが\n切断されました。",
            "zh": "<color=green>【TRI-OS Plug-in:TOUCH】</color>\n触摸交流\n已断开。",
            "narrator_zh": ""
        },
        {
            "location": "411/TALK",
            "narrator": "アーヤ",
            "text": "はい、おしまい。",
            "zh": "好了，到此为止。",
            "narrator_zh": "绫水"
        },
        {
            "location": "412/SEL",
            "narrator": "（選択肢）",
            "text": "満足。",
            "zh": "满足了。",
            "narrator_zh": "（选项）"
        },
        {
            "location": "413/SEL",
            "narrator": "（選択肢）",
            "text": "もっと！",
            "zh": "还想要！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "414/ACT",
            "narrator": "",
            "text": "満足。",
            "zh": "满足了。",
            "narrator_zh": ""
        },
        {
            "location": "415/TALK",
            "narrator": "アーヤ",
            "text": "はいはい。\n良かったわね。",
            "zh": "好好好。\n太好了呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "416/ACT",
            "narrator": "",
            "text": "もっと！",
            "zh": "还想要！",
            "narrator_zh": ""
        },
        {
            "location": "417/TALK",
            "narrator": "アーヤ",
            "text": "もうお終い。\nね？",
            "zh": "已经结束了。\n好吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "418/SEL",
            "narrator": "（選択肢）",
            "text": "…はい。",
            "zh": "……好的。",
            "narrator_zh": "（选项）"
        },
        {
            "location": "419/ACT",
            "narrator": "",
            "text": "…はい。",
            "zh": "……好的。",
            "narrator_zh": ""
        },
        {
            "location": "422/TALK",
            "narrator": "アーヤ",
            "text": "ふふっ。\n言うこと聞けて\nおりこうさんね。",
            "zh": "呵呵。\n能乖乖听话，\n真乖呀。",
            "narrator_zh": "绫水"
        },
        {
            "location": "438/TALK",
            "narrator": "アーヤ",
            "text": "と、ちょっとした\nお遊びでした。",
            "zh": "那么，刚才就是\n一点小游戏。",
            "narrator_zh": "绫水"
        },
        {
            "location": "440/TALK",
            "narrator": "アーヤ",
            "text": "といっても\nココロの中じゃ\n実感ないわよね。",
            "zh": "话虽如此，\n在心灵里面，\n也没什么实感吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "441/SEL",
            "narrator": "（選択肢）",
            "text": "確かに！",
            "zh": "确实！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "442/SEL",
            "narrator": "（選択肢）",
            "text": "そんなことないよ！",
            "zh": "才没这回事！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "443/ACT",
            "narrator": "",
            "text": "確かに！",
            "zh": "确实！",
            "narrator_zh": ""
        },
        {
            "location": "444/TALK",
            "narrator": "アーヤ",
            "text": "正直でよろしい。",
            "zh": "很老实，不错。",
            "narrator_zh": "绫水"
        },
        {
            "location": "445/ACT",
            "narrator": "",
            "text": "そんなことないよ！",
            "zh": "才没这回事！",
            "narrator_zh": ""
        },
        {
            "location": "447/TALK",
            "narrator": "アーヤ",
            "text": "本当に？",
            "zh": "真的吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "450/TALK",
            "narrator": "アーヤ",
            "text": "でも、もう現実の\n私とスキンシップ\nできるような――",
            "zh": "不过，按理说应该\n有能和现实里的我\n亲密接触的——",
            "narrator_zh": "绫水"
        },
        {
            "location": "451/TALK",
            "narrator": "アーヤ",
            "text": "システムがある\nはずなんだけどね。",
            "zh": "这样的系统\n才对呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "452/TALK",
            "narrator": "アーヤ",
            "text": "私の姉が\n作ってた気が――",
            "zh": "总觉得是我姐姐\n做出来的——",
            "narrator_zh": "绫水"
        },
        {
            "location": "453/TALK",
            "narrator": "アーヤ",
            "text": "…って、なんで私、\nそんなこと\n知ってるのかしら…。",
            "zh": "……话说，为什么我\n会知道这种事\n呢……",
            "narrator_zh": "绫水"
        }
    ]
}
