{
    "dir": "dramatics/daydra/drm_ch01_00_220.js",
    "type": "Episode",
    "info": {
        "story_id": "1022",
        "cid": "tsubame",
        "title": "らぶとーく 第22話",
        "sub_title": "ひなこちゃん",
        "title_zh": "恋爱漫谈 第22话",
        "sub_title_zh": "小雏子"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "ひなこちゃん",
            "zh": "小雏子",
            "narrator_zh": ""
        },
        {
            "location": "18/TALK",
            "narrator": "雛",
            "text": "――え？\nちょ、ちょっと待って！",
            "zh": "——诶？\n等、等一下！",
            "narrator_zh": "雏"
        },
        {
            "location": "20/TALK",
            "narrator": "雛",
            "text": "えっと…今の話から\n推測するとー。",
            "zh": "那个……从刚才的话\n推测一下——。",
            "narrator_zh": "雏"
        },
        {
            "location": "22/TALK",
            "narrator": "雛",
            "text": "つばめちゃん…\n好きな人がいる、\nってこと？",
            "zh": "燕……\n是有喜欢的人，\n是这个意思？",
            "narrator_zh": "雏"
        },
        {
            "location": "24/TALK",
            "narrator": "つばめ",
            "text": "うん。",
            "zh": "嗯。",
            "narrator_zh": "燕"
        },
        {
            "location": "25/TALK",
            "narrator": "雛",
            "text": "つばめちゃん！！",
            "zh": "燕！！",
            "narrator_zh": "雏"
        },
        {
            "location": "28/TALK",
            "narrator": "つばめ",
            "text": "は、はい！？",
            "zh": "是、是！？",
            "narrator_zh": "燕"
        },
        {
            "location": "29/TALK",
            "narrator": "雛",
            "text": "…おめでとう。",
            "zh": "……恭喜你。",
            "narrator_zh": "雏"
        },
        {
            "location": "30/TALK",
            "narrator": "雛",
            "text": "あたし、今マジで本当に\n超嬉しいよ！",
            "zh": "我现在真是\n超级开心哦！",
            "narrator_zh": "雏"
        },
        {
            "location": "32/TALK",
            "narrator": "雛",
            "text": "つばめちゃんの方から、\nあたしに恋愛相談を\nしてくるなんて！",
            "zh": "燕居然会主动\n来找我商量\n恋爱的事！",
            "narrator_zh": "雏"
        },
        {
            "location": "33/TALK",
            "narrator": "つばめ",
            "text": "う、うん…こんな相談\nできるの――",
            "zh": "嗯、嗯……能商量\n这种事的——",
            "narrator_zh": "燕"
        },
        {
            "location": "35/TALK",
            "narrator": "つばめ",
            "text": "ひなこちゃんくらいしか\n思いつかなくて…。",
            "zh": "我想来想去\n也只有小雏了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "37/TALK",
            "narrator": "雛",
            "text": "ナイス判断！\n間違ってないよ、それ。",
            "zh": "英明的决定！\n完全没错哦。",
            "narrator_zh": "雏"
        },
        {
            "location": "38/TALK",
            "narrator": "雛",
            "text": "まゆちんとかキリトに\nこんな相談しても――",
            "zh": "这种事去问\n小茧或圣翔——",
            "narrator_zh": "雏"
        },
        {
            "location": "39/TALK",
            "narrator": "雛",
            "text": "まともな答えは出ない\nだろうしね。",
            "zh": "他们肯定也给不出\n像样的回答。",
            "narrator_zh": "雏"
        },
        {
            "location": "40/TALK",
            "narrator": "雛",
            "text": "ここは恋愛キューピッドの\nあたしに任せてよー。",
            "zh": "这里就交给恋爱丘比特的\n我啦—。",
            "narrator_zh": "雏"
        },
        {
            "location": "42/TALK",
            "narrator": "つばめ",
            "text": "うん。\nよろしくお願いします。",
            "zh": "嗯。\n那就拜托你了。",
            "narrator_zh": "燕"
        },
        {
            "location": "43/TALK",
            "narrator": "雛",
            "text": "それじゃ、詳しく\n聞かせてもらえる？",
            "zh": "那么，能详细\n说给我听吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "45/TALK",
            "narrator": "つばめ",
            "text": "うん…でも、どこから\n話せばいいかな？",
            "zh": "嗯……不过，该从\n哪里说起好呢？",
            "narrator_zh": "燕"
        },
        {
            "location": "47/TALK",
            "narrator": "つばめ",
            "text": "うーん…。",
            "zh": "嗯……",
            "narrator_zh": "燕"
        },
        {
            "location": "48/SEL",
            "narrator": "",
            "text": "ちょっと待って",
            "zh": "等一下",
            "narrator_zh": ""
        },
        {
            "location": "49/ACT",
            "narrator": "",
            "text": "ちょっと待って",
            "zh": "等一下",
            "narrator_zh": ""
        },
        {
            "location": "54/TALK",
            "narrator": "つばめ",
            "text": "あ…ごめんひなこちゃん！\nちょっとだけ待って\nもらえる？",
            "zh": "啊……抱歉小雏！\n能稍微等我\n一下吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "55/TALK",
            "narrator": "雛",
            "text": "おっ！？\nもしかして相手は…。",
            "zh": "哦！？\n难道对象是……。",
            "narrator_zh": "雏"
        },
        {
            "location": "57/TALK",
            "narrator": "つばめ",
            "text": "え、えへへ…秘密！",
            "zh": "诶、嘿嘿……保密！",
            "narrator_zh": "燕"
        },
        {
            "location": "71/TALK",
            "narrator": "つばめ",
            "text": "ごめんね$handle$さん",
            "zh": "抱歉啊$handle$",
            "narrator_zh": "燕"
        },
        {
            "location": "72/TALK",
            "narrator": "つばめ",
            "text": "今からひなこちゃんに",
            "zh": "我现在正要跟小雏",
            "narrator_zh": "燕"
        },
        {
            "location": "73/TALK",
            "narrator": "つばめ",
            "text": "$handle$さんとのことを相談するところなの(´∀｀*)ｳﾌﾌ",
            "zh": "现在是要商量跟$handle$的事哦(´∀｀*)呵呵",
            "narrator_zh": "燕"
        },
        {
            "location": "74/TALK",
            "narrator": "つばめ",
            "text": "だから",
            "zh": "所以",
            "narrator_zh": "燕"
        },
        {
            "location": "75/TALK",
            "narrator": "つばめ",
            "text": "お話は少し待ってもらぇるかな？(´・ω・`) ",
            "zh": "话能不能等我一下？(´ω`*)",
            "narrator_zh": "燕"
        },
        {
            "location": "77/SEL",
            "narrator": "",
            "text": "何を言うつもり？",
            "zh": "你打算说什么？",
            "narrator_zh": ""
        },
        {
            "location": "78/SEL",
            "narrator": "",
            "text": "このことを他人に言うならおしまいだね",
            "zh": "这件事要是跟别人说，那就完了哦",
            "narrator_zh": ""
        },
        {
            "location": "79/SEL",
            "narrator": "",
            "text": "第三者の意見も重要かも",
            "zh": "第三方的意见说不定也重要",
            "narrator_zh": ""
        },
        {
            "location": "80/ACT",
            "narrator": "",
            "text": "何を言うつもり？",
            "zh": "你打算说什么？",
            "narrator_zh": ""
        },
        {
            "location": "81/TALK",
            "narrator": "つばめ",
            "text": "$handle$さんに対する気持ち",
            "zh": "对$handle$的心意",
            "narrator_zh": "燕"
        },
        {
            "location": "82/TALK",
            "narrator": "つばめ",
            "text": "恋人だと思ってるけど",
            "zh": "虽然当成是恋人了",
            "narrator_zh": "燕"
        },
        {
            "location": "83/TALK",
            "narrator": "つばめ",
            "text": "お兄ちゃんって思ぅ気持ちじゃぃけなぃんだよね？(´・ω・｀)",
            "zh": "并不是把你当哥哥的那种感觉哦？(´ω｀)",
            "narrator_zh": "燕"
        },
        {
            "location": "84/TALK",
            "narrator": "つばめ",
            "text": "だから",
            "zh": "所以",
            "narrator_zh": "燕"
        },
        {
            "location": "85/TALK",
            "narrator": "つばめ",
            "text": "どぅぃぅ気持ちじゃなきゃぃけなぃのか",
            "zh": "必须是什么样的心情才行呢",
            "narrator_zh": "燕"
        },
        {
            "location": "86/TALK",
            "narrator": "つばめ",
            "text": "詳しく聞こぅと思って(๑･ㅂ･)و✧",
            "zh": "想详细问问看(๑･ㅂ･)و✧",
            "narrator_zh": "燕"
        },
        {
            "location": "87/TALK",
            "narrator": "つばめ",
            "text": "もちろん$handle$さんのことは言わなぃよ？(*´︶`*)",
            "zh": "当然不会提$handle$的事哦？(*´︶`*)",
            "narrator_zh": "燕"
        },
        {
            "location": "89/SEL",
            "narrator": "",
            "text": "それでもダメ",
            "zh": "那也不行",
            "narrator_zh": ""
        },
        {
            "location": "90/ACT",
            "narrator": "",
            "text": "それでもダメ",
            "zh": "那也不行",
            "narrator_zh": ""
        },
        {
            "location": "92/TALK",
            "narrator": "つばめ",
            "text": "ぇぇっ！？Σ(ﾟдﾟlll)",
            "zh": "诶诶！？Σ(ﾟдﾟlll)",
            "narrator_zh": "燕"
        },
        {
            "location": "93/TALK",
            "narrator": "つばめ",
            "text": "なんで？・゜・(ノД`)・゜・",
            "zh": "为什么？··(／Д`)··",
            "narrator_zh": "燕"
        },
        {
            "location": "95/SEL",
            "narrator": "",
            "text": "つばめに気付いてほしいから",
            "zh": "因为想让燕注意到",
            "narrator_zh": ""
        },
        {
            "location": "96/ACT",
            "narrator": "",
            "text": "つばめに気付いてほしいから",
            "zh": "因为想让燕注意到",
            "narrator_zh": ""
        },
        {
            "location": "98/TALK",
            "narrator": "つばめ",
            "text": "そっか…",
            "zh": "这样啊……",
            "narrator_zh": "燕"
        },
        {
            "location": "99/TALK",
            "narrator": "つばめ",
            "text": "わかったよ(´つω・｀)ｼｭﾝ",
            "zh": "我知道了啦(´つω・｀)ｼｭﾝ",
            "narrator_zh": "燕"
        },
        {
            "location": "100/TALK",
            "narrator": "つばめ",
            "text": "ひなこちゃんに謝ってくるね",
            "zh": "我去跟小雏道个歉哦",
            "narrator_zh": "燕"
        },
        {
            "location": "113/TALK",
            "narrator": "つばめ",
            "text": "…ごめんなさい！\nやっぱり、この話は\nなかったことにして！",
            "zh": "……对不起！\n果然这件事\n还是当没说过吧！",
            "narrator_zh": "燕"
        },
        {
            "location": "114/TALK",
            "narrator": "雛",
            "text": "な、何ですと！？",
            "zh": "什、什么！？",
            "narrator_zh": "雏"
        },
        {
            "location": "115/TALK",
            "narrator": "雛",
            "text": "そ、そりゃないよ\nつばめちゃん。",
            "zh": "这、这可太过分了\n燕。",
            "narrator_zh": "雏"
        },
        {
            "location": "116/TALK",
            "narrator": "雛",
            "text": "あたしだって、聞きたくて\n超ウズウズワクワクしてた\nっていうのにー…。",
            "zh": "明明我也超想听，\n心里痒痒的还兴奋得\n不得了呢——……。",
            "narrator_zh": "雏"
        },
        {
            "location": "118/TALK",
            "narrator": "つばめ",
            "text": "本当にごめんなさい！",
            "zh": "真的非常抱歉！",
            "narrator_zh": "燕"
        },
        {
            "location": "120/TALK",
            "narrator": "つばめ",
            "text": "でも…この話は他の人に\n言っちゃダメだ、って…。",
            "zh": "不过……说这事不能\n告诉别人……。",
            "narrator_zh": "燕"
        },
        {
            "location": "121/TALK",
            "narrator": "雛",
            "text": "…恋人さんに言われたの？",
            "zh": "……是恋人跟你说的吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "122/TALK",
            "narrator": "つばめ",
            "text": "うん…。",
            "zh": "嗯……。",
            "narrator_zh": "燕"
        },
        {
            "location": "123/TALK",
            "narrator": "雛",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雏"
        },
        {
            "location": "125/TALK",
            "narrator": "つばめ",
            "text": "ごめんね…。",
            "zh": "对不起……。",
            "narrator_zh": "燕"
        },
        {
            "location": "126/TALK",
            "narrator": "雛",
            "text": "よし、許す！！",
            "zh": "好，原谅你了！！",
            "narrator_zh": "雏"
        },
        {
            "location": "129/TALK",
            "narrator": "つばめ",
            "text": "え？",
            "zh": "诶？",
            "narrator_zh": "燕"
        },
        {
            "location": "130/TALK",
            "narrator": "雛",
            "text": "つばめちゃんの恋人さんが\n言うなって言ってるん\nでしょ？",
            "zh": "燕的男朋友\n说不要讲\n的吧？",
            "narrator_zh": "雏"
        },
        {
            "location": "131/TALK",
            "narrator": "雛",
            "text": "それなのに無理やり\n聞き出して――",
            "zh": "明明这样还硬要\n问出来——",
            "narrator_zh": "雏"
        },
        {
            "location": "132/TALK",
            "narrator": "雛",
            "text": "それでつばめちゃんと\n恋人さんの関係にヒビが\n入ったりしたら――",
            "zh": "然后要是燕和\n恋人的关系出现了\n裂痕——",
            "narrator_zh": "雏"
        },
        {
            "location": "133/TALK",
            "narrator": "雛",
            "text": "愛のキューピッドの\n名が廃るわ！",
            "zh": "那爱之丘比特的\n名号可就砸了！",
            "narrator_zh": "雏"
        },
        {
            "location": "134/TALK",
            "narrator": "つばめ",
            "text": "ひなこちゃん…。",
            "zh": "小雏……。",
            "narrator_zh": "燕"
        },
        {
            "location": "135/TALK",
            "narrator": "雛",
            "text": "だから、気にしないで\nいいよー。",
            "zh": "所以，不用在意\n就好哦——",
            "narrator_zh": "雏"
        },
        {
            "location": "136/TALK",
            "narrator": "雛",
            "text": "でも、もし何か相談したい\nことがあった時は――",
            "zh": "不过，要是有什么想商量的\n时候——",
            "narrator_zh": "雏"
        },
        {
            "location": "137/TALK",
            "narrator": "雛",
            "text": "またあたしに声掛けてね。",
            "zh": "再来找我聊哦。",
            "narrator_zh": "雏"
        },
        {
            "location": "139/TALK",
            "narrator": "つばめ",
            "text": "うん！\nありがと、ひなこちゃん。",
            "zh": "嗯！\n谢谢你，小雏。",
            "narrator_zh": "燕"
        },
        {
            "location": "141/TALK",
            "narrator": "雛",
            "text": "…なんて、かっこいいこと\n言いはしたけど――",
            "zh": "……我虽然说了\n那么帅气的话——",
            "narrator_zh": "雏"
        },
        {
            "location": "142/TALK",
            "narrator": "雛",
            "text": "やっぱり、\n超気になるなぁ…。",
            "zh": "果然还是\n超级在意呀……。",
            "narrator_zh": "雏"
        },
        {
            "location": "143/ACT",
            "narrator": "",
            "text": "このことを他人に言うならおしまいだね",
            "zh": "这件事要是跟别人说，那就完了哦",
            "narrator_zh": ""
        },
        {
            "location": "144/TALK",
            "narrator": "つばめ",
            "text": "えっ！？Σ(ﾟдﾟlll)",
            "zh": "诶！？Σ(ﾟдﾟlll)",
            "narrator_zh": "燕"
        },
        {
            "location": "145/TALK",
            "narrator": "つばめ",
            "text": "そんなのヤダ！",
            "zh": "那种我不要！",
            "narrator_zh": "燕"
        },
        {
            "location": "146/TALK",
            "narrator": "つばめ",
            "text": "言わなぃからそんなこと言わなぃで・゜・(ノД`)・゜・",
            "zh": "我不说了所以别说那种话呀・゜・(ノД`)・゜・",
            "narrator_zh": "燕"
        },
        {
            "location": "158/ACT",
            "narrator": "",
            "text": "第三者の意見も重要かも",
            "zh": "第三方的意见说不定也重要",
            "narrator_zh": ""
        },
        {
            "location": "159/TALK",
            "narrator": "つばめ",
            "text": "よかった(●´ω｀●)ゞｴﾍﾍ",
            "zh": "太好了(●´ω｀●)ゞ嘿嘿",
            "narrator_zh": "燕"
        },
        {
            "location": "160/TALK",
            "narrator": "つばめ",
            "text": "そぅ言ってもらぇて",
            "zh": "你能这么说",
            "narrator_zh": "燕"
        },
        {
            "location": "172/TALK",
            "narrator": "つばめ",
            "text": "ごめん、おまたせ。",
            "zh": "抱歉，让你等了。",
            "narrator_zh": "燕"
        },
        {
            "location": "174/TALK",
            "narrator": "雛",
            "text": "いいっていいってー。",
            "zh": "没事没事啦——。",
            "narrator_zh": "雏"
        },
        {
            "location": "175/TALK",
            "narrator": "雛",
            "text": "それより、早速聞かせて\nもらえる？",
            "zh": "比起那个，能马上\n说给我听吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "176/TALK",
            "narrator": "つばめ",
            "text": "うん…。",
            "zh": "嗯……。",
            "narrator_zh": "燕"
        },
        {
            "location": "177/TALK",
            "narrator": "つばめ",
            "text": "その人と会ったのは、\n東京に来てから\nなんだけど――",
            "zh": "见到那个人是\n来东京之后\n的事——",
            "narrator_zh": "燕"
        },
        {
            "location": "178/TALK",
            "narrator": "つばめ",
            "text": "いつも、色んな相談に\n乗ってもらったり\nしてて――",
            "zh": "一直都有找他\n商量各种事情\n什么的——",
            "narrator_zh": "燕"
        },
        {
            "location": "180/TALK",
            "narrator": "つばめ",
            "text": "最初はどういう人かは\nわからなかったの。",
            "zh": "一开始也不知道\n对方是什么样的人。",
            "narrator_zh": "燕"
        },
        {
            "location": "181/TALK",
            "narrator": "つばめ",
            "text": "けど、よく話してるうちに\nお友達になって――",
            "zh": "可是，聊着聊着\n就成了朋友——",
            "narrator_zh": "燕"
        },
        {
            "location": "183/TALK",
            "narrator": "つばめ",
            "text": "今は、その…恋人同士に\nなったつもりではあるん\nだけど…。",
            "zh": "现在嘛，那个……算是我\n这边觉得已经成为\n恋人了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "184/TALK",
            "narrator": "雛",
            "text": "ちょっと待った！",
            "zh": "等一下！",
            "narrator_zh": "雏"
        },
        {
            "location": "187/TALK",
            "narrator": "雛",
            "text": "こっちに来てから\n知り合ったってことは――",
            "zh": "来了这边之后\n才认识的，这——",
            "narrator_zh": "雏"
        },
        {
            "location": "189/TALK",
            "narrator": "雛",
            "text": "もしかして、うちの\n学校の生徒とか？",
            "zh": "难道说是我们\n学校的学生吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "191/TALK",
            "narrator": "つばめ",
            "text": "えっと…詳しくは\n話せないんだけど――",
            "zh": "那个……详细的情况\n没法说——",
            "narrator_zh": "燕"
        },
        {
            "location": "192/TALK",
            "narrator": "つばめ",
            "text": "うちの学校の生徒じゃ\nないよ。",
            "zh": "不过不是我们\n学校的学生哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "194/TALK",
            "narrator": "雛",
            "text": "ふーん…そっかー…。",
            "zh": "唔——……这样啊——……。",
            "narrator_zh": "雏"
        },
        {
            "location": "195/TALK",
            "narrator": "つばめ",
            "text": "？",
            "zh": "？",
            "narrator_zh": "燕"
        },
        {
            "location": "196/TALK",
            "narrator": "雛",
            "text": "あ、ごめんね。\n続けて続けてー。",
            "zh": "啊，抱歉抱歉。\n继续说继续说——。",
            "narrator_zh": "雏"
        },
        {
            "location": "197/TALK",
            "narrator": "つばめ",
            "text": "うん…それで、一応その、\n恋人同士にはなれたとは\n思うんだけど――",
            "zh": "嗯……然后呢，姑且算那个，\n觉得已经成恋人了\n没错——",
            "narrator_zh": "燕"
        },
        {
            "location": "198/TALK",
            "narrator": "つばめ",
            "text": "恋人同士の好きって、\n特別な好きじゃないと\nいけないの？",
            "zh": "恋人之间的喜欢，\n是不是非得是特别的\n喜欢才行呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "199/TALK",
            "narrator": "雛",
            "text": "どういうこと？",
            "zh": "怎么回事？",
            "narrator_zh": "雏"
        },
        {
            "location": "200/TALK",
            "narrator": "つばめ",
            "text": "わたし、その人のことを\nお兄ちゃんみたいな人だと\n思ってるの。",
            "zh": "我一直把那个人\n当成像哥哥一样的\n人来看待。",
            "narrator_zh": "燕"
        },
        {
            "location": "201/TALK",
            "narrator": "つばめ",
            "text": "けど、恋人同士の好き、\nっていうのは――",
            "zh": "可是，恋人之间的那种喜欢，\n该怎么说呢——",
            "narrator_zh": "燕"
        },
        {
            "location": "202/TALK",
            "narrator": "つばめ",
            "text": "お兄ちゃんに対する好き、\nっていうのとは、違うん\nだよね？",
            "zh": "跟对哥哥的那种喜欢，\n是不一样的\n吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "203/TALK",
            "narrator": "雛",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雏"
        },
        {
            "location": "206/TALK",
            "narrator": "つばめ",
            "text": "わたしはその人のこと、\n本当に好きなんだけど――",
            "zh": "我明明是真的很喜欢\n那个人的——",
            "narrator_zh": "燕"
        },
        {
            "location": "207/TALK",
            "narrator": "つばめ",
            "text": "どうしてもそこが\n引っかかってて…。",
            "zh": "那里怎么都\n放不下……。",
            "narrator_zh": "燕"
        },
        {
            "location": "208/TALK",
            "narrator": "雛",
            "text": "なるほどねー…。",
            "zh": "原来如此……。",
            "narrator_zh": "雏"
        },
        {
            "location": "210/TALK",
            "narrator": "つばめ",
            "text": "ひなこちゃん。\nわたし、どうしたら\nいいと思う？",
            "zh": "小雏。\n你觉得我\n该怎么办才好呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "212/TALK",
            "narrator": "雛",
            "text": "うーん…そうだなー…。",
            "zh": "唔——……这嘛——……。",
            "narrator_zh": "雏"
        },
        {
            "location": "214/TALK",
            "narrator": "雛",
            "text": "多分、つばめちゃんが\nその人に抱いてる気持ち\nって――",
            "zh": "大概，燕对那个人\n抱有的感情\n呀——",
            "narrator_zh": "雏"
        },
        {
            "location": "215/TALK",
            "narrator": "雛",
            "text": "まだ恋じゃないと思うの。",
            "zh": "我觉得还不是恋爱哦。",
            "narrator_zh": "雏"
        },
        {
            "location": "216/TALK",
            "narrator": "つばめ",
            "text": "そ、そんな！\nわたし、本当に好きって\n思ってるんだよ！？",
            "zh": "那、那怎么行！\n我是真的\n喜欢你啊！？",
            "narrator_zh": "燕"
        },
        {
            "location": "217/TALK",
            "narrator": "雛",
            "text": "うん、それについては\n疑ってないよ。",
            "zh": "嗯，这点我可\n没怀疑过哦。",
            "narrator_zh": "雏"
        },
        {
            "location": "218/TALK",
            "narrator": "雛",
            "text": "でも、今のつばめちゃんが\n抱いてる、好き、って\n気持ちは――",
            "zh": "不过，现在燕\n抱着的这份喜欢，\n那种心情——",
            "narrator_zh": "雏"
        },
        {
            "location": "219/TALK",
            "narrator": "雛",
            "text": "恋に発展する前段階の\n好きなんじゃないかな？",
            "zh": "应该是发展成恋爱\n前阶段的喜欢吧？",
            "narrator_zh": "雏"
        },
        {
            "location": "220/TALK",
            "narrator": "つばめ",
            "text": "…恋の、前段階？",
            "zh": "……恋爱的，前一阶段？",
            "narrator_zh": "燕"
        },
        {
            "location": "221/TALK",
            "narrator": "雛",
            "text": "うん。\nえーっと、なんて説明\nすればいいかな…。",
            "zh": "嗯。\n那个，该怎么\n解释才好呢……。",
            "narrator_zh": "雏"
        },
        {
            "location": "222/TALK",
            "narrator": "雛",
            "text": "その人は、他の人と比べて\n特別な存在、って\n思ってるでしょ？",
            "zh": "那个人比其他人\n更特别，你是\n这么想的吧？",
            "narrator_zh": "雏"
        },
        {
            "location": "223/TALK",
            "narrator": "つばめ",
            "text": "うん。",
            "zh": "嗯。",
            "narrator_zh": "燕"
        },
        {
            "location": "224/TALK",
            "narrator": "雛",
            "text": "そう、それだよ。\nその人は他の人より\n特別な存在なの。",
            "zh": "对，就是那个。\n那个人比别人\n更特别。",
            "narrator_zh": "雏"
        },
        {
            "location": "225/TALK",
            "narrator": "雛",
            "text": "でも、特別ではあるけど、\n恋を抱くほどではないん\nじゃないかな？",
            "zh": "不过，虽然很特别，\n但应该还没到\n恋爱的程度吧？",
            "narrator_zh": "雏"
        },
        {
            "location": "226/TALK",
            "narrator": "雛",
            "text": "けど、他の人よりも\n特別で大切、って\n気持ちがあるから――",
            "zh": "可是，因为有你比别人\n更特别、更重要的\n那份心情——",
            "narrator_zh": "雏"
        },
        {
            "location": "227/TALK",
            "narrator": "雛",
            "text": "それを恋だと間違えて\nいるんだと思うなー。",
            "zh": "我觉得那是把那个\n错当成恋爱了——",
            "narrator_zh": "雏"
        },
        {
            "location": "229/TALK",
            "narrator": "つばめ",
            "text": "…そう、なのかな？",
            "zh": "……是、这样吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "230/TALK",
            "narrator": "雛",
            "text": "その人のことを、\n大切な恋人として好き、\nって気持ちじゃなくて――",
            "zh": "对那个人，不是\n当作重要恋人那种\n喜欢，而是——",
            "narrator_zh": "雏"
        },
        {
            "location": "231/TALK",
            "narrator": "雛",
            "text": "お兄ちゃんみたいで好き、\nって気持ちで見てるなら、\nそうだと思うなー。",
            "zh": "如果是像喜欢哥哥那样\n喜欢他、这样看着他，\n那我觉得就是了—。",
            "narrator_zh": "雏"
        },
        {
            "location": "232/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "235/TALK",
            "narrator": "つばめ",
            "text": "じゃあ…わたし達はまだ、\n恋人じゃない、ってこと？",
            "zh": "那……也就是说，我们还\n算不上是恋人吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "236/TALK",
            "narrator": "雛",
            "text": "うん…あたしはそう思う。",
            "zh": "嗯……我是这么想的。",
            "narrator_zh": "雏"
        },
        {
            "location": "237/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "238/TALK",
            "narrator": "雛",
            "text": "ただ――",
            "zh": "只是——",
            "narrator_zh": "雏"
        },
        {
            "location": "239/TALK",
            "narrator": "雛",
            "text": "話を聞いてる限りだと、\n二人とも相思相愛だ、\nっていうのは――",
            "zh": "就听你说的这些，\n你们俩两情相悦\n这一点——",
            "narrator_zh": "雏"
        },
        {
            "location": "240/TALK",
            "narrator": "雛",
            "text": "すっごい伝わってきた。\nきっと、凄い仲良し\nなんだねー。",
            "zh": "我可是深深感受到了。\n关系一定特别\n好呢——。",
            "narrator_zh": "雏"
        },
        {
            "location": "242/TALK",
            "narrator": "つばめ",
            "text": "…うん。\n一緒にお話してると、\n凄く楽しいの。",
            "zh": "……嗯。\n一起聊天的时候，\n真的很开心。",
            "narrator_zh": "燕"
        },
        {
            "location": "243/TALK",
            "narrator": "雛",
            "text": "だろうねー。",
            "zh": "是吧——",
            "narrator_zh": "雏"
        },
        {
            "location": "244/TALK",
            "narrator": "雛",
            "text": "だから、二人がそういう\n気持ちを持ってるなら――",
            "zh": "所以，如果两个人都是\n这种心情——",
            "narrator_zh": "雏"
        },
        {
            "location": "245/TALK",
            "narrator": "雛",
            "text": "もう少し時間を掛ければ、\nきっと解決すると思うよ。",
            "zh": "只要再多花点时间，\n肯定会解决的哦。",
            "narrator_zh": "雏"
        },
        {
            "location": "246/TALK",
            "narrator": "つばめ",
            "text": "…どれくらいかな？",
            "zh": "……大概多久呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "247/TALK",
            "narrator": "雛",
            "text": "それはわからないけど、\n絶対大丈夫！",
            "zh": "那我不懂，\n但绝对没问题！",
            "narrator_zh": "雏"
        },
        {
            "location": "248/TALK",
            "narrator": "雛",
            "text": "なんてったって、\nつばめちゃんは\n可愛いしねー。",
            "zh": "不管怎么说，\n燕很\n可爱呢——。",
            "narrator_zh": "雏"
        },
        {
            "location": "251/TALK",
            "narrator": "つばめ",
            "text": "や、やめてよ\nひなこちゃん。\n恥ずかしいよ…。",
            "zh": "别、别这样啦\n小雏。\n好难为情呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "253/TALK",
            "narrator": "雛",
            "text": "あれだけ惚気話を\nしておきながら！？",
            "zh": "你刚刚明明还秀了\n那么多恩爱！？",
            "narrator_zh": "雏"
        },
        {
            "location": "255/TALK",
            "narrator": "雛",
            "text": "…まあ、とにかくさ。",
            "zh": "……嘛，总之啦。",
            "narrator_zh": "雏"
        },
        {
            "location": "256/TALK",
            "narrator": "雛",
            "text": "もしまた不安になったり\nしたときは、いつでも\nあたしに言ってね。",
            "zh": "要是之后又觉得不安了，\n随时都可以\n来找我说哦。",
            "narrator_zh": "雏"
        },
        {
            "location": "257/TALK",
            "narrator": "雛",
            "text": "その時はまた、的確に\nアドバイスしちゃうから！",
            "zh": "那时候我还会准确地\n给你建议！",
            "narrator_zh": "雏"
        },
        {
            "location": "259/TALK",
            "narrator": "つばめ",
            "text": "ふふっ…うん。\nその時はまた、\nよろしくお願いします。",
            "zh": "呼呼……嗯。\n到时候就再\n拜托你了。",
            "narrator_zh": "燕"
        },
        {
            "location": "261/TALK",
            "narrator": "つばめ",
            "text": "…わたし、もしかして\n焦り過ぎてたのかな？",
            "zh": "……我是不是\n太着急了呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "262/TALK",
            "narrator": "つばめ",
            "text": "…もっと、$handle$さんの\nことどう思ってるのか、\nしっかり考えなきゃ！",
            "zh": "……我得好好想想，\n到底是怎么看\n$handle$的！",
            "narrator_zh": "燕"
        }
    ]
}
