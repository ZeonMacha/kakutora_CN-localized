            "text": "出陣",
            "zh": "出击",
            "narrator_zh": ""
        },
        {
            "location": "323/TALK",
            "narrator": "つばめ",
            "text": "ううん",
            "zh": "不是的",
            "narrator_zh": "燕"
        },
        {
            "location": "324/TALK",
            "narrator": "つばめ",
            "text": "こういうこと",
            "zh": "这种事",
            "narrator_zh": "燕"
        },
        {
            "location": "325/TALK",
            "narrator": "つばめ",
            "text": "前にもあったから",
            "zh": "以前也有过",
            "narrator_zh": "燕"
        },
        {
            "location": "326/TALK",
            "narrator": "つばめ",
            "text": "わかるの(o´Д`)=з",
            "zh": "所以我知道(o´Д`)=з",
            "narrator_zh": "燕"
        },
        {
            "location": "330/SEL",
            "narrator": "",
            "text": "積極的に話してみようよ",
            "zh": "主动去说说看吧",
            "narrator_zh": ""
        },
        {
            "location": "331/ACT",
            "narrator": "",
            "text": "積極的に話してみようよ",
            "zh": "主动去说说看吧",
            "narrator_zh": ""
        },
        {
            "location": "333/TALK",
            "narrator": "つばめ",
            "text": "無理だよ",
            "zh": "做不到",
            "narrator_zh": "燕"
        },
        {
            "location": "334/TALK",
            "narrator": "つばめ",
            "text": "きっと",
            "zh": "一定",
            "narrator_zh": "燕"
        },
        {
            "location": "335/TALK",
            "narrator": "つばめ",
            "text": "余計嫌われちゃう(´つω・｀)ｼｭﾝ",
            "zh": "会被更讨厌(´つω・｀)ｼｭﾝ",
            "narrator_zh": "燕"
        },
        {
            "location": "336/TALK",
            "narrator": "つばめ",
            "text": "そんなの",
            "zh": "那样",
            "narrator_zh": "燕"
        },
        {
            "location": "337/TALK",
            "narrator": "つばめ",
            "text": "悲しいよ・゜・(ノД`)・゜・",
            "zh": "好难过・゜・(ノД`)・゜・",
            "narrator_zh": "燕"
        },
        {
            "location": "339/SEL",
            "narrator": "",
            "text": "このままの方が悲しいよ",
            "zh": "就这样下去更难过哦",
            "narrator_zh": ""
        },
        {
            "location": "340/ACT",
            "narrator": "",
            "text": "このままの方が悲しいよ",
            "zh": "就这样下去更难过哦",
            "narrator_zh": ""
        },
        {
            "location": "342/TALK",
            "narrator": "つばめ",
            "text": "そうかもしれないけど",
            "zh": "也许是这样",
            "narrator_zh": "燕"
        },
        {
            "location": "344/TALK",
            "narrator": "つばめ",
            "text": "怖いの",
            "zh": "可是害怕",
            "narrator_zh": "燕"
        },
        {
            "location": "345/TALK",
            "narrator": "つばめ",
            "text": "仲良くなりたい人に",
            "zh": "想要亲近的人",
            "narrator_zh": "燕"
        },
        {
            "location": "346/TALK",
            "narrator": "つばめ",
            "text": "引かれちゃうのって",
            "zh": "被对方躲开",
            "narrator_zh": "燕"
        },
        {
            "location": "348/SEL",
            "narrator": "",
            "text": "思いっきりが足りないからそうなる",
            "zh": "是因为魄力不够才会这样",
            "narrator_zh": ""
        },
        {
            "location": "349/ACT",
            "narrator": "",
            "text": "思いっきりが足りないからそうなる",
            "zh": "是因为魄力不够才会这样",
            "narrator_zh": ""
        },
        {
            "location": "351/TALK",
            "narrator": "つばめ",
            "text": "そんなことない",
            "zh": "才不是",
            "narrator_zh": "燕"
        },
        {
            "location": "352/TALK",
            "narrator": "つばめ",
            "text": "前の時だって",
            "zh": "上次也是",
            "narrator_zh": "燕"
        },
        {
            "location": "353/TALK",
            "narrator": "つばめ",
            "text": "頑張ったもん",
            "zh": "我努力了",
            "narrator_zh": "燕"
        },
        {
            "location": "355/SEL",
            "narrator": "",
            "text": "足りないよ",
            "zh": "还不够",
            "narrator_zh": ""
        },
        {
            "location": "356/ACT",
            "narrator": "",
            "text": "足りないよ",
            "zh": "还不够",
            "narrator_zh": ""
        },
        {
            "location": "358/TALK",
            "narrator": "つばめ",
            "text": "そうかな？",
            "zh": "是吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "360/TALK",
            "narrator": "つばめ",
            "text": "何が足りないのかな？",
            "zh": "缺的是什么呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "362/SEL",
            "narrator": "",
            "text": "もっと仲良くなりたい、って気持ちを出していけ",
            "zh": "把想更亲近的心意表现出来",
            "narrator_zh": ""
        },
        {
            "location": "363/ACT",
            "narrator": "",
            "text": "もっと仲良くなりたい、って気持ちを出していけ",
            "zh": "把想更亲近的心意表现出来",
            "narrator_zh": ""
        },
        {
            "location": "366/SEL",
            "narrator": "",
            "text": "とにかく、話さなくちゃ",
            "zh": "总之，必须开口",
            "narrator_zh": ""
        },
        {
            "location": "367/ACT",
            "narrator": "",
            "text": "とにかく、話さなくちゃ",
            "zh": "总之，必须开口",
            "narrator_zh": ""
        },
        {
            "location": "369/TALK",
            "narrator": "つばめ",
            "text": "ちゃんと話せば",
            "zh": "好好说的话",
            "narrator_zh": "燕"
        },
        {
            "location": "370/TALK",
            "narrator": "つばめ",
            "text": "少しは仲良くなれるかな？(´･ω･｀) ",
            "zh": "能稍微亲近一点吗？(´･ω･｀) ",
            "narrator_zh": "燕"
        },
        {
            "location": "371/TALK",
            "narrator": "つばめ",
            "text": "嫌われたままでいられるのは嫌だよ(´つω・｀)ｼｭﾝ",
            "zh": "一直被讨厌着，我不愿意(´つω・｀)ｼｭﾝ",
            "narrator_zh": "燕"
        },
        {
            "location": "373/SEL",
            "narrator": "",
            "text": "頑張れ、つばめ！",
            "zh": "加油，燕！",
            "narrator_zh": ""
        },
        {
            "location": "374/ACT",
            "narrator": "",
            "text": "頑張れ、つばめ！",
            "zh": "加油，燕！",
            "narrator_zh": ""
        },
        {
            "location": "376/TALK",
            "narrator": "つばめ",
            "text": "ありがと(≧ω≦)",
            "zh": "谢谢(≧ω≦)",
            "narrator_zh": "燕"
        },
        {
            "location": "377/TALK",
            "narrator": "つばめ",
            "text": "でも",
            "zh": "可是",
            "narrator_zh": "燕"
        },
        {
            "location": "378/TALK",
            "narrator": "つばめ",
            "text": "なんて話しかければいいかな？(´･ω･｀) ",
            "zh": "该怎么开口好呀？(´･ω･｀) ",
            "narrator_zh": "燕"
        },
        {
            "location": "379/TALK",
            "narrator": "つばめ",
            "text": "急だから話題も思いつかないし…",
            "zh": "太突然了，话题也想不出来……",
            "narrator_zh": "燕"
        },
        {
            "location": "381/SEL",
            "narrator": "",
            "text": "手を繋ごう、と言おう",
            "zh": "说去牵手吧",
            "narrator_zh": ""
        },
        {
            "location": "382/SEL",
            "narrator": "",
            "text": "帰ったら食事しようと誘おう",
            "zh": "回去之后约吃饭吧",
            "narrator_zh": ""
        },
        {
            "location": "383/ACT",
            "narrator": "",
            "text": "手を繋ごう、と言おう",
            "zh": "说去牵手吧",
            "narrator_zh": ""
        },
        {
            "location": "384/TALK",
            "narrator": "つばめ",
            "text": "それいいかもヽ(*´∀｀)ノ",
            "zh": "这个也许不错ヽ(*´∀｀)ノ",
            "narrator_zh": "燕"
        },
        {
            "location": "385/TALK",
            "narrator": "つばめ",
            "text": "早速言ってみるね(๑･ㅂ･)و☆",
            "zh": "我马上去说(๑･ㅂ･)و☆",
            "narrator_zh": "燕"
        },
        {
            "location": "417/TALK",
            "narrator": "つばめ",
            "text": "あの、せんぱい。",
            "zh": "那个，前辈。",
            "narrator_zh": "燕"
        },
        {
            "location": "419/TALK",
            "narrator": "ガブリエラ",
            "text": "…何よ？",
            "zh": "……什么？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "420/TALK",
            "narrator": "つばめ",
            "text": "え、えっと…。",
            "zh": "诶、那个……。",
            "narrator_zh": "燕"
        },
        {
            "location": "421/TALK",
            "narrator": "つばめ",
            "text": "…よかったら、\nわたしと手を繋いで\nもらえませんか？",
            "zh": "……如果可以的话，\n能和我\n牵手吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "422/TALK",
            "narrator": "ガブリエラ",
            "text": "っ！？",
            "zh": "！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "425/TALK",
            "narrator": "ガブリエラ",
            "text": "は？　いや、何？\n急に何言い出すの？",
            "zh": "哈？　不，什么？\n突然说什么？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "427/TALK",
            "narrator": "つばめ",
            "text": "だ、だって、こんな\n不気味なところ\n歩いてると――",
            "zh": "因、因为，在这种\n阴森的地方\n走着——",
            "narrator_zh": "燕"
        },
        {
            "location": "428/TALK",
            "narrator": "つばめ",
            "text": "何か不安な気持ちに\nなってくるじゃない\nですか。",
            "zh": "心里会变得\n不安，\n不是吗。",
            "narrator_zh": "燕"
        },
        {
            "location": "429/TALK",
            "narrator": "つばめ",
            "text": "だから、よかったら\n手を握ってもらえたら\n嬉しいなぁ、って…。",
            "zh": "所以，如果可以，\n能握着我的手\n我会很高兴……。",
            "narrator_zh": "燕"
        },
        {
            "location": "430/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "432/TALK",
            "narrator": "ガブリエラ",
            "text": "絶対に嫌。\n子供じゃあるまいし。",
            "zh": "绝对不要。\n又不是小孩子。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "433/TALK",
            "narrator": "つばめ",
            "text": "そ、そうですか…。",
            "zh": "是、是吗……。",
            "narrator_zh": "燕"
        },
        {
            "location": "435/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィ、そんなに\nイジワル言わないの。",
            "zh": "加维，别那么\n捉弄人。",
            "narrator_zh": "绫水"
        },
        {
            "location": "438/TALK",
            "narrator": "ガブリエラ",
            "text": "な、なによ？\nまた新人の味方するわけ？",
            "zh": "什、什么？\n又站在新人那边？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "439/TALK",
            "narrator": "アーヤ",
            "text": "新人だと思うなら、\n手くらい繋いであげても\nいいんじゃない？",
            "zh": "既然觉得是新人，\n牵个手\n也没关系吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "442/TALK",
            "narrator": "ガブリエラ",
            "text": "むっ…。",
            "zh": "唔……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "443/TALK",
            "narrator": "つばめ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "燕"
        },
        {
            "location": "444/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "445/TALK",
            "narrator": "ガブリエラ",
            "text": "やっぱり嫌よ。",
            "zh": "还是不要。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "446/TALK",
            "narrator": "ガブリエラ",
            "text": "フェノメノンの中で、\nわざわざリスクを冒すような\nことしたくないし。",
            "zh": "在PhenoMENON里，\n我不想特意去做\n冒险的事。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "447/TALK",
            "narrator": "つばめ",
            "text": "…？\nリスク……って…？",
            "zh": "……？\n风险……是指……？",
            "narrator_zh": "燕"
        },
        {
            "location": "448/TALK",
            "narrator": "アーヤ",
            "text": "まったく、イジワル\nなんだから…。",
            "zh": "真是的，就会\n捉弄人……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "451/TALK",
            "narrator": "ガブリエラ",
            "text": "イジワルじゃない！\n何よ、もう…。",
            "zh": "才不是捉弄！\n什么嘛，真是的……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "452/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "453/ACT",
            "narrator": "",
            "text": "帰ったら食事しようと誘おう",
            "zh": "回去之后约吃饭吧",
            "narrator_zh": ""
        },
        {
            "location": "454/TALK",
            "narrator": "つばめ",
            "text": "それなら自然かも(*´︶`*)",
            "zh": "那样也许自然些(*´︶`*)",
            "narrator_zh": "燕"
        },
        {
            "location": "455/TALK",
            "narrator": "つばめ",
            "text": "早速誘ってみる(๑･ㅂ･)و☆",
            "zh": "我马上去约(๑･ㅂ･)و☆",
            "narrator_zh": "燕"
        },
        {
            "location": "485/TALK",
            "narrator": "つばめ",
            "text": "あ、あの、せんぱい。\nこれが終わった後の\n予定って、ありますか？",
            "zh": "啊、那个，前辈。\n这件事结束之后，\n有安排吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "487/TALK",
            "narrator": "ガブリエラ",
            "text": "何でそんなこと聞くのよ？",
            "zh": "为什么问这个？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "488/TALK",
            "narrator": "つばめ",
            "text": "もし予定がないなら、\n一緒に食事に行きま\nせんか？",
            "zh": "如果没有安排，\n要不要一起去\n吃饭？",
            "narrator_zh": "燕"
        },
        {
            "location": "489/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "491/TALK",
            "narrator": "ガブリエラ",
            "text": "いや、え？\n何でこのタイミングで\n急にそんなこと聞くわけ？",
            "zh": "不，诶？\n为什么在这个时候\n突然问这种事？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "493/TALK",
            "narrator": "つばめ",
            "text": "考えてみたらわたし、\nまだせんぱいのことって\nよく知らないし――",
            "zh": "我想了想，我\n对前辈还\n不太了解——",
            "narrator_zh": "燕"
        },
        {
            "location": "494/TALK",
            "narrator": "つばめ",
            "text": "せんぱいも、わたしのこと\n知らないと思うから――",
            "zh": "前辈对我，\n应该也不了解——",
            "narrator_zh": "燕"
        },
        {
            "location": "495/TALK",
            "narrator": "つばめ",
            "text": "食事でもしながら、\n色々お話したいと\n思ったんです。",
            "zh": "一边吃饭，\n一边聊很多，\n我是这么想的。",
            "narrator_zh": "燕"
        },
        {
            "location": "497/TALK",
            "narrator": "アーヤ",
            "text": "それ、いいじゃない。\nそうすれば少しは\n距離も縮まるだろうし。",
            "zh": "那不是挺好。\n这样的话，距离\n也能拉近一点。",
            "narrator_zh": "绫水"
        },
        {
            "location": "498/TALK",
            "narrator": "アーヤ",
            "text": "行ってあげたら？",
            "zh": "去一下如何？",
            "narrator_zh": "绫水"
        },
        {
            "location": "501/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょ、やめてよアーヤ！\nあたしは行かないわよ？",
            "zh": "等、别这样绫水！\n我才不去。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "502/TALK",
            "narrator": "つばめ",
            "text": "もしかして、予定とか\nありましたか？",
            "zh": "难道，已经有\n安排了吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "505/TALK",
            "narrator": "ガブリエラ",
            "text": "そうじゃないけど…。",
            "zh": "倒不是那样……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "506/TALK",
            "narrator": "ガブリエラ",
            "text": "得体のしれない奴と\n食事しても、美味しく\n食べられないわ。",
            "zh": "和来历不明的人\n吃饭，也吃不出\n味道。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "507/TALK",
            "narrator": "アーヤ",
            "text": "ちょっと、ギャヴィ！",
            "zh": "等等，加维！",
            "narrator_zh": "绫水"
        },
        {
            "location": "510/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤも！\nそうやって新人の肩ばっか\n持たないでよ！",
            "zh": "绫水也是！\n别老只帮着\n新人！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "511/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
