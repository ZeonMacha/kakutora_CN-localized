{
    "dir": "chap29/daydra/dd_ch02_29_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "29205",
        "cid": "ayami",
        "title": "005 メインストーリー",
        "sub_title": "背中合わせの＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "背靠背＜后篇＞"
    },
    "entry": [
        {
            "location": "497/SCENARIO",
            "narrator": "",
            "text": "背中合わせの",
            "zh": "背靠背",
            "narrator_zh": ""
        },
        {
            "location": "516/TALK",
            "narrator": "アーヤ",
            "text": "私はずっと\nマイペースな姉に\n腹を立てていました。",
            "zh": "我一直都在对\n我行我素的姐姐\n感到生气。",
            "narrator_zh": "绫水"
        },
        {
            "location": "517/TALK",
            "narrator": "アーヤ",
            "text": "つい人の望むことを\nしてしまう自分と比べて\n飄々としている姉。",
            "zh": "比起总是不自觉地\n去迎合他人期待的自己，\n姐姐却总是那么洒脱自如。",
            "narrator_zh": "绫水"
        },
        {
            "location": "518/TALK",
            "narrator": "アーヤ",
            "text": "自分の好きなことに\n全力投球して\n認めさせてしまう姉に。",
            "zh": "我对全心全意投入\n自己喜欢的事物、还能\n赢得认可的姐姐感到不满。",
            "narrator_zh": "绫水"
        },
        {
            "location": "520/TALK",
            "narrator": "アーヤ",
            "text": "…でも。",
            "zh": "……不过。",
            "narrator_zh": "绫水"
        },
        {
            "location": "521/TALK",
            "narrator": "アーヤ",
            "text": "お互いどこか\nすれ違っていただけ\nなのかもしれないですね。",
            "zh": "或许我们彼此之间\n只是在什么地方\n擦肩错过了而已吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "522/TALK",
            "narrator": "真幌",
            "text": "……。\nこれは口止め\nされていたんだが。",
            "zh": "……。\n这件事本来她交代过\n要保密的。",
            "narrator_zh": "真幌"
        },
        {
            "location": "523/TALK",
            "narrator": "真幌",
            "text": "エリカはワルシャワの\n世界大会に行けなかった\nことを後悔していた。",
            "zh": "领火其实一直很后悔\n没能去成华沙的\n世界大赛。",
            "narrator_zh": "真幌"
        },
        {
            "location": "524/TALK",
            "narrator": "真幌",
            "text": "引退試合になるなら\n仕事を全部投げ捨ても\n行くべきだったと。",
            "zh": "她说要是知道是隐退赛，\n就算把工作全都丢下\n也应该去的。",
            "narrator_zh": "真幌"
        },
        {
            "location": "526/TALK",
            "narrator": "アーヤ",
            "text": "……。\nたかが学生の試合です。",
            "zh": "……。\n那不过是学生的比赛罢了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "529/TALK",
            "narrator": "アーヤ",
            "text": "仕事の方が大事に\n決まってるじゃ\nないですか。",
            "zh": "当然是工作\n更重要\n不是吗。",
            "narrator_zh": "绫水"
        },
        {
            "location": "530/TALK",
            "narrator": "真幌",
            "text": "たかがじゃないだろう。\n大事な妹の晴れ舞台だ。",
            "zh": "怎么会只是“不过”呢。\n那可是重要妹妹的盛大舞台啊。",
            "narrator_zh": "真幌"
        },
        {
            "location": "531/SEL",
            "narrator": "",
            "text": "そうだよ",
            "zh": "就是啊",
            "narrator_zh": ""
        },
        {
            "location": "532/SEL",
            "narrator": "",
            "text": "$me$も見たかったな",
            "zh": "$me$我也好想看啊",
            "narrator_zh": ""
        },
        {
            "location": "533/ACT",
            "narrator": "",
            "text": "そうだよ",
            "zh": "就是啊",
            "narrator_zh": ""
        },
        {
            "location": "550/TALK",
            "narrator": "アーヤ",
            "text": "昔の話よ",
            "zh": "都是以前的事了哦",
            "narrator_zh": "绫水"
        },
        {
            "location": "551/ACT",
            "narrator": "",
            "text": "$me$も見たかったな",
            "zh": "$me$我也好想看啊",
            "narrator_zh": ""
        },
        {
            "location": "568/TALK",
            "narrator": "アーヤ",
            "text": "もう無理だけど",
            "zh": "已经不可能了就是",
            "narrator_zh": "绫水"
        },
        {
            "location": "580/TALK",
            "narrator": "アーヤ",
            "text": "それにわざわざ\n口止めする必要なんて。",
            "zh": "而且也用不着\n特意让人保密吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "581/TALK",
            "narrator": "真幌",
            "text": "アヤちゃんはきっと\nすごく悩んで引退を\n決めたんだと思う。",
            "zh": "小绫她一定是\n烦恼了很久很久，\n才决定隐退的。",
            "narrator_zh": "真幌"
        },
        {
            "location": "582/TALK",
            "narrator": "真幌",
            "text": "アヤちゃんの人生は\nアヤちゃんだけに\n決める権利がある。",
            "zh": "小绫的人生，\n只有小绫自己\n才有权利决定。",
            "narrator_zh": "真幌"
        },
        {
            "location": "583/TALK",
            "narrator": "真幌",
            "text": "だけど私はきっと\nアヤちゃんに聞いて\nしまうだろうから。",
            "zh": "可是我见到她的话，\n肯定还是会忍不住\n问出口的吧。",
            "narrator_zh": "真幌"
        },
        {
            "location": "584/TALK",
            "narrator": "真幌",
            "text": "どうして辞めたの？\nなんで続けないの？\nって。",
            "zh": "问她为什么要辞掉？\n为什么不继续下去呢？\n之类的。",
            "narrator_zh": "真幌"
        },
        {
            "location": "585/TALK",
            "narrator": "真幌",
            "text": "そしてアヤちゃんは\nその言葉をずっと\n気にするだろうから。",
            "zh": "而小绫又一定会\n把那些话一直\n记挂在心上的。",
            "narrator_zh": "真幌"
        },
        {
            "location": "586/TALK",
            "narrator": "真幌",
            "text": "だから内緒ね。\n見に行きたかったことも\n見に行けなかったことも。",
            "zh": "所以要保密哦。\n无论是很想去看的事，\n还是没能去成的事。",
            "narrator_zh": "真幌"
        },
        {
            "location": "587/TALK",
            "narrator": "真幌",
            "text": "――だ、そうだ。",
            "zh": "——她就是这么说的。",
            "narrator_zh": "真幌"
        },
        {
            "location": "588/SEL",
            "narrator": "",
            "text": "いいお姉さんだね",
            "zh": "真是个好姐姐呢",
            "narrator_zh": ""
        },
        {
            "location": "589/SEL",
            "narrator": "",
            "text": "続けて欲しかったんだね",
            "zh": "她是希望你能继续下去吧",
            "narrator_zh": ""
        },
        {
            "location": "590/ACT",
            "narrator": "",
            "text": "いいお姉さんだね",
            "zh": "真是个好姐姐呢",
            "narrator_zh": ""
        },
        {
            "location": "591/ACT",
            "narrator": "",
            "text": "続けて欲しかったんだね",
            "zh": "她是希望你能继续下去吧",
            "narrator_zh": ""
        },
        {
            "location": "622/TALK",
            "narrator": "アーヤ",
            "text": "私はずっと自分自身に\n挑戦するために\n剣道をしていました。",
            "zh": "我以前一直是为了\n挑战自己本身，\n才一直练剑道的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "623/TALK",
            "narrator": "アーヤ",
            "text": "そして世界選手権で\n優勝した時\n何かが切れたんです。",
            "zh": "然后在世界锦标赛上\n夺冠的那一刻，\n心里有什么东西断掉了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "626/TALK",
            "narrator": "アーヤ",
            "text": "聞かれたら確かに\n困ったでしょうね。",
            "zh": "要是真被问起来，\n我确实会很为难吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "627/TALK",
            "narrator": "アーヤ",
            "text": "続けるのが怖いから\nもう剣道を辞めるとしか\n言えなかったですから。",
            "zh": "因为我只是害怕继续下去，\n只能说出我已经不练剑道了\n这样的话来啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "628/TALK",
            "narrator": "真幌",
            "text": "…エリカは答えが\n欲しかったわけじゃ\nないぞ。",
            "zh": "……领火她\n并不是想要\n一个答案啊。",
            "narrator_zh": "真幌"
        },
        {
            "location": "630/TALK",
            "narrator": "アーヤ",
            "text": "……それも\nわかってます。",
            "zh": "……那些事\n我也都明白。",
            "narrator_zh": "绫水"
        },
        {
            "location": "631/TALK",
            "narrator": "真幌",
            "text": "本当に似てるな。\nさすがは姉妹だ。",
            "zh": "真是太像了啊。\n不愧是亲姐妹。",
            "narrator_zh": "真幌"
        },
        {
            "location": "633/TALK",
            "narrator": "アーヤ",
            "text": "あまりそう\n言ってほしくは\nないですけど…。",
            "zh": "我倒是不太\n希望你这么说\n就是了……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "634/TALK",
            "narrator": "真幌",
            "text": "あはは。\nそうだろうな。",
            "zh": "啊哈哈。\n也是啊。",
            "narrator_zh": "真幌"
        },
        {
            "location": "637/TALK",
            "narrator": "アーヤ",
            "text": "館長…！",
            "zh": "馆长……！",
            "narrator_zh": "绫水"
        },
        {
            "location": "648/DIALOG",
            "narrator": "Dialog_chapter_ch02",
            "text": "【MV EXE_MiYABi】",
            "zh": "【MV EXE_MiYABi】",
            "narrator_zh": "Dialog_chapter_ch02"
        }
    ]
}
