{
    "dir": "dramatics/daydra/drm_ch04_00_440.js",
    "type": "Episode",
    "info": {
        "story_id": "4046",
        "cid": "miyabi",
        "title": "らぶとーく 第47話",
        "sub_title": "口止めとは生意気な（つばめ）",
        "title_zh": "恋爱漫谈 第47话",
        "sub_title_zh": "封口还真是放肆（燕）"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "口止めとは生意気な（つばめ）",
            "zh": "封口还真是放肆（燕）",
            "narrator_zh": ""
        },
        {
            "location": "22/TALK",
            "narrator": "つばめ",
            "text": "あ、はーい。\n開いてますよー。",
            "zh": "啊，好——。\n门开着哦——。",
            "narrator_zh": "燕"
        },
        {
            "location": "25/TALK",
            "narrator": "みやび",
            "text": "お邪魔するぞね。",
            "zh": "打扰了咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "26/TALK",
            "narrator": "つばめ",
            "text": "みやびさん。\nどうかしたんですか？",
            "zh": "雅。\n怎么了吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "27/TALK",
            "narrator": "みやび",
            "text": "ん…当直のことや。",
            "zh": "嗯……说的是值班咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "28/TALK",
            "narrator": "みやび",
            "text": "今度の当直、まさか\nつばめちゃんが代わる\n言うとは思わなくて。",
            "zh": "这次的值班，我没想到\n燕居然会说\n要替我来换。",
            "narrator_zh": "雅"
        },
        {
            "location": "30/TALK",
            "narrator": "つばめ",
            "text": "ああ、そのことですか。",
            "zh": "啊，是那件事啊。",
            "narrator_zh": "燕"
        },
        {
            "location": "33/TALK",
            "narrator": "みやび",
            "text": "実は、その日はどうしても\n外せん用事があってな。",
            "zh": "其实那天，我有个\n无论如何都推不掉的事咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "34/TALK",
            "narrator": "みやび",
            "text": "正直、どうしようか\n悩んでたちや。",
            "zh": "老实说，我也一直\n在纠结滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "37/TALK",
            "narrator": "みやび",
            "text": "やき、つばめちゃんが\n代わる言うてくれて、\nまっこと助かった。",
            "zh": "所以啵，燕肯替我\n来换班，\n真算帮了大忙。",
            "narrator_zh": "雅"
        },
        {
            "location": "39/TALK",
            "narrator": "みやび",
            "text": "ありがとな。",
            "zh": "谢啦。",
            "narrator_zh": "雅"
        },
        {
            "location": "40/TALK",
            "narrator": "つばめ",
            "text": "そ、そんな！\nお礼なんて良いですから。",
            "zh": "不、不用了！\n不用道谢啦。",
            "narrator_zh": "燕"
        },
        {
            "location": "41/TALK",
            "narrator": "みやび",
            "text": "いや、礼くらい言わせて\nもらえんと、うちの気が\nすまん。",
            "zh": "不，至少让我\n道个谢嘛，不然\n我心里过不去。",
            "narrator_zh": "雅"
        },
        {
            "location": "42/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "44/TALK",
            "narrator": "つばめ",
            "text": "あの…それなら、\nもう一人お礼を言うべき\n人がいまして…。",
            "zh": "那个……要是这样，\n还有一位应该\n道谢的人在……。",
            "narrator_zh": "燕"
        },
        {
            "location": "45/TALK",
            "narrator": "みやび",
            "text": "…もう一人？",
            "zh": "…还有一个？",
            "narrator_zh": "雅"
        },
        {
            "location": "46/TALK",
            "narrator": "つばめ",
            "text": "…$handle$さんです。",
            "zh": "……是$handle$。",
            "narrator_zh": "燕"
        },
        {
            "location": "47/TALK",
            "narrator": "みやび",
            "text": "は？",
            "zh": "啊？",
            "narrator_zh": "雅"
        },
        {
            "location": "48/TALK",
            "narrator": "つばめ",
            "text": "これ、実は口止めされて\nたんですけど――",
            "zh": "这个，其实我被\n封了口——",
            "narrator_zh": "燕"
        },
        {
            "location": "49/TALK",
            "narrator": "つばめ",
            "text": "当直を代わったのって、\n$handle$さんにお願い\nされたからなんです。",
            "zh": "会去换值班，\n是因为$handle$来\n拜托过我。",
            "narrator_zh": "燕"
        },
        {
            "location": "50/TALK",
            "narrator": "つばめ",
            "text": "その日は、みやびさんが\nどうしても外せない用事が\nあるんだ、って…。",
            "zh": "那天雅有件\n无论如何都推不开的\n事，她这么说……。",
            "narrator_zh": "燕"
        },
        {
            "location": "51/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "54/TALK",
            "narrator": "みやび",
            "text": "初耳や。\nそんなこと言われたが？",
            "zh": "头一回听说咯。\n还有人跟你这么讲过咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "55/TALK",
            "narrator": "つばめ",
            "text": "はい…。",
            "zh": "好的……。",
            "narrator_zh": "燕"
        },
        {
            "location": "57/TALK",
            "narrator": "みやび",
            "text": "そうか…。",
            "zh": "是吗……",
            "narrator_zh": "雅"
        },
        {
            "location": "58/TALK",
            "narrator": "みやび",
            "text": "なるほどな…。\n道理でタイミングが\n良過ぎるわけや。",
            "zh": "原来如此……。\n怪不得这时机\n巧得过分咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "61/TALK",
            "narrator": "つばめ",
            "text": "…あの、余計なこと\nしちゃいましたか？",
            "zh": "……那个，我是不是\n多管闲事了？",
            "narrator_zh": "燕"
        },
        {
            "location": "63/TALK",
            "narrator": "みやび",
            "text": "いや、そんなことは\nないぞね。",
            "zh": "不，没\n那么难啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "64/TALK",
            "narrator": "みやび",
            "text": "それより、当直の方は\nまっこと変わってもらって\nえいが？",
            "zh": "比起这个，值班那边\n真的能拜托你\n换一下好咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "68/TALK",
            "narrator": "つばめ",
            "text": "はい！\n大丈夫です！",
            "zh": "好！\n没问题！",
            "narrator_zh": "燕"
        },
        {
            "location": "69/TALK",
            "narrator": "みやび",
            "text": "そうか…。\n改めて、ありがとうな。",
            "zh": "这样啊……。\n再次谢谢你咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "82/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "87/TALK",
            "narrator": "みやび",
            "text": "おい",
            "zh": "喂",
            "narrator_zh": "雅"
        },
        {
            "location": "89/TALK",
            "narrator": "みやび",
            "text": "うちに内緒で勝手なことを",
            "zh": "瞒着我擅自乱来",
            "narrator_zh": "雅"
        },
        {
            "location": "90/TALK",
            "narrator": "みやび",
            "text": "余計なことするな！",
            "zh": "别多管闲事！",
            "narrator_zh": "雅"
        },
        {
            "location": "92/SEL",
            "narrator": "",
            "text": "もう決まったし",
            "zh": "都已经定好了",
            "narrator_zh": ""
        },
        {
            "location": "93/SEL",
            "narrator": "",
            "text": "サプライズ成功！",
            "zh": "惊喜成功！",
            "narrator_zh": ""
        },
        {
            "location": "94/SEL",
            "narrator": "",
            "text": "遠慮しないで",
            "zh": "别客气",
            "narrator_zh": ""
        },
        {
            "location": "95/ACT",
            "narrator": "",
            "text": "もう決まったし",
            "zh": "都已经定好了",
            "narrator_zh": ""
        },
        {
            "location": "96/TALK",
            "narrator": "みやび",
            "text": "勝手に決めよって",
            "zh": "就这么自作主张",
            "narrator_zh": "雅"
        },
        {
            "location": "97/TALK",
            "narrator": "みやび",
            "text": "ハッキリ言っておく",
            "zh": "我把话说清楚",
            "narrator_zh": "雅"
        },
        {
            "location": "98/TALK",
            "narrator": "みやび",
            "text": "こういうズルは好きやない",
            "zh": "这种取巧我不喜欢",
            "narrator_zh": "雅"
        },
        {
            "location": "99/TALK",
            "narrator": "みやび",
            "text": "礼は言わんぞ！",
            "zh": "我可不会道谢咧！",
            "narrator_zh": "雅"
        },
        {
            "location": "100/ACT",
            "narrator": "",
            "text": "サプライズ成功！",
            "zh": "惊喜成功！",
            "narrator_zh": ""
        },
        {
            "location": "101/TALK",
            "narrator": "みやび",
            "text": "そうやね",
            "zh": "是这样咯",
            "narrator_zh": "雅"
        },
        {
            "location": "102/TALK",
            "narrator": "みやび",
            "text": "ハッピーの付かない方",
            "zh": "不带Happy的那个",
            "narrator_zh": "雅"
        },
        {
            "location": "103/TALK",
            "narrator": "みやび",
            "text": "ただのサプライズ",
            "zh": "就是个惊喜嘛",
            "narrator_zh": "雅"
        },
        {
            "location": "104/TALK",
            "narrator": "みやび",
            "text": "いや",
            "zh": "不对",
            "narrator_zh": "雅"
        },
        {
            "location": "105/TALK",
            "narrator": "みやび",
            "text": "限りなくバッドに近い",
            "zh": "无限接近Bad咯",
            "narrator_zh": "雅"
        },
        {
            "location": "106/ACT",
            "narrator": "",
            "text": "遠慮しないで",
            "zh": "别客气",
            "narrator_zh": ""
        },
        {
            "location": "107/TALK",
            "narrator": "みやび",
            "text": "おまえが言うな！",
            "zh": "轮不到你说！",
            "narrator_zh": "雅"
        },
        {
            "location": "108/TALK",
            "narrator": "みやび",
            "text": "それはつばめちゃんのセリフや",
            "zh": "那是燕的台词咯",
            "narrator_zh": "雅"
        },
        {
            "location": "109/TALK",
            "narrator": "みやび",
            "text": "呆れるほどの図々しさやね",
            "zh": "脸皮厚得让人无语咯",
            "narrator_zh": "雅"
        },
        {
            "location": "112/SEL",
            "narrator": "",
            "text": "余計なことしてごめん…",
            "zh": "多此一举，抱歉……",
            "narrator_zh": ""
        },
        {
            "location": "113/ACT",
            "narrator": "",
            "text": "余計なことしてごめん…",
            "zh": "多此一举，抱歉……",
            "narrator_zh": ""
        },
        {
            "location": "116/TALK",
            "narrator": "みやび",
            "text": "まあ",
            "zh": "嗯",
            "narrator_zh": "雅"
        },
        {
            "location": "117/TALK",
            "narrator": "みやび",
            "text": "当直がなくなって助かったのは事実や",
            "zh": "不用值班算我走运，这也是实话咯",
            "narrator_zh": "雅"
        },
        {
            "location": "118/TALK",
            "narrator": "みやび",
            "text": "実際困ってたのも事実",
            "zh": "实际上确实也很为难",
            "narrator_zh": "雅"
        },
        {
            "location": "119/TALK",
            "narrator": "みやび",
            "text": "そういうことだ",
            "zh": "就是这么回事",
            "narrator_zh": "雅"
        },
        {
            "location": "120/TALK",
            "narrator": "みやび",
            "text": "まあ",
            "zh": "嗯",
            "narrator_zh": "雅"
        },
        {
            "location": "122/TALK",
            "narrator": "みやび",
            "text": "休みに罪はない",
            "zh": "休息又没有罪",
            "narrator_zh": "雅"
        },
        {
            "location": "123/TALK",
            "narrator": "みやび",
            "text": "遠慮なく使わせてもらうちや！",
            "zh": "那我就不客气地用滴！",
            "narrator_zh": "雅"
        },
        {
            "location": "17/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>某月某日　 6:10 PM</color>\nとある平日、寮「とらいあんぐる」つばめの部屋にて",
            "zh": "<color=green>某月某日　 6:10 PM</color>\n某个平日，宿舍「Triangle」燕的房间里。",
            "narrator_zh": "Dialog_EventData"
        }
    ]
}
