    "entry": [
        {
            "location": "902/SCENARIO",
            "narrator": "",
            "text": "CY敵（ガブちゃん）",
            "zh": "CY敌人（加布）",
            "narrator_zh": ""
        },
        {
            "location": "909/SEL",
            "narrator": "",
            "text": "あける",
            "zh": "打开",
            "narrator_zh": ""
        },
        {
            "location": "910/SEL",
            "narrator": "",
            "text": "あけない",
            "zh": "不打开",
            "narrator_zh": ""
        },
        {
            "location": "911/ACT",
            "narrator": "",
            "text": "あける",
            "zh": "打开",
            "narrator_zh": ""
        },
        {
            "location": "912/ACT",
            "narrator": "",
            "text": "あけない",
            "zh": "不打开",
            "narrator_zh": ""
        },
        {
            "location": "913/TALK",
            "narrator": "千羽鶴",
            "text": "じゃあ私がもらう。",
            "zh": "那我就收下了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "937/TALK",
            "narrator": "ガブリエラ",
            "text": "呼ばれて飛び出て\nじゃじゃじゃじゃーん！",
            "zh": "被叫一声就飞身登场，\n铛铛铛铛——！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "938/TALK",
            "narrator": "ガブリエラ",
            "text": "欲の皮が突っ張って\n宝箱を開るなんて\n愚かな人たちね！",
            "zh": "贪得无厌还去开宝箱，\n真是一群\n愚蠢的家伙呢！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "939/SEL",
            "narrator": "",
            "text": "宝箱に入ってるなんてかわいい！",
            "zh": "宝箱里待着什么的，好可爱！",
            "narrator_zh": ""
        },
        {
            "location": "940/SEL",
            "narrator": "",
            "text": "欲の皮突っ張ってたわけじゃないよ！",
            "zh": "我又不是贪心才开的！",
            "narrator_zh": ""
        },
        {
            "location": "941/ACT",
            "narrator": "",
            "text": "宝箱に入ってるなんてかわいい！",
            "zh": "宝箱里待着什么的，好可爱！",
            "narrator_zh": ""
        },
        {
            "location": "942/TALK",
            "narrator": "ガブリエラ",
            "text": "人のこと\n小さい言うな！",
            "zh": "谁说我\n小了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "943/TALK",
            "narrator": "千羽鶴",
            "text": "小さいとは\n言ってないけど。",
            "zh": "倒也没有\n说你小。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "944/ACT",
            "narrator": "",
            "text": "欲の皮突っ張ってたわけじゃないよ！",
            "zh": "我又不是贪心才开的！",
            "narrator_zh": ""
        },
        {
            "location": "945/TALK",
            "narrator": "ガブリエラ",
            "text": "口だけなら\n何とでも言えるわよね。",
            "zh": "光靠一张嘴，\n什么都能说嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "947/TALK",
            "narrator": "ガブリエラ",
            "text": "そんな減らず口叩いて\nいられるのもいまのうち。",
            "zh": "你们能这么嘴硬，\n也就趁现在了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "948/TALK",
            "narrator": "ガブリエラ",
            "text": "今からあたしが\nあんたたちの身ぐるみを\n剥いであげるんだから！",
            "zh": "接下来我可是会把你们\n从头到脚\n扒个精光的！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "949/SEL",
            "narrator": "",
            "text": "そうはさせるか！",
            "zh": "才不会让你得逞！",
            "narrator_zh": ""
        },
        {
            "location": "950/SEL",
            "narrator": "",
            "text": "自分から脱ぎます！",
            "zh": "我自己脱！",
            "narrator_zh": ""
        },
        {
            "location": "951/ACT",
            "narrator": "",
            "text": "そうはさせるか！",
            "zh": "才不会让你得逞！",
            "narrator_zh": ""
        },
        {
            "location": "952/TALK",
            "narrator": "ガブリエラ",
            "text": "ふーん、どうするの？\nいっておくけど、\nあたしは強いわよ？",
            "zh": "哦——，你打算怎么办？\n先说好，\n我可是很强的哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "954/TALK",
            "narrator": "千羽鶴",
            "text": "この子の言う通り。\n彼女はこけしのギャヴィ。",
            "zh": "这孩子说得没错。\n她是木芥子的加维。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "955/TALK",
            "narrator": "千羽鶴",
            "text": "その名の通り、\n１０ｋｍ先のこけしを\n打ち抜くことができる。",
            "zh": "如其名所示，\n能击穿１０ｋｍ外的\n木芥子。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "957/TALK",
            "narrator": "千羽鶴",
            "text": "決して逃げられない。",
            "zh": "绝对逃不掉的。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "958/TALK",
            "narrator": "ガブリエラ",
            "text": "その通りよ。\n早速今から実演して\nあげるわね！",
            "zh": "没错。\n现在就演示\n给你们看！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "959/TALK",
            "narrator": "ガブリエラ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "961/TALK",
            "narrator": "ガブリエラ",
            "text": "あら。これじゃないわ。",
            "zh": "哎呀。不是这个啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "962/TALK",
            "narrator": "ガブリエラ",
            "text": "…ない……",
            "zh": "……没了……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "963/TALK",
            "narrator": "ガブリエラ",
            "text": "ない！！\nあたしの大切な\nこけしが無いわ！",
            "zh": "没了！！\n我宝贵的\n木芥子不见了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "965/SEL",
            "narrator": "",
            "text": "こけしってこれ？",
            "zh": "木芥子是这个？",
            "narrator_zh": ""
        },
        {
            "location": "966/ACT",
            "narrator": "",
            "text": "こけしってこれ？",
            "zh": "木芥子是这个？",
            "narrator_zh": ""
        },
        {
            "location": "970/TALK",
            "narrator": "ガブリエラ",
            "text": "ああっ！\nそうよ、それよ！",
            "zh": "啊啊！\n对，就是那个！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "971/TALK",
            "narrator": "ガブリエラ",
            "text": "どこにあったの！？",
            "zh": "在哪里找到的！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "972/TALK",
            "narrator": "千羽鶴",
            "text": "道端に落ちてた。",
            "zh": "掉在路边了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "973/TALK",
            "narrator": "ガブリエラ",
            "text": "ありがとう！\nありがとう！！",
            "zh": "谢谢！\n谢谢！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "974/TALK",
            "narrator": "ガブリエラ",
            "text": "あんたたちは\n心の友よ！",
            "zh": "你们可是我的\n知心好友！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "975/TALK",
            "narrator": "ガブリエラ",
            "text": "お礼にここを\n通してあげる！",
            "zh": "作为答谢，\n放你们过去！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "976/TALK",
            "narrator": "ガブリエラ",
            "text": "それじゃ、またね！",
            "zh": "那么，再见啦！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "979/SEL",
            "narrator": "",
            "text": "ここってガブリエラの私有地？",
            "zh": "这里是加布里埃拉的私有地？",
            "narrator_zh": ""
        },
        {
            "location": "980/ACT",
            "narrator": "",
            "text": "ここってガブリエラの私有地？",
            "zh": "这里是加布里埃拉的私有地？",
            "narrator_zh": ""
        },
        {
            "location": "982/TALK",
            "narrator": "千羽鶴",
            "text": "いいえ。",
            "zh": "不是。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "984/TALK",
            "narrator": "千羽鶴",
            "text": "まあそんな\nどうでもいい事より、\n先を急ぎましょ。",
            "zh": "比起那种无所谓的事，\n还是先\n赶路吧。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "996/SEL",
            "narrator": "",
            "text": "今のうちに逃げよう！",
            "zh": "趁现在逃吧！",
            "narrator_zh": ""
        },
        {
            "location": "997/ACT",
            "narrator": "",
            "text": "今のうちに逃げよう！",
            "zh": "趁现在逃吧！",
            "narrator_zh": ""
        },
        {
            "location": "999/TALK",
            "narrator": "千羽鶴",
            "text": "そうね。\n今なら上手く\n逃げられるかも。",
            "zh": "也是。\n趁现在也许\n能顺利逃掉。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1001/TALK",
            "narrator": "ガブリエラ",
            "text": "ああっ！\nこらーっ！",
            "zh": "啊啊！\n喂——！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1002/TALK",
            "narrator": "ガブリエラ",
            "text": "逃がさないわよ！",
            "zh": "不会让你们跑的！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1012/ACT",
            "narrator": "",
            "text": "自分から脱ぎます！",
            "zh": "我自己脱！",
            "narrator_zh": ""
        },
        {
            "location": "1013/TALK",
            "narrator": "ガブリエラ",
            "text": "きゃあああっ！",
            "zh": "呀啊啊啊！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "1015/TALK",
            "narrator": "ガブリエラ",
            "text": "変態よ！\n変態がいるわ！",
            "zh": "变态！\n有变态啊！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "908/DIALOG",
            "narrator": "INFO",
            "text": "宝箱を見つけた！",
            "zh": "发现了宝箱！",
            "narrator_zh": "INFO"
        },
        {
            "location": "919/DIALOG",
            "narrator": "NOTICE",
            "text": "宝箱はミミックだった！",
            "zh": "宝箱是宝箱怪！",
            "narrator_zh": "NOTICE"
        },
        {
            "location": "969/DIALOG",
            "narrator": "INFO",
            "text": "こけしのギャヴィに\n『こけし』を渡した！",
            "zh": "把『木芥子』交给了\n木芥子的加维！",
            "narrator_zh": "INFO"
        },
        {
            "location": "1006/DIALOG",
            "narrator": "INFO",
            "text": "千羽鶴にヒット！\n千羽鶴は\n10000ポイントのダメージ",
            "zh": "命中千羽鹤！\n千羽鹤受到\n10000点伤害",
            "narrator_zh": "INFO"
        },
        {
            "location": "1008/DIALOG",
            "narrator": "INFO",
            "text": "千羽鶴は\n死んでしまった。",
            "zh": "千羽鹤\n死掉了。",
            "narrator_zh": "INFO"
        },
        {
            "location": "1019/DIALOG",
            "narrator": "INFO",
            "text": "あなたは\nしにました。",
            "zh": "你\n死了。",
            "narrator_zh": "INFO"
        }
    ]
}
