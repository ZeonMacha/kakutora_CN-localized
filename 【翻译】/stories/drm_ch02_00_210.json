{
    "dir": "dramatics/daydra/drm_ch02_00_210.js",
    "type": "Episode",
    "info": {
        "story_id": "2021",
        "cid": "ayami",
        "title": "らぶとーく 第21話",
        "sub_title": "霧の中の距離",
        "title_zh": "恋爱漫谈 第21话",
        "sub_title_zh": "雾中的距离"
    },
    "entry": [
        {
            "location": "284/SCENARIO",
            "narrator": "",
            "text": "霧の中の距離",
            "zh": "雾中的距离",
            "narrator_zh": ""
        },
        {
            "location": "294/TALK",
            "narrator": "真幌",
            "text": "…それにしても\n客が来ないな。",
            "zh": "……话说回来\n客人也不来啊。",
            "narrator_zh": "真幌"
        },
        {
            "location": "297/TALK",
            "narrator": "アーヤ",
            "text": "プログラム\n変えてみますか？",
            "zh": "排片\n要不要改一改？",
            "narrator_zh": "绫水"
        },
        {
            "location": "299/TALK",
            "narrator": "真幌",
            "text": "…正直、それで\n動員数が見込める\nわけではない。",
            "zh": "……老实说，光靠那个\n也指望不上\n动员人数。",
            "narrator_zh": "真幌"
        },
        {
            "location": "300/TALK",
            "narrator": "真幌",
            "text": "特にうちみたいな\n形態の映画館は。",
            "zh": "尤其是我们这种\n形态的电影院。",
            "narrator_zh": "真幌"
        },
        {
            "location": "301/TALK",
            "narrator": "真幌",
            "text": "建物が好きな人が\n来るだけの場所に\nなっているからな。",
            "zh": "已经变成只有\n喜欢这栋建筑的人\n才会来的地方了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "302/TALK",
            "narrator": "真幌",
            "text": "それに、下手に\n人が来るようになると\n支障も出るしな。",
            "zh": "而且，要是让外人\n随便过来，\n也会有妨碍。",
            "narrator_zh": "真幌"
        },
        {
            "location": "304/TALK",
            "narrator": "アーヤ",
            "text": "…そうですよね。",
            "zh": "……是啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "305/TALK",
            "narrator": "真幌",
            "text": "ところで。",
            "zh": "对了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "306/TALK",
            "narrator": "アーヤ",
            "text": "はい。",
            "zh": "是。",
            "narrator_zh": "绫水"
        },
        {
            "location": "307/TALK",
            "narrator": "真幌",
            "text": "この前Ｂｏｔが\nどうとか言っていたのは\n解決したのか？",
            "zh": "之前你说的Bot\n怎么样之类的事，\n解决了吗？",
            "narrator_zh": "真幌"
        },
        {
            "location": "309/TALK",
            "narrator": "アーヤ",
            "text": "……ええ、まあ。",
            "zh": "……嗯，算是。",
            "narrator_zh": "绫水"
        },
        {
            "location": "310/TALK",
            "narrator": "真幌",
            "text": "…………。\nならいいんだが。",
            "zh": "…………。\n那就好。",
            "narrator_zh": "真幌"
        },
        {
            "location": "311/TALK",
            "narrator": "真幌",
            "text": "他に困ったことは\nないか？",
            "zh": "另外还有\n为难的事吗？",
            "narrator_zh": "真幌"
        },
        {
            "location": "313/TALK",
            "narrator": "アーヤ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "315/TALK",
            "narrator": "アーヤ",
            "text": "……実は……。",
            "zh": "……其实……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "317/TALK",
            "narrator": "アーヤ",
            "text": "人のちょっとした\n秘密を\n知ってしまって。",
            "zh": "不小心知道了\n别人一点\n小秘密。",
            "narrator_zh": "绫水"
        },
        {
            "location": "318/TALK",
            "narrator": "アーヤ",
            "text": "その後どうやって\n接すればいいのか\n悩んでるんです。",
            "zh": "之后该怎么相处，\n我正为此\n苦恼。",
            "narrator_zh": "绫水"
        },
        {
            "location": "319/TALK",
            "narrator": "真幌",
            "text": "詳しく聞く…\nわけには\nいかないんだろうな。",
            "zh": "详细的事……\n也不好\n问吧。",
            "narrator_zh": "真幌"
        },
        {
            "location": "320/TALK",
            "narrator": "真幌",
            "text": "そのことは\n相手は\n気づいているのか？",
            "zh": "这件事\n对方\n察觉到了吗？",
            "narrator_zh": "真幌"
        },
        {
            "location": "323/TALK",
            "narrator": "アーヤ",
            "text": "はい。そして\n今まで通りに\n接して欲しいと。",
            "zh": "是的。而且\n希望我还像以前那样\n相处。",
            "narrator_zh": "绫水"
        },
        {
            "location": "324/TALK",
            "narrator": "アーヤ",
            "text": "でも私には\nそれが難しくて。",
            "zh": "但我很难\n做到。",
            "narrator_zh": "绫水"
        },
        {
            "location": "325/TALK",
            "narrator": "真幌",
            "text": "なるほど…。",
            "zh": "原来如此……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "327/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "328/TALK",
            "narrator": "真幌",
            "text": "秘密を知ったのが\n故意か過失かは\n知らないが。",
            "zh": "知道秘密是故意\n还是无意，\n我不知道。",
            "narrator_zh": "真幌"
        },
        {
            "location": "329/TALK",
            "narrator": "真幌",
            "text": "相手が今まで通りと\n言っているのなら。",
            "zh": "既然对方说\n照旧就好。",
            "narrator_zh": "真幌"
        },
        {
            "location": "330/TALK",
            "narrator": "真幌",
            "text": "それでいいんじゃ\nないか？",
            "zh": "这样不\n好吗？",
            "narrator_zh": "真幌"
        },
        {
            "location": "331/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "332/TALK",
            "narrator": "真幌",
            "text": "そう簡単には\nいかないか。",
            "zh": "没那么简单\n吗。",
            "narrator_zh": "真幌"
        },
        {
            "location": "333/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "334/TALK",
            "narrator": "真幌",
            "text": "また仲良くできると\nいいな。",
            "zh": "要是还能好好相处\n就好了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "337/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "349/TALK",
            "narrator": "アーヤ",
            "text": "いる？",
            "zh": "在吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "350/TALK",
            "narrator": "アーヤ",
            "text": "って",
            "zh": "话说",
            "narrator_zh": "绫水"
        },
        {
            "location": "352/SEL",
            "narrator": "",
            "text": "いるよ！",
            "zh": "在啊！",
            "narrator_zh": ""
        },
        {
            "location": "353/SEL",
            "narrator": "",
            "text": "今日もかわいいね、アーヤ",
            "zh": "今天也很可爱呢，绫水",
            "narrator_zh": ""
        },
        {
            "location": "354/SEL",
            "narrator": "",
            "text": "待ってました！",
            "zh": "等好久了！",
            "narrator_zh": ""
        },
        {
            "location": "355/ACT",
            "narrator": "",
            "text": "いるよ！",
            "zh": "在啊！",
            "narrator_zh": ""
        },
        {
            "location": "356/TALK",
            "narrator": "アーヤ",
            "text": "なんなのかしら",
            "zh": "这算什么",
            "narrator_zh": "绫水"
        },
        {
            "location": "357/TALK",
            "narrator": "アーヤ",
            "text": "そのテンション",
            "zh": "那股劲头",
            "narrator_zh": "绫水"
        },
        {
            "location": "358/ACT",
            "narrator": "",
            "text": "今日もかわいいね、アーヤ",
            "zh": "今天也很可爱呢，绫水",
            "narrator_zh": ""
        },
        {
            "location": "359/TALK",
            "narrator": "アーヤ",
            "text": "本当に",
            "zh": "真的",
            "narrator_zh": "绫水"
        },
        {
            "location": "360/TALK",
            "narrator": "アーヤ",
            "text": "いつも通りね",
            "zh": "和平常一样",
            "narrator_zh": "绫水"
        },
        {
            "location": "361/ACT",
            "narrator": "",
            "text": "待ってました！",
            "zh": "等好久了！",
            "narrator_zh": ""
        },
        {
            "location": "362/TALK",
            "narrator": "アーヤ",
            "text": "あら",
            "zh": "哦",
            "narrator_zh": "绫水"
        },
        {
            "location": "363/TALK",
            "narrator": "アーヤ",
            "text": "待っててくれたの",
            "zh": "你在等我啊",
            "narrator_zh": "绫水"
        },
        {
            "location": "365/TALK",
            "narrator": "アーヤ",
            "text": "でも",
            "zh": "不过",
            "narrator_zh": "绫水"
        },
        {
            "location": "366/TALK",
            "narrator": "アーヤ",
            "text": "やっぱり",
            "zh": "果然",
            "narrator_zh": "绫水"
        },
        {
            "location": "367/TALK",
            "narrator": "アーヤ",
            "text": "今日はいいわ",
            "zh": "今天就免了吧",
            "narrator_zh": "绫水"
        },
        {
            "location": "370/SEL",
            "narrator": "",
            "text": "残念",
            "zh": "可惜",
            "narrator_zh": ""
        },
        {
            "location": "371/SEL",
            "narrator": "",
            "text": "ずっと待ってるから",
            "zh": "我会一直等着",
            "narrator_zh": ""
        },
        {
            "location": "372/SEL",
            "narrator": "",
            "text": "$me$だって忙しいのに",
            "zh": "$me$明明也很忙",
            "narrator_zh": ""
        },
        {
            "location": "373/ACT",
            "narrator": "",
            "text": "残念",
            "zh": "可惜",
            "narrator_zh": ""
        },
        {
            "location": "374/TALK",
            "narrator": "アーヤ",
            "text": "考えが",
            "zh": "想法",
            "narrator_zh": "绫水"
        },
        {
            "location": "375/TALK",
            "narrator": "アーヤ",
            "text": "まだ",
            "zh": "还",
            "narrator_zh": "绫水"
        },
        {
            "location": "376/TALK",
            "narrator": "アーヤ",
            "text": "まとまらないのよ",
            "zh": "整理不拢",
            "narrator_zh": "绫水"
        },
        {
            "location": "377/ACT",
            "narrator": "",
            "text": "ずっと待ってるから",
            "zh": "我会一直等着",
            "narrator_zh": ""
        },
        {
            "location": "378/TALK",
            "narrator": "アーヤ",
            "text": "、、、",
            "zh": "、、、",
            "narrator_zh": "绫水"
        },
        {
            "location": "379/TALK",
            "narrator": "アーヤ",
            "text": "そうなの",
            "zh": "对",
            "narrator_zh": "绫水"
        },
        {
            "location": "380/TALK",
            "narrator": "アーヤ",
            "text": "ううん",
            "zh": "不是的",
            "narrator_zh": "绫水"
        },
        {
            "location": "381/TALK",
            "narrator": "アーヤ",
            "text": "なんでもない",
            "zh": "没什么",
            "narrator_zh": "绫水"
        },
        {
            "location": "382/ACT",
            "narrator": "",
            "text": "$me$だって忙しいのに",
            "zh": "$me$明明也很忙",
            "narrator_zh": ""
        },
        {
            "location": "383/TALK",
            "narrator": "アーヤ",
            "text": "それは",
            "zh": "这个",
            "narrator_zh": "绫水"
        },
        {
            "location": "384/TALK",
            "narrator": "アーヤ",
            "text": "悪かったわ",
            "zh": "是我不好",
            "narrator_zh": "绫水"
        },
        {
            "location": "385/TALK",
            "narrator": "アーヤ",
            "text": "ごめんね！",
            "zh": "抱歉！",
            "narrator_zh": "绫水"
        },
        {
            "location": "398/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "410/TALK",
            "narrator": "アーヤ",
            "text": "ちょっと質問",
            "zh": "稍微问一下",
            "narrator_zh": "绫水"
        },
        {
            "location": "411/TALK",
            "narrator": "アーヤ",
            "text": "たいしたことじゃないけど",
            "zh": "也不是什么大事，不过",
            "narrator_zh": "绫水"
        },
        {
            "location": "414/TALK",
            "narrator": "ボイスメール",
            "text": "気持ちヘクトパスカル",
            "zh": "心情百帕",
            "narrator_zh": "语音信箱"
        },
        {
            "location": "426/DIALOG",
            "narrator": "Dialog_GETVoice",
            "text": "<color=green>【アーヤ】</color>のボイスメール\n<color=red>【気持ちヘクトパスカル】</color>\nをゲットしました！",
            "zh": "<color=green>【绫水】</color>的语音信箱\n<color=red>【心情百帕】</color>\n已入手！",
            "narrator_zh": "Dialog_GETVoice"
        }
    ]
}
