            "narrator_zh": ""
        },
        {
            "location": "1270/TALK",
            "narrator": "みやび",
            "text": "微妙ゆう問題に目を瞑る必要はあるけんどね",
            "zh": "但是对『微妙』的问题，有时候就得睁只眼闭只眼嘛",
            "narrator_zh": "雅"
        },
        {
            "location": "1272/ACT",
            "narrator": "",
            "text": "微妙ならやめようよ",
            "zh": "觉得微妙的话就算了吧",
            "narrator_zh": ""
        },
        {
            "location": "1273/TALK",
            "narrator": "みやび",
            "text": "完璧なんぞ存在せん！",
