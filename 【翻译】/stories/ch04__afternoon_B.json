            "narrator_zh": "雅"
        },
        {
            "location": "1274/TALK",
            "narrator": "みやび",
            "text": "なんてな、とにかくやめよう",
            "zh": "骗你的啦，总之这件算了吧",
            "narrator_zh": "雅"
        },
        {
            "location": "1277/TALK",
            "narrator": "みやび",
            "text": "あーそれでえいよ",
