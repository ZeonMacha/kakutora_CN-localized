{
    "dir": "dramatics/daydra/drm_ch03_00_670.js",
    "type": "Episode",
    "info": {
        "story_id": "3067",
        "cid": "gabriella",
        "title": "らぶとーく  第68話",
        "sub_title": "身の程知らず",
        "title_zh": "恋爱漫谈 第68话",
        "sub_title_zh": "不知天高地厚"
    },
    "entry": [
        {
            "location": "167/SCENARIO",
            "narrator": "",
            "text": "身の程知らず",
            "zh": "不知天高地厚",
            "narrator_zh": ""
        },
        {
            "location": "185/TALK",
            "narrator": "先生",
            "text": "ガブリエラさん。\nちょっといいかしら？",
            "zh": "加布里埃拉。\n能占用你一下吗？",
            "narrator_zh": "老师"
        },
        {
            "location": "187/TALK",
            "narrator": "ガブリエラ",
            "text": "はい、何ですか？",
            "zh": "好的，什么事？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "188/TALK",
            "narrator": "先生",
            "text": "あなたの書いた詩、\n読ませてもらったわ。",
            "zh": "你写的诗，\n我读过了。",
            "narrator_zh": "老师"
        },
        {
            "location": "189/TALK",
            "narrator": "ガブリエラ",
            "text": "ああ、授業で提出した\nやつですか？",
            "zh": "啊，是课堂上交的\n那份吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "190/TALK",
            "narrator": "先生",
            "text": "ええ。",
            "zh": "嗯。",
            "narrator_zh": "老师"
        },
        {
            "location": "191/TALK",
            "narrator": "先生",
            "text": "正直、凄く驚いたわ。",
            "zh": "说实话，我非常惊讶。",
            "narrator_zh": "老师"
        },
        {
            "location": "192/TALK",
            "narrator": "先生",
            "text": "今まで色んな生徒が\n書いた詩を見てきた\nけど――",
            "zh": "至今我看过\n各种学生写的诗，\n但是——",
            "narrator_zh": "老师"
        },
        {
            "location": "193/TALK",
            "narrator": "先生",
            "text": "あんなに素晴らしい詩を\n読んだのは初めてだった\nから。",
            "zh": "读到那么出色的诗\n还是头一次，\n所以。",
            "narrator_zh": "老师"
        },
        {
            "location": "195/TALK",
            "narrator": "ガブリエラ",
            "text": "えっ…そ、そうですか？",
            "zh": "诶……是、是吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "196/TALK",
            "narrator": "先生",
            "text": "ええ、\n本当に良かったわ。",
            "zh": "是的，\n真的写得太好了。",
            "narrator_zh": "老师"
        },
        {
            "location": "197/TALK",
            "narrator": "先生",
            "text": "あんなに素敵なのが\n読めるなら――",
            "zh": "既然能写出\n那么动人的诗——",
            "narrator_zh": "老师"
        },
        {
            "location": "198/TALK",
            "narrator": "先生",
            "text": "次の宿題も、詩の作成に\nしちゃおうかしら？",
            "zh": "下次的作业，\n要不要也改成写诗呢？",
            "narrator_zh": "老师"
        },
        {
            "location": "201/TALK",
            "narrator": "ガブリエラ",
            "text": "そ、それはちょっと…\nあたしも詩を作るのに\n慣れてませんし…。",
            "zh": "那、那有点……\n我写诗也\n不太习惯……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "202/TALK",
            "narrator": "先生",
            "text": "ふふっ、冗談よ。",
            "zh": "呵呵，开玩笑的。",
            "narrator_zh": "老师"
        },
        {
            "location": "203/TALK",
            "narrator": "先生",
            "text": "とにかく、本当に\n素敵な詩だったわ。",
            "zh": "总之，真是一首\n很美的诗哦。",
            "narrator_zh": "老师"
        },
        {
            "location": "204/TALK",
            "narrator": "先生",
            "text": "もし他にも書くことが\nあったら――",
            "zh": "要是还写了\n别的什么——",
            "narrator_zh": "老师"
        },
        {
            "location": "205/TALK",
            "narrator": "先生",
            "text": "その時は先生にも\n読ませてね。",
            "zh": "那时候也让老师\n读一读吧。",
            "narrator_zh": "老师"
        },
        {
            "location": "207/SEL",
            "narrator": "",
            "text": "おーい",
            "zh": "喂——",
            "narrator_zh": ""
        },
        {
            "location": "212/ACT",
            "narrator": "",
            "text": "おーい",
            "zh": "喂——",
            "narrator_zh": ""
        },
        {
            "location": "220/TALK",
            "narrator": "ガブリエラ",
            "text": "聞いてたの？",
            "zh": "你在听？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "222/SEL",
            "narrator": "",
            "text": "やったね",
            "zh": "太好了",
            "narrator_zh": ""
        },
        {
            "location": "223/SEL",
            "narrator": "",
            "text": "褒め上手な先生だね",
            "zh": "是个很会夸人的老师呢",
            "narrator_zh": ""
        },
        {
            "location": "224/SEL",
            "narrator": "",
            "text": "もっと書いてみれば",
            "zh": "再多写写看嘛",
            "narrator_zh": ""
        },
        {
            "location": "225/ACT",
            "narrator": "",
            "text": "やったね",
            "zh": "太好了",
            "narrator_zh": ""
        },
        {
            "location": "226/TALK",
            "narrator": "ガブリエラ",
            "text": "別に",
            "zh": "无所谓",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "227/TALK",
            "narrator": "ガブリエラ",
            "text": "日本語で詩が書けるなんて凄いってことでしょ？",
            "zh": "是说「能用日语写诗就很厉害」那种吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "228/TALK",
            "narrator": "ガブリエラ",
            "text": "喜ぶようなことじゃないわ",
            "zh": "不是值得高兴的事哦",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "230/SEL",
            "narrator": "",
            "text": "そんな感じじゃなかったよ",
            "zh": "不是那种感觉哦",
            "narrator_zh": ""
        },
        {
            "location": "231/ACT",
            "narrator": "",
            "text": "そんな感じじゃなかったよ",
            "zh": "不是那种感觉哦",
            "narrator_zh": ""
        },
        {
            "location": "233/TALK",
            "narrator": "ガブリエラ",
            "text": "じゃあお世辞ね",
            "zh": "那就是客套话咯",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "234/TALK",
            "narrator": "ガブリエラ",
            "text": "そうとしか思えないわ",
            "zh": "我只能那么想",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "236/SEL",
            "narrator": "",
            "text": "素直になりなよ",
            "zh": "坦率一点嘛",
            "narrator_zh": ""
        },
        {
            "location": "237/ACT",
            "narrator": "",
            "text": "素直になりなよ",
            "zh": "坦率一点嘛",
            "narrator_zh": ""
        },
        {
            "location": "239/TALK",
            "narrator": "ガブリエラ",
            "text": "何よそれ？",
            "zh": "那是什么话？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "240/TALK",
            "narrator": "ガブリエラ",
            "text": "私が素直じゃないって言うの！？",
            "zh": "你说我不够坦率！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "241/TALK",
            "narrator": "ガブリエラ",
            "text": "私はいつだって素直よ",
            "zh": "我一直都坦率得很呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "242/TALK",
            "narrator": "ガブリエラ",
            "text": "$handle$だってわかってるでしょ？",
            "zh": "$handle$你也知道的吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "244/SEL",
            "narrator": "",
            "text": "$me$は凄い嬉しいよ",
            "zh": "$me$真的特别开心",
            "narrator_zh": ""
        },
        {
            "location": "245/ACT",
            "narrator": "",
            "text": "$me$は凄い嬉しいよ",
            "zh": "$me$真的特别开心",
            "narrator_zh": ""
        },
        {
            "location": "247/TALK",
            "narrator": "ガブリエラ",
            "text": "そうなの？",
            "zh": "是吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "248/TALK",
            "narrator": "ガブリエラ",
            "text": "そっか",
            "zh": "这样啊",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "249/TALK",
            "narrator": "ガブリエラ",
            "text": "$handle$は嬉しいって思ってくれるのね",
            "zh": "原来$handle$会觉得高兴呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "250/TALK",
            "narrator": "ガブリエラ",
            "text": "それならまあ",
            "zh": "那样的话嘛",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "251/TALK",
            "narrator": "ガブリエラ",
            "text": "私も少しくらいは嬉しいと思ってもいいわ",
            "zh": "那我也可以觉得稍微有点开心",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "252/TALK",
            "narrator": "ガブリエラ",
            "text": "本当に少しだけね",
            "zh": "真的只有一点点哦",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "253/ACT",
            "narrator": "",
            "text": "褒め上手な先生だね",
            "zh": "是个很会夸人的老师呢",
            "narrator_zh": ""
        },
        {
            "location": "254/TALK",
            "narrator": "ガブリエラ",
            "text": "何でそうなるのよ？",
            "zh": "怎么会变成这样啊？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "256/TALK",
            "narrator": "ガブリエラ",
            "text": "どう考えても私の詩に感動してたじゃない！",
            "zh": "怎么想你都被我的诗打动了吧！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "257/TALK",
            "narrator": "ガブリエラ",
            "text": "私の詩は本当に出来が良かったのよ",
            "zh": "我的诗真的写得很不错哦",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "258/TALK",
            "narrator": "ガブリエラ",
            "text": "…多分",
            "zh": "……大概",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "259/TALK",
            "narrator": "ガブリエラ",
            "text": "でも",
            "zh": "不过",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "260/TALK",
            "narrator": "ガブリエラ",
            "text": "やっぱり、褒め上手なだけなのかしら？",
            "zh": "果然只是因为老师擅长夸人吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "262/SEL",
            "narrator": "",
            "text": "冗談だよ、もっと自信持って",
            "zh": "开玩笑的，你自信点",
            "narrator_zh": ""
        },
        {
            "location": "263/ACT",
            "narrator": "",
            "text": "冗談だよ、もっと自信持って",
            "zh": "开玩笑的，你自信点",
            "narrator_zh": ""
        },
        {
            "location": "265/TALK",
            "narrator": "ガブリエラ",
            "text": "$handle$は冗談のセンスがないわ",
            "zh": "$handle$真没幽默感",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "266/TALK",
            "narrator": "ガブリエラ",
            "text": "っていうかイジワル？",
            "zh": "话说，你是故意的？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "268/SEL",
            "narrator": "",
            "text": "ごめん",
            "zh": "抱歉",
            "narrator_zh": ""
        },
        {
            "location": "269/ACT",
            "narrator": "",
            "text": "ごめん",
            "zh": "抱歉",
            "narrator_zh": ""
        },
        {
            "location": "271/TALK",
            "narrator": "ガブリエラ",
            "text": "冗談よ",
            "zh": "开玩笑的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "273/TALK",
            "narrator": "ガブリエラ",
            "text": "まあ、$handle$の言う通り",
            "zh": "算了，$handle$说得也对",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "274/TALK",
            "narrator": "ガブリエラ",
            "text": "少し自信を持った方がいいかもしれないわね",
            "zh": "我或许也该稍微自信一点呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "275/ACT",
            "narrator": "",
            "text": "もっと書いてみれば",
            "zh": "再多写写看嘛",
            "narrator_zh": ""
        },
        {
            "location": "276/TALK",
            "narrator": "ガブリエラ",
            "text": "言われなくても書くわよ",
            "zh": "不用你说我也会写的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "277/TALK",
            "narrator": "ガブリエラ",
            "text": "詩は得意じゃないから",
            "zh": "毕竟诗不是我的强项",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "278/TALK",
            "narrator": "ガブリエラ",
            "text": "もっと勉強しようと思ってたし",
            "zh": "我本来就想着要多学习呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "280/SEL",
            "narrator": "",
            "text": "$me$も読んでみたいな",
            "zh": "$me$也想读读看",
            "narrator_zh": ""
        },
        {
            "location": "281/ACT",
            "narrator": "",
            "text": "$me$も読んでみたいな",
            "zh": "$me$也想读读看",
            "narrator_zh": ""
        },
        {
            "location": "283/TALK",
            "narrator": "ガブリエラ",
            "text": "調子いいんだから",
            "zh": "你还真是顺杆爬呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "284/TALK",
            "narrator": "ガブリエラ",
            "text": "勉強中だから見せられるようなものじゃないし",
            "zh": "还在学习中，拿不出能见人的东西",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "285/TALK",
            "narrator": "ガブリエラ",
            "text": "出来が悪いかもしれないわよ？",
            "zh": "说不定写得很差哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "287/SEL",
            "narrator": "",
            "text": "ガブリエラなら大丈夫",
            "zh": "加布里埃拉肯定没事",
            "narrator_zh": ""
        },
        {
            "location": "288/ACT",
            "narrator": "",
            "text": "ガブリエラなら大丈夫",
            "zh": "加布里埃拉肯定没事",
            "narrator_zh": ""
        },
        {
            "location": "290/TALK",
            "narrator": "ガブリエラ",
            "text": "本当調子良過ぎだから",
            "zh": "你真是顺杆爬得过头了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "291/TALK",
            "narrator": "ガブリエラ",
            "text": "っていうかわざとらしいし",
            "zh": "话说，太做作了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "292/TALK",
            "narrator": "ガブリエラ",
            "text": "けど",
            "zh": "可是",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "294/TALK",
            "narrator": "ガブリエラ",
            "text": "そこまで期待されてるなら頑張るわ",
            "zh": "既然被期待到那地步，我就努力吧",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "300/TALK",
            "narrator": "ガブリエラ",
            "text": "…あたしの詩、\n良かったんだ…。",
            "zh": "……原来我的诗，\n真的写得好……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "301/TALK",
            "narrator": "ガブリエラ",
            "text": "$handle$にも褒めて\nもらえたし…。",
            "zh": "还被$handle$\n夸了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "302/TALK",
            "narrator": "ガブリエラ",
            "text": "ふふっ…ちょっと\n本気で勉強して\nみようかしら？",
            "zh": "呵呵……要不要\n稍微认真\n学一学呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "174/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>某月某日　 0:16 PM</color>\nとある平日の昼休み、付属学園食堂でのこと",
