{
    "dir": "chap31/daydra/dd_ch01_31_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "31102",
        "cid": "tsubame",
        "title": "002 メインストーリー",
        "sub_title": "触れえぬ未来の＜前編＞",
        "title_zh": "002 主线剧情",
        "sub_title_zh": "触不到的未来＜前篇＞"
    },
    "entry": [
        {
            "location": "8/SCENARIO",
            "narrator": "",
            "text": "触れえぬ未来の",
            "zh": "触不到的未来",
            "narrator_zh": ""
        },
        {
            "location": "26/TALK",
            "narrator": "つばめ",
            "text": "…わからない…\nわからないよ…。",
            "zh": "……不明白……\n不明白啊……",
            "narrator_zh": "燕"
        },
        {
            "location": "27/TALK",
            "narrator": "つばめ",
            "text": "今どうなってるのかも\nどうすれば\nいいのかも…。",
            "zh": "现在变成什么样了，\n该怎么办，\n也不知道……",
            "narrator_zh": "燕"
        },
        {
            "location": "28/TALK",
            "narrator": "千羽鶴",
            "text": "逢瀬つばめ。",
            "zh": "逢濑燕。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "31/TALK",
            "narrator": "つばめ",
            "text": "長官さん…！",
            "zh": "长官……！",
            "narrator_zh": "燕"
        },
        {
            "location": "44/TALK",
            "narrator": "千羽鶴",
            "text": "質問がある。\n正直に答えて。",
            "zh": "我有问题。\n老实回答。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "45/TALK",
            "narrator": "千羽鶴",
            "text": "私が望んでいるのは\n輝ける未来。",
            "zh": "我想要的是\n闪耀的未来。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "46/TALK",
            "narrator": "千羽鶴",
            "text": "それはどうやって\n創造するべきか。",
            "zh": "那该怎么\n创造。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "47/TALK",
            "narrator": "透明つばめ",
            "text": "創造…？",
            "zh": "创造……？",
            "narrator_zh": "透明燕"
        },
        {
            "location": "48/TALK",
            "narrator": "千羽鶴",
            "text": "そう。\n逢瀬つばめはどう\n創造するのか。",
            "zh": "是的。\n逢濑燕要怎么\n创造。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "49/TALK",
            "narrator": "千羽鶴",
            "text": "どう創造すべきと\n考えているのか。\n正直に答えて。",
            "zh": "你认为该怎么\n创造。\n老实回答。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "50/TALK",
            "narrator": "透明つばめ",
            "text": "わたし……。\nわたしなら……。",
            "zh": "我……\n要是我的话……",
            "narrator_zh": "透明燕"
        },
        {
            "location": "60/TALK",
            "narrator": "透明つばめ",
            "text": "…どうすればいいのかは\nわかりません。",
            "zh": "……该怎么办，\n我不知道。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "61/TALK",
            "narrator": "透明つばめ",
            "text": "それは人によって\n違うと思うから。",
            "zh": "因为我觉得\n那是因人而异的。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "62/TALK",
            "narrator": "透明つばめ",
            "text": "だからわたしには\n作れないと思います。",
            "zh": "所以我觉得\n我做不出来。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "63/TALK",
            "narrator": "透明つばめ",
            "text": "それに人の未来は\n他の人に強要される\nことじゃない。",
            "zh": "而且人的未来\n不该由别人\n强加。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "64/TALK",
            "narrator": "透明つばめ",
            "text": "…わたしは\nそう思います。",
            "zh": "……我是\n这么想的。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "77/TALK",
            "narrator": "千羽鶴",
            "text": "なるほど。",
            "zh": "原来如此。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "78/TALK",
            "narrator": "千羽鶴",
            "text": "あなたの意見は\nよくわかった。",
            "zh": "你的意见\n我明白了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "79/TALK",
            "narrator": "透明つばめ",
            "text": "長官さん…！",
            "zh": "长官……！",
            "narrator_zh": "透明燕"
        },
        {
            "location": "80/TALK",
            "narrator": "千羽鶴",
            "text": "やはり私はあなたに\n回帰しなければ\nならない。",
            "zh": "果然，我必须\n回归到\n你身上。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "82/TALK",
            "narrator": "透明つばめ",
            "text": "……え？",
            "zh": "……诶？",
            "narrator_zh": "透明燕"
        },
        {
            "location": "83/TALK",
            "narrator": "千羽鶴",
            "text": "本当は今の状態で\n回帰することは\n私にとっても危険。",
            "zh": "其实以现在的状态\n回归，对我\n也很危险。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "85/TALK",
            "narrator": "千羽鶴",
            "text": "でもこのままでは\n世界が取り返しの\nつかないことになる。",
            "zh": "可再这样下去，\n世界会变得\n无法挽回。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "87/TALK",
            "narrator": "千羽鶴",
            "text": "これ以上の不確定性を\n阻止しなければ。",
            "zh": "必须阻止\n更多的不确定性。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "89/TALK",
            "narrator": "透明つばめ",
            "text": "…何の話をして\nいるんですか…？",
            "zh": "……你在说\n什么……？",
            "narrator_zh": "透明燕"
        },
        {
            "location": "91/TALK",
            "narrator": "千羽鶴",
            "text": "やって。",
            "zh": "做吧。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "110/TALK",
            "narrator": "つばめ",
            "text": "！！！！！！",
            "zh": "！！！！！！",
            "narrator_zh": "燕"
        },
        {
            "location": "112/TALK",
            "narrator": "つばめ",
            "text": "痛い！　頭が割れそう！",
            "zh": "好痛！　头要裂开了！",
            "narrator_zh": "燕"
        },
        {
            "location": "118/TALK",
            "narrator": "千羽鶴",
            "text": "逢瀬つばめ。",
            "zh": "逢濑燕。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "119/TALK",
            "narrator": "つばめ",
            "text": "痛い痛い痛い痛い痛い\n痛い痛い痛い痛い痛い\n痛い痛い痛い痛い…！",
            "zh": "好痛好痛好痛好痛好痛\n好痛好痛好痛好痛好痛\n好痛好痛好痛好痛……！",
            "narrator_zh": "燕"
        },
        {
            "location": "120/TALK",
            "narrator": "千羽鶴",
            "text": "回帰により予測できる\n結果はみっつ。",
            "zh": "回归之后能预测的\n结果有三个。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "121/TALK",
            "narrator": "つばめ",
            "text": "…あ…うぅ…。",
            "zh": "……啊……呜……",
            "narrator_zh": "燕"
        },
        {
            "location": "122/TALK",
            "narrator": "千羽鶴",
            "text": "私が死ぬか、\nあなたが死ぬか、\n二人とも死ぬか。",
            "zh": "我死，\n你死，\n或者两个一起死。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "123/TALK",
            "narrator": "つばめ",
            "text": "…痛…痛いよ…。",
            "zh": "……痛……好痛……",
            "narrator_zh": "燕"
        },
        {
            "location": "126/TALK",
            "narrator": "千羽鶴",
            "text": "$handle$。",
            "zh": "$handle$。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "127/SEL",
            "narrator": "",
            "text": "千…千羽鶴？",
            "zh": "千……千羽鹤？",
            "narrator_zh": ""
        },
        {
            "location": "128/SEL",
            "narrator": "",
            "text": "こっち見んな！",
            "zh": "别看这边！",
            "narrator_zh": ""
        },
        {
            "location": "129/SEL",
            "narrator": "",
            "text": "何の用？",
            "zh": "干什么？",
            "narrator_zh": ""
        },
        {
            "location": "130/ACT",
            "narrator": "",
            "text": "千…千羽鶴？",
            "zh": "千……千羽鹤？",
            "narrator_zh": ""
        },
        {
            "location": "131/ACT",
            "narrator": "",
            "text": "こっち見んな！",
            "zh": "别看这边！",
            "narrator_zh": ""
        },
        {
            "location": "132/ACT",
            "narrator": "",
            "text": "何の用？",
            "zh": "干什么？",
            "narrator_zh": ""
        },
        {
            "location": "134/TALK",
            "narrator": "千羽鶴",
            "text": "これから\nそっちに行くから。",
            "zh": "我现在\n到你那边去。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "135/SEL",
            "narrator": "",
            "text": "そんなことできるわけが",
            "zh": "怎么可能办得到",
            "narrator_zh": ""
        },
        {
            "location": "136/SEL",
            "narrator": "",
            "text": "来るな！",
            "zh": "别过来！",
            "narrator_zh": ""
        },
        {
            "location": "137/SEL",
            "narrator": "",
            "text": "嘘でしょ？",
            "zh": "骗人的吧？",
            "narrator_zh": ""
        },
        {
            "location": "138/ACT",
            "narrator": "",
            "text": "そんなことできるわけが",
            "zh": "怎么可能办得到",
            "narrator_zh": ""
        },
        {
            "location": "139/ACT",
            "narrator": "",
            "text": "来るな！",
            "zh": "别过来！",
            "narrator_zh": ""
        },
        {
            "location": "140/ACT",
            "narrator": "",
            "text": "嘘でしょ？",
            "zh": "骗人的吧？",
            "narrator_zh": ""
        },
        {
            "location": "176/TALK",
            "narrator": "百鶴",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "百鹤"
        },
        {
            "location": "177/SEL",
            "narrator": "",
            "text": "…！？",
            "zh": "……！？",
            "narrator_zh": ""
        },
        {
            "location": "178/ACT",
            "narrator": "",
            "text": "…！？",
            "zh": "……！？",
            "narrator_zh": ""
        },
        {
            "location": "183/TALK",
            "narrator": "百鶴",
            "text": "…っ！？",
            "zh": "……唔！？",
            "narrator_zh": "百鹤"
        },
        {
            "location": "184/TALK",
            "narrator": "百鶴",
            "text": "もしかして……",
            "zh": "难道……",
            "narrator_zh": "百鹤"
        },
        {
            "location": "185/TALK",
            "narrator": "百鶴",
            "text": "もしもし？",
            "zh": "喂？",
            "narrator_zh": "百鹤"
        },
        {
            "location": "186/SEL",
            "narrator": "",
            "text": "はい",
            "zh": "在",
            "narrator_zh": ""
        },
        {
            "location": "187/ACT",
            "narrator": "",
            "text": "はい",
            "zh": "在",
            "narrator_zh": ""
        },
        {
            "location": "189/TALK",
            "narrator": "百鶴",
            "text": "やっぱり。",
            "zh": "果然。",
            "narrator_zh": "百鹤"
        },
        {
            "location": "190/TALK",
            "narrator": "百鶴",
            "text": "私の会話を\n認識できる？",
            "zh": "你能听懂\n我在说什么吗？",
            "narrator_zh": "百鹤"
        },
        {
            "location": "191/SEL",
            "narrator": "",
            "text": "え…！？",
            "zh": "诶……！？",
            "narrator_zh": ""
        },
        {
            "location": "192/SEL",
            "narrator": "",
            "text": "『私の会話を認識出来る？』と言った",
            "zh": "你说了『你能听懂我在说什么吗？』",
            "narrator_zh": ""
        },
        {
            "location": "193/ACT",
            "narrator": "",
            "text": "え…！？",
            "zh": "诶……！？",
            "narrator_zh": ""
        },
        {
            "location": "194/ACT",
            "narrator": "",
            "text": "『私の会話を認識出来る？』と言った",
            "zh": "你说了『你能听懂我在说什么吗？』",
            "narrator_zh": ""
        },
        {
            "location": "197/TALK",
            "narrator": "百鶴",
            "text": "すごい。\n本当に繋がった。",
            "zh": "太好了。\n真的连上了。",
            "narrator_zh": "百鹤"
        },
        {
            "location": "198/TALK",
            "narrator": "百鶴",
            "text": "信じられないかも。",
            "zh": "也许难以置信。",
            "narrator_zh": "百鹤"
        },
        {
            "location": "199/SEL",
            "narrator": "",
            "text": "え？ちょっとどういうこと？マジで",
            "zh": "诶？等等这是怎么回事？真的假的",
            "narrator_zh": ""
        },
        {
            "location": "200/ACT",
            "narrator": "",
            "text": "え？ちょっとどういうこと？マジで",
            "zh": "诶？等等这是怎么回事？真的假的",
            "narrator_zh": ""
        },
        {
            "location": "203/TALK",
            "narrator": "百鶴",
            "text": "このプログラムを\n起動してくれて\nありがとう。",
            "zh": "谢谢你\n启动了\n这个程序。",
            "narrator_zh": "百鹤"
        },
        {
            "location": "204/TALK",
            "narrator": "百鶴",
            "text": "私は貴方とは違う世界に\nある、このプログラムの\nナビキャラクター[千羽鶴]。",
            "zh": "我在和你不同的世界里，\n是这个程序的\n导航角色[千羽鹤]。",
            "narrator_zh": "百鹤"
        },
        {
            "location": "205/TALK",
            "narrator": "百鶴",
            "text": "貴方の世界の誰かが、\n私を起動してくれるのを\n待っていた。",
            "zh": "我一直在等\n你的世界里有人\n来启动我。",
            "narrator_zh": "百鹤"
        },
        {
            "location": "206/SEL",
            "narrator": "",
            "text": "もしかして、中身が千羽鶴なの？",
            "zh": "难道里面是千羽鹤？",
            "narrator_zh": ""
        },
        {
            "location": "207/ACT",
            "narrator": "",
            "text": "もしかして、中身が千羽鶴なの？",
            "zh": "难道里面是千羽鹤？",
            "narrator_zh": ""
        },
        {
            "location": "209/TALK",
            "narrator": "百鶴",
            "text": "そう。\n今はまだリモートだけど。",
            "zh": "是的。\n现在还只是远程。",
            "narrator_zh": "百鹤"
        },
        {
            "location": "210/TALK",
            "narrator": "百鶴",
            "text": "そして唐突なお願いに\nなってしまうのだけど――",
            "zh": "接下来会变成\n一个很突然的请求——",
            "narrator_zh": "百鹤"
        },
        {
            "location": "211/SEL",
            "narrator": "",
            "text": "この世界を救って欲しい？",
            "zh": "是要我拯救这个世界？",
            "narrator_zh": ""
        },
        {
            "location": "212/SEL",
            "narrator": "",
            "text": "結婚しよう！",
            "zh": "我们结婚吧！",
            "narrator_zh": ""
        },
        {
            "location": "213/ACT",
            "narrator": "",
            "text": "この世界を救って欲しい？",
            "zh": "是要我拯救这个世界？",
            "narrator_zh": ""
        },
        {
            "location": "214/TALK",
            "narrator": "百鶴",
            "text": "惜しいけど違う。",
            "zh": "差一点，但不是。",
            "narrator_zh": "百鹤"
        },
        {
            "location": "215/TALK",
            "narrator": "百鶴",
            "text": "この世界を\n救うために――",
            "zh": "为了拯救\n这个世界——",
            "narrator_zh": "百鹤"
        },
        {
            "location": "216/ACT",
            "narrator": "",
            "text": "結婚しよう！",
            "zh": "我们结婚吧！",
            "narrator_zh": ""
        },
        {
            "location": "218/TALK",
            "narrator": "百鶴",
            "text": "えっ！",
            "zh": "诶！",
            "narrator_zh": "百鹤"
        },
        {
            "location": "219/TALK",
            "narrator": "百鶴",
            "text": "やだ…そんな突然。\n私たち、非攻略対象\n同士なのよ？",
            "zh": "讨厌……这么突然。\n我们俩，可是\n非攻略对象同伴呀？",
            "narrator_zh": "百鹤"
        },
        {
            "location": "220/SEL",
            "narrator": "",
            "text": "冗談です",
            "zh": "开玩笑的",
            "narrator_zh": ""
        },
        {
            "location": "221/SEL",
            "narrator": "",
            "text": "大事なのは設定じゃない！この気持ちなんだ！",
            "zh": "重要的不是设定！是这份心意！",
            "narrator_zh": ""
        },
        {
            "location": "222/ACT",
            "narrator": "",
            "text": "冗談です",
            "zh": "开玩笑的",
            "narrator_zh": ""
        },
        {
            "location": "223/TALK",
            "narrator": "百鶴",
            "text": "……そう。",
            "zh": "……是的。",
            "narrator_zh": "百鹤"
        },
        {
            "location": "224/TALK",
            "narrator": "百鶴",
            "text": "まあ、いいけど。",
            "zh": "算了，也行。",
            "narrator_zh": "百鹤"
        },
        {
            "location": "225/ACT",
            "narrator": "",
            "text": "大事なのは設定じゃない！この気持ちなんだ！",
            "zh": "重要的不是设定！是这份心意！",
            "narrator_zh": ""
        },
        {
            "location": "227/TALK",
            "narrator": "百鶴",
            "text": "なんて情熱的な人なの？\n嬉しい！",
            "zh": "多么热情的人？\n真高兴！",
            "narrator_zh": "百鹤"
        },
        {
            "location": "228/SEL",
            "narrator": "",
            "text": "千羽鶴！",
            "zh": "千羽鹤！",
            "narrator_zh": ""
        },
        {
            "location": "229/ACT",
            "narrator": "",
            "text": "千羽鶴！",
            "zh": "千羽鹤！",
            "narrator_zh": ""
        },
        {
            "location": "231/TALK",
            "narrator": "百鶴",
            "text": "ああっ…\n$handle$さんっ！",
            "zh": "啊啊……\n$handle$！",
            "narrator_zh": "百鹤"
        },
        {
            "location": "232/SEL",
            "narrator": "",
            "text": "名前呼んでくれた！！",
            "zh": "你叫了我的名字！！",
            "narrator_zh": ""
        },
        {
            "location": "233/ACT",
            "narrator": "",
            "text": "名前呼んでくれた！！",
            "zh": "你叫了我的名字！！",
            "narrator_zh": ""
        },
        {
            "location": "235/TALK",
            "narrator": "百鶴",
            "text": "ええ。\nだって私、あなたの\n名前知ってるもの。",
            "zh": "嗯。\n因为我\n知道你的名字。",
            "narrator_zh": "百鹤"
        },
        {
            "location": "236/TALK",
            "narrator": "百鶴",
            "text": "それに。\nさっき私のこと何て？",
            "zh": "还有。\n刚才你叫我什么？",
            "narrator_zh": "百鹤"
        },
        {
            "location": "237/SEL",
            "narrator": "",
            "text": "ちはるだよ！",
            "zh": "是千羽鹤呀！",
            "narrator_zh": ""
        },
        {
            "location": "238/ACT",
            "narrator": "",
            "text": "ちはるだよ！",
            "zh": "是千羽鹤呀！",
            "narrator_zh": ""
        },
        {
            "location": "240/TALK",
            "narrator": "百鶴",
            "text": "そうね。正解。",
            "zh": "是啊。答对了。",
            "narrator_zh": "百鹤"
        },
        {
            "location": "241/TALK",
            "narrator": "百鶴",
            "text": "貴方と私はもう、\n他人じゃない。",
            "zh": "你和我，\n已经不是外人了。",
            "narrator_zh": "百鹤"
        },
        {
            "location": "242/TALK",
            "narrator": "百鶴",
            "text": "そして、ここまでの間、\n私がどれ程非攻略対象と\n言ったかわからないのに―",
            "zh": "而且，到现在为止，\n我说了多少次\n非攻略对象——",
            "narrator_zh": "百鹤"
        },
        {
            "location": "243/TALK",
            "narrator": "百鶴",
            "text": "それでも尚、頑なに\n結婚しようと言ってくる\n貴方はある意味すごい。",
            "zh": "你还是死咬着\n说要结婚，\n某种意义上真厉害。",
            "narrator_zh": "百鹤"
        },
        {
            "location": "244/TALK",
            "narrator": "百鶴",
            "text": "貴方は本当に、\n私と結婚したいと\n思ってるのね。",
            "zh": "你是真的\n想和我\n结婚吧。",
            "narrator_zh": "百鹤"
        },
        {
            "location": "245/SEL",
            "narrator": "",
            "text": "本当にしたいと思ってる",
            "zh": "是真的想",
            "narrator_zh": ""
        },
        {
            "location": "246/SEL",
            "narrator": "",
            "text": "選択肢を色々試していただけ",
            "zh": "只是在试各种选项",
            "narrator_zh": ""
        },
        {
            "location": "247/ACT",
            "narrator": "",
            "text": "本当にしたいと思ってる",
            "zh": "是真的想",
            "narrator_zh": ""
        },
        {
            "location": "249/TALK",
            "narrator": "百鶴",
            "text": "結婚という２文字は\nあらゆる関係と意味を\n包含している。",
            "zh": "结婚这两个字，\n包含了所有的关系\n和意义。",
            "narrator_zh": "百鹤"
        },
        {
            "location": "250/TALK",
            "narrator": "百鶴",
            "text": "私との結婚がもし実現\nしたとして、それは貴方の\n結婚観念とは違うかも。",
            "zh": "就算和我结婚真的实现了，\n那也许也和你的\n结婚观念不一样。",
            "narrator_zh": "百鹤"
        },
        {
            "location": "251/TALK",
            "narrator": "百鶴",
            "text": "そういう可能性を、\n貴方は考えた事がある？",
            "zh": "这种可能性，\n你想过吗？",
            "narrator_zh": "百鹤"
        },
        {
            "location": "252/SEL",
            "narrator": "",
            "text": "ある",
            "zh": "想过",
            "narrator_zh": ""
        },
        {
            "location": "253/SEL",
            "narrator": "",
            "text": "ない",
            "zh": "没想过",
            "narrator_zh": ""
        },
        {
            "location": "254/ACT",
            "narrator": "",
            "text": "ある",
            "zh": "想过",
            "narrator_zh": ""
        },
        {
            "location": "256/TALK",
            "narrator": "百鶴",
            "text": "そう。\nそれじゃ、覚悟は出来ての\nことなのね。",
            "zh": "是的。\n那就是已经\n有觉悟了吧。",
            "narrator_zh": "百鹤"
        },
        {
            "location": "257/ACT",
            "narrator": "",
            "text": "ない",
            "zh": "没想过",
            "narrator_zh": ""
        },
        {
            "location": "258/TALK",
            "narrator": "百鶴",
            "text": "浅はかね。\nノリで求愛してるだけ？",
            "zh": "浅薄。\n只是随口求爱？",
            "narrator_zh": "百鹤"
        },
        {
            "location": "261/TALK",
            "narrator": "百鶴",
            "text": "貴方は前にも、\n彼女たちをコロシテでも\n私をとると言っていた。",
            "zh": "你以前也说过，\n就算杀掉她们\n也要选我。",
            "narrator_zh": "百鹤"
        },
        {
            "location": "262/TALK",
            "narrator": "百鶴",
            "text": "だから、考え云々は置いて\nおいても、その気持ちは\n一貫している事がわかる。",
            "zh": "所以，先不谈想没想过，\n这份心意\n是一贯的。",
            "narrator_zh": "百鹤"
        },
        {
            "location": "263/TALK",
            "narrator": "百鶴",
            "text": "それはそうと、\nあの時私が言ったこと、\n覚えてる？",
            "zh": "话说回来，\n那时候我说的话，\n你记得吗？",
            "narrator_zh": "百鹤"
        },
        {
            "location": "264/TALK",
            "narrator": "百鶴",
            "text": "彼女らを殺したら\n私と結婚できなくなる。",
            "zh": "杀了她们的话，\n就不能和我结婚了。",
            "narrator_zh": "百鹤"
        },
        {
            "location": "265/TALK",
            "narrator": "百鶴",
            "text": "今ならその意味が\nわかると思う。",
            "zh": "现在你应该\n明白那是什么意思了。",
            "narrator_zh": "百鹤"
        },
        {
            "location": "266/TALK",
            "narrator": "百鶴",
            "text": "特定を防ぐ為に\n「ら」という形で\n濁しはしたけども。",
            "zh": "为了防止被特定出来，\n我用「们」\n含糊过去了。",
            "narrator_zh": "百鹤"
        },
        {
            "location": "267/TALK",
            "narrator": "百鶴",
            "text": "そして、私がなぜ\n非攻略対象なのか。",
            "zh": "还有，我为什么\n是非攻略对象。",
            "narrator_zh": "百鹤"
        },
        {
            "location": "268/TALK",
            "narrator": "百鶴",
            "text": "その答えもまた\nそこにある。",
            "zh": "答案\n也在那里。",
            "narrator_zh": "百鹤"
        },
        {
            "location": "270/TALK",
            "narrator": "百鶴",
            "text": "いずれにせよ、\n貴方の願いは\n叶えられる。",
            "zh": "不管怎样，\n你的愿望\n会实现。",
            "narrator_zh": "百鹤"
        },
        {
            "location": "271/TALK",
            "narrator": "百鶴",
            "text": "それは、貴方の\n想像するものとは\n違うかもしれないけど。",
            "zh": "那也许\n和你想象的\n不一样。",
            "narrator_zh": "百鹤"
        },
        {
            "location": "272/ACT",
            "narrator": "",
            "text": "選択肢を色々試していただけ",
            "zh": "只是在试各种选项",
            "narrator_zh": ""
        },
        {
            "location": "273/TALK",
            "narrator": "百鶴",
            "text": "そう……。",
            "zh": "这样啊……",
            "narrator_zh": "百鹤"
        },
        {
            "location": "274/TALK",
            "narrator": "百鶴",
            "text": "今わりと忙しいから、\nそういうくだらないこと\nしないで。",
            "zh": "我现在挺忙的，\n别做这种\n无聊的事。",
            "narrator_zh": "百鹤"
        },
        {
            "location": "277/TALK",
            "narrator": "百鶴",
            "text": "貴方のせいで、本題から\n逸れてしまった。",
            "zh": "都怪你，\n偏离正题了。",
            "narrator_zh": "百鹤"
        },
        {
            "location": "278/TALK",
            "narrator": "百鶴",
            "text": "私が貴方にしたかった\n唐突なお願いは、実は\n当たらずとも遠からず。",
            "zh": "我本来想对你说的\n那个突然的请求，\n其实八九不离十。",
            "narrator_zh": "百鹤"
        },
        {
            "location": "279/TALK",
            "narrator": "百鶴",
            "text": "それは、\nこの世界を\n救うために――",
            "zh": "那就是，\n为了拯救\n这个世界——",
            "narrator_zh": "百鹤"
        },
        {
            "location": "284/TALK",
            "narrator": "百鶴",
            "text": "<size=30><color=red>ある少女たちを\n発症させて欲しい！</color></size>",
            "zh": "<size=30><color=red>希望你让某些少女\n发症！</color></size>",
            "narrator_zh": "百鹤"
        },
        {
            "location": "285/SEL",
            "narrator": "",
            "text": "今、なんて？",
            "zh": "你刚才说什么？",
            "narrator_zh": ""
        },
        {
            "location": "286/ACT",
            "narrator": "",
            "text": "今、なんて？",
            "zh": "你刚才说什么？",
            "narrator_zh": ""
        },
        {
            "location": "288/TALK",
            "narrator": "百鶴",
            "text": "あるしょうじょたちを\nはっしょうさせてほしい",
            "zh": "想让某些少女\n发症",
            "narrator_zh": "百鹤"
        },
        {
            "location": "289/SEL",
            "narrator": "",
            "text": "結婚…でしたよね？",
            "zh": "是结婚……对吧？",
            "narrator_zh": ""
        },
        {
            "location": "290/ACT",
            "narrator": "",
            "text": "結婚…でしたよね？",
            "zh": "是结婚……对吧？",
            "narrator_zh": ""
        },
        {
            "location": "292/TALK",
            "narrator": "百鶴",
            "text": "もちろん、結婚も\n現在進行形のお願いの\n１つに変わりはない。",
            "zh": "当然，结婚\n也仍是正在进行的\n请求之一。",
            "narrator_zh": "百鹤"
        },
        {
            "location": "293/SEL",
            "narrator": "",
            "text": "意味が分からないんですけど",
            "zh": "我听不懂啊",
            "narrator_zh": ""
        },
        {
            "location": "294/ACT",
            "narrator": "",
            "text": "意味が分からないんですけど",
            "zh": "我听不懂啊",
            "narrator_zh": ""
        },
        {
            "location": "296/TALK",
            "narrator": "百鶴",
            "text": "そうね。\n確かにこの２つは\n繋がらないかもしれない。",
            "zh": "是啊。\n这两个确实\n也许连不起来。",
            "narrator_zh": "百鹤"
        },
        {
            "location": "297/TALK",
            "narrator": "百鶴",
            "text": "この辺りは、私がここに\n戻ってこられる準備が\n整ったら改めて説明する。",
            "zh": "这部分，等我\n准备好回到这里，\n再说明。",
            "narrator_zh": "百鹤"
        },
        {
            "location": "298/TALK",
            "narrator": "百鶴",
            "text": "早ければ、\n次に会うときにでも。",
            "zh": "快的话，\n下次见面的时候。",
            "narrator_zh": "百鹤"
        },
        {
            "location": "23/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>9月9日　 3:04 PM</color>\nつばめが監禁されている部屋にて",
            "zh": "<color=green>9月9日　 3:04 PM</color>\n燕被关着的房间",
            "narrator_zh": "Dialog_EventData"
        },
        {
            "location": "303/DIALOG",
            "narrator": "NOTICE",
            "text": "<color=red>【TRI-OS Error:0x99】</color>\nココロスフィアとの回線が\n切断されました。(981)",
            "zh": "<color=red>【TRI-OS Error:0x99】</color>\n与心灵领域的线路\n已切断。(981)",
            "narrator_zh": "NOTICE"
        }
    ]
}
