            "narrator": "",
            "text": "怖い",
            "zh": "害怕",
            "narrator_zh": ""
        },
        {
            "location": "404/ACT",
            "narrator": "",
            "text": "大丈夫",
            "zh": "没事",
            "narrator_zh": ""
        },
        {
            "location": "405/TALK",
            "narrator": "ガブリエラ",
            "text": "ほんとに？",
            "zh": "真的吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "406/TALK",
            "narrator": "ガブリエラ",
            "text": "わかったわ。\nそれじゃ、言うわね。",
            "zh": "知道了。\n那我来说。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "407/ACT",
            "narrator": "",
            "text": "怖い",
            "zh": "害怕",
            "narrator_zh": ""
        },
        {
            "location": "408/TALK",
            "narrator": "ガブリエラ",
            "text": "そうね、ちょっと怖い\nお話になるかも。",
            "zh": "是啊，也许会变成\n有点可怕的故事。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "409/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、なるべく\n優しく伝えるから、\n聞いて頂戴ね。",
            "zh": "不过我会尽量\n说得温柔些，\n你听我说哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "411/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしの家…\nポーランドにある実家の\nことなんだけど。",
            "zh": "我家……\n在波兰的老家\n那件事。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "412/TALK",
            "narrator": "ガブリエラ",
            "text": "実は、まだあたしが初等部\nだった頃に――",
            "zh": "其实，在我还在\n小学部的时候——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "413/TALK",
            "narrator": "ガブリエラ",
            "text": "強盗に入られた\nことがあるの。",
            "zh": "曾经被强盗\n闯进来过。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "414/SEL",
            "narrator": "",
            "text": "大丈夫だった！？",
            "zh": "你没事吧！？",
            "narrator_zh": ""
        },
        {
            "location": "415/ACT",
            "narrator": "",
            "text": "大丈夫だった！？",
            "zh": "你没事吧！？",
            "narrator_zh": ""
        },
        {
            "location": "418/TALK",
            "narrator": "ガブリエラ",
            "text": "え？\nあ、そうね。",
            "zh": "诶？\n啊，是啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "419/TALK",
            "narrator": "ガブリエラ",
            "text": "…っと、あたしの\n身体は大丈夫だったわ。",
            "zh": "……嗯，我的\n身体没事。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "420/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、やっぱりほら、\nココロにキズが\nできちゃったのよ。",
            "zh": "可是，你看，\n心里还是\n留下了伤。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "421/TALK",
            "narrator": "ガブリエラ",
            "text": "だから、特定の条件を\n満たしちゃうと、手の\n震えが止まらなくなるわ。",
            "zh": "所以，一旦满足\n特定的条件，手就\n会抖个不停。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "422/TALK",
            "narrator": "ガブリエラ",
            "text": "それは、今でも。",
            "zh": "直到现在也是。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "423/SEL",
            "narrator": "",
            "text": "大変だったね",
            "zh": "真不容易",
            "narrator_zh": ""
        },
        {
            "location": "424/SEL",
            "narrator": "",
            "text": "特定の条件って？",
            "zh": "特定条件是什么？",
            "narrator_zh": ""
        },
        {
            "location": "425/ACT",
            "narrator": "",
            "text": "大変だったね",
            "zh": "真不容易",
            "narrator_zh": ""
        },
        {
            "location": "426/TALK",
            "narrator": "ガブリエラ",
            "text": "ありがと。\nでも大丈夫。",
            "zh": "谢谢。\n不过没事。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "427/ACT",
            "narrator": "",
            "text": "特定の条件って？",
            "zh": "特定条件是什么？",
            "narrator_zh": ""
        },
        {
            "location": "428/TALK",
            "narrator": "ガブリエラ",
            "text": "それは……ちょっと、\nあたしの口からは\n言いたくないわね。",
            "zh": "那个……有点，\n我不想从自己嘴里\n说出来。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "429/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、知りたいのなら\n深層世界の入口へ行けば\nきっと見られるわ。",
            "zh": "不过，想知道的话，\n去深层世界的入口\n一定能看到。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "430/TALK",
            "narrator": "ガブリエラ",
            "text": "多分どこかにあるから\n探してみてね。",
            "zh": "大概就在某处，\n你找找看。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "432/TALK",
            "narrator": "ガブリエラ",
            "text": "とにかくね、その条件を\n満たすと、必ず今回の\nようにクランが出ちゃう。",
            "zh": "总之，一旦满足那个条件，\n就一定会像这次这样\n冒出库兰。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "433/TALK",
            "narrator": "ガブリエラ",
            "text": "だから、やっつけて\nココロを落ち着かせないと\nいけないのよね。",
            "zh": "所以必须打倒它，\n让心平静\n下来才行。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "434/SEL",
            "narrator": "",
            "text": "そういうことなら任せて！",
            "zh": "这样的话就交给我！",
            "narrator_zh": ""
        },
        {
            "location": "435/ACT",
            "narrator": "",
            "text": "そういうことなら任せて！",
            "zh": "这样的话就交给我！",
            "narrator_zh": ""
        },
        {
            "location": "437/TALK",
            "narrator": "ガブリエラ",
            "text": "ふふ、\n協力してくれてありがと。\nとっても心強いわ♪",
            "zh": "呵呵，\n谢谢你愿意帮忙。\n真是让人安心♪",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "438/TALK",
            "narrator": "ガブリエラ",
            "text": "それじゃ、行くわよ！",
            "zh": "那就出发！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "440/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしと\n$handle$にとって\n素敵なココロの旅を！",
            "zh": "献给我和\n$handle$的，\n美妙的心灵之旅！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "27/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>5月3日　5:58 PM</color>\nFreyMENOWライブ中に発生した\nフェノメノンドーム戦にて。",
