{
    "dir": "chap03/daydra/dd_ch03_03_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "3302",
        "cid": "gabriella",
        "title": "002 メインストーリー",
        "sub_title": "ガブリエラという存在＜前編＞",
        "title_zh": "002 主线剧情",
        "sub_title_zh": "名为加布里埃拉的存在＜前篇＞"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "ガブリエラ導入",
            "zh": "加布里埃拉登场",
            "narrator_zh": ""
        },
        {
            "location": "29/TALK",
            "narrator": "ガブリエラ",
            "text": "まったく、ちょこまか\nちょこまかと…。",
            "zh": "真是的，\n碎步来碎步去的……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "30/TALK",
            "narrator": "ガブリエラ",
            "text": "ああもうっ！！\n今、チャンスだったのに！",
            "zh": "啊真是的！！\n刚才明明是机会！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "31/TALK",
            "narrator": "ガブリエラ",
            "text": "ただでさえ標的との\n距離が近過ぎて、狙い辛い\nってのに…。",
            "zh": "本来离目标\n就太近，很难瞄准，\n结果还……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "32/TALK",
            "narrator": "ガブリエラ",
            "text": "…足を撃って動けなく\nすれば…。",
            "zh": "……打中腿让人动不了\n的话……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "35/TALK",
            "narrator": "ガブリエラ",
            "text": "って、それじゃこっちの\n位置がバレるか。",
            "zh": "等等，那样的话\n我这边的位置就暴露了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "38/TALK",
            "narrator": "ガブリエラ",
            "text": "っていうか、発症者も\nウイルスによる被害者\nとして扱えなんて――",
            "zh": "话说回来，还让我把发病者也\n当作病毒的受害者\n来对待——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "39/TALK",
            "narrator": "ガブリエラ",
            "text": "甘過ぎるのよ。\nこれじゃ、何のための\n戦いかわからないわ。",
            "zh": "太天真了。\n这样下去，根本不知道\n这场战斗是为了什么。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "40/TALK",
            "narrator": "ガブリエラ",
            "text": "ポーランドだったら、\n二人ともとっくに\n撃ち殺してるのに…。",
            "zh": "要是在波兰，\n两个人早就\n被我击毙了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "44/TALK",
            "narrator": "真幌",
            "text": "ギャヴィ、状況は？",
            "zh": "加维，情况如何？",
            "narrator_zh": "真幌"
        },
        {
            "location": "55/TALK",
            "narrator": "ガブリエラ",
            "text": "…ターゲット補足中。\nいつでも撃てるのに…。",
            "zh": "……正在锁定目标。\n明明随时都能开枪……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "56/TALK",
            "narrator": "真幌",
            "text": "そうか。",
            "zh": "是吗。",
            "narrator_zh": "真幌"
        },
        {
            "location": "57/TALK",
            "narrator": "真幌",
            "text": "いいか、狙いはあくまでも\n発症者の持っている剣\nだからな。",
            "zh": "听好，目标始终是\n发病者手里的\n那把剑。",
            "narrator_zh": "真幌"
        },
        {
            "location": "58/TALK",
            "narrator": "真幌",
            "text": "絶対に人を撃つなよ。",
            "zh": "绝对不准对人开枪。",
            "narrator_zh": "真幌"
        },
        {
            "location": "59/TALK",
            "narrator": "ガブリエラ",
            "text": "…わかってるわよ。",
            "zh": "……我知道了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "60/TALK",
            "narrator": "真幌",
            "text": "我々は可能な限り、\n発症者を傷つけず――",
            "zh": "我们要尽可能，\n不伤害发病者——",
            "narrator_zh": "真幌"
        },
        {
            "location": "61/TALK",
            "narrator": "真幌",
            "text": "五体満足の状態で\n事態を収束させることが\n任務なんだ。",
            "zh": "在四肢完好的状态下\n把事态平息下去，\n这就是任务。",
            "narrator_zh": "真幌"
        },
        {
            "location": "62/TALK",
            "narrator": "ガブリエラ",
            "text": "だから、わかってるって。",
            "zh": "所以说，我知道了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "63/TALK",
            "narrator": "ガブリエラ",
            "text": "じゃなきゃ、とっくに\n引き金を引いてるわ。",
            "zh": "不然的话，我早就\n扣下扳机了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "64/TALK",
            "narrator": "真幌",
            "text": "…そうだな。",
            "zh": "……也是。",
            "narrator_zh": "真幌"
        },
        {
            "location": "65/TALK",
            "narrator": "真幌",
            "text": "とにかく、民間人には\nかすり傷一つ負わせることは\n許さん。",
            "zh": "总之，绝不允许\n让平民负\n哪怕一道擦伤。",
            "narrator_zh": "真幌"
        },
        {
            "location": "66/TALK",
            "narrator": "真幌",
            "text": "それと、もし撃てそうに\nないなら無理をせず、\n牽制だけに留めろ。",
            "zh": "还有，要是没法\n开枪就别硬来，\n只做牵制就行。",
            "narrator_zh": "真幌"
        },
        {
            "location": "68/TALK",
            "narrator": "ガブリエラ",
            "text": "っ！！",
            "zh": "唔！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "69/TALK",
            "narrator": "ガブリエラ",
            "text": "無理じゃないわ！\nこれくらいの距離なら、\n絶対に外さないし。",
            "zh": "这不算硬来！\n这点距离的话，\n我绝对不会打偏。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "71/TALK",
            "narrator": "ガブリエラ",
            "text": "それに、牽制程度で\n怯むような相手には\n思えないし――",
            "zh": "而且，我不觉得\n对方会被区区牵制\n吓退——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "72/TALK",
            "narrator": "ガブリエラ",
            "text": "あの剣を破壊しない限り、\n今の状況が良くなるとも\n思えないわ。",
            "zh": "不毁掉那把剑，\n我不觉得现在的局面\n会好转。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "73/TALK",
            "narrator": "真幌",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "真幌"
        },
        {
            "location": "74/TALK",
            "narrator": "ガブリエラ",
            "text": "心配無用よ。\nあたしは狙った物以外は\n当てないから。",
            "zh": "不用担心。\n除了瞄准的东西，\n我不会打中别的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "75/TALK",
            "narrator": "ガブリエラ",
            "text": "チャンスが来たら、\n一発で撃ち抜いてやるわ。",
            "zh": "机会一来，\n我就一发打穿。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "76/TALK",
            "narrator": "真幌",
            "text": "…相変わらず、負けん気の\n強い奴だ。",
            "zh": "……还是老样子，\n好胜心很强。",
            "narrator_zh": "真幌"
        },
        {
            "location": "77/TALK",
            "narrator": "真幌",
            "text": "いや、若い証拠か…。",
            "zh": "不，也许是年轻的证明……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "78/TALK",
            "narrator": "真幌",
            "text": "わかった。\n現場のおまえに任せる。",
            "zh": "好。\n交给现场的你。",
            "narrator_zh": "真幌"
        },
        {
            "location": "79/TALK",
            "narrator": "真幌",
            "text": "ただし、絶対に――",
            "zh": "但是，绝对——",
            "narrator_zh": "真幌"
        },
        {
            "location": "80/TALK",
            "narrator": "ガブリエラ",
            "text": "人を撃つな、でしょ？\nらじゃ！",
            "zh": "不准对人开枪，对吧？\n了解！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "81/TALK",
            "narrator": "真幌",
            "text": "期待している。",
            "zh": "我期待着。",
            "narrator_zh": "真幌"
        },
        {
            "location": "85/TALK",
            "narrator": "ガブリエラ",
            "text": "…やってやるわよ。",
            "zh": "……我会做到的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "86/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしの腕は、軍や警察\nからも引っ張りだこになる\nほどなんだから。",
            "zh": "我的本事，连军队和警察\n都抢着要，\n就是这个水平。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "87/TALK",
            "narrator": "ガブリエラ",
            "text": "それを全部蹴ってここに\nいるあたしに、無理を\nするなですって？",
            "zh": "那些我全推掉才待在这里，\n还跟我说别\n硬来？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "88/TALK",
            "narrator": "ガブリエラ",
            "text": "この程度、朝飯前――",
            "zh": "这点程度，小菜一碟——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "89/TALK",
            "narrator": "ガブリエラ",
            "text": "なっ！？",
            "zh": "什！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "90/TALK",
            "narrator": "ガブリエラ",
            "text": "あいつ、何やって…。",
            "zh": "那人在干什么……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "94/TALK",
            "narrator": "ガブリエラ",
            "text": "マズい、捕まった！！",
            "zh": "糟了，被抓住了！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "95/TALK",
            "narrator": "ガブリエラ",
            "text": "身体が重なってる。\nこれじゃ狙い辛くて\n撃てないじゃない！",
            "zh": "身体叠在一起。\n这样很难瞄准，\n根本开不了枪！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "97/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤは…えっ！？\nあの抜け殻、まだあんなに\n離れたところにいるの！？",
            "zh": "绫水……诶！？\n那个空壳，还在那么\n远的地方！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "100/TALK",
            "narrator": "ガブリエラ",
            "text": "みやびも…ダメだわ。\nあの位置からじゃ\n間に合わない…。",
            "zh": "雅也……不行。\n从那个位置\n来不及……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "102/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "106/TALK",
            "narrator": "ガブリエラ",
            "text": "やってやる。",
            "zh": "我来做。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "107/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしがやるしか…。",
            "zh": "只能我来……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "120/TALK",
            "narrator": "ガブリエラ",
            "text": "っ！？",
            "zh": "唔！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "121/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "122/TALK",
            "narrator": "ガブリエラ",
            "text": "大丈夫…大丈夫よ。",
            "zh": "没事……没事的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "123/TALK",
            "narrator": "ガブリエラ",
            "text": "落ち着いて、狙いを…。",
            "zh": "冷静，瞄准……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "135/TALK",
            "narrator": "ガブリエラ",
            "text": "くっ！！",
            "zh": "可恶！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "136/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "138/TALK",
            "narrator": "ガブリエラ",
            "text": "大丈夫…忘れろ…。\n忘れろ、忘れろ！",
            "zh": "没事……忘掉……。\n忘掉，忘掉！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "139/TALK",
            "narrator": "ガブリエラ",
            "text": "今は集中しなくちゃ\nダメなんだから。",
            "zh": "现在必须\n集中精神。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "140/TALK",
            "narrator": "ガブリエラ",
            "text": "お願いだから、\n集中して…あたし！",
            "zh": "拜托了，\n集中……我自己！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "185/TALK",
            "narrator": "ガブリエラ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "194/TALK",
            "narrator": "千羽鶴",
            "text": "[ココロスフィア]の説明は\n前に私がしてると思うけど\nもう一度聞く？",
            "zh": "[心灵领域]的说明\n我想之前讲过，\n要再听一次吗？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "195/SEL",
            "narrator": "",
            "text": "はい",
            "zh": "要",
            "narrator_zh": ""
        },
        {
            "location": "196/SEL",
            "narrator": "",
            "text": "いいえ",
            "zh": "不要",
            "narrator_zh": ""
        },
        {
            "location": "197/ACT",
            "narrator": "",
            "text": "はい",
            "zh": "要",
            "narrator_zh": ""
        },
        {
            "location": "198/TALK",
            "narrator": "千羽鶴",
            "text": "わかった。",
            "zh": "好。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "200/ACT",
            "narrator": "",
            "text": "いいえ",
            "zh": "不要",
            "narrator_zh": ""
        },
        {
            "location": "208/TALK",
            "narrator": "千羽鶴",
            "text": "ようこそ。",
            "zh": "欢迎。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "209/SEL",
            "narrator": "",
            "text": "ここは…精神世界？",
            "zh": "这里是……精神世界？",
            "narrator_zh": ""
        },
        {
            "location": "210/ACT",
            "narrator": "",
            "text": "ここは…精神世界？",
            "zh": "这里是……精神世界？",
            "narrator_zh": ""
        },
        {
            "location": "212/TALK",
            "narrator": "千羽鶴",
            "text": "そう。\nバトル説明で入ったのと\n同じ、精神世界。",
            "zh": "是的。\n和战斗说明里进去的\n是同一个精神世界。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "213/TALK",
            "narrator": "千羽鶴",
            "text": "ここは、後ろにいる\n彼女、ガブリエラの\n精神世界の入口――",
            "zh": "这里是后面那位，\n加布里埃拉的\n精神世界入口——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "214/TALK",
            "narrator": "千羽鶴",
            "text": "通称<color=red>【[ココロゲート]】</color>\nと呼ばれている場所。",
            "zh": "通称<color=red>【[心之扉]】</color>\n的地方。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "215/TALK",
            "narrator": "千羽鶴",
            "text": "ここでは彼女は\nあなたと普通に\n対話できる。",
            "zh": "在这里，她可以\n和你正常\n对话。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "216/TALK",
            "narrator": "千羽鶴",
            "text": "彼女の心に直接\n語りかけることで、\n心を動かすの。",
            "zh": "直接向她的心\n诉说，\n就能打动她。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "217/TALK",
            "narrator": "千羽鶴",
            "text": "早速、\n彼女に話しかけてみて。",
            "zh": "那就，\n试着跟她说说话。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "225/TALK",
            "narrator": "ガブリエラ",
            "text": "わあ、お客様だ！\n珍しいなぁ！",
            "zh": "哇，是客人！\n真少见呀！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "226/SEL",
            "narrator": "",
            "text": "はじめまして。$handle$です",
            "zh": "初次见面。我是$handle$",
            "narrator_zh": ""
        },
        {
            "location": "227/ACT",
            "narrator": "",
            "text": "はじめまして。$handle$です",
            "zh": "初次见面。我是$handle$",
            "narrator_zh": ""
        },
        {
            "location": "229/TALK",
            "narrator": "ガブリエラ",
            "text": "はじめまして～！\nあたしはガブリエラの\n[ココロの司書]よ！",
            "zh": "初次见面～！\n我是加布里埃拉的\n[心之司书]哦！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "231/SEL",
            "narrator": "",
            "text": "よろしく",
            "zh": "请多关照",
            "narrator_zh": ""
        },
        {
            "location": "232/SEL",
            "narrator": "",
            "text": "司書のことは知ってるよ",
            "zh": "司书的事我知道",
            "narrator_zh": ""
