{
    "dir": "chap13/daydra/dd_ch01_13_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "13152",
        "cid": "tsubame",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "テスト返却",
        "title_zh": "Extra002 额外剧情",
        "sub_title_zh": "试卷发还"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "テスト返却",
            "zh": "试卷发还",
            "narrator_zh": ""
        },
        {
            "location": "27/TALK",
            "narrator": "つばめ",
            "text": "うわぁ…\nこれ、酷過ぎかも。",
            "zh": "哇……\n这也太惨了吧。",
            "narrator_zh": "燕"
        },
        {
            "location": "28/TALK",
            "narrator": "つばめ",
            "text": "テストでこんな酷い点数\n取ったの初めてだよぉ。",
            "zh": "考试考出这么惨的分数，\n我还是第一次呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "29/TALK",
            "narrator": "つばめ",
            "text": "こっち来てから忙しくて、\nちゃんと勉強できなかった\nからなぁ…。",
            "zh": "来了这边之后太忙，\n没能好好学习，\n所以才……。",
            "narrator_zh": "燕"
        },
        {
            "location": "30/TALK",
            "narrator": "つばめ",
            "text": "…お父さんに見せたら、\n絶対怒られちゃう。",
            "zh": "……要是给爸爸看，\n绝对会被骂的。",
            "narrator_zh": "燕"
        },
        {
            "location": "31/TALK",
            "narrator": "つばめ",
            "text": "はぁ…どうしよう？",
            "zh": "哈啊……怎么办呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "32/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "44/TALK",
            "narrator": "つばめ",
            "text": "相談に乗ってください",
            "zh": "请帮我想想办法",
            "narrator_zh": "燕"
        },
        {
            "location": "46/SEL",
            "narrator": "",
            "text": "改まってどうしたの？",
            "zh": "突然这么正经，怎么了？",
            "narrator_zh": ""
        },
        {
            "location": "47/ACT",
            "narrator": "",
            "text": "改まってどうしたの？",
            "zh": "突然这么正经，怎么了？",
            "narrator_zh": ""
        },
        {
            "location": "49/TALK",
            "narrator": "つばめ",
            "text": "テストで酷い点数取っちゃったの",
            "zh": "考试考了个很惨的分数",
            "narrator_zh": "燕"
        },
        {
            "location": "50/TALK",
            "narrator": "つばめ",
            "text": "こんなのお父さんに見せたら怒られちゃう",
            "zh": "这种分数要是给爸爸看，会被骂的",
            "narrator_zh": "燕"
        },
        {
            "location": "51/TALK",
            "narrator": "つばめ",
            "text": "どうしよう…",
            "zh": "怎么办呀……",
            "narrator_zh": "燕"
        },
        {
            "location": "54/SEL",
            "narrator": "",
            "text": "お父さんには秘密だ",
            "zh": "对爸爸保密",
            "narrator_zh": ""
        },
        {
            "location": "55/SEL",
            "narrator": "",
            "text": "勉強して次は頑張ろう",
            "zh": "好好学，下次加油",
            "narrator_zh": ""
        },
        {
            "location": "56/SEL",
            "narrator": "",
            "text": "友達に教えてもらおう",
            "zh": "请朋友教你吧",
            "narrator_zh": ""
        },
        {
            "location": "57/ACT",
            "narrator": "",
            "text": "お父さんには秘密だ",
            "zh": "对爸爸保密",
            "narrator_zh": ""
        },
        {
            "location": "58/TALK",
            "narrator": "つばめ",
            "text": "バレたら余計怒られちゃうよ！",
            "zh": "要是被发现，会挨更凶的骂呀！",
            "narrator_zh": "燕"
        },
        {
            "location": "60/TALK",
            "narrator": "つばめ",
            "text": "お父さん、本気で怒ったら凄く怖いんだから！",
            "zh": "爸爸要是动真格发火，可吓人了！",
            "narrator_zh": "燕"
        },
        {
            "location": "61/TALK",
            "narrator": "つばめ",
            "text": "憂鬱だよぉ…",
            "zh": "好郁闷呀……",
            "narrator_zh": "燕"
        },
        {
            "location": "72/TALK",
            "narrator": "つばめ",
            "text": "…怒られるの、覚悟して\n見せる以外ないか。",
            "zh": "……挨骂的事，也只能\n做好觉悟给他看了。",
            "narrator_zh": "燕"
        },
        {
            "location": "73/TALK",
            "narrator": "つばめ",
            "text": "潔くお父さんに怒られて、\n今度は頑張ろう。",
            "zh": "痛痛快快挨爸爸一顿骂，\n下次再加油。",
            "narrator_zh": "燕"
        },
        {
            "location": "74/ACT",
            "narrator": "",
            "text": "勉強して次は頑張ろう",
            "zh": "好好学，下次加油",
            "narrator_zh": ""
        },
        {
            "location": "75/TALK",
            "narrator": "つばめ",
            "text": "そうだね",
            "zh": "是呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "76/TALK",
            "narrator": "つばめ",
            "text": "お父さんにもそう言ってみるよ",
            "zh": "我也会试着这么跟爸爸说的。",
            "narrator_zh": "燕"
        },
        {
            "location": "87/TALK",
            "narrator": "つばめ",
            "text": "今度のテストは頑張るって\n約束すれば――",
            "zh": "要是答应他\n下次考试会加油——",
            "narrator_zh": "燕"
        },
        {
            "location": "88/TALK",
            "narrator": "つばめ",
            "text": "きっと、そんなには\n怒られない…かな？",
            "zh": "应该，就不会\n那么生气了……吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "89/TALK",
            "narrator": "つばめ",
            "text": "よーし、今夜から\n勉強頑張ろう！",
            "zh": "好，从今晚开始\n好好学习！",
            "narrator_zh": "燕"
        },
        {
            "location": "90/ACT",
            "narrator": "",
            "text": "友達に教えてもらおう",
            "zh": "请朋友教你吧",
            "narrator_zh": ""
        },
        {
            "location": "91/TALK",
            "narrator": "つばめ",
            "text": "うーん",
            "zh": "嗯……",
            "narrator_zh": "燕"
        },
        {
            "location": "92/TALK",
            "narrator": "つばめ",
            "text": "迷惑になっちゃわないかな？",
            "zh": "不会给人添麻烦吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "93/TALK",
            "narrator": "つばめ",
            "text": "でも、ちょっとお願いしてみるよ",
            "zh": "不过，我还是试着拜托一下。",
            "narrator_zh": "燕"
        },
        {
            "location": "112/TALK",
            "narrator": "つばめ",
            "text": "あの、ひなこちゃん。\nお願いがあるんだけど…。",
            "zh": "那个，雏。\n我有件事想拜托你……。",
            "narrator_zh": "燕"
        },
        {
            "location": "114/TALK",
            "narrator": "雛",
            "text": "なになに、どうかしたの？",
            "zh": "怎么怎么，出什么事了？",
            "narrator_zh": "雏"
        },
        {
            "location": "116/TALK",
            "narrator": "つばめ",
            "text": "実は…こういうわけで…。",
            "zh": "其实……是这么回事……。",
            "narrator_zh": "燕"
        },
        {
            "location": "118/TALK",
            "narrator": "雛",
            "text": "うわぁ…この点数は\nちょっと酷いかも…。",
            "zh": "哇……这个分数\n是有点惨……。",
            "narrator_zh": "雏"
        },
        {
            "location": "120/TALK",
            "narrator": "繭",
            "text": "七割取れてないのは\nちょっと問題ね。",
            "zh": "连七成都不到，\n是有点问题。",
            "narrator_zh": "茧"
        },
        {
            "location": "123/TALK",
            "narrator": "つばめ",
            "text": "わかってるから\n困ってるんだよぉ。",
            "zh": "我知道呀，\n所以才头疼呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "124/TALK",
            "narrator": "つばめ",
            "text": "それで、お願いって\nいうのは…。",
            "zh": "所以，想拜托的\n是……。",
            "narrator_zh": "燕"
        },
        {
            "location": "126/TALK",
            "narrator": "雛",
            "text": "つばめちゃん！\nみなまで言わなくても\nわかるよ。",
            "zh": "燕！\n不用说完\n我也懂。",
            "narrator_zh": "雏"
        },
        {
            "location": "129/TALK",
            "narrator": "雛",
            "text": "勉強ならあたしが\n教えてあげるから、\n安心して。",
            "zh": "要是学习的话我来\n教你，\n放心吧。",
            "narrator_zh": "雏"
        },
        {
            "location": "130/TALK",
            "narrator": "つばめ",
            "text": "ほ、本当！？",
            "zh": "真、真的！？",
            "narrator_zh": "燕"
        },
        {
            "location": "131/TALK",
            "narrator": "雛",
            "text": "うん！　任せて！",
            "zh": "嗯！交给我！",
            "narrator_zh": "雏"
        },
        {
            "location": "133/TALK",
            "narrator": "つばめ",
            "text": "よかったぁ…。\n相談して正解だったよ！",
            "zh": "太好了……。\n找你商量是对的呀！",
            "narrator_zh": "燕"
        },
        {
            "location": "135/TALK",
            "narrator": "雛",
            "text": "まあ、あたしが苦手な\n教科はまゆちんにお願い\nすることになるけど。",
            "zh": "不过，我不擅长的\n科目，就得拜托茧\n来教了。",
            "narrator_zh": "雏"
        },
        {
            "location": "137/TALK",
            "narrator": "繭",
            "text": "ナチュラルに私を\n巻き込むな。",
            "zh": "别一脸自然地\n把我卷进来。",
            "narrator_zh": "茧"
        },
        {
            "location": "139/TALK",
            "narrator": "つばめ",
            "text": "ひなこちゃん、まゆちん、\nよろしくお願いしまーす！",
            "zh": "雏、茧，\n请多关照呀！",
            "narrator_zh": "燕"
        },
        {
            "location": "141/TALK",
            "narrator": "繭",
            "text": "まだ私は教えるなんて\n言ってないんだけど…。",
            "zh": "我还没说过要教人\n……。",
            "narrator_zh": "茧"
        },
        {
            "location": "143/TALK",
            "narrator": "繭",
            "text": "…まあ、いいか。",
            "zh": "……算了。",
            "narrator_zh": "茧"
        },
        {
            "location": "16/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>7月14日　11:03 AM</color>\nとある初夏の平日、教室での休み時間のこと。",
            "zh": "<color=green>7月14日　11:03 AM</color>\n某个初夏的工作日，教室里的课间。",
            "narrator_zh": "Dialog_EventData"
        }
    ]
}
