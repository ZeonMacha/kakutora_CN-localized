{
    "dir": "chap00/daydra/spev_ch04_006.js",
    "type": "",
    "info": {
        "story_id": "4006",
        "cid": "",
        "title": "スペシャルエピソード",
        "sub_title": "溶けてしまうほどに",
        "title_zh": "特别篇",
        "sub_title_zh": "简直要融化了"
    },
    "entry": [
        {
            "location": "28/TALK",
            "narrator": "透明アーヤ",
            "text": "みんな、休まないで！\nあと砂浜一往復！！",
            "zh": "大家，别停下来！\n沙滩还差一个来回！！",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "30/TALK",
            "narrator": "透明つばめ",
            "text": "は、はいぃ…。\n頑張りますぅ…。",
            "zh": "是、是呀……\n我会加油的……",
            "narrator_zh": "透明燕"
        },
        {
            "location": "31/TALK",
            "narrator": "透明神楽",
            "text": "つばめさん、頑張って！\n足を止めたら動けなく\nなっちゃいますよ。",
            "zh": "燕，加油！\n停下脚步的话\n可就动弹不得了哦。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "32/TALK",
            "narrator": "透明ガブリエラ",
            "text": "ペース落とさないで、\n最後まで気合入れなさい！",
            "zh": "别把步速降下来，\n撑到最后打起干劲！",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "33/TALK",
            "narrator": "透明みやび",
            "text": "…みんな、\nまっこと元気やなぁ。",
            "zh": "……大家，\n精神头可真足咯。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "34/TALK",
            "narrator": "透明みやび",
            "text": "こんな炎天下に\n砂浜で走りこみとか、\nついて行けんがよ。",
            "zh": "这么大太阳底下\n在沙滩上跑步训练，\n我可跟不上啵。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "35/TALK",
            "narrator": "透明ガブリエラ",
            "text": "ほら、つばめ！\nペース落ちてる！！",
            "zh": "喂，燕！\n步速掉下来了！！",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "36/TALK",
            "narrator": "透明つばめ",
            "text": "ご、ごめーん！！",
            "zh": "对、对不起——！！",
            "narrator_zh": "透明燕"
        },
        {
            "location": "39/TALK",
            "narrator": "透明みやび",
            "text": "…ひゃっ！？",
            "zh": "……呀！？",
            "narrator_zh": "透明雅"
        },
        {
            "location": "43/TALK",
            "narrator": "透明みやび",
            "text": "あちゃぁ…アイス、\n落ちてしもうた…。",
            "zh": "哎呀……冰淇淋，\n掉下去了……",
            "narrator_zh": "透明雅"
        },
        {
            "location": "44/TALK",
            "narrator": "透明みやび",
            "text": "みんなの暑苦しさに\n耐えられんかったん\nやろうなぁ…。",
            "zh": "大概是受不了\n大家那股热乎劲\n化掉了吧……",
            "narrator_zh": "透明雅"
        },
        {
            "location": "46/TALK",
            "narrator": "透明みやび",
            "text": "…………。",
            "zh": "…………",
            "narrator_zh": "透明雅"
        },
        {
            "location": "49/TALK",
            "narrator": "みやび",
            "text": "さてどうしたものか",
            "zh": "那么该怎么办好",
            "narrator_zh": "雅"
        },
        {
            "location": "50/TALK",
            "narrator": "みやび",
            "text": "胸に落ちたアイス",
            "zh": "掉在胸口上的冰淇淋",
            "narrator_zh": "雅"
        },
        {
            "location": "51/TALK",
            "narrator": "みやび",
            "text": "この処理方法",
            "zh": "该怎么处理呢",
            "narrator_zh": "雅"
        },
        {
            "location": "52/SEL",
            "narrator": "（選択肢）",
            "text": "食べたい！！",
            "zh": "好想吃！！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "53/SEL",
            "narrator": "（選択肢）",
            "text": "食べちゃえ",
            "zh": "干脆吃掉吧",
            "narrator_zh": "（选项）"
        },
        {
            "location": "54/ACT",
            "narrator": "",
            "text": "食べたい！！",
            "zh": "好想吃！！",
            "narrator_zh": ""
        },
        {
            "location": "55/TALK",
            "narrator": "みやび",
            "text": "相棒がここにいたら",
            "zh": "搭档要是在这儿",
            "narrator_zh": "雅"
        },
        {
            "location": "56/TALK",
            "narrator": "みやび",
            "text": "即頼んでただろう",
            "zh": "肯定当场就拜托你了",
            "narrator_zh": "雅"
        },
        {
            "location": "58/TALK",
            "narrator": "みやび",
            "text": "胸のアイス",
            "zh": "胸口的冰淇淋",
            "narrator_zh": "雅"
        },
        {
            "location": "60/TALK",
            "narrator": "みやび",
            "text": "染みてきている",
            "zh": "正慢慢渗进来",
            "narrator_zh": "雅"
        },
        {
            "location": "61/TALK",
            "narrator": "みやび",
            "text": "冷たい",
            "zh": "好凉",
            "narrator_zh": "雅"
        },
        {
            "location": "62/ACT",
            "narrator": "",
            "text": "食べちゃえ",
            "zh": "干脆吃掉吧",
            "narrator_zh": ""
        },
        {
            "location": "63/TALK",
            "narrator": "みやび",
            "text": "無理だろう",
            "zh": "办不到的吧",
            "narrator_zh": "雅"
        },
        {
            "location": "64/TALK",
            "narrator": "みやび",
            "text": "触れたら溶ける",
            "zh": "一碰就化掉了",
            "narrator_zh": "雅"
        },
        {
            "location": "65/TALK",
            "narrator": "みやび",
            "text": "万事休す",
            "zh": "万事休矣",
            "narrator_zh": "雅"
        },
        {
            "location": "66/TALK",
            "narrator": "みやび",
            "text": "もうこのまま",
            "zh": "只好就这样",
            "narrator_zh": "雅"
        },
        {
            "location": "67/TALK",
            "narrator": "みやび",
            "text": "見守るしかないのだ",
            "zh": "眼睁睁看着了",
            "narrator_zh": "雅"
        },
        {
            "location": "70/TALK",
            "narrator": "みやび",
            "text": "だが",
            "zh": "但是",
            "narrator_zh": "雅"
        },
        {
            "location": "71/TALK",
            "narrator": "みやび",
            "text": "まだアイスはある",
            "zh": "我手里还有冰淇淋",
            "narrator_zh": "雅"
        },
        {
            "location": "73/TALK",
            "narrator": "みやび",
            "text": "それが救い",
            "zh": "这算是不幸中的万幸",
            "narrator_zh": "雅"
        },
        {
            "location": "74/TALK",
            "narrator": "みやび",
            "text": "溶ける前に食べねば",
            "zh": "得在融化前吃掉",
            "narrator_zh": "雅"
        },
        {
            "location": "75/SEL",
            "narrator": "（選択肢）",
            "text": "ていうか、みやびはサボり？",
            "zh": "话说回来，雅你这是在偷懒？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "76/ACT",
            "narrator": "",
            "text": "ていうか、みやびはサボり？",
            "zh": "话说回来，雅你这是在偷懒？",
            "narrator_zh": ""
        },
        {
            "location": "80/TALK",
            "narrator": "みやび",
            "text": "サボりではない",
            "zh": "这不是偷懒",
            "narrator_zh": "雅"
        },
        {
            "location": "81/TALK",
            "narrator": "みやび",
            "text": "自主的辞退である",
            "zh": "是主动退赛",
            "narrator_zh": "雅"
        },
        {
            "location": "82/TALK",
            "narrator": "みやび",
            "text": "肉体労働は専門外",
            "zh": "体力活不在我专业范围内",
            "narrator_zh": "雅"
        },
        {
            "location": "83/TALK",
            "narrator": "みやび",
            "text": "うちは頭脳派なのだ",
            "zh": "我可是头脑派",
            "narrator_zh": "雅"
        },
        {
            "location": "86/SEL",
            "narrator": "（選択肢）",
            "text": "なにか訓練しなくていいの？",
            "zh": "不需要做点什么训练吗？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "87/SEL",
            "narrator": "（選択肢）",
            "text": "脳みそクールダウン中か",
            "zh": "是在给脑子降温冷却吗",
            "narrator_zh": "（选项）"
        },
        {
            "location": "88/ACT",
            "narrator": "",
            "text": "なにか訓練しなくていいの？",
            "zh": "不需要做点什么训练吗？",
            "narrator_zh": ""
        },
        {
            "location": "91/TALK",
            "narrator": "みやび",
            "text": "えいのだよ",
            "zh": "不用了啵",
            "narrator_zh": "雅"
        },
        {
            "location": "93/TALK",
            "narrator": "みやび",
            "text": "うちは普段から",
            "zh": "我平时就已经",
            "narrator_zh": "雅"
        },
        {
            "location": "94/TALK",
            "narrator": "みやび",
            "text": "何時間もＰＣ前で鍛えてるのだ",
            "zh": "坐在电脑前锻炼好几个小时了",
            "narrator_zh": "雅"
        },
        {
            "location": "95/TALK",
            "narrator": "みやび",
            "text": "故にみんなの訓練中は",
            "zh": "所以大家训练的时候",
            "narrator_zh": "雅"
        },
        {
            "location": "96/TALK",
            "narrator": "みやび",
            "text": "休息タイムと決めた",
            "zh": "就定为我的休息时间",
            "narrator_zh": "雅"
        },
        {
            "location": "97/ACT",
            "narrator": "",
            "text": "脳みそクールダウン中か",
            "zh": "是在给脑子降温冷却吗",
            "narrator_zh": ""
        },
        {
            "location": "98/TALK",
            "narrator": "みやび",
            "text": "理解が早くて素晴らしい",
            "zh": "理解得这么快，太棒了",
            "narrator_zh": "雅"
        },
        {
            "location": "99/TALK",
            "narrator": "みやび",
            "text": "ＰＣと同じ",
            "zh": "跟电脑一样",
            "narrator_zh": "雅"
        },
        {
            "location": "101/TALK",
            "narrator": "みやび",
            "text": "脳みそ熱暴走は怖い",
            "zh": "脑子过热死机是很可怕的",
            "narrator_zh": "雅"
        },
        {
            "location": "102/TALK",
            "narrator": "みやび",
            "text": "アイスは冷却液代わりなのだ",
            "zh": "冰淇淋就是拿来当冷却液的",
            "narrator_zh": "雅"
        },
        {
            "location": "104/TALK",
            "narrator": "みやび",
            "text": "しかし",
            "zh": "不过",
            "narrator_zh": "雅"
        },
        {
            "location": "105/TALK",
            "narrator": "みやび",
            "text": "地元の海で",
            "zh": "在老家的海边",
            "narrator_zh": "雅"
        },
        {
            "location": "106/TALK",
            "narrator": "みやび",
            "text": "こんなにのんびりしたの",
            "zh": "像这样悠闲待着",
            "narrator_zh": "雅"
        },
        {
            "location": "107/TALK",
            "narrator": "みやび",
            "text": "初めてかもしれん",
            "zh": "还是头一回吧",
            "narrator_zh": "雅"
        },
        {
            "location": "108/TALK",
            "narrator": "みやび",
            "text": "散歩はしても",
            "zh": "散步倒是会去",
            "narrator_zh": "雅"
        },
        {
            "location": "109/TALK",
            "narrator": "みやび",
            "text": "のんびりはしない",
            "zh": "却不会这样悠闲待着",
            "narrator_zh": "雅"
        },
        {
            "location": "110/TALK",
            "narrator": "みやび",
            "text": "暑いだけだから",
            "zh": "因为只有热而已",
            "narrator_zh": "雅"
        },
        {
            "location": "111/SEL",
            "narrator": "（選択肢）",
            "text": "一人じゃつまらないよ",
            "zh": "一个人待着很无聊哦",
            "narrator_zh": "（选项）"
        },
        {
            "location": "112/SEL",
            "narrator": "（選択肢）",
            "text": "冷房効いた部屋でＰＣが一番",
            "zh": "开着冷气的房间配电脑才是最棒的",
            "narrator_zh": "（选项）"
        },
        {
            "location": "113/ACT",
            "narrator": "",
            "text": "一人じゃつまらないよ",
            "zh": "一个人待着很无聊哦",
            "narrator_zh": ""
        },
        {
            "location": "114/TALK",
            "narrator": "みやび",
            "text": "今も一人だが？",
            "zh": "现在也是一个人吧？",
            "narrator_zh": "雅"
        },
        {
            "location": "116/TALK",
            "narrator": "みやび",
            "text": "訓練してるみんなを",
            "zh": "远远望着",
            "narrator_zh": "雅"
        },
        {
            "location": "117/TALK",
            "narrator": "みやび",
            "text": "遠くから眺めて",
            "zh": "正在训练的大家",
            "narrator_zh": "雅"
        },
        {
            "location": "120/TALK",
            "narrator": "みやび",
            "text": "いや",
            "zh": "不对",
            "narrator_zh": "雅"
        },
        {
            "location": "121/TALK",
            "narrator": "みやび",
            "text": "違うな",
            "zh": "不是这样",
            "narrator_zh": "雅"
        },
        {
            "location": "122/TALK",
            "narrator": "みやび",
            "text": "そういうことではない",
            "zh": "不是那个意思",
            "narrator_zh": "雅"
        },
        {
            "location": "123/TALK",
            "narrator": "みやび",
            "text": "多分",
            "zh": "大概",
            "narrator_zh": "雅"
        },
        {
            "location": "125/ACT",
            "narrator": "",
            "text": "冷房効いた部屋でＰＣが一番",
            "zh": "开着冷气的房间配电脑才是最棒的",
            "narrator_zh": ""
        },
        {
            "location": "126/TALK",
            "narrator": "みやび",
            "text": "その通りだ",
            "zh": "正是如此",
            "narrator_zh": "雅"
        },
        {
            "location": "127/TALK",
            "narrator": "みやび",
            "text": "理解あり過ぎて怖い",
            "zh": "太懂我了，都有点吓人",
            "narrator_zh": "雅"
        },
        {
            "location": "128/TALK",
            "narrator": "みやび",
            "text": "浜辺に来なくても",
            "zh": "就算不用来海滩",
            "narrator_zh": "雅"
        },
        {
            "location": "129/TALK",
            "narrator": "みやび",
            "text": "部屋から海見えるし",
            "zh": "从房间里也看得到海",
            "narrator_zh": "雅"
        },
        {
            "location": "131/TALK",
            "narrator": "みやび",
            "text": "話に夢中になり過ぎた",
            "zh": "聊得太投入了",
            "narrator_zh": "雅"
        },
        {
            "location": "132/TALK",
            "narrator": "みやび",
            "text": "残りのアイスを食べなければ",
            "zh": "得把剩下的冰淇淋吃掉才行",
            "narrator_zh": "雅"
        },
        {
            "location": "133/TALK",
            "narrator": "みやび",
            "text": "また胸が冷たくなる前に",
            "zh": "趁胸口还没再变凉之前",
            "narrator_zh": "雅"
        },
        {
            "location": "137/TALK",
            "narrator": "透明みやび",
            "text": "さてと、これ食べたら\n違う味のを…。",
            "zh": "那么，吃完这份\n再吃个别的口味……",
            "narrator_zh": "透明雅"
        },
        {
            "location": "138/TALK",
            "narrator": "透明真幌",
            "text": "随分と優雅だな。",
            "zh": "还真是悠闲自在啊。",
            "narrator_zh": "透明真幌"
        },
        {
            "location": "140/TALK",
            "narrator": "透明みやび",
            "text": "ああ、まほさん。\nお疲れさんです。",
            "zh": "啊，真幌。\n辛苦啦。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "141/TALK",
            "narrator": "透明真幌",
            "text": "おまえ…ここまで\n堂々とサボられると、\n怒る気にもなれん…。",
            "zh": "你这……光明正大偷懒\n到这份上，\n我都气不起来了……",
            "narrator_zh": "透明真幌"
        },
        {
            "location": "142/TALK",
            "narrator": "透明みやび",
            "text": "自主的辞退ながですよ。\nまほさんも、\nアイス食べます？",
            "zh": "这叫主动退赛咯。\n真幌，\n你也吃冰淇淋咩？",
            "narrator_zh": "透明雅"
        },
        {
            "location": "143/TALK",
            "narrator": "透明真幌",
            "text": "…よし、わかった。\nそのアイスを食べきる\nまでは待ってやる。",
            "zh": "……好，明白了。\n那我就等到你\n把这份冰淇淋吃完。",
            "narrator_zh": "透明真幌"
        },
        {
            "location": "144/TALK",
            "narrator": "透明真幌",
            "text": "だから、早く食って、\nおまえも訓練に戻れ！",
            "zh": "所以，赶紧吃完，\n你也给我回去训练！",
            "narrator_zh": "透明真幌"
        },
        {
            "location": "147/TALK",
            "narrator": "透明みやび",
            "text": "はぁ…堂々としてれば\n平気かと思うたけんど、\n無理やったか…。",
            "zh": "唉……还以为摆出一副\n理直气壮的样子就能没事，\n果然还是不行咩……",
            "narrator_zh": "透明雅"
        }
    ]
}
