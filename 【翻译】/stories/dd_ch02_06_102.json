{
    "dir": "chap06/daydra/dd_ch02_06_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "6205",
        "cid": "ayami",
        "title": "005 メインストーリー",
        "sub_title": "出陣【Case：アーヤ】＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "出击【Case：绫水】＜后篇＞"
    },
    "entry": [
        {
            "location": "256/SCENARIO",
            "narrator": "",
            "text": "出陣【アーヤから見たCase】",
            "zh": "出击【从绫水眼中看到的Case】",
            "narrator_zh": ""
        },
        {
            "location": "294/TALK",
            "narrator": "アーヤ",
            "text": "…まあ、実際問題\nあの人に協力を\n頼もうと思っても――",
            "zh": "……嘛，实际上\n就算想请那个人\n帮忙——",
            "narrator_zh": "绫水"
        },
        {
            "location": "295/TALK",
            "narrator": "アーヤ",
            "text": "電話に出ないから、\n無理な話よね。",
            "zh": "电话也不接，\n根本不可能。",
            "narrator_zh": "绫水"
        },
        {
            "location": "296/TALK",
            "narrator": "アーヤ",
            "text": "まったく…、\n何のためにスマホ\n持ってるのかしら？",
            "zh": "真是的……，\n手机是为了什么\n带着的？",
            "narrator_zh": "绫水"
        },
        {
            "location": "299/TALK",
            "narrator": "ガブリエラ",
            "text": "…っていうか、あんたが\n言うな、って話よね。",
            "zh": "……话说，轮不到\n你来说吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "301/TALK",
            "narrator": "つばめ",
            "text": "え？",
            "zh": "诶？",
            "narrator_zh": "燕"
        },
        {
            "location": "302/TALK",
            "narrator": "ガブリエラ",
            "text": "フェノメノンの中で、\n生身で発症者と戦って――",
            "zh": "在PhenoMENON里，\n以肉身和发病者战斗——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "303/TALK",
            "narrator": "ガブリエラ",
            "text": "素手でクランを引き剥がす\nなんて芸当、あたし達でも\nできないわ。",
            "zh": "徒手把库兰扯下来，\n这种本事，我们\n也做不到。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "306/TALK",
            "narrator": "ガブリエラ",
            "text": "そんなあんたに、\n強いとか言われてもね。",
            "zh": "你这样的人，\n还说别人强。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "307/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィ、そういう\n言い方しないの。",
            "zh": "加维，别用\n那种说法。",
            "narrator_zh": "绫水"
        },
        {
            "location": "310/TALK",
            "narrator": "ガブリエラ",
            "text": "だって本当のことじゃん。",
            "zh": "可这就是事实。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "312/TALK",
            "narrator": "アーヤ",
            "text": "…ギャヴィは、\nちょっと逢瀬さんを\n警戒し過ぎね。",
            "zh": "……加维对逢濑\n警戒得\n有点过头。",
            "narrator_zh": "绫水"
        },
        {
            "location": "315/TALK",
            "narrator": "アーヤ",
            "text": "気持ちはわからなくも\nないけど――",
            "zh": "心情也不是\n不能理解——",
            "narrator_zh": "绫水"
        },
        {
            "location": "317/TALK",
            "narrator": "アーヤ",
            "text": "これじゃ、お互いの\n足を引っ張ることに\nなるかもしれないわ。",
            "zh": "这样下去，也许会\n互相\n拖后腿。",
            "narrator_zh": "绫水"
        },
        {
            "location": "318/TALK",
            "narrator": "アーヤ",
            "text": "どうにかしないと…。",
            "zh": "得想点办法……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "319/TALK",
            "narrator": "みやび",
            "text": "ふぁ～…歩いても歩いても\n到着せんなぁ…。",
            "zh": "哈啊……走啊走啊\n还到不了……。",
            "narrator_zh": "雅"
        },
        {
            "location": "321/TALK",
            "narrator": "アーヤ",
            "text": "…みやびに協力を\n頼むのは、無理そうね。",
            "zh": "……请雅帮忙，\n看来也不行。",
            "narrator_zh": "绫水"
        },
        {
            "location": "324/TALK",
            "narrator": "アーヤ",
            "text": "これからもう一人\n増えることを\n考えると――",
            "zh": "想到以后还要\n再增加一个人\n——",
            "narrator_zh": "绫水"
        },
        {
            "location": "326/TALK",
            "narrator": "アーヤ",
            "text": "今のうちに、二人の\n仲を取り持っておき\nたいところだけど…。",
            "zh": "想趁现在，把她们两个\n的关系\n撮合好……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "327/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "331/TALK",
            "narrator": "アーヤ",
            "text": "頭が痛い(；´Д｀)",
            "zh": "头疼(；´Д｀)",
            "narrator_zh": "绫水"
        },
        {
            "location": "332/TALK",
            "narrator": "アーヤ",
            "text": "どうしてこんなにまとまらないの？",
            "zh": "为什么这么聚不拢？",
            "narrator_zh": "绫水"
        },
        {
            "location": "333/TALK",
            "narrator": "アーヤ",
            "text": "みんなバラバラ",
            "zh": "大家各走各的",
            "narrator_zh": "绫水"
        },
        {
            "location": "334/TALK",
            "narrator": "アーヤ",
            "text": "どうしたらいいの？(；´Д｀)",
            "zh": "该怎么办？(；´Д｀)",
            "narrator_zh": "绫水"
        },
        {
            "location": "336/SEL",
            "narrator": "",
            "text": "落ち着いて",
            "zh": "冷静点",
            "narrator_zh": ""
        },
        {
            "location": "337/ACT",
            "narrator": "",
            "text": "落ち着いて",
            "zh": "冷静点",
            "narrator_zh": ""
        },
        {
            "location": "339/TALK",
            "narrator": "アーヤ",
            "text": "別に慌ててない",
            "zh": "我没慌",
            "narrator_zh": "绫水"
        },
        {
            "location": "340/TALK",
            "narrator": "アーヤ",
            "text": "困ってるだけ(´o｀；",
            "zh": "只是为难(´o｀；",
            "narrator_zh": "绫水"
        },
        {
            "location": "341/TALK",
            "narrator": "アーヤ",
            "text": "逢瀬さんとギャヴィを仲良くさせる方法がわからなくて",
            "zh": "不知道怎么让逢濑和加维和好",
            "narrator_zh": "绫水"
        },
        {
            "location": "342/TALK",
            "narrator": "アーヤ",
            "text": "本当、頭が痛い(ノД`)",
            "zh": "真的，头疼(ノД`)",
            "narrator_zh": "绫水"
        },
        {
            "location": "344/SEL",
            "narrator": "",
            "text": "子供じゃないんだ、見守れ",
            "zh": "又不是小孩，看着就行",
            "narrator_zh": ""
        },
        {
            "location": "345/SEL",
            "narrator": "",
            "text": "命令すれば？",
            "zh": "下命令呢？",
            "narrator_zh": ""
        },
        {
            "location": "346/ACT",
            "narrator": "",
            "text": "子供じゃないんだ、見守れ",
            "zh": "又不是小孩，看着就行",
            "narrator_zh": ""
        },
        {
            "location": "347/TALK",
            "narrator": "アーヤ",
            "text": "見守った結果",
            "zh": "看着的结果",
            "narrator_zh": "绫水"
        },
        {
            "location": "348/TALK",
            "narrator": "アーヤ",
            "text": "更に悪化したら？",
            "zh": "要是更糟呢？",
            "narrator_zh": "绫水"
        },
        {
            "location": "349/TALK",
            "narrator": "アーヤ",
            "text": "その可能性の方が高いと思うし",
            "zh": "我觉得那种可能更高",
            "narrator_zh": "绫水"
        },
        {
            "location": "350/ACT",
            "narrator": "",
            "text": "命令すれば？",
            "zh": "下命令呢？",
            "narrator_zh": ""
        },
        {
            "location": "351/TALK",
            "narrator": "アーヤ",
            "text": "絶対逆効果だと思う(-ω-;)",
            "zh": "绝对会适得其反(-ω-;)",
            "narrator_zh": "绫水"
        },
        {
            "location": "352/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィの性格知らな過ぎ",
            "zh": "太不了解加维的性格了",
            "narrator_zh": "绫水"
        },
        {
            "location": "353/TALK",
            "narrator": "アーヤ",
            "text": "そんなこと言ったらキレて",
            "zh": "那么说她会发火",
            "narrator_zh": "绫水"
        },
        {
            "location": "354/TALK",
            "narrator": "アーヤ",
            "text": "余計逢瀬さんに当たるようになるから",
            "zh": "会更加迁怒逢濑",
            "narrator_zh": "绫水"
        },
        {
            "location": "359/TALK",
            "narrator": "アーヤ",
            "text": "Ｂｏｔに愚痴ってたって、\n答えは出ないわね。",
            "zh": "跟Bot抱怨，\n也得不出答案。",
            "narrator_zh": "绫水"
        },
        {
            "location": "386/TALK",
            "narrator": "つばめ",
            "text": "あの、せんぱい。",
            "zh": "那个，前辈。",
            "narrator_zh": "燕"
        },
        {
            "location": "388/TALK",
            "narrator": "ガブリエラ",
            "text": "…何よ？",
            "zh": "……什么？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "389/TALK",
            "narrator": "つばめ",
            "text": "え、えっと…。",
            "zh": "诶，那个……。",
            "narrator_zh": "燕"
        },
        {
            "location": "390/TALK",
            "narrator": "つばめ",
            "text": "…よかったら、\nわたしと手を繋いで\nもらえませんか？",
            "zh": "……可以的话，\n能和我\n牵手吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "391/TALK",
            "narrator": "アーヤ",
            "text": "えっ！？",
            "zh": "诶！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "392/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "395/TALK",
            "narrator": "ガブリエラ",
            "text": "は？　いや、何？\n急に何言い出すの？",
            "zh": "哈？　不对，什么？\n突然说什么？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "397/TALK",
            "narrator": "つばめ",
            "text": "だ、だって、こんな\n不気味なところ\n歩いてると――",
            "zh": "因、因为，在这种\n阴森的地方\n走着——",
            "narrator_zh": "燕"
        },
        {
            "location": "398/TALK",
            "narrator": "つばめ",
            "text": "何か不安な気持ちに\nなってくるじゃない\nですか。",
            "zh": "心里会变得\n不安，\n不是吗。",
            "narrator_zh": "燕"
        },
        {
            "location": "399/TALK",
            "narrator": "つばめ",
            "text": "だから、よかったら\n手を握ってもらえたら\n嬉しいなぁ、って…。",
            "zh": "所以，可以的话\n能握住手\n就好了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "401/TALK",
            "narrator": "アーヤ",
            "text": "…逢瀬さんって、\n凄い子かも。",
            "zh": "……逢濑，\n也许是个了不起的孩子。",
            "narrator_zh": "绫水"
        },
        {
            "location": "402/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィが逢瀬さんを\n警戒してるのは\n明らかなのに――",
            "zh": "加维在警戒逢濑，\n这是\n明摆着的——",
            "narrator_zh": "绫水"
        },
        {
            "location": "404/TALK",
            "narrator": "アーヤ",
            "text": "それでも行動を\n起こすなんて…。",
            "zh": "即便如此还是\n采取行动……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "405/TALK",
            "narrator": "アーヤ",
            "text": "…リーダーのくせに、\n私ったら何を怖気つい\nてるのかしら。",
            "zh": "……身为队长，\n我到底在\n害怕什么。",
            "narrator_zh": "绫水"
        },
        {
            "location": "407/TALK",
            "narrator": "アーヤ",
            "text": "…まさか、新入りの\n仲間に気付かされるなんて\n思わなかったわ。",
            "zh": "……没想到，会被\n新来的同伴\n点醒。",
            "narrator_zh": "绫水"
        },
        {
            "location": "408/TALK",
            "narrator": "アーヤ",
            "text": "私も逢瀬さん\nみたいに――",
            "zh": "我也要像逢濑\n那样——",
            "narrator_zh": "绫水"
        },
        {
            "location": "410/TALK",
            "narrator": "アーヤ",
            "text": "勇気を出して、一歩を\n踏み出さなくちゃ！",
            "zh": "拿出勇气，\n迈出一步！",
            "narrator_zh": "绫水"
        },
        {
            "location": "444/TALK",
            "narrator": "アーヤ",
            "text": "…そろそろ出口ね。",
            "zh": "……快到出口了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "445/TALK",
            "narrator": "アーヤ",
            "text": "各自、準備はいい？\n行くわよ！",
            "zh": "大家，准备好了吗？\n走了！",
            "narrator_zh": "绫水"
        },
        {
            "location": "446/TALK",
            "narrator": "アーヤ",
            "text": "今日はいつも以上に\n集中して、全力で\n戦ってやるわ！",
            "zh": "今天要比平时\n更集中，全力\n战斗！",
            "narrator_zh": "绫水"
        },
        {
            "location": "457/DIALOG",
            "narrator": "Dialog_chapter_ch02",
            "text": "【04 レッドサイト】",
            "zh": "【04 赤红视线】",
            "narrator_zh": "Dialog_chapter_ch02"
        }
    ]
}
