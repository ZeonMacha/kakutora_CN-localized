            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "187/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "188/TALK",
            "narrator": "ガブリエラ",
            "text": "なんか、さっきまでの\n寂しい気持ち、\n消えちゃったな…。",
            "zh": "总觉得，刚才为止那种\n寂寞的心情，\n一下子消失了呢……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "189/TALK",
            "narrator": "ガブリエラ",
            "text": "今は、なんとなくだけど\n満足した気持ちになってる\nような…？",
            "zh": "现在虽然说不上来为什么，\n但总感觉心里\n挺满足的……？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "190/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "191/TALK",
            "narrator": "ガブリエラ",
            "text": "やっぱり、あたしが\n一番連絡を取りたいと\n思ってる相手は――",
            "zh": "果然，我最想\n联系上的\n那个人——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "192/TALK",
            "narrator": "ガブリエラ",
            "text": "$handle$、って\nことなのかしら…？",
            "zh": "指的就是$handle$，\n对吧……？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "195/TALK",
            "narrator": "ガブリエラ",
            "text": "$handle$は",
            "zh": "$handle$",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "198/TALK",
            "narrator": "ガブリエラ",
            "text": "とっても大切で",
            "zh": "对我来说是非常重要",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "199/TALK",
            "narrator": "ガブリエラ",
            "text": "特別な人よ",
            "zh": "非常特别的人哦",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "201/SEL",
            "narrator": "",
            "text": "光栄だよ",
            "zh": "我很荣幸",
            "narrator_zh": ""
        },
        {
            "location": "202/SEL",
            "narrator": "",
            "text": "ガブリエラも特別な存在だ",
            "zh": "加布里埃拉也是特别的存在",
            "narrator_zh": ""
        },
        {
            "location": "203/ACT",
            "narrator": "",
            "text": "光栄だよ",
            "zh": "我很荣幸",
            "narrator_zh": ""
        },
