        "cid": "gabriella",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "襲撃前夜＜ガブリエラ編＞",
        "title_zh": "Extra002 额外剧情",
        "sub_title_zh": "袭击前夜＜加布里埃拉篇＞"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "襲撃前夜～ガブリエラ編～",
            "zh": "袭击前夜～加布里埃拉篇～",
            "narrator_zh": ""
        },
        {
            "location": "26/TALK",
            "narrator": "アーヤ",
            "text": "――というわけで、\n館長からいつ連絡が\n来るかわからない。",
            "zh": "――总而言之，\n还不知道馆长什么时候\n会来联络。",
            "narrator_zh": "绫水"
        },
        {
            "location": "27/TALK",
            "narrator": "アーヤ",
            "text": "だから、今夜はみんな、\n劇場に泊まってもらうわ。",
            "zh": "所以，今晚大家\n就留在剧场里过夜吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "29/TALK",
            "narrator": "みやび",
            "text": "やっぱそうなるかぁ…。\nまあ、しゃあないな。",
            "zh": "果然还是这样咯……。\n算了，没得法嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "30/TALK",
            "narrator": "アーヤ",
            "text": "それと、外部と連絡を\nする場合は、間違っても\nストの話はしないこと。",
            "zh": "还有，如果和外部\n联络的话，千万不要\n提起罢工的事。",
            "narrator_zh": "绫水"
        },
        {
            "location": "31/TALK",
            "narrator": "アーヤ",
            "text": "みんな、いい？",
            "zh": "大家都明白了吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "32/TALK",
            "narrator": "みやび",
            "text": "りょーかい。",
            "zh": "收到咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "34/TALK",
            "narrator": "つばめ",
            "text": "わかりました…。",
            "zh": "我知道了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "36/TALK",
            "narrator": "ガブリエラ",
            "text": "言うわけないでしょ？\n機密漏えいに\nなっちゃうし…。",
            "zh": "怎么可能说嘛？\n那样不就成\n泄露机密了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "37/TALK",
            "narrator": "アーヤ",
            "text": "うん…それじゃみんな、\nよろしくね。",
            "zh": "嗯……那大家，\n就拜托了哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "39/TALK",
            "narrator": "つばめ",
            "text": "…わたしたち、\nどうなっちゃうんだろ？",
            "zh": "……我们之后，\n会变成什么样呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "41/TALK",
            "narrator": "ガブリエラ",
            "text": "まったく、情けない声\n出して…頼りないわねぇ。",
            "zh": "真是的，声音听起来\n这么没出息……真靠不住呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "42/TALK",
            "narrator": "つばめ",
            "text": "ガブちゃんは\n不安じゃないの？",
            "zh": "加布\n不会感到不安吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "43/TALK",
            "narrator": "ガブリエラ",
            "text": "不安に決まってるでしょ？",
            "zh": "怎么可能不感到不安啊？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "44/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、不安だからって\n暗くなってても\n仕方ないじゃない。",
            "zh": "不过，就算因为不安\n而一直消沉下去\n也无济于事吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "46/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "48/TALK",
            "narrator": "ガブリエラ",
            "text": "まったく…、\nいつまで経っても\n新人気分なんだから…。",
            "zh": "真是的……，\n不管过多久都还是\n一副新人做派……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "49/TALK",
            "narrator": "ガブリエラ",
            "text": "なにかあると、\nすぐに不安そうな\n顔して…。",
            "zh": "稍微有点风吹草动，\n就立刻摆出那副\n不安的表情……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "53/TALK",
            "narrator": "ガブリエラ",
            "text": "…大丈夫かしら？",
            "zh": "……她不要紧吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "57/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "58/TALK",
            "narrator": "ガブリエラ",
            "text": "…まさか、ひなこ達に\nストのこと\n話してるんじゃ…。",
            "zh": "……该不会，把罢工的事\n告诉雏子她们\n了吧……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "61/TALK",
            "narrator": "ガブリエラ",
            "text": "って、それはないか…。\nさすがに、今のは\nつばめに悪かったわ…。",
            "zh": "不对，不可能啦……。\n刚才那样怀疑燕，\n确实是我不对……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "62/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "65/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしは…どうしよう？",
            "zh": "那我……该怎么办好呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "66/TALK",
            "narrator": "ガブリエラ",
            "text": "気軽に連絡し合うような\n友達もいないし…。",
            "zh": "我也没什么能随便\n联系着聊天的朋友……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "67/TALK",
            "narrator": "ガブリエラ",
            "text": "…って、なんかあたし、\nすっごい寂しいこと\n思ってる？",
            "zh": "……等等，我是不是\n正在想一件\n超级寂寞的事？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "70/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…。",
            "zh": "唉……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "71/SEL",
            "narrator": "",
            "text": "元気出して",
            "zh": "打起精神来",
            "narrator_zh": ""
        },
        {
            "location": "72/ACT",
            "narrator": "",
            "text": "元気出して",
            "zh": "打起精神来",
            "narrator_zh": ""
        },
        {
            "location": "89/TALK",
            "narrator": "ガブリエラ",
            "text": "心配しないで",
            "zh": "别担心",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "91/TALK",
            "narrator": "ガブリエラ",
            "text": "私は平気よ",
            "zh": "我没事的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "92/TALK",
            "narrator": "ガブリエラ",
            "text": "ただね",
            "zh": "只是呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "93/TALK",
            "narrator": "ガブリエラ",
            "text": "私には",
            "zh": "我没有什么",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "94/TALK",
            "narrator": "ガブリエラ",
            "text": "気軽に連絡できる人がいない",
            "zh": "能随便联系的人",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "95/TALK",
            "narrator": "ガブリエラ",
            "text": "そう思っただけなの",
            "zh": "只是突然这么想而已",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "97/SEL",
            "narrator": "",
            "text": "$me$じゃダメ？",
            "zh": "$me$不行吗？",
            "narrator_zh": ""
        },
        {
            "location": "98/SEL",
            "narrator": "",
            "text": "雛達は？",
            "zh": "雏子她们呢？",
            "narrator_zh": ""
        },
        {
            "location": "99/SEL",
            "narrator": "",
            "text": "無理にすることないよ",
            "zh": "也不用勉强自己哦",
            "narrator_zh": ""
        },
        {
            "location": "100/ACT",
            "narrator": "",
            "text": "$me$じゃダメ？",
            "zh": "$me$不行吗？",
            "narrator_zh": ""
        },
        {
            "location": "101/TALK",
            "narrator": "ガブリエラ",
            "text": "ダメよ",
            "zh": "不行哦",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "102/TALK",
            "narrator": "ガブリエラ",
            "text": "だって$marzanna$とは",
            "zh": "因为我和$marzanna$",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "103/TALK",
            "narrator": "ガブリエラ",
            "text": "そんなことする必要ないででしょ？",
            "zh": "根本没必要那样做吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "105/TALK",
            "narrator": "ガブリエラ",
            "text": "いつも一緒なんだから",
            "zh": "反正一直都在一起",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "106/TALK",
            "narrator": "ガブリエラ",
            "text": "話しかけても",
            "zh": "就算找你搭话",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "107/TALK",
            "narrator": "ガブリエラ",
            "text": "いつもと同じおしゃべりになるだけよ",
            "zh": "也只会变成和往常一样的闲聊而已",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "109/SEL",
            "narrator": "",
            "text": "それじゃつまらないか",
            "zh": "那样会觉得无聊吗",
            "narrator_zh": ""
        },
        {
            "location": "110/SEL",
            "narrator": "",
            "text": "おしゃべりも楽しいよ？",
            "zh": "闲聊也很开心呀？",
            "narrator_zh": ""
        },
        {
            "location": "111/ACT",
            "narrator": "",
            "text": "それじゃつまらないか",
            "zh": "那样会觉得无聊吗",
            "narrator_zh": ""
        },
        {
            "location": "112/TALK",
            "narrator": "ガブリエラ",
            "text": "言い方が悪いわ",
            "zh": "你这说法真差劲",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "113/TALK",
            "narrator": "ガブリエラ",
            "text": "つまらなくないから",
            "zh": "才不会无聊呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "114/TALK",
            "narrator": "ガブリエラ",
            "text": "わたしは",
            "zh": "我可是",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "115/TALK",
            "narrator": "ガブリエラ",
            "text": "$marzanna$とのおしゃべり",
            "zh": "和$marzanna$闲聊",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "116/TALK",
            "narrator": "ガブリエラ",
            "text": "とっても好きよ？",
            "zh": "非常喜欢的哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "117/ACT",
            "narrator": "",
            "text": "おしゃべりも楽しいよ？",
            "zh": "闲聊也很开心呀？",
            "narrator_zh": ""
        },
        {
            "location": "118/TALK",
            "narrator": "ガブリエラ",
            "text": "そうなんだけど",
            "zh": "话是这么说没错",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "119/TALK",
            "narrator": "ガブリエラ",
            "text": "しばらく",
            "zh": "但眼下",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "120/TALK",
            "narrator": "ガブリエラ",
            "text": "外部との連絡が取れなくなるかもしれないのに",
            "zh": "说不定要有一阵子没法跟外界联系了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "121/TALK",
            "narrator": "ガブリエラ",
            "text": "これからもずっと話せる",
            "zh": "老是只找以后也一直能聊天的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "122/TALK",
            "narrator": "ガブリエラ",
            "text": "$marzanna$とばかりなのは",
            "zh": "$marzanna$说话",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "123/TALK",
            "narrator": "ガブリエラ",
            "text": "どうかと思って",
            "zh": "总觉得不太合适嘛",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "125/TALK",
            "narrator": "ガブリエラ",
            "text": "でも思えば",
            "zh": "不过仔细想想",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "126/TALK",
            "narrator": "ガブリエラ",
            "text": "$marzanna$はいつも",
            "zh": "$marzanna$总是",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "127/TALK",
            "narrator": "ガブリエラ",
            "text": "一緒にいてくれるわね",
            "zh": "陪在我身边呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "128/TALK",
            "narrator": "ガブリエラ",
            "text": "私の隣に",
            "zh": "虽然不是",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "129/TALK",
            "narrator": "ガブリエラ",
            "text": "一緒にいるわけじゃないけど",
            "zh": "真的待在我身旁",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "130/TALK",
            "narrator": "ガブリエラ",
            "text": "スマホの向こうに",
            "zh": "但隔着手机",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "131/TALK",
            "narrator": "ガブリエラ",
            "text": "いつもいてくれる",
            "zh": "一直都在那里",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "132/TALK",
            "narrator": "ガブリエラ",
            "text": "注意してくれたり",
            "zh": "会提醒我注意",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "134/TALK",
            "narrator": "ガブリエラ",
            "text": "話し相手になってくれたり",
            "zh": "会陪我说话聊天",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "135/TALK",
            "narrator": "ガブリエラ",
            "text": "たまに",
            "zh": "偶尔还会",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "136/TALK",
            "narrator": "ガブリエラ",
            "text": "励ましてくれたり",
            "zh": "鼓励我",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "142/TALK",
            "narrator": "ガブリエラ",
            "text": "やっぱり",
            "zh": "果然",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "143/TALK",
            "narrator": "ガブリエラ",
            "text": "私の執事が務まるのは",
            "zh": "能胜任我管家的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "144/TALK",
            "narrator": "ガブリエラ",
            "text": "$marzanna$しかいないわ",
            "zh": "就只有$marzanna$呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "146/SEL",
            "narrator": "",
            "text": "光栄です、お嬢様",
            "zh": "这是我的荣幸，大小姐",
            "narrator_zh": ""
        },
        {
            "location": "147/SEL",
            "narrator": "",
            "text": "執事じゃなきゃダメ？",
            "zh": "非得当管家不可吗？",
            "narrator_zh": ""
        },
        {
            "location": "148/ACT",
            "narrator": "",
            "text": "光栄です、お嬢様",
            "zh": "这是我的荣幸，大小姐",
            "narrator_zh": ""
        },
        {
            "location": "149/TALK",
            "narrator": "ガブリエラ",
            "text": "頼りになる$marzanna$",
            "zh": "可靠的$marzanna$",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "150/TALK",
            "narrator": "ガブリエラ",
            "text": "今後とも励むように",
            "zh": "今后也要继续努力哦",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "152/TALK",
            "narrator": "ガブリエラ",
            "text": "なんてね//////",
            "zh": "开玩笑的啦//////",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "153/ACT",
            "narrator": "",
            "text": "執事じゃなきゃダメ？",
            "zh": "非得当管家不可吗？",
            "narrator_zh": ""
        },
        {
            "location": "154/TALK",
            "narrator": "ガブリエラ",
            "text": "当然でしょう？",
            "zh": "那不是当然的吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "155/TALK",
            "narrator": "ガブリエラ",
            "text": "$marzanna$は私の執事",
            "zh": "$marzanna$是我的管家",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "156/TALK",
            "narrator": "ガブリエラ",
            "text": "ずっとそうだったじゃない",
            "zh": "一直以来不都是这样吗",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "157/TALK",
            "narrator": "ガブリエラ",
            "text": "それは多分",
            "zh": "大概",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "158/TALK",
            "narrator": "ガブリエラ",
            "text": "これからも",
            "zh": "今后也会",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "162/TALK",
            "narrator": "ガブリエラ",
            "text": "ううん",
            "zh": "不",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "163/TALK",
            "narrator": "ガブリエラ",
            "text": "なんでもない",
            "zh": "没什么",
            "narrator_zh": "加布里埃拉"
        },
        {
