            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "239/ACT",
            "narrator": "",
            "text": "雛達は？",
            "zh": "雏子她们呢？",
            "narrator_zh": ""
        },
        {
            "location": "240/TALK",
            "narrator": "ガブリエラ",
            "text": "ひなこたち？",
