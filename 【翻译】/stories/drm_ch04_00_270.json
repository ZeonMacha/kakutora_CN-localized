        "title": "らぶとーく 第27話",
        "sub_title": "ハッカーの良心などという宣言",
        "title_zh": "恋爱漫谈 第27话",
        "sub_title_zh": "所谓黑客良心之类的宣言"
    },
    "entry": [
        {
            "location": "513/SCENARIO",
            "narrator": "",
            "text": "ハッカーの良心などという宣言",
            "zh": "所谓黑客良心之类的宣言",
            "narrator_zh": ""
        },
        {
            "location": "523/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "535/TALK",
            "narrator": "みやび",
            "text": "暇人参上！",
            "zh": "闲人驾到！",
            "narrator_zh": "雅"
        },
        {
            "location": "536/TALK",
            "narrator": "みやび",
            "text": "どうする？",
            "zh": "怎么办？",
            "narrator_zh": "雅"
        },
        {
            "location": "538/SEL",
            "narrator": "",
            "text": "お話でもする？",
            "zh": "要不要聊聊天？",
            "narrator_zh": ""
        },
        {
            "location": "539/SEL",
            "narrator": "",
            "text": "バイトは？",
            "zh": "打工呢？",
            "narrator_zh": ""
        },
        {
            "location": "540/SEL",
            "narrator": "",
            "text": "たたかう",
            "zh": "战斗",
            "narrator_zh": ""
        },
        {
            "location": "541/ACT",
            "narrator": "",
            "text": "お話でもする？",
            "zh": "要不要聊聊天？",
            "narrator_zh": ""
        },
        {
            "location": "542/TALK",
            "narrator": "みやび",
            "text": "暇つぶしにお喋り？",
            "zh": "用聊天来打发时间？",
            "narrator_zh": "雅"
        },
        {
            "location": "543/TALK",
            "narrator": "みやび",
            "text": "ワンパターン過ぎや",
            "zh": "套路也太单一了咯",
            "narrator_zh": "雅"
        },
        {
            "location": "544/TALK",
            "narrator": "みやび",
            "text": "萎える",
            "zh": "真扫兴",
            "narrator_zh": "雅"
        },
        {
            "location": "546/TALK",
            "narrator": "みやび",
            "text": "ショボーン",
            "zh": "蔫了",
            "narrator_zh": "雅"
        },
        {
            "location": "547/ACT",
            "narrator": "",
            "text": "バイトは？",
            "zh": "打工呢？",
            "narrator_zh": ""
        },
        {
            "location": "548/TALK",
            "narrator": "みやび",
            "text": "作業は終えた",
            "zh": "活儿干完了",
            "narrator_zh": "雅"
        },
        {
            "location": "549/TALK",
            "narrator": "みやび",
            "text": "やることないから待機中",
            "zh": "没事可做，待机中",
            "narrator_zh": "雅"
        },
        {
            "location": "550/TALK",
            "narrator": "みやび",
            "text": "仕事が来るまで待ってるだけの精神的に辛いお仕事です",
            "zh": "这是一份只能等工作上门、精神上很煎熬的工作",
            "narrator_zh": "雅"
        },
        {
            "location": "551/ACT",
            "narrator": "",
            "text": "たたかう",
            "zh": "战斗",
            "narrator_zh": ""
        },
        {
            "location": "552/TALK",
            "narrator": "みやび",
            "text": "相棒の攻撃",
            "zh": "搭档的攻击",
            "narrator_zh": "雅"
        },
        {
            "location": "553/TALK",
            "narrator": "みやび",
            "text": "うちの暇にはダメージを与えられん",
            "zh": "没法给我这份闲造成伤害",
            "narrator_zh": "雅"
        },
        {
            "location": "554/TALK",
            "narrator": "みやび",
            "text": "ダメやったね",
            "zh": "不行咯",
            "narrator_zh": "雅"
        },
        {
            "location": "556/TALK",
            "narrator": "みやび",
            "text": "おっ",
            "zh": "哦",
            "narrator_zh": "雅"
        },
        {
            "location": "557/TALK",
            "narrator": "みやび",
            "text": "ちっくと待ちぃ",
            "zh": "等子咯",
            "narrator_zh": "雅"
        },
        {
            "location": "575/TALK",
            "narrator": "つばめ",
            "text": "あっ、みやびさん。\nお疲れ様です。",
            "zh": "啊，雅。\n辛苦了。",
            "narrator_zh": "燕"
        },
        {
            "location": "577/TALK",
            "narrator": "みやび",
            "text": "つばめちゃん、\nえいところに来た。",
            "zh": "燕，\n来得正好嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "578/TALK",
            "narrator": "みやび",
            "text": "今な、相棒と会話しゆう\nところなんやが――",
            "zh": "现在呢，我正跟搭档\n聊着天——",
            "narrator_zh": "雅"
        },
        {
            "location": "579/TALK",
            "narrator": "みやび",
            "text": "つばめちゃんも一緒に\n入ってくれんか？",
            "zh": "燕也一起\n加进来吧？",
            "narrator_zh": "雅"
        },
        {
            "location": "580/TALK",
            "narrator": "つばめ",
            "text": "え？　わたしもですか？",
            "zh": "诶？　我也要吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "581/TALK",
            "narrator": "みやび",
            "text": "うん",
            "zh": "嗯",
            "narrator_zh": "雅"
        },
        {
            "location": "582/TALK",
            "narrator": "みやび",
            "text": "まあ、ちっくと興味が\nあってな…。",
            "zh": "嘛，就是有点\n兴趣……。",
            "narrator_zh": "雅"
        },
        {
            "location": "583/TALK",
            "narrator": "みやび",
            "text": "やき、ちっくとでえいき、\n入ってくれんか？",
            "zh": "嘛，就一小会儿，\n进来一下得不得？",
            "narrator_zh": "雅"
        },
        {
            "location": "585/TALK",
            "narrator": "つばめ",
            "text": "それはまあ、構いません\nけど…。",
            "zh": "那个嘛，我不介意\n啦……。",
            "narrator_zh": "燕"
        },
        {
            "location": "587/TALK",
            "narrator": "みやび",
            "text": "よし、決まりや。",
            "zh": "好，就这么定了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "593/TALK",
            "narrator": "みやび",
            "text": "ちゅうわけやき",
            "zh": "所以就是这样嘛",
            "narrator_zh": "雅"
        },
        {
            "location": "594/TALK",
            "narrator": "みやび",
            "text": "今からつばめちゃんも来るちや",
            "zh": "现在燕也要来了滴",
            "narrator_zh": "雅"
        },
        {
            "location": "596/SEL",
            "narrator": "",
            "text": "呼ぶ必要ないのに",
            "zh": "明明不用叫你",
            "narrator_zh": ""
        },
        {
            "location": "597/ACT",
            "narrator": "",
            "text": "呼ぶ必要ないのに",
            "zh": "明明不用叫你",
            "narrator_zh": ""
        },
        {
            "location": "599/TALK",
            "narrator": "みやび",
            "text": "うちにはある",
            "zh": "我有必要",
            "narrator_zh": "雅"
        },
        {
            "location": "600/TALK",
            "narrator": "みやび",
            "text": "あるから呼んだ",
            "zh": "有所以才叫",
            "narrator_zh": "雅"
        },
        {
            "location": "602/TALK",
            "narrator": "システム",
            "text": "『つばめさんが入室しました』",
            "zh": "『燕已进入房间』",
            "narrator_zh": "系统"
        },
        {
            "location": "603/TALK",
            "narrator": "つばめ",
            "text": "おじゃまします",
            "zh": "打扰了",
            "narrator_zh": "燕"
        },
        {
            "location": "605/TALK",
            "narrator": "みやび",
            "text": "つばめちゃん参上",
            "zh": "燕登场",
            "narrator_zh": "雅"
        },
        {
            "location": "607/SEL",
            "narrator": "",
            "text": "こんにちは",
            "zh": "你好",
            "narrator_zh": ""
        },
        {
            "location": "608/ACT",
            "narrator": "",
            "text": "こんにちは",
            "zh": "你好",
            "narrator_zh": ""
        },
        {
            "location": "610/TALK",
            "narrator": "つばめ",
            "text": "こんにちは、$handle$さん",
            "zh": "你好，$handle$",
            "narrator_zh": "燕"
        },
        {
            "location": "611/TALK",
            "narrator": "つばめ",
            "text": "それでみやびさん",
            "zh": "那雅小姐呢",
            "narrator_zh": "燕"
        },
        {
            "location": "612/TALK",
            "narrator": "つばめ",
            "text": "どういう用事ですか",
            "zh": "是什么事呢",
            "narrator_zh": "燕"
        },
        {
            "location": "614/TALK",
            "narrator": "みやび",
            "text": "難しいことやない",
            "zh": "不是什么难事",
            "narrator_zh": "雅"
        },
        {
            "location": "615/TALK",
            "narrator": "みやび",
            "text": "普段通りにお喋りしてえいよ",
            "zh": "照常聊天就得咧",
            "narrator_zh": "雅"
        },
        {
            "location": "616/TALK",
            "narrator": "つばめ",
            "text": "そう言われても",
            "zh": "就算你这么说",
            "narrator_zh": "燕"
        },
        {
            "location": "617/TALK",
            "narrator": "つばめ",
            "text": "今は話題もないですし",
            "zh": "现在也没什么话题，",
            "narrator_zh": "燕"
        },
        {
            "location": "619/TALK",
            "narrator": "みやび",
            "text": "暇つぶしの雑談でもえいき",
            "zh": "闲聊打发时间也好嘛",
            "narrator_zh": "雅"
        },
        {
            "location": "620/TALK",
            "narrator": "みやび",
            "text": "楽しもう",
            "zh": "开心点吧",
            "narrator_zh": "雅"
        },
        {
            "location": "621/TALK",
            "narrator": "つばめ",
            "text": "雑談ですか",
            "zh": "闲聊吗",
            "narrator_zh": "燕"
        },
        {
            "location": "622/TALK",
            "narrator": "つばめ",
            "text": "頑張ってみます",
            "zh": "我努力试试",
            "narrator_zh": "燕"
        },
        {
            "location": "625/SEL",
            "narrator": "",
            "text": "困るよね",
            "zh": "确实很为难呢",
            "narrator_zh": ""
        },
        {
            "location": "626/SEL",
            "narrator": "",
            "text": "ちょっと付き合ってね",
            "zh": "陪我一会儿哦",
            "narrator_zh": ""
        },
        {
            "location": "627/SEL",
            "narrator": "",
            "text": "相変わらず不思議ちゃんだよね",
            "zh": "还是那么古怪呢",
            "narrator_zh": ""
        },
        {
            "location": "628/ACT",
            "narrator": "",
            "text": "困るよね",
            "zh": "确实很为难呢",
            "narrator_zh": ""
        },
        {
            "location": "629/TALK",
            "narrator": "みやび",
            "text": "待て",
            "zh": "慢着",
            "narrator_zh": "雅"
        },
        {
            "location": "631/TALK",
            "narrator": "みやび",
            "text": "何が困るのだ？",
            "zh": "有什么可为难的？",
            "narrator_zh": "雅"
        },
        {
            "location": "633/SEL",
            "narrator": "",
            "text": "つばめが困ってるでしょ？",
            "zh": "燕在为难吧？",
            "narrator_zh": ""
        },
        {
            "location": "634/ACT",
            "narrator": "",
            "text": "つばめが困ってるでしょ？",
            "zh": "燕在为难吧？",
            "narrator_zh": ""
        },
        {
            "location": "636/TALK",
            "narrator": "みやび",
            "text": "別に困るようなこと言ってない",
            "zh": "我又没说什么让人为难的话",
            "narrator_zh": "雅"
        },
        {
            "location": "637/TALK",
            "narrator": "みやび",
            "text": "雑談がそんなに難しいか？",
            "zh": "闲聊有那么难咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "638/TALK",
            "narrator": "みやび",
            "text": "これも雑談やが",
            "zh": "这也算是闲聊咯",
            "narrator_zh": "雅"
        },
        {
            "location": "640/TALK",
            "narrator": "つばめ",
            "text": "$handle$さん",
            "zh": "$handle$",
            "narrator_zh": "燕"
        },
        {
            "location": "641/TALK",
            "narrator": "つばめ",
            "text": "心配してくれてありがと",
            "zh": "谢谢你担心我",
            "narrator_zh": "燕"
        },
        {
            "location": "642/TALK",
            "narrator": "つばめ",
            "text": "でも",
            "zh": "不过",
            "narrator_zh": "燕"
        },
        {
            "location": "643/TALK",
            "narrator": "つばめ",
            "text": "全然困ってないから大丈夫だよ",
            "zh": "我完全没在为难，没事的哦",
            "narrator_zh": "燕"
        },
        {
            "location": "644/TALK",
            "narrator": "つばめ",
            "text": "それに",
            "zh": "而且",
            "narrator_zh": "燕"
        },
        {
            "location": "645/TALK",
            "narrator": "つばめ",
            "text": "みやびさんのことだから",
            "zh": "以雅的性格，",
            "narrator_zh": "燕"
        },
        {
            "location": "646/TALK",
            "narrator": "つばめ",
            "text": "きっと何か考えがあってのことだと思うし",
            "zh": "我觉得一定是有想法才这么做的",
            "narrator_zh": "燕"
        },
        {
            "location": "649/SEL",
            "narrator": "",
            "text": "つばめは良い子だ",
            "zh": "燕是个好孩子",
            "narrator_zh": ""
        },
        {
            "location": "650/ACT",
            "narrator": "",
            "text": "つばめは良い子だ",
            "zh": "燕是个好孩子",
            "narrator_zh": ""
        },
        {
            "location": "652/TALK",
            "narrator": "つばめ",
            "text": "ありがと",
            "zh": "谢谢",
            "narrator_zh": "燕"
        },
        {
            "location": "657/ACT",
            "narrator": "",
            "text": "ちょっと付き合ってね",
            "zh": "陪我一会儿哦",
            "narrator_zh": ""
        },
        {
            "location": "658/TALK",
            "narrator": "みやび",
            "text": "他人行儀な",
            "zh": "真见外啊，",
            "narrator_zh": "雅"
        },
        {
            "location": "659/TALK",
            "narrator": "みやび",
            "text": "いつまでも付き合うぞ！",
            "zh": "我会一直奉陪的咯！",
            "narrator_zh": "雅"
        },
        {
            "location": "661/SEL",
            "narrator": "",
            "text": "つばめに言ったんだけど",
            "zh": "我跟燕说过了",
            "narrator_zh": ""
        },
        {
            "location": "662/ACT",
            "narrator": "",
            "text": "つばめに言ったんだけど",
            "zh": "我跟燕说过了",
            "narrator_zh": ""
        },
        {
            "location": "664/TALK",
            "narrator": "みやび",
            "text": "うちには無しか？",
            "zh": "我是没份咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "665/TALK",
            "narrator": "みやび",
            "text": "のけ者か？",
            "zh": "把我排除在外？",
            "narrator_zh": "雅"
        },
        {
            "location": "666/TALK",
            "narrator": "みやび",
            "text": "邪魔者扱いか？",
            "zh": "被当成碍事的了咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "668/SEL",
            "narrator": "",
            "text": "そうじゃないけど、つばめを困らせてるし",
            "zh": "不是那样，但你确实在为难燕",
            "narrator_zh": ""
        },
        {
            "location": "669/ACT",
            "narrator": "",
            "text": "そうじゃないけど、つばめを困らせてるし",
            "zh": "不是那样，但你确实在为难燕",
            "narrator_zh": ""
        },
        {
            "location": "671/TALK",
            "narrator": "つばめ",
            "text": "そんなことないよ",
            "zh": "不会有那种事哦",
            "narrator_zh": "燕"
        },
        {
            "location": "672/TALK",
            "narrator": "つばめ",
            "text": "確かによくわからない行動だけど",
            "zh": "行为确实让人看不懂，",
            "narrator_zh": "燕"
        },
        {
            "location": "673/TALK",
            "narrator": "つばめ",
            "text": "それがみやびさんっぽいし",
            "zh": "不过很像雅的风格咯",
            "narrator_zh": "燕"
        },
        {
            "location": "674/TALK",
            "narrator": "つばめ",
            "text": "わたしは全然困ってないから",
            "zh": "我完全没觉得为难，",
            "narrator_zh": "燕"
        },
        {
            "location": "677/SEL",
            "narrator": "",
            "text": "気を使わせてごめん",
            "zh": "让你费心了，抱歉",
            "narrator_zh": ""
        },
        {
            "location": "678/ACT",
            "narrator": "",
            "text": "気を使わせてごめん",
            "zh": "让你费心了，抱歉",
            "narrator_zh": ""
        },
        {
            "location": "680/TALK",
            "narrator": "つばめ",
            "text": "ううん",
            "zh": "不是的",
            "narrator_zh": "燕"
        },
        {
            "location": "681/TALK",
            "narrator": "つばめ",
            "text": "$handle$さんとお話しできるの嬉しいから",
            "zh": "能跟$handle$聊上我很开心",
            "narrator_zh": "燕"
        },
        {
            "location": "682/TALK",
            "narrator": "つばめ",
            "text": "本当に気は使ってないよ",
            "zh": "真的没有费心哦",
            "narrator_zh": "燕"
        },
        {
            "location": "686/ACT",
            "narrator": "",
            "text": "相変わらず不思議ちゃんだよね",
            "zh": "还是那么古怪呢",
            "narrator_zh": ""
        },
        {
            "location": "687/TALK",
            "narrator": "みやび",
            "text": "同意",
            "zh": "同意",
            "narrator_zh": "雅"
        },
        {
            "location": "688/TALK",
            "narrator": "みやび",
            "text": "つばめちゃんの良い子さは",
            "zh": "燕的善良",
            "narrator_zh": "雅"
        },
        {
            "location": "690/TALK",
            "narrator": "みやび",
            "text": "不思議ちゃんクラス",
            "zh": "已经是古怪少女的级别咯",
            "narrator_zh": "雅"
        },
        {
            "location": "691/TALK",
            "narrator": "つばめ",
            "text": "そうなんですか？",
            "zh": "是这样吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "694/SEL",
            "narrator": "",
            "text": "いや、不思議なのはみやび",
            "zh": "不，奇怪的是雅",
            "narrator_zh": ""
        },
        {
            "location": "695/ACT",
            "narrator": "",
            "text": "いや、不思議なのはみやび",
            "zh": "不，奇怪的是雅",
            "narrator_zh": ""
        },
        {
            "location": "697/TALK",
            "narrator": "みやび",
            "text": "は？",
            "zh": "啊？",
            "narrator_zh": "雅"
        },
        {
            "location": "698/TALK",
            "narrator": "みやび",
            "text": "うちのどこが不思議？",
            "zh": "我哪里奇怪了？",
            "narrator_zh": "雅"
        },
        {
            "location": "699/TALK",
            "narrator": "みやび",
            "text": "今不思議なことしとらん",
            "zh": "现在又没做什么奇怪的事",
            "narrator_zh": "雅"
        },
        {
            "location": "701/SEL",
            "narrator": "",
            "text": "自覚無しな辺り、本物だ",
            "zh": "就这一点没自觉，才是货真价实",
            "narrator_zh": ""
        },
        {
            "location": "702/ACT",
            "narrator": "",
            "text": "自覚無しな辺り、本物だ",
            "zh": "就这一点没自觉，才是货真价实",
            "narrator_zh": ""
        },
        {
            "location": "704/TALK",
            "narrator": "みやび",
            "text": "誰が本物や",
            "zh": "谁是真货咯！",
            "narrator_zh": "雅"
        },
        {
            "location": "706/TALK",
            "narrator": "つばめ",
            "text": "あの！",
            "zh": "那个！",
            "narrator_zh": "燕"
        },
        {
            "location": "707/TALK",
            "narrator": "つばめ",
            "text": "そう思うのって",
            "zh": "这么想这件事",
            "narrator_zh": "燕"
        },
        {
            "location": "708/TALK",
            "narrator": "つばめ",
            "text": "みやびさんが凄く頭が良いからだと思います",
            "zh": "我觉得是因为雅非常聪明",
            "narrator_zh": "燕"
        },
        {
            "location": "709/TALK",
            "narrator": "つばめ",
            "text": "だから私から見ても",
            "zh": "所以在我看来",
            "narrator_zh": "燕"
        },
        {
            "location": "710/TALK",
            "narrator": "つばめ",
            "text": "不思議なくらい凄い人だなぁって",
            "zh": "会觉得她是不可思议的了不起的人",
            "narrator_zh": "燕"
        },
        {
            "location": "711/TALK",
            "narrator": "つばめ",
            "text": "思う時ありますし",
            "zh": "也有这样想的时候",
            "narrator_zh": "燕"
        },
        {
            "location": "714/SEL",
            "narrator": "",
            "text": "やっぱりつばめは良い子だ",
            "zh": "燕果然是个好孩子",
            "narrator_zh": ""
        },
        {
            "location": "715/ACT",
            "narrator": "",
            "text": "やっぱりつばめは良い子だ",
            "zh": "燕果然是个好孩子",
            "narrator_zh": ""
        },
        {
            "location": "717/TALK",
            "narrator": "つばめ",
            "text": "そうかな？",
            "zh": "是吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "718/TALK",
            "narrator": "つばめ",
            "text": "そんなことないよ",
            "zh": "不会有那种事哦",
            "narrator_zh": "燕"
        },
        {
            "location": "722/TALK",
            "narrator": "みやび",
            "text": "なんか",
            "zh": "总觉得",
            "narrator_zh": "雅"
        },
        {
            "location": "723/TALK",
            "narrator": "みやび",
            "text": "あれやね",
            "zh": "就是那个咯，",
            "narrator_zh": "雅"
        },
        {
            "location": "724/TALK",
            "narrator": "みやび",
            "text": "思うてた反応と違うわ",
            "zh": "和预想的反应不一样啊",
            "narrator_zh": "雅"
        },
        {
            "location": "725/TALK",
            "narrator": "つばめ",
            "text": "え？",
            "zh": "诶？",
            "narrator_zh": "燕"
        },
        {
            "location": "731/TALK",
            "narrator": "つばめ",
            "text": "あれ？",
            "zh": "咦？",
            "narrator_zh": "燕"
        },
        {
            "location": "735/TALK",
            "narrator": "つばめ",
            "text": "ど、どうしたんですか？\n急に退出して…。",
            "zh": "怎、怎么了？\n突然退出了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "737/TALK",
            "narrator": "みやび",
            "text": "…別に。\n雑談やき、いつ終わるのも\n自由や。",
            "zh": "……没什么。\n既然是闲聊，什么时候\n结束都随你咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "738/TALK",
            "narrator": "みやび",
            "text": "ちゅうわけで、解散や。",
            "zh": "所以就这样，散会啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "739/TALK",
            "narrator": "つばめ",
            "text": "でも、反応がどうとか\n言ってたのに、\n途中で良いんですか？",
            "zh": "不过，刚才还在说\n反应怎么样，\n中途就可以了？",
            "narrator_zh": "燕"
        },
        {
            "location": "741/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "743/TALK",
            "narrator": "みやび",
            "text": "ああ、もうえい。\nどうでもえいがよ、\nそんなもん。",
            "zh": "啊，得咧。\n怎样都无所谓咯，\n那种东西。",
            "narrator_zh": "雅"
        },
        {
            "location": "745/TALK",
            "narrator": "つばめ",
            "text": "そ、そうですか…。",
            "zh": "是、是吗……。",
            "narrator_zh": "燕"
        },
        {
            "location": "746/TALK",
            "narrator": "つばめ",
            "text": "…みやびさん、\n少し機嫌悪そうかも。",
            "zh": "……雅，\n好像有点不太高兴。",
            "narrator_zh": "燕"
        },
        {
            "location": "748/TALK",
            "narrator": "つばめ",
            "text": "わたし、何か怒らせる\nようなことしちゃった\nかな…？",
            "zh": "我，是不是做了什么\n惹她生气的\n事呀……？",
            "narrator_zh": "燕"
        }
    ]
