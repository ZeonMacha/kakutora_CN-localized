            "narrator_zh": ""
        },
        {
            "location": "102/TALK",
            "narrator": "アーヤ",
            "text": "クラムボンはわらったよ。",
            "zh": "克拉姆邦笑了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "103/TALK",
            "narrator": "アーヤ",
            "text": "クラムボンはかぷかぷわらったよ。",
            "zh": "克拉姆邦喀噗喀噗地笑了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "105/SEL",
            "narrator": "",
            "text": "かぷかぷ？",
            "zh": "喀噗喀噗？",
            "narrator_zh": ""
        },
        {
            "location": "106/SEL",
            "narrator": "",
            "text": "暑さで壊れた？",
            "zh": "是被热坏了？",
            "narrator_zh": ""
        },
        {
            "location": "107/SEL",
            "narrator": "",
            "text": "宮沢賢治「やまなし」",
            "zh": "宫泽贤治《山梨》",
            "narrator_zh": ""
        },
        {
            "location": "108/ACT",
            "narrator": "",
            "text": "かぷかぷ？",
            "zh": "喀噗喀噗？",
            "narrator_zh": ""
        },
        {
            "location": "109/TALK",
            "narrator": "アーヤ",
            "text": "そうよ",
            "zh": "就是哦",
            "narrator_zh": "绫水"
        },
        {
            "location": "111/TALK",
            "narrator": "アーヤ",
            "text": "かぷかぷ笑うの",
            "zh": "是喀噗喀噗地笑",
            "narrator_zh": "绫水"
        },
        {
            "location": "112/ACT",
            "narrator": "",
            "text": "暑さで壊れた？",
            "zh": "是被热坏了？",
            "narrator_zh": ""
        },
        {
            "location": "113/TALK",
            "narrator": "アーヤ",
            "text": "違うわよ",
            "zh": "不对哦",
            "narrator_zh": "绫水"
        },
        {
            "location": "114/TALK",
            "narrator": "アーヤ",
            "text": "文学作品よ",
            "zh": "是文学作品",
            "narrator_zh": "绫水"
        },
        {
            "location": "115/ACT",
            "narrator": "",
            "text": "宮沢賢治「やまなし」",
            "zh": "宫泽贤治《山梨》",
            "narrator_zh": ""
        },
        {
            "location": "117/TALK",
            "narrator": "アーヤ",
            "text": "そう",
            "zh": "对",
            "narrator_zh": "绫水"
        },
        {
            "location": "118/TALK",
            "narrator": "アーヤ",
            "text": "懐かしいでしょ",
            "zh": "很怀念吧",
            "narrator_zh": "绫水"
        },
        {
            "location": "119/TALK",
            "narrator": "アーヤ",
            "text": "小学校で習ったわよね",
            "zh": "小学学过吧",
            "narrator_zh": "绫水"
        },
        {
            "location": "121/TALK",
            "narrator": "アーヤ",
            "text": "この先でクラムボンは死んでしまうけど",
            "zh": "后面克拉姆邦会死掉",
            "narrator_zh": "绫水"
        },
        {
            "location": "122/TALK",
            "narrator": "アーヤ",
            "text": "これって殺人なのよね",
            "zh": "这就是杀人啊",
            "narrator_zh": "绫水"
        },
        {
            "location": "123/TALK",
            "narrator": "アーヤ",
            "text": "事件の匂いがするわ",
            "zh": "有事件的味道",
            "narrator_zh": "绫水"
        },
        {
            "location": "125/SEL",
            "narrator": "",
            "text": "事件……だっけ？",
            "zh": "是事件……来着？",
            "narrator_zh": ""
        },
        {
            "location": "126/SEL",
            "narrator": "",
            "text": "やっぱり暑さにやられてるよね",
            "zh": "果然是被热到了吧",
            "narrator_zh": ""
        },
        {
            "location": "127/SEL",
            "narrator": "",
            "text": "$me$は命をかけてアーヤを守るよ",
            "zh": "$me$会拼上命保护绫水",
            "narrator_zh": ""
        },
        {
            "location": "128/ACT",
            "narrator": "",
            "text": "事件……だっけ？",
            "zh": "是事件……来着？",
            "narrator_zh": ""
        },
        {
            "location": "129/TALK",
            "narrator": "アーヤ",
            "text": "そうよ",
            "zh": "就是哦",
            "narrator_zh": "绫水"
        },
        {
            "location": "130/TALK",
            "narrator": "アーヤ",
            "text": "殺されたのに理由がわからないのよ",
            "zh": "明明被杀了，却不知道理由",
            "narrator_zh": "绫水"
        },
        {
            "location": "131/TALK",
            "narrator": "アーヤ",
            "text": "このままじゃ迷宮入りよ",
            "zh": "这样下去就要成悬案了",
            "narrator_zh": "绫水"
        },
        {
            "location": "132/TALK",
            "narrator": "アーヤ",
            "text": "解決に向けて動かなきゃだわ",
            "zh": "得为了解决行动起来",
            "narrator_zh": "绫水"
        },
        {
            "location": "133/TALK",
            "narrator": "アーヤ",
            "text": "頼んだわよ",
            "zh": "交给你了",
            "narrator_zh": "绫水"
        },
        {
            "location": "134/ACT",
            "narrator": "",
            "text": "やっぱり暑さにやられてるよね",
            "zh": "果然是被热到了吧",
            "narrator_zh": ""
        },
        {
            "location": "135/TALK",
            "narrator": "アーヤ",
            "text": "確かに厚いけど",
            "zh": "确实挺厚的[?]",
            "narrator_zh": "绫水"
        },
        {
            "location": "137/TALK",
            "narrator": "アーヤ",
            "text": "暑いけど",
            "zh": "是热",
            "narrator_zh": "绫水"
        },
        {
            "location": "138/TALK",
            "narrator": "アーヤ",
            "text": "そうじゃないわよ",
            "zh": "不是那样哦",
            "narrator_zh": "绫水"
        },
        {
            "location": "139/TALK",
            "narrator": "アーヤ",
            "text": "ちょっとやまなし読み返してみてよね",
            "zh": "你去把《山梨》重读一下",
            "narrator_zh": "绫水"
        },
        {
            "location": "140/ACT",
            "narrator": "",
            "text": "$me$は命をかけてアーヤを守るよ",
            "zh": "$me$会拼上命保护绫水",
            "narrator_zh": ""
        },
        {
            "location": "142/TALK",
            "narrator": "アーヤ",
            "text": "相変わらずね",
            "zh": "一如既往",
            "narrator_zh": "绫水"
        },
        {
            "location": "143/TALK",
            "narrator": "アーヤ",
            "text": "本当なのかしら？",
            "zh": "是真的吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "144/TALK",
            "narrator": "アーヤ",
            "text": "でも",
            "zh": "不过",
            "narrator_zh": "绫水"
        },
        {
            "location": "145/TALK",
            "narrator": "アーヤ",
            "text": "信じてあげるわ",
            "zh": "我信你",
            "narrator_zh": "绫水"
        },
        {
            "location": "146/TALK",
            "narrator": "アーヤ",
            "text": "半分だけね",
            "zh": "只信一半",
            "narrator_zh": "绫水"
        }
    ]
