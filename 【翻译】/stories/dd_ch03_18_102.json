{
    "dir": "chap18/daydra/dd_ch03_18_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "18305",
        "cid": "gabriella",
        "title": "005 メインストーリー",
        "sub_title": "違う気がする＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "总觉得不对劲＜后篇＞"
    },
    "entry": [
        {
            "location": "479/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "480/TALK",
            "narrator": "ガブリエラ",
            "text": "確かに、アーヤの\n言う通りなのかも\nしれないわね。",
            "zh": "确实，或许就像\n绫水说的一样\n吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "481/TALK",
            "narrator": "ガブリエラ",
            "text": "あんなことが\nなかったら、卯月は\nまだきっと隠してた。",
            "zh": "要不是发生那种事，\n卯月肯定到现在\n还瞒着呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "482/TALK",
            "narrator": "ガブリエラ",
            "text": "自分がメノウで\nあることを。",
            "zh": "瞒着自己就是\nMENOW这件事。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "483/TALK",
            "narrator": "アーヤ",
            "text": "でしょ？",
            "zh": "对吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "484/TALK",
            "narrator": "ガブリエラ",
            "text": "ええ。",
            "zh": "嗯。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "485/TALK",
            "narrator": "ガブリエラ",
            "text": "でも…あたしは\n聞いてみようと\n思うわ。",
            "zh": "不过……我还是\n决定买来\n听听看。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "486/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "487/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤに言われて、\n正直今もまだモヤッと\nしてる。",
            "zh": "被绫水这么一说，\n老实讲我现在心里\n还是有点别扭。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "488/TALK",
            "narrator": "ガブリエラ",
            "text": "それでも、やっぱり\n聞いてみるべきだと\n思うのよ。",
            "zh": "即便如此，我还是觉得\n应该听听看\n才对。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "490/TALK",
            "narrator": "ガブリエラ",
            "text": "多分、これって\nあたし達には必要な\nことだと思うし。",
            "zh": "大概，这对我们来说\n是一件必要的\n事吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "491/TALK",
            "narrator": "アーヤ",
            "text": "どういうこと？",
            "zh": "什么意思？",
            "narrator_zh": "绫水"
        },
        {
            "location": "492/TALK",
            "narrator": "ガブリエラ",
            "text": "神楽ってさ、\n考えてみると\n謎だらけじゃない？",
            "zh": "神乐她呀，\n仔细想想不是\n浑身上下都是谜团吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "493/TALK",
            "narrator": "ガブリエラ",
            "text": "あたし達が神楽の\nことで知ってること\nなんて。",
            "zh": "我们对神乐\n了解到的事\n简直少得可怜。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "494/TALK",
            "narrator": "ガブリエラ",
            "text": "実はメノウだった、\nってことくらいだし。",
            "zh": "也就只知道她其实是\nMENOW这一件事而已。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "495/TALK",
            "narrator": "ガブリエラ",
            "text": "それにさ、この前の\n出動の時だけど！",
            "zh": "而且啊，上次\n出动的时候也是！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "496/TALK",
            "narrator": "ガブリエラ",
            "text": "自分の家が巻き込まれ\nてる、っていうの、\n言わなかったでしょ？",
            "zh": "自己家被卷进去了\n这件事，她不也\n半句没提吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "497/TALK",
            "narrator": "ガブリエラ",
            "text": "あの子、自分のこと\n全然話さないん\nだもの！",
            "zh": "那孩子，自己的事\n根本半点儿都\n不肯跟人说嘛！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "498/TALK",
            "narrator": "ガブリエラ",
            "text": "こっちが知るために\n動かなきゃ、永遠に\n何もわからないままよ。",
            "zh": "要是不由我们主动去了解，\n恐怕永远都只能\n一头雾水下去。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "500/TALK",
            "narrator": "アーヤ",
            "text": "…話してくれないと\n思ってるの？",
            "zh": "……你觉得她不会主动\n告诉我们吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "501/TALK",
            "narrator": "ガブリエラ",
            "text": "ええ、思ってるわ。",
            "zh": "嗯，我是这么觉得。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "502/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤは思ってるの？\n神楽の方から、色々と\n話してくれる、って。",
            "zh": "难道绫水觉得吗？\n觉得神乐会主动把\n各种事都告诉我们。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "503/TALK",
            "narrator": "アーヤ",
            "text": "…わからない。",
            "zh": "……不知道。",
            "narrator_zh": "绫水"
        },
        {
            "location": "504/TALK",
            "narrator": "アーヤ",
            "text": "想像もできないもの。",
            "zh": "连想象都想象不出来呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "505/TALK",
            "narrator": "ガブリエラ",
            "text": "でしょ？？",
            "zh": "对吧？？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "506/TALK",
            "narrator": "ガブリエラ",
            "text": "だからさ、まあ、\n気は進まないかも\nしれないけど。",
            "zh": "所以呀，嘛，\n虽然心里可能\n不太情愿。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "507/TALK",
            "narrator": "ガブリエラ",
            "text": "必要なこと、と思って\n聞くべきじゃないの\nかしら？",
            "zh": "但当成是必要的功课\n去听听看，不也\n挺应该的吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "508/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "509/TALK",
            "narrator": "ガブリエラ",
            "text": "ま、アーヤが聞かない\nって言っても\nあたしは買うけど。",
            "zh": "嘛，就算绫水说不听，\n我也是要\n买一张的啦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "510/TALK",
            "narrator": "アーヤ",
            "text": "…ううん。\n言わないわ。",
            "zh": "……不。\n我可没说不听。",
            "narrator_zh": "绫水"
        },
        {
            "location": "511/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィの言う通り、\n卯月から話してくれる\nとは思えないし。",
            "zh": "就像加维说的，\n我也实在不觉得卯月\n会主动开口跟我们聊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "512/TALK",
            "narrator": "アーヤ",
            "text": "それなら、こっちから\n知るための行動を\n起こさないと。",
            "zh": "既然如此，就只能\n由我们这边主动采取\n行动去了解她了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "513/TALK",
            "narrator": "アーヤ",
            "text": "…できれば仲良く\nしたいしね。",
            "zh": "……如果可以的话，\n我也想和她好好相处嘛。",
            "narrator_zh": "绫水"
        },
        {
            "location": "515/TALK",
            "narrator": "ガブリエラ",
            "text": "そういうこと。",
            "zh": "就是这么回事。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "516/TALK",
            "narrator": "ガブリエラ",
            "text": "…って、違うでしょ！\n別に仲良くなる必要は\nないんだから…。",
            "zh": "……不对，才不是那样！\n我又没必要非得跟她\n搞好关系不可……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "517/TALK",
            "narrator": "アーヤ",
            "text": "そうなの？\n私は卯月とも\n仲良くなりたいけど？",
            "zh": "是吗？\n我倒是也想和卯月\n处好关系呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "518/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしは違うの！",
            "zh": "我才不一样呢！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "519/TALK",
            "narrator": "ガブリエラ",
            "text": "ほら、さっさと\nＣＤ買って帰るわよ。",
            "zh": "行啦，赶紧买完\nCD回去吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "520/TALK",
            "narrator": "アーヤ",
            "text": "ふふっ、\n照れちゃって。",
            "zh": "呵呵，\n害羞了呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "522/TALK",
            "narrator": "ガブリエラ",
            "text": "照れてない！",
            "zh": "才没害羞！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "523/TALK",
            "narrator": "ガブリエラ",
            "text": "…仲良く、か…。",
            "zh": "……搞好关系，吗……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "524/TALK",
            "narrator": "ガブリエラ",
            "text": "ＣＤ聞いただけで\n卯月がわかるなんて\n思えないけど。",
            "zh": "虽然不觉得光听听\nCD就能有多了解\n卯月就是了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "526/TALK",
            "narrator": "ガブリエラ",
            "text": "…可能性は\nゼロじゃない…。",
            "zh": "……但可能性\n也不是零……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "529/TALK",
            "narrator": "ガブリエラ",
            "text": "…なんて、\n甘いかしらね…。",
            "zh": "……这么想，\n未免太天真了吧……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "540/DIALOG",
            "narrator": "Dialog_chapter_ch03",
            "text": "【15 弾の数だけ抱きしめて】",
            "zh": "【15 有多少发子弹，就拥抱多少次】",
            "narrator_zh": "Dialog_chapter_ch03"
        }
    ]
}
