   "narrator_zh": ""
  },
  {
   "location": "1003/ACT",
   "narrator": "",
   "text": "なんだろうね",
   "zh": "谁知道呢",
   "narrator_zh": ""
  },
  {
   "location": "1004/TALK",
   "narrator": "ガブリエラ",
   "text": "$handle$も\nわからないのね。",
   "zh": "原来$handle$也不懂啊。\n",
