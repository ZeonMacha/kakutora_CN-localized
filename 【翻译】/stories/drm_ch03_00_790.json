  {
   "location": "1008/TALK",
   "narrator": "ガブリエラ",
   "text": "それだったら\nあたしはもう\n必要ないわね。",
   "zh": "那样的话，\n我就不\n需要了。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "1011/TALK",
   "narrator": "ガブリエラ",
   "text": "あ。\nでもね。"
  },
  {
   "location": "1012/TALK",
   "narrator": "ガブリエラ",
   "text": "確かこの先に\n祭壇があるって\n聞いてるわ。"
  },
  {
   "location": "1013/SEL",
   "narrator": "",
   "text": "呪術的な？",
   "zh": "是咒术那种？",
   "narrator_zh": ""
  },
  {
   "location": "1014/SEL",
   "narrator": "",
   "text": "民間信仰かな",
   "zh": "是民间信仰吧",
