   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "992/TALK",
   "narrator": "ガブリエラ",
   "text": "$handle$の愛は\n独特なのね。",
   "zh": "$handle$的爱\n真是独特呢。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "996/TALK",
   "narrator": "ガブリエラ",
   "text": "時々小銭が置いてある\nところがあるのね。"
