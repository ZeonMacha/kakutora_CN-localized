 "entry": [
  {
   "location": "913/TALK",
   "narrator": "ガブリエラ",
   "text": "意外と開けてる\n感じなのね。"
  },
  {
   "location": "915/TALK",
   "narrator": "ガブリエラ",
   "text": "もっと山奥に\nひっそりあるのかと\n思ってたわ…。"
  },
  {
   "location": "917/TALK",
   "narrator": "ガブリエラ",
   "text": "中はやっぱり\n暗いけど…。"
  },
  {
   "location": "919/TALK",
   "narrator": "ガブリエラ",
   "text": "$handle$は\n来たことあるのかしら。\nこの鍾乳洞に。",
   "zh": "$handle$来过吗？\n这个钟乳洞。\n",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "920/SEL",
   "narrator": "",
   "text": "あるよ",
   "zh": "有啊",
   "narrator_zh": ""
  },
  {
   "location": "921/SEL",
   "narrator": "",
   "text": "ないよ",
   "zh": "没有哦",
   "narrator_zh": ""
  },
  {
   "location": "922/SEL",
   "narrator": "",
   "text": "忘れた",
   "zh": "忘了",
   "narrator_zh": ""
  },
  {
   "location": "923/ACT",
   "narrator": "",
   "text": "あるよ",
   "zh": "有啊",
   "narrator_zh": ""
  },
  {
   "location": "925/TALK",
   "narrator": "ガブリエラ",
   "text": "そうなのね。",
   "zh": "原来是这样。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "926/ACT",
   "narrator": "",
   "text": "ないよ",
   "zh": "没有哦",
   "narrator_zh": ""
  },
  {
   "location": "928/TALK",
   "narrator": "ガブリエラ",
   "text": "あたしと一緒ね。"
  },
  {
   "location": "929/ACT",
   "narrator": "",
   "text": "忘れた",
   "zh": "忘了",
   "narrator_zh": ""
  },
  {
   "location": "931/TALK",
   "narrator": "ガブリエラ",
   "text": "そんなことあるの？",
   "zh": "有那种事吗？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "934/TALK",
   "narrator": "ガブリエラ",
   "text": "ヴィエリチカに\n雰囲気が似てるかもって\n思って選んだけど。"
  },
  {
   "location": "935/TALK",
   "narrator": "ガブリエラ",
   "text": "意外と天井も低いし\n湿っぽい感じ。"
  },
  {
   "location": "936/TALK",
   "narrator": "ガブリエラ",
   "text": "足元もなんだか\n滑るし。"
  },
  {
   "location": "938/TALK",
   "narrator": "ガブリエラ",
   "text": "やっぱり岩塩坑とは\n違うのね。"
  },
  {
   "location": "939/SEL",
   "narrator": "",
   "text": "そりゃそうだ",
   "zh": "那当然咯",
   "narrator_zh": ""
  },
  {
   "location": "940/SEL",
   "narrator": "",
   "text": "がっかりしちゃった？",
   "zh": "失望了？",
   "narrator_zh": ""
  },
  {
   "location": "941/SEL",
   "narrator": "",
   "text": "これはこれで楽しいよ",
   "zh": "这样也有这样的乐趣哦",
   "narrator_zh": ""
  },
  {
   "location": "942/ACT",
   "narrator": "",
   "text": "そりゃそうだ",
   "zh": "那当然咯",
   "narrator_zh": ""
  },
  {
   "location": "943/TALK",
   "narrator": "ガブリエラ",
   "text": "当たり前といえば\n当たり前よね。"
  },
  {
   "location": "944/ACT",
   "narrator": "",
   "text": "がっかりしちゃった？",
