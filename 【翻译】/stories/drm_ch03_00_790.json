   "narrator": "",
   "text": "なんだろうね",
   "zh": "谁知道呢",
   "narrator_zh": ""
  },
  {
   "location": "1001/SEL",
   "narrator": "",
   "text": "身代わり的なアレ",
   "zh": "就是替身那种东西",
   "narrator_zh": ""
  },
  {
   "location": "1002/SEL",
   "narrator": "",
   "text": "恋の成就祈願かも",
