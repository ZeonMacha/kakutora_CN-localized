  {
   "location": "946/ACT",
   "narrator": "",
   "text": "これはこれで楽しいよ",
   "zh": "这样也有这样的乐趣哦",
   "narrator_zh": ""
  },
  {
   "location": "947/TALK",
   "narrator": "ガブリエラ",
   "text": "そうね。\n確かに興味深いわ。",
   "zh": "是啊。\n确实很有意思。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "949/TALK",
   "narrator": "ガブリエラ",
   "text": "鍾乳洞って\n何万年もかけて\nこの形になったのよね。"
  },
  {
   "location": "950/SEL",
   "narrator": "",
   "text": "そうだね",
   "zh": "是呀。",
   "narrator_zh": ""
  },
  {
   "location": "951/SEL",
   "narrator": "",
   "text": "実は$me$が作った",
   "zh": "其实是$me$做的",
   "narrator_zh": ""
  },
  {
   "location": "952/ACT",
   "narrator": "",
   "text": "そうだね",
   "zh": "是呀。",
   "narrator_zh": ""
  },
  {
   "location": "953/TALK",
   "narrator": "ガブリエラ",
   "text": "すごいわよね。"
  },
  {
   "location": "954/ACT",
   "narrator": "",
   "text": "実は$me$が作った",
   "zh": "其实是$me$做的",
   "narrator_zh": ""
  },
  {
