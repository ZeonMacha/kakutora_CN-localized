   "narrator_zh": "兔之阿尼玛"
  },
  {
   "location": "47/TALK",
   "narrator": "ラビットアニマ",
   "text": "みやびさんのことです"
  },
  {
   "location": "49/TALK",
   "narrator": "ラビットアニマ",
   "text": "助かります"
  },
  {
   "location": "50/TALK",
   "narrator": "ラビットアニマ",
   "text": "話が早くて"
  },
  {
   "location": "52/TALK",
   "narrator": "ラビットアニマ",
   "text": "彼女が落ち込んでいる理由を知っていますか？"
  },
  {
   "location": "54/SEL",
   "narrator": "",
   "text": "知ってる",
   "zh": "知道",
   "narrator_zh": ""
  },
  {
   "location": "55/SEL",
   "narrator": "",
   "text": "見当はついてる",
   "zh": "我大概有数了",
   "narrator_zh": ""
  },
  {
   "location": "56/SEL",
   "narrator": "",
   "text": "知らない",
   "zh": "不知道",
   "narrator_zh": ""
  },
  {
   "location": "57/ACT",
   "narrator": "",
   "text": "知ってる",
   "zh": "知道",
   "narrator_zh": ""
  },
  {
   "location": "59/TALK",
   "narrator": "ラビットアニマ",
   "text": "知ってるんですね"
  },
  {
   "location": "60/ACT",
   "narrator": "",
   "text": "見当はついてる",
   "zh": "我大概有数了",
   "narrator_zh": ""
  },
  {
   "location": "62/TALK",
   "narrator": "ラビットアニマ",
   "text": "だったら",
