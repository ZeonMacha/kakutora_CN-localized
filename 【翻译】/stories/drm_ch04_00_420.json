        },
        {
            "location": "55/SEL",
            "narrator": "",
            "text": "見当はついてる",
            "zh": "我大概有数了",
            "narrator_zh": ""
        },
        {
            "location": "56/SEL",
            "narrator": "",
            "text": "知らない",
            "zh": "不知道",
            "narrator_zh": ""
        },
        {
            "location": "57/ACT",
            "narrator": "",
            "text": "知ってる",
            "zh": "知道",
            "narrator_zh": ""
        },
        {
            "location": "59/TALK",
            "narrator": "ラビットアニマ",
            "text": "知ってるんですね",
