   "location": "93/ACT",
   "narrator": "",
   "text": "まあね",
   "zh": "嘛",
   "narrator_zh": ""
  },
  {
   "location": "95/TALK",
   "narrator": "ラビットアニマ",
   "text": "当然知ってますよね"
  },
  {
   "location": "98/TALK",
   "narrator": "ラビットアニマ",
   "text": "でもあなたは",
   "zh": "不过你",
   "narrator_zh": "兔之阿尼玛"
  },
  {
   "location": "99/TALK",
   "narrator": "ラビットアニマ",
   "text": "みやびさんの気持ちを"
  },
  {
   "location": "100/TALK",
   "narrator": "ラビットアニマ",
   "text": "浮上させる手段を知っているはずです"
  },
  {
   "location": "101/TALK",
   "narrator": "ラビットアニマ",
   "text": "助けてほしい内容を知っているはずです"
  },
  {
   "location": "103/SEL",
   "narrator": "",
   "text": "当直を代わって欲しいらしいよ",
   "zh": "好像有人想换值班",
   "narrator_zh": ""
  },
  {
   "location": "104/ACT",
   "narrator": "",
   "text": "当直を代わって欲しいらしいよ",
