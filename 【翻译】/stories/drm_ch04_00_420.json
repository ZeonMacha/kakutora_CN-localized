        },
        {
            "location": "103/SEL",
            "narrator": "",
            "text": "当直を代わって欲しいらしいよ",
            "zh": "好像有人想换值班",
            "narrator_zh": ""
        },
        {
            "location": "104/ACT",
            "narrator": "",
            "text": "当直を代わって欲しいらしいよ",
