            "narrator_zh": ""
        },
        {
            "location": "65/TALK",
            "narrator": "ラビットアニマ",
            "text": "本当に？",
            "zh": "真的吗？",
            "narrator_zh": "兔之阿尼玛"
        },
        {
            "location": "68/TALK",
            "narrator": "ラビットアニマ",
            "text": "あなたはみやびさんのために何かしましたか？",
