            "narrator": "",
            "text": "また後でね",
            "zh": "待会儿见哦",
            "narrator_zh": ""
        },
        {
            "location": "26/SEL",
            "narrator": "",
            "text": "みやびのことだよね？",
            "zh": "说的是雅的事吧？",
            "narrator_zh": ""
