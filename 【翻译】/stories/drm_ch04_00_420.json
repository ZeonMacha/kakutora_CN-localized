        {
            "location": "33/TALK",
            "narrator": "ラビットアニマ",
            "text": "少しだけです",
            "zh": "就一点点",
            "narrator_zh": "兔之阿尼玛"
        },
        {
            "location": "34/TALK",
            "narrator": "ラビットアニマ",
            "text": "時間をください",
            "zh": "请给我一点时间",
            "narrator_zh": "兔之阿尼玛"
        },
        {
            "location": "35/ACT",
            "narrator": "",
            "text": "みやびのことだよね？",
            "zh": "说的是雅的事吧？",
            "narrator_zh": ""
        },
        {
            "location": "46/TALK",
            "narrator": "ラビットアニマ",
            "text": "そうです",
            "zh": "是的",
            "narrator_zh": "兔之阿尼玛"
        },
        {
            "location": "47/TALK",
            "narrator": "ラビットアニマ",
            "text": "みやびさんのことです",
