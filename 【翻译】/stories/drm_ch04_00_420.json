   "narrator_zh": "兔之阿尼玛"
  },
  {
   "location": "68/TALK",
   "narrator": "ラビットアニマ",
   "text": "あなたはみやびさんのために何かしましたか？"
  },
  {
   "location": "70/SEL",
   "narrator": "",
   "text": "一応聞いたよ",
   "zh": "我好歹问过了",
   "narrator_zh": ""
  },
  {
   "location": "71/SEL",
   "narrator": "",
   "text": "してないな",
   "zh": "没做过",
   "narrator_zh": ""
  },
  {
   "location": "72/SEL",
   "narrator": "",
   "text": "そっとしといた方がいいんじゃない"
  },
  {
   "location": "73/ACT",
   "narrator": "",
   "text": "一応聞いたよ",
   "zh": "我好歹问过了",
   "narrator_zh": ""
  },
  {
   "location": "75/TALK",
   "narrator": "ラビットアニマ",
   "text": "一応ですか"
  },
  {
   "location": "76/ACT",
   "narrator": "",
   "text": "してないな",
   "zh": "没做过",
   "narrator_zh": ""
  },
  {
   "location": "78/TALK",
   "narrator": "ラビットアニマ",
   "text": "どうして",
   "zh": "为什么",
   "narrator_zh": "兔之阿尼玛"
  },
  {
   "location": "79/ACT",
   "narrator": "",
   "text": "そっとしといた方がいいんじゃない"
  },
  {
   "location": "81/TALK",
   "narrator": "ラビットアニマ",
   "text": "わかってないですね"
  },
  {
   "location": "84/TALK",
   "narrator": "ラビットアニマ",
   "text": "あの人は"
  },
  {
   "location": "85/TALK",
   "narrator": "ラビットアニマ",
   "text": "口に出して助けを求めるタイプじゃない"
