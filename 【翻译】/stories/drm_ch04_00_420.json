  {
   "location": "63/ACT",
   "narrator": "",
   "text": "知らない",
   "zh": "不知道",
   "narrator_zh": ""
  },
  {
   "location": "65/TALK",
   "narrator": "ラビットアニマ",
   "text": "本当に？",
