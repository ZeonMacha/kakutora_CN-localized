    "entry": [
        {
            "location": "156/SCENARIO",
            "narrator": "",
            "text": "千羽鶴恋愛ゲーム２",
            "zh": "千羽鹤恋爱游戏2",
            "narrator_zh": ""
        },
        {
            "location": "192/TALK",
            "narrator": "千羽鶴",
            "text": "ああっ！\nあなたは\n$handle$！",
            "zh": "啊啊！\n你是\n$handle$！",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "193/TALK",
            "narrator": "千羽鶴",
            "text": "あなたがここにくるのを\nずっと待っていたの！",
            "zh": "我一直在等\n你来这里！",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "194/SEL",
            "narrator": "",
            "text": "またすごい背景っすね",
            "zh": "背景又夸张了啊",
            "narrator_zh": ""
        },
        {
            "location": "195/ACT",
            "narrator": "",
            "text": "またすごい背景っすね",
            "zh": "背景又夸张了啊",
            "narrator_zh": ""
        },
        {
            "location": "197/TALK",
            "narrator": "千羽鶴",
            "text": "はいはい予算予算。",
            "zh": "好好好，预算预算。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "198/TALK",
            "narrator": "千羽鶴",
            "text": "そういう所にツッコミ\n入れて雰囲気壊さない。",
            "zh": "别吐槽这种地方，\n别把气氛搞砸。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "199/SEL",
            "narrator": "",
            "text": "あ、はい…",
            "zh": "啊，好……",
            "narrator_zh": ""
        },
        {
            "location": "200/ACT",
            "narrator": "",
            "text": "あ、はい…",
            "zh": "啊，好……",
            "narrator_zh": ""
        },
        {
            "location": "202/TALK",
            "narrator": "千羽鶴",
            "text": "わたしの名前は千羽鶴。\n職業は『非攻略対象』。",
            "zh": "我的名字是千羽鹤。\n职业是『非攻略对象』。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "203/TALK",
            "narrator": "千羽鶴",
            "text": "でもホントは密かに\n『攻略対象』になりたいと\n思ってる女の子なの。",
            "zh": "但其实是个\n暗暗想成为『攻略对象』\n的女孩。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "205/TALK",
            "narrator": "千羽鶴",
            "text": "あなたも私が\n攻略対象になって\n欲しいでしょ？",
            "zh": "你也希望我\n成为攻略对象\n吧？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "206/SEL",
            "narrator": "",
            "text": "はい！",
            "zh": "好！",
            "narrator_zh": ""
        },
        {
            "location": "207/SEL",
            "narrator": "",
            "text": "もちろん！",
            "zh": "当然！",
            "narrator_zh": ""
        },
        {
            "location": "208/SEL",
            "narrator": "",
            "text": "いいえ",
            "zh": "不",
            "narrator_zh": ""
        },
        {
            "location": "209/ACT",
            "narrator": "",
            "text": "はい！",
            "zh": "好！",
            "narrator_zh": ""
        },
        {
            "location": "210/ACT",
            "narrator": "",
            "text": "もちろん！",
            "zh": "当然！",
            "narrator_zh": ""
        },
        {
            "location": "211/ACT",
            "narrator": "",
            "text": "いいえ",
            "zh": "不",
            "narrator_zh": ""
        },
        {
            "location": "212/TALK",
            "narrator": "千羽鶴",
            "text": "そんな、ひどい……。",
            "zh": "怎么这样，太过分了……。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "215/TALK",
            "narrator": "千羽鶴",
            "text": "うれしい！\n私たち、同じ目的を\n持ってるのね。",
            "zh": "好开心！\n我们的目的\n是一样的。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "216/TALK",
            "narrator": "千羽鶴",
            "text": "同じ目的を持つ者は\nパーティーを組んで\n旅をするの！",
            "zh": "目的相同的人，\n就要组队\n去旅行！",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "217/SEL",
            "narrator": "",
            "text": "いやに説明口調っすね",
            "zh": "解说腔未免太重了啊",
            "narrator_zh": ""
        },
        {
            "location": "218/ACT",
            "narrator": "",
            "text": "いやに説明口調っすね",
            "zh": "解说腔未免太重了啊",
            "narrator_zh": ""
        },
        {
            "location": "220/TALK",
            "narrator": "千羽鶴",
            "text": "解りやすさ第一。\n予算でワード数が\n限られてるんだから。",
            "zh": "好懂最重要。\n预算把字数\n限制住了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "221/TALK",
            "narrator": "千羽鶴",
            "text": "そして私の目的は、\nあのお城。",
            "zh": "而我的目的，\n是那座城堡。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "222/TALK",
            "narrator": "千羽鶴",
            "text": "あのお城の中には\n伝説の『非消滅の宝玉』が\n眠っているといわれてる。",
            "zh": "据说那座城堡里，\n沉睡着传说的\n『不灭宝玉』。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "223/TALK",
            "narrator": "千羽鶴",
            "text": "だから、私とあなたで\nパーティーを組んで、\nあのお城に行きましょ。",
            "zh": "所以，我和你\n组队，\n去那座城堡吧。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "224/TALK",
            "narrator": "千羽鶴",
            "text": "途中に手強い敵が出るかも\nしれないけど、２人の\nラブパワーで殲滅よ！",
            "zh": "路上也许会碰上\n难缠的敌人，用两人的\n恋爱之力歼灭他们！",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "225/SEL",
            "narrator": "",
            "text": "お、おう…",
            "zh": "哦、哦……",
            "narrator_zh": ""
        },
        {
            "location": "226/ACT",
            "narrator": "",
            "text": "お、おう…",
            "zh": "哦、哦……",
            "narrator_zh": ""
        },
