        },
        {
            "location": "238/SEL",
            "narrator": "",
            "text": "クリアを断念する",
            "zh": "放弃通关",
            "narrator_zh": ""
        },
        {
            "location": "289/ACT",
            "narrator": "",
            "text": "クリアを断念する",
            "zh": "放弃通关",
