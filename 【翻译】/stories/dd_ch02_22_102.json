{
    "dir": "chap22/daydra/dd_ch02_22_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "22205",
        "cid": "ayami",
        "title": "005 メインストーリー",
        "sub_title": "覚悟＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "觉悟＜后篇＞"
    },
    "entry": [
        {
            "location": "365/TALK",
            "narrator": "アーヤ",
            "text": "…嫌な予感から\n目を反らしても、\n何も解決しないわ。",
            "zh": "……就算对不好的预感\n视而不见，\n也解决不了任何问题。",
            "narrator_zh": "绫水"
        },
        {
            "location": "366/TALK",
            "narrator": "アーヤ",
            "text": "館長が言ってるのは、\n任期のことよ。",
            "zh": "馆长所说的，\n是指任期吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "368/TALK",
            "narrator": "アーヤ",
            "text": "多分…。",
            "zh": "大概……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "369/TALK",
            "narrator": "アーヤ",
            "text": "…館長が何をしようと\nしているのかは\nわかりません。",
            "zh": "……虽然我不知道\n馆长究竟打算\n做些什么。",
            "narrator_zh": "绫水"
        },
        {
            "location": "370/TALK",
            "narrator": "アーヤ",
            "text": "でも、命に関わるような\nことだけは、\n避けてくださいね？",
            "zh": "但唯独会危及性命的事，\n请你千万不要\n去做，好吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "371/TALK",
            "narrator": "真幌",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "真幌"
        },
        {
            "location": "372/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "373/TALK",
            "narrator": "真幌",
            "text": "ぷっ。",
            "zh": "噗。",
            "narrator_zh": "真幌"
        },
        {
            "location": "374/TALK",
            "narrator": "真幌",
            "text": "あはははは！\nおまえがそれを\n言うのか？",
            "zh": "啊哈哈哈哈！\n这话居然是从\n你嘴里说出来的？",
            "narrator_zh": "真幌"
        },
        {
            "location": "375/TALK",
            "narrator": "真幌",
            "text": "最前線で\n命を懸けて戦ってる\nおまえが言うか。",
            "zh": "你这个站在最前线\n赌上性命战斗的人，\n居然说出这种话。",
            "narrator_zh": "真幌"
        },
        {
            "location": "376/TALK",
            "narrator": "真幌",
            "text": "命に関わることは\n避けろって…。\n説得力がなさすぎる。",
            "zh": "还叫我避开危及性命的事\n……。\n这也太没有说服力了吧。",
            "narrator_zh": "真幌"
        },
        {
            "location": "378/TALK",
            "narrator": "アーヤ",
            "text": "そ、そうかもしれ\nませんけど、\n本気で心配して…！",
            "zh": "话、话是这么说\n没错，可我是真心在\n担心你啊……！",
            "narrator_zh": "绫水"
        },
        {
            "location": "379/TALK",
            "narrator": "真幌",
            "text": "ああ、わかってる。\nわかってるよ。",
            "zh": "好好，我知道。\n我知道啦。",
            "narrator_zh": "真幌"
        },
        {
            "location": "380/TALK",
            "narrator": "真幌",
            "text": "だが、冗談を\nそこまで本気に\nするな。",
            "zh": "不过，别把一句玩笑\n当真到那种\n地步嘛。",
            "narrator_zh": "真幌"
        },
        {
            "location": "381/TALK",
            "narrator": "真幌",
            "text": "こちらも反応に\n困ってしまうだろ？",
            "zh": "这样一来，我这边反而\n不知道该怎么接话了啊？",
            "narrator_zh": "真幌"
        },
        {
            "location": "383/TALK",
            "narrator": "アーヤ",
            "text": "えっ…と…。",
            "zh": "那个……呃……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "384/TALK",
            "narrator": "真幌",
            "text": "そう簡単に死んで\nたまるか。",
            "zh": "我哪有那么容易\n就死掉啊。",
            "narrator_zh": "真幌"
        },
        {
            "location": "385/TALK",
            "narrator": "アーヤ",
            "text": "はぁ…もう…。",
            "zh": "哈啊……真是的……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "386/TALK",
            "narrator": "真幌",
            "text": "すまんすまん。",
            "zh": "抱歉抱歉。",
            "narrator_zh": "真幌"
        },
        {
            "location": "387/TALK",
            "narrator": "アーヤ",
            "text": "…けど、冗談で\n本当に安心しました。",
            "zh": "……不过，听你说是玩笑，\n我真的松了口气。",
            "narrator_zh": "绫水"
        },
        {
            "location": "388/TALK",
            "narrator": "アーヤ",
            "text": "もうこういう冗談は\nやめてくださいよ？",
            "zh": "以后请别再开\n这种玩笑了好吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "389/TALK",
            "narrator": "真幌",
            "text": "ああ、わかった。\n冗談はやめる。",
            "zh": "好好，我知道了。\n这种玩笑不开了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "390/TALK",
            "narrator": "真幌",
            "text": "その代わり。\n本音で、一つおまえに\n言っておく。",
            "zh": "作为交换。\n我跟你说句\n真心话吧。",
            "narrator_zh": "真幌"
        },
        {
            "location": "391/TALK",
            "narrator": "アーヤ",
            "text": "？",
            "zh": "？",
            "narrator_zh": "绫水"
        },
        {
            "location": "392/TALK",
            "narrator": "真幌",
            "text": "おまえにはもっと、\nデカくなってもらわ\nなければ困る…。",
            "zh": "我需要你变得\n更“大”才行\n……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "393/TALK",
            "narrator": "真幌",
            "text": "これが私の本音だ。",
            "zh": "这就是我的真心话。",
            "narrator_zh": "真幌"
        },
        {
            "location": "395/TALK",
            "narrator": "アーヤ",
            "text": "…デカく、ですか？",
            "zh": "……变“大”，吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "396/TALK",
            "narrator": "真幌",
            "text": "そう、デカくだ。",
            "zh": "没错，就是变大。",
            "narrator_zh": "真幌"
        },
        {
            "location": "397/TALK",
            "narrator": "アーヤ",
            "text": "…なんか、さっきから\n抽象的な言い方ばかり\nしてくるわね。",
            "zh": "……总觉得，你从刚才开始\n就一直净说些\n很抽象的话呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "398/TALK",
            "narrator": "アーヤ",
            "text": "どういう意味なの\nかしら？",
            "zh": "这究竟是什么\n意思呢？",
            "narrator_zh": "绫水"
        },
        {
            "location": "399/TALK",
            "narrator": "アーヤ",
            "text": "まともに受け止めて\nいいのか…それとも、\n別の意味があるとか？",
            "zh": "是按字面意思理解\n就好……还是说，\n另有所指呢？",
            "narrator_zh": "绫水"
        },
        {
            "location": "400/TALK",
            "narrator": "アーヤ",
            "text": "う～ん…。",
            "zh": "唔~……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "401/SEL",
            "narrator": "",
            "text": "もっと頼れるリーダーになれ、ってことだ",
            "zh": "意思是让你成为更可靠的队长啦",
            "narrator_zh": ""
        },
        {
            "location": "402/SEL",
            "narrator": "",
            "text": "真幌の気持ちわかるなぁ",
            "zh": "我好懂真幌的心情啊",
            "narrator_zh": ""
        },
        {
            "location": "403/ACT",
            "narrator": "",
            "text": "もっと頼れるリーダーになれ、ってことだ",
            "zh": "意思是让你成为更可靠的队长啦",
            "narrator_zh": ""
        },
        {
            "location": "413/TALK",
            "narrator": "アーヤ",
            "text": "それ納得だわ(>_<)",
            "zh": "这话我服气(>_<)",
            "narrator_zh": "绫水"
        },
        {
            "location": "414/TALK",
            "narrator": "アーヤ",
            "text": "館長と比べて",
            "zh": "跟馆长比起来",
            "narrator_zh": "绫水"
        },
        {
            "location": "415/TALK",
            "narrator": "アーヤ",
            "text": "まだまだ半人前だし(-ω-;)",
            "zh": "我还远远不够格(-ω-;)",
            "narrator_zh": "绫水"
        },
        {
            "location": "416/TALK",
            "narrator": "アーヤ",
            "text": "仲間のこと",
            "zh": "同伴们的事",
            "narrator_zh": "绫水"
        },
        {
            "location": "417/TALK",
            "narrator": "アーヤ",
            "text": "最近ちゃんと見れてないし",
            "zh": "最近都没能好好照看到",
            "narrator_zh": "绫水"
        },
        {
            "location": "418/TALK",
            "narrator": "アーヤ",
            "text": "反省しないと(ノД`)",
            "zh": "不好好反省不行啊(ノД`)",
            "narrator_zh": "绫水"
        },
        {
            "location": "423/TALK",
            "narrator": "アーヤ",
            "text": "…これからも、\nこれ以上に\n精進します。",
            "zh": "……今后，我也会\n比现在更加\n努力精进的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "424/TALK",
            "narrator": "アーヤ",
            "text": "みんなの手本として。\nリーダーとして。",
            "zh": "作为大家的榜样。\n作为一名队长。",
            "narrator_zh": "绫水"
        },
        {
            "location": "426/TALK",
            "narrator": "真幌",
            "text": "…ん、期待してるぞ。",
            "zh": "……嗯，我拭目以待。",
            "narrator_zh": "真幌"
        },
        {
            "location": "427/ACT",
            "narrator": "",
            "text": "真幌の気持ちわかる",
            "zh": "我懂真幌的心情",
            "narrator_zh": ""
        },
        {
            "location": "437/TALK",
            "narrator": "アーヤ",
            "text": "どういうこと？(￣Д￣ )",
            "zh": "什么意思？(￣Д￣ )",
            "narrator_zh": "绫水"
        },
        {
            "location": "440/SEL",
            "narrator": "",
            "text": "胸だよ、胸",
            "zh": "胸啦，胸",
            "narrator_zh": ""
        },
        {
            "location": "441/ACT",
            "narrator": "",
            "text": "胸だよ、胸",
            "zh": "胸啦，胸",
            "narrator_zh": ""
        },
        {
            "location": "444/TALK",
            "narrator": "アーヤ",
            "text": "胸？",
            "zh": "胸？",
            "narrator_zh": "绫水"
        },
        {
            "location": "445/TALK",
            "narrator": "アーヤ",
            "text": "ちょっとわからないんだけど（￣ー￣？）",
            "zh": "有点没听明白呢（￣ー￣？）",
            "narrator_zh": "绫水"
        },
        {
            "location": "447/SEL",
            "narrator": "",
            "text": "バストサイズの話だよ",
            "zh": "说的是胸围尺寸啦",
            "narrator_zh": ""
        },
        {
            "location": "448/ACT",
            "narrator": "",
            "text": "バストサイズの話だよ",
            "zh": "说的是胸围尺寸啦",
            "narrator_zh": ""
        },
        {
            "location": "450/TALK",
            "narrator": "アーヤ",
            "text": "何の話してるのよ（｀皿´ )",
            "zh": "你在胡说什么呢（｀皿´ )",
            "narrator_zh": "绫水"
        },
        {
            "location": "451/TALK",
            "narrator": "アーヤ",
            "text": "そんなわけないから！",
            "zh": "怎么可能是指那个！",
            "narrator_zh": "绫水"
        },
        {
            "location": "452/TALK",
            "narrator": "アーヤ",
            "text": "話に繋がりないでしょ(｀ヘ´)",
            "zh": "上下文完全接不上吧(｀ヘ´)",
            "narrator_zh": "绫水"
        },
        {
            "location": "454/SEL",
            "narrator": "",
            "text": "落ち着け、相手は酔っ払いだ",
            "zh": "冷静点，对方可是个醉鬼",
            "narrator_zh": ""
        },
        {
            "location": "455/ACT",
            "narrator": "",
            "text": "落ち着け、相手は酔っ払いだ",
            "zh": "冷静点，对方可是个醉鬼",
            "narrator_zh": ""
        },
        {
            "location": "458/TALK",
            "narrator": "アーヤ",
            "text": "そういえば",
            "zh": "说起来",
            "narrator_zh": "绫水"
        },
        {
            "location": "459/TALK",
            "narrator": "アーヤ",
            "text": "前にも館長",
            "zh": "以前馆长也",
            "narrator_zh": "绫水"
        },
        {
            "location": "460/TALK",
            "narrator": "アーヤ",
            "text": "飲みに行った時",
            "zh": "去喝酒的时候",
            "narrator_zh": "绫水"
        },
        {
            "location": "461/TALK",
            "narrator": "アーヤ",
            "text": "下ネタ言ったことがあったわ(￣Д￣ )",
            "zh": "开过一次黄腔呢(￣Д￣ )",
            "narrator_zh": "绫水"
        },
        {
            "location": "464/TALK",
            "narrator": "アーヤ",
            "text": "まったく",
            "zh": "真是的",
            "narrator_zh": "绫水"
        },
        {
            "location": "465/TALK",
            "narrator": "アーヤ",
            "text": "これだから酔っ払いは(--#)",
            "zh": "醉鬼就是这点讨厌(--#)",
            "narrator_zh": "绫水"
        },
        {
            "location": "470/TALK",
            "narrator": "アーヤ",
            "text": "…残念ですけど、\n館長の期待には\nお答えできません。",
            "zh": "……虽然很遗憾，\n但我无法回应\n馆长的期待。",
            "narrator_zh": "绫水"
        },
        {
            "location": "472/TALK",
            "narrator": "真幌",
            "text": "…は？",
            "zh": "……哈？",
            "narrator_zh": "真幌"
        },
        {
            "location": "473/TALK",
            "narrator": "アーヤ",
            "text": "無茶ですよ。\n私にデカくなれだ\nなんて。",
            "zh": "太勉强了。\n要我变得更大\n什么的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "474/TALK",
            "narrator": "アーヤ",
            "text": "十代ならまだしも、\n今から成長するわけ\nないじゃないですか。",
            "zh": "要是十几岁倒还好说，\n我都这把年纪了，\n怎么可能还会再长啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "475/TALK",
            "narrator": "真幌",
            "text": "おいおい…本気か？",
            "zh": "喂喂……你是认真的吗？",
            "narrator_zh": "真幌"
        },
        {
            "location": "476/TALK",
            "narrator": "真幌",
            "text": "おまえはみんなの\n手本になるリーダー\nなんだぞ？",
            "zh": "你可是要成为大家\n榜样的队长\n啊？",
            "narrator_zh": "真幌"
        },
        {
            "location": "477/TALK",
            "narrator": "真幌",
            "text": "そんな簡単に無理とか\n言うもんじゃないぞ。",
            "zh": "怎么能这么轻易地就\n把“做不到”挂在嘴边呢。",
            "narrator_zh": "真幌"
        },
        {
            "location": "478/TALK",
            "narrator": "アーヤ",
            "text": "館長が無茶なこと\n言うからですよ。",
            "zh": "那是因为馆长你\n净提些无理的要求啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "479/TALK",
            "narrator": "アーヤ",
            "text": "できないことを\nできるなんて、\n私には言えません。",
            "zh": "明明做不到的事，\n却偏要吹牛说能做到，\n我说不出口。",
            "narrator_zh": "绫水"
        },
        {
            "location": "480/TALK",
            "narrator": "アーヤ",
            "text": "それこそ、リーダー\nとして無責任だと\n思いませんか？",
            "zh": "那样才叫作为队长\n不负责任，\n你不觉得吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "481/TALK",
            "narrator": "真幌",
            "text": "…本気で\n言ってるのか？",
            "zh": "……你是认真的\n在说这话吗？",
            "narrator_zh": "真幌"
        },
        {
            "location": "482/TALK",
            "narrator": "アーヤ",
            "text": "当然です。\n私の成長はもう、\n止まってますから。",
            "zh": "当然了。\n我的发育早就\n已经停止了嘛。",
            "narrator_zh": "绫水"
        },
        {
            "location": "483/TALK",
            "narrator": "真幌",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "真幌"
        },
        {
            "location": "484/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "485/TALK",
            "narrator": "真幌",
            "text": "ガッカリだよ…。\nアーヤには期待して\nいたんだが。",
            "zh": "真让我失望啊……。\n我明明对绫水\n寄予了厚望的。",
            "narrator_zh": "真幌"
        },
        {
            "location": "486/TALK",
            "narrator": "真幌",
            "text": "まさか、これ以上\n成長ができんと\n言われるとはな…。",
            "zh": "真没想到，你居然会说\n自己已经无法再\n成长了……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "487/TALK",
            "narrator": "アーヤ",
            "text": "そんな期待されても\n困りますから…。",
            "zh": "就算你对我寄予厚望，\n我也很困扰啊……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "488/TALK",
            "narrator": "アーヤ",
            "text": "第一、リーダーで\nあることと大きいことに\n関係はありますか？",
            "zh": "再说了，当不当队长，\n跟尺寸大小之间\n有什么关系吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "489/TALK",
            "narrator": "真幌",
            "text": "そりゃおまえ、\n小さいリーダーとか\n頼りにならんだろ？",
            "zh": "那当然了，\n一个小小的队长\n看着就不够可靠吧？",
            "narrator_zh": "真幌"
        },
        {
            "location": "490/TALK",
            "narrator": "アーヤ",
            "text": "スレンダーな\nリーダーも\n素敵じゃないですか！",
            "zh": "纤细一点的\n队长不也\n挺好的嘛！",
            "narrator_zh": "绫水"
        },
        {
            "location": "491/TALK",
            "narrator": "真幌",
            "text": "…スレンダー？",
            "zh": "……纤细？",
            "narrator_zh": "真幌"
        },
        {
            "location": "492/TALK",
            "narrator": "アーヤ",
            "text": "サイズだけなら私より\nみやびの方が適任って\nことになりますよ？",
            "zh": "要是只论尺寸的话，\n那岂不是雅比我\n更适合当队长了？",
            "narrator_zh": "绫水"
        },
        {
            "location": "493/TALK",
            "narrator": "真幌",
            "text": "いや、おい…。",
            "zh": "不是，喂……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "494/TALK",
            "narrator": "アーヤ",
            "text": "そういうこと\nなんですよね！？",
            "zh": "你说的就是这个\n意思吧！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "495/TALK",
            "narrator": "真幌",
            "text": "ストップ！\n落ち着け、アーヤ。",
            "zh": "停！\n冷静一下，绫水。",
            "narrator_zh": "真幌"
        },
        {
            "location": "496/TALK",
            "narrator": "真幌",
            "text": "おまえ、何の話を\nしてるんだ？",
            "zh": "你刚才到底在\n说什么东西啊？",
            "narrator_zh": "真幌"
        },
        {
            "location": "498/TALK",
            "narrator": "アーヤ",
            "text": "大小の話です！",
            "zh": "当然是在说大小的事啊！",
            "narrator_zh": "绫水"
        },
        {
            "location": "500/TALK",
            "narrator": "アーヤ",
            "text": "大体スポーツ選手で\n大きい人なんて\nいませんから！",
            "zh": "本来运动员里面\n就没什么尺寸大的\n人好不好！",
            "narrator_zh": "绫水"
        },
        {
            "location": "502/TALK",
            "narrator": "アーヤ",
            "text": "みやびだって\nサイズがないって\n嘆いてますし！",
            "zh": "就连雅也在感叹\n根本买不到合适\n的尺码呢！",
            "narrator_zh": "绫水"
        },
        {
            "location": "503/TALK",
            "narrator": "真幌",
            "text": "…あ、あぁっ！\nなるほど、\nそういうことか。",
            "zh": "……啊、啊啊！\n原来如此，\n是这么回事啊。",
            "narrator_zh": "真幌"
        },
        {
            "location": "505/TALK",
            "narrator": "アーヤ",
            "text": "何がですか？",
            "zh": "什么啊？",
            "narrator_zh": "绫水"
        },
        {
            "location": "506/TALK",
            "narrator": "真幌",
            "text": "…私がデカくなって\nもらわなきゃ困ると\n言ったのは、な。",
            "zh": "……我说我需要你\n变得更大才行，\n意思是啊。",
            "narrator_zh": "真幌"
        },
        {
            "location": "507/TALK",
            "narrator": "真幌",
            "text": "一人の戦士として\nデカくなってほしい、\nという意味だぞ？",
            "zh": "是希望你作为一名战士\n能变得更加强大、独当一面，\n是这个意思好吗？",
            "narrator_zh": "真幌"
        },
        {
            "location": "508/TALK",
            "narrator": "アーヤ",
            "text": "…え？",
            "zh": "……诶？",
            "narrator_zh": "绫水"
        },
        {
            "location": "509/TALK",
            "narrator": "真幌",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "真幌"
        },
        {
            "location": "512/TALK",
            "narrator": "アーヤ",
            "text": "…え、えぇっ！？",
            "zh": "……诶、诶诶！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "513/TALK",
            "narrator": "真幌",
            "text": "はぁ…まったく。\nなんちゅー勘違いだ。",
            "zh": "哈啊……真是的。\n你这脑子里都在瞎想些什么啊。",
            "narrator_zh": "真幌"
        },
        {
            "location": "514/TALK",
            "narrator": "アーヤ",
            "text": "だ、だって！\nなんか抽象的な\n言い方だったし！！",
            "zh": "可、可是！\n谁让你说得那么\n抽象啊！！",
            "narrator_zh": "绫水"
        },
        {
            "location": "515/TALK",
            "narrator": "アーヤ",
            "text": "それに$handle$も\nそう言ってて…。",
            "zh": "而且$handle$也\n是这么说的……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "516/TALK",
            "narrator": "真幌",
            "text": "$handle$？\n知らんぞそんな奴。",
            "zh": "$handle$？\n我不认识这号人。",
            "narrator_zh": "真幌"
        },
        {
            "location": "518/TALK",
            "narrator": "アーヤ",
            "text": "うう…。",
            "zh": "呜呜……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "519/TALK",
            "narrator": "真幌",
            "text": "ははっ…。\nまあ、いいさ。",
            "zh": "哈哈……。\n算了，随它去吧。",
            "narrator_zh": "真幌"
        },
        {
            "location": "520/TALK",
            "narrator": "真幌",
            "text": "とりあえず、\n精進しろよ、半人前。",
            "zh": "总之，\n继续努力精进吧，小菜鸟。",
            "narrator_zh": "真幌"
        },
        {
            "location": "521/TALK",
            "narrator": "アーヤ",
            "text": "…はい、すみません。",
            "zh": "……是，非常抱歉。",
            "narrator_zh": "绫水"
        },
        {
            "location": "533/DIALOG",
            "narrator": "Dialog_chapter_ch02",
            "text": "【18 ブラック・クラン】",
            "zh": "【18 黑之库兰】",
            "narrator_zh": "Dialog_chapter_ch02"
        }
    ]
}
