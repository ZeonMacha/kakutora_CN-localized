        "title": "009 ココロスフィアストーリー【Lv03】",
        "sub_title": "壊されるココロⅡ＜帰結＞",
        "title_zh": "009 心灵领域故事【Lv03】",
        "sub_title_zh": "被弄坏的心Ⅱ＜归结＞"
    },
    "entry": [
        {
            "location": "62/SCENARIO",
            "narrator": "",
            "text": "壊されるココロ４",
            "zh": "被弄坏的心4",
            "narrator_zh": ""
        },
        {
            "location": "77/TALK",
            "narrator": "ガブリエラ",
            "text": "やったわ！\nガーディアンクランを\n倒せたっ！",
            "zh": "太好了！\n把守护库兰\n打倒了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "78/TALK",
            "narrator": "ガブリエラ",
            "text": "これで後は\n本体をぶっ壊せば！",
            "zh": "这样接下来\n只要把本体砸烂就……！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "89/TALK",
            "narrator": "ガブリエラ",
            "text": "ひっ！！",
            "zh": "噫！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "90/TALK",
            "narrator": "ガブリエラ",
            "text": "あんた誰よ！",
            "zh": "你谁啊！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "91/TALK",
            "narrator": "？？？",
            "text": "あたし　は　あなた",
            "zh": "我　就是　你",
            "narrator_zh": "？？？"
        },
        {
            "location": "92/TALK",
            "narrator": "？？？",
            "text": "とらうま　に\nおびえる　あなた",
            "zh": "畏惧　创伤\n的　你",
            "narrator_zh": "？？？"
        },
        {
            "location": "93/TALK",
            "narrator": "ガブリエラ",
            "text": "……　…っ…",
            "zh": "……　…唔…",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "94/SEL",
            "narrator": "（選択肢）",
            "text": "ガブリエラ？？",
            "zh": "加布里埃拉？？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "95/ACT",
            "narrator": "",
            "text": "ガブリエラ？？",
            "zh": "加布里埃拉？？",
            "narrator_zh": ""
        },
        {
            "location": "97/TALK",
            "narrator": "？？？",
            "text": "あたし　を\nけそうと　するの？",
            "zh": "你想　把\n我　抹消吗？",
            "narrator_zh": "？？？"
        },
        {
            "location": "98/TALK",
            "narrator": "？？？",
            "text": "それが　なにを\nいみ　するか",
            "zh": "那　究竟\n意味着　什么",
            "narrator_zh": "？？？"
        },
        {
            "location": "99/TALK",
            "narrator": "？？？",
            "text": "いま\nおしえて　あげる",
            "zh": "现在\n就　告诉你",
            "narrator_zh": "？？？"
        },
        {
            "location": "100/SEL",
            "narrator": "（選択肢）",
            "text": "去れ！！！",
            "zh": "滚开！！！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "115/TALK",
            "narrator": "ガブリエラ",
            "text": "いやああああああああ\nああああああああああ\nあああああああっ！！",
            "zh": "不要啊啊啊啊啊啊啊啊\n啊啊啊啊啊啊啊啊啊啊\n啊啊啊啊啊啊啊！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "130/TALK",
            "narrator": "ガブリエラ",
            "text": "…うっ……\n…　ううっ…ぐすっ…",
            "zh": "…唔……\n…　呜呜…呜……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "131/SEL",
            "narrator": "（選択肢）",
            "text": "大丈夫！？",
            "zh": "没事吧！？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "132/ACT",
            "narrator": "",
            "text": "大丈夫！？",
            "zh": "没事吧！？",
            "narrator_zh": ""
        },
        {
            "location": "134/TALK",
            "narrator": "ガブリエラ",
            "text": "もう……っ…\nぐすっ…",
            "zh": "不要……唔…\n呜…",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "135/TALK",
            "narrator": "ガブリエラ",
            "text": "……しにたい…　…",
            "zh": "……好想死…　…",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "136/ACT",
            "narrator": "",
            "text": "去れ！！！",
            "zh": "滚开！！！",
            "narrator_zh": ""
        },
        {
            "location": "157/TALK",
            "narrator": "ガブリエラ",
            "text": "…っ……はぁ…\n……　…っ…はぁっ…",
            "zh": "…唔……哈啊…\n……　…唔…哈啊…",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "158/TALK",
            "narrator": "ガブリエラ",
            "text": "あんたが…っ……\n助けてくれたの…？",
            "zh": "是你……\n救了我吗……？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "159/SEL",
            "narrator": "（選択肢）",
            "text": "多分",
            "zh": "大概吧",
            "narrator_zh": "（选项）"
        },
        {
            "location": "160/ACT",
            "narrator": "",
            "text": "多分",
            "zh": "大概吧",
            "narrator_zh": ""
        },
        {
            "location": "162/TALK",
            "narrator": "ガブリエラ",
            "text": "……ありがと…",
            "zh": "……谢谢…",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "163/SEL",
            "narrator": "（選択肢）",
            "text": "大丈夫？",
            "zh": "没事吧？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "164/ACT",
            "narrator": "",
            "text": "大丈夫？",
            "zh": "没事吧？",
            "narrator_zh": ""
        },
        {
            "location": "166/TALK",
            "narrator": "ガブリエラ",
            "text": "うん……\nもう平気。",
            "zh": "嗯……\n已经没事了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "167/TALK",
            "narrator": "ガブリエラ",
            "text": "でも……",
            "zh": "可是……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "168/TALK",
            "narrator": "ガブリエラ",
            "text": "やっぱりトラウマを\n自分で破壊するなんて\n無理なのかしら……",
            "zh": "果然，要靠自己\n破坏掉心理创伤什么的，\n还是办不到吗……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "169/SEL",
            "narrator": "（選択肢）",
            "text": "まだ何か方法があるかもしれない",
            "zh": "也许还有什么别的办法",
            "narrator_zh": "（选项）"
        },
        {
            "location": "170/ACT",
            "narrator": "",
            "text": "まだ何か方法があるかもしれない",
            "zh": "也许还有什么别的办法",
            "narrator_zh": ""
        },
        {
            "location": "172/TALK",
            "narrator": "ガブリエラ",
            "text": "……うん。\nそうね。",
            "zh": "……嗯。\n是啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "173/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、どうして\nあんたは、あたしに\n力を貸してくれるの？",
            "zh": "可是，为什么\n你愿意这样\n借给我力量呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "174/SEL",
            "narrator": "（選択肢）",
            "text": "好きだから",
            "zh": "因为喜欢你",
            "narrator_zh": "（选项）"
        },
        {
            "location": "175/SEL",
            "narrator": "（選択肢）",
            "text": "なんか気になる",
            "zh": "总觉得很在意",
            "narrator_zh": "（选项）"
        },
        {
            "location": "176/ACT",
            "narrator": "",
            "text": "好きだから",
            "zh": "因为喜欢你",
            "narrator_zh": ""
        },
        {
            "location": "178/TALK",
            "narrator": "ガブリエラ",
            "text": "ええっ！？\nちょっと何を急に\n言い出すのよ！",
            "zh": "诶诶！？\n等下，你怎么突然\n说这种话啊！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "179/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、ありがと。\n純粋に嬉しい。",
            "zh": "不过，谢谢。\n说真的，我很开心。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "180/TALK",
            "narrator": "ガブリエラ",
            "text": "と、とにかく\nこのままここにいても\n仕方ないわね。",
            "zh": "总、总之\n一直待在这里\n也不是办法。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "181/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしももっと\n強くならなくちゃ\nいけないと思うし――",
            "zh": "我也必须变得\n更坚强才行\n——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "182/TALK",
            "narrator": "ガブリエラ",
            "text": "また準備ができたら\n作戦を考えたいの。",
            "zh": "等我做好准备之后，\n想再思考一次作战。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "183/TALK",
            "narrator": "ガブリエラ",
            "text": "その時はまた、\nよければ、その――",
            "zh": "到时候，\n如果可以的话，那个——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "184/TALK",
            "narrator": "ガブリエラ",
            "text": "つ、つきあって\n欲しいかも……。",
            "zh": "希、希望你能\n陪我一起……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "185/SEL",
            "narrator": "（選択肢）",
            "text": "もちろん",
            "zh": "当然",
            "narrator_zh": "（选项）"
        },
        {
            "location": "186/ACT",
            "narrator": "",
            "text": "もちろん",
            "zh": "当然",
            "narrator_zh": ""
        },
        {
            "location": "189/TALK",
            "narrator": "ガブリエラ",
            "text": "ありがとう。\nまたよろしくね。",
            "zh": "谢谢。\n到时再多关照哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "190/ACT",
            "narrator": "",
            "text": "なんか気になる",
            "zh": "总觉得很在意",
            "narrator_zh": ""
        },
        {
            "location": "191/TALK",
            "narrator": "ガブリエラ",
            "text": "そっか…。でも\n無理はしないで。",
            "zh": "这样啊…。不过\n你也别太勉强。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "192/TALK",
            "narrator": "ガブリエラ",
            "text": "気が向いたら\nまたつき合ってよね。",
            "zh": "要是心血来潮了，\n再来陪我吧。",
            "narrator_zh": "加布里埃拉"
        }
    ]
}
