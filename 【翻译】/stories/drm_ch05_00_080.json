        "title": "らぶとーく 第08話",
        "sub_title": "フェノメノンという現象について",
        "title_zh": "恋爱漫谈 第08话",
        "sub_title_zh": "关于名为PhenoMENON的现象"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "フェノメノンという現象について",
            "zh": "关于名为PhenoMENON的现象",
            "narrator_zh": ""
        },
        {
            "location": "22/TALK",
            "narrator": "アーヤ",
            "text": "二人ともお疲れさま。\n体調はどう？\n怪我とかしてない？",
            "zh": "你们俩都辛苦了。\n身体还好吗？\n有没有受伤之类的？",
            "narrator_zh": "绫水"
        },
        {
            "location": "24/TALK",
            "narrator": "つばめ",
            "text": "はい！\n大丈夫です！",
            "zh": "好！\n没问题！",
            "narrator_zh": "燕"
        },
        {
            "location": "26/TALK",
            "narrator": "アーヤ",
            "text": "卯月はどう？",
            "zh": "卯月怎么样？",
            "narrator_zh": "绫水"
        },
        {
            "location": "27/TALK",
            "narrator": "神楽",
            "text": "…大丈夫です。",
            "zh": "……没事的。",
            "narrator_zh": "神乐"
        },
        {
            "location": "28/TALK",
            "narrator": "アーヤ",
            "text": "無理しないで…って\n言えないのが辛い\nところだけど。",
            "zh": "虽然真难受啊，\n没法说出“别太勉强”\n这种话。",
            "narrator_zh": "绫水"
        },
        {
            "location": "29/TALK",
            "narrator": "アーヤ",
            "text": "できるだけ\nフォローしたいと\n思ってるから。",
            "zh": "因为我想尽量\n在旁\n支援。",
            "narrator_zh": "绫水"
        },
        {
            "location": "30/TALK",
            "narrator": "つばめ",
            "text": "アーヤさん…。",
            "zh": "绫水……。",
            "narrator_zh": "燕"
        },
        {
            "location": "32/TALK",
            "narrator": "アーヤ",
            "text": "じゃあちょっと\nギャヴィとみやびの\nところに行ってくるわ。",
            "zh": "那我稍微\n去加维和雅\n那边一趟。",
            "narrator_zh": "绫水"
        },
        {
            "location": "33/TALK",
            "narrator": "アーヤ",
            "text": "後はゆっくり\n休んでね。",
            "zh": "剩下的时间\n好好休息哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "37/TALK",
            "narrator": "神楽",
            "text": "お疲れさまでした、\nつばめさん。",
            "zh": "辛苦了，\n燕。",
            "narrator_zh": "神乐"
        },
        {
            "location": "38/TALK",
            "narrator": "つばめ",
            "text": "ううん、卯月さんこそ。\n助かったよ。",
            "zh": "没这回事，卯月才是。\n多亏你帮忙了。",
            "narrator_zh": "燕"
        },
        {
            "location": "40/TALK",
            "narrator": "つばめ",
            "text": "わたしみんなの\n足引っ張って\nばかりだね。",
            "zh": "我总是\n在拖大家的\n后腿呢。",
            "narrator_zh": "燕"
        },
        {
            "location": "41/TALK",
            "narrator": "つばめ",
            "text": "もっと\nがんばらなきゃ…。",
            "zh": "我得\n更努力才行……。",
            "narrator_zh": "燕"
        },
        {
            "location": "42/TALK",
            "narrator": "神楽",
            "text": "大丈夫ですよ。",
            "zh": "没关系哦。",
            "narrator_zh": "神乐"
        },
        {
            "location": "43/TALK",
            "narrator": "つばめ",
            "text": "…ありがとう。\n卯月さんは優しいね。",
            "zh": "……谢谢。\n卯月真温柔呢。",
            "narrator_zh": "燕"
        },
        {
            "location": "44/TALK",
            "narrator": "神楽",
            "text": "そんなこと\nないですよー！",
            "zh": "没有\n那种事啦——！",
            "narrator_zh": "神乐"
        },
        {
            "location": "45/TALK",
            "narrator": "神楽",
            "text": "つばめさんの方が\n優しいし\nかわいいですー！",
            "zh": "燕更\n温柔，也更\n可爱——！",
            "narrator_zh": "神乐"
        },
        {
            "location": "47/TALK",
            "narrator": "つばめ",
            "text": "えっ！？",
            "zh": "诶！？",
            "narrator_zh": "燕"
        },
        {
            "location": "48/TALK",
            "narrator": "神楽",
            "text": "食べたくなっちゃい\nますー！\n食べていいですか？",
            "zh": "让人好想吃一口\n啊——！\n可以吃掉吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "49/TALK",
            "narrator": "つばめ",
            "text": "え、えっと……。",
            "zh": "那、那个……。",
            "narrator_zh": "燕"
        },
        {
            "location": "51/SEL",
            "narrator": "",
            "text": "どういう意味で？",
            "zh": "是什么意思？",
            "narrator_zh": ""
        },
        {
            "location": "52/ACT",
            "narrator": "",
            "text": "どういう意味で？",
            "zh": "是什么意思？",
            "narrator_zh": ""
        },
        {
            "location": "69/TALK",
            "narrator": "神楽",
            "text": "どういう意味でだと思いますか？",
            "zh": "你觉得是什么意思？",
            "narrator_zh": "神乐"
        },
        {
            "location": "71/SEL",
            "narrator": "",
            "text": "性欲的な",
            "zh": "色欲那种",
            "narrator_zh": ""
        },
        {
            "location": "72/SEL",
            "narrator": "",
            "text": "食欲的な",
            "zh": "食欲那种的",
            "narrator_zh": ""
        },
        {
            "location": "73/SEL",
            "narrator": "",
            "text": "睡眠欲？？？",
            "zh": "睡眠欲？？？",
            "narrator_zh": ""
        },
        {
            "location": "74/ACT",
            "narrator": "",
            "text": "性欲的な",
            "zh": "色欲那种",
            "narrator_zh": ""
        },
        {
            "location": "75/TALK",
            "narrator": "神楽",
            "text": "エッチですねー$handle$さんってば♪",
            "zh": "$handle$你真色呢——♪",
            "narrator_zh": "神乐"
        },
        {
            "location": "86/TALK",
            "narrator": "神楽",
            "text": "これから二人っきりに\nなれるところに\n行きましょう！",
            "zh": "接下来我们\n去能两个人\n独处的地方吧！",
            "narrator_zh": "神乐"
        },
        {
            "location": "87/TALK",
            "narrator": "つばめ",
            "text": "え、もう二人っきり\nだよ…？",
            "zh": "诶，现在就已经是\n两个人独处了哦……？",
            "narrator_zh": "燕"
        },
        {
            "location": "89/TALK",
            "narrator": "神楽",
            "text": "そういう意味じゃ\nありませんよー！",
            "zh": "不是那个意思\n啦——！",
            "narrator_zh": "神乐"
        },
        {
            "location": "90/TALK",
            "narrator": "神楽",
            "text": "でもそういうところも\nつばめさんらしくて\nかわいいです。",
            "zh": "不过那种地方\n也很像燕，\n很可爱。",
            "narrator_zh": "神乐"
        },
        {
            "location": "91/ACT",
            "narrator": "",
            "text": "食欲的な",
            "zh": "食欲那种的",
            "narrator_zh": ""
        },
        {
            "location": "92/TALK",
            "narrator": "神楽",
            "text": "なるほどです♪",
            "zh": "原来如此♪",
            "narrator_zh": "神乐"
        },
        {
            "location": "93/TALK",
            "narrator": "神楽",
            "text": "了解しました★",
            "zh": "了解了★",
            "narrator_zh": "神乐"
        },
        {
            "location": "104/TALK",
            "narrator": "神楽",
            "text": "というか\n甘いものでも\n食べに行きませんか？",
            "zh": "话说要不要\n去吃点\n甜的？",
            "narrator_zh": "神乐"
        },
        {
            "location": "105/TALK",
            "narrator": "つばめ",
            "text": "あ、そういう意味\nだったの？",
            "zh": "啊，原来是那个\n意思呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "106/ACT",
            "narrator": "",
            "text": "睡眠欲？？？",
            "zh": "睡眠欲？？？",
            "narrator_zh": ""
        },
        {
            "location": "107/TALK",
            "narrator": "神楽",
            "text": "ぴょんこは食いしん坊キャラなんですか？",
            "zh": "蹦子难道是吃货人设吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "108/TALK",
            "narrator": "神楽",
            "text": "寝言でも食べたいとか言ってる系の？？？",
            "zh": "是那种连说梦话都在喊想吃什么什么的类型吗？？？",
            "narrator_zh": "神乐"
        },
        {
            "location": "109/TALK",
            "narrator": "神楽",
            "text": "そんなことを言う$handle$さんは不思議ちゃん枠ですね★",
            "zh": "说那种话的$handle$真是奇人类型呢★",
            "narrator_zh": "神乐"
        },
        {
            "location": "120/TALK",
            "narrator": "神楽",
            "text": "つばめさんは今\n何がしたいですか？",
            "zh": "燕现在\n想做什么？",
            "narrator_zh": "神乐"
        },
        {
            "location": "121/TALK",
            "narrator": "つばめ",
            "text": "わたし……？",
            "zh": "我……？",
            "narrator_zh": "燕"
        },
        {
            "location": "123/TALK",
            "narrator": "つばめ",
            "text": "ちょっと疲れたし、\nお昼寝したいかも。",
            "zh": "有点累了，\n也许想睡个午觉。",
            "narrator_zh": "燕"
        },
        {
            "location": "125/TALK",
            "narrator": "つばめ",
            "text": "そういえば\n卯月さんは寮に\n入る気はないの？",
            "zh": "说起来，\n卯月没打算\n住进宿舍吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "126/TALK",
            "narrator": "神楽",
            "text": "……そうですね。\n自宅もそんなに\n遠くないですし。",
            "zh": "……是啊。\n我家离得也\n不算太远。",
            "narrator_zh": "神乐"
        },
        {
            "location": "127/TALK",
            "narrator": "つばめ",
            "text": "そっかー。\nそうだよね。",
            "zh": "这样啊。\n是啊。",
            "narrator_zh": "燕"
        },
        {
            "location": "128/TALK",
            "narrator": "つばめ",
            "text": "今日みたいな日に\n同じところに\n帰れたらいいなって。",
            "zh": "我就在想，像今天\n这样的日子要是能回\n同一个地方就好了。",
            "narrator_zh": "燕"
        },
        {
            "location": "129/TALK",
            "narrator": "つばめ",
            "text": "そう思ったけど\n卯月さんはおうちに\n帰る方がいいよね。",
            "zh": "我虽然这么想，\n但卯月还是\n回家比较好。",
            "narrator_zh": "燕"
        },
        {
            "location": "130/TALK",
            "narrator": "つばめ",
            "text": "わたしは卯月さんと\n一緒の方が\nうれしいけど。",
            "zh": "不过对我来说，\n能和卯月一起\n会更开心哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "131/TALK",
            "narrator": "神楽",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "132/TALK",
            "narrator": "つばめ",
            "text": "変なこと言って\nごめんね。\nまた明日！",
            "zh": "说了奇怪的话，\n抱歉哦。\n明天见！",
            "narrator_zh": "燕"
        },
        {
            "location": "133/TALK",
            "narrator": "神楽",
            "text": "…ええ、また明日。",
            "zh": "……嗯，明天见。",
            "narrator_zh": "神乐"
        },
        {
            "location": "146/TALK",
            "narrator": "神楽",
            "text": "ぴょんこは何で今フェノメノンが発生しないのかって思ってるんですよ",
            "zh": "蹦子我在想为什么现在没有发生PhenoMENON呀",
            "narrator_zh": "神乐"
        },
        {
            "location": "148/TALK",
            "narrator": "神楽",
            "text": "どうしてだかわかりますか？",
            "zh": "你知道为什么吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "150/SEL",
            "narrator": "",
            "text": "ごめんわかんない",
            "zh": "抱歉我搞不懂",
            "narrator_zh": ""
        },
        {
            "location": "151/SEL",
            "narrator": "",
            "text": "ワーカホリックだから",
            "zh": "因为是工作狂",
            "narrator_zh": ""
        },
        {
            "location": "152/SEL",
            "narrator": "",
            "text": "色々こじらせてるからじゃない？",
            "zh": "因为各种事都憋得太拧巴了吧？",
            "narrator_zh": ""
        },
        {
            "location": "153/ACT",
            "narrator": "",
            "text": "ごめんわかんない",
            "zh": "抱歉我搞不懂",
            "narrator_zh": ""
        },
        {
            "location": "154/TALK",
            "narrator": "神楽",
            "text": "そうですよね、、、",
            "zh": "是啊、、、",
            "narrator_zh": "神乐"
        },
        {
            "location": "155/TALK",
            "narrator": "神楽",
            "text": "ちょっと整理できたらお話ししてもいいですか？",
            "zh": "等我稍微整理一下再谈可以吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "156/ACT",
            "narrator": "",
            "text": "ワーカホリックだから",
            "zh": "因为是工作狂",
            "narrator_zh": ""
        },
        {
            "location": "157/TALK",
            "narrator": "神楽",
            "text": "そうかもしれませんね、、、",
            "zh": "也许是这样呢……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "158/ACT",
            "narrator": "",
            "text": "色々こじらせてるからじゃない？",
            "zh": "因为各种事都憋得太拧巴了吧？",
            "narrator_zh": ""
        },
        {
            "location": "159/TALK",
            "narrator": "神楽",
            "text": "そんなぴょんことお友達でいてくれるんですよね？",
            "zh": "你愿意跟这样的蹦子做朋友吧？",
            "narrator_zh": "神乐"
        },
        {
            "location": "162/TALK",
            "narrator": "神楽",
            "text": "お友達になったからってこんなぴょんこはいきなりディープすぎますか？",
            "zh": "就算成了朋友，这样的蹦子是不是太深入了点？",
            "narrator_zh": "神乐"
        },
        {
            "location": "164/SEL",
            "narrator": "",
            "text": "ちょっとね",
