{
    "dir": "chap18/daydra/dd_ch03_18_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "18302",
        "cid": "gabriella",
        "title": "002 メインストーリー",
        "sub_title": "違う気がする＜前編＞",
        "title_zh": "002 主线剧情",
        "sub_title_zh": "总觉得不对劲＜前篇＞"
    },
    "entry": [
        {
            "location": "30/TALK",
            "narrator": "ガブリエラ",
            "text": "…ここにもない。\nおかしいわね…。",
            "zh": "……这里也没有。\n真奇怪呢……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "31/TALK",
            "narrator": "ガブリエラ",
            "text": "フ、の棚はここからの\nはずなのに…。",
            "zh": "“F”的货架明明该从\n这里开始的啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "32/TALK",
            "narrator": "ガブリエラ",
            "text": "う～ん…。",
            "zh": "唔～嗯……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "33/SEL",
            "narrator": "",
            "text": "何してるの？",
            "zh": "你在干什么呢？",
            "narrator_zh": ""
        },
        {
            "location": "34/ACT",
            "narrator": "",
            "text": "何してるの？",
            "zh": "你在干什么呢？",
            "narrator_zh": ""
        },
        {
            "location": "51/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょっと探し物よ",
            "zh": "我在找点东西哦",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "52/TALK",
            "narrator": "ガブリエラ",
            "text": "でも見つからないの",
            "zh": "可就是找不到",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "53/TALK",
            "narrator": "ガブリエラ",
            "text": "おかしいわ",
            "zh": "真奇怪",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "54/TALK",
            "narrator": "ガブリエラ",
            "text": "人気ないのかしら？",
            "zh": "难道说没什么人气吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "56/SEL",
            "narrator": "",
            "text": "何を探してるの？",
            "zh": "你在找什么？",
            "narrator_zh": ""
        },
        {
            "location": "57/ACT",
            "narrator": "",
            "text": "何を探してるの？",
            "zh": "你在找什么？",
            "narrator_zh": ""
        },
        {
            "location": "59/TALK",
            "narrator": "ガブリエラ",
            "text": "ＣＤよ",
            "zh": "CD啦",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "60/TALK",
            "narrator": "ガブリエラ",
            "text": "わかるでしょ？",
            "zh": "这还用问吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "63/TALK",
            "narrator": "ガブリエラ",
            "text": "メノウのＣＤよ",
            "zh": "是MENOW的CD啦",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "64/TALK",
            "narrator": "ガブリエラ",
            "text": "別に",
            "zh": "我也不是",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "65/TALK",
            "narrator": "ガブリエラ",
            "text": "聞きたいわけじゃないから",
            "zh": "有多想听才找的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "66/TALK",
            "narrator": "ガブリエラ",
            "text": "ファンじゃないし",
            "zh": "我也不是她的粉丝",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "67/TALK",
            "narrator": "ガブリエラ",
            "text": "でも",
            "zh": "不过",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "68/TALK",
            "narrator": "ガブリエラ",
            "text": "たくさん怒ったからかしらね？",
            "zh": "大概是之前气过头了吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "69/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょっと吹っ切れたのかも",
            "zh": "现在反而有点想通了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "70/TALK",
            "narrator": "ガブリエラ",
            "text": "だから",
            "zh": "所以",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "71/TALK",
            "narrator": "ガブリエラ",
            "text": "聞いてみようと思ったのよ",
            "zh": "才想着买来听听看",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "72/TALK",
            "narrator": "ガブリエラ",
            "text": "もしかしたら",
            "zh": "说不定",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "73/TALK",
            "narrator": "ガブリエラ",
            "text": "知れるかもしれないでしょう？",
            "zh": "能借此多了解一点吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "74/TALK",
            "narrator": "ガブリエラ",
            "text": "神楽のこと",
            "zh": "关于神乐的事",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "75/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょっとだけでも",
            "zh": "哪怕只是稍微了解一点也好",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "77/SEL",
            "narrator": "",
            "text": "聞いたことないんだっけ？",
            "zh": "你以前没听过吗？",
            "narrator_zh": ""
        },
        {
            "location": "78/SEL",
            "narrator": "",
            "text": "それで何か知れるかな？",
            "zh": "听CD能了解出什么吗？",
            "narrator_zh": ""
        },
        {
            "location": "79/ACT",
            "narrator": "",
            "text": "聞いたことないんだっけ？",
            "zh": "你以前没听过吗？",
            "narrator_zh": ""
        },
        {
            "location": "80/TALK",
            "narrator": "ガブリエラ",
            "text": "そうなのよ",
            "zh": "是呀",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "81/TALK",
            "narrator": "ガブリエラ",
            "text": "流行りらしいけど",
            "zh": "虽说好像挺火的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "82/TALK",
            "narrator": "ガブリエラ",
            "text": "まだ聞いたことなくて",
            "zh": "但我还没认真听过",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "83/TALK",
            "narrator": "ガブリエラ",
            "text": "よく耳にはするけど",
            "zh": "平时倒是经常在耳边听到",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "86/TALK",
            "narrator": "ガブリエラ",
            "text": "まあ",
            "zh": "嘛",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "87/TALK",
            "narrator": "ガブリエラ",
            "text": "いい声よね",
            "zh": "嗓音确实不错呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "88/ACT",
            "narrator": "",
            "text": "それで何か知れるかな？",
            "zh": "听CD能了解出什么吗？",
            "narrator_zh": ""
        },
        {
            "location": "89/TALK",
            "narrator": "ガブリエラ",
            "text": "さあ？",
            "zh": "谁知道呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "90/TALK",
            "narrator": "ガブリエラ",
            "text": "そんなの知らないわよ",
            "zh": "那种事我哪儿知道啊",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "91/TALK",
            "narrator": "ガブリエラ",
            "text": "メノウのことは知れるんじゃないかしら？",
            "zh": "至少对MENOW应该能有所了解吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "92/TALK",
            "narrator": "ガブリエラ",
            "text": "売れてる歌手程度にしか知らなかったし",
            "zh": "我以前对她也就只知道是个畅销歌手而已",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "93/TALK",
            "narrator": "ガブリエラ",
            "text": "だから",
            "zh": "所以",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "94/TALK",
            "narrator": "ガブリエラ",
            "text": "メノウをやってるときの神楽が",
            "zh": "我至少想知道作为MENOW活动时的神乐",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "95/TALK",
            "narrator": "ガブリエラ",
            "text": "どんな感じなのかだけでも知りたいのよ",
            "zh": "究竟是个什么样子呀",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "97/TALK",
            "narrator": "ガブリエラ",
            "text": "まあ",
            "zh": "嘛",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "98/TALK",
            "narrator": "ガブリエラ",
            "text": "ＣＤで全部知れるわけないし",
            "zh": "光靠一张CD也不可能了解全部啦",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "99/TALK",
            "narrator": "ガブリエラ",
            "text": "最初の一歩？",
            "zh": "算是第一步？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "100/TALK",
            "narrator": "ガブリエラ",
            "text": "それくらいの気持ちよ",
            "zh": "差不多就是这种心态吧",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "111/TALK",
            "narrator": "ガブリエラ",
            "text": "…でも、肝心のＣＤが\n見つからないのよね。",
            "zh": "……可是，最关键的CD\n却怎么都找不到呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "112/TALK",
            "narrator": "ガブリエラ",
            "text": "この辺にあるはず\nなんだけど…。",
            "zh": "按理说应该就在\n这一带才对……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "114/TALK",
            "narrator": "ガブリエラ",
            "text": "…あれ？",
            "zh": "……咦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "117/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "118/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤ。",
            "zh": "绫水。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "119/TALK",
            "narrator": "アーヤ",
            "text": "あら？　ギャヴィも\nＣＤ見に来たの？",
            "zh": "哎呀？　加维也是\n来看CD的吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "120/TALK",
            "narrator": "ガブリエラ",
            "text": "ええ、神楽――",
            "zh": "嗯，来看神乐——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "121/TALK",
            "narrator": "ガブリエラ",
            "text": "じゃなくて、\nメノウのＣＤをね…。",
            "zh": "不对，\n是MENOW的CD……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "122/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィも！？",
            "zh": "加维也是！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "123/TALK",
            "narrator": "ガブリエラ",
            "text": "え？　それじゃあ\nアーヤも？",
            "zh": "咦？　那难道说\n绫水也是？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "124/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "125/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "127/TALK",
            "narrator": "アーヤ",
            "text": "ふふっ、考えることは\n同じね。",
            "zh": "呵呵，想到一块儿\n去了呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "128/TALK",
            "narrator": "ガブリエラ",
            "text": "そうみたいね。\nけど、メノウのＣＤ\nなかったでしょ？",
            "zh": "看来是呢。\n不过，这边好像没看到\nMENOW的CD吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "129/TALK",
            "narrator": "アーヤ",
            "text": "ああ、それなら\n向こうにコーナーが\n作られてたわ。",
            "zh": "哦，那个的话，\n那边专门给她设了\n一个专区哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "130/TALK",
            "narrator": "ガブリエラ",
            "text": "ああ、それでか…。",
            "zh": "啊，原来如此……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "131/TALK",
            "narrator": "ガブリエラ",
            "text": "あれ？　でもアーヤ、\nＣＤ持ってないじゃ\nない。",
            "zh": "咦？　可绫水你\n手里不是没拿\nCD吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "132/TALK",
            "narrator": "アーヤ",
            "text": "…買おうとは思ったん\nだけど…。",
            "zh": "……我本来是想\n买一张的……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "133/TALK",
            "narrator": "アーヤ",
            "text": "なんか、これでいいの\nかな、って気になって\nきちゃって…。",
            "zh": "可总觉得，这样\n真的好吗，越想越觉得\n有点不对劲……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "134/TALK",
            "narrator": "ガブリエラ",
            "text": "どういうこと？",
            "zh": "什么意思？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "136/TALK",
            "narrator": "アーヤ",
            "text": "だって、メノウの\n正体を卯月はずっと\n隠してたんだもの。",
            "zh": "毕竟，她是MENOW\n这件事，卯月一直都在\n刻意隐瞒着吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "137/TALK",
            "narrator": "アーヤ",
            "text": "それを、こんな形で\n知ったからって――",
            "zh": "结果我们用那种方式\n知道了真相，回头就跑来——",
            "narrator_zh": "绫水"
        },
        {
            "location": "138/TALK",
            "narrator": "アーヤ",
            "text": "メノウのＣＤを聞いて\nみるっていうのは、\nなんか違くない？",
            "zh": "听MENOW的CD\n去试探她，总觉得\n有点不太对劲吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "139/TALK",
            "narrator": "ガブリエラ",
            "text": "だから、\n何が違うのよ？",
            "zh": "所以说，\n到底是哪儿不对劲啊？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "140/TALK",
            "narrator": "アーヤ",
            "text": "…なんか、卑怯な\n感じがするのよ。",
            "zh": "……总有种，趁人之危\n的感觉。",
            "narrator_zh": "绫水"
        },
        {
            "location": "141/TALK",
            "narrator": "ガブリエラ",
            "text": "卑怯って…ちょっと\n気にし過ぎじゃない？",
            "zh": "趁人之危……你未免\n想太多了吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "142/TALK",
            "narrator": "アーヤ",
            "text": "そうかしら…。",
            "zh": "是吗……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "143/TALK",
            "narrator": "ガブリエラ",
            "text": "そうよ。",
            "zh": "是啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "145/TALK",
            "narrator": "ガブリエラ",
            "text": "ていうか、そんなこと\n言われたらあたしまで\n買いづらいじゃない。",
            "zh": "话说回来，被你这么\n一说，连我都不好意思\n去买啦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "146/TALK",
            "narrator": "アーヤ",
            "text": "ご、ごめん…。",
            "zh": "抱、抱歉……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "147/TALK",
            "narrator": "ガブリエラ",
            "text": "もぅ…。",
            "zh": "真是的……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "148/TALK",
            "narrator": "ガブリエラ",
            "text": "…でも、アーヤの\n言ってることも\n一理あるかも。",
            "zh": "……不过，绫水\n说的话倒也\n有几分道理。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "149/TALK",
            "narrator": "ガブリエラ",
            "text": "知られたくなくて\n隠してたこと\nなんだもの。",
            "zh": "那毕竟是她不想被人\n知道而一直藏着的\n秘密嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "150/TALK",
            "narrator": "ガブリエラ",
            "text": "そこから色々知ろうと\n思うのって、ちょっと\n卑怯なのかも…。",
            "zh": "还想顺着这个去打探\n她的各种事，或许确实\n有点卑鄙吧……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "151/TALK",
            "narrator": "ガブリエラ",
            "text": "だとしたら…。",
            "zh": "要是那样的话……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "152/TALK",
            "narrator": "ガブリエラ",
            "text": "逆に離れられることに\nなっちゃうの？",
            "zh": "反而会让她跟我们\n越走越远吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "153/TALK",
            "narrator": "ガブリエラ",
            "text": "…どうしよう。",
            "zh": "……这下该怎么办才好。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "217/TALK",
            "narrator": "ガブリエラ",
            "text": "　",
            "zh": "　",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "226/TALK",
            "narrator": "ガブリエラ",
            "text": "あ、$handle$！\nいらっしゃい！",
            "zh": "啊，$handle$！\n欢迎光临！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "227/TALK",
            "narrator": "ガブリエラ",
            "text": "さて、今日はどんな\n悩みなのかしらね！",
            "zh": "那么，今天又是什么样的\n烦恼呢！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "239/SEL",
            "narrator": "",
            "text": "ここに来ると平和で和む",
            "zh": "来这里就觉得很平和很舒心",
            "narrator_zh": ""
        },
        {
            "location": "240/SEL",
            "narrator": "",
            "text": "ガブリエラは本当に何ともないの？",
            "zh": "加布里埃拉真的什么事都没有吗？",
            "narrator_zh": ""
        },
        {
            "location": "241/ACT",
            "narrator": "",
            "text": "ここに来ると平和で和む",
            "zh": "来这里就觉得很平和很舒心",
            "narrator_zh": ""
        },
        {
            "location": "242/TALK",
            "narrator": "ガブリエラ",
            "text": "え？　どうしたの？\n急に。",
            "zh": "咦？　怎么了？\n突然这么说。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "243/ACT",
            "narrator": "",
            "text": "ガブリエラは本当に何ともないの？",
            "zh": "加布里埃拉真的什么事都没有吗？",
            "narrator_zh": ""
        },
        {
            "location": "244/TALK",
            "narrator": "ガブリエラ",
            "text": "え？\n何ともない…って？\n何が？",
            "zh": "咦？\n什么叫……没事？\n指什么事？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "246/SEL",
            "narrator": "",
            "text": "他の子のココロの中はだいぶきな臭くなってるから",
            "zh": "因为其他女孩子的心灵里面现在已经挺剑拔弩张的了",
            "narrator_zh": ""
        },
        {
            "location": "247/ACT",
            "narrator": "",
            "text": "他の子のココロの中はだいぶきな臭くなってるから",
            "zh": "因为其他女孩子的心灵里面现在已经挺剑拔弩张的了",
            "narrator_zh": ""
        },
        {
            "location": "249/TALK",
            "narrator": "ガブリエラ",
            "text": "こーら。他の乙女のお話を\n乙女のココロの部屋で\n言ったりしないのよ？",
            "zh": "好—啦。不许在一位少女的\n心之房间里，聊别的\n少女的事情哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "250/TALK",
            "narrator": "ガブリエラ",
            "text": "まあ、みんな色々\n問題を抱えてそう\nだものね。",
            "zh": "嘛，大家看起来确实\n各自都背着不少\n问题呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "251/TALK",
            "narrator": "ガブリエラ",
            "text": "でもあたしは大丈夫！\nみんなと違って\n幸せにやってるから！",
            "zh": "不过我没问题！\n跟大家不一样，\n我可是过得很幸福的！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "252/SEL",
            "narrator": "",
            "text": "いや、そういう個人的な悩みで修羅場ってるわけじゃなくて…",
            "zh": "不，倒也不是那种个人烦恼引起的修罗场……",
            "narrator_zh": ""
        },
        {
            "location": "253/SEL",
            "narrator": "",
            "text": "いや、それは嘘でしょ",
            "zh": "不，那是在骗人吧",
            "narrator_zh": ""
        },
        {
            "location": "254/ACT",
            "narrator": "",
            "text": "いや、そういう個人的な悩みで修羅場ってるわけじゃなくて…",
            "zh": "不，倒也不是那种个人烦恼引起的修罗场……",
            "narrator_zh": ""
        },
        {
            "location": "255/TALK",
            "narrator": "ガブリエラ",
            "text": "そうなの？\n個人的な悩みじゃないって\nことは、どういう事なの？",
