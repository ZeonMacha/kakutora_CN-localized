            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "278/SEL",
            "narrator": "",
            "text": "わかる",
            "zh": "懂",
            "narrator_zh": ""
        },
        {
            "location": "279/SEL",
            "narrator": "",
            "text": "わからない",
            "zh": "不懂",
            "narrator_zh": ""
        },
        {
            "location": "280/ACT",
            "narrator": "",
            "text": "わかる",
            "zh": "懂",
            "narrator_zh": ""
        },
        {
            "location": "281/TALK",
            "narrator": "ガブリエラ",
            "text": "よかった。\n$handle$が\n常識的な人で。",
