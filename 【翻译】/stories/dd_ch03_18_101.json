        },
        {
            "location": "273/TALK",
            "narrator": "ガブリエラ",
            "text": "ふーん、なるほどね。",
            "zh": "哼嗯，原来如此。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "274/TALK",
            "narrator": "ガブリエラ",
            "text": "まあ確かに、あんたが\n言う事は間違ってないわ。",
