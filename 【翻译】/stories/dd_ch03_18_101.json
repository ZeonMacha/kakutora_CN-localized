            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "256/SEL",
            "narrator": "",
            "text": "もっとこう、世界全体の潮流っていうか",
            "zh": "更像是……整个世界的大趋势之类的",
            "narrator_zh": ""
        },
        {
            "location": "257/SEL",
            "narrator": "",
            "text": "いや、忘れてくれ",
            "zh": "不，忘了吧",
            "narrator_zh": ""
        },
        {
            "location": "258/ACT",
            "narrator": "",
            "text": "もっとこう、世界全体の潮流っていうか",
            "zh": "更像是……整个世界的大趋势之类的",
            "narrator_zh": ""
        },
        {
            "location": "260/TALK",
            "narrator": "ガブリエラ",
            "text": "……ふーん。\nそういうのがあるのね。",
            "zh": "……哼—嗯。\n还有那种事啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "261/TALK",
            "narrator": "ガブリエラ",
            "text": "よくわからないけど、\nあたしはいつも通り\n元気にやってるだけよ？",
            "zh": "虽然不太明白，\n但我一直都跟平时一样\n元气满满地过日子哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "262/ACT",
            "narrator": "",
            "text": "いや、忘れてくれ",
