            "narrator_zh": ""
        },
        {
            "location": "263/TALK",
            "narrator": "ガブリエラ",
            "text": "ええっ？\n$handle$から\n話を振ってきたのに。",
            "zh": "哎—？\n明明是$handle$你\n先起的话头。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "264/TALK",
            "narrator": "ガブリエラ",
            "text": "まあいいわ。",
            "zh": "算了，随你吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "266/ACT",
            "narrator": "",
            "text": "いや、それは嘘でしょ",
            "zh": "不，那是在骗人吧",
            "narrator_zh": ""
        },
        {
            "location": "267/TALK",
            "narrator": "ガブリエラ",
            "text": "どうしてよ。",
