{
    "dir": "chap06/daydra/dd_ch01_06_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "6156",
        "cid": "tsubame",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "心配されるつばめ",
        "title_zh": "Extra006 额外剧情",
        "sub_title_zh": "被人担心的燕"
    },
    "entry": [
        {
            "location": "197/SCENARIO",
            "narrator": "",
            "text": "心配されるつばめ",
            "zh": "被人担心的燕",
            "narrator_zh": ""
        },
        {
            "location": "208/TALK",
            "narrator": "ガブリエラ",
            "text": "…アーヤ、遅いわね。\n車取りに行くのに\n何分掛かってるのよ？",
            "zh": "……绫水，好慢。\n去取车，\n要花几分钟？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "209/TALK",
            "narrator": "ガブリエラ",
            "text": "一刻を争う事態なの、\nわかってるのかしら？",
            "zh": "这是争分夺秒的事，\n你明白吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "210/TALK",
            "narrator": "みやび",
            "text": "出撃前で気分高まっ\nちょるなぁ。",
            "zh": "出战之前，兴致\n高得很。",
            "narrator_zh": "雅"
        },
        {
            "location": "211/TALK",
            "narrator": "ガブリエラ",
            "text": "みやびもちょっとは\nヤル気見せなさいよ。",
            "zh": "雅也拿出一点\n干劲来。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "213/TALK",
            "narrator": "ガブリエラ",
            "text": "てか、つばめ。",
            "zh": "话说，燕。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "215/TALK",
            "narrator": "つばめ",
            "text": "は、はい！",
            "zh": "是、是！",
            "narrator_zh": "燕"
        },
        {
            "location": "217/TALK",
            "narrator": "ガブリエラ",
            "text": "一番ヤル気出さなきゃ\nいけないのは\nあんたでしょ？",
            "zh": "最该拿出干劲的\n是\n你吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "218/TALK",
            "narrator": "ガブリエラ",
            "text": "中途半端な気持ちだと\n簡単に死ぬわよ？",
            "zh": "心思只到一半，\n很容易死掉哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "221/TALK",
            "narrator": "つばめ",
            "text": "ご、ごめんなさい…。",
            "zh": "对、对不起……。",
            "narrator_zh": "燕"
        },
        {
            "location": "223/TALK",
            "narrator": "みやび",
            "text": "まあ、死ぬほど痛い\n思いはするかも\nしれんけんど――",
            "zh": "嘛，疼得要死的\n感觉也许会有，\n不过——",
            "narrator_zh": "雅"
        },
        {
            "location": "224/TALK",
            "narrator": "みやび",
            "text": "コネクトしとけば、\nそう簡単に死ぬことは\nないちや。",
            "zh": "接上的话，\n不会那么轻易\n死掉咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "226/TALK",
            "narrator": "つばめ",
            "text": "そ、そうですか…。\n少し安心しました。",
            "zh": "是、是吗……\n稍微安心了。",
            "narrator_zh": "燕"
        },
        {
            "location": "229/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…そういうのが\n半端な気持ち、って\n言ってるのに…。",
            "zh": "哈啊……我就是在说\n这种不上不下的心思，\n结果……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "231/TALK",
            "narrator": "みやび",
            "text": "まあ、緊張するんは\n仕方ないことやき――",
            "zh": "嘛，会紧张\n也是没办法的事啵——",
            "narrator_zh": "雅"
        },
        {
            "location": "232/TALK",
            "narrator": "みやび",
            "text": "ここは先輩として、\nちくっと緊張を\nやわらげちゃる。",
            "zh": "这里作为前辈，\n给你松一哈\n紧张。",
            "narrator_zh": "雅"
        },
        {
            "location": "234/TALK",
            "narrator": "ガブリエラ",
            "text": "どうする気よ？",
            "zh": "你想干什么？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "236/TALK",
            "narrator": "みやび",
            "text": "まあ、こんな時は\n雑談が一番やろ。",
            "zh": "嘛，这种时候\n闲聊最合适吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "238/TALK",
            "narrator": "みやび",
            "text": "つばめちゃん、\nこっちでの生活には\n慣れたかね？",
            "zh": "燕，\n这边的生活\n习惯了喃？",
            "narrator_zh": "雅"
        },
        {
            "location": "240/TALK",
            "narrator": "つばめ",
            "text": "あの、まだ６日目\nなんですけど…。",
            "zh": "那个，才第六天\n而已……。",
            "narrator_zh": "燕"
        },
        {
            "location": "241/TALK",
            "narrator": "みやび",
            "text": "６日暮らした感想は？",
            "zh": "住了六天的感想呢？",
            "narrator_zh": "雅"
        },
        {
            "location": "242/TALK",
            "narrator": "つばめ",
            "text": "う、うーん…。\nちょっと不安が強い、\nかなぁ…？",
            "zh": "唔、唔……\n不安比较强，\n吧……？",
            "narrator_zh": "燕"
        },
        {
            "location": "243/TALK",
            "narrator": "つばめ",
            "text": "でも、新しい学校は\nちょっと楽しみです。",
            "zh": "不过，新学校\n有点期待。",
            "narrator_zh": "燕"
        },
        {
            "location": "244/TALK",
            "narrator": "みやび",
            "text": "学校が楽しみとか、\nつばめちゃんは\n真面目さんやね。",
            "zh": "还期待上学，\n燕\n真老实咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "245/TALK",
            "narrator": "つばめ",
            "text": "そ、そうですか？",
            "zh": "是、是吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "246/TALK",
            "narrator": "みやび",
            "text": "うん…これなら、\n学校でえい友達も\n沢山できそうやね。",
            "zh": "嗯……这样的话，\n学校里要得的朋友\n也能交到很多咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "247/TALK",
            "narrator": "ガブリエラ",
            "text": "どうかしらねぇ？\nどんくさそうだから\n無理なんじゃない？",
            "zh": "谁知道呢？\n看起来笨手笨脚的，\n大概不行吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "248/TALK",
            "narrator": "みやび",
            "text": "それだと、うちらも\nどんくさいゆうことに\nなるがよ？",
            "zh": "那样的话，我们\n不也成了笨手笨脚\n咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "252/TALK",
            "narrator": "ガブリエラ",
            "text": "余計なこと言わなくて\nいいから！",
            "zh": "多余的话\n不用说！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "253/TALK",
            "narrator": "みやび",
            "text": "まあ、とりあえず\nつばめちゃんの\n当面の目標は――",
            "zh": "嘛，总之\n燕\n眼下的目标是——",
            "narrator_zh": "雅"
        },
        {
            "location": "254/TALK",
            "narrator": "みやび",
            "text": "友達１００人作りで\n決まりゆうことで。",
            "zh": "交一百个朋友，\n就这么定了。",
            "narrator_zh": "雅"
        },
        {
            "location": "257/TALK",
            "narrator": "つばめ",
            "text": "ええっ！？\nさすがにそれは\nムリなんじゃ…。",
            "zh": "诶诶！？\n这个果然\n做不到吧……。",
            "narrator_zh": "燕"
        },
        {
            "location": "258/TALK",
            "narrator": "みやび",
            "text": "とりあえずＷＡＶＥの\n連絡先交換すれば、\nどうにかなるがよ。",
            "zh": "先把WAVE的\n联系方式换了，\n总能有办法咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "260/TALK",
            "narrator": "つばめ",
            "text": "１００人かぁ…。",
            "zh": "一百个人呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "261/TALK",
            "narrator": "つばめ",
            "text": "いてくれたら嬉しい\nけど、ちょっと想像\nできない数字かも。",
            "zh": "要是有的话我会高兴，\n不过这个数字有点\n想象不出来。",
            "narrator_zh": "燕"
        },
        {
            "location": "262/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "274/TALK",
            "narrator": "つばめ",
            "text": "変なこと聞くけど、答えてくれると嬉しいな",
            "zh": "问个奇怪的问题，要是能回答我会很高兴",
            "narrator_zh": "燕"
        },
        {
            "location": "275/TALK",
            "narrator": "つばめ",
            "text": "わたし、友達１００人作れると思う？",
            "zh": "你觉得我能交到一百个朋友吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "277/SEL",
            "narrator": "",
            "text": "きっとできるさ",
            "zh": "一定可以的",
            "narrator_zh": ""
        },
        {
            "location": "278/SEL",
            "narrator": "",
            "text": "どうだろう？",
            "zh": "不好说？",
            "narrator_zh": ""
        },
        {
            "location": "279/SEL",
            "narrator": "",
            "text": "１人の恋人を作ろう",
            "zh": "去找一个恋人吧",
            "narrator_zh": ""
        },
        {
            "location": "280/ACT",
            "narrator": "",
            "text": "きっとできるさ",
            "zh": "一定可以的",
            "narrator_zh": ""
        },
        {
            "location": "292/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "293/TALK",
            "narrator": "つばめ",
            "text": "…なんて返せばいいのか\nわからなくて、無言で\n切っちゃった。",
            "zh": "……不知道该怎么回，\n就沉默着\n挂断了。",
            "narrator_zh": "燕"
        },
        {
            "location": "294/TALK",
            "narrator": "つばめ",
            "text": "でも、友達１００人も\nいたら、きっと毎日\n楽しいよね。",
            "zh": "不过，要是有一百个朋友，\n每天一定\n很开心吧。",
            "narrator_zh": "燕"
        },
        {
            "location": "296/TALK",
            "narrator": "つばめ",
            "text": "よーし！",
            "zh": "好！",
            "narrator_zh": "燕"
        },
        {
            "location": "298/TALK",
            "narrator": "つばめ",
            "text": "わたし、東京にいる間に\n友達１００人作るのを\n目標に、頑張ります！",
            "zh": "我在东京的这段时间，\n把交一百个朋友\n当成目标，加油！",
            "narrator_zh": "燕"
        },
        {
            "location": "299/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "300/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "301/TALK",
            "narrator": "つばめ",
            "text": "あ、あれ？\nどうして黙っちゃうん\nですか？",
            "zh": "啊，咦？\n为什么不说话\n了？",
            "narrator_zh": "燕"
        },
        {
            "location": "302/TALK",
            "narrator": "みやび",
            "text": "いや…つばめちゃんは\nまっことえい子やと\n思うただけちや。",
            "zh": "不……只是觉得\n燕的确是个\n好孩子咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "304/TALK",
            "narrator": "ガブリエラ",
            "text": "いい子っていうか、\n冗談の通じない\nド天然なだけじゃ…。",
            "zh": "与其说好孩子，\n只是听不懂玩笑的\n天然呆吧……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "306/TALK",
            "narrator": "みやび",
            "text": "うちらにはない\n純真さやぞね。",
            "zh": "我们没有的\n那份纯真啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "307/ACT",
            "narrator": "",
            "text": "どうだろう？",
            "zh": "不好说？",
            "narrator_zh": ""
        },
        {
            "location": "308/TALK",
            "narrator": "つばめ",
            "text": "やっぱり、現実味ないよね？",
            "zh": "果然，不太现实吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "320/TALK",
            "narrator": "つばめ",
            "text": "さすがに１００人は\nハードルが高いから――",
            "zh": "一百个人\n门槛太高了——",
            "narrator_zh": "燕"
        },
        {
            "location": "321/TALK",
            "narrator": "つばめ",
            "text": "２０人くらいを目標に\n頑張ってみます！",
            "zh": "就把二十个人当目标，\n加油试试！",
            "narrator_zh": "燕"
        },
        {
            "location": "323/TALK",
            "narrator": "みやび",
            "text": "２０人っちゅのも、\nそこそこ多い数やと\n思うんやけんど…。",
            "zh": "二十个人，\n我也觉得数量\n不算少，不过……。",
            "narrator_zh": "雅"
        },
        {
            "location": "324/ACT",
            "narrator": "",
            "text": "一人の恋人を作ろう",
            "zh": "去找一个恋人吧",
            "narrator_zh": ""
        },
        {
            "location": "327/TALK",
            "narrator": "つばめ",
            "text": "１００人の友達より、１人の恋人がいいの？",
            "zh": "比起一百个朋友，一个恋人更好吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "328/TALK",
            "narrator": "つばめ",
            "text": "う～ん…そうなのかな？",
            "zh": "唔……是这样吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "340/TALK",
            "narrator": "つばめ",
            "text": "…あの、\n１００人の友達と\n１人の恋人なら――",
            "zh": "……那个，\n一百个朋友和\n一个恋人——",
            "narrator_zh": "燕"
        },
        {
            "location": "341/TALK",
            "narrator": "つばめ",
            "text": "どっちがいいもの\nなんですか？",
            "zh": "哪个更好\n呢？",
            "narrator_zh": "燕"
        },
        {
            "location": "344/TALK",
            "narrator": "みやび",
            "text": "…つばめちゃん、\nその質問にはうちらは\n答えられんよ。",
            "zh": "……燕，\n这个问题我们\n答不上。",
            "narrator_zh": "雅"
        },
        {
            "location": "346/TALK",
            "narrator": "みやび",
            "text": "恋人のおるメンバーは\n一人もおらんきな。",
            "zh": "有恋人的成员，\n一个都没有啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "348/TALK",
            "narrator": "つばめ",
            "text": "そうですか…。",
            "zh": "是这样啊……。",
            "narrator_zh": "燕"
        },
        {
            "location": "349/TALK",
            "narrator": "つばめ",
            "text": "みんなにも恋人って\nいないんだ…。",
            "zh": "大家也没有\n恋人啊……。",
            "narrator_zh": "燕"
        },
        {
            "location": "350/TALK",
            "narrator": "つばめ",
            "text": "恋人って、友達よりも\n作るの難しいんだなぁ。",
            "zh": "恋人，比朋友\n更难拥有呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "368/TALK",
            "narrator": "ガブリエラ",
            "text": "…あ、車来たわ。\n二人とも準備はいい？",
            "zh": "……啊，车来了。\n你们两个准备好了吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "369/TALK",
            "narrator": "つばめ",
            "text": "は、はい！",
            "zh": "是、是！",
            "narrator_zh": "燕"
        },
        {
            "location": "371/TALK",
            "narrator": "みやび",
            "text": "ふむ…１００人の\n友達を作る方が\n先か――",
            "zh": "嗯……是先去\n交一百个朋友，\n还是——",
            "narrator_zh": "雅"
        },
        {
            "location": "372/TALK",
            "narrator": "みやび",
            "text": "１００人のクランを\n退治する方が先か…。",
            "zh": "还是先去消灭\n一百个库兰……。",
            "narrator_zh": "雅"
        },
        {
            "location": "373/TALK",
            "narrator": "ガブリエラ",
            "text": "…不吉なこと\n言わないでよ。",
            "zh": "……别说\n不吉利的话。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "375/TALK",
            "narrator": "つばめ",
            "text": "うーん、できれば\nお友達の方を先に\n作りたいです…。",
            "zh": "唔，要是可以的话\n我想先交\n朋友……。",
            "narrator_zh": "燕"
        },
        {
            "location": "376/TALK",
            "narrator": "ガブリエラ",
            "text": "ああ、はいはい！\n話はここまで。",
            "zh": "啊，好好！\n话就到这里。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "377/TALK",
            "narrator": "ガブリエラ",
            "text": "仕事モードに\n切り替えなさい。\nほら、行くわよ。",
            "zh": "切换成\n工作状态。\n来，走了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "207/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>5月9日　9:32 AM</color>\n高校でのフェノメノン発生時の\n出動前。",
            "zh": "<color=green>5月9日　9:32 AM</color>\n高中发生PhenoMENON的时候，\n出发之前。",
            "narrator_zh": "Dialog_EventData"
        },
        {
            "location": "361/DIALOG",
            "narrator": "Dialog_GEThimegoto_ch01",
            "text": "【まだ恋も知らず】",
            "zh": "【尚未懂得恋爱】",
            "narrator_zh": "Dialog_GEThimegoto_ch01"
        }
    ]
}
