{
    "dir": "chap11/daydra/dd_ch04_11_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "11402",
        "cid": "miyabi",
        "title": "002 メインストーリー",
        "sub_title": "ガブちゃんの真実は＜前編＞",
        "title_zh": "002 主线剧情",
        "sub_title_zh": "加布的真相是＜前篇＞"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "ガブちゃんの真実は",
            "zh": "加布的真相是",
            "narrator_zh": ""
        },
        {
            "location": "25/TALK",
            "narrator": "みやび",
            "text": "…身体が重い。",
            "zh": "……身体好沉。",
            "narrator_zh": "雅"
        },
        {
            "location": "26/TALK",
            "narrator": "みやび",
            "text": "昨日、七夕祭りで\n遊び過ぎたか…。",
            "zh": "昨天在七夕祭\n玩过头了咩……。",
            "narrator_zh": "雅"
        },
        {
            "location": "27/TALK",
            "narrator": "みやび",
            "text": "…ちくっと座って\n身体休めるか。",
            "zh": "……等子坐下来\n歇歇身体吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "29/TALK",
            "narrator": "みやび",
            "text": "二度寝こそ\nこの世の至福。",
            "zh": "回笼觉才是\n人间至福。",
            "narrator_zh": "雅"
        },
        {
            "location": "30/TALK",
            "narrator": "みやび",
            "text": "…他人を信じさせる\nには――",
            "zh": "……要想让别人\n相信自己――",
            "narrator_zh": "雅"
        },
        {
            "location": "31/TALK",
            "narrator": "みやび",
            "text": "たまに本当のことも\n交えんとな。",
            "zh": "偶尔也得掺上几句\n真话才行。",
            "narrator_zh": "雅"
        },
        {
            "location": "32/TALK",
            "narrator": "みやび",
            "text": "さて、少しの間\nおやすみ…。",
            "zh": "那么，稍微\n睡一会儿……。",
            "narrator_zh": "雅"
        },
        {
            "location": "33/TALK",
            "narrator": "雛",
            "text": "あっ、やっぱそうだ。",
            "zh": "啊，果然在这。",
            "narrator_zh": "雏"
        },
        {
            "location": "35/TALK",
            "narrator": "雛",
            "text": "おはようございます、\nみやび先輩！",
            "zh": "早上好，\n雅前辈！",
            "narrator_zh": "雏"
        },
        {
            "location": "38/TALK",
            "narrator": "みやび",
            "text": "…ん？",
            "zh": "……嗯？",
            "narrator_zh": "雅"
        },
        {
            "location": "39/TALK",
            "narrator": "雛",
            "text": "ほら、まゆちん。\n早く早く！",
            "zh": "快看，小茧。\n快点快点！",
            "narrator_zh": "雏"
        },
        {
            "location": "42/TALK",
            "narrator": "繭",
            "text": "…みやび先輩、\nおはようございます。",
            "zh": "……雅前辈，\n早上好。",
            "narrator_zh": "茧"
        },
        {
            "location": "44/TALK",
            "narrator": "繭",
            "text": "お疲れのところ、\n朝から騒がしくして\n申し訳ありません。",
            "zh": "前辈正累着，\n一大早就这么吵闹，\n实在抱歉。",
            "narrator_zh": "茧"
        },
        {
            "location": "45/TALK",
            "narrator": "みやび",
            "text": "…あんたらは。",
            "zh": "……你们啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "47/TALK",
            "narrator": "みやび",
            "text": "…誰やったっけか？\n見覚えはあるんや\nけんど――",
            "zh": "……叫什么来着？\n眼熟是眼熟，\n但是――",
            "narrator_zh": "雅"
        },
        {
            "location": "69/TALK",
            "narrator": "みやび",
            "text": "ところで…あんたら、\nつばめちゃん達の\nお友達かの？",
            "zh": "话说……你们，\n是燕她们的\n朋友咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "70/TALK",
            "narrator": "雛",
            "text": "いえす！",
            "zh": "Yes！",
            "narrator_zh": "雏"
        },
        {
            "location": "72/TALK",
            "narrator": "繭",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "茧"
        },
        {
            "location": "73/TALK",
            "narrator": "みやび",
            "text": "そうか。",
            "zh": "这样啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "74/TALK",
            "narrator": "みやび",
            "text": "うちの新人さんの\nこと、今後とも\nよろしゅうな。",
            "zh": "我们剧场的新人，\n今后也\n拜托你们咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "75/TALK",
            "narrator": "ヒカル",
            "text": "わかりました。",
            "zh": "知道了。",
            "narrator_zh": "光"
        },
        {
            "location": "76/TALK",
            "narrator": "キリト",
            "text": "了解っす！",
            "zh": "了解！",
            "narrator_zh": "圣翔"
        },
        {
            "location": "77/TALK",
            "narrator": "みやび",
            "text": "うん…。",
            "zh": "嗯……。",
            "narrator_zh": "雅"
        },
        {
            "location": "79/TALK",
            "narrator": "みやび",
            "text": "…そっちの子も、\nよろしゅう頼むがよ。",
            "zh": "……那边那位，\n也拜托你们咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "82/TALK",
            "narrator": "繭",
            "text": "っ！？\nあ、は、はい！！\nお任せください！！",
            "zh": "——！？\n好、好、好的！！\n请交给我们！！",
            "narrator_zh": "茧"
        },
        {
            "location": "83/TALK",
            "narrator": "キリト",
            "text": "あはは、何だよ？\n何テンパッて――",
            "zh": "啊哈哈，干嘛呀？\n怎么慌成这样――",
            "narrator_zh": "圣翔"
        },
        {
            "location": "85/TALK",
            "narrator": "繭",
            "text": "ふんっ！",
            "zh": "喝！",
            "narrator_zh": "茧"
        },
        {
            "location": "89/TALK",
            "narrator": "キリト",
            "text": "ぐはっ！？",
            "zh": "呃哈！？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "106/TALK",
            "narrator": "みやび",
            "text": "…ああ、思い出した。\nつばめちゃんの\nお友達の――",
            "zh": "……啊，想起来了。\n是燕的\n朋友——",
            "narrator_zh": "雅"
        },
        {
            "location": "107/TALK",
            "narrator": "みやび",
            "text": "元気な女の子と、\nちくっと変わった\nのか…。",
            "zh": "精神满满的女孩子，\n和有点奇怪\n的那个……。",
            "narrator_zh": "雅"
        },
        {
            "location": "110/TALK",
            "narrator": "みやび",
            "text": "おはよう。\nえぇっと、確か…。",
            "zh": "早啊。\n那个，好像……。",
            "narrator_zh": "雅"
        },
        {
            "location": "112/TALK",
            "narrator": "雛",
            "text": "ひなこと\nまゆちんです！",
            "zh": "我是小雏，\n她是小茧！",
            "narrator_zh": "雏"
        },
        {
            "location": "114/TALK",
            "narrator": "繭",
            "text": "光月繭です…。\nこっちはひなこで\nいいです。",
            "zh": "我是光月茧……。\n这边叫\n小雏就行。",
            "narrator_zh": "茧"
        },
        {
            "location": "116/TALK",
            "narrator": "みやび",
            "text": "なるほど、覚えた。",
            "zh": "原来如此，记住了。",
            "narrator_zh": "雅"
        },
        {
            "location": "117/TALK",
            "narrator": "雛",
            "text": "みやび先輩、\n大丈夫ですか？",
            "zh": "雅前辈，\n你还好吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "118/TALK",
            "narrator": "雛",
            "text": "何だかいつも以上に\n元気がないですよー？",
            "zh": "总觉得比平时\n还没精神哦？",
            "narrator_zh": "雏"
        },
        {
            "location": "121/TALK",
            "narrator": "みやび",
            "text": "朝起きたらな、\n昨日の疲れがドッと\n押し寄せてきたがよ。",
            "zh": "早上一醒来，\n昨天的疲劳就\n哗地一下全涌上来了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "122/TALK",
            "narrator": "繭",
            "text": "…昨夜は、\n何かあったのですか？",
            "zh": "……昨晚，\n是发生什么事了吗？",
            "narrator_zh": "茧"
        },
        {
            "location": "123/TALK",
            "narrator": "みやび",
            "text": "七夕祭りや。\nうちらのメンバーと、\nほれ、あの子ら…。",
            "zh": "七夕祭嘛。\n和我们剧团的成员，\n喏，就是那几个……。",
            "narrator_zh": "雅"
        },
        {
            "location": "124/TALK",
            "narrator": "繭",
            "text": "…キリトとヒカル\nですか？",
            "zh": "……是圣翔和光\n吗？",
            "narrator_zh": "茧"
        },
        {
            "location": "125/TALK",
            "narrator": "みやび",
            "text": "そうそう、あの二人と\n一緒に行ったがよ。",
            "zh": "对对，就是和\n那两个人一起去的咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "126/TALK",
            "narrator": "雛",
            "text": "あー、そういえば\nキリト達がそんなこと\n言ってたっけ？",
            "zh": "啊——这么说来，\n圣翔他们是说过\n这样的话来着？",
            "narrator_zh": "雏"
        },
        {
            "location": "128/TALK",
            "narrator": "みやび",
            "text": "二人は\n行かんかったが？",
            "zh": "你们两个\n不是没去嘛？",
            "narrator_zh": "雅"
        },
        {
            "location": "129/TALK",
            "narrator": "雛",
            "text": "行こうかなぁ、とは\n思ってたんです。",
            "zh": "我是想过\n要不要去的。",
            "narrator_zh": "雏"
        },
        {
            "location": "130/TALK",
            "narrator": "雛",
            "text": "でも、テレビで\n世界の鉄道特集が\nやってて、つい…。",
            "zh": "可是电视里在放\n世界铁路特辑，\n就一不小心……。",
            "narrator_zh": "雏"
        },
        {
            "location": "131/TALK",
            "narrator": "みやび",
            "text": "祭りよりテレビを\n取ったっちゅう\nことか？",
            "zh": "就是说，比起祭典\n你选了电视\n是咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "132/TALK",
            "narrator": "雛",
            "text": "お祭りも好きだけど、\n電車はもっと好き\nなんです！",
            "zh": "祭典我也喜欢，\n但电车更喜欢\n呀！",
            "narrator_zh": "雏"
        },
        {
            "location": "134/TALK",
            "narrator": "みやび",
            "text": "…面白い子やね。",
            "zh": "……有意思的孩子咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "135/TALK",
            "narrator": "みやび",
            "text": "光月さんは？",
            "zh": "光月你呢？",
            "narrator_zh": "雅"
        },
        {
            "location": "136/TALK",
            "narrator": "繭",
            "text": "あ、は、はい…。\n昨日の夜は、\nバイトでした…。",
            "zh": "啊，是、是的……。\n昨晚我，\n在打工……。",
            "narrator_zh": "茧"
        },
        {
            "location": "137/TALK",
            "narrator": "雛",
            "text": "よく働くねぇ。\nシフト入れ過ぎて\n疲れないのー？",
            "zh": "真勤快呀。\n班排太满，\n不累吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "139/TALK",
            "narrator": "繭",
            "text": "別に…。",
            "zh": "没什么……。",
            "narrator_zh": "茧"
        },
        {
            "location": "140/TALK",
            "narrator": "みやび",
            "text": "いや、でも偉いと\n思うがよ。",
            "zh": "不，不过我觉得\n很了不起咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "141/TALK",
            "narrator": "みやび",
            "text": "うちも劇場のバイト\nしちょるけんど――",
            "zh": "我虽然也在剧场\n打工，但是――",
            "narrator_zh": "雅"
        },
        {
            "location": "142/TALK",
            "narrator": "みやび",
            "text": "正直、シフトが\n少ない方が嬉しいと\n思うちょるきね。",
            "zh": "老实说，班次\n少一点我才开心\n啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "144/TALK",
            "narrator": "みやび",
            "text": "光月さんは働き者や。\n関心関心。",
            "zh": "光月你真是勤劳。\n佩服佩服。",
            "narrator_zh": "雅"
        },
        {
            "location": "147/TALK",
            "narrator": "繭",
            "text": "っ！？　お、お褒めに\nあずかり、光栄です！",
            "zh": "——！？承、承蒙\n夸奖，不胜荣幸！",
            "narrator_zh": "茧"
        },
        {
            "location": "148/TALK",
            "narrator": "みやび",
            "text": "大袈裟やねぇ…。",
            "zh": "夸张了咯……。",
            "narrator_zh": "雅"
        },
        {
            "location": "149/TALK",
            "narrator": "みやび",
            "text": "で？　光月さんは\n何のアルバイト\nしちょるが？",
            "zh": "那么？光月你\n打的是什么工\n咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "152/TALK",
            "narrator": "繭",
            "text": "あっ…そ、それは…。",
            "zh": "啊……这、这个……。",
            "narrator_zh": "茧"
        },
        {
            "location": "153/TALK",
            "narrator": "雛",
            "text": "まゆちん、バイトの\n話はしてくれないん\nですよー。",
            "zh": "小茧不肯\n说打工的\n事情哦。",
            "narrator_zh": "雏"
        },
        {
            "location": "154/TALK",
            "narrator": "みやび",
            "text": "そうなが？",
            "zh": "是这么回事咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "155/TALK",
            "narrator": "雛",
            "text": "あたし達も、今まで\n何度も聞いてるん\nですけど――",
            "zh": "我们到现在\n问过好多遍了\n可是――",
            "narrator_zh": "雏"
        },
        {
            "location": "156/TALK",
            "narrator": "雛",
            "text": "ヒントも\nくれないんです。",
            "zh": "连个提示\n都不给。",
            "narrator_zh": "雏"
        },
        {
            "location": "157/TALK",
            "narrator": "みやび",
            "text": "そうやったか…。",
            "zh": "是这样啊……。",
            "narrator_zh": "雅"
        },
        {
            "location": "159/TALK",
            "narrator": "繭",
            "text": "いえ！　ですが\nみやび先輩が\n知りたいなら――",
            "zh": "不是！不过\n要是雅前辈\n想知道的话――",
            "narrator_zh": "茧"
        },
        {
            "location": "160/TALK",
            "narrator": "繭",
            "text": "あ…でも、やっぱり\n知られるのは…。",
            "zh": "啊……但是，果然\n被人知道的话……。",
            "narrator_zh": "茧"
        },
        {
            "location": "161/TALK",
            "narrator": "みやび",
            "text": "ああ、えいよえいよ。\n無理に聞き出す気は\nないちや。",
            "zh": "啊，得吧得吧。\n没打算硬要\n问出来滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "162/TALK",
            "narrator": "みやび",
            "text": "誰にも、一つや二つ\n秘密はあるきね。",
            "zh": "谁都会有一两个\n秘密的嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "164/TALK",
            "narrator": "繭",
            "text": "あ…、\nそ、そうですか…。",
            "zh": "啊……\n这、这样啊……。",
            "narrator_zh": "茧"
        },
        {
            "location": "166/TALK",
            "narrator": "みやび",
            "text": "…落ち込んどる？\n相変わらず、\nよくわからん子や。",
            "zh": "……这是低落了？\n还是老样子，\n让人捉摸不透的孩子咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "167/TALK",
            "narrator": "みやび",
            "text": "…しっかし、折角の\nお祭りなんちゅう\nシチュやのに――",
            "zh": "……不过，明明是\n祭典这种难得的\n场合――",
            "narrator_zh": "雅"
        },
        {
            "location": "168/TALK",
            "narrator": "みやび",
            "text": "テレビやバイトを\n優先するっちゅうんは\nどうなが？",
            "zh": "却把电视和打工\n放在前面，\n这算怎么回事咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "169/TALK",
            "narrator": "みやび",
            "text": "お年頃なんやし、\n祭りにときめかんと\nもったいないちや。",
            "zh": "正是这个年纪，\n不对祭典心动\n就太可惜了滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "170/TALK",
            "narrator": "雛",
            "text": "電車はときめきの\n塊です！",
            "zh": "电车是心动\n的结晶！",
            "narrator_zh": "雏"
        },
        {
            "location": "172/TALK",
            "narrator": "繭",
            "text": "申し訳ありません。\nときめきは現在、\n品切れ中でして…。",
            "zh": "非常抱歉。\n心动目前\n正处于缺货状态……。",
            "narrator_zh": "茧"
        },
        {
            "location": "173/TALK",
            "narrator": "みやび",
            "text": "…好きな男の子の\n一人もおらんが？",
            "zh": "……喜欢的男孩子\n一个都没有嘛？",
            "narrator_zh": "雅"
        },
        {
            "location": "174/TALK",
            "narrator": "雛",
            "text": "おらんです。",
            "zh": "就是没有。",
            "narrator_zh": "雏"
        },
        {
            "location": "176/TALK",
            "narrator": "繭",
            "text": "わ、私は…その…、\n素敵な人が、その…。",
            "zh": "我、我……那个……，\n有很出色的人，那个……。",
            "narrator_zh": "茧"
        },
        {
            "location": "177/TALK",
            "narrator": "雛",
            "text": "えっ！？\n好きな男の子\nいるの！？",
            "zh": "诶！？\n有喜欢的\n男孩子！？",
            "narrator_zh": "雏"
        },
        {
            "location": "178/TALK",
            "narrator": "繭",
            "text": "お、男じゃなくて！",
            "zh": "不、不是男孩子！",
            "narrator_zh": "茧"
        },
        {
            "location": "179/TALK",
            "narrator": "繭",
            "text": "あ、そ、尊敬という\n意味で、その…。",
            "zh": "啊，是、是敬佩\n那个意思，那个……。",
            "narrator_zh": "茧"
        },
        {
            "location": "180/TALK",
            "narrator": "みやび",
            "text": "ほぅ…気が合うなぁ。",
            "zh": "嚯……挺合得来的嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "181/TALK",
            "narrator": "みやび",
            "text": "うちも、尊敬しちょる\n女の人がおるがよ。",
            "zh": "我也有敬佩的\n女性咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "182/TALK",
            "narrator": "みやび",
            "text": "やき、光月さんの\n気持ちはわかるちや。",
            "zh": "所以嘛，光月你的\n心情我懂滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "184/TALK",
            "narrator": "繭",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "茧"
        },
        {
            "location": "187/TALK",
            "narrator": "みやび",
            "text": "…しっかし、\nうちが言えたことや\nないけんど――",
            "zh": "……不过，\n这话我自己也没资格\n说就是了――",
            "narrator_zh": "雅"
        },
        {
            "location": "188/TALK",
            "narrator": "みやび",
            "text": "思春期女子としては\nかなり問題ありや\nないか？",
            "zh": "作为青春期少女来说，\n这问题相当大\n没是嘛？",
            "narrator_zh": "雅"
        },
        {
            "location": "189/TALK",
            "narrator": "みやび",
            "text": "…多分、恋愛関係の\n話題に関しては――",
            "zh": "……大概，在恋爱\n话题方面――",
            "narrator_zh": "雅"
        },
        {
            "location": "190/TALK",
            "narrator": "みやび",
            "text": "うちらより、\nガブちゃんの方が\n遥か先におるようや。",
            "zh": "比起我们，\n加布在这上面\n遥遥领先的样子咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "191/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "192/TALK",
            "narrator": "みやび",
            "text": "そういえば、\n昨日のガブちゃん――",
            "zh": "说起来，\n昨天的加布――",
            "narrator_zh": "雅"
        },
        {
            "location": "193/TALK",
            "narrator": "みやび",
            "text": "ちくっと様子が\nおかしかったような\n気がするな。",
            "zh": "感觉样子\n有点不太对劲\n来着。",
            "narrator_zh": "雅"
        },
        {
            "location": "194/TALK",
            "narrator": "みやび",
            "text": "いつもやったら、\nもっと激おこ状態で\n否定するやろうに――",
            "zh": "换成平时，她该用\n更炸毛的状态\n否定才对――",
            "narrator_zh": "雅"
        },
        {
            "location": "195/TALK",
            "narrator": "みやび",
            "text": "何となく、元気が\nなかったような…。",
            "zh": "总感觉\n没什么精神……。",
            "narrator_zh": "雅"
        },
        {
            "location": "197/TALK",
            "narrator": "みやび",
            "text": "何か、引っかかる\nようなことでも\nあったんやろか？",
            "zh": "莫非是碰上了什么\n让她耿耿于怀的\n事咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "198/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "241/TALK",
            "narrator": "みやび",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "雅"
        },
        {
            "location": "254/TALK",
            "narrator": "みやび",
            "text": "うむ。\n今日もえい挨拶やね。",
            "zh": "唔。\n今天也是不错的问候咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "257/TALK",
            "narrator": "みやび",
            "text": "酷い挨拶をされたちや。",
            "zh": "被狠话问候了滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "260/TALK",
            "narrator": "みやび",
            "text": "マニアックな挨拶やね。",
            "zh": "这问候够冷门的咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "266/TALK",
            "narrator": "みやび",
            "text": "みやびさん\n４ポイントゲット。",
            "zh": "雅\n获得４点积分。",
            "narrator_zh": "雅"
        },
        {
            "location": "267/SEL",
            "narrator": "",
            "text": "まだやってるんだ",
            "zh": "还在玩这个啊",
            "narrator_zh": ""
        },
        {
            "location": "268/ACT",
            "narrator": "",
            "text": "まだやってるんだ",
            "zh": "还在玩这个啊",
            "narrator_zh": ""
        },
        {
            "location": "270/TALK",
            "narrator": "みやび",
            "text": "当然や。\nやめるなぞ一言も\n言っちょらんが？",
            "zh": "当然咯。\n停下来这种话，\n我一个字都没说过咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "271/TALK",
            "narrator": "みやび",
            "text": "いつか、うちがやりたい\n時にお前さんにポイント\nボーナスをねだるぞね。",
            "zh": "等哪天我想玩的时候，\n就找你讨\n积分奖励咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "272/TALK",
            "narrator": "みやび",
            "text": "それこそが\n今の生きがいやき。",
            "zh": "这才是我如今\n的生存意义嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "273/SEL",
            "narrator": "",
            "text": "それが生きがいなんて…",
            "zh": "这居然是生存意义……",
            "narrator_zh": ""
        },
        {
            "location": "274/ACT",
            "narrator": "",
            "text": "それが生きがいなんて…",
            "zh": "这居然是生存意义……",
            "narrator_zh": ""
        },
        {
            "location": "277/TALK",
            "narrator": "みやび",
            "text": "まあ、ココロの司書なんて\nそんな事くらいしか\n娯楽がないんよ。",
            "zh": "毕竟心之司书嘛，\n也就只有这点程度\n的娱乐咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "278/TALK",
            "narrator": "みやび",
            "text": "ほんだら今日も元気に\n仕事しますかー。",
            "zh": "那就今天也精神满满地\n开工吧——。",
            "narrator_zh": "雅"
        },
        {
            "location": "285/TALK",
            "narrator": "みやび",
            "text": "オープンプロセス、\n0x773番地から\n0x102番地へ。",
            "zh": "开放进程，\n从0x773号地址\n移到0x102号地址。",
            "narrator_zh": "雅"
        },
        {
            "location": "300/TALK",
            "narrator": "みやび",
            "text": "完了。",
            "zh": "完成。",
            "narrator_zh": "雅"
        },
        {
            "location": "302/TALK",
            "narrator": "みやび",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "雅"
        },
        {
            "location": "304/TALK",
            "narrator": "みやび",
            "text": "………。",
            "zh": "………。",
            "narrator_zh": "雅"
        },
        {
            "location": "306/TALK",
            "narrator": "みやび",
            "text": "なるほどなぁ。\n今回は複雑やね。",
            "zh": "原来如此。\n这次很复杂咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "307/SEL",
            "narrator": "",
            "text": "どんな内容？",
            "zh": "什么内容？",
            "narrator_zh": ""
        },
        {
            "location": "308/ACT",
            "narrator": "",
            "text": "どんな内容？",
            "zh": "什么内容？",
            "narrator_zh": ""
        },
        {
            "location": "310/TALK",
            "narrator": "みやび",
            "text": "結論から言えば、\n繭と雛に対してどこまで\n心を開くか悩んじゅう。",
            "zh": "先说结论，\n就是烦恼该对茧和雏\n把心打开到什么程度咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "311/SEL",
            "narrator": "",
            "text": "あれ？ガブリエラの事じゃないんだ",
            "zh": "咦？不是加布里埃拉的事吗",
            "narrator_zh": ""
        },
        {
            "location": "312/ACT",
            "narrator": "",
            "text": "あれ？ガブリエラの事じゃないんだ",
            "zh": "咦？不是加布里埃拉的事吗",
            "narrator_zh": ""
        },
        {
            "location": "314/TALK",
            "narrator": "みやび",
            "text": "まあ、そこが今回の\n引っ掛け問題よ。",
            "zh": "嘛，这正是这次\n的陷阱题哦。",
            "narrator_zh": "雅"
        },
        {
            "location": "315/TALK",
            "narrator": "みやび",
            "text": "どれくらいの難易度かと\nゆうと、現実のうちも多分\n最後まで気づかんくらい。",
            "zh": "要说难度有多高，\n大概就是现实的我到最后\n都察觉不到的程度。",
            "narrator_zh": "雅"
        },
        {
            "location": "316/SEL",
            "narrator": "",
            "text": "そこまで！",
            "zh": "都到这个地步了！",
            "narrator_zh": ""
        },
        {
            "location": "317/ACT",
            "narrator": "",
            "text": "そこまで！",
            "zh": "都到这个地步了！",
            "narrator_zh": ""
        },
        {
            "location": "319/TALK",
            "narrator": "みやび",
            "text": "今から順を追って\n説明しちゃろう。",
            "zh": "现在就按顺序\n讲解给你听。",
            "narrator_zh": "雅"
        },
        {
            "location": "320/TALK",
            "narrator": "みやび",
            "text": "１．ガブちゃんに違和感を\n感じているが、その理由が\nわからない。",
            "zh": "１．对加布感到\n违和，但说不出\n理由是什么。",
            "narrator_zh": "雅"
        },
        {
            "location": "321/TALK",
            "narrator": "みやび",
            "text": "２．そもそも自分が人に\n壁を作ってるから解らない\nと一人反省する。",
            "zh": "２．然后一个人反省，\n觉得说到底是自己\n对人筑了墙才看不懂。",
            "narrator_zh": "雅"
        },
        {
            "location": "322/TALK",
            "narrator": "みやび",
            "text": "３．なら他人なら解るかも\nと思うが、目の前にいる\n二人じゃな、と諦める。",
            "zh": "３．虽然觉得换作别人\n说不定就能看懂，\n可眼前偏偏是这两个，只好放弃。",
            "narrator_zh": "雅"
        },
        {
            "location": "323/TALK",
            "narrator": "みやび",
            "text": "４．だがその諦めこそが\n自身の奢りと観念の賜物\nだと思わなくもない。",
            "zh": "４．但不能否认，这份放弃\n正是自己傲慢与成见\n的产物。",
            "narrator_zh": "雅"
        },
        {
            "location": "324/TALK",
            "narrator": "みやび",
            "text": "５．とはいえ今回の件は\nコイバナとも取れる故に\nキャラに反する。",
            "zh": "５．话虽如此，这次的事\n也可以看作恋爱话题，\n与人设相悖。",
            "narrator_zh": "雅"
        },
        {
            "location": "325/TALK",
            "narrator": "みやび",
            "text": "６．だが有機物の思考回路\nにおける例外を突き止める\nのは、うちは苦手である。",
            "zh": "６．但查明有机物思考回路\n中的例外，\n并非我所长。",
            "narrator_zh": "雅"
        },
        {
            "location": "326/TALK",
            "narrator": "みやび",
            "text": "７．そもそも苦手やから\n他人のCPUを使わせて\nもらうわけやけんど……",
            "zh": "７．正因为不擅长，才想\n借用别人的CPU\n来用……",
            "narrator_zh": "雅"
        },
        {
            "location": "327/TALK",
            "narrator": "みやび",
            "text": "８．それは自身のファイア\nウォールに穴を開ける\nことになるわけやき……",
            "zh": "８．但这等于在自己的\n防火墙上开洞\n……",
            "narrator_zh": "雅"
        },
        {
            "location": "328/TALK",
            "narrator": "みやび",
            "text": "９．そこまで信用して\nいいものなのか、及び\nそれに値する問題なのか。",
            "zh": "９．能否信任到这个地步，\n以及问题本身是否\n值得如此。",
            "narrator_zh": "雅"
        },
        {
            "location": "329/TALK",
            "narrator": "みやび",
            "text": "１０．いや、それこそが\nうちのブレイクスルーを\n妨げる要因である。",
            "zh": "１０．不，这恰恰是\n妨碍我突破\n的要素。",
            "narrator_zh": "雅"
        },
        {
            "location": "330/TALK",
            "narrator": "みやび",
            "text": "１１．分散コンピュー\nティングの時代に逆行する\n自分らしくない発想。",
            "zh": "１１．与分布式计算时代\n背道而驰、不像我\n会有的想法。",
            "narrator_zh": "雅"
        },
        {
            "location": "331/TALK",
            "narrator": "みやび",
            "text": "１２．しかし目の前の\n２つのCPUは本当に信頼に\n値する――（永久ループ）",
            "zh": "１２．但眼前的两个CPU\n真的值得信任吗\n――（永久循环）",
            "narrator_zh": "雅"
        },
        {
            "location": "332/TALK",
            "narrator": "みやび",
            "text": "１３．うちのココロに\n例外が発生し、お前さんが\nここに飛ばされる。",
            "zh": "１３．我的心中发生异常，\n于是你被\n传送到了这里。",
            "narrator_zh": "雅"
        },
        {
            "location": "334/TALK",
            "narrator": "みやび",
            "text": "――ちゅうことを、\n最後の「…………。」の\n間に思うちょったわけや。",
            "zh": "――以上这些，就是我\n在最后那句「…………。」\n之间想完的事咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "335/SEL",
            "narrator": "",
            "text": "あの「…………。」がそこまで深いものだったなんて！",
            "zh": "那句「…………。」居然有这么深的内涵！",
            "narrator_zh": ""
        },
        {
            "location": "336/SEL",
            "narrator": "",
            "text": "天才脳故の複雑な思考回路だね",
            "zh": "不愧是天才脑，思考回路真复杂",
            "narrator_zh": ""
        },
        {
            "location": "337/ACT",
            "narrator": "",
            "text": "あの「…………。」がそこまで深いものだったなんて！",
            "zh": "那句「…………。」居然有这么深的内涵！",
            "narrator_zh": ""
        },
        {
            "location": "338/TALK",
            "narrator": "みやび",
            "text": "まあ、特別なことやない。",
            "zh": "嘛，这不是什么特别的事。",
            "narrator_zh": "雅"
        },
        {
            "location": "339/TALK",
            "narrator": "みやび",
            "text": "だれやって、\n考えるときは一瞬やき。",
            "zh": "谁都一样，\n思考就在一瞬间嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "340/TALK",
            "narrator": "みやび",
            "text": "それを言葉にしたり\nする事が、面倒かつ\n時間がかかるだけぞね。",
            "zh": "把它转换成语言\n又麻烦又费时间，\n仅此而已咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "341/TALK",
            "narrator": "みやび",
            "text": "脳信号を言語として\nまとめる自己翻訳こそが、\n脳で最も高負荷の処理や。",
            "zh": "把脑信号整理成语言的\n自我翻译，才是脑内\n负荷最高的处理。",
            "narrator_zh": "雅"
        },
        {
            "location": "342/ACT",
            "narrator": "",
            "text": "天才脳故の複雑な思考回路だね",
            "zh": "不愧是天才脑，思考回路真复杂",
            "narrator_zh": ""
        },
        {
            "location": "343/TALK",
            "narrator": "みやび",
            "text": "うちをおちょくるのも\n大概にしいや。",
            "zh": "戏弄我也\n该有个限度啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "344/SEL",
            "narrator": "",
            "text": "本当に天才だと思う",
            "zh": "我是真心觉得你是天才",
            "narrator_zh": ""
        },
        {
            "location": "345/ACT",
            "narrator": "",
            "text": "本当に天才だと思う",
            "zh": "我是真心觉得你是天才",
            "narrator_zh": ""
        },
        {
            "location": "348/TALK",
            "narrator": "みやび",
            "text": "単に偏屈なだけやよ。",
            "zh": "我只是单纯地别扭咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "349/TALK",
            "narrator": "みやび",
            "text": "まあでも、他人にそう\n言われて嬉しくないか、\nちゅうたら――",
            "zh": "嘛不过，被人这么\n说，要说高不高兴\n的话――",
            "narrator_zh": "雅"
        },
        {
            "location": "351/TALK",
            "narrator": "みやび",
            "text": "ちくっとは、\n嬉しいけんどな。",
            "zh": "不过多少\n还是有点高兴的啦。",
            "narrator_zh": "雅"
        },
        {
            "location": "352/TALK",
            "narrator": "みやび",
            "text": "やき、ダメなんよ！",
            "zh": "所以不行哦！",
            "narrator_zh": "雅"
        },
        {
            "location": "354/TALK",
            "narrator": "みやび",
            "text": "以後それ禁止な。",
            "zh": "以后禁止这样。",
            "narrator_zh": "雅"
        },
        {
            "location": "356/TALK",
            "narrator": "みやび",
            "text": "ちなみに、顕在意識たる\n現実のうちは、２までしか\nわかっちょらん。",
            "zh": "顺便一提，作为显意识的\n现实里的我，只想到\n第２条为止。",
            "narrator_zh": "雅"
        },
        {
            "location": "357/TALK",
            "narrator": "みやび",
            "text": "けんど、クランが湧いてる\nちゅうことは、相談するか\n否かで悩んでるのは事実。",
            "zh": "但是，库兰会冒出来，\n就说明我确实在烦恼\n要不要找人商量。",
            "narrator_zh": "雅"
        },
        {
            "location": "359/TALK",
            "narrator": "みやび",
            "text": "「他人に相談する」ちゅう\n一般人には簡単なことが、\nうちには世紀の大問題や。",
            "zh": "「找人商量」这种\n对普通人再简单不过的事，\n对我却是世纪大难题。",
            "narrator_zh": "雅"
        },
        {
            "location": "360/TALK",
            "narrator": "みやび",
            "text": "やき、このクランを撃退\nすると、現実のうちも\nビックリするやもしれん。",
            "zh": "所以嘛，击退这个库兰，\n现实的我\n说不定会吓一跳。",
            "narrator_zh": "雅"
        },
        {
            "location": "361/TALK",
            "narrator": "みやび",
            "text": "自分の行動にな。",
            "zh": "也就是为自己的行动吃一惊。",
            "narrator_zh": "雅"
        },
        {
            "location": "362/TALK",
            "narrator": "みやび",
            "text": "けんど、うちはそろそろ\n変わらんといかんちや。",
            "zh": "但是，我也差不多\n该变一变了滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "363/TALK",
            "narrator": "みやび",
            "text": "そうせんと、\n全てが膠着状態に\nなり始めちゅう。",
            "zh": "再不变，\n一切都要开始\n僵住不动咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "364/TALK",
            "narrator": "みやび",
            "text": "これは、うちの今後に\nとって、重要なことや。\n協力せい。",
            "zh": "这件事，对我今后\n很重要。\n给我出力。",
            "narrator_zh": "雅"
        },
        {
            "location": "365/SEL",
            "narrator": "",
            "text": "本当に？\n精神操作じゃなくて？",
            "zh": "真的？\n不是精神操控吗？",
            "narrator_zh": ""
        },
        {
            "location": "366/ACT",
            "narrator": "",
            "text": "本当に？\n精神操作じゃなくて？",
            "zh": "真的？\n不是精神操控吗？",
            "narrator_zh": ""
        },
        {
            "location": "367/TALK",
            "narrator": "みやび",
            "text": "まあ、そう思うのも\n無理はないか。",
            "zh": "嘛，你会这么想\n也难怪。",
            "narrator_zh": "雅"
        },
        {
            "location": "368/TALK",
            "narrator": "みやび",
            "text": "お前さんも今はココロの\n中にいるけんど、現実を\n生きる存在やきね。",
            "zh": "你虽然现在身处\n心中，却是活在\n现实的存在嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "369/TALK",
            "narrator": "みやび",
            "text": "目に見えているものだけが\n本当のことだとゆう観念が\nどうしてもこびりつく。",
            "zh": "眼见为实的观念\n总会不知不觉\n粘在身上。",
            "narrator_zh": "雅"
        },
        {
            "location": "370/TALK",
            "narrator": "みやび",
            "text": "うちがお前さんに頼んでる\nのは、背中を一押しして\nもらうことだけや。",
            "zh": "我拜托你的，\n只是从背后\n推我一把而已。",
            "narrator_zh": "雅"
        },
        {
            "location": "371/TALK",
            "narrator": "みやび",
            "text": "別に、精神操作をして、\nココロにも無いことを\nさせようってわけやない。",
            "zh": "又不是搞精神操控，\n要你做心里\n没有的事。",
            "narrator_zh": "雅"
        },
        {
            "location": "372/TALK",
            "narrator": "みやび",
            "text": "あくまで、\n源はうちの想いや。",
            "zh": "说到底，\n源头还是我自己的心意。",
            "narrator_zh": "雅"
        },
        {
            "location": "373/TALK",
            "narrator": "みやび",
            "text": "そこに一言支えるのが\nお前さんの役割。",
            "zh": "你只需要在旁边\n附和一句。",
            "narrator_zh": "雅"
        },
        {
            "location": "374/TALK",
            "narrator": "みやび",
            "text": "現実でも普通にやっちょる\nと思うけんど、ココロの中\nやと警戒するんやろな。",
            "zh": "现实中你应该也在\n照常这么做，\n可一进心里就会戒备吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "375/TALK",
            "narrator": "みやび",
            "text": "もしどうしても\n気が進まんゆうなら、\n無理にやらんでもえいよ？",
            "zh": "要是实在\n不情愿的话，\n不勉强做也没关系，好咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "376/TALK",
            "narrator": "みやび",
            "text": "うちから言えることは\nこれだけやね。",
            "zh": "我能说的\n就这些咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "379/TALK",
            "narrator": "みやび",
            "text": "ほんだら早速行くぞね。",
            "zh": "那就马上出发咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "380/TALK",
            "narrator": "みやび",
            "text": "うちと$handle$に\nえいココロの旅を。",
            "zh": "为我和$handle$\n献上美妙的心灵之旅。",
            "narrator_zh": "雅"
        },
        {
            "location": "23/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>6月6日　7:11 AM</color>\n平日の朝、通学中の有楽町線車内にて。",
            "zh": "<color=green>6月6日　7:11 AM</color>\n工作日清晨，通学途中的有乐町线车厢内。",
            "narrator_zh": "Dialog_EventData"
        },
        {
            "location": "210/DIALOG",
            "narrator": "BattleInit/Dialog_BATTLE_ch04",
            "text": "<color=black><size=50><b>恋ヶ崎みやびのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n恋ヶ崎みやびの心の葛藤を解消してください。\n\n\n\n",
            "zh": "<color=black><size=50><b>在恋之崎雅的心中\n战斗开始了。</b></size></color>\n\n\n\n\n\n她的心中，\n生出了巨大的纠葛。\n\n请潜入心灵领域，\n化解恋之崎雅的心之纠葛。\n\n\n\n",
            "narrator_zh": "BattleInit/Dialog_BATTLE_ch04"
