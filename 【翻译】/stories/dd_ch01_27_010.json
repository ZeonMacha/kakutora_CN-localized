{
    "dir": "chap27/daydra/dd_ch01_27_010.js",
    "type": "",
    "info": {
        "story_id": "50002",
        "cid": "",
        "title": "SideStory002 ストーリー",
        "sub_title": "FILE01.閃光",
        "title_zh": "SideStory002 剧情",
        "sub_title_zh": "FILE01.闪光"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "東京編１話",
            "zh": "东京篇 第1话",
            "narrator_zh": ""
        },
        {
            "location": "16/DIALOG",
            "narrator": "",
            "text": "<color=green>9月4日　 9:32 AM</color>\nとある日曜、附属学園校門前にて。",
            "zh": "<color=green>9月4日　 9:32 AM</color>\n某个周日，于附属学园校门前。",
            "narrator_zh": ""
        },
        {
            "location": "25/TALK",
            "narrator": "雛",
            "text": "はぁ…。",
            "zh": "唉……。",
            "narrator_zh": "雏"
        },
        {
            "location": "27/TALK",
            "narrator": "繭",
            "text": "…十回目。\nいい加減ウザいんだけど？",
            "zh": "……第十次了。\n你也差不多够烦了吧？",
            "narrator_zh": "茧"
        },
        {
            "location": "29/TALK",
            "narrator": "雛",
            "text": "だって、心配なんだよー。\nつばめちゃんからの連絡、\nまだ来ないし…。",
            "zh": "因为我担心嘛——。\n燕那边的消息，\n到现在还没来……。",
            "narrator_zh": "雏"
        },
        {
            "location": "30/TALK",
            "narrator": "雛",
            "text": "いつもだったら連絡も\nナシに、こんなに遅れる\nことないもん。",
            "zh": "平时的话，根本不会\n连个招呼都不打\n就迟到这么久嘛。",
            "narrator_zh": "雏"
        },
        {
            "location": "31/TALK",
            "narrator": "雛",
            "text": "ましてや今日は、\n遊びに行く約束だよ！？",
            "zh": "更何况今天，\n我们可是约好了要出去玩的呀！？",
            "narrator_zh": "雏"
        },
        {
            "location": "32/TALK",
            "narrator": "繭",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "茧"
        },
        {
            "location": "33/TALK",
            "narrator": "雛",
            "text": "そうだ。\nまゆちん、みやび先輩に\n聞いてみてよ。",
            "zh": "对了。\n小茧，你去问问\n雅前辈嘛。",
            "narrator_zh": "雏"
        },
        {
            "location": "34/TALK",
            "narrator": "キリト",
            "text": "聞くだけ無駄だぞ。",
            "zh": "问了也白搭哦。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "36/TALK",
            "narrator": "繭",
            "text": "えっ！？",
            "zh": "哎！？",
            "narrator_zh": "茧"
        },
        {
            "location": "40/TALK",
            "narrator": "キリト",
            "text": "多分、送っても返事は\n戻ってこないだろうし…。",
            "zh": "大概发了消息\n也不会有回复的……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "43/TALK",
            "narrator": "雛",
            "text": "キリト！",
            "zh": "圣翔！",
            "narrator_zh": "雏"
        },
        {
            "location": "46/TALK",
            "narrator": "キリト",
            "text": "おっす、数日振りだな。",
            "zh": "哟，好几天没见了啊。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "47/TALK",
            "narrator": "雛",
            "text": "おっすじゃないよ！\nずっと連絡してたのに！？",
            "zh": "什么“哟”呀！\n我一直在联系你耶！？",
            "narrator_zh": "雏"
        },
        {
            "location": "48/TALK",
            "narrator": "キリト",
            "text": "わりぃ…。\n外部との連絡、\n禁止されててさ…。",
            "zh": "抱歉……。\n我们被禁止\n跟外界联络了啊……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "49/TALK",
            "narrator": "繭",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "茧"
        },
        {
            "location": "52/TALK",
            "narrator": "キリト",
            "text": "いや、俺を睨まれても\n困るんだけど…。",
            "zh": "不是，你这么瞪着我\n我也挺困扰的……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "53/TALK",
            "narrator": "繭",
            "text": "なにを知ってる？",
            "zh": "你知道些什么？",
            "narrator_zh": "茧"
        },
        {
            "location": "54/TALK",
            "narrator": "雛",
            "text": "え？",
            "zh": "哎？",
            "narrator_zh": "雏"
        },
        {
            "location": "55/TALK",
            "narrator": "繭",
            "text": "返事が戻ってこないって、\nどういうこと？",
            "zh": "不会有回复，\n是什么意思？",
            "narrator_zh": "茧"
        },
        {
            "location": "56/TALK",
            "narrator": "キリト",
            "text": "…ここじゃ話せない。",
            "zh": "……这里没法说。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "57/TALK",
            "narrator": "キリト",
            "text": "ヒカルが屋上にいるから、\n付いてきてくれ。",
            "zh": "光在屋顶上，\n跟我过来吧。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "73/TALK",
            "narrator": "雛",
            "text": "そんな…。\nつばめちゃんが、管理庁に\n捕まったなんて…。",
            "zh": "怎么会……。\n燕竟然被管理厅\n抓走了什么的……。",
            "narrator_zh": "雏"
        },
        {
            "location": "74/TALK",
            "narrator": "キリト",
            "text": "俺が甘かったんだよ。",
            "zh": "是我太天真了啊。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "75/TALK",
            "narrator": "キリト",
            "text": "逢瀬が隠れてるの、\n黙ってりゃバレないと\n思ったから…。",
            "zh": "我还以为关于逢濑藏着的事，\n只要闭口不提\n就不会暴露呢……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "77/TALK",
            "narrator": "ヒカル",
            "text": "キリトのせいじゃないよ。",
            "zh": "不是圣翔的错哦。",
            "narrator_zh": "光"
        },
        {
            "location": "78/TALK",
            "narrator": "ヒカル",
            "text": "あの場では、あれ以上の\nことはできなかったし…。",
            "zh": "在当时的情况下，\n已经做不到更多了……。",
            "narrator_zh": "光"
        },
        {
            "location": "80/TALK",
            "narrator": "繭",
            "text": "…他のみんなは？",
            "zh": "……其他大家呢？",
            "narrator_zh": "茧"
        },
        {
            "location": "82/TALK",
            "narrator": "ヒカル",
            "text": "無事に脱出したのは\n確かだけど、\nどこに行ったかまでは…。",
            "zh": "确定是安全\n逃脱了，\n但去了哪里就……。",
            "narrator_zh": "光"
        },
        {
            "location": "86/TALK",
            "narrator": "繭",
            "text": "…確かめる。",
            "zh": "……我确认一下。",
            "narrator_zh": "茧"
        },
        {
            "location": "87/TALK",
            "narrator": "雛",
            "text": "…つばめちゃんが\n管理庁に捕まっちゃって、\nみんなは行方不明…。",
            "zh": "……燕被\n管理厅抓走了，\n大家又下落不明……。",
            "narrator_zh": "雏"
        },
        {
            "location": "88/TALK",
            "narrator": "雛",
            "text": "それに、キリト達は\n謹慎処分なんて…。",
            "zh": "而且，圣翔你们还\n受了禁足处分……。",
            "narrator_zh": "雏"
        },
        {
            "location": "89/TALK",
            "narrator": "雛",
            "text": "こんなの、酷過ぎるよ…。",
            "zh": "这也太过分了啊……。",
            "narrator_zh": "雏"
        },
        {
            "location": "91/TALK",
            "narrator": "キリト",
            "text": "…いや、別に俺たちの\n謹慎はいいんだよ。",
            "zh": "……不是，我们受禁足\n倒是无所谓啦。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "92/TALK",
            "narrator": "キリト",
            "text": "むしろ、そうなってくれて\nありがたいくらいだしな。",
            "zh": "倒不如说，变成这样\n我还求之不得呢。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "93/TALK",
            "narrator": "ヒカル",
            "text": "うん…今の管理庁の\nやり方には、\n賛同できないしね。",
            "zh": "嗯……如今管理厅的\n做法，\n我也实在无法认同啊。",
            "narrator_zh": "光"
        },
        {
            "location": "95/TALK",
            "narrator": "キリト",
            "text": "襲撃の前に警告できれば\nよかったんだが…、\nそれも無理でさ…。",
            "zh": "要是能在袭击前提醒一下\n就好了……\n可那也做不到啊……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "96/TALK",
            "narrator": "雛",
            "text": "…そっか。",
            "zh": "……这样啊。",
            "narrator_zh": "雏"
        },
        {
            "location": "98/TALK",
            "narrator": "雛",
            "text": "ずっと連絡が取れなく\n心配してたけど…。",
            "zh": "一直联系不上你们，\n我还担心着呢……。",
            "narrator_zh": "雏"
        },
        {
            "location": "100/TALK",
            "narrator": "雛",
            "text": "二人も、大変な想い\nしてたんだね…。",
            "zh": "你们俩，也经历了\n这么难受的事呀……。",
            "narrator_zh": "雏"
        },
        {
            "location": "102/TALK",
            "narrator": "ヒカル",
            "text": "心配かけたみたいで、\nすみません…。",
            "zh": "好像让你们担心了，\n真不好意思……。",
            "narrator_zh": "光"
        },
        {
            "location": "103/TALK",
            "narrator": "ヒカル",
            "text": "でも、ちょっと嬉しいな。\n気にされてないと\n思ってたから…。",
            "zh": "不过，还有点开心呢。\n我还以为根本没人在意\n我们呢……。",
            "narrator_zh": "光"
        },
        {
            "location": "105/TALK",
            "narrator": "雛",
            "text": "もぉ、友達と何日も\n連絡取れなかったら、\n普通心配するって！",
            "zh": "真是的，好几天都联系不上\n朋友的话，\n任谁都会担心的好吧！",
            "narrator_zh": "雏"
        },
        {
            "location": "108/TALK",
            "narrator": "ヒカル",
            "text": "あ、あはは…、\nそうだよね…。",
            "zh": "啊、啊哈哈……\n说得也是啊……。",
            "narrator_zh": "光"
        },
        {
            "location": "109/TALK",
            "narrator": "ヒカル",
            "text": "友達かぁ…。\nまあ、そうだよね…。",
            "zh": "朋友啊……。\n嘛，也是呢……。",
            "narrator_zh": "光"
        },
        {
            "location": "110/TALK",
            "narrator": "繭",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "茧"
        },
        {
            "location": "112/TALK",
            "narrator": "キリト",
            "text": "繭、さっきから\nなにやってんだ？",
            "zh": "茧，你从刚才起\n在干嘛呢？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "113/TALK",
            "narrator": "繭",
            "text": "みやび先輩に\nＷＡＶＥを送ってる…。",
            "zh": "在给雅前辈\n发WAVE……。",
            "narrator_zh": "茧"
        },
        {
            "location": "114/TALK",
            "narrator": "キリト",
            "text": "なにか来たのか？",
            "zh": "有回信了吗？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "115/TALK",
            "narrator": "繭",
            "text": "…既読もつかない。",
            "zh": "……连已读都没有。",
            "narrator_zh": "茧"
        },
        {
            "location": "117/TALK",
            "narrator": "ヒカル",
            "text": "多分、居場所がバレるのを\n恐れてるんじゃないかな？",
            "zh": "大概是担心行踪暴露\n才不敢看吧？",
            "narrator_zh": "光"
        },
        {
            "location": "119/TALK",
            "narrator": "雛",
            "text": "そっか…。",
            "zh": "这样啊……。",
            "narrator_zh": "雏"
        },
        {
            "location": "120/TALK",
            "narrator": "雛",
            "text": "じゃあ、あたし達だけで\nやるしかない、って\nことだね。",
            "zh": "那也就是说，\n只能靠我们自己\n去干了呀。",
            "narrator_zh": "雏"
        },
        {
            "location": "121/TALK",
            "narrator": "キリト",
            "text": "やるって、何をだ？",
            "zh": "去干，干什么？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "123/TALK",
            "narrator": "雛",
            "text": "つばめちゃん救出作戦に\n決まってるでしょー？",
            "zh": "那还用说，当然是\n救燕大作战啦——？",
            "narrator_zh": "雏"
        },
        {
            "location": "124/TALK",
            "narrator": "雛",
            "text": "綾水様達だって、\n今は管理庁に追われてる\n身なんだし…。",
            "zh": "绫水大人她们现在\n自己也被管理厅\n追捕着嘛……。",
            "narrator_zh": "雏"
        },
        {
            "location": "125/TALK",
            "narrator": "雛",
            "text": "その点、あたし達なら\n管理庁に目を付けられても\nいないから――",
            "zh": "相比之下，我们几个\n还没被管理厅盯上，\n所以——",
            "narrator_zh": "雏"
        },
        {
            "location": "129/TALK",
            "narrator": "繭",
            "text": "無謀すぎる。",
            "zh": "太鲁莽了。",
            "narrator_zh": "茧"
        },
        {
            "location": "130/TALK",
            "narrator": "キリト",
            "text": "繭の言う通りだ。\nさすがにそれは\n無茶過ぎるだろ？",
            "zh": "茧说得对。\n那未免也\n太乱来了吧？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "131/TALK",
            "narrator": "キリト",
            "text": "第一、逢瀬がどこに\n捕まってるのかも\nわからないんだぞ？",
            "zh": "首先，逢濑被关在\n什么地方，\n我们连这都不知道哦？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "132/TALK",
            "narrator": "雛",
            "text": "キリト達なら\n知ることができるんじゃ\nないの？",
            "zh": "如果是圣翔你们的话，\n难道打听不到\n消息吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "134/TALK",
            "narrator": "ヒカル",
            "text": "あの、ひなこさん。\n僕達謹慎中なんだけど…。",
            "zh": "那个，雏子。\n我们现在还在禁足中呢……。",
            "narrator_zh": "光"
        },
        {
            "location": "135/TALK",
            "narrator": "ヒカル",
            "text": "まあ、仮に謹慎中じゃ\nなかったとしても\n無理だと思うよ？",
            "zh": "嘛，就算没有在禁足，\n我想也是\n不可能的吧？",
            "narrator_zh": "光"
        },
        {
            "location": "136/TALK",
            "narrator": "ヒカル",
            "text": "僕達は通常攻撃隊の、\n一番下っ端だし…。",
            "zh": "我们只是普通攻击队里\n最底层的成员嘛……。",
            "narrator_zh": "光"
        },
        {
            "location": "137/TALK",
            "narrator": "キリト",
            "text": "色々質問しても、\n答えてもらえないことが\nほとんどだったもんな。",
            "zh": "平时就算问东问西，\n十有八九也都是\n得不到回答的啊。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "138/TALK",
            "narrator": "繭",
            "text": "…そんな扱いだったの？",
            "zh": "……你们在队里就这待遇？",
            "narrator_zh": "茧"
        },
        {
            "location": "139/TALK",
            "narrator": "キリト",
            "text": "まあ、まだ学生だしな。\n正式な隊員になるまでは\n仕方ねぇんだよ…。",
            "zh": "嘛，毕竟还是学生嘛。\n在成为正式队员之前\n这也是没办法的事……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "141/TALK",
            "narrator": "雛",
            "text": "そっか…。\nうーん、どうしたら\nいいのかなぁ？",
            "zh": "这样啊……。\n唔——，那到底\n该怎么办才好呀？",
            "narrator_zh": "雏"
        },
        {
            "location": "142/TALK",
            "narrator": "ヒカル",
            "text": "…ひなこさん。\n本気で逢瀬さんのことを\n助けるつもりですか？",
            "zh": "……雏子。\n你是认真的，\n打算去救逢濑吗？",
            "narrator_zh": "光"
        },
        {
            "location": "144/TALK",
            "narrator": "雛",
            "text": "当然だよ！",
            "zh": "当然了！",
            "narrator_zh": "雏"
        },
        {
            "location": "145/TALK",
            "narrator": "雛",
            "text": "ヒカルくんは、\nつばめちゃんのこと\n助けたくないの？",
            "zh": "光难道\n不想救\n燕吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "146/TALK",
            "narrator": "ヒカル",
            "text": "まさか！\n本音を言えば僕だって…。",
            "zh": "怎么可能！\n说实话我也……。",
            "narrator_zh": "光"
        },
        {
            "location": "147/TALK",
            "narrator": "キリト",
            "text": "ひなこ…俺達だって、\n逢瀬を見捨てたいわけじゃ\nないんだ。",
            "zh": "雏子……我们几个，\n也并不是想对逢濑\n见死不救啊。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "148/TALK",
            "narrator": "キリト",
            "text": "けど…わかんだろ？\n相手は管理庁なんだぜ？",
            "zh": "可是……你懂的吧？\n对手可是管理厅啊？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "149/TALK",
            "narrator": "繭",
            "text": "素人が束になって、\nどうにかなるような\n相手じゃない。",
            "zh": "不是几个外行凑一块，\n就能应付得了的\n对手。",
            "narrator_zh": "茧"
        },
        {
            "location": "151/TALK",
            "narrator": "雛",
            "text": "そんなのわかってるよ。",
            "zh": "那种事我也知道啊。",
            "narrator_zh": "雏"
        },
        {
            "location": "152/TALK",
            "narrator": "雛",
            "text": "でも、もしつばめちゃんが\n今のあたし達の\n立場だったら…。",
            "zh": "可是，如果换成燕\n处在现在我们\n这个立场上……。",
            "narrator_zh": "雏"
        },
        {
            "location": "153/TALK",
            "narrator": "雛",
            "text": "絶対、助けるために\n動くと思うの。",
            "zh": "我觉得她绝对会\n为了救人而行动的。",
            "narrator_zh": "雏"
        },
        {
            "location": "154/TALK",
            "narrator": "雛",
            "text": "覚えてるかな？\n夏休み前にあったこと…。",
            "zh": "你们还记得吗？\n暑假前发生过的事……。",
            "narrator_zh": "雏"
        },
        {
            "location": "171/TALK",
            "narrator": "雛",
            "text": "どうしよう…。\nマジで見つからないよー。",
            "zh": "怎么办……。\n真的找不到了呀——。",
            "narrator_zh": "雏"
        },
        {
            "location": "173/TALK",
            "narrator": "キリト",
            "text": "小さいもんだからな。\nさすがに、もう諦めたら\nどうなんだ？",
            "zh": "那么小一张东西嘛。\n我看，要不干脆放弃\n算了？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "175/TALK",
            "narrator": "雛",
            "text": "だ、ダメだよー！\nあたしの宝物の\n一つなんだから…。",
            "zh": "不、不行呀——！\n那可是我的\n宝贝之一嘛……。",
            "narrator_zh": "雏"
        },
        {
            "location": "178/TALK",
            "narrator": "つばめ",
            "text": "あれ…？\n二人とも、どうしたの？",
            "zh": "咦……？\n你们俩，怎么了？",
            "narrator_zh": "燕"
        },
        {
            "location": "181/TALK",
            "narrator": "雛",
            "text": "あ、つばめちゃん！\nブロマイド見なかった？",
            "zh": "啊，燕！\n你看到我的写真照了吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "185/TALK",
            "narrator": "つばめ",
            "text": "ブロマイド？\nそれって、アイドルとかの\n写真のことだよね？",
            "zh": "写真照？\n那是指偶像之类的\n照片对吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "186/TALK",
            "narrator": "キリト",
            "text": "アイドル、か…。\nまあ、ひなこから見れば\nアイドルなのか？",
            "zh": "偶像，吗……。\n嘛，在雏子眼里\n勉强也算偶像吧？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "189/TALK",
            "narrator": "つばめ",
            "text": "どういうこと？",
            "zh": "什么意思？",
            "narrator_zh": "燕"
        },
        {
            "location": "190/TALK",
            "narrator": "キリト",
            "text": "なんとか、っていう、\n寝台列車のブロマイド\nなんだってさ。",
            "zh": "说是叫什么什么的，\n卧铺列车的写真照\n来着。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "191/TALK",
            "narrator": "キリト",
            "text": "普通に土産物屋で\n売ってるような\nブロマイドなんだろ？",
            "zh": "不就是纪念品店里\n随手就能买到的那种\n写真照吗？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "194/TALK",
            "narrator": "雛",
            "text": "そうだけど、思い出が\nたっぷり詰まってるの！",
            "zh": "话是这么说，但里面\n装着满满的回忆嘛！",
            "narrator_zh": "雏"
        },
        {
            "location": "199/TALK",
            "narrator": "つばめ",
            "text": "大変！\nそれじゃ、わたしも\n一緒に探すよ！",
            "zh": "那可不得了！\n那我也\n一起帮忙找呀！",
            "narrator_zh": "燕"
        },
        {
            "location": "201/TALK",
            "narrator": "雛",
            "text": "い、いいよー。\nだってつばめちゃん、\n今日はバイトの日でしょ？",
            "zh": "不、不用啦——。\n燕今天\n还要去打工吧？",
            "narrator_zh": "雏"
        },
        {
            "location": "202/TALK",
            "narrator": "キリト",
            "text": "遅刻したら、東雲教官や\nガブリエラに\n怒られるんじゃね？",
            "zh": "迟到的话，会被东云教官\n还有加布里埃拉\n训一顿的吧？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "206/TALK",
            "narrator": "つばめ",
            "text": "でも…ひなこちゃんの\n大切なものなんでしょ？",
            "zh": "可是……那是小雏\n很重要的东西对吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "209/TALK",
            "narrator": "雛",
            "text": "だからって、バイトがある\nつばめちゃんに\n迷惑はかけられないよ。",
            "zh": "就算那样，也不能给\n要去打工的燕\n添麻烦呀。",
            "narrator_zh": "雏"
        },
        {
            "location": "210/TALK",
            "narrator": "雛",
            "text": "あたしは大丈夫だから、\nつばめちゃんは\nバイト頑張ってきてね。",
            "zh": "我这边没事的，\n燕就快去\n好好打工吧。",
            "narrator_zh": "雏"
        },
        {
            "location": "213/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "225/TALK",
            "narrator": "つばめ",
            "text": "こぅぃぅ場合って",
            "zh": "像这种时候",
            "narrator_zh": "燕"
        },
        {
            "location": "227/TALK",
            "narrator": "つばめ",
            "text": "どうするのが",
            "zh": "到底怎么做",
            "narrator_zh": "燕"
        },
        {
            "location": "228/TALK",
            "narrator": "つばめ",
            "text": "正しぃのかな？(´･ω･｀) ",
            "zh": "才对呀？(´･ω･｀)",
            "narrator_zh": "燕"
        },
        {
            "location": "230/SEL",
            "narrator": "（選択肢）",
            "text": "どういう場合のこと？",
            "zh": "指什么情况呀？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "231/ACT",
            "narrator": "",
            "text": "どういう場合のこと？",
            "zh": "指什么情况呀？",
            "narrator_zh": ""
        },
        {
            "location": "233/TALK",
            "narrator": "つばめ",
            "text": "ひなこちゃんの失くした物",
            "zh": "小雏弄丢的东西",
            "narrator_zh": "燕"
        },
        {
            "location": "234/TALK",
            "narrator": "つばめ",
            "text": "わたしも",
            "zh": "我也",
            "narrator_zh": "燕"
        },
        {
            "location": "235/TALK",
            "narrator": "つばめ",
            "text": "一緒に探したぃのo(*･ﾛ･*)o、",
            "zh": "想一起帮忙找呀o(*･ﾛ･*)o、",
            "narrator_zh": "燕"
        },
        {
            "location": "236/TALK",
            "narrator": "つばめ",
            "text": "でも",
            "zh": "可是",
            "narrator_zh": "燕"
        },
        {
            "location": "237/TALK",
            "narrator": "つばめ",
            "text": "バイトがぁるんだから",
            "zh": "她让我因为要打工",
            "narrator_zh": "燕"
        },
        {
            "location": "238/TALK",
            "narrator": "つばめ",
            "text": "そっちを優先しろって(o´Д`)=з",
            "zh": "就先去顾打工那边(o´Д`)=з",
            "narrator_zh": "燕"
        },
        {
            "location": "242/TALK",
            "narrator": "つばめ",
            "text": "ひなこちゃんの言ってること",
            "zh": "小雏说的话",
            "narrator_zh": "燕"
        },
        {
            "location": "243/TALK",
            "narrator": "つばめ",
            "text": "正しいと思ぅ(´･ω･｀) ",
            "zh": "我也觉得是对的(´･ω･｀)",
            "narrator_zh": "燕"
        },
        {
            "location": "244/TALK",
            "narrator": "つばめ",
            "text": "だけど",
            "zh": "但是",
            "narrator_zh": "燕"
        },
        {
            "location": "245/TALK",
            "narrator": "つばめ",
            "text": "それでぃぃのかな？(･Д･｀)",
            "zh": "那样真的好吗？(･Д･｀)",
            "narrator_zh": "燕"
        },
        {
            "location": "247/SEL",
            "narrator": "（選択肢）",
            "text": "雛の言う通りだと思う",
            "zh": "我觉得雏说得对",
            "narrator_zh": "（选项）"
        },
        {
            "location": "248/SEL",
            "narrator": "（選択肢）",
            "text": "手伝ってあげてほしい",
            "zh": "希望能帮她一把",
            "narrator_zh": "（选项）"
        },
        {
            "location": "249/SEL",
            "narrator": "（選択肢）",
            "text": "大切なのはつばめの意志だ",
            "zh": "重要的是燕自己的想法",
            "narrator_zh": "（选项）"
        },
        {
            "location": "250/ACT",
            "narrator": "",
            "text": "雛の言う通りだと思う",
            "zh": "我觉得雏说得对",
            "narrator_zh": ""
        },
        {
            "location": "251/TALK",
            "narrator": "つばめ",
            "text": "そっか",
            "zh": "这样啊",
            "narrator_zh": "燕"
        },
        {
            "location": "254/TALK",
            "narrator": "つばめ",
            "text": "わかったよ(*´︶`*)",
            "zh": "我知道了呀(*´︶`*)",
            "narrator_zh": "燕"
        },
        {
            "location": "266/TALK",
            "narrator": "つばめ",
            "text": "それじゃあ、\nひなこちゃん。\n悪いんだけどわたし…。",
            "zh": "那……\n小雏。\n不好意思，我……。",
            "narrator_zh": "燕"
        },
        {
            "location": "267/TALK",
            "narrator": "雛",
            "text": "うん、アルバイト\n頑張ってねー。",
            "zh": "嗯，打工\n加油哦——。",
            "narrator_zh": "雏"
        },
        {
            "location": "268/TALK",
            "narrator": "キリト",
            "text": "俺も一緒に探すから、\n心配いらねぇよ。",
            "zh": "我也会一起帮忙找的，\n不用担心。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "269/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "271/TALK",
            "narrator": "キリト",
            "text": "ほら、逢瀬。\n本当に遅刻するぞ？",
            "zh": "喂，逢濑。\n再不走真要迟到了哦？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "274/TALK",
            "narrator": "つばめ",
            "text": "…やっぱり、\n放っておけないよ！",
            "zh": "……果然，\n放着不管不行呀！",
            "narrator_zh": "燕"
        },
        {
            "location": "275/ACT",
            "narrator": "",
            "text": "手伝ってあげてほしい",
            "zh": "希望能帮她一把",
            "narrator_zh": ""
        },
        {
            "location": "276/TALK",
            "narrator": "つばめ",
            "text": "$handle$さん",
            "zh": "$handle$",
            "narrator_zh": "燕"
        },
        {
            "location": "278/TALK",
            "narrator": "つばめ",
            "text": "ぁりがと(*´︶`*)",
            "zh": "谢谢呀(*´︶`*)",
            "narrator_zh": "燕"
        },
        {
            "location": "279/TALK",
            "narrator": "つばめ",
            "text": "わたし",
            "zh": "我",
            "narrator_zh": "燕"
        },
        {
            "location": "280/TALK",
            "narrator": "つばめ",
            "text": "やっぱり手伝ぅね(≧ω≦)",
            "zh": "还是留下来帮忙呀(≧ω≦)",
            "narrator_zh": "燕"
        },
        {
            "location": "291/ACT",
            "narrator": "",
            "text": "大切なのはつばめの意志だ",
            "zh": "重要的是燕自己的想法",
            "narrator_zh": ""
        },
        {
            "location": "292/TALK",
            "narrator": "つばめ",
            "text": "わたしの意志は",
            "zh": "我的想法",
            "narrator_zh": "燕"
        },
        {
            "location": "293/TALK",
            "narrator": "つばめ",
            "text": "もう決まってるよ",
            "zh": "已经定下来了呀",
            "narrator_zh": "燕"
        },
        {
            "location": "295/TALK",
            "narrator": "つばめ",
            "text": "悩むことなかったんだね(●´ω｀●)ゞ",
            "zh": "根本没什么好纠结的嘛(●´ω｀●)ゞ",
            "narrator_zh": "燕"
        },
        {
            "location": "296/TALK",
            "narrator": "つばめ",
            "text": "気づかせてくれて",
            "zh": "点醒了我",
            "narrator_zh": "燕"
        },
        {
            "location": "297/TALK",
            "narrator": "つばめ",
            "text": "ぁりがと(*≧∀≦*) ",
            "zh": "谢谢呀(*≧∀≦*)",
            "narrator_zh": "燕"
        },
        {
            "location": "311/TALK",
            "narrator": "つばめ",
            "text": "ひなこちゃん。\nやっぱり、わたしも\n手伝うよ！",
            "zh": "小雏。\n果然，我还是\n留下来帮忙！",
            "narrator_zh": "燕"
        },
        {
            "location": "312/TALK",
            "narrator": "雛",
            "text": "ちょ、つばめちゃん！\nあたしの話聞いてた？",
            "zh": "等、燕！\n你到底有没有听我说话啊？",
            "narrator_zh": "雏"
        },
        {
            "location": "313/TALK",
            "narrator": "キリト",
            "text": "今日はシフトの人数も\n少ないんだし、\n行かないとマズいだろ？",
            "zh": "今天排班的人手\n本来就少，\n你不去可不妙吧？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "316/TALK",
            "narrator": "つばめ",
            "text": "電車一本分だけ！\nそれくらいなら、\nそんなに怒られないし…。",
            "zh": "就耽误一班电车的时间！\n只晚那么一点的话，\n不会挨太重骂的……。",
            "narrator_zh": "燕"
        },
        {
            "location": "317/TALK",
            "narrator": "雛",
            "text": "でも…。",
            "zh": "可是……。",
            "narrator_zh": "雏"
        },
        {
            "location": "318/TALK",
            "narrator": "つばめ",
            "text": "それに、今のまま\nバイトに行っても、\n集中できないと思うの…。",
            "zh": "而且，照这样\n去打工的话，\n我也没法专心嘛……。",
            "narrator_zh": "燕"
        },
        {
            "location": "319/TALK",
            "narrator": "つばめ",
            "text": "だから、お願い。\nわたしにも探し物の\nお手伝いさせて？",
            "zh": "所以，拜托了。\n也让我一起\n帮忙找找吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "320/TALK",
            "narrator": "雛",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雏"
        },
        {
            "location": "321/TALK",
            "narrator": "雛",
            "text": "もぅ…本当に電車一本分\nだけだからね？",
            "zh": "真是的……真的只准\n耽误一班电车哦？",
            "narrator_zh": "雏"
        },
        {
            "location": "323/TALK",
            "narrator": "つばめ",
            "text": "ほんとう！？\nありがとう、\nひなこちゃん。",
            "zh": "真的吗！？\n谢谢你，\n小雏。",
            "narrator_zh": "燕"
        },
        {
            "location": "324/TALK",
            "narrator": "キリト",
            "text": "逢瀬が礼を言うのは\n変じゃないか？",
            "zh": "怎么反倒让逢濑道起谢来了，\n不觉得奇怪吗？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "327/TALK",
            "narrator": "つばめ",
            "text": "あ、あれ、そうかな？",
            "zh": "啊、咦，是这样吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "328/TALK",
            "narrator": "雛",
            "text": "あはは、こちらこそ\nありがとうだよー。",
            "zh": "啊哈哈，应该是我\n谢谢你才对呀——。",
            "narrator_zh": "雏"
        },
        {
            "location": "330/TALK",
            "narrator": "キリト",
            "text": "まったく…。\nそんじゃ、さっさと\n探すの再開しようぜ。",
            "zh": "真是服了……。\n那赶紧接着\n找吧。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "346/TALK",
            "narrator": "ヒカル",
            "text": "…なるほど。\nそんなことがあったんだ？",
            "zh": "……原来如此。\n还有过那样的事啊？",
            "narrator_zh": "光"
        },
        {
            "location": "348/TALK",
            "narrator": "キリト",
            "text": "ああ…結局あの後、\n逢瀬が見つけて\nくれたんだよな？",
            "zh": "嗯……结果后来，\n还真让逢濑给\n找着了吧？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "349/TALK",
            "narrator": "雛",
            "text": "うん…。\n電車、三本分くらい\n遅くなっちゃったけど…。",
            "zh": "嗯……。\n虽然最后晚了\n大概三班电车吧……。",
            "narrator_zh": "雏"
        },
        {
            "location": "350/TALK",
            "narrator": "繭",
            "text": "…逢瀬さんらしいわ。",
            "zh": "……倒是很像逢濑的作风。",
            "narrator_zh": "茧"
        },
        {
            "location": "351/TALK",
            "narrator": "繭",
            "text": "どこか抜けてて、\n危なっかしいのに…。",
            "zh": "明明总是丢三落四，\n看着让人提心吊胆……。",
            "narrator_zh": "茧"
        },
        {
            "location": "352/TALK",
            "narrator": "繭",
            "text": "呆れるくらいお節介で、\n困ってる人がいたら\n見捨てられない性格。",
            "zh": "却热心得叫人无语，\n只要看见有人发愁\n就绝不会袖手旁观。",
            "narrator_zh": "茧"
        },
        {
            "location": "353/TALK",
            "narrator": "ヒカル",
            "text": "…いい子だよね。\n逢瀬さんって。",
            "zh": "……真是个好姑娘啊，\n逢濑。",
            "narrator_zh": "光"
        },
        {
            "location": "354/TALK",
            "narrator": "キリト",
            "text": "ああ…ちょっとだけ\n頼りない感じだけどな。",
            "zh": "嗯……虽然感觉\n稍微有点儿靠不住。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "355/TALK",
            "narrator": "雛",
            "text": "そこも含めて\nつばめちゃんの\n魅力だと思うなー。",
            "zh": "我觉得连这点在内，\n也是燕的\n魅力所在呀——。",
            "narrator_zh": "雏"
        },
        {
            "location": "359/TALK",
            "narrator": "ヒカル",
            "text": "…多分、東雲教官に\nバレたら確実に怒られると\n思うけど…。",
            "zh": "……虽然我觉得，\n这事要是被东云教官\n发现肯定会挨骂……。",
            "narrator_zh": "光"
        },
        {
            "location": "360/TALK",
            "narrator": "ヒカル",
            "text": "このままってわけには、\nいかないよね？",
            "zh": "但总不能就这样\n什么都不做吧？",
            "narrator_zh": "光"
        },
        {
            "location": "362/TALK",
            "narrator": "キリト",
            "text": "…そうだな。",
            "zh": "……说得是。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "364/TALK",
            "narrator": "雛",
            "text": "じゃ、じゃあ、キリト達も\n手伝ってくれるの！？",
            "zh": "那、那也就是说，圣翔你们也\n愿意帮忙了！？",
            "narrator_zh": "雏"
        },
        {
            "location": "366/TALK",
            "narrator": "キリト",
            "text": "ただし！\n俺たちで逢瀬を助ける、\nってのはナシだぞ？",
            "zh": "不过！\n靠我们几个直接去救逢濑，\n这事免谈哦？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "367/TALK",
            "narrator": "キリト",
            "text": "さすがにそれは無謀だし、\n上手くいく可能性は、\n考えるまでもないしな。",
            "zh": "那未免太鲁莽了，\n根本不用想就知道\n不可能顺利的。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "368/TALK",
            "narrator": "雛",
            "text": "じゃあ、どうするの？",
            "zh": "那，怎么办？",
            "narrator_zh": "雏"
        },
        {
            "location": "369/TALK",
            "narrator": "キリト",
            "text": "…綾水先輩達と、\nどうにか連絡を\n取るんだよ。",
            "zh": "……想方设法\n联系上\n绫水前辈她们。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "370/TALK",
            "narrator": "キリト",
            "text": "俺たちだけで\n逢瀬を助けるなんて、\n絶対に無理な話だ。",
            "zh": "光靠我们几个\n去救逢濑，\n绝对是天方夜谭。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "371/TALK",
            "narrator": "キリト",
            "text": "だから、先輩たちと連絡を\n取ってから、サポートする\n形で俺たちは動く。",
            "zh": "所以，我们先联系上前辈们，\n再以支援她们的形式\n行动。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "372/TALK",
            "narrator": "キリト",
            "text": "それなら、無理な話でも\nないからな。",
            "zh": "那样的话，倒也不是\n办不到的事。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "373/TALK",
            "narrator": "ヒカル",
            "text": "まあ、逢瀬さんの救出を\n手伝うってだけでも、\n危険に変わりないけど…。",
            "zh": "嘛，哪怕只是协助\n救出逢濑，\n也依然很危险就是了……。",
            "narrator_zh": "光"
        },
        {
            "location": "374/TALK",
            "narrator": "ヒカル",
            "text": "ひなこさん。\nそれで納得して\nもらえますか？",
            "zh": "雏子。\n这个方案你能\n接受吗？",
            "narrator_zh": "光"
        },
        {
            "location": "375/TALK",
            "narrator": "雛",
            "text": "…もちろんだよ。",
            "zh": "……当然可以呀。",
            "narrator_zh": "雏"
        },
        {
            "location": "376/TALK",
            "narrator": "雛",
            "text": "キリト、ヒカルくん…。\nワガママ聞いてくれて\nありがと。",
            "zh": "圣翔、光……。\n谢谢你们愿意听从\n我的任性。",
            "narrator_zh": "雏"
        },
        {
            "location": "377/TALK",
            "narrator": "キリト",
            "text": "礼はいらねぇよ。",
            "zh": "用不着道谢。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "378/TALK",
            "narrator": "キリト",
            "text": "俺たちだって、本当は\n逢瀬のこと助けたいと\n思ってたんだからな。",
            "zh": "说到底，我们自己\n本来也一直想\n救出逢濑的啊。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "379/TALK",
            "narrator": "ヒカル",
            "text": "そういうことです。",
            "zh": "正是这样。",
            "narrator_zh": "光"
        },
        {
            "location": "381/TALK",
            "narrator": "ヒカル",
            "text": "…ただ、問題はどうやって\n綾水先輩達と連絡を取るか\nということだけど…。",
            "zh": "……不过，问题在于\n究竟怎么才能和\n绫水前辈她们取得联系……。",
            "narrator_zh": "光"
        },
        {
            "location": "382/TALK",
            "narrator": "キリト",
            "text": "ＷＡＶＥ送っても\n無反応だし、\nそうだなぁ…。",
            "zh": "发WAVE过去\n也没反应，\n这可难办了啊……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "383/TALK",
            "narrator": "雛",
            "text": "うーん…。",
            "zh": "唔——……。",
            "narrator_zh": "雏"
        },
        {
            "location": "384/TALK",
            "narrator": "繭",
            "text": "…身近な人に\n聞いてみるのは？",
            "zh": "……问问她们\n身边亲近的人呢？",
            "narrator_zh": "茧"
        },
        {
            "location": "387/TALK",
            "narrator": "雛",
            "text": "え？　どういうこと？",
            "zh": "哎？　什么意思？",
            "narrator_zh": "雏"
        },
        {
            "location": "390/TALK",
            "narrator": "繭",
            "text": "綾水先輩達の居場所、\n心当たりありそうな人に\n聞くの。",
            "zh": "找可能会对绫水前辈她们的去向\n有头绪的人\n打听。",
            "narrator_zh": "茧"
        },
        {
            "location": "391/TALK",
            "narrator": "繭",
            "text": "まあ、それ以外の方法は\n思いつかないけど。",
            "zh": "嘛，除此之外我也\n想不出别的办法了。",
            "narrator_zh": "茧"
        },
        {
            "location": "393/TALK",
            "narrator": "キリト",
            "text": "けど、身近な人って\n誰のことだよ？",
            "zh": "可是，所谓亲近的人\n是指谁啊？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "394/TALK",
            "narrator": "キリト",
            "text": "知る限りだと、俺たちが\n一番身近な気するし…。",
            "zh": "就我所知，感觉咱们几个\n就已经算最亲近的了……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "397/TALK",
            "narrator": "雛",
            "text": "あっ！！",
            "zh": "啊！！",
            "narrator_zh": "雏"
        },
        {
            "location": "399/TALK",
            "narrator": "ヒカル",
            "text": "うわっ！？\nど、どうしたんですか！？",
            "zh": "哇啊！？\n怎、怎么了！？",
            "narrator_zh": "光"
        },
        {
            "location": "400/TALK",
            "narrator": "雛",
            "text": "いる、いるよ！！\nとっても身近な人で、\nあたし達よりももっと…。",
            "zh": "有、有人啊！！\n一个非常亲近的人，\n比我们还要更……。",
            "narrator_zh": "雏"
        },
        {
            "location": "401/TALK",
            "narrator": "雛",
            "text": "綾水様のこと\n知ってる人が！！",
            "zh": "更了解绫水大人\n的人！！",
            "narrator_zh": "雏"
        }
    ]
}
