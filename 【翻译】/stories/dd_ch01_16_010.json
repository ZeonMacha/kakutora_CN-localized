{
    "dir": "chap16/daydra/dd_ch01_16_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "16152",
        "cid": "tsubame",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "二人きり",
        "title_zh": "Extra002 额外剧情",
        "sub_title_zh": "只有两个人"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "二人きり",
            "zh": "只有两个人",
            "narrator_zh": ""
        },
        {
            "location": "23/TALK",
            "narrator": "つばめ",
            "text": "キリトくん。\nひなこちゃん達から\n連絡来た？",
            "zh": "圣翔。\n小雏她们\n联系你了吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "27/TALK",
            "narrator": "キリト",
            "text": "ああ、今丁度、\n学園を出たってさ。",
            "zh": "啊，刚好，\n说是刚出学校。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "28/TALK",
            "narrator": "つばめ",
            "text": "そっか…もう少し\nかかりそうだね。",
            "zh": "这样啊……还得\n再等一会儿呢。",
            "narrator_zh": "燕"
        },
        {
            "location": "29/TALK",
            "narrator": "キリト",
            "text": "だな…しっかし、\n逢瀬と二人きりって\n結構珍しい気が――",
            "zh": "是啊……话说，\n跟逢濑两个人独处，\n感觉还挺少见——",
            "narrator_zh": "圣翔"
        },
        {
            "location": "31/TALK",
            "narrator": "キリト",
            "text": "…っていうか、初めてか？",
            "zh": "……或者说，这是第一次？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "33/TALK",
            "narrator": "つばめ",
            "text": "えっ…？",
            "zh": "诶……？",
            "narrator_zh": "燕"
        },
        {
            "location": "35/TALK",
            "narrator": "つばめ",
            "text": "そういえば、キリトくんと\n二人きりって、今まで\nなかったかも。",
            "zh": "这么一说，跟圣翔\n两个人独处，以前\n好像还真没有。",
            "narrator_zh": "燕"
        },
        {
            "location": "37/TALK",
            "narrator": "つばめ",
            "text": "そ、そうだね。\n言われるまで\n気づかなかったよ。",
            "zh": "是、是啊。\n你不说的话，\n我都没注意到。",
            "narrator_zh": "燕"
        },
        {
            "location": "39/TALK",
            "narrator": "キリト",
            "text": "結構付き合い長いのに、\n意外だな。",
            "zh": "都认识这么久了，\n还挺意外的。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "40/TALK",
            "narrator": "キリト",
            "text": "でも考えてみりゃ、\nいつもはひなこか繭辺りが\n一緒だからなぁ…。",
            "zh": "不过想想也是，\n平时总有小雏或者小茧\n在一起……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "42/TALK",
            "narrator": "つばめ",
            "text": "うん…そうだね。",
            "zh": "嗯……是啊。",
            "narrator_zh": "燕"
        },
        {
            "location": "43/TALK",
            "narrator": "キリト",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "45/TALK",
            "narrator": "キリト",
            "text": "やべぇ、余計なこと\n言っちまったか…？",
            "zh": "糟了，是不是\n说了多余的话……？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "47/TALK",
            "narrator": "キリト",
            "text": "飲み物、追加でもするか？",
            "zh": "要不要再点杯喝的？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "49/TALK",
            "narrator": "つばめ",
            "text": "う、うん…そうだね。",
            "zh": "嗯、嗯……好啊。",
            "narrator_zh": "燕"
        },
        {
            "location": "52/TALK",
            "narrator": "キリト",
            "text": "やっぱり…逢瀬のやつ、\nメチャクチャ緊張しち\nまってる…。",
            "zh": "果然……逢濑这家伙，\n紧张得不行\n……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "53/TALK",
            "narrator": "キリト",
            "text": "普段普通に喋ってるから、\n気を抜き過ぎちまったか。",
            "zh": "平时说话挺正常的，\n我就松懈过头了吗。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "56/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "59/TALK",
            "narrator": "キリト",
            "text": "でも…なんか、こうして\n改めて見ると――",
            "zh": "不过……这么\n重新一看——",
            "narrator_zh": "圣翔"
        },
        {
            "location": "61/TALK",
            "narrator": "キリト",
            "text": "逢瀬って結構美人で\n可愛いかも――",
            "zh": "逢濑其实挺漂亮，\n也挺可爱的——",
            "narrator_zh": "圣翔"
        },
        {
            "location": "65/TALK",
            "narrator": "キリト",
            "text": "いやいや、そうじゃない！",
            "zh": "不对不对，不是这个！",
            "narrator_zh": "圣翔"
        },
        {
            "location": "67/TALK",
            "narrator": "つばめ",
            "text": "えっ！？　な、なにが！？",
            "zh": "诶！？　什、什么！？",
            "narrator_zh": "燕"
        },
        {
            "location": "70/TALK",
            "narrator": "キリト",
            "text": "あ、いや…。",
            "zh": "啊，没什么……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "72/TALK",
            "narrator": "キリト",
            "text": "ダメだ、ここは男の俺が\nしっかりしないと！",
            "zh": "不行，这种时候\n我这个男的得撑住！",
            "narrator_zh": "圣翔"
        },
        {
            "location": "74/TALK",
            "narrator": "キリト",
            "text": "お、逢瀬は…えっと…。",
            "zh": "逢、逢濑……那个……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "75/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "78/TALK",
            "narrator": "キリト",
            "text": "何かないか？\nこの重い空気を払える、\n盛り上がれる話題は…。",
            "zh": "有没有什么话题？\n能把这股沉闷散掉、\n还能热起来的……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "81/TALK",
            "narrator": "キリト",
            "text": "…そ、そうだ！\n逢瀬は戦艦のこと\nどう思う？",
            "zh": "……对、对了！\n逢濑觉得战舰\n怎么样？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "83/TALK",
            "narrator": "つばめ",
            "text": "え？　戦艦って、\nキリトくんの好きな\nあの戦艦？",
            "zh": "诶？　战舰，\n是圣翔喜欢的\n那种战舰？",
            "narrator_zh": "燕"
        },
        {
            "location": "84/TALK",
            "narrator": "キリト",
            "text": "そうそう。",
            "zh": "对对。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "85/TALK",
            "narrator": "キリト",
            "text": "あ、言っとくけど\n擬人化した奴じゃねぇ\nからな？",
            "zh": "啊，先说好，\n不是那种拟人化的\n啊？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "87/TALK",
            "narrator": "つばめ",
            "text": "ギジンカ？",
            "zh": "拟人化？",
            "narrator_zh": "燕"
        },
        {
            "location": "89/TALK",
            "narrator": "キリト",
            "text": "あ、いや…知らないなら\n良いんだ。\n気にしないでくれ。",
            "zh": "啊，没事……不知道\n就好。\n别在意。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "90/TALK",
            "narrator": "キリト",
            "text": "それより、逢瀬は戦艦の\nことをどう思う！？",
            "zh": "比起那个，逢濑觉得\n战舰怎么样！？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "92/TALK",
            "narrator": "つばめ",
            "text": "どうって…どうかなぁ？\nよくわからないかも…。",
            "zh": "怎么样……怎么说呢？\n我可能不太懂……。",
            "narrator_zh": "燕"
        },
        {
            "location": "95/TALK",
            "narrator": "キリト",
            "text": "って、当然だよ！\n何やってんだよ俺！？",
            "zh": "那不是当然的吗！\n我在干什么啊！？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "96/TALK",
            "narrator": "キリト",
            "text": "逢瀬が戦艦のことなんか\n知ってるわけねぇじゃん！",
            "zh": "逢濑怎么可能\n懂战舰那种东西！",
            "narrator_zh": "圣翔"
        },
        {
            "location": "98/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "99/TALK",
            "narrator": "キリト",
            "text": "ああ、余計に逢瀬が\n気まずそうな感じに\nなっちまった…。",
            "zh": "啊，逢濑看起来\n更尴尬了\n……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "101/TALK",
            "narrator": "キリト",
            "text": "てか、これドン引きって\nやつなのか？\n俺、引かれちまったか！？",
            "zh": "话说，这就是\n劝退吗？\n我是不是把人吓跑了！？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "104/TALK",
            "narrator": "キリト",
            "text": "あ～…えっと…。",
            "zh": "啊——……那个……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "106/TALK",
            "narrator": "つばめ",
            "text": "キリトくん、わたしのこと\n気にして話しかけてきて\nくれてるのに――",
            "zh": "圣翔明明是\n顾着我，才找话题\n跟我说话——",
            "narrator_zh": "燕"
        },
        {
            "location": "107/TALK",
            "narrator": "つばめ",
            "text": "戦艦のことなんて、\nどう聞けばいいか\nわからないよぉ…。",
            "zh": "战舰的事，\n我不知道该怎么问\n才好……。",
            "narrator_zh": "燕"
        },
        {
            "location": "119/TALK",
            "narrator": "つばめ",
            "text": "お願い、一緒に考えて",
            "zh": "拜托了，一起想想",
            "narrator_zh": "燕"
        },
        {
            "location": "122/SEL",
            "narrator": "",
            "text": "つばめ、慌て過ぎ",
            "zh": "燕，你太慌了",
            "narrator_zh": ""
        },
        {
            "location": "123/ACT",
            "narrator": "",
            "text": "つばめ、慌て過ぎ",
            "zh": "燕，你太慌了",
            "narrator_zh": ""
        },
        {
            "location": "125/TALK",
            "narrator": "つばめ",
            "text": "だって、緊張しちゃって…",
            "zh": "因为，太紧张了……",
            "narrator_zh": "燕"
        },
        {
            "location": "126/TALK",
            "narrator": "つばめ",
            "text": "それに、戦艦のこと知らないから、なんて聞けばいいかわからないよ",
            "zh": "而且我也不懂战舰，不知道该怎么问",
            "narrator_zh": "燕"
        },
        {
            "location": "128/SEL",
            "narrator": "",
            "text": "戦艦のどこが好きなのかな？",
            "zh": "他喜欢战舰的哪里呢？",
            "narrator_zh": ""
        },
        {
            "location": "129/SEL",
            "narrator": "",
            "text": "戦艦で戦ってみたいのかな？",
            "zh": "是想坐战舰去打仗吗？",
            "narrator_zh": ""
        },
        {
            "location": "130/ACT",
            "narrator": "",
            "text": "戦艦のどこが好きなのかな？",
            "zh": "他喜欢战舰的哪里呢？",
            "narrator_zh": ""
        },
        {
            "location": "132/TALK",
            "narrator": "つばめ",
            "text": "ありがと、それ聞いてみる",
            "zh": "谢谢，我问问看",
            "narrator_zh": "燕"
        },
        {
            "location": "145/TALK",
            "narrator": "つばめ",
            "text": "キリトくんは、\n戦艦のどこが好きなの？",
            "zh": "圣翔喜欢\n战舰的哪里？",
            "narrator_zh": "燕"
        },
        {
            "location": "146/TALK",
            "narrator": "キリト",
            "text": "えっ？　そうだなぁ…。",
            "zh": "诶？　这个嘛……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "147/TALK",
            "narrator": "キリト",
            "text": "見た目は譲れねぇな。\nそこにあるだけで\n超かっこいいからな。",
            "zh": "外观我是不会让步的。\n光是停在那里，\n就帅得不行。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "148/TALK",
            "narrator": "つばめ",
            "text": "うんうん。",
            "zh": "嗯嗯。",
            "narrator_zh": "燕"
        },
        {
            "location": "150/TALK",
            "narrator": "キリト",
            "text": "こう、普通の船と違って、\n船全体が装甲に覆われた\nところとか――",
            "zh": "就是，跟普通的船不一样，\n整艘船都包着装甲\n的地方——",
            "narrator_zh": "圣翔"
        },
        {
            "location": "151/TALK",
            "narrator": "キリト",
            "text": "大きな砲門がいくつも\n載った重量感とか、\nマジ半端ねぇよな！",
            "zh": "好几门大炮压在上面\n的那种分量，\n真的不是闹着玩的！",
            "narrator_zh": "圣翔"
        },
        {
            "location": "152/TALK",
            "narrator": "キリト",
            "text": "それに、全体を包む\n汗と油の染みついた\n男臭いオーラ…。",
            "zh": "还有，裹着整艘船的、\n汗和机油渗进去的\n那股男人味……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "153/TALK",
            "narrator": "キリト",
            "text": "そんなのが大海原で\n主砲やら対空砲ぶっ放して\n戦うんだぜ？",
            "zh": "那种东西在大海上，\n主炮、高射炮一通乱放，\n打起来？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "155/TALK",
            "narrator": "キリト",
            "text": "マジかっこよ過ぎるだろ、\nって話さ！",
            "zh": "帅过头了吧，\n就是这么回事！",
            "narrator_zh": "圣翔"
        },
        {
            "location": "157/TALK",
            "narrator": "つばめ",
            "text": "男臭さ…確かに、戦艦って\n男の子っぽい感じがする\nかも。",
            "zh": "男人味……确实，战舰\n给人一种男孩子的感觉\n呢。",
            "narrator_zh": "燕"
        },
        {
            "location": "158/TALK",
            "narrator": "キリト",
            "text": "でもよ、実は女の名前が\n多いんだぜ？",
            "zh": "不过啊，其实用女孩子\n名字的还挺多的？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "159/TALK",
            "narrator": "つばめ",
            "text": "えぇっ、そうなの！？",
            "zh": "诶诶，是这样！？",
            "narrator_zh": "燕"
        },
        {
            "location": "160/TALK",
            "narrator": "キリト",
            "text": "そもそも船ってのは、\n女として見られてる\nからな。",
            "zh": "说到底，船这种东西\n本来就被当成\n女性来看。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "161/TALK",
            "narrator": "つばめ",
            "text": "えっ…あっ、そっか！\nだから姉妹艦って\nいうんだ！",
            "zh": "诶……啊，原来如此！\n所以才叫\n姐妹舰！",
            "narrator_zh": "燕"
        },
        {
            "location": "162/TALK",
            "narrator": "つばめ",
            "text": "兄弟艦、って呼び方、\n聞いたことないもん。",
            "zh": "兄弟舰这种叫法，\n我还没听过。",
            "narrator_zh": "燕"
        },
        {
            "location": "164/TALK",
            "narrator": "キリト",
            "text": "なっ、先に言われた！？\n俺がかっこよく教えようと\n思ってたのに！",
            "zh": "什么，被抢先说了！？\n我还想帅气地\n教你呢！",
            "narrator_zh": "圣翔"
        },
        {
            "location": "165/TALK",
            "narrator": "つばめ",
            "text": "えへへ…でも、凄いなぁ。\nキリトくんって、\n本当に好きなんだね？",
            "zh": "诶嘿嘿……不过，好厉害。\n圣翔是\n真的很喜欢呢？",
            "narrator_zh": "燕"
        },
        {
            "location": "166/TALK",
            "narrator": "キリト",
            "text": "おう！　戦艦に対する\n熱き想いは誰にも\n負ける気しねぇぜ！！",
            "zh": "那当然！　我对战舰的\n这股热血，谁都\n别想比过我！！",
            "narrator_zh": "圣翔"
        },
        {
            "location": "167/TALK",
            "narrator": "キリト",
            "text": "そうだ、今度俺お勧めの\n戦艦映画を…。",
            "zh": "对了，下次我推荐的\n战舰电影……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "168/TALK",
            "narrator": "雛",
            "text": "熱過ぎるから！",
            "zh": "太热了啦！",
            "narrator_zh": "雏"
        },
        {
            "location": "172/TALK",
            "narrator": "キリト",
            "text": "っ！？\nひなこ！",
            "zh": "……！？\n小雏！",
            "narrator_zh": "圣翔"
        },
        {
            "location": "175/TALK",
            "narrator": "繭",
            "text": "この席の周りだけ、\nバカみたいに\n蒸し暑いんだけど？",
            "zh": "怎么就这张桌子周围，\n热得\n离谱？",
            "narrator_zh": "茧"
        },
        {
            "location": "177/TALK",
            "narrator": "つばめ",
            "text": "ひなこちゃん、まゆちん。\nやっと到着だね。",
            "zh": "小雏，小茧。\n终于到了呢。",
            "narrator_zh": "燕"
        },
        {
            "location": "179/TALK",
            "narrator": "雛",
            "text": "いやー、お待たせ\nしちゃってごめんねー。",
            "zh": "哎呀，让你们\n久等了，对不起哦。",
            "narrator_zh": "雏"
        },
        {
            "location": "181/TALK",
            "narrator": "雛",
            "text": "っていうか、キリト。\n何で戦艦の話なんて\nしてんの？",
            "zh": "话说，圣翔。\n为什么在聊\n战舰啊？",
            "narrator_zh": "雏"
        },
        {
            "location": "183/TALK",
            "narrator": "キリト",
            "text": "いや、何でって…。",
            "zh": "不是，为什么……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "186/TALK",
            "narrator": "キリト",
            "text": "やべぇ…つい楽しくて\n熱くなり過ぎた！",
            "zh": "糟了……一聊高兴，\n就热过头了！",
            "narrator_zh": "圣翔"
        },
        {
            "location": "187/TALK",
            "narrator": "つばめ",
            "text": "で、でも、面白かったよ。\n全部は理解できなかった\nけど…。",
            "zh": "可、可是，挺有意思的。\n虽然没全听懂\n……。",
            "narrator_zh": "燕"
        },
        {
            "location": "188/TALK",
            "narrator": "雛",
            "text": "あー、ストップストップ！\n汗と油の染みつきそうな\n戦艦トークはおしまい！",
            "zh": "啊，停停停！\n快要沾上汗和机油的\n战舰话题到此为止！",
            "narrator_zh": "雏"
        },
        {
            "location": "189/TALK",
            "narrator": "雛",
            "text": "女子トークのシャワーで\n綺麗に洗い流すよ。",
            "zh": "我用女生话题的淋浴，\n把它们冲干净。",
            "narrator_zh": "雏"
        },
        {
            "location": "191/TALK",
            "narrator": "キリト",
            "text": "…やっぱ、女の子にする\n話じゃなかったよな？",
            "zh": "……果然，不是该跟\n女孩子说的话题吧？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "192/TALK",
            "narrator": "繭",
            "text": "聞くまでもない。",
            "zh": "还用问。",
            "narrator_zh": "茧"
        },
        {
            "location": "193/TALK",
            "narrator": "繭",
            "text": "カフェで女子とお茶しな\nがら、延々と戦艦について\n話すとか――",
            "zh": "在咖啡馆跟女生喝茶，\n还没完没了地聊\n战舰——",
            "narrator_zh": "茧"
        },
        {
            "location": "194/TALK",
            "narrator": "繭",
            "text": "マジないわ、ってレベル。\nドン引きされて帰られて\nないのが奇跡だから。",
            "zh": "真的不行，到这个程度了。\n没被劝退直接走掉，\n已经是奇迹了。",
            "narrator_zh": "茧"
        },
        {
            "location": "196/TALK",
            "narrator": "キリト",
            "text": "…こんなんだから俺、\nモテないんだろうなぁ。",
            "zh": "……所以我才\n不受欢迎吧。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "197/ACT",
            "narrator": "",
            "text": "戦艦で戦ってみたいのかな？",
            "zh": "是想坐战舰去打仗吗？",
            "narrator_zh": ""
        },
        {
            "location": "198/TALK",
            "narrator": "つばめ",
            "text": "男の子だからそうなのかも",
            "zh": "也许因为是男孩子才会这样",
            "narrator_zh": "燕"
        },
        {
            "location": "211/TALK",
            "narrator": "つばめ",
            "text": "戦艦に乗って戦いたい、\nってことかな？",
            "zh": "是想坐上战舰去打仗，\n是这个意思吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "212/TALK",
            "narrator": "キリト",
            "text": "ん～…時々言われるけど、\nそうじゃねぇんだよなぁ。",
            "zh": "嗯——……有时会被人这么说，\n不过不是那样啊。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "214/TALK",
            "narrator": "つばめ",
            "text": "違うの？",
            "zh": "不是吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "215/TALK",
            "narrator": "キリト",
            "text": "いや、確かに戦艦で\n海に出てさ――",
            "zh": "也不是，坐战舰\n出海的话——",
            "narrator_zh": "圣翔"
        },
        {
            "location": "216/TALK",
            "narrator": "キリト",
            "text": "そこで主砲の一発でも\n撃てたら、そりゃ最高の\n思い出になるだろうさ。",
            "zh": "要是能在那儿\n开上一发主炮，那肯定是\n最棒的回忆。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "217/TALK",
            "narrator": "キリト",
            "text": "けど…戦いたい、って\nわけじゃないんだよ…。",
            "zh": "可是……我并不是\n想去打仗……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "218/TALK",
            "narrator": "キリト",
            "text": "それに、戦闘で戦艦が\n壊れるところも、\n見たくないしな…。",
            "zh": "而且，战舰在战斗里\n被打坏的样子，\n我也不想看……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "219/TALK",
            "narrator": "つばめ",
            "text": "…そっか。",
            "zh": "……这样啊。",
            "narrator_zh": "燕"
        },
        {
            "location": "221/TALK",
            "narrator": "つばめ",
            "text": "戦艦のこと、本当に\n大好きで大切に思ってるん\nだね。",
            "zh": "你是真的\n很喜欢战舰，也很珍惜\n呢。",
            "narrator_zh": "燕"
        },
        {
            "location": "226/TALK",
            "narrator": "キリト",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "227/TALK",
            "narrator": "つばめ",
            "text": "…キリトくん？",
            "zh": "……圣翔？",
            "narrator_zh": "燕"
        },
        {
            "location": "230/TALK",
            "narrator": "キリト",
            "text": "いや、やっぱり違う！",
            "zh": "不，果然还是不对！",
            "narrator_zh": "圣翔"
        },
        {
            "location": "231/TALK",
            "narrator": "キリト",
            "text": "壊れてる戦艦だって、\nメチャクチャ\nかっこいいんだ！",
            "zh": "坏掉的战舰也\n帅得\n不行！",
            "narrator_zh": "圣翔"
        },
        {
            "location": "233/TALK",
            "narrator": "つばめ",
            "text": "えぇっ！？",
            "zh": "诶诶！？",
            "narrator_zh": "燕"
        },
        {
            "location": "235/TALK",
            "narrator": "キリト",
            "text": "激しい戦闘で半壊しても、\n沈まずに航行してるやつ\nとか――",
            "zh": "激烈战斗里打到半毁，\n还不沉、继续开着的\n那种——",
            "narrator_zh": "圣翔"
        },
        {
            "location": "236/TALK",
            "narrator": "キリト",
            "text": "海底で眠るように沈んだ\n戦艦なんかもな、味が\nあってかっこいいんだよ！",
            "zh": "还有像睡着一样沉在\n海底的战舰，也有味道，\n很帅的！",
            "narrator_zh": "圣翔"
        },
        {
            "location": "237/TALK",
            "narrator": "つばめ",
            "text": "でも、さっきは壊れた\n戦艦を見るのが嫌だ、って\n言ってたのに…。",
            "zh": "可是，你刚才还说\n不想看坏掉的\n战舰……。",
            "narrator_zh": "燕"
        },
        {
            "location": "238/TALK",
            "narrator": "キリト",
            "text": "わかってる。\n超矛盾してるよな？",
            "zh": "我知道。\n矛盾得离谱吧？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "239/TALK",
            "narrator": "キリト",
            "text": "けど、マジでいいんだよ！\nなんか見てるとさ、グッと\n来るのもあるんだぜ？",
            "zh": "可是，真的很好啊！\n看着看着，会一下子\n被戳中的吧？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "240/TALK",
            "narrator": "つばめ",
            "text": "…そうなんだ。",
            "zh": "……是这样啊。",
            "narrator_zh": "燕"
        },
        {
            "location": "242/TALK",
            "narrator": "キリト",
            "text": "…あ、やべぇ。\nつい熱が入っちまった…。",
            "zh": "……啊，糟了。\n一不小心又热起来了……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "243/TALK",
            "narrator": "つばめ",
            "text": "キリトくんって…。",
            "zh": "圣翔你啊……。",
            "narrator_zh": "燕"
        },
        {
            "location": "245/TALK",
            "narrator": "つばめ",
            "text": "本当に、戦艦が\n大好きなんだね。",
            "zh": "是真的，\n很喜欢战舰呢。",
            "narrator_zh": "燕"
        },
        {
            "location": "246/TALK",
            "narrator": "キリト",
            "text": "…え？",
            "zh": "……诶？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "247/TALK",
            "narrator": "つばめ",
            "text": "壊れるところを見たいとは\n思わないのに――",
            "zh": "并不想看它\n坏掉的样子——",
            "narrator_zh": "燕"
        },
        {
            "location": "248/TALK",
            "narrator": "つばめ",
            "text": "壊れた戦艦も、かっこいい\nって言えるんだもん。",
            "zh": "却又能说坏掉的战舰\n也很帅。",
            "narrator_zh": "燕"
        },
        {
            "location": "249/TALK",
            "narrator": "つばめ",
            "text": "どんな状態でも好きって\n言えるなんて、すごく\n素敵だと思う。",
            "zh": "不管什么状态\n都能说喜欢，\n我觉得非常棒。",
            "narrator_zh": "燕"
        },
        {
            "location": "251/TALK",
            "narrator": "キリト",
            "text": "…そ、そうか。",
            "zh": "……是、是吗。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "252/TALK",
            "narrator": "つばめ",
            "text": "うん。戦艦に対する\nキリトくんの気持ち、\n沢山伝わったよ。",
            "zh": "嗯。圣翔对战舰的\n心情，\n我好好感受到了。",
            "narrator_zh": "燕"
        },
        {
            "location": "256/TALK",
            "narrator": "キリト",
            "text": "…ヤベェ。",
            "zh": "……糟了。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "257/TALK",
            "narrator": "キリト",
            "text": "こんなふうに言って\nもらうの初めてで、\nなんか感激してきた。",
            "zh": "第一次被人\n这样说，\n有点感动了。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "261/TALK",
            "narrator": "キリト",
            "text": "…ありがとな。\n少し恥ずかしいけど、\n嬉しいぜ。",
            "zh": "……谢了。\n有点不好意思，\n不过很高兴。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "262/TALK",
            "narrator": "雛",
            "text": "恥ずかしがるところが\n違うでしょ！？",
            "zh": "你不好意思的地方\n搞错了吧！？",
            "narrator_zh": "雏"
        },
        {
            "location": "268/TALK",
            "narrator": "キリト",
            "text": "っ！？\nひなこ！",
            "zh": "……！？\n小雏！",
            "narrator_zh": "圣翔"
        },
        {
            "location": "271/TALK",
            "narrator": "繭",
            "text": "女の子相手に熱い戦艦\nトークとか、マジないわ。",
            "zh": "对着女孩子热血聊\n战舰，真的不行。",
            "narrator_zh": "茧"
        },
        {
            "location": "273/TALK",
            "narrator": "つばめ",
            "text": "ひなこちゃん、まゆちん。\nやっと到着だね。",
            "zh": "小雏，小茧。\n终于到了呢。",
            "narrator_zh": "燕"
        },
        {
            "location": "275/TALK",
            "narrator": "雛",
            "text": "いやー、お待たせ\nしちゃってごめんねー。",
            "zh": "哎呀，让你们\n久等了，对不起哦。",
            "narrator_zh": "雏"
        },
        {
            "location": "276/TALK",
            "narrator": "雛",
            "text": "…まあ、退屈はして\nなかったみたいだけど。",
            "zh": "……不过，看起来\n也没觉得无聊。",
            "narrator_zh": "雏"
        },
        {
            "location": "277/TALK",
            "narrator": "つばめ",
            "text": "うん、キリトくんが\n戦艦のこと、いっぱい\nお話ししてくれたからね。",
            "zh": "嗯，因为圣翔\n讲了好多\n战舰的事。",
            "narrator_zh": "燕"
        },
        {
            "location": "281/TALK",
            "narrator": "キリト",
            "text": "あ、ああ…まあな。",
            "zh": "啊，啊……也是。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "282/TALK",
            "narrator": "繭",
            "text": "女子とカフェで二人きり。\nそんなシチュエーションで\n戦艦トークとか――",
            "zh": "跟女生两个人在咖啡馆。\n这种场合还聊\n战舰——",
            "narrator_zh": "茧"
        },
        {
            "location": "283/TALK",
            "narrator": "繭",
            "text": "逢瀬さんじゃなかったら、\n確実にドン引きされて\n帰られてたと思う。",
            "zh": "要不是逢濑，\n肯定已经被劝退、\n直接回去了。",
            "narrator_zh": "茧"
        },
        {
            "location": "284/TALK",
            "narrator": "キリト",
            "text": "いや、わかってる！\nわかってはいたんだ！",
            "zh": "不是，我知道！\n我明明知道的！",
            "narrator_zh": "圣翔"
        },
        {
            "location": "286/TALK",
            "narrator": "キリト",
            "text": "けど、いい感じの質問を\nされちまって、\nつい抑えられなくて…。",
            "zh": "可是，被问了个\n正好的问题，\n一下子没忍住……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "287/TALK",
            "narrator": "つばめ",
            "text": "それだけ戦艦のことが\n好きって証拠だよ。",
            "zh": "这就是你那么喜欢\n战舰的证据呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "289/TALK",
            "narrator": "キリト",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "291/TALK",
            "narrator": "キリト",
            "text": "こんなんだから、\n俺ってモテないんだろう\nなぁ…とほほ。",
            "zh": "所以啊，\n我才不受欢迎\n吧……唉。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "22/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>7月21日　3:20 PM</color>\nとある平日の放課後、某カフェにて。",
            "zh": "<color=green>7月21日　3:20 PM</color>\n某个工作日的放学后，在某家咖啡馆。",
            "narrator_zh": "Dialog_EventData"
        }
    ]
}
