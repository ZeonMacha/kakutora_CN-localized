            "narrator_zh": "燕"
        },
        {
            "location": "203/ACT",
            "narrator": "",
            "text": "メール送信：ガブリエラ",
            "zh": "发送邮件：加布里埃拉",
            "narrator_zh": ""
        },
        {
            "location": "209/TALK",
            "narrator": "つばめ",
            "text": "あれ？",
            "zh": "咦？",
            "narrator_zh": "燕"
        },
        {
            "location": "210/TALK",
            "narrator": "つばめ",
            "text": "あれ！？\nガブちゃんにメール\n送っちゃってる！",
            "zh": "咦！？\n邮件发给\n加布了！",
            "narrator_zh": "燕"
        },
        {
            "location": "211/TALK",
            "narrator": "つばめ",
            "text": "どうしよう…\nわたし、何もしてない\nのに…。",
            "zh": "怎么办……\n我什么都\n没做……。",
            "narrator_zh": "燕"
        },
        {
            "location": "217/TALK",
            "narrator": "ガブリエラ",
            "text": "まったく、何なのよ？\nわざわざメールで\n呼び出すなんて！",
            "zh": "真是的，怎么回事？\n还特地用邮件\n把人叫出来！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "220/TALK",
            "narrator": "つばめ",
            "text": "ご、ごめんなさい！\n間違って送っちゃった\nみたいで…",
            "zh": "对、对不起！\n好像发错了\n……。",
            "narrator_zh": "燕"
        },
        {
            "location": "222/TALK",
            "narrator": "つばめ",
            "text": "ゲホゲホッ！",
            "zh": "咳咳！",
            "narrator_zh": "燕"
        },
        {
            "location": "224/TALK",
            "narrator": "ガブリエラ",
            "text": "…ちょっと、本格的に\n風邪じゃない。",
            "zh": "……喂，这是\n正经感冒了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "225/TALK",
            "narrator": "ガブリエラ",
            "text": "もういいから、\n寮で寝てなさいよ。",
            "zh": "行了，\n回宿舍睡去。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "227/TALK",
            "narrator": "つばめ",
            "text": "そんな、大げさですよ。\nこれくらいなら\n心配いりませんから…。",
            "zh": "没那么夸张呀。\n这点程度\n不用担心……。",
            "narrator_zh": "燕"
        },
        {
            "location": "228/TALK",
            "narrator": "ガブリエラ",
            "text": "あんたじゃなくて、\nお客の心配をしてるのよ！",
            "zh": "我担心的不是你，\n是客人！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "229/TALK",
            "narrator": "ガブリエラ",
            "text": "映画を見に来たお客に、\nあんたの風邪がうつるかも\nしれないのよ？",
            "zh": "来看电影的客人，\n可能会被你的感冒\n传染哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "230/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "232/TALK",
            "narrator": "ガブリエラ",
            "text": "わかったら、さっさと\n寮に戻って寝なさい。",
            "zh": "知道的话，赶紧\n回宿舍睡觉。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "233/TALK",
            "narrator": "つばめ",
            "text": "…わかりました。",
            "zh": "……知道了。",
            "narrator_zh": "燕"
        },
        {
            "location": "234/TALK",
            "narrator": "つばめ",
            "text": "ありがとうございます。\nそれじゃあ、今日は\n帰って休みますね。",
            "zh": "谢谢。\n那我今天\n回去休息了。",
            "narrator_zh": "燕"
        },
        {
            "location": "236/TALK",
            "narrator": "ガブリエラ",
            "text": "風邪薬飲むの\n忘れないでよ？",
            "zh": "感冒药\n别忘了吃哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "237/TALK",
            "narrator": "つばめ",
            "text": "はい！",
            "zh": "好！",
            "narrator_zh": "燕"
        },
        {
            "location": "242/TALK",
            "narrator": "ガブリエラ",
            "text": "……はぁ。",
            "zh": "……哈啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "244/TALK",
            "narrator": "ガブリエラ",
            "text": "…まあ、お客なんて\n来ないんだから、\nうつらないんだけどね。",
            "zh": "……嘛，客人\n又不会来，\n也不会传染就是了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "245/ACT",
            "narrator": "",
            "text": "風邪薬は飲んでおいて",
            "zh": "先把感冒药吃了",
            "narrator_zh": ""
        },
        {
            "location": "262/TALK",
            "narrator": "つばめ",
            "text": "救急箱の中に入ってたから、すぐに飲むよ",
            "zh": "急救箱里有，我马上吃",
            "narrator_zh": "燕"
        },
        {
            "location": "263/TALK",
            "narrator": "つばめ",
            "text": "実は、結構ギリギリだったんだ…頭痛くて",
            "zh": "其实已经快到极限了……头好痛",
            "narrator_zh": "燕"
        },
        {
            "location": "274/TALK",
            "narrator": "つばめ",
            "text": "…風邪薬の存在、\n言われるまで思いも\nしなかったな…。",
            "zh": "……感冒药，\n不说的话根本\n想不到……。",
            "narrator_zh": "燕"
        },
        {
            "location": "275/TALK",
            "narrator": "つばめ",
            "text": "熱で頭が働かないのかも。\n飲んだら、少しだけ\n休憩しよ…。",
            "zh": "也许是烧得脑子转不动。\n吃了之后，稍微\n休息一下……。",
            "narrator_zh": "燕"
        },
        {
            "location": "15/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>7月30日　1:23 PM</color>\n夏休み初日の午後、神楽坂トライナリー劇場でのバイト中にて。",
            "zh": "<color=green>7月30日　1:23 PM</color>\n暑假第一天下午，在神乐坂三重奏剧场打工的时候。",
            "narrator_zh": "Dialog_EventData"
        }
    ]
}
