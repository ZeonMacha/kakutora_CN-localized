{
    "dir": "chap18/daydra/dd_ch01_18_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "18152",
        "cid": "tsubame",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "風邪気味",
        "title_zh": "Extra002 额外剧情",
        "sub_title_zh": "有点感冒"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "風邪気味",
            "zh": "有点感冒",
            "narrator_zh": ""
        },
        {
            "location": "28/TALK",
            "narrator": "ガブリエラ",
            "text": "つばめ、なんか顔が\n赤くなってない？",
            "zh": "燕，脸是不是\n有点红？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "30/TALK",
            "narrator": "つばめ",
            "text": "えっ…そういえば、\nちょっと顔が熱く\nなってるような…。",
            "zh": "诶……说起来，\n脸好像有点\n发热……。",
            "narrator_zh": "燕"
        },
        {
            "location": "31/TALK",
            "narrator": "ガブリエラ",
            "text": "それ、風邪じゃないの？\n寮に戻って寝た方が\nいいんじゃない？",
            "zh": "那不是感冒吗？\n回宿舍睡一觉\n比较好吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "32/TALK",
            "narrator": "つばめ",
            "text": "い、いえ、大丈夫です！\nお仕事もあるのに、\n休んでられませんし――",
            "zh": "不、不是，没事！\n还有工作，\n不能休息——",
            "narrator_zh": "燕"
        },
        {
            "location": "33/TALK",
            "narrator": "つばめ",
            "text": "これくらいなら、\n動いてればラクに\nなりますよ。",
            "zh": "这点程度的话，\n动一动就会\n轻松的。",
            "narrator_zh": "燕"
        },
        {
            "location": "35/TALK",
            "narrator": "ガブリエラ",
            "text": "…まあ、あんたが\nそう言うなら構わない\nけど…。",
            "zh": "……嘛，你\n都这么说的话\n也行……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "37/TALK",
            "narrator": "ガブリエラ",
            "text": "熱は夕方になると上がる、\nっていうから、\n無理しない方がいいわよ。",
            "zh": "听说傍晚会发烧，\n所以别勉强\n比较好哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "41/TALK",
            "narrator": "つばめ",
            "text": "…ガブちゃん\nわたしのこと\n心配してくれてたみたい。",
            "zh": "……加布\n好像在\n担心我。",
            "narrator_zh": "燕"
        },
        {
            "location": "43/TALK",
            "narrator": "つばめ",
            "text": "…素直に聞いておけば\nよかったかな？",
            "zh": "……老实听她的\n就好了吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "55/TALK",
            "narrator": "つばめ",
            "text": "っ、コホッ！\nケホケホッ…！",
            "zh": "咳！\n咳咳……！",
            "narrator_zh": "燕"
        },
        {
            "location": "56/TALK",
            "narrator": "つばめ",
            "text": "…意識したら、なんだか\n身体がダルくなって\nきちゃったかも。",
            "zh": "……一意识到，\n身体好像变得\n发沉了。",
            "narrator_zh": "燕"
        },
        {
            "location": "57/SEL",
            "narrator": "",
            "text": "休んだ方が良い",
            "zh": "还是休息比较好",
            "narrator_zh": ""
        },
        {
            "location": "58/SEL",
            "narrator": "",
            "text": "メール送信：ガブリエラ",
            "zh": "发送邮件：加布里埃拉",
            "narrator_zh": ""
        },
        {
            "location": "59/SEL",
            "narrator": "",
            "text": "風邪薬は飲んでおいて",
            "zh": "先把感冒药吃了",
            "narrator_zh": ""
        },
        {
            "location": "61/TALK",
            "narrator": "つばめ",
            "text": "でも、もう少しで\nお掃除終わるし――",
            "zh": "不过，打扫\n马上就结束了——",
            "narrator_zh": "燕"
        },
        {
            "location": "62/TALK",
            "narrator": "つばめ",
            "text": "それくらいだったら、\nどうにか頑張れるかも。",
            "zh": "这点程度的话，\n也许还能撑一下。",
            "narrator_zh": "燕"
        },
        {
            "location": "65/TALK",
            "narrator": "つばめ",
            "text": "えっと、雑誌はこっちに\n置いて、小物はとりあえず\nこっちに…。",
            "zh": "那个，杂志放这边，\n小东西先\n放这边……。",
            "narrator_zh": "燕"
        },
        {
            "location": "66/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "67/TALK",
            "narrator": "つばめ",
            "text": "気持ち悪いかも…。\nちょっとだけ休もう…。",
            "zh": "好像有点恶心……。\n稍微休息一下……。",
            "narrator_zh": "燕"
        },
        {
            "location": "68/TALK",
            "narrator": "つばめ",
            "text": "ふぅ…\nけほっ、ゲホゲホッ！",
            "zh": "呼……\n咳，咳咳！",
            "narrator_zh": "燕"
        },
        {
            "location": "69/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "84/TALK",
            "narrator": "つばめ",
            "text": "う、うぅん…。",
            "zh": "唔、嗯……。",
            "narrator_zh": "燕"
        },
        {
            "location": "85/TALK",
            "narrator": "つばめ",
            "text": "…あれ？\nここって…。",
            "zh": "……咦？\n这里是……。",
            "narrator_zh": "燕"
        },
        {
            "location": "87/TALK",
            "narrator": "真幌",
            "text": "ようやく目を覚ましたな。",
            "zh": "终于醒了啊。",
            "narrator_zh": "真幌"
        },
        {
            "location": "90/TALK",
            "narrator": "アーヤ",
            "text": "つばめ、大丈夫？",
            "zh": "燕，没事吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "92/TALK",
            "narrator": "つばめ",
            "text": "真幌さん…アーヤさんも？",
            "zh": "真幌……绫水也在？",
            "narrator_zh": "燕"
        },
        {
            "location": "93/TALK",
            "narrator": "つばめ",
            "text": "あれ……？\nわたし、楽屋にいた\nはずじゃ…。",
            "zh": "咦……？\n我应该在\n后台的……。",
            "narrator_zh": "燕"
        },
        {
            "location": "94/TALK",
            "narrator": "真幌",
            "text": "覚えていないのか？\n楽屋で眠ったまま、\n起きる気配がなくてな。",
            "zh": "不记得了吗？\n你在后台睡着，\n一点要醒的样子都没有。",
            "narrator_zh": "真幌"
        },
        {
            "location": "95/TALK",
            "narrator": "真幌",
            "text": "私とアーヤで、\n部屋まで運んだんだ。",
            "zh": "我和绫水\n把你送到房间的。",
            "narrator_zh": "真幌"
        },
        {
            "location": "96/TALK",
            "narrator": "つばめ",
            "text": "そうだったんですか…。",
            "zh": "是这样啊……。",
            "narrator_zh": "燕"
        },
        {
            "location": "98/TALK",
            "narrator": "アーヤ",
            "text": "もぅ、体調が悪いなら\n休まないとダメじゃない。",
            "zh": "真是的，身体不舒服\n就得休息。",
            "narrator_zh": "绫水"
        },
        {
            "location": "99/TALK",
            "narrator": "アーヤ",
            "text": "こんなに顔、真っ赤に\nしちゃって…。",
            "zh": "脸红成\n这样……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "100/TALK",
            "narrator": "つばめ",
            "text": "すみません…\nでも、休むと迷惑が…。",
            "zh": "对不起……\n可是休息的话会添麻烦……。",
            "narrator_zh": "燕"
        },
        {
            "location": "101/TALK",
            "narrator": "真幌",
            "text": "体調を悪くされる方が\n迷惑だ。",
            "zh": "把身体搞坏了\n才叫添麻烦。",
            "narrator_zh": "真幌"
        },
        {
            "location": "102/TALK",
            "narrator": "真幌",
            "text": "いいか、逢瀬。\n今後は今日みたいな\n無茶は絶対に禁止だ。",
            "zh": "听好了，逢濑。\n今后绝对禁止\n今天这种乱来。",
            "narrator_zh": "真幌"
        },
        {
            "location": "103/TALK",
            "narrator": "真幌",
            "text": "具合が悪い時は休み、\n少しでも早く回復する\nこと――",
            "zh": "不舒服就休息，\n尽量早点\n恢复——",
            "narrator_zh": "真幌"
        },
        {
            "location": "104/TALK",
            "narrator": "真幌",
            "text": "それも仕事の内だぞ？",
            "zh": "这也是工作的一部分。",
            "narrator_zh": "真幌"
        },
        {
            "location": "105/TALK",
            "narrator": "つばめ",
            "text": "…ごめんなさい。",
            "zh": "……对不起。",
            "narrator_zh": "燕"
        },
        {
            "location": "106/TALK",
            "narrator": "真幌",
            "text": "わかればそれでいい。\nアーヤ、あとは任せた。",
            "zh": "明白就好。\n绫水，剩下的交给你。",
            "narrator_zh": "真幌"
        },
        {
            "location": "109/TALK",
            "narrator": "アーヤ",
            "text": "じゃあ、おかゆでも\n作ってくるから、\n大人しく寝てるのよ？",
            "zh": "那我去做点粥，\n你老实\n躺着。",
            "narrator_zh": "绫水"
        },
        {
            "location": "114/TALK",
            "narrator": "つばめ",
            "text": "はぁ…\n余計迷惑かけちゃった。",
            "zh": "哈啊……\n反而添了更多麻烦。",
            "narrator_zh": "燕"
        },
        {
            "location": "115/TALK",
            "narrator": "つばめ",
            "text": "早く治して、\nちゃんと謝ろう…。",
            "zh": "快点好起来，\n好好道歉……。",
            "narrator_zh": "燕"
        },
        {
            "location": "116/ACT",
            "narrator": "",
            "text": "休んだ方が良い",
            "zh": "还是休息比较好",
            "narrator_zh": ""
        },
        {
            "location": "133/TALK",
            "narrator": "つばめ",
            "text": "そんなに具合悪く見えるかな？",
            "zh": "看起来有那么不舒服吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "145/TALK",
            "narrator": "つばめ",
            "text": "ちょっと動いてれば、\n気にならなくなりそう\nなんだけど",
            "zh": "动一动的话，\n好像就不会在意了\n可是",
            "narrator_zh": "燕"
        },
        {
            "location": "146/TALK",
            "narrator": "つばめ",
            "text": "…でも、\nちょっとだけ休んで、\nそれから動こうかな？",
            "zh": "……不过，\n稍微休息一下，\n然后再动吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "147/TALK",
            "narrator": "つばめ",
            "text": "けほっ、けほっ…\n何だか、気持ち悪い\nかも…。",
            "zh": "咳、咳……\n总觉得，好像\n有点恶心……。",
            "narrator_zh": "燕"
        },
        {
            "location": "149/TALK",
            "narrator": "つばめ",
            "text": "…やだなぁ。",
            "zh": "……讨厌呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "150/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "166/TALK",
            "narrator": "つばめ",
            "text": "う、うぅん…。",
