            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "139/TALK",
            "narrator": "ガブリエラ",
            "text": "早く勝負がしたいと思っているわ",
            "zh": "我是很想早点再比一场的哦",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "140/ACT",
            "narrator": "",
            "text": "次は実銃でやってみたいね",
            "zh": "下次想试试用真枪比呢",
