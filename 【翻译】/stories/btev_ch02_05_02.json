{
    "dir": "chap05/battle/btev_ch02_05_02.js",
    "type": "",
    "info": {
        "story_id": "22006",
        "cid": "",
        "title": "006 ココロスフィアストーリー【Lv02】",
        "sub_title": "ＪＫＡクーデター＜帰結＞",
        "title_zh": "006 心灵领域故事【Lv02】",
        "sub_title_zh": "JKA政变＜归结＞"
    },
    "entry": [
        {
            "location": "374/SCENARIO",
            "narrator": "",
            "text": "高校時代のクーデター",
            "zh": "高中时代的政变",
            "narrator_zh": ""
        },
        {
            "location": "384/TALK",
            "narrator": "高校生アーヤ",
            "text": "当然の結果ですね。",
            "zh": "这是理所当然的结果。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "385/TALK",
            "narrator": "潜在アーヤ",
            "text": "どうして\nこんなことを\nするわけ！？",
            "zh": "你为什么要\n做出这种事\n啊！？",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "386/TALK",
            "narrator": "高校生アーヤ",
            "text": "ドームの\nフェノメノン戦前――",
            "zh": "穹顶的\nPhenoMENON战之前——",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "387/TALK",
            "narrator": "潜在アーヤ",
            "text": "…？",
            "zh": "……？",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "389/TALK",
            "narrator": "高校生アーヤ",
            "text": "電車が止まって\n閉じこめられた時、\n私は体裁を気にした。",
            "zh": "电车停运、\n被困在车厢里的时候，\n我还在在意体面。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "390/TALK",
            "narrator": "高校生アーヤ",
            "text": "もう少し遅かったら\n逢瀬さんはもっと\n大変だったかも。",
            "zh": "要是再晚一点，\n逢濑说不定就会\n遇到更大麻烦了。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "392/TALK",
            "narrator": "潜在アーヤ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "393/TALK",
            "narrator": "高校生アーヤ",
            "text": "そして、劇場で\n皆に厳しく言うことを\n躊躇うのもまた然り。",
            "zh": "而且，在剧场里\n对大家严厉管教时\n犹豫不决，也是同理。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "394/TALK",
            "narrator": "高校生アーヤ",
            "text": "最近の私は\nたるみすぎです。",
            "zh": "最近的我\n实在太松懈了。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "395/TALK",
            "narrator": "高校生アーヤ",
            "text": "だからその根源である\n貴方を殲滅しに来た。",
            "zh": "所以我才来消灭\n身为那一切根源的你。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "397/TALK",
            "narrator": "高校生アーヤ",
            "text": "そして今、\nその使命は達成された\nというわけです。",
            "zh": "而现在，\n这项使命\n已经达成了。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "400/TALK",
            "narrator": "潜在アーヤ",
            "text": "……そうね。\n私はもう消えるもの。",
            "zh": "……是啊。\n反正我也要消失了。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "402/TALK",
            "narrator": "潜在アーヤ",
            "text": "けど、こんなやり方\n普通じゃない。",
            "zh": "不过，你这种做法\n也太不正常了。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "403/TALK",
            "narrator": "潜在アーヤ",
            "text": "これからもそうやって\n貴方のような一人格が\n私たちを殲滅したら――",
            "zh": "要是今后也像这样，\n任凭你这样的一重人格\n把我们接连消灭的话——",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "406/TALK",
            "narrator": "潜在アーヤ",
            "text": "私は全く物事の\nバランスの取れない\n酷い私になるわよ？",
            "zh": "我可是会变成一个\n完全失去平衡、\n糟糕透顶的自己哦？",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "407/TALK",
            "narrator": "高校生アーヤ",
            "text": "そこはしっかり\nバランスを取って\n調節するから。",
            "zh": "那方面我会好好\n把握平衡\n加以调节的。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "409/TALK",
            "narrator": "高校生アーヤ",
            "text": "貴方は心配しなくて\n大丈夫。",
            "zh": "你不用担心\n也没关系。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "411/TALK",
            "narrator": "潜在アーヤ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "413/TALK",
            "narrator": "潜在アーヤ",
            "text": "$handle$さん。\nこの子には絶対\n気を許さないでね。",
            "zh": "$handle$。\n对这孩子千万不要\n放松警惕哦。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "415/TALK",
            "narrator": "潜在アーヤ",
            "text": "確かに“私たち”は\n$handle$さんに\n心を預けている。",
            "zh": "确实“我们”是\n把心托付给了\n$handle$。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "416/TALK",
            "narrator": "潜在アーヤ",
            "text": "けど、他にも沢山いる\n綾水の人格たちが貴方を\n危険と感じたら――",
            "zh": "不过，如果其他为数众多的\n绫水人格觉得你\n很危险的话——",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "417/TALK",
            "narrator": "潜在アーヤ",
            "text": "その時から貴方は\n私の心に\n入れなくなるから。",
            "zh": "从那一刻起，你就\n再也进不到我的\n心里来了。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "428/TALK",
            "narrator": "高校生アーヤ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "439/TALK",
            "narrator": "高校生アーヤ",
            "text": "改めて、\nありがとうございます。\n助かったわ。",
            "zh": "再次向你道谢，\n非常感谢。\n多亏你帮了大忙。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "441/TALK",
            "narrator": "高校生アーヤ",
            "text": "それじゃ約束通り、\nえっと……",
            "zh": "那么照约定，\n那个……",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "442/TALK",
            "narrator": "高校生アーヤ",
            "text": "デート？\nしましょうか？",
            "zh": "我们去约会……\n好吗？",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "443/SEL",
            "narrator": "（選択肢）",
            "text": "やったー！",
            "zh": "太好了！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "444/SEL",
            "narrator": "（選択肢）",
            "text": "照れてる？",
            "zh": "你在害羞吗？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "445/ACT",
            "narrator": "",
            "text": "やったー！",
            "zh": "太好了！",
            "narrator_zh": ""
        },
        {
            "location": "446/ACT",
            "narrator": "",
            "text": "照れてる？",
            "zh": "你在害羞吗？",
            "narrator_zh": ""
        },
        {
            "location": "452/DIALOG",
            "narrator": "",
            "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！",
            "zh": "心情点数\n<size=40><color=red><b>300pt.</b></color></size>\n增加了！",
            "narrator_zh": ""
        },
        {
            "location": "456/TALK",
            "narrator": "高校生アーヤ",
            "text": "そんなわけ\nないでしょ！",
            "zh": "怎么可能\n会害羞！",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "457/TALK",
            "narrator": "高校生アーヤ",
            "text": "ちょっと呆れてるだけ。",
            "zh": "只是有点无语罢了。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "458/TALK",
            "narrator": "高校生アーヤ",
            "text": "貴方にとってデートが\nそんな価値がある\nものなんだ…って。",
            "zh": "没想到对你来说，\n约会居然是这么\n有价值的事……。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "459/SEL",
            "narrator": "（選択肢）",
            "text": "大ありです！",
            "zh": "非常有价值！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "460/SEL",
            "narrator": "（選択肢）",
            "text": "元々ロハだったわけだし価値が０．１でも十分元が取れてる",
            "zh": "本来就是免费的，就算价值只有0.1也完全回本了",
            "narrator_zh": "（选项）"
        },
        {
            "location": "461/ACT",
            "narrator": "",
            "text": "大ありです！",
            "zh": "非常有价值！",
            "narrator_zh": ""
        },
        {
            "location": "462/TALK",
            "narrator": "高校生アーヤ",
            "text": "ふーん。\n私にはちょっと\nわからないわ。",
            "zh": "哼嗯。\n我实在有点\n搞不懂。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "463/ACT",
            "narrator": "",
            "text": "元々ロハだったわけだし価値が０．１でも十分元が取れてる",
            "zh": "本来就是免费的，就算价值只有0.1也完全回本了",
            "narrator_zh": ""
        },
        {
            "location": "469/DIALOG",
            "narrator": "",
            "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！",
            "zh": "心情点数\n<size=40><color=red><b>300pt.</b></color></size>\n增加了！",
            "narrator_zh": ""
        },
        {
            "location": "473/TALK",
            "narrator": "高校生アーヤ",
            "text": "あ……。",
            "zh": "啊……。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "475/TALK",
            "narrator": "高校生アーヤ",
            "text": "そうね。\nちょっとだけ\n納得した。",
            "zh": "说得也是。\n稍微有点\n被说服了。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "478/TALK",
            "narrator": "高校生アーヤ",
            "text": "さて、それじゃ早速\nお待ちかねの\nデートだけど――",
            "zh": "好了，那就事不宜迟，\n你期待已久的\n约会——",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "479/TALK",
            "narrator": "高校生アーヤ",
            "text": "図書館でいい？",
            "zh": "去图书馆可以吗？",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "480/SEL",
            "narrator": "（選択肢）",
            "text": "もちろん！",
            "zh": "当然！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "481/SEL",
            "narrator": "（選択肢）",
            "text": "カフェで一緒に甘い物食べたい",
            "zh": "我想去咖啡馆一起吃甜点",
            "narrator_zh": "（选项）"
        },
        {
            "location": "482/ACT",
            "narrator": "",
            "text": "もちろん！",
            "zh": "当然！",
            "narrator_zh": ""
        },
        {
            "location": "483/TALK",
            "narrator": "高校生アーヤ",
            "text": "それじゃ早速\n行きましょう。",
            "zh": "那就事不宜迟，\n走吧。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "497/TALK",
            "narrator": "高校生アーヤ",
            "text": "それじゃ私は\n明日の予習を\nするから。",
            "zh": "那我就先做\n明天的预习\n了。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "499/TALK",
            "narrator": "高校生アーヤ",
            "text": "$handle$$yobi$は\nどうする？",
            "zh": "$handle$$yobi$打算\n做什么？",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "500/SEL",
            "narrator": "（選択肢）",
            "text": "アーヤと話をする",
            "zh": "和绫水聊天",
            "narrator_zh": "（选项）"
        },
        {
            "location": "501/SEL",
            "narrator": "（選択肢）",
            "text": "アーヤの顔をずっと見てる",
            "zh": "一直盯着绫水的脸看",
            "narrator_zh": "（选项）"
        },
        {
            "location": "502/ACT",
            "narrator": "",
            "text": "アーヤと話をする",
            "zh": "和绫水聊天",
            "narrator_zh": ""
        },
        {
            "location": "504/TALK",
            "narrator": "高校生アーヤ",
            "text": "ダメに\n決まってるでしょ。\nここ図書館よ？",
            "zh": "那当然\n不行吧。\n这里可是图书馆哦？",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "505/SEL",
            "narrator": "（選択肢）",
            "text": "耳元で愛を囁くように話すから",
            "zh": "我会在耳边像低诉爱语一样轻声说话的",
            "narrator_zh": "（选项）"
        },
        {
            "location": "506/ACT",
            "narrator": "",
            "text": "耳元で愛を囁くように話すから",
            "zh": "我会在耳边像低诉爱语一样轻声说话的",
            "narrator_zh": ""
        },
        {
            "location": "509/TALK",
            "narrator": "高校生アーヤ",
            "text": "ば、バカなこと\n言わないで！",
            "zh": "别、别说那种\n胡话！",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "510/SEL",
            "narrator": "高校生アーヤ",
            "text": "それくらいの話し声は普通に聞こえるけど？",
            "zh": "那种程度的说话声平时也能听到吧？",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "511/ACT",
            "narrator": "",
            "text": "それくらいの話し声は普通に聞こえるけど？",
            "zh": "那种程度的说话声平时也能听到吧？",
            "narrator_zh": ""
        },
        {
            "location": "513/TALK",
            "narrator": "高校生アーヤ",
            "text": "他の子は\n問題じゃない。",
            "zh": "别人怎么说\n不是问题。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "514/TALK",
            "narrator": "高校生アーヤ",
            "text": "私がそういうことを\nするのが問題なのよ！",
            "zh": "是我做这种事\n才成问题！",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "515/SEL",
            "narrator": "（選択肢）",
            "text": "なんで？",
            "zh": "为什么？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "516/ACT",
            "narrator": "",
            "text": "なんで？",
            "zh": "为什么？",
            "narrator_zh": ""
        },
        {
            "location": "518/TALK",
            "narrator": "高校生アーヤ",
            "text": "生徒会長だから！",
            "zh": "因为我是学生会长！",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "519/TALK",
            "narrator": "高校生アーヤ",
            "text": "生徒会長が……",
            "zh": "要是学生会长……",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "521/TALK",
            "narrator": "高校生アーヤ",
            "text": "その…",
            "zh": "那个……",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "522/TALK",
            "narrator": "高校生アーヤ",
            "text": "図書館で\n愛を囁いたり\nしてたら……っ…",
            "zh": "在图书馆里\n低诉什么爱语\n的话……唔……",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "523/TALK",
            "narrator": "高校生アーヤ",
            "text": "信頼ガタ落ちに\nなっちゃうでしょ！",
            "zh": "信赖度会一落千丈的\n吧！",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "524/SEL",
            "narrator": "（選択肢）",
            "text": "本当に愛を囁くとは言ってないけど？",
            "zh": "我也没说真要低诉爱语啊？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "525/ACT",
            "narrator": "",
            "text": "本当に愛を囁くとは言ってないけど？",
            "zh": "我也没说真要低诉爱语啊？",
            "narrator_zh": ""
        },
        {
            "location": "527/TALK",
            "narrator": "高校生アーヤ",
            "text": "…っ！？",
            "zh": "……唔！？",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "528/TALK",
            "narrator": "高校生アーヤ",
            "text": "うーるーさーいーっ！",
            "zh": "吵——死——了——！",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "529/TALK",
            "narrator": "高校生アーヤ",
            "text": "もういい。\n帰る！",
            "zh": "够了。\n我要回去了！",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "531/TALK",
            "narrator": "高校生アーヤ",
            "text": "こんなくだらない事で\n信頼失ったら\n立ち直れないわ。",
            "zh": "要是为了这种无聊事\n失去大家的信赖，\n我可振作不起来。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "532/TALK",
            "narrator": "高校生アーヤ",
            "text": "ついてこないでよね？",
            "zh": "不准跟过来哦？",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "533/ACT",
            "narrator": "",
            "text": "アーヤの顔をずっと見てる",
            "zh": "一直盯着绫水的脸看",
            "narrator_zh": ""
        },
        {
            "location": "539/DIALOG",
            "narrator": "",
            "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！",
            "zh": "心情点数\n<size=40><color=red><b>300pt.</b></color></size>\n增加了！",
            "narrator_zh": ""
        },
        {
            "location": "544/TALK",
            "narrator": "高校生アーヤ",
            "text": "は……",
            "zh": "哈……",
