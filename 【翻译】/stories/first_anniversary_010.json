            "narrator_zh": ""
        },
        {
            "location": "170/TALK",
            "narrator": "つばめ",
            "text": "そっか",
            "zh": "这样呀",
            "narrator_zh": "燕"
        },
        {
            "location": "172/TALK",
            "narrator": "つばめ",
            "text": "でもぁたしも",
