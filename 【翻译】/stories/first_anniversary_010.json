            "text": "ぅんヽ(〃´∀`〃)ﾉ",
            "zh": "嗯ヽ(〃´∀`〃)ﾉ",
            "narrator_zh": "燕"
        },
        {
            "location": "176/TALK",
            "narrator": "つばめ",
            "text": "みんな一緒だし",
            "zh": "大家也在一起嘛",
            "narrator_zh": "燕"
        },
        {
            "location": "178/SEL",
            "narrator": "（選択肢）",
