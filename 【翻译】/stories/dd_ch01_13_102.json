{
    "dir": "chap13/daydra/dd_ch01_13_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "13105",
        "cid": "tsubame",
        "title": "005 メインストーリー",
        "sub_title": "魔法少女道＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "魔法少女道＜后篇＞"
    },
    "entry": [
        {
            "location": "653/SCENARIO",
            "narrator": "",
            "text": "魔法少女道",
            "zh": "魔法少女道",
            "narrator_zh": ""
        },
        {
            "location": "674/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "675/TALK",
            "narrator": "つばめ",
            "text": "輝き流れる、\n永遠のミード…\nだっけ？",
            "zh": "闪耀流淌、\n永恒的蜜酒……\n是这句来着？",
            "narrator_zh": "燕"
        },
        {
            "location": "677/TALK",
            "narrator": "神楽",
            "text": "はい。\nミルクティーの\n決め台詞ですね。",
            "zh": "对。\n是奶茶的\n定场台词。",
            "narrator_zh": "神乐"
        },
        {
            "location": "679/TALK",
            "narrator": "つばめ",
            "text": "うーん…。",
            "zh": "嗯……。",
            "narrator_zh": "燕"
        },
        {
            "location": "680/TALK",
            "narrator": "つばめ",
            "text": "わたし、メルティ\nやってもいいかな？",
            "zh": "我来当融化，\n可以吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "681/TALK",
            "narrator": "神楽",
            "text": "え――",
            "zh": "诶——",
            "narrator_zh": "神乐"
        },
        {
            "location": "684/TALK",
            "narrator": "神楽",
            "text": "えぇっ！？\nほ、本当ですか！？",
            "zh": "诶诶！？\n真、真的吗！？",
            "narrator_zh": "神乐"
        },
        {
            "location": "687/TALK",
            "narrator": "つばめ",
            "text": "うん。",
            "zh": "嗯。",
            "narrator_zh": "燕"
        },
        {
            "location": "688/TALK",
            "narrator": "つばめ",
            "text": "アーヤさん達も、\nあんまりやりたくない\nみたいだし。",
            "zh": "绫水她们，\n好像也\n不太想当。",
            "narrator_zh": "燕"
        },
        {
            "location": "689/TALK",
            "narrator": "つばめ",
            "text": "それなら、わたしと\n卯月さんでやれば\nいいんじゃないかな？",
            "zh": "那我跟\n卯月来当，\n不就好了吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "690/TALK",
            "narrator": "神楽",
            "text": "で、でも、\n本当にいいんですか？",
            "zh": "可、可是，\n真的可以吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "691/TALK",
            "narrator": "神楽",
            "text": "皆さんは恥ずかしくて\n嫌がってるのに…。",
            "zh": "大家觉得害羞，\n都不愿意……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "694/TALK",
            "narrator": "つばめ",
            "text": "そ、それはまあ、\n恥ずかしいことは\n恥ずかしいけど……。",
            "zh": "那、那个嘛，\n害羞是\n害羞……。",
            "narrator_zh": "燕"
        },
        {
            "location": "695/TALK",
            "narrator": "つばめ",
            "text": "誰かがやらないと\nいけないことでしょ？",
            "zh": "总得有人\n来做吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "697/TALK",
            "narrator": "つばめ",
            "text": "それに、卯月さんと\n一緒なら平気だと思うし。",
            "zh": "而且，跟卯月一起的话，\n我觉得没关系。",
            "narrator_zh": "燕"
        },
        {
            "location": "698/TALK",
            "narrator": "神楽",
            "text": "つばめさん…。",
            "zh": "燕……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "700/TALK",
            "narrator": "神楽",
            "text": "…なら、到着するまで\n特訓しましょう。",
            "zh": "……那在到之前，\n我们特训吧。",
            "narrator_zh": "神乐"
        },
        {
            "location": "702/TALK",
            "narrator": "つばめ",
            "text": "え、特訓？",
            "zh": "诶，特训？",
            "narrator_zh": "燕"
        },
        {
            "location": "703/TALK",
            "narrator": "神楽",
            "text": "メルティのポーズは\n意外と難しいんですよ？",
            "zh": "融化的姿势\n其实意外地难哦？",
            "narrator_zh": "神乐"
        },
        {
            "location": "704/TALK",
            "narrator": "神楽",
            "text": "車の中なので動きには\n限界がありますけど、\nできる限り指導します！",
            "zh": "在车里，动作\n有限，\n我会尽量教！",
            "narrator_zh": "神乐"
        },
        {
            "location": "705/TALK",
            "narrator": "つばめ",
            "text": "せ、セリフだけで\nいいんじゃ…。",
            "zh": "只、只说台词\n不就行了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "706/TALK",
            "narrator": "神楽",
            "text": "そんなのダメです！",
            "zh": "那样不行！",
            "narrator_zh": "神乐"
        },
        {
            "location": "707/TALK",
            "narrator": "神楽",
            "text": "せっかくつばめさんと\nメルティをやれる\n機会なんですから――",
            "zh": "难得能和燕\n一起当融化，\n这个机会——",
            "narrator_zh": "神乐"
        },
        {
            "location": "708/TALK",
            "narrator": "神楽",
            "text": "完璧で可愛い\nつばめさんを\n見たいんです！",
            "zh": "我想看到\n完美又可爱的\n燕！",
            "narrator_zh": "神乐"
        },
        {
            "location": "710/TALK",
            "narrator": "神楽",
            "text": "さあ、まずは\n上半身の動きから\n説明しますね！",
            "zh": "来，先从\n上半身的动作\n开始讲！",
            "narrator_zh": "神乐"
        },
        {
            "location": "712/TALK",
            "narrator": "つばめ",
            "text": "えぇーっ！？",
            "zh": "诶诶诶！？",
            "narrator_zh": "燕"
        },
        {
            "location": "719/TALK",
            "narrator": "つばめ",
            "text": "はぁ、はぁ…。\nど、どうかな？",
            "zh": "哈啊，哈啊……。\n怎、怎么样？",
            "narrator_zh": "燕"
        },
        {
            "location": "721/TALK",
            "narrator": "神楽",
            "text": "そう、そうです！\nそのポーズです！",
            "zh": "对，就是这样！\n就是这个姿势！",
            "narrator_zh": "神乐"
        },
        {
            "location": "722/TALK",
            "narrator": "神楽",
            "text": "かっこよさと可愛さが\n見事に合わさったその\nポーズこそがミルクです！",
            "zh": "帅气和可爱\n刚好叠在一起，\n这个姿势才是奶茶！",
            "narrator_zh": "神乐"
        },
        {
            "location": "724/TALK",
            "narrator": "つばめ",
            "text": "…メルティになるの\nって、大変なんだね。",
            "zh": "……要变成融化，\n还挺不容易的。",
            "narrator_zh": "燕"
        },
        {
            "location": "726/TALK",
            "narrator": "神楽",
            "text": "本当によかったです。\n到着までに完璧に\n仕上げられて。",
            "zh": "真是太好了。\n在到之前\n练到完美了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "731/TALK",
            "narrator": "神楽",
            "text": "さあ、つばめさん。\n急ぎましょう。",
            "zh": "来，燕。\n我们快点。",
            "narrator_zh": "神乐"
        },
        {
            "location": "732/TALK",
            "narrator": "神楽",
            "text": "アーヤさん達に\n先を越されちゃい\nますよ！",
            "zh": "要被绫水她们\n抢先\n了呀！",
            "narrator_zh": "神乐"
        },
        {
            "location": "735/TALK",
            "narrator": "つばめ",
            "text": "あ、待ってよ\n卯月さーん！",
            "zh": "啊，等一下\n卯月——！",
            "narrator_zh": "燕"
        },
        {
            "location": "746/DIALOG",
            "narrator": "Dialog_chapter_ch01",
            "text": "【MV EXE_AYAMi】",
            "zh": "【MV EXE_AYAMi】",
            "narrator_zh": "Dialog_chapter_ch01"
        }
    ]
}
