{
    "dir": "chap05/daydra/dd_ch02_05_030.js",
    "type": "MainStory",
    "info": {
        "story_id": "5258",
        "cid": "ayami",
        "title": "Extra008 プレミアムストーリー",
        "sub_title": "捨て猫",
        "title_zh": "Extra008 额外剧情",
        "sub_title_zh": "弃猫"
    },
    "entry": [
        {
            "location": "525/SCENARIO",
            "narrator": "",
            "text": "捨て猫",
            "zh": "弃猫",
            "narrator_zh": ""
        },
        {
            "location": "554/TALK",
            "narrator": "ガブリエラ",
            "text": "大変、大変よ！",
            "zh": "不得了，不得了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "558/TALK",
            "narrator": "アーヤ",
            "text": "どうしたの？\nそんなに慌てて…。",
            "zh": "怎么了？\n这么慌……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "560/TALK",
            "narrator": "ガブリエラ",
            "text": "猫、猫が…！",
            "zh": "猫，猫……！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "562/TALK",
            "narrator": "ガブリエラ",
            "text": "劇場の前に子猫が\n捨てられてたの！",
            "zh": "剧场门口有只小猫\n被扔掉了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "564/TALK",
            "narrator": "アーヤ",
            "text": "えぇっ！？",
            "zh": "诶诶！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "565/TALK",
            "narrator": "真幌",
            "text": "本当か！？",
            "zh": "真的！？",
            "narrator_zh": "真幌"
        },
        {
            "location": "566/TALK",
            "narrator": "真幌",
            "text": "まったく、\nよりにもよって\n何故うちの劇場に…。",
            "zh": "真是的，\n偏偏\n扔到我们剧场……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "569/TALK",
            "narrator": "アーヤ",
            "text": "映画館なら、人の目に\n付きやすいと思ったから\nじゃないですか？",
            "zh": "要是电影院的话，\n觉得比较容易被人看见，\n是不是？",
            "narrator_zh": "绫水"
        },
        {
            "location": "572/TALK",
            "narrator": "真幌",
            "text": "だとしたら捨てる劇場を\n間違えているだろ。",
            "zh": "那也是\n扔错剧场了吧。",
            "narrator_zh": "真幌"
        },
        {
            "location": "573/TALK",
            "narrator": "真幌",
            "text": "うちみたいな寂れた所\nではなく、もっと大きな\nところに捨てるべきだ。",
            "zh": "不该扔到我们这种冷清的地方，\n该扔到更大的\n地方去。",
            "narrator_zh": "真幌"
        },
        {
            "location": "574/TALK",
            "narrator": "アーヤ",
            "text": "…悲しくなるようなこと\n言わないでください。",
            "zh": "……别说这种\n让人难过的话。",
            "narrator_zh": "绫水"
        },
        {
            "location": "577/TALK",
            "narrator": "ガブリエラ",
            "text": "ねえ、まほ。\nうちで飼おうよ。",
            "zh": "喂，真幌。\n我们养吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "578/TALK",
            "narrator": "ガブリエラ",
            "text": "看板猫ってことにすれば\nきっと猫目当てで来る\n人も増えると思うし…。",
            "zh": "要是当成招牌猫，\n说不定冲着猫来的人\n也会变多……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "581/TALK",
            "narrator": "真幌",
            "text": "猫一匹で客が増える\nほど劇場運営は\nラクなものじゃない。",
            "zh": "靠一只猫就能增加客人，\n剧场经营\n哪有那么轻松。",
            "narrator_zh": "真幌"
        },
        {
            "location": "582/TALK",
            "narrator": "真幌",
            "text": "元いたところに\n戻して来い！",
            "zh": "送回\n原来的地方！",
            "narrator_zh": "真幌"
        },
        {
            "location": "585/TALK",
            "narrator": "ガブリエラ",
            "text": "それってここだけど、\n飼っていいの？",
            "zh": "原来的地方就是这儿，\n那可以养吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "587/TALK",
            "narrator": "真幌",
            "text": "くそっ、ややこしいな！",
            "zh": "可恶，真麻烦！",
            "narrator_zh": "真幌"
        },
        {
            "location": "591/TALK",
            "narrator": "アーヤ",
            "text": "…どうしよう？",
            "zh": "……怎么办？",
            "narrator_zh": "绫水"
        },
        {
            "location": "603/TALK",
            "narrator": "アーヤ",
            "text": "大変なことになっちゃった",
            "zh": "变成大麻烦了",
            "narrator_zh": "绫水"
        },
        {
            "location": "604/TALK",
            "narrator": "アーヤ",
            "text": "劇場の前に猫が捨てられてたんだけど",
            "zh": "剧场门口有人扔了只猫",
            "narrator_zh": "绫水"
        },
        {
            "location": "605/TALK",
            "narrator": "アーヤ",
            "text": "うちじゃ飼えないし…",
            "zh": "我们这儿养不了……",
            "narrator_zh": "绫水"
        },
        {
            "location": "606/TALK",
            "narrator": "アーヤ",
            "text": "でも、",
            "zh": "可是，",
            "narrator_zh": "绫水"
        },
        {
            "location": "607/TALK",
            "narrator": "アーヤ",
            "text": "保健所なんて選択肢は絶対になし！！(｀Д´)",
            "zh": "收容所这种选项绝对不要！！(｀Д´)",
            "narrator_zh": "绫水"
        },
        {
            "location": "608/TALK",
            "narrator": "アーヤ",
            "text": "ワガママ言ってるのはわかってるけど",
            "zh": "我知道这是在任性",
            "narrator_zh": "绫水"
        },
        {
            "location": "609/TALK",
            "narrator": "アーヤ",
            "text": "どうしよう…(-ω-;)",
            "zh": "怎么办……(-ω-;)",
            "narrator_zh": "绫水"
        },
        {
            "location": "611/SEL",
            "narrator": "",
            "text": "保護団体に連絡しよう",
            "zh": "联系保护团体吧",
            "narrator_zh": ""
        },
        {
            "location": "612/SEL",
            "narrator": "",
            "text": "友達に飼えるか聞こう",
            "zh": "问问朋友能不能养",
            "narrator_zh": ""
        },
        {
            "location": "613/SEL",
            "narrator": "",
            "text": "劇場で飼おう！！",
            "zh": "在剧场养！！",
            "narrator_zh": ""
        },
        {
            "location": "614/ACT",
            "narrator": "",
            "text": "保護団体に連絡しよう",
            "zh": "联系保护团体吧",
            "narrator_zh": ""
        },
        {
            "location": "624/TALK",
            "narrator": "アーヤ",
            "text": "それって里親を見つけてくれる団体のことよね？",
            "zh": "就是帮着找领养人的团体吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "625/TALK",
            "narrator": "アーヤ",
            "text": "そういうところなら、一つだけ心当たりがあるの(ﾟｰﾟ)",
            "zh": "那样的地方，我正好知道一个(ﾟｰﾟ)",
            "narrator_zh": "绫水"
        },
        {
            "location": "638/TALK",
            "narrator": "真幌",
            "text": "とにかくうちはダメだ！\n劇場でなど\n飼えるわけがない！",
            "zh": "总之我们这儿不行！\n剧场里\n怎么可能养！",
            "narrator_zh": "真幌"
        },
        {
            "location": "639/TALK",
            "narrator": "ガブリエラ",
            "text": "迷惑掛けないように\nするってば！",
            "zh": "我会尽量\n不添麻烦的！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "643/TALK",
            "narrator": "アーヤ",
            "text": "あ、あの！",
            "zh": "那、那个！",
            "narrator_zh": "绫水"
        },
        {
            "location": "644/TALK",
            "narrator": "アーヤ",
            "text": "動物の里親を見つけて\nくれる団体を知ってる\nので――",
            "zh": "我认识一个\n帮动物找领养人的\n团体——",
            "narrator_zh": "绫水"
        },
        {
            "location": "645/TALK",
            "narrator": "アーヤ",
            "text": "そこに引き取りに来て\nもらう、っていうのは\nどうですか？",
            "zh": "请他们过来\n接走，\n怎么样？",
            "narrator_zh": "绫水"
        },
        {
            "location": "649/TALK",
            "narrator": "ガブリエラ",
            "text": "えっ！？",
            "zh": "诶！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "652/TALK",
            "narrator": "真幌",
            "text": "そんな団体があるのか？",
            "zh": "还有这种团体？",
            "narrator_zh": "真幌"
        },
        {
            "location": "653/TALK",
            "narrator": "アーヤ",
            "text": "はい。保健所と違って、\nちゃんと里親を見つけて\nくれるところなんです。",
            "zh": "有。和收容所不一样，\n会好好找领养人的\n地方。",
            "narrator_zh": "绫水"
        },
        {
            "location": "655/TALK",
            "narrator": "アーヤ",
            "text": "詳しく説明すると、\nまず――。",
            "zh": "详细说来，\n首先——。",
            "narrator_zh": "绫水"
        },
        {
            "location": "658/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "664/TALK",
            "narrator": "ガブリエラ",
            "text": "マルザンナ、どうしよう…",
            "zh": "玛尔赞娜，怎么办……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "665/TALK",
            "narrator": "ガブリエラ",
            "text": "劇場前に捨てられてた猫、うちで飼いたいのに",
            "zh": "剧场门口被扔掉的猫，我想在家里养",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "666/TALK",
            "narrator": "ガブリエラ",
            "text": "このままじゃ里親に出されてしまいそうなの",
            "zh": "这样下去好像要被送去领养了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "668/SEL",
            "narrator": "",
            "text": "その方が猫は幸せだよ",
            "zh": "那样猫更幸福",
            "narrator_zh": ""
        },
        {
            "location": "669/SEL",
            "narrator": "",
            "text": "絶対飼うと言い続けろ",
            "zh": "就坚持说绝对要养",
            "narrator_zh": ""
        },
        {
            "location": "670/ACT",
            "narrator": "",
            "text": "その方が猫は幸せだよ",
            "zh": "那样猫更幸福",
            "narrator_zh": ""
        },
        {
            "location": "671/TALK",
            "narrator": "ガブリエラ",
            "text": "酷い！",
            "zh": "太过分了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "672/TALK",
            "narrator": "ガブリエラ",
            "text": "マルザンナは私の味方してくれると思ったのに！",
            "zh": "我还以为玛尔赞娜会站在我这边！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "683/TALK",
            "narrator": "アーヤ",
            "text": "…という団体なんです。\nそこで犬を迎えた友達も\nいるんです。",
            "zh": "……就是这样的团体。\n我有朋友在那里\n领养过狗。",
            "narrator_zh": "绫水"
        },
        {
            "location": "685/TALK",
            "narrator": "真幌",
            "text": "なるほどな。よし、\nすぐに連絡しよう。",
            "zh": "原来如此。好，\n马上联系。",
            "narrator_zh": "真幌"
        },
        {
            "location": "687/TALK",
            "narrator": "アーヤ",
            "text": "わかりました。\nギャヴィも、それなら\n文句ないでしょ？",
            "zh": "知道了。\n加维，这样\n就没意见了吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "692/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "693/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィ？",
            "zh": "加维？",
            "narrator_zh": "绫水"
        },
        {
            "location": "695/TALK",
            "narrator": "ガブリエラ",
            "text": "そ、そこに行けば…\n絶対幸せになれる？",
            "zh": "去、去了那里……\n绝对会幸福吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "696/TALK",
            "narrator": "アーヤ",
            "text": "…子猫なら引き取り手も\nすぐ見つかるし、\n可能性は高いと思うわ。",
            "zh": "……小猫的话，领养的人\n也很快能找到，\n可能性很高。",
            "narrator_zh": "绫水"
        },
        {
            "location": "698/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "702/TALK",
            "narrator": "ガブリエラ",
            "text": "わかったわよ。\n飼えないのは\n残念だけど――",
            "zh": "知道了。\n不能养是\n很遗憾——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "705/TALK",
            "narrator": "ガブリエラ",
            "text": "猫が幸せになって\nくれるなら、諦めるわ。",
            "zh": "猫要是能幸福，\n我就放弃。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "707/TALK",
            "narrator": "アーヤ",
            "text": "じゃあ、\n早速連絡しますね。",
            "zh": "那，\n我马上联系。",
            "narrator_zh": "绫水"
        },
        {
            "location": "711/TALK",
            "narrator": "ガブリエラ",
            "text": "…飼いたかったなぁ。",
            "zh": "……好想养啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "714/TALK",
            "narrator": "アーヤ",
            "text": "…気持ちは\nわからなくも\nないけどね。",
            "zh": "……这种心情\n也不是\n不能理解。",
            "narrator_zh": "绫水"
        },
        {
            "location": "715/ACT",
            "narrator": "",
            "text": "絶対飼うと言い続けろ",
            "zh": "就坚持说绝对要养",
            "narrator_zh": ""
        },
        {
            "location": "716/TALK",
            "narrator": "ガブリエラ",
            "text": "さすがはマルザンナ",
            "zh": "不愧是玛尔赞娜",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "717/TALK",
            "narrator": "ガブリエラ",
            "text": "気持ちはいつも一緒ね！",
            "zh": "心意总是在一起！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "728/TALK",
            "narrator": "アーヤ",
            "text": "…という団体なんです。\nそこで犬を迎えた友達も\nいるんです。",
            "zh": "……就是这样的团体。\n我有朋友在那里\n领养过狗。",
            "narrator_zh": "绫水"
        },
        {
            "location": "730/TALK",
            "narrator": "真幌",
            "text": "なるほどな。\nよし、すぐに連絡しよう。",
            "zh": "原来如此。\n好，马上联系。",
            "narrator_zh": "真幌"
        },
        {
            "location": "732/TALK",
            "narrator": "アーヤ",
            "text": "わかりました。\nギャヴィも、それなら\n文句ないでしょ？",
            "zh": "知道了。\n加维，这样\n就没意见了吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "737/TALK",
            "narrator": "ガブリエラ",
            "text": "ある！",
            "zh": "有！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "738/TALK",
            "narrator": "ガブリエラ",
            "text": "そこから、どんな人に\n引き取られるかは\nわからないでしょ？",
            "zh": "从那里被什么样的人\n领走，\n谁也不知道吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "739/TALK",
            "narrator": "ガブリエラ",
            "text": "そんな危ないこと\nさせられないわ。",
            "zh": "这么危险的事\n我不能让它碰上。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "741/TALK",
            "narrator": "アーヤ",
            "text": "引き取るための条件が\nちゃんとあるから、\nその心配はないって。",
            "zh": "领养是有条件的，\n所以这个\n不用担心。",
            "narrator_zh": "绫水"
        },
        {
            "location": "743/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、相手がウソをつく\nこともあるんだから、\n絶対じゃないでしょ？",
            "zh": "可是对方也会说谎，\n所以不是\n绝对的吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "745/TALK",
            "narrator": "ガブリエラ",
            "text": "だから絶対に反対よ。",
            "zh": "所以我绝对反对。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "746/TALK",
            "narrator": "アーヤ",
            "text": "まったく、子供じゃ\nないんだから…。",
            "zh": "真是的，又不是\n小孩子……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "750/TALK",
            "narrator": "真幌",
            "text": "…つまり。",
            "zh": "……就是说。",
            "narrator_zh": "真幌"
        },
        {
            "location": "751/TALK",
            "narrator": "真幌",
            "text": "猫を引き取る相手を、\n信頼できる確かな\n証拠があれば――",
            "zh": "如果有可靠的证据，\n证明领养的人\n值得信任——",
            "narrator_zh": "真幌"
        },
        {
            "location": "752/TALK",
            "narrator": "真幌",
            "text": "そのときは\n諦めるんだな？",
            "zh": "那时候\n你就放弃？",
            "narrator_zh": "真幌"
        },
        {
            "location": "754/TALK",
            "narrator": "ガブリエラ",
            "text": "ええ、そんな相手が\nいるなら諦めるわ。",
            "zh": "嗯，要是有这样的人，\n我就放弃。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "755/TALK",
            "narrator": "真幌",
            "text": "なら、情報管理庁に\n一人アテがある。\n連絡してみよう。",
            "zh": "那，情报管理厅里\n我有个人选。\n联系看看。",
            "narrator_zh": "真幌"
        },
        {
            "location": "756/TALK",
            "narrator": "ガブリエラ",
            "text": "えっ…。",
            "zh": "诶……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "757/TALK",
            "narrator": "真幌",
            "text": "情報管理庁の\n官僚だから身分も\nしっかりしている。",
            "zh": "是情报管理厅的\n官员，身份也\n很清楚。",
            "narrator_zh": "真幌"
        },
        {
            "location": "758/TALK",
            "narrator": "真幌",
            "text": "それに、少し前に\n飼い猫を亡くした\nばかりで――",
            "zh": "而且，前不久\n刚失去了\n养的猫——",
            "narrator_zh": "真幌"
        },
        {
            "location": "759/TALK",
            "narrator": "真幌",
            "text": "新しい家族を迎えたいと\nぼやいていたからな。",
            "zh": "一直念叨着想\n迎接新的家人。",
            "narrator_zh": "真幌"
        },
        {
            "location": "760/TALK",
            "narrator": "真幌",
            "text": "連絡すれば、間違いなく\n引き取ってもらえる\nはずだ。",
            "zh": "一联系，肯定\n会有人\n接走的。",
            "narrator_zh": "真幌"
        },
        {
            "location": "763/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "764/TALK",
            "narrator": "真幌",
            "text": "文句はないな？",
            "zh": "没意见了吧？",
            "narrator_zh": "真幌"
        },
        {
            "location": "765/TALK",
            "narrator": "ガブリエラ",
            "text": "情報管理庁の官僚…。",
            "zh": "情报管理厅的官员……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "767/TALK",
            "narrator": "ガブリエラ",
            "text": "そんな人に\n飼われるなら、\n文句は言えないわ。",
            "zh": "交给那种人\n养的话，\n我就没话说了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "769/TALK",
            "narrator": "アーヤ",
            "text": "…そうね。私達が飼う\nよりも、ずっと幸せに\nしてくれそうだし。",
            "zh": "……是啊。比起我们养，\n更能让它\n幸福。",
            "narrator_zh": "绫水"
        },
        {
            "location": "770/TALK",
            "narrator": "真幌",
            "text": "確実にな。\nじゃあ、早速連絡しよう。",
            "zh": "确实。\n那就马上联系。",
            "narrator_zh": "真幌"
        },
        {
            "location": "774/TALK",
            "narrator": "アーヤ",
            "text": "…うちで飼えてたら、\n絶対毎日楽しかった\nだろうなぁ…。",
            "zh": "……要是能在我们这儿养，\n每天一定都很开心\n吧……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "777/ACT",
            "narrator": "",
            "text": "友達に飼えるか聞こう",
            "zh": "问问朋友能不能养",
            "narrator_zh": ""
        },
        {
            "location": "778/TALK",
            "narrator": "アーヤ",
            "text": "そうね",
            "zh": "说得对",
            "narrator_zh": "绫水"
        },
        {
            "location": "779/TALK",
            "narrator": "アーヤ",
            "text": "何人かにＷＡＶＥを送ってみるわ",
            "zh": "我给几个人发WAVE看看",
            "narrator_zh": "绫水"
        },
        {
            "location": "783/TALK",
            "narrator": "アーヤ",
            "text": "えっと、大学関係者の\nアドレスは、っと…。",
            "zh": "那个，大学相关的\n地址，嗯……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "785/TALK",
            "narrator": "真幌",
            "text": "ギャヴィ、ワガママは\nいい加減にしろ。",
            "zh": "加维，任性\n也该适可而止。",
            "narrator_zh": "真幌"
        },
        {
            "location": "786/TALK",
            "narrator": "真幌",
            "text": "うちの劇場で飼うなんて\n絶対に許さんぞ。",
            "zh": "在我们剧场养，\n绝对不许。",
            "narrator_zh": "真幌"
        },
        {
            "location": "788/TALK",
            "narrator": "ガブリエラ",
            "text": "いいじゃない！\n猫の一匹や二匹くらい。",
            "zh": "有什么不好！\n一只两只猫而已。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "789/TALK",
            "narrator": "真幌",
            "text": "世話はどうする？\nおまえ一人で出来るのか？",
            "zh": "谁来照顾？\n你一个人做得来吗？",
            "narrator_zh": "真幌"
        },
        {
            "location": "790/TALK",
            "narrator": "真幌",
            "text": "エサ代や病院代、\nトイレの砂、他にも\nまだまだ必要だぞ？",
            "zh": "猫粮、看病的钱、\n猫砂，还有\n好多要花钱？",
            "narrator_zh": "真幌"
        },
        {
            "location": "792/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしのお給料から\n出すわよ。それくらい\n安いものだし。",
            "zh": "从我工资里\n出。这点\n又不贵。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "793/TALK",
            "narrator": "真幌",
            "text": "…まったく！\n金持ったガキってのは\n面倒だな！",
            "zh": "……真是的！\n有钱的小孩\n真麻烦！",
            "narrator_zh": "真幌"
        },
        {
            "location": "798/TALK",
            "narrator": "アーヤ",
            "text": "二人とも、\nそろそろケンカは\nやめてください。",
            "zh": "你们两个，\n架也吵得\n差不多了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "799/TALK",
            "narrator": "アーヤ",
            "text": "今、猫を飼いたいって\n友達が見つかったので。",
            "zh": "刚才找到朋友，\n说想养猫。",
            "narrator_zh": "绫水"
        },
        {
            "location": "801/TALK",
            "narrator": "ガブリエラ",
            "text": "えっ！？",
            "zh": "诶！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "803/TALK",
            "narrator": "真幌",
            "text": "さすがだな。\n驚くほど迅速な対応だ。",
            "zh": "不愧是你。\n应对快得惊人。",
            "narrator_zh": "真幌"
        },
        {
            "location": "804/TALK",
            "narrator": "ガブリエラ",
            "text": "だ、誰なのそれ！？\n変なヤツじゃない\nでしょうね！",
            "zh": "是、是谁！？\n不是奇怪的人\n吧！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "806/TALK",
            "narrator": "アーヤ",
            "text": "大学の友達よ。",
            "zh": "大学的朋友。",
            "narrator_zh": "绫水"
        },
        {
            "location": "807/TALK",
            "narrator": "アーヤ",
            "text": "ちょうど、猫を\n飼いたいって家族と\n話していたんですって。",
            "zh": "正好家里有人\n说想养猫，\n他们在商量。",
            "narrator_zh": "绫水"
        },
        {
            "location": "808/TALK",
            "narrator": "真幌",
            "text": "良いタイミングだな。\nよし、その友人宅に\n引き取ってもらおう。",
            "zh": "时机正好。\n好，就让那位朋友\n接走吧。",
            "narrator_zh": "真幌"
        },
        {
            "location": "810/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィも、それでいい？",
            "zh": "加维，这样可以吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "815/TALK",
            "narrator": "ガブリエラ",
            "text": "…その人って、\n動物のこと\n好きな人？",
            "zh": "……那个人，\n喜欢动物\n吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "816/TALK",
            "narrator": "アーヤ",
            "text": "ええ、とってもね。",
            "zh": "嗯，非常喜欢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "817/TALK",
            "narrator": "アーヤ",
            "text": "猫を飼うのも初めてじゃ\nないっていうから――",
            "zh": "养猫也不是\n第一次——",
            "narrator_zh": "绫水"
        },
        {
            "location": "818/TALK",
            "narrator": "アーヤ",
            "text": "きっと、幸せに育てて\nくれるはずよ。",
            "zh": "一定会幸福地\n养大的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "823/TALK",
            "narrator": "ガブリエラ",
            "text": "そっか…それなら、\nあたしも賛成よ。",
            "zh": "这样啊……那，\n我也赞成。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "824/TALK",
            "narrator": "ガブリエラ",
            "text": "そんな人達に飼って\nもらえるなら安心ね。",
            "zh": "交给那样的人，\n就放心了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "826/TALK",
            "narrator": "アーヤ",
            "text": "じゃあ、決まりね。\n早速連絡しておくわ。",
            "zh": "那就定了。\n我马上联系。",
            "narrator_zh": "绫水"
        },
        {
            "location": "827/ACT",
            "narrator": "",
            "text": "劇場で飼おう！！",
            "zh": "在剧场养！！",
            "narrator_zh": ""
        },
        {
            "location": "838/TALK",
            "narrator": "アーヤ",
            "text": "そりゃ、私だって出来れば飼いたいけど…",
            "zh": "那当然，能养的话我也想养……",
            "narrator_zh": "绫水"
        },
        {
            "location": "839/TALK",
            "narrator": "アーヤ",
            "text": "…本音言ったら、我慢できなくなってきちゃったじゃない！(＞0＜)",
            "zh": "……把真心话说出来，我就忍不住了！(＞0＜)",
            "narrator_zh": "绫水"
        },
        {
            "location": "840/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィだけじゃなくて、私も飼いたいって言えば",
            "zh": "不只是加维，要是我也说想养",
            "narrator_zh": "绫水"
        },
        {
            "location": "841/TALK",
            "narrator": "アーヤ",
            "text": "館長も考え直してくれるかも",
            "zh": "馆长也许会重新考虑",
            "narrator_zh": "绫水"
        },
        {
            "location": "853/TALK",
            "narrator": "真幌",
            "text": "ギャヴィ、ワガママは\nいい加減にしろ。",
            "zh": "加维，任性\n也该适可而止。",
            "narrator_zh": "真幌"
        },
        {
            "location": "854/TALK",
            "narrator": "真幌",
            "text": "うちの劇場で飼うなんて\n絶対に許さんぞ。",
            "zh": "在我们剧场养，\n绝对不许。",
            "narrator_zh": "真幌"
        },
        {
            "location": "857/TALK",
            "narrator": "ガブリエラ",
            "text": "いいじゃない！\n猫の一匹や二匹くらい。",
            "zh": "有什么不好！\n一只两只猫而已。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "858/TALK",
            "narrator": "真幌",
            "text": "世話はどうする？\nおまえ一人で出来るのか？",
            "zh": "谁来照顾？\n你一个人做得来吗？",
            "narrator_zh": "真幌"
        },
        {
            "location": "859/TALK",
            "narrator": "真幌",
            "text": "エサ代や病院代、\nトイレの砂、他にも\nまだまだ必要だぞ？",
            "zh": "猫粮、看病的钱、\n猫砂，还有\n好多要花钱？",
            "narrator_zh": "真幌"
        },
        {
            "location": "861/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしのお給料から\n出すわよ。それくらい\n安いものだし。",
            "zh": "从我工资里\n出。这点\n又不贵。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "865/TALK",
            "narrator": "アーヤ",
            "text": "私も出すわ。",
            "zh": "我也出。",
            "narrator_zh": "绫水"
        },
        {
            "location": "868/TALK",
            "narrator": "真幌",
            "text": "なっ、アーヤ！？",
            "zh": "什、绫水！？",
            "narrator_zh": "真幌"
        },
        {
            "location": "870/TALK",
            "narrator": "アーヤ",
            "text": "私も猫飼いたいです！\n可愛くて良いじゃない\nですか！",
            "zh": "我也想养猫！\n可爱\n不好吗！",
            "narrator_zh": "绫水"
        },
        {
            "location": "871/TALK",
            "narrator": "ガブリエラ",
            "text": "ほら、アーヤも\nこう言ってるし！",
            "zh": "看，绫水\n也这么说！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "873/TALK",
            "narrator": "真幌",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "真幌"
        },
        {
            "location": "875/TALK",
            "narrator": "真幌",
            "text": "その猫をおまえ達が\n飼うっていうのか！？",
            "zh": "你们是说，\n这只猫由你们来养！？",
            "narrator_zh": "真幌"
        },
        {
            "location": "876/TALK",
            "narrator": "アーヤ",
            "text": "そうです！",
            "zh": "对！",
            "narrator_zh": "绫水"
        },
        {
            "location": "877/TALK",
            "narrator": "ガブリエラ",
            "text": "そうに\n決まってるじゃん。",
            "zh": "当然\n是这样。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "878/TALK",
            "narrator": "真幌",
            "text": "なるほど…。",
            "zh": "原来如此……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "879/TALK",
            "narrator": "真幌",
            "text": "実は、情報管理庁の\n官僚に、猫好きが\n一人いるんだ。",
            "zh": "其实，情报管理厅的\n官员里，有一个\n喜欢猫的。",
            "narrator_zh": "真幌"
        },
        {
            "location": "881/TALK",
            "narrator": "ガブリエラ",
            "text": "えっ…。",
            "zh": "诶……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "883/TALK",
            "narrator": "真幌",
            "text": "しかも、少し前に\n飼い猫を亡くした\nばかりで――",
            "zh": "而且，前不久\n刚失去了\n养的猫——",
            "narrator_zh": "真幌"
        },
        {
            "location": "884/TALK",
            "narrator": "真幌",
            "text": "新しい家族を迎えたいと\nぼやいていたからな。",
            "zh": "一直念叨着想\n迎接新的家人。",
            "narrator_zh": "真幌"
        },
        {
            "location": "885/TALK",
            "narrator": "真幌",
            "text": "連絡すれば、間違いなく\n引き取ってもらえる\nはずだ。",
            "zh": "一联系，肯定\n会有人\n接走的。",
            "narrator_zh": "真幌"
        },
        {
            "location": "886/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "887/TALK",
            "narrator": "真幌",
            "text": "家族揃って猫好き\nらしく、幸せに\n暮らせることだろう。",
            "zh": "听说全家都喜欢猫，\n应该能过得\n很幸福。",
            "narrator_zh": "真幌"
        },
        {
            "location": "888/TALK",
            "narrator": "真幌",
            "text": "…それなら文句はないな？",
            "zh": "……这样就没意见了吧？",
            "narrator_zh": "真幌"
        },
        {
            "location": "892/TALK",
            "narrator": "ガブリエラ",
            "text": "…諦めるしかないわね。",
            "zh": "……只能放弃了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "896/TALK",
            "narrator": "アーヤ",
            "text": "…そうね。私達が飼う\nよりも、ずっと幸せに\nしてくれそうだし。",
            "zh": "……是啊。比起我们养，\n更能让它\n幸福。",
            "narrator_zh": "绫水"
        },
        {
            "location": "899/TALK",
            "narrator": "真幌",
            "text": "決まりだな。\n早速連絡するとしよう。",
            "zh": "就这么定了。\n马上联系。",
            "narrator_zh": "真幌"
        },
        {
            "location": "902/TALK",
            "narrator": "ガブリエラ",
            "text": "グスッ…\n飼いたかったなぁ…。",
            "zh": "呜……\n好想养啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "904/TALK",
            "narrator": "アーヤ",
            "text": "…いつか寮を出たら、\n絶対猫飼おう。",
            "zh": "……哪天搬出宿舍，\n一定要养猫。",
            "narrator_zh": "绫水"
        },
        {
            "location": "534/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>5月14日　3:26 PM</color>\nある日の午後、神楽坂\nトライナリーの楽屋にて。",
            "zh": "<color=green>5月14日　3:26 PM</color>\n某天下午，神乐坂\n三重奏的后台。",
            "narrator_zh": "Dialog_EventData"
        },
        {
            "location": "620/DIALOG",
            "narrator": "Dialog_GETGokigen",
            "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！",
            "zh": "心情点数\n<size=40><color=red><b>300pt.</b></color></size>\n增加了！",
            "narrator_zh": "Dialog_GETGokigen"
        },
        {
            "location": "834/DIALOG",
            "narrator": "Dialog_GETGokigen",
            "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！",
            "zh": "心情点数\n<size=40><color=red><b>300pt.</b></color></size>\n增加了！",
            "narrator_zh": "Dialog_GETGokigen"
        },
        {
            "location": "915/DIALOG",
            "narrator": "Dialog_GEThimegoto_ch02",
            "text": "【いつかモフれる日が来たら】",
            "zh": "【若是有一天能摸到毛茸茸】",
            "narrator_zh": "Dialog_GEThimegoto_ch02"
        }
    ]
}
