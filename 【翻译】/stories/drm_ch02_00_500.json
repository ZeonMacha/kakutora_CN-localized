  "title": "らぶとーく 第49話",
  "sub_title": "古いのかもしれないけど"
 },
 "entry": [
  {
   "location": "7/SCENARIO",
   "narrator": "",
   "text": "古いのかもしれないけど"
  },
  {
   "location": "25/TALK",
   "narrator": "つばめ",
   "text": "きゃっ！",
   "zh": "呀！",
   "narrator_zh": "燕"
  },
  {
   "location": "27/TALK",
   "narrator": "アーヤ",
   "text": "雷？\nまだ遠いみたいだけど、\n一雨来そうね。"
  },
  {
   "location": "31/TALK",
   "narrator": "つばめ",
   "text": "きゃっ！",
   "zh": "呀！",
   "narrator_zh": "燕"
  },
  {
   "location": "33/TALK",
   "narrator": "ガブリエラ",
   "text": "いや、さすがにちょっと\n怖がり過ぎでしょ？"
  },
  {
   "location": "34/TALK",
   "narrator": "つばめ",
   "text": "だ、だって、雷って\n怖いじゃないですか。",
   "zh": "可、可是，打雷\n很可怕嘛。",
   "narrator_zh": "燕"
  },
  {
   "location": "37/TALK",
   "narrator": "ガブリエラ",
   "text": "別に怖くないわよ。\nただ空が光って音がする\nだけじゃない。"
  },
  {
   "location": "42/TALK",
   "narrator": "ガブリエラ",
   "text": "きゃぁっ！！",
   "zh": "呀啊！！",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "44/TALK",
   "narrator": "つばめ",
   "text": "…ガブちゃんも\n怖がってるよね？",
   "zh": "……加布她\n也很害怕吧？",
   "narrator_zh": "燕"
  },
  {
   "location": "48/TALK",
   "narrator": "ガブリエラ",
   "text": "ち、違う！\n怖かったんじゃないわ！",
   "zh": "不、不是！\n我才没有害怕！",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "49/TALK",
   "narrator": "ガブリエラ",
   "text": "急に大きな音がしたから、\nビックリしただけよ。"
  },
  {
   "location": "50/TALK",
   "narrator": "つばめ",
   "text": "本当かなぁ？"
  },
  {
   "location": "52/TALK",
   "narrator": "ガブリエラ",
   "text": "雷なんて怖くないわよ！"
  },
  {
   "location": "54/TALK",
   "narrator": "みやび",
   "text": "うちも、雷はもうちっくと\n大きい方が好きやね。"
  },
  {
   "location": "56/TALK",
   "narrator": "アーヤ",
   "text": "あら、みやびは\n雷って平気なの？"
  },
  {
   "location": "58/TALK",
   "narrator": "みやび",
   "text": "ど派手で好きちや。",
   "zh": "那么张扬，我喜欢咯。",
   "narrator_zh": "雅"
  },
  {
   "location": "59/TALK",
   "narrator": "みやび",
   "text": "どうせなら、寮にでも\n直撃してくれたら\n派手でえいんやけんど。",
   "zh": "既然这样，直接\n杀到宿舍去反而\n更热闹咯，不过。",
   "narrator_zh": "雅"
  },
  {
   "location": "60/TALK",
   "narrator": "つばめ",
   "text": "えぇっ！？",
   "zh": "诶诶！？",
   "narrator_zh": "燕"
  },
  {
   "location": "62/TALK",
   "narrator": "ガブリエラ",
   "text": "ちょ、冗談でもそういう\nこと言わないでよ！",
   "zh": "等、就算是玩笑也别说\n那种话！",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "64/TALK",
   "narrator": "みやび",
   "text": "いや、冗談やなくて、\n身体が震えるくらい\nド派手な音を――"
  },
  {
   "location": "65/TALK",
   "narrator": "みやび",
   "text": "…………。"
  },
  {
   "location": "67/TALK",
   "narrator": "みやび",
   "text": "いや、前言撤回や。"
  },
  {
   "location": "68/TALK",
   "narrator": "みやび",
   "text": "そんなんでＰＣに不調が\n出たら、面倒なことに\nなるきね。",
   "zh": "那样的话电脑出故障，\n就会变得\n很麻烦咯。",
   "narrator_zh": "雅"
  },
  {
   "location": "71/TALK",
   "narrator": "アーヤ",
   "text": "みやびらしいわね。"
  },
  {
   "location": "73/TALK",
   "narrator": "ガブリエラ",
   "text": "そういうアーヤは\n怖くないの？",
   "zh": "这样的绫水\n你不怕吗？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "76/TALK",
   "narrator": "アーヤ",
   "text": "怖いわよ。\n急に近くで音がしたら\nビクッとするし。"
  },
  {
   "location": "77/TALK",
   "narrator": "ガブリエラ",
   "text": "…全然怖がってないわね。",
   "zh": "……一点都不怕呢。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "79/TALK",
   "narrator": "つばめ",
   "text": "やっぱり、アーヤさんは\n凄いなぁ…。"
  },
  {
   "location": "80/TALK",
   "narrator": "アーヤ",
   "text": "昔は怖かったけど、\nさすがにこの年に\nなるとね…。"
  },
  {
   "location": "82/TALK",
   "narrator": "アーヤ",
   "text": "…そういえば、\n$handle$さんの方は\nどうなのかしら？"
  },
  {
   "location": "95/TALK",
   "narrator": "アーヤ",
   "text": "$handle$さん",
   "zh": "$handle$",
   "narrator_zh": "绫水"
  },
  {
   "location": "96/TALK",
   "narrator": "アーヤ",
   "text": "こっちは凄い天気(>_<)",
   "zh": "这边天气好厉害(>_<)",
   "narrator_zh": "绫水"
  },
  {
   "location": "97/TALK",
   "narrator": "アーヤ",
   "text": "雷！"
  },
  {
   "location": "99/SEL",
   "narrator": "",
   "text": "大丈夫！？"
  },
  {
   "location": "100/ACT",
   "narrator": "",
   "text": "大丈夫！？"
  },
  {
   "location": "102/TALK",
   "narrator": "アーヤ",
   "text": "大丈夫"
  },
  {
   "location": "103/TALK",
   "narrator": "アーヤ",
   "text": "今日は出掛ける予定ないし"
  },
  {
   "location": "104/TALK",
   "narrator": "アーヤ",
   "text": "明日までずっと屋内だから(^^"
  },
  {
   "location": "105/TALK",
   "narrator": "アーヤ",
   "text": "そっちの天気はどう？",
   "zh": "你那边天气怎么样？",
   "narrator_zh": "绫水"
  },
  {
   "location": "107/SEL",
   "narrator": "",
   "text": "いい天気だよ",
   "zh": "天气很好哦",
   "narrator_zh": ""
  },
  {
   "location": "108/SEL",
   "narrator": "",
   "text": "あんまりよくないな",
   "zh": "感觉不太好",
   "narrator_zh": ""
  },
  {
   "location": "109/SEL",
   "narrator": "",
   "text": "アーヤのおかげで気持ちは晴天",
   "zh": "托绫水的福，心情一片晴",
   "narrator_zh": ""
  },
  {
   "location": "110/ACT",
   "narrator": "",
   "text": "いい天気だよ",
   "zh": "天气很好哦",
   "narrator_zh": ""
  },
  {
   "location": "111/TALK",
   "narrator": "アーヤ",
   "text": "それならよかった",
   "zh": "那样就好",
   "narrator_zh": "绫水"
  },
  {
   "location": "112/TALK",
   "narrator": "アーヤ",
   "text": "天候悪くなると"
  },
  {
   "location": "113/TALK",
   "narrator": "アーヤ",
   "text": "気温も下がるし"
  },
  {
   "location": "114/TALK",
   "narrator": "アーヤ",
   "text": "低気圧で頭も痛くなるから"
  },
  {
   "location": "116/TALK",
   "narrator": "アーヤ",
   "text": "最悪よね(T_T)"
  },
  {
   "location": "118/SEL",
   "narrator": "",
   "text": "体調に気を付けてね",
   "zh": "注意身体哦",
   "narrator_zh": ""
  },
  {
   "location": "119/ACT",
   "narrator": "",
   "text": "体調に気を付けてね",
   "zh": "注意身体哦",
   "narrator_zh": ""
  },
  {
   "location": "121/TALK",
   "narrator": "アーヤ",
   "text": "うん",
   "zh": "嗯",
   "narrator_zh": "绫水"
  },
  {
   "location": "122/TALK",
   "narrator": "アーヤ",
   "text": "ありがと(*^.^*)"
  },
  {
   "location": "123/ACT",
   "narrator": "",
   "text": "あんまりよくないな",
   "zh": "感觉不太好",
   "narrator_zh": ""
  },
  {
   "location": "124/TALK",
   "narrator": "アーヤ",
   "text": "そうなんだ",
   "zh": "是这样啊",
   "narrator_zh": "绫水"
  },
  {
   "location": "125/TALK",
   "narrator": "アーヤ",
   "text": "ちょっとだけ嬉しいかも",
   "zh": "也许有一点点高兴",
   "narrator_zh": "绫水"
  },
  {
   "location": "127/SEL",
   "narrator": "",
   "text": "どうして？",
   "zh": "为什么？",
   "narrator_zh": ""
  },
  {
   "location": "128/ACT",
   "narrator": "",
   "text": "どうして？",
   "zh": "为什么？",
   "narrator_zh": ""
  },
  {
   "location": "130/TALK",
   "narrator": "アーヤ",
   "text": "だって",
   "zh": "因为",
   "narrator_zh": "绫水"
  },
  {
   "location": "131/TALK",
   "narrator": "アーヤ",
   "text": "離れてるのに"
  },
  {
   "location": "132/TALK",
   "narrator": "アーヤ",
   "text": "すぐ近くにいるみたいだし"
  },
  {
   "location": "135/SEL",
   "narrator": "",
   "text": "なんか、照れる",
   "zh": "怎么讲，有点害羞",
   "narrator_zh": ""
  },
  {
   "location": "136/ACT",
   "narrator": "",
   "text": "なんか、照れる",
   "zh": "怎么讲，有点害羞",
   "narrator_zh": ""
  },
  {
   "location": "138/TALK",
   "narrator": "アーヤ",
   "text": "$handle$さんの",
   "zh": "$handle$的",
   "narrator_zh": "绫水"
  },
  {
   "location": "140/TALK",
   "narrator": "アーヤ",
   "text": "可愛い一面発見"
  },
  {
   "location": "142/ACT",
   "narrator": "",
   "text": "アーヤのおかげで気持ちは晴天",
   "zh": "托绫水的福，心情一片晴",
   "narrator_zh": ""
  },
  {
   "location": "143/TALK",
   "narrator": "アーヤ",
   "text": "口が上手いのね"
  },
  {
   "location": "144/TALK",
   "narrator": "アーヤ",
   "text": "そういうことばかり言ってると",
   "zh": "老说那种话的话",
   "narrator_zh": "绫水"
  },
  {
   "location": "145/TALK",
   "narrator": "アーヤ",
   "text": "遊び人に見えるわよ？(￣Д￣ )"
  },
  {
   "location": "146/TALK",
   "narrator": "アーヤ",
   "text": "色んな女の人に言ってるんでしょ？"
  },
  {
   "location": "148/SEL",
   "narrator": "",
   "text": "生まれて初めて言った",
   "zh": "我有生以来第一次说",
   "narrator_zh": ""
  },
  {
   "location": "149/ACT",
   "narrator": "",
   "text": "生まれて初めて言った",
   "zh": "我有生以来第一次说",
   "narrator_zh": ""
  },
  {
   "location": "151/TALK",
   "narrator": "アーヤ",
   "text": "そうなの？＼(◎o◎)／",
   "zh": "是这样吗？＼(◎o◎)／",
   "narrator_zh": "绫水"
  },
  {
   "location": "152/TALK",
   "narrator": "アーヤ",
   "text": "それならいいわ",
   "zh": "那样就好",
   "narrator_zh": "绫水"
  },
  {
   "location": "153/TALK",
   "narrator": "アーヤ",
   "text": "他の人には言ったらダメよ( ・_・)σﾞ"
  },
  {
   "location": "155/TALK",
   "narrator": "アーヤ",
   "text": "そういえば今日ね",
   "zh": "说起来今天呢",
   "narrator_zh": "绫水"
  },
  {
   "location": "160/TALK",
   "narrator": "アーヤ",
   "text": "あ",
   "zh": "啊",
   "narrator_zh": "绫水"
  },
  {
   "location": "161/TALK",
   "narrator": "アーヤ",
   "text": "待って",
   "zh": "等等",
   "narrator_zh": "绫水"
  },
  {
   "location": "165/TALK",
   "narrator": "アーヤ",
   "text": "ごめん",
   "zh": "抱歉",
   "narrator_zh": "绫水"
  },
  {
   "location": "167/TALK",
   "narrator": "アーヤ",
   "text": "また後で",
   "zh": "回头再说",
   "narrator_zh": "绫水"
  },
  {
   "location": "168/TALK",
   "narrator": "アーヤ",
   "text": "どこかに落ちたみたいで停電",
   "zh": "好像掉到什么地方了，停电",
   "narrator_zh": "绫水"
  },
  {
   "location": "169/TALK",
   "narrator": "アーヤ",
   "text": "真っ暗で"
  },
  {
   "location": "170/TALK",
   "narrator": "アーヤ",
   "text": "つばめ達が怖がってる",
   "zh": "燕她们在害怕",
   "narrator_zh": "绫水"
  },
  {
   "location": "172/SEL",
   "narrator": "",
   "text": "わかった、近くにいれなくてごめん",
   "zh": "我知道了，没能陪在你身边，抱歉啊",
   "narrator_zh": ""
  },
  {
   "location": "173/ACT",
   "narrator": "",
   "text": "わかった、近くにいれなくてごめん",
   "zh": "我知道了，没能陪在你身边，抱歉啊",
   "narrator_zh": ""
  },
  {
   "location": "175/TALK",
   "narrator": "アーヤ",
   "text": "スマホ越しでも"
  },
  {
   "location": "176/TALK",
   "narrator": "アーヤ",
   "text": "いてくれるだけで嬉しい"
  },
  {
   "location": "177/TALK",
   "narrator": "アーヤ",
   "text": "ちゃんと伝わってるから(*^^*)",
   "zh": "我有好好传达到(*^^*)",
   "narrator_zh": "绫水"
  },
  {
   "location": "178/TALK",
   "narrator": "アーヤ",
   "text": "また夜にね"
  },
  {
   "location": "181/TALK",
   "narrator": "アーヤ",
   "text": "でもやっぱり",
   "zh": "不过果然",
   "narrator_zh": "绫水"
  },
  {
   "location": "182/TALK",
   "narrator": "アーヤ",
   "text": "少しだけ"
  },
  {
   "location": "185/TALK",
   "narrator": "ボイスメール",
   "text": "熱冷ましにアイスクリーム"
  },
  {
   "location": "203/TALK",
   "narrator": "アーヤ",
   "text": "今はこんな感じ"
  },
  {
   "location": "205/TALK",
   "narrator": "アーヤ",
   "text": "じゃあまたね",
   "zh": "那就下次见",
   "narrator_zh": "绫水"
  },
  {
