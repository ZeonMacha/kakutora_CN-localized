{
    "dir": "dramatics/daydra/drm_ch02_00_700.js",
    "type": "Episode",
    "info": {
        "story_id": "2070",
        "cid": "ayami",
        "title": "らぶとーく 第69話",
        "sub_title": "思いの重い思い",
        "title_zh": "恋爱漫谈 第69话",
        "sub_title_zh": "心意的沉重"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "思いの重い思い",
            "zh": "心意的沉重",
            "narrator_zh": ""
        },
        {
            "location": "20/TALK",
            "narrator": "アーヤ",
            "text": "……へえ。\nこういうのも\nあるのね。",
            "zh": "……哦。\n原来还有\n这种东西啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "21/TALK",
            "narrator": "アーヤ",
            "text": "今度試しに\n作ってみよう\nかしら。",
            "zh": "下次要不要\n试着\n做一个呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "23/TALK",
            "narrator": "みやび",
            "text": "アーヤは何を\n熱心に\n読んじゅう？",
            "zh": "绫水你\n在读什么\n这么入神？",
            "narrator_zh": "雅"
        },
        {
            "location": "26/TALK",
            "narrator": "アーヤ",
            "text": "え。\nええと……。",
            "zh": "诶。\n那个……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "27/TALK",
            "narrator": "ガブリエラ",
            "text": "なあに？\n「本当に願いが叶う\nミサンガの作り方」？",
            "zh": "什么？\n“能真正实现愿望的\n幸运绳做法”？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "28/TALK",
            "narrator": "つばめ",
            "text": "ミサンガって\n何ですか？",
            "zh": "幸运绳是\n什么呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "31/TALK",
            "narrator": "ガブリエラ",
            "text": "ミサンガは\nミサンガよ。",
            "zh": "幸运绳\n就是幸运绳啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "33/TALK",
            "narrator": "みやび",
            "text": "組紐の一種ぞね。",
            "zh": "是组纽的一种咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "34/TALK",
            "narrator": "みやび",
            "text": "そこに書いちゅう\n通り、切れると\n願いが叶うらしい。",
            "zh": "按那上面写的，\n断了的话\n愿望就会实现嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "36/TALK",
            "narrator": "つばめ",
            "text": "ふうん……。\n千羽鶴みたいな\nものですか？",
            "zh": "唔……。\n是类似千羽鹤的\n东西吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "38/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょっと！\nそこまで重い\n願い事じゃないわよ！？",
            "zh": "喂！\n又不是那么重的\n心愿哦！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "39/TALK",
            "narrator": "みやび",
            "text": "それは願いを込めた\n本人にしか\nわからんろう。",
            "zh": "那是倾注了心愿，\n只有本人\n才明白啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "41/TALK",
            "narrator": "みやび",
            "text": "なあ？\nアーヤ。",
            "zh": "我说？\n绫水。",
            "narrator_zh": "雅"
        },
        {
            "location": "43/TALK",
            "narrator": "アーヤ",
            "text": "えっ？\n私？",
            "zh": "诶？\n我？",
            "narrator_zh": "绫水"
        },
        {
            "location": "44/TALK",
            "narrator": "みやび",
            "text": "作るつもりで\n見てたんと\n違うんかね？",
            "zh": "不是想着要做\n才看的\n吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "46/TALK",
            "narrator": "アーヤ",
            "text": "それはそう\nなんだけど…。",
            "zh": "话是\n这么说……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "59/TALK",
            "narrator": "アーヤ",
            "text": "ねえ",
            "zh": "我说",
            "narrator_zh": "绫水"
        },
        {
            "location": "60/TALK",
            "narrator": "アーヤ",
            "text": "願い事ってある？",
            "zh": "你有什么愿望吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "62/SEL",
            "narrator": "",
            "text": "あるといえばある",
            "zh": "说有也有",
            "narrator_zh": ""
        },
        {
            "location": "63/SEL",
            "narrator": "",
            "text": "ないかなー",
            "zh": "没有吧——",
            "narrator_zh": ""
        },
        {
            "location": "64/SEL",
            "narrator": "",
            "text": "言えばアーヤは叶えてくれる？",
            "zh": "我说了绫水就会替我实现吗？",
            "narrator_zh": ""
        },
        {
            "location": "65/ACT",
            "narrator": "",
            "text": "あるといえばある",
            "zh": "说有也有",
            "narrator_zh": ""
        },
        {
            "location": "66/TALK",
            "narrator": "アーヤ",
            "text": "あるのね",
            "zh": "还真有啊",
            "narrator_zh": "绫水"
        },
        {
            "location": "67/TALK",
            "narrator": "アーヤ",
            "text": "教えて",
            "zh": "告诉我",
            "narrator_zh": "绫水"
        },
        {
            "location": "69/SEL",
            "narrator": "",
            "text": "秘密",
            "zh": "秘密",
            "narrator_zh": ""
        },
        {
            "location": "70/SEL",
            "narrator": "",
            "text": "わかってるくせに！",
            "zh": "你明明就知道！",
            "narrator_zh": ""
        },
        {
            "location": "71/ACT",
            "narrator": "",
            "text": "秘密",
            "zh": "秘密",
            "narrator_zh": ""
        },
        {
            "location": "72/TALK",
            "narrator": "アーヤ",
            "text": "そう",
            "zh": "对",
            "narrator_zh": "绫水"
        },
        {
            "location": "73/TALK",
            "narrator": "アーヤ",
            "text": "ならいいわよ(--*;",
            "zh": "那就好(--*;",
            "narrator_zh": "绫水"
        },
        {
            "location": "74/ACT",
            "narrator": "",
            "text": "わかってるくせに！",
            "zh": "你明明就知道！",
            "narrator_zh": ""
        },
        {
            "location": "75/TALK",
            "narrator": "アーヤ",
            "text": "わからないわよ",
            "zh": "谁知道啊",
            "narrator_zh": "绫水"
        },
        {
            "location": "76/TALK",
            "narrator": "アーヤ",
            "text": "もう＼(◎o◎)／",
            "zh": "真是的＼(◎o◎)／",
            "narrator_zh": "绫水"
        },
        {
            "location": "78/ACT",
            "narrator": "",
            "text": "ないかなー",
            "zh": "没有吧——",
            "narrator_zh": ""
        },
        {
            "location": "79/TALK",
            "narrator": "アーヤ",
            "text": "ないのね",
            "zh": "没有呢",
            "narrator_zh": "绫水"
        },
        {
            "location": "80/TALK",
            "narrator": "アーヤ",
            "text": "そっか",
            "zh": "这样啊",
            "narrator_zh": "绫水"
        },
        {
            "location": "81/ACT",
            "narrator": "",
            "text": "言えばアーヤは叶えてくれる？",
            "zh": "我说了绫水就会替我实现吗？",
            "narrator_zh": ""
        },
        {
            "location": "82/TALK",
            "narrator": "アーヤ",
            "text": "ものによるわ",
            "zh": "要看是什么了",
            "narrator_zh": "绫水"
        },
        {
            "location": "83/TALK",
            "narrator": "アーヤ",
            "text": "叶えられるものならね(｡-_-｡)",
            "zh": "要是能实现的话(｡-_-｡)",
            "narrator_zh": "绫水"
        },
        {
            "location": "98/TALK",
            "narrator": "アーヤ",
            "text": "ちょっと\nお世話になってる\n人がいて。",
            "zh": "有个一直\n受人家照顾\n的人。",
            "narrator_zh": "绫水"
        },
        {
            "location": "99/TALK",
            "narrator": "アーヤ",
            "text": "お礼もあんまり\nできてないから。",
            "zh": "我也没怎么\n好好道过谢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "100/TALK",
            "narrator": "アーヤ",
            "text": "簡単だし作って\nあげようかなって\n思ったんだけど。",
            "zh": "还想着很简单，\n要不要做个\n送你呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "101/TALK",
            "narrator": "アーヤ",
            "text": "あんまり\n興味ないみたい。",
            "zh": "不过你好像\n不太感兴趣。",
            "narrator_zh": "绫水"
        },
        {
            "location": "103/TALK",
            "narrator": "つばめ",
            "text": "あ…。\nそうなんですね。",
            "zh": "啊……。\n是这样啊。",
            "narrator_zh": "燕"
        },
        {
            "location": "104/TALK",
            "narrator": "みやび",
            "text": "やっぱりアレよ。\n手作りは念が\nこもっちゅうき。",
            "zh": "果然是那个道理。\n手工的东西\n心意最重咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "105/TALK",
            "narrator": "みやび",
            "text": "ちっくと\n重いんかも\nしれんねえ。",
            "zh": "也许有点\n沉重\n咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "108/TALK",
            "narrator": "ガブリエラ",
            "text": "確かにね。",
            "zh": "确实呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "109/TALK",
            "narrator": "ガブリエラ",
            "text": "あれってヒモが\n切れるまで\n２、３ヶ月かかるわよね。",
            "zh": "那东西要等绳子\n断掉\n得花两三个月吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "110/TALK",
            "narrator": "ガブリエラ",
            "text": "相当仲がよくないと\n付けてもらえない\nんじゃない。",
            "zh": "交情不够深的话\n人家不会给你\n戴的吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "112/TALK",
            "narrator": "ガブリエラ",
            "text": "でもあたしは\nもらってあげるわ。\n安心して。",
            "zh": "不过我会\n收下的。\n放心吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "113/TALK",
            "narrator": "つばめ",
            "text": "わたしは…\n手間かけてもらうの\n悪いですし。",
            "zh": "我的话……\n让人费那功夫\n总觉得过意不去。",
            "narrator_zh": "燕"
        },
        {
            "location": "114/TALK",
            "narrator": "つばめ",
            "text": "事前に聞かれたら\n遠慮すると\n思います。",
            "zh": "要是事先问我的话，\n我想我会\n推辞的。",
            "narrator_zh": "燕"
        },
        {
            "location": "115/TALK",
            "narrator": "アーヤ",
            "text": "サプライズ\nプレゼントなら\nありってこと？",
            "zh": "如果是\n惊喜礼物的话\n就可以吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "116/TALK",
            "narrator": "みやび",
            "text": "えろうミサンガに\n執着するねえ。",
            "zh": "对这根手绳\n倒是挺执着嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "118/TALK",
            "narrator": "アーヤ",
            "text": "そういうわけじゃ\nないんだけど…。",
            "zh": "也不是\n那么回事……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "119/TALK",
            "narrator": "みやび",
            "text": "まあ、あれよね。",
            "zh": "嘛，就是那个啦。",
            "narrator_zh": "雅"
        },
        {
            "location": "120/TALK",
            "narrator": "みやび",
            "text": "そういうアーヤを\n相手がかわいいって\n思っちゅうなら。",
            "zh": "如果对方觉得\n这样的绫水\n很可爱嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "121/TALK",
            "narrator": "みやび",
            "text": "むしろアリなんと\n違うかねえ。",
            "zh": "反倒可以说\n是可行的吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "122/TALK",
            "narrator": "ガブリエラ",
            "text": "だからあたしなら\nもらって\nあげるってば。",
            "zh": "所以我说我来\n收下\n就好嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "124/TALK",
            "narrator": "アーヤ",
            "text": "簡単なものだったら\n大丈夫って\n思ってたけど。",
            "zh": "本来想着\n简单的东西\n应该没关系。",
            "narrator_zh": "绫水"
        },
        {
            "location": "126/TALK",
            "narrator": "アーヤ",
            "text": "どうも\nそういうわけじゃ\nないみたい…。",
            "zh": "好像\n也不完全是\n那样……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "127/TALK",
            "narrator": "アーヤ",
            "text": "……うーん……。",
            "zh": "……唔……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "19/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>某月某日　 0:16 PM</color>\nとある平日の昼休み、付属学園食堂でのこと",
            "zh": "<color=green>某月某日　 0:16 PM</color>\n某天平日的午休，在附属学园食堂里",
            "narrator_zh": "Dialog_EventData"
        }
    ]
}
