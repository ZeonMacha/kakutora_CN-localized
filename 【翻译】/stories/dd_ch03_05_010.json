{
    "dir": "chap05/daydra/dd_ch03_05_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "5352",
        "cid": "gabriella",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "テストの結果",
        "title_zh": "Extra002 额外剧情",
        "sub_title_zh": "考试结果"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "テストの結果",
            "zh": "考试结果",
            "narrator_zh": ""
        },
        {
            "location": "19/TALK",
            "narrator": "みやび",
            "text": "しっかし、\nガブちゃんは\nまっこと頭がえいね。",
            "zh": "不过，\n加布\n脑壳蛮灵咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "22/TALK",
            "narrator": "ガブリエラ",
            "text": "小テストで\n満点取ったくらいで\n大げさよ。",
            "zh": "小测验\n拿了满分而已，\n夸张了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "24/TALK",
            "narrator": "ガブリエラ",
            "text": "中間や期末と違って\n出題範囲も狭いんだし。",
            "zh": "又不是期中期末，\n出题范围也很窄。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "26/TALK",
            "narrator": "みやび",
            "text": "けんど、満点なんて\nそう簡単に取れる\nもんやないがよ。",
            "zh": "不过，满分这种，\n不是那么容易\n拿到的咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "29/TALK",
            "narrator": "ガブリエラ",
            "text": "っていうか、あたしは\nとっくに中学レベルの\n勉強は済ませてあるの。",
            "zh": "话说，我\n早就把中学水平的\n功课学完了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "30/TALK",
            "narrator": "ガブリエラ",
            "text": "だからこれは当然の\n結果。いちいち喜んで\nられないわ。",
            "zh": "所以这是当然的\n结果。没工夫\n一一高兴。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "32/TALK",
            "narrator": "みやび",
            "text": "はぁ…\n冷めちゅうなぁ…。",
            "zh": "哈……\n冷淡得很啊……。",
            "narrator_zh": "雅"
        },
        {
            "location": "33/TALK",
            "narrator": "みやび",
            "text": "例えそうやとしても、\n１００点取ったことには\n変わりないんやし――",
            "zh": "就算是那样，\n拿了一百分这件事\n也不会变——",
            "narrator_zh": "雅"
        },
        {
            "location": "34/TALK",
            "narrator": "みやび",
            "text": "そのことを喜ぶんは、\n何もおかしくはないと\n思うがよ？",
            "zh": "为这件事高兴，\n也没什么好奇怪的\n咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "35/SEL",
            "narrator": "",
            "text": "嫌な人に思われちゃうよ？",
            "zh": "会被当成讨厌的人哦？",
            "narrator_zh": ""
        },
        {
            "location": "36/SEL",
            "narrator": "",
            "text": "喜ばなきゃ変だよ",
            "zh": "不高兴才奇怪",
            "narrator_zh": ""
        },
        {
            "location": "37/SEL",
            "narrator": "",
            "text": "$me$が代わりに喜ぶよ",
            "zh": "那$me$替你高兴",
            "narrator_zh": ""
        },
        {
            "location": "40/TALK",
            "narrator": "ガブリエラ",
            "text": "そう言われても…。",
            "zh": "你这么说的话……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "41/TALK",
            "narrator": "みやび",
            "text": "まあ、無理に喜べとは\n言わんき――",
            "zh": "嘛，我又没说\n要你硬高兴啵——",
            "narrator_zh": "雅"
        },
        {
            "location": "42/TALK",
            "narrator": "みやび",
            "text": "そこまで深く考えること\nないがよ。",
            "zh": "没必要想得\n那么深咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "45/TALK",
            "narrator": "みやび",
            "text": "やけんど、あんまし\n喜ばんでいるんも――",
            "zh": "不过，太过\n高兴的话——",
            "narrator_zh": "雅"
        },
        {
            "location": "46/TALK",
            "narrator": "みやび",
            "text": "せっかくの可愛さが\n台無しになって\n勿体無いがよ。",
            "zh": "好不容易的可爱\n全糟蹋掉，\n太可惜了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "48/TALK",
            "narrator": "ガブリエラ",
            "text": "うっ……。",
            "zh": "唔……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "50/TALK",
            "narrator": "ガブリエラ",
            "text": "…べ、別に！\nそういうの\n気にしないし。",
            "zh": "……才、才没有！\n那种事\n我才不在意。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "51/TALK",
            "narrator": "みやび",
            "text": "ちっくと気にした方が\nえいと思うけんど…。",
            "zh": "在意一哈比较\n好，不过……。",
            "narrator_zh": "雅"
        },
        {
            "location": "52/TALK",
            "narrator": "みやび",
            "text": "まあ、その方が\nガブちゃんらしくは\nあるな。",
            "zh": "嘛，那样\n倒更像\n加布。",
            "narrator_zh": "雅"
        },
        {
            "location": "54/ACT",
            "narrator": "",
            "text": "嫌な人に思われちゃうよ？",
            "zh": "会被当成讨厌的人哦？",
            "narrator_zh": ""
        },
        {
            "location": "82/TALK",
            "narrator": "ガブリエラ",
            "text": "それは嫌かも…",
            "zh": "那可能不太想……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "95/TALK",
            "narrator": "ガブリエラ",
            "text": "マルザンナの言う\nとおり、嫌なヤツに\n思われちゃうかも。",
            "zh": "照玛尔赞娜说的，\n也许会被当成\n讨厌的人。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "96/TALK",
            "narrator": "ガブリエラ",
            "text": "満点自体は凄いもの\nなんだから――",
            "zh": "满分本身就是\n很了不起的事——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "97/TALK",
            "narrator": "ガブリエラ",
            "text": "喜ぶときは喜ばないと\nエレガントでは\nないわね。",
            "zh": "该高兴时不高兴，\n就不算\nelegant了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "99/TALK",
            "narrator": "ガブリエラ",
            "text": "…みやびの言う通りね。",
            "zh": "……雅说得对。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "101/TALK",
            "narrator": "みやび",
            "text": "ようやく理解したがか？",
            "zh": "总算明白了喃？",
            "narrator_zh": "雅"
        },
        {
            "location": "102/TALK",
            "narrator": "ガブリエラ",
            "text": "ええ…とっくに\n習ったとか、そういう\nのは別にして――",
            "zh": "嗯……早就学过\n之类的，那些\n先放一边——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "103/TALK",
            "narrator": "ガブリエラ",
            "text": "完璧に覚えてる、って\n証明にもなるんだし。\n喜んでおくべきよね。",
            "zh": "也能证明我\n记得很完整。\n是该高兴一下。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "104/TALK",
            "narrator": "ガブリエラ",
            "text": "反省するわ。",
            "zh": "我反省。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "107/TALK",
            "narrator": "みやび",
            "text": "反省やのうて\n喜べ言っちゅうに…。",
            "zh": "不是叫你反省，\n是叫你高兴……。",
            "narrator_zh": "雅"
        },
        {
            "location": "108/ACT",
            "narrator": "",
            "text": "喜ばなきゃ変だよ",
            "zh": "不高兴才奇怪",
            "narrator_zh": ""
        },
        {
            "location": "127/TALK",
            "narrator": "ガブリエラ",
            "text": "無理に喜ぶ方が変よ",
            "zh": "硬要高兴才奇怪",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "139/TALK",
            "narrator": "ガブリエラ",
            "text": "そうよ、いくら\n周りから凄いと\n思われたって――",
            "zh": "就是，不管周围\n觉得多么\n了不起——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "140/TALK",
            "narrator": "ガブリエラ",
            "text": "それで無理に\n喜ばなきゃいけない\n理由なんてないわ。",
            "zh": "也没有因此\n非要高兴的\n理由。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "143/TALK",
            "narrator": "ガブリエラ",
            "text": "うん、やっぱり無理。",
            "zh": "嗯，果然还是不行。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "145/TALK",
            "narrator": "みやび",
            "text": "言い切りおったか。",
            "zh": "说得真绝。",
            "narrator_zh": "雅"
        },
        {
            "location": "146/TALK",
            "narrator": "ガブリエラ",
            "text": "日本の中学レベルの\n問題じゃ、達成感も\n皆無だし――",
            "zh": "日本中学水平的\n题目，成就感\n也一点没有——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "147/TALK",
            "narrator": "ガブリエラ",
            "text": "一々こんなことで\n喜んだら、キリが\nなくなっちゃうわ。",
            "zh": "每回这种事都高兴，\n那就没完\n没了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "150/TALK",
            "narrator": "みやび",
            "text": "…この性格じゃ\n同級生に友達なんて\nできないのも当然やね。",
            "zh": "……这种性格，\n在同学里交不到朋友\n也是当然的咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "151/ACT",
            "narrator": "",
            "text": "$me$が代わりに喜ぶよ",
            "zh": "那$me$替你高兴",
            "narrator_zh": ""
        },
        {
            "location": "179/TALK",
            "narrator": "ガブリエラ",
            "text": "ありがとう、マルザンナ",
            "zh": "谢谢，玛尔赞娜",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "180/TALK",
            "narrator": "ガブリエラ",
            "text": "それなら、私の分までうんと喜んでちょうだい",
            "zh": "那就请你连我的份一起好好高兴",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "192/TALK",
            "narrator": "ガブリエラ",
            "text": "…ふふっ。",
            "zh": "……呵呵。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "193/TALK",
            "narrator": "みやび",
            "text": "おっ、やっとわかって\nもらえたようやね。",
            "zh": "哦，看来终于\n懂了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "195/TALK",
            "narrator": "ガブリエラ",
            "text": "えっ、何が？",
            "zh": "诶，什么？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "196/TALK",
            "narrator": "みやび",
            "text": "えい笑顔に\nなっちゅうよ。",
            "zh": "笑容变得\n好看咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "198/TALK",
            "narrator": "ガブリエラ",
            "text": "えっ！？",
            "zh": "诶！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "200/TALK",
            "narrator": "ガブリエラ",
            "text": "本当だ！\nなんか口元が自然と\n緩んじゃってる。",
            "zh": "真的！\n嘴角不知不觉\n松下来了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "201/TALK",
            "narrator": "みやび",
            "text": "簡単思うたとしても、\n満点を取った時は\n素直に喜ぶ。",
            "zh": "就算觉得简单，\n拿到满分的时候\n也坦率地高兴。",
            "narrator_zh": "雅"
        },
        {
            "location": "202/TALK",
            "narrator": "みやび",
            "text": "その方が自然やし、\n可愛くてえいと思うよ。",
            "zh": "那样更自然，\n也可爱，要得好。",
            "narrator_zh": "雅"
        },
        {
            "location": "204/TALK",
            "narrator": "ガブリエラ",
            "text": "…満点が嬉しくて\n笑ってるわけじゃ\nないんだけど…。",
            "zh": "……我不是因为满分\n开心才在笑\n……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "205/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、あたしのことで\n喜んでくれる人がいる\nのって、嬉しいな。",
            "zh": "不过，有人会为\n我的事高兴，\n我觉得挺开心。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "18/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>5月13日　4:51 PM</color>\nとある日の夕方、神楽坂トライナリー付近の路地にて。",
            "zh": "<color=green>5月13日　4:51 PM</color>\n某天傍晚，神乐坂三重奏附近的小巷。",
            "narrator_zh": "Dialog_EventData"
        },
        {
            "location": "60/DIALOG",
            "narrator": "Dialog_GETGokigen",
            "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！",
            "zh": "心情点数\n<size=40><color=red><b>300pt.</b></color></size>\n增加了！",
            "narrator_zh": "Dialog_GETGokigen"
        },
        {
            "location": "157/DIALOG",
            "narrator": "Dialog_GETGokigen",
            "text": "ゴキゲンポイントが\n<size=40><color=red><b>300pt.</b></color></size>\nアップしました！",
            "zh": "心情点数\n<size=40><color=red><b>300pt.</b></color></size>\n增加了！",
            "narrator_zh": "Dialog_GETGokigen"
        }
    ]
}
