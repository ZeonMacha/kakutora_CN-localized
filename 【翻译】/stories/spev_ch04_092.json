{
    "dir": "chap00/daydra/spev_ch04_092.js",
    "type": "",
    "info": {
        "story_id": "91031",
        "cid": "",
        "title": "ぴょんこのサマー大作戦♪",
        "sub_title": "ぴょんこのサマー大作戦♪①【みやび編】",
        "title_zh": "蹦子的夏日大作战♪",
        "sub_title_zh": "蹦子的夏日大作战♪①【雅篇】"
    },
    "entry": [
        {
            "location": "19/DIALOG",
            "narrator": "",
            "text": "<color=green>7月5日　5:11 PM</color>\nとある平日の放課後、みやびの部屋にて",
            "zh": "<color=green>7月5日　5:11 PM</color>\n某个工作日的放学后，在雅的房间里",
            "narrator_zh": ""
        },
        {
            "location": "26/TALK",
            "narrator": "みやび",
            "text": "ん？　開いてるぞねー。",
            "zh": "嗯？　门开着咧——。",
            "narrator_zh": "雅"
        },
        {
            "location": "27/TALK",
            "narrator": "神楽",
            "text": "はい、失礼します。",
            "zh": "好的，打扰了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "40/TALK",
            "narrator": "神楽",
            "text": "こんにち――",
            "zh": "你好——",
            "narrator_zh": "神乐"
        },
        {
            "location": "43/TALK",
            "narrator": "神楽",
            "text": "わっ！？",
            "zh": "哇！？",
            "narrator_zh": "神乐"
        },
        {
            "location": "48/TALK",
            "narrator": "みやび",
            "text": "なんや？\n部屋に入ってそうそう\n大声出して…。",
            "zh": "做驷马？\n一进屋就\n这么大惊小怪的……。",
            "narrator_zh": "雅"
        },
        {
            "location": "50/TALK",
            "narrator": "神楽",
            "text": "す、すみません…。\nなんか、凄い部屋だな、\nと思って…。",
            "zh": "对、对不起……。\n总觉得，这房间\n好惊人啊……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "51/TALK",
            "narrator": "みやび",
            "text": "ほぅ…この部屋のよさが\nわかるとは、\n卯月もなかなかやな。",
            "zh": "哦……居然能懂\n这屋子的妙处，\n卯月你也蛮有眼光嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "52/TALK",
            "narrator": "神楽",
            "text": "いや、いいと思っては\nいないんですけど…。",
            "zh": "不，我倒并不是\n觉得它好就是了……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "53/TALK",
            "narrator": "みやび",
            "text": "それより、\nうちになんか用か？",
            "zh": "不说那个，\n找我有驷马事咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "54/TALK",
            "narrator": "神楽",
            "text": "あ、はい…。\nパソコンのことで、\nご相談したくて…。",
            "zh": "啊，是的……。\n关于电脑的事，\n想向你请教一下……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "55/TALK",
            "narrator": "神楽",
            "text": "私の使ってるＰＣ、\nちょっと古いタイプで\nスペックが乏しいんです。",
            "zh": "我用的那台PC\n型号有点老，\n配置不太够看。",
            "narrator_zh": "神乐"
        },
        {
            "location": "57/TALK",
            "narrator": "神楽",
            "text": "なので、みやびさんに\n新しいＰＣを見繕って\nもらえたらな、って。",
            "zh": "所以想请雅\n帮忙挑选一台\n新的PC。",
            "narrator_zh": "神乐"
        },
        {
            "location": "58/TALK",
            "narrator": "みやび",
            "text": "おおっ、予想してたより\n面白そうな相談や。",
            "zh": "哦哦，比我预想的\n还要有意思点嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "59/TALK",
            "narrator": "みやび",
            "text": "ＰＣのことやったら\n力になれるき、安心しぃ。",
            "zh": "PC这方面的事\n我包帮得上忙啵，放心吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "60/TALK",
            "narrator": "神楽",
            "text": "ありがとうございます！",
            "zh": "谢谢你！",
            "narrator_zh": "神乐"
        },
        {
            "location": "61/TALK",
            "narrator": "みやび",
            "text": "で？　そのＰＣを\n使う目的は？",
            "zh": "那么？　你打算拿\n这台PC来干嘛？",
            "narrator_zh": "雅"
        },
        {
            "location": "62/TALK",
            "narrator": "神楽",
            "text": "先日発売した\n画像編集ソフトを\n入れたいんです。",
            "zh": "我想装一个\n前几天刚发售的\n图像编辑软件。",
            "narrator_zh": "神乐"
        },
        {
            "location": "63/TALK",
            "narrator": "みやび",
            "text": "あ～、あれかぁ…。\n確か推奨スペック\n結構高かったなぁ…。",
            "zh": "啊～，那个啊……。\n我记得它推荐配置\n要求还蛮高的嘛……。",
            "narrator_zh": "雅"
        },
        {
            "location": "64/TALK",
            "narrator": "神楽",
            "text": "はい…自分でも、\n探してみたんです。",
            "zh": "是的……我自己也\n试着找过。",
            "narrator_zh": "神乐"
        },
        {
            "location": "65/TALK",
            "narrator": "神楽",
            "text": "でも、どれも私の使ってる\nＰＣより高性能で、\n見分けが付かなくて…。",
            "zh": "可是，每台看起来都比\n我现在用的PC性能高，\n实在分不清区别……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "66/TALK",
            "narrator": "みやび",
            "text": "わからん時には\nむやみに手を出さんで\n正解や。",
            "zh": "没懂的时候\n不瞎伸手乱买\n才是正解咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "67/TALK",
            "narrator": "みやび",
            "text": "ちゅうか、画像編集ソフト\nなんて必要か？",
            "zh": "话说回来，图像编辑软件\n用得着那种东西咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "69/TALK",
            "narrator": "みやび",
            "text": "簡単な写真の加工くらい、\n最初から入っちょる\nソフトで十分やろ？",
            "zh": "简单修个照片什么的，\n系统自带的\n软件就够用了吧？",
            "narrator_zh": "雅"
        },
        {
            "location": "71/TALK",
            "narrator": "神楽",
            "text": "そ、そうなんですけど、\nえっと…。",
            "zh": "是、是这样没错，\n那个……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "72/TALK",
            "narrator": "神楽",
            "text": "…同人誌を作ろうと\n思ってる、なんて\n言ったら。",
            "zh": "……要是我说出\n自己打算画同人志\n什么的。",
            "narrator_zh": "神乐"
        },
        {
            "location": "73/TALK",
            "narrator": "神楽",
            "text": "きっと、一時間後には\nみんなに知られちゃうと\n思うし…。",
            "zh": "搞不好一个小时后\n就会传得大家都知道\n了……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "75/TALK",
            "narrator": "神楽",
            "text": "…形から入るのって、\nモチベーション維持に\n大切だと思いませんか？",
            "zh": "……你不觉得先备齐装备\n对维持创作干劲\n很重要吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "76/TALK",
            "narrator": "みやび",
            "text": "…なるほど。\n卯月にもそういうの\nあるんやね。",
            "zh": "……原来如此。\n卯月你也有这种\n讲究咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "78/TALK",
            "narrator": "みやび",
            "text": "じゃあ、スペック調べて、\n卯月に合いそうなのを\n何台か見つけとくがよ。",
            "zh": "那我回头查查配置，\n挑几台适合你的\n列出来给你咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "79/TALK",
            "narrator": "神楽",
            "text": "はい、連絡待ってますね。\nでは、私はこれで…。",
            "zh": "嗯，那我等你的消息哦。\n那我就先告辞了……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "80/TALK",
            "narrator": "みやび",
            "text": "うん…。",
            "zh": "嗯……。",
            "narrator_zh": "雅"
        },
        {
            "location": "82/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "83/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "85/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "87/TALK",
            "narrator": "みやび",
            "text": "…なんや？\nまだ用事あるが？",
            "zh": "……做驷马？\n还有事咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "90/TALK",
            "narrator": "神楽",
            "text": "いや…改めて見ても、\nやっぱり部屋の中が\n凄いな、って…。",
            "zh": "没有……只是再看一遍，\n还是觉得这房间里\n真是太惊人了……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "91/TALK",
            "narrator": "神楽",
            "text": "最後に片付けたのって、\nいつなんですか？",
            "zh": "你上一次收拾房间，\n是什么时候啊？",
            "narrator_zh": "神乐"
        },
        {
            "location": "92/TALK",
            "narrator": "みやび",
            "text": "？　この整頓しきった\n部屋を片付けろと？",
            "zh": "？　你要我收拾\n这整整齐齐的屋子？",
            "narrator_zh": "雅"
        },
        {
            "location": "93/TALK",
            "narrator": "神楽",
            "text": "整頓しきった部屋！？\nこの部屋が！？",
            "zh": "整整齐齐的屋子！？\n这间屋子！？",
            "narrator_zh": "神乐"
        },
        {
            "location": "94/TALK",
            "narrator": "みやび",
            "text": "…見えんか？",
            "zh": "……你看不出咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "95/TALK",
            "narrator": "神楽",
            "text": "ごめんなさい…。\n散らかった部屋にしか\n見えません…。",
            "zh": "抱歉……。\n在我眼里怎么看都\n只有乱七八糟……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "97/TALK",
            "narrator": "みやび",
            "text": "ふむ…まあ、この部屋を\n使うんはうちやきね。",
            "zh": "唔……嘛，反正这屋子\n是我在用啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "98/TALK",
            "narrator": "みやび",
            "text": "他人からしたら、\n散らかっちょるようにしか\n見えんかもしれん。",
            "zh": "在旁人眼里看来，\n或许只能看出\n一团乱麻吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "100/TALK",
            "narrator": "みやび",
            "text": "けんど、うちにとっては\nこの状態こそが\n最も理に適っちょるんよ。",
            "zh": "但是，对我而言，\n正是这种状态\n才最合情合理咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "101/TALK",
            "narrator": "みやび",
            "text": "なにかする際に、\nその必要な物が\n手の届く範囲にある配置。",
            "zh": "不管想干什么，\n需要的东西全都\n落在伸手就够得着的布局。",
            "narrator_zh": "雅"
        },
        {
            "location": "102/TALK",
            "narrator": "みやび",
            "text": "それがこの部屋や。",
            "zh": "那就是这间屋子咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "103/TALK",
            "narrator": "神楽",
            "text": "…片づけませんか？",
            "zh": "……真的不收拾一下吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "105/TALK",
            "narrator": "みやび",
            "text": "断固拒否ぞね！",
            "zh": "坚决拒绝咧！",
            "narrator_zh": "雅"
        },
        {
            "location": "106/TALK",
            "narrator": "みやび",
            "text": "ちゅうか、卯月の部屋も\nこんなもんやろ？",
            "zh": "话说回来，卯月你的房间\n差不多也这样吧？",
            "narrator_zh": "雅"
        },
        {
            "location": "108/TALK",
            "narrator": "神楽",
            "text": "ちょ！？\nやめてください！",
            "zh": "喂！？\n请别胡说！",
            "narrator_zh": "神乐"
        },
        {
            "location": "109/TALK",
            "narrator": "神楽",
            "text": "誰かに聞かれてたら\n勘違いされちゃうかも\nしれないじゃないですか。",
            "zh": "要是被谁听见了，\n说不定会让人\n误会的呀。",
            "narrator_zh": "神乐"
        },
        {
            "location": "110/TALK",
            "narrator": "みやび",
            "text": "ちゅうことは、\n違うんか？",
            "zh": "照你这么说，\n难道不是咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "111/TALK",
            "narrator": "神楽",
            "text": "ちゃんと片付いてますよ。",
            "zh": "我那里可是收拾得干干净净的哦。",
            "narrator_zh": "神乐"
        },
        {
            "location": "112/TALK",
            "narrator": "みやび",
            "text": "マジか。",
            "zh": "真的假的。",
            "narrator_zh": "雅"
        },
        {
            "location": "113/TALK",
            "narrator": "神楽",
            "text": "マジですよ。\nまあ、自分でお掃除した\nことはないですけど。",
            "zh": "真的哦。\n嘛，虽然我自己从来\n没亲手打扫过就是了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "114/TALK",
            "narrator": "みやび",
            "text": "マジか。",
            "zh": "真的假的。",
            "narrator_zh": "雅"
        },
        {
            "location": "115/TALK",
            "narrator": "神楽",
            "text": "マジですよ。",
            "zh": "真的哦。",
            "narrator_zh": "神乐"
        },
        {
            "location": "117/TALK",
            "narrator": "みやび",
            "text": "お嬢様め…。",
            "zh": "好个大小姐……。",
            "narrator_zh": "雅"
        },
        {
            "location": "118/TALK",
            "narrator": "神楽",
            "text": "とにかく、まともに\n歩く場所くらいは\n確保しましょうよ。",
            "zh": "总之，至少把能\n正经落脚走路的地方\n清出来吧。",
            "narrator_zh": "神乐"
        },
        {
            "location": "119/TALK",
            "narrator": "みやび",
            "text": "だから、この部屋は\nうちにとっては\n整頓されちょるんやって。",
            "zh": "都说了，这屋子\n对我来说就已经是\n收拾得井井有条了嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "121/TALK",
            "narrator": "みやび",
            "text": "うちが暮らすうえで、\nこの配置はまさに\n神配置！",
            "zh": "对我的日常生活来说，\n这套布局简直就是\n神级布局！",
            "narrator_zh": "雅"
        },
        {
            "location": "123/TALK",
            "narrator": "みやび",
            "text": "これ以上うちにあった\n配置なんぞ、\n存在せんのや。",
            "zh": "比这更趁我手的\n布局，那可是\n没得第二份咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "124/SEL",
            "narrator": "（選択肢）",
            "text": "どう見ても汚部屋だ！",
            "zh": "怎么看都是脏乱屋吧！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "125/SEL",
            "narrator": "（選択肢）",
            "text": "$me$の部屋も似た感じだ",
            "zh": "$me$的房间也差不多这样",
            "narrator_zh": "（选项）"
        },
        {
            "location": "126/SEL",
            "narrator": "（選択肢）",
            "text": "掃除したくなる部屋だ",
            "zh": "真是个让人想大扫除的房间",
            "narrator_zh": "（选项）"
        },
        {
            "location": "127/ACT",
            "narrator": "",
            "text": "どう見ても汚部屋だ！",
            "zh": "怎么看都是脏乱屋吧！",
            "narrator_zh": ""
        },
        {
            "location": "144/TALK",
            "narrator": "みやび",
            "text": "相棒おまえもか",
            "zh": "搭档连你也这样吗",
            "narrator_zh": "雅"
        },
        {
            "location": "145/TALK",
            "narrator": "みやび",
            "text": "というより",
            "zh": "倒不如说",
            "narrator_zh": "雅"
        },
        {
            "location": "146/TALK",
            "narrator": "みやび",
            "text": "何故この美しさがわからないのか！？",
            "zh": "为什么看不出这番美感所在！？",
            "narrator_zh": "雅"
        },
        {
            "location": "147/TALK",
            "narrator": "みやび",
            "text": "うちは悲しい",
            "zh": "我很伤心",
            "narrator_zh": "雅"
        },
        {
            "location": "148/TALK",
            "narrator": "みやび",
            "text": "悲しいなぁ",
            "zh": "真伤心啊",
            "narrator_zh": "雅"
        },
        {
            "location": "149/TALK",
            "narrator": "みやび",
            "text": "相棒が",
            "zh": "伤心搭档",
            "narrator_zh": "雅"
        },
        {
            "location": "150/TALK",
            "narrator": "みやび",
            "text": "美的センスゼロで",
            "zh": "居然审美为零",
            "narrator_zh": "雅"
        },
        {
            "location": "162/TALK",
            "narrator": "みやび",
            "text": "…何故誰もこのよさが\nわからんのか？",
            "zh": "……为什么没一个懂\n这屋子好在哪里的？",
            "narrator_zh": "雅"
        },
        {
            "location": "163/TALK",
            "narrator": "神楽",
            "text": "わかる方が少ないと\n思いますよ？",
            "zh": "我觉得能看懂的人\n才是少数吧？",
            "narrator_zh": "神乐"
        },
        {
            "location": "164/ACT",
            "narrator": "",
            "text": "$me$の部屋も似た感じだ",
            "zh": "$me$的房间也差不多这样",
            "narrator_zh": ""
        },
        {
            "location": "181/TALK",
            "narrator": "みやび",
            "text": "なんという奇遇",
            "zh": "何等巧合",
            "narrator_zh": "雅"
        },
        {
            "location": "183/TALK",
            "narrator": "みやび",
            "text": "相棒の部屋も",
            "zh": "搭档的房间竟然也",
            "narrator_zh": "雅"
        },
        {
            "location": "184/TALK",
            "narrator": "みやび",
            "text": "整頓されてるとは",
            "zh": "收拾得如此井井有条",
            "narrator_zh": "雅"
        },
        {
            "location": "186/SEL",
            "narrator": "（選択肢）",
            "text": "使い慣れるとやめられない",
            "zh": "用顺手了就戒不掉",
            "narrator_zh": "（选项）"
        },
        {
            "location": "187/SEL",
            "narrator": "（選択肢）",
            "text": "いや、散らかってるってこと",
            "zh": "不，我的意思是也很乱",
            "narrator_zh": "（选项）"
        },
        {
            "location": "188/ACT",
            "narrator": "",
            "text": "使い慣れるとやめられない",
            "zh": "用顺手了就戒不掉",
            "narrator_zh": ""
        },
        {
            "location": "189/TALK",
            "narrator": "みやび",
            "text": "この場にいたら",
            "zh": "你要是人在这儿",
            "narrator_zh": "雅"
        },
        {
            "location": "190/TALK",
            "narrator": "みやび",
            "text": "抱きしめて",
            "zh": "我一定抱住你",
            "narrator_zh": "雅"
        },
        {
            "location": "191/TALK",
            "narrator": "みやび",
            "text": "チューの嵐だった",
            "zh": "狠狠亲个不停",
            "narrator_zh": "雅"
        },
        {
            "location": "192/TALK",
            "narrator": "みやび",
            "text": "いないのでしない",
            "zh": "人不在就算了",
            "narrator_zh": "雅"
        },
        {
            "location": "193/TALK",
            "narrator": "みやび",
            "text": "残念だが仕方ない",
            "zh": "可惜归可惜，没办法",
            "narrator_zh": "雅"
        },
        {
            "location": "204/TALK",
            "narrator": "神楽",
            "text": "…片付けろ、って\n言われたんですか？",
            "zh": "……他是叫你\n赶紧收拾吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "206/TALK",
            "narrator": "みやび",
            "text": "いや、相棒は\nうちの理解者やった。",
            "zh": "不，搭档才是\n我的知音咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "208/TALK",
            "narrator": "神楽",
            "text": "…似た者同士が\n出会っちゃった、\nってことですね…。",
            "zh": "……也就是说\n同类凑一块去了\n是吧……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "209/ACT",
            "narrator": "",
            "text": "いや、散らかってるってこと",
            "zh": "不，我的意思是也很乱",
            "narrator_zh": ""
        },
        {
            "location": "210/TALK",
            "narrator": "みやび",
            "text": "それは違う",
            "zh": "那不对",
            "narrator_zh": "雅"
        },
        {
            "location": "211/TALK",
            "narrator": "みやび",
            "text": "うちの部屋は",
            "zh": "我的房间是",
            "narrator_zh": "雅"
        },
        {
            "location": "212/TALK",
            "narrator": "みやび",
            "text": "整頓された乱雑さ",
            "zh": "井井有条的杂乱",
            "narrator_zh": "雅"
        },
        {
            "location": "213/TALK",
            "narrator": "みやび",
            "text": "相棒の部屋は",
            "zh": "搭档的房间是",
            "narrator_zh": "雅"
        },
        {
            "location": "214/TALK",
            "narrator": "みやび",
            "text": "混沌とした乱雑さ",
            "zh": "混沌无序的杂乱",
            "narrator_zh": "雅"
        },
        {
            "location": "215/TALK",
            "narrator": "みやび",
            "text": "似て非なるもの",
            "zh": "看似相似实则天差地别",
            "narrator_zh": "雅"
        },
        {
            "location": "216/TALK",
            "narrator": "みやび",
            "text": "一緒にされるのは",
            "zh": "把两者混为一谈",
            "narrator_zh": "雅"
        },
        {
            "location": "217/TALK",
            "narrator": "みやび",
            "text": "不愉快極まりない",
            "zh": "实在令我不快至极",
            "narrator_zh": "雅"
        },
        {
            "location": "218/TALK",
            "narrator": "みやび",
            "text": "激おこである",
            "zh": "气得我都要炸毛了",
            "narrator_zh": "雅"
        },
        {
            "location": "230/TALK",
            "narrator": "みやび",
            "text": "…情けない。",
            "zh": "……真不像话。",
            "narrator_zh": "雅"
        },
        {
            "location": "231/TALK",
            "narrator": "神楽",
            "text": "どうかしたんですか？",
            "zh": "怎么了吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "233/TALK",
            "narrator": "みやび",
            "text": "相棒は自分の部屋を\n整頓もできない、\nだらしないヤツのようや。",
            "zh": "搭档好像是个连自己\n房间都收拾不好、\n邋里邋遢的家伙咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "234/TALK",
            "narrator": "神楽",
            "text": "…それ、自分自身に\n言うべき言葉ですよ。",
            "zh": "……这句话，你最该\n拿来对自己说才对哦。",
            "narrator_zh": "神乐"
        },
        {
            "location": "236/ACT",
            "narrator": "",
            "text": "掃除したくなる部屋だ",
            "zh": "真是个让人想大扫除的房间",
            "narrator_zh": ""
        },
        {
            "location": "253/TALK",
            "narrator": "みやび",
            "text": "掃除するところなど",
            "zh": "需要打扫的地方",
            "narrator_zh": "雅"
        },
        {
            "location": "255/TALK",
            "narrator": "みやび",
            "text": "皆無",
            "zh": "压根没有",
            "narrator_zh": "雅"
        },
        {
            "location": "256/TALK",
            "narrator": "みやび",
            "text": "他人が触れると",
            "zh": "外人一碰",
            "narrator_zh": "雅"
        },
        {
            "location": "257/TALK",
            "narrator": "みやび",
            "text": "逆に汚れる",
            "zh": "反倒会弄脏",
            "narrator_zh": "雅"
        },
        {
            "location": "258/TALK",
            "narrator": "みやび",
            "text": "ドントタッチ",
            "zh": "Don't touch",
            "narrator_zh": "雅"
        },
        {
            "location": "259/TALK",
            "narrator": "みやび",
            "text": "わかったな？",
            "zh": "听明白了吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "270/TALK",
            "narrator": "みやび",
            "text": "…あっ、なるほど。\nそういうことやったか。",
            "zh": "……啊，原来如此。\n是那么一回事咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "271/TALK",
            "narrator": "神楽",
            "text": "はい？",
            "zh": "诶？",
            "narrator_zh": "神乐"
        },
        {
            "location": "273/TALK",
            "narrator": "みやび",
            "text": "今、この部屋は掃除したく\nなる部屋だと言われたん\nやけんど、なるほど。",
            "zh": "刚才有人说这屋子\n是个让人想大扫除的房间，\n原来是这么回事啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "275/TALK",
            "narrator": "みやび",
            "text": "相棒は潔癖症やき、\nこの整頓された部屋を\nさらに掃除したいと――",
            "zh": "搭档有洁癖啵，\n看到这么整洁的房间\n还想打扫得更干净——",
            "narrator_zh": "雅"
        },
        {
            "location": "276/TALK",
            "narrator": "神楽",
            "text": "絶対違います！",
            "zh": "绝对不是！",
            "narrator_zh": "神乐"
        },
        {
            "location": "278/TALK",
            "narrator": "神楽",
            "text": "まったく…そもそも\nアーヤさん達は\nなにも言わないんですか？",
            "zh": "真是的……说到底\n绫水她们\n都不说你两句的吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "279/TALK",
            "narrator": "神楽",
            "text": "絶対に、だらしないから\n掃除しなさい、とか\n言うはずですし…。",
            "zh": "她们肯定会说\n“太邋遢了快去收拾”\n之类的话才对啊……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "280/TALK",
            "narrator": "神楽",
            "text": "真幌さんだって、\nこの部屋を見たら\n大爆発しちゃいますよ。",
            "zh": "就连真幌，\n要是看见这房间\n也肯定会大发雷霆的哦。",
            "narrator_zh": "神乐"
        },
        {
            "location": "281/TALK",
            "narrator": "みやび",
            "text": "まほさんなら\n何度もここに来ちょるよ。",
            "zh": "真幌的话\n可来过这儿好多次了。",
            "narrator_zh": "雅"
        },
        {
            "location": "283/TALK",
            "narrator": "神楽",
            "text": "えっ！？\n怒られなかったん\nですか！？",
            "zh": "诶！？\n她没对你\n发火吗！？",
            "narrator_zh": "神乐"
        },
        {
            "location": "284/TALK",
            "narrator": "みやび",
            "text": "最初は片付けろ\n言うてたけんどな。",
            "zh": "一开始也催我收拾\n来着，但是嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "285/TALK",
            "narrator": "みやび",
            "text": "最後には、床だけは\n抜かない程度にしろ、\n言うて終わりぞね。",
            "zh": "到最后就扔下一句\n“别把地板压塌就成”，\n算完事咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "286/TALK",
            "narrator": "神楽",
            "text": "…それ、諦められた\nだけのような？",
            "zh": "……那只是彻底对你\n死心放弃了吧？",
            "narrator_zh": "神乐"
        },
        {
            "location": "287/TALK",
            "narrator": "神楽",
            "text": "でも、劇場の真幌さんの\n部屋も、すごく散らかって\nますよね？",
            "zh": "不过，剧场里真幌的\n房间，也是乱得\n够厉害的呢？",
            "narrator_zh": "神乐"
        },
        {
            "location": "290/TALK",
            "narrator": "みやび",
            "text": "あ～、そういえば\nまほさん、整頓とか\n苦手そうやきね。",
            "zh": "啊～，说起来也是，\n真幌看着也不太擅长\n收拾屋子啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "291/TALK",
            "narrator": "みやび",
            "text": "あ、だから時々、\nまほさん部屋に来ること\nあるんか。",
            "zh": "啊，所以偶尔\n真幌才会特意跑到\n我这屋里来咩。",
            "narrator_zh": "雅"
        },
        {
            "location": "292/TALK",
            "narrator": "神楽",
            "text": "えぇっ！？\n時々来るんですか？",
            "zh": "诶诶！？\n还会偶尔过来吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "294/TALK",
            "narrator": "みやび",
            "text": "解析作業とか頼まれて、\n結果が出たっちゅうと\nわざわざ来るんよ。",
            "zh": "比方托我解析什么东西，\n等结果一出来，她就\n专程跑过来了。",
            "narrator_zh": "雅"
        },
        {
            "location": "295/TALK",
            "narrator": "みやび",
            "text": "ベッドソファ代わりにして\nわかったこと教えると、\nすぐ帰るけんどな。",
            "zh": "拿我床当沙发靠着，\n等我把查出的东西一说完，\n她马上就回去就是了。",
            "narrator_zh": "雅"
        },
        {
            "location": "297/TALK",
            "narrator": "みやび",
            "text": "そうかぁ…この部屋が\n落ち着くき、わざわざ\nここまでくる…。",
            "zh": "这样啊……是觉得待这屋里\n自在啵，才专程\n跑到这儿来……。",
            "narrator_zh": "雅"
        },
        {
            "location": "298/TALK",
            "narrator": "みやび",
            "text": "やはりまほさんは、\n理解あるボスやねぇ。",
            "zh": "果然真幌是个\n体贴下属的老板咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "300/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "301/TALK",
            "narrator": "神楽",
            "text": "ずぼらな上司と、\nダメな部下。",
            "zh": "懒散的上司，与\n废柴的下属。",
            "narrator_zh": "神乐"
        },
        {
            "location": "303/TALK",
            "narrator": "神楽",
            "text": "二人はみんなに隠れて\n密会し、いつの間にか\nいけない関係へ…。",
            "zh": "两人背着大家\n偷偷幽会，不知不觉间\n滑向禁忌的关系……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "305/TALK",
            "narrator": "神楽",
            "text": "こ、これは…、\n筆が進む展開ですね！",
            "zh": "这、这可是……，\n让人下笔停不下来的展开呢！",
            "narrator_zh": "神乐"
        },
        {
            "location": "308/TALK",
            "narrator": "みやび",
            "text": "は？　なにが進むって？",
            "zh": "哈？　什么停不下来？",
            "narrator_zh": "雅"
        },
        {
            "location": "310/TALK",
            "narrator": "神楽",
            "text": "いえ！\nごちそうさまでした、\nみやびさん！",
            "zh": "没什么！\n多谢款待，\n雅！",
            "narrator_zh": "神乐"
        }
    ]
}
