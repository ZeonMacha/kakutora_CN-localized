{
    "dir": "chap06/daydra/dd_ch04_06_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "6412",
        "cid": "miyabi",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "ＰＣ不調",
        "title_zh": "Extra006 额外剧情",
        "sub_title_zh": "电脑故障"
    },
    "entry": [
        {
            "location": "139/SCENARIO",
            "narrator": "",
            "text": "ＰＣ不調",
            "zh": "电脑故障",
            "narrator_zh": ""
        },
        {
            "location": "150/TALK",
            "narrator": "アーヤ",
            "text": "…どう、\n直りそうかしら？",
            "zh": "……怎么样，\n修得好吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "152/TALK",
            "narrator": "みやび",
            "text": "ふむ…安心しい。\nこのノートＰＣは\n壊れちょらんき。",
            "zh": "嗯……放心。\n这台笔记本电脑\n没坏啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "154/TALK",
            "narrator": "みやび",
            "text": "ただ、スペックが\n激低で、何をするんも\n時間が掛かるだけやき。",
            "zh": "只是配置\n算低了，干什么\n都费时间啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "155/TALK",
            "narrator": "アーヤ",
            "text": "…そんなに低いの？",
            "zh": "……有那么低？",
            "narrator_zh": "绫水"
        },
        {
            "location": "157/TALK",
            "narrator": "みやび",
            "text": "ああ、かなり低いなぁ。\n新しそうやけんど、\nまさか買ってすぐなが？",
            "zh": "啊，相当低。\n看起来挺新，但是，\n难道是刚买的咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "158/TALK",
            "narrator": "アーヤ",
            "text": "少し前に\n買ったばかりよ。",
            "zh": "不久前\n刚买的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "159/TALK",
            "narrator": "アーヤ",
            "text": "店員さんに薦められて、\n値段もお手ごろだった\nからいいかなって…。",
            "zh": "店员推荐的，\n价钱也合适，\n就觉得可以……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "160/TALK",
            "narrator": "アーヤ",
            "text": "どうにか\nならないかしら？",
            "zh": "有没有办法\n想想？",
            "narrator_zh": "绫水"
        },
        {
            "location": "163/TALK",
            "narrator": "みやび",
            "text": "…そうやなぁ？",
            "zh": "……是咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "164/SEL",
            "narrator": "",
            "text": "お手上げ、と言おう",
            "zh": "就说没办法了",
            "narrator_zh": ""
        },
        {
            "location": "165/SEL",
            "narrator": "",
            "text": "どうにかしてあげて",
            "zh": "帮她想想办法",
            "narrator_zh": ""
        },
        {
            "location": "166/SEL",
            "narrator": "",
            "text": "腕の見せ所ですぜ！",
            "zh": "该露一手了！",
            "narrator_zh": ""
        },
        {
            "location": "169/TALK",
            "narrator": "みやび",
            "text": "そもそも、これで何を\nしよう思うて買ったが？",
            "zh": "说到底，买这个\n是想用来做什么？",
            "narrator_zh": "雅"
        },
        {
            "location": "171/TALK",
            "narrator": "アーヤ",
            "text": "レポートとか書いたり、\nあとはネットを\n見るためかしら。",
            "zh": "写报告之类，\n还有上网\n看看吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "172/TALK",
            "narrator": "みやび",
            "text": "なるほど、基本文章を\n書くためか…。",
            "zh": "原来如此，主要是为了\n写文章……。",
            "narrator_zh": "雅"
        },
        {
            "location": "173/TALK",
            "narrator": "みやび",
            "text": "けんど、このスペック\nやとそれだけでもスト\nレス溜まりそうやね。",
            "zh": "但是，这种配置\n光干这个就会\n攒下一肚子火咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "174/TALK",
            "narrator": "アーヤ",
            "text": "だから困ってるのよ。\n本当、\nどうにかならない？",
            "zh": "所以才为难。\n真的，\n没有办法吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "178/TALK",
            "narrator": "みやび",
            "text": "…今よりもちっくと\nマシに思えるくらい\nにはできそうやけんど―",
            "zh": "……比现在稍微\n像样一点，\n大概做得到，但是—",
            "narrator_zh": "雅"
        },
        {
            "location": "180/TALK",
            "narrator": "みやび",
            "text": "それで構わんか？",
            "zh": "这样得咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "182/TALK",
            "narrator": "アーヤ",
            "text": "文字を打つのと、\nネットを快適に\n見られれば十分よ。",
            "zh": "打字，\n还有能舒服地上网，\n就够了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "183/TALK",
            "narrator": "みやび",
            "text": "まあ、それくらいなら\n多分どうにかなるちや。",
            "zh": "嘛，就这些的话\n大概有办法滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "184/TALK",
            "narrator": "みやび",
            "text": "不要なソフトを消すき、\nそれで幾分かは\n軽くなるはずや。",
            "zh": "把没用的软件删掉啵，\n这样多少\n会轻一点。",
            "narrator_zh": "雅"
        },
        {
            "location": "186/TALK",
            "narrator": "アーヤ",
            "text": "よかった…\n本当、みやびが\nいてくれて助かったわ。",
            "zh": "太好了……\n真的，有雅在\n帮了大忙。",
            "narrator_zh": "绫水"
        },
        {
            "location": "187/TALK",
            "narrator": "みやび",
            "text": "まあ、今度ＰＣ買う\n時は、うちに聞いて\nからにしい。",
            "zh": "嘛，下次买电脑\n的时候，先问我\n再买。",
            "narrator_zh": "雅"
        },
        {
            "location": "189/ACT",
            "narrator": "",
            "text": "お手上げ、と言おう",
            "zh": "就说没办法了",
            "narrator_zh": ""
        },
        {
            "location": "209/TALK",
            "narrator": "みやび",
            "text": "…そうやね",
            "zh": "……是咯",
            "narrator_zh": "雅"
        },
        {
            "location": "210/TALK",
            "narrator": "みやび",
            "text": "このスペックじゃ、何したところで高が知れてるき",
            "zh": "这种配置，干什么都算有限了啵",
            "narrator_zh": "雅"
        },
        {
            "location": "222/TALK",
            "narrator": "みやび",
            "text": "…すまんなぁ。\nさすがにこれは、\nお手上げ状態ちや。",
            "zh": "……没好意思。\n这个确实，\n只能举白旗滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "223/TALK",
            "narrator": "みやび",
            "text": "エラーや変なソフトが\n原因いうなら、対処は\nできたけんど――",
            "zh": "要是报错或者怪软件\n的原因，还能处理，\n但是——",
            "narrator_zh": "雅"
        },
        {
            "location": "225/TALK",
            "narrator": "みやび",
            "text": "元々低い性能をどうにか\nするいうんは、もう改造\nするしかないがよ。",
            "zh": "要把本来就低的性能\n想办法提上去，只能改造\n了。",
            "narrator_zh": "雅"
        },
        {
            "location": "228/TALK",
            "narrator": "アーヤ",
            "text": "そう…。",
            "zh": "这样啊……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "229/TALK",
            "narrator": "みやび",
            "text": "すまんね。",
            "zh": "没好意思。",
            "narrator_zh": "雅"
        },
        {
            "location": "231/TALK",
            "narrator": "アーヤ",
            "text": "ううん、いいのよ。\n安かったし、いい勉強\nにもなったから――",
            "zh": "不，没关系。\n便宜，也算\n长了教训——",
            "narrator_zh": "绫水"
        },
        {
            "location": "233/TALK",
            "narrator": "アーヤ",
            "text": "次からはあまり安い物を\n買わないようにするわ。",
            "zh": "下次不会再买\n太便宜的东西了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "234/TALK",
            "narrator": "みやび",
            "text": "値段やのうて、まずは\nスペックを確認しい。",
            "zh": "不是看价钱，先\n确认配置。",
            "narrator_zh": "雅"
        },
        {
            "location": "235/ACT",
            "narrator": "",
            "text": "どうにかしてあげて",
            "zh": "帮她想想办法",
            "narrator_zh": ""
        },
        {
            "location": "256/TALK",
            "narrator": "みやび",
            "text": "どうにか言われてもなぁ…",
            "zh": "你说想想办法……",
            "narrator_zh": "雅"
        },
        {
            "location": "257/TALK",
            "narrator": "みやび",
            "text": "まあ、やれる限りはやってみるがよ",
            "zh": "嘛，能做的我会做",
            "narrator_zh": "雅"
        },
        {
            "location": "270/TALK",
            "narrator": "みやび",
            "text": "今よりもちっくとマシに\n思えるくらいには\nできそうやけんど――",
            "zh": "……比现在稍微\n像样一点\n大概做得到，但是——",
            "narrator_zh": "雅"
        },
        {
            "location": "271/TALK",
            "narrator": "みやび",
            "text": "それで構わんか？",
            "zh": "这样得咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "272/TALK",
            "narrator": "アーヤ",
            "text": "文字を打つのと、\nネットを快適に\n見られれば十分よ。",
            "zh": "打字，\n还有能舒服地上网，\n就够了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "273/TALK",
            "narrator": "みやび",
            "text": "まあ、それくらいなら\n多分どうにかなるちや。",
            "zh": "嘛，就这些的话\n大概有办法滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "274/TALK",
            "narrator": "みやび",
            "text": "不要なソフトを消すき、\nそれで幾分かは\n軽くなるはずや。",
            "zh": "把没用的软件删掉啵，\n这样多少\n会轻一点。",
            "narrator_zh": "雅"
        },
        {
            "location": "276/TALK",
            "narrator": "アーヤ",
            "text": "よかった…\n本当、みやびが\nいてくれて助かったわ。",
            "zh": "太好了……\n真的，有雅在\n帮了大忙。",
            "narrator_zh": "绫水"
        },
        {
            "location": "277/TALK",
            "narrator": "みやび",
            "text": "まあ、今度ＰＣ買う\n時は、うちに聞いて\nからにしい。",
            "zh": "嘛，下次买电脑\n的时候，先问我\n再买。",
            "narrator_zh": "雅"
        },
        {
            "location": "278/ACT",
            "narrator": "",
            "text": "腕の見せ所ですぜ！",
            "zh": "该露一手了！",
            "narrator_zh": ""
        },
        {
            "location": "300/TALK",
            "narrator": "みやび",
            "text": "面白いこと言うやないか、相棒…",
            "zh": "说得挺有意思啊，搭档……",
            "narrator_zh": "雅"
        },
        {
            "location": "302/TALK",
            "narrator": "みやび",
            "text": "…うちの本気、よう見とけや！！",
            "zh": "……我的认真，给我看好了！！",
            "narrator_zh": "雅"
        },
        {
            "location": "313/TALK",
            "narrator": "みやび",
            "text": "よっしゃ、とりあえず\nバラすところから\n始めるぞね。",
            "zh": "好，总之\n从拆开\n开始啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "314/TALK",
            "narrator": "アーヤ",
            "text": "は？　バラすって…\nまさか分解！？",
            "zh": "哈？　拆开……\n难道是拆机！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "316/TALK",
            "narrator": "みやび",
            "text": "アーヤ、辛いと思うが\nハッキリ言わせてもらう\nけんど――",
            "zh": "绫水，这话不好听，\n我还是说清楚，\n但是——",
            "narrator_zh": "雅"
        },
        {
            "location": "319/TALK",
            "narrator": "みやび",
            "text": "こんなクソスペック\nＰＣ、弄る程度では\nなーんも変わらんちや！",
            "zh": "这种垃圾配置的\n电脑，光调一调\n什么都不会变滴！",
            "narrator_zh": "雅"
        },
        {
            "location": "320/TALK",
            "narrator": "みやび",
            "text": "やるならハードから\nゴッソリ変えな意味が\nないぞね。",
            "zh": "要做就从硬件\n整套换掉，不然\n没意义啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "321/TALK",
            "narrator": "みやび",
            "text": "パーツはうちの部屋に\nある最新の物を使うき、\n安心してえいよ。",
            "zh": "零件用我房间里\n最新的啵，\n放心，得咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "323/TALK",
            "narrator": "アーヤ",
            "text": "い、いいわよ別に！\nそこまで大げさなこと\nしなくても…。",
            "zh": "不、不用了！\n不必做到\n那么夸张……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "324/TALK",
            "narrator": "みやび",
            "text": "そこまでせんと、\nこいつは最強ＰＣに\n生まれ変われん！",
            "zh": "不做到那一步，\n这家伙变不成\n最强电脑！",
            "narrator_zh": "雅"
        },
        {
            "location": "327/TALK",
            "narrator": "アーヤ",
            "text": "最強にしてなんて\n言ってないでしょ！？",
            "zh": "我可没说\n要做成最强！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "328/TALK",
            "narrator": "みやび",
            "text": "とにかく、うちは\nこいつを超ハイ\nスペックに改造する！",
            "zh": "总之，我要把\n这家伙改成\n超高配置！",
            "narrator_zh": "雅"
        },
        {
            "location": "329/TALK",
            "narrator": "みやび",
            "text": "こんなにヤル気に\nなったん久しぶりやき。",
            "zh": "这么有干劲，\n好久没有了啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "330/TALK",
            "narrator": "みやび",
            "text": "大船に乗った気で\n待っとれ。",
            "zh": "就放心\n等着吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "333/TALK",
            "narrator": "アーヤ",
            "text": "…止めるのは\n無理そうね。",
            "zh": "……看来拦不住\n了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "336/TALK",
            "narrator": "アーヤ",
            "text": "せめて、ＯＳだけは\n変なの入れないでね？",
            "zh": "至少，OS\n别装奇怪的，好吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "148/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>5月12日　7:44 PM</color>\nとある夜、アーヤの部屋で。",
            "zh": "<color=green>5月12日　7:44 PM</color>\n某个夜里，在绫水的房间。",
            "narrator_zh": "Dialog_EventData"
        },
        {
            "location": "347/DIALOG",
            "narrator": "Dialog_GEThimegoto_ch04",
            "text": "【うちのマシンが火を噴く、か？】",
            "zh": "【我家的机器会喷火，是吗？】",
            "narrator_zh": "Dialog_GEThimegoto_ch04"
        }
    ]
}
