    },
    "entry": [
        {
            "location": "689/SCENARIO",
            "narrator": "",
            "text": "パラレルパラレルパラレルパラレル",
            "zh": "平行平行平行平行",
            "narrator_zh": ""
        },
        {
            "location": "708/TALK",
            "narrator": "みやび",
            "text": "さっきは\n$handle$に変なこと\n言うてしもた…。",
            "zh": "刚才\n对$handle$说了\n奇怪的话……。",
            "narrator_zh": "雅"
        },
        {
            "location": "709/TALK",
            "narrator": "みやび",
            "text": "あれでは不思議ちゃんや\nのうて電波ちゃんやき。",
            "zh": "那已经不是神秘系\n而是电波系了啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "710/TALK",
            "narrator": "みやび",
            "text": "弁明しておく\nべきやろうね。",
            "zh": "应该先辩解一下\n才行吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "723/TALK",
            "narrator": "みやび",
            "text": "先ほどの話だが",
            "zh": "关于刚才那番话",
            "narrator_zh": "雅"
        },
        {
            "location": "724/TALK",
            "narrator": "みやび",
            "text": "結論から言おう",
            "zh": "先说结论",
            "narrator_zh": "雅"
        },
        {
            "location": "725/TALK",
            "narrator": "みやび",
            "text": "なごちゃんについては保留",
            "zh": "七五的情况保留判断",
            "narrator_zh": "雅"
        },
        {
            "location": "726/TALK",
            "narrator": "みやび",
            "text": "$handle$については存在を確認済み",
            "zh": "$handle$的存在已确认",
            "narrator_zh": "雅"
        },
        {
            "location": "727/TALK",
            "narrator": "みやび",
            "text": "以上",
            "zh": "以上",
            "narrator_zh": "雅"
        },
        {
            "location": "740/SEL",
            "narrator": "",
            "text": "ちょっと待って",
            "zh": "等一下",
            "narrator_zh": ""
        },
        {
            "location": "741/ACT",
            "narrator": "",
            "text": "ちょっと待って",
            "zh": "等一下",
            "narrator_zh": ""
        },
        {
            "location": "758/TALK",
            "narrator": "みやび",
            "text": "ぬ",
            "zh": "唔？",
            "narrator_zh": "雅"
        },
        {
            "location": "759/SEL",
            "narrator": "",
            "text": "過程も説明して",
            "zh": "过程也要说明",
            "narrator_zh": ""
        },
        {
            "location": "760/SEL",
            "narrator": "",
            "text": "$me$の疑惑は晴れたみたいだけど",
            "zh": "$me$的嫌疑倒像是洗清了",
            "narrator_zh": ""
        },
        {
            "location": "761/SEL",
            "narrator": "",
            "text": "もう少し詳しく！",
            "zh": "再详细说说！",
            "narrator_zh": ""
        },
        {
            "location": "762/ACT",
            "narrator": "",
            "text": "過程も説明して",
            "zh": "过程也要说明",
            "narrator_zh": ""
        },
        {
            "location": "763/TALK",
            "narrator": "みやび",
            "text": "了解した",
            "zh": "了解",
            "narrator_zh": "雅"
        },
        {
            "location": "764/ACT",
            "narrator": "",
            "text": "$me$の疑惑は晴れたみたいだけど",
            "zh": "$me$的嫌疑倒像是洗清了",
            "narrator_zh": ""
        },
        {
            "location": "766/TALK",
            "narrator": "みやび",
            "text": "すまんかった",
            "zh": "没好意思了",
            "narrator_zh": "雅"
        },
        {
            "location": "767/ACT",
            "narrator": "",
            "text": "もう少し詳しく！",
            "zh": "再详细说说！",
            "narrator_zh": ""
        },
        {
            "location": "768/TALK",
            "narrator": "みやび",
            "text": "ふむ",
            "zh": "唔",
            "narrator_zh": "雅"
        },
        {
            "location": "770/TALK",
            "narrator": "みやび",
            "text": "まずはなごちゃんの件",
            "zh": "先说七五的事",
            "narrator_zh": "雅"
        },
        {
            "location": "771/TALK",
            "narrator": "みやび",
            "text": "うちはうちの感覚を信じる",
            "zh": "我相信自己的感觉",
            "narrator_zh": "雅"
        },
        {
            "location": "772/TALK",
            "narrator": "みやび",
            "text": "五感、プラス魂や",
            "zh": "五感，外加灵魂",
            "narrator_zh": "雅"
        },
        {
            "location": "773/TALK",
            "narrator": "みやび",
            "text": "それで確認できたものこそがうちにとっての事実",
            "zh": "能以此确认到的东西，才是我认定的事实",
            "narrator_zh": "雅"
        },
        {
            "location": "774/TALK",
            "narrator": "みやび",
            "text": "なごちゃんの死は",
            "zh": "七五的死",
            "narrator_zh": "雅"
        },
        {
            "location": "776/TALK",
            "narrator": "みやび",
            "text": "そのいずれでも感じ取れておらん",
            "zh": "哪一样都没感觉到",
            "narrator_zh": "雅"
        },
        {
            "location": "777/TALK",
            "narrator": "みやび",
            "text": "やき",
            "zh": "所以说啵",
            "narrator_zh": "雅"
        },
        {
            "location": "778/TALK",
            "narrator": "みやび",
            "text": "保留ぞね",
            "zh": "保留判断咧",
            "narrator_zh": "雅"
        },
        {
            "location": "780/SEL",
            "narrator": "",
            "text": "ふむ",
            "zh": "唔",
            "narrator_zh": ""
        },
        {
            "location": "781/SEL",
            "narrator": "",
            "text": "なるほど",
            "zh": "原来如此",
            "narrator_zh": ""
        },
        {
            "location": "782/SEL",
            "narrator": "",
            "text": "そういう理論",
            "zh": "原来是这种理论",
            "narrator_zh": ""
        },
        {
            "location": "783/ACT",
            "narrator": "",
            "text": "ふむ",
            "zh": "唔",
            "narrator_zh": ""
        },
        {
            "location": "784/TALK",
            "narrator": "みやび",
            "text": "そういうことだ",
            "zh": "就是这么回事",
            "narrator_zh": "雅"
        },
        {
            "location": "785/ACT",
            "narrator": "",
            "text": "なるほど",
            "zh": "原来如此",
            "narrator_zh": ""
        },
        {
            "location": "786/TALK",
            "narrator": "みやび",
            "text": "ご理解いただけたかの",
            "zh": "承蒙理解了咯",
            "narrator_zh": "雅"
        },
        {
            "location": "787/ACT",
            "narrator": "",
            "text": "そういう理論",
            "zh": "原来是这种理论",
            "narrator_zh": ""
        },
        {
            "location": "788/TALK",
            "narrator": "みやび",
            "text": "みやびさん理論ぞね",
            "zh": "雅式理论咧",
            "narrator_zh": "雅"
        },
        {
            "location": "790/TALK",
            "narrator": "みやび",
            "text": "次に$handle$",
            "zh": "接下来是$handle$",
            "narrator_zh": "雅"
        },
        {
            "location": "791/TALK",
            "narrator": "みやび",
            "text": "これは五感で感じたことはない",
            "zh": "这个五感从没感觉到过",
            "narrator_zh": "雅"
        },
        {
            "location": "792/TALK",
            "narrator": "みやび",
            "text": "しかし魂は確認済み",
            "zh": "但灵魂已确认到位",
            "narrator_zh": "雅"
        },
        {
            "location": "793/TALK",
            "narrator": "みやび",
            "text": "これこそ新しいリアル",
            "zh": "这才是崭新的现实",
            "narrator_zh": "雅"
        },
        {
            "location": "794/TALK",
            "narrator": "みやび",
            "text": "魂のシンギュラリティ",
            "zh": "灵魂的奇点",
            "narrator_zh": "雅"
        },
        {
            "location": "795/TALK",
            "narrator": "みやび",
            "text": "ヒト意識上の技術的特異点",
            "zh": "人类意识上的技术特异点",
            "narrator_zh": "雅"
        },
        {
            "location": "797/SEL",
            "narrator": "",
            "text": "はあ",
            "zh": "哈啊",
            "narrator_zh": ""
        },
        {
            "location": "798/SEL",
            "narrator": "",
            "text": "わかるようなわかんないような",
            "zh": "好像懂了又好像没懂",
            "narrator_zh": ""
        },
        {
            "location": "799/SEL",
            "narrator": "",
            "text": "なんとなく格好いいからいいか",
            "zh": "感觉挺帅的，那就这样吧",
            "narrator_zh": ""
        },
        {
            "location": "800/ACT",
            "narrator": "",
            "text": "はあ",
            "zh": "哈啊",
            "narrator_zh": ""
        },
        {
            "location": "801/TALK",
            "narrator": "みやび",
            "text": "なんともまあ",
            "zh": "哎呀真是",
            "narrator_zh": "雅"
        },
        {
            "location": "802/TALK",
            "narrator": "みやび",
            "text": "よいお返事だこと",
            "zh": "回答得可真好呀",
            "narrator_zh": "雅"
        },
        {
            "location": "803/ACT",
            "narrator": "",
            "text": "わかるようなわかんないような",
            "zh": "好像懂了又好像没懂",
            "narrator_zh": ""
        },
        {
            "location": "804/TALK",
            "narrator": "みやび",
            "text": "理解しようとするな",
            "zh": "别去理解",
            "narrator_zh": "雅"
        },
        {
            "location": "805/TALK",
            "narrator": "みやび",
            "text": "感じろ",
            "zh": "去感受",
            "narrator_zh": "雅"
        },
        {
            "location": "806/ACT",
            "narrator": "",
            "text": "なんとなく格好いいからいいか",
            "zh": "感觉挺帅的，那就这样吧",
            "narrator_zh": ""
        },
        {
            "location": "808/TALK",
            "narrator": "みやび",
            "text": "それそれ",
            "zh": "对对就是这样",
            "narrator_zh": "雅"
        },
        {
            "location": "809/TALK",
            "narrator": "みやび",
            "text": "めっちゃ大事",
            "zh": "超级重要",
            "narrator_zh": "雅"
        },
        {
            "location": "810/TALK",
            "narrator": "みやび",
            "text": "たぶん",
            "zh": "大概",
            "narrator_zh": "雅"
        },
        {
            "location": "812/TALK",
            "narrator": "みやび",
            "text": "なんというか",
            "zh": "该怎么说呢",
            "narrator_zh": "雅"
        },
        {
            "location": "813/TALK",
            "narrator": "みやび",
            "text": "相棒は常にうちの側におる",
            "zh": "搭档永远都在我身边",
            "narrator_zh": "雅"
        },
        {
            "location": "814/TALK",
            "narrator": "みやび",
            "text": "この目には見えなくても",
            "zh": "就算这双眼睛看不见",
            "narrator_zh": "雅"
        },
        {
            "location": "815/TALK",
            "narrator": "みやび",
            "text": "魂では感じておる",
            "zh": "灵魂也能感觉到",
            "narrator_zh": "雅"
        },
        {
            "location": "816/TALK",
            "narrator": "みやび",
            "text": "つまり$handle$は実在する",
            "zh": "也就是说$handle$是真实存在的",
            "narrator_zh": "雅"
        },
        {
            "location": "817/TALK",
            "narrator": "みやび",
            "text": "そして",
            "zh": "而",
            "narrator_zh": "雅"
        },
        {
            "location": "818/TALK",
            "narrator": "みやび",
            "text": "今現在まで目視できんのは",
            "zh": "至今没法亲眼看见",
            "narrator_zh": "雅"
        },
        {
            "location": "819/TALK",
            "narrator": "みやび",
            "text": "この世界がバグっておるからであろう",
            "zh": "是因为这个世界出着bug吧",
            "narrator_zh": "雅"
        },
        {
            "location": "820/TALK",
            "narrator": "みやび",
            "text": "うちはそう結論づけた",
            "zh": "我是这么下的结论",
            "narrator_zh": "雅"
        },
        {
            "location": "832/TALK",
            "narrator": "透明アーヤ",
            "text": "ギャヴィ、みやび。\n館長から準備完了の\n連絡があったわ。",
            "zh": "加维，雅。\n馆长那边\n准备完成的联络来了。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "833/TALK",
            "narrator": "透明アーヤ",
            "text": "サイネージに館長が\n映し出されたら\n救出開始よ。",
            "zh": "等馆长被投到\n大屏幕上，\n救出行动就开始了。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "834/TALK",
            "narrator": "透明ガブリエラ",
            "text": "ふうん。\nまほもやる時はやるわね。",
            "zh": "哦。\n真幌该出手时还真出手呢。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "836/TALK",
            "narrator": "みやび",
            "text": "いっつもそうやったら\n肩が凝って\n仕方ないろう。",
            "zh": "要一直都这样，\n肩膀还不得\n僵硬死啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "837/TALK",
            "narrator": "みやび",
            "text": "うちみたいに。",
            "zh": "就像我这样。",
            "narrator_zh": "雅"
        },
        {
            "location": "838/TALK",
            "narrator": "透明アーヤ",
            "text": "……スタンバイ。\n各人、構えよ。",
            "zh": "……各就各位。\n大家，做好准备。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "853/TALK",
            "narrator": "みやび",
            "text": "これが終わったら",
            "zh": "等这事结束",
            "narrator_zh": "雅"
        },
        {
            "location": "854/TALK",
            "narrator": "みやび",
            "text": "この世界のデバッグをせんといかんね",
            "zh": "就得给这个世界除错才行呢",
            "narrator_zh": "雅"
        },
        {
            "location": "855/TALK",
            "narrator": "みやび",
            "text": "二人のために",
            "zh": "为了她们两个",
            "narrator_zh": "雅"
        },
        {
            "location": "866/TALK",
            "narrator": "みやび",
            "text": "発煙手榴弾の\n安全ロック解除。",
            "zh": "发烟手榴弹，\n解除保险。",
            "narrator_zh": "雅"
        },
        {
            "location": "867/TALK",
            "narrator": "みやび",
            "text": "いつでも行けるき。",
            "zh": "随时都能上啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "868/TALK",
            "narrator": "透明ガブリエラ",
            "text": "望むところよ。",
            "zh": "正合我意。",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "869/TALK",
            "narrator": "透明アーヤ",
            "text": "…お願い。",
            "zh": "……拜托了。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "870/TALK",
            "narrator": "みやび",
            "text": "オッケー。\n…発破！",
            "zh": "OK。\n……起爆！",
            "narrator_zh": "雅"
        },
        {
            "location": "877/TALK",
            "narrator": "みやび",
            "text": "相棒を\nあんまり待たせる\nわけにはいかんき。",
            "zh": "可不能让搭档\n等太久\n啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "878/TALK",
            "narrator": "みやび",
            "text": "こじゃんと片付けて\nしまわんとね…！",
            "zh": "得漂漂亮亮地\n收拾干净才行呐…！",
            "narrator_zh": "雅"
        },
        {
            "location": "894/DIALOG",
            "narrator": "Dialog_chapter_ch04",
            "text": "【27 シン・カグラ】",
            "zh": "【27 新·神乐】",
            "narrator_zh": "Dialog_chapter_ch04"
        }
    ]
