{
    "dir": "chap15/daydra/dd_ch03_15_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "15356",
        "cid": "gabriella",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "展覧会",
        "title_zh": "Extra006 额外剧情",
        "sub_title_zh": "展览会"
    },
    "entry": [
        {
            "location": "267/SCENARIO",
            "narrator": "",
            "text": "展覧会",
            "zh": "展览会",
            "narrator_zh": ""
        },
        {
            "location": "279/TALK",
            "narrator": "ガブリエラ",
            "text": "…マズいわ。\n道に迷ったかも。",
            "zh": "……糟了。\n我好像迷路了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "291/TALK",
            "narrator": "ガブリエラ",
            "text": "$marzanna$、私が今いる位置ってわかる？",
            "zh": "$marzanna$，你知道我现在在什么位置吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "293/SEL",
            "narrator": "",
            "text": "受信できないからわからない",
            "zh": "接收不到定位所以我也不知道",
            "narrator_zh": ""
        },
        {
            "location": "294/ACT",
            "narrator": "",
            "text": "受信できないからわからない",
            "zh": "接收不到定位所以我也不知道",
            "narrator_zh": ""
        },
        {
            "location": "296/TALK",
            "narrator": "ガブリエラ",
            "text": "うそっ！？　どうしよう…",
            "zh": "不会吧！？　这下怎么办……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "297/TALK",
            "narrator": "ガブリエラ",
            "text": "何とかならない？",
            "zh": "不能想想办法吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "298/TALK",
            "narrator": "ガブリエラ",
            "text": "このあたりって慣れてないから、どこに何があるのかよくわからないの",
            "zh": "这一带我还不熟，完全搞不清哪儿有什么呀",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "300/SEL",
            "narrator": "",
            "text": "健闘を祈ってるよ",
            "zh": "祝你好运咯",
            "narrator_zh": ""
        },
        {
            "location": "301/ACT",
            "narrator": "",
            "text": "健闘を祈ってるよ",
            "zh": "祝你好运咯",
            "narrator_zh": ""
        },
        {
            "location": "303/TALK",
            "narrator": "ガブリエラ",
            "text": "もぉ、肝心な時に役立たずなんだから！",
            "zh": "真是的，关键时刻净派不上用场！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "316/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…どうしよう？",
            "zh": "唉……怎么办才好呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "320/TALK",
            "narrator": "繭",
            "text": "ガブリエラ。",
            "zh": "加布里埃拉。",
            "narrator_zh": "茧"
        },
        {
            "location": "322/TALK",
            "narrator": "ガブリエラ",
            "text": "えっ…繭！？",
            "zh": "咦……茧！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "323/TALK",
            "narrator": "繭",
            "text": "やっぱり…見覚えのある\n後姿だったから、\nもしやと思ったけど――",
            "zh": "果然……看着背影\n挺眼熟的，\n我还想着莫非是你——",
            "narrator_zh": "茧"
        },
        {
            "location": "324/TALK",
            "narrator": "ガブリエラ",
            "text": "あんた、\nここで何してるの？",
            "zh": "你呀，\n怎么会在这儿？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "326/TALK",
            "narrator": "繭",
            "text": "バイト…っ！",
            "zh": "打工……！",
            "narrator_zh": "茧"
        },
        {
            "location": "328/TALK",
            "narrator": "ガブリエラ",
            "text": "？",
            "zh": "？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "331/TALK",
            "narrator": "繭",
            "text": "…何でもない。\nガブリエラこそ、\nここで何をしてるの？",
            "zh": "……没什么。\n倒是加布里埃拉，\n你在这儿干嘛呢？",
            "narrator_zh": "茧"
        },
        {
            "location": "332/TALK",
            "narrator": "ガブリエラ",
            "text": "何って、えっと…。",
            "zh": "干嘛……那个……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "334/TALK",
            "narrator": "繭",
            "text": "…迷子？",
            "zh": "……迷路了？",
            "narrator_zh": "茧"
        },
        {
            "location": "337/TALK",
            "narrator": "ガブリエラ",
            "text": "ち、違うわ！\n今やってる浮世絵展に\n行くところよ。",
            "zh": "才、才不是呢！\n我是要去正在举办的\n浮世绘展啦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "338/TALK",
            "narrator": "繭",
            "text": "ああ…一丁目の方で\nやってる、あれね。",
            "zh": "啊啊……在一丁目那边\n办的那个展吧。",
            "narrator_zh": "茧"
        },
        {
            "location": "339/TALK",
            "narrator": "ガブリエラ",
            "text": "知ってるの？",
            "zh": "你知道吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "340/TALK",
            "narrator": "繭",
            "text": "駅前にポスターが\n貼ってあったし…。",
            "zh": "车站前贴着\n海报嘛……。",
            "narrator_zh": "茧"
        },
        {
            "location": "341/TALK",
            "narrator": "繭",
            "text": "っていうか、\nこっちは５丁目だから、\n全然方向が違う。",
            "zh": "话说回来，\n这边可是5丁目，\n方向完全反了。",
            "narrator_zh": "茧"
        },
        {
            "location": "343/TALK",
            "narrator": "ガブリエラ",
            "text": "ご、５丁目？\nそれって、えっと…。",
            "zh": "五、5丁目？\n也就是说，那个……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "344/TALK",
            "narrator": "繭",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "茧"
        },
        {
            "location": "345/TALK",
            "narrator": "繭",
            "text": "こっちよ。",
            "zh": "这边走。",
            "narrator_zh": "茧"
        },
        {
            "location": "349/TALK",
            "narrator": "ガブリエラ",
            "text": "あっ…",
            "zh": "啊……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "351/TALK",
            "narrator": "ガブリエラ",
            "text": "…もぅ、大きな街って\nわかりにくいのよ…。",
            "zh": "……真是的，大城市就是\n容易让人摸不着头脑嘛……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "363/TALK",
            "narrator": "繭",
            "text": "…ここよ。",
            "zh": "……就是这里了。",
            "narrator_zh": "茧"
        },
        {
            "location": "365/TALK",
            "narrator": "ガブリエラ",
            "text": "良かった…。\n一時はどうなるかと\n思ったわ。",
            "zh": "太好了……。\n刚才我还以为\n要完蛋了呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "367/TALK",
            "narrator": "繭",
            "text": "今度からは、降りる出口と\n地図をしっかり確認した\n方が良い。",
            "zh": "下次记得把下车出口\n和地图都仔细\n确认清楚比较好。",
            "narrator_zh": "茧"
        },
        {
            "location": "368/TALK",
            "narrator": "繭",
            "text": "南口とかに出てたら、\n確実に遭難してた。",
            "zh": "要是你从南口出去，\n肯定直接遇难了。",
            "narrator_zh": "茧"
        },
        {
            "location": "370/TALK",
            "narrator": "ガブリエラ",
            "text": "大袈裟なんだから…。\nでも、助かったわ。",
            "zh": "太夸张了吧……。\n不过，真是帮大忙了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "371/TALK",
            "narrator": "繭",
            "text": "…じゃあ、私は行くから。\nまた学校で。",
            "zh": "……那我就先走了。\n学校见。",
            "narrator_zh": "茧"
        },
        {
            "location": "373/TALK",
            "narrator": "ガブリエラ",
            "text": "うん…ありがと。",
            "zh": "嗯……谢谢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "377/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "378/TALK",
            "narrator": "ガブリエラ",
            "text": "そういえば、繭がどんな\nバイトしてるのか、\n誰も知らないんだっけ？",
            "zh": "说起来，茧到底在做什么\n打工来着，好像\n谁都不知道吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "379/SEL",
            "narrator": "",
            "text": "それは繭に失礼だよ",
            "zh": "那样对茧太失礼了",
            "narrator_zh": ""
        },
        {
            "location": "380/SEL",
            "narrator": "",
            "text": "一定の距離を空けるんだよ",
            "zh": "记得保持一定距离哦",
            "narrator_zh": ""
        },
        {
            "location": "381/TALK",
            "narrator": "ガブリエラ",
            "text": "…後をつけてみよう\nかしら？",
            "zh": "……要不悄悄\n跟上去看看？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "382/TALK",
            "narrator": "ガブリエラ",
            "text": "繭のバイトを知る\nチャンスなんだし。",
            "zh": "这可是弄清茧在打什么工的\n好机会嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "385/TALK",
            "narrator": "ガブリエラ",
            "text": "…って、ダメよね。",
            "zh": "……哎呀，不行不行。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "386/TALK",
            "narrator": "ガブリエラ",
            "text": "助けてもらったのに、\n恩を仇で返すような\n真似、失礼だもの。",
            "zh": "人家刚帮过自己，\n再干这种恩将仇报的\n事就太失礼了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "389/TALK",
            "narrator": "ガブリエラ",
            "text": "…浮世絵見て忘れよう。",
            "zh": "……去看浮世绘忘掉这茬吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "391/ACT",
            "narrator": "",
            "text": "それは繭に失礼だよ",
            "zh": "那样对茧太失礼了",
            "narrator_zh": ""
        },
        {
            "location": "409/TALK",
            "narrator": "ガブリエラ",
            "text": "わ、わかってるわ",
            "zh": "我、我知道啦",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "410/TALK",
            "narrator": "ガブリエラ",
            "text": "っていうか、どうして私の考えてることわかったの？",
            "zh": "话说回来，你怎么知道我在想什么啊？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "411/TALK",
            "narrator": "ガブリエラ",
            "text": "$marzanna$は鋭いわね",
            "zh": "$marzanna$还真是敏锐呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "423/TALK",
            "narrator": "ガブリエラ",
            "text": "…でも、繭のおかげで\n道に迷わずに済んだん\nだから――",
            "zh": "……不过，多亏了茧\n我才没继续\n迷路——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "424/TALK",
            "narrator": "ガブリエラ",
            "text": "恩を仇で返すようなこと、\nしたらいけないわね。",
            "zh": "恩将仇报的事，\n确实不能干呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "427/TALK",
            "narrator": "ガブリエラ",
            "text": "…浮世絵見て忘れよう。",
            "zh": "……去看浮世绘忘掉这茬吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "428/ACT",
            "narrator": "",
            "text": "一定の距離を空けるんだよ",
            "zh": "记得保持一定距离哦",
            "narrator_zh": ""
        },
        {
            "location": "447/TALK",
            "narrator": "ガブリエラ",
            "text": "任せて",
            "zh": "交给我吧",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "448/TALK",
            "narrator": "ガブリエラ",
            "text": "気配を悟られないようにするのは、狙撃の基本よ",
            "zh": "不让人察觉气息，可是狙击的基本功哦",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "449/TALK",
            "narrator": "ガブリエラ",
            "text": "もちろん、撃つわけじゃないけど",
            "zh": "当然，我也不是要开枪啦",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "461/TALK",
            "narrator": "ガブリエラ",
            "text": "ふふっ、なんだか\n探偵になったみたい…。",
            "zh": "呼呼，总觉得\n像当了侦探一样……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "462/TALK",
            "narrator": "ガブリエラ",
            "text": "よし、尾行開始！",
            "zh": "好，开始跟踪！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "474/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "475/TALK",
            "narrator": "ガブリエラ",
            "text": "そろそろ到着しても\nいいころだと思うけど、\nまだなのかしら？",
            "zh": "感觉差不多也该\n到地方了吧，\n还没到吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "477/TALK",
            "narrator": "ガブリエラ",
            "text": "っていうか、この辺って\nどこも繭が働きそうな\n店がないんだけど…。",
            "zh": "话说回来，这附近\n怎么看都没有像是\n茧会去打工的店啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "479/TALK",
            "narrator": "ガブリエラ",
            "text": "カラオケ、ブティック、\nバーガーショップ、\nネットカフェ――",
            "zh": "卡拉OK、精品店、\n汉堡店、\n网吧——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "481/TALK",
            "narrator": "ガブリエラ",
            "text": "メガネ屋、メイドサロン、\n電気屋に大型レコード店、\nあとはコンビニ？",
            "zh": "眼镜店、女仆沙龙、\n电器店还有大型唱片店，\n再就是便利店？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "482/TALK",
            "narrator": "ガブリエラ",
            "text": "…もしかして、バイトまで\n時間潰す気とか？",
            "zh": "……莫非，她只是想在\n打工前消磨时间？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "485/TALK",
            "narrator": "ガブリエラ",
            "text": "…あっ、しまった！",
            "zh": "……啊，糟糕！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "488/TALK",
            "narrator": "ガブリエラ",
            "text": "うそ…\nあたしが見失うなんて…。",
            "zh": "不会吧……\n我居然把人跟丢了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "489/TALK",
            "narrator": "ガブリエラ",
            "text": "数秒前までここにいた、\nってことは、どこかお店に\n入った――",
            "zh": "几秒前还在这儿，\n也就是说，她走进\n哪家店里去了——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "491/TALK",
            "narrator": "ガブリエラ",
            "text": "ってわけでもなさそう。\nまさか、本当にただ\n見失っただけ？",
            "zh": "好像也不是这样。\n难道说，真的就只是\n单纯跟丢了吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "493/TALK",
            "narrator": "ガブリエラ",
            "text": "…勘が鈍ったのかしら？\nやっぱり、毎日銃に\n触れないからなぁ…。",
            "zh": "……是直觉变迟钝了吗？\n果然还是因为不能天天\n摸到枪的缘故啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "495/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…もういいや。\n浮世絵見に行こう。",
            "zh": "唉……算了不管了。\n去看浮世绘吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "501/TALK",
            "narrator": "繭",
            "text": "…諦めたかしら？",
            "zh": "……她放弃了吗？",
            "narrator_zh": "茧"
        },
        {
            "location": "502/TALK",
            "narrator": "繭",
            "text": "バカ、間抜け、私。\nバカ正直にバイトとか\n言うなんて…。",
            "zh": "笨蛋，蠢货，我真是。\n傻乎乎地老实说出\n打工什么的……。",
            "narrator_zh": "茧"
        },
        {
            "location": "503/TALK",
            "narrator": "繭",
            "text": "今まで必死に隠してた\n努力が無駄になるところ\nだったわ。",
            "zh": "至今为止拼命隐瞒的\n努力差点就\n白费了呢。",
            "narrator_zh": "茧"
        },
        {
            "location": "504/TALK",
            "narrator": "繭",
            "text": "…一応、店にはもう少し\n歩いてから行った方が\nいいかも。",
            "zh": "……保险起见，再多走\n一段路然后再去店里\n比较好吧。",
            "narrator_zh": "茧"
        },
        {
            "location": "506/TALK",
            "narrator": "繭",
            "text": "…めんどくさ。",
            "zh": "……真麻烦。",
            "narrator_zh": "茧"
        },
