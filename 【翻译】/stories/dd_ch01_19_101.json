{
    "dir": "chap19/daydra/dd_ch01_19_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "19102",
        "cid": "tsubame",
        "title": "002 メインストーリー",
        "sub_title": "気にしすぎの夏＜前編＞",
        "title_zh": "002 主线剧情",
        "sub_title_zh": "想太多的夏天＜前篇＞"
    },
    "entry": [
        {
            "location": "22/TALK",
            "narrator": "真幌",
            "text": "よーし、全員よく\n頑張ったな。",
            "zh": "好——，大家都很\n努力啊。",
            "narrator_zh": "真幌"
        },
        {
            "location": "23/TALK",
            "narrator": "真幌",
            "text": "これで午前の訓練は\n終わりにするが、\n昼食後に再開だ。",
            "zh": "上午的训练就\n到此为止，\n午饭后再继续。",
            "narrator_zh": "真幌"
        },
        {
            "location": "24/TALK",
            "narrator": "真幌",
            "text": "とにかく今は休め。\n以上、一時解散！",
            "zh": "总之现在先休息。\n以上，暂时解散！",
            "narrator_zh": "真幌"
        },
        {
            "location": "61/TALK",
            "narrator": "アーヤ",
            "text": "さて、と。\nそれじゃお昼ご飯\n食べちゃいましょ。",
            "zh": "好了。\n那就去吃\n午饭吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "62/TALK",
            "narrator": "つばめ",
            "text": "そうですね。\nもうお腹ペコペコ\nです。",
            "zh": "是呀。\n肚子已经饿得\n咕咕叫了。",
            "narrator_zh": "燕"
        },
        {
            "location": "64/TALK",
            "narrator": "神楽",
            "text": "私もです…。\nでも、お腹いっぱいは\n食べられませんね。",
            "zh": "我也是……。\n不过，可不能吃太饱\n呢。",
            "narrator_zh": "神乐"
        },
        {
            "location": "65/TALK",
            "narrator": "みやび",
            "text": "午後もこれやろ？\n腹いっぱい食うたら\n動けなくなるがよ。",
            "zh": "下午也是这样啵？\n吃得太饱的话\n就动不了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "67/TALK",
            "narrator": "ガブリエラ",
            "text": "情けないわねぇ。\n胃が弱いんじゃ\nないの？",
            "zh": "真没出息呀。\n是不是胃\n不太好呀？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "68/TALK",
            "narrator": "アーヤ",
            "text": "とにかく、まずは\nみやびの家に\n戻りましょ。",
            "zh": "总之，先回\n雅的家里\n吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "109/TALK",
            "narrator": "雛",
            "text": "美味しかったー！\nやっぱ夏の素麺は\n最高だねー。",
            "zh": "好好吃——！\n果然夏天的素面\n最棒了呢——。",
            "narrator_zh": "雏"
        },
        {
            "location": "110/TALK",
            "narrator": "キリト",
            "text": "ああ、満腹になった\nところで、少し昼寝\nでもするか。",
            "zh": "啊，这下吃饱了，\n稍微睡个\n午觉吧。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "112/TALK",
            "narrator": "ヒカル",
            "text": "そんな暇ないよ。\n少し休んだら、\nすぐに行かないと。",
            "zh": "可没那闲工夫哦。\n稍微歇会儿，\n就得马上出发了。",
            "narrator_zh": "光"
        },
        {
            "location": "113/TALK",
            "narrator": "キリト",
            "text": "ちょっと遅れたって\n平気だっての。\n学校じゃあるまいし。",
            "zh": "晚了一点点也\n没关系啦。\n又不是去上学。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "114/TALK",
            "narrator": "雛",
            "text": "逆でしょ？",
            "zh": "反了吧？",
            "narrator_zh": "雏"
        },
        {
            "location": "115/TALK",
            "narrator": "雛",
            "text": "東雲教官を待たせたり\nしたらさ。",
            "zh": "要是让东云教官\n等着什么的。",
            "narrator_zh": "雏"
        },
        {
            "location": "116/TALK",
            "narrator": "雛",
            "text": "学校遅刻するより\nヤバいことになると\n思うけどねー。",
            "zh": "我觉得会比\n上学迟到\n还要糟糕哦——。",
            "narrator_zh": "雏"
        },
        {
            "location": "117/TALK",
            "narrator": "つばめ",
            "text": "お昼ごはん、\n楽しみだなー。",
            "zh": "午饭，\n好期待呀——。",
            "narrator_zh": "燕"
        },
        {
            "location": "119/TALK",
            "narrator": "雛",
            "text": "あ、この声は！",
            "zh": "啊，这声音是！",
            "narrator_zh": "雏"
        },
        {
            "location": "120/TALK",
            "narrator": "みやび",
            "text": "ま、昼やし素麺\nだと思うけんどな。",
            "zh": "嘛，大中午的\n估计也就是吃素面不过咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "121/TALK",
            "narrator": "つばめ",
            "text": "暑いし疲れてるから、\nそっちの方が嬉しい\nです。",
            "zh": "又热又累的，\n吃那个反而\n更开心呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "122/TALK",
            "narrator": "雛",
            "text": "つばめちゃーん！\nこっちこっちー！",
            "zh": "燕——！\n这边这边——！",
            "narrator_zh": "雏"
        },
        {
            "location": "132/TALK",
            "narrator": "つばめ",
            "text": "あ、あれ！？",
            "zh": "诶、咦！？",
            "narrator_zh": "燕"
        },
        {
            "location": "134/TALK",
            "narrator": "キリト",
            "text": "よっ、逢瀬。\n訓練ご苦労さん。",
            "zh": "哟，逢濑。\n训练辛苦啦。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "135/TALK",
            "narrator": "ヒカル",
            "text": "お疲れ様です。\n暑い中、ごくろうさま\nでした。",
            "zh": "辛苦了。\n大热天的，\n真是辛苦了。",
            "narrator_zh": "光"
        },
        {
            "location": "136/TALK",
            "narrator": "つばめ",
            "text": "みんな、どうして\nここにいるの！？",
            "zh": "大家，为什么\n会在这里呀！？",
            "narrator_zh": "燕"
        },
        {
            "location": "139/TALK",
            "narrator": "みやび",
            "text": "…お？　もう到着し\nちょったが？",
            "zh": "……哦？已经\n到了咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "140/TALK",
            "narrator": "ヒカル",
            "text": "お邪魔してます、\nみやび先輩。",
            "zh": "打扰了，\n雅前辈。",
            "narrator_zh": "光"
        },
        {
            "location": "143/TALK",
            "narrator": "つばめ",
            "text": "あの、みやびさん。\nどうしてみんなが\nここにいるんですか？",
            "zh": "那个，雅。\n为什么大家\n会在这里呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "145/TALK",
            "narrator": "みやび",
            "text": "なんや？　まほさんに\n聞いてなかったが？",
            "zh": "怎么？真幌\n没跟你说咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "146/TALK",
            "narrator": "つばめ",
            "text": "はい…なんで？",
            "zh": "没有……为什么？",
            "narrator_zh": "燕"
        },
        {
            "location": "148/TALK",
            "narrator": "キリト",
            "text": "逢瀬達の手伝い兼、\n東雲教官の手伝い。",
            "zh": "说是来给逢濑你们打下手，\n兼给东云教官帮忙。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "149/TALK",
            "narrator": "キリト",
            "text": "それだったら\n合宿についてきても\nいいって東雲教官が。",
            "zh": "只要干这个的话，\n东云教官就准许我们\n跟着来合宿了。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "150/TALK",
            "narrator": "キリト",
            "text": "そうすりゃ、逢瀬達が\n訓練に集中できる\nから、ってな。",
            "zh": "说是这样一来，逢濑你们\n就能专心投入\n训练了。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "152/TALK",
            "narrator": "雛",
            "text": "ま、つばめちゃん達の\n手伝いはおまけだよね。",
            "zh": "嘛，给燕你们帮忙\n只是顺带的啦。",
            "narrator_zh": "雏"
        },
        {
            "location": "153/TALK",
            "narrator": "雛",
            "text": "教官は自分の手伝いが\n欲しかったみたい\nだから。",
            "zh": "看样子教官主要是\n想要帮自己干活的人\n嘛。",
            "narrator_zh": "雏"
        },
        {
            "location": "154/TALK",
            "narrator": "ヒカル",
            "text": "逢瀬さん達の訓練は、\n僕達じゃ手伝えません\nからね。",
            "zh": "毕竟逢濑你们的训练，\n我们也帮不上什么忙\n呢。",
            "narrator_zh": "光"
        },
        {
            "location": "158/TALK",
            "narrator": "つばめ",
            "text": "そうなんだ…。\n全然知らなかったよ。",
            "zh": "这样啊……。\n我都完全不知道哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "159/TALK",
            "narrator": "つばめ",
            "text": "でもさ。\nそれだったら。",
            "zh": "不过嘛。\n那样的话。",
            "narrator_zh": "燕"
        },
        {
            "location": "160/TALK",
            "narrator": "つばめ",
            "text": "一緒に遊びに行ったり\nできるよね！",
            "zh": "就能一起出去\n玩了吧！",
            "narrator_zh": "燕"
        },
        {
            "location": "161/TALK",
            "narrator": "雛",
            "text": "うーん…そうだったら\nよかったんだけど…。",
            "zh": "嗯——……我倒也想那样，\n不过……。",
            "narrator_zh": "雏"
        },
        {
            "location": "163/TALK",
            "narrator": "雛",
            "text": "ほら、基本的に教官の\n手伝いが多い、って\n言ったでしょ？",
            "zh": "你看，我刚才不是说了，\n基本主要是给教官\n帮忙居多嘛？",
            "narrator_zh": "雏"
        },
        {
            "location": "165/TALK",
            "narrator": "つばめ",
            "text": "う、うん…。",
            "zh": "嗯、嗯……。",
            "narrator_zh": "燕"
        },
        {
            "location": "166/TALK",
            "narrator": "雛",
            "text": "だから、昼間は\nほとんどこっちには\nいないんだよー。",
            "zh": "所以，白天\n几乎都不会\n待在这边的——。",
            "narrator_zh": "雏"
        },
        {
            "location": "167/TALK",
            "narrator": "キリト",
            "text": "泊まるのも、俺たちは\n近くの旅館だしな。",
            "zh": "我们住的地方，\n也是附近的旅馆嘛。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "170/TALK",
            "narrator": "つばめ",
            "text": "えーっ！？",
            "zh": "诶——！？",
            "narrator_zh": "燕"
        },
        {
            "location": "172/TALK",
            "narrator": "ヒカル",
            "text": "逢瀬さん達は、\n政府の秘密部隊\nだからね。",
            "zh": "毕竟逢濑你们，\n是政府的秘密部队\n嘛。",
            "narrator_zh": "光"
        },
        {
            "location": "173/TALK",
            "narrator": "ヒカル",
            "text": "一緒に行動するのは\nまずい、ってことなの\nかもしれないね。",
            "zh": "大概是觉得我们\n一起行动不太妥当\n吧。",
            "narrator_zh": "光"
        },
        {
            "location": "174/TALK",
            "narrator": "キリト",
            "text": "おまけに、こっちに\nいる期間も逢瀬達より\n全然短いしな。",
            "zh": "而且，我们待在这边的\n时间也比逢濑你们\n短得多呢。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "176/TALK",
            "narrator": "雛",
            "text": "うん…もしかしたら、\n遊びに行ったりとかは\nできないかも。",
            "zh": "嗯……说不定，\n没办法一起出去玩\n之类的呢。",
            "narrator_zh": "雏"
        },
        {
            "location": "177/TALK",
            "narrator": "つばめ",
            "text": "そうなんだ…。",
            "zh": "这样啊……。",
            "narrator_zh": "燕"
        },
        {
            "location": "179/TALK",
            "narrator": "雛",
            "text": "ただ、\n東京ではできない\n作業みたいだから。",
            "zh": "不过，听说是\n在东京做不了的\n作业。",
            "narrator_zh": "雏"
        },
        {
            "location": "180/TALK",
            "narrator": "雛",
            "text": "ちょっと楽しみでは\nあるんだ。",
            "zh": "我其实还有点\n小期待呢。",
            "narrator_zh": "雏"
        },
        {
            "location": "181/TALK",
            "narrator": "つばめ",
            "text": "…そっかぁ。",
            "zh": "……这样啊。",
            "narrator_zh": "燕"
        },
        {
            "location": "182/TALK",
            "narrator": "つばめ",
            "text": "なんか、やること\n沢山あって大変だね。",
            "zh": "感觉要做的事情\n好多，好辛苦呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "246/TALK",
            "narrator": "つばめ",
            "text": "　",
            "zh": "　",
            "narrator_zh": "燕"
        },
        {
            "location": "260/TALK",
            "narrator": "つばめ",
            "text": "こんにちは、\n$handle$さん。",
            "zh": "你好，\n$handle$。",
            "narrator_zh": "燕"
        },
        {
            "location": "261/SEL",
            "narrator": "",
            "text": "ちょ！！　水着！？",
            "zh": "等下！！ 泳装！？",
            "narrator_zh": ""
        },
        {
            "location": "262/ACT",
            "narrator": "",
            "text": "ちょ！！　水着！？",
            "zh": "等下！！ 泳装！？",
            "narrator_zh": ""
        },
        {
            "location": "264/TALK",
            "narrator": "つばめ",
            "text": "はい。",
            "zh": "是的。",
            "narrator_zh": "燕"
        },
        {
            "location": "265/TALK",
            "narrator": "つばめ",
            "text": "…ダメでしたか？\nまあそりゃダメですよね。\nわたしみたいなのじゃ。",
            "zh": "……不行吗？\n嘛，那确实不行吧。\n像我这种的。",
            "narrator_zh": "燕"
        },
        {
            "location": "266/SEL",
            "narrator": "",
            "text": "そんなことないよ、\nかわいいよ！",
            "zh": "才没有，\n很可爱哦！",
            "narrator_zh": ""
        },
        {
            "location": "267/SEL",
            "narrator": "",
            "text": "なんで急にまた…",
            "zh": "怎么突然又……",
            "narrator_zh": ""
        },
        {
            "location": "268/ACT",
            "narrator": "",
            "text": "そんなことないよ、\nかわいいよ！",
            "zh": "才没有，\n很可爱哦！",
            "narrator_zh": ""
        },
        {
            "location": "270/TALK",
            "narrator": "つばめ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "燕"
        },
        {
            "location": "273/TALK",
            "narrator": "つばめ",
            "text": "………。",
            "zh": "………。",
            "narrator_zh": "燕"
        },
        {
            "location": "274/SEL",
            "narrator": "",
            "text": "…？",
            "zh": "……？",
            "narrator_zh": ""
        },
        {
            "location": "275/ACT",
            "narrator": "",
            "text": "…？",
            "zh": "……？",
            "narrator_zh": ""
        },
        {
            "location": "277/TALK",
            "narrator": "つばめ",
            "text": "いえ。\nお気になさらず。",
            "zh": "不。\n请不用在意。",
            "narrator_zh": "燕"
        },
        {
            "location": "278/TALK",
            "narrator": "つばめ",
            "text": "どう反応したらいいか\nわからなくなった\nだけです。",
            "zh": "只是不知道\n该怎么反应\n罢了。",
            "narrator_zh": "燕"
        },
        {
            "location": "279/TALK",
            "narrator": "つばめ",
            "text": "とまあ、\nそれはそれとして。",
            "zh": "不过嘛，\n暂且先把这放一边。",
            "narrator_zh": "燕"
        },
        {
            "location": "280/ACT",
            "narrator": "",
            "text": "なんで急にまた…",
            "zh": "怎么突然又……",
            "narrator_zh": ""
        },
        {
            "location": "281/TALK",
            "narrator": "つばめ",
            "text": "いえ、\n現実のわたしが水着なので\nそれに対抗しようかと。",
            "zh": "没，\n因为现实的我穿了泳装，\n我就想着对抗一下。",
            "narrator_zh": "燕"
        },
        {
            "location": "282/SEL",
            "narrator": "",
            "text": "自分自身と競い合ってどうするの！？",
            "zh": "和自己较什么劲啊！？",
            "narrator_zh": ""
        },
        {
            "location": "283/ACT",
            "narrator": "",
            "text": "自分自身と競い合ってどうするの！？",
            "zh": "和自己较什么劲啊！？",
            "narrator_zh": ""
        },
        {
            "location": "287/TALK",
            "narrator": "つばめ",
            "text": "シィィィット！！",
            "zh": "Shiiit！！",
            "narrator_zh": "燕"
        },
        {
            "location": "288/SEL",
            "narrator": "",
            "text": "座れってこと？",
            "zh": "是要我坐下（Sit）？",
            "narrator_zh": ""
        },
        {
            "location": "289/SEL",
            "narrator": "",
            "text": "嫉妬？",
            "zh": "你在嫉妒？",
            "narrator_zh": ""
        },
        {
            "location": "290/ACT",
            "narrator": "",
            "text": "座れってこと？",
            "zh": "是要我坐下（Sit）？",
            "narrator_zh": ""
        },
        {
            "location": "291/TALK",
            "narrator": "つばめ",
            "text": "アホですか？\nそうですか。",
            "zh": "你是笨蛋吗？\n是吗。",
            "narrator_zh": "燕"
        },
        {
            "location": "292/TALK",
            "narrator": "つばめ",
            "text": "なぜ「自分と競い合って\nどうする？」の返答が\n「座れ！」なのか。",
            "zh": "为什么“和自己较什么劲\n啊？”的回答\n会是“坐下！”呢。",
            "narrator_zh": "燕"
        },
        {
            "location": "293/TALK",
            "narrator": "つばめ",
