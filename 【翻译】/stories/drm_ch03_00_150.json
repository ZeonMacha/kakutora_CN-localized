{
 "dir": "dramatics/daydra/drm_ch03_00_150.js",
 "type": "Episode",
 "info": {
  "story_id": "3015",
  "cid": "gabriella",
  "title": "らぶとーく  第15話",
  "sub_title": "二人きりより緊張する"
 },
 "entry": [
  {
   "location": "7/SCENARIO",
   "narrator": "",
   "text": "二人きりより緊張する"
  },
  {
   "location": "19/TALK",
   "narrator": "ガブリエラ",
   "text": "…………。"
  },
  {
   "location": "21/TALK",
   "narrator": "ガブリエラ",
   "text": "やっぱり、たまには\n本で調べ物をするのも\n悪くないわね。"
  },
  {
   "location": "22/TALK",
   "narrator": "ガブリエラ",
   "text": "何でもネット検索じゃ、\n面白くないし。"
  },
  {
   "location": "27/TALK",
   "narrator": "キリト",
   "text": "あれ？\nガブリエラじゃん。"
  },
  {
   "location": "29/TALK",
   "narrator": "ガブリエラ",
   "text": "っ！？",
   "zh": "！？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "31/TALK",
   "narrator": "雛",
   "text": "あ、本当だ。\n珍しいね…お勉強？"
  },
  {
   "location": "32/TALK",
   "narrator": "ガブリエラ",
   "text": "あ、えと…。"
  },
  {
   "location": "34/TALK",
   "narrator": "ヒカル",
   "text": "あ、あの、二人とも。\n図書室ではもう少し\n声を抑えないと…。"
  },
  {
   "location": "36/TALK",
   "narrator": "ガブリエラ",
   "text": "…………。"
  },
  {
   "location": "38/TALK",
   "narrator": "ヒカル",
   "text": "こんにちは。\nよろしければ、相席して\nよろしいですか？",
   "zh": "你好。\n如果不介意，可以\n拼桌吗？",
   "narrator_zh": "光"
  },
  {
   "location": "40/TALK",
   "narrator": "ガブリエラ",
   "text": "…………。"
  },
  {
   "location": "42/TALK",
   "narrator": "雛",
   "text": "ありがとねー。\nそれじゃ、お隣失礼ー。"
  },
  {
   "location": "43/TALK",
   "narrator": "雛",
   "text": "ふぅ…。",
   "zh": "呼……。",
   "narrator_zh": "雏"
  },
  {
   "location": "48/TALK",
   "narrator": "ガブリエラ",
   "text": "…あんた達、図書室に\n何しに来たの？"
  },
  {
   "location": "50/TALK",
   "narrator": "雛",
   "text": "えへへ…あたし達も\nちょっと調べ物が\nあってね。",
   "zh": "嘿嘿……我们也是\n有点东西要\n查一查呢。",
   "narrator_zh": "雏"
  },
  {
   "location": "53/TALK",
   "narrator": "キリト",
   "text": "さっさと始めようぜ。\n資料になりそうな本、\n取ってくるぞ。"
  },
  {
   "location": "55/TALK",
   "narrator": "ヒカル",
   "text": "あ、僕も行きます。"
  },
  {
   "location": "56/TALK",
   "narrator": "ガブリエラ",
   "text": "…………。"
  },
  {
   "location": "66/TALK",
   "narrator": "キリト",
   "text": "はぁ…なんか、頭が\nパンクしそうなんだ\nけど…。",
   "zh": "唉……总觉得脑袋\n要炸掉\n了……。",
   "narrator_zh": "圣翔"
  },
  {
   "location": "68/TALK",
   "narrator": "雛",
   "text": "まだそんなに時間\n経ってないじゃん。"
  },
  {
   "location": "70/TALK",
   "narrator": "雛",
   "text": "ほら、そっちの地図帳\n調べてみて。"
  },
  {
   "location": "71/TALK",
   "narrator": "キリト",
   "text": "へいへい…。\nったく、まだ数学の\n問題集の方がラクだぜ。"
  },
  {
   "location": "72/TALK",
   "narrator": "ガブリエラ",
   "text": "…なんか、結構手こずっ\nてるみたい。\n何調べてるのかしら？",
   "zh": "……好像，相当费劲\n的样子。\n到底在查什么呢？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "74/TALK",
   "narrator": "ガブリエラ",
   "text": "…っていうか。"
  },
  {
   "location": "75/TALK",
   "narrator": "ヒカル",
   "text": "…………。"
  },
  {
   "location": "77/TALK",
   "narrator": "ガブリエラ",
   "text": "ヒカルくん、あんまり\n手伝ってる感じが\nしない…。"
  },
  {
   "location": "80/TALK",
   "narrator": "ガブリエラ",
   "text": "手伝わない、って\nことは、ひなこ達の\n宿題なのかしら？"
  },
  {
   "location": "92/TALK",
   "narrator": "ガブリエラ",
   "text": "ねえ、$handle$も珍しいと思わない？",
   "zh": "喂，$handle$也不觉得稀奇吗？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "93/TALK",
   "narrator": "ガブリエラ",
   "text": "普通、こういう調べ物だと、ヒカルくんが一番活躍しそうなのに"
  },
  {
   "location": "94/TALK",
   "narrator": "ガブリエラ",
   "text": "何となく、暇してそうな感じがするの…"
  },
  {
   "location": "96/SEL",
   "narrator": "",
   "text": "筆談で話しかけてみれば？",
   "zh": "试着用写的跟她搭话嘛？",
   "narrator_zh": ""
  },
  {
   "location": "97/ACT",
   "narrator": "",
   "text": "筆談で話しかけてみれば？",
   "zh": "试着用写的跟她搭话嘛？",
   "narrator_zh": ""
  },
  {
   "location": "100/TALK",
   "narrator": "ガブリエラ",
   "text": "えっ！？",
   "zh": "诶！？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "103/TALK",
   "narrator": "ガブリエラ",
   "text": "まあ",
   "zh": "嗯",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "104/TALK",
   "narrator": "ガブリエラ",
   "text": "ちょっと気になるし",
   "zh": "也有点在意",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "106/TALK",
   "narrator": "ガブリエラ",
   "text": "でも、なんて声をかければいいかわからないわ",
   "zh": "不过，不知道该怎么开口",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "108/SEL",
   "narrator": "",
   "text": "調べているものについて聞けば",
   "zh": "要是问问他在查什么",
   "narrator_zh": ""
  },
  {
   "location": "109/SEL",
   "narrator": "",
   "text": "付き合いがいいのねって言ってみれば",
   "zh": "说白了你就是待人热络",
   "narrator_zh": ""
  },
  {
   "location": "110/SEL",
   "narrator": "",
   "text": "二人きりでお茶でもどうって聞けば",
   "zh": "问一句要不要两个人喝个茶",
   "narrator_zh": ""
  },
  {
   "location": "111/ACT",
   "narrator": "",
   "text": "調べているものについて聞けば",
   "zh": "要是问问他在查什么",
   "narrator_zh": ""
  },
  {
   "location": "113/TALK",
   "narrator": "ガブリエラ",
   "text": "そうね、私も気になるし",
   "zh": "是啊，我也很在意",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "115/TALK",
   "narrator": "ガブリエラ",
   "text": "早速聞いてみるわ"
  },
  {
   "location": "126/TALK",
   "narrator": "ガブリエラ",
   "text": "…………。"
  },
  {
   "location": "128/TALK",
   "narrator": "ヒカル",
   "text": "…ん？\nメモ？",
   "zh": "…嗯？\n笔记？",
   "narrator_zh": "光"
  },
  {
   "location": "129/TALK",
   "narrator": "ヒカル",
   "text": "…………。"
  },
  {
   "location": "132/TALK",
   "narrator": "ヒカル",
   "text": "ああ、すみません。\n話していません\nでしたね。"
  },
  {
   "location": "133/TALK",
   "narrator": "ヒカル",
   "text": "東京の歴史を調べて\nレポートを纏める\n課題が出ているので――",
   "zh": "作业是调查东京的历史\n并整理成报告，\n所以——",
   "narrator_zh": "光"
  },
  {
   "location": "134/TALK",
   "narrator": "ヒカル",
   "text": "それについて調べて、\nまとめているところ\nなんですよ。",
   "zh": "那件事我在查，\n现在正在\n整理。",
   "narrator_zh": "光"
  },
  {
   "location": "135/TALK",
   "narrator": "ガブリエラ",
   "text": "…そんな課題が\n出てたんだ。",
   "zh": "…原来还有\n这种作业啊。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "136/TALK",
   "narrator": "ガブリエラ",
   "text": "っていうか、なんか\nすっごい楽しそうかも。",
   "zh": "话说，好像\n特别开心啊。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "137/TALK",
   "narrator": "ガブリエラ",
   "text": "東京の歴史って、\n前に勉強した時、\n楽しかったなぁ…。",
   "zh": "东京的历史，\n以前学的时候，\n好开心啊……",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "138/TALK",
   "narrator": "ヒカル",
   "text": "…ガブリエラさんは\n何を調べているん\nですか？",
   "zh": "……加布里埃拉小姐\n在查\n什么啊？",
   "narrator_zh": "光"
  },
  {
   "location": "139/TALK",
   "narrator": "ガブリエラ",
   "text": "っ！？",
   "zh": "！？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "141/TALK",
   "narrator": "ガブリエラ",
   "text": "そうだった。\nあたしも話して\nなかったわ。",
   "zh": "是这样啊。\n我也\n没说。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "144/TALK",
   "narrator": "ガブリエラ",
   "text": "えっと……。",
   "zh": "呃……。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "146/TALK",
   "narrator": "ヒカル",
   "text": "…国語の教科書に\n載っている話の――",
   "zh": "……国语课本上\n登着的那个故事——",
   "narrator_zh": "光"
  },
  {
   "location": "147/TALK",
   "narrator": "ヒカル",
   "text": "原作者が書いた他の\n話を調べている…\nですか。"
  },
  {
   "location": "149/TALK",
   "narrator": "ヒカル",
   "text": "見たところ、\n芥川龍之介の本を\n調べているようですね。"
  },
  {
   "location": "151/TALK",
   "narrator": "ガブリエラ",
   "text": "…………。"
  },
  {
   "location": "152/TALK",
   "narrator": "ガブリエラ",
   "text": "教科書に載っていた\n羅生門を読んで、\n気になったんです…と。"
  },
  {
   "location": "153/TALK",
   "narrator": "ガブリエラ",
   "text": "…………。"
  },
  {
   "location": "155/TALK",
   "narrator": "ヒカル",
   "text": "…え？\nちょっと、教科書を\n見せてもらえますか？"
  },
  {
   "location": "157/TALK",
   "narrator": "ガブリエラ",
   "text": "…な、なに？\nどうしたのかしら？",
   "zh": "……什、什么？\n怎么了呀？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "158/TALK",
   "narrator": "ヒカル",
   "text": "えっと…。\nああ、やっぱり…。"
  },
  {
   "location": "159/TALK",
   "narrator": "ヒカル",
   "text": "僕が当時使っていた\n教科書と、内容が\n大分変わっていますね。"
  },
  {
   "location": "160/TALK",
   "narrator": "ヒカル",
   "text": "僕の時は羅生門では\nなくて、蜘蛛の糸\nでしたから。"
  },
  {
   "location": "161/TALK",
   "narrator": "ガブリエラ",
   "text": "あ～…あれ、後味悪い\nから、あんまり好きじゃ\nないんだけど…。"
  },
  {
   "location": "162/TALK",
   "narrator": "ヒカル",
   "text": "あ、でも漱石のこころは\n僕の時もありましたよ。"
  },
  {
   "location": "163/TALK",
   "narrator": "ヒカル",
   "text": "懐かしいなぁ…。\nこれ、感想文を書く\n宿題があったんです。"
  },
  {
   "location": "165/TALK",
   "narrator": "ガブリエラ",
   "text": "っ！？",
   "zh": "！？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "167/TALK",
   "narrator": "ガブリエラ",
   "text": "あたしもその宿題、\nやりました…っと！"
  },
  {
   "location": "168/TALK",
   "narrator": "ガブリエラ",
   "text": "…………。"
  },
  {
   "location": "170/TALK",
   "narrator": "ヒカル",
   "text": "…そうですか。\nガブリエラさんも\nやったんですか。"
  },
  {
   "location": "171/TALK",
   "narrator": "ヒカル",
   "text": "あれも後味の悪い話\nだから、苦労したのを\n覚えてますよ…。"
  },
  {
   "location": "173/TALK",
   "narrator": "雛",
   "text": "…………。"
  },
  {
   "location": "177/TALK",
   "narrator": "ガブリエラ",
   "text": "…な、何よ、ひなこ？\nそんなニヤニヤしちゃ\nって…。",
   "zh": "……干、干嘛呀，雏？\n笑得那么\n不怀好意……。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "178/TALK",
   "narrator": "雛",
   "text": "んっふっふっふ…\nいやー、お二人さん――"
  },
  {
   "location": "179/TALK",
   "narrator": "雛",
   "text": "なんか、凄い仲良し\nオーラ発してたから――",
   "zh": "因为散发着\n超要好的气场——",
   "narrator_zh": "雏"
  },
  {
   "location": "180/TALK",
   "narrator": "雛",
   "text": "見てるこっちも\n嬉しくなってきちゃっ\nてねー。"
  },
  {
   "location": "182/TALK",
   "narrator": "ヒカル",
   "text": "えっ？",
   "zh": "诶？",
   "narrator_zh": "光"
  },
  {
   "location": "187/TALK",
   "narrator": "ガブリエラ",
   "text": "なっ！？\nな、何言ってるのよ！",
   "zh": "什！？\n你、你在说什么！",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "188/TALK",
   "narrator": "ガブリエラ",
   "text": "変な誤解されそうな\n言い方しないで！"
  },
  {
   "location": "190/TALK",
   "narrator": "ヒカル",
   "text": "ちょ、ガブリエラさん。\n声のボリュームを…。",
   "zh": "等、加布里埃拉。\n声音音量……。",
   "narrator_zh": "光"
  },
  {
   "location": "193/TALK",
   "narrator": "ガブリエラ",
   "text": "っ！！",
   "zh": "唔！！",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "195/TALK",
   "narrator": "雛",
   "text": "ごめんごめん。\nちょーっとからかい\n過ぎちゃったかなー？",
   "zh": "抱歉抱歉。\n是不是稍微\n捉弄过头了—？",
   "narrator_zh": "雏"
  },
  {
   "location": "197/TALK",
   "narrator": "ガブリエラ",
   "text": "…………。"
  },
  {
   "location": "198/TALK",
   "narrator": "ヒカル",
   "text": "えっと…大丈夫ですか、\nガブリエラさん？"
  },
  {
   "location": "200/TALK",
   "narrator": "ガブリエラ",
   "text": "…大丈夫なわけない\nじゃない、もう！",
   "zh": "……怎么可能没事，\n真是的！",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "201/ACT",
   "narrator": "",
   "text": "付き合いがいいのねって言ってみれば",
   "zh": "说白了你就是待人热络",
   "narrator_zh": ""
  },
  {
   "location": "202/TALK",
   "narrator": "ガブリエラ",
   "text": "そうね",
   "zh": "说得对",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "203/TALK",
   "narrator": "ガブリエラ",
   "text": "ひなこ達に付き合っているだけみたいだし"
  },
  {
   "location": "214/TALK",
   "narrator": "ガブリエラ",
   "text": "…………。"
  },
  {
   "location": "216/TALK",
   "narrator": "ヒカル",
   "text": "…ん？\nメモ？",
   "zh": "…嗯？\n笔记？",
   "narrator_zh": "光"
  },
  {
   "location": "217/TALK",
   "narrator": "ヒカル",
   "text": "…………。"
  },
  {
   "location": "220/TALK",
   "narrator": "ヒカル",
   "text": "あ、違うんです。\n勘違いさせちゃい\nましたか？"
  },
  {
   "location": "221/TALK",
   "narrator": "ヒカル",
   "text": "今やってるのって、\n僕らの班で発表する\nレポートの――"
  },
  {
   "location": "222/TALK",
   "narrator": "ヒカル",
   "text": "資料探しなんです。"
  },
  {
   "location": "223/TALK",
   "narrator": "ガブリエラ",
   "text": "…どんなレポートなん\nですか…っと。",
   "zh": "……是什么样的报告\n呢……这样。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "225/TALK",
   "narrator": "ヒカル",
   "text": "…………。"
  },
  {
   "location": "227/TALK",
   "narrator": "ヒカル",
   "text": "…えっとですね。"
  },
  {
   "location": "228/TALK",
   "narrator": "ヒカル",
   "text": "東京の歴史を調べて\nレポートを纏める\n課題が出ているので――",
   "zh": "作业是调查东京的历史\n并整理成报告，\n所以——",
   "narrator_zh": "光"
  },
  {
   "location": "229/TALK",
   "narrator": "ヒカル",
   "text": "それについて調べて、\nまとめているところ\nなんですよ。",
   "zh": "那件事我在查，\n现在正在\n整理。",
   "narrator_zh": "光"
  },
  {
   "location": "231/TALK",
   "narrator": "ヒカル",
   "text": "ただ、僕は海外生活が\n長かったせいか――",
   "zh": "只是，也许是因为我\n在国外生活得久——",
   "narrator_zh": "光"
  },
  {
   "location": "232/TALK",
   "narrator": "ヒカル",
   "text": "どうにも、日本の歴史は\n苦手でして…。",
   "zh": "我实在不太擅长\n日本历史……。",
   "narrator_zh": "光"
  },
  {
   "location": "234/TALK",
   "narrator": "ヒカル",
   "text": "それで、詳しい二人に\n任せっきりになって\nしまっているんですよ。",
   "zh": "结果就全交给\n这两位熟悉情况\n的人了。",
   "narrator_zh": "光"
  },
  {
   "location": "235/TALK",
   "narrator": "ガブリエラ",
   "text": "…そんな課題が\n出てたんだ。",
   "zh": "…原来还有\n这种作业啊。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "237/TALK",
   "narrator": "ガブリエラ",
   "text": "っていうか、なんか\nすっごい楽しそうかも。",
   "zh": "话说，好像\n特别开心啊。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "238/TALK",
   "narrator": "ガブリエラ",
   "text": "東京の歴史って、\n前に勉強した時、\n楽しかったなぁ…。",
   "zh": "东京的历史，\n以前学的时候，\n好开心啊……",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "240/TALK",
   "narrator": "キリト",
   "text": "なーに、気にすんなよ。\nヒカルには他の教科で\n助けられてるしな。",
   "zh": "什么啊，别在意。\n光在别的科目上\n也帮了我不少。",
   "narrator_zh": "圣翔"
  },
  {
   "location": "241/TALK",
   "narrator": "キリト",
   "text": "おまえが苦手な分野は、\n俺達でサポートするぜ。",
   "zh": "你不擅长的领域，\n就由我们来支援。",
   "narrator_zh": "圣翔"
  },
  {
   "location": "243/TALK",
   "narrator": "雛",
   "text": "そういうこと。\nま、これくらい\n遠慮は無用さー。",
   "zh": "就是这么回事。\n这点小忙\n不用客气啦。",
   "narrator_zh": "雏"
  },
  {
   "location": "245/TALK",
   "narrator": "ヒカル",
   "text": "ありがとうございます。\n本当、助けていただいて\nありがたいです。"
  },
  {
   "location": "247/TALK",
   "narrator": "キリト",
   "text": "ま、もうしばらくは\n掛かりそうだし――"
  },
  {
   "location": "248/TALK",
   "narrator": "キリト",
   "text": "ガブリエラと話して、\n待っててくれよ。"
  },
  {
   "location": "250/TALK",
   "narrator": "ガブリエラ",
   "text": "っ！？",
   "zh": "！？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "252/TALK",
   "narrator": "ガブリエラ",
   "text": "な、何であたしの\n名前が出てくるの！？",
   "zh": "为、为什么会出现\n我的名字！？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "254/TALK",
   "narrator": "雛",
   "text": "キリト、それナイス！\nいいこと言うじゃん。"
  },
  {
   "location": "255/TALK",
   "narrator": "雛",
   "text": "レポートはあたし達が\n引き受けるから――"
  },
  {
   "location": "256/TALK",
   "narrator": "雛",
   "text": "若い者同士、どうぞ\n二人きりで仲良く語り\n合っちゃっててね。"
  },
  {
   "location": "258/ACT",
   "narrator": "",
   "text": "二人きりでお茶でもどうって聞けば",
   "zh": "问一句要不要两个人喝个茶",
   "narrator_zh": ""
  },
  {
   "location": "260/TALK",
   "narrator": "ガブリエラ",
   "text": "は！？",
   "zh": "哈！？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "261/TALK",
   "narrator": "ガブリエラ",
   "text": "どうしてそうなっちゃうのよ！？",
   "zh": "为什么会变成那样！？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "263/TALK",
   "narrator": "ガブリエラ",
   "text": "今って、そんなこという雰囲気じゃないでしょ？"
  },
  {
   "location": "264/TALK",
   "narrator": "ガブリエラ",
   "text": "っていうか、これ、もしＯＫされたら",
   "zh": "话说，这个要是被答应了",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "265/TALK",
   "narrator": "ガブリエラ",
   "text": "デートになっちゃう////////"
  },
  {
   "location": "266/TALK",
   "narrator": "ガブリエラ",
   "text": "何でそんな変なこと\n言うの？"
  },
  {
   "location": "277/TALK",
   "narrator": "ガブリエラ",
   "text": "まったく…マルザンナ\nってば、急に変なこと\n言い出して…。"
  },
  {
   "location": "279/TALK",
   "narrator": "ヒカル",
   "text": "あの…大丈夫ですか？"
  },
  {
   "location": "281/TALK",
   "narrator": "ガブリエラ",
   "text": "っ！",
   "zh": "！",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "282/TALK",
   "narrator": "ヒカル",
   "text": "あ、すみません。\n驚かせちゃいました？"
  },
  {
   "location": "283/TALK",
   "narrator": "ヒカル",
   "text": "でも、先ほどから\n急に顔が赤くなってきた\nみたいですし…。",
   "zh": "不过，从刚才起\n脸好像突然\n红起来了……。",
   "narrator_zh": "光"
  },
  {
   "location": "286/TALK",
   "narrator": "ガブリエラ",
   "text": "ま、マルザンナが\n変なこと言うから！"
  },
  {
   "location": "287/TALK",
   "narrator": "ヒカル",
   "text": "…熱でもあるんじゃ\nありませんか？",
   "zh": "……你是不是\n发烧了？",
   "narrator_zh": "光"
  },
  {
   "location": "289/TALK",
   "narrator": "ヒカル",
   "text": "ちょっとすみません。",
   "zh": "失礼一下。",
   "narrator_zh": "光"
  },
  {
   "location": "295/TALK",
   "narrator": "ガブリエラ",
   "text": "…………っ！？"
  },
  {
   "location": "298/TALK",
   "narrator": "ガブリエラ",
   "text": "…………。"
  },
  {
   "location": "300/TALK",
   "narrator": "雛",
   "text": "うわっ、何！？"
  },
  {
   "location": "302/TALK",
   "narrator": "ヒカル",
   "text": "あっ…す、すみません。\n驚かせてしまいまし\nたか？"
  },
  {
   "location": "304/TALK",
   "narrator": "キリト",
   "text": "なんだなんだ？\nどうかしたのか？",
   "zh": "怎么了怎么了？\n出什么事了？",
   "narrator_zh": "圣翔"
  },
  {
   "location": "317/TALK",
   "narrator": "ヒカル",
   "text": "いえ…ガブリエラさんの\n熱を測ろうかと思い――"
  },
  {
   "location": "318/TALK",
   "narrator": "ヒカル",
   "text": "つい、おでこに触ろうと\nしてしまって…。",
   "zh": "我不小心\n想摸她的额头了……。",
   "narrator_zh": "光"
  },
  {
   "location": "320/TALK",
   "narrator": "キリト",
   "text": "おでこって…おまえ、\nそういうことする\nタイプだったっけか？",
   "zh": "额头啊……你这家伙，\n原来是会做\n这种事的那种人吗？",
   "narrator_zh": "圣翔"
  },
  {
   "location": "323/TALK",
   "narrator": "ヒカル",
   "text": "いや、その…子供の頃、\n熱っぽい時にいつも姉が\nしてくれていて――"
  },
  {
   "location": "324/TALK",
   "narrator": "ヒカル",
   "text": "それで、つい…。",
   "zh": "然后，不知不觉就……。",
   "narrator_zh": "光"
  },
  {
   "location": "325/TALK",
   "narrator": "雛",
   "text": "ああ、そういうこと\nだったんだ。"
  },
  {
   "location": "326/TALK",
   "narrator": "雛",
   "text": "けど、女の子のおでこに\n急に触ろうとするのは、\nやめた方がいいよー。",
   "zh": "不过，突然想摸女孩子\n的额头，\n最好还是别这样哦—。",
   "narrator_zh": "雏"
  },
  {
   "location": "328/TALK",
   "narrator": "雛",
   "text": "ガブリエラちゃん、\nビックリして警戒\nしちゃってるし。"
  },
  {
   "location": "330/TALK",
   "narrator": "ガブリエラ",
   "text": "…………。"
  },
  {
   "location": "333/TALK",
   "narrator": "ヒカル",
   "text": "…す、すみません。\n驚かせてしまい\nましたよね？"
  },
  {
   "location": "335/TALK",
   "narrator": "キリト",
   "text": "なんか、ヒカルが女子に\nここまで警戒されてる\nのって――",
   "zh": "总觉得光被女生\n警戒到这个\n地步——",
   "narrator_zh": "圣翔"
  },
  {
   "location": "336/TALK",
   "narrator": "キリト",
   "text": "ちょっと新鮮だな。",
   "zh": "挺新鲜的。",
   "narrator_zh": "圣翔"
  },
  {
   "location": "339/TALK",
   "narrator": "ガブリエラ",
   "text": "…………。"
  },
  {
   "location": "340/TALK",
   "narrator": "ガブリエラ",
   "text": "ビックリして、\nつい逃げちゃった\nけど――"
  },
  {
   "location": "342/TALK",
   "narrator": "ガブリエラ",
   "text": "大袈裟だったかも…。\nヒカルくんに悪いこと\nしちゃった…。"
  }
