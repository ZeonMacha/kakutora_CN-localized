{
    "dir": "dramatics/daydra/drm_ch03_00_150.js",
    "type": "Episode",
    "info": {
        "story_id": "3015",
        "cid": "gabriella",
        "title": "らぶとーく  第15話",
        "sub_title": "二人きりより緊張する",
        "title_zh": "恋爱漫谈 第15话",
        "sub_title_zh": "比单独相处更紧张"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "二人きりより緊張する",
            "zh": "比单独相处更紧张"
        },
        {
            "location": "19/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "21/TALK",
            "narrator": "ガブリエラ",
            "text": "やっぱり、たまには\n本で調べ物をするのも\n悪くないわね。",
            "zh": "果然，偶尔\n用书查资料\n也不坏。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "22/TALK",
            "narrator": "ガブリエラ",
            "text": "何でもネット検索じゃ、\n面白くないし。",
            "zh": "什么都靠网上搜索，\n也没什么意思。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "27/TALK",
            "narrator": "キリト",
            "text": "あれ？\nガブリエラじゃん。",
            "zh": "咦？\n这不是加布里埃拉吗。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "29/TALK",
            "narrator": "ガブリエラ",
            "text": "っ！？",
            "zh": "！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "31/TALK",
            "narrator": "雛",
            "text": "あ、本当だ。\n珍しいね…お勉強？",
            "zh": "啊，真的。\n真少见……在学习？",
            "narrator_zh": "雏"
        },
        {
            "location": "32/TALK",
            "narrator": "ガブリエラ",
            "text": "あ、えと…。",
            "zh": "啊，那个……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "34/TALK",
            "narrator": "ヒカル",
            "text": "あ、あの、二人とも。\n図書室ではもう少し\n声を抑えないと…。",
            "zh": "啊，那个，你们两个。\n在图书室得再\n把声音放低一点……",
            "narrator_zh": "光"
        },
        {
            "location": "36/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "38/TALK",
            "narrator": "ヒカル",
            "text": "こんにちは。\nよろしければ、相席して\nよろしいですか？",
            "zh": "你好。\n如果不介意，可以\n拼桌吗？",
            "narrator_zh": "光"
        },
        {
            "location": "40/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "42/TALK",
            "narrator": "雛",
            "text": "ありがとねー。\nそれじゃ、お隣失礼ー。",
            "zh": "谢谢啦。\n那就，打扰隔壁了。",
            "narrator_zh": "雏"
        },
        {
            "location": "43/TALK",
            "narrator": "雛",
            "text": "ふぅ…。",
            "zh": "呼……。",
            "narrator_zh": "雏"
        },
        {
            "location": "48/TALK",
            "narrator": "ガブリエラ",
            "text": "…あんた達、図書室に\n何しに来たの？",
            "zh": "……你们来图书室\n做什么？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "50/TALK",
            "narrator": "雛",
            "text": "えへへ…あたし達も\nちょっと調べ物が\nあってね。",
            "zh": "嘿嘿……我们也是\n有点东西要\n查一查呢。",
            "narrator_zh": "雏"
        },
        {
            "location": "53/TALK",
            "narrator": "キリト",
            "text": "さっさと始めようぜ。\n資料になりそうな本、\n取ってくるぞ。",
            "zh": "赶紧开始吧。\n能当资料的书，\n我去拿。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "55/TALK",
            "narrator": "ヒカル",
            "text": "あ、僕も行きます。",
            "zh": "啊，我也去。",
            "narrator_zh": "光"
        },
        {
            "location": "56/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "66/TALK",
            "narrator": "キリト",
            "text": "はぁ…なんか、頭が\nパンクしそうなんだ\nけど…。",
            "zh": "唉……总觉得脑袋\n要炸掉\n了……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "68/TALK",
            "narrator": "雛",
            "text": "まだそんなに時間\n経ってないじゃん。",
            "zh": "还没过多久\n嘛。",
            "narrator_zh": "雏"
        },
        {
            "location": "70/TALK",
            "narrator": "雛",
            "text": "ほら、そっちの地図帳\n調べてみて。",
            "zh": "来，查查\n那边的地图册。",
            "narrator_zh": "雏"
        },
        {
            "location": "71/TALK",
            "narrator": "キリト",
            "text": "へいへい…。\nったく、まだ数学の\n問題集の方がラクだぜ。",
            "zh": "好好好……\n真是的，还是数学\n习题集更轻松。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "72/TALK",
            "narrator": "ガブリエラ",
            "text": "…なんか、結構手こずっ\nてるみたい。\n何調べてるのかしら？",
            "zh": "……好像，相当费劲\n的样子。\n到底在查什么呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "74/TALK",
            "narrator": "ガブリエラ",
            "text": "…っていうか。",
            "zh": "……话说。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "75/TALK",
            "narrator": "ヒカル",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "光"
        },
        {
            "location": "77/TALK",
            "narrator": "ガブリエラ",
            "text": "ヒカルくん、あんまり\n手伝ってる感じが\nしない…。",
            "zh": "光，不太\n像在帮忙\n的样子……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "80/TALK",
            "narrator": "ガブリエラ",
            "text": "手伝わない、って\nことは、ひなこ達の\n宿題なのかしら？",
            "zh": "不帮忙的话，\n难道是雏子她们\n的作业？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "92/TALK",
            "narrator": "ガブリエラ",
            "text": "ねえ、$handle$も珍しいと思わない？",
            "zh": "喂，$handle$也不觉得稀奇吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "93/TALK",
            "narrator": "ガブリエラ",
            "text": "普通、こういう調べ物だと、ヒカルくんが一番活躍しそうなのに",
            "zh": "通常这种查资料，明明光应该最能发挥作用",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "94/TALK",
            "narrator": "ガブリエラ",
            "text": "何となく、暇してそうな感じがするの…",
            "zh": "总觉得，他看起来很闲……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "96/SEL",
            "narrator": "",
            "text": "筆談で話しかけてみれば？",
            "zh": "试着用写的跟她搭话嘛？",
            "narrator_zh": ""
        },
        {
            "location": "97/ACT",
            "narrator": "",
            "text": "筆談で話しかけてみれば？",
            "zh": "试着用写的跟她搭话嘛？",
            "narrator_zh": ""
        },
        {
            "location": "100/TALK",
            "narrator": "ガブリエラ",
            "text": "えっ！？",
            "zh": "诶！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "103/TALK",
            "narrator": "ガブリエラ",
            "text": "まあ",
            "zh": "嗯",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "104/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょっと気になるし",
            "zh": "也有点在意",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "106/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、なんて声をかければいいかわからないわ",
            "zh": "不过，不知道该怎么开口",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "108/SEL",
            "narrator": "",
            "text": "調べているものについて聞けば",
            "zh": "要是问问他在查什么",
            "narrator_zh": ""
        },
        {
            "location": "109/SEL",
            "narrator": "",
            "text": "付き合いがいいのねって言ってみれば",
            "zh": "说白了你就是待人热络",
            "narrator_zh": ""
        },
        {
            "location": "110/SEL",
            "narrator": "",
            "text": "二人きりでお茶でもどうって聞けば",
            "zh": "问一句要不要两个人喝个茶",
            "narrator_zh": ""
        },
        {
            "location": "111/ACT",
            "narrator": "",
            "text": "調べているものについて聞けば",
            "zh": "要是问问他在查什么",
            "narrator_zh": ""
        },
        {
            "location": "113/TALK",
            "narrator": "ガブリエラ",
            "text": "そうね、私も気になるし",
            "zh": "是啊，我也很在意",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "115/TALK",
            "narrator": "ガブリエラ",
            "text": "早速聞いてみるわ",
            "zh": "我这就问问",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "126/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "128/TALK",
            "narrator": "ヒカル",
            "text": "…ん？\nメモ？",
            "zh": "…嗯？\n笔记？",
            "narrator_zh": "光"
        },
        {
            "location": "129/TALK",
            "narrator": "ヒカル",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "光"
        },
        {
            "location": "132/TALK",
            "narrator": "ヒカル",
            "text": "ああ、すみません。\n話していません\nでしたね。",
            "zh": "啊，抱歉。\n我没把话说\n出来呢。",
            "narrator_zh": "光"
        },
        {
            "location": "133/TALK",
            "narrator": "ヒカル",
            "text": "東京の歴史を調べて\nレポートを纏める\n課題が出ているので――",
            "zh": "作业是调查东京的历史\n并整理成报告，\n所以——",
            "narrator_zh": "光"
        },
        {
            "location": "134/TALK",
            "narrator": "ヒカル",
            "text": "それについて調べて、\nまとめているところ\nなんですよ。",
            "zh": "那件事我在查，\n现在正在\n整理。",
            "narrator_zh": "光"
        },
        {
            "location": "135/TALK",
            "narrator": "ガブリエラ",
            "text": "…そんな課題が\n出てたんだ。",
            "zh": "…原来还有\n这种作业啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "136/TALK",
            "narrator": "ガブリエラ",
            "text": "っていうか、なんか\nすっごい楽しそうかも。",
            "zh": "话说，好像\n特别开心啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "137/TALK",
            "narrator": "ガブリエラ",
            "text": "東京の歴史って、\n前に勉強した時、\n楽しかったなぁ…。",
            "zh": "东京的历史，\n以前学的时候，\n好开心啊……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "138/TALK",
            "narrator": "ヒカル",
            "text": "…ガブリエラさんは\n何を調べているん\nですか？",
            "zh": "……加布里埃拉小姐\n在查\n什么啊？",
            "narrator_zh": "光"
        },
        {
            "location": "139/TALK",
            "narrator": "ガブリエラ",
            "text": "っ！？",
            "zh": "！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "141/TALK",
            "narrator": "ガブリエラ",
            "text": "そうだった。\nあたしも話して\nなかったわ。",
            "zh": "是这样啊。\n我也\n没说。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "144/TALK",
            "narrator": "ガブリエラ",
            "text": "えっと……。",
            "zh": "呃……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "146/TALK",
            "narrator": "ヒカル",
            "text": "…国語の教科書に\n載っている話の――",
            "zh": "……国语课本上\n登着的那个故事——",
            "narrator_zh": "光"
        },
        {
            "location": "147/TALK",
            "narrator": "ヒカル",
            "text": "原作者が書いた他の\n話を調べている…\nですか。",
            "zh": "在查原作者写的\n其他作品……\n是吗。",
            "narrator_zh": "光"
        },
        {
            "location": "149/TALK",
            "narrator": "ヒカル",
            "text": "見たところ、\n芥川龍之介の本を\n調べているようですね。",
            "zh": "看起来，\n是在查芥川龙之介\n的书呢。",
            "narrator_zh": "光"
        },
        {
            "location": "151/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "152/TALK",
            "narrator": "ガブリエラ",
            "text": "教科書に載っていた\n羅生門を読んで、\n気になったんです…と。",
            "zh": "读了教科书上的\n《罗生门》，\n有点在意……发送。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "153/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "155/TALK",
            "narrator": "ヒカル",
            "text": "…え？\nちょっと、教科書を\n見せてもらえますか？",
            "zh": "……诶？\n可以给我看一下\n教科书吗？",
            "narrator_zh": "光"
        },
        {
            "location": "157/TALK",
            "narrator": "ガブリエラ",
            "text": "…な、なに？\nどうしたのかしら？",
            "zh": "……什、什么？\n怎么了呀？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "158/TALK",
            "narrator": "ヒカル",
            "text": "えっと…。\nああ、やっぱり…。",
            "zh": "那个……\n啊，果然……",
            "narrator_zh": "光"
        },
        {
            "location": "159/TALK",
            "narrator": "ヒカル",
            "text": "僕が当時使っていた\n教科書と、内容が\n大分変わっていますね。",
            "zh": "和我当时用的\n教科书，内容\n差了不少呢。",
            "narrator_zh": "光"
        },
        {
            "location": "160/TALK",
            "narrator": "ヒカル",
            "text": "僕の時は羅生門では\nなくて、蜘蛛の糸\nでしたから。",
            "zh": "我那时候不是\n《罗生门》，是\n《蜘蛛之丝》。",
            "narrator_zh": "光"
        },
        {
            "location": "161/TALK",
            "narrator": "ガブリエラ",
            "text": "あ～…あれ、後味悪い\nから、あんまり好きじゃ\nないんだけど…。",
            "zh": "啊～……那个，余味很差，\n所以我不太\n喜欢……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "162/TALK",
            "narrator": "ヒカル",
            "text": "あ、でも漱石のこころは\n僕の時もありましたよ。",
            "zh": "啊，不过漱石的《心》\n我那时候也有哦。",
            "narrator_zh": "光"
        },
        {
            "location": "163/TALK",
            "narrator": "ヒカル",
            "text": "懐かしいなぁ…。\nこれ、感想文を書く\n宿題があったんです。",
            "zh": "好怀念啊……\n这个，有写读后感\n的作业。",
            "narrator_zh": "光"
        },
        {
            "location": "165/TALK",
            "narrator": "ガブリエラ",
            "text": "っ！？",
            "zh": "！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "167/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしもその宿題、\nやりました…っと！",
            "zh": "那个作业，\n我也做过……发送！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "168/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "170/TALK",
            "narrator": "ヒカル",
            "text": "…そうですか。\nガブリエラさんも\nやったんですか。",
            "zh": "……是吗。\n加布里埃拉也\n做过吗。",
            "narrator_zh": "光"
        },
        {
            "location": "171/TALK",
            "narrator": "ヒカル",
            "text": "あれも後味の悪い話\nだから、苦労したのを\n覚えてますよ…。",
            "zh": "那也是余味很差的故事，\n我记得写得很\n辛苦……",
            "narrator_zh": "光"
        },
        {
            "location": "173/TALK",
            "narrator": "雛",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雏"
        },
        {
            "location": "177/TALK",
            "narrator": "ガブリエラ",
            "text": "…な、何よ、ひなこ？\nそんなニヤニヤしちゃ\nって…。",
            "zh": "……干、干嘛呀，雏？\n笑得那么\n不怀好意……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "178/TALK",
            "narrator": "雛",
            "text": "んっふっふっふ…\nいやー、お二人さん――",
            "zh": "嗯哼哼哼……\n哎呀，两位——",
            "narrator_zh": "雏"
        },
        {
            "location": "179/TALK",
            "narrator": "雛",
            "text": "なんか、凄い仲良し\nオーラ発してたから――",
            "zh": "因为散发着\n超要好的气场——",
            "narrator_zh": "雏"
        },
        {
            "location": "180/TALK",
            "narrator": "雛",
            "text": "見てるこっちも\n嬉しくなってきちゃっ\nてねー。",
            "zh": "看着看着，\n我这边也\n高兴起来了呀。",
            "narrator_zh": "雏"
        },
        {
            "location": "182/TALK",
            "narrator": "ヒカル",
            "text": "えっ？",
            "zh": "诶？",
            "narrator_zh": "光"
        },
        {
            "location": "187/TALK",
            "narrator": "ガブリエラ",
            "text": "なっ！？\nな、何言ってるのよ！",
            "zh": "什！？\n你、你在说什么！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "188/TALK",
            "narrator": "ガブリエラ",
            "text": "変な誤解されそうな\n言い方しないで！",
            "zh": "别说得好像会被人\n误会！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "190/TALK",
            "narrator": "ヒカル",
            "text": "ちょ、ガブリエラさん。\n声のボリュームを…。",
            "zh": "等、加布里埃拉。\n声音音量……。",
            "narrator_zh": "光"
        },
        {
            "location": "193/TALK",
            "narrator": "ガブリエラ",
            "text": "っ！！",
            "zh": "唔！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "195/TALK",
            "narrator": "雛",
            "text": "ごめんごめん。\nちょーっとからかい\n過ぎちゃったかなー？",
            "zh": "抱歉抱歉。\n是不是稍微\n捉弄过头了—？",
            "narrator_zh": "雏"
        },
        {
            "location": "197/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "198/TALK",
            "narrator": "ヒカル",
            "text": "えっと…大丈夫ですか、\nガブリエラさん？",
            "zh": "那个……没事吗，\n加布里埃拉？",
            "narrator_zh": "光"
        },
        {
            "location": "200/TALK",
            "narrator": "ガブリエラ",
            "text": "…大丈夫なわけない\nじゃない、もう！",
            "zh": "……怎么可能没事，\n真是的！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "201/ACT",
            "narrator": "",
            "text": "付き合いがいいのねって言ってみれば",
            "zh": "说白了你就是待人热络",
            "narrator_zh": ""
        },
        {
            "location": "202/TALK",
            "narrator": "ガブリエラ",
            "text": "そうね",
            "zh": "说得对",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "203/TALK",
            "narrator": "ガブリエラ",
            "text": "ひなこ達に付き合っているだけみたいだし",
            "zh": "看起来只是在陪雏子她们",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "214/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "216/TALK",
            "narrator": "ヒカル",
            "text": "…ん？\nメモ？",
            "zh": "…嗯？\n笔记？",
            "narrator_zh": "光"
        },
        {
            "location": "217/TALK",
            "narrator": "ヒカル",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "光"
        },
        {
            "location": "220/TALK",
            "narrator": "ヒカル",
            "text": "あ、違うんです。\n勘違いさせちゃい\nましたか？",
            "zh": "啊，不是的。\n我是不是让你\n误会了？",
            "narrator_zh": "光"
        },
        {
            "location": "221/TALK",
            "narrator": "ヒカル",
            "text": "今やってるのって、\n僕らの班で発表する\nレポートの――",
            "zh": "我们现在做的，\n是我们小组要发表的\n报告的——",
            "narrator_zh": "光"
        },
        {
            "location": "222/TALK",
            "narrator": "ヒカル",
            "text": "資料探しなんです。",
            "zh": "资料调查。",
            "narrator_zh": "光"
        },
        {
            "location": "223/TALK",
            "narrator": "ガブリエラ",
            "text": "…どんなレポートなん\nですか…っと。",
            "zh": "……是什么样的报告\n呢……这样。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "225/TALK",
            "narrator": "ヒカル",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "光"
        },
        {
            "location": "227/TALK",
            "narrator": "ヒカル",
            "text": "…えっとですね。",
            "zh": "……那个。",
            "narrator_zh": "光"
        },
        {
            "location": "228/TALK",
            "narrator": "ヒカル",
            "text": "東京の歴史を調べて\nレポートを纏める\n課題が出ているので――",
            "zh": "作业是调查东京的历史\n并整理成报告，\n所以——",
            "narrator_zh": "光"
        },
        {
            "location": "229/TALK",
            "narrator": "ヒカル",
            "text": "それについて調べて、\nまとめているところ\nなんですよ。",
            "zh": "那件事我在查，\n现在正在\n整理。",
            "narrator_zh": "光"
        },
        {
            "location": "231/TALK",
            "narrator": "ヒカル",
            "text": "ただ、僕は海外生活が\n長かったせいか――",
            "zh": "只是，也许是因为我\n在国外生活得久——",
            "narrator_zh": "光"
        },
        {
            "location": "232/TALK",
            "narrator": "ヒカル",
            "text": "どうにも、日本の歴史は\n苦手でして…。",
            "zh": "我实在不太擅长\n日本历史……。",
            "narrator_zh": "光"
        },
        {
            "location": "234/TALK",
            "narrator": "ヒカル",
            "text": "それで、詳しい二人に\n任せっきりになって\nしまっているんですよ。",
            "zh": "结果就全交给\n这两位熟悉情况\n的人了。",
            "narrator_zh": "光"
        },
        {
            "location": "235/TALK",
            "narrator": "ガブリエラ",
            "text": "…そんな課題が\n出てたんだ。",
            "zh": "…原来还有\n这种作业啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "237/TALK",
            "narrator": "ガブリエラ",
            "text": "っていうか、なんか\nすっごい楽しそうかも。",
            "zh": "话说，好像\n特别开心啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "238/TALK",
            "narrator": "ガブリエラ",
            "text": "東京の歴史って、\n前に勉強した時、\n楽しかったなぁ…。",
            "zh": "东京的历史，\n以前学的时候，\n好开心啊……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "240/TALK",
            "narrator": "キリト",
            "text": "なーに、気にすんなよ。\nヒカルには他の教科で\n助けられてるしな。",
            "zh": "什么啊，别在意。\n光在别的科目上\n也帮了我不少。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "241/TALK",
            "narrator": "キリト",
            "text": "おまえが苦手な分野は、\n俺達でサポートするぜ。",
            "zh": "你不擅长的领域，\n就由我们来支援。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "243/TALK",
            "narrator": "雛",
            "text": "そういうこと。\nま、これくらい\n遠慮は無用さー。",
            "zh": "就是这么回事。\n这点小忙\n不用客气啦。",
            "narrator_zh": "雏"
        },
        {
            "location": "245/TALK",
            "narrator": "ヒカル",
            "text": "ありがとうございます。\n本当、助けていただいて\nありがたいです。",
            "zh": "谢谢你。\n真的，帮了大忙，\n太感谢了。",
            "narrator_zh": "光"
        },
        {
            "location": "247/TALK",
            "narrator": "キリト",
            "text": "ま、もうしばらくは\n掛かりそうだし――",
            "zh": "嘛，还得再\n花一会儿——",
            "narrator_zh": "圣翔"
        },
        {
            "location": "248/TALK",
            "narrator": "キリト",
            "text": "ガブリエラと話して、\n待っててくれよ。",
            "zh": "你和加布里埃拉聊着，\n等一下吧。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "250/TALK",
            "narrator": "ガブリエラ",
            "text": "っ！？",
            "zh": "！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "252/TALK",
            "narrator": "ガブリエラ",
            "text": "な、何であたしの\n名前が出てくるの！？",
            "zh": "为、为什么会出现\n我的名字！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "254/TALK",
            "narrator": "雛",
            "text": "キリト、それナイス！\nいいこと言うじゃん。",
            "zh": "圣翔，这句漂亮！\n说得真好嘛。",
            "narrator_zh": "雏"
        },
        {
            "location": "255/TALK",
            "narrator": "雛",
            "text": "レポートはあたし達が\n引き受けるから――",
            "zh": "报告我们来\n承担——",
            "narrator_zh": "雏"
        },
        {
            "location": "256/TALK",
            "narrator": "雛",
            "text": "若い者同士、どうぞ\n二人きりで仲良く語り\n合っちゃっててね。",
            "zh": "年轻人嘛，请\n两个人单独好好\n聊聊吧。",
            "narrator_zh": "雏"
        },
        {
            "location": "258/ACT",
            "narrator": "",
            "text": "二人きりでお茶でもどうって聞けば",
            "zh": "问一句要不要两个人喝个茶",
            "narrator_zh": ""
        },
        {
            "location": "260/TALK",
            "narrator": "ガブリエラ",
            "text": "は！？",
            "zh": "哈！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "261/TALK",
            "narrator": "ガブリエラ",
            "text": "どうしてそうなっちゃうのよ！？",
            "zh": "为什么会变成那样！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "263/TALK",
            "narrator": "ガブリエラ",
            "text": "今って、そんなこという雰囲気じゃないでしょ？",
            "zh": "现在可不是说那种话的气氛吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "264/TALK",
            "narrator": "ガブリエラ",
            "text": "っていうか、これ、もしＯＫされたら",
            "zh": "话说，这个要是被答应了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "265/TALK",
            "narrator": "ガブリエラ",
            "text": "デートになっちゃう////////",
            "zh": "会变成约会的////////",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "266/TALK",
            "narrator": "ガブリエラ",
            "text": "何でそんな変なこと\n言うの？",
            "zh": "为什么说\n这种奇怪的话？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "277/TALK",
            "narrator": "ガブリエラ",
            "text": "まったく…マルザンナ\nってば、急に変なこと\n言い出して…。",
            "zh": "真是的……玛尔赞娜\n突然说起\n奇怪的话……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "279/TALK",
            "narrator": "ヒカル",
            "text": "あの…大丈夫ですか？",
            "zh": "那个……你没事吗？",
            "narrator_zh": "光"
        },
        {
            "location": "281/TALK",
            "narrator": "ガブリエラ",
            "text": "っ！",
            "zh": "！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "282/TALK",
            "narrator": "ヒカル",
            "text": "あ、すみません。\n驚かせちゃいました？",
            "zh": "啊，对不起。\n吓到你了吗？",
            "narrator_zh": "光"
        },
        {
            "location": "283/TALK",
            "narrator": "ヒカル",
            "text": "でも、先ほどから\n急に顔が赤くなってきた\nみたいですし…。",
            "zh": "不过，从刚才起\n脸好像突然\n红起来了……。",
            "narrator_zh": "光"
        },
        {
            "location": "286/TALK",
            "narrator": "ガブリエラ",
            "text": "ま、マルザンナが\n変なこと言うから！",
            "zh": "因、因为玛尔赞娜\n说了奇怪的话！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "287/TALK",
            "narrator": "ヒカル",
            "text": "…熱でもあるんじゃ\nありませんか？",
            "zh": "……你是不是\n发烧了？",
            "narrator_zh": "光"
        },
        {
            "location": "289/TALK",
            "narrator": "ヒカル",
            "text": "ちょっとすみません。",
            "zh": "失礼一下。",
            "narrator_zh": "光"
        },
        {
            "location": "295/TALK",
            "narrator": "ガブリエラ",
            "text": "…………っ！？",
            "zh": "…………！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "298/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "300/TALK",
            "narrator": "雛",
            "text": "うわっ、何！？",
            "zh": "哇，什么！？",
            "narrator_zh": "雏"
        },
        {
            "location": "302/TALK",
            "narrator": "ヒカル",
            "text": "あっ…す、すみません。\n驚かせてしまいまし\nたか？",
            "zh": "啊……对、对不起。\n吓到你\n了吗？",
            "narrator_zh": "光"
        },
        {
            "location": "304/TALK",
            "narrator": "キリト",
            "text": "なんだなんだ？\nどうかしたのか？",
            "zh": "怎么了怎么了？\n出什么事了？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "317/TALK",
            "narrator": "ヒカル",
            "text": "いえ…ガブリエラさんの\n熱を測ろうかと思い――",
            "zh": "没有……我想给加布里埃拉\n量一下体温——",
            "narrator_zh": "光"
        },
        {
            "location": "318/TALK",
            "narrator": "ヒカル",
            "text": "つい、おでこに触ろうと\nしてしまって…。",
            "zh": "我不小心\n想摸她的额头了……。",
            "narrator_zh": "光"
        },
        {
            "location": "320/TALK",
            "narrator": "キリト",
            "text": "おでこって…おまえ、\nそういうことする\nタイプだったっけか？",
            "zh": "额头啊……你这家伙，\n原来是会做\n这种事的那种人吗？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "323/TALK",
            "narrator": "ヒカル",
            "text": "いや、その…子供の頃、\n熱っぽい時にいつも姉が\nしてくれていて――",
            "zh": "不，那个……小时候，\n发烧的时候姐姐\n总是这么做——",
            "narrator_zh": "光"
        },
        {
            "location": "324/TALK",
            "narrator": "ヒカル",
            "text": "それで、つい…。",
            "zh": "然后，不知不觉就……。",
            "narrator_zh": "光"
        },
        {
            "location": "325/TALK",
            "narrator": "雛",
            "text": "ああ、そういうこと\nだったんだ。",
            "zh": "啊，原来\n是这么回事。",
            "narrator_zh": "雏"
        },
        {
            "location": "326/TALK",
            "narrator": "雛",
            "text": "けど、女の子のおでこに\n急に触ろうとするのは、\nやめた方がいいよー。",
            "zh": "不过，突然想摸女孩子\n的额头，\n最好还是别这样哦—。",
            "narrator_zh": "雏"
        },
        {
            "location": "328/TALK",
            "narrator": "雛",
            "text": "ガブリエラちゃん、\nビックリして警戒\nしちゃってるし。",
            "zh": "加布里埃拉，\n吓了一跳，警戒\n起来了。",
            "narrator_zh": "雏"
        },
        {
            "location": "330/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "333/TALK",
            "narrator": "ヒカル",
            "text": "…す、すみません。\n驚かせてしまい\nましたよね？",
            "zh": "……对、对不起。\n吓到你了\n吧？",
            "narrator_zh": "光"
        },
        {
            "location": "335/TALK",
            "narrator": "キリト",
            "text": "なんか、ヒカルが女子に\nここまで警戒されてる\nのって――",
            "zh": "总觉得光被女生\n警戒到这个\n地步——",
            "narrator_zh": "圣翔"
        },
        {
            "location": "336/TALK",
            "narrator": "キリト",
            "text": "ちょっと新鮮だな。",
            "zh": "挺新鲜的。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "339/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "340/TALK",
            "narrator": "ガブリエラ",
            "text": "ビックリして、\nつい逃げちゃった\nけど――",
            "zh": "吓了一跳，\n下意识就躲开了\n——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "342/TALK",
            "narrator": "ガブリエラ",
            "text": "大袈裟だったかも…。\nヒカルくんに悪いこと\nしちゃった…。",
            "zh": "也许太夸张了……\n对光做了\n不好的事……",
            "narrator_zh": "加布里埃拉"
        }
    ]
}
