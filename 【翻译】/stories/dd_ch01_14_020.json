        "sub_title_zh": "国政绫水与内衣"
    },
    "entry": [
        {
            "location": "479/SCENARIO",
            "narrator": "",
            "text": "アーヤＭＶ回２",
            "zh": "绫水MV第2回",
            "narrator_zh": ""
        },
        {
            "location": "496/TALK",
            "narrator": "神楽",
            "text": "どうですか？\n可愛い下着、\n見つかりましたか？",
            "zh": "怎么样？\n可爱的内衣，\n找到了吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "498/TALK",
            "narrator": "つばめ",
            "text": "え、えっと…うん。\nどの下着も\n可愛いと思うよ。",
            "zh": "诶、那个……嗯。\n哪件内衣\n都觉得可爱呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "499/TALK",
            "narrator": "神楽",
            "text": "もぉ、つばめさん！\nしっかり選ばないと\nダメじゃないですか。",
            "zh": "真是的，燕！\n不好好挑\n可不行。",
            "narrator_zh": "神乐"
        },
        {
            "location": "501/TALK",
            "narrator": "つばめ",
            "text": "で、でも、わたし\nこういうお店来るの\n初めてだから…。",
            "zh": "可、可是，我\n来这种店\n还是第一次呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "503/TALK",
            "narrator": "神楽",
            "text": "じゃあ、私が代わりに\n選んじゃいますね。\nえーっと…。",
            "zh": "那我替你\n挑吧。\n那个……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "505/TALK",
            "narrator": "神楽",
            "text": "あっ、これなんか\nセクシーな感じで\nいいかも！",
            "zh": "啊，这件\n感觉挺性感的，\n也许不错！",
            "narrator_zh": "神乐"
        },
        {
            "location": "507/TALK",
            "narrator": "つばめ",
            "text": "えっ！？\nこれはちょっと…。",
            "zh": "诶！？\n这件有点……。",
            "narrator_zh": "燕"
        },
        {
            "location": "508/TALK",
            "narrator": "神楽",
            "text": "つばめさんは\n素敵な胸をお持ち\nですから――",
            "zh": "燕的\n胸部很漂亮，\n所以——",
            "narrator_zh": "神乐"
        },
        {
            "location": "509/TALK",
            "narrator": "神楽",
            "text": "こういうデザインのが\n絶対似合いますよ！",
            "zh": "这种设计的\n绝对适合你！",
            "narrator_zh": "神乐"
        },
        {
            "location": "511/TALK",
            "narrator": "つばめ",
            "text": "で、デザインは\n素敵だと思うけど――",
            "zh": "设、设计\n我觉得很好看，可是——",
            "narrator_zh": "燕"
        },
        {
            "location": "512/TALK",
            "narrator": "つばめ",
            "text": "生地、ちょっと\n少なくない？",
            "zh": "布料，是不是\n有点少？",
            "narrator_zh": "燕"
        },
        {
            "location": "513/TALK",
            "narrator": "神楽",
            "text": "それがセクシー度\n倍増ポイントです！",
            "zh": "那就是性感度\n翻倍的重点！",
            "narrator_zh": "神乐"
        },
        {
            "location": "515/TALK",
            "narrator": "つばめ",
            "text": "わたし、普通に白とか\nベージュとか、\nイチゴ柄がいいな…。",
            "zh": "我就想要白色，\n或者米色，\n草莓图案就好了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "516/TALK",
            "narrator": "神楽",
            "text": "…はい？\nいま、イチゴって\n言いました？",
            "zh": "……什么？\n你刚才说了\n草莓？",
            "narrator_zh": "神乐"
        },
        {
            "location": "517/TALK",
            "narrator": "つばめ",
            "text": "うん、イチゴ。\n可愛くて\nお気に入りなんだ。",
            "zh": "嗯，草莓。\n很可爱，\n是我最喜欢的。",
            "narrator_zh": "燕"
        },
        {
            "location": "519/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "520/TALK",
            "narrator": "つばめ",
            "text": "…卯月さん？",
            "zh": "……卯月？",
            "narrator_zh": "燕"
        },
        {
            "location": "522/TALK",
            "narrator": "神楽",
            "text": "つばめさん、\n最高です！",
            "zh": "燕，\n最棒了！",
            "narrator_zh": "神乐"
        },
        {
            "location": "524/TALK",
            "narrator": "つばめ",
            "text": "え、えぇっ！？",
            "zh": "诶、诶诶！？",
            "narrator_zh": "燕"
        },
        {
            "location": "529/TALK",
            "narrator": "ガブリエラ",
            "text": "何言ってんのよ。\n高校生にもなって\n子供っぽい…。",
            "zh": "你在说什么。\n都高中生了，\n还这么孩子气……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "531/TALK",
            "narrator": "つばめ",
            "text": "こ、子供っぽい\nかなぁ？",
            "zh": "孩、孩子气\n吗呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "533/TALK",
            "narrator": "ガブリエラ",
            "text": "当然でしょ？\n今どき、小学生でも\n履かないわよ。",
            "zh": "那还用说？\n现在连小学生\n都不会穿这种了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "536/TALK",
            "narrator": "神楽",
            "text": "ガブちゃんなら\n年相応に似合うと\n思いますよ？",
            "zh": "要是加布，\n合年纪的款式\n会合适哦？",
            "narrator_zh": "神乐"
        },
        {
            "location": "537/TALK",
            "narrator": "ガブリエラ",
            "text": "どういう意味よ！？",
            "zh": "什么意思！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "538/TALK",
            "narrator": "つばめ",
            "text": "あ、えっと…、\nそうだ！",
            "zh": "啊，那个……，\n对了！",
            "narrator_zh": "燕"
        },
        {
            "location": "539/TALK",
            "narrator": "つばめ",
            "text": "ガブちゃんは\n気に入った下着、\n見つかったの？",
            "zh": "加布\n有找到\n喜欢的内衣吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "541/TALK",
            "narrator": "ガブリエラ",
            "text": "え！？　ま、まあ、\n一応ね…。",
            "zh": "诶！？　这、这个，\n算是吧……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "542/TALK",
            "narrator": "神楽",
            "text": "何で後ろに\n隠してるんですか？",
            "zh": "为什么藏在\n身后呀？",
            "narrator_zh": "神乐"
        },
        {
            "location": "545/TALK",
            "narrator": "ガブリエラ",
            "text": "し、下着は見せびら\nかすようなものじゃ\nないからよ…。",
            "zh": "内、内衣又不是\n拿来显摆的\n东西……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "548/TALK",
            "narrator": "アーヤ",
            "text": "――えっ！？\nちょっと、ギャヴィ！",
            "zh": "——诶！？\n等一下，加维！",
            "narrator_zh": "绫水"
        },
        {
            "location": "553/TALK",
            "narrator": "アーヤ",
            "text": "その持ってる下着、\nギャヴィには\n早過ぎない？",
            "zh": "你拿着的那件内衣，\n对加维来说\n是不是太早了？",
            "narrator_zh": "绫水"
        },
        {
            "location": "558/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょ、アーヤ！\n勝手に見ないで！",
            "zh": "等、绫水！\n不许随便看！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "560/TALK",
            "narrator": "アーヤ",
            "text": "でも、黒はもう少し\n大人になってから\nじゃないと――",
            "zh": "可是，黑色要再\n长大一点\n才行——",
            "narrator_zh": "绫水"
        },
        {
            "location": "561/TALK",
            "narrator": "ガブリエラ",
            "text": "言わなくていいから！",
            "zh": "不用说了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "563/TALK",
            "narrator": "神楽",
            "text": "黒って…さすがに\nガブちゃんに黒は\n早過ぎますよ…。",
            "zh": "黑色……果然\n对加布来说黑色\n太早了……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "567/TALK",
            "narrator": "ガブリエラ",
            "text": "関係ないでしょ！\nあたしが買うん\nだから。",
            "zh": "没关系吧！\n买的人是我，\n所以。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "572/TALK",
            "narrator": "ガブリエラ",
            "text": "っていうか、\nそういうアーヤは\nどうなのよ？",
            "zh": "话说回来，\n说这种话的绫水\n你自己呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "574/TALK",
            "narrator": "アーヤ",
            "text": "え？　別に普通だと\n思うけど…。",
            "zh": "诶？　我觉得\n挺普通的……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "575/TALK",
            "narrator": "ガブリエラ",
            "text": "そう言って、本当は\nアーヤも黒とか\n選んでるんじゃ――",
            "zh": "嘴上这么说，其实\n绫水也在挑\n黑色什么的——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "576/TALK",
            "narrator": "ガブリエラ",
            "text": "…って、何それ？\n本当に普通じゃない。",
            "zh": "……等等，那是什么？\n真的一点都不普通。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "577/TALK",
            "narrator": "アーヤ",
            "text": "だから、普通だって\n言ったでしょ？",
            "zh": "所以我才说了，\n很普通吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "579/TALK",
            "narrator": "ガブリエラ",
            "text": "なんか、シンプル\n過ぎてつまらない\nわね…。",
            "zh": "总觉得，简单得\n过头，没意思\n……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "583/TALK",
            "narrator": "つばめ",
            "text": "そうかな？\n逆に大人っぽくて\n素敵だと思うよ。",
            "zh": "是吗？\n我倒觉得成熟，\n很好看呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "585/TALK",
            "narrator": "ガブリエラ",
            "text": "大人っぽいのは\nあたしの下着でしょ。",
            "zh": "成熟的是\n我的内衣才对。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "588/TALK",
            "narrator": "神楽",
            "text": "色だけじゃ大人っぽい\nとは言えませんよ。",
            "zh": "光靠颜色\n可说不上成熟哦。",
            "narrator_zh": "神乐"
        },
        {
            "location": "590/TALK",
            "narrator": "神楽",
            "text": "私がガブちゃんに合う\n大人っぽい下着を\n選んであげますね。",
            "zh": "我来给加布挑\n适合的成熟\n内衣哦。",
            "narrator_zh": "神乐"
        },
        {
            "location": "592/TALK",
            "narrator": "ガブリエラ",
            "text": "えー、神楽に\n任せるの\n凄い不安なんだけど。",
            "zh": "诶——，交给神乐\n来办的话\n超级不放心。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "593/TALK",
            "narrator": "神楽",
            "text": "大丈夫ですよー。\nうーん、ガブちゃんに\n似合うのは…。",
            "zh": "没问题的——。\n嗯——，适合加布的\n是……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "598/TALK",
            "narrator": "ガブリエラ",
            "text": "選ぶのは勝手だけど、\n買わないからね！",
            "zh": "你要挑随你，\n我可不买！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "600/TALK",
            "narrator": "つばめ",
            "text": "あはは…多分、\n凄いの選びそうな\n気がします。",
            "zh": "啊哈哈……总觉得，\n会挑出很夸张的\n来呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "602/TALK",
            "narrator": "つばめ",
            "text": "わたしにも、\nこんな生地の少ない\n下着選んだし…。",
            "zh": "给我也挑了\n布料这么少的\n内衣……。",
            "narrator_zh": "燕"
        },
        {
            "location": "603/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "615/TALK",
            "narrator": "つばめ",
            "text": "$handle$さーん",
            "zh": "$handle$——",
            "narrator_zh": "燕"
        },
        {
            "location": "616/TALK",
            "narrator": "つばめ",
            "text": "どぅ思ぅ？ヾ(｡>﹏<｡)ﾉﾞ",
            "zh": "你觉得怎么样呀？ヾ(｡>﹏<｡)ﾉﾞ",
            "narrator_zh": "燕"
        },
        {
            "location": "617/TALK",
            "narrator": "つばめ",
            "text": "卯月さんの",
            "zh": "卯月挑的",
            "narrator_zh": "燕"
        },
        {
            "location": "619/TALK",
            "narrator": "つばめ",
            "text": "選んだ下着",
            "zh": "那件内衣",
            "narrator_zh": "燕"
        },
        {
            "location": "620/TALK",
            "narrator": "つばめ",
            "text": "ちょっと",
            "zh": "有点",
            "narrator_zh": "燕"
        },
        {
            "location": "622/TALK",
            "narrator": "つばめ",
            "text": "過激すぎだよね？(/ω＼)(/ω＼)ﾊｽﾞｶｼｰｨ",
            "zh": "太过火了呀？(/ω＼)(/ω＼)ﾊｽﾞｶｼｰｨ",
            "narrator_zh": "燕"
        },
        {
            "location": "624/SEL",
            "narrator": "",
            "text": "見えなくてわからない",
            "zh": "看不见，不明白",
            "narrator_zh": ""
        },
        {
            "location": "625/ACT",
            "narrator": "",
            "text": "見えなくてわからない",
            "zh": "看不见，不明白",
            "narrator_zh": ""
        },
        {
            "location": "628/TALK",
            "narrator": "つばめ",
            "text": "そぅなの？(´･ω･｀) ",
            "zh": "是这样呀？(´･ω･｀) ",
            "narrator_zh": "燕"
        },
        {
            "location": "630/TALK",
            "narrator": "つばめ",
            "text": "残念(o´Д`)=з",
            "zh": "可惜呀(o´Д`)=з",
            "narrator_zh": "燕"
        },
        {
            "location": "631/TALK",
            "narrator": "つばめ",
            "text": "それじゃ",
            "zh": "那",
            "narrator_zh": "燕"
        },
        {
            "location": "632/TALK",
            "narrator": "つばめ",
            "text": "やめよぅかな？(･Д･｀)",
            "zh": "那就算了呀？(･Д･｀)",
            "narrator_zh": "燕"
        },
        {
            "location": "634/SEL",
            "narrator": "",
            "text": "買って着て見せてよ！",
            "zh": "买下来穿给我看！",
            "narrator_zh": ""
        },
        {
            "location": "635/SEL",
            "narrator": "",
            "text": "アーヤに聞いてみるのは？",
            "zh": "问问绫水怎么样？",
            "narrator_zh": ""
        },
        {
            "location": "636/ACT",
            "narrator": "",
            "text": "買って着て見せてよ！",
            "zh": "买下来穿给我看！",
            "narrator_zh": ""
        },
        {
            "location": "639/TALK",
            "narrator": "つばめ",
            "text": "見せませんー",
            "zh": "不给看——",
            "narrator_zh": "燕"
        },
        {
            "location": "650/TALK",
            "narrator": "つばめ",
            "text": "$handle$さんって、\nえっちな人なの\nかなぁ…？",
            "zh": "$handle$，\n是不是\n色色的人呀……？",
            "narrator_zh": "燕"
        },
        {
            "location": "652/TALK",
            "narrator": "アーヤ",
            "text": "あら？\nつばめの持ってる\nその下着――",
            "zh": "咦？\n燕拿着的\n那件内衣——",
            "narrator_zh": "绫水"
        },
        {
            "location": "656/TALK",
            "narrator": "つばめ",
            "text": "えっ！？\nあ、これはその、\n卯月さんが…。",
            "zh": "诶！？\n啊，这个是那个，\n卯月她……。",
            "narrator_zh": "燕"
        },
        {
            "location": "657/TALK",
            "narrator": "アーヤ",
            "text": "可愛くていいわね。",
            "zh": "挺可爱的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "659/TALK",
            "narrator": "つばめ",
            "text": "えぇっ！？\nでも、デザインが\nちょっと…。",
            "zh": "诶诶！？\n可是，设计\n有点……。",
            "narrator_zh": "燕"
        },
        {
            "location": "660/TALK",
            "narrator": "アーヤ",
            "text": "うーん、慣れてないと\nちょっと付けづらく\n思えるかしら？",
            "zh": "嗯，不习惯的话，\n会觉得有点\n不好穿吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "661/TALK",
            "narrator": "アーヤ",
            "text": "けど、つばめだって\n高校生の女の子なん\nだから――",
            "zh": "不过，燕也是\n高中生的女孩子，\n所以——",
            "narrator_zh": "绫水"
        },
        {
            "location": "662/TALK",
            "narrator": "アーヤ",
            "text": "これくらいいいと\n思うけど？",
            "zh": "这种程度\n可以吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "664/TALK",
            "narrator": "つばめ",
            "text": "そ、そうですか？",
            "zh": "是、是这样吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "665/TALK",
            "narrator": "アーヤ",
            "text": "もちろん、学校には\n付けてかない方が\nいいと思うけどね。",
            "zh": "当然，去学校\n还是别穿\n比较好。",
            "narrator_zh": "绫水"
        },
        {
            "location": "668/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょっと、何それ？\nあたしには早いとか\n言ってたくせに。",
            "zh": "等等，那是什么？\n明明跟我说\n对我来说太早。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "671/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィに\n黒は早すぎよ。",
            "zh": "对加维来说，\n黑色太早了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "672/TALK",
            "narrator": "ガブリエラ",
            "text": "またそうやって\n子ども扱いして！",
            "zh": "又这样\n把我当小孩子！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "673/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしだって\n黒い下着くらい\n着こなせるわよ！",
            "zh": "我这种程度的\n黑色内衣\n也能穿得好看！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "675/TALK",
            "narrator": "アーヤ",
            "text": "着こなすって…、\n別に見せる相手も\nいないくせに…。",
            "zh": "穿得好看……，\n可又没有\n给人看的对象……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "676/TALK",
            "narrator": "ガブリエラ",
            "text": "なっ！？",
            "zh": "什！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "677/TALK",
            "narrator": "ガブリエラ",
            "text": "そ、それ言うなら\nアーヤもでしょ！",
            "zh": "那、那这么说的话\n绫水也一样吧！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "678/TALK",
            "narrator": "アーヤ",
            "text": "私は黒なんて\n買ってないわ。",
            "zh": "我可没买\n什么黑色。",
            "narrator_zh": "绫水"
        },
        {
            "location": "679/TALK",
            "narrator": "ガブリエラ",
            "text": "でも持ってるじゃん。\n前に銭湯で付けてたの\n見たわよ？",
            "zh": "可你有啊。\n之前在澡堂穿的\n我看到了哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "680/TALK",
            "narrator": "アーヤ",
            "text": "そりゃ、私はもう\n成人してるし。",
            "zh": "那是因为，我已经\n成年了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "682/TALK",
            "narrator": "ガブリエラ",
            "text": "なのに見せる相手が\nいないのね…。",
            "zh": "可还是没有\n能看的人……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "684/TALK",
            "narrator": "アーヤ",
            "text": "そ、そういう変なこと\n言わないの！",
            "zh": "别、别说这种\n奇怪的话！",
            "narrator_zh": "绫水"
        },
        {
            "location": "685/TALK",
            "narrator": "ガブリエラ",
            "text": "最初に言ったのは\nアーヤじゃん！",
            "zh": "先说的是\n绫水吧！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "688/TALK",
            "narrator": "つばめ",
            "text": "ふ、二人とも\n落ち着いて――",
            "zh": "你、你们两个\n冷静一下——",
            "narrator_zh": "燕"
        },
        {
            "location": "692/TALK",
            "narrator": "神楽",
            "text": "相手ならいますよ。",
            "zh": "要说对象，是有的。",
            "narrator_zh": "神乐"
        },
        {
            "location": "693/TALK",
            "narrator": "アーヤ",
            "text": "は？",
            "zh": "啊？",
            "narrator_zh": "绫水"
        },
        {
            "location": "703/TALK",
            "narrator": "神楽",
            "text": "皆さん、見せる\n相手ならいるじゃ\nないですか。",
            "zh": "大家，给人看的\n对象，不是\n就有的吗。",
            "narrator_zh": "神乐"
        },
        {
            "location": "705/TALK",
            "narrator": "つばめ",
            "text": "え！？　誰のこと！？",
            "zh": "诶！？　谁呀！？",
            "narrator_zh": "燕"
        },
        {
            "location": "708/TALK",
            "narrator": "神楽",
            "text": "私たちですよ。",
            "zh": "是我们呀。",
            "narrator_zh": "神乐"
        },
        {
            "location": "709/TALK",
            "narrator": "神楽",
            "text": "ランジェリー\nパーティーを\nすれば――",
            "zh": "办一场\n内衣派对\n的话——",
            "narrator_zh": "神乐"
        },
        {
            "location": "710/TALK",
            "narrator": "神楽",
            "text": "皆さん自慢の下着を、\n堂々とお披露目する\nことができるんです！",
            "zh": "大家就能把得意的内衣，\n堂堂正正地\n亮出来了！",
            "narrator_zh": "神乐"
        },
        {
            "location": "711/TALK",
            "narrator": "つばめ",
            "text": "し、下着でパーティー\nするの！？",
            "zh": "用、用内衣办派对\n吗！？",
            "narrator_zh": "燕"
        },
        {
            "location": "714/TALK",
            "narrator": "アーヤ",
            "text": "そういうわけじゃ\nなくて、えっと――",
            "zh": "不是那个意思，\n那个——",
            "narrator_zh": "绫水"
        },
        {
            "location": "715/TALK",
            "narrator": "アーヤ",
            "text": "パジャマパーティーの\n下着版、って感じ\nかしら？",
            "zh": "像是睡衣派对的\n内衣版，\n那种感觉吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "717/TALK",
            "narrator": "つばめ",
            "text": "で、でも、下着姿\nなんですよね？",
            "zh": "可、可是，是穿着\n内衣的样子吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "719/TALK",
            "narrator": "神楽",
            "text": "大丈夫ですよ。\n私たち以外は\n誰も見てませんし。",
            "zh": "没关系的。\n除了我们，\n没有别人看。",
            "narrator_zh": "神乐"
        },
        {
            "location": "720/SEL",
            "narrator": "",
            "text": "$me$が見てるよ",
            "zh": "$me$在看哦",
            "narrator_zh": ""
        },
        {
            "location": "722/TALK",
            "narrator": "つばめ",
            "text": "それでもちょっと\n恥ずかしいけど…。",
            "zh": "就算这样还是\n有点害羞……。",
            "narrator_zh": "燕"
        },
        {
            "location": "723/TALK",
            "narrator": "神楽",
            "text": "やってみると、\nそうでもないですよ。",
            "zh": "做了之后，\n也没那么回事。",
            "narrator_zh": "神乐"
        },
        {
            "location": "724/TALK",
            "narrator": "神楽",
            "text": "ね、アーヤさん？",
            "zh": "对吧，绫水？",
            "narrator_zh": "神乐"
        },
        {
            "location": "726/TALK",
            "narrator": "アーヤ",
            "text": "ね、って言われても、\n私もやったことないん\nだけど…。",
            "zh": "就算你问我，\n我也没办过\n……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "730/TALK",
            "narrator": "みやび",
            "text": "みんな、やたらと\n盛り上がっちゅうね。",
            "zh": "大家，热闹得很\n咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "732/TALK",
            "narrator": "神楽",
            "text": "今、ランジェリー\nパーティーをする\n計画を立てて――",
            "zh": "我们正在计划\n办一场内衣\n派对——",
            "narrator_zh": "神乐"
        },
        {
            "location": "733/TALK",
            "narrator": "神楽",
            "text": "って…みやびさん、\n凄い下着を選んで\nますね…。",
            "zh": "说起来……雅，\n挑了好厉害的\n内衣呀……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "735/TALK",
            "narrator": "みやび",
            "text": "ん？　これが何か？",
            "zh": "嗯？　这是么子？",
            "narrator_zh": "雅"
        },
        {
            "location": "737/TALK",
            "narrator": "ガブリエラ",
            "text": "うわっ、何それ！？\n超ド派手じゃない！",
            "zh": "哇，那是什么！？\n也太花哨了吧！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "738/TALK",
            "narrator": "みやび",
            "text": "こっちのは地味やぞ。",
            "zh": "这边这件素得很啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "739/TALK",
            "narrator": "神楽",
            "text": "もう一枚は、その…、\n言いづらいですけど、\nおばさんっぽいです。",
            "zh": "另一件，那个……，\n不太好意思说，\n有点像阿姨。",
            "narrator_zh": "神乐"
        },
        {
            "location": "740/TALK",
            "narrator": "みやび",
            "text": "うむ、うちもそう\n思うてたちや。",
            "zh": "嗯，我也是\n这么觉得咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "742/TALK",
            "narrator": "アーヤ",
            "text": "そう思うなら\nどうして――",
            "zh": "既然这么想，\n为什么——",
            "narrator_zh": "绫水"
        },
        {
            "location": "745/TALK",
            "narrator": "アーヤ",
            "text": "あっ…そっか。\nそういうことね。",
            "zh": "啊……是这样。\n原来是这么回事。",
            "narrator_zh": "绫水"
        },
        {
            "location": "747/TALK",
            "narrator": "つばめ",
            "text": "どういうことですか？",
            "zh": "什么意思呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "749/TALK",
            "narrator": "アーヤ",
            "text": "多分、それくらいしか\nサイズがなかったん\nじゃないの？",
            "zh": "大概，这个尺码\n只有这些\n吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "751/TALK",
            "narrator": "みやび",
            "text": "うむ…うちに合うのが\nこれだけやったがよ。",
            "zh": "嗯……合我身的\n就只有这几件啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "753/TALK",
            "narrator": "つばめ",
            "text": "大きいサイズって\n置いてないんですか？",
            "zh": "大尺码的\n没有放吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "754/TALK",
            "narrator": "みやび",
            "text": "無くはないけんど、\nやたらと派手なのが\n多くて――",
            "zh": "也不是没得，不过，\n花哨的\n特别多——",
            "narrator_zh": "雅"
        },
        {
            "location": "755/TALK",
            "narrator": "みやび",
            "text": "シンプルなのは\n皆無に近いがよ。",
            "zh": "简单的\n几乎没得啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "756/TALK",
            "narrator": "アーヤ",
            "text": "…私の友達にも\n胸の大きい子が\nいるんだけど――",
            "zh": "……我朋友里也有\n胸很大的\n女孩子——",
            "narrator_zh": "绫水"
        },
        {
            "location": "757/TALK",
            "narrator": "アーヤ",
            "text": "よくそれ言われるわ。\nワイヤーが入ってると\n痛い、とかも。",
            "zh": "经常听到这种话。\n有钢圈的话\n会疼，之类的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "759/TALK",
            "narrator": "みやび",
            "text": "サイズが合わんとな。\nやき、ワイヤー無しが\n好きなんやけんど――",
            "zh": "尺码不合咯。\n所以嘛，我喜欢没钢圈的，\n不过——",
            "narrator_zh": "雅"
        },
        {
            "location": "760/TALK",
            "narrator": "みやび",
            "text": "まあ、この店には\nなかったき、贅沢は\n言えん。",
            "zh": "这家店里\n没得嘛，就没法\n讲究了。",
            "narrator_zh": "雅"
        },
        {
            "location": "762/TALK",
            "narrator": "神楽",
            "text": "…なんか、おばさん\nっぽいとか言って、\nすみません…。",
            "zh": "……那个，说什么\n像阿姨之类的，\n对不起……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "764/TALK",
            "narrator": "みやび",
            "text": "いや、構わん構わん。\nうちもそう思うてるん\nやし。",
            "zh": "不，没事没事。\n我自己也是\n这么觉得嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "765/TALK",
            "narrator": "みやび",
            "text": "まあ、下着のデザイン\nのことで騒げるんは\n幸せなことやき――",
            "zh": "反正，能为内衣设计\n吵上一吵，\n是件幸福事嘛——",
            "narrator_zh": "雅"
        },
        {
            "location": "766/TALK",
            "narrator": "みやび",
            "text": "うちに遠慮せんで、\n思いっきり楽しまんと\nいかんぞね。",
            "zh": "不用顾着我，\n得尽情\n乐一乐啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "768/TALK",
            "narrator": "みやび",
            "text": "じゃ、\n買ってくるちや。",
            "zh": "那就，\n我去买咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "773/TALK",
            "narrator": "つばめ",
            "text": "…胸の大きい人って、\n大変なんですね。",
            "zh": "……胸大的人，\n还挺辛苦的呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "775/TALK",
            "narrator": "神楽",
            "text": "デザインを選べない\nなんて…そんなこと\nあるんですね…。",
            "zh": "没法挑设计\n什么的……还有\n这种事呀……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "777/TALK",
            "narrator": "ガブリエラ",
            "text": "…あたし、やっぱり\nこの下着やめるわ。",
            "zh": "……我还是\n不买这件内衣了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "779/TALK",
            "narrator": "アーヤ",
            "text": "え、いいの？\nあんなに黒がいいって\n言ってたのに。",
            "zh": "诶，可以吗？\n你刚才还一直说\n想要黑色。",
            "narrator_zh": "绫水"
        },
        {
            "location": "780/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしはみやびと\n違っていつでも\n付けられるし――",
            "zh": "我和雅不一样，\n什么时候\n都能穿——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "782/TALK",
            "narrator": "ガブリエラ",
            "text": "別に、今急いで付ける\n必要ないもの…。",
            "zh": "也不是现在\n非得马上穿……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "783/TALK",
            "narrator": "アーヤ",
            "text": "私が何言っても\n聞かなかったのに…。",
            "zh": "我说什么\n你都不听的……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "785/TALK",
            "narrator": "神楽",
            "text": "みやびさんの話は、\nそれだけ威力があった\nってことですね…。",
            "zh": "雅的话，\n就是有这么大的\n威力呀……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "786/ACT",
            "narrator": "",
            "text": "$me$が見てるよ",
            "zh": "$me$在看哦",
            "narrator_zh": ""
        },
        {
            "location": "803/TALK",
            "narrator": "つばめ",
            "text": "$handle$さん",
            "zh": "$handle$",
            "narrator_zh": "燕"
        },
        {
            "location": "805/TALK",
            "narrator": "つばめ",
            "text": "さっきから",
            "zh": "从刚才起",
            "narrator_zh": "燕"
        },
        {
            "location": "806/TALK",
            "narrator": "つばめ",
            "text": "えっちなこと言い過ぎ！ヾ(｡>﹏<｡)ﾉﾞ",
            "zh": "色色的话太多了！ヾ(｡>﹏<｡)ﾉﾞ",
            "narrator_zh": "燕"
        },
        {
            "location": "807/TALK",
            "narrator": "つばめ",
            "text": "あんまり",
            "zh": "太",
            "narrator_zh": "燕"
        },
        {
            "location": "808/TALK",
            "narrator": "つばめ",
            "text": "そういうこと言われると",
            "zh": "被这么说的话",
            "narrator_zh": "燕"
        },
        {
            "location": "809/TALK",
            "narrator": "つばめ",
            "text": "困っちゃうよ(´つω・｀)ｼｭﾝ",
            "zh": "会为难的呀(´つω・｀)ｼｭﾝ",
            "narrator_zh": "燕"
        },
        {
            "location": "813/TALK",
            "narrator": "システム",
            "text": "『アーヤさんが入室しました』",
            "zh": "『绫水进入房间了』",
            "narrator_zh": "系统"
        },
        {
            "location": "814/TALK",
            "narrator": "システム",
            "text": "『ガブリエラさんが入室しました』",
            "zh": "『加布里埃拉进入房间了』",
            "narrator_zh": "系统"
        },
        {
            "location": "815/TALK",
            "narrator": "アーヤ",
            "text": "つばめから聞いた",
            "zh": "听燕说了",
            "narrator_zh": "绫水"
        },
        {
            "location": "816/TALK",
            "narrator": "アーヤ",
            "text": "セクハラしてるの？(｀ヘ´)",
            "zh": "你在性骚扰吗？(｀ヘ´)",
            "narrator_zh": "绫水"
        },
        {
            "location": "817/TALK",
            "narrator": "ガブリエラ",
            "text": "何をやってるのよ！",
            "zh": "你在干什么！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "818/TALK",
            "narrator": "アーヤ",
            "text": "女の子に下着姿を見せろとか",
            "zh": "让女孩子给你看内衣什么的",
            "narrator_zh": "绫水"
        },
        {
            "location": "819/TALK",
            "narrator": "アーヤ",
            "text": "言っちゃダメでしょ（｀皿´ )",
            "zh": "不能说的吧（｀皿´ )",
            "narrator_zh": "绫水"
        },
        {
            "location": "820/TALK",
            "narrator": "ガブリエラ",
            "text": "見損なったわ！",
            "zh": "我看错你了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "822/TALK",
            "narrator": "ガブリエラ",
            "text": "そんなこと言うなんて",
            "zh": "居然说这种话",
            "narrator_zh": "加布里埃拉"
        },
