    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "TRUEにしてFALSEは成立するや否や？",
            "zh": "TRUE和FALSE能同时成立吗？",
            "narrator_zh": ""
        },
        {
            "location": "16/TALK",
            "narrator": "みやび",
            "text": "…よし！",
            "zh": "……好嘞！",
            "narrator_zh": "雅"
        },
        {
            "location": "28/TALK",
            "narrator": "みやび",
            "text": "相棒",
            "zh": "搭档",
            "narrator_zh": "雅"
        },
        {
            "location": "29/TALK",
            "narrator": "みやび",
            "text": "今少し",
            "zh": "现在，稍微……",
            "narrator_zh": "雅"
        },
        {
            "location": "41/TALK",
            "narrator": "みやび",
            "text": "いや、ここはダメや。",
            "zh": "不行，这里不行。",
            "narrator_zh": "雅"
        },
        {
            "location": "42/TALK",
            "narrator": "みやび",
            "text": "もっと、人目の少ない\nところに…。",
            "zh": "去个更不显眼的\n地方……",
            "narrator_zh": "雅"
        },
        {
            "location": "56/TALK",
            "narrator": "みやび",
            "text": "よし、ここなら…。",
            "zh": "好，这里的话……",
            "narrator_zh": "雅"
        },
        {
            "location": "68/TALK",
            "narrator": "みやび",
            "text": "すまんな",
            "zh": "没好意思",
            "narrator_zh": "雅"
        },
        {
            "location": "69/TALK",
            "narrator": "みやび",
            "text": "頼みがあるちや",
            "zh": "有件事想拜托你滴",
            "narrator_zh": "雅"
        },
        {
            "location": "71/SEL",
            "narrator": "",
            "text": "頼み？",
            "zh": "有件事求你？",
            "narrator_zh": ""
        },
        {
            "location": "72/ACT",
            "narrator": "",
            "text": "頼み？",
            "zh": "有件事求你？",
            "narrator_zh": ""
        },
        {
            "location": "74/TALK",
            "narrator": "みやび",
            "text": "そうや",
            "zh": "是啊",
            "narrator_zh": "雅"
        },
        {
            "location": "75/TALK",
            "narrator": "みやび",
            "text": "実は",
            "zh": "其实啊",
            "narrator_zh": "雅"
        },
        {
            "location": "91/TALK",
            "narrator": "みやび",
            "text": "マズい！",
            "zh": "糟了！",
            "narrator_zh": "雅"
        },
        {
            "location": "94/TALK",
            "narrator": "女子高校生Ａ",
            "text": "昨日のテレビ見た？\nカッちんの出てるドラマ。",
            "zh": "昨天看电视了吗？\n卡亲演的那部剧。",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "96/TALK",
            "narrator": "女子高校生Ｂ",
            "text": "ああ、見た見たー。\n面白かったよねー。",
            "zh": "啊，看了看了——\n很有意思呢——",
            "narrator_zh": "女高中生B"
        },
        {
            "location": "99/TALK",
            "narrator": "みやび",
            "text": "くっ、誰もいない場所は\nないのか…？",
            "zh": "唔，就没有\n没人的地方吗……？",
            "narrator_zh": "雅"
        },
        {
            "location": "114/TALK",
            "narrator": "みやび",
            "text": "…よし、ここなら\nえいやろ。",
            "zh": "……好，这里的话\n应该行得通咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "126/TALK",
            "narrator": "みやび",
            "text": "何度もすまんな",
            "zh": "没好意思，都好几次了",
            "narrator_zh": "雅"
        },
        {
            "location": "127/TALK",
            "narrator": "みやび",
            "text": "どこに目があるかわからんき",
            "zh": "不知道眼睛长在哪里，所以",
            "narrator_zh": "雅"
        },
        {
            "location": "129/SEL",
            "narrator": "",
            "text": "どういうこと？",
            "zh": "怎么回事？",
            "narrator_zh": ""
        },
        {
            "location": "130/ACT",
            "narrator": "",
            "text": "どういうこと？",
            "zh": "怎么回事？",
            "narrator_zh": ""
        },
        {
            "location": "132/TALK",
            "narrator": "みやび",
            "text": "噂を聞いた",
            "zh": "听到了一个传言",
            "narrator_zh": "雅"
        },
        {
            "location": "133/TALK",
            "narrator": "みやび",
            "text": "この学校を裏で操っちょるんは",
            "zh": "在背后操纵这所学校的是",
            "narrator_zh": "雅"
        },
        {
            "location": "134/TALK",
            "narrator": "みやび",
            "text": "実はまほさんらしい",
            "zh": "据说好像是真幌",
            "narrator_zh": "雅"
        },
        {
            "location": "136/SEL",
            "narrator": "",
            "text": "マジで！？",
            "zh": "真的假的！？",
            "narrator_zh": ""
        },
        {
            "location": "137/ACT",
            "narrator": "",
            "text": "マジで！？",
            "zh": "真的假的！？",
            "narrator_zh": ""
        },
        {
            "location": "139/TALK",
            "narrator": "みやび",
            "text": "わからんき",
            "zh": "还不清楚啵",
            "narrator_zh": "雅"
        },
        {
            "location": "140/TALK",
            "narrator": "みやび",
            "text": "相棒に調べてもらおう思うてる",
            "zh": "正打算请你查一查",
            "narrator_zh": "雅"
        },
        {
            "location": "141/TALK",
            "narrator": "みやび",
            "text": "そういうことやき",
            "zh": "就是这么回事啵",
            "narrator_zh": "雅"
        },
        {
            "location": "142/TALK",
            "narrator": "みやび",
            "text": "頼んだ",
            "zh": "拜托你了",
            "narrator_zh": "雅"
        },
        {
            "location": "145/SEL",
            "narrator": "",
            "text": "無理",
            "zh": "不行",
            "narrator_zh": ""
        },
        {
            "location": "146/SEL",
            "narrator": "",
            "text": "知ってた",
            "zh": "早就知道了",
            "narrator_zh": ""
        },
        {
            "location": "147/SEL",
            "narrator": "",
            "text": "やってみるけど",
            "zh": "我试试吧",
            "narrator_zh": ""
        },
        {
            "location": "148/ACT",
            "narrator": "",
            "text": "無理",
            "zh": "不行",
            "narrator_zh": ""
        },
        {
            "location": "149/TALK",
            "narrator": "みやび",
            "text": "無理？",
            "zh": "不行？",
            "narrator_zh": "雅"
        },
        {
            "location": "150/TALK",
            "narrator": "みやび",
            "text": "何故や？",
