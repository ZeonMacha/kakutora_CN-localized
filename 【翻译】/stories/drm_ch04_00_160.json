            "narrator_zh": "雅"
        },
        {
            "location": "152/TALK",
            "narrator": "みやび",
            "text": "本気になれ",
            "zh": "认真点啊",
            "narrator_zh": "雅"
        },
        {
            "location": "153/TALK",
            "narrator": "みやび",
            "text": "出来るんやろ？",
            "zh": "你做得到的，是没是？",
            "narrator_zh": "雅"
        },
        {
            "location": "155/SEL",
            "narrator": "",
            "text": "知らないから無理",
            "zh": "因为不知道，所以不行",
            "narrator_zh": ""
        },
        {
            "location": "156/ACT",
            "narrator": "",
            "text": "知らないから無理",
            "zh": "因为不知道，所以不行",
            "narrator_zh": ""
        },
        {
            "location": "158/TALK",
            "narrator": "みやび",
            "text": "何やそれ？",
            "zh": "那算什么啊？",
            "narrator_zh": "雅"
        },
        {
            "location": "159/TALK",
            "narrator": "みやび",
            "text": "調べる気ゼロ？",
            "zh": "你压根不想查？",
            "narrator_zh": "雅"
        },
        {
            "location": "160/TALK",
            "narrator": "みやび",
            "text": "ガッカリや",
            "zh": "太让人失望了",
            "narrator_zh": "雅"
        },
        {
            "location": "173/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "174/TALK",
            "narrator": "みやび",
            "text": "上手くかわされたか？\nそれとも本気か…。",
            "zh": "是被巧妙地搪塞了？\n还是说他是认真的……",
            "narrator_zh": "雅"
        },
        {
            "location": "175/TALK",
            "narrator": "みやび",
            "text": "もうちっくと調べる\n必要がありそうやね…。",
