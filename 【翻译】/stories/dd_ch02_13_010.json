{
    "dir": "chap13/daydra/dd_ch02_13_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "13252",
        "cid": "ayami",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "子供と遭遇",
        "title_zh": "Extra002 额外剧情",
        "sub_title_zh": "偶遇小孩"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "子供と遭遇",
            "zh": "偶遇小孩",
            "narrator_zh": ""
        },
        {
            "location": "21/TALK",
            "narrator": "雛",
            "text": "綾水様、\n今朝は素敵でした！",
            "zh": "绫水大人，\n今天早上好帅气！",
            "narrator_zh": "雏"
        },
        {
            "location": "24/TALK",
            "narrator": "アーヤ",
            "text": "？　何が？",
            "zh": "？　什么事？",
            "narrator_zh": "绫水"
        },
        {
            "location": "25/TALK",
            "narrator": "雛",
            "text": "転んで泣いてた\n男の子を、助けてたじゃ\nないですかー。",
            "zh": "您不是帮了那个\n摔倒哭鼻子的小男孩\n嘛——。",
            "narrator_zh": "雏"
        },
        {
            "location": "27/TALK",
            "narrator": "アーヤ",
            "text": "ああ、あのことね。",
            "zh": "啊，那件事啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "29/TALK",
            "narrator": "雛",
            "text": "ビックリしました。\n綾水様って、子供の相手が\n凄くお上手なんですね。",
            "zh": "吓了一跳。\n绫水大人哄起孩子来，\n原来这么厉害呀。",
            "narrator_zh": "雏"
        },
        {
            "location": "30/TALK",
            "narrator": "つばめ",
            "text": "上手って、どういうこと？",
            "zh": "厉害是指，怎么回事？",
            "narrator_zh": "燕"
        },
        {
            "location": "32/TALK",
            "narrator": "雛",
            "text": "泣いてた男の子がね、\n綾水様に何か言われた\n瞬間――",
            "zh": "那个哭着的小男孩呀，\n在绫水大人对他说了些什么\n的瞬间——",
            "narrator_zh": "雏"
        },
        {
            "location": "33/TALK",
            "narrator": "雛",
            "text": "ピタッと泣き止んで、\n自分で立ち上がったの。",
            "zh": "一下子就不哭了，\n自己站了起来。",
            "narrator_zh": "雏"
        },
        {
            "location": "34/TALK",
            "narrator": "つばめ",
            "text": "す、凄いよそれ。\nアーヤさん、どんな魔法を\n使ったんですか？",
            "zh": "好、好厉害呀。\n绫水，你到底用了什么\n魔法呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "36/TALK",
            "narrator": "アーヤ",
            "text": "大げさね。\n普通に声を掛けただけよ。",
            "zh": "太夸张了。\n我只是正常搭了句话而已。",
            "narrator_zh": "绫水"
        },
        {
            "location": "38/TALK",
            "narrator": "アーヤ",
            "text": "ああいう時って驚いて\n泣いてるだけだから、\n意外とすぐ泣き止むのよ。",
            "zh": "那种时候小孩子只是\n吓到才哭的，\n意外地很快就会停下来哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "39/TALK",
            "narrator": "つばめ",
            "text": "…アーヤさん、\n詳しいんですね。",
            "zh": "……绫水，\n你很懂呢。",
            "narrator_zh": "燕"
        },
        {
            "location": "42/TALK",
            "narrator": "アーヤ",
            "text": "そ、そうかしら？",
            "zh": "是、是吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "43/SEL",
            "narrator": "",
            "text": "本で学んだとか？",
            "zh": "从书上学来的？",
            "narrator_zh": ""
        },
        {
            "location": "44/SEL",
            "narrator": "",
            "text": "もしかして、経験談？",
            "zh": "难道说，是经验之谈？",
            "narrator_zh": ""
        },
        {
            "location": "45/SEL",
            "narrator": "",
            "text": "子供好きだからね",
            "zh": "因为喜欢小孩嘛",
            "narrator_zh": ""
        },
        {
            "location": "49/TALK",
            "narrator": "雛",
            "text": "それはやっぱり、\n綾水様が大人だから\nじゃないかなー？",
            "zh": "那果然还是因为，\n绫水大人\n比较成熟吧——？",
            "narrator_zh": "雏"
        },
        {
            "location": "51/TALK",
            "narrator": "つばめ",
            "text": "大人だから？",
            "zh": "因为成熟？",
            "narrator_zh": "燕"
        },
        {
            "location": "53/TALK",
            "narrator": "雛",
            "text": "うん、なんて言うのかな？",
            "zh": "嗯，该怎么说好呢？",
            "narrator_zh": "雏"
        },
        {
            "location": "54/TALK",
            "narrator": "雛",
            "text": "ほら、なんか自然と\nそういうことわかっちゃい\nそうな感じしない？",
            "zh": "你看，总觉得她好像\n自然而然就能明白这些事，\n不觉得吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "55/TALK",
            "narrator": "つばめ",
            "text": "あはは、言われてみると\n確かにそうかも。",
            "zh": "啊哈哈，听你这么一说\n确实有点像呢。",
            "narrator_zh": "燕"
        },
        {
            "location": "60/TALK",
            "narrator": "アーヤ",
            "text": "…私が何も言わない間に、\n結論が出ちゃったみたい。",
            "zh": "……我还没来得及说什么，\n结论好像就已经出来了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "61/TALK",
            "narrator": "アーヤ",
            "text": "まあ、二人が言うほど\nわかってるつもりは\nないんだけど――",
            "zh": "嘛，虽然我自己\n并不觉得有你们俩\n说的那么懂——",
            "narrator_zh": "绫水"
        },
        {
            "location": "62/TALK",
            "narrator": "アーヤ",
            "text": "そういう風に見えてる\nなら、ちょっと嬉しいな。",
            "zh": "不过在你们眼里是这样的话，\n倒还有点开心呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "64/ACT",
            "narrator": "",
            "text": "本で学んだとか？",
            "zh": "从书上学来的？",
            "narrator_zh": ""
        },
        {
            "location": "84/TALK",
            "narrator": "アーヤ",
            "text": "ナイスアドバイス！",
            "zh": "好建议！",
            "narrator_zh": "绫水"
        },
        {
            "location": "85/TALK",
            "narrator": "アーヤ",
            "text": "どう答えようか迷ってたところだったの",
            "zh": "我正犹豫该怎么回答呢",
            "narrator_zh": "绫水"
        },
        {
            "location": "86/TALK",
            "narrator": "アーヤ",
            "text": "本で知った、って答え方",
            "zh": "说是从书上看到的，这种答法",
            "narrator_zh": "绫水"
        },
        {
            "location": "87/TALK",
            "narrator": "アーヤ",
            "text": "凄く便利よね",
            "zh": "真好用呢",
            "narrator_zh": "绫水"
        },
        {
            "location": "88/TALK",
            "narrator": "アーヤ",
            "text": "それで行くわ(^^)",
            "zh": "就这么说啦(^^)",
            "narrator_zh": "绫水"
        },
        {
            "location": "101/TALK",
            "narrator": "アーヤ",
            "text": "本で読んだことが\nあるのよ。",
            "zh": "我在书上读到过\n哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "102/TALK",
            "narrator": "アーヤ",
            "text": "子供はビックリすると、\nそれが理由で泣きだす\nことがよくある、ってね。",
            "zh": "书上说小孩子一受惊，\n往往就会因为这个\n哭起来。",
            "narrator_zh": "绫水"
        },
        {
            "location": "104/TALK",
            "narrator": "つばめ",
            "text": "そうなんですかぁ。\n勉強になります。",
            "zh": "这样呀。\n长见识了。",
            "narrator_zh": "燕"
        },
        {
            "location": "105/TALK",
            "narrator": "雛",
            "text": "…っていうか――",
            "zh": "……话说回来——",
            "narrator_zh": "雏"
        },
        {
            "location": "106/TALK",
            "narrator": "雛",
            "text": "子供に関する本を読んだ\nことがある、っていうのが\n驚きです。",
            "zh": "您竟然读过关于\n小孩的书，这才让我\n吃惊呢。",
            "narrator_zh": "雏"
        },
        {
            "location": "109/TALK",
            "narrator": "アーヤ",
            "text": "ま、まあほら、あれよ。\n誰でもいずれは必要に\nなる知識だし…。",
            "zh": "这、这个嘛，你看。\n反正谁将来早晚都用得上\n这种知识嘛……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "110/TALK",
            "narrator": "アーヤ",
            "text": "もちろん、今はそんな\n予定はないけど――",
            "zh": "当然，现在还没那种\n打算就是了——",
            "narrator_zh": "绫水"
        },
        {
            "location": "114/TALK",
            "narrator": "アーヤ",
            "text": "早いうちに読んでおいても\n損はないかな、って\n思ったのよ。",
            "zh": "我只是觉得早点读一读\n也没什么坏处，\n才去看的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "115/TALK",
            "narrator": "雛",
            "text": "そうだったんですか…。",
            "zh": "原来是这样呀……。",
            "narrator_zh": "雏"
        },
        {
            "location": "116/TALK",
            "narrator": "雛",
            "text": "あたしも、今度読んで\nみようかなぁ？",
            "zh": "那我下次也找来\n读读看好了？",
            "narrator_zh": "雏"
        },
        {
            "location": "120/TALK",
            "narrator": "アーヤ",
            "text": "…自分で言ったことでは\nあるけど、将来的に絶対\n必要になるんだし――",
            "zh": "……虽然是我自己随口说的，\n但将来确实绝对\n用得上——",
            "narrator_zh": "绫水"
        },
        {
            "location": "121/TALK",
            "narrator": "アーヤ",
            "text": "私も読んでおいた方が\nよさそうね。",
            "zh": "看来我也还是读一读\n比较好吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "122/ACT",
            "narrator": "",
            "text": "もしかして、経験談？",
            "zh": "难道说，是经验之谈？",
            "narrator_zh": ""
        },
        {
            "location": "143/TALK",
            "narrator": "アーヤ",
            "text": "そういうわけじゃないけど",
            "zh": "倒也不是那样",
            "narrator_zh": "绫水"
        },
        {
            "location": "144/TALK",
            "narrator": "アーヤ",
            "text": "経験談なら、いいのがあるわ",
            "zh": "不过要是经验之谈，倒有个不错的",
            "narrator_zh": "绫水"
        },
        {
            "location": "156/TALK",
            "narrator": "アーヤ",
            "text": "まあ、自分が子供の時の\nことを思い出せば――",
            "zh": "嘛，只要回想一下\n自己小时候的事——",
            "narrator_zh": "绫水"
        },
        {
            "location": "157/TALK",
            "narrator": "アーヤ",
            "text": "なんとなくだけど\nどうすればいいか\nわかると思うわ。",
            "zh": "大概就能\n明白该怎么做了\n吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "158/TALK",
            "narrator": "雛",
            "text": "自分の子供時代…\nあ～、そういえば――",
            "zh": "自己的童年时代……\n啊～说起来——",
            "narrator_zh": "雏"
        },
        {
            "location": "159/TALK",
            "narrator": "雛",
            "text": "私も転んだりした時は、\n痛みじゃなくてビックリ\nして泣いてました。",
            "zh": "我以前摔倒的时候，\n也不是因为疼，而是被吓到\n才哭出来的。",
            "narrator_zh": "雏"
        },
        {
            "location": "161/TALK",
            "narrator": "アーヤ",
            "text": "私もよ。\n小さい頃は、転ぶたびに\n泣いてたわ…。",
            "zh": "我也是哦。\n小时候每次一摔倒\n就会哭……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "163/TALK",
            "narrator": "つばめ",
            "text": "そうだったんですか！？",
            "zh": "原来是这样吗！？",
            "narrator_zh": "燕"
        },
        {
            "location": "165/TALK",
            "narrator": "アーヤ",
            "text": "うん。擦りむいたかも、\nって思い込んじゃって、\nいつも泣いてた。",
            "zh": "嗯。总以为自己肯定是\n擦破皮了，\n每次都要哭。",
            "narrator_zh": "绫水"
        },
        {
            "location": "166/TALK",
            "narrator": "雛",
            "text": "何だか、今とは結構\nイメージが違います\nけど――。",
            "zh": "总觉得，和您现在的形象\n反差挺大的\n不过——。",
            "narrator_zh": "雏"
        },
        {
            "location": "167/TALK",
            "narrator": "雛",
            "text": "凄く可愛いと思います！",
            "zh": "我觉得超级可爱！",
            "narrator_zh": "雏"
        },
        {
            "location": "169/TALK",
            "narrator": "アーヤ",
            "text": "ありがと…でも、ちょっと\n恥ずかしいから、この話は\nおしまいね。",
            "zh": "谢谢……不过有点\n不好意思，这个话题\n就到此为止吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "170/ACT",
            "narrator": "",
            "text": "子供好きだからね",
            "zh": "因为喜欢小孩嘛",
            "narrator_zh": ""
        },
        {
            "location": "191/TALK",
            "narrator": "アーヤ",
            "text": "…そうね",
            "zh": "……是啊",
            "narrator_zh": "绫水"
        },
        {
            "location": "192/TALK",
            "narrator": "アーヤ",
            "text": "大切なのはその気持ちよね？",
            "zh": "重要的就是这份心情对吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "203/TALK",
            "narrator": "雛",
            "text": "私も、あんなふうに\n子供の対応が出来る\n大人になりたいなぁ…。",
            "zh": "我也好想成为像那样\n能从容应对小孩子的\n大人呀……。",
            "narrator_zh": "雏"
        },
        {
            "location": "205/TALK",
            "narrator": "アーヤ",
            "text": "子供が好き、って気持ちが\n大切なんじゃない？",
            "zh": "喜欢小孩子的心情，\n才是最重要的吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "206/TALK",
            "narrator": "つばめ",
            "text": "アーヤさんって、\n子供好きなんですか？",
            "zh": "绫水，\n你喜欢小孩子吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "209/TALK",
            "narrator": "アーヤ",
            "text": "あら、知らなかった？\n私は子供のことが\n大好きよ。",
            "zh": "哎呀，你不知道吗？\n我最喜欢\n小孩子了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "210/TALK",
            "narrator": "アーヤ",
            "text": "だから、泣いてる姿を\n見たら心配になっちゃ\nうのかもしれないわ。",
            "zh": "所以，看到孩子在哭\n才会忍不住担心\n起来吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "213/TALK",
            "narrator": "つばめ",
            "text": "そっか…子供嫌い\nだったらそんな気持ちには\nなりませんよね。",
            "zh": "这样呀……要是讨厌小孩的话\n就不会有这种心情了\n呢。",
            "narrator_zh": "燕"
        },
        {
            "location": "214/TALK",
            "narrator": "雛",
            "text": "そうだね。\nなんか、納得しました。",
            "zh": "是啊。\n总觉得，很有道理。",
            "narrator_zh": "雏"
        },
        {
            "location": "216/TALK",
            "narrator": "アーヤ",
            "text": "それなら良かったわ。",
            "zh": "那就好。",
            "narrator_zh": "绫水"
        },
        {
            "location": "19/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>7月8日　12:45 PM</color>\nとある平日の昼休み、学園前庭にて。",
            "zh": "<color=green>7月8日　12:45 PM</color>\n某个平日的午休，学园前庭。",
            "narrator_zh": "Dialog_EventData"
        }
    ]
}
