{
    "dir": "chap23/daydra/dd_ch01_23_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "23156",
        "cid": "tsubame",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "夏休みの宿題",
        "title_zh": "Extra006 额外剧情",
        "sub_title_zh": "暑假作业"
    },
    "entry": [
        {
            "location": "346/SCENARIO",
            "narrator": "",
            "text": "夏休みの宿題",
            "zh": "暑假作业",
            "narrator_zh": ""
        },
        {
            "location": "359/TALK",
            "narrator": "つばめ",
            "text": "はぁ…やってもやっても\n全然終わらないよぉ…。",
            "zh": "哈啊……做了又做\n完全做不完呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "360/TALK",
            "narrator": "ガブリエラ",
            "text": "合宿の間、夏休みの宿題を\n全然やらなかったのは\nつばめでしょ？",
            "zh": "合宿期间，一点都没做\n暑假作业的人\n不就是燕吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "361/TALK",
            "narrator": "ガブリエラ",
            "text": "自業自得よ。",
            "zh": "自作自受。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "362/TALK",
            "narrator": "つばめ",
            "text": "ううう、っていうか、\nガブちゃんは\nいつやってたの？",
            "zh": "呜呜呜，话说回来，\n加布你是\n什么时候做的？",
            "narrator_zh": "燕"
        },
        {
            "location": "363/TALK",
            "narrator": "ガブリエラ",
            "text": "初日に終わらせたわ。\n残しといても面倒だし。",
            "zh": "第一天就做完了。\n留着也麻烦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "364/TALK",
            "narrator": "つばめ",
            "text": "…ガブちゃんって、\n本当凄いよね…。",
            "zh": "……加布你呀，\n真的好厉害呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "366/TALK",
            "narrator": "ガブリエラ",
            "text": "当然のこと言ってないで、\n手と頭を動かしなさい。",
            "zh": "别说这种理所当然的话，\n手和脑子动起来。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "368/TALK",
            "narrator": "つばめ",
            "text": "は、はい！\nえっと、次の問題は…。",
            "zh": "是、是！\n那个，下一题是……。",
            "narrator_zh": "燕"
        },
        {
            "location": "370/TALK",
            "narrator": "ガブリエラ",
            "text": "あ、その前にこことここ、\n間違ってるから直して。",
            "zh": "啊，在这之前这里和这里，\n做错了，改掉。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "373/TALK",
            "narrator": "つばめ",
            "text": "うわーん！\n全然進まないよぉー！",
            "zh": "呜哇——！\n完全没有进展呀——！",
            "narrator_zh": "燕"
        },
        {
            "location": "380/TALK",
            "narrator": "つばめ",
            "text": "お、終わったぁ…。",
            "zh": "做、做完了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "381/TALK",
            "narrator": "ガブリエラ",
            "text": "はい、お疲れ。\nやればできるじゃない。",
            "zh": "好，辛苦了。\n做起来不也挺能干嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "382/TALK",
            "narrator": "つばめ",
            "text": "え、えへへ…、\nガブちゃんのスパルタ\n指導のおかげだよ…。",
            "zh": "诶、诶嘿嘿……，\n这都多亏了加布的\n斯巴达指导呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "383/TALK",
            "narrator": "つばめ",
            "text": "夕方になっちゃった…。\nごめんね、長い時間\n手伝ってもらって…。",
            "zh": "都到傍晚了……。\n对不起呀，让你\n帮了这么长时间……。",
            "narrator_zh": "燕"
        },
        {
            "location": "384/TALK",
            "narrator": "ガブリエラ",
            "text": "べ、別にいいわよ。\nやることなかったんだし、\nただの暇つぶしよ。",
            "zh": "没、没什么啦。\n反正也没别的事做，\n只是打发时间。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "385/TALK",
            "narrator": "つばめ",
            "text": "それでも、ありがと。\nやっぱりガブちゃんは\n頼りになるなぁ。",
            "zh": "即便如此也谢谢你。\n果然加布\n最可靠了呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "386/TALK",
            "narrator": "ガブリエラ",
            "text": "だから、別にいいって…。",
            "zh": "都说了，没什么……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "387/TALK",
            "narrator": "つばめ",
            "text": "あ、そうだ！\nガブちゃん、もう少しだけ\n付き合ってもらえる？",
            "zh": "啊，对了！\n加布，能再陪我\n待一会儿吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "388/TALK",
            "narrator": "つばめ",
            "text": "宿題手伝ってもらった\nお礼に、アイス奢るよ。",
            "zh": "作为帮我写作业的\n谢礼，我请你吃冰淇淋哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "389/TALK",
            "narrator": "ガブリエラ",
            "text": "やった！\nそういうことなら\n喜んで付き合うわ。",
            "zh": "太好了！\n如果是这事的话，\n那我就乐意奉陪了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "391/TALK",
            "narrator": "つばめ",
            "text": "ふふっ、それじゃあ、\n買いに行こっか。",
            "zh": "呵呵，那，\n我们去买吧。",
            "narrator_zh": "燕"
        },
        {
            "location": "405/TALK",
            "narrator": "ガブリエラ",
            "text": "…合宿も、\nもうすぐ終わりね。",
            "zh": "……合宿，\n也很快要结束了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "407/TALK",
            "narrator": "つばめ",
            "text": "そうだね…。\n何か、帰りたくないな…。",
            "zh": "是呀……。\n总觉得，不太想回去呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "408/TALK",
            "narrator": "ガブリエラ",
            "text": "そうね…。\nみやびの家、\nとっても素敵だし…。",
            "zh": "是啊……。\n雅的家，\n真的很漂亮……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "411/TALK",
            "narrator": "つばめ",
            "text": "ガブちゃん、\n本当にみやびさんの家が\n好きなんだね。",
            "zh": "加布，\n你是真的很喜欢\n雅的家呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "414/TALK",
            "narrator": "ガブリエラ",
            "text": "あんな立派な日本家屋が\n実家だなんて…、\nみやびは幸せ者よ。",
            "zh": "那么气派的日式大宅\n居然是老家……，\n雅真是个幸福的人。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "417/TALK",
            "narrator": "ガブリエラ",
            "text": "…でもまあ、そろそろ\nベッドが恋しくなっても\nいるのよね。",
            "zh": "……不过嘛，现在\n也差不多开始想念\n软床了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "418/TALK",
            "narrator": "つばめ",
            "text": "あはは…やっぱり、\nベッドに慣れてると\n布団は辛いよね…。",
            "zh": "啊哈哈……果然，\n睡惯了床的话，\n被褥会难受呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "419/TALK",
            "narrator": "ガブリエラ",
            "text": "特に訓練でヘトヘトの\n身体にはね。",
            "zh": "尤其是训练到筋疲力尽\n的身体呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "422/TALK",
            "narrator": "つばめ",
            "text": "うん…本当、毎日のように\n訓練だったから、\nビックリしたなぁ…。",
            "zh": "嗯……真的，几乎每天\n都在训练，\n吓了一跳呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "423/TALK",
            "narrator": "ガブリエラ",
            "text": "もっとお出かけしたり、\n遊んだりしたかったわ。",
            "zh": "我还想多出去\n逛逛、多玩一会儿的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "424/TALK",
            "narrator": "つばめ",
            "text": "うん…ふふっ…。",
            "zh": "嗯……呵呵……。",
            "narrator_zh": "燕"
        },
        {
            "location": "428/TALK",
            "narrator": "ガブリエラ",
            "text": "？　何がおかしいのよ？",
            "zh": "？　有什么好笑的？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "431/TALK",
            "narrator": "つばめ",
            "text": "うん…今は当たり前に\nなってるけど、覚えてる？",
            "zh": "嗯……虽然现在已经\n理所当然了，你还记得吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "432/TALK",
            "narrator": "つばめ",
            "text": "少し前まで、ガブちゃんと\nお話ししながら歩くなんて\n考えられなかったから…。",
            "zh": "不久之前，能像这样和加布\n一边聊着天一边散步，\n简直想都不敢想呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "433/TALK",
            "narrator": "ガブリエラ",
            "text": "うっ…。",
            "zh": "唔……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "434/TALK",
            "narrator": "つばめ",
            "text": "あの時のわたしは\n信じられないだろうなぁ。",
            "zh": "那时候的我\n肯定不敢相信吧。",
            "narrator_zh": "燕"
        },
        {
            "location": "435/TALK",
            "narrator": "つばめ",
            "text": "まさか、ガブちゃんと\nこんなに仲良くなって――",
            "zh": "真没想到，能和加布\n变得这么要好——",
            "narrator_zh": "燕"
        },
        {
            "location": "436/TALK",
            "narrator": "ガブリエラ",
            "text": "す、すとーっぷ！\nその頃の話はしなくて\nいいから！",
            "zh": "停、停——！\n那时候的事\n不用提了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "437/TALK",
            "narrator": "つばめ",
            "text": "でも――",
            "zh": "可是——",
            "narrator_zh": "燕"
        },
        {
            "location": "438/TALK",
            "narrator": "ガブリエラ",
            "text": "言うこと聞きなさいよ！",
            "zh": "给我听话！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "439/TALK",
            "narrator": "ガブリエラ",
            "text": "先輩の命令が聞けない\nっていうの？\nバカ新人！",
            "zh": "前辈的命令都敢\n不听了吗？\n笨蛋新人！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "440/TALK",
            "narrator": "つばめ",
            "text": "は、はい！\nごめんなさい、\nガブリエラせんぱい…！",
            "zh": "是、是！\n对不起，\n加布里埃拉前辈……！",
            "narrator_zh": "燕"
        },
        {
            "location": "441/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "442/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "445/TALK",
            "narrator": "ガブリエラ",
            "text": "ぷっ…新人って…。\nなんか、久しぶりに\n言ったわ。",
            "zh": "噗……新人什么的……。\n总觉得，好久\n没这么叫了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "448/TALK",
            "narrator": "つばめ",
            "text": "えへへ…わたしもつい、\nせんぱいって\n言っちゃいました。",
            "zh": "诶嘿嘿……我也不由自主\n叫出前辈\n来了。",
            "narrator_zh": "燕"
        },
        {
            "location": "451/TALK",
            "narrator": "ガブリエラ",
            "text": "せんぱいって呼ぶ方が\nしっくりくるなら、\n戻してもいいけど？",
            "zh": "要是觉得叫前辈\n更顺口的话，\n改回去也行？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "455/TALK",
            "narrator": "つばめ",
            "text": "ううん、ガブちゃんって\n呼ぶ方が好きだから、\nこのままがいいな。",
            "zh": "不用，我更喜欢\n叫你加布，\n就这样就好啦。",
            "narrator_zh": "燕"
        },
        {
            "location": "456/TALK",
            "narrator": "ガブリエラ",
            "text": "ふーん…まあ、つばめが\n好きな方で構わないけど。",
            "zh": "哼——……嘛，燕你\n喜欢怎么叫都无所谓。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "457/SEL",
            "narrator": "",
            "text": "イチャイチャタイム？",
            "zh": "腻歪时间？",
            "narrator_zh": ""
        },
        {
            "location": "460/TALK",
            "narrator": "つばめ",
            "text": "えへへ…ガブちゃん。",
            "zh": "诶嘿嘿……加布。",
            "narrator_zh": "燕"
        },
        {
            "location": "462/TALK",
            "narrator": "ガブリエラ",
            "text": "な、なによ？",
            "zh": "干、干嘛啦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "464/TALK",
            "narrator": "つばめ",
            "text": "ううん、呼んでみただけ。",
            "zh": "没什么，只是叫叫看。",
            "narrator_zh": "燕"
        },
        {
            "location": "465/TALK",
            "narrator": "ガブリエラ",
            "text": "あ、あのね…。",
            "zh": "那、那个……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "469/TALK",
            "narrator": "ガブリエラ",
            "text": "バカなことやってないで、\nさっさとアイス買いに\n行くわよ。",
            "zh": "别干傻事了，\n快点去买\n冰淇淋。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "470/TALK",
            "narrator": "つばめ",
            "text": "うん…行こ、ガブちゃん。",
            "zh": "嗯……走吧，加布。",
            "narrator_zh": "燕"
        },
        {
            "location": "473/ACT",
            "narrator": "",
            "text": "イチャイチャタイム？",
            "zh": "腻歪时间？",
            "narrator_zh": ""
        },
        {
            "location": "487/TALK",
            "narrator": "つばめ",
            "text": "本当？(´,,･ω･,,｀)",
            "zh": "真的吗？(´,,･ω･,,｀)",
            "narrator_zh": "燕"
        },
        {
            "location": "488/TALK",
            "narrator": "つばめ",
            "text": "わたしとガブちゃん",
            "zh": "我和加布",
            "narrator_zh": "燕"
        },
        {
            "location": "489/TALK",
            "narrator": "つばめ",
            "text": "仲良しに見ぇる？o(*･ﾛ･*)o、",
            "zh": "看起来很要好吗？o(*･ﾛ･*)o、",
            "narrator_zh": "燕"
        },
        {
            "location": "491/SEL",
            "narrator": "",
            "text": "ガブリエラに聞いてみよう",
            "zh": "问问加布里埃拉吧",
            "narrator_zh": ""
        },
        {
            "location": "492/ACT",
            "narrator": "",
            "text": "ガブリエラに聞いてみよう",
            "zh": "问问加布里埃拉吧",
            "narrator_zh": ""
        },
        {
            "location": "494/TALK",
            "narrator": "つばめ",
            "text": "そぅだねヽ(*´∀｀*)ﾉ",
            "zh": "是呀ヽ(*´∀｀*)ﾉ",
            "narrator_zh": "燕"
        },
        {
            "location": "495/TALK",
            "narrator": "つばめ",
            "text": "直接ガブちゃんに",
            "zh": "我这就直接去",
            "narrator_zh": "燕"
        },
        {
            "location": "496/TALK",
            "narrator": "つばめ",
            "text": "聞いてみる(*≧∀≦*) ",
            "zh": "问问加布(*≧∀≦*) ",
            "narrator_zh": "燕"
        },
        {
            "location": "504/TALK",
            "narrator": "つばめ",
            "text": "ねえ、ガブちゃん。",
            "zh": "呐，加布。",
            "narrator_zh": "燕"
        },
        {
            "location": "508/TALK",
            "narrator": "ガブリエラ",
            "text": "ん？　どうかした？",
            "zh": "嗯？　怎么了？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "509/TALK",
            "narrator": "つばめ",
            "text": "わたしたち、\n仲良しに見えるかな？",
            "zh": "我们俩，\n看起来很要好吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "512/TALK",
            "narrator": "ガブリエラ",
            "text": "は、はぁ！？\nなによ急に…。",
            "zh": "哈、哈啊！？\n干嘛突然说这个……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "513/TALK",
            "narrator": "つばめ",
            "text": "他の人から見て、\nイチャイチャしてるように\n見えるみたいだから…。",
            "zh": "在别人看来，\n好像在腻歪一样\n……。",
            "narrator_zh": "燕"
        },
        {
            "location": "514/TALK",
            "narrator": "ガブリエラ",
            "text": "イチャイチャ！？",
            "zh": "腻歪！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "515/TALK",
            "narrator": "ガブリエラ",
            "text": "いや、ないない！\n普通に歩いてるだけ\nでしょ！？",
            "zh": "没有，绝对没有！\n只是在正常走路\n而已吧！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "516/TALK",
            "narrator": "つばめ",
            "text": "そうかな？",
            "zh": "是吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "517/TALK",
            "narrator": "ガブリエラ",
            "text": "そうでしょうが！",
            "zh": "当然是啊！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "520/TALK",
            "narrator": "つばめ",
            "text": "そっかぁ…。",
            "zh": "这样呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "521/TALK",
            "narrator": "ガブリエラ",
            "text": "大体、そういうのは\n男の子と一緒にいる\nときに――",
            "zh": "再说，那种词是\n和男孩子在一起的\n时候——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "524/TALK",
            "narrator": "ガブリエラ",
            "text": "…はぁ。\nううん、やっぱいいわ。",
            "zh": "……哈啊。\n算了，还是不说了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "525/TALK",
            "narrator": "つばめ",
            "text": "あ、あれ？\nどうして急にため息？",
            "zh": "哎、哎？\n怎么突然叹气呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "528/TALK",
            "narrator": "ガブリエラ",
            "text": "つばめは天然だから、\n何言っても無駄、って\n思ったのよ。",
            "zh": "我是觉得燕你太天然，\n说什么都是白费\n功夫。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "529/TALK",
            "narrator": "つばめ",
            "text": "て、天然って\n言わないでよぉ…。",
            "zh": "别、别说我\n天然呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "530/SEL",
            "narrator": "",
            "text": "つばめのこと、理解してくれてるね",
            "zh": "她很理解燕呀",
            "narrator_zh": ""
        },
        {
            "location": "533/TALK",
            "narrator": "ガブリエラ",
            "text": "本当のことじゃん。\n入隊したときから\nずーっと治らないし。",
            "zh": "我说的是事实嘛。\n从入队时候起，\n就一直没改过来。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "535/TALK",
            "narrator": "つばめ",
            "text": "っていうか、わたしって\nそんなに天然なのかな？",
            "zh": "话说回来，我真的\n有那么天然吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "536/TALK",
            "narrator": "ガブリエラ",
            "text": "みんなに聞いてみれば？\n口を揃えて天然って\n返されるだろうけど。",
            "zh": "你去问问大家呗？\n不过估计会异口同声地\n回答你是天然就是了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "540/TALK",
            "narrator": "つばめ",
            "text": "うう…治ればいいん\nだけどなぁ…。",
            "zh": "呜呜……要是能改掉\n就好了呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "542/TALK",
            "narrator": "ガブリエラ",
            "text": "あはは、どうかしらね？",
            "zh": "啊哈哈，谁知道呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "543/TALK",
            "narrator": "ガブリエラ",
            "text": "…ま、そのまんまでも\nあたしは嫌いじゃないん\nだけど…。",
            "zh": "……嘛，就算保持现在这样，\n我也并不讨厌就是\n了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "545/ACT",
            "narrator": "",
            "text": "つばめのこと、理解してくれてるね",
            "zh": "她很理解燕呀",
            "narrator_zh": ""
        },
        {
            "location": "559/TALK",
            "narrator": "つばめ",
            "text": "そぅぃぅことなの？(･Д･｀)",
            "zh": "是这么回事吗？(･Д･｀)",
            "narrator_zh": "燕"
        },
        {
            "location": "561/SEL",
            "narrator": "",
            "text": "受け入れてくれた証拠だよ",
            "zh": "这是她接纳你的证据呀",
            "narrator_zh": ""
        },
        {
            "location": "562/ACT",
            "narrator": "",
            "text": "受け入れてくれた証拠だよ",
            "zh": "这是她接纳你的证据呀",
            "narrator_zh": ""
        },
        {
            "location": "565/TALK",
            "narrator": "つばめ",
            "text": "そっか",
            "zh": "这样呀",
            "narrator_zh": "燕"
        },
        {
            "location": "566/TALK",
            "narrator": "つばめ",
            "text": "そぅだよね(≧ω≦)",
            "zh": "就是呀(≧ω≦)",
            "narrator_zh": "燕"
        },
        {
            "location": "567/TALK",
            "narrator": "つばめ",
            "text": "ぁりがとぅ、$handle$さん",
            "zh": "谢谢你，$handle$",
            "narrator_zh": "燕"
        },
        {
            "location": "574/TALK",
            "narrator": "つばめ",
            "text": "えへへ…。",
            "zh": "诶嘿嘿……。",
            "narrator_zh": "燕"
        },
        {
            "location": "579/TALK",
            "narrator": "ガブリエラ",
            "text": "…こ、今度はなによ？",
            "zh": "……这、这次又怎么了？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "580/TALK",
            "narrator": "つばめ",
            "text": "ガブちゃんに受け入れて\nもらえて、嬉しいなぁ、\nって…。",
            "zh": "觉得能被加布\n接纳，真的好开心\n呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "581/TALK",
            "narrator": "ガブリエラ",
            "text": "はい！？",
            "zh": "啥！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "584/TALK",
            "narrator": "つばめ",
            "text": "前は怒ってたけど、\n今は天然なの理解して、\n怒らないでくれたでしょ？",
            "zh": "以前还会生气，\n现在理解了我的天然，\n就不生气了嘛？",
            "narrator_zh": "燕"
        },
        {
            "location": "585/TALK",
            "narrator": "つばめ",
            "text": "それって、わたしのこと\n理解して、受け入れて\nくれた、ってことだよね。",
            "zh": "这不就说明，你已经\n理解我、接纳我了\n对吧。",
            "narrator_zh": "燕"
        },
        {
            "location": "587/TALK",
            "narrator": "ガブリエラ",
            "text": "ち、違うから！",
            "zh": "才、才不是！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "589/TALK",
            "narrator": "ガブリエラ",
            "text": "そりゃ、確かに前より\nつばめのことは理解しては\nいるけど…。",
            "zh": "虽说，确实比以前\n更了解燕了\n……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "592/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、受け入れたとか、\nそういうのないから！",
            "zh": "但是，接纳什么的，\n绝对没有这回事！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "593/TALK",
            "narrator": "つばめ",
            "text": "そ、そうなの？",
            "zh": "是、是这样吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "596/TALK",
            "narrator": "ガブリエラ",
            "text": "っていうか、言い方！\nもうちょっとこう、\n普通の言い方ないわけ？",
            "zh": "话说你的说法！\n就不能稍微用点\n普通的说法吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "597/TALK",
            "narrator": "つばめ",
            "text": "普通…普通…。",
            "zh": "普通……普通……。",
            "narrator_zh": "燕"
        },
        {
            "location": "598/TALK",
            "narrator": "つばめ",
            "text": "あっ、好きになって\nもらえた、とか？",
            "zh": "啊，比方说\n变得喜欢我了，之类的？",
            "narrator_zh": "燕"
        },
        {
            "location": "599/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "600/TALK",
            "narrator": "つばめ",
            "text": "あ、あれ？",
            "zh": "哎、哎？",
            "narrator_zh": "燕"
        },
        {
            "location": "601/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…そういうセリフを\n平然と言えるとこも、\n天然だからこそよね…。",
            "zh": "哈啊……这种台词也能\n面不改色地说出来，\n也正是因为天然吧……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "602/TALK",
            "narrator": "つばめ",
            "text": "ま、また天然って\n言ったぁ…。",
            "zh": "又、又说我\n天然了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "603/TALK",
            "narrator": "ガブリエラ",
            "text": "ヘコむんじゃないの。\n悪口で言ってるわけじゃ\nないんだし…。",
            "zh": "别垂头丧气的。\n又不是在骂你\n……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "604/TALK",
            "narrator": "ガブリエラ",
            "text": "…恥ずかしがって言えない\nあたしには、ちょっとだけ\n羨ましいわ。",
            "zh": "……对害羞到说不出口的\n我来说，其实倒是有那么\n一点羡慕。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "357/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>8月27日　 0:56 PM</color>\n合宿中、みやびの実家でのこと",
            "zh": "<color=green>8月27日　 0:56 PM</color>\n合宿期间，在雅的老家",
            "narrator_zh": "Dialog_EventData"
        }
    ]
}
