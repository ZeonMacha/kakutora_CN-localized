{
    "dir": "chap12/daydra/dd_ch03_12_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "12302",
        "cid": "gabriella",
        "title": "002 メインストーリー",
        "sub_title": "口添えを頼まれて＜前編＞",
        "title_zh": "002 主线剧情",
        "sub_title_zh": "被拜托美言几句＜前篇＞"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "口添えを頼まれて",
            "zh": "被拜托美言几句",
            "narrator_zh": ""
        },
        {
            "location": "26/TALK",
            "narrator": "ガブリエラ",
            "text": "…いや、頼まれても\n無理だから。",
            "zh": "……那个，就算你们来求我\n也是不行的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "27/TALK",
            "narrator": "キリト",
            "text": "はぁ…やっぱりな。\nひなこ、これで\n諦めついたろ？",
            "zh": "哈啊……果然啊。\n雏，这下你该\n死心了吧？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "29/TALK",
            "narrator": "雛",
            "text": "つかないよ！",
            "zh": "才不死心呢！",
            "narrator_zh": "雏"
        },
        {
            "location": "31/TALK",
            "narrator": "ガブリエラ",
            "text": "あのね…。\n劇場でバイトしたい\nっていうけど――",
            "zh": "我说啊……。\n你们说想去剧场\n打工——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "32/TALK",
            "narrator": "ガブリエラ",
            "text": "あそこがただの\n劇場じゃないことは\n知ってるでしょ？",
            "zh": "但你们也知道那里\n不是普通的\n剧场吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "34/TALK",
            "narrator": "雛",
            "text": "だから、東雲教官に\n口添えしてもらおうと\n思って――",
            "zh": "所以，我们才想请\n东云教官帮忙通融\n一下——",
            "narrator_zh": "雏"
        },
        {
            "location": "35/TALK",
            "narrator": "雛",
            "text": "ガブリエラちゃんに\nお願いしてるんだよ。",
            "zh": "这才来拜托\n加布里埃拉的呀。",
            "narrator_zh": "雏"
        },
        {
            "location": "37/TALK",
            "narrator": "ガブリエラ",
            "text": "口添えなら\nあたしじゃなくて――",
            "zh": "要说情的话，\n别找我——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "38/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤとかつばめに\n頼めばいいじゃない。",
            "zh": "去找绫水或者燕\n帮忙不就好了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "41/TALK",
            "narrator": "雛",
            "text": "え、えーっと、\nそれは、そのー…。",
            "zh": "呃、呃——，\n那个、就是——……。",
            "narrator_zh": "雏"
        },
        {
            "location": "42/TALK",
            "narrator": "キリト",
            "text": "…アーヤ先輩と\nみやび先輩には\n断られたから――",
            "zh": "……因为已经被绫水前辈\n和雅前辈\n拒绝过了——",
            "narrator_zh": "圣翔"
        },
        {
            "location": "43/TALK",
            "narrator": "キリト",
            "text": "ガブリエラに頼みに\nきてるとは、さすがに\n言えねぇみたいだな。",
            "zh": "所以才跑来找\n加布里埃拉，这事儿\n她肯定不好意思直说吧。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "45/TALK",
            "narrator": "雛",
            "text": "つ、つばめちゃんには\n絶対頼めないの。",
            "zh": "绝、绝对不能\n拜托燕啊。",
            "narrator_zh": "雏"
        },
        {
            "location": "46/TALK",
            "narrator": "雛",
            "text": "つばめちゃんに内緒で\n劇場でバイトする\n許可もらって――",
            "zh": "我们的作战计划可是\n瞒着燕拿到\n剧场打工的许可——",
            "narrator_zh": "雏"
        },
        {
            "location": "47/TALK",
            "narrator": "雛",
            "text": "ビックリさせよう、\nって作戦だからねー。",
            "zh": "然后吓她一大跳\n来着呀—。",
            "narrator_zh": "雏"
        },
        {
            "location": "49/TALK",
            "narrator": "雛",
            "text": "というわけだから、\nお願い！\n教官に口添えして！",
            "zh": "所以说，\n拜托了！\n帮我们向教官美言几句吧！",
            "narrator_zh": "雏"
        },
        {
            "location": "51/TALK",
            "narrator": "ガブリエラ",
            "text": "だから、無理だって！\n絶対できないから。",
            "zh": "我都说了，不行！\n绝对不可能的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "52/TALK",
            "narrator": "雛",
            "text": "そこを何とか！\nお願いします、\nガブリエラちゃん！！",
            "zh": "想想办法嘛！\n拜托你了，\n加布里埃拉！！",
            "narrator_zh": "雏"
        },
        {
            "location": "55/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょ！？　やめてよ！\nこんなところで\n大声で…。",
            "zh": "喂！？　别这样！\n在这种地方\n大喊大叫的……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "56/TALK",
            "narrator": "雛",
            "text": "ガブリエラちゃんしか\n頼れないんだよー。\nお願いします！",
            "zh": "我们只能指望\n加布里埃拉了呀—。\n拜托了！",
            "narrator_zh": "雏"
        },
        {
            "location": "58/TALK",
            "narrator": "キリト",
            "text": "俺からも頼む！\n神様仏様\nガブリエラ様！！",
            "zh": "我也求你了！\n神明啊佛祖啊\n加布里埃拉大人！！",
            "narrator_zh": "圣翔"
        },
        {
            "location": "60/TALK",
            "narrator": "ヒカル",
            "text": "すみません…、\nお願いできませんか？",
            "zh": "不好意思……，\n能拜托您吗？",
            "narrator_zh": "光"
        },
        {
            "location": "64/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょ、うぅ…。",
            "zh": "喂、呜呜……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "65/TALK",
            "narrator": "ガブリエラ",
            "text": "ああもう、わかった！\nわかったわよ！\n口添えするから！",
            "zh": "啊啊真是的，知道了！\n我知道了啦！\n我帮你们说就是了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "66/TALK",
            "narrator": "雛",
            "text": "本当！？",
            "zh": "真的吗！？",
            "narrator_zh": "雏"
        },
        {
            "location": "68/TALK",
            "narrator": "ガブリエラ",
            "text": "口添えだけよ？\n断られたとしても、\n責任取らないから。",
            "zh": "我可只管美言几句哦？\n就算被拒绝了，\n我也不负责任。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "70/TALK",
            "narrator": "雛",
            "text": "十分だよー！\nありがとう、\nガブリエラちゃん！",
            "zh": "足够了呀—！\n谢谢你，\n加布里埃拉！",
            "narrator_zh": "雏"
        },
        {
            "location": "72/TALK",
            "narrator": "キリト",
            "text": "ふぅ…一歩前進だな。",
            "zh": "呼……总算迈出一步了。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "73/TALK",
            "narrator": "繭",
            "text": "二歩目が東雲教官で\nある以上、ここで\n行き止まりだと思う。",
            "zh": "只要第二步面对的是\n东云教官，我看在这里\n就已是死胡同了。",
            "narrator_zh": "茧"
        },
        {
            "location": "75/TALK",
            "narrator": "雛",
            "text": "不吉なこと言わない！",
            "zh": "别说这种不吉利的话！",
            "narrator_zh": "雏"
        },
        {
            "location": "78/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…面倒なことに\nなったわ…。",
            "zh": "哈啊……摊上\n麻烦事了呢……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "80/TALK",
            "narrator": "ヒカル",
            "text": "お手数おかけしますが\nよろしく\nお願いします。",
            "zh": "有劳您费心了，\n请多\n关照。",
            "narrator_zh": "光"
        },
        {
            "location": "82/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "102/TALK",
            "narrator": "真幌",
            "text": "いや、そんな頼み\nダメに決まってる\nだろ。",
            "zh": "不，那种请求\n肯定不行\n吧。",
            "narrator_zh": "真幌"
        },
        {
            "location": "103/TALK",
            "narrator": "キリト",
            "text": "はぁ…やっぱなぁ。",
            "zh": "哈啊……果然如此啊。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "104/TALK",
            "narrator": "ヒカル",
            "text": "残念でしたね。",
            "zh": "真遗憾呢。",
            "narrator_zh": "光"
        },
        {
            "location": "106/TALK",
            "narrator": "雛",
            "text": "えーっ！？\nどうしてですか！！",
            "zh": "诶—！？\n为什么呀！！",
            "narrator_zh": "雏"
        },
        {
            "location": "108/TALK",
            "narrator": "真幌",
            "text": "トライナリーの仕事を\n手伝いたいなんて\n頼み、聞けるわけない。",
            "zh": "想帮忙做三重奏的\n工作这种请求，\n怎么可能答应。",
            "narrator_zh": "真幌"
        },
        {
            "location": "112/TALK",
            "narrator": "ガブリエラ",
            "text": "…あたしも、そこまで\n手伝おうとしてるのは\n聞いてなかったけど？",
            "zh": "……我可没听说\n你们还要帮忙\n到那种地步啊？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "113/TALK",
            "narrator": "雛",
            "text": "だって、言ったら\n断られちゃいそう\nだったし…。",
            "zh": "因为，要是直接说出来\n感觉立刻就会被\n拒绝嘛……。",
            "narrator_zh": "雏"
        },
        {
            "location": "114/TALK",
            "narrator": "雛",
            "text": "あ、でも別に、\nフェノメノンの中に\n入って手伝うとか――",
            "zh": "啊，不过我们也不是\n要进到PhenoMENON里\n去帮忙什么的——",
            "narrator_zh": "雏"
        },
        {
            "location": "115/TALK",
            "narrator": "雛",
            "text": "そういうことを\n言ってるんじゃ\nないんです。",
            "zh": "我指的\n不是那种\n事啦。",
            "narrator_zh": "雏"
        },
        {
            "location": "117/TALK",
            "narrator": "雛",
            "text": "あたし達がしようと\n思ってるのは――",
            "zh": "我们想做的\n是像——",
            "narrator_zh": "雏"
        },
        {
            "location": "118/TALK",
            "narrator": "雛",
            "text": "トライナリーの\nマネージャーみたいな\nことなんです。",
            "zh": "三重奏的\n经纪人一样的\n工作。",
            "narrator_zh": "雏"
        },
        {
            "location": "119/TALK",
            "narrator": "真幌",
            "text": "…というと？",
            "zh": "……具体来说呢？",
            "narrator_zh": "真幌"
        },
        {
            "location": "120/TALK",
            "narrator": "雛",
            "text": "秘密基地のお掃除に\n食事のお世話。\nその他雑務なんでも。",
            "zh": "打扫秘密基地、\n照顾饮食。\n其他杂务什么都行。",
            "narrator_zh": "雏"
        },
        {
            "location": "122/TALK",
            "narrator": "雛",
            "text": "もちろん、必要なら\n現場に出るのも\nＯＫですよー。",
            "zh": "当然，如果有需要的话，\n去现场出外勤也\nOK哦—。",
            "narrator_zh": "雏"
        },
        {
            "location": "123/TALK",
            "narrator": "真幌",
            "text": "ＯＫなわけあるか。",
            "zh": "怎么可能OK。",
            "narrator_zh": "真幌"
        },
        {
            "location": "124/TALK",
            "narrator": "雛",
            "text": "とにかく、何でも\nするつもりですから、\nお願いします！",
            "zh": "总之，我们什么\n都愿意做，\n拜托了！",
            "narrator_zh": "雏"
        },
        {
            "location": "125/TALK",
            "narrator": "真幌",
            "text": "はぁ…そういう\n問題じゃないんだよ。",
            "zh": "哈啊……这不是\n那方面的问题。",
            "narrator_zh": "真幌"
        },
        {
            "location": "126/TALK",
            "narrator": "真幌",
            "text": "トライナリーが\n秘密の塊な組織だと\nいうのは――",
            "zh": "三重奏是\n充满了机密的组织\n这一点——",
            "narrator_zh": "真幌"
        },
        {
            "location": "127/TALK",
            "narrator": "真幌",
            "text": "あの学校に通っている\nおまえらなら\nわかるだろ？",
            "zh": "在那所学校上学的\n你们应该\n明白吧？",
            "narrator_zh": "真幌"
        },
        {
            "location": "128/TALK",
            "narrator": "真幌",
            "text": "そんなところに、\nおまえ達のような\n一般人を――",
            "zh": "那种地方，\n像你们这样的\n普通人——",
            "narrator_zh": "真幌"
        },
        {
            "location": "129/TALK",
            "narrator": "真幌",
            "text": "簡単に雇い入れる\nわけにはいかないん\nだよ。",
            "zh": "怎么可能\n随随便便雇用\n呢。",
            "narrator_zh": "真幌"
        },
        {
            "location": "131/TALK",
            "narrator": "雛",
            "text": "そんなぁ…。",
            "zh": "怎么这样……。",
            "narrator_zh": "雏"
        },
        {
            "location": "133/TALK",
            "narrator": "キリト",
            "text": "…なあ、ひなこ。\nさすがにもう\n諦め時だと思うぞ？",
            "zh": "……喂，雏。\n事到如今\n也该死心了吧？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "134/TALK",
            "narrator": "キリト",
            "text": "東雲教官にダメって\n言われちゃ、\n無理は言えないだろ。",
            "zh": "东云教官都说不行了，\n咱们也不能\n硬缠着不放吧。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "135/TALK",
            "narrator": "雛",
            "text": "うーん…。",
            "zh": "嗯—……。",
            "narrator_zh": "雏"
        },
        {
            "location": "138/TALK",
            "narrator": "ガブリエラ",
            "text": "…まあ、最初から\nわかってた結果よね。",
            "zh": "……嘛，这也是\n一开始就知道的结果呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "139/TALK",
            "narrator": "ガブリエラ",
            "text": "これだけまほに\n断られれば、さすがに\n諦めるわよね…。",
            "zh": "被真幌拒绝得这么干脆，\n她们总该\n死心了吧……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "140/TALK",
            "narrator": "繭",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "茧"
        },
        {
            "location": "142/TALK",
            "narrator": "繭",
            "text": "残念です。",
            "zh": "真遗憾。",
            "narrator_zh": "茧"
        },
        {
            "location": "143/TALK",
            "narrator": "雛",
            "text": "え？",
            "zh": "诶？",
            "narrator_zh": "雏"
        },
        {
            "location": "144/TALK",
            "narrator": "真幌",
            "text": "どうした光月。\nそんなに仕事を\n手伝いたかったのか？",
            "zh": "怎么了光月。\n你这么想来\n帮忙工作吗？",
            "narrator_zh": "真幌"
        },
        {
            "location": "146/TALK",
            "narrator": "繭",
            "text": "いえ…東雲教官は、\n筋を通せばわかると\n思っていました。",
            "zh": "不……我原本以为\n只要讲道理，\n东云教官就会明白的。",
            "narrator_zh": "茧"
        },
        {
            "location": "149/TALK",
            "narrator": "繭",
            "text": "ですが、通常攻撃隊の\n『四角ダルマ』と\n同じで――",
            "zh": "但没想到，您和\n普通攻击队的\n『四角达摩』一样——",
            "narrator_zh": "茧"
        },
        {
            "location": "150/TALK",
            "narrator": "繭",
            "text": "杓子定規な方だったと\nわかって、残念と\n思っただけです。",
            "zh": "只是个墨守成规的人，\n我只是对此\n感到遗憾罢了。",
            "narrator_zh": "茧"
        },
        {
            "location": "152/TALK",
            "narrator": "ガブリエラ",
            "text": "…え？　何今の。\nもしかして悪口？",
            "zh": "……诶？　刚才那是什么。\n难道是在骂人？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "154/TALK",
            "narrator": "キリト",
            "text": "ちょ、繭！\nおまえ何言って――",
            "zh": "喂、茧！\n你在说些什——",
            "narrator_zh": "圣翔"
        },
        {
            "location": "157/TALK",
            "narrator": "真幌",
            "text": "…おい、光月。\nその『四角ダルマ』\nってのは何だ？",
            "zh": "……喂，光月。\n那个『四角达摩』\n是什么意思？",
            "narrator_zh": "真幌"
        },
        {
            "location": "160/TALK",
            "narrator": "繭",
            "text": "確か、庁内幹部内での\n隠語だったと\n思いますが…。",
            "zh": "我记得，似乎是\n厅内干部之间的\n隐语吧……。",
            "narrator_zh": "茧"
        },
        {
            "location": "162/TALK",
            "narrator": "真幌",
            "text": "どこでそれを知った？",
            "zh": "你是从哪儿知道的？",
            "narrator_zh": "真幌"
        },
        {
            "location": "165/TALK",
            "narrator": "繭",
            "text": "ふわっとした\n風の噂で、流れ流れて\n頭の中に。",
            "zh": "是随风飘来的\n模糊传闻，辗转流进\n我脑海里的。",
            "narrator_zh": "茧"
        },
        {
            "location": "167/TALK",
            "narrator": "真幌",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "真幌"
        },
        {
            "location": "170/TALK",
            "narrator": "繭",
            "text": "…それはそうと、\n本題に戻っても\nよろしいでしょうか？",
            "zh": "……不说那个了，\n我们可以回到\n正题了吗？",
            "narrator_zh": "茧"
        },
        {
            "location": "172/TALK",
            "narrator": "真幌",
            "text": "いや…、\n光月、おまえだけ\n廊下に来い。",
            "zh": "不……，\n光月，你一个人\n到走廊来。",
            "narrator_zh": "真幌"
        },
        {
            "location": "176/TALK",
            "narrator": "雛",
            "text": "ちょ、まゆちん！\n大丈夫なの？",
            "zh": "喂、小茧！\n不要紧吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "178/TALK",
            "narrator": "繭",
            "text": "…行ってくる。",
            "zh": "……我去去就回。",
            "narrator_zh": "茧"
        },
        {
            "location": "182/TALK",
            "narrator": "キリト",
            "text": "おいおい、繭のやつ\n大丈夫なのかよ！？",
            "zh": "喂喂，茧这家伙\n没问题吧！？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "184/TALK",
            "narrator": "雛",
            "text": "し、知らないよ。\nていうか、東雲教官\nどうして怒ってんの？",
            "zh": "我、我不知道啊。\n话说回来，东云教官\n为什么这么生气啊？",
            "narrator_zh": "雏"
        },
        {
            "location": "186/TALK",
            "narrator": "ヒカル",
            "text": "わかりませんけど…、\nガブリエラさん。",
            "zh": "虽然不清楚……，\n加布里埃拉。",
            "narrator_zh": "光"
        },
        {
            "location": "189/TALK",
            "narrator": "ガブリエラ",
            "text": "っ！？",
            "zh": "！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "190/TALK",
            "narrator": "ヒカル",
            "text": "先ほど繭さんが\n言っていた四角ダルマ\nのことですが――",
            "zh": "刚才茧提到的\n四角达摩\n这件事——",
            "narrator_zh": "光"
        },
        {
            "location": "191/TALK",
            "narrator": "ヒカル",
            "text": "庁内幹部内での隠語と\nいうのは本当ですか？",
            "zh": "真的是厅内干部之间的\n隐语吗？",
            "narrator_zh": "光"
        },
        {
            "location": "193/TALK",
            "narrator": "雛",
            "text": "そういえば…、\nどうなの？",
            "zh": "说起来……，\n到底是怎么回事？",
            "narrator_zh": "雏"
        },
        {
            "location": "195/TALK",
            "narrator": "ガブリエラ",
            "text": "し、知るわけない\nでしょ！？",
            "zh": "我、我怎么可能\n知道啊！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "196/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしは隊員で\n幹部じゃないん\nだから…。",
            "zh": "我只是队员，\n又不是\n干部……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "198/TALK",
            "narrator": "真幌",
            "text": "光月！！\nその情報をどこで\n手に入れた！？",
            "zh": "光月！！\n你是从哪儿搞到\n那个情报的！？",
            "narrator_zh": "真幌"
        },
        {
            "location": "201/TALK",
            "narrator": "雛",
            "text": "ちょ、怒鳴ってるよ？\nまゆちん大丈夫なの？",
            "zh": "喂、她在吼人了哦？\n小茧真的没问题吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "203/TALK",
            "narrator": "ヒカル",
            "text": "…やっぱり、僕達も\n行ってみましょう。",
            "zh": "……果然，我们也\n过去看看吧。",
            "narrator_zh": "光"
        },
        {
            "location": "229/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょっと、まほ！\n何があったのよ！？",
            "zh": "等一下，真幌！\n到底发生什么事了！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "231/TALK",
            "narrator": "雛",
            "text": "酷いですよ！\n怒鳴らなくたって\nいいじゃないですか。",
            "zh": "太过分了！\n没必要这么\n大声吼她吧。",
            "narrator_zh": "雏"
        },
        {
            "location": "232/TALK",
            "narrator": "真幌",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "真幌"
        },
        {
            "location": "233/TALK",
            "narrator": "ヒカル",
            "text": "何があったんですか？",
            "zh": "发生什么事了吗？",
            "narrator_zh": "光"
        },
        {
            "location": "234/TALK",
            "narrator": "真幌",
            "text": "…詳細は話せん。\nだが、光月は――",
            "zh": "……详情不能说。\n但是，光月她——",
            "narrator_zh": "真幌"
        },
        {
            "location": "235/TALK",
            "narrator": "真幌",
            "text": "国家機密レベルの\n情報を握っている。",
            "zh": "掌握了国家机密级别的\n情报。",
            "narrator_zh": "真幌"
        },
        {
            "location": "237/TALK",
            "narrator": "キリト",
            "text": "…はぁ？\nど、どういうこと\nなんだよ、繭？",
            "zh": "……啊？\n这、这是怎么回事\n啊，茧？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "238/TALK",
            "narrator": "繭",
            "text": "うるさい。\nうろたえるな。",
            "zh": "吵死了。\n别慌。",
            "narrator_zh": "茧"
        },
        {
            "location": "239/TALK",
            "narrator": "真幌",
            "text": "小金井の反応が\n正しいんだ。",
            "zh": "小金井的反应\n才是正确的。",
            "narrator_zh": "真幌"
        },
        {
            "location": "241/TALK",
            "narrator": "真幌",
            "text": "おまえの持っている\nその情報は、知ってる\nだけでも大問題なんだ。",
            "zh": "你掌握的那个情报，\n光是知道\n就已经是大问题了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "242/TALK",
            "narrator": "真幌",
            "text": "もしも盗んだのだと\nすれば、国家レベルの\n重罪なんだぞ？",
            "zh": "如果是偷来的，\n那可是国家级别的\n重罪啊？",
            "narrator_zh": "真幌"
        },
        {
            "location": "244/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょ、ウソでしょ！？\nどうしてそんな話に\nなってんのよ！",
            "zh": "喂、不会吧！？\n怎么会扯到\n这种事上去啊！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "245/TALK",
            "narrator": "真幌",
            "text": "どうなんだ、光月？\nハッキリ答えろ！",
            "zh": "怎么回事，光月？\n老实回答我！",
            "narrator_zh": "真幌"
        },
        {
            "location": "247/TALK",
            "narrator": "繭",
            "text": "…そう思うのならば、\n警察に突き出して\nもらって結構です。",
            "zh": "……如果您这么认为，\n把我交给警察\n也无所谓。",
            "narrator_zh": "茧"
        },
        {
            "location": "248/TALK",
            "narrator": "繭",
            "text": "ただ…今お話したのは\n全て事実ですよね？",
            "zh": "不过……我刚才说的\n全都是事实对吧？",
            "narrator_zh": "茧"
        },
        {
            "location": "249/TALK",
            "narrator": "真幌",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "真幌"
        },
        {
            "location": "251/TALK",
            "narrator": "繭",
            "text": "ならば、私達を\n小間使いとして\n囲っておいた方が――",
            "zh": "既然如此，把我们\n当成跑腿打杂的\n留在身边——",
            "narrator_zh": "茧"
        },
        {
            "location": "252/TALK",
            "narrator": "繭",
            "text": "何かと便利だとは\n思いませんか？",
            "zh": "您不觉得这样无论做什么\n都更方便吗？",
            "narrator_zh": "茧"
        },
        {
            "location": "253/TALK",
            "narrator": "繭",
            "text": "トライナリーの\n命に関わるような\n事態になった際に――",
            "zh": "万一发生关乎\n三重奏性命的\n事态时——",
            "narrator_zh": "茧"
        },
        {
            "location": "254/TALK",
            "narrator": "繭",
            "text": "完全なる直属の部隊\nとして、我々を使える\nようにもなりますよ？",
            "zh": "您还能把我们当成\n完全直属的部队\n来驱使哦？",
            "narrator_zh": "茧"
        },
        {
            "location": "257/TALK",
            "narrator": "真幌",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "真幌"
        },
        {
            "location": "258/TALK",
            "narrator": "繭",
            "text": "…どうしますか？",
            "zh": "……您意下如何？",
            "narrator_zh": "茧"
        },
        {
            "location": "259/TALK",
            "narrator": "真幌",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "真幌"
        },
        {
            "location": "261/TALK",
            "narrator": "キリト",
            "text": "…おい、話の内容は\nよくわからねぇけど、\nヤバくねぇか？",
            "zh": "……喂，虽然没太听懂\n他们在说什么，\n但这情况不是很妙吗？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "263/TALK",
            "narrator": "雛",
            "text": "お手伝いするつもりが\n牢屋行きになるとか、\n意味わかんないよ！",
            "zh": "明明只是想来帮忙，\n结果却要进局子什么的，\n完全搞不懂啊！",
            "narrator_zh": "雏"
        },
        {
            "location": "266/TALK",
            "narrator": "ヒカル",
            "text": "お、落ち着いて！\nまだ決まったわけじゃ\nありませんから…。",
            "zh": "冷、冷静点！\n事情还没有\n定下来呢……。",
            "narrator_zh": "光"
        },
        {
            "location": "267/TALK",
            "narrator": "雛",
            "text": "で、でも…。",
            "zh": "可、可是……。",
            "narrator_zh": "雏"
        },
        {
            "location": "269/TALK",
            "narrator": "真幌",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "真幌"
        },
        {
            "location": "271/TALK",
            "narrator": "繭",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "茧"
        },
        {
            "location": "272/SEL",
            "narrator": "",
            "text": "繭達が捕まっちゃう！",
            "zh": "茧她们要被抓起来了！",
            "narrator_zh": ""
        },
        {
            "location": "273/ACT",
            "narrator": "",
            "text": "繭達が捕まっちゃう！",
            "zh": "茧她们要被抓起来了！",
            "narrator_zh": ""
        },
        {
            "location": "292/TALK",
            "narrator": "ガブリエラ",
            "text": "そんなわけないでしょ？",
            "zh": "怎么可能嘛？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "293/TALK",
            "narrator": "ガブリエラ",
            "text": "もしまほが本気で警察に突き出すつもりだとしたら",
            "zh": "如果真幌真打算把她们交给警察的话",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "294/TALK",
            "narrator": "ガブリエラ",
            "text": "今頃、とっくに警察と管理庁に連絡してるわ",
            "zh": "这会儿早就联系警察和管理厅了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "296/TALK",
            "narrator": "ガブリエラ",
            "text": "だからそんなに心配する必要ないのよ",
            "zh": "所以根本用不着那么担心啦",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "298/SEL",
            "narrator": "",
            "text": "本当に？　絶対大丈夫？",
            "zh": "真的吗？　绝对没问题？",
            "narrator_zh": ""
        },
        {
            "location": "299/ACT",
            "narrator": "",
            "text": "本当に？　絶対大丈夫？",
            "zh": "真的吗？　绝对没问题？",
            "narrator_zh": ""
        },
        {
            "location": "301/TALK",
            "narrator": "ガブリエラ",
            "text": "多分ね",
            "zh": "大概吧",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "303/SEL",
            "narrator": "",
            "text": "不安に思うところはあるんだね？",
            "zh": "你心里其实还是有些不安对吧？",
            "narrator_zh": ""
        },
        {
            "location": "304/ACT",
            "narrator": "",
            "text": "不安に思うところはあるんだね？",
            "zh": "你心里其实还是有些不安对吧？",
            "narrator_zh": ""
        },
        {
            "location": "306/TALK",
            "narrator": "ガブリエラ",
            "text": "落ち着きなさいマルザンナ！！",
            "zh": "你给我冷静点玛尔赞娜！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "308/TALK",
            "narrator": "ガブリエラ",
            "text": "大丈夫だって言ってるんだから信じなさい！",
            "zh": "我都说了没问题了，你就相信我嘛！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "319/TALK",
            "narrator": "ガブリエラ",
            "text": "まったく、\n心配性なんだから…。",
            "zh": "真是的，\n怎么这么爱操心……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "320/TALK",
            "narrator": "ガブリエラ",
            "text": "まほもどうせ\n答えは決まってるん\nだから――",
            "zh": "真幌反正也早就\n决定好答案\n了——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "321/TALK",
            "narrator": "ガブリエラ",
            "text": "さっさとダメって\n言って帰らせれば\nいいのに…。",
            "zh": "干脆点说不行，\n让她们回去\n不就好了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "322/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "323/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、ちょっとは\nフォローしてあげても\nいいかしら？",
            "zh": "不过，稍微帮她们\n圆个场\n也不错吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "324/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしのこと、\n頼ってきてくれ\nたんだから――",
            "zh": "毕竟她们也是\n特意跑来\n拜托我的——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "325/TALK",
            "narrator": "ガブリエラ",
            "text": "ガッカリして帰る姿\n見たら、こっちだって\n心が痛むわ…。",
            "zh": "看到她们垂头丧气地回去，\n我这边心里\n也会过意不去的……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "326/TALK",
            "narrator": "ガブリエラ",
            "text": "…でも、そんなこと\nしたらまほに怒られる\nかもしれないし。",
            "zh": "……可是，那样做的话\n搞不好会被真幌骂，\n而且。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "328/TALK",
            "narrator": "ガブリエラ",
            "text": "どうしよう…。",
            "zh": "怎么办呢……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "372/TALK",
            "narrator": "ガブリエラ",
            "text": "あ、$handle$！",
            "zh": "啊，$handle$！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "373/TALK",
            "narrator": "ガブリエラ",
            "text": "今回はちょっと\nただならない状況に\nなってるわね！",
            "zh": "这次似乎陷入了\n非同寻常的\n状况呢！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "374/SEL",
            "narrator": "",
            "text": "ガブリエラはどうしたいと思ってるの？",
            "zh": "加布里埃拉自己想怎么做呢？",
            "narrator_zh": ""
        },
        {
            "location": "375/ACT",
            "narrator": "",
            "text": "ガブリエラはどうしたいと思ってるの？",
            "zh": "加布里埃拉自己想怎么做呢？",
            "narrator_zh": ""
        },
        {
            "location": "377/TALK",
            "narrator": "ガブリエラ",
            "text": "司書のあたしとして\nこうしたいって答えは\nあるけど……",
            "zh": "作为司书的我，\n倒是有自己想做的\n答案……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "378/TALK",
            "narrator": "ガブリエラ",
            "text": "$handle$が\n知りたいのは、\n総意の腹づもりよね？",
            "zh": "不过$handle$\n想知道的，\n是总意的打算对吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "379/TALK",
            "narrator": "ガブリエラ",
            "text": "そこはほら！\n検索検索！",
            "zh": "这种时候嘛！\n搜索搜索！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "386/SEL",
            "narrator": "",
            "text": "司書って何でも知ってるわけじゃないんだね",
            "zh": "原来司书也不是什么都知道的啊",
            "narrator_zh": ""
        },
        {
            "location": "387/ACT",
            "narrator": "",
            "text": "司書って何でも知ってるわけじゃないんだね",
            "zh": "原来司书也不是什么都知道的啊",
            "narrator_zh": ""
        },
        {
            "location": "389/TALK",
            "narrator": "ガブリエラ",
            "text": "当たり前でしょ？\n図書館の司書が、本の\n中身を全部知ってる？",
            "zh": "那不是当然的吗？\n图书馆的司书，难道会把书\n里的内容全都记住吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "391/TALK",
            "narrator": "ガブリエラ",
            "text": "むしろ知らない事の方が\n多いくらいよ。",
            "zh": "倒不如说不知道的事\n还更多呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "392/TALK",
            "narrator": "ガブリエラ",
            "text": "オープンプロセス、\n0x58F番地から\n0x224番地へ。",
            "zh": "开放进程，\n从0x58F号地址\n前往0x224号地址。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "407/TALK",
            "narrator": "ガブリエラ",
            "text": "シーク完了っ♪",
            "zh": "搜索完成♪",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "411/TALK",
            "narrator": "ガブリエラ",
            "text": "それで、\n今回のあたしの\n総意は……っと。",
            "zh": "那么，\n这次我的\n总意是……嗯。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "412/TALK",
            "narrator": "ガブリエラ",
            "text": "……はあ、なるほど。",
            "zh": "……哈啊，原来如此。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "413/TALK",
            "narrator": "ガブリエラ",
            "text": "どっちだと思う？",
            "zh": "你觉得是哪边？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "414/SEL",
            "narrator": "",
            "text": "繭達に助け船を出したいと思ってる",
            "zh": "想向茧她们伸出援手",
            "narrator_zh": ""
        },
        {
            "location": "415/SEL",
            "narrator": "",
            "text": "繭達に素直に帰ってもらえるように誘導するつもり",
            "zh": "打算引导茧她们老老实实回去",
            "narrator_zh": ""
        },
        {
            "location": "416/ACT",
            "narrator": "",
            "text": "繭達に助け船を出したいと思ってる",
            "zh": "想向茧她们伸出援手",
            "narrator_zh": ""
        },
        {
            "location": "417/TALK",
            "narrator": "ガブリエラ",
            "text": "正解。\n何の捻りもなくて\nごめんなさいね。",
            "zh": "答对了。\n一点反转都没有，\n真不好意思呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "418/ACT",
            "narrator": "",
            "text": "繭達に素直に帰ってもらえるように誘導するつもり",
            "zh": "打算引导茧她们老老实实回去",
            "narrator_zh": ""
        },
        {
            "location": "420/TALK",
            "narrator": "ガブリエラ",
            "text": "残念。\n正解は、助け船を\n出したいって思ってる。",
            "zh": "真遗憾。\n正确答案是，她想着\n要向她们伸出援手。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "421/TALK",
            "narrator": "ガブリエラ",
            "text": "何の捻りもなくて\nごめんなさいね。",
            "zh": "一点反转都没有，\n真不好意思呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "423/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、本当に大事なのは\nここからなのよ。",
            "zh": "不过，真正重要的\n还在后头哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "424/TALK",
            "narrator": "ガブリエラ",
            "text": "助け船出したいんだけど\nどうやって口添えすれば\nいいのかわからないの。",
            "zh": "虽然想伸出援手，\n但她不知道该怎么\n帮忙说情才好。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "425/TALK",
            "narrator": "ガブリエラ",
            "text": "だから、\n$handle$に\n協力して欲しいのよね！",
            "zh": "所以，\n她希望$handle$\n能帮帮忙呢！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "427/TALK",
            "narrator": "ガブリエラ",
            "text": "何て言えば\nまほが首を縦に\n振ると思う？",
            "zh": "你觉得该怎么说，\n真幌才会点头\n答应呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "428/SEL",
            "narrator": "",
            "text": "劇場のバイトやらせれば自分たちが楽になるっていうのは？",
            "zh": "说让她们在剧场打工的话，你们自己也会轻松很多怎么样？",
            "narrator_zh": ""
        },
        {
            "location": "429/SEL",
            "narrator": "",
            "text": "男共を力仕事でこき使えるっていうのは？",
            "zh": "说可以把那几个男生当苦力使唤怎么样？",
            "narrator_zh": ""
        },
        {
            "location": "430/SEL",
            "narrator": "",
            "text": "ここまで粘着するくらいだから、雇わなかったら大変なことに…",
            "zh": "说她们都缠到这份上了，要是不雇用的话会出大事的……",
            "narrator_zh": ""
        },
        {
            "location": "431/ACT",
            "narrator": "",
            "text": "劇場のバイトやらせれば自分たちが楽になるっていうのは？",
            "zh": "说让她们在剧场打工的话，你们自己也会轻松很多怎么样？",
            "narrator_zh": ""
        },
        {
            "location": "432/TALK",
            "narrator": "ガブリエラ",
            "text": "え……。それって\n自分が怠けたいだけ\nみたいに聞こえるわよ？",
            "zh": "诶……。那样听起来\n不就像是我自己\n想偷懒一样吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "433/TALK",
            "narrator": "ガブリエラ",
            "text": "うーん……\nでも、実際\nそうなのよね。",
            "zh": "唔嗯……\n不过，事实上\n确实是这样呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "434/SEL",
            "narrator": "",
            "text": "自分で提案しておいてアレだけど、劇場いつもヒマだよね？",
            "zh": "虽然是我自己提的，不过剧场平时一直很闲对吧？",
            "narrator_zh": ""
        },
        {
            "location": "435/ACT",
            "narrator": "",
            "text": "自分で提案しておいてアレだけど、劇場いつもヒマだよね？",
            "zh": "虽然是我自己提的，不过剧场平时一直很闲对吧？",
            "narrator_zh": ""
        },
        {
            "location": "438/TALK",
            "narrator": "ガブリエラ",
            "text": "まあ、失礼ね！\n……その通りだけど。",
            "zh": "哎呀，真失礼！\n……虽然这是事实没错。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "439/TALK",
            "narrator": "ガブリエラ",
            "text": "やっぱりこの案は\nダメかしらね。",
            "zh": "看来这个方案\n还是不行呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "440/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、この発想から\n何かいい考えが浮かぶかも\nしれないし。",
            "zh": "不过，顺着这个思路\n说不定能想出\n什么好主意来。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "441/ACT",
            "narrator": "",
            "text": "男共を力仕事でこき使えるっていうのは？",
            "zh": "说可以把那几个男生当苦力使唤怎么样？",
            "narrator_zh": ""
        },
        {
            "location": "442/TALK",
            "narrator": "ガブリエラ",
            "text": "あ、それ……そうね。",
            "zh": "啊，那个……是啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "443/TALK",
            "narrator": "ガブリエラ",
            "text": "そういえば、男の子たちも\nいるんだったわね。",
            "zh": "说起来，他们之中\n也有男孩子在呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "444/SEL",
            "narrator": "",
            "text": "苦手なんだったよね",
            "zh": "你其实不太擅长应付男生对吧",
            "narrator_zh": ""
        },
        {
            "location": "445/ACT",
            "narrator": "",
            "text": "苦手なんだったよね",
            "zh": "你其实不太擅长应付男生对吧",
            "narrator_zh": ""
        },
        {
            "location": "447/TALK",
            "narrator": "ガブリエラ",
            "text": "…そうね。\n平たく言えば。",
            "zh": "……是啊。\n简单来说就是这样。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "449/TALK",
            "narrator": "ガブリエラ",
            "text": "とはいえ、口添えしたい\n気持ちは変わらないし…",
            "zh": "话虽如此，想帮忙说情的\n心情依然没变……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "450/TALK",
            "narrator": "ガブリエラ",
            "text": "割と説得力ある案だから\n背に腹は替えられない\nって感じね。",
            "zh": "这也是个挺有说服力的方案，\n也算是顾头不顾尾、\n管不了那么多了呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "451/ACT",
            "narrator": "",
            "text": "ここまで粘着するくらいだから、雇わなかったら大変なことに…",
            "zh": "说她们都缠到这份上了，要是不雇用的话会出大事的……",
            "narrator_zh": ""
        },
        {
            "location": "452/TALK",
            "narrator": "ガブリエラ",
            "text": "何それ怖っ！！",
            "zh": "什么啊好吓人！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "453/TALK",
            "narrator": "ガブリエラ",
            "text": "……と思ったけど、\n実際あり得そうなところが\n本気で怖いわね。",
            "zh": "……我是这么想的，\n但细想真有这种可能，\n这才真的吓人呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "454/TALK",
            "narrator": "ガブリエラ",
            "text": "まあ、逆恨みされて\n火を付けられるような\nことは無いと思うけど……",
            "zh": "嘛，我想她们应该\n不至于怀恨在心\n跑来纵火就是了……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "456/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、また何度もアタック\nしてくるだろうし、見てて\n辛くなりそう。",
            "zh": "不过，她们肯定还会\n一次次找上门来吧，\n看着也怪让人难受的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "457/SEL",
            "narrator": "",
            "text": "真幌も同じ気持ちになるかもよ",
            "zh": "说不定真幌也会有同样的想法哦",
            "narrator_zh": ""
        },
        {
            "location": "458/ACT",
            "narrator": "",
            "text": "真幌も同じ気持ちになるかもよ",
            "zh": "说不定真幌也会有同样的想法哦",
            "narrator_zh": ""
        },
        {
            "location": "460/TALK",
            "narrator": "ガブリエラ",
            "text": "うーん、そうかもね。\nああ見えて人情味溢れる\n人だし……。",
            "zh": "唔嗯，说不定呢。\n她别看那样，其实也是个\n很有人情味的人……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "462/TALK",
            "narrator": "ガブリエラ",
            "text": "とにかく、ありがと！\nすっごく参考になったわ。",
            "zh": "总之，谢谢啦！\n帮了大忙了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "463/SEL",
            "narrator": "",
            "text": "どういたしまして",
            "zh": "不客气",
            "narrator_zh": ""
        },
        {
            "location": "464/ACT",
            "narrator": "",
            "text": "どういたしまして",
            "zh": "不客气",
            "narrator_zh": ""
        },
        {
            "location": "467/TALK",
            "narrator": "ガブリエラ",
            "text": "それにしても……",
            "zh": "话说回来……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "468/TALK",
            "narrator": "ガブリエラ",
            "text": "$handle$は\nどうしていつもそんなに\n協力してくれるの？",
            "zh": "$handle$为什么\n总是这么愿意\n帮我呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "469/SEL",
            "narrator": "",
            "text": "ガブリエラが好きだから",
            "zh": "因为喜欢加布里埃拉",
            "narrator_zh": ""
        },
        {
            "location": "470/SEL",
            "narrator": "",
            "text": "コンプリートする為だよ",
            "zh": "为了全收集呀",
            "narrator_zh": ""
        },
        {
            "location": "471/ACT",
            "narrator": "",
            "text": "ガブリエラが好きだから",
            "zh": "因为喜欢加布里埃拉",
            "narrator_zh": ""
        },
        {
            "location": "472/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょっと、もう…\n直球すぎるわよ？",
            "zh": "喂、真是的……\n这也太直球了吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "473/TALK",
            "narrator": "ガブリエラ",
            "text": "でも$handle$は、\nそういう所も素敵よね。",
            "zh": "不过$handle$，\n连这一点也很棒呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "476/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしにもそういう所、\n見習ってもらいたいわ。",
            "zh": "真希望我也能学学\n你这一点呀。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "477/ACT",
            "narrator": "",
            "text": "コンプリートする為だよ",
            "zh": "为了全收集呀",
            "narrator_zh": ""
        },
        {
            "location": "478/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょっと？\nそれは酷いんじゃなくて？",
            "zh": "我说你啊？\n这未免也太冷酷了吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "479/SEL",
            "narrator": "",
            "text": "なんでそんな嬉しそうなの？",
            "zh": "干嘛那么开心啊？",
            "narrator_zh": ""
        },
        {
            "location": "480/ACT",
            "narrator": "",
            "text": "なんでそんな嬉しそうなの？",
            "zh": "干嘛那么开心啊？",
            "narrator_zh": ""
        },
        {
            "location": "483/TALK",
            "narrator": "ガブリエラ",
            "text": "え？　だって、どういう\n理由でも、協力してくれる\n事には変わりないもの。",
            "zh": "诶？　因为不管是什么\n理由，你愿意帮忙\n这一点是不会变的嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "484/TALK",
            "narrator": "ガブリエラ",
            "text": "そんなゲームみたいな\n理由でも、嫌だったら\nやらないでしょ？",
            "zh": "就算是为了玩游戏\n一样的理由，如果讨厌的话\n也不会去做的吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "485/SEL",
            "narrator": "",
            "text": "なんでそんなポジティブなの？",
            "zh": "为什么这么乐观啊？",
            "narrator_zh": ""
        },
        {
            "location": "486/ACT",
            "narrator": "",
            "text": "なんでそんなポジティブなの？",
            "zh": "为什么这么乐观啊？",
            "narrator_zh": ""
        },
        {
            "location": "488/TALK",
            "narrator": "ガブリエラ",
            "text": "なんで？って言われても。\nだってそういう人格\nなんだもの、あたし。",
            "zh": "问我为什么嘛。\n因为我就是这样的人格\n呀。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "490/TALK",
            "narrator": "ガブリエラ",
            "text": "だからこんな閑職に\n回されてるのかも\nしれないけどね。",
            "zh": "说不定正因如此，\n才会被调到这种冷门闲职\n上来呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "492/TALK",
            "narrator": "ガブリエラ",
            "text": "さて。それじゃ\nそろそろ行きましょ。",
            "zh": "好了。那么\n我们也差不多该出发了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "493/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしと\n$handle$にとって\n素敵なココロの旅を！",
            "zh": "愿属于我和\n$handle$的\n美妙心灵之旅开启！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "25/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>7月3日　3:38 PM</color>\nとある週末の昼下がり、近所にある公園にて。",
            "zh": "<color=green>7月3日　3:38 PM</color>\n某个周末的午后，在附近的公园里。",
            "narrator_zh": "Dialog_EventData"
