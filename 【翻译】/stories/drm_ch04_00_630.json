            "narrator": "みやび",
            "text": "それは",
            "zh": "这个",
            "narrator_zh": "雅"
        },
        {
            "location": "213/TALK",
            "narrator": "みやび",
            "text": "却って困るな",
            "zh": "反而让人为难咧",
            "narrator_zh": "雅"
        },
        {
            "location": "215/TALK",
            "narrator": "みやび",
            "text": "やはり",
            "zh": "果然",
            "narrator_zh": "雅"
        },
        {
            "location": "216/TALK",
            "narrator": "みやび",
            "text": "やめておこう",
            "zh": "还是算了吧",
            "narrator_zh": "雅"
        },
        {
            "location": "217/ACT",
            "narrator": "",
            "text": "どうやって歌うつもり？",
            "zh": "你打算怎么唱？",
            "narrator_zh": ""
        },
        {
            "location": "218/TALK",
            "narrator": "みやび",
            "text": "いや",
            "zh": "不对",
            "narrator_zh": "雅"
        },
        {
            "location": "219/TALK",
            "narrator": "みやび",
            "text": "普通に",
            "zh": "普普通通地",
            "narrator_zh": "雅"
        },
        {
            "location": "220/TALK",
            "narrator": "みやび",
            "text": "けんど",
            "zh": "但是",
            "narrator_zh": "雅"
        },
        {
            "location": "221/TALK",
            "narrator": "みやび",
            "text": "聞かせられんね",
            "zh": "没法唱给你听呢",
            "narrator_zh": "雅"
        },
        {
            "location": "222/TALK",
            "narrator": "みやび",
            "text": "ちゅーことで",
            "zh": "就是这么回事",
            "narrator_zh": "雅"
        },
        {
            "location": "223/TALK",
            "narrator": "みやび",
            "text": "やめることにするぞね",
            "zh": "那就决定不唱了咧",
            "narrator_zh": "雅"
        },
        {
            "location": "224/ACT",
            "narrator": "",
            "text": "今作曲するから待って",
            "zh": "我现在就作曲，等等",
            "narrator_zh": ""
        },
        {
            "location": "234/TALK",
            "narrator": "みやび",
            "text": "お",
            "zh": "哦",
            "narrator_zh": "雅"
        },
        {
            "location": "236/TALK",
            "narrator": "みやび",
            "text": "やる気だな",
            "zh": "挺有干劲啊",
            "narrator_zh": "雅"
        },
        {
            "location": "238/SEL",
            "narrator": "",
            "text": "もちのろん",
            "zh": "那当然",
            "narrator_zh": ""
        },
        {
            "location": "239/SEL",
            "narrator": "",
            "text": "みやびのキーは？",
            "zh": "雅的音域是多少？",
            "narrator_zh": ""
        },
        {
            "location": "240/SEL",
            "narrator": "",
            "text": "ショパンの再来だからね",
            "zh": "毕竟是肖邦再世",
            "narrator_zh": ""
        },
        {
            "location": "241/ACT",
            "narrator": "",
            "text": "もちのろん",
            "zh": "那当然",
            "narrator_zh": ""
        },
        {
            "location": "242/TALK",
            "narrator": "みやび",
            "text": "その言い方は",
            "zh": "那种说法",
            "narrator_zh": "雅"
        },
        {
            "location": "243/TALK",
            "narrator": "みやび",
            "text": "古くないか",
            "zh": "挺老套的，没是嘛？",
            "narrator_zh": "雅"
        },
        {
            "location": "244/ACT",
            "narrator": "",
            "text": "みやびのキーは？",
            "zh": "雅的音域是多少？",
            "narrator_zh": ""
        },
        {
            "location": "245/TALK",
            "narrator": "みやび",
            "text": "普通に",
            "zh": "普普通通地",
            "narrator_zh": "雅"
        },
        {
            "location": "246/TALK",
            "narrator": "みやび",
            "text": "アルト？",
            "zh": "女低音？",
            "narrator_zh": "雅"
        },
        {
            "location": "247/ACT",
            "narrator": "",
            "text": "ショパンの再来だからね",
            "zh": "毕竟是肖邦再世",
            "narrator_zh": ""
        },
        {
            "location": "248/TALK",
            "narrator": "みやび",
            "text": "それでは歌えん",
            "zh": "那样就唱不了",
            "narrator_zh": "雅"
        },
        {
            "location": "249/TALK",
            "narrator": "みやび",
            "text": "超技巧",
            "zh": "超技巧什么的",
            "narrator_zh": "雅"
        },
        {
            "location": "250/TALK",
            "narrator": "みやび",
            "text": "以前に",
            "zh": "先不论",
            "narrator_zh": "雅"
        },
        {
            "location": "251/TALK",
            "narrator": "みやび",
            "text": "ボーカル曲ではない",
            "zh": "根本就不是声乐曲",
            "narrator_zh": "雅"
        },
        {
            "location": "253/TALK",
            "narrator": "みやび",
            "text": "童謡とか唱歌とか",
            "zh": "童谣啦唱歌什么的",
            "narrator_zh": "雅"
        },
        {
            "location": "255/TALK",
            "narrator": "みやび",
            "text": "そういうのは勘弁",
            "zh": "那种就算了",
            "narrator_zh": "雅"
        },
        {
            "location": "256/TALK",
            "narrator": "みやび",
            "text": "とはいえ",
            "zh": "话虽如此",
            "narrator_zh": "雅"
        },
        {
            "location": "257/TALK",
            "narrator": "みやび",
            "text": "小唄も長唄も無理だ",
            "zh": "小呗啦长呗也都不行",
            "narrator_zh": "雅"
        },
        {
            "location": "258/TALK",
            "narrator": "みやび",
            "text": "それ以外で頼む",
            "zh": "除此之外随便点",
            "narrator_zh": "雅"
        },
        {
            "location": "260/SEL",
            "narrator": "",
            "text": "アニソンっぽいやつ",
            "zh": "像动画歌的那种",
            "narrator_zh": ""
        },
        {
            "location": "261/SEL",
            "narrator": "",
            "text": "J-popだから",
            "zh": "因为是J-pop嘛",
            "narrator_zh": ""
        },
        {
            "location": "262/SEL",
            "narrator": "",
            "text": "好きな曲調とかある？",
            "zh": "有喜欢的曲风吗？",
            "narrator_zh": ""
        },
        {
            "location": "263/ACT",
            "narrator": "",
            "text": "アニソンっぽいやつ",
