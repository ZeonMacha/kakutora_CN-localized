            "text": "リクエストはあるか",
            "zh": "有想听的歌咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "208/SEL",
            "narrator": "",
            "text": "なんでもいいよ",
            "zh": "都行吧",
            "narrator_zh": ""
        },
        {
            "location": "209/SEL",
            "narrator": "",
            "text": "どうやって歌うつもり？",
            "zh": "你打算怎么唱？",
            "narrator_zh": ""
        },
        {
            "location": "210/SEL",
            "narrator": "",
            "text": "今作曲するから待って",
            "zh": "我现在就作曲，等等",
