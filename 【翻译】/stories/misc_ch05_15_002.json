    "entry": [
        {
            "location": "4359/SCENARIO",
            "narrator": "",
            "text": "絶望という名の希望",
            "zh": "名为绝望的希望",
            "narrator_zh": ""
        },
        {
            "location": "4384/TALK",
            "narrator": "神楽",
            "text": "昏い暗い井戸の底に閉じ込められていた少女は",
            "zh": "被关在昏暗的井底的少女",
            "narrator_zh": "神乐"
        },
        {
            "location": "4385/TALK",
            "narrator": "神楽",
            "text": "月の光ほど明るい光はないと思っていた",
            "zh": "以为没有比月光更亮的光",
            "narrator_zh": "神乐"
        },
        {
            "location": "4386/TALK",
            "narrator": "神楽",
            "text": "井戸から出たその日まで",
            "zh": "直到离开井的那一天",
            "narrator_zh": "神乐"
        },
        {
            "location": "4388/SEL",
            "narrator": "",
            "text": "太陽は差さなかったわけ？",
            "zh": "所以太阳没有照到？",
            "narrator_zh": ""
        },
        {
            "location": "4389/SEL",
            "narrator": "",
            "text": "また何か受信してる？",
            "zh": "又在接收什么吗？",
            "narrator_zh": ""
        },
        {
            "location": "4390/SEL",
            "narrator": "",
            "text": "井戸から出れてよかったね…",
            "zh": "能从井里出来真好……",
            "narrator_zh": ""
        },
        {
            "location": "4391/ACT",
            "narrator": "",
            "text": "太陽は差さなかったわけ？",
            "zh": "所以太阳没有照到？",
            "narrator_zh": ""
        },
        {
            "location": "4392/TALK",
            "narrator": "神楽",
            "text": "そういうことになるのか",
            "zh": "会变成那样吗",
            "narrator_zh": "神乐"
        },
        {
            "location": "4394/TALK",
            "narrator": "神楽",
            "text": "まあいいや！",
            "zh": "嘛算了！",
            "narrator_zh": "神乐"
        },
        {
            "location": "4395/ACT",
            "narrator": "",
            "text": "また何か受信してる？",
            "zh": "又在接收什么吗？",
            "narrator_zh": ""
        },
        {
            "location": "4396/TALK",
            "narrator": "神楽",
            "text": "違うぴょん",
            "zh": "不是的pyon",
            "narrator_zh": "神乐"
        },
        {
            "location": "4397/TALK",
            "narrator": "神楽",
            "text": "ぴょんこの内面から湧き出してるぴょん",
            "zh": "是从蹦子的内面涌出来的pyon",
            "narrator_zh": "神乐"
        },
        {
            "location": "4398/ACT",
            "narrator": "",
            "text": "井戸から出れてよかったね…",
            "zh": "能从井里出来真好……",
            "narrator_zh": ""
        },
        {
            "location": "4400/TALK",
            "narrator": "神楽",
            "text": "そうかも",
            "zh": "也许是",
            "narrator_zh": "神乐"
        },
        {
            "location": "4401/TALK",
            "narrator": "神楽",
            "text": "$handlek$って優しいよね",
            "zh": "$handlek$很温柔呢",
            "narrator_zh": "神乐"
        },
        {
            "location": "4402/TALK",
            "narrator": "神楽",
            "text": "時々びっくりしてその後ほっこりするぴょん",
            "zh": "有时吓一跳，然后心里暖起来pyon",
            "narrator_zh": "神乐"
        },
        {
            "location": "4404/TALK",
            "narrator": "神楽",
            "text": "月の光しか知らなかった少女には日の光が眩しすぎて",
            "zh": "只知道月光的少女，日光太晃眼",
            "narrator_zh": "神乐"
        },
        {
            "location": "4405/TALK",
            "narrator": "神楽",
            "text": "日中は目を閉じて過ごすことしかできなかった",
            "zh": "白天只能闭着眼度过",
            "narrator_zh": "神乐"
        },
        {
            "location": "4407/SEL",
            "narrator": "",
            "text": "そんなことってあるの？",
            "zh": "有这种事吗？",
            "narrator_zh": ""
        },
        {
            "location": "4408/SEL",
            "narrator": "",
            "text": "日常生活できなくない？",
            "zh": "日常生活不是没法过吗？",
            "narrator_zh": ""
        },
        {
            "location": "4409/SEL",
            "narrator": "",
            "text": "徐々に慣れていけたのかな？",
            "zh": "是渐渐习惯了吗？",
            "narrator_zh": ""
        },
        {
            "location": "4410/ACT",
            "narrator": "",
            "text": "そんなことってあるの？",
            "zh": "有这种事吗？",
            "narrator_zh": ""
        },
        {
            "location": "4411/TALK",
            "narrator": "神楽",
            "text": "あるってことに汁！",
            "zh": "就当成有的说！[?]",
            "narrator_zh": "神乐"
        },
        {
            "location": "4412/ACT",
            "narrator": "",
            "text": "日常生活できなくない？",
            "zh": "日常生活不是没法过吗？",
            "narrator_zh": ""
        },
        {
            "location": "4413/TALK",
            "narrator": "神楽",
            "text": "できないんじゃない？",
            "zh": "不是没法过吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "4414/ACT",
            "narrator": "",
            "text": "徐々に慣れていけたのかな？",
            "zh": "是渐渐习惯了吗？",
            "narrator_zh": ""
        },
        {
            "location": "4416/TALK",
            "narrator": "神楽",
            "text": "きっとそう",
            "zh": "一定是这样",
            "narrator_zh": "神乐"
        },
        {
            "location": "4417/TALK",
            "narrator": "神楽",
            "text": "少女のペースで生きていくしかないから",
            "zh": "只能按少女的步调活下去",
            "narrator_zh": "神乐"
        },
        {
            "location": "4419/TALK",
            "narrator": "神楽",
            "text": "それは誰にも強制できないし",
            "zh": "这谁也不能强迫",
            "narrator_zh": "神乐"
        },
        {
            "location": "4421/TALK",
            "narrator": "神楽",
            "text": "外の世界は時々とても冷たかったりしたけれど",
            "zh": "外面的世界有时非常冷",
            "narrator_zh": "神乐"
        },
        {
            "location": "4422/TALK",
            "narrator": "神楽",
            "text": "それでも少女は井戸に戻るという選択だけはしなかった",
            "zh": "即便如此，少女唯独没有选择回到井里",
            "narrator_zh": "神乐"
        },
        {
            "location": "4423/TALK",
            "narrator": "神楽",
            "text": "その代わりにラジオを聴いて言葉を憶え、自分を説明する努力をした",
            "zh": "作为代替，她听收音机记住话语，努力说明自己",
            "narrator_zh": "神乐"
        },
        {
            "location": "4424/TALK",
            "narrator": "神楽",
            "text": "幸せかい？という問いにはまだはいと答えることができないけれど",
            "zh": "问她幸福吗，她还不能回答是",
            "narrator_zh": "神乐"
        },
        {
            "location": "4425/TALK",
            "narrator": "神楽",
            "text": "空に浮かぶのは月だけじゃないことを知れたことは、幸せの一片かもしれないと少女は思うのだった",
            "zh": "但知道浮在天上的不只是月亮，少女觉得这也许是幸福的一片",
            "narrator_zh": "神乐"
        }
    ]
}
