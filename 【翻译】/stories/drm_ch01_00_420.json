{
    "dir": "dramatics/daydra/drm_ch01_00_420.js",
    "type": "Episode",
    "info": {
        "story_id": "1042",
        "cid": "tsubame",
        "title": "らぶとーく 第42話",
        "sub_title": "探究心のその先は",
        "title_zh": "恋爱漫谈 第42话",
        "sub_title_zh": "求知欲的前方是"
    },
    "entry": [
        {
            "location": "115/SCENARIO",
            "narrator": "",
            "text": "探究心のその先は",
            "zh": "求知欲的前方是",
            "narrator_zh": ""
        },
        {
            "location": "127/TALK",
            "narrator": "みやび",
            "text": "…あれ？\nつばめちゃん、休憩？",
            "zh": "……咦？\n燕，在休息咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "128/TALK",
            "narrator": "つばめ",
            "text": "はい。\n丁度お茶を入れようと\n思ってたんですけど――",
            "zh": "是的。\n我正打算\n泡茶来着——",
            "narrator_zh": "燕"
        },
        {
            "location": "129/TALK",
            "narrator": "つばめ",
            "text": "みやびさんもどうですか？",
            "zh": "雅也来一杯吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "131/TALK",
            "narrator": "みやび",
            "text": "うちはえいよ。",
            "zh": "我就不用了，得。",
            "narrator_zh": "雅"
        },
        {
            "location": "132/TALK",
            "narrator": "みやび",
            "text": "それより、つばめちゃんに\n聞きたいことがあるがよ。",
            "zh": "比起那个，我有话\n想问燕咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "133/TALK",
            "narrator": "つばめ",
            "text": "わたしに、ですか？",
            "zh": "问我、吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "134/TALK",
            "narrator": "みやび",
            "text": "うん…つばめちゃんは、\nうちが思うていた以上に、\n探求心を持っているやろ？",
            "zh": "嗯……燕你啊，\n比我想的还\n更有求知欲，是没是？",
            "narrator_zh": "雅"
        },
        {
            "location": "135/TALK",
            "narrator": "つばめ",
            "text": "そ、そうですか？\n自分ではわからないん\nですけど…。",
            "zh": "是、是这样吗？\n我自己也不太\n清楚……。",
            "narrator_zh": "燕"
        },
        {
            "location": "136/TALK",
            "narrator": "みやび",
            "text": "気付いとらんかったか。\nまあ、つばめちゃん\nらしくはあるけんど――",
            "zh": "没发觉咩。\n嘛，虽然确实蛮像\n燕就是了——",
            "narrator_zh": "雅"
        },
        {
            "location": "137/TALK",
            "narrator": "みやび",
            "text": "Ｂｏｔのこと然り、\n卯月のこと然り――",
            "zh": "Bot的事也好，\n卯月的事也好——",
            "narrator_zh": "雅"
        },
        {
            "location": "138/TALK",
            "narrator": "みやび",
            "text": "探求心が強いき、\n肩入れが過ぎるんや\nないが？",
            "zh": "求知欲太强啵，\n是不是偏袒过头\n了没是嘛？",
            "narrator_zh": "雅"
        },
        {
            "location": "139/TALK",
            "narrator": "つばめ",
            "text": "…そう、なんでしょうか？",
            "zh": "……是、这样吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "140/TALK",
            "narrator": "みやび",
            "text": "少なくとも、\nうちはそう思うてる。",
            "zh": "至少，\n我是这么想的咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "141/TALK",
            "narrator": "みやび",
            "text": "けんど、肩入れするんは\nつばめちゃんの自由や\nけんど――",
            "zh": "不过，要偏袒谁\n是燕酱的自由\n咯——",
            "narrator_zh": "雅"
        },
        {
            "location": "142/TALK",
            "narrator": "みやび",
            "text": "その先に、１００％の\n理解は存在すると思う？",
            "zh": "你觉得在那之后会有\n100%的理解吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "144/TALK",
            "narrator": "つばめ",
            "text": "？　す、すみません。\nどういう意味ですか？",
            "zh": "？　抱、抱歉。\n你是什么意思呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "145/TALK",
            "narrator": "みやび",
            "text": "１００％わかりあうことが\nできるんか、っちゅう\nことや。",
            "zh": "能不能做到100%\n互相理解，就是\n这个意思咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "146/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "147/TALK",
            "narrator": "みやび",
            "text": "まあ、答えたくないなら\n答えんでもえいよ。",
            "zh": "嘛，要是不想答，\n不答也得。",
            "narrator_zh": "雅"
        },
        {
            "location": "148/TALK",
            "narrator": "みやび",
            "text": "ちっくと興味があって\n聞いただけやき。",
            "zh": "只是因为有点兴趣\n才问的咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "149/TALK",
            "narrator": "みやび",
            "text": "考えまとまったらで\nえいき、答えてもらえると\n嬉しいちや。",
            "zh": "等你想好了再答\n也得啵，能回答我的话\n我会挺开心的滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "151/TALK",
            "narrator": "つばめ",
            "text": "…どうなんだろ？\nわたしの思ってること、\n変なのかな？",
            "zh": "……到底是怎么回事呢？\n我想到的那些，\n是不是很奇怪呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "163/TALK",
            "narrator": "つばめ",
            "text": "聞きたぃことがあるの",
            "zh": "我有件事想问你",
            "narrator_zh": "燕"
        },
        {
            "location": "164/TALK",
            "narrator": "つばめ",
            "text": "探求心の先に１００％の理解はあるのかって",
            "zh": "她问我说求知欲的前方有没有100%的理解",
            "narrator_zh": "燕"
        },
        {
            "location": "165/TALK",
            "narrator": "つばめ",
            "text": "みやびさんの聞かれたの",
            "zh": "是雅问我的",
            "narrator_zh": "燕"
        },
        {
            "location": "166/TALK",
            "narrator": "つばめ",
            "text": "わたしはぁると思ぅんだけど",
            "zh": "我觉得是有的",
            "narrator_zh": "燕"
        },
        {
            "location": "167/TALK",
            "narrator": "つばめ",
            "text": "ぉかしくなぃよね？(´・ω・｀)",
            "zh": "不奇怪吧？(´･ω･｀)",
            "narrator_zh": "燕"
        },
        {
            "location": "169/SEL",
            "narrator": "",
            "text": "あるの？",
            "zh": "有吗？",
            "narrator_zh": ""
        },
        {
            "location": "170/SEL",
            "narrator": "",
            "text": "わかりあえないものだと思う",
            "zh": "我觉得是没法互相理解的",
            "narrator_zh": ""
        },
        {
            "location": "171/SEL",
            "narrator": "",
            "text": "理解しあえてると思うけど？",
            "zh": "我觉得我们算是互相理解了吧？",
            "narrator_zh": ""
        },
        {
            "location": "172/ACT",
            "narrator": "",
            "text": "あるの？",
            "zh": "有吗？",
            "narrator_zh": ""
        },
        {
            "location": "173/TALK",
            "narrator": "つばめ",
            "text": "わたしはぁると思ってる",
            "zh": "我觉得是有的",
            "narrator_zh": "燕"
        },
        {
            "location": "174/TALK",
            "narrator": "つばめ",
            "text": "だって",
            "zh": "因为",
            "narrator_zh": "燕"
        },
        {
            "location": "175/TALK",
            "narrator": "つばめ",
            "text": "わたしは知りたぃもの",
            "zh": "因为我想知道嘛",
            "narrator_zh": "燕"
        },
        {
            "location": "186/TALK",
            "narrator": "つばめ",
            "text": "…わたしは、\nあると思ってます。",
            "zh": "……我觉得，\n是有的。",
            "narrator_zh": "燕"
        },
        {
            "location": "187/TALK",
            "narrator": "みやび",
            "text": "ほう…なんでや？",
            "zh": "嚯……为驷马咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "188/TALK",
            "narrator": "つばめ",
            "text": "だって、理解し合うことが\n出来なかったら、\n寂しいじゃないですか。",
            "zh": "因为，要是没法\n互相理解，\n不是很寂寞吗。",
            "narrator_zh": "燕"
        },
        {
            "location": "189/TALK",
            "narrator": "つばめ",
            "text": "それに、そう思ってるから\nこそ、知りたい、って\n思うんですし…。",
            "zh": "而且，正因为这么想，\n我才想\n知道……。",
            "narrator_zh": "燕"
        },
        {
            "location": "190/TALK",
            "narrator": "みやび",
            "text": "…なるほど。",
            "zh": "……原来如此。",
            "narrator_zh": "雅"
        },
        {
            "location": "191/TALK",
            "narrator": "みやび",
            "text": "相手を１００％理解する\nいうことはできる。",
            "zh": "能100%理解对方这回事，\n是做得到的。",
            "narrator_zh": "雅"
        },
        {
            "location": "192/TALK",
            "narrator": "みやび",
            "text": "つばめちゃんは、\nそう思うとるんやね？",
            "zh": "燕原来是\n这么想的啊？",
            "narrator_zh": "雅"
        },
        {
            "location": "193/TALK",
            "narrator": "つばめ",
            "text": "…はい。",
            "zh": "……是的。",
            "narrator_zh": "燕"
        },
        {
            "location": "194/TALK",
            "narrator": "みやび",
            "text": "…それが、つばめちゃんの\n考えいうことやね。",
            "zh": "……那就是燕的\n想法咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "196/TALK",
            "narrator": "みやび",
            "text": "それを聞けてスッキリ\nしたちや。\nありがとな。",
            "zh": "能问到那个，我就\n痛快了。\n谢啦。",
            "narrator_zh": "雅"
        },
        {
            "location": "200/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "201/TALK",
            "narrator": "つばめ",
            "text": "わたし、間違って\nないよね？",
            "zh": "我、没有说错\n对吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "202/ACT",
            "narrator": "",
            "text": "わかりあえないものだと思う",
            "zh": "我觉得是没法互相理解的",
            "narrator_zh": ""
        },
        {
            "location": "203/TALK",
            "narrator": "つばめ",
            "text": "$handle$さんはそぅ思ぅの？",
            "zh": "$handle$是这么想的吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "204/TALK",
            "narrator": "つばめ",
            "text": "そぅなのかな？(; ;)",
            "zh": "是这样吗？(; ;)",
            "narrator_zh": "燕"
        },
        {
            "location": "215/TALK",
            "narrator": "つばめ",
            "text": "…みやびさんは――",
            "zh": "……雅小姐她——",
            "narrator_zh": "燕"
        },
        {
            "location": "216/TALK",
            "narrator": "つばめ",
            "text": "分かり合えないと思ってる\nから、そんな質問を\nしたんですか？",
            "zh": "是因为觉得没法\n互相理解，才问了\n这样的问题吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "218/TALK",
            "narrator": "みやび",
            "text": "…さあ、どうやろね？",
            "zh": "……这可谁知道咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "219/TALK",
            "narrator": "みやび",
            "text": "ただ、つばめちゃんが\nどう思うてるか気になった\nだけやき――",
            "zh": "只是，我有点在意\n燕是怎么想的，\n所以嘛——",
            "narrator_zh": "雅"
        },
        {
            "location": "221/TALK",
            "narrator": "みやび",
            "text": "うち自身は、そんなこと\n考えたことないのかも\nしれん。",
            "zh": "我自己嘛，这种事\n说不定根本就没\n想过咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "222/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "223/TALK",
            "narrator": "みやび",
            "text": "まあ、望んでいた答えや\nないけんど、答えては\nくれたき――",
            "zh": "嘛，虽然不是我期望\n的答案，但是好歹也\n回答我了啵——",
            "narrator_zh": "雅"
        },
        {
            "location": "225/TALK",
            "narrator": "みやび",
            "text": "それで満足するちや。",
            "zh": "这样就满足了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "228/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "229/TALK",
            "narrator": "つばめ",
            "text": "やっぱり、分かり合え\nないって思ってるのかな？",
            "zh": "她果然还是觉得\n没法互相理解吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "230/ACT",
            "narrator": "",
            "text": "理解しあえてると思うけど？",
            "zh": "我觉得我们算是互相理解了吧？",
            "narrator_zh": ""
        },
        {
            "location": "231/TALK",
            "narrator": "つばめ",
            "text": "$handle$さんはそぅ思ぅの？",
            "zh": "$handle$是这么想的吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "232/TALK",
            "narrator": "つばめ",
            "text": "残念だけど",
            "zh": "可惜啊",
            "narrator_zh": "燕"
        },
        {
            "location": "233/TALK",
            "narrator": "つばめ",
            "text": "それはなぃと思ぅよ(；´Д｀)",
            "zh": "我觉得没有那种事(；´Д｀)",
            "narrator_zh": "燕"
        },
        {
            "location": "244/TALK",
            "narrator": "つばめ",
            "text": "…あの、みやびさん。",
            "zh": "……那个，雅。",
            "narrator_zh": "燕"
        },
        {
            "location": "245/TALK",
            "narrator": "つばめ",
            "text": "理解とか、わかりあうって\nことを――",
            "zh": "理解呀、互相明白\n这些事——",
            "narrator_zh": "燕"
        },
        {
            "location": "246/TALK",
            "narrator": "つばめ",
            "text": "数値で言えるもの\nなんですか？",
            "zh": "是能用数字衡量的\n东西吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "247/TALK",
            "narrator": "みやび",
            "text": "じゃあ言い方変えて、\n完璧に理解できると\n思う？",
            "zh": "那换个说法，\n你觉得能完美理解\n咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "249/TALK",
            "narrator": "つばめ",
            "text": "えぇっ！？",
            "zh": "诶诶！？",
            "narrator_zh": "燕"
        },
        {
            "location": "250/TALK",
            "narrator": "みやび",
            "text": "別に数値で教えてほしい\n言うてるわけやないんよ。",
            "zh": "我也不是说非要你\n用数字讲给我听咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "251/TALK",
            "narrator": "みやび",
            "text": "肩入れすることで、\n相手をちゃんと理解\nできるんか――",
            "zh": "靠着去偏袒，\n是不是真能好好理解\n对方咩——",
            "narrator_zh": "雅"
        },
        {
            "location": "252/TALK",
            "narrator": "みやび",
            "text": "それを聞きたいだけや。\n数値を知りたいわけや\nない。",
            "zh": "我只是想听那个。\n不是想知道\n数字。",
            "narrator_zh": "雅"
        },
        {
            "location": "253/TALK",
            "narrator": "つばめ",
            "text": "は、はあ…そういうこと\nですか…。",
            "zh": "是、哈啊……那、是这样\n吗……。",
            "narrator_zh": "燕"
        },
        {
            "location": "254/TALK",
            "narrator": "みやび",
            "text": "まあ、今のつばめちゃんの\n答えで、大体はわかった\nちや。",
            "zh": "嘛，凭燕刚才\n这个回答，我大致\n懂了滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "255/TALK",
            "narrator": "つばめ",
            "text": "えっ、もういいんですか？",
            "zh": "诶，这就行了吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "256/TALK",
            "narrator": "みやび",
            "text": "うん、十分や。",
            "zh": "嗯，足够了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "257/TALK",
            "narrator": "みやび",
            "text": "変な質問して\nすまんかったね。",
            "zh": "问了个奇怪的问题，\n没好意思啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "260/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "262/TALK",
            "narrator": "つばめ",
            "text": "本当に、ちゃんと\nわかってもらえたのかな？",
            "zh": "她真的、有好好\n明白我的意思吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "125/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>8月某日　 3:20 PM</color>\n合宿中、みやびの実家でのこと",
            "zh": "<color=green>8月某日　 3:20 PM</color>\n合宿期间，在雅的老家",
            "narrator_zh": "Dialog_EventData"
        }
    ]
}
