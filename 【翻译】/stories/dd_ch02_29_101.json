    },
    "entry": [
        {
            "location": "8/SCENARIO",
            "narrator": "",
            "text": "乙女剣士と機械愛ずる姫君",
            "zh": "少女剑士与钟爱机械的公主",
            "narrator_zh": ""
        },
        {
            "location": "28/TALK",
            "narrator": "アーヤ",
            "text": "館長と\n無事に合流できて\nよかったです。",
            "zh": "能和馆长\n平安汇合\n真是太好了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "29/TALK",
            "narrator": "アーヤ",
            "text": "意味深なことを\n言うから\n心配していたんですよ。",
            "zh": "你之前说那些\n意味深长的话，\n我可是很担心的哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "30/TALK",
            "narrator": "真幌",
            "text": "それはすまなかった。",
            "zh": "那还真是抱歉。",
            "narrator_zh": "真幌"
        },
        {
            "location": "31/TALK",
            "narrator": "真幌",
            "text": "…あの時は最悪の事態を\n考えておかないと\nいけなかったからな。",
            "zh": "……当时毕竟不得不\n做最坏的\n打算啊。",
            "narrator_zh": "真幌"
        },
        {
            "location": "32/TALK",
            "narrator": "アーヤ",
            "text": "…。",
            "zh": "……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "33/TALK",
            "narrator": "真幌",
            "text": "だがその状態は\n脱した。",
            "zh": "不过那种状况\n已经脱离了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "34/TALK",
            "narrator": "真幌",
            "text": "まだまだ油断は\nできないが。",
            "zh": "虽然还远不到\n可以掉以轻心的时候。",
            "narrator_zh": "真幌"
        },
        {
            "location": "35/TALK",
            "narrator": "真幌",
            "text": "こちらにはエリカがいる。\nこれほど心強い\nことはないだろう。",
            "zh": "但我们这边有领火在。\n没有比这更让人\n安心的事了吧。",
            "narrator_zh": "真幌"
        },
        {
            "location": "37/TALK",
            "narrator": "アーヤ",
            "text": "……………。",
            "zh": "……………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "38/TALK",
            "narrator": "真幌",
            "text": "なあアーヤ。",
            "zh": "我说，绫水。",
            "narrator_zh": "真幌"
        },
        {
            "location": "39/TALK",
            "narrator": "真幌",
            "text": "エリカはいつも\n自慢していたぞ。\nおまえのことを。",
            "zh": "领火她以前\n可是一直都在炫耀\n你的事呢。",
            "narrator_zh": "真幌"
        },
        {
            "location": "42/TALK",
            "narrator": "アーヤ",
            "text": "え？",
            "zh": "哎？",
            "narrator_zh": "绫水"
        },
        {
            "location": "43/TALK",
            "narrator": "真幌",
            "text": "アヤちゃんは世界で\n一番強いんだ、と。",
            "zh": "她说小绫是\n世界上最强的。",
            "narrator_zh": "真幌"
        },
        {
            "location": "44/TALK",
            "narrator": "真幌",
            "text": "かっこよくて優しい\n自慢の妹だと。",
            "zh": "说你是既帅气又温柔、\n让她引以为傲的妹妹。",
            "narrator_zh": "真幌"
        },
        {
            "location": "45/SEL",
            "narrator": "",
            "text": "さすがアーヤ",
            "zh": "不愧是绫水",
            "narrator_zh": ""
        },
        {
            "location": "46/SEL",
            "narrator": "",
            "text": "いいお姉さんだね",
            "zh": "真是个好姐姐呢",
            "narrator_zh": ""
        },
        {
            "location": "47/ACT",
            "narrator": "",
            "text": "さすがアーヤ",
            "zh": "不愧是绫水",
            "narrator_zh": ""
        },
        {
            "location": "48/ACT",
            "narrator": "",
            "text": "いいお姉さんだね",
            "zh": "真是个好姐姐呢",
            "narrator_zh": ""
        },
        {
            "location": "66/TALK",
            "narrator": "アーヤ",
            "text": "そんなこと",
            "zh": "就算你对我说",
            "narrator_zh": "绫水"
        },
        {
            "location": "68/TALK",
            "narrator": "アーヤ",
            "text": "言われても",
            "zh": "这种事",
            "narrator_zh": "绫水"
        },
        {
            "location": "70/SEL",
            "narrator": "",
            "text": "素直になりなよ",
            "zh": "你就坦率一点嘛",
            "narrator_zh": ""
        },
        {
            "location": "71/SEL",
            "narrator": "",
            "text": "照れちゃってもー",
            "zh": "哎呀呀害羞了呢—",
            "narrator_zh": ""
        },
        {
            "location": "72/SEL",
            "narrator": "",
            "text": "そんなアーヤもかわいい",
            "zh": "这样的绫水也很可爱",
            "narrator_zh": ""
        },
        {
            "location": "73/ACT",
            "narrator": "",
            "text": "素直になりなよ",
            "zh": "你就坦率一点嘛",
            "narrator_zh": ""
        },
        {
            "location": "74/TALK",
            "narrator": "アーヤ",
            "text": "知らないわ",
            "zh": "我才不知道",
            "narrator_zh": "绫水"
        },
        {
            "location": "75/TALK",
            "narrator": "アーヤ",
            "text": "そんなこと",
            "zh": "那种事",
            "narrator_zh": "绫水"
        },
        {
            "location": "76/ACT",
            "narrator": "",
            "text": "照れちゃってもー",
            "zh": "哎呀呀害羞了呢—",
            "narrator_zh": ""
        },
        {
            "location": "77/TALK",
            "narrator": "アーヤ",
            "text": "そういうんじゃ",
            "zh": "才不是那种",
            "narrator_zh": "绫水"
        },
        {
            "location": "78/TALK",
            "narrator": "アーヤ",
            "text": "ないわ",
            "zh": "回事呢",
            "narrator_zh": "绫水"
        },
        {
            "location": "79/ACT",
            "narrator": "",
            "text": "そんなアーヤもかわいい",
            "zh": "这样的绫水也很可爱",
            "narrator_zh": ""
        },
        {
            "location": "80/TALK",
            "narrator": "アーヤ",
            "text": "$handle$さんは",
            "zh": "$handle$你啊",
            "narrator_zh": "绫水"
        },
        {
            "location": "81/TALK",
            "narrator": "アーヤ",
            "text": "いつもそれね",
            "zh": "总是这一套呢",
            "narrator_zh": "绫水"
        },
        {
            "location": "83/TALK",
            "narrator": "アーヤ",
            "text": "自慢なんか",
            "zh": "我才不是什么",
            "narrator_zh": "绫水"
        },
        {
            "location": "84/TALK",
            "narrator": "アーヤ",
            "text": "されるような妹じゃない",
            "zh": "值得拿去炫耀的妹妹",
            "narrator_zh": "绫水"
        },
        {
            "location": "85/TALK",
            "narrator": "アーヤ",
            "text": "だってお姉ちゃんの方が",
            "zh": "明明姐姐她",
            "narrator_zh": "绫水"
        },
        {
            "location": "86/TALK",
            "narrator": "アーヤ",
            "text": "ずっと頭もよくて",
            "zh": "比我聪明得多",
            "narrator_zh": "绫水"
        },
        {
            "location": "87/TALK",
            "narrator": "アーヤ",
            "text": "それに",
            "zh": "而且",
            "narrator_zh": "绫水"
        },
        {
            "location": "88/TALK",
            "narrator": "アーヤ",
            "text": "いつも変なことばかり言うから",
            "zh": "总是净说些奇怪的话",
            "narrator_zh": "绫水"
        },
        {
            "location": "89/TALK",
            "narrator": "アーヤ",
            "text": "困ってたのよ私",
            "zh": "以前可把我搞得够头疼的",
            "narrator_zh": "绫水"
        },
        {
            "location": "91/SEL",
            "narrator": "",
            "text": "誤解だったんじゃない",
            "zh": "会不会是误会呀",
            "narrator_zh": ""
        },
        {
            "location": "92/SEL",
            "narrator": "",
            "text": "離れてみてわかることもあるよ",
            "zh": "分开之后才明白的事也是有的哦",
            "narrator_zh": ""
        },
        {
            "location": "93/SEL",
            "narrator": "",
            "text": "姉妹って難しいよね",
            "zh": "姐妹之间真难处呢",
            "narrator_zh": ""
        },
        {
            "location": "94/ACT",
            "narrator": "",
            "text": "誤解だったんじゃない",
            "zh": "会不会是误会呀",
            "narrator_zh": ""
        },
        {
            "location": "95/TALK",
            "narrator": "アーヤ",
            "text": "そんなこと",
            "zh": "那种话",
            "narrator_zh": "绫水"
        },
        {
            "location": "97/TALK",
            "narrator": "アーヤ",
            "text": "言いたくないわ",
            "zh": "我才不想听",
            "narrator_zh": "绫水"
        },
        {
            "location": "98/ACT",
            "narrator": "",
            "text": "離れてみてわかることもあるよ",
            "zh": "分开之后才明白的事也是有的哦",
            "narrator_zh": ""
        },
        {
            "location": "99/TALK",
            "narrator": "アーヤ",
            "text": "それは",
            "zh": "这一点",
            "narrator_zh": "绫水"
        },
        {
            "location": "101/TALK",
            "narrator": "アーヤ",
            "text": "あるかもね",
            "zh": "或许确实有吧",
            "narrator_zh": "绫水"
        },
        {
            "location": "102/ACT",
            "narrator": "",
            "text": "姉妹って難しいよね",
            "zh": "姐妹之间真难处呢",
            "narrator_zh": ""
        },
        {
            "location": "103/TALK",
            "narrator": "アーヤ",
            "text": "そう",
            "zh": "是啊",
            "narrator_zh": "绫水"
        },
        {
            "location": "105/TALK",
            "narrator": "アーヤ",
            "text": "本当そう",
            "zh": "真的是这样",
            "narrator_zh": "绫水"
        },
        {
            "location": "117/TALK",
            "narrator": "真幌",
            "text": "それから自分は\n少し肩身が狭いとも。",
            "zh": "而且她还说自己\n心里其实有点自卑呢。",
            "narrator_zh": "真幌"
        },
        {
            "location": "119/TALK",
            "narrator": "アーヤ",
            "text": "…どうして？",
            "zh": "……为什么？",
            "narrator_zh": "绫水"
        },
        {
            "location": "120/TALK",
            "narrator": "アーヤ",
            "text": "そんなこと\nないはずです。",
            "zh": "根本没有那种事\n才对啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "121/TALK",
            "narrator": "真幌",
            "text": "しっかり者の妹と\n比べられるからだと。",
            "zh": "因为总被拿去跟稳重可靠的\n妹妹作比较。",
            "narrator_zh": "真幌"
        },
        {
            "location": "122/TALK",
            "narrator": "真幌",
            "text": "同級生や下級生だけでなく\n教師からも頼られる妹。",
            "zh": "不仅受同级生和学弟学妹欢迎，\n连老师都信赖有加的妹妹。",
            "narrator_zh": "真幌"
        },
        {
            "location": "123/TALK",
            "narrator": "真幌",
            "text": "自分はいつも人の輪から\nはみ出してしまう。でも\n妹はいつも中心にいる。",
            "zh": "自己却总是融不进\n人群的圈子里。可妹妹\n却永远处在人群的中心。",
            "narrator_zh": "真幌"
        },
        {
            "location": "124/TALK",
            "narrator": "真幌",
            "text": "そんな妹を\n自慢に思いつつも\n辛い時もあると。",
            "zh": "虽然为这样的妹妹\n感到骄傲，但有时\n心里也会很难受。",
            "narrator_zh": "真幌"
        },
        {
            "location": "126/TALK",
            "narrator": "アーヤ",
            "text": "そんなこと\n私には一度も……。",
            "zh": "这种事\n她一次都没跟我……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "174/TALK",
            "narrator": "アーヤ",
            "text": "　",
            "zh": "　",
            "narrator_zh": "绫水"
        },
        {
            "location": "190/TALK",
            "narrator": "白烏",
            "text": "[ココロゲート]へ\nいらっしゃい。\n$handle$さん。",
            "zh": "欢迎来到\n[心之扉]。\n$handle$。",
            "narrator_zh": "白鸦"
        },
        {
            "location": "191/SEL",
            "narrator": "",
            "text": "どうしたの？怖い顔して",
            "zh": "怎么了？板着一张脸",
            "narrator_zh": ""
        },
        {
            "location": "192/ACT",
            "narrator": "",
            "text": "どうしたの？怖い顔して",
            "zh": "怎么了？板着一张脸",
            "narrator_zh": ""
        },
        {
            "location": "194/TALK",
            "narrator": "白烏",
            "text": "えっと。\nそれは……",
            "zh": "那个。\n其实是……",
            "narrator_zh": "白鸦"
        },
        {
            "location": "195/TALK",
            "narrator": "白烏",
            "text": "$handle$さんに\n言わなければならない\nことがあります。",
            "zh": "有件事我必须得\n告诉$handle$\n才行。",
            "narrator_zh": "白鸦"
        },
        {
            "location": "196/SEL",
            "narrator": "",
            "text": "告白！？",
            "zh": "告白！？",
            "narrator_zh": ""
        },
        {
            "location": "197/SEL",
            "narrator": "",
            "text": "なに？",
            "zh": "什么事？",
            "narrator_zh": ""
        },
        {
            "location": "198/ACT",
            "narrator": "",
            "text": "告白！？",
            "zh": "告白！？",
            "narrator_zh": ""
        },
        {
            "location": "199/TALK",
            "narrator": "白烏",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "白鸦"
        },
        {
            "location": "200/TALK",
            "narrator": "白烏",
            "text": "やっぱりいいわ。",
            "zh": "算了，当我没说。",
            "narrator_zh": "白鸦"
        },
        {
            "location": "201/SEL",
            "narrator": "",
            "text": "えー、冗談です！",
            "zh": "哎—，开玩笑的啦！",
            "narrator_zh": ""
        },
        {
            "location": "202/ACT",
            "narrator": "",
            "text": "えー、冗談です！",
            "zh": "哎—，开玩笑的啦！",
            "narrator_zh": ""
        },
        {
            "location": "204/TALK",
            "narrator": "白烏",
            "text": "もう…。\n冗談も\n時と場所をを選んでね。",
            "zh": "真是的……。\n开玩笑也要\n分清楚场合和时机啊。",
            "narrator_zh": "白鸦"
        },
        {
            "location": "205/ACT",
            "narrator": "",
            "text": "なに？",
            "zh": "什么事？",
            "narrator_zh": ""
        },
        {
            "location": "207/TALK",
            "narrator": "白烏",
            "text": "えと……ね。",
            "zh": "那个……啊。",
            "narrator_zh": "白鸦"
        },
        {
            "location": "208/TALK",
            "narrator": "白烏",
            "text": "実は…",
            "zh": "其实……",
            "narrator_zh": "白鸦"
        },
        {
            "location": "209/TALK",
            "narrator": "白烏",
            "text": "言っておきたいことが\nあるんだけど……",
            "zh": "有件事我想先\n跟你说一声……",
            "narrator_zh": "白鸦"
        },
        {
            "location": "210/TALK",
            "narrator": "白烏",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "白鸦"
        },
        {
            "location": "211/TALK",
            "narrator": "白烏",
            "text": "うーん……",
            "zh": "唔嗯……",
            "narrator_zh": "白鸦"
        },
        {
            "location": "212/SEL",
            "narrator": "",
            "text": "……？",
            "zh": "……？？",
            "narrator_zh": ""
        },
        {
            "location": "213/ACT",
            "narrator": "",
            "text": "……？",
            "zh": "……？？",
            "narrator_zh": ""
        },
        {
            "location": "215/TALK",
            "narrator": "白烏",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "白鸦"
        },
        {
            "location": "216/TALK",
            "narrator": "白烏",
            "text": "ごめんなさい！\nやっぱり今回はナシ！",
            "zh": "对不起！\n这次还是算了！",
            "narrator_zh": "白鸦"
        },
        {
            "location": "217/SEL",
            "narrator": "",
            "text": "えー！？",
            "zh": "哎—！？",
            "narrator_zh": ""
        },
        {
            "location": "218/SEL",
            "narrator": "",
            "text": "ホントに？\nホントに言わなくていいの？",
            "zh": "真的吗？\n真的不用说吗？",
            "narrator_zh": ""
        },
        {
            "location": "219/ACT",
            "narrator": "",
            "text": "えー！？",
            "zh": "哎—！？",
            "narrator_zh": ""
        },
        {
            "location": "220/TALK",
            "narrator": "白烏",
            "text": "ごめんなさい。\nホントにごめんね。",
            "zh": "对不起。\n真的非常抱歉。",
            "narrator_zh": "白鸦"
        },
        {
            "location": "221/ACT",
            "narrator": "",
            "text": "ホントに？\nホントに言わなくていいの？",
            "zh": "真的吗？\n真的不用说吗？",
            "narrator_zh": ""
        },
        {
            "location": "223/TALK",
            "narrator": "白烏",
            "text": "え！？\nいや、言いたいけど\n今回はまだ心の準備が。",
            "zh": "哎！？\n不是，我是想说的，只是\n这次还没做好心理准备。",
            "narrator_zh": "白鸦"
        },
        {
            "location": "225/TALK",
            "narrator": "白烏",
            "text": "でも、次回は言う。\n絶対……言うから。",
            "zh": "不过，下次一定说。\n绝对……会说的。",
            "narrator_zh": "白鸦"
        },
        {
            "location": "226/SEL",
            "narrator": "",
            "text": "ダメ！\n今言え！",
            "zh": "不行！\n现在就说！",
            "narrator_zh": ""
        },
        {
            "location": "227/ACT",
            "narrator": "",
            "text": "ダメ！\n今言え！",
            "zh": "不行！\n现在就说！",
            "narrator_zh": ""
        },
        {
            "location": "229/TALK",
            "narrator": "白烏",
            "text": "は！？\nなんで！？",
            "zh": "哈！？\n为什么！？",
            "narrator_zh": "白鸦"
        },
        {
            "location": "230/SEL",
            "narrator": "",
            "text": "それ死亡フラグだから",
            "zh": "因为那是死亡Flag啊",
            "narrator_zh": ""
        },
        {
            "location": "231/ACT",
            "narrator": "",
            "text": "それ死亡フラグだから",
            "zh": "因为那是死亡Flag啊",
            "narrator_zh": ""
        },
        {
            "location": "233/TALK",
            "narrator": "白烏",
            "text": "意味が\n分からないんだけど。",
            "zh": "完全搞不懂\n你在说什么。",
            "narrator_zh": "白鸦"
        },
        {
            "location": "234/SEL",
            "narrator": "",
            "text": "前にエヴェレットが同じ事を言って、次の回に失踪した",
            "zh": "之前艾弗雷特也说了同样的话，结果下一话就失踪了",
            "narrator_zh": ""
        },
        {
            "location": "235/ACT",
            "narrator": "",
            "text": "前にエヴェレットが同じ事を言って、次の回に失踪した",
            "zh": "之前艾弗雷特也说了同样的话，结果下一话就失踪了",
            "narrator_zh": ""
        },
        {
            "location": "237/TALK",
            "narrator": "白烏",
            "text": "ああ、あのこと。\n私は大丈夫だから――",
            "zh": "啊，那件事啊。\n我不会有事的——",
            "narrator_zh": "白鸦"
        },
        {
            "location": "238/SEL",
            "narrator": "",
            "text": "それも死亡フラグなので、失踪する前に言うだけ言ってって！",
            "zh": "那也是死亡Flag，所以在失踪前好歹先说出来吧！",
            "narrator_zh": ""
        },
        {
            "location": "239/SEL",
            "narrator": "",
            "text": "白烏を助けたいから、ちゃんと教えて！",
            "zh": "因为我想帮白鸦，所以好好告诉我吧！",
            "narrator_zh": ""
        },
        {
            "location": "240/ACT",
            "narrator": "",
            "text": "それも死亡フラグなので、失踪する前に言うだけ言ってって！",
            "zh": "那也是死亡Flag，所以在失踪前好歹先说出来吧！",
            "narrator_zh": ""
        },
        {
            "location": "242/TALK",
            "narrator": "白烏",
            "text": "ああ。\n必要なのは\n情報の方なのね。",
            "zh": "啊啊。\n你需要的\n只是情报而已吧。",
            "narrator_zh": "白鸦"
        },
        {
            "location": "244/ACT",
            "narrator": "",
            "text": "白烏を助けたいから、ちゃんと教えて！",
            "zh": "因为我想帮白鸦，所以好好告诉我吧！",
            "narrator_zh": ""
        },
        {
            "location": "246/TALK",
            "narrator": "白烏",
            "text": "またそんな事言って。\n情報が欲しいだけでしょ？",
            "zh": "又说这种话。\n你只是想要情报而已吧？",
            "narrator_zh": "白鸦"
        },
        {
            "location": "247/TALK",
            "narrator": "白烏",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "白鸦"
        },
        {
            "location": "249/TALK",
            "narrator": "白烏",
            "text": "まあいいわ。\nそこまで言うなら。",
            "zh": "算了，无所谓。\n既然你都这么说了。",
            "narrator_zh": "白鸦"
        },
        {
            "location": "250/TALK",
            "narrator": "白烏",
            "text": "でも、どちらかというと\nこの情報でショックなのは\n貴方の方だと思う。",
            "zh": "不过，真要说起来，\n听到这个消息会受打击的\n反而是你这边吧。",
            "narrator_zh": "白鸦"
        },
        {
            "location": "251/SEL",
            "narrator": "",
            "text": "言ってみて",
            "zh": "说说看吧",
            "narrator_zh": ""
        },
        {
            "location": "252/SEL",
            "narrator": "",
            "text": "やっぱ遠慮します！",
            "zh": "那我还是不听了！",
            "narrator_zh": ""
        },
        {
            "location": "253/ACT",
            "narrator": "",
            "text": "言ってみて",
            "zh": "说说看吧",
            "narrator_zh": ""
        },
        {
            "location": "255/ACT",
            "narrator": "",
            "text": "やっぱ遠慮します！",
            "zh": "那我还是不听了！",
            "narrator_zh": ""
        },
        {
            "location": "256/TALK",
            "narrator": "白烏",
            "text": "もうダメ。\n言うって決めたもの。",
            "zh": "已经晚了。\n我已经决定要说了。",
            "narrator_zh": "白鸦"
        },
        {
            "location": "258/TALK",
            "narrator": "白烏",
            "text": "それじゃ、\n大事な事を伝えます。",
            "zh": "那么，\n我要说一件重要的事。",
            "narrator_zh": "白鸦"
        },
        {
            "location": "259/TALK",
            "narrator": "白烏",
            "text": "セルフクランのことは\n覚えてる？",
            "zh": "自身库兰的事\n你还记得吗？",
            "narrator_zh": "白鸦"
        },
        {
            "location": "260/SEL",
            "narrator": "",
            "text": "覚えてる",
            "zh": "记得",
            "narrator_zh": ""
        },
        {
            "location": "261/SEL",
            "narrator": "",
            "text": "一応また教えて",
            "zh": "以防万一再教我一遍吧",
            "narrator_zh": ""
        },
        {
            "location": "262/ACT",
            "narrator": "",
            "text": "覚えてる",
            "zh": "记得",
            "narrator_zh": ""
        },
        {
            "location": "263/TALK",
            "narrator": "白烏",
            "text": "さすがね。",
            "zh": "真不愧是你。",
            "narrator_zh": "白鸦"
        },
        {
            "location": "264/ACT",
            "narrator": "",
            "text": "一応また教えて",
            "zh": "以防万一再教我一遍吧",
            "narrator_zh": ""
        },
        {
            "location": "265/TALK",
            "narrator": "白烏",
            "text": "はいはい。",
            "zh": "好好好。",
            "narrator_zh": "白鸦"
        },
        {
            "location": "266/TALK",
            "narrator": "白烏",
            "text": "セルフクランは、\n私という存在の主人格と\n言われるクランのこと。",
            "zh": "自身库兰，\n指的是被称为我这个存在的\n主人格的库兰。",
            "narrator_zh": "白鸦"
        },
        {
            "location": "267/TALK",
            "narrator": "白烏",
            "text": "いわば、私を体現する\n人格のことね。",
            "zh": "换句话说，就是体现着\n我本身的人格呢。",
            "narrator_zh": "白鸦"
        },
        {
            "location": "268/SEL",
            "narrator": "",
            "text": "そうだったね",
            "zh": "是这样来着呢",
            "narrator_zh": ""
        },
        {
            "location": "269/SEL",
            "narrator": "",
            "text": "クランと人格の違いがよくわからない",
            "zh": "不太明白库兰和人格的区别",
            "narrator_zh": ""
        },
        {
            "location": "270/ACT",
            "narrator": "",
            "text": "そうだったね",
            "zh": "是这样来着呢",
            "narrator_zh": ""
        },
        {
            "location": "271/TALK",
            "narrator": "白烏",
            "text": "そうよ。",
            "zh": "没错。",
            "narrator_zh": "白鸦"
        },
        {
            "location": "272/ACT",
            "narrator": "",
            "text": "クランと人格の違いがよくわからない",
            "zh": "不太明白库兰和人格的区别",
            "narrator_zh": ""
        },
        {
            "location": "273/TALK",
            "narrator": "白烏",
            "text": "人格が発症したものが\nクランと言われるもの。",
            "zh": "所谓库兰，\n就是人格发作后显现出来的东西。",
            "narrator_zh": "白鸦"
        },
        {
            "location": "274/TALK",
            "narrator": "白烏",
            "text": "人格は、大きな衝撃が\nあったりすると発症する。",
            "zh": "人格只要受到\n强烈的冲击就会发作。",
            "narrator_zh": "白鸦"
        },
        {
            "location": "275/TALK",
            "narrator": "白烏",
            "text": "それは大抵は、その衝撃の\n主題に近いクランである\n場合が多いのだけど。",
            "zh": "那大多时候，都会是\n接近那场冲击主题的\n库兰。",
            "narrator_zh": "白鸦"
        },
        {
            "location": "276/TALK",
            "narrator": "白烏",
            "text": "でも、わりと誰でも、\n生きていれば一度や二度は\n発症してるものなのよ。",
            "zh": "不过，其实不管是谁，\n只要活着，多少都会\n发作个一两次哦。",
            "narrator_zh": "白鸦"
        },
        {
            "location": "277/TALK",
            "narrator": "白烏",
            "text": "そして、発症は決して\n悪いことじゃない。",
            "zh": "而且，发作绝对\n不是什么坏事。",
            "narrator_zh": "白鸦"
        },
        {
            "location": "278/TALK",
            "narrator": "白烏",
            "text": "それによって\n人格は進化して、\nココロは成長するから。",
            "zh": "因为借由那样的过程，\n人格才会进化，\n心灵才会成长。",
            "narrator_zh": "白鸦"
        },
        {
            "location": "279/TALK",
            "narrator": "白烏",
            "text": "ただ、セルフクランとも\nなれば、それはまた\n話が変わってくる。",
            "zh": "只是，若是到了\n自身库兰这一步，\n情况就另当别论了。",
            "narrator_zh": "白鸦"
        },
        {
            "location": "280/TALK",
            "narrator": "白烏",
            "text": "セルフクランが発症する\nくらいの出来事というのは\n全人格激動レベルのこと。",
            "zh": "足以让自身库兰发作\n的重大事件，属于\n全人格剧变级别的程度。",
            "narrator_zh": "白鸦"
        },
        {
            "location": "281/TALK",
            "narrator": "白烏",
            "text": "だから、殆どの人は、\n一生に一度も発症しない。",
            "zh": "所以，绝大多数人，\n一辈子都不会发作一次。",
            "narrator_zh": "白鸦"
        },
        {
            "location": "282/TALK",
            "narrator": "白烏",
            "text": "発症すれば、運が良ければ\n全く別人のように\n人が変わるだけで済み――",
            "zh": "一旦发作，运气好的话\n也只是整个人像变了个人\n似的彻底改头换面——",
            "narrator_zh": "白鸦"
        },
        {
            "location": "283/TALK",
            "narrator": "白烏",
            "text": "運が悪ければ、最悪\n廃人になってしまうの。",
            "zh": "运气不好的话，最坏\n甚至会变成废人。",
            "narrator_zh": "白鸦"
        },
        {
            "location": "286/TALK",
            "narrator": "白烏",
            "text": "そのセルフクランが……",
            "zh": "而那个自身库兰……",
            "narrator_zh": "白鸦"
        },
        {
            "location": "287/TALK",
            "narrator": "白烏",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "白鸦"
        },
        {
            "location": "288/SEL",
            "narrator": "",
            "text": "…？？",
            "zh": "……？？",
            "narrator_zh": ""
        },
        {
            "location": "289/ACT",
            "narrator": "",
            "text": "…？？",
            "zh": "……？？",
            "narrator_zh": ""
        },
        {
            "location": "291/TALK",
            "narrator": "白烏",
            "text": "そのセルフクランが、\n近いうちに発――",
            "zh": "那个自身库兰，\n很快就要发——",
            "narrator_zh": "白鸦"
        },
        {
            "location": "296/SEL",
            "narrator": "",
            "text": "！？",
            "zh": "！？",
            "narrator_zh": ""
        },
        {
            "location": "297/ACT",
            "narrator": "",
            "text": "！？",
            "zh": "！？",
            "narrator_zh": ""
        },
        {
            "location": "303/SEL",
            "narrator": "",
            "text": "おーい",
            "zh": "喂——",
            "narrator_zh": ""
        },
        {
            "location": "304/ACT",
            "narrator": "",
            "text": "おーい",
            "zh": "喂——",
            "narrator_zh": ""
        },
        {
            "location": "307/SEL",
            "narrator": "",
            "text": "適当に操作してみる",
            "zh": "试着随便操作看看",
            "narrator_zh": ""
        },
        {
            "location": "308/ACT",
            "narrator": "",
            "text": "適当に操作してみる",
            "zh": "试着随便操作看看",
            "narrator_zh": ""
        },
        {
            "location": "311/SEL",
            "narrator": "",
            "text": "EXEC_STATUSDUMP/.",
            "zh": "EXEC_STATUSDUMP/.",
            "narrator_zh": ""
        },
        {
            "location": "312/SEL",
            "narrator": "",
            "text": "EXEC_SEEK_SECTOR/.",
            "zh": "EXEC_SEEK_SECTOR/.",
            "narrator_zh": ""
        },
        {
            "location": "313/SEL",
            "narrator": "",
            "text": "EXEC_SUSPEND/.",
            "zh": "EXEC_SUSPEND/.",
            "narrator_zh": ""
        },
        {
            "location": "322/SEL",
            "narrator": "",
            "text": "Type::KokoroError",
            "zh": "Type::KokoroError",
            "narrator_zh": ""
        },
        {
            "location": "323/SEL",
            "narrator": "",
            "text": "Type::",
            "zh": "Type::",
            "narrator_zh": ""
        },
        {
            "location": "400/TALK",
            "narrator": "エリカ",
            "text": "あれ？\nどうしたの！？",
            "zh": "哎呀？\n怎么回事呀！？",
            "narrator_zh": "领火"
        },
        {
            "location": "401/SEL",
            "narrator": "",
            "text": "エリカさん！？",
            "zh": "领火！？",
            "narrator_zh": ""
        },
        {
            "location": "402/ACT",
            "narrator": "",
            "text": "エリカさん！？",
            "zh": "领火！？",
            "narrator_zh": ""
        },
        {
            "location": "404/TALK",
            "narrator": "エリカ",
            "text": "もしかして、\nバグって飛ばされて\n来ちゃったのかな？",
            "zh": "难道说，\n出了Bug被传飞\n到这里来了吗？",
            "narrator_zh": "领火"
        },
        {
            "location": "405/TALK",
            "narrator": "エリカ",
            "text": "確かに0x000だから、\nアドレスがnullだと\nここに来る可能性も――",
            "zh": "确实这里是0x000嘛，\n地址是null的话\n也有可能跳到这里来——",
            "narrator_zh": "领火"
        },
        {
            "location": "406/SEL",
            "narrator": "",
            "text": "エリカさんはなんでここに！？",
            "zh": "领火你怎么会在这里！？",
            "narrator_zh": ""
        },
        {
            "location": "407/ACT",
            "narrator": "",
            "text": "エリカさんはなんでここに！？",
            "zh": "领火你怎么会在这里！？",
            "narrator_zh": ""
        },
        {
            "location": "409/TALK",
            "narrator": "エリカ",
            "text": "あ、えっとね。\n別に不法侵入とかじゃ\nないよ？",
            "zh": "啊，那个呢。\n我可不是非法入侵\n之类的哦？",
            "narrator_zh": "领火"
        },
        {
            "location": "410/TALK",
            "narrator": "エリカ",
            "text": "この0x000ってのは、\n外部リンクへの\nフックアドレスなの。",
            "zh": "这个0x000呀，\n是用来连接外部链接的\n挂钩地址啦。",
            "narrator_zh": "领火"
        },
        {
            "location": "412/TALK",
            "narrator": "エリカ",
            "text": "もっと具体的に言うと、\nトライガジェットを介して\n外部へ接続する場所。",
            "zh": "更具体地说，\n就是通过Tri-Gadget\n连接到外部的地方。",
            "narrator_zh": "领火"
        },
        {
            "location": "413/TALK",
            "narrator": "エリカ",
            "text": "専門的な言い方すると、\n1xアドレス空間への\nジャンパーってところ？",
            "zh": "用专业一点的说法，\n大概就是通往1x地址空间的\n跳线之类的吧？",
            "narrator_zh": "领火"
        },
        {
            "location": "414/SEL",
            "narrator": "",
            "text": "？？？？？？？？？",
            "zh": "？？？？？？？？？",
            "narrator_zh": ""
        },
        {
            "location": "415/SEL",
            "narrator": "",
            "text": "そうだったのか！！",
            "zh": "原来是这样啊！！",
            "narrator_zh": ""
        },
        {
            "location": "416/ACT",
            "narrator": "",
            "text": "？？？？？？？？？",
            "zh": "？？？？？？？？？",
            "narrator_zh": ""
        },
        {
            "location": "418/TALK",
            "narrator": "エリカ",
            "text": "うーんと、\nえっとね……",
            "zh": "唔——嗯，\n那个呀……",
            "narrator_zh": "领火"
        },
        {
            "location": "419/TALK",
            "narrator": "エリカ",
            "text": "トライガジェットが、\n綾ちゃんを\n強くするでしょ？",
            "zh": "Tri-Gadget，\n不是会让小绫\n变强吗？",
            "narrator_zh": "领火"
        },
        {
            "location": "420/TALK",
            "narrator": "エリカ",
            "text": "戦闘経験無いのに\nすごい立ち回りが\n上手かったり、",
            "zh": "明明没有战斗经验，\n身手和走位却\n厉害得不得了，",
            "narrator_zh": "领火"
        },
        {
            "location": "421/TALK",
            "narrator": "エリカ",
            "text": "クランを装備すると、\nそのクランの力を\n自分のものにできたり。",
            "zh": "只要装备上库兰，\n就能把那个库兰的力量\n变成自己的东西之类的。",
            "narrator_zh": "领火"
        },
        {
            "location": "422/TALK",
            "narrator": "エリカ",
            "text": "そういうのは、トライ\nガジェットを介して、脳を\n拡張してるというわけ。",
            "zh": "那种事情，就是通过\nTri-Gadget来对大脑\n进行扩展啦。",
            "narrator_zh": "领火"
        },
        {
            "location": "423/TALK",
            "narrator": "エリカ",
            "text": "そして、その拡張ポート、\n例えるならUSB端子が\nこの0x000ってこと。",
            "zh": "然后呢，那个扩展端口，\n打个比方来说就像USB接口，\n也就是这个0x000啦。",
            "narrator_zh": "领火"
        },
        {
            "location": "424/TALK",
            "narrator": "エリカ",
            "text": "USBにHDD挿せば容量\n増えるし、カメラ繋げば\n目が増えるでしょ？",
            "zh": "往USB上插硬盘的话容量\n就会变大，接上摄像头的话\n眼睛就会变多对吧？",
            "narrator_zh": "领火"
        },
        {
            "location": "425/TALK",
            "narrator": "エリカ",
            "text": "それと同じ事を\nできるようにする\nポートなの。",
            "zh": "就是用来实现\n同样功能的\n端口哦。",
            "narrator_zh": "领火"
        },
        {
            "location": "426/ACT",
            "narrator": "",
            "text": "そうだったのか！！",
            "zh": "原来是这样啊！！",
            "narrator_zh": ""
        },
        {
            "location": "428/TALK",
            "narrator": "エリカ",
            "text": "そう。",
            "zh": "没错。",
            "narrator_zh": "领火"
        },
        {
            "location": "438/SEL",
            "narrator": "",
            "text": "じゃあ、前に千羽鶴をここで見かけたのも…",
            "zh": "那之前在这里看到千羽鹤，也是因为…",
            "narrator_zh": ""
        },
        {
            "location": "439/ACT",
            "narrator": "",
            "text": "じゃあ、前に千羽鶴をここで見かけたのも…",
            "zh": "那之前在这里看到千羽鹤，也是因为…",
            "narrator_zh": ""
        },
        {
            "location": "441/TALK",
            "narrator": "エリカ",
            "text": "そうだね。",
            "zh": "是那样呢。",
            "narrator_zh": "领火"
        },
        {
            "location": "442/TALK",
            "narrator": "エリカ",
            "text": "彼女がTRI-OSの\nアドミニストレータ\nだったから。",
            "zh": "因为她曾经是\nTRI-OS的\n管理员呀。",
            "narrator_zh": "领火"
        },
        {
            "location": "444/SEL",
            "narrator": "",
            "text": "でも、つばめの時はご飯食べてたよ…？",
            "zh": "可是，在燕那边的时候她还在吃饭来着…？",
            "narrator_zh": ""
        },
        {
            "location": "445/ACT",
            "narrator": "",
            "text": "でも、つばめの時はご飯食べてたよ…？",
            "zh": "可是，在燕那边的时候她还在吃饭来着…？",
            "narrator_zh": ""
        },
        {
            "location": "447/TALK",
            "narrator": "エリカ",
            "text": "そうなんだ！",
            "zh": "这样啊！",
            "narrator_zh": "领火"
        },
        {
            "location": "448/TALK",
            "narrator": "エリカ",
            "text": "それは多分、自分の\nホームだから、くつろいで\nいたんじゃないかな？",
            "zh": "那大概是因为，那里是她\n自己的主场，所以才那么\n惬意地放松着吧？",
            "narrator_zh": "领火"
        },
        {
            "location": "451/TALK",
            "narrator": "エリカ",
            "text": "それはそうと、\nどうしてここに来たの？",
            "zh": "先不说那个，\n你怎么会来这里呢？",
            "narrator_zh": "领火"
        },
        {
            "location": "452/SEL",
            "narrator": "",
            "text": "突然白烏が消えたから、自分で飛んできた",
            "zh": "因为白鸦突然消失了，我就自己飞过来了",
            "narrator_zh": ""
        },
        {
            "location": "453/ACT",
            "narrator": "",
            "text": "突然白烏が消えたから、自分で飛んできた",
            "zh": "因为白鸦突然消失了，我就自己飞过来了",
            "narrator_zh": ""
        },
        {
            "location": "455/TALK",
            "narrator": "エリカ",
            "text": "突然…消えた？",
            "zh": "突然……消失了？",
            "narrator_zh": "领火"
        },
        {
            "location": "456/TALK",
            "narrator": "エリカ",
            "text": "うーん……\nそんなことは\nないと思うんだけど……",
            "zh": "唔——嗯……\n我觉得应该不会\n发生这种事才对呀……",
            "narrator_zh": "领火"
        },
        {
            "location": "457/TALK",
            "narrator": "エリカ",
            "text": "ちょっと調べてみるね。",
            "zh": "我稍微去查查看哦。",
            "narrator_zh": "领火"
        },
        {
            "location": "458/TALK",
