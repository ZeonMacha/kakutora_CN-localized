{
    "dir": "chap10/daydra/dd_ch02_10_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "10202",
        "cid": "ayami",
        "title": "002 メインストーリー",
        "sub_title": "切れない物が怖い＜前編＞",
        "title_zh": "002 主线剧情",
        "sub_title_zh": "害怕无法斩断之物＜前篇＞"
    },
    "entry": [
        {
            "location": "8/SCENARIO",
            "narrator": "",
            "text": "切れない物が怖い",
            "zh": "害怕无法斩断之物",
            "narrator_zh": ""
        },
        {
            "location": "24/TALK",
            "narrator": "つばめ",
            "text": "…買い物に夢中に\nなって、遅くなっ\nちゃった。",
            "zh": "……买东西买得太入迷，\n回来的路上\n都这么晚了。",
            "narrator_zh": "燕"
        },
        {
            "location": "25/TALK",
            "narrator": "つばめ",
            "text": "部屋に戻ったら、\nすぐにお夕飯の\n準備をして…。",
            "zh": "回到房间之后，\n得赶紧开始\n准备晚饭……",
            "narrator_zh": "燕"
        },
        {
            "location": "28/TALK",
            "narrator": "つばめ",
            "text": "…えっ！？",
            "zh": "……咦！？",
            "narrator_zh": "燕"
        },
        {
            "location": "29/TALK",
            "narrator": "つばめ",
            "text": "何、あれ？\n寮の周りを、何かが\n飛んでるような…？",
            "zh": "那、那是什么？\n宿舍周围，好像有东西\n在飞……？",
            "narrator_zh": "燕"
        },
        {
            "location": "31/TALK",
            "narrator": "つばめ",
            "text": "あの影は…え！？\n人間？",
            "zh": "那个影子是……咦！？\n人吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "33/TALK",
            "narrator": "つばめ",
            "text": "あっ、あの部屋は！",
            "zh": "啊，那个房间是！",
            "narrator_zh": "燕"
        },
        {
            "location": "53/TALK",
            "narrator": "つばめ",
            "text": "怖くて町中まで戻って\n来ちゃったよ……。",
            "zh": "吓得我又跑回\n镇上了……",
            "narrator_zh": "燕"
        },
        {
            "location": "54/TALK",
            "narrator": "つばめ",
            "text": "あれ、何だったんだろう\nやっぱりドロ…",
            "zh": "刚才那个，到底是什么呀\n果然是小……",
            "narrator_zh": "燕"
        },
        {
            "location": "56/TALK",
            "narrator": "アーヤ",
            "text": "あら、逢瀬さん。\nどうかしたの？",
            "zh": "哎呀，逢濑。\n怎么了吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "57/TALK",
            "narrator": "つばめ",
            "text": "ああっ、アーヤさん！\n良かったぁ！！",
            "zh": "啊啊，绫水！\n太好了！！",
            "narrator_zh": "燕"
        },
        {
            "location": "59/TALK",
            "narrator": "アーヤ",
            "text": "えっ？\nどうしたの？\n何かあったの？",
            "zh": "咦？\n怎么了？\n出什么事了吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "60/TALK",
            "narrator": "つばめ",
            "text": "今、買い物から帰って\nきたんですけど――",
            "zh": "我刚才买完东西\n正要回来——",
            "narrator_zh": "燕"
        },
        {
            "location": "61/TALK",
            "narrator": "つばめ",
            "text": "寮の周りを、ゆらゆら\nした人影が飛んでいた\nんです。",
            "zh": "结果看见宿舍周围，\n有个晃晃悠悠的人影\n在天上飞。",
            "narrator_zh": "燕"
        },
        {
            "location": "63/TALK",
            "narrator": "アーヤ",
            "text": "えっ！？",
            "zh": "咦！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "64/TALK",
            "narrator": "つばめ",
            "text": "それで、その影が\nアーヤさんの部屋に\n降りていったから――",
            "zh": "然后，那个影子\n就落到绫水的\n房间去了——",
            "narrator_zh": "燕"
        },
        {
            "location": "66/TALK",
            "narrator": "つばめ",
            "text": "泥棒なんじゃ、って\n心配になって…。",
            "zh": "我担心会不会是小偷，\n心里正慌呢……",
            "narrator_zh": "燕"
        },
        {
            "location": "68/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "70/TALK",
            "narrator": "つばめ",
            "text": "アーヤさん？",
            "zh": "绫水？",
            "narrator_zh": "燕"
        },
        {
            "location": "72/TALK",
            "narrator": "アーヤ",
            "text": "あっ、ううん！\n私は平気だから！",
            "zh": "啊、没事！\n我不要紧的！",
            "narrator_zh": "绫水"
        },
        {
            "location": "74/TALK",
            "narrator": "つばめ",
            "text": "？　そうですか…。\nじゃあ、見間違い\nだったのかなぁ？",
            "zh": "？ 这样呀……\n那，难道是我\n看花眼了吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "75/TALK",
            "narrator": "アーヤ",
            "text": "…ゆらゆらしながら\n空を飛ぶ人影って――",
            "zh": "……一边晃晃悠悠地\n一边在天上飞的人影——",
            "narrator_zh": "绫水"
        },
        {
            "location": "77/TALK",
            "narrator": "アーヤ",
            "text": "…霊！？\nうちの寮に…！？",
            "zh": "……幽灵！？\n在我们宿舍里……！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "78/TALK",
            "narrator": "つばめ",
            "text": "でもやっぱり戻ります。\nお騒がせしました。",
            "zh": "那我还是回去啦。\n打扰你了。",
            "narrator_zh": "燕"
        },
        {
            "location": "81/TALK",
            "narrator": "アーヤ",
            "text": "っ！？　ま、待って！\n行っちゃダメ！",
            "zh": "唔！？ 等、等等！\n不能走！",
            "narrator_zh": "绫水"
        },
        {
            "location": "83/TALK",
            "narrator": "つばめ",
            "text": "はい？",
            "zh": "啊？",
            "narrator_zh": "燕"
        },
        {
            "location": "86/TALK",
            "narrator": "アーヤ",
            "text": "あっ…ほ、ほら、\n安全のためよ。",
            "zh": "啊……那、那个，\n是为了安全着想哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "87/TALK",
            "narrator": "アーヤ",
            "text": "もし本当に泥棒だった\nとしたら、逢瀬さんも\n危ないわ。",
            "zh": "万一真是什么小偷，\n逢濑你一个人\n也很危险。",
            "narrator_zh": "绫水"
        },
        {
            "location": "90/TALK",
            "narrator": "アーヤ",
            "text": "寮まで送るから、\n一緒に行きましょ。",
            "zh": "我送你回宿舍，\n一起走吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "91/TALK",
            "narrator": "つばめ",
            "text": "で、でも、ご迷惑に\nなっちゃうんじゃ…。",
            "zh": "可、可是，这样不就\n太麻烦你了……",
            "narrator_zh": "燕"
        },
        {
            "location": "92/TALK",
            "narrator": "アーヤ",
            "text": "そんなことないわ。\n後輩の安全を護るのも\n私の役目よ。",
            "zh": "没那回事。\n保护后辈的安全，\n也是我的职责所在。",
            "narrator_zh": "绫水"
        },
        {
            "location": "94/TALK",
            "narrator": "アーヤ",
            "text": "それじゃ、早く部屋に\n行きましょ。",
            "zh": "好了，我们快点\n回房间去吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "95/TALK",
            "narrator": "つばめ",
            "text": "は、はい…。",
            "zh": "好、好的……",
            "narrator_zh": "燕"
        },
        {
            "location": "96/TALK",
            "narrator": "つばめ",
            "text": "…余計な心配\nさせちゃったかな？",
            "zh": "……是不是让绫水\n白操心了呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "121/TALK",
            "narrator": "アーヤ",
            "text": "ふぅ……。\nこれでしばらく\n時間が稼げるわ…。",
            "zh": "呼……\n这样一来，总算能\n拖延一会儿时间了……",
            "narrator_zh": "绫水"
        },
        {
            "location": "124/TALK",
            "narrator": "つばめ",
            "text": "ふぅ…。\nアーヤさん、シャワー\n出ましたぁ。",
            "zh": "呼……\n绫水，我洗完澡\n出来啦。",
            "narrator_zh": "燕"
        },
        {
            "location": "125/TALK",
            "narrator": "アーヤ",
            "text": "さっぱりした？\n鍋焼きうどんも\n丁度出来たところよ。",
            "zh": "洗清爽了？\n锅烧乌冬面也\n正好做好了哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "127/TALK",
            "narrator": "つばめ",
            "text": "わぁ、美味しそう！",
            "zh": "哇，看起来好好吃！",
            "narrator_zh": "燕"
        },
        {
            "location": "128/TALK",
            "narrator": "アーヤ",
            "text": "熱いうちに食べてね。",
            "zh": "趁热吃吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "130/TALK",
            "narrator": "つばめ",
            "text": "はい…でも、送って\nもらっただけじゃ\nなくて――",
            "zh": "嗯……不过，\n不仅麻烦你送我\n回来——",
            "narrator_zh": "燕"
        },
        {
            "location": "131/TALK",
            "narrator": "つばめ",
            "text": "夕飯まで作ってもらっ\nちゃって、何だか\n申し訳ないです…。",
            "zh": "还劳烦你连晚饭都\n帮我做好了，总觉得\n怪不好意思的……",
            "narrator_zh": "燕"
        },
        {
            "location": "133/TALK",
            "narrator": "アーヤ",
            "text": "気にしないで。",
            "zh": "别放在心上。",
            "narrator_zh": "绫水"
        },
        {
            "location": "135/TALK",
            "narrator": "アーヤ",
            "text": "それに、怖がってる\n逢瀬さんを一人には\nできないもの。",
            "zh": "再说，我也不能把\n正害怕的逢濑\n一个人丢下不管。",
            "narrator_zh": "绫水"
        },
        {
            "location": "137/TALK",
            "narrator": "つばめ",
            "text": "…何だか、\nすみません。",
            "zh": "……总觉得，\n实在不好意思。",
            "narrator_zh": "燕"
        },
        {
            "location": "138/TALK",
            "narrator": "つばめ",
            "text": "実は、一人で寮に\n戻るの、ちょっとだけ\n怖かったんです…。",
            "zh": "其实，一个人回宿舍\n的时候，我确实有点\n害怕来着……",
            "narrator_zh": "燕"
        },
        {
            "location": "139/TALK",
            "narrator": "アーヤ",
            "text": "そういう時は、\nちゃんと言ってくれて\nいいのよ？",
            "zh": "那种时候，\n直接跟我说出来\n就好了嘛。",
            "narrator_zh": "绫水"
        },
        {
            "location": "140/TALK",
            "narrator": "アーヤ",
            "text": "私はリーダーなん\nだから、遠慮なんか\nしないで。",
            "zh": "我可是队长，\n不用跟我\n客气的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "142/TALK",
            "narrator": "つばめ",
            "text": "は、はい…。",
            "zh": "是、是的……",
            "narrator_zh": "燕"
        },
        {
            "location": "145/TALK",
            "narrator": "つばめ",
            "text": "…やっぱり、\nアーヤさんは\n凄いなぁ…。",
            "zh": "……果然，\n绫水真的\n好厉害呀……",
            "narrator_zh": "燕"
        },
        {
            "location": "146/TALK",
            "narrator": "つばめ",
            "text": "わたしと違って、\n全然怖がってない。",
            "zh": "跟我不一样，\n完全不害怕呢。",
            "narrator_zh": "燕"
        },
        {
            "location": "147/TALK",
            "narrator": "つばめ",
            "text": "どうしたら、わたしも\nアーヤさんみたいに\nなれるんだろ？",
            "zh": "要怎么做，我才能\n变得像绫水这样\n镇定呢？",
            "narrator_zh": "燕"
        },
        {
            "location": "150/TALK",
            "narrator": "アーヤ",
            "text": "…よかった。\nつばめも少しは\n怖がってて…。",
            "zh": "……太好了。\n幸好燕多少也有点\n害怕……",
            "narrator_zh": "绫水"
        },
        {
            "location": "151/TALK",
            "narrator": "アーヤ",
            "text": "おかげで、こうして\nつばめの部屋にいる\n口実が出来たわ。",
            "zh": "托她的福，我才终于\n有了留在燕房间里的\n借口。",
            "narrator_zh": "绫水"
        },
        {
            "location": "152/TALK",
            "narrator": "アーヤ",
            "text": "…つばめには、\n気付かれてないと\nいいんだけど。",
            "zh": "……只希望\n别被燕察觉到\n就好了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "154/TALK",
            "narrator": "つばめ",
            "text": "アーヤさんって、\nやっぱり――",
            "zh": "绫水果然，\n还是因为——",
            "narrator_zh": "燕"
        },
        {
            "location": "157/TALK",
            "narrator": "アーヤ",
            "text": "っ！？　な、なに！？",
            "zh": "唔！？ 什、什么！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "158/TALK",
            "narrator": "つばめ",
            "text": "剣道をやってるから、\nそんなに凛として\nいられるんですか？",
            "zh": "因为一直有在练剑道，\n所以才能保持得\n这么凛然吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "159/TALK",
            "narrator": "アーヤ",
            "text": "あ、ああ…剣道ね。",
            "zh": "啊、啊……剑道啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "160/TALK",
            "narrator": "アーヤ",
            "text": "でも、正確には\n『やっていた』\nだけどね。",
            "zh": "不过，准确来说\n是“以前练过”\n就是了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "162/TALK",
            "narrator": "アーヤ",
            "text": "高校を卒業する時、\n剣道はやめちゃった\nから…。",
            "zh": "高中毕业的时候，\n我就把剑道\n停掉了……",
            "narrator_zh": "绫水"
        },
        {
            "location": "163/TALK",
            "narrator": "つばめ",
            "text": "え？　でも楽屋に\n竹刀がありました\nけど？",
            "zh": "咦？可我记得休息室里\n不是放着一把\n竹刀吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "166/TALK",
            "narrator": "アーヤ",
            "text": "あれは、ほら…、\n素振り用にね。",
            "zh": "那个嘛，你看……\n只是拿来空挥用的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "167/TALK",
            "narrator": "アーヤ",
            "text": "ストレス発散に、\nおもいっきり振りたく\nなる時もあるのよ。",
            "zh": "想发泄压力的时候，\n偶尔也会想痛痛快快\n挥上几下嘛。",
            "narrator_zh": "绫水"
        },
        {
            "location": "168/TALK",
            "narrator": "つばめ",
            "text": "なるほど…。\nそれでも、やっぱり\n凄いです。",
            "zh": "原来如此……\n即便如此，还是觉得\n你好厉害。",
            "narrator_zh": "燕"
        },
        {
            "location": "170/TALK",
            "narrator": "つばめ",
            "text": "料理が出来て、\n自分で自分の身を\n護ることが出来て――",
            "zh": "既会做饭，\n又能靠自己的力量\n保护自己——",
            "narrator_zh": "燕"
        },
        {
            "location": "171/TALK",
            "narrator": "つばめ",
            "text": "後輩のわたしにも\n気遣えるんだもの。",
            "zh": "还能这样细心地\n关照我这个后辈。",
            "narrator_zh": "燕"
        },
        {
            "location": "172/TALK",
            "narrator": "つばめ",
            "text": "…きっと、\nアーヤさんみたいな\n人のことを――",
            "zh": "……我想，\n大家口中说的，\n大概就是指",
            "narrator_zh": "燕"
        },
        {
            "location": "173/TALK",
            "narrator": "つばめ",
            "text": "自立した女性、って\n言うんだろうなぁ…。",
            "zh": "像绫水这样的\n自立女性吧……",
            "narrator_zh": "燕"
        },
        {
            "location": "174/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "175/TALK",
            "narrator": "アーヤ",
            "text": "何？　そんなジッと\n見つめてきて…。",
            "zh": "怎么了？这么直勾勾地\n盯着我看……",
            "narrator_zh": "绫水"
        },
        {
            "location": "176/TALK",
            "narrator": "つばめ",
            "text": "あ、いえ…。",
            "zh": "啊，没、没什么……",
            "narrator_zh": "燕"
        },
        {
            "location": "177/TALK",
            "narrator": "つばめ",
            "text": "アーヤさんの\nカレシさんって――",
            "zh": "我只是在想，\n绫水的男朋友——",
            "narrator_zh": "燕"
        },
        {
            "location": "180/TALK",
            "narrator": "つばめ",
            "text": "とても幸せ者だな、\nって思っちゃって…。",
            "zh": "一定是个特别幸福的人吧，\n心里这么想着……",
            "narrator_zh": "燕"
        },
        {
            "location": "181/TALK",
            "narrator": "アーヤ",
            "text": "あら？　逢瀬さんも\nそういう話するんだ？",
            "zh": "哎呀？想不到逢濑\n也会聊这种话题啊？",
            "narrator_zh": "绫水"
        },
        {
            "location": "182/TALK",
            "narrator": "つばめ",
            "text": "えへへ…。",
            "zh": "嘿嘿……",
            "narrator_zh": "燕"
        },
        {
            "location": "183/TALK",
            "narrator": "アーヤ",
            "text": "…でも、多分私の\n彼氏になる人は――",
            "zh": "……不过，将来要是真有\n谁当了我的男朋友——",
            "narrator_zh": "绫水"
        },
        {
            "location": "184/TALK",
            "narrator": "アーヤ",
            "text": "絶対苦労するから、\n幸せ者には程遠いん\nじゃないかしら？",
            "zh": "绝对会很辛苦的，\n恐怕跟“幸福”\n完全沾不上边吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "185/TALK",
            "narrator": "つばめ",
            "text": "そうなんですか？",
            "zh": "是这样的吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "186/TALK",
            "narrator": "アーヤ",
            "text": "ええ…本当、私の\n彼氏なんかになったら\n大変だから…。",
            "zh": "嗯……真的，要是当了\n我的男朋友，可有的\n受罪了……",
            "narrator_zh": "绫水"
        },
        {
            "location": "187/TALK",
            "narrator": "アーヤ",
            "text": "将来的には、うちの\n神社を継がされたり\nとか――",
            "zh": "以后说不定还得\n被要求继承我们家的\n神社什么的——",
            "narrator_zh": "绫水"
        },
        {
            "location": "189/TALK",
            "narrator": "アーヤ",
            "text": "私のお化け嫌いでも、\n沢山迷惑掛けることに\nなりそうだし…。",
            "zh": "再加上我这么怕鬼，\n肯定也会给他添不少\n麻烦……",
            "narrator_zh": "绫水"
        },
        {
            "location": "191/TALK",
            "narrator": "アーヤ",
            "text": "はぁ…。",
            "zh": "哈啊……",
            "narrator_zh": "绫水"
        },
        {
            "location": "192/TALK",
            "narrator": "つばめ",
            "text": "え、えと…、\nあ、そうだ！",
            "zh": "那、那个……\n啊、对了！",
            "narrator_zh": "燕"
        },
        {
            "location": "193/TALK",
            "narrator": "つばめ",
            "text": "じゃあ、どういう\nカレシさんなら\nいいと思いますか？",
            "zh": "那，绫水觉得\n什么样的男朋友\n比较合适呢？",
            "narrator_zh": "燕"
        },
        {
            "location": "195/TALK",
            "narrator": "アーヤ",
            "text": "うーん、そうね…。",
            "zh": "唔……让我想想……",
            "narrator_zh": "绫水"
        },
        {
            "location": "196/TALK",
            "narrator": "アーヤ",
            "text": "やっぱり、私より\n怖がりじゃない方が\nいいと思うから…。",
            "zh": "果然还是比我\n胆子大一点的\n比较好吧……",
            "narrator_zh": "绫水"
        },
        {
            "location": "198/TALK",
            "narrator": "アーヤ",
            "text": "…精神的に強い人、\nかな？",
            "zh": "……心理素质强大的人，\n大概是这样？",
            "narrator_zh": "绫水"
        },
        {
            "location": "199/TALK",
            "narrator": "つばめ",
            "text": "精神的に強い人、\nですか…。",
            "zh": "心理素质强大的人，\n吗……",
            "narrator_zh": "燕"
        },
        {
            "location": "200/TALK",
            "narrator": "つばめ",
            "text": "なんか、ちょっと\nわかる気がします。",
            "zh": "总觉得，我好像\n有点明白了。",
            "narrator_zh": "燕"
        },
        {
            "location": "201/TALK",
            "narrator": "つばめ",
            "text": "アーヤさんも\n強い人だから――",
            "zh": "因为绫水自己\n也是个很坚强的人——",
            "narrator_zh": "燕"
        },
        {
            "location": "202/TALK",
            "narrator": "つばめ",
            "text": "凄くお似合いだと\n思いますよ。",
            "zh": "我觉得你们肯定\n特别般配哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "203/TALK",
            "narrator": "アーヤ",
            "text": "…なんか、微妙に\n勘違いされてる気が\nするけど――",
            "zh": "……总觉得，她好像\n稍微有点误会了\n我的意思——",
            "narrator_zh": "绫水"
        },
        {
            "location": "204/TALK",
            "narrator": "アーヤ",
            "text": "まあ、お化けが怖い\nなんてのがバレるより\nマシよね…。",
            "zh": "不过，总比被她发现\n我其实怕鬼怕得要死\n强多了吧……",
            "narrator_zh": "绫水"
        },
        {
            "location": "205/SEL",
            "narrator": "",
            "text": "もしかして、オバケ苦手なの？",
            "zh": "该不会，你怕鬼吧？",
            "narrator_zh": ""
        },
        {
            "location": "206/ACT",
            "narrator": "",
            "text": "もしかして、オバケ苦手なの？",
            "zh": "该不会，你怕鬼吧？",
            "narrator_zh": ""
        },
        {
            "location": "227/TALK",
            "narrator": "アーヤ",
            "text": "まさか",
            "zh": "怎么可能",
            "narrator_zh": "绫水"
        },
        {
            "location": "228/TALK",
            "narrator": "アーヤ",
            "text": "そんなことあるわけないでそ",
            "zh": "哪儿会有那种事啊",
            "narrator_zh": "绫水"
        },
        {
            "location": "230/TALK",
            "narrator": "アーヤ",
            "text": "でしょ！！（｀皿´ )",
            "zh": "对吧！！（｀皿´ )",
            "narrator_zh": "绫水"
        },
        {
            "location": "232/SEL",
            "narrator": "",
            "text": "動揺してる？",
            "zh": "你慌了？",
            "narrator_zh": ""
        },
        {
            "location": "233/ACT",
            "narrator": "",
            "text": "動揺してる？",
            "zh": "你慌了？",
            "narrator_zh": ""
        },
        {
            "location": "235/TALK",
            "narrator": "アーヤ",
            "text": "してないから",
            "zh": "才没有好吧",
            "narrator_zh": "绫水"
        },
        {
            "location": "236/TALK",
            "narrator": "アーヤ",
            "text": "いくらＢｏｔでも",
            "zh": "就算你是Bot",
            "narrator_zh": "绫水"
        },
        {
            "location": "237/TALK",
            "narrator": "アーヤ",
            "text": "適当過ぎよ！(｀ヘ´)",
            "zh": "说话也太随便了吧！(｀ヘ´)",
            "narrator_zh": "绫水"
        },
        {
            "location": "249/TALK",
            "narrator": "アーヤ",
            "text": "…まったく、もう。\n本当に心を読んでるんじゃ\nないかしら……。",
            "zh": "……真是的，受不了。\n该不会真的能读心\n吧……",
            "narrator_zh": "绫水"
        },
        {
            "location": "293/TALK",
            "narrator": "アーヤ",
            "text": "[ココロゲート]へ\nいらっしゃい。\n$handle$さん。",
            "zh": "欢迎来到\n[心之扉]，\n$handle$。",
            "narrator_zh": "绫水"
        },
        {
            "location": "294/TALK",
            "narrator": "アーヤ",
            "text": "毎回懲りずに来てくれて\n本当にありがとう。",
            "zh": "每次都不嫌麻烦地跑来，\n真的很谢谢你。",
            "narrator_zh": "绫水"
        },
        {
            "location": "296/TALK",
            "narrator": "アーヤ",
            "text": "それじゃ早速\n扉をコールするわね。",
            "zh": "那我就赶紧\n呼叫心之扉了哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "301/TALK",
            "narrator": "アーヤ",
            "text": "オープンプロセス、\n0x68F番地から\n0x295番地へ。",
            "zh": "开放进程，\n从0x68F号地址\n前往0x295号地址。",
            "narrator_zh": "绫水"
        },
        {
            "location": "323/TALK",
            "narrator": "アーヤ",
            "text": "シーク完了。",
            "zh": "搜索完成。",
            "narrator_zh": "绫水"
        },
        {
            "location": "325/TALK",
            "narrator": "アーヤ",
            "text": "さて、\n今回は何かしらね。",
            "zh": "那么，\n这次是什么情况呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "328/TALK",
            "narrator": "アーヤ",
            "text": "……あはは。",
            "zh": "……啊哈哈。",
            "narrator_zh": "绫水"
        },
        {
            "location": "329/SEL",
            "narrator": "",
            "text": "オバケ怖いんだ",
            "zh": "原来你怕鬼啊",
            "narrator_zh": ""
        },
        {
            "location": "330/ACT",
            "narrator": "",
            "text": "オバケ怖いんだ",
            "zh": "原来你怕鬼啊",
            "narrator_zh": ""
        },
        {
            "location": "332/TALK",
            "narrator": "アーヤ",
            "text": "そうね。\nお恥ずかしながら。",
            "zh": "是啊。\n真是不好意思。",
            "narrator_zh": "绫水"
        },
        {
            "location": "333/SEL",
            "narrator": "アーヤ",
            "text": "てことは、今回はオバケ怖いって気持ちを打破するの？",
            "zh": "这么说，这次是要克服怕鬼的心情吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "334/ACT",
            "narrator": "",
            "text": "てことは、今回はオバケ怖いって気持ちを打破するの？",
            "zh": "这么说，这次是要克服怕鬼的心情吗？",
            "narrator_zh": ""
        },
        {
            "location": "336/TALK",
            "narrator": "アーヤ",
            "text": "うーん、\n流石にそれは無理かな。",
            "zh": "唔——\n那果然还是做不到吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "337/TALK",
            "narrator": "アーヤ",
            "text": "私の霊に対する恐怖心は\nかなり根が深いから、\n少なくともここでは無理。",
            "zh": "我对幽灵的恐惧\n可是相当根深蒂固的，\n至少在这里解决不了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "338/TALK",
            "narrator": "アーヤ",
            "text": "今回は寧ろ逆で……",
            "zh": "这次反倒是正好相反……",
            "narrator_zh": "绫水"
        },
        {
            "location": "339/TALK",
            "narrator": "アーヤ",
            "text": "怖いから、どんな手段を\n用いてもつばめの部屋に\n留まらせて欲しいの。",
            "zh": "正因为害怕，我才希望你\n无论用什么手段，都要把她\n留在燕的房间里。",
            "narrator_zh": "绫水"
        },
        {
            "location": "340/SEL",
            "narrator": "",
            "text": "そこまで！？",
            "zh": "怕到这种地步！？",
            "narrator_zh": ""
        },
        {
            "location": "341/ACT",
            "narrator": "",
            "text": "そこまで！？",
            "zh": "怕到这种地步！？",
            "narrator_zh": ""
        },
        {
            "location": "343/TALK",
            "narrator": "アーヤ",
            "text": "ええ、そこまで。",
            "zh": "对，就是到这种地步。",
            "narrator_zh": "绫水"
        },
        {
            "location": "344/TALK",
            "narrator": "アーヤ",
            "text": "司書の私も含めて、\n本当にちょっと\n無理なのよ。",
            "zh": "就连身为司书的我，\n也是真的有点\n受不了呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "345/TALK",
            "narrator": "アーヤ",
            "text": "それくらい\n根が深いっていうか……",
            "zh": "就是这么\n根深蒂固吧……",
            "narrator_zh": "绫水"
        },
        {
            "location": "346/TALK",
            "narrator": "アーヤ",
            "text": "だから、逢瀬さんに\n対する遠慮を緩和して\n欲しいの。お願い！",
            "zh": "所以，希望能帮你缓和一下\n她对逢濑的客气\n和顾虑。拜托了！",
            "narrator_zh": "绫水"
        },
        {
            "location": "347/SEL",
            "narrator": "",
            "text": "そこまで言うなら……",
            "zh": "既然你都这么说了……",
            "narrator_zh": ""
        },
        {
            "location": "348/ACT",
            "narrator": "",
            "text": "そこまで言うなら……",
            "zh": "既然你都这么说了……",
            "narrator_zh": ""
        },
        {
            "location": "350/TALK",
            "narrator": "アーヤ",
            "text": "よかった。\nよろしくね。",
            "zh": "太好了。\n那就拜托你了哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "351/SEL",
            "narrator": "",
            "text": "はい",
            "zh": "好",
            "narrator_zh": ""
        },
        {
            "location": "352/ACT",
            "narrator": "",
            "text": "はい",
            "zh": "好",
            "narrator_zh": ""
        },
        {
            "location": "355/TALK",
            "narrator": "アーヤ",
            "text": "はぁ……。",
            "zh": "哈啊……",
            "narrator_zh": "绫水"
        },
        {
            "location": "356/TALK",
            "narrator": "アーヤ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "357/SEL",
            "narrator": "",
            "text": "どうしたの？",
            "zh": "怎么了？",
            "narrator_zh": ""
        },
        {
            "location": "358/ACT",
            "narrator": "",
            "text": "どうしたの？",
            "zh": "怎么了？",
            "narrator_zh": ""
        },
        {
            "location": "360/TALK",
            "narrator": "アーヤ",
            "text": "えっと……",
            "zh": "那个……",
            "narrator_zh": "绫水"
        },
        {
            "location": "361/SEL",
            "narrator": "",
            "text": "幽霊が怖いってことを気にしてるの？",
            "zh": "还在介意怕鬼这件事吗？",
            "narrator_zh": ""
        },
        {
            "location": "362/ACT",
            "narrator": "",
            "text": "幽霊が怖いってことを気にしてるの？",
            "zh": "还在介意怕鬼这件事吗？",
            "narrator_zh": ""
        },
        {
            "location": "364/TALK",
            "narrator": "アーヤ",
            "text": "え？\nあ、ううん、\nそうじゃなくて。",
            "zh": "咦？\n啊、不是，\n不是那件事。",
            "narrator_zh": "绫水"
        },
        {
            "location": "365/TALK",
            "narrator": "アーヤ",
            "text": "$handle$は、\n他の子たちのココロの\n中にも行ってる感じ？",
            "zh": "$handle$，\n你平时也会去其他女孩子的\n心灵里面吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "366/SEL",
            "narrator": "",
            "text": "もちろん",
            "zh": "当然",
            "narrator_zh": ""
        },
        {
            "location": "367/SEL",
            "narrator": "",
            "text": "アーヤだけだよ",
            "zh": "只有绫水哦",
            "narrator_zh": ""
        },
        {
            "location": "368/ACT",
            "narrator": "",
            "text": "もちろん",
            "zh": "当然",
            "narrator_zh": ""
        },
        {
            "location": "369/TALK",
            "narrator": "アーヤ",
            "text": "ほんと？",
            "zh": "真的吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "370/TALK",
            "narrator": "アーヤ",
            "text": "あの……",
            "zh": "那个……",
            "narrator_zh": "绫水"
        },
        {
            "location": "371/TALK",
            "narrator": "アーヤ",
            "text": "えと……",
            "zh": "就是……",
            "narrator_zh": "绫水"
        },
        {
            "location": "372/TALK",
            "narrator": "アーヤ",
            "text": "他の子のココロの中って\nどんな感じ？",
            "zh": "其他女孩子的心灵里面\n是什么样的呢？",
            "narrator_zh": "绫水"
        },
        {
            "location": "373/ACT",
            "narrator": "",
            "text": "アーヤだけだよ",
            "zh": "只有绫水哦",
            "narrator_zh": ""
        },
        {
            "location": "374/TALK",
            "narrator": "アーヤ",
            "text": "あー、そうなんだ…。",
            "zh": "啊——这样啊……",
            "narrator_zh": "绫水"
        },
        {
            "location": "375/SEL",
            "narrator": "",
            "text": "あれ？ガッカリしてる？",
            "zh": "咦？你失望了吗？",
            "narrator_zh": ""
        },
        {
            "location": "376/ACT",
            "narrator": "",
            "text": "あれ？ガッカリしてる？",
            "zh": "咦？你失望了吗？",
            "narrator_zh": ""
        },
        {
            "location": "379/TALK",
            "narrator": "アーヤ",
            "text": "え！？\nいえ、別に……",
            "zh": "咦！？\n没有，倒也不是……",
            "narrator_zh": "绫水"
        },
        {
            "location": "380/TALK",
            "narrator": "アーヤ",
            "text": "……えっと、その、ね、\n大した事じゃないのよ。",
            "zh": "……那个、就是、呢，\n没什么大不了的事啦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "381/TALK",
            "narrator": "アーヤ",
            "text": "ただ、他の子のココロの\n中ってどんな感じなのか\nって思っただけ。",
            "zh": "只是单纯好奇，\n其他女孩子的心灵里面\n会是什么样子而已。",
            "narrator_zh": "绫水"
        },
        {
            "location": "383/SEL",
            "narrator": "",
            "text": "気になるんだ！",
            "zh": "你很在意呀！",
            "narrator_zh": ""
        },
        {
            "location": "384/ACT",
            "narrator": "",
            "text": "気になるんだ！",
            "zh": "你很在意呀！",
            "narrator_zh": ""
        },
        {
            "location": "386/TALK",
            "narrator": "アーヤ",
            "text": "あ、……そ…\n……それは……　…",
            "zh": "啊、……那…\n……那是……",
            "narrator_zh": "绫水"
        },
        {
            "location": "388/TALK",
            "narrator": "アーヤ",
            "text": "……はぁ。",
            "zh": "……哈啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "389/TALK",
            "narrator": "アーヤ",
            "text": "正直に言うわね。",
            "zh": "我老实说吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "390/TALK",
            "narrator": "アーヤ",
            "text": "他の子のココロの中を\n覗きたいわけじゃなくて、\nうんと……",
            "zh": "我并不是想去偷窥\n其他女孩子的心灵，\n嗯……",
            "narrator_zh": "绫水"
        },
        {
            "location": "391/TALK",
            "narrator": "アーヤ",
            "text": "$handle$にとって\n私のココロって、他の子に\n比べて退屈かなって……。",
            "zh": "只是在想，对$handle$来说，\n我的心灵是不是比起其他女孩子\n显得很无聊呢……",
            "narrator_zh": "绫水"
        },
        {
            "location": "392/TALK",
            "narrator": "アーヤ",
            "text": "なんか毎回つまんない\n悩み事ばっかりで、\n嫌になってきてない？",
            "zh": "总觉得每次都是些\n微不足道的小烦恼，\n你会不会觉得厌烦了？",
            "narrator_zh": "绫水"
        },
        {
            "location": "393/SEL",
            "narrator": "",
            "text": "正直つまらない",
            "zh": "老实说确实挺无聊",
            "narrator_zh": ""
        },
        {
            "location": "394/SEL",
            "narrator": "",
            "text": "そんなことないよ！",
            "zh": "才没有那种事哦！",
            "narrator_zh": ""
        },
        {
            "location": "395/ACT",
            "narrator": "",
            "text": "正直つまらない",
            "zh": "老实说确实挺无聊",
