{
 "dir": "chap07/daydra/dd_ch05_07_101.js",
 "type": "MainStory",
 "info": {
  "story_id": "7502",
  "cid": "kagura",
  "title": "002 メインストーリー",
  "sub_title": "なれあい＜前編＞",
  "title_zh": "002 主线剧情",
  "sub_title_zh": "和稀泥＜前篇＞"
 },
 "entry": [
  {
   "location": "36/TALK",
   "narrator": "つばめ",
   "text": "…終わったねぇ。",
   "zh": "……结束了呀。",
   "narrator_zh": "燕"
  },
  {
   "location": "37/TALK",
   "narrator": "神楽",
   "text": "…そうですね。\n私、もうヘトヘトです。",
   "zh": "……是啊。\n我已经累坏了。",
   "narrator_zh": "神乐"
  },
  {
   "location": "39/TALK",
   "narrator": "つばめ",
   "text": "わたし…もうベッドに\n直行したい気分だよ。",
   "zh": "我……已经想\n直接钻进被窝了。",
   "narrator_zh": "燕"
  },
  {
   "location": "40/TALK",
   "narrator": "つばめ",
   "text": "こんなに大変なこと、\nアーヤさん達は…。",
   "zh": "这么辛苦的事，\n绫水她们……。",
   "narrator_zh": "燕"
  },
  {
   "location": "43/TALK",
   "narrator": "つばめ",
   "text": "ずーっとやってた\nなんて、\n尊敬しちゃうよね。",
   "zh": "一直都在做，\n真的，\n好让人尊敬呀。",
   "narrator_zh": "燕"
  },
  {
   "location": "45/TALK",
   "narrator": "神楽",
   "text": "…………。",
   "zh": "…………。",
   "narrator_zh": "神乐"
  },
  {
   "location": "46/TALK",
   "narrator": "神楽",
   "text": "どういうこと？",
   "zh": "什么意思？",
   "narrator_zh": "神乐"
  },
  {
   "location": "47/TALK",
   "narrator": "神楽",
   "text": "さっきの戦闘で、\nこの子は人並みレベルにも\n戦えていなかった。",
   "zh": "刚才的战斗里，\n这孩子连普通人的水平\n都没打到。",
   "narrator_zh": "神乐"
  },
  {
   "location": "48/TALK",
   "narrator": "神楽",
   "text": "ううん、そもそも\n戦い方をまったく知らない\n感じで…。",
   "zh": "不对，根本\n像是完全不会\n战斗……。",
   "narrator_zh": "神乐"
  },
  {
   "location": "49/TALK",
   "narrator": "神楽",
   "text": "状況に翻弄されてる\nだけにしか見えなかった",
   "zh": "看起来只是\n被状况牵着走",
   "narrator_zh": "神乐"
  },
  {
   "location": "50/TALK",
   "narrator": "神楽",
   "text": "これが…本当にあの\n逢瀬つばめなの？",
   "zh": "这……真的是那个\n逢濑燕吗？",
   "narrator_zh": "神乐"
  },
  {
   "location": "51/TALK",
   "narrator": "神楽",
   "text": "…あの、つばめさん。\n初めての戦闘の感想、\n聞いていいですか？",
   "zh": "……那个，燕。\n第一次战斗的感想，\n可以问问吗？",
   "narrator_zh": "神乐"
  },
  {
   "location": "54/TALK",
   "narrator": "つばめ",
   "text": "感想って言われても…、\nよく覚えてないかも。",
   "zh": "说感想的话……\n我可能记不太清。",
   "narrator_zh": "燕"
  },
  {
   "location": "55/TALK",
   "narrator": "つばめ",
   "text": "なんか、とにかく必死で\n色々動いてて…。",
   "zh": "就是，总之拼了命\n动来动去……。",
   "narrator_zh": "燕"
  },
  {
   "location": "56/TALK",
   "narrator": "つばめ",
   "text": "気がついたら終わってた、\nって感じだったし…。",
   "zh": "回过神来已经结束了，\n就是这种感觉……。",
   "narrator_zh": "燕"
  },
  {
   "location": "57/TALK",
   "narrator": "神楽",
   "text": "で、でも、つばめさんは\nドーム戦を経験している\nじゃないですか。",
   "zh": "可、可是，燕\n经历过穹顶战\n不是吗。",
   "narrator_zh": "神乐"
  },
  {
   "location": "58/TALK",
   "narrator": "つばめ",
   "text": "えっ？　どうして\n卯月さんがそのこと\n知ってるの？",
   "zh": "诶？　为什么\n卯月会知道\n这件事？",
   "narrator_zh": "燕"
  },
  {
   "location": "59/TALK",
   "narrator": "神楽",
   "text": "あっ…ま、真幌さんから、\n事前に聞いてたので…。",
   "zh": "啊……是、从真幌那里，\n事先听说的……。",
   "narrator_zh": "神乐"
  },
  {
   "location": "60/TALK",
   "narrator": "つばめ",
   "text": "あ、そうだったんだ？",
   "zh": "啊，是这样呀？",
   "narrator_zh": "燕"
  },
  {
   "location": "61/TALK",
   "narrator": "つばめ",
   "text": "でも…、あの時はまだ、\n入隊する前だったから、\n逃げてるだけだったし…。",
   "zh": "可是……那时候还\n没入队，\n只是在逃而已……。",
   "narrator_zh": "燕"
  },
  {
   "location": "62/TALK",
   "narrator": "つばめ",
   "text": "って、それって今日と\nやってること変わらない\nような…？",
   "zh": "说起来，那和今天\n做的事好像也\n没差……？",
   "narrator_zh": "燕"
  },
  {
   "location": "63/TALK",
   "narrator": "神楽",
   "text": "…もしかしてつばめさん。\nどこか具合でも悪いんじゃ\nないですか？",
   "zh": "……难道燕。\n是不是哪里\n不舒服？",
   "narrator_zh": "神乐"
  },
  {
   "location": "65/TALK",
   "narrator": "つばめ",
   "text": "ええっ？　そんなこと\nないけど…。",
   "zh": "诶诶？　没有\n那种事……。",
   "narrator_zh": "燕"
  },
  {
   "location": "66/TALK",
   "narrator": "神楽",
   "text": "…すみません。\nちょっと、おでこ\n触りますね。",
   "zh": "……抱歉。\n我稍微，摸一下\n额头哦。",
   "narrator_zh": "神乐"
  },
  {
   "location": "67/TALK",
   "narrator": "つばめ",
   "text": "あっ、ひゃっ！？",
   "zh": "啊，呀！？",
   "narrator_zh": "燕"
  },
  {
   "location": "68/TALK",
   "narrator": "神楽",
   "text": "…熱はないみたい。\nじゃあ、どこかケガとか\nしているんじゃ…。",
   "zh": "……好像没发烧。\n那，是不是哪里\n受伤了……。",
   "narrator_zh": "神乐"
  },
  {
   "location": "69/TALK",
   "narrator": "つばめ",
   "text": "だ、大丈夫だよ。\nわたしは本当に\n平気だから。",
   "zh": "没、没关系。\n我真的\n没事。",
   "narrator_zh": "燕"
  },
  {
   "location": "70/TALK",
   "narrator": "つばめ",
   "text": "あ、でも――",
   "zh": "啊，不过——",
   "narrator_zh": "燕"
  },
  {
   "location": "71/TALK",
   "narrator": "神楽",
   "text": "やっぱり、どこか具合が？",
   "zh": "果然，哪里不舒服？",
   "narrator_zh": "神乐"
  },
  {
   "location": "72/TALK",
   "narrator": "つばめ",
   "text": "そうなりかけはしたけど、\n神楽ちゃんのおかげで\n助かったから…。",
   "zh": "差一点就那样了，\n多亏了神乐\n才得救……。",
   "narrator_zh": "燕"
  },
  {
   "location": "73/TALK",
   "narrator": "つばめ",
   "text": "さっきは、わたしを\n護ってくれてありがと。",
   "zh": "刚才，谢谢你\n保护我。",
   "narrator_zh": "燕"
  },
  {
   "location": "74/TALK",
   "narrator": "つばめ",
   "text": "おかげで、わたしは\nこの通り無事だよ。",
   "zh": "所以我才能\n像这样平安无事。",
   "narrator_zh": "燕"
  },
  {
   "location": "76/TALK",
   "narrator": "神楽",
   "text": "そ、そんな。\nお礼なんて…。",
   "zh": "哪、哪里。\n道谢什么的……。",
   "narrator_zh": "神乐"
  },
  {
   "location": "77/TALK",
   "narrator": "つばめ",
   "text": "同じ新人なのに…、\nわたしも、卯月さんのこと\n見習わなくちゃ。",
   "zh": "明明都是新人……\n我也得向\n卯月学习。",
   "narrator_zh": "燕"
  },
  {
   "location": "79/TALK",
   "narrator": "神楽",
   "text": "そ、そんなことないです！",
   "zh": "没、没那回事！",
   "narrator_zh": "神乐"
  },
  {
   "location": "80/TALK",
   "narrator": "神楽",
   "text": "私も、必死だったから\nあまり戦闘のこと\n覚えてないですし…。",
   "zh": "我也拼了命，\n战斗的事\n记不太清……。",
   "narrator_zh": "神乐"
  },
  {
   "location": "82/TALK",
   "narrator": "つばめ",
   "text": "あはは、よかったー。\nちょっと安心したよ。",
   "zh": "啊哈哈，太好了。\n稍微安心了。",
   "narrator_zh": "燕"
  },
  {
   "location": "83/TALK",
   "narrator": "つばめ",
   "text": "昔っからどんくさいって\nよく言われてるから…。",
   "zh": "从以前就常被说\n笨手笨脚……。",
   "narrator_zh": "燕"
  },
  {
   "location": "84/TALK",
   "narrator": "つばめ",
   "text": "それでなのかなぁ、って、\n不安だったんだ。",
   "zh": "是不是因为这个，\n我才不安的。",
   "narrator_zh": "燕"
  },
  {
   "location": "85/TALK",
   "narrator": "神楽",
   "text": "…………。",
   "zh": "…………。",
   "narrator_zh": "神乐"
  },
  {
   "location": "86/TALK",
   "narrator": "神楽",
   "text": "わからない…。\nなんなの、この子？",
   "zh": "不懂……。\n这孩子，到底怎么回事？",
   "narrator_zh": "神乐"
  },
  {
   "location": "87/TALK",
   "narrator": "神楽",
   "text": "ドーム戦で見せたような\n冷徹さが、今は微塵にも\n感じられない。",
   "zh": "穹顶战里那种\n冷彻，现在一丁点\n都感觉不到。",
   "narrator_zh": "神乐"
  },
  {
   "location": "88/TALK",
   "narrator": "神楽",
   "text": "まるで、どこにでもいる\n普通の女の子みたいな…。",
   "zh": "简直像随处可见的\n普通女孩子……。",
   "narrator_zh": "神乐"
  },
  {
   "location": "89/TALK",
   "narrator": "神楽",
   "text": "ううん、まさにそれ。\n戦闘なんか無縁の、\n普通の子そのもの。",
   "zh": "不对，就是这样。\n和战斗毫无关系的、\n普通孩子本身。",
   "narrator_zh": "神乐"
  },
  {
   "location": "90/TALK",
   "narrator": "つばめ",
   "text": "…………。",
   "zh": "…………。",
   "narrator_zh": "燕"
  },
  {
   "location": "91/TALK",
   "narrator": "神楽",
   "text": "元気ないみたいですけど、\nやっぱりどこか具合が…。",
   "zh": "看起来没精神，\n果然是哪里不舒服……。",
   "narrator_zh": "神乐"
  },
  {
   "location": "92/TALK",
   "narrator": "つばめ",
   "text": "あ、そうじゃなくって。\n今日の戦闘のことを、\n頭の中で反省してたの。",
   "zh": "啊，不是那样。\n我在脑子里反省\n今天的战斗。",
   "narrator_zh": "燕"
  },
  {
   "location": "93/TALK",
   "narrator": "つばめ",
   "text": "顔に出ちゃってたかな？",
   "zh": "写在脸上了吗？",
   "narrator_zh": "燕"
  },
  {
   "location": "94/TALK",
   "narrator": "神楽",
   "text": "…元気がなさそうに\n見えたから、\n心配しました…。",
   "zh": "……看起来没精神，\n所以\n担心了……。",
   "narrator_zh": "神乐"
  },
  {
   "location": "95/TALK",
   "narrator": "つばめ",
   "text": "これも悪いところ\nなんだよね。",
   "zh": "这也是不好的地方\n呀。",
   "narrator_zh": "燕"
  },
  {
   "location": "96/TALK",
   "narrator": "つばめ",
   "text": "一人で色々考えて、\nウジウジしちゃう\nところ…。",
   "zh": "一个人想很多，\n就会磨磨蹭蹭\n的地方……。",
   "narrator_zh": "燕"
  },
  {
   "location": "97/TALK",
   "narrator": "神楽",
   "text": "…まあ、本当に体調が\n悪いわけではないなら、\nいいんですけど…。",
   "zh": "……嘛，只要不是\n真的身体不舒服，\n就好……。",
   "narrator_zh": "神乐"
  },
  {
   "location": "98/TALK",
   "narrator": "つばめ",
   "text": "えへへ…ありがと。\n卯月さんって、\n優しいんだね。",
   "zh": "诶嘿嘿……谢谢。\n卯月，\n人真好呀。",
   "narrator_zh": "燕"
  },
  {
   "location": "99/TALK",
   "narrator": "神楽",
   "text": "えっ！？",
   "zh": "诶！？",
   "narrator_zh": "神乐"
  },
  {
   "location": "100/TALK",
   "narrator": "つばめ",
   "text": "だって、会ったばかりの\nわたしのこと、とっても\n気にかけてくれてるし。",
   "zh": "因为，才刚见面的\n我，你也这么\n关心。",
   "narrator_zh": "燕"
  },
  {
   "location": "101/TALK",
   "narrator": "神楽",
   "text": "と、当然ですよ。\nだって、私達はー―",
   "zh": "这、这是当然。\n因为，我们是——",
   "narrator_zh": "神乐"
  },
  {
   "location": "102/TALK",
   "narrator": "神楽",
   "text": "…仲間、なんですから。",
   "zh": "……是同伴，所以。",
   "narrator_zh": "神乐"
  },
  {
   "location": "103/TALK",
   "narrator": "つばめ",
   "text": "えへへ…。",
   "zh": "诶嘿嘿……。",
   "narrator_zh": "燕"
  },
  {
   "location": "104/TALK",
   "narrator": "神楽",
   "text": "なんだか、この子と\n話してると、\n調子が狂っちゃう…。",
   "zh": "总觉得，和这孩子\n说话的时候，\n节奏会被打乱……。",
   "narrator_zh": "神乐"
  },
  {
   "location": "105/TALK",
   "narrator": "神楽",
   "text": "私が聞いてたのと、\n全然違うし。",
   "zh": "和我听说的，\n完全不一样。",
   "narrator_zh": "神乐"
  },
  {
   "location": "106/TALK",
   "narrator": "神楽",
   "text": "同姓同名の別人…、\nなんてことは、\n多分ないだろうけど…。",
   "zh": "同名同姓的另一个人……\n这种事，\n大概没有吧……。",
   "narrator_zh": "神乐"
  },
  {
   "location": "107/TALK",
   "narrator": "神楽",
   "text": "でも、もしかしたら…。",
   "zh": "可是，说不定……。",
   "narrator_zh": "神乐"
  },
  {
   "location": "108/TALK",
   "narrator": "神楽",
   "text": "…つばめさん。\nあなたは…。",
   "zh": "……燕。\n你是……。",
   "narrator_zh": "神乐"
  },
  {
   "location": "109/TALK",
   "narrator": "つばめ",
   "text": "え？",
   "zh": "诶？",
   "narrator_zh": "燕"
  },
  {
   "location": "110/TALK",
   "narrator": "神楽",
   "text": "あなたは、本当に…。",
   "zh": "你，真的是……。",
   "narrator_zh": "神乐"
  },
  {
   "location": "113/TALK",
   "narrator": "神楽",
   "text": "いえ、やっぱりなんでも\nありません。",
   "zh": "不，果然\n什么都没有。",
   "narrator_zh": "神乐"
  },
  {
   "location": "114/TALK",
   "narrator": "つばめ",
   "text": "あらら…気になるよぉ…。",
   "zh": "哎呀……好在意呀……。",
   "narrator_zh": "燕"
  },
  {
   "location": "115/TALK",
   "narrator": "神楽",
   "text": "ふふっ、ごめんなさい。",
   "zh": "呵呵，对不起。",
   "narrator_zh": "神乐"
  },
  {
   "location": "116/SEL",
   "narrator": "",
   "text": "なにを聞こうとしたの？",
   "zh": "你想问什么？",
   "narrator_zh": ""
  },
  {
   "location": "117/ACT",
   "narrator": "",
   "text": "なにを聞こうとしたの？",
   "zh": "你想问什么？",
   "narrator_zh": ""
  },
  {
   "location": "136/TALK",
   "narrator": "神楽",
   "text": "あなたは本当に逢瀬つばめさんですか？",
   "zh": "你真的是逢濑燕吗？",
   "narrator_zh": "神乐"
  },
  {
   "location": "137/TALK",
   "narrator": "神楽",
   "text": "なんて",
   "zh": "之类的",
   "narrator_zh": "神乐"
  },
  {
   "location": "138/TALK",
   "narrator": "神楽",
   "text": "冷静に考えるととてもできない質問を",
   "zh": "冷静想想是根本问不出口的问题",
   "narrator_zh": "神乐"
  },
  {
   "location": "140/SEL",
   "narrator": "",
   "text": "つばめが別人だと思ってるわけ？",
   "zh": "你觉得燕是另一个人？",
   "narrator_zh": ""
  },
  {
   "location": "141/SEL",
   "narrator": "",
   "text": "さすがに直球過ぎるだろ",
   "zh": "这也太直白了吧",
   "narrator_zh": ""
  },
  {
   "location": "142/ACT",
   "narrator": "",
   "text": "つばめが別人だと思ってるわけ？",
   "zh": "你觉得燕是另一个人？",
   "narrator_zh": ""
  },
  {
   "location": "143/TALK",
   "narrator": "神楽",
   "text": "だって",
   "zh": "因为",
   "narrator_zh": "神乐"
  },
  {
   "location": "144/TALK",
   "narrator": "神楽",
   "text": "聞いてたのと全然違うし",
   "zh": "和听说的完全不一样",
   "narrator_zh": "神乐"
  },
  {
   "location": "145/TALK",
   "narrator": "神楽",
   "text": "は？",
   "zh": "哈？",
   "narrator_zh": "神乐"
  },
  {
   "location": "146/TALK",
   "narrator": "神楽",
   "text": "って思うことの連続で",
   "zh": "这种念头一个接一个",
   "narrator_zh": "神乐"
  },
  {
   "location": "147/ACT",
