{
    "dir": "chap02/battle/btev_ch02_02_01.js",
    "type": "Other",
    "info": {
        "story_id": "60211",
        "cid": "ayami",
        "title": "己の敵は己＜葛藤＞",
        "sub_title": "バトル中盤",
        "title_zh": "自己的敌人就是自己＜纠葛＞",
        "sub_title_zh": "战斗中段"
    },
    "entry": [
        {
            "location": "280/SCENARIO",
            "narrator": "",
            "text": "バトル中盤",
            "zh": "战斗中段",
            "narrator_zh": ""
        },
        {
            "location": "289/TALK",
            "narrator": "潜在アーヤ",
            "text": "…なかなかやるわね。",
            "zh": "……挺有两下子的嘛。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "290/TALK",
            "narrator": "表層アーヤ",
            "text": "それくらい\n意志が硬いってことよ。",
            "zh": "这就说明我的意志\n就是这么坚定。",
            "narrator_zh": "表层绫水"
        },
        {
            "location": "291/TALK",
            "narrator": "潜在アーヤ",
            "text": "もっと他のメンバーを\n信用して、任せても\nいいと思うんだけど。",
            "zh": "我觉得你多信任一下\n其他成员，交给她们\n也没什么不好嘛。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "292/TALK",
            "narrator": "表層アーヤ",
            "text": "そういう\n問題じゃない！",
            "zh": "不是\n那种问题！",
            "narrator_zh": "表层绫水"
        },
        {
            "location": "293/TALK",
            "narrator": "表層アーヤ",
            "text": "リーダーである私が\n行かなかったら……",
            "zh": "身为队长的我\n要是不去的话……",
            "narrator_zh": "表层绫水"
        },
        {
            "location": "294/TALK",
            "narrator": "潜在アーヤ",
            "text": "行かなかったら？",
            "zh": "不去的话会怎样？",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "295/TALK",
            "narrator": "表層アーヤ",
            "text": "リーダーとしての\n責任感が欠如してると\n思われかねない。",
            "zh": "可能会被人觉得\n我缺乏身为队长的\n责任感。",
            "narrator_zh": "表层绫水"
        },
        {
            "location": "296/TALK",
            "narrator": "潜在アーヤ",
            "text": "まあそうかもね。\nでも……",
            "zh": "嘛，也许吧。\n不过……",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "297/TALK",
            "narrator": "潜在アーヤ",
            "text": "今の貴方の言葉の中に\n本音がしっかり\nダダ漏れていたわよ。",
            "zh": "刚才你那番话里，\n把真心话清清楚楚地\n漏出来了哦。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "298/TALK",
            "narrator": "表層アーヤ",
            "text": "え！？",
            "zh": "诶！？",
            "narrator_zh": "表层绫水"
        },
        {
            "location": "299/TALK",
            "narrator": "潜在アーヤ",
            "text": "ううん、でもいいの。\nそれは私の守備範囲\nじゃないから。",
            "zh": "没事，没关系。\n反正那也不在我的\n负责范围内。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "300/TALK",
            "narrator": "潜在アーヤ",
            "text": "それより、\n次は絶対に負けない。",
            "zh": "比起这个，\n下次绝对不会输。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "301/TALK",
            "narrator": "潜在アーヤ",
            "text": "とっておきの\n[クラン]を\n用意してあるし。",
            "zh": "我可是还准备了\n压箱底的\n[库兰]呢。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "303/TALK",
            "narrator": "潜在アーヤ",
            "text": "絶対に勝って\n$handle$さんと\nデートするんだから。",
            "zh": "我绝对要赢下来，\n然后和$handle$\n去约会。",
            "narrator_zh": "潜在绫水"
        },
        {
            "location": "304/TALK",
            "narrator": "表層アーヤ",
            "text": "させないわよ！",
            "zh": "休想得逞！",
            "narrator_zh": "表层绫水"
        }
    ]
}
