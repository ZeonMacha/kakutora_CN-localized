    "entry": [
        {
            "location": "496/SCENARIO",
            "narrator": "",
            "text": "三日月と猫の爪",
            "zh": "新月与猫爪",
            "narrator_zh": ""
        },
        {
            "location": "498/TALK",
            "narrator": "アーヤ",
            "text": "どっちに見える？",
            "zh": "你觉得我像哪一派？",
            "narrator_zh": "绫水"
        },
        {
            "location": "499/TALK",
            "narrator": "アーヤ",
            "text": "実は",
            "zh": "其实",
            "narrator_zh": "绫水"
        },
        {
            "location": "500/TALK",
            "narrator": "アーヤ",
            "text": "ネコ派",
            "zh": "是猫派",
            "narrator_zh": "绫水"
        },
        {
            "location": "501/TALK",
            "narrator": "アーヤ",
            "text": "トライナリーでも猫派が絶対的多数だったわ",
            "zh": "在三重奏里也是猫派占绝对多数哦",
            "narrator_zh": "绫水"
        },
        {
            "location": "503/SEL",
            "narrator": "",
            "text": "猫かわいいしね",
            "zh": "毕竟猫很可爱嘛",
            "narrator_zh": ""
        },
        {
            "location": "504/SEL",
            "narrator": "",
            "text": "犬の方が好きだけど",
            "zh": "不过我更喜欢狗",
            "narrator_zh": ""
        },
        {
            "location": "505/SEL",
            "narrator": "",
            "text": "動物はあんまり……",
            "zh": "动物的话不太……",
            "narrator_zh": ""
        },
        {
            "location": "506/SEL",
            "narrator": "",
            "text": "$me$はアーヤ派",
            "zh": "$me$是绫水派",
            "narrator_zh": ""
        },
        {
            "location": "507/ACT",
            "narrator": "",
            "text": "猫かわいいしね",
            "zh": "毕竟猫很可爱嘛",
            "narrator_zh": ""
        },
        {
            "location": "508/TALK",
            "narrator": "アーヤ",
            "text": "かわいいわ",
            "zh": "很可爱吧",
            "narrator_zh": "绫水"
        },
        {
            "location": "509/TALK",
            "narrator": "アーヤ",
            "text": "それは否定しない",
            "zh": "这点我不否认",
            "narrator_zh": "绫水"
        },
        {
            "location": "510/ACT",
            "narrator": "",
            "text": "犬の方が好きだけど",
            "zh": "不过我更喜欢狗",
            "narrator_zh": ""
        },
        {
            "location": "511/TALK",
            "narrator": "アーヤ",
            "text": "犬もいいわよね",
            "zh": "狗也很不错呢",
            "narrator_zh": "绫水"
        },
        {
            "location": "512/ACT",
            "narrator": "",
            "text": "動物はあんまり……",
            "zh": "动物的话不太……",
            "narrator_zh": ""
        },
        {
            "location": "513/TALK",
            "narrator": "アーヤ",
            "text": "あら",
            "zh": "哎呀",
            "narrator_zh": "绫水"
        },
        {
            "location": "514/TALK",
            "narrator": "アーヤ",
            "text": "そうだったの",
            "zh": "这样啊",
            "narrator_zh": "绫水"
        },
        {
            "location": "515/ACT",
            "narrator": "",
            "text": "$me$はアーヤ派",
            "zh": "$me$是绫水派",
            "narrator_zh": ""
        },
        {
            "location": "516/TALK",
            "narrator": "アーヤ",
            "text": "それを言うなら",
            "zh": "要这么说的话",
            "narrator_zh": "绫水"
        },
        {
            "location": "517/TALK",
            "narrator": "アーヤ",
            "text": "私は$handle$さん派",
            "zh": "我才是$handle$派",
            "narrator_zh": "绫水"
        },
        {
            "location": "518/TALK",
            "narrator": "アーヤ",
            "text": "って",
            "zh": "哎呀",
            "narrator_zh": "绫水"
        },
        {
            "location": "519/TALK",
            "narrator": "アーヤ",
            "text": "ちょっと恥ずかしい、、、",
            "zh": "突然有点害羞……",
            "narrator_zh": "绫水"
        },
        {
            "location": "521/TALK",
            "narrator": "アーヤ",
            "text": "うちにね",
            "zh": "我们那儿啊",
            "narrator_zh": "绫水"
        },
        {
            "location": "522/TALK",
            "narrator": "アーヤ",
            "text": "猫の親子がやってくるのよ",
            "zh": "经常有猫妈妈带着小猫过来哦",
            "narrator_zh": "绫水"
        },
        {
            "location": "523/TALK",
            "narrator": "アーヤ",
            "text": "みんな猫がかわいいって大騒ぎ",
            "zh": "大家都嚷着猫咪好可爱、闹个不停",
            "narrator_zh": "绫水"
        },
        {
            "location": "525/SEL",
            "narrator": "",
            "text": "そのうち飽きると思うけど",
            "zh": "不过过阵子应该就会腻了吧",
            "narrator_zh": ""
        },
        {
            "location": "526/SEL",
            "narrator": "",
            "text": "あんまり興味ないなー",
            "zh": "不太感兴趣呢——",
            "narrator_zh": ""
        },
        {
            "location": "527/SEL",
            "narrator": "",
            "text": "猫和むよね",
            "zh": "猫咪很治愈呢",
            "narrator_zh": ""
        },
        {
            "location": "528/ACT",
            "narrator": "",
            "text": "そのうち飽きると思うけど",
            "zh": "不过过阵子应该就会腻了吧",
            "narrator_zh": ""
        },
        {
            "location": "529/TALK",
            "narrator": "アーヤ",
            "text": "そうかもね",
            "zh": "说不定呢",
            "narrator_zh": "绫水"
        },
        {
            "location": "530/ACT",
            "narrator": "",
            "text": "あんまり興味ないなー",
            "zh": "不太感兴趣呢——",
            "narrator_zh": ""
        },
        {
            "location": "531/TALK",
            "narrator": "アーヤ",
            "text": "そうなのね",
            "zh": "这样啊",
            "narrator_zh": "绫水"
        },
        {
            "location": "532/ACT",
            "narrator": "",
            "text": "猫和むよね",
            "zh": "猫咪很治愈呢",
            "narrator_zh": ""
        },
        {
            "location": "533/TALK",
            "narrator": "アーヤ",
            "text": "そうなのよ",
            "zh": "就是呀",
            "narrator_zh": "绫水"
        },
        {
            "location": "534/TALK",
            "narrator": "アーヤ",
            "text": "あのかわいさ",
            "zh": "那副可爱的模样",
            "narrator_zh": "绫水"
        },
        {
            "location": "535/TALK",
            "narrator": "アーヤ",
            "text": "反則だわ",
            "zh": "简直犯规",
            "narrator_zh": "绫水"
        },
        {
            "location": "536/TALK",
            "narrator": "アーヤ",
            "text": "抱っことかしたいけど",
            "zh": "虽然很想抱抱它们",
            "narrator_zh": "绫水"
        },
        {
            "location": "537/TALK",
            "narrator": "アーヤ",
            "text": "させてくれないのよ(-ω-;)",
            "zh": "可它们根本不让抱呀(-ω-;)",
            "narrator_zh": "绫水"
        },
        {
            "location": "538/TALK",
            "narrator": "アーヤ",
            "text": "でもそういうところも",
            "zh": "不过就连这点",
            "narrator_zh": "绫水"
        },
        {
            "location": "539/TALK",
            "narrator": "アーヤ",
            "text": "猫らしくていい",
            "zh": "也很有猫的风格，挺好的",
            "narrator_zh": "绫水"
        },
        {
            "location": "541/TALK",
            "narrator": "アーヤ",
            "text": "そのうち親離れすると思うけど",
            "zh": "等过阵子小猫应该就会独立了",
            "narrator_zh": "绫水"
        },
        {
            "location": "542/TALK",
            "narrator": "アーヤ",
            "text": "そうしたら親猫だけ来るようになるのかしら",
            "zh": "到时候是不是就只有猫妈妈过来了",
            "narrator_zh": "绫水"
        },
        {
            "location": "543/TALK",
            "narrator": "アーヤ",
            "text": "そうなったら少し",
            "zh": "真到那时大概多少",
            "narrator_zh": "绫水"
        },
        {
            "location": "544/TALK",
            "narrator": "アーヤ",
            "text": "さみしいわ",
            "zh": "会有点寂寞哦",
            "narrator_zh": "绫水"
        },
        {
            "location": "545/TALK",
            "narrator": "アーヤ",
            "text": "仕方ないけど",
            "zh": "虽然也没办法就是了",
            "narrator_zh": "绫水"
        }
    ]
}
