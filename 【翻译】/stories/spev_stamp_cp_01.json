{
    "dir": "chap00/daydra/spev_stamp_cp_01.js",
    "type": "",
    "info": {
        "story_id": "91006",
        "cid": "",
        "title": "【期間限定】トライナリースタンプ配信記念",
        "sub_title": "トライナリースタンプ配信記念",
        "title_zh": "【限时】三重奏贴纸配信纪念",
        "sub_title_zh": "三重奏贴纸配信纪念"
    },
    "entry": [
        {
            "location": "19/TALK",
            "narrator": "みやび",
            "text": "ん～…。",
            "zh": "唔～……。",
            "narrator_zh": "雅"
        },
        {
            "location": "20/TALK",
            "narrator": "みやび",
            "text": "…まだか？\nそろそろやと思うたん\nやけんど…。",
            "zh": "……还没到咩？\n我寻思着也差不多\n该到了啵……。",
            "narrator_zh": "雅"
        },
        {
            "location": "24/TALK",
            "narrator": "つばめ",
            "text": "あ、いたいた。\n探しましたよ。",
            "zh": "啊，在这里呀。\n找了你好久呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "26/TALK",
            "narrator": "つばめ",
            "text": "休憩時間、もうとっくに\n終わっちゃってますよ？",
            "zh": "休息时间，早就\n已经结束了哦？",
            "narrator_zh": "燕"
        },
        {
            "location": "30/TALK",
            "narrator": "みやび",
            "text": "知っちゅうがよ。",
            "zh": "我晓得咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "31/TALK",
            "narrator": "つばめ",
            "text": "…ゲームですか？",
            "zh": "……在打游戏吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "32/TALK",
            "narrator": "みやび",
            "text": "いんや、お届け物を\n待っちゅうがよ。",
            "zh": "才不是，是在等\n送来的东西咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "33/TALK",
            "narrator": "つばめ",
            "text": "お届け物、ですか？",
            "zh": "送来的东西、吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "34/TALK",
            "narrator": "みやび",
            "text": "ロマンチックな言い方を\nすると――",
            "zh": "要是用浪漫点的说法\n来讲呢——",
            "narrator_zh": "雅"
        },
        {
            "location": "35/TALK",
            "narrator": "みやび",
            "text": "時空の果ての要人殿からの\nプレゼント、やね。",
            "zh": "就是来自时空尽头要人阁下的\n一份礼物、咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "38/TALK",
            "narrator": "つばめ",
            "text": "ジクーノハテ…？\n外国ですか？",
            "zh": "“时空尽头”……？\n是外国吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "39/TALK",
            "narrator": "みやび",
            "text": "ある意味正解。",
            "zh": "某种意义上算答对了。",
            "narrator_zh": "雅"
        },
        {
            "location": "47/TALK",
            "narrator": "みやび",
            "text": "よっしゃ、来たぞね♪",
            "zh": "好嘞，来咧♪",
            "narrator_zh": "雅"
        },
        {
            "location": "50/TALK",
            "narrator": "つばめ",
            "text": "あの…いったいなにが\n届いたんですか？",
            "zh": "那个……究竟是什么\n送过来了呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "51/TALK",
            "narrator": "みやび",
            "text": "ふふん、つばめちゃんにも\n送っちゃろうかね。",
            "zh": "哼哼，也发一份\n给燕看看啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "57/TALK",
            "narrator": "みやび",
            "text": "ほい、送信完了。\n見てみぃ。",
            "zh": "喏，发送完毕。\n快看看啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "59/TALK",
            "narrator": "つばめ",
            "text": "は、はあ…。",
            "zh": "是、是吗……。",
            "narrator_zh": "燕"
        },
        {
            "location": "73/TALK",
            "narrator": "つばめ",
            "text": "ぇっ！？(ﾟ△ﾟ;ﾉ)ﾉ",
            "zh": "诶！？(ﾟ△ﾟ;ﾉ)ﾉ",
            "narrator_zh": "燕"
        },
        {
            "location": "77/TALK",
            "narrator": "つばめ",
            "text": "すごぃ",
            "zh": "好厉害",
            "narrator_zh": "燕"
        },
        {
            "location": "78/TALK",
            "narrator": "つばめ",
            "text": "これ",
            "zh": "这个",
            "narrator_zh": "燕"
        },
        {
            "location": "79/TALK",
            "narrator": "つばめ",
            "text": "わたし達のスタンプ(*≧∀≦*) ",
            "zh": "是我们的贴纸呀(*≧∀≦*)",
            "narrator_zh": "燕"
        },
        {
            "location": "81/TALK",
            "narrator": "みやび",
            "text": "その通り",
            "zh": "正是如此",
            "narrator_zh": "雅"
        },
        {
            "location": "82/TALK",
            "narrator": "みやび",
            "text": "これが待っていたお届け物",
            "zh": "这就是一直在等的那份礼物",
            "narrator_zh": "雅"
        },
        {
            "location": "84/TALK",
            "narrator": "つばめ",
            "text": "神楽ちゃん！",
            "zh": "神乐！",
            "narrator_zh": "燕"
        },
        {
            "location": "85/TALK",
            "narrator": "つばめ",
            "text": "これもかわぃぃ(*´ω｀*)",
            "zh": "这张也好可爱呀(*´ω｀*)",
            "narrator_zh": "燕"
        },
        {
            "location": "87/TALK",
            "narrator": "みやび",
            "text": "ふむふむ",
            "zh": "嗯嗯",
            "narrator_zh": "雅"
        },
        {
            "location": "88/TALK",
            "narrator": "みやび",
            "text": "使い勝手良好なり",
            "zh": "用起来甚是顺手",
            "narrator_zh": "雅"
        },
        {
            "location": "89/TALK",
            "narrator": "みやび",
            "text": "皆に布教するとしよう",
            "zh": "这就拿去向大伙传教一番",
            "narrator_zh": "雅"
        },
        {
            "location": "110/TALK",
            "narrator": "神楽",
            "text": "――と、いうわけで、\n明け方に仮眠を取ろうと\n思っていたら…。",
            "zh": "——总、总而言之，\n我本打算天快亮时\n小睡一会的……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "111/TALK",
            "narrator": "神楽",
            "text": "熟睡してしまって、\n遅れてしまったんです。",
            "zh": "结果一下睡太沉了，\n这才迟到了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "112/TALK",
            "narrator": "ガブリエラ",
            "text": "…真夜中につぶやきが\nあったから、まさかとは\n思ってたけど…。",
            "zh": "……半夜三更看你在发推文，\n我就大概猜到\n不太妙了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "114/TALK",
            "narrator": "ガブリエラ",
            "text": "徹夜で絵を描いてたとは\n思わなかったわ。",
            "zh": "没想到你居然\n通宵在画画啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "116/TALK",
            "narrator": "神楽",
            "text": "深夜から明け方の時間が\n一番筆が進むんですよね。",
            "zh": "从深夜到天亮这段时间\n画起来最顺手嘛。",
            "narrator_zh": "神乐"
        },
        {
            "location": "117/TALK",
            "narrator": "アーヤ",
            "text": "だからって、待ち合わせに\n遅れていい理由には\nならないのよ？",
            "zh": "就算那样，也不代表\n就能成为约好见面\n却迟到的理由哦？",
            "narrator_zh": "绫水"
        },
        {
            "location": "119/TALK",
            "narrator": "神楽",
            "text": "わかっていますよ。\nそこはちゃんと\n反省してますから。",
            "zh": "我知道啦。\n这一点我也有\n好好反省的。",
            "narrator_zh": "神乐"
        },
        {
            "location": "121/TALK",
            "narrator": "神楽",
            "text": "ですけど…、\n創作活動を\n頑張った後には――",
            "zh": "不过……、\n在努力进行完\n创作活动之后——",
            "narrator_zh": "神乐"
        },
        {
            "location": "122/TALK",
            "narrator": "神楽",
            "text": "身体が求める限りの\n休息を与えなければ\nならないんですっ！！",
            "zh": "就必须给予身体\n它所渴求的\n最大限度休息！！",
            "narrator_zh": "神乐"
        },
        {
            "location": "123/TALK",
            "narrator": "ガブリエラ",
            "text": "だから、それ理由に\nなってないから…。",
            "zh": "都说了，那根本\n算不上理由吧……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "130/TALK",
            "narrator": "神楽",
            "text": "……っと。\nみやびさんからですね。",
            "zh": "……哎呀。\n是雅发来的消息呢。",
            "narrator_zh": "神乐"
        },
        {
            "location": "143/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしにも来た…。\nつばめもいるみたいよ？",
            "zh": "我这边也收到了……。\n好像燕也在里面哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "149/TALK",
            "narrator": "アーヤ",
            "text": "どうしたのかしら？\nまさか、緊急事態？",
            "zh": "怎么回事呀？\n难道说，出什么紧急状况了？",
            "narrator_zh": "绫水"
        },
        {
            "location": "151/TALK",
            "narrator": "みやび",
            "text": "あ～アアァア～！",
            "zh": "啊～啊啊啊～！",
            "narrator_zh": "雅"
        },
        {
            "location": "154/TALK",
            "narrator": "アーヤ",
            "text": "は！？",
            "zh": "哈！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "157/TALK",
            "narrator": "みやび",
            "text": "都会のターザン",
            "zh": "都市的泰山",
            "narrator_zh": "雅"
        },
        {
            "location": "158/TALK",
            "narrator": "みやび",
            "text": "アーヤ・ザ・ワイルド",
            "zh": "绫水·The·Wild",
            "narrator_zh": "雅"
        },
        {
            "location": "159/TALK",
            "narrator": "みやび",
            "text": "参上！",
            "zh": "参上！",
            "narrator_zh": "雅"
        },
        {
            "location": "160/TALK",
            "narrator": "神楽",
            "text": "ちょｗｗｗｗｗｗｗｗｗ",
            "zh": "喂哈哈哈哈哈哈哈哈哈",
            "narrator_zh": "神乐"
        },
        {
            "location": "162/TALK",
            "narrator": "アーヤ",
            "text": "ちょっとなにこれ！？",
            "zh": "等下这是什么啊！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "163/TALK",
            "narrator": "アーヤ",
            "text": "私でしょこれ！？(>_<)",
            "zh": "这画的是我吧！？(>_<)",
            "narrator_zh": "绫水"
        },
        {
            "location": "164/TALK",
            "narrator": "システム",
            "text": "恋ヶ崎みやび さんからスタンプが届きました",
            "zh": "收到来自 恋之崎雅 的贴纸",
            "narrator_zh": "系统"
        },
        {
            "location": "165/TALK",
            "narrator": "神楽",
            "text": "ありがとうございます♪",
            "zh": "谢谢啦♪",
            "narrator_zh": "神乐"
        },
        {
            "location": "168/TALK",
            "narrator": "ガブリエラ",
            "text": "勝手に私たちのスタンプ作ったの？",
            "zh": "擅自把我们做成了贴纸吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "170/TALK",
            "narrator": "つばめ",
            "text": "そぅみたぃ(･Д･｀)",
            "zh": "好像是这样呀(･Д･｀)",
            "narrator_zh": "燕"
        },
        {
            "location": "171/TALK",
            "narrator": "つばめ",
            "text": "みやびさんのぉ友達が",
            "zh": "似乎是雅的朋友做的",
            "narrator_zh": "燕"
        },
        {
            "location": "172/TALK",
            "narrator": "ガブリエラ",
            "text": "そんなお友達がいたのね",
            "zh": "她还有这种朋友啊",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "178/TALK",
            "narrator": "神楽",
            "text": "えーっ！なにこれ！！！！",
            "zh": "诶——！这是什么呀！！！！",
            "narrator_zh": "神乐"
        },
        {
            "location": "179/TALK",
            "narrator": "神楽",
            "text": "超かわいいんですけど！！",
            "zh": "也太可爱了吧！！",
            "narrator_zh": "神乐"
        },
        {
            "location": "181/TALK",
            "narrator": "神楽",
            "text": "ヤバみＭＡＸですっ！！",
            "zh": "太犯规MAX了！！",
            "narrator_zh": "神乐"
        },
        {
            "location": "184/TALK",
            "narrator": "つばめ",
            "text": "スタンプだけど",
            "zh": "虽说是贴纸",
            "narrator_zh": "燕"
        },
        {
            "location": "185/TALK",
            "narrator": "つばめ",
            "text": "ちょっと恥ずかしぃかも(/ω＼)",
            "zh": "感觉有点不好意思呀(/ω＼)",
            "narrator_zh": "燕"
        },
        {
            "location": "188/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょっとつばめ！",
            "zh": "等下，燕！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "190/TALK",
            "narrator": "ガブリエラ",
            "text": "私のスタンプ使わないでちょうだい",
            "zh": "别拿我的贴纸来用好不好",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "191/TALK",
            "narrator": "ガブリエラ",
            "text": "私が照れてるみたいじゃないの！！////////////",
            "zh": "那不显得好像我在害羞一样嘛！！////////////",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "193/TALK",
            "narrator": "みやび",
            "text": "ガブちゃんスタンプは",
            "zh": "加布的贴纸",
            "narrator_zh": "雅"
        },
        {
            "location": "194/TALK",
            "narrator": "みやび",
            "text": "甘えたり",
            "zh": "用来撒娇",
            "narrator_zh": "雅"
        },
        {
            "location": "195/TALK",
            "narrator": "みやび",
            "text": "ツンデレするときに便利",
            "zh": "或者傲娇的时候可方便了",
            "narrator_zh": "雅"
        },
        {
            "location": "196/TALK",
            "narrator": "みやび",
            "text": "むしろそれ用",
            "zh": "不如说就是专用贴纸",
            "narrator_zh": "雅"
        },
        {
            "location": "197/TALK",
            "narrator": "ガブリエラ",
            "text": "なにそれ！？",
            "zh": "那算什么啊！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "198/TALK",
            "narrator": "みやび",
            "text": "忠実に再現された本人クオリティー",
            "zh": "忠实还原出的本人水准",
            "narrator_zh": "雅"
        },
        {
            "location": "199/TALK",
            "narrator": "ガブリエラ",
            "text": "何度も言ってるけど",
            "zh": "我都说过很多遍了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "200/TALK",
            "narrator": "ガブリエラ",
            "text": "私はツンデレじゃないわ",
            "zh": "我才不是什么傲娇",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "202/TALK",
            "narrator": "みやび",
            "text": "なにっ！？",
            "zh": "什么！？",
            "narrator_zh": "雅"
        },
        {
            "location": "204/TALK",
            "narrator": "みやび",
            "text": "ガブちゃんがツンデレか否か",
            "zh": "加布究竟是不是傲娇",
            "narrator_zh": "雅"
        },
        {
            "location": "205/TALK",
            "narrator": "みやび",
            "text": "それを決める会合が今始まる",
            "zh": "决定此事的会议现在开始",
            "narrator_zh": "雅"
        },
        {
            "location": "206/TALK",
            "narrator": "ガブリエラ",
            "text": "はじまらないから！",
            "zh": "才不会开始呢！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "208/TALK",
            "narrator": "つばめ",
            "text": "二人とも(´ｪ｀；)三(；´ｪ｀)",
            "zh": "你们两个(´ｪ｀；)三(；´ｪ｀)",
            "narrator_zh": "燕"
        },
        {
            "location": "209/TALK",
            "narrator": "つばめ",
            "text": "ケンカしなぃで",
            "zh": "不要吵架呀",
            "narrator_zh": "燕"
        },
        {
            "location": "212/TALK",
            "narrator": "神楽",
            "text": "その通りです！！",
            "zh": "正是如此！！",
            "narrator_zh": "神乐"
        },
        {
            "location": "216/TALK",
            "narrator": "アーヤ",
            "text": "スタンプのせいで（；￢＿￢）",
            "zh": "都怪这些贴纸（；￢＿￢）",
            "narrator_zh": "绫水"
        },
        {
            "location": "218/TALK",
            "narrator": "アーヤ",
            "text": "誰が喋ってるか",
            "zh": "搞得谁在说话",
            "narrator_zh": "绫水"
        },
        {
            "location": "219/TALK",
            "narrator": "アーヤ",
            "text": "混乱するわ(-ω-;)",
            "zh": "都快分不清了(-ω-;)",
            "narrator_zh": "绫水"
        },
        {
            "location": "222/TALK",
            "narrator": "みやび",
            "text": "みんな",
            "zh": "大家",
            "narrator_zh": "雅"
        },
        {
            "location": "223/TALK",
            "narrator": "みやび",
            "text": "もう使いこなしている",
            "zh": "已经用得这么得心应手了",
            "narrator_zh": "雅"
        },
        {
            "location": "224/TALK",
            "narrator": "みやび",
            "text": "さすがは現代っ子",
            "zh": "不愧是当代少女",
            "narrator_zh": "雅"
        },
        {
            "location": "226/TALK",
            "narrator": "つばめ",
            "text": "みやびさんの使った",
            "zh": "雅刚才用的",
            "narrator_zh": "燕"
        },
        {
            "location": "227/TALK",
            "narrator": "つばめ",
            "text": "そのシリーズも",
