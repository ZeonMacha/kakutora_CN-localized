{
    "dir": "chap17/daydra/dd_ch04_17_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "17456",
        "cid": "miyabi",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "おサボり旅行",
        "title_zh": "Extra006 额外剧情",
        "sub_title_zh": "逃学旅行"
    },
    "entry": [
        {
            "location": "193/SCENARIO",
            "narrator": "",
            "text": "おサボり旅行",
            "zh": "逃学旅行",
            "narrator_zh": ""
        },
        {
            "location": "204/TALK",
            "narrator": "みやび",
            "text": "ここが高崎駅なが？\n意外と大きいんやね。",
            "zh": "这里就是高崎站咯？\n没想到还挺大的咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "206/TALK",
            "narrator": "雛",
            "text": "そりゃそうですよ。\n新幹線も止まる駅です\nからねー。",
            "zh": "那当然了。\n这里可是新干线\n都会停靠的站呀。",
            "narrator_zh": "雏"
        },
        {
            "location": "208/TALK",
            "narrator": "みやび",
            "text": "ふむ、なるほど…。",
            "zh": "唔，原来如此……",
            "narrator_zh": "雅"
        },
        {
            "location": "210/TALK",
            "narrator": "みやび",
            "text": "…なのに、うちらは\nわざわざ鈍行でここまで\n来たんやね？",
            "zh": "…可我们偏偏\n特意坐慢车跑到\n这种地方来咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "211/TALK",
            "narrator": "雛",
            "text": "言い出したのは\nみやび先輩じゃ\nないですか。",
            "zh": "先说出口的\n不就是雅\n前辈吗。",
            "narrator_zh": "雏"
        },
        {
            "location": "212/TALK",
            "narrator": "雛",
            "text": "学校行くとき、\n電車の中で言ったこと\n覚えてますか？",
            "zh": "上学路上，\n在电车里面说的话\n还记得吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "215/TALK",
            "narrator": "みやび",
            "text": "ん～？　確か…。",
            "zh": "嗯～？　好像是……",
            "narrator_zh": "雅"
        },
        {
            "location": "230/TALK",
            "narrator": "みやび",
            "text": "…なあ、ひなこちゃん。",
            "zh": "…我说，小雏。",
            "narrator_zh": "雅"
        },
        {
            "location": "231/TALK",
            "narrator": "みやび",
            "text": "登校途中に思い立って、\nぶらり電車の旅とか\nするん――",
            "zh": "上学路上突然起意，\n来一场说走就走的\n电车之旅——",
            "narrator_zh": "雅"
        },
        {
            "location": "232/TALK",
            "narrator": "みやび",
            "text": "青春っぽくてえいと\n思わん？",
            "zh": "很有青春的味道，\n不是挺好的咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "234/TALK",
            "narrator": "雛",
            "text": "何ですかその超が付く\n素敵な提案！？",
            "zh": "那是什么带「超」字的\n完美提议！？",
            "narrator_zh": "雏"
        },
        {
            "location": "235/TALK",
            "narrator": "雛",
            "text": "もしかして、あたしに\n学校サボろうっていう\nお誘いですか？",
            "zh": "该不会，是想\n约我一起逃学\n吧？",
            "narrator_zh": "雏"
        },
        {
            "location": "236/TALK",
            "narrator": "みやび",
            "text": "ひなこちゃんを\n不良の道へ進ませるような\nことはできんよ。",
            "zh": "把小雏你往\n不良少女那条路上带，\n这种事我做不出来咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "238/TALK",
            "narrator": "みやび",
            "text": "ただ、うちがしてみたい\n思うて聞いちゅうんよ。",
            "zh": "只是我自己想试试，\n才这么问你的咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "239/TALK",
            "narrator": "雛",
            "text": "そうですか…。",
            "zh": "这样啊……",
            "narrator_zh": "雏"
        },
        {
            "location": "240/TALK",
            "narrator": "雛",
            "text": "ぶらり電車旅というのは、\n新幹線もありですか？",
            "zh": "说走就走的电车之旅，\n也能坐新干线吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "242/TALK",
            "narrator": "みやび",
            "text": "鈍行一択やね。\n新幹線やとぶらり感が\n無くてつまらんし。",
            "zh": "当然是慢车咯。\n坐新干线就没得\n那份闲适感，无聊。",
            "narrator_zh": "雅"
        },
        {
            "location": "243/TALK",
            "narrator": "みやび",
            "text": "ひなこちゃんやったら、\nどこへ行こう思う？",
            "zh": "要是小雏你的话，\n想去哪里咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "245/TALK",
            "narrator": "雛",
            "text": "…そうですね。",
            "zh": "…让我想想。",
            "narrator_zh": "雏"
        },
        {
            "location": "246/TALK",
            "narrator": "雛",
            "text": "新宿から湘南新宿ライン、\nもしくは上野から高崎線に\n乗って――",
            "zh": "从新宿坐湘南新宿线，\n或者从上野坐高崎线\n——",
            "narrator_zh": "雏"
        },
        {
            "location": "248/TALK",
            "narrator": "雛",
            "text": "高崎までのんびりと\n電車旅行を楽しむと\n思います。",
            "zh": "然后慢悠悠地享受\n一路坐到高崎的\n电车之旅。",
            "narrator_zh": "雏"
        },
        {
            "location": "250/TALK",
            "narrator": "みやび",
            "text": "高崎…群馬やったっけ？",
            "zh": "高崎……是在群马来着？",
            "narrator_zh": "雅"
        },
        {
            "location": "251/TALK",
            "narrator": "雛",
            "text": "はい。\n約二時間、鈍行に揺られる\n旅になりますね。",
            "zh": "是的。\n会是被慢车摇晃\n约两小时的旅程呢。",
            "narrator_zh": "雏"
        },
        {
            "location": "253/TALK",
            "narrator": "みやび",
            "text": "…なるほど。",
            "zh": "…原来如此。",
            "narrator_zh": "雅"
        },
        {
            "location": "267/TALK",
            "narrator": "雛",
            "text": "…って、話から始まって、\n本当に来ることになったん\nですから。",
            "zh": "…就是从那番对话\n开始，最后真的\n跑来了这里。",
            "narrator_zh": "雏"
        },
        {
            "location": "269/TALK",
            "narrator": "みやび",
            "text": "…そうやったね。\nそんなこと言った記憶、\nうっすらとあるんよ。",
            "zh": "…是那么说过咯。\n说过那种话的记忆，\n隐隐约约还有咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "271/TALK",
            "narrator": "みやび",
            "text": "…けんど、思い付きで\n鈍行旅行なんて――",
            "zh": "…但是，一时兴起\n坐慢车旅行什么的——",
            "narrator_zh": "雅"
        },
        {
            "location": "273/TALK",
            "narrator": "みやび",
            "text": "自分でやっておきながら、\n今更ビックリちや。",
            "zh": "自己干出来了，\n现在才吓一跳滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "275/TALK",
            "narrator": "雛",
            "text": "あたしも、まさかそれに\n付き合ってる自分に\n驚いてます。",
            "zh": "我也是，没想到\n自己居然陪着\n来了，很吃惊。",
            "narrator_zh": "雏"
        },
        {
            "location": "276/TALK",
            "narrator": "雛",
            "text": "う～ん…これから\nどうしようかなぁ？",
            "zh": "嗯～……接下来\n要怎么办才好呢？",
            "narrator_zh": "雏"
        },
        {
            "location": "277/TALK",
            "narrator": "雛",
            "text": "高崎駅から出てる\n電車だと、えっと…。",
            "zh": "从高崎站发车的\n电车的话，那个……。",
            "narrator_zh": "雏"
        },
        {
            "location": "278/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "290/TALK",
            "narrator": "みやび",
            "text": "高崎なう！",
            "zh": "我现在人在高崎！",
            "narrator_zh": "雅"
        },
        {
            "location": "292/SEL",
            "narrator": "",
            "text": "そうみたいだね",
            "zh": "看起来是这样",
            "narrator_zh": ""
        },
        {
            "location": "293/ACT",
            "narrator": "",
            "text": "そうみたいだね",
            "zh": "看起来是这样",
            "narrator_zh": ""
        },
        {
            "location": "295/TALK",
            "narrator": "みやび",
            "text": "自分でもビックリしてるんよ",
            "zh": "我自己都吓了一跳咯",
            "narrator_zh": "雅"
        },
        {
            "location": "296/TALK",
            "narrator": "みやび",
            "text": "学校サボッて、鈍行でこんなところまで来ちゅうなんて",
            "zh": "逃了学，还坐慢车跑到这种地方来着",
            "narrator_zh": "雅"
        },
        {
            "location": "297/TALK",
            "narrator": "みやび",
            "text": "信じられんがよ",
            "zh": "真是没法信咯",
            "narrator_zh": "雅"
        },
        {
            "location": "299/SEL",
            "narrator": "",
            "text": "これは夢だ！",
            "zh": "这是梦！",
            "narrator_zh": ""
        },
        {
            "location": "300/SEL",
            "narrator": "",
            "text": "今更だし、もう楽しもうよ",
            "zh": "事到如今，干脆玩个痛快吧",
            "narrator_zh": ""
        },
        {
            "location": "301/ACT",
            "narrator": "",
            "text": "これは夢だ！",
            "zh": "这是梦！",
            "narrator_zh": ""
        },
        {
            "location": "302/TALK",
            "narrator": "みやび",
            "text": "夢？",
            "zh": "梦？",
            "narrator_zh": "雅"
        },
        {
            "location": "303/TALK",
            "narrator": "みやび",
            "text": "まあ、それやったらありえそうやね",
            "zh": "嘛，要真是那样，倒还说得通咯",
            "narrator_zh": "雅"
        },
        {
            "location": "315/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "316/TALK",
            "narrator": "雛",
            "text": "みやび先輩。\nこの後なんですけど…。",
            "zh": "雅前辈。\n关于接下来……",
            "narrator_zh": "雏"
        },
        {
            "location": "317/TALK",
            "narrator": "みやび",
            "text": "夢や。",
            "zh": "是梦咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "318/TALK",
            "narrator": "雛",
            "text": "…はい？",
            "zh": "…啊？",
            "narrator_zh": "雏"
        },
        {
            "location": "322/TALK",
            "narrator": "みやび",
            "text": "そうや。\nこれは、きっと夢や！",
            "zh": "没错。\n这肯定是梦咯！",
            "narrator_zh": "雅"
        },
        {
            "location": "338/TALK",
            "narrator": "みやび",
            "text": "っ！？",
            "zh": "！？",
            "narrator_zh": "雅"
        },
        {
            "location": "340/TALK",
            "narrator": "雛",
            "text": "あ、起きましたか？",
            "zh": "啊，你醒了？",
            "narrator_zh": "雏"
        },
        {
            "location": "342/TALK",
            "narrator": "みやび",
            "text": "…ひなこちゃん？\nここは…。",
            "zh": "…小雏？\n这里是……。",
            "narrator_zh": "雅"
        },
        {
            "location": "345/TALK",
            "narrator": "みやび",
            "text": "…電車の中…。",
            "zh": "…电车里面……",
            "narrator_zh": "雅"
        },
        {
            "location": "347/TALK",
            "narrator": "みやび",
            "text": "なんや、やっぱしあれは\n夢やったんか。",
            "zh": "搞什么嘛，果然那\n是梦咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "350/TALK",
            "narrator": "みやび",
            "text": "…ははっ、そうやな。\nいくらうちでも、\nあれはないちや。",
            "zh": "…哈哈，也是咯。\n就算是我，\n那也不可能滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "351/TALK",
            "narrator": "雛",
            "text": "何の話ですか？",
            "zh": "你在说什么呢？",
            "narrator_zh": "雏"
        },
        {
            "location": "353/TALK",
            "narrator": "みやび",
            "text": "いや、なんでもないんよ。\nちっくと、変な夢を\n見ただけやき。",
            "zh": "没什么啦。\n只是稍微做了个\n怪梦而已嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "354/TALK",
            "narrator": "雛",
            "text": "そうだったんですか…。",
            "zh": "原来是这样啊……",
            "narrator_zh": "雏"
        },
        {
            "location": "356/TALK",
            "narrator": "雛",
            "text": "それよりみやび先輩。\nほら、見てください。",
            "zh": "比起那个，雅前辈。\n快看，这边。",
            "narrator_zh": "雏"
        },
        {
            "location": "357/TALK",
            "narrator": "雛",
            "text": "次が、高崎駅ですよ。",
            "zh": "下一站，就是高崎站了哦。",
            "narrator_zh": "雏"
        },
        {
            "location": "360/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "361/TALK",
            "narrator": "雛",
            "text": "？　みやび先輩？",
            "zh": "？　雅前辈？",
            "narrator_zh": "雏"
        },
        {
            "location": "363/TALK",
            "narrator": "みやび",
            "text": "…これは、夢か？",
            "zh": "…这次，也是梦咩……。",
            "narrator_zh": "雅"
        },
        {
            "location": "364/TALK",
            "narrator": "雛",
            "text": "えっと…もしかして、\n寝ぼけちゃってるとか？",
            "zh": "那个……难道是\n没睡醒迷迷糊糊的？",
            "narrator_zh": "雏"
        },
        {
            "location": "366/TALK",
            "narrator": "みやび",
            "text": "…いや、なんでもない。",
            "zh": "…不，没什么。",
            "narrator_zh": "雅"
        },
        {
            "location": "367/TALK",
            "narrator": "みやび",
            "text": "ちっくと、薄気味悪い\n気分やな…。",
            "zh": "就是有点，\n发毛的感觉咯……",
            "narrator_zh": "雅"
        },
        {
            "location": "368/ACT",
            "narrator": "",
            "text": "今更だし、もう楽しもうよ",
            "zh": "事到如今，干脆玩个痛快吧",
            "narrator_zh": ""
        },
        {
            "location": "370/TALK",
            "narrator": "みやび",
            "text": "…そうやね",
            "zh": "…是咯",
            "narrator_zh": "雅"
        },
        {
            "location": "371/TALK",
            "narrator": "みやび",
            "text": "信じようが信じまいが、これが現実なんやし",
            "zh": "信也好不信也好，这都是现实咯",
            "narrator_zh": "雅"
        },
        {
            "location": "372/TALK",
            "narrator": "みやび",
            "text": "今更学校にも行けんき、今日は遊ぶちや",
            "zh": "事到如今学校也回不去了，今天就玩个痛快滴",
            "narrator_zh": "雅"
        },
        {
            "location": "384/TALK",
            "narrator": "雛",
            "text": "みやび先輩！\nあたしに提案があります！",
            "zh": "雅前辈！\n我有一个提议！",
            "narrator_zh": "雏"
        },
        {
            "location": "386/TALK",
            "narrator": "みやび",
            "text": "ん、言うてみい。",
            "zh": "嗯，说说看咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "387/TALK",
            "narrator": "雛",
            "text": "両毛線という電車が\nここから出ているん\nですが――",
            "zh": "有一种叫两毛线的\n电车，就是\n从这里发车的——",
            "narrator_zh": "雏"
        },
        {
            "location": "388/TALK",
            "narrator": "雛",
            "text": "あたし、それに乗って\nみたいんです。",
            "zh": "我想坐坐看\n那个。",
            "narrator_zh": "雏"
        },
        {
            "location": "391/TALK",
            "narrator": "みやび",
            "text": "それ、面白い電車なが？",
            "zh": "那个，是有趣的电车咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "392/TALK",
            "narrator": "雛",
            "text": "手動でドアを開け閉め\nできる電車なんですよー。",
            "zh": "是能手动开关\n车门的电车哦——。",
            "narrator_zh": "雏"
        },
        {
            "location": "393/TALK",
            "narrator": "みやび",
            "text": "マジか！？\nそんな電車見たこと\nないき――",
            "zh": "真的假的！？\n那种电车我\n从来没见过啵——",
            "narrator_zh": "雅"
        },
        {
            "location": "395/TALK",
            "narrator": "みやび",
            "text": "次はそれに乗って、\nぶらり旅行を続けるちや！",
            "zh": "下一程就坐那个，\n把说走就走的旅行继续下去滴！",
            "narrator_zh": "雅"
        },
        {
            "location": "413/TALK",
            "narrator": "真幌",
            "text": "…なるほど。",
            "zh": "…原来如此。",
            "narrator_zh": "真幌"
        },
        {
            "location": "414/TALK",
            "narrator": "真幌",
            "text": "その何ちゃら線に乗って、\nそのまま温泉に入りに\n行き――",
            "zh": "坐上那个什么线，\n然后就直接去\n泡了温泉——",
            "narrator_zh": "真幌"
        },
        {
            "location": "415/TALK",
            "narrator": "真幌",
            "text": "今頃になって\n土産片手に帰ってきた、\nということだな？",
            "zh": "到了这个点，\n才拎着特产回来，\n是这么回事吧？",
            "narrator_zh": "真幌"
        },
        {
            "location": "417/TALK",
            "narrator": "雛",
            "text": "は、はい…。\n予定より、少しだけ\n遅くなりましたけど…。",
            "zh": "是、是的……。\n只是比原定计划\n稍微晚了一点……",
            "narrator_zh": "雏"
        },
        {
            "location": "420/TALK",
            "narrator": "みやび",
            "text": "青春を満喫した\n結果ながです。",
            "zh": "是充分享受了\n青春的结果咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "421/TALK",
            "narrator": "みやび",
            "text": "まほさんやったら\n理解してくれよる\n思っちょります",
            "zh": "我寻思真幌你的话，\n肯定会理解\n我们的咯",
            "narrator_zh": "雅"
        },
        {
            "location": "427/TALK",
            "narrator": "真幌",
            "text": "出来るわけないだろうが！",
            "zh": "怎么可能理解啊！",
            "narrator_zh": "真幌"
        },
        {
            "location": "428/TALK",
            "narrator": "真幌",
            "text": "学校サボッて群馬まで\n行って、温泉入って\n帰ってくるとか――",
            "zh": "逃学跑到群马去，\n泡个温泉再\n回来之类的——",
            "narrator_zh": "真幌"
        },
        {
            "location": "429/TALK",
            "narrator": "真幌",
            "text": "どこが青春だ！？\n老人の日帰り温泉旅行と\n変わらんぞ！？",
            "zh": "哪里算青春！？\n跟老人当天往返的\n温泉旅行有什么两样！？",
            "narrator_zh": "真幌"
        },
        {
            "location": "432/TALK",
            "narrator": "雛",
            "text": "…ごもっともです。",
            "zh": "…的确很有道理。",
            "narrator_zh": "雏"
        },
        {
            "location": "433/TALK",
            "narrator": "みやび",
            "text": "まあ、サボッて青春を\n満喫した分、明日からは\n真面目にやりますき――",
            "zh": "嘛，逃学享受够了\n青春，从明天起\n就认真干活啵——",
            "narrator_zh": "雅"
        },
        {
            "location": "435/TALK",
            "narrator": "みやび",
            "text": "お説教はこの辺で\n勘弁してもらえん\nですか？",
            "zh": "说教就到这里，\n饶了我们\n得咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "436/TALK",
            "narrator": "真幌",
            "text": "…驚くほど反省の色が\n見えないんだが？",
            "zh": "…我怎么完全\n看不出你们有半点反省的意思？",
            "narrator_zh": "真幌"
        },
        {
            "location": "438/TALK",
            "narrator": "雛",
            "text": "し、してますよー。\n反省してますから。",
            "zh": "有、有在反省哦——。\n我们真的有反省。",
            "narrator_zh": "雏"
        },
        {
            "location": "439/TALK",
            "narrator": "雛",
            "text": "だから、温泉まんじゅう\nでも食べて、東雲教官も\n落ち着いてください。",
            "zh": "所以，吃个温泉馒头，\n东云教官您也\n消消气嘛。",
            "narrator_zh": "雏"
        },
        {
            "location": "440/TALK",
            "narrator": "みやび",
            "text": "色々試食して選んだが\nですよ。",
            "zh": "是试吃了好多\n才选出来的咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "442/TALK",
            "narrator": "雛",
            "text": "お煎餅とどっちにするかで\n迷ったんですよねー。",
            "zh": "还在煎饼和它之间\n纠结了好久呢——。",
            "narrator_zh": "雏"
        },
        {
            "location": "444/TALK",
            "narrator": "真幌",
            "text": "こいつら…反省文でも\n書かせるか？",
            "zh": "这几个家伙……\n要不还是罚她们写检讨吧？",
            "narrator_zh": "真幌"
        },
        {
            "location": "202/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>7月27日　11:02 AM</color>\nとある平日の午前中、高崎駅にて。",
            "zh": "<color=green>7月27日　11:02 AM</color>\n某个平日的上午，在高崎站。",
            "narrator_zh": "Dialog_EventData"
        },
        {
            "location": "455/DIALOG",
            "narrator": "Dialog_GEThimegoto_ch04",
            "text": "【ガタンゴトンと揺れながら】",
            "zh": "【在哐当哐当的摇晃中】",
            "narrator_zh": "Dialog_GEThimegoto_ch04"
        }
    ]
}
