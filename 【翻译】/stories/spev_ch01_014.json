            "location": "152/TALK",
            "narrator": "つばめ",
            "text": "$handle$さんの隣は",
            "zh": "$handle$的身边",
            "narrator_zh": "燕"
        },
        {
            "location": "153/TALK",
            "narrator": "つばめ",
            "text": "絶対に譲れなぃかも",
            "zh": "我绝对不会让的",
            "narrator_zh": "燕"
        },
        {
            "location": "154/TALK",
            "narrator": "つばめ",
            "text": "ぇへへ(≧艸≦*)",
            "zh": "诶嘿嘿(≧艸≦*)",
            "narrator_zh": "燕"
        },
        {
            "location": "156/TALK",
            "narrator": "つばめ",
            "text": "それじゃ",
            "zh": "那就",
            "narrator_zh": "燕"
        },
        {
            "location": "158/TALK",
            "narrator": "つばめ",
            "text": "パーティーに戻るよ",
            "zh": "我回派对了",
            "narrator_zh": "燕"
        },
        {
            "location": "159/TALK",
            "narrator": "つばめ",
            "text": "部屋に帰ったら",
            "zh": "回房间之后",
            "narrator_zh": "燕"
        },
        {
            "location": "160/TALK",
            "narrator": "つばめ",
            "text": "また",
            "zh": "再",
            "narrator_zh": "燕"
        },
        {
            "location": "163/TALK",
            "narrator": "透明つばめ",
            "text": "…えへへ。",
            "zh": "……诶嘿嘿。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "164/TALK",
            "narrator": "銀葉樹",
            "text": "つばめ、嬉しそう。\n誰と話してたの？",
            "zh": "燕，看起来好高兴。\n在跟谁说话？",
            "narrator_zh": "银叶树"
        },
        {
            "location": "165/TALK",
            "narrator": "透明つばめ",
            "text": "うん…わたしのね、\nとっても大切な人だよ。",
            "zh": "嗯……是我\n非常重要的人。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "167/TALK",
            "narrator": "銀葉樹",
            "text": "えっ！？",
            "zh": "诶！？",
            "narrator_zh": "银叶树"
        },
        {
            "location": "168/TALK",
            "narrator": "透明つばめ",
            "text": "あはは、そのうち\n紹介するよ。",
            "zh": "啊哈哈，过些时候\n介绍给你。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "169/TALK",
            "narrator": "透明つばめ",
            "text": "きっと、銀ちゃんも\nスゴく好きになって\nくれると思うし。",
            "zh": "银叶也一定会\n非常喜欢\n那个人的。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "170/TALK",
            "narrator": "銀葉樹",
            "text": "…ほんとう？",
            "zh": "……真的？",
            "narrator_zh": "银叶树"
        },
        {
            "location": "171/TALK",
            "narrator": "透明つばめ",
            "text": "うん、実はちょっとだけ\nそんな話してたんだ。",
            "zh": "嗯，其实刚才\n稍微聊到了这个。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "173/TALK",
            "narrator": "銀葉樹",
            "text": "…大丈夫かな？\nちょっと不安なの。",
            "zh": "……没问题吗？\n我有点不安。",
            "narrator_zh": "银叶树"
        },
        {
            "location": "174/TALK",
            "narrator": "透明つばめ",
            "text": "もぉ、ダメだよ。\nそんなくらい顔してたら、\nカワイイ顔が台無しだよ。",
            "zh": "真是的，不行哦。\n摆出那种表情，\n可爱的脸就浪费了。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "175/TALK",
            "narrator": "銀葉樹",
            "text": "…うん。",
            "zh": "……嗯。",
            "narrator_zh": "银叶树"
        },
        {
            "location": "176/TALK",
            "narrator": "透明つばめ",
            "text": "あはは、そうそう。\nやっぱり銀ちゃんは\nとっても可愛いよー。",
            "zh": "啊哈哈，对对。\n银叶果然\n非常可爱哦。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "177/TALK",
            "narrator": "銀葉樹",
            "text": "そ、そんなことないの。\nつばめの方が…。",
            "zh": "才、才没有。\n燕更……",
            "narrator_zh": "银叶树"
        },
        {
            "location": "178/TALK",
            "narrator": "透明つばめ",
            "text": "ううん、銀ちゃんの方が\n絶対可愛いよ。",
            "zh": "不，银叶\n绝对更可爱。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "179/TALK",
            "narrator": "透明つばめ",
            "text": "サンタ帽も、\nとっても似合ってるし。",
            "zh": "圣诞帽\n也非常合适。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "181/TALK",
            "narrator": "銀葉樹",
            "text": "…………。",
            "zh": "…………",
            "narrator_zh": "银叶树"
        },
        {
            "location": "182/TALK",
            "narrator": "透明つばめ",
            "text": "うん、ほんとう可愛い！",
            "zh": "嗯，真的好可爱！",
            "narrator_zh": "透明燕"
        },
        {
            "location": "183/TALK",
            "narrator": "銀葉樹",
            "text": "…ありがと。",
            "zh": "……谢谢。",
            "narrator_zh": "银叶树"
        },
        {
            "location": "185/TALK",
            "narrator": "透明つばめ",
            "text": "えへへ…。",
            "zh": "诶嘿嘿……",
            "narrator_zh": "透明燕"
        }
    ]
}
