    "entry": [
        {
            "location": "32/TALK",
            "narrator": "透明つばめ",
            "text": "どうしたの、銀ちゃん。\nさっきからずっと\n小さくなってるけど…。",
            "zh": "怎么了，银叶。\n从刚才起一直\n缩着……",
            "narrator_zh": "透明燕"
        },
        {
            "location": "33/TALK",
            "narrator": "銀葉樹",
            "text": "…ま、前向きに考える\nなんて、言わなければ\nよかったの…。",
            "zh": "……要是不说\n往好的方面想，\n就好了……",
            "narrator_zh": "银叶树"
        },
        {
            "location": "34/TALK",
            "narrator": "透明つばめ",
            "text": "え？",
            "zh": "诶？",
            "narrator_zh": "透明燕"
        },
        {
            "location": "35/TALK",
            "narrator": "銀葉樹",
            "text": "この服…サンタ服って\nいうから、普通のかと\n思ったけど…。",
            "zh": "这件衣服……说是圣诞装，\n我以为是普通的\n那种……",
            "narrator_zh": "银叶树"
        },
        {
            "location": "36/TALK",
            "narrator": "銀葉樹",
            "text": "露出が多すぎて、\n恥ずかしいの…。",
            "zh": "露得太多，\n好害羞……",
            "narrator_zh": "银叶树"
        },
        {
            "location": "37/TALK",
            "narrator": "透明つばめ",
            "text": "あ、あはは…ごめんね。\nちゃんと確認すれば\nよかったよね…。",
            "zh": "啊、啊哈哈……对不起。\n要是先确认一下\n就好了……",
            "narrator_zh": "透明燕"
        },
        {
            "location": "38/TALK",
            "narrator": "透明つばめ",
            "text": "でも、大丈夫だよ。\nみんなも着てるんだし。",
            "zh": "不过，没事的。\n大家也都穿着。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "39/TALK",
            "narrator": "透明つばめ",
            "text": "それに、わたしは\n銀ちゃんと同じ格好\nしたかったから…。",
            "zh": "而且，我想\n和银叶穿成\n一样……",
            "narrator_zh": "透明燕"
        },
        {
            "location": "40/TALK",
            "narrator": "透明つばめ",
            "text": "今、とっても嬉しいよ。",
            "zh": "我现在非常高兴。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "42/TALK",
            "narrator": "銀葉樹",
            "text": "…………。",
            "zh": "…………",
            "narrator_zh": "银叶树"
        },
        {
            "location": "43/TALK",
            "narrator": "銀葉樹",
            "text": "つばめは、\nとっても似合ってるの。",
            "zh": "燕，\n非常合适。",
            "narrator_zh": "银叶树"
        },
        {
            "location": "45/TALK",
            "narrator": "透明つばめ",
            "text": "ほんとう？",
            "zh": "真的？",
            "narrator_zh": "透明燕"
        },
        {
            "location": "46/TALK",
            "narrator": "銀葉樹",
            "text": "うん…とっても可愛くて、\nいいと思うの。",
            "zh": "嗯……非常可爱，\n我觉得很好。",
            "narrator_zh": "银叶树"
        },
        {
            "location": "47/TALK",
            "narrator": "透明つばめ",
            "text": "ありがと…。\nでも、正直なこと\n言うとね――",
            "zh": "谢谢……\n不过，说实话\n——",
            "narrator_zh": "透明燕"
        },
        {
            "location": "48/TALK",
            "narrator": "透明つばめ",
            "text": "実はわたしも、\nちょっとだけ\n恥ずかしいんだ。",
            "zh": "其实我也\n有一点点\n害羞。",
            "narrator_zh": "透明燕"
        },
        {
            "location": "49/TALK",
            "narrator": "銀葉樹",
            "text": "そうなの？",
            "zh": "是吗？",
            "narrator_zh": "银叶树"
        },
        {
            "location": "50/TALK",
            "narrator": "透明つばめ",
            "text": "うん。\n可愛いから好きだけど、\n露出が多いのはね…。",
            "zh": "嗯。\n因为可爱所以喜欢，\n可是露得多……",
            "narrator_zh": "透明燕"
        },
        {
            "location": "51/TALK",
            "narrator": "銀葉樹",
            "text": "ふふっ、一緒なの。",
            "zh": "呵呵，我们一样。",
            "narrator_zh": "银叶树"
        },
        {
            "location": "54/TALK",
            "narrator": "透明つばめ",
            "text": "えへへ…。",
