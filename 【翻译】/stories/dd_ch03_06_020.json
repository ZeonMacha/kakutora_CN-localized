        },
        {
            "location": "587/TALK",
            "narrator": "みやび",
            "text": "けんど、\nちっくとでも興味が\nあるんやったら――",
            "zh": "不过，\n哪怕有一哈兴趣\n的话——",
            "narrator_zh": "雅"
        },
        {
            "location": "588/TALK",
            "narrator": "みやび",
            "text": "いつかは出よう思える\nようになるがよ。",
            "zh": "总有一天会想\n去参加的咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "589/TALK",
            "narrator": "ガブリエラ",
            "text": "…そうかしら？",
            "zh": "……是吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "590/TALK",
            "narrator": "みやび",
            "text": "そうちや。",
            "zh": "是咯。",
            "narrator_zh": "雅"
        },
        {
