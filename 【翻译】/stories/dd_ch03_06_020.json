{
    "dir": "chap06/daydra/dd_ch03_06_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "6356",
        "cid": "gabriella",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "ミスコン",
        "title_zh": "Extra006 额外剧情",
        "sub_title_zh": "选美"
    },
    "entry": [
        {
            "location": "443/SCENARIO",
            "narrator": "",
            "text": "ミスコン",
            "zh": "选美",
            "narrator_zh": ""
        },
        {
            "location": "459/TALK",
            "narrator": "ガブリエラ",
            "text": "…今回の特集記事、\nあんまり\n面白くないわね。",
            "zh": "……这次的特辑，\n不怎么\n有意思。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "460/TALK",
            "narrator": "ガブリエラ",
            "text": "これといって\n欲しい服も\n載ってないし…。",
            "zh": "也没登\n我想要的\n衣服……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "461/TALK",
            "narrator": "ガブリエラ",
            "text": "…ん？\n読者モデル募集？",
            "zh": "……嗯？\n招募读者模特？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "462/TALK",
            "narrator": "ガブリエラ",
            "text": "書類審査合格後、\nコンテストで優勝したら\n専属モデルデビュー…。",
            "zh": "书面审查合格后，\n选美赢了的话\n就能以专属模特出道……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "464/TALK",
            "narrator": "ガブリエラ",
            "text": "読者モデルかぁ…。",
            "zh": "读者模特啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "465/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "469/TALK",
            "narrator": "みやび",
            "text": "興味あるんか？",
            "zh": "有兴趣喃？",
            "narrator_zh": "雅"
        },
        {
            "location": "472/TALK",
            "narrator": "ガブリエラ",
            "text": "きゃあっ！？",
            "zh": "呀啊！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "474/TALK",
            "narrator": "ガブリエラ",
            "text": "み、みやび！？\n急に声かけないでよ！\n驚いたじゃない！？",
            "zh": "雅、雅！？\n别突然出声！\n吓到我了！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "475/TALK",
            "narrator": "みやび",
            "text": "読者モデル、\n応募してみたら\nどうや？",
            "zh": "读者模特，\n去报名\n怎么样？",
            "narrator_zh": "雅"
        },
        {
            "location": "478/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ？\n絶対にしないわよ。",
            "zh": "哈？\n我绝对不会。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "482/TALK",
            "narrator": "みやび",
            "text": "ほう…なら…。",
            "zh": "哦……那样的话……。",
            "narrator_zh": "雅"
        },
        {
            "location": "484/TALK",
            "narrator": "ガブリエラ",
            "text": "言っとくけど、勝手に\n応募されて、仮に合格\nしても――",
            "zh": "先说好，就算被擅自\n报名，就算合格\n了——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "485/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしは辞退するから。",
            "zh": "我也会辞退。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "488/TALK",
            "narrator": "みやび",
            "text": "…察しがえいな、\nガブちゃん。",
            "zh": "……眼力好啊，\n加布。",
            "narrator_zh": "雅"
        },
        {
            "location": "489/TALK",
            "narrator": "みやび",
            "text": "まあ、ガブちゃんの\nことやき多分断るとは\n思うちょったけんど――",
            "zh": "嘛，因为是加布啵，\n我猜多半会拒绝，\n不过——",
            "narrator_zh": "雅"
        },
        {
            "location": "490/TALK",
            "narrator": "みやび",
            "text": "ちくっと勿体ない\n気もするがよ。",
            "zh": "也觉得有一哈\n可惜咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "491/TALK",
            "narrator": "ガブリエラ",
            "text": "勿体ない？",
            "zh": "可惜？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "492/TALK",
            "narrator": "みやび",
            "text": "ガブちゃんの可愛さを、\n大勢の人に見せられん\nことちや。",
            "zh": "加布的可爱，\n没法给很多人看，\n这件事咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "493/SEL",
            "narrator": "",
            "text": "興味ないの？",
            "zh": "没兴趣吗？",
            "narrator_zh": ""
        },
        {
            "location": "494/SEL",
            "narrator": "",
            "text": "優勝間違いなしだよ！",
            "zh": "赢定了！",
            "narrator_zh": ""
        },
        {
            "location": "495/SEL",
            "narrator": "",
            "text": "ガブリエラを見られたくない",
            "zh": "不想让人看见加布里埃拉",
            "narrator_zh": ""
        },
        {
            "location": "497/TALK",
            "narrator": "ガブリエラ",
            "text": "大袈裟過ぎだってば。",
            "zh": "太夸张了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "498/TALK",
            "narrator": "みやび",
            "text": "まあ、ちっくとだけな。",
            "zh": "嘛，就一哈而已。",
            "narrator_zh": "雅"
        },
        {
            "location": "499/TALK",
            "narrator": "みやび",
            "text": "けんど、可愛い思うは\n本当やき、応募だけ\nしてみたらどうかね。",
            "zh": "不过，觉得可爱\n是真的啵，只报名\n看看怎么样。",
            "narrator_zh": "雅"
        },
        {
            "location": "501/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "504/TALK",
            "narrator": "ガブリエラ",
            "text": "まあ、正直言って\n憧れるし――",
            "zh": "嘛，老实说\n是会向往——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "505/TALK",
            "narrator": "ガブリエラ",
            "text": "可愛いって言って\nもらえるのも、\n嬉しいと思うわ。",
            "zh": "被人说可爱，\n我想我也会\n高兴。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "506/TALK",
            "narrator": "ガブリエラ",
            "text": "けど…嫌なのよ。\nこういうのって…。",
            "zh": "可是……我不想。\n这种事……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "507/TALK",
            "narrator": "みやび",
            "text": "こういうのって、\nコンテストのことなが？",
            "zh": "这种事，\n是说选美喃？",
            "narrator_zh": "雅"
        },
        {
            "location": "509/TALK",
            "narrator": "ガブリエラ",
            "text": "うん…。",
            "zh": "嗯……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "510/TALK",
            "narrator": "みやび",
            "text": "…嫌いいうよりは、\n苦手、っちゅう感じ\nかもしれんなぁ。",
            "zh": "……与其说讨厌，\n更像是不擅长\n的感觉吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "511/TALK",
            "narrator": "みやび",
            "text": "…まあ、そこまで\n嫌ならこれ以上は\n勧めんぞね。",
            "zh": "……嘛，要是那么\n讨厌，我就不再\n劝了啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "512/TALK",
            "narrator": "みやび",
            "text": "けんど、\nちっくとでも興味が\nあるんやったら――",
            "zh": "不过，\n哪怕有一哈兴趣\n的话——",
            "narrator_zh": "雅"
        },
        {
            "location": "513/TALK",
            "narrator": "みやび",
            "text": "いつかは出よう思える\nようになるがよ。",
            "zh": "总有一天会想\n去参加的咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "515/TALK",
            "narrator": "ガブリエラ",
            "text": "…そうかしら？",
            "zh": "……是吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "516/TALK",
            "narrator": "みやび",
            "text": "そうちや。",
            "zh": "是咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "518/TALK",
            "narrator": "みやび",
            "text": "コンテストの壇上に\n上がって、可愛さを\n振りまくガブちゃん。",
            "zh": "站上选美的台子，\n把可爱撒得到处都是的\n加布。",
            "narrator_zh": "雅"
        },
        {
            "location": "519/TALK",
            "narrator": "みやび",
            "text": "そんなガブちゃんの\n可愛さに当てられて、\n鼻血を出す男達の姿が―",
            "zh": "被那样的加布\n可爱击中，流鼻血的\n男人们的样子——",
            "narrator_zh": "雅"
        },
        {
            "location": "520/TALK",
            "narrator": "みやび",
            "text": "目に浮かんでくるぞね。",
            "zh": "都浮现在眼前啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "521/TALK",
            "narrator": "ガブリエラ",
            "text": "そんな可愛さ嫌よ！",
            "zh": "那种可爱我才不要！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "522/TALK",
            "narrator": "ガブリエラ",
            "text": "っていうか、\nリアルだとそれ\n大惨事じゃない？",
            "zh": "话说，\n要是真的那样\n不就是大惨剧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "524/TALK",
            "narrator": "みやび",
            "text": "…大惨事やね。",
            "zh": "……大惨剧咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "526/TALK",
            "narrator": "みやび",
            "text": "ガブちゃんの可愛さは\n兵器並みやきね。",
            "zh": "加布的可爱\n堪比兵器啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "529/TALK",
            "narrator": "ガブリエラ",
            "text": "そんな可愛さ持って\nないし、持ちたくも\nないわよ…。",
            "zh": "我没有那种可爱，\n也不想有\n……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "531/ACT",
            "narrator": "",
            "text": "興味ないの？",
            "zh": "没兴趣吗？",
            "narrator_zh": ""
        },
        {
            "location": "535/TALK",
            "narrator": "ガブリエラ",
            "text": "ごめん、\nちょっとタイム。\n何か来たみたい。",
            "zh": "抱歉，\n稍微暂停。\n好像来消息了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "536/TALK",
            "narrator": "みやび",
            "text": "ん、ゆっくりでえいよ。",
            "zh": "嗯，慢慢来要得。",
            "narrator_zh": "雅"
        },
        {
            "location": "553/TALK",
            "narrator": "ガブリエラ",
            "text": "興味ないわけじゃないわ",
            "zh": "不是没兴趣",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "554/TALK",
            "narrator": "ガブリエラ",
            "text": "けど…仮に合格したら、コンテストでしょ？",
            "zh": "可是……要是合格了，就是选美吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "555/TALK",
            "narrator": "ガブリエラ",
            "text": "そうなったら、男の人達に沢山見られることになるし…",
            "zh": "那样的话，就会被很多男生看着……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "557/SEL",
            "narrator": "",
            "text": "怖い？",
            "zh": "害怕？",
            "narrator_zh": ""
        },
        {
            "location": "558/ACT",
            "narrator": "",
            "text": "怖い？",
            "zh": "害怕？",
            "narrator_zh": ""
        },
        {
            "location": "560/TALK",
            "narrator": "ガブリエラ",
            "text": "想像するだけでも怖いわ",
            "zh": "光是想象就害怕",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "561/TALK",
            "narrator": "ガブリエラ",
            "text": "だから、嫌なの！",
            "zh": "所以，我不想！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "574/TALK",
            "narrator": "ガブリエラ",
            "text": "お待たせ…。",
            "zh": "久等了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "575/TALK",
            "narrator": "みやび",
            "text": "大丈夫がか？\nちっくと顔色悪い\nみたいやけんど…。",
            "zh": "没事喃？\n脸色有一哈不好\n的样子，不过……。",
            "narrator_zh": "雅"
        },
        {
            "location": "577/TALK",
            "narrator": "ガブリエラ",
            "text": "へ、平気よ。\n何でもないから。",
            "zh": "没、没事。\n什么都没有。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "578/TALK",
            "narrator": "みやび",
            "text": "…そんなに\nコンテストの\n話が嫌だったが？",
            "zh": "……有那么\n讨厌\n谈选美吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "580/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "581/TALK",
            "narrator": "ガブリエラ",
            "text": "まあ、正直言って\n憧れるし――",
            "zh": "嘛，老实说\n是会向往——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "582/TALK",
            "narrator": "ガブリエラ",
            "text": "可愛いって言って\nもらえるのも、\n嬉しいと思うわ。",
            "zh": "被人说可爱，\n我想我也会\n高兴。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "583/TALK",
            "narrator": "ガブリエラ",
            "text": "けど…嫌なのよ。\nこういうのって…。",
            "zh": "可是……我不想。\n这种事……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "584/TALK",
            "narrator": "みやび",
            "text": "…そうやったがね。",
            "zh": "……是那样喃。",
            "narrator_zh": "雅"
        },
        {
            "location": "585/TALK",
            "narrator": "みやび",
            "text": "…嫌いいうよりは、\n苦手、っちゅう感じ\nかもしれんなぁ。",
            "zh": "……与其说讨厌，\n更像是不擅长\n的感觉吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "586/TALK",
            "narrator": "みやび",
            "text": "…まあ、そこまで\n嫌ならこれ以上は\n勧めんぞね。",
            "zh": "……嘛，要是那么\n讨厌，我就不再\n劝了啵。",
