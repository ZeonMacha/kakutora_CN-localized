            "narrator_zh": "神乐"
        },
        {
            "location": "1414/TALK",
            "narrator": "神楽",
            "text": "そうだけど",
            "zh": "是这样没错",
            "narrator_zh": "神乐"
        },
        {
            "location": "1415/TALK",
            "narrator": "神楽",
            "text": "そうだけど",
            "zh": "是这样没错",
            "narrator_zh": "神乐"
        },
        {
            "location": "1416/ACT",
            "narrator": "",
            "text": "神楽は神楽ってだけで十分だよ",
            "zh": "神乐光是做神乐就够了",
            "narrator_zh": ""
        },
        {
            "location": "1417/TALK",
            "narrator": "神楽",
            "text": "そっかな？",
            "zh": "是吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1418/TALK",
            "narrator": "神楽",
            "text": "それだけで",
            "zh": "光是这些",
            "narrator_zh": "神乐"
        },
        {
            "location": "1419/TALK",
            "narrator": "神楽",
            "text": "いいのかな？",
            "zh": "这样行吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1420/ACT",
            "narrator": "",
            "text": "一人称がぴょんこって時点でｗｗｗ",
            "zh": "自称就是蹦子这点已经哈哈哈",
            "narrator_zh": ""
        },
        {
            "location": "1421/TALK",
            "narrator": "神楽",
            "text": "は？",
            "zh": "啊？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1422/TALK",
            "narrator": "神楽",
            "text": "ぴょんこはぴょんこだし！！！！",
            "zh": "蹦子就是蹦子啊！！！！",
            "narrator_zh": "神乐"
        },
        {
            "location": "1424/TALK",
            "narrator": "神楽",
            "text": "なんかさ",
            "zh": "我说啊",
            "narrator_zh": "神乐"
        },
        {
            "location": "1425/TALK",
            "narrator": "神楽",
            "text": "あれなんでしょ",
            "zh": "就是那个吧",
            "narrator_zh": "神乐"
        },
        {
            "location": "1426/TALK",
            "narrator": "神楽",
            "text": "適当に楽しげなウソばっかり並べてれば",
            "zh": "只要随便编一堆听着开心的谎话",
            "narrator_zh": "神乐"
        },
        {
            "location": "1427/TALK",
            "narrator": "神楽",
            "text": "ぴょんこのイライラも見なくてすむし",
            "zh": "就不用看蹦子发脾气",
            "narrator_zh": "神乐"
        },
        {
            "location": "1428/TALK",
            "narrator": "神楽",
            "text": "$handle$はそれでいいんでしょ",
            "zh": "$handle$这样就行了吧",
            "narrator_zh": "神乐"
        },
        {
            "location": "1429/TALK",
            "narrator": "神楽",
            "text": "むしろそれがいいんでしょ？？？",
            "zh": "不如说你更希望那样吧？？？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1430/TALK",
            "narrator": "神楽",
            "text": "めんどくさくなくて",
            "zh": "省得麻烦",
            "narrator_zh": "神乐"
        },
        {
            "location": "1433/SEL",
            "narrator": "",
            "text": "そんなこと思ってない",
            "zh": "我没那么想",
            "narrator_zh": ""
        },
        {
            "location": "1434/SEL",
            "narrator": "",
            "text": "なんでそうなるの？",
            "zh": "怎么就变成这样了？",
            "narrator_zh": ""
        },
        {
            "location": "1435/SEL",
            "narrator": "",
            "text": "よしよしいい子いい子",
            "zh": "乖啦乖啦，好孩子好孩子",
            "narrator_zh": ""
        },
        {
            "location": "1436/ACT",
            "narrator": "",
            "text": "そんなこと思ってない",
            "zh": "我没那么想",
            "narrator_zh": ""
        },
        {
            "location": "1437/TALK",
            "narrator": "神楽",
            "text": "またまた",
            "zh": "又来了",
            "narrator_zh": "神乐"
        },
        {
            "location": "1438/TALK",
            "narrator": "神楽",
            "text": "上手いんだから",
            "zh": "真会说啊",
            "narrator_zh": "神乐"
        },
        {
            "location": "1439/ACT",
            "narrator": "",
            "text": "なんでそうなるの？",
            "zh": "怎么就变成这样了？",
            "narrator_zh": ""
        },
        {
            "location": "1440/TALK",
            "narrator": "神楽",
            "text": "なんでって",
            "zh": "为什么嘛",
            "narrator_zh": "神乐"
        },
        {
            "location": "1441/TALK",
            "narrator": "神楽",
            "text": "本当のことでしょ",
            "zh": "本来就是真的嘛",
            "narrator_zh": "神乐"
        },
        {
            "location": "1442/ACT",
            "narrator": "",
            "text": "よしよしいい子いい子",
            "zh": "乖啦乖啦，好孩子好孩子",
            "narrator_zh": ""
        },
        {
            "location": "1443/TALK",
            "narrator": "神楽",
            "text": "あ？？？？",
            "zh": "哈？？？？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1444/TALK",
            "narrator": "神楽",
            "text": "ふざけんな",
            "zh": "开什么玩笑",
            "narrator_zh": "神乐"
        },
        {
            "location": "1446/TALK",
            "narrator": "神楽",
            "text": "ぴょんこもう機嫌がいいふりするのも疲れたから",
            "zh": "蹦子已经懒得再装作心情很好的样子了",
            "narrator_zh": "神乐"
        },
        {
            "location": "1447/TALK",
            "narrator": "神楽",
            "text": "そういうことしたくない",
            "zh": "我不想做那种事",
            "narrator_zh": "神乐"
        },
        {
            "location": "1449/SEL",
            "narrator": "",
            "text": "今までそうだったんだ…？",
            "zh": "一直以来都是这样吗……？",
            "narrator_zh": ""
        },
        {
            "location": "1450/SEL",
            "narrator": "",
            "text": "ごめんね無理させて",
            "zh": "对不起，让你勉强了",
            "narrator_zh": ""
        },
        {
            "location": "1451/SEL",
            "narrator": "",
            "text": "今日はずいぶん機嫌が悪いね",
            "zh": "你今天心情差得厉害呢",
            "narrator_zh": ""
        },
        {
            "location": "1452/ACT",
            "narrator": "",
            "text": "今までそうだったんだ…？",
            "zh": "一直以来都是这样吗……？",
            "narrator_zh": ""
        },
        {
            "location": "1453/TALK",
            "narrator": "神楽",
            "text": "気付いてなかったんだ？？？",
            "zh": "原来你一直没发现啊？？？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1454/ACT",
            "narrator": "",
            "text": "ごめんね無理させて",
            "zh": "对不起，让你勉强了",
            "narrator_zh": ""
        },
        {
            "location": "1455/TALK",
            "narrator": "神楽",
            "text": "無理っていうか",
            "zh": "与其说是勉强",
            "narrator_zh": "神乐"
        },
        {
            "location": "1456/TALK",
            "narrator": "神楽",
            "text": "ぴょんこが勝手にそういう気分になってるだけだけどー",
            "zh": "不如说是蹦子自己擅自闹成这种心情而已——",
            "narrator_zh": "神乐"
        },
        {
            "location": "1457/TALK",
            "narrator": "神楽",
            "text": "でもー",
            "zh": "不过——",
            "narrator_zh": "神乐"
        },
        {
            "location": "1458/ACT",
            "narrator": "",
            "text": "今日はずいぶん機嫌が悪いね",
            "zh": "你今天心情差得厉害呢",
            "narrator_zh": ""
        },
        {
            "location": "1459/TALK",
            "narrator": "神楽",
            "text": "今日はじゃないし",
            "zh": "才不是“今天”呢",
            "narrator_zh": "神乐"
        },
        {
            "location": "1461/TALK",
            "narrator": "神楽",
            "text": "なんだろねこういうの",
            "zh": "这种事到底是怎么回事呢",
            "narrator_zh": "神乐"
        },
        {
            "location": "1463/TALK",
            "narrator": "神楽",
            "text": "ムシャクシャしてやった？？？",
            "zh": "因为心里烦躁才这么干的？？？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1465/SEL",
            "narrator": "",
            "text": "じゃあ今は反省してるの？",
            "zh": "那你现在在反省吗？",
            "narrator_zh": ""
        },
        {
            "location": "1466/SEL",
            "narrator": "",
            "text": "ご機嫌斜めだな～",
            "zh": "心情不太好啊～",
            "narrator_zh": ""
        },
        {
            "location": "1467/SEL",
            "narrator": "",
            "text": "全部吐き出せば楽になれるかも",
            "zh": "全都吐出来也许会轻松些",
            "narrator_zh": ""
        },
        {
            "location": "1468/ACT",
            "narrator": "",
            "text": "じゃあ今は反省してるの？",
            "zh": "那你现在在反省吗？",
            "narrator_zh": ""
        },
        {
            "location": "1469/TALK",
            "narrator": "神楽",
            "text": "なんでよ",
            "zh": "为什么啊",
            "narrator_zh": "神乐"
        },
        {
            "location": "1470/TALK",
            "narrator": "神楽",
            "text": "なんでそんなことしなきゃいけないの",
            "zh": "为什么非做那种事不可呢",
            "narrator_zh": "神乐"
        },
        {
            "location": "1471/ACT",
            "narrator": "",
            "text": "ご機嫌斜めだな～",
            "zh": "心情不太好啊～",
            "narrator_zh": ""
        },
        {
            "location": "1472/TALK",
            "narrator": "神楽",
            "text": "当たり前でしょ",
