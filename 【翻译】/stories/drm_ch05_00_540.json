        {
            "location": "1478/TALK",
            "narrator": "神楽",
            "text": "何もかも面倒くさいし",
            "zh": "干什么都嫌麻烦",
            "narrator_zh": "神乐"
        },
        {
            "location": "1479/TALK",
            "narrator": "神楽",
            "text": "それなのに$handle$はそういう態度で",
