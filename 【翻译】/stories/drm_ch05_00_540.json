            "narrator_zh": "神乐"
        },
        {
            "location": "1474/ACT",
            "narrator": "",
            "text": "全部吐き出せば楽になれるかも",
            "zh": "全都吐出来也许会轻松些",
            "narrator_zh": ""
        },
        {
            "location": "1475/TALK",
            "narrator": "神楽",
            "text": "かもね～～～～？",
