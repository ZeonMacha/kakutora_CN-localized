            "narrator": "",
            "text": "大変なんだよね…",
            "zh": "真是辛苦啊……",
            "narrator_zh": ""
        },
        {
            "location": "1484/SEL",
            "narrator": "",
            "text": "代わってあげたいけど",
            "zh": "我想替你，可是",
            "narrator_zh": ""
        },
        {
            "location": "1485/SEL",
            "narrator": "",
            "text": "なんかごめん",
            "zh": "有点抱歉",
            "narrator_zh": ""
        },
        {
            "location": "1486/SEL",
            "narrator": "",
            "text": "プップクプー！",
            "zh": "噗噗噗——！",
            "narrator_zh": ""
        },
        {
            "location": "1487/ACT",
            "narrator": "",
            "text": "大変なんだよね…",
            "zh": "真是辛苦啊……",
            "narrator_zh": ""
        },
        {
            "location": "1488/TALK",
            "narrator": "神楽",
            "text": "ですよですよdeathよ！？！？",
            "zh": "是这样吧death吧！？！？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1489/ACT",
            "narrator": "",
            "text": "代わってあげたいけど",
            "zh": "我想替你，可是",
            "narrator_zh": ""
        },
        {
            "location": "1490/TALK",
            "narrator": "神楽",
            "text": "けどとか言ってもそんなの無理だし！！！",
            "zh": "可是就算这么说，那也做不到啊！！！",
            "narrator_zh": "神乐"
        },
        {
            "location": "1491/TALK",
            "narrator": "神楽",
            "text": "高みの見物ってやつ！？！？！？！？",
            "zh": "你是在隔岸观火吗！？！？！？！？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1492/ACT",
            "narrator": "",
            "text": "なんかごめん",
            "zh": "有点抱歉",
            "narrator_zh": ""
        },
        {
            "location": "1493/TALK",
            "narrator": "神楽",
            "text": "謝ればいいと思ってる？",
            "zh": "你以为道个歉就行了吗？",
