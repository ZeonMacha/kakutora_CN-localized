        {
            "location": "1496/TALK",
            "narrator": "神楽",
            "text": "何それ",
            "zh": "那是什么",
            "narrator_zh": "神乐"
        },
        {
            "location": "1498/TALK",
            "narrator": "神楽",
            "text": "パンパカパーン！！！",
            "zh": "锵锵锵——！！！",
            "narrator_zh": "神乐"
        },
        {
            "location": "1502/TALK",
            "narrator": "神楽",
            "text": "なんて",
