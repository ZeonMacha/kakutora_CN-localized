            "narrator": "神楽",
            "text": "たのしくしたいし",
            "zh": "我也想弄得开心",
            "narrator_zh": "神乐"
        },
        {
            "location": "1505/TALK",
            "narrator": "神楽",
            "text": "笑っていたいの",
