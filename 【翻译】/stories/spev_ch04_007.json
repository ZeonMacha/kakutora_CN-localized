{
    "dir": "chap00/daydra/spev_ch04_007.js",
    "type": "",
    "info": {
        "story_id": "4007",
        "cid": "",
        "title": "スペシャルエピソード",
        "sub_title": "神楽ちゃんとゲーム",
        "title_zh": "特别篇",
        "sub_title_zh": "和神乐玩游戏"
    },
    "entry": [
        {
            "location": "29/TALK",
            "narrator": "透明神楽",
            "text": "ちょ、みやびさん！\nなんでそっちの車、\nそんなに早いんですか！？",
            "zh": "等、雅！\n为什么你那辆车\n跑得这么快呀！？",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "32/TALK",
            "narrator": "透明みやび",
            "text": "なんでもなにも、\nうちは普通に走っちゅう\nだけやぞ？",
            "zh": "哪有什么为什么，\n我明明只是在正常\n开而已咯？",
            "narrator_zh": "透明雅"
        },
        {
            "location": "35/TALK",
            "narrator": "透明神楽",
            "text": "そんな…えぇっ！？\nどんどん加速してる！",
            "zh": "怎么会……诶诶！？\n还在越跑越快！",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "36/TALK",
            "narrator": "透明神楽",
            "text": "まさか、チートですか！？",
            "zh": "难道，你开挂了吗！？",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "37/TALK",
            "narrator": "透明みやび",
            "text": "人聞きの悪い…。\nテクの問題や。",
            "zh": "说得真难听……\n这是技术问题咯。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "38/TALK",
            "narrator": "透明みやび",
            "text": "曲がり角ではドリフト、\nできる限りインコース。",
            "zh": "过弯漂移，\n尽量贴着内道走。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "39/TALK",
            "narrator": "透明みやび",
            "text": "それだけ意識しちょれば、\nこれくらい普通ちや。",
            "zh": "只要注意这两点，\n跑成这样很平常滴。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "41/TALK",
            "narrator": "透明神楽",
            "text": "それにしたってちょっと\n早過ぎるような…。",
            "zh": "话虽如此，还是觉得\n快得有点过分了……",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "42/TALK",
            "narrator": "透明みやび",
            "text": "ふむ…ならば禁断の\n裏技を披露しよう。",
            "zh": "唔……既然如此，就来\n露一手禁忌秘技吧。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "43/TALK",
            "narrator": "透明みやび",
            "text": "秘技、コースアウトからの\nショートカット！",
            "zh": "秘技，冲出赛道\n抄近道！",
            "narrator_zh": "透明雅"
        },
        {
            "location": "47/TALK",
            "narrator": "透明神楽",
            "text": "えぇーっ！？",
            "zh": "诶诶——！？",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "48/TALK",
            "narrator": "透明みやび",
            "text": "ふっ…うちの完勝や。",
            "zh": "哼……是我完胜咯。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "50/TALK",
            "narrator": "透明神楽",
            "text": "ま、負けた…。\n結構やりこんだゲーム\nだったのに…。",
            "zh": "居、居然输了……\n明明这款游戏\n我已经玩得很熟了……",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "52/TALK",
            "narrator": "透明みやび",
            "text": "ふふふ…うちに対して\nゲームデートを求めたのが\n運の尽きやったな。",
            "zh": "呵呵呵……找我\n约着打游戏的时候，\n你就已经走背运了咯。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "53/TALK",
            "narrator": "透明みやび",
            "text": "どうする？\nリベンジはいくらでも\n受けるぞね？",
            "zh": "怎么样？\n你想复仇多少次\n我都奉陪咧？",
            "narrator_zh": "透明雅"
        },
        {
            "location": "55/TALK",
            "narrator": "透明神楽",
            "text": "もう一回お願いします。",
            "zh": "请再来一局。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "56/TALK",
            "narrator": "透明神楽",
            "text": "スーパープレイ動画で\nやってた技で、\n次こそ勝ちます！",
            "zh": "我要用大神实况视频里\n演示过的绝招，\n下次一定赢过你！",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "58/TALK",
            "narrator": "透明みやび",
            "text": "ほほぅ…その自信、\nすぐに崩れんように\n気ぃつけた方がえいよ。",
            "zh": "哦吼……你这份自信，\n最好小心别\n马上垮掉咯。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "59/TALK",
            "narrator": "透明神楽",
            "text": "その言葉、そのまま\nみやびさんに\nお返しします。",
            "zh": "这句话，我原封不动\n还给\n雅。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "60/TALK",
            "narrator": "透明神楽",
            "text": "さあ、行きますよ！",
            "zh": "来，我要上了哦！",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "61/TALK",
            "narrator": "透明みやび",
            "text": "スタートッ！",
            "zh": "开始！",
            "narrator_zh": "透明雅"
        },
        {
            "location": "64/TALK",
            "narrator": "透明みやび",
            "text": "おおっ！？\n確かに上手くなっちゅう。",
            "zh": "哦哦！？\n确实变厉害了咯。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "65/TALK",
            "narrator": "透明神楽",
            "text": "まだまだです。\n必殺――",
            "zh": "还早着呢。\n必杀——",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "66/TALK",
            "narrator": "透明神楽",
            "text": "押し出し！！",
            "zh": "撞出赛道！！",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "70/TALK",
            "narrator": "透明みやび",
            "text": "な、なにぃ！？",
            "zh": "什、什么！？",
            "narrator_zh": "透明雅"
        },
        {
            "location": "74/TALK",
            "narrator": "透明神楽",
            "text": "やった、抜いた！",
            "zh": "太好了，超过去了！",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "75/TALK",
            "narrator": "透明みやび",
            "text": "卯月…とうとう手段を\n選ばなくなったか…。",
            "zh": "卯月……你终于\n开始不择手段了咩……",
            "narrator_zh": "透明雅"
        },
        {
            "location": "76/TALK",
            "narrator": "透明神楽",
            "text": "レースにクラッシュは\n付きものですよー。",
            "zh": "赛车比赛里撞车\n本来就是常事嘛——",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "78/TALK",
            "narrator": "透明みやび",
            "text": "ならばもう一度、\nコースアウトからの\nショートカット！",
            "zh": "那就再来一次，\n冲出赛道\n抄近道！",
            "narrator_zh": "透明雅"
        },
        {
            "location": "81/TALK",
            "narrator": "透明神楽",
            "text": "それこそ卑怯じゃ\nないですか！",
            "zh": "那才真的算\n卑鄙吧！",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "83/TALK",
            "narrator": "透明みやび",
            "text": "コースアウト判定が\n出る前に復帰しちゅうき、\nルール上問題なしぞね。",
            "zh": "在判定出界前\n就回到赛道了啵，\n按规则没得问题咧。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "84/TALK",
            "narrator": "透明みやび",
            "text": "さあ、このレースも\nうちがもらうぞね。",
            "zh": "来吧，这一局\n也归我拿下了咧。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "87/TALK",
            "narrator": "透明神楽",
            "text": "そうはいきません。\n今度こそは絶対に――",
            "zh": "我可不会让你得逞。\n这一次绝对要——",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "93/TALK",
            "narrator": "透明神楽",
            "text": "えっ！？",
            "zh": "诶！？",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "94/TALK",
            "narrator": "透明みやび",
            "text": "ぬぁっ！？",
            "zh": "唔哇！？",
            "narrator_zh": "透明雅"
        },
        {
            "location": "96/TALK",
            "narrator": "透明真幌",
            "text": "…みやび、卯月。\nなにをやっているんだ？",
            "zh": "……雅、卯月。\n你们在干什么？",
            "narrator_zh": "透明真幌"
        },
        {
            "location": "97/TALK",
            "narrator": "透明神楽",
            "text": "ま、真幌さん！？",
            "zh": "真、真幌！？",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "99/TALK",
            "narrator": "透明みやび",
            "text": "なにするがですか！？\nってかなぜここに！？",
            "zh": "干驷马啊！？\n不对，你怎么会在这里！？",
            "narrator_zh": "透明雅"
        },
        {
            "location": "100/TALK",
            "narrator": "透明真幌",
            "text": "…連絡も取れず、\n散々探させておいて\n何をしてる？",
            "zh": "……联系也联系不上，\n害我一通好找，\n结果在这干什么呢？",
            "narrator_zh": "透明真幌"
        },
        {
            "location": "101/TALK",
            "narrator": "透明みやび",
            "text": "うちらはゲームデートを\n楽しんどる最中だったが\nですよ。",
            "zh": "我们俩正玩着\n游戏约会，开心得\n很呢。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "103/TALK",
            "narrator": "透明みやび",
            "text": "っていうか、どうして\nコンセント抜いたり\nしたんです？",
            "zh": "话说回来，为驷马\n要突然把插头\n拔掉啊？",
            "narrator_zh": "透明雅"
        },
        {
            "location": "104/TALK",
            "narrator": "透明神楽",
            "text": "そうですよ。\nせっかく、今度こそ\n私が勝ったのに…。",
            "zh": "就是啊。\n好不容易这一次\n明明是我要赢了……",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "105/TALK",
            "narrator": "透明みやび",
            "text": "いや、うちの方が\nリードしちょったぞね。",
            "zh": "才怪，明明是我\n这边领先咧。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "106/TALK",
            "narrator": "透明神楽",
            "text": "でも私は加速してたから\nゴール直前で絶対に\n抜いてましたよ。",
            "zh": "可是我在加速呀，\n终点线前肯定\n能超过去的。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "107/TALK",
            "narrator": "透明真幌",
            "text": "あのな…二人とも、\nいま何時か言ってみろ",
            "zh": "我说……你们俩，\n报一下现在几点了",
            "narrator_zh": "透明真幌"
        },
        {
            "location": "108/TALK",
            "narrator": "透明みやび",
            "text": "１６時？　まだ日も暮れ\nとらんですけど？",
            "zh": "１６点？　天都还没黑\n下来呢？",
            "narrator_zh": "透明雅"
        },
        {
            "location": "109/TALK",
            "narrator": "透明神楽",
            "text": "それがどうか\nしたんですか？",
            "zh": "这个时间\n有什么问题吗？",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "110/TALK",
            "narrator": "透明真幌",
            "text": "うむ、そうだ。",
            "zh": "嗯，没错。",
            "narrator_zh": "透明真幌"
        },
        {
            "location": "111/TALK",
            "narrator": "透明真幌",
            "text": "で…おまえ達は今日\nこの時間、本当なら\nどこにいるはずだ？",
            "zh": "那么……你们俩今天\n这个时间，照理说\n应该在哪里？",
            "narrator_zh": "透明真幌"
        },
        {
            "location": "113/TALK",
            "narrator": "透明神楽",
            "text": "…あっ！",
            "zh": "……啊！",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "115/TALK",
            "narrator": "透明神楽",
            "text": "そ、そうでした…。\n今日は劇場のシフトが\n入ってたんでした…。",
            "zh": "对、对哦……\n今天排了\n剧场的班来着……",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "118/TALK",
            "narrator": "透明みやび",
            "text": "あ、あれぇ？\nそう…やったが？",
            "zh": "咦、咦？\n是……那样咩？",
            "narrator_zh": "透明雅"
        },
        {
            "location": "119/TALK",
            "narrator": "透明みやび",
            "text": "実はその…お休みを\n申請しとった、なんて\n落ちありません？",
            "zh": "其实那个……我们早就\n请过假了，难道没得\n这种反转咩？",
            "narrator_zh": "透明雅"
        },
        {
            "location": "120/TALK",
            "narrator": "透明真幌",
            "text": "なぜ私がわざわざ\nお前たちを探したか――",
            "zh": "我为什么要专程\n过来找你们俩——",
            "narrator_zh": "透明真幌"
        },
        {
            "location": "121/TALK",
            "narrator": "透明真幌",
            "text": "賢いお前たちなら、\nこの意味が分かるよな？",
            "zh": "聪明的你们俩，\n能明白这是什么意思吧？",
            "narrator_zh": "透明真幌"
        },
        {
            "location": "122/TALK",
            "narrator": "透明みやび",
            "text": "…………<size=15>めっちゃ怒っとる</size>。",
            "zh": "…………<size=15>她气炸了</size>。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "124/TALK",
            "narrator": "透明神楽",
            "text": "…………<size=15>あはは</size>。",
            "zh": "…………<size=15>啊哈哈</size>。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "125/TALK",
            "narrator": "透明真幌",
            "text": "デートは終わりだ。\n仕事に戻れ。",
            "zh": "约会到此为止。\n回去干活。",
            "narrator_zh": "透明真幌"
        },
        {
            "location": "126/TALK",
            "narrator": "透明神楽",
            "text": "…わかりました。",
            "zh": "……知道了。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "127/TALK",
            "narrator": "透明みやび",
            "text": "はぁ…。\nつばめちゃんたちには\nアイスでもこうてくか。",
            "zh": "唉……\n给燕她们捎点\n冰淇淋过去吧。",
            "narrator_zh": "透明雅"
        }
    ]
}
