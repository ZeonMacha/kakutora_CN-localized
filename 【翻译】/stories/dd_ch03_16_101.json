{
    "dir": "chap16/daydra/dd_ch03_16_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "16302",
        "cid": "gabriella",
        "title": "002 メインストーリー",
        "sub_title": "プライベートタイム＜前編＞",
        "title_zh": "002 主线剧情",
        "sub_title_zh": "私人时间＜前篇＞"
    },
    "entry": [
        {
            "location": "29/TALK",
            "narrator": "雛",
            "text": "つばめちゃん。\n帰りにカフェに\n寄ってかない？",
            "zh": "燕。\n回去路上要不要顺道\n去咖啡店呀？",
            "narrator_zh": "雏"
        },
        {
            "location": "32/TALK",
            "narrator": "つばめ",
            "text": "ごめん…。\n今日、バイトのシフト\n入ってて…。",
            "zh": "抱歉……。\n我今天排了打工的\n班次……。",
            "narrator_zh": "燕"
        },
        {
            "location": "33/TALK",
            "narrator": "雛",
            "text": "あれ？　今日って\nそうだったっけ？",
            "zh": "咦？　今天\n有排班吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "34/TALK",
            "narrator": "繭",
            "text": "キリト達と一緒に\nシフト入ってたはず。",
            "zh": "她应该是和圣翔他们\n排在同一班。",
            "narrator_zh": "茧"
        },
        {
            "location": "35/TALK",
            "narrator": "つばめ",
            "text": "うん。そういうこと\nだから、今日は先に\n帰るね。",
            "zh": "嗯。就是这么回事，\n所以我今天就\n先回去了哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "36/TALK",
            "narrator": "雛",
            "text": "おっけー。\nバイト頑張ってねー。",
            "zh": "好嘞—。\n打工加油哦—。",
            "narrator_zh": "雏"
        },
        {
            "location": "37/TALK",
            "narrator": "つばめ",
            "text": "うん、また明日ー。",
            "zh": "嗯，明天见—。",
            "narrator_zh": "燕"
        },
        {
            "location": "41/TALK",
            "narrator": "雛",
            "text": "…さてと、それじゃ\nどこ行こっか？",
            "zh": "……好吧，那咱们\n去哪儿呢？",
            "narrator_zh": "雏"
        },
        {
            "location": "43/TALK",
            "narrator": "繭",
            "text": "カフェでいいと思う。\n座れるし。",
            "zh": "去咖啡店挺好的。\n而且有座位。",
            "narrator_zh": "茧"
        },
        {
            "location": "45/TALK",
            "narrator": "雛",
            "text": "だねー。\nじゃ、それで。",
            "zh": "也是哦—。\n那就这么定了。",
            "narrator_zh": "雏"
        },
        {
            "location": "47/TALK",
            "narrator": "雛",
            "text": "あっ、\nガブリエラちゃん！",
            "zh": "啊，\n加布里埃拉！",
            "narrator_zh": "雏"
        },
        {
            "location": "53/TALK",
            "narrator": "ガブリエラ",
            "text": "あら、そっちも\n今帰り？",
            "zh": "哎呀，你们也是\n现在回家？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "54/TALK",
            "narrator": "雛",
            "text": "うん…もしかして、\n今日ってこれから\nバイト入ってる？",
            "zh": "嗯……该不会，\n你今天待会儿也\n排了打工吧？",
            "narrator_zh": "雏"
        },
        {
            "location": "55/TALK",
            "narrator": "ガブリエラ",
            "text": "え？　ううん、\n入ってないけど…。",
            "zh": "哎？　没有啊，\n没排班……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "56/TALK",
            "narrator": "雛",
            "text": "じゃ、決まりねー。\n一緒にカフェに行こ。",
            "zh": "那，就这么定了—。\n一起去咖啡店吧。",
            "narrator_zh": "雏"
        },
        {
            "location": "57/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょ！？　勝手に\n決めないでよ！",
            "zh": "喂！？　别擅自\n替我做决定啊！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "58/TALK",
            "narrator": "繭",
            "text": "何か予定でもあるの？",
            "zh": "你有什么安排吗？",
            "narrator_zh": "茧"
        },
        {
            "location": "60/TALK",
            "narrator": "ガブリエラ",
            "text": "べ、別にないけど…。",
            "zh": "倒、倒也不是有安排……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "61/TALK",
            "narrator": "雛",
            "text": "じゃあいいじゃん。\n手伝ってほしいことも\nあるんだしー。",
            "zh": "那不就行了嘛。\n正好也有事想请你\n帮帮忙嘛—。",
            "narrator_zh": "雏"
        },
        {
            "location": "63/TALK",
            "narrator": "ガブリエラ",
            "text": "は？",
            "zh": "哈？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "64/TALK",
            "narrator": "繭",
            "text": "アプリゲームで、\n今日から新しい\nイベントが始まるの。",
            "zh": "有款手游，\n今天起要开启\n新活动了。",
            "narrator_zh": "茧"
        },
        {
            "location": "65/TALK",
            "narrator": "繭",
            "text": "でも、攻略するには、\n一人でも多くの助けが\n必要…。",
            "zh": "不过，想要攻略的话，\n多一个人帮忙\n就多一分助力……。",
            "narrator_zh": "茧"
        },
        {
            "location": "66/TALK",
            "narrator": "ガブリエラ",
            "text": "アプリゲーム？\nああ、もしかして\nカプドラのこと？",
            "zh": "手游？\n啊啊，难道你是说\n卡普多拉？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "67/TALK",
            "narrator": "雛",
            "text": "そうそう！\nガブリエラちゃんも\nやってる？",
            "zh": "对对！\n加布里埃拉也在\n玩吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "69/TALK",
            "narrator": "ガブリエラ",
            "text": "まあね…。\nイベントのことは\n忘れてたけど。",
            "zh": "算是吧……。\n虽然活动的事\n我给忘了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "70/TALK",
            "narrator": "繭",
            "text": "やってるなら好都合。\n手伝ってほしい。",
            "zh": "也在玩那就再好不过。\n想请你帮个忙。",
            "narrator_zh": "茧"
        },
        {
            "location": "71/TALK",
            "narrator": "繭",
            "text": "協力プレイなら\n一日で結構進むと\n思う。",
            "zh": "要是联机合作的话，\n我觉得一天就能推进\n不少进度。",
            "narrator_zh": "茧"
        },
        {
            "location": "72/TALK",
            "narrator": "雛",
            "text": "だからさ、放課後は\n三人でカプドラして\n遊ぼうよ！",
            "zh": "所以嘛，放学后\n咱们三个人一起玩卡普多拉\n好好玩一通吧！",
            "narrator_zh": "雏"
        },
        {
            "location": "74/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "75/TALK",
            "narrator": "雛",
            "text": "あれ？　もしかして\nソロプレイ派？",
            "zh": "咦？　难道说\n你是单机党？",
            "narrator_zh": "雏"
        },
        {
            "location": "76/TALK",
            "narrator": "ガブリエラ",
            "text": "そ、そういうわけじゃ\nないけど…。",
            "zh": "倒、倒也不是\n那样……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "77/TALK",
            "narrator": "繭",
            "text": "何か問題？",
            "zh": "有什么问题吗？",
            "narrator_zh": "茧"
        },
        {
            "location": "79/TALK",
            "narrator": "ガブリエラ",
            "text": "え、えっと…。",
            "zh": "这、这个嘛……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "82/TALK",
            "narrator": "ガブリエラ",
            "text": "…なんか、やたらと\nフレンドリーに\n誘ってくるわね？",
            "zh": "……总觉得，你们俩\n邀请得也太\n自来熟了吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "83/TALK",
            "narrator": "ガブリエラ",
            "text": "そんなに仲がいいって\nわけじゃないのに…。",
            "zh": "明明也算不上\n关系有多铁……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "85/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "86/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、つばめの教室\nとか劇場ではよく\n話してるもの。",
            "zh": "不过，在燕的教室\n或者剧场里倒是\n经常聊天。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "87/TALK",
            "narrator": "ガブリエラ",
            "text": "これくらいは普通…\nなのかしら？",
            "zh": "这种程度算正常……\n的吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "88/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、放課後一緒に\nゲームするほどの\n仲じゃないし…",
            "zh": "可我们也没熟到放学后\n还一起玩游戏的\n地步吧……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "89/TALK",
            "narrator": "ガブリエラ",
            "text": "う～ん…。",
            "zh": "唔～……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "137/TALK",
            "narrator": "ガブリエラ",
            "text": "　",
            "zh": "　",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "153/TALK",
            "narrator": "ガブリエラ",
            "text": "あら、$handle$。\nいらっしゃい。",
            "zh": "哎呀，$handle$。\n欢迎光临。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "154/TALK",
            "narrator": "ガブリエラ",
            "text": "今回の悩みは\n何なのかしらね！",
            "zh": "这次的烦恼\n又是什么呢！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "161/TALK",
            "narrator": "ガブリエラ",
            "text": "オープンプロセス、\n0x333番地から\n0xFCC番地へ。",
            "zh": "开放进程，\n从0x333号地址\n前往0xFCC号地址。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "183/TALK",
            "narrator": "ガブリエラ",
            "text": "シーク完了っ♪",
            "zh": "搜索完成♪",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "187/TALK",
            "narrator": "ガブリエラ",
            "text": "それで、\n今回のあたしは……？",
            "zh": "那么，\n这次的我……？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "188/TALK",
            "narrator": "ガブリエラ",
            "text": "ああ、なるほど。\nあたしらしい悩みね。",
            "zh": "啊啊，原来如此。\n真是很有我风格的烦恼呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "189/SEL",
            "narrator": "",
            "text": "自分から見ると、放課後一緒にゲームするくらいの仲に見える",
            "zh": "在我看来，你们已经熟到放学后可以一起打游戏的程度了",
            "narrator_zh": ""
        },
        {
            "location": "190/SEL",
            "narrator": "",
            "text": "放課後遊ぶとなると、またちょっと構えちゃうよね",
            "zh": "一说到放学后出去玩，确实又会稍微端着一点吧",
            "narrator_zh": ""
        },
        {
            "location": "191/ACT",
            "narrator": "",
            "text": "自分から見ると、放課後一緒にゲームするくらいの仲に見える",
            "zh": "在我看来，你们已经熟到放学后可以一起打游戏的程度了",
            "narrator_zh": ""
        },
        {
            "location": "192/TALK",
            "narrator": "ガブリエラ",
            "text": "うーん、そういうもの\nなのかしらね？",
            "zh": "唔—，真是那样\n吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "193/ACT",
            "narrator": "",
            "text": "放課後遊ぶとなると、またちょっと構えちゃうよね",
            "zh": "一说到放学后出去玩，确实又会稍微端着一点吧",
            "narrator_zh": ""
        },
        {
            "location": "195/TALK",
            "narrator": "ガブリエラ",
            "text": "そうそう。\nそうなのよね。",
            "zh": "对对。\n就是这样嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "196/TALK",
            "narrator": "ガブリエラ",
            "text": "学校にいる時に仲良く\nお話するからって、\n放課後もっていうと――",
            "zh": "在学校的时候聊得\n再开心，可一说到\n放学后——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "197/TALK",
            "narrator": "ガブリエラ",
            "text": "それはそれで\n全然別の話だもの。",
            "zh": "那完全就是\n另一回事了嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "199/TALK",
            "narrator": "ガブリエラ",
            "text": "パブリックな時間と\nプライベートな時間では\n付き合い方も違うのよ。",
            "zh": "公共时间和\n私人时间的\n相处方式是不一样的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "200/TALK",
            "narrator": "ガブリエラ",
            "text": "学校にいる時間は\nパブリックな時間。",
            "zh": "待在学校的时间\n属于公共时间。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "201/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、解放されたら\nそこからはプライベートな\n時間なの。",
            "zh": "可一旦放了学，\n从那以后就是私人\n时间了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "202/TALK",
            "narrator": "ガブリエラ",
            "text": "プライベートな時間に\n一緒にいる人っていうのは\nやっぱり特別なのよね。",
            "zh": "会在私人时间里\n待在一起的人，\n果然还是比较特别的呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "203/SEL",
            "narrator": "",
            "text": "西洋的な考え方だね",
            "zh": "很西式的想法呢",
            "narrator_zh": ""
        },
        {
            "location": "204/SEL",
            "narrator": "",
            "text": "てことはアーヤは特別なんだね",
            "zh": "那也就是说绫水很特别咯",
            "narrator_zh": ""
        },
        {
            "location": "205/SEL",
            "narrator": "",
            "text": "てことはつばめは特別なんだね",
            "zh": "那也就是说燕很特别咯",
            "narrator_zh": ""
        },
        {
            "location": "206/SEL",
            "narrator": "",
            "text": "てことは$me$は特別なんだね",
            "zh": "那也就是说$me$很特别咯",
            "narrator_zh": ""
        },
        {
            "location": "207/ACT",
            "narrator": "",
            "text": "西洋的な考え方だね",
            "zh": "很西式的想法呢",
            "narrator_zh": ""
        },
        {
            "location": "209/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしからすれば、\n放課後までつき合うなんて\n日本的だと思うわよ？",
            "zh": "要我说的话，\n放学后还接着来往\n才很日式呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "210/TALK",
            "narrator": "ガブリエラ",
            "text": "まあでも、前に本で\n読んだけど、日本って\nそうなのよね。",
            "zh": "不过嘛，以前在书上\n读到过，日本好像\n就是这样呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "211/TALK",
            "narrator": "ガブリエラ",
            "text": "仕事終わってからも\n会社の人と飲んだり\nするんでしょう？",
            "zh": "下班之后也还会跟\n公司里的人去喝酒\n对吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "212/TALK",
            "narrator": "ガブリエラ",
            "text": "それって結構\nブルーよね。",
            "zh": "那样挺让人\nblue的吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "213/TALK",
            "narrator": "ガブリエラ",
            "text": "だって、朝から寝る前まで\n１日中仕事してるって\nことじゃない。",
            "zh": "因为不就等于从早到晚\n睡前为止，一整天都在\n上班吗。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "214/TALK",
            "narrator": "ガブリエラ",
            "text": "あれを読んだとき、\nちょっと目眩がしたわね。",
            "zh": "读到那段的时候，\n我都有点犯晕呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "215/SEL",
            "narrator": "",
            "text": "飲み会と仕事は違うよ",
            "zh": "聚餐和工作是不一样的啦",
            "narrator_zh": ""
        },
        {
            "location": "216/SEL",
            "narrator": "",
            "text": "その気持ちすごくわかる！！",
            "zh": "这种心情我太懂了！！",
            "narrator_zh": ""
        },
        {
            "location": "217/ACT",
            "narrator": "",
            "text": "飲み会と仕事は違うよ",
            "zh": "聚餐和工作是不一样的啦",
            "narrator_zh": ""
        },
        {
            "location": "218/TALK",
            "narrator": "ガブリエラ",
            "text": "そうなのね。\nそういう感覚なのね、\nやっぱり。",
            "zh": "这样啊。\n果然你们是这种\n感觉呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "219/TALK",
            "narrator": "ガブリエラ",
            "text": "日本のことは大好きだけど\nそこだけはどうしても\n共感できないのよね。",
            "zh": "虽然我很喜欢日本，\n但唯独这一点无论如何\n都共情不来呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "220/ACT",
            "narrator": "",
            "text": "その気持ちすごくわかる！！",
            "zh": "这种心情我太懂了！！",
            "narrator_zh": ""
        },
        {
            "location": "221/TALK",
            "narrator": "ガブリエラ",
            "text": "ほんと！？",
            "zh": "真的吗！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "222/TALK",
            "narrator": "ガブリエラ",
            "text": "やっぱり\n$handle$とは\n気が合うわね！",
            "zh": "果然我和\n$handle$\n很投缘呢！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "223/TALK",
            "narrator": "ガブリエラ",
            "text": "学校で昼間ずっと\n縛られてるんだもの！",
            "zh": "白天在学校里一直\n被束缚着嘛！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "224/TALK",
            "narrator": "ガブリエラ",
            "text": "放課後くらい、自分の\n自由意志で行動したい\nじゃない！",
            "zh": "至少放学以后，总想按\n自己的自由意志去行动\n不是吗！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "225/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしたち、\n似てるわね～♪",
            "zh": "我们俩，\n很像呢～♪",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "227/ACT",
            "narrator": "",
            "text": "てことはアーヤは特別なんだね",
            "zh": "那也就是说绫水很特别咯",
            "narrator_zh": ""
        },
        {
            "location": "229/TALK",
            "narrator": "ガブリエラ",
            "text": "え？\nそうかしら？",
            "zh": "哎？\n是这样吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "230/SEL",
            "narrator": "",
            "text": "放課後や休日一緒にいるよね",
            "zh": "你们放学后和休息日也经常待在一起吧",
            "narrator_zh": ""
        },
        {
            "location": "231/ACT",
            "narrator": "",
            "text": "放課後や休日一緒にいるよね",
            "zh": "你们放学后和休息日也经常待在一起吧",
            "narrator_zh": ""
        },
        {
            "location": "233/TALK",
            "narrator": "ガブリエラ",
            "text": "そんなこと――",
            "zh": "那种事——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "234/TALK",
            "narrator": "ガブリエラ",
            "text": "……た、たまたまよ。",
            "zh": "……只、只是碰巧啦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "235/TALK",
            "narrator": "ガブリエラ",
            "text": "たまたまあんたが\n見ている瞬間に、偶然\n一緒にいるだけだから。",
            "zh": "只是碰巧在你\n看着的那一瞬间，偶然\n待在一起而已。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "236/SEL",
            "narrator": "",
            "text": "そういうことにしておきますね",
            "zh": "那我就姑且当成是这样吧",
            "narrator_zh": ""
        },
        {
            "location": "237/ACT",
            "narrator": "",
            "text": "そういうことにしておきますね",
            "zh": "那我就姑且当成是这样吧",
            "narrator_zh": ""
        },
        {
            "location": "239/TALK",
            "narrator": "ガブリエラ",
            "text": "そ、そうよ！\nそれでいいのよ。",
            "zh": "对、对嘛！\n这样就对了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "240/ACT",
            "narrator": "",
            "text": "てことはつばめは特別なんだね",
            "zh": "那也就是说燕很特别咯",
            "narrator_zh": ""
        },
        {
            "location": "241/TALK",
            "narrator": "ガブリエラ",
            "text": "もちろんよ！\nつばめは特別なの！",
            "zh": "那当然啦！\n燕可是很特别的！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "242/TALK",
            "narrator": "ガブリエラ",
            "text": "現実のあたしは\n絶対に認めないけど。",
            "zh": "虽说现实里的我\n死也不会承认就是了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "243/ACT",
            "narrator": "",
            "text": "てことは$me$は特別なんだね",
            "zh": "那也就是说$me$很特别咯",
            "narrator_zh": ""
        },
        {
            "location": "244/TALK",
            "narrator": "ガブリエラ",
            "text": "ええ、そうね！\nあたしにとっては\nすごい特別よ？",
            "zh": "嗯，没错！\n对我而言\n可是超级特别的哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "245/SEL",
            "narrator": "",
            "text": "あたしにとって「は」？",
            "zh": "“对你而言”？",
            "narrator_zh": ""
        },
        {
            "location": "246/SEL",
            "narrator": "",
            "text": "ガブリエラ全体にとっては、だよね？",
            "zh": "是对整个加布里埃拉而言，才对吧？",
            "narrator_zh": ""
        },
        {
            "location": "247/ACT",
            "narrator": "",
            "text": "あたしにとって「は」？",
            "zh": "“对你而言”？",
            "narrator_zh": ""
        },
        {
            "location": "248/TALK",
            "narrator": "ガブリエラ",
            "text": "ええ。そうだけど？\n何か問題あったかしら？",
            "zh": "嗯。是啊？\n有什么问题吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "249/TALK",
            "narrator": "ガブリエラ",
            "text": "前にもお話ししたけど、\n$handle$は\nあたしの大切な人だもの。",
            "zh": "之前也跟你说过，\n$handle$可是\n对我很重要的人嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "250/SEL",
            "narrator": "",
            "text": "他の人格は？",
            "zh": "那其他人格呢？",
            "narrator_zh": ""
        },
        {
            "location": "251/ACT",
            "narrator": "",
            "text": "他の人格は？",
            "zh": "那其他人格呢？",
            "narrator_zh": ""
        },
        {
            "location": "253/TALK",
            "narrator": "ガブリエラ",
            "text": "んー、それはちょっと\nわからないかな。",
            "zh": "唔—，这个我也有点\n说不好呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "254/TALK",
            "narrator": "ガブリエラ",
            "text": "自分自身じゃないもの。",
            "zh": "毕竟不是我自己嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "255/ACT",
            "narrator": "",
            "text": "ガブリエラ全体にとっては、だよね？",
            "zh": "是对整个加布里埃拉而言，才对吧？",
            "narrator_zh": ""
        },
        {
            "location": "256/TALK",
            "narrator": "ガブリエラ",
            "text": "んー、それはちょっと\nわからないかな。",
            "zh": "唔—，这个我也有点\n说不好呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "257/TALK",
            "narrator": "ガブリエラ",
            "text": "自分自身じゃないもの。",
            "zh": "毕竟不是我自己嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "259/TALK",
            "narrator": "ガブリエラ",
            "text": "で、なんだったかしら。\nえっと――",
            "zh": "话又说回来，刚才聊到哪儿了。\n那个——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "260/TALK",
            "narrator": "ガブリエラ",
            "text": "あ、そうそう、\n放課後つき合うような仲か\nだったわね。",
            "zh": "啊，对了对了，\n是聊到算不算放学后会一起玩的交情\n来着呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "261/TALK",
            "narrator": "ガブリエラ",
            "text": "実際にどうかは\nわからないけど、あたしは\n一緒に遊びたいかしら。",
            "zh": "实际究竟怎么样\n我也不清楚，但我自己\n还是挺想一起玩的吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "262/TALK",
            "narrator": "ガブリエラ",
            "text": "郷には入れば郷に従え\nなんて言葉もあるけど、\nやっぱり刷り込みは強烈。",
            "zh": "虽说也有入乡随俗\n这样的说法，\n但打小印在脑子里的观念果然很强烈。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "263/TALK",
            "narrator": "ガブリエラ",
            "text": "どうしてもプライベートを\n共にするに値する相手か、\n値すると思われてるか。",
            "zh": "总会忍不住去在意对方\n值不值得共享私人时间，\n又或者对方是不是也觉得自己值得。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "264/TALK",
            "narrator": "ガブリエラ",
            "text": "そういうのを\n気にしちゃうのよね。",
            "zh": "就是会去在意\n这种事呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "265/SEL",
            "narrator": "",
            "text": "確かに子供の頃にやってたことって刷り込まれるよね",
            "zh": "确实小时候做过的事会深深印在脑子里呢",
            "narrator_zh": ""
        },
        {
            "location": "266/SEL",
            "narrator": "",
            "text": "もっと気楽に生きよう",
            "zh": "活得再随性一点吧",
            "narrator_zh": ""
        },
        {
            "location": "267/ACT",
            "narrator": "",
            "text": "確かに子供の頃にやってたことって刷り込まれるよね",
            "zh": "确实小时候做过的事会深深印在脑子里呢",
            "narrator_zh": ""
        },
        {
            "location": "268/TALK",
            "narrator": "ガブリエラ",
            "text": "ほんと。\n三つ子の魂百までって\n言うものね。",
            "zh": "真的。\n俗话不也说嘛，\n三岁看老。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "269/SEL",
            "narrator": "",
            "text": "ホントによく知ってるね",
            "zh": "你懂得真多啊",
            "narrator_zh": ""
        },
        {
            "location": "270/SEL",
            "narrator": "",
            "text": "流石に知識ありすぎじゃない？",
            "zh": "是不是懂过头了点？",
            "narrator_zh": ""
        },
        {
            "location": "271/ACT",
            "narrator": "",
            "text": "ホントによく知ってるね",
            "zh": "你懂得真多啊",
            "narrator_zh": ""
        },
        {
            "location": "272/TALK",
            "narrator": "ガブリエラ",
            "text": "ええ。\nいっぱい勉強したもの。\n日本に来るためにね。",
            "zh": "是啊。\n毕竟为了来日本，\n我可是拼命学过不少呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "273/ACT",
            "narrator": "",
            "text": "流石に知識ありすぎじゃない？",
            "zh": "是不是懂过头了点？",
            "narrator_zh": ""
        },
        {
            "location": "274/TALK",
            "narrator": "ガブリエラ",
            "text": "ん？\nなんだかちょっと\n訝しげな発言ね。",
            "zh": "嗯？\n你这话听起来\n怎么有点狐疑呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "275/TALK",
            "narrator": "ガブリエラ",
            "text": "普通に興味を持って\n勉強していれば、\nこれくらい覚えるわよ。",
            "zh": "只要有兴趣\n认真去学的话，\n这种程度自然就记住了哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "277/ACT",
            "narrator": "",
            "text": "もっと気楽に生きよう",
            "zh": "活得再随性一点吧",
            "narrator_zh": ""
        },
        {
            "location": "278/TALK",
            "narrator": "ガブリエラ",
            "text": "それができたらね～。",
            "zh": "要是真能那样就好了呢～。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "282/TALK",
            "narrator": "ガブリエラ",
            "text": "というわけで、\n今回もよろしくお願いね。",
            "zh": "总而言之，\n这次也拜托你咯。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "283/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしと\n$handle$にとって\n素敵なココロの旅を！",
            "zh": "祝我和\n$handle$都能拥有\n一段美好的心灵之旅！",
            "narrator_zh": "加布里埃拉"
        },
        {
