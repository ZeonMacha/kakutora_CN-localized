{
    "dir": "chap19/daydra/dd_ch03_19_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "19356",
        "cid": "gabriella",
        "title": "Extra005 プレミアムストーリー",
        "sub_title": "横須賀の祭り",
        "title_zh": "Extra005 额外剧情",
        "sub_title_zh": "横须贺的祭典"
    },
    "entry": [
        {
            "location": "324/SCENARIO",
            "narrator": "",
            "text": "横須賀の祭り",
            "zh": "横须贺的祭典",
            "narrator_zh": ""
        },
        {
            "location": "359/TALK",
            "narrator": "つばめ",
            "text": "わぁ！！",
            "zh": "哇！！",
            "narrator_zh": "燕"
        },
        {
            "location": "360/TALK",
            "narrator": "つばめ",
            "text": "横須賀って初めて\n来たけど、こんな大きな\nお祭りがやるんだね。",
            "zh": "我还是第一次\n来横须贺呢，没想到\n会有这么盛大的祭典呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "362/TALK",
            "narrator": "雛",
            "text": "つばめちゃんって、\n横須賀は初めて？",
            "zh": "燕你是\n第一次来横须贺吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "365/TALK",
            "narrator": "つばめ",
            "text": "うん！",
            "zh": "嗯！",
            "narrator_zh": "燕"
        },
        {
            "location": "367/TALK",
            "narrator": "キリト",
            "text": "それなら絶対行くべき\nおすすめスポットが――",
            "zh": "那可有个绝对不能错过的\n推荐地点——",
            "narrator_zh": "圣翔"
        },
        {
            "location": "368/TALK",
            "narrator": "つばめ",
            "text": "三笠公園のこと？",
            "zh": "你是说三笠公园吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "370/TALK",
            "narrator": "キリト",
            "text": "…バレバレかよ。",
            "zh": "……这就暴露了啊。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "372/TALK",
            "narrator": "雛",
            "text": "あはは、\nそりゃそうだよー。",
            "zh": "啊哈哈，\n那当然啦—。",
            "narrator_zh": "雏"
        },
        {
            "location": "374/TALK",
            "narrator": "繭",
            "text": "わからない方が\nおかしいから。",
            "zh": "猜不出来才\n奇怪吧。",
            "narrator_zh": "茧"
        },
        {
            "location": "376/TALK",
            "narrator": "ヒカル",
            "text": "でも、せっかくのお祭り\nなんですし、今日は\n公園ではなく――",
            "zh": "不过，难得赶上祭典嘛，\n今天与其去公园，\n不如——",
            "narrator_zh": "光"
        },
        {
            "location": "377/TALK",
            "narrator": "ヒカル",
            "text": "出店を見て周った方が\n良いと思いますよ？",
            "zh": "去逛逛那些摊位\n不是更好吗？",
            "narrator_zh": "光"
        },
        {
            "location": "380/TALK",
            "narrator": "キリト",
            "text": "…まあ、そうだな。\n三笠はどこにも\n逃げねぇし。",
            "zh": "……嘛，也是。\n反正三笠公园\n又不会长腿跑掉。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "382/TALK",
            "narrator": "つばめ",
            "text": "出店かぁ…どこを見に\n行こうかなぁ？",
            "zh": "摊位呀……去逛哪里\n比较好呢？",
            "narrator_zh": "燕"
        },
        {
            "location": "383/TALK",
            "narrator": "つばめ",
            "text": "やっぱり鯛焼き屋は\n譲れないよね。",
            "zh": "果然鲷鱼烧摊子\n绝对不能错过呢。",
            "narrator_zh": "燕"
        },
        {
            "location": "386/TALK",
            "narrator": "ガブリエラ",
            "text": "あんた、本当にそれしか\nないのね…。",
            "zh": "你呀，脑子里真就只剩\n那点东西了呢……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "387/TALK",
            "narrator": "ガブリエラ",
            "text": "そういえば、昨日ネットで\n調べた飴細工の屋台、\nどこににあるのかしら？",
            "zh": "说起来，昨天我在网上\n查到的糖人摊子，\n究竟摆在哪里呀？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "388/TALK",
            "narrator": "ガブリエラ",
            "text": "ホームページに\n場所が書いてあれば\nいいんだけど…。",
            "zh": "要是主页上\n写了具体位置\n就好了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "390/TALK",
            "narrator": "キリト",
            "text": "おいおい、逢瀬。\n祭りは食い物の屋台\nだけじゃないんだぜ？",
            "zh": "喂喂，逢濑。\n祭典可不光只有\n吃的东西的摊位啊？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "391/TALK",
            "narrator": "キリト",
            "text": "遊べるようなところも\n周らないと、勿体ないぞ。",
            "zh": "不也去玩玩那些游艺摊子的话，\n可就太亏了。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "393/TALK",
            "narrator": "つばめ",
            "text": "例えば？",
            "zh": "比如说呢？",
            "narrator_zh": "燕"
        },
        {
            "location": "394/TALK",
            "narrator": "キリト",
            "text": "へへっ、プラモ釣りだな。",
            "zh": "嘿嘿，当然是钓拼装模型啦。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "395/TALK",
            "narrator": "つばめ",
            "text": "それって、紐を引いた\n先にある景品がもらえる、\nあれ？",
            "zh": "就是拉一根绳子，\n能拿到绳子另一头\n挂着的奖品的那个吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "396/TALK",
            "narrator": "キリト",
            "text": "おう！\n今日こそは店の奥に\nドーンと飾ってある――",
            "zh": "没错！\n今天我非要把摆在店最里面\n气派十足的那个——",
            "narrator_zh": "圣翔"
        },
        {
            "location": "397/TALK",
            "narrator": "キリト",
            "text": "武蔵１／５００モデルを\nゲットしてやるぜ！！",
            "zh": "武藏1/500模型\n给钓到手不可！！",
            "narrator_zh": "圣翔"
        },
        {
            "location": "398/TALK",
            "narrator": "ヒカル",
            "text": "えっ！？\nキリト、それ本気ですか？",
            "zh": "哎！？\n圣翔，你是认真的吗？",
            "narrator_zh": "光"
        },
        {
            "location": "400/TALK",
            "narrator": "キリト",
            "text": "当然！　気合い入れて\n武蔵を引き寄せてやるぜ！",
            "zh": "当然！我要卯足干劲\n把武藏号给拽过来！",
            "narrator_zh": "圣翔"
        },
        {
            "location": "402/TALK",
            "narrator": "雛",
            "text": "うわぁ…\n本気で信じちゃってる\nみたい…。",
            "zh": "哇啊……\n他好像真的\n信以为真了……。",
            "narrator_zh": "雏"
        },
        {
            "location": "405/TALK",
            "narrator": "繭",
            "text": "それ、絶対糸繋がって\nないから。",
            "zh": "那个，绳子绝对\n没连着奖品好吗。",
            "narrator_zh": "茧"
        },
        {
            "location": "406/TALK",
            "narrator": "繭",
            "text": "全財産つぎ込んでも\n絶対取れないから。",
            "zh": "就算把全部家当砸进去\n也绝对拿不到的。",
            "narrator_zh": "茧"
        },
        {
            "location": "408/TALK",
            "narrator": "キリト",
            "text": "はぁ…夢の無い奴だな。",
            "zh": "哈……真是没梦想的家伙。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "410/TALK",
            "narrator": "ガブリエラ",
            "text": "キリト君は夢しか\n見えてないようね…。",
            "zh": "圣翔眼里倒是只剩\n做梦了呢……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "411/TALK",
            "narrator": "キリト",
            "text": "繭は何見るんだよ？",
            "zh": "茧你想逛什么啊？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "412/TALK",
            "narrator": "繭",
            "text": "ＰＣパーツ釣り。",
            "zh": "钓PC零件。",
            "narrator_zh": "茧"
        },
        {
            "location": "415/TALK",
            "narrator": "ガブリエラ",
            "text": "…秋葉原のお祭りでも、\nそんなの見たことないん\nだけど？",
            "zh": "……就算在秋叶原的祭典上，\n我也没见过\n这种摊子好吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "416/TALK",
            "narrator": "キリト",
            "text": "こんだけデカいんだ。\n探せばありそうだよな。",
            "zh": "这么大的祭典呢。\n找找说不定真有吧。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "418/TALK",
            "narrator": "雛",
            "text": "じゃあ、あたしは\n鉄道模型釣りがいい！",
            "zh": "那我想要\n钓铁道模型！",
            "narrator_zh": "雏"
        },
        {
            "location": "421/TALK",
            "narrator": "ガブリエラ",
            "text": "…ふざけてるのか\n真面目なのか、いまいち\n判断できないわね？",
            "zh": "……你们到底是在开玩笑\n还是认真的，一时间还真\n有点判断不出来呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "423/TALK",
            "narrator": "つばめ",
            "text": "楽しくて仕方ないんだよ。",
            "zh": "他们只是玩得太开心了呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "424/TALK",
            "narrator": "つばめ",
            "text": "ヒカルくんはどうするの？",
            "zh": "光打算去逛什么呢？",
            "narrator_zh": "燕"
        },
        {
            "location": "425/TALK",
            "narrator": "ヒカル",
            "text": "僕は、飴細工を見に\n行こうと思ってます。",
            "zh": "我打算去看\n糖人摊子。",
            "narrator_zh": "光"
        },
        {
            "location": "426/TALK",
            "narrator": "ガブリエラ",
            "text": "えっ！？",
            "zh": "哎！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "428/TALK",
            "narrator": "雛",
            "text": "飴細工釣り？\nいいと思うよー。",
            "zh": "钓糖人吗？\n我觉得不错哟—。",
            "narrator_zh": "雏"
        },
        {
            "location": "429/TALK",
            "narrator": "ヒカル",
            "text": "ち、違いますよ。\n普通の飴細工です。",
            "zh": "不、不是啦。\n就是普通的糖人摊子。",
            "narrator_zh": "光"
        },
        {
            "location": "430/TALK",
            "narrator": "ヒカル",
            "text": "ここの出店に、毎年凄い\n人が出店しているのを――",
            "zh": "听说这边的祭典上，每年都会有\n一位手艺超群的师傅来摆摊——",
            "narrator_zh": "光"
        },
        {
            "location": "431/TALK",
            "narrator": "ヒカル",
            "text": "昨日、ネットで見つけて\n知ったんです。",
            "zh": "我昨天在网上\n刚好查到的。",
            "narrator_zh": "光"
        },
        {
            "location": "433/TALK",
            "narrator": "キリト",
            "text": "…おまえ、本当に\n枯れてるよな？",
            "zh": "……你这家伙，\n心态还真是老成啊？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "434/TALK",
            "narrator": "ヒカル",
            "text": "そ、そうでしょうか？",
            "zh": "是、是这样吗？",
            "narrator_zh": "光"
        },
        {
            "location": "436/TALK",
            "narrator": "ガブリエラ",
            "text": "…飴細工見るのは、\nもう無理そうね。",
            "zh": "……看来想去看糖人，\n已经没戏了呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "439/SEL",
            "narrator": "",
            "text": "ヒカルと趣味が合うね",
            "zh": "你和光兴趣很投缘呢",
            "narrator_zh": ""
        },
        {
            "location": "440/SEL",
            "narrator": "",
            "text": "片っ端から周れば？",
            "zh": "干脆一家家全逛过去不就好了？",
            "narrator_zh": ""
        },
        {
            "location": "441/SEL",
            "narrator": "",
            "text": "逆に意識してると思われそう",
            "zh": "那样反而会被以为你在刻意避嫌吧",
            "narrator_zh": ""
        },
        {
            "location": "444/TALK",
            "narrator": "ガブリエラ",
            "text": "…あたしも飴細工が\n見たいって言ったら――",
            "zh": "……要是我也说想去看\n糖人摊子的话——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "445/TALK",
            "narrator": "ガブリエラ",
            "text": "またヒカル君とのことを\n誤解されそうだし…。",
            "zh": "肯定又要被误会\n我和光之间有什么了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "448/TALK",
            "narrator": "つばめ",
            "text": "ガブちゃんは\n何を見たいの？",
            "zh": "加布你\n想看什么呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "451/TALK",
            "narrator": "ガブリエラ",
            "text": "…別に。\n特に決めてないわ。",
            "zh": "……没什么。\n还没特别决定呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "452/TALK",
            "narrator": "つばめ",
            "text": "そっか…。\nじゃあ、私と一緒に\n周ろう。",
            "zh": "这样啊……。\n那，跟我一起\n逛吧。",
            "narrator_zh": "燕"
        },
        {
            "location": "454/TALK",
            "narrator": "キリト",
            "text": "よーし、そんじゃ花火の\n時間になったら、会場で\n落ち合おうぜ。",
            "zh": "好嘞，那就到放烟花的\n时间点，在会场\n碰头吧。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "456/TALK",
            "narrator": "雛",
            "text": "繭ちん、鉄道模型と\nＰＣパーツ釣り探しに\n行こう！",
            "zh": "小茧，我们去找\n钓铁道模型和\n钓PC零件的摊位吧！",
            "narrator_zh": "雏"
        },
        {
            "location": "457/TALK",
            "narrator": "繭",
            "text": "いや、絶対無いし。",
            "zh": "不，绝对没有的。",
            "narrator_zh": "茧"
        },
        {
            "location": "458/TALK",
            "narrator": "雛",
            "text": "ぶらつこう、って\nことだよー。\n繭ちんはニブちんだなぁ。",
            "zh": "就是说咱们去\n随便溜达溜达啦—。\n小茧真是个大木头呀。",
            "narrator_zh": "雏"
        },
        {
            "location": "478/TALK",
            "narrator": "ヒカル",
            "text": "では、また後で。",
            "zh": "那么，待会儿见。",
            "narrator_zh": "光"
        },
        {
            "location": "482/TALK",
            "narrator": "つばめ",
            "text": "じゃあ、わたしたちも\n行こっか？",
            "zh": "那，我们也\n出发吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "483/TALK",
            "narrator": "ガブリエラ",
            "text": "うん…。",
            "zh": "嗯……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "485/TALK",
            "narrator": "ガブリエラ",
            "text": "…見たかったなぁ…。",
            "zh": "……好想看啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "487/ACT",
            "narrator": "",
            "text": "ヒカルと趣味が合うね",
            "zh": "你和光兴趣很投缘呢",
            "narrator_zh": ""
        },
        {
            "location": "503/TALK",
            "narrator": "ガブリエラ",
            "text": "そうやってからかわれるのが嫌なの！",
            "zh": "我最讨厌这样被拿来打趣了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "515/TALK",
            "narrator": "ガブリエラ",
            "text": "まったく、$marzanna$まで\n言ってくるなんて…。",
            "zh": "真是的，连$marzanna$都\n这么调侃我……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "516/TALK",
            "narrator": "つばめ",
            "text": "ガブちゃんは\n何を見たいの？",
            "zh": "加布你\n想看什么呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "518/ACT",
            "narrator": "",
            "text": "片っ端から周れば？",
            "zh": "干脆一家家全逛过去不就好了？",
            "narrator_zh": ""
        },
        {
            "location": "533/TALK",
            "narrator": "ガブリエラ",
            "text": "それよ！",
            "zh": "就是这个！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "534/TALK",
            "narrator": "ガブリエラ",
            "text": "一軒ずつ周れば、飴細工の店にも自然に行くことができるわ",
            "zh": "只要一家家逛过去，就能顺理成章地逛到糖人摊子了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "535/TALK",
            "narrator": "ガブリエラ",
            "text": "冴えてるわね、$marzanna$",
            "zh": "脑子转得真快呢，$marzanna$",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "546/TALK",
            "narrator": "つばめ",
            "text": "ガブちゃんは\n何を見たいの？",
            "zh": "加布你\n想看什么呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "549/TALK",
            "narrator": "ガブリエラ",
            "text": "とりあえず、一通り見て\n周るつもりよ。",
            "zh": "总之，我打算把这边\n全部逛上一圈哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "551/TALK",
            "narrator": "雛",
            "text": "おっ、やる気満々だねー。",
            "zh": "哦，干劲十足嘛—。",
            "narrator_zh": "雏"
        },
        {
            "location": "552/TALK",
            "narrator": "繭",
            "text": "出店の数が多いから、\n意外と難しそうだと\n思うけど。",
            "zh": "这里的摊位数量这么多，\n我觉得意外地\n挺难逛完的。",
            "narrator_zh": "茧"
        },
        {
            "location": "553/TALK",
            "narrator": "ガブリエラ",
            "text": "ちゃっちゃと見て\n周るから平気よ。",
            "zh": "我会麻利地逛过去的，\n没问题啦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "555/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしの本命は、\n飴細工なんだから。",
            "zh": "毕竟我真正想看的，\n可是糖人摊子啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "557/TALK",
            "narrator": "キリト",
            "text": "よーし、そんじゃ花火の\n時間になったら、会場で\n落ち合おうぜ。",
            "zh": "好嘞，那就到放烟花的\n时间点，在会场\n碰头吧。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "574/TALK",
            "narrator": "ガブリエラ",
            "text": "…うわっ、\nもうこんな時間じゃん！？",
            "zh": "……哇，\n都已经这个时间了吗！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "575/TALK",
            "narrator": "ガブリエラ",
            "text": "もうそろそろ花火が\n始まっちゃう…。",
            "zh": "烟花大会马上\n就要开始了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "576/TALK",
            "narrator": "ガブリエラ",
            "text": "まだ飴細工\n見てないのに…。",
            "zh": "我连糖人摊子\n都还没看到呢……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "578/TALK",
            "narrator": "ガブリエラ",
            "text": "…あ、何あの店！？\n青いリンゴ飴とか\n売ってるし！",
            "zh": "……啊，那是什么摊子！？\n居然还在卖蓝色\n苹果糖啊！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "579/TALK",
            "narrator": "ガブリエラ",
            "text": "…面白そう。\nあれは買わないと！",
            "zh": "……好有趣。\n那个非买不可！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "582/TALK",
            "narrator": "神楽",
            "text": "ここにいたんですね、\nガブちゃん。",
            "zh": "原来你在这里呀，\n加布。",
            "narrator_zh": "神乐"
        },
        {
            "location": "585/TALK",
            "narrator": "つばめ",
            "text": "見つけたよ。\nほら、もうすぐ花火が\n始まる時間だから――",
            "zh": "找到你啦。\n好啦，马上就要到\n放烟花的时间了——",
            "narrator_zh": "燕"
        },
        {
            "location": "586/TALK",
            "narrator": "つばめ",
            "text": "急いで会場行こう。",
            "zh": "快点去会场吧。",
            "narrator_zh": "燕"
        },
        {
            "location": "589/TALK",
            "narrator": "ガブリエラ",
            "text": "えっ！？\nで、でも、まだあたし、\nお店見てないし…。",
            "zh": "哎！？\n可、可是，我还有摊位\n没逛到呢……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "590/TALK",
            "narrator": "神楽",
            "text": "全然見てないんですか？",
            "zh": "你完全没逛到吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "591/TALK",
            "narrator": "ガブリエラ",
            "text": "いや、沢山見はした\nけど…。",
            "zh": "不，倒是已经逛了\n好多了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "592/TALK",
            "narrator": "神楽",
            "text": "それじゃあ、早く花火を\n見に行きましょう。",
            "zh": "既然这样，那就快点\n去看烟花吧。",
            "narrator_zh": "神乐"
        },
        {
            "location": "593/TALK",
            "narrator": "神楽",
            "text": "もう全員揃って、\nあとはガブちゃんだけ\nなんですよ？",
            "zh": "大家都已经到齐了，\n现在就差加布\n你一个人了哦？",
            "narrator_zh": "神乐"
        },
        {
            "location": "594/TALK",
            "narrator": "つばめ",
            "text": "さ、ガブちゃん。\nこっちこっち！",
            "zh": "来，加布。\n这边这边！",
            "narrator_zh": "燕"
        },
        {
            "location": "596/TALK",
            "narrator": "ガブリエラ",
            "text": "えぇっ！？\nちょ、そんな…！",
            "zh": "哎哎！？\n等、怎么这样……！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "597/TALK",
            "narrator": "ガブリエラ",
            "text": "飴細工見たかったのにー！",
            "zh": "我本来还想看糖人的呀—！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "598/ACT",
            "narrator": "",
            "text": "逆に意識してると思われそう",
            "zh": "那样反而会被以为你在刻意避嫌吧",
            "narrator_zh": ""
        },
        {
            "location": "614/TALK",
            "narrator": "ガブリエラ",
            "text": "$marzanna$はそう思うの？",
            "zh": "$marzanna$是这么想的吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "615/TALK",
            "narrator": "ガブリエラ",
            "text": "それじゃ、どう答えたらいいのよ…",
            "zh": "那我到底该怎么回答才好啊……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "616/TALK",
            "narrator": "ガブリエラ",
            "text": "…混乱してきたわ",
            "zh": "……越想越乱了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "628/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "629/TALK",
            "narrator": "つばめ",
            "text": "ガブちゃんは\n何を見たいの？",
            "zh": "加布你\n想看什么呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "630/TALK",
            "narrator": "ガブリエラ",
            "text": "うん…。",
            "zh": "嗯……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "631/TALK",
            "narrator": "ガブリエラ",
            "text": "…やっぱり、正直に\n飴細工って言おう。",
            "zh": "……果然，还是老实说\n想看糖人吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "632/TALK",
            "narrator": "ガブリエラ",
            "text": "我慢してたら、\n全然楽しめないと思うし。",
            "zh": "一直忍着的话，\n肯定也玩得不痛快。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "634/TALK",
            "narrator": "ガブリエラ",
            "text": "…あ、あたしも、\n飴細工を見たいの。",
            "zh": "……我、我也想\n去看糖人。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "635/TALK",
            "narrator": "つばめ",
            "text": "…やっぱり。\nガブちゃんは飴細工を\n見たがると思ったよ。",
            "zh": "……我就知道。\n我就猜到加布肯定\n也想去看糖人的。",
            "narrator_zh": "燕"
        },
        {
            "location": "637/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "639/TALK",
            "narrator": "雛",
            "text": "うん、あたしも思ってた。",
            "zh": "嗯，我也是这么猜的。",
            "narrator_zh": "雏"
        },
        {
            "location": "640/TALK",
            "narrator": "雛",
            "text": "ガブリエラちゃん、\nそういうの大好き\nだもんね。",
            "zh": "毕竟加布里埃拉\n最喜欢这种传统手艺\n了嘛。",
            "narrator_zh": "雏"
        },
        {
            "location": "642/TALK",
            "narrator": "ガブリエラ",
            "text": "…えっ？",
            "zh": "……哎？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "643/TALK",
            "narrator": "つばめ",
            "text": "日本の文化的な物に\n目がないのは、\nみんな知ってるよ。",
            "zh": "你对日本文化类的东西\n毫无抵抗力这件事，\n大家都知道哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "645/TALK",
            "narrator": "繭",
            "text": "そうでなくても、\n見たことがないなら\nあれは一見の価値あり。",
            "zh": "退一步讲，\n如果以前没见过的话，\n那个确实很值得一见。",
            "narrator_zh": "茧"
        },
        {
            "location": "646/TALK",
            "narrator": "繭",
            "text": "ていうか、見ないと\n勿体ない。",
            "zh": "倒不如说，不看\n才亏了呢。",
            "narrator_zh": "茧"
        },
        {
            "location": "648/TALK",
            "narrator": "キリト",
            "text": "でも、これでまた\n楽屋に物が増えることに\nなりそうだな。",
            "zh": "不过，这样一来\n后台休息室里的东西\n又要变多了啊。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "649/TALK",
            "narrator": "雛",
            "text": "そりゃそうだよー。\n飴細工って、食べるより\n飾る方がメインだし。",
            "zh": "那是当然啦—。\n糖人这东西，主要还是\n用来摆着欣赏而不是吃的嘛。",
            "narrator_zh": "雏"
        },
        {
            "location": "651/TALK",
            "narrator": "雛",
            "text": "ヒカルくんも\nそのつもりでしょ？",
            "zh": "光你也是\n这么打算的对吧？",
            "narrator_zh": "雏"
        },
        {
            "location": "652/TALK",
            "narrator": "ヒカル",
            "text": "もちろんです。\nどこに飾るかは、\nまだ考え中ですが…。",
            "zh": "那是自然。\n至于要摆在哪里，\n目前还在考虑中就是了……。",
            "narrator_zh": "光"
        },
        {
            "location": "653/TALK",
            "narrator": "ガブリエラ",
            "text": "…なんか、あたしの\n思ってた反応と違う？",
            "zh": "……总觉得，跟我想象中\n大家的反应不太一样？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "655/TALK",
            "narrator": "ガブリエラ",
            "text": "絶対からかわれると\n思ってたのに…。",
            "zh": "我还以为绝对会\n被大家打趣呢……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "657/TALK",
            "narrator": "ヒカル",
            "text": "飴細工の屋台の場所は\n向こうですが、えっと…。",
            "zh": "糖人摊子的位置\n在那边，那个……。",
            "narrator_zh": "光"
        },
        {
            "location": "659/TALK",
            "narrator": "ヒカル",
            "text": "そうだ、よろしければ\n逢瀬さんも一緒に\n行きませんか？",
            "zh": "对了，如果不介意的话，\n逢濑也一起\n过去看看吗？",
            "narrator_zh": "光"
        },
        {
            "location": "660/TALK",
            "narrator": "つばめ",
            "text": "うん、それだとわたしも\n嬉しいな。",
            "zh": "嗯，那样的话我也\n很开心呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "661/TALK",
            "narrator": "つばめ",
            "text": "鯛焼き以外は、\n特に見るもの\n決めてなかったし。",
            "zh": "除了鲷鱼烧之外，\n我也没特别定好\n要逛什么嘛。",
            "narrator_zh": "燕"
        },
        {
            "location": "663/TALK",
            "narrator": "キリト",
            "text": "よーし、そんじゃ花火の\n時間になったら、会場で\n落ち合おうぜ。",
            "zh": "好嘞，那就到放烟花的\n时间点，在会场\n碰头吧。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "664/TALK",
            "narrator": "雛",
            "text": "繭ちん、鉄道模型と\nＰＣパーツ釣り探しに\n行こう！",
            "zh": "小茧，我们去找\n钓铁道模型和\n钓PC零件的摊位吧！",
            "narrator_zh": "雏"
        },
        {
            "location": "665/TALK",
            "narrator": "繭",
            "text": "いや、絶対無いし。",
            "zh": "不，绝对没有的。",
            "narrator_zh": "茧"
        },
        {
            "location": "666/TALK",
            "narrator": "雛",
            "text": "ぶらつこう、って\nことだよー。\n繭ちんはニブちんだなぁ。",
            "zh": "就是说咱们去\n随便溜达溜达啦—。\n小茧真是个大木头呀。",
            "narrator_zh": "雏"
        },
        {
            "location": "685/TALK",
            "narrator": "ヒカル",
            "text": "では、僕達も\n行きましょうか。",
            "zh": "那么，我们也\n出发吧。",
            "narrator_zh": "光"
        },
        {
            "location": "686/TALK",
            "narrator": "つばめ",
            "text": "うん。\n楽しみだね、ガブちゃん！",
            "zh": "嗯。\n好期待呀，加布！",
            "narrator_zh": "燕"
        },
        {
            "location": "688/TALK",
            "narrator": "ガブリエラ",
            "text": "…うん。",
            "zh": "……嗯。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "690/TALK",
            "narrator": "ガブリエラ",
            "text": "我慢しないで良かった…。\n飴細工、早く見たいな。",
            "zh": "幸好没有忍着不说……。\n真想快点看到糖人呀。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "358/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>8月20日　 6:50 PM</color>\n合宿中、横須賀のお祭りにて",
            "zh": "<color=green>8月20日　 6:50 PM</color>\n合宿中，在横须贺的祭典上",
            "narrator_zh": "Dialog_EventData"
        }
    ]
}
