{
    "dir": "chap07/daydra/dd_ch03_07_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "7302",
        "cid": "gabriella",
        "title": "002 メインストーリー",
        "sub_title": "リーダーに望むものは＜前編＞",
        "title_zh": "002 主线剧情",
        "sub_title_zh": "对队长所期望的是＜前篇＞"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "リーダーに望むものは",
            "zh": "对队长所期望的是",
            "narrator_zh": ""
        },
        {
            "location": "38/TALK",
            "narrator": "ガブリエラ",
            "text": "まったく、どうして\nあたしが新人の\n援護なのよ？",
            "zh": "真是的，为什么\n非要我去给新人\n做援护啊？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "39/TALK",
            "narrator": "ガブリエラ",
            "text": "まほもアーヤも、\n新人が入ったからって\n色めきだち過ぎよ。",
            "zh": "真幌和绫水也是，\n就因为来了个新人，\n兴奋过头了吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "46/TALK",
            "narrator": "ガブリエラ",
            "text": "…でも、神楽の方は\nかなり腕が立ちそうな\n感じね。",
            "zh": "……不过，神乐那边\n感觉身手倒是\n相当不错呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "47/TALK",
            "narrator": "ガブリエラ",
            "text": "新人だから、ちょっと\n荒くはあるけど。",
            "zh": "虽然因为是新人，\n手法还有点粗糙就是了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "54/TALK",
            "narrator": "ガブリエラ",
            "text": "…前回も今回も、\nあたしが援護に\n回されてるのって――",
            "zh": "……上次也好这次也好，\n总是把我安排去\n做援护——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "56/TALK",
            "narrator": "ガブリエラ",
            "text": "まほは、あたしの腕を\n信用してない、って\nこと？",
            "zh": "真幌是信不过\n我的本事，\n是这意思吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "67/SEL",
            "narrator": "",
            "text": "そんなことない",
            "zh": "没有那种事",
            "narrator_zh": ""
        },
        {
            "location": "68/SEL",
            "narrator": "",
            "text": "実際、甘く見られてる",
            "zh": "确实被小看了",
            "narrator_zh": ""
        },
        {
            "location": "69/ACT",
            "narrator": "",
            "text": "そんなことない",
            "zh": "没有那种事",
            "narrator_zh": ""
        },
        {
            "location": "74/TALK",
            "narrator": "ガブリエラ",
            "text": "マルザンナかしら？\nこんな時になんなの？",
            "zh": "是玛尔赞娜吗？\n这种时候有什么事？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "79/TALK",
            "narrator": "ガブリエラ",
            "text": "そうかしら？",
            "zh": "是吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "80/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、よく見ると私が出張るほどじゃないかも",
            "zh": "不过，仔细一看好像也用不着我亲自出马",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "81/TALK",
            "narrator": "ガブリエラ",
            "text": "一見激しそうだけど、\n意表突くような攻撃もしてこないし",
            "zh": "乍一看攻势好像很猛，\n其实也不会使出什么出其不意的招式",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "82/TALK",
            "narrator": "ガブリエラ",
            "text": "新人のチュートリアル戦には、もってこいの相手かもしれないわね",
            "zh": "作为新人的教学战对手，倒真是再合适不过了呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "87/ACT",
            "narrator": "",
            "text": "実際、甘く見られてる",
            "zh": "确实被小看了",
            "narrator_zh": ""
        },
        {
            "location": "91/TALK",
            "narrator": "ガブリエラ",
            "text": "マルザンナかしら？\nこんな時になんなの？",
            "zh": "是玛尔赞娜吗？\n这种时候有什么事？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "95/TALK",
            "narrator": "ガブリエラ",
            "text": "どういう意味よ！？",
            "zh": "你什么意思啊！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "97/TALK",
            "narrator": "ガブリエラ",
            "text": "私が新人より劣ってるって言いたいの！？",
            "zh": "你是想说我比新人还差劲吗！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "99/SEL",
            "narrator": "",
            "text": "つばめもああ見えても超的な力を持つ惨忍な存在らしいよ",
            "zh": "别看燕那样，她好像也是拥有超常力量、十分残忍的存在哦",
            "narrator_zh": ""
        },
        {
            "location": "100/ACT",
            "narrator": "",
            "text": "つばめもああ見えても超的な力を持つ惨忍な存在らしいよ",
            "zh": "别看燕那样，她好像也是拥有超常力量、十分残忍的存在哦",
            "narrator_zh": ""
        },
        {
            "location": "102/TALK",
            "narrator": "ガブリエラ",
            "text": "惨忍！？",
            "zh": "残忍！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "103/TALK",
            "narrator": "ガブリエラ",
            "text": "もちろんわかってるわ、そんなこと！",
            "zh": "那种事，我当然知道！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "104/TALK",
            "narrator": "ガブリエラ",
            "text": "だからずっと警戒してるし、仲間とも思ってないし",
            "zh": "所以我才一直防着她，也没把她当成同伴",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "105/TALK",
            "narrator": "ガブリエラ",
            "text": "友達にだって、絶対にならないんだから！",
            "zh": "也绝对不会跟她成为朋友的！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "107/SEL",
            "narrator": "",
            "text": "新人達の方がガブリエラ達より使えそう",
            "zh": "感觉新人们比加布里埃拉你们更好用",
            "narrator_zh": ""
        },
        {
            "location": "108/TALK",
            "narrator": "ガブリエラ",
            "text": "マルザンナも知ってるでしょ！？",
            "zh": "玛尔赞娜你也知道的吧！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "114/ACT",
            "narrator": "",
            "text": "新人達の方がガブリエラ達より使えそう",
            "zh": "感觉新人们比加布里埃拉你们更好用",
            "narrator_zh": ""
        },
        {
            "location": "115/TALK",
            "narrator": "ガブリエラ",
            "text": "何よそれ？",
            "zh": "那算什么话？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "116/TALK",
            "narrator": "ガブリエラ",
            "text": "ふざけたこと言うなら、もう話さないから！",
            "zh": "要是再说这种胡话，我就不理你了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "120/TALK",
            "narrator": "ガブリエラ",
            "text": "何よ、あたし達の方が\n戦闘慣れしてるん\nだから…。",
            "zh": "什么嘛，明明我们这边\n才更习惯战斗\n啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "122/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、マルザンナには\nそんな風に見えたの\nかしら？",
            "zh": "不过，在玛尔赞娜眼里\n难道是那样\n吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "128/TALK",
            "narrator": "透明アーヤ",
            "text": "ギャヴィ、聞こえる？",
            "zh": "加维，听得到吗？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "130/TALK",
            "narrator": "ガブリエラ",
            "text": "聞こえてるわ。\nプライベート通信で\nどうしたの？",
            "zh": "听得到。\n用私人频道联络我\n有什么事？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "131/TALK",
            "narrator": "透明アーヤ",
            "text": "敵の数が多過ぎる。",
            "zh": "敌人的数量太多了。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "132/TALK",
            "narrator": "透明アーヤ",
            "text": "このままじゃ事態が\n思うように進まなく\nなりそうだから――",
            "zh": "照这样下去局势\n恐怕没法按预想\n发展——",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "133/TALK",
            "narrator": "透明アーヤ",
            "text": "先手を打って作戦を\n変更するわ。",
            "zh": "我先一步\n变更作战。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "136/TALK",
            "narrator": "ガブリエラ",
            "text": "…賛成よ。\nで、どんな作戦？",
            "zh": "……我赞成。\n那么，是什么作战？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "137/TALK",
            "narrator": "透明アーヤ",
            "text": "ギャヴィの力が\n必要になるわ。",
            "zh": "需要借助\n加维的力量。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "138/TALK",
            "narrator": "透明アーヤ",
            "text": "みやびに陽動作戦を\n依頼して、敵を引き\nつけてもらうから――",
            "zh": "我会拜托雅\n执行诱敌作战，把敌人\n引开——",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "139/TALK",
            "narrator": "透明アーヤ",
            "text": "ギャヴィには、\nそこを狙い撃ちして\nほしいの。",
            "zh": "然后希望加维\n趁机从旁\n狙击。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "140/TALK",
            "narrator": "ガブリエラ",
            "text": "りょーかい。\nその程度、楽勝よ。",
            "zh": "了——解。\n这种程度，小菜一碟。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "141/TALK",
            "narrator": "透明アーヤ",
            "text": "ただ、シールドで\n耐えられるのは\n短時間だし――",
            "zh": "只是，护盾\n能撑住的时间\n很短——",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "142/TALK",
            "narrator": "透明アーヤ",
            "text": "間違ってシールドに\n誤射しても、みやびは\n無事じゃすまない。",
            "zh": "要是不小心误射中\n护盾，雅也\n没法全身而退。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "143/TALK",
            "narrator": "透明アーヤ",
            "text": "だから、短時間で\n確実に倒さないと\nいけないの。",
            "zh": "所以，必须在\n短时间内\n稳稳解决掉敌人。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "144/TALK",
            "narrator": "透明アーヤ",
            "text": "厳しい条件だけど、\nやれる？",
            "zh": "条件很苛刻，\n能做到吗？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "146/TALK",
            "narrator": "ガブリエラ",
            "text": "っ！？　当然よ！！",
            "zh": "唔！？　那当然！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "148/TALK",
            "narrator": "ガブリエラ",
            "text": "そんな簡単なこと、\n一々確認取らないで。",
            "zh": "这么简单的事，\n别一一跟我确认啦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "149/TALK",
            "narrator": "透明アーヤ",
            "text": "わかった。\nそれじゃ、お願いね。",
            "zh": "知道了。\n那就拜托你了。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "153/TALK",
            "narrator": "ガブリエラ",
            "text": "…なによ。\n裏方仕事ばっかり\nあたしに頼んで。",
            "zh": "……什么嘛。\n净把些幕后活\n派给我做。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "155/TALK",
            "narrator": "ガブリエラ",
            "text": "…アーヤも、あたしの\nこと低く見てる、って\nこと？",
            "zh": "……难道说，连绫水也\n看轻我\n吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "156/TALK",
            "narrator": "ガブリエラ",
            "text": "って、当然よね…。",
            "zh": "不过，这也是当然的吧……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "157/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤにとっての\nあたしなんて――",
            "zh": "对绫水来说，\n我算什么呢——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "158/TALK",
            "narrator": "ガブリエラ",
            "text": "所詮、単なる戦闘員の\n一人でしかないわけ\nだし。",
            "zh": "说到底，不过只是\n众多战斗员中的\n一个罢了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "159/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしのことなんて、\nわかってるはずない\nものね。",
            "zh": "我的心情什么的，\n她怎么可能会\n懂呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "160/TALK",
            "narrator": "ガブリエラ",
            "text": "わかってるわよ、\nそんなこと…。",
            "zh": "那种事，\n我心里清楚得很……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "162/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "165/TALK",
            "narrator": "ガブリエラ",
            "text": "わかってるのに、\nどうしてこんなに\n腹が立つのよ…！！",
            "zh": "明明心里清楚，\n为什么还是这么\n火大啊……！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "209/TALK",
            "narrator": "ガブリエラ",
            "text": "ようこそ[ココロゲート]へ。",
            "zh": "欢迎来到[心之扉]。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "210/SEL",
            "narrator": "",
            "text": "なんか元気ない？",
            "zh": "总觉得没精打采的？",
            "narrator_zh": ""
        },
        {
            "location": "211/ACT",
            "narrator": "",
            "text": "なんか元気ない？",
            "zh": "总觉得没精打采的？",
            "narrator_zh": ""
        },
        {
            "location": "213/TALK",
            "narrator": "ガブリエラ",
            "text": "そうなのよ～！",
            "zh": "可不是嘛～！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "214/TALK",
            "narrator": "ガブリエラ",
            "text": "前回、後もう一歩で\nつばめと仲良くなれる\nところだったのに！",
            "zh": "明明上一次，就差那么一点\n就能和燕\n搞好关系了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "215/TALK",
            "narrator": "ガブリエラ",
            "text": "あーもう、\nあたしのバカバカ！",
            "zh": "啊——真是的，\n我真是个笨蛋笨蛋！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "216/TALK",
            "narrator": "ガブリエラ",
            "text": "ま、それだけ\nソルジャーのあたしの\n力が強いってことね。",
            "zh": "嘛，这也说明\nsoldier那边的我\n力量有多强呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "217/TALK",
            "narrator": "ガブリエラ",
            "text": "さて、それはそれとして、\n今回も頑張って扉を\n検索するわよ♪",
            "zh": "好啦，那先放一边，\n这次也要努力\n搜索大门哦♪",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "224/TALK",
            "narrator": "ガブリエラ",
            "text": "オープンプロセス、\n0x112番地から\n0x31B番地へ。",
            "zh": "开放进程，\n从0x112号地址\n前往0x31B号地址。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "239/TALK",
            "narrator": "ガブリエラ",
            "text": "シーク完了っ♪",
            "zh": "搜索完成♪",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "242/TALK",
            "narrator": "ガブリエラ",
            "text": "さて、今回は……っと。",
            "zh": "那么，这次是……嗯。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "244/TALK",
            "narrator": "ガブリエラ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "245/TALK",
            "narrator": "ガブリエラ",
            "text": "………。",
            "zh": "………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "246/TALK",
            "narrator": "ガブリエラ",
            "text": "なるほどね。\n今回も割とテンプレ的な\nザ・あたし、って感じね。",
            "zh": "原来如此。\n这次也很有那种\n典型的“这就是我”的感觉呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "247/TALK",
            "narrator": "ガブリエラ",
            "text": "ココロファイルナンバー\n03-582-44によると――",
            "zh": "根据心之档案编号\n03-582-44的记录——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "248/TALK",
            "narrator": "ガブリエラ",
            "text": "『國政綾水の自分に対する\n対応が原因となり、精神の\n停滞が発生している』",
            "zh": "『因国政绫水对自己的\n态度，导致了\n精神上的停滞』",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "249/TALK",
            "narrator": "ガブリエラ",
            "text": "簡単に言うと、\nアーヤが自分のことを\nもっと見てくれないと嫌。",
            "zh": "简单来说，就是\n如果绫水不多关注自己\n就不高兴。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "251/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ……、\nさて、と。",
            "zh": "唉……，\n那么，接下来。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "252/TALK",
            "narrator": "ガブリエラ",
            "text": "今回ちょっと面倒なのは、\n解決にはクランの対処と\n現実の対処が必要なこと。",
            "zh": "这次有点麻烦的地方在于，\n要解决这个问题，需要同时\n处理库兰和现实两边。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "253/TALK",
            "narrator": "ガブリエラ",
            "text": "まずはクランを倒して、\nあたしの気持ちを整理する。",
            "zh": "首先打倒库兰，\n把我的心情理顺。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "254/TALK",
            "narrator": "ガブリエラ",
            "text": "その後、現実で\nあたしが望んでる対応を\n創りあげる――。",
            "zh": "之后，在现实中\n营造出我所期望的\n回应——。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "255/TALK",
            "narrator": "ガブリエラ",
            "text": "具体的には、アーヤに\nあたしのことをもっと\n気にしてもらえればいい。",
            "zh": "具体来说，只要让绫水\n更加在意我\n就行了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "256/TALK",
            "narrator": "ガブリエラ",
            "text": "貴方なら、そのように\n便宜を図ることも\nできるんじゃないかしら？",
            "zh": "如果是你的话，\n应该也能帮忙\n促成这种局面吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "257/SEL",
            "narrator": "",
            "text": "多分、できるよ",
            "zh": "大概，可以吧",
            "narrator_zh": ""
        },
        {
            "location": "258/SEL",
            "narrator": "",
            "text": "なんか面倒くさいね",
            "zh": "总觉得好麻烦啊",
            "narrator_zh": ""
        },
        {
            "location": "259/ACT",
            "narrator": "",
            "text": "多分、できるよ",
            "zh": "大概，可以吧",
            "narrator_zh": ""
        },
        {
            "location": "261/TALK",
            "narrator": "ガブリエラ",
            "text": "やっぱり！\nありがと。",
            "zh": "果然！\n谢谢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "262/TALK",
            "narrator": "ガブリエラ",
            "text": "ごめんなさいね、\n本当に面倒な子で。",
            "zh": "真不好意思啊，\n这孩子实在让人操心。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "263/TALK",
            "narrator": "ガブリエラ",
            "text": "こんな事で拗ねちゃう\nくらいに、アーヤのこと\n慕ってるのよね～。",
            "zh": "她就是仰慕绫水到\n会因为这种小事\n闹别扭的程度呢～。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "264/ACT",
            "narrator": "",
            "text": "なんか面倒くさいね",
            "zh": "总觉得好麻烦啊",
            "narrator_zh": ""
        },
        {
            "location": "265/TALK",
            "narrator": "ガブリエラ",
            "text": "本当よね。\n実はあたしも\nそう思ってるのよ？",
            "zh": "可不是嘛。\n其实我也是\n这么觉得的哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "266/TALK",
            "narrator": "ガブリエラ",
            "text": "正直、周りからすれば\nすごく面倒な子だと思う。",
            "zh": "老实说，在旁人看来，\n她确实是个很麻烦的孩子。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "267/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、１つだけ\n分かって欲しいのは――",
            "zh": "不过，唯有一件事\n我希望你能明白——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "271/TALK",
            "narrator": "ガブリエラ",
            "text": "つばめとの件を見ても\n分かるかもしれないけど、\nあたしって――",
            "zh": "看之前和燕的事\n你大概也能明白，\n我这个人啊——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "272/TALK",
            "narrator": "ガブリエラ",
            "text": "人一倍、\n人恋しい性格なのよね。",
            "zh": "性格比常人\n更渴望被人陪伴呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "274/TALK",
            "narrator": "ガブリエラ",
            "text": "周囲を攻撃してばっかりな\nくせにね。",
            "zh": "明明自己老是\n攻击周围的人呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "275/TALK",
            "narrator": "ガブリエラ",
            "text": "とにかく、\n今回もお願いね。",
            "zh": "总之，\n这次也拜托你了哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "276/TALK",
            "narrator": "ガブリエラ",
            "text": "もう\n$handle$だけが\n頼りなんだから！",
            "zh": "现在\n就只能指望\n$handle$了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "277/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしと\n$handle$にとって\n素敵なココロの旅を！",
            "zh": "愿我与\n$handle$拥有一段\n美妙的心灵之旅！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "25/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>5月9日　1:59 PM</color>\n某高校で発生したフェノメノン戦。その最中のこと。",
            "zh": "<color=green>5月9日　1:59 PM</color>\n某高中发生的PhenoMENON战。就在那场战斗之中。",
            "narrator_zh": "Dialog_EventData"
