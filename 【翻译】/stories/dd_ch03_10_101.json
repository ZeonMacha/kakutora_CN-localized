{
    "dir": "chap10/daydra/dd_ch03_10_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "10302",
        "cid": "gabriella",
        "title": "002 メインストーリー",
        "sub_title": "七夕祭りへ行きません？＜前編＞",
        "title_zh": "002 主线剧情",
        "sub_title_zh": "不去七夕祭典吗？＜前篇＞"
    },
    "entry": [
        {
            "location": "8/SCENARIO",
            "narrator": "",
            "text": "七夕祭りへ行きません？",
            "zh": "不去七夕祭典吗？",
            "narrator_zh": ""
        },
        {
            "location": "49/TALK",
            "narrator": "ガブリエラ",
            "text": "七夕まつり？",
            "zh": "七夕祭典？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "52/TALK",
            "narrator": "つばめ",
            "text": "うん！\nもうすぐ近所の神社で\nやるんだって。",
            "zh": "嗯！\n听说马上就要在附近的\n神社举办了哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "54/TALK",
            "narrator": "神楽",
            "text": "みんなで行こうと\n思うんですけど――",
            "zh": "我们正想着大家一起\n去呢——",
            "narrator_zh": "神乐"
        },
        {
            "location": "55/TALK",
            "narrator": "神楽",
            "text": "ガブちゃんも、\nもちろん行きます\nよね？",
            "zh": "加布，\n你当然也会去的\n对吧？",
            "narrator_zh": "神乐"
        },
        {
            "location": "56/TALK",
            "narrator": "ガブリエラ",
            "text": "うーん、\n行ってみたいとは\n思ってるけど……",
            "zh": "嗯——\n虽说我确实有点\n想去看看啦……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "57/TALK",
            "narrator": "つばめ",
            "text": "じゃあ、一緒に――",
            "zh": "那，大家一起——",
            "narrator_zh": "燕"
        },
        {
            "location": "59/TALK",
            "narrator": "ガブリエラ",
            "text": "まだ行くとは\n言ってないわよ。\nそれに！",
            "zh": "我还没说\n要去呢。\n而且！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "61/TALK",
            "narrator": "ガブリエラ",
            "text": "行く時は一人で行く。\nあんた達と一緒には\n行かないわ。",
            "zh": "要去我也是自己去。\n才不跟你们\n一起去呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "62/TALK",
            "narrator": "つばめ",
            "text": "えっ…。",
            "zh": "咦……。",
            "narrator_zh": "燕"
        },
        {
            "location": "63/TALK",
            "narrator": "神楽",
            "text": "何でですか？\n一緒に行った方が\n楽しいのに…。",
            "zh": "为什么呀？\n大家一起去明明\n更开心的说……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "64/TALK",
            "narrator": "ガブリエラ",
            "text": "別に、楽しくなんか……",
            "zh": "才、才不会开心呢……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "66/TALK",
            "narrator": "みやび",
            "text": "そんなこと言わんで、\nみんなで行くぞね。",
            "zh": "别这么说嘛，\n大家一起去啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "67/TALK",
            "narrator": "みやび",
            "text": "きっと楽しいと\n思うんよ？",
            "zh": "肯定会很开心\n的咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "69/TALK",
            "narrator": "ガブリエラ",
            "text": "…みやびがそんなこと\n言うの、珍しいわね？",
            "zh": "……雅会说这种话，\n还真是稀奇呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "70/TALK",
            "narrator": "ガブリエラ",
            "text": "人の多いとこって、\nあまり好きじゃない\nはずなのに。",
            "zh": "你明明应该不太喜欢\n人多的地方\n才对吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "74/TALK",
            "narrator": "みやび",
            "text": "…祭りは別や。\n日本人やきね。",
            "zh": "……祭典另当别论。\n毕竟我是日本人嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "75/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "76/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "79/TALK",
            "narrator": "ガブリエラ",
            "text": "…そっか。\nみやびだって\n日本人だものね。",
            "zh": "……也是啊。\n毕竟雅也是\n日本人嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "81/TALK",
            "narrator": "みやび",
            "text": "ほっ…。",
            "zh": "呼……。",
            "narrator_zh": "雅"
        },
        {
            "location": "83/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、ホントお祭りは\n行くにしても\n一人で行くから。",
            "zh": "不过，说真的，祭典\n就算去我也是\n自己一个人去。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "84/TALK",
            "narrator": "ガブリエラ",
            "text": "っていうか、あたしは\n一人で行きたいの。",
            "zh": "倒不如说，我就是\n想一个人去。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "86/TALK",
            "narrator": "つばめ",
            "text": "みんなで行った方が\n絶対楽しいですよ。",
            "zh": "大家一起去绝对\n更开心哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "88/TALK",
            "narrator": "ガブリエラ",
            "text": "だから、あんたは\n卯月達と一緒に行けば\n楽しめるでしょ？",
            "zh": "所以说，你只要和\n卯月她们一起去\n不就能玩得开心了吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "89/TALK",
            "narrator": "つばめ",
            "text": "せんぱいもいなきゃ、\n寂しいです…。",
            "zh": "前辈要是不在的话，\n我会觉得寂寞的……。",
            "narrator_zh": "燕"
        },
        {
            "location": "91/TALK",
            "narrator": "ガブリエラ",
            "text": "な、なにそれ？\n意味わかんない。",
            "zh": "什、什么呀？\n莫名其妙。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "93/TALK",
            "narrator": "神楽",
            "text": "あーあ、みんなで\n浴衣着ていくお祭り\nなんて――",
            "zh": "哎呀，大家一起\n穿着浴衣去逛祭典\n什么的——",
            "narrator_zh": "神乐"
        },
        {
            "location": "94/TALK",
            "narrator": "神楽",
            "text": "絶対に楽しいに\n決まってますのに。",
            "zh": "肯定会玩得\n非常开心的说。",
            "narrator_zh": "神乐"
        },
        {
            "location": "97/TALK",
            "narrator": "ガブリエラ",
            "text": "…確かに、それは\nちょっと楽しそう\nだけど。",
            "zh": "……确实，听起来\n是挺有意思的\n啦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "99/TALK",
            "narrator": "つばめ",
            "text": "そうですよ。",
            "zh": "就是说呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "100/TALK",
            "narrator": "つばめ",
            "text": "それに、せんぱいが\n喜ぶような作戦も――",
            "zh": "而且，我们还有能让\n前辈开心的作战计划——",
            "narrator_zh": "燕"
        },
        {
            "location": "103/TALK",
            "narrator": "神楽",
            "text": "ちょ！？\nつばめさん！",
            "zh": "等、等一下！？\n燕！",
            "narrator_zh": "神乐"
        },
        {
            "location": "105/TALK",
            "narrator": "つばめ",
            "text": "あっ！",
            "zh": "啊！",
            "narrator_zh": "燕"
        },
        {
            "location": "107/TALK",
            "narrator": "ガブリエラ",
            "text": "…今、作戦って\n聞こえたんだけど？",
            "zh": "……我刚才好像听到\n“作战计划”几个字了哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "108/TALK",
            "narrator": "つばめ",
            "text": "あああ、えっと！\nそれはですね、\nその…。",
            "zh": "啊啊啊，那个！\n那个是呢，\n就是……。",
            "narrator_zh": "燕"
        },
        {
            "location": "111/TALK",
            "narrator": "神楽",
            "text": "や、屋台全店制覇\n作戦です！",
            "zh": "是、是制霸全部\n摊位大作战！",
            "narrator_zh": "神乐"
        },
        {
            "location": "112/TALK",
            "narrator": "ガブリエラ",
            "text": "えっ、全店制覇？",
            "zh": "咦，全部制霸？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "113/TALK",
            "narrator": "神楽",
            "text": "そうです。",
            "zh": "是的。",
            "narrator_zh": "神乐"
        },
        {
            "location": "114/TALK",
            "narrator": "神楽",
            "text": "一人では無理ですが、\n五人でなら可能だと\n思いませんか？",
            "zh": "一个人的话肯定办不到，\n但五个人一起不就\n有可能实现了吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "115/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "117/TALK",
            "narrator": "ガブリエラ",
            "text": "やっぱり、楽しそう。",
            "zh": "果然，听起来好有意思。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "118/TALK",
            "narrator": "ガブリエラ",
            "text": "食べ物なんかも、\nシェアすれば\n全部行けるかも。",
            "zh": "吃的什么的，\n大家分着吃的话\n说不定真能全吃一遍。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "119/TALK",
            "narrator": "ガブリエラ",
            "text": "…でも。",
            "zh": "……但是。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "121/TALK",
            "narrator": "みやび",
            "text": "…どうや？\nうちらを助けると\n思うて――",
            "zh": "……怎么样？\n就当帮我们\n一个忙——",
            "narrator_zh": "雅"
        },
        {
            "location": "123/TALK",
            "narrator": "みやび",
            "text": "ガブちゃんも\n一緒に来てもらえ\nんか？",
            "zh": "加布能不能也\n跟我们一起\n去喃？",
            "narrator_zh": "雅"
        },
        {
            "location": "124/TALK",
            "narrator": "ガブリエラ",
            "text": "…そ、そうねぇ。",
            "zh": "……这、这样啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "125/TALK",
            "narrator": "ガブリエラ",
            "text": "…凄く楽しそう。\nううん、絶対楽しいに\n決まってる。",
            "zh": "……听起来超有意思。\n不对，肯定会很开心\n才对。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "126/TALK",
            "narrator": "ガブリエラ",
            "text": "なのに…どうして\nこんなにイライラした\n気持ちになるの？",
            "zh": "明明如此……为什么\n我心里会这么\n烦躁呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "127/TALK",
            "narrator": "ガブリエラ",
            "text": "別に、みんなのことが\n嫌いだから、って\nわけでもないのに…。",
            "zh": "我也并不是因为\n讨厌大家才这样\n的啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "129/TALK",
            "narrator": "つばめ",
            "text": "せんぱいは、まずは\nどのお店から周りたい\nですか？",
            "zh": "前辈，你最先\n想从哪个摊位\n开始逛呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "130/TALK",
            "narrator": "ガブリエラ",
            "text": "っ！？",
            "zh": "唔！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "131/TALK",
            "narrator": "ガブリエラ",
            "text": "そ、そんなの、\nあたしの勝手\nでしょ！？",
            "zh": "这、这种事，\n我想怎么逛就怎么逛\n吧！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "132/TALK",
            "narrator": "ガブリエラ",
            "text": "第一、あたしは絶対、\nあんたとなんか\n行かないから。",
            "zh": "再说第一，我绝对\n不会跟你一起\n去的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "135/TALK",
            "narrator": "つばめ",
            "text": "えっ…。\nわたし、ですか？",
            "zh": "咦……。\n我、我吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "136/TALK",
            "narrator": "ガブリエラ",
            "text": "そうよ。\nっていうか、\n本当自覚ないのね？",
            "zh": "就是你。\n话说回来，\n你还真是毫无自觉呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "138/TALK",
            "narrator": "ガブリエラ",
            "text": "あんたは、コネクトも\n何もしない普通の\n状態で――",
            "zh": "你在既没有连接\n也没有任何动作的\n普通状态下——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "139/TALK",
            "narrator": "ガブリエラ",
            "text": "クランを壊すような\n危ない奴なのよ？",
            "zh": "可是个能破坏库兰的\n危险分子哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "141/TALK",
            "narrator": "神楽",
            "text": "ちょ、ガブちゃん。\nそれは今、関係ない\n話じゃ…。",
            "zh": "等、加布。\n那件事跟现在\n没关系吧……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "142/TALK",
            "narrator": "ガブリエラ",
            "text": "大ありよ。",
            "zh": "大有关系。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "144/TALK",
            "narrator": "ガブリエラ",
            "text": "そんな危ない力を\n持ってるヤツと\n一緒にいたら――",
            "zh": "跟拥有那种\n危险力量的家伙\n待在一起的话——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "145/TALK",
            "narrator": "ガブリエラ",
            "text": "警戒して、お祭りを\n楽しむことなんて\nできないわ。",
            "zh": "我光顾着警戒了，\n根本没法好好享受\n祭典嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "147/TALK",
            "narrator": "ガブリエラ",
            "text": "…あ。",
            "zh": "……啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "148/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "150/TALK",
            "narrator": "神楽",
            "text": "…が、ガブちゃん！\nいくら何でもそんな…\n酷いです！",
            "zh": "……加、加布！\n再怎么说那样也……\n太过分了！",
            "narrator_zh": "神乐"
        },
        {
            "location": "152/TALK",
            "narrator": "みやび",
            "text": "さすがに、今のは\n言い過ぎやぞ？",
            "zh": "说真的，刚才那话\n说得太过火了啵？",
            "narrator_zh": "雅"
        },
        {
            "location": "153/TALK",
            "narrator": "みやび",
            "text": "つばめちゃんに\n謝りぃ。",
            "zh": "快向燕\n道歉咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "156/TALK",
            "narrator": "ガブリエラ",
            "text": "な、なによ。\n正直に話しただけ\nじゃない！",
            "zh": "什、什么嘛。\n我只是把心里话\n说出来而已啊！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "157/TALK",
            "narrator": "みやび",
            "text": "だからって、言うて\nえいことと悪いことが\nあるやろ。",
            "zh": "话虽如此，什么该说\n什么不该说总得有个\n分寸咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "158/TALK",
            "narrator": "神楽",
            "text": "そうですよ。",
            "zh": "就是说呀。",
            "narrator_zh": "神乐"
        },
        {
            "location": "159/TALK",
            "narrator": "神楽",
            "text": "それに、つばめさんは\nガブちゃんに\n対して――",
            "zh": "而且，燕她对\n加布你\n从来——",
            "narrator_zh": "神乐"
        },
        {
            "location": "160/TALK",
            "narrator": "神楽",
            "text": "何も悪いことして\nないのに…。",
            "zh": "都没做过什么\n过分的事……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "162/TALK",
            "narrator": "ガブリエラ",
            "text": "そ、そんなの！",
            "zh": "那、那种事！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "163/TALK",
            "narrator": "ガブリエラ",
            "text": "…わかってるわよ！",
            "zh": "……我当然知道啊！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "164/TALK",
            "narrator": "ガブリエラ",
            "text": "っていうか、つばめが\n悪いことするとか、\n考えられないし！",
            "zh": "倒不如说，我也无法\n想象燕会做出什么\n坏事来！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "165/TALK",
            "narrator": "ガブリエラ",
            "text": "そんなの、\nあたしだって\nわかってる！",
            "zh": "这种事，\n连我自己也\n清楚得很！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "166/TALK",
            "narrator": "ガブリエラ",
            "text": "わかってるけど――",
            "zh": "虽然清楚——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "168/TALK",
            "narrator": "ガブリエラ",
            "text": "それでも！",
            "zh": "可即便如此！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "169/TALK",
            "narrator": "ガブリエラ",
            "text": "と、とにかく！\nあたしはあんた達とは\n絶対に――",
            "zh": "总、总之！\n我绝对不跟你们\n一起——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "213/TALK",
            "narrator": "ガブリエラ",
            "text": "あ、$handle$！\nいらっしゃい！",
            "zh": "啊，$handle$！\n欢迎你来！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "214/TALK",
            "narrator": "ガブリエラ",
            "text": "前回は本当にありがと。\nお陰で助かったわ。",
            "zh": "上次真是谢谢你啦。\n多亏有你才帮大忙了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "215/SEL",
            "narrator": "",
            "text": "でも今回も…",
            "zh": "不过这次也……",
            "narrator_zh": ""
        },
        {
            "location": "216/ACT",
            "narrator": "",
            "text": "でも今回も…",
            "zh": "不过这次也……",
            "narrator_zh": ""
        },
        {
            "location": "218/TALK",
            "narrator": "ガブリエラ",
            "text": "……ねぇ。",
            "zh": "……是啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "219/TALK",
            "narrator": "ガブリエラ",
            "text": "やっぱりつばめの件に\n関してだけは、根っこが\n深いのよね。",
            "zh": "果然唯独在燕这件事上，\n心结扎得\n很深呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "220/TALK",
            "narrator": "ガブリエラ",
            "text": "単にツンデレって\nだけじゃないってことね。",
            "zh": "看来并不只是单纯的\n傲娇而已呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "221/SEL",
            "narrator": "",
            "text": "リアルの本人、ツンデレって言うと否定しますよ",
            "zh": "现实里的本人，要是说她傲娇她会否认的哦",
            "narrator_zh": ""
        },
        {
            "location": "222/ACT",
            "narrator": "",
            "text": "リアルの本人、ツンデレって言うと否定しますよ",
            "zh": "现实里的本人，要是说她傲娇她会否认的哦",
            "narrator_zh": ""
        },
        {
            "location": "225/TALK",
            "narrator": "ガブリエラ",
            "text": "そりゃそうよ。\nツンデレだもん。",
            "zh": "那当然啦。\n毕竟就是个傲娇嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "226/TALK",
            "narrator": "ガブリエラ",
            "text": "それじゃ早速！\n今回も頑張って扉を\nコールしちゃうわね！",
            "zh": "那我们赶紧开始吧！\n这次我也要努力把门扉\n呼叫出来咯！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "233/TALK",
            "narrator": "ガブリエラ",
            "text": "オープンプロセス、\n0x9FE番地から\n0x884番地へ。",
            "zh": "开放进程，\n从0x9FE号地址\n前往0x884号地址。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "255/TALK",
            "narrator": "ガブリエラ",
            "text": "シーク完了っ♪",
            "zh": "搜索完成♪",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "257/TALK",
            "narrator": "ガブリエラ",
            "text": "さて、今回は\n検索する必要もない\n気がするけど……。",
            "zh": "好了，虽说这次\n感觉都没必要检索了\n就是……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "259/TALK",
            "narrator": "ガブリエラ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "260/TALK",
            "narrator": "ガブリエラ",
            "text": "………。",
            "zh": "………",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "261/TALK",
            "narrator": "ガブリエラ",
            "text": "あ、あら。",
            "zh": "哎、哎呀。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "262/TALK",
            "narrator": "ガブリエラ",
            "text": "へぇ、そうなのね。",
            "zh": "哦，原来是这样啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "263/SEL",
            "narrator": "",
            "text": "なになに？",
            "zh": "怎么了怎么了？",
            "narrator_zh": ""
        },
        {
            "location": "264/ACT",
            "narrator": "",
            "text": "なになに？",
            "zh": "怎么了怎么了？",
            "narrator_zh": ""
        },
        {
            "location": "267/TALK",
            "narrator": "ガブリエラ",
            "text": "ごめんなさい、\nあたしの思い込み\nだったかも。",
            "zh": "抱歉抱歉，\n可能是我先入为主\n猜错了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "268/TALK",
            "narrator": "ガブリエラ",
            "text": "今回の悩みの原因は\nつばめじゃないみたいね。",
            "zh": "这次烦恼的根源\n好像不是燕呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "269/SEL",
            "narrator": "",
            "text": "そうなの？",
            "zh": "是这样吗？",
            "narrator_zh": ""
        },
        {
            "location": "270/ACT",
            "narrator": "",
            "text": "そうなの？",
            "zh": "是这样吗？",
            "narrator_zh": ""
        },
        {
            "location": "272/TALK",
            "narrator": "ガブリエラ",
            "text": "うん。\n本人も全然\n気づいてないけど。",
            "zh": "嗯。\n虽然她自己完全\n没察觉到就是了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "273/TALK",
            "narrator": "ガブリエラ",
            "text": "多分クランが扉を塞いで\n真意を分からせないように\nしてるのね。",
            "zh": "大概是库兰把门扉堵住了，\n不让她看清自己的\n真实想法吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "274/SEL",
            "narrator": "",
            "text": "して、その真意とは？",
            "zh": "那么，那真实想法是？",
            "narrator_zh": ""
        },
        {
            "location": "275/ACT",
            "narrator": "",
            "text": "して、その真意とは？",
            "zh": "那么，那真实想法是？",
            "narrator_zh": ""
        },
        {
            "location": "277/TALK",
            "narrator": "ガブリエラ",
            "text": "その真意は、\n他のトライナリーメンバー\n全員に対する憤りね。",
            "zh": "那个真实想法，\n是对其他三重奏成员\n全员的愤懑呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "278/TALK",
            "narrator": "ガブリエラ",
            "text": "ここ最近フェノメノンも\n増えてるし、つばめの\n謎もわかってない。",
            "zh": "最近这段时间PhenoMENON\n也在增多，燕身上的\n谜团也还没解开。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "279/TALK",
            "narrator": "ガブリエラ",
            "text": "そんな中で、呑気に縁日に\n行くなんて信じられない、\nっていう気持ちみたいよ？",
            "zh": "在这样的节骨眼上，居然还\n悠哉地去逛庙会，简直难以置信——\n她好像是这么想的哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "280/SEL",
            "narrator": "",
            "text": "流石ガブちゃん、トライナリーの良心！",
            "zh": "不愧是加布，三重奏的良心！",
            "narrator_zh": ""
        },
        {
            "location": "281/SEL",
            "narrator": "",
            "text": "そこまで気を張らなくても……",
            "zh": "倒也不用绷得那么紧……",
            "narrator_zh": ""
        },
        {
            "location": "282/ACT",
            "narrator": "",
            "text": "流石ガブちゃん、トライナリーの良心！",
            "zh": "不愧是加布，三重奏的良心！",
            "narrator_zh": ""
        },
        {
            "location": "284/TALK",
            "narrator": "ガブリエラ",
            "text": "えっ！？\nえっと、\n褒めてくれてるの？",
            "zh": "咦！？\n那个，\n这是在夸我吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "285/SEL",
            "narrator": "",
            "text": "照れてる？",
            "zh": "害羞了吗？",
            "narrator_zh": ""
        },
        {
            "location": "286/ACT",
            "narrator": "",
            "text": "照れてる？",
            "zh": "害羞了吗？",
            "narrator_zh": ""
        },
        {
            "location": "288/TALK",
            "narrator": "ガブリエラ",
            "text": "そ、そういうわけじゃ\nないけど……",
            "zh": "也、也不是那样\n啦……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "289/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、あまりそう\n言ってくれる人って\nいないから――",
            "zh": "不过，平时很少有人\n这么夸我\n所以——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "290/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょ、ちょっとだけ\n嬉しいって気持ちも、\n無いことはないわよ？",
            "zh": "虽、虽然也有那么一丁点\n开心的心情，但也算不上\n没有啦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "291/TALK",
            "narrator": "ガブリエラ",
            "text": "ただ、今回に関しては\nちょっと気にしすぎって\n気持ちがあるのよね。",
            "zh": "只是，就这次而言，\n总觉得她有点\n太神经紧绷了呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "292/ACT",
            "narrator": "",
            "text": "そこまで気を張らなくても……",
            "zh": "倒也不用绷得那么紧……",
            "narrator_zh": ""
        },
        {
            "location": "293/TALK",
            "narrator": "ガブリエラ",
            "text": "そうよね。\nあたしも今回は\n同意するわ。",
            "zh": "说得也是。\n这次我也很\n赞同你的看法。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "295/TALK",
            "narrator": "ガブリエラ",
            "text": "やっぱり戦場生まれだから\nまだこの辺の感覚に、内心\n途惑ってるのよね。",
            "zh": "毕竟是在战场上出生的，\n对这种分寸感，她心里\n还是会感到无所适从呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "296/TALK",
            "narrator": "ガブリエラ",
            "text": "リラックスするのと\n油断するのは全然違う。",
            "zh": "放松和松懈\n是完全不同的两码事。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "297/TALK",
            "narrator": "ガブリエラ",
            "text": "それをみんな\n分かってないみたいで、\nすごく心配なのよ。",
            "zh": "大家好像都没明白\n这一点，所以她才会\n特别担心吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "298/TALK",
            "narrator": "ガブリエラ",
            "text": "とはいっても、\n今回はちょっと\n警戒しすぎ。",
            "zh": "话虽如此，\n这次确实是\n警戒过头了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "299/TALK",
            "narrator": "ガブリエラ",
            "text": "それに、その事を\nつばめに対する気持ちと\n勘違いしてる！",
            "zh": "而且，她还把这股情绪\n当成了自己对燕的\n态度，搞混了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "300/TALK",
            "narrator": "ガブリエラ",
            "text": "少なくとも\nそこだけは、あたしに\n気づいてもらわなくちゃ。",
            "zh": "至少这一点，\n必须让外面的我\n自己察觉到才行。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "301/SEL",
            "narrator": "",
            "text": "本当につばめが好きなんだね",
            "zh": "你是真的很喜欢燕呢",
            "narrator_zh": ""
        },
        {
            "location": "302/ACT",
            "narrator": "",
            "text": "本当につばめが好きなんだね",
            "zh": "你是真的很喜欢燕呢",
            "narrator_zh": ""
        },
        {
            "location": "304/TALK",
            "narrator": "ガブリエラ",
            "text": "ち、違うのよ！\n単に勘違いしてるのが\n嫌なだけなの！",
            "zh": "才、才不是呢！\n我只是单纯不想看她\n一直误会下去而已！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "306/TALK",
            "narrator": "ガブリエラ",
            "text": "とにかく、今回も\nあたしのこと\n宜しくお願いね。",
            "zh": "总之，这次也\n多多拜托你\n照顾我咯。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "307/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしと\n$handle$にとって\n素敵なココロの旅を！",
            "zh": "祝我与\n$handle$都能拥有\n一段美妙的心灵之旅！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "18/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>6月2日　4:17 PM</color>\nとある平日の放課後、神楽坂トライナリーでのバイトの最中のこと。",
            "zh": "<color=green>6月2日　4:17 PM</color>\n某个平日的放学后，在神乐坂三重奏打工时的事情。",
            "narrator_zh": "Dialog_EventData"
        },
        {
            "location": "181/DIALOG",
            "narrator": "BattleInit/Dialog_BATTLE_ch03",
            "text": "<color=black><size=50><b>ガブリエラのココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\nガブリエラの心の葛藤を解消してください。\n\n\n\n",
            "zh": "<color=black><size=50><b>在加布里埃拉的心中\n战斗开始了。</b></size></color>\n\n\n\n\n\n在她的心中，\n正产生巨大的纠葛。\n\n请潜入心灵领域\n化解加布里埃拉内心的纠葛吧。\n\n\n\n",
            "narrator_zh": "BattleInit/Dialog_BATTLE_ch03"
        }
    ]
}
