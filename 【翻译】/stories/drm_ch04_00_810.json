   "zh": "$me$爱着\n雅",
   "narrator_zh": ""
  },
  {
   "location": "417/TALK",
   "narrator": "みやび",
   "text": "うちも同じぞね。"
  },
  {
   "location": "421/TALK",
   "narrator": "みやび",
   "text": "…どういた？",
   "zh": "……怎么咯？",
   "narrator_zh": "雅"
  },
  {
   "location": "422/SEL",
   "narrator": "",
   "text": "ここにいるのは\n本物のみやび？",
   "zh": "在这里的是\n真正的雅吗？",
   "narrator_zh": ""
  },
  {
   "location": "423/SEL",
   "narrator": "",
   "text": "みやびがデレた！",
