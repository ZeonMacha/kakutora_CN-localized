 "entry": [
  {
   "location": "316/TALK",
   "narrator": "みやび",
   "text": "$handle$の\n気分はどんなかね。",
   "zh": "$handle$\n心情怎么样嘛。",
   "narrator_zh": "雅"
  },
  {
   "location": "317/TALK",
   "narrator": "みやび",
   "text": "うちは意外と\n落ち着いちゅう。"
  },
  {
   "location": "318/TALK",
   "narrator": "みやび",
   "text": "自分でもびっくり\nするくらいに。"
  },
  {
   "location": "319/SEL",
   "narrator": "",
   "text": "それはよかった",
   "zh": "那就好",
   "narrator_zh": ""
  },
  {
   "location": "320/SEL",
   "narrator": "",
   "text": "$me$は取り乱してる",
   "zh": "$me$慌了",
   "narrator_zh": ""
  },
  {
   "location": "321/SEL",
   "narrator": "",
   "text": "緊張してるよ…",
   "zh": "我有点紧张……",
   "narrator_zh": ""
  },
  {
   "location": "322/ACT",
   "narrator": "",
   "text": "それはよかった",
   "zh": "那就好",
   "narrator_zh": ""
  },
  {
   "location": "323/TALK",
   "narrator": "みやび",
   "text": "冷静な判断には\n冷静な思考が\n必要やきね。"
  },
  {
   "location": "324/ACT",
   "narrator": "",
   "text": "$me$は取り乱してる",
   "zh": "$me$慌了",
   "narrator_zh": ""
  },
  {
   "location": "325/TALK",
   "narrator": "みやび",
   "text": "とりあえず深呼吸とか\nしてみたらえいかも\nしれんぞね。",
   "zh": "总之先试试\n深呼吸也许\n会好咯。",
   "narrator_zh": "雅"
  },
  {
   "location": "326/TALK",
   "narrator": "みやび",
   "text": "吸ってー吐いてー\nヒッヒッフー\nヒッヒッフー。"
  },
  {
   "location": "327/SEL",
   "narrator": "",
   "text": "ちょっと違う…",
   "zh": "有点不对……",
   "narrator_zh": ""
  },
  {
   "location": "328/SEL",
   "narrator": "",
   "text": "それ全部吐く息だよ",
   "zh": "那些全是吐出来的气",
   "narrator_zh": ""
  },
  {
   "location": "329/SEL",
   "narrator": "",
   "text": "う、生まれる…！",
   "zh": "要、要生出来了……！",
   "narrator_zh": ""
  },
  {
   "location": "330/ACT",
   "narrator": "",
   "text": "ちょっと違う…",
   "zh": "有点不对……",
   "narrator_zh": ""
  },
  {
   "location": "332/TALK",
   "narrator": "みやび",
   "text": "気付かれるとは\n思わなんだ。"
  },
  {
   "location": "333/ACT",
   "narrator": "",
   "text": "それ全部吐く息だよ",
   "zh": "那些全是吐出来的气",
   "narrator_zh": ""
  },
  {
   "location": "334/TALK",
   "narrator": "みやび",
   "text": "えっ！？",
   "zh": "诶！？",
   "narrator_zh": "雅"
  },
  {
   "location": "335/TALK",
   "narrator": "みやび",
   "text": "それは知らんかった…。",
   "zh": "那我可不知道……。",
   "narrator_zh": "雅"
  },
  {
   "location": "336/ACT",
   "narrator": "",
   "text": "う、生まれる…！",
   "zh": "要、要生出来了……！",
   "narrator_zh": ""
  },
  {
   "location": "337/TALK",
   "narrator": "みやび",
   "text": "何を言っちゅう。"
  },
  {
   "location": "338/TALK",
   "narrator": "みやび",
   "text": "愛ならとっくに\n生まれとるきね。"
  },
  {
   "location": "340/ACT",
   "narrator": "",
   "text": "緊張してるよ…",
   "zh": "我有点紧张……",
   "narrator_zh": ""
  },
  {
   "location": "341/TALK",
   "narrator": "みやび",
   "text": "ほいたらうちが\n手を握っちゃろう。"
  },
  {
   "location": "342/SEL",
   "narrator": "",
   "text": "やった！！！",
   "zh": "太好了！！！",
   "narrator_zh": ""
  },
  {
   "location": "343/SEL",
   "narrator": "",
   "text": "もっと緊張するよ…",
   "zh": "反而更紧张了……",
   "narrator_zh": ""
  },
  {
   "location": "344/SEL",
   "narrator": "",
   "text": "本当に？",
   "zh": "真的吗？",
   "narrator_zh": ""
  },
  {
   "location": "345/ACT",
   "narrator": "",
   "text": "やった！！！",
   "zh": "太好了！！！",
   "narrator_zh": ""
  },
  {
   "location": "346/TALK",
   "narrator": "みやび",
   "text": "…そんな喜び方を\nするほどうれしいかね。"
  },
  {
   "location": "348/TALK",
   "narrator": "みやび",
   "text": "…$handle$は\n素直やねえ。"
  },
  {
   "location": "349/ACT",
   "narrator": "",
   "text": "もっと緊張するよ…",
   "zh": "反而更紧张了……",
   "narrator_zh": ""
  },
  {
   "location": "350/TALK",
   "narrator": "みやび",
   "text": "またまた。"
  },
  {
   "location": "351/TALK",
   "narrator": "みやび",
   "text": "そんなんでは\n伴侶として\nやっていけんろう。",
   "zh": "那样的话\n就没法作为伴侣\n过下去了咯。",
   "narrator_zh": "雅"
  },
  {
   "location": "352/TALK",
   "narrator": "みやび",
   "text": "ほれほれ。\nほれほれ。"
  },
  {
   "location": "353/ACT",
   "narrator": "",
   "text": "本当に？",
   "zh": "真的吗？",
   "narrator_zh": ""
  },
  {
   "location": "354/TALK",
   "narrator": "みやび",
   "text": "大事なのは\n気持ちやき。"
  },
  {
   "location": "355/TALK",
   "narrator": "みやび",
   "text": "手をつないどると\n妄想しておけば\n感触も伝わるろう。"
  },
  {
   "location": "356/TALK",
   "narrator": "みやび",
   "text": "…少しは落ち着いて\nきたかねえ？",
   "zh": "……差不多\n冷静下来了吧？",
   "narrator_zh": "雅"
  },
  {
   "location": "359/TALK",
   "narrator": "みやび",
   "text": "それにしても\n心願成就ちうのは\n便利なもんやね。",
   "zh": "不过话说回来，\n心想事成这种\n东西真方便。",
   "narrator_zh": "雅"
  },
  {
   "location": "360/TALK",
   "narrator": "みやび",
   "text": "心に秘めた願いやき\nわざわざ内容を\n説明せんでもえい。"
  },
  {
   "location": "361/TALK",
   "narrator": "みやび",
   "text": "それでいてちゃんと\n神様に話を\n付けてくれるらしい。",
   "zh": "而且好像会好好\n跟神明打好\n招呼。",
   "narrator_zh": "雅"
  },
  {
   "location": "363/TALK",
   "narrator": "みやび",
   "text": "…もしかして世間には\n人に言えん願望のある\n人間ばかりおるんかね？",
   "zh": "……难道世上尽是些\n有着不能对人说的\n愿望的人吗？",
   "narrator_zh": "雅"
  },
  {
   "location": "364/SEL",
   "narrator": "",
   "text": "そういうこと？",
   "zh": "是那么回事？",
   "narrator_zh": ""
  },
  {
   "location": "365/SEL",
   "narrator": "",
   "text": "言語化できない\n願望ってあるよ",
   "zh": "有些愿望\n是没法用语言说清的",
   "narrator_zh": ""
  },
  {
   "location": "366/SEL",
   "narrator": "",
   "text": "人にはみな\n秘密があるのさ",
   "zh": "每个人都有\n自己的秘密嘛",
   "narrator_zh": ""
  },
  {
   "location": "367/ACT",
   "narrator": "",
   "text": "そういうこと？",
   "zh": "是那么回事？",
   "narrator_zh": ""
  },
  {
   "location": "368/TALK",
   "narrator": "みやび",
   "text": "そうでなければ\nこの形態には\nならんと思うぞね。",
   "zh": "不这样的话，\n我觉得是变不成\n这个形态的咯。",
   "narrator_zh": "雅"
  },
  {
   "location": "369/ACT",
   "narrator": "",
   "text": "言語化できない\n願望ってあるよ",
   "zh": "有些愿望\n是没法用语言说清的",
   "narrator_zh": ""
  },
  {
   "location": "370/TALK",
   "narrator": "みやび",
   "text": "それは原始的な\n欲望のような\n気がするちや。",
   "zh": "我觉得那像\n原始的\n欲望咯。",
   "narrator_zh": "雅"
  },
  {
   "location": "371/ACT",
   "narrator": "",
   "text": "人にはみな\n秘密があるのさ",
   "zh": "每个人都有\n自己的秘密嘛",
   "narrator_zh": ""
  },
  {
   "location": "372/TALK",
   "narrator": "みやび",
   "text": "大人な意見ぞね。"
  },
  {
   "location": "373/TALK",
   "narrator": "みやび",
   "text": "しかし人生とは\nそういうものかも\nしれんねえ。"
  },
  {
   "location": "375/TALK",
   "narrator": "みやび",
   "text": "それにしても。",
   "zh": "不过话说回来。",
   "narrator_zh": "雅"
  },
  {
   "location": "376/TALK",
   "narrator": "みやび",
   "text": "気が付いたら\nびっくりするようなことに\nなっておったぞね。"
  },
  {
   "location": "377/TALK",
   "narrator": "みやび",
   "text": "$handle$のことは\n怪しい何かとしか認識して\nおらんかったのに。",
   "zh": "$handle$的事，\n我本来只当成\n什么可疑东西咯。",
   "narrator_zh": "雅"
  },
  {
   "location": "378/TALK",
   "narrator": "みやび",
   "text": "今となっては\n離れることは\n考えられんちや。"
  },
  {
   "location": "379/SEL",
   "narrator": "",
   "text": "みやびがデレてる…",
   "zh": "雅害羞了……",
   "narrator_zh": ""
  },
  {
   "location": "380/SEL",
   "narrator": "",
   "text": "$me$もだよ",
   "zh": "$me$也是哦",
   "narrator_zh": ""
  },
  {
   "location": "381/SEL",
   "narrator": "",
   "text": "貢いだからね！",
   "zh": "我可是供着你的！",
   "narrator_zh": ""
  },
  {
   "location": "382/ACT",
   "narrator": "",
   "text": "みやびがデレてる…",
   "zh": "雅害羞了……",
   "narrator_zh": ""
  },
  {
   "location": "384/TALK",
   "narrator": "みやび",
   "text": "…デレたら悪いかね？",
   "zh": "……娇羞一下不行啵？",
   "narrator_zh": "雅"
  },
  {
   "location": "385/ACT",
   "narrator": "",
   "text": "$me$もだよ",
   "zh": "$me$也是哦",
   "narrator_zh": ""
  },
  {
   "location": "386/TALK",
   "narrator": "みやび",
   "text": "…知っちゅうき。",
   "zh": "……我晓得的咯。",
   "narrator_zh": "雅"
  },
  {
   "location": "387/ACT",
   "narrator": "",
   "text": "貢いだからね！",
   "zh": "我可是供着你的！",
   "narrator_zh": ""
  },
  {
   "location": "388/TALK",
   "narrator": "みやび",
   "text": "即物的すぎるねえ。"
  },
  {
   "location": "389/TALK",
   "narrator": "みやび",
   "text": "そんなことうち以外に\n言い出したら\n即別れ話ぞね。",
   "zh": "那种话要是从我家以外\n的人嘴里说出来，\n就立刻谈分手咯。",
   "narrator_zh": "雅"
  },
  {
   "location": "391/TALK",
   "narrator": "みやび",
   "text": "神様とやらに\n法的拘束力はない。"
  },
  {
   "location": "392/TALK",
   "narrator": "みやび",
   "text": "何かを強制する\n力などない。"
  },
  {
   "location": "393/TALK",
   "narrator": "みやび",
   "text": "それに、神頼みは\nリクエスト結果の\n判定も曖昧ぞね。",
   "zh": "而且，求神这种事，\n请求结果的判定\n也很模糊咯。",
   "narrator_zh": "雅"
  },
  {
   "location": "394/TALK",
   "narrator": "みやび",
   "text": "やったら式など\n無意味かというたら。"
  },
  {
   "location": "395/TALK",
   "narrator": "みやび",
   "text": "うちはそうは\n思うとらんぞね。"
  },
  {
   "location": "396/SEL",
   "narrator": "",
   "text": "みやびの見解は？",
   "zh": "雅怎么看？",
   "narrator_zh": ""
  },
  {
   "location": "397/SEL",
   "narrator": "",
   "text": "照れなくていいのに",
   "zh": "不用害羞也行啊",
   "narrator_zh": ""
  },
  {
   "location": "398/SEL",
   "narrator": "",
   "text": "気持ちの問題でしょ",
   "zh": "是心意的问题吧",
   "narrator_zh": ""
  },
  {
   "location": "399/ACT",
   "narrator": "",
   "text": "みやびの見解は？",
   "zh": "雅怎么看？",
   "narrator_zh": ""
  },
  {
   "location": "400/TALK",
   "narrator": "みやび",
   "text": "端的に言うと\n意味はある。"
  },
  {
   "location": "401/ACT",
   "narrator": "",
   "text": "照れなくていいのに",
   "zh": "不用害羞也行啊",
   "narrator_zh": ""
  },
  {
   "location": "403/TALK",
   "narrator": "みやび",
   "text": "…今日の$handle$は\nちっくと\nはしゃぎすぎぞね。",
   "zh": "……今天的$handle$\n有点\n太闹腾了啵。",
   "narrator_zh": "雅"
  },
  {
   "location": "404/ACT",
   "narrator": "",
   "text": "気持ちの問題でしょ",
   "zh": "是心意的问题吧",
   "narrator_zh": ""
  },
  {
   "location": "405/TALK",
   "narrator": "みやび",
   "text": "一言で結論付けると\nそうやけんど。"
  },
  {
   "location": "407/TALK",
   "narrator": "みやび",
   "text": "不確定要素を\n不確定要素として\n容認しながら。"
  },
  {
   "location": "408/TALK",
   "narrator": "みやび",
   "text": "自分の意思を\n表明するために必要な\nものだと思うとる。"
  },
  {
   "location": "409/SEL",
   "narrator": "",
   "text": "要はみやびが$me$を\n好きってことでしょ",
