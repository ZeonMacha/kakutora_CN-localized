    "entry": [
        {
            "location": "169/TALK",
            "narrator": "ガブリエラ",
            "text": "懐石料理って、料理の芸術品よね",
            "zh": "怀石料理，简直就是料理界的艺术品呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "171/TALK",
            "narrator": "ガブリエラ",
            "text": "食べるのに、ちょっと罪悪感を覚えるわ",
            "zh": "要把它吃掉，还稍微有点罪恶感呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "174/SEL",
            "narrator": "",
            "text": "食べるのが礼儀だよ",
            "zh": "吃掉它才是礼貌哦",
            "narrator_zh": ""
        },
        {
            "location": "175/ACT",
            "narrator": "",
            "text": "食べるのが礼儀だよ",
            "zh": "吃掉它才是礼貌哦",
            "narrator_zh": ""
        },
        {
            "location": "178/TALK",
            "narrator": "ガブリエラ",
            "text": "そういうところ、日本人って凄いわ",
            "zh": "这种地方，日本人真厉害",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "179/TALK",
            "narrator": "ガブリエラ",
            "text": "私みたいに、懐石料理を前にしてなかなか食べられない人って",
            "zh": "像我这样面对怀石料理迟迟下不了嘴的人",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "180/TALK",
            "narrator": "ガブリエラ",
            "text": "結構多いと思うのに",
            "zh": "我想应该还挺多的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "181/TALK",
            "narrator": "ガブリエラ",
            "text": "日本の料理って、どうしてこんなに美しい物ばかりなの？",
            "zh": "日本的料理，为什么净是这么美的东西呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "184/SEL",
            "narrator": "",
            "text": "君は闇を知らない",
            "zh": "你还不知道黑暗",
            "narrator_zh": ""
        },
        {
            "location": "185/ACT",
            "narrator": "",
            "text": "君は闇を知らない",
            "zh": "你还不知道黑暗",
            "narrator_zh": ""
        },
        {
            "location": "188/TALK",
            "narrator": "ガブリエラ",
            "text": "闇？",
            "zh": "黑暗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "189/TALK",
            "narrator": "ガブリエラ",
            "text": "日本料理に闇なんてあるの？",
            "zh": "日本料理里还有黑暗这一说？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "190/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、それもいつか見てみたいわね",
            "zh": "不过，那个我也想哪天见识一下呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "191/TALK",
            "narrator": "ガブリエラ",
            "text": "きっと、凄く美しい闇なんでしょうね",
            "zh": "一定是极其美丽的黑暗吧",
            "narrator_zh": "加布里埃拉"
        }
    ]
}
