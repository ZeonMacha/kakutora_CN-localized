            "narrator_zh": "雅"
        },
        {
            "location": "215/ACT",
            "narrator": "",
            "text": "野沢菜？",
            "zh": "野泽菜？",
            "narrator_zh": ""
        },
        {
            "location": "216/TALK",
            "narrator": "みやび",
            "text": "惜しい",
            "zh": "可惜",
            "narrator_zh": "雅"
        },
        {
            "location": "217/TALK",
            "narrator": "みやび",
            "text": "もう一息",
            "zh": "还差一口气",
            "narrator_zh": "雅"
        },
        {
            "location": "218/ACT",
            "narrator": "",
            "text": "みやびが食べたいものはなに？",
            "zh": "雅想吃什么？",
            "narrator_zh": ""
        },
        {
            "location": "220/TALK",
            "narrator": "みやび",
            "text": "それを当ててみよと言ったわけで",
            "zh": "我是说让你来猜",
            "narrator_zh": "雅"
        },
        {
            "location": "221/TALK",
            "narrator": "みやび",
            "text": "逆質問とは",
