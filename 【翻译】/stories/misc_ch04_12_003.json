            "narrator_zh": "雅"
        },
        {
            "location": "229/SEL",
            "narrator": "",
            "text": "忙しいの？",
            "zh": "忙吗？",
            "narrator_zh": ""
        },
        {
            "location": "230/SEL",
            "narrator": "",
            "text": "よかったら付き合うよ",
            "zh": "愿意的话我陪你",
            "narrator_zh": ""
        },
        {
            "location": "231/SEL",
