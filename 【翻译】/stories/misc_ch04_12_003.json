            "narrator_zh": "雅"
        },
        {
            "location": "222/TALK",
            "narrator": "みやび",
            "text": "いい度胸ぞね",
            "zh": "胆子不小咧",
            "narrator_zh": "雅"
        },
        {
            "location": "223/TALK",
            "narrator": "みやび",
            "text": "誉めてつかわす",
            "zh": "夸你一句",
            "narrator_zh": "雅"
        },
        {
            "location": "225/TALK",
            "narrator": "みやび",
            "text": "しかし",
            "zh": "但是",
