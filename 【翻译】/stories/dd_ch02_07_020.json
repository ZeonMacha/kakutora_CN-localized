{
    "dir": "chap07/daydra/dd_ch02_07_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "7255",
        "cid": "ayami",
        "title": "Extra005 プレミアムストーリー",
        "sub_title": "剣道部の指導",
        "title_zh": "Extra005 额外剧情",
        "sub_title_zh": "剑道部的指导"
    },
    "entry": [
        {
            "location": "151/SCENARIO",
            "narrator": "",
            "text": "剣道部の指導",
            "zh": "剑道部的指导",
            "narrator_zh": ""
        },
        {
            "location": "163/TALK",
            "narrator": "アーヤ",
            "text": "はぁ…\nどうしようかしら？",
            "zh": "哈啊……\n怎么办呢？",
            "narrator_zh": "绫水"
        },
        {
            "location": "165/TALK",
            "narrator": "ガブリエラ",
            "text": "浮かない顔してるわね。\n何かあったの？",
            "zh": "脸色不太好。\n出什么事了？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "167/TALK",
            "narrator": "アーヤ",
            "text": "…実は、\n高等部の剣道部に\nお願いされたのよ。",
            "zh": "……其实，\n高中部的剑道部\n来拜托我了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "168/TALK",
            "narrator": "アーヤ",
            "text": "うちの指導を\nして欲しい、ってね。",
            "zh": "说想请我\n去指导。",
            "narrator_zh": "绫水"
        },
        {
            "location": "171/TALK",
            "narrator": "ガブリエラ",
            "text": "…ふ～ん。",
            "zh": "……嗯——。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "173/TALK",
            "narrator": "アーヤ",
            "text": "まあ、バイトとか他にも\n色々あるから、時々で\n良いとは言われたけど―",
            "zh": "嘛，打工还有别的事，\n说偶尔去就行\n——",
            "narrator_zh": "绫水"
        },
        {
            "location": "174/TALK",
            "narrator": "アーヤ",
            "text": "どう返事をしようか、\nちょっと迷ってるのよ。",
            "zh": "怎么回复，\n我有点犹豫。",
            "narrator_zh": "绫水"
        },
        {
            "location": "177/TALK",
            "narrator": "ガブリエラ",
            "text": "…断っちゃえば？\nっていうか、悩む必要\nどこにもないと思うし。",
            "zh": "……拒绝不就好了？\n而且，我觉得根本\n没什么好烦的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "179/TALK",
            "narrator": "ガブリエラ",
            "text": "抜け殻のあんたが\n部活の指導なんて、\nできるわけないじゃん。",
            "zh": "空壳一样的你\n去指导社团，\n怎么可能做得来。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "182/TALK",
            "narrator": "アーヤ",
            "text": "はぁ…あんたねぇ…。",
            "zh": "哈啊……你啊……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "183/TALK",
            "narrator": "アーヤ",
            "text": "…まあ、\n辞めた身としては\n何も言い返せないけど。",
            "zh": "……嘛，\n作为已经退出的人，\n我也没什么可回的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "184/TALK",
            "narrator": "アーヤ",
            "text": "でも、本当どうしよう\nかしら…。",
            "zh": "可是，真的\n怎么办呢……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "185/SEL",
            "narrator": "",
            "text": "後輩の頼みは聞こう",
            "zh": "后辈的请求就答应",
            "narrator_zh": ""
        },
        {
            "location": "186/SEL",
            "narrator": "",
            "text": "嫌なら断るべきだ",
            "zh": "不想去就该拒绝",
            "narrator_zh": ""
        },
        {
            "location": "187/SEL",
            "narrator": "",
            "text": "アーヤはどうしたいの？",
            "zh": "绫水想怎么做？",
            "narrator_zh": ""
        },
        {
            "location": "188/ACT",
            "narrator": "",
            "text": "後輩の頼みは聞こう",
            "zh": "后辈的请求就答应",
            "narrator_zh": ""
        },
        {
            "location": "193/TALK",
            "narrator": "アーヤ",
            "text": "あっ…。",
            "zh": "啊……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "194/TALK",
            "narrator": "ガブリエラ",
            "text": "返事の催促じゃないの？",
            "zh": "是在催回复吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "196/TALK",
            "narrator": "アーヤ",
            "text": "どうかしら？\nえっと…。",
            "zh": "是吗？\n那个……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "210/TALK",
            "narrator": "アーヤ",
            "text": "ずっと聞いてたの？",
            "zh": "你一直在听？",
            "narrator_zh": "绫水"
        },
        {
            "location": "211/TALK",
            "narrator": "アーヤ",
            "text": "でも、",
            "zh": "不过，",
            "narrator_zh": "绫水"
        },
        {
            "location": "212/TALK",
            "narrator": "アーヤ",
            "text": "ちょうど悩んでたところだから助かるけど",
            "zh": "正好我在烦恼，倒是帮了忙",
            "narrator_zh": "绫水"
        },
        {
            "location": "213/TALK",
            "narrator": "アーヤ",
            "text": "あなたの言うとおり、やってみようと思うわ",
            "zh": "就照你说的，我想试试看",
            "narrator_zh": "绫水"
        },
        {
            "location": "214/TALK",
            "narrator": "アーヤ",
            "text": "面識のない私に、わざわざ頼んできたくらいだし",
            "zh": "素不相识还特意来拜托",
            "narrator_zh": "绫水"
        },
        {
            "location": "215/TALK",
            "narrator": "アーヤ",
            "text": "それだけ期待してくれてるんだろうし",
            "zh": "应该是挺期待我的",
            "narrator_zh": "绫水"
        },
        {
            "location": "227/TALK",
            "narrator": "アーヤ",
            "text": "催促じゃなかったけど、\n決めたわ。",
            "zh": "不是催回复，\n我决定了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "228/TALK",
            "narrator": "アーヤ",
            "text": "私、\nやってみようと思う。",
            "zh": "我，\n想试试看。",
            "narrator_zh": "绫水"
        },
        {
            "location": "229/TALK",
            "narrator": "ガブリエラ",
            "text": "マジで？",
            "zh": "真的？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "233/TALK",
            "narrator": "ガブリエラ",
            "text": "まさか、これを機に\n本格的に剣道復帰する\nつもりとか？",
            "zh": "难道，想趁这个机会\n正式回到剑道\n吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "234/TALK",
            "narrator": "アーヤ",
            "text": "毎日稽古に参加できる\nわけじゃないから、\n復帰は無理よ。",
            "zh": "又不能每天参加练习，\n所以回归\n是不可能的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "235/TALK",
            "narrator": "アーヤ",
            "text": "中途半端にやってたら、\nどんどん腕が鈍ってくと\n思うし…。",
            "zh": "半吊子做下去，\n我觉得手会越来越\n生……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "236/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、\n指導はするんでしょ？",
            "zh": "可是，\n指导还是要做吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "237/TALK",
            "narrator": "アーヤ",
            "text": "自分でするのと\n指導するのは、\nまったくの別物よ。",
            "zh": "自己做，\n和指导别人，\n完全是两回事。",
            "narrator_zh": "绫水"
        },
        {
            "location": "238/TALK",
            "narrator": "アーヤ",
            "text": "それに、\n後輩の頼みを聞ける\n先輩になりたい――",
            "zh": "而且，\n我想成为能听后辈请求的\n前辈——",
            "narrator_zh": "绫水"
        },
        {
            "location": "239/TALK",
            "narrator": "アーヤ",
            "text": "そう思っただけよ。",
            "zh": "只是这么想。",
            "narrator_zh": "绫水"
        },
        {
            "location": "242/TALK",
            "narrator": "ガブリエラ",
            "text": "…な～んだ。",
            "zh": "……什么嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "243/TALK",
            "narrator": "アーヤ",
            "text": "なんだとは何よ？",
            "zh": "什么嘛是什么意思？",
            "narrator_zh": "绫水"
        },
        {
            "location": "245/TALK",
            "narrator": "ガブリエラ",
            "text": "別に。",
            "zh": "没什么。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "247/TALK",
            "narrator": "ガブリエラ",
            "text": "ただ、そんな理由で\n受けても、大したことは\nできなさそうだな――",
            "zh": "只是觉得，凭这种理由\n答应下来，也做不出\n什么了不起的事——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "249/TALK",
            "narrator": "ガブリエラ",
            "text": "って、思っただけよ。\nま、適当に頑張れば？",
            "zh": "只是这么想。\n嘛，随便努力一下？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "251/TALK",
            "narrator": "アーヤ",
            "text": "何よ、ちょっとくらい\n応援してくれても\nいいのに。",
            "zh": "什么嘛，稍微\n支持我一下\n也没关系吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "252/ACT",
            "narrator": "",
            "text": "嫌なら断るべきだ",
            "zh": "不想去就该拒绝",
            "narrator_zh": ""
        },
        {
            "location": "255/TALK",
            "narrator": "アーヤ",
            "text": "あっ…。",
            "zh": "啊……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "256/TALK",
            "narrator": "ガブリエラ",
            "text": "返事の催促じゃないの？",
            "zh": "是在催回复吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "258/TALK",
            "narrator": "アーヤ",
            "text": "どうかしら？\nえっと…。",
            "zh": "是吗？\n那个……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "272/TALK",
            "narrator": "アーヤ",
            "text": "聞いてたの？",
            "zh": "你在听？",
            "narrator_zh": "绫水"
        },
        {
            "location": "273/TALK",
            "narrator": "アーヤ",
            "text": "嫌、ってわけじゃないわ",
            "zh": "也不是讨厌",
            "narrator_zh": "绫水"
        },
        {
            "location": "274/TALK",
            "narrator": "アーヤ",
            "text": "ただ、あまり乗り気がしないだけよ",
            "zh": "只是不太起劲",
            "narrator_zh": "绫水"
        },
        {
            "location": "275/TALK",
            "narrator": "アーヤ",
            "text": "…って、こんな気持ちで受けても、大したことできないわね",
            "zh": "……这种心情答应下来，也做不出什么了不起的事",
            "narrator_zh": "绫水"
        },
        {
            "location": "287/TALK",
            "narrator": "アーヤ",
            "text": "…やっぱり、\n断ろうかな。",
            "zh": "……果然，\n还是拒绝吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "288/TALK",
            "narrator": "アーヤ",
            "text": "剣道なんて、まともに\nやったの高校時代が\n最後だし…。",
            "zh": "剑道，正经做过\n还是高中那时候\n最后一次……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "291/TALK",
            "narrator": "ガブリエラ",
            "text": "…毎日自主練してる\nから、腕は落ちて\nないんでしょ？",
            "zh": "……你不是每天\n自己加练，手\n没生吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "293/TALK",
            "narrator": "アーヤ",
            "text": "だと良いんだけど…。",
            "zh": "但愿如此……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "295/TALK",
            "narrator": "アーヤ",
            "text": "でも、断ろうって\n思ったのは――",
            "zh": "可是，我想拒绝\n是因为——",
            "narrator_zh": "绫水"
        },
        {
            "location": "296/TALK",
            "narrator": "アーヤ",
            "text": "一度剣道を辞めた私が、\n人に剣道を教えるなんて\nおこがましい。",
            "zh": "已经退出剑道的我，\n再去教别人剑道，\n太不自量力。",
            "narrator_zh": "绫水"
        },
        {
            "location": "297/TALK",
            "narrator": "アーヤ",
            "text": "そう思ったからよ。",
            "zh": "是这么想的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "298/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "302/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…バッカみたい。",
            "zh": "哈啊……像个傻瓜。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "304/TALK",
            "narrator": "アーヤ",
            "text": "何よ、それ？",
            "zh": "什么意思？",
            "narrator_zh": "绫水"
        },
        {
            "location": "307/TALK",
            "narrator": "ガブリエラ",
            "text": "あんたがじゃないわ。",
            "zh": "不是说你。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "308/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょっとでも期待した\nあたしがバカだった、\nって思っただけよ。",
            "zh": "稍微期待了一下的\n我才是傻瓜，\n只是这么想。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "309/TALK",
            "narrator": "アーヤ",
            "text": "意味わからないわ。",
            "zh": "听不懂。",
            "narrator_zh": "绫水"
        },
        {
            "location": "312/TALK",
            "narrator": "ガブリエラ",
            "text": "いいわよ、もう。\n別に期待してないし。",
            "zh": "算了。\n我也没在期待。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "313/ACT",
            "narrator": "",
            "text": "アーヤはどうしたいの？",
            "zh": "绫水想怎么做？",
            "narrator_zh": ""
        },
        {
            "location": "316/TALK",
            "narrator": "アーヤ",
            "text": "あっ…。",
            "zh": "啊……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "317/TALK",
            "narrator": "ガブリエラ",
            "text": "返事の催促じゃないの？",
            "zh": "是在催回复吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "318/TALK",
            "narrator": "アーヤ",
            "text": "どうかしら？\nえっと…。",
            "zh": "是吗？\n那个……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "332/TALK",
            "narrator": "アーヤ",
            "text": "どうしたいって、もちろんやりたいと思ってるわ",
            "zh": "想怎么做，当然是想做",
            "narrator_zh": "绫水"
        },
        {
            "location": "333/TALK",
            "narrator": "アーヤ",
            "text": "嫌いになったから剣道を辞めた、ってわけじゃないし…",
            "zh": "又不是因为讨厌才退出剑道……",
            "narrator_zh": "绫水"
        },
        {
            "location": "334/TALK",
            "narrator": "アーヤ",
            "text": "…なんだ",
            "zh": "……什么",
            "narrator_zh": "绫水"
        },
        {
            "location": "335/TALK",
            "narrator": "アーヤ",
            "text": "もう答え出てたわ",
            "zh": "答案已经有了",
            "narrator_zh": "绫水"
        },
        {
            "location": "346/TALK",
            "narrator": "ガブリエラ",
            "text": "誰からだった？",
            "zh": "谁来的？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "348/TALK",
            "narrator": "アーヤ",
            "text": "ん？　ちょっとね。",
            "zh": "嗯？　有一点。",
            "narrator_zh": "绫水"
        },
        {
            "location": "349/TALK",
            "narrator": "アーヤ",
            "text": "私、剣道部の指導の話、\n受けてみようかしら。",
            "zh": "剑道部指导的事，\n我要不要答应。",
            "narrator_zh": "绫水"
        },
        {
            "location": "350/TALK",
            "narrator": "ガブリエラ",
            "text": "ふ～ん…辞めたくせに、\nよくそんな気持ちに\nなったわね？",
            "zh": "哼……都退出了，\n还能有这种心情\n啊？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "354/TALK",
            "narrator": "アーヤ",
            "text": "辞めはしたけど、\n剣道が嫌いになった\nわけじゃないもの。",
            "zh": "是退出了，\n但不是讨厌\n剑道。",
            "narrator_zh": "绫水"
        },
        {
            "location": "355/TALK",
            "narrator": "アーヤ",
            "text": "今だって大好きだから、\n例え指導する側だったと\nしても――",
            "zh": "现在也还很喜欢，\n就算是站在指导的一边\n——",
            "narrator_zh": "绫水"
        },
        {
            "location": "356/TALK",
            "narrator": "アーヤ",
            "text": "剣道に関われるなら、\nこれほど嬉しいことは\nないわ。",
            "zh": "能和剑道有关，\n没有比这更\n高兴的了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "357/TALK",
            "narrator": "ガブリエラ",
            "text": "…ふ～ん。\nまだ好きだったんだ？",
            "zh": "……哼。\n还喜欢啊？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "360/TALK",
            "narrator": "アーヤ",
            "text": "当たり前じゃない。\nバカなこと\n聞かないでよ。",
            "zh": "这不是当然的。\n别问\n傻问题。",
            "narrator_zh": "绫水"
        },
        {
            "location": "361/TALK",
            "narrator": "アーヤ",
            "text": "毎日は参加できない\nから、剣道に復帰する\nわけにはいかないけど―",
            "zh": "不能每天参加，\n所以没法回归剑道\n——",
            "narrator_zh": "绫水"
        },
        {
            "location": "362/TALK",
            "narrator": "アーヤ",
            "text": "指導者として後輩達を\nビシビシ鍛えようと\n思うわ。",
