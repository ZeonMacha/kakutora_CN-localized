    "entry": [
        {
            "location": "496/SCENARIO",
            "narrator": "",
            "text": "決意を伝える決意",
            "zh": "传达决心的决心",
            "narrator_zh": ""
        },
        {
            "location": "521/SEL",
            "narrator": "",
            "text": "お父さんの話、ウソでしょ？",
            "zh": "爸爸的事，是说谎吧？",
            "narrator_zh": ""
        },
        {
            "location": "522/ACT",
            "narrator": "",
            "text": "お父さんの話、ウソでしょ？",
            "zh": "爸爸的事，是说谎吧？",
            "narrator_zh": ""
        },
        {
            "location": "524/TALK",
            "narrator": "つばめ",
            "text": "ぇっ！？(ﾟ△ﾟ;ﾉ)ﾉ",
            "zh": "诶！？(ﾟ△ﾟ;ﾉ)ﾉ",
            "narrator_zh": "燕"
        },
        {
            "location": "528/TALK",
            "narrator": "つばめ",
            "text": "どぅしてそぅ思ぅの？",
            "zh": "为什么这么想？",
            "narrator_zh": "燕"
        },
        {
            "location": "530/SEL",
            "narrator": "",
            "text": "つばめはウソが下手",
            "zh": "燕不擅长说谎",
            "narrator_zh": ""
        },
        {
            "location": "531/ACT",
            "narrator": "",
            "text": "つばめはウソが下手",
            "zh": "燕不擅长说谎",
            "narrator_zh": ""
        },
        {
            "location": "534/TALK",
            "narrator": "つばめ",
            "text": "ごめんなさぃ(´･ω･｀) ",
            "zh": "对不起(´･ω･｀) ",
            "narrator_zh": "燕"
        },
        {
            "location": "536/TALK",
            "narrator": "つばめ",
            "text": "$handle$さんの言ぅ通り",
            "zh": "正如$handle$说的",
            "narrator_zh": "燕"
        },
        {
            "location": "537/TALK",
            "narrator": "つばめ",
            "text": "ぉ父さん",
            "zh": "爸爸",
            "narrator_zh": "燕"
        },
        {
            "location": "538/TALK",
            "narrator": "つばめ",
            "text": "許してくれてなぃの(o´Д`)=з",
            "zh": "还没原谅我(o´Д`)=з",
            "narrator_zh": "燕"
        },
        {
            "location": "539/TALK",
            "narrator": "つばめ",
            "text": "説得しよぅと思ったんだけど",
            "zh": "我想去说服",
            "narrator_zh": "燕"
        },
        {
            "location": "540/TALK",
            "narrator": "つばめ",
            "text": "結局時間なくて(´・ω・｀)",
            "zh": "结果没时间(´・ω・｀)",
            "narrator_zh": "燕"
        },
        {
            "location": "541/TALK",
            "narrator": "つばめ",
            "text": "無理やり押し切った形で電話切っちゃったから",
            "zh": "硬是把电话挂断了",
            "narrator_zh": "燕"
        },
        {
            "location": "542/TALK",
            "narrator": "つばめ",
            "text": "まだ仲直りしてなぃの(´つω・｀)ｼｭﾝ",
            "zh": "还没和好(´つω・｀)ｼｭﾝ",
            "narrator_zh": "燕"
        },
        {
            "location": "545/SEL",
            "narrator": "",
            "text": "ダメでしょ、それ",
            "zh": "这样不行吧",
            "narrator_zh": ""
        },
        {
            "location": "546/ACT",
            "narrator": "",
            "text": "ダメでしょ、それ",
            "zh": "这样不行吧",
            "narrator_zh": ""
        },
        {
            "location": "548/TALK",
            "narrator": "つばめ",
            "text": "わかってるけど",
            "zh": "我知道",
            "narrator_zh": "燕"
        },
        {
            "location": "549/TALK",
            "narrator": "つばめ",
            "text": "話し辛くて(o´Д`)=з",
            "zh": "很难说出口(o´Д`)=з",
            "narrator_zh": "燕"
        },
        {
            "location": "550/TALK",
            "narrator": "つばめ",
            "text": "ぉ父さんも",
            "zh": "爸爸也",
            "narrator_zh": "燕"
        },
        {
            "location": "551/TALK",
            "narrator": "つばめ",
            "text": "ぁれから連絡してこなぃし",
            "zh": "从那以后没联系",
            "narrator_zh": "燕"
        },
        {
            "location": "552/TALK",
            "narrator": "つばめ",
            "text": "嫌われちゃったのかな？・゜・(ノД`)・゜・",
            "zh": "是不是被讨厌了？・゜・(ノД`)・゜・",
            "narrator_zh": "燕"
        },
        {
            "location": "555/SEL",
            "narrator": "",
            "text": "つばめを心配してのことだから、嫌われてないよ",
            "zh": "那是因为担心燕，没有讨厌你哦",
            "narrator_zh": ""
        },
        {
            "location": "556/SEL",
            "narrator": "",
            "text": "すぐに連絡して謝るべき",
            "zh": "应该马上联系道歉",
            "narrator_zh": ""
        },
        {
            "location": "557/SEL",
            "narrator": "",
            "text": "つばめはお父さんが大好きなんだね",
            "zh": "燕很喜欢爸爸吧",
            "narrator_zh": ""
        },
        {
            "location": "558/ACT",
            "narrator": "",
            "text": "つばめを心配してのことだから、嫌われてないよ",
            "zh": "那是因为担心燕，没有讨厌你哦",
            "narrator_zh": ""
        },
        {
            "location": "560/TALK",
            "narrator": "つばめ",
            "text": "ぁりがとう(*´ω｀*)",
            "zh": "谢谢(*´ω｀*)",
            "narrator_zh": "燕"
        },
        {
            "location": "561/TALK",
            "narrator": "つばめ",
            "text": "$handle$さんにそぅ言われると",
            "zh": "被$handle$这么一说",
            "narrator_zh": "燕"
        },
        {
            "location": "562/TALK",
            "narrator": "つばめ",
            "text": "そんな気がしてきたよ",
            "zh": "我也开始这么觉得了",
            "narrator_zh": "燕"
        },
        {
            "location": "565/TALK",
            "narrator": "つばめ",
            "text": "わたし、ぉ父さんに謝る！(๑･ㅂ･)و☆",
            "zh": "我要向爸爸道歉！(๑･ㅂ･)و☆",
            "narrator_zh": "燕"
        },
        {
            "location": "576/TALK",
            "narrator": "つばめ",
            "text": "…なんて送ろうかな？",
            "zh": "……该怎么发好？",
            "narrator_zh": "燕"
        },
        {
            "location": "577/TALK",
            "narrator": "つばめ",
            "text": "ただ、ごめんなさい、\nだけだと素っ気ない\n感じだし…。",
            "zh": "只写对不起，\n好像太冷淡\n了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "582/TALK",
            "narrator": "つばめ",
            "text": "わわっ！？\nめ、メール…。",
            "zh": "哇哇！？\n邮、邮件……。",
            "narrator_zh": "燕"
        },
        {
            "location": "584/TALK",
            "narrator": "つばめ",
            "text": "お父さん！？",
            "zh": "爸爸！？",
            "narrator_zh": "燕"
        },
        {
            "location": "585/TALK",
            "narrator": "つばめ",
            "text": "『…母さんと話した。\n母さんは、つばめが\nやりたいことなら――",
            "zh": "『……和妈妈谈过了。\n妈妈说，只要是燕\n想做的事——",
            "narrator_zh": "燕"
        },
        {
            "location": "586/TALK",
            "narrator": "つばめ",
            "text": "やらせてあげたい、\nとのこと。",
            "zh": "就想让她去做，\n她是这么说的。",
            "narrator_zh": "燕"
        },
        {
            "location": "587/TALK",
            "narrator": "つばめ",
            "text": "母さんに免じて、\n今回の件は暫定的に\n許すことにする』",
            "zh": "看在妈妈的份上，\n这件事暂且\n原谅了』",
            "narrator_zh": "燕"
        },
        {
            "location": "588/TALK",
            "narrator": "つばめ",
            "text": "…お父さん。",
            "zh": "……爸爸。",
            "narrator_zh": "燕"
        },
        {
            "location": "589/TALK",
            "narrator": "つばめ",
            "text": "『けど、毎日メールでも\n電話でも、ちゃんと\n連絡をよこすこと。",
            "zh": "『不过，每天用邮件也好\n电话也好，要好好\n联系。",
            "narrator_zh": "燕"
        },
        {
            "location": "590/TALK",
            "narrator": "つばめ",
            "text": "数日中に一度そっちへ\n行く。明日からの学校、\n頑張れ』",
            "zh": "这几天我会去一次。\n从明天起的学校，\n加油』",
            "narrator_zh": "燕"
        },
        {
            "location": "591/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "592/TALK",
            "narrator": "つばめ",
            "text": "ありがとう…、\nお父さん…お母さん。",
            "zh": "谢谢……\n爸爸……妈妈。",
            "narrator_zh": "燕"
        },
        {
            "location": "593/TALK",
            "narrator": "つばめ",
            "text": "…へ、返事しなきゃ。",
            "zh": "……得、得回信。",
            "narrator_zh": "燕"
        },
        {
            "location": "594/TALK",
            "narrator": "つばめ",
            "text": "ありがとう、\nお父さん、お母さん。",
            "zh": "谢谢，\n爸爸、妈妈。",
            "narrator_zh": "燕"
        },
        {
            "location": "595/TALK",
            "narrator": "つばめ",
            "text": "わたし、頑張るから！",
            "zh": "我会加油的！",
            "narrator_zh": "燕"
        },
        {
            "location": "596/TALK",
            "narrator": "つばめ",
            "text": "何があったか、\n毎日必ず連絡するね。",
            "zh": "发生了什么，\n我每天一定联系。",
            "narrator_zh": "燕"
        },
        {
            "location": "597/TALK",
            "narrator": "つばめ",
            "text": "週末、一度おうちに\n帰ります。",
            "zh": "周末，回一次\n家。",
            "narrator_zh": "燕"
        },
        {
            "location": "598/TALK",
            "narrator": "つばめ",
            "text": "いっぱいお土産\n買ってくね！",
            "zh": "会买很多伴手礼\n回去的！",
            "narrator_zh": "燕"
        },
        {
            "location": "599/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "601/TALK",
            "narrator": "つばめ",
            "text": "大好きなお父さんへ！",
            "zh": "给我最喜欢的爸爸！",
            "narrator_zh": "燕"
        },
        {
            "location": "602/ACT",
            "narrator": "",
            "text": "すぐに連絡して謝るべき",
            "zh": "应该马上联系道歉",
            "narrator_zh": ""
        },
        {
            "location": "603/TALK",
            "narrator": "つばめ",
            "text": "時間が経つと",
            "zh": "时间一长",
            "narrator_zh": "燕"
        },
        {
            "location": "604/TALK",
            "narrator": "つばめ",
            "text": "謝り難くなっちゃぅよねヾ(｡>﹏<｡)ﾉﾞ",
            "zh": "就更难道歉了ヾ(｡>﹏<｡)ﾉﾞ",
            "narrator_zh": "燕"
        },
        {
            "location": "605/TALK",
            "narrator": "つばめ",
            "text": "わかった",
            "zh": "知道了",
            "narrator_zh": "燕"
        },
        {
            "location": "607/ACT",
            "narrator": "",
            "text": "つばめはお父さんが大好きなんだね",
            "zh": "燕很喜欢爸爸吧",
            "narrator_zh": ""
        },
        {
            "location": "608/TALK",
            "narrator": "つばめ",
            "text": "ぅん(*´︶`*)",
            "zh": "嗯(*´︶`*)",
            "narrator_zh": "燕"
        },
        {
            "location": "609/TALK",
            "narrator": "つばめ",
            "text": "ぉ母さん",
            "zh": "妈妈",
            "narrator_zh": "燕"
        },
        {
            "location": "610/TALK",
            "narrator": "つばめ",
            "text": "わたしと同じ病気で",
            "zh": "和我一样的病",
            "narrator_zh": "燕"
        },
        {
            "location": "611/TALK",
            "narrator": "つばめ",
            "text": "ずっと入退院を繰り返してるの(´･ω･｀) ",
            "zh": "一直反复住院出院(´･ω･｀) ",
            "narrator_zh": "燕"
        },
        {
            "location": "612/TALK",
            "narrator": "つばめ",
            "text": "だからわたし",
            "zh": "所以我",
            "narrator_zh": "燕"
        },
        {
            "location": "613/TALK",
            "narrator": "つばめ",
            "text": "ぉ父さんと二人でぃる時間が多かったの",
            "zh": "和爸爸两个人在一起的时间很多",
            "narrator_zh": "燕"
        },
        {
            "location": "614/TALK",
            "narrator": "つばめ",
            "text": "ぁぁ見ぇてぉ父さん",
            "zh": "别看爸爸那样",
            "narrator_zh": "燕"
        },
        {
            "location": "615/TALK",
            "narrator": "つばめ",
            "text": "すごく料理が上手なんだよ(´∀｀*)ｳﾌﾌ",
            "zh": "做饭非常厉害(´∀｀*)ｳﾌﾌ",
            "narrator_zh": "燕"
        },
        {
            "location": "616/TALK",
            "narrator": "つばめ",
            "text": "忙しぃのにぃつも作ってくれて",
            "zh": "明明很忙还一直给我做",
            "narrator_zh": "燕"
        },
        {
            "location": "617/TALK",
            "narrator": "つばめ",
            "text": "ぶっきらぼうだけど",
            "zh": "说话直，可是",
            "narrator_zh": "燕"
        },
        {
            "location": "619/TALK",
            "narrator": "つばめ",
            "text": "すごく優しぃ人なの (*´∀`*)",
            "zh": "是个非常温柔的人 (*´∀`*)",
            "narrator_zh": "燕"
        },
        {
            "location": "621/SEL",
            "narrator": "",
            "text": "でも、結婚相手は大変そう",
            "zh": "不过，结婚对象会很辛苦吧",
            "narrator_zh": ""
        },
        {
            "location": "622/ACT",
            "narrator": "",
            "text": "でも、結婚相手は大変そう",
            "zh": "不过，结婚对象会很辛苦吧",
            "narrator_zh": ""
        },
        {
            "location": "624/TALK",
            "narrator": "つばめ",
            "text": "ぅーん",
            "zh": "唔——",
            "narrator_zh": "燕"
        },
        {
            "location": "626/TALK",
            "narrator": "つばめ",
            "text": "ちょっと大変かも(´ｪ｀；)三(；´ｪ｀)",
            "zh": "也许有点辛苦(´ｪ｀；)三(；´ｪ｀)",
            "narrator_zh": "燕"
        },
        {
            "location": "628/TALK",
            "narrator": "つばめ",
            "text": "話してたら",
            "zh": "说着说着",
            "narrator_zh": "燕"
        },
        {
            "location": "629/TALK",
            "narrator": "つばめ",
            "text": "気持ちが軽くなってきたよ(´∀｀*)ｳﾌﾌ",
            "zh": "心情变轻了(´∀｀*)ｳﾌﾌ",
            "narrator_zh": "燕"
        },
        {
            "location": "642/DIALOG",
