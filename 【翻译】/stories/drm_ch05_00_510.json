    "entry": [
        {
            "location": "657/SCENARIO",
            "narrator": "",
            "text": "今はもういらないけど",
            "zh": "现在已经不需要了",
            "narrator_zh": ""
        },
        {
            "location": "682/TALK",
            "narrator": "神楽",
            "text": "FreyMENOWって名前で世に出すってことは最終的にはぴょんこが責任持つってことぴょん",
            "zh": "顶着FreyMENOW这个名字发表到世上，就意味着最终要由蹦子来负起责任pyon",
            "narrator_zh": "神乐"
        },
        {
            "location": "683/TALK",
            "narrator": "神楽",
            "text": "それなのにさー",
            "zh": "明明这样——",
            "narrator_zh": "神乐"
        },
        {
            "location": "684/TALK",
            "narrator": "神楽",
            "text": "コンセプトとかそういうの理解してない輩に限ってジャストアイディアなんだけどとか",
            "zh": "偏偏是那些连概念设定都不懂的家伙，老爱说什么“我只是随口提个点子”之类的",
            "narrator_zh": "神乐"
        },
        {
            "location": "685/TALK",
            "narrator": "神楽",
            "text": "ドヤ顔で言ってくるの何なの？",
            "zh": "还一副得意洋洋的表情跑来说，什么毛病啊？",
            "narrator_zh": "神乐"
        },
        {
            "location": "686/TALK",
            "narrator": "神楽",
            "text": "バカなの死ぬの？？？",
            "zh": "是笨蛋吗想死吗？？？",
            "narrator_zh": "神乐"
        },
        {
            "location": "687/TALK",
            "narrator": "神楽",
            "text": "っていうか頃していい！？！？！？！",
            "zh": "话说，差不多可以了吧！？！？",
            "narrator_zh": "神乐"
        },
        {
            "location": "689/SEL",
            "narrator": "",
            "text": "まあ落ち着いて",
            "zh": "先冷静一下",
            "narrator_zh": ""
        },
        {
            "location": "690/SEL",
            "narrator": "",
            "text": "よしよし大変だったんだね",
            "zh": "乖，真是辛苦你了",
            "narrator_zh": ""
        },
        {
            "location": "691/SEL",
            "narrator": "",
            "text": "特別に許可する",
            "zh": "特别批准",
            "narrator_zh": ""
        },
        {
            "location": "692/ACT",
            "narrator": "",
            "text": "まあ落ち着いて",
            "zh": "先冷静一下",
            "narrator_zh": ""
        },
        {
            "location": "693/TALK",
            "narrator": "神楽",
            "text": "落ち着けないし！！！",
            "zh": "冷静不下来啦！！！",
            "narrator_zh": "神乐"
        },
        {
            "location": "694/TALK",
            "narrator": "神楽",
            "text": "無理だし！！！",
            "zh": "做不到啦！！！",
            "narrator_zh": "神乐"
        },
        {
            "location": "695/ACT",
            "narrator": "",
            "text": "よしよし大変だったんだね",
            "zh": "乖，真是辛苦你了",
            "narrator_zh": ""
        },
        {
            "location": "696/TALK",
            "narrator": "神楽",
            "text": "ﾏｼﾞでそう！",
            "zh": "真的就是那样！",
            "narrator_zh": "神乐"
        },
        {
            "location": "697/TALK",
            "narrator": "神楽",
            "text": "何なんだろうねｱﾚ！",
            "zh": "那家伙到底怎么回事啊！",
            "narrator_zh": "神乐"
        },
        {
            "location": "698/ACT",
            "narrator": "",
            "text": "特別に許可する",
            "zh": "特别批准",
            "narrator_zh": ""
        },
        {
            "location": "699/TALK",
            "narrator": "神楽",
            "text": "許可が出た！！！",
            "zh": "批准下来了！！！",
            "narrator_zh": "神乐"
        },
        {
            "location": "701/TALK",
            "narrator": "神楽",
            "text": "では遠慮なく！！！",
            "zh": "那我就不客气了！！！",
            "narrator_zh": "神乐"
        },
        {
            "location": "703/TALK",
            "narrator": "神楽",
            "text": "あーね",
            "zh": "啊，对哦",
            "narrator_zh": "神乐"
        },
        {
            "location": "705/TALK",
            "narrator": "神楽",
            "text": "方向性とかはね",
            "zh": "方向性什么的呀",
            "narrator_zh": "神乐"
        },
        {
            "location": "706/TALK",
            "narrator": "神楽",
            "text": "もう仕方ないし",
            "zh": "这方面已经没办法了",
            "narrator_zh": "神乐"
        },
        {
            "location": "707/TALK",
            "narrator": "神楽",
            "text": "そういう方向性でクオリティ上げていきましょうってのは大丈夫なの",
            "zh": "说要在那个方向提高品质，这没问题吗",
            "narrator_zh": "神乐"
        },
        {
            "location": "708/TALK",
            "narrator": "神楽",
            "text": "それがぴょんこのやりたい方向じゃなくても",
            "zh": "即使那不是pyon子想要的方向",
            "narrator_zh": "神乐"
        },
        {
            "location": "709/TALK",
            "narrator": "神楽",
            "text": "ゴールはコレなんだなっていうのはありなの",
            "zh": "明确告诉我“终点就是这个哦”，这种我完全能接受",
            "narrator_zh": "神乐"
        },
        {
            "location": "710/TALK",
            "narrator": "神楽",
            "text": "でもさ！",
            "zh": "可是啊！",
            "narrator_zh": "神乐"
        },
        {
            "location": "711/TALK",
            "narrator": "神楽",
            "text": "迷走させるタイプに限って俺ＴＵＥＥＥＥなバカで困る",
            "zh": "偏偏是那种只会带偏方向的家伙全都是自以为龙傲天的蠢货，真让人头疼",
            "narrator_zh": "神乐"
        },
        {
            "location": "712/TALK",
            "narrator": "神楽",
            "text": "ファンタジーって言えば何が何でもドラゴン出してくるとかそういう輩",
            "zh": "一提到奇幻就不管三七二十一非要往里塞一条龙的那帮人",
            "narrator_zh": "神乐"
        },
        {
            "location": "713/TALK",
            "narrator": "神楽",
            "text": "世の中にはそうじゃないファンタジーの方が本来多いんだっつー！！！！！",
            "zh": "这世上本来就是不带龙的奇幻作品更多好不好！！！！！",
            "narrator_zh": "神乐"
        },
        {
            "location": "714/TALK",
            "narrator": "神楽",
            "text": "視野狭すぎ！",
            "zh": "视野也太窄了！",
            "narrator_zh": "神乐"
        },
        {
            "location": "715/TALK",
            "narrator": "神楽",
            "text": "引き出し少なすぎ！",
            "zh": "肚子里也太没墨水了！",
            "narrator_zh": "神乐"
        },
        {
            "location": "716/TALK",
            "narrator": "神楽",
            "text": "そういうのこそ超絶クオリティと新しい視点が必要なのにわかってないし",
            "zh": "那种才需要超高水准和全新视角，可你根本不懂",
            "narrator_zh": "神乐"
        },
        {
            "location": "717/TALK",
            "narrator": "神楽",
            "text": "別にお前全然強くねーし！",
            "zh": "再说你本人也根本不强好吧！",
            "narrator_zh": "神乐"
        },
        {
            "location": "720/SEL",
            "narrator": "",
            "text": "相当アレだったんだね…",
            "zh": "原来那么糟糕啊……",
            "narrator_zh": ""
        },
        {
            "location": "721/SEL",
            "narrator": "",
            "text": "ドラゴンかっこいいけどなー",
            "zh": "龙挺帅的啊——",
            "narrator_zh": ""
        },
        {
            "location": "722/SEL",
            "narrator": "",
            "text": "お疲れさま",
            "zh": "辛苦了",
            "narrator_zh": ""
        },
        {
            "location": "723/ACT",
            "narrator": "",
            "text": "相当アレだったんだね…",
            "zh": "原来那么糟糕啊……",
            "narrator_zh": ""
        },
        {
            "location": "724/TALK",
            "narrator": "神楽",
            "text": "そうなのー",
            "zh": "是这样啊——",
            "narrator_zh": "神乐"
        },
        {
            "location": "725/ACT",
            "narrator": "",
            "text": "ドラゴンかっこいいけどなー",
            "zh": "龙挺帅的啊——",
            "narrator_zh": ""
        },
        {
            "location": "726/TALK",
            "narrator": "神楽",
            "text": "それは異論の余地がない",
            "zh": "那没有异议的余地",
            "narrator_zh": "神乐"
        },
        {
            "location": "727/TALK",
            "narrator": "神楽",
            "text": "でも胸キュン学園ラブコメとか医療ドラマとか刑事物とかにはドラゴンいらんだろ！",
            "zh": "可心动校园恋爱喜剧、医疗剧、刑警剧里根本不需要龙吧！",
            "narrator_zh": "神乐"
        },
        {
            "location": "728/TALK",
            "narrator": "神楽",
            "text": "ってそういう話",
            "zh": "话说那种事",
            "narrator_zh": "神乐"
        },
        {
            "location": "729/ACT",
            "narrator": "",
            "text": "お疲れさま",
            "zh": "辛苦了",
            "narrator_zh": ""
        },
        {
            "location": "734/TALK",
            "narrator": "神楽",
            "text": "正直ね？",
            "zh": "说实话呢？",
            "narrator_zh": "神乐"
        },
        {
            "location": "735/TALK",
            "narrator": "神楽",
            "text": "ぴょんこは歌唱力なんかもあるから",
            "zh": "蹦子好歹也是很有唱功的",
            "narrator_zh": "神乐"
        },
        {
            "location": "736/TALK",
            "narrator": "神楽",
            "text": "無茶苦茶な電波ソングでもそれなりに聞かせることはできちゃうぴょん",
            "zh": "就算是乱七八糟的电波歌，我也照样能唱得像模像样pyon",
            "narrator_zh": "神乐"
        },
        {
            "location": "738/SEL",
            "narrator": "",
            "text": "すごい自信だね",
            "zh": "真是有自信",
            "narrator_zh": ""
        },
        {
            "location": "739/SEL",
            "narrator": "",
            "text": "むしろ聞いてみたい",
            "zh": "反而想听听",
            "narrator_zh": ""
        },
        {
            "location": "740/SEL",
            "narrator": "",
            "text": "なるほど？",
            "zh": "原来如此？",
            "narrator_zh": ""
        },
        {
            "location": "741/ACT",
            "narrator": "",
            "text": "すごい自信だね",
            "zh": "真是有自信",
            "narrator_zh": ""
        },
        {
            "location": "742/TALK",
            "narrator": "神楽",
            "text": "客観的事実だから",
            "zh": "因为这是客观事实嘛",
            "narrator_zh": "神乐"
        },
        {
            "location": "743/ACT",
            "narrator": "",
            "text": "むしろ聞いてみたい",
            "zh": "反而想听听",
            "narrator_zh": ""
        },
        {
            "location": "744/TALK",
            "narrator": "神楽",
            "text": "計算して電波ソングならね？",
            "zh": "如果是经过精心设计的电波歌倒还好啦？",
            "narrator_zh": "神乐"
        },
        {
            "location": "745/TALK",
            "narrator": "神楽",
            "text": "むしろ大好きだけど",
            "zh": "不如说我超喜欢的",
            "narrator_zh": "神乐"
        },
        {
            "location": "746/TALK",
            "narrator": "神楽",
            "text": "ただのまとめられないカオスは無理",
            "zh": "光是无法收拾的混乱可不行",
            "narrator_zh": "神乐"
        },
        {
            "location": "747/TALK",
            "narrator": "神楽",
            "text": "クリエイターとして無理",
            "zh": "作为创作者实在接受不了",
            "narrator_zh": "神乐"
        },
        {
            "location": "748/ACT",
            "narrator": "",
            "text": "なるほど？",
            "zh": "原来如此？",
            "narrator_zh": ""
        },
        {
            "location": "749/TALK",
            "narrator": "神楽",
            "text": "そこは仕事ですから？",
            "zh": "那里是工作吧？",
            "narrator_zh": "神乐"
        },
        {
            "location": "751/TALK",
            "narrator": "神楽",
            "text": "計算づくの電波ならそれもありだけど",
            "zh": "精心算计过的电波风格倒还行",
            "narrator_zh": "神乐"
        },
        {
            "location": "752/TALK",
            "narrator": "神楽",
            "text": "ただの異物にしかならないのは",
            "zh": "只会变成单纯的异物",
            "narrator_zh": "神乐"
        },
        {
            "location": "753/TALK",
            "narrator": "神楽",
            "text": "どうなのかなって",
            "zh": "我是在想会不会是这样",
            "narrator_zh": "神乐"
        },
        {
            "location": "755/SEL",
            "narrator": "",
            "text": "うまく料理するのがプロじゃないの？",
            "zh": "能把菜做得好才算专业吧？",
            "narrator_zh": ""
        },
        {
            "location": "756/SEL",
            "narrator": "",
            "text": "新しい世界が開けるかもよ",
            "zh": "说不定会打开新的世界哦",
            "narrator_zh": ""
        },
        {
            "location": "757/SEL",
            "narrator": "",
            "text": "真の電波は計算なんてできない",
            "zh": "真正的电波是算不出来的",
            "narrator_zh": ""
        },
        {
            "location": "758/ACT",
            "narrator": "",
            "text": "うまく料理するのがプロじゃないの？",
            "zh": "能把菜做得好才算专业吧？",
            "narrator_zh": ""
        },
        {
            "location": "759/TALK",
            "narrator": "神楽",
            "text": "その前に素材を見極めるのが真のプロ",
            "zh": "在那之前看准素材才是真正的内行",
            "narrator_zh": "神乐"
        },
        {
            "location": "760/TALK",
            "narrator": "神楽",
            "text": "安請け合いするのは素人かレベルの低いプロ",
            "zh": "什么都随便答应下来的不是外行就是三流职业人",
            "narrator_zh": "神乐"
        },
        {
            "location": "761/ACT",
            "narrator": "",
            "text": "新しい世界が開けるかもよ",
            "zh": "说不定会打开新的世界哦",
            "narrator_zh": ""
        },
        {
            "location": "762/TALK",
            "narrator": "神楽",
            "text": "開きたいセカイと開きたくない世界があるし",
            "zh": "这世上有想打开的“世界”，也有不想打开的世界嘛",
            "narrator_zh": "神乐"
        },
        {
            "location": "763/TALK",
            "narrator": "神楽",
            "text": "それを決めるのはぴょんこなのだ！",
            "zh": "决定那个的是pyon子！",
            "narrator_zh": "神乐"
        },
        {
            "location": "764/ACT",
            "narrator": "",
            "text": "真の電波は計算なんてできない",
            "zh": "真正的电波是算不出来的",
            "narrator_zh": ""
        },
        {
            "location": "765/TALK",
            "narrator": "神楽",
            "text": "それはそう",
            "zh": "那倒是",
            "narrator_zh": "神乐"
        },
        {
            "location": "766/TALK",
            "narrator": "神楽",
            "text": "そしてそれは別次元の話",
            "zh": "然后那是另一个次元的事",
            "narrator_zh": "神乐"
        },
        {
            "location": "767/TALK",
            "narrator": "神楽",
            "text": "クリエイティブとは真逆の話",
            "zh": "那跟创作完全是背道而驰的",
            "narrator_zh": "神乐"
        },
        {
            "location": "769/TALK",
            "narrator": "神楽",
            "text": "作り上げるまではぴょんこだって迷走するよ？",
            "zh": "在彻底完成之前，连蹦子自己也会迷失方向的哦？",
            "narrator_zh": "神乐"
        },
        {
            "location": "770/TALK",
            "narrator": "神楽",
            "text": "頭の中ぐるぐるして色んな可能性を考えて考えて考えて",
            "zh": "脑子里转个不停，把各种可能性想了又想、想了又想",
            "narrator_zh": "神乐"
        },
        {
            "location": "771/TALK",
            "narrator": "神楽",
            "text": "それで最後に一番いいものを選択するの",
            "zh": "然后最后选最好的那个",
            "narrator_zh": "神乐"
        },
        {
            "location": "772/TALK",
            "narrator": "神楽",
            "text": "その経過でどうしても捨てちゃうものがでるのは仕方ないって思う",
            "zh": "我觉得过程中总会有不得不丢掉的东西，这是没办法的",
            "narrator_zh": "神乐"
        },
        {
            "location": "773/TALK",
            "narrator": "神楽",
            "text": "でもさ！",
            "zh": "可是啊！",
            "narrator_zh": "神乐"
        },
        {
            "location": "774/TALK",
            "narrator": "神楽",
            "text": "最初からどう考えても相容れないものを入れようとするのはさ～",
            "zh": "可一上来就硬要把怎么想都格格不入的东西塞进来这种事啊～",
            "narrator_zh": "神乐"
        },
        {
            "location": "775/TALK",
            "narrator": "神楽",
            "text": "なんていうの？",
            "zh": "该怎么说呢？",
            "narrator_zh": "神乐"
        },
        {
            "location": "777/TALK",
            "narrator": "神楽",
            "text": "愚の骨頂？？？",
            "zh": "简直愚蠢透顶？？？",
            "narrator_zh": "神乐"
        },
        {
            "location": "779/SEL",
            "narrator": "",
            "text": "相当怒ってるね…",
            "zh": "她相当生气呢……",
            "narrator_zh": ""
        },
        {
            "location": "780/SEL",
            "narrator": "",
            "text": "そうなんだ",
            "zh": "是这样啊",
            "narrator_zh": ""
        },
        {
            "location": "781/SEL",
            "narrator": "",
            "text": "色んな考えがあるもんね",
            "zh": "毕竟大家想法都不一样嘛",
            "narrator_zh": ""
        },
        {
            "location": "782/ACT",
            "narrator": "",
            "text": "相当怒ってるね…",
            "zh": "她相当生气呢……",
            "narrator_zh": ""
        },
        {
            "location": "783/TALK",
            "narrator": "神楽",
            "text": "怒ってるね",
            "zh": "是在生气呀",
            "narrator_zh": "神乐"
        },
        {
            "location": "784/TALK",
            "narrator": "神楽",
            "text": "実際",
            "zh": "实际上",
            "narrator_zh": "神乐"
        },
