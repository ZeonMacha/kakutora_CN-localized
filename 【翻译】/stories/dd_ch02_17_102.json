{
    "dir": "chap17/daydra/dd_ch02_17_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "17205",
        "cid": "ayami",
        "title": "005 メインストーリー",
        "sub_title": "局所的先輩会議＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "局部前辈会议＜后篇＞"
    },
    "entry": [
        {
            "location": "541/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "542/TALK",
            "narrator": "みやび",
            "text": "でな、\n話を続けるけんど――",
            "zh": "然后呢，\n我继续往下说不过——",
            "narrator_zh": "雅"
        },
        {
            "location": "543/TALK",
            "narrator": "アーヤ",
            "text": "待って…その前に、\n言っておくことがあるの。",
            "zh": "等等……在那之前，\n我有话想先说。",
            "narrator_zh": "绫水"
        },
        {
            "location": "544/TALK",
            "narrator": "アーヤ",
            "text": "この話だけど…、\n私を信頼して話してくれた\nことは、とっても嬉しい。",
            "zh": "关于这件事……\n你能这么信任我并告诉我，\n我真的非常高兴。",
            "narrator_zh": "绫水"
        },
        {
            "location": "547/TALK",
            "narrator": "アーヤ",
            "text": "でも…ごめんなさい。\n正直、スケールが\n大き過ぎる話だわ。",
            "zh": "但是……对不起。\n老实说，这事的格局\n实在太大了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "548/TALK",
            "narrator": "アーヤ",
            "text": "だから…このまま聞いても\n解決できる自信ないの。",
            "zh": "所以……就算就这么听下去，\n我也没有能解决的自信。",
            "narrator_zh": "绫水"
        },
        {
            "location": "550/TALK",
            "narrator": "アーヤ",
            "text": "それでも…話の続き、\n聞かせてもらえる？",
            "zh": "即便如此……后面的话，\n你还是愿意讲给我听吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "551/TALK",
            "narrator": "みやび",
            "text": "もちろんや。",
            "zh": "那是当然咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "552/TALK",
            "narrator": "みやび",
            "text": "うちも、解決してもらえる\n思うて話したわけやない。",
            "zh": "我也不是指望你能\n解决才跟你说啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "553/TALK",
            "narrator": "みやび",
            "text": "ただ、情報を共有して\nおきたかっただけやき。",
            "zh": "只是想先把情报\n共享给你罢了嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "554/TALK",
            "narrator": "アーヤ",
            "text": "そう…。",
            "zh": "这样啊……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "555/TALK",
            "narrator": "みやび",
            "text": "…話、続けるがよ。",
            "zh": "……那我继续说咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "556/TALK",
            "narrator": "みやび",
            "text": "仮に…、まっこと\nフェノメノンが人為的に\n起こされていたとする。",
            "zh": "假设……如果PhenoMENON\n真的是被人蓄意\n引发的。",
            "narrator_zh": "雅"
        },
        {
            "location": "557/TALK",
            "narrator": "みやび",
            "text": "そうなると、\nうちらにとっては\n大問題ぞね。",
            "zh": "那样一来，\n对我们而言可就是\n大问题啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "558/TALK",
            "narrator": "みやび",
            "text": "敵は明らかに、うちらに\n狙いを定めてるっちゅう\nことになるきね。",
            "zh": "这就说明敌人明显是\n冲着我们来\n的咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "559/TALK",
            "narrator": "アーヤ",
            "text": "えっ、どうして？",
            "zh": "哎，为什么？",
            "narrator_zh": "绫水"
        },
        {
            "location": "560/TALK",
            "narrator": "みやび",
            "text": "この前のフェノメノンが\n出現した場所や。",
            "zh": "上一次PhenoMENON\n出现的地方咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "561/TALK",
            "narrator": "アーヤ",
            "text": "…？",
            "zh": "……？",
            "narrator_zh": "绫水"
        },
        {
            "location": "562/TALK",
            "narrator": "みやび",
            "text": "…そうやったな。\nつばめちゃん以外には\n教えてなかったんやった。",
            "zh": "……对哦。\n除了燕以外，\n还没告诉过其他人呢。",
            "narrator_zh": "雅"
        },
        {
            "location": "563/TALK",
            "narrator": "みやび",
            "text": "実は、あの時…、\n卯月の家がフェノメノンに\n巻き込まれちょったがよ。",
            "zh": "其实那时候……\n卯月的家刚好被卷进\nPhenoMENON里头了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "565/TALK",
            "narrator": "アーヤ",
            "text": "え…、えぇっ！？",
            "zh": "哎……哎哎！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "567/TALK",
            "narrator": "みやび",
            "text": "すまん…プライベートに\n関わる情報やったき、\n言えんかったがよ…。",
            "zh": "对不住……因为是涉及\n隐私的情报，\n没法随便往外说啵……。",
            "narrator_zh": "雅"
        },
        {
            "location": "569/TALK",
            "narrator": "アーヤ",
            "text": "じゃ、じゃあ…あの時に\n卯月の様子が\nおかしかったのって…。",
            "zh": "那、那么……那时候\n卯月的样子\n那么反常，难道……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "572/TALK",
            "narrator": "みやび",
            "text": "家族が巻き込まれちゅう\n状況で、冷静でいられる\nはずないちや。",
            "zh": "家里人都被卷进去了，\n换谁也不可能\n保持冷静咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "574/TALK",
            "narrator": "アーヤ",
            "text": "そ、そんな…。",
            "zh": "怎、怎么会……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "576/TALK",
            "narrator": "アーヤ",
            "text": "私…とんでもないこと\nしちゃった…。",
            "zh": "我……做了不得了的\n事情……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "578/TALK",
            "narrator": "アーヤ",
            "text": "知らなかったからって、\n卯月に、あんなに強く\n酷いことを…。",
            "zh": "就因为不知情，\n对卯月说了那么重\n那么过分的话……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "580/TALK",
            "narrator": "みやび",
            "text": "しっかし、どうにも\nわからん…。",
            "zh": "不过话说回来，实在\n搞不懂……。",
            "narrator_zh": "雅"
        },
        {
            "location": "581/TALK",
            "narrator": "みやび",
            "text": "フェノメノンは、人の心の\n一部がこの世界に顕在し、\n世界を作るものや。",
            "zh": "PhenoMENON，是人心里\n的一部分在这个世界显现，\n从而创造出世界的东西。",
            "narrator_zh": "雅"
        },
        {
            "location": "582/TALK",
            "narrator": "みやび",
            "text": "けんど、その際にもの凄い\nエネルギーがかかるんよ。",
            "zh": "不过，在那时候需要消耗\n极其庞大的能量。",
            "narrator_zh": "雅"
        },
        {
            "location": "583/TALK",
            "narrator": "アーヤ",
            "text": "…家族が巻き込まれて、\nそれで必死になって、\nあんな行動に出たんだわ。",
            "zh": "……家人被卷进去了，\n所以才会那么拼命，\n做出那样的举动啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "584/TALK",
            "narrator": "みやび",
            "text": "人の魂の重さは無限。\nそんな言葉聞いたこと\nあるやろ？",
            "zh": "人的灵魂重量是无限的。\n你应该听说过\n这句话吧？",
            "narrator_zh": "雅"
        },
        {
            "location": "585/TALK",
            "narrator": "みやび",
            "text": "実際それが本当なのかは、\nうちにもわからん。",
            "zh": "实际上这是不是真的，\n我也不晓得。",
            "narrator_zh": "雅"
        },
        {
            "location": "586/TALK",
            "narrator": "みやび",
            "text": "まあ、無限っちゅうのは\n言い過ぎやろうけんど、\nかなり大きいやろうね。",
            "zh": "嘛，说无限是\n夸张了点不过，\n确实相当庞大吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "587/TALK",
            "narrator": "みやび",
            "text": "…とはいえ、フェノメノン\n生み出せるほどではないと\n思うけんど。",
            "zh": "……话虽如此，应该也不至于\n大到能凭空制造出PhenoMENON\n的程度才对。",
            "narrator_zh": "雅"
        },
        {
            "location": "588/TALK",
            "narrator": "みやび",
            "text": "半径数百メートル内の\n世界を全て改ざんとか、\n常軌を逸し過ぎや。",
            "zh": "把半径数百米内的\n世界全都篡改什么的，\n未免太违背常理了。",
            "narrator_zh": "雅"
        },
        {
            "location": "590/TALK",
            "narrator": "アーヤ",
            "text": "しかも、メノウのことまで\nバレてもっとショックを\n受けてた卯月に…。",
            "zh": "而且，连MENOW的事都\n暴露了，让本就备受打击的\n卯月雪上加霜……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "591/TALK",
            "narrator": "みやび",
            "text": "けんど、フェノメノンを\n生み出すための、\nその巨大なエネルギー。",
            "zh": "不过，用来催生出\nPhenoMENON的那股\n庞大能量。",
            "narrator_zh": "雅"
        },
        {
            "location": "592/TALK",
            "narrator": "みやび",
            "text": "これが外から来てるゆう\n意味に捉えられる内容が、\n資料の中にあったちや。",
            "zh": "资料里头有段内容，\n可以理解成这股能量\n是从外部传过来的咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "594/TALK",
            "narrator": "みやび",
            "text": "やき、その外から来てる\n大元がどこなのかが\nわかれば――",
            "zh": "所以，只要能查明那个\n从外部输过来的源头\n究竟在哪里——",
            "narrator_zh": "雅"
        },
        {
            "location": "596/TALK",
            "narrator": "みやび",
            "text": "ん？",
            "zh": "嗯？",
            "narrator_zh": "雅"
        },
        {
            "location": "597/TALK",
            "narrator": "アーヤ",
            "text": "苦しんでる仲間に、\n私は…追い打ちを\nかけたなんて…。",
            "zh": "对正在痛苦的同伴，\n我居然……还那样\n落井下石……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "598/TALK",
            "narrator": "みやび",
            "text": "…アーヤ？\nうちの話聞いちょる？",
            "zh": "……绫水？\n你在听我说话吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "599/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "600/TALK",
            "narrator": "みやび",
            "text": "…アーヤは悪くないぞね。\nそんな気に病まんでも\nえいんよ。",
            "zh": "……这不关绫水的错啵。\n用不着这么\n耿耿于怀。",
            "narrator_zh": "雅"
        },
        {
            "location": "601/TALK",
            "narrator": "みやび",
            "text": "アーヤは、卯月の実家の\n場所を知らんかった。",
            "zh": "绫水又不知道\n卯月老家的位置。",
            "narrator_zh": "雅"
        },
        {
            "location": "602/TALK",
            "narrator": "みやび",
            "text": "卯月も、自分の家が\n巻き込まれちょるのを\n言わんかった。",
            "zh": "卯月自己也没把家里\n被卷进去的事\n说出来啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "603/TALK",
            "narrator": "みやび",
            "text": "それじゃ、卯月の家が\n巻き込まれちょるなんて、\nわかるはずないやろ？",
            "zh": "既然这样，你怎么可能\n晓得卯月家\n被卷进去了嘛？",
            "narrator_zh": "雅"
        },
        {
            "location": "605/TALK",
            "narrator": "アーヤ",
            "text": "それは、そうだけど…。",
            "zh": "话是这么说没错……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "606/TALK",
            "narrator": "みやび",
            "text": "じゃあ、何か？",
            "zh": "那怎么着？",
            "narrator_zh": "雅"
        },
        {
            "location": "607/TALK",
            "narrator": "みやび",
            "text": "実家が巻き込まれてれば、\n自分勝手な行動が正当化\nできるゆうんか？",
            "zh": "难道只要老家被卷进去了，\n擅作主张的行动就能\n被正当化了吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "608/TALK",
            "narrator": "アーヤ",
            "text": "まさか！\nそんなわけないでしょ…。",
            "zh": "怎么可能！\n当然不是那样……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "609/TALK",
            "narrator": "みやび",
            "text": "そうやろ？",
            "zh": "那不就结了？",
            "narrator_zh": "雅"
        },
        {
            "location": "610/TALK",
            "narrator": "みやび",
            "text": "アーヤは、リーダーとして\n当然のことをしただけや。",
            "zh": "绫水只是尽了\n作为队长分内的职责而已。",
            "narrator_zh": "雅"
        },
        {
            "location": "611/TALK",
            "narrator": "みやび",
            "text": "自分勝手な行動をして、\n勝手な行動を起こした\n卯月を叱った。",
            "zh": "斥责了只顾着自己、\n擅自采取行动的\n卯月。",
            "narrator_zh": "雅"
        },
        {
            "location": "612/TALK",
            "narrator": "みやび",
            "text": "それは、どんな状況でも\nやらんといかんことや。",
            "zh": "那是无论在什么情况下，\n都必须做的事。",
            "narrator_zh": "雅"
        },
        {
            "location": "614/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "615/TALK",
            "narrator": "みやび",
            "text": "なんや？　まだ自分が\n間違うたことをしたと\n思うてるが？",
            "zh": "搞么子？　你该不会还觉得\n自己做错了\n吧？",
            "narrator_zh": "雅"
        },
        {
            "location": "618/TALK",
            "narrator": "アーヤ",
            "text": "…ううん。",
            "zh": "……没有。",
            "narrator_zh": "绫水"
        },
        {
            "location": "619/TALK",
            "narrator": "アーヤ",
            "text": "ありがとう、みやび…。\nちょっと、元気出たわ。",
            "zh": "谢谢你，雅……。\n稍微，打起精神来了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "620/TALK",
            "narrator": "みやび",
            "text": "…まあ、気にするなゆうて\n割り切れる性格やないのは\nわかっちょるぞね。",
            "zh": "……嘛，我也晓得你不是\n听人劝一句“别在意”就能\n想开的性子啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "621/TALK",
            "narrator": "みやび",
            "text": "けんど、うちはアーヤが\n間違うたことをしたとは\n思うちょらん。",
            "zh": "不过，我可不觉得\n绫水做了什么\n错事。",
            "narrator_zh": "雅"
        },
        {
            "location": "622/TALK",
            "narrator": "アーヤ",
            "text": "…ん、ありがとう。",
            "zh": "……嗯，谢谢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "623/TALK",
            "narrator": "アーヤ",
            "text": "…それで？\nなんの話だったかしら？",
            "zh": "……然后呢？\n刚才说到哪里来着？",
            "narrator_zh": "绫水"
        },
        {
            "location": "624/TALK",
            "narrator": "みやび",
            "text": "ああ…フェノメノンが\n人為的に起こされちょる\n可能性がある。",
            "zh": "哦哦……就是PhenoMENON\n有可能是人为引发的\n这件事。",
            "narrator_zh": "雅"
        },
        {
            "location": "625/TALK",
            "narrator": "みやび",
            "text": "今は、それだけ覚えといて\nもらえればえいよ。",
            "zh": "眼下，你只要先记住\n这一点就够咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "627/TALK",
            "narrator": "アーヤ",
            "text": "ん…わかった…。",
            "zh": "嗯……我明白了……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "629/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "630/TALK",
            "narrator": "みやび",
            "text": "すまんけんど、\nうちは先に帰るちや。",
            "zh": "对不住咯，\n我先回去了啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "631/TALK",
            "narrator": "みやび",
            "text": "しばらく、一人で\n気持ちまとめてから\n帰ってきぃ。",
            "zh": "你一个人待一会，\n把心情整理好了\n再回来吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "633/TALK",
            "narrator": "アーヤ",
            "text": "…そうするわ。",
            "zh": "……我会的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "638/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "644/TALK",
            "narrator": "アーヤ",
            "text": "$handle$はどう思う？",
            "zh": "$handle$怎么想？",
            "narrator_zh": "绫水"
        },
        {
            "location": "645/TALK",
            "narrator": "アーヤ",
            "text": "私が",
            "zh": "关于我",
            "narrator_zh": "绫水"
        },
        {
            "location": "646/TALK",
            "narrator": "アーヤ",
            "text": "卯月を叱ったこと(-.-;)",
            "zh": "斥责了卯月这件事(-.-;)",
            "narrator_zh": "绫水"
        },
        {
            "location": "647/TALK",
            "narrator": "アーヤ",
            "text": "みやびは",
            "zh": "雅",
            "narrator_zh": "绫水"
        },
        {
            "location": "648/TALK",
            "narrator": "アーヤ",
            "text": "正しいって言ってくれた",
            "zh": "说我是对的",
            "narrator_zh": "绫水"
        },
        {
            "location": "649/TALK",
            "narrator": "アーヤ",
            "text": "でも",
            "zh": "可是",
            "narrator_zh": "绫水"
        },
        {
            "location": "651/TALK",
            "narrator": "アーヤ",
            "text": "自信が持てない(>_<)",
            "zh": "我还是没自信(>_<)",
            "narrator_zh": "绫水"
        },
        {
            "location": "652/TALK",
            "narrator": "アーヤ",
            "text": "本当に",
            "zh": "真的",
            "narrator_zh": "绫水"
        },
        {
            "location": "653/TALK",
            "narrator": "アーヤ",
            "text": "あれでよかったのか(ノД`)",
            "zh": "那样做就行了吗(ノД`)",
            "narrator_zh": "绫水"
        },
        {
            "location": "656/SEL",
            "narrator": "",
            "text": "間違ってないよ、自信持って！",
            "zh": "你没有错，拿出自信来！",
            "narrator_zh": ""
        },
        {
            "location": "657/SEL",
            "narrator": "",
            "text": "$me$にもわからない",
            "zh": "$me$也不清楚",
            "narrator_zh": ""
        },
        {
            "location": "658/SEL",
            "narrator": "",
            "text": "理由を聞かなかったのが間違い",
            "zh": "没问清理由是错的",
            "narrator_zh": ""
        },
        {
            "location": "659/ACT",
            "narrator": "",
            "text": "間違ってないよ、自信持って！",
            "zh": "你没有错，拿出自信来！",
            "narrator_zh": ""
        },
        {
            "location": "661/TALK",
            "narrator": "アーヤ",
            "text": "ありがとう(｡-_-｡)",
            "zh": "谢谢(｡-_-｡)",
            "narrator_zh": "绫水"
        },
        {
            "location": "662/TALK",
            "narrator": "アーヤ",
            "text": "ごめんなさい",
            "zh": "对不起",
            "narrator_zh": "绫水"
        },
        {
            "location": "663/TALK",
            "narrator": "アーヤ",
            "text": "いつまでもウジウジ(-ω-;)",
            "zh": "一直这样瞻前顾后(-ω-;)",
            "narrator_zh": "绫水"
        },
        {
            "location": "664/TALK",
            "narrator": "アーヤ",
            "text": "でも",
            "zh": "不过",
            "narrator_zh": "绫水"
        },
        {
            "location": "665/TALK",
            "narrator": "アーヤ",
            "text": "もう平気だから",
            "zh": "已经没事了",
            "narrator_zh": "绫水"
        },
        {
            "location": "668/TALK",
            "narrator": "アーヤ",
            "text": "気持ち切り替えるわ(^^",
            "zh": "我会调整好心情的(^^",
            "narrator_zh": "绫水"
        },
        {
            "location": "671/ACT",
            "narrator": "",
            "text": "$me$にもわからない",
            "zh": "$me$也不清楚",
            "narrator_zh": ""
        },
        {
            "location": "672/TALK",
            "narrator": "アーヤ",
            "text": "そう(-.-;)",
            "zh": "这样啊(-.-;)",
            "narrator_zh": "绫水"
        },
        {
            "location": "675/TALK",
            "narrator": "アーヤ",
            "text": "もしかしたら",
            "zh": "说不定",
            "narrator_zh": "绫水"
        },
        {
            "location": "676/TALK",
            "narrator": "アーヤ",
            "text": "間違ってもいるし",
            "zh": "既做错了",
            "narrator_zh": "绫水"
        },
        {
            "location": "677/TALK",
            "narrator": "アーヤ",
            "text": "間違ってもいない",
            "zh": "又没有错",
            "narrator_zh": "绫水"
        },
        {
            "location": "678/TALK",
            "narrator": "アーヤ",
            "text": "だからかしら？",
            "zh": "是因为这样吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "681/TALK",
            "narrator": "アーヤ",
            "text": "私にもわからない(´o｀；",
            "zh": "连我自己也弄不明白(´o｀；",
            "narrator_zh": "绫水"
        },
        {
            "location": "682/TALK",
            "narrator": "アーヤ",
            "text": "ありがとう",
            "zh": "谢谢你",
            "narrator_zh": "绫水"
        },
        {
            "location": "684/TALK",
            "narrator": "アーヤ",
            "text": "相談乗ってくれてm(_ _)m",
            "zh": "愿意听我倾诉m(_ _)m",
            "narrator_zh": "绫水"
        },
        {
            "location": "691/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "692/TALK",
            "narrator": "アーヤ",
            "text": "ダメよね…。\nいつまでも、こんなに\nウジウジしてたら…。",
            "zh": "不行啊……。\n要是总这样\n犹豫不决的话……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "694/TALK",
            "narrator": "アーヤ",
            "text": "私にはわからないけど、\nみやびは、ハッキリと\n言ってくれた。",
            "zh": "虽然我自己也不清楚，\n但雅明确地\n告诉了我。",
            "narrator_zh": "绫水"
        },
        {
            "location": "695/TALK",
            "narrator": "アーヤ",
            "text": "だから、今はみやびの\n言葉を信じよう…。",
            "zh": "所以，现在就先相信\n雅的话吧……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "696/ACT",
            "narrator": "",
            "text": "理由を聞かなかったのが間違い",
            "zh": "没问清理由是错的",
            "narrator_zh": ""
        },
        {
            "location": "697/TALK",
            "narrator": "アーヤ",
            "text": "そうよね",
            "zh": "是啊",
            "narrator_zh": "绫水"
        },
        {
            "location": "698/TALK",
            "narrator": "アーヤ",
            "text": "$handle$の言う通り(; ;)",
            "zh": "就像$handle$说的(; ;)",
            "narrator_zh": "绫水"
        },
        {
            "location": "699/TALK",
            "narrator": "アーヤ",
            "text": "卯月は今まで",
            "zh": "卯月至今为止",
            "narrator_zh": "绫水"
        },
        {
            "location": "700/TALK",
            "narrator": "アーヤ",
            "text": "勝手な行動はしなかった",
            "zh": "从来没有擅自行动过",
            "narrator_zh": "绫水"
        },
        {
            "location": "701/TALK",
            "narrator": "アーヤ",
            "text": "なのに",
            "zh": "可我却",
            "narrator_zh": "绫水"
        },
        {
            "location": "702/TALK",
            "narrator": "アーヤ",
            "text": "理由があると考えずに",
            "zh": "没去想她是不是有什么理由",
            "narrator_zh": "绫水"
        },
        {
            "location": "703/TALK",
            "narrator": "アーヤ",
            "text": "感情的に叱りつけた(ノД`)",
            "zh": "就情绪化地斥责了她(ノД`)",
            "narrator_zh": "绫水"
        },
        {
            "location": "705/TALK",
            "narrator": "アーヤ",
            "text": "大人として",
            "zh": "作为大人",
            "narrator_zh": "绫水"
        },
        {
            "location": "707/TALK",
            "narrator": "アーヤ",
            "text": "恥ずかしいことした(>_<)",
            "zh": "做了件好丢人的事(>_<)",
            "narrator_zh": "绫水"
        },
        {
            "location": "708/TALK",
            "narrator": "アーヤ",
            "text": "反省しないと(T_T)",
            "zh": "不好好反省不行(T_T)",
            "narrator_zh": "绫水"
        },
        {
            "location": "714/TALK",
            "narrator": "アーヤ",
            "text": "やっぱり、神楽には\nちゃんと謝った方が…。",
            "zh": "果然，还是应该去向神乐\n好好道个歉才……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "715/TALK",
            "narrator": "アーヤ",
            "text": "…いや、やっぱりダメ。",
            "zh": "……不，还是不行。",
            "narrator_zh": "绫水"
        },
        {
            "location": "717/TALK",
            "narrator": "アーヤ",
            "text": "どんな理由があっても、\n戦闘中の勝手な行動は\n許されない。",
            "zh": "无论有什么理由，\n战斗中的擅自行动\n都是不被允许的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "718/TALK",
            "narrator": "アーヤ",
            "text": "隊員全員の命に関わる\n問題に発展する可能性も\nあるんだから…。",
            "zh": "因为这有可能会发展成\n危及全体队员性命的\n大问题……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "719/TALK",
            "narrator": "アーヤ",
            "text": "みやびも言ってたけど、\n叱ったこと事態に\n間違はないはず。",
            "zh": "就像雅也说过的那样，\n斥责她这件事本身\n应该没有错。",
            "narrator_zh": "绫水"
        },
        {
            "location": "720/TALK",
            "narrator": "アーヤ",
            "text": "…でも、感情的になって\n怒ったことは、\n本当に反省しないと…。",
            "zh": "……但是，情绪上头\n发火这一点，\n真的得好好反省才行……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "722/TALK",
            "narrator": "アーヤ",
            "text": "私も、まだまだ精神的に\n大人になり切れてない、\nってことね…。",
            "zh": "也就是说，我在精神上\n也还远远称不上\n是个成熟的大人呢……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "734/DIALOG",
            "narrator": "Dialog_chapter_ch02",
            "text": "【14 神楽学校やめるってよ】",
            "zh": "【14 听说神乐要退学了】",
            "narrator_zh": "Dialog_chapter_ch02"
        }
    ]
