{
    "dir": "chap16/daydra/dd_ch02_16_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "16252",
        "cid": "ayami",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "ゴキブリ注意",
        "title_zh": "Extra002 额外剧情",
        "sub_title_zh": "小心蟑螂"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "ゴキブリ注意",
            "zh": "小心蟑螂",
            "narrator_zh": ""
        },
        {
            "location": "24/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…暇ねぇ…。",
            "zh": "哈啊……好闲啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "26/TALK",
            "narrator": "つばめ",
            "text": "やることやっちゃうと、\n閉館まですること\nないもんね？",
            "zh": "把该做的事做完后，\n到闭馆前就没什么事\n可做了呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "27/TALK",
            "narrator": "ガブリエラ",
            "text": "まあ、こういう時こそ\nスマホゲームに没頭して、\n時間を忘れた方が――",
            "zh": "嘛，越是这种时候\n越该沉浸在手游里，\n忘掉时间才――",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "28/TALK",
            "narrator": "ガブリエラ",
            "text": "ん？",
            "zh": "嗯？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "30/TALK",
            "narrator": "つばめ",
            "text": "え、なに？",
            "zh": "咦，怎么了？",
            "narrator_zh": "燕"
        },
        {
            "location": "32/TALK",
            "narrator": "ガブリエラ",
            "text": "今、なんかカサカサって\n音がしたような…。",
            "zh": "刚才，好像听到什么\n沙沙作响的声音……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "33/TALK",
            "narrator": "つばめ",
            "text": "カサカサ？\nなんだろう…。",
            "zh": "沙沙声？\n是什么呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "36/TALK",
            "narrator": "ガブリエラ",
            "text": "確か、ちゃぶ台の下から\n聞こえ――",
            "zh": "记得是从矮脚桌底下\n传出来的――",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "41/TALK",
            "narrator": "ガブリエラ",
            "text": "ひっ！？\nいやぁぁぁぁぁぁぁ！！",
            "zh": "噫！？\n不要啊啊啊啊啊啊啊！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "44/TALK",
            "narrator": "つばめ",
            "text": "が、ガブちゃん！？\nどうし――",
            "zh": "加、加布！？\n怎么――",
            "narrator_zh": "燕"
        },
        {
            "location": "47/TALK",
            "narrator": "つばめ",
            "text": "やだ、ゴキブリ！？\nきゃあぁぁぁぁぁぁ！！",
            "zh": "讨厌，蟑螂！？\n呀啊啊啊啊啊啊！！",
            "narrator_zh": "燕"
        },
        {
            "location": "51/TALK",
            "narrator": "ガブリエラ",
            "text": "こここ、こっち来た！！\nつばめ、あんた何とか\nしなさいよ！",
            "zh": "这这这、朝这边过来了！！\n燕，你快想想\n办法啊！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "55/TALK",
            "narrator": "つばめ",
            "text": "む、無理だよぉ！！",
            "zh": "做、做不到啦！！",
            "narrator_zh": "燕"
        },
        {
            "location": "58/TALK",
            "narrator": "ガブリエラ",
            "text": "誰か！！\n誰か来てぇ！！",
            "zh": "来人啊！！\n谁快来啊！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "70/TALK",
            "narrator": "アーヤ",
            "text": "ふぁ…。",
            "zh": "呼啊……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "71/TALK",
            "narrator": "アーヤ",
            "text": "っ！\nいけないいけない。",
            "zh": "唔！\n不行不行。",
            "narrator_zh": "绫水"
        },
        {
            "location": "72/TALK",
            "narrator": "アーヤ",
            "text": "いくら暇だからって、\nバイト中にあくびは\nいけないわね。",
            "zh": "就算再闲，\n打工期间打哈欠\n也是不行的呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "73/TALK",
            "narrator": "アーヤ",
            "text": "…でも、本当に\n今日は暇だわ…。",
            "zh": "……不过，今天\n真的好闲啊……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "74/TALK",
            "narrator": "アーヤ",
            "text": "やることなくて、\nこのままじゃ本当に\n寝ちゃいそう…。",
            "zh": "没什么事可做，\n再这样下去感觉\n真的要睡着了……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "75/SEL",
            "narrator": "",
            "text": "暇そうだね",
            "zh": "看起来很闲呢",
            "narrator_zh": ""
        },
        {
            "location": "78/TALK",
            "narrator": "アーヤ",
            "text": "はぁ…",
            "zh": "哈啊……",
            "narrator_zh": "绫水"
        },
        {
            "location": "79/TALK",
            "narrator": "アーヤ",
            "text": "………………。",
            "zh": "………………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "80/TALK",
            "narrator": "アーヤ",
            "text": "………………。",
            "zh": "………………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "84/TALK",
            "narrator": "アーヤ",
            "text": "くぅ…。",
            "zh": "呼……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "86/TALK",
            "narrator": "アーヤ",
            "text": "はっ！？",
            "zh": "哈！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "87/TALK",
            "narrator": "アーヤ",
            "text": "ああもう、\nしっかりしなきゃ！",
            "zh": "啊真是的，\n得振作起来才行！",
            "narrator_zh": "绫水"
        },
        {
            "location": "88/TALK",
            "narrator": "アーヤ",
            "text": "ちょっと、外の空気にでも\n当たってこよう…。",
            "zh": "稍微去外面透透气\n好了……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "90/ACT",
            "narrator": "",
            "text": "暇そうだね",
            "zh": "看起来很闲呢",
            "narrator_zh": ""
        },
        {
            "location": "97/TALK",
            "narrator": "アーヤ",
            "text": "…いいタイミングね。",
            "zh": "……时机真巧呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "111/TALK",
            "narrator": "アーヤ",
            "text": "暇過ぎて寝そう(；´Д｀)",
            "zh": "太闲了感觉要睡着了(；´Д｀)",
            "narrator_zh": "绫水"
        },
        {
            "location": "112/TALK",
            "narrator": "アーヤ",
            "text": "けど、声掛けてもらえたから目が覚めた",
            "zh": "不过，你跟我搭话后就清醒了",
            "narrator_zh": "绫水"
        },
        {
            "location": "113/TALK",
            "narrator": "アーヤ",
            "text": "もう大丈夫(*≧∀≦*) ",
            "zh": "已经没事了(*≧∀≦*) ",
            "narrator_zh": "绫水"
        },
        {
            "location": "114/TALK",
            "narrator": "アーヤ",
            "text": "けど、暇過ぎて時間を無駄にしてる気分…",
            "zh": "不过，太闲了总有种在浪费时间的感觉……",
            "narrator_zh": "绫水"
        },
        {
            "location": "116/SEL",
            "narrator": "",
            "text": "楽屋に行ってみよう",
            "zh": "去休息室看看吧",
            "narrator_zh": ""
        },
        {
            "location": "117/SEL",
            "narrator": "",
            "text": "楽屋にゴキブリが出たよ",
            "zh": "休息室里出现蟑螂了哦",
            "narrator_zh": ""
        },
        {
            "location": "118/SEL",
            "narrator": "",
            "text": "平和が一番さ",
            "zh": "和平是最好的啦",
            "narrator_zh": ""
        },
        {
            "location": "119/ACT",
            "narrator": "",
            "text": "楽屋に行ってみよう",
            "zh": "去休息室看看吧",
            "narrator_zh": ""
        },
        {
            "location": "121/TALK",
            "narrator": "アーヤ",
            "text": "そうね…楽屋なら誰かしらいると思うし",
            "zh": "是啊……去休息室的话应该有人在吧",
            "narrator_zh": "绫水"
        },
        {
            "location": "122/TALK",
            "narrator": "アーヤ",
            "text": "お喋りでもしてくるわ",
            "zh": "我去和她们聊聊天",
            "narrator_zh": "绫水"
        },
        {
            "location": "146/TALK",
            "narrator": "ガブリエラ",
            "text": "つばめ、そっち行った！",
            "zh": "燕，朝你那边去了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "150/TALK",
            "narrator": "つばめ",
            "text": "きゃーっ！！\nこ、来ないで来ないでー！",
            "zh": "呀啊——！！\n别、别过来别过来——！",
            "narrator_zh": "燕"
        },
        {
            "location": "151/TALK",
            "narrator": "ガブリエラ",
            "text": "ちゃぶ台！\nちゃぶ台の上に避難して！",
            "zh": "矮脚桌！\n快避难到矮脚桌上去！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "152/TALK",
            "narrator": "つばめ",
            "text": "きゃーっ！！",
            "zh": "呀啊——！！",
            "narrator_zh": "燕"
        },
        {
            "location": "155/TALK",
            "narrator": "アーヤ",
            "text": "ちょっと、どうしたの？\nいくら何でも騒ぎ過ぎよ。",
            "zh": "我说，怎么了？\n不管怎么说也太吵了哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "157/TALK",
            "narrator": "つばめ",
            "text": "あ、アーヤさん！！",
            "zh": "啊、绫水！！",
            "narrator_zh": "燕"
        },
        {
            "location": "159/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤ、足元！\n踏んづけて！",
            "zh": "绫水，脚边！\n快踩扁它！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "163/TALK",
            "narrator": "アーヤ",
            "text": "え？",
            "zh": "咦？",
            "narrator_zh": "绫水"
        },
        {
            "location": "164/TALK",
            "narrator": "アーヤ",
            "text": "きゃぁぁぁぁぁぁぁっ！\nちょ、やだ！　ゴキブリ！",
            "zh": "呀啊啊啊啊啊啊啊！\n等、讨厌！　蟑螂！",
            "narrator_zh": "绫水"
        },
        {
            "location": "165/TALK",
            "narrator": "つばめ",
            "text": "アーヤさん、この雑誌！\n使ってください！",
            "zh": "绫水，这本杂志！\n请用这个！",
            "narrator_zh": "燕"
        },
        {
            "location": "167/TALK",
            "narrator": "アーヤ",
            "text": "くっ…てぇいっ！",
            "zh": "唔……嘿呀！",
            "narrator_zh": "绫水"
        },
        {
            "location": "175/TALK",
            "narrator": "ガブリエラ",
            "text": "やった、仕留めた！",
            "zh": "太好了，干掉了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "179/TALK",
            "narrator": "つばめ",
            "text": "はぁ…よ、よかったぁ…。",
            "zh": "哈啊……太、太好了呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "182/TALK",
            "narrator": "アーヤ",
            "text": "はぁ、はぁ…な、なに？\nどういうことなの？",
            "zh": "哈啊，哈啊……什、什么？\n这到底是怎么回事？",
            "narrator_zh": "绫水"
        },
        {
            "location": "184/TALK",
            "narrator": "ガブリエラ",
            "text": "ゴキブリよ、ゴキブリ！\n急に出てきたから、\n驚いて逃げてたのよ。",
            "zh": "是蟑螂啦，蟑螂！\n突然冒出来了，\n我们吓得只好逃跑了嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "187/TALK",
            "narrator": "アーヤ",
            "text": "逃げてちゃ\n意味ないでしょ！？\n退治しなさいよ！",
            "zh": "光逃跑\n有什么用啊！？\n快点消灭掉啊！",
            "narrator_zh": "绫水"
        },
        {
            "location": "188/TALK",
            "narrator": "つばめ",
            "text": "で、でも、怖いじゃない\nですかぁ…。",
            "zh": "可、可是，那不是很可怕\n嘛……。",
            "narrator_zh": "燕"
        },
        {
            "location": "190/TALK",
            "narrator": "アーヤ",
            "text": "噛みつかれるわけでも\nないのに、まったく…。",
            "zh": "又不会被咬，\n真是的……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "191/TALK",
            "narrator": "ガブリエラ",
            "text": "なによ、アーヤだって\n大声で叫んだくせに。",
            "zh": "什么嘛，绫水你不也\n大声尖叫了吗。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "193/TALK",
            "narrator": "アーヤ",
            "text": "そ、そりゃ、入って\nすぐにゴキブリがいたら、\n誰だって叫ぶわよ…。",
            "zh": "那、那是因为刚一进来\n就看到蟑螂，\n不管是谁都会叫出来的吧……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "195/TALK",
            "narrator": "ガブリエラ",
            "text": "それはそうだけど――",
            "zh": "话是这么说没错――",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "196/TALK",
            "narrator": "ガブリエラ",
            "text": "なんか、すっごい可愛い\n叫び方で、そっちの方が\n驚いたかも。",
            "zh": "总觉得，叫声超级可爱的，\n反而更让我\n吃了一惊呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "197/TALK",
            "narrator": "アーヤ",
            "text": "なっ！？",
            "zh": "什！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "199/TALK",
            "narrator": "つばめ",
            "text": "わたしも、ちょっとだけ\nそう思いました。",
            "zh": "我也稍微\n这么觉得。",
            "narrator_zh": "燕"
        },
        {
            "location": "201/TALK",
            "narrator": "アーヤ",
            "text": "うっ…ば、バカなこと\n言ってないの！",
            "zh": "唔……别、别说\n傻话了！",
            "narrator_zh": "绫水"
        },
        {
            "location": "202/TALK",
            "narrator": "アーヤ",
            "text": "後でスプレーを用意して\nおくから――",
            "zh": "待会儿我会把杀虫喷雾\n准备好的――",
            "narrator_zh": "绫水"
        },
        {
            "location": "203/TALK",
            "narrator": "アーヤ",
            "text": "今度からは、自分たちで\n退治するのよ？",
            "zh": "从下次开始，你们要\n自己消灭掉哦？",
            "narrator_zh": "绫水"
        },
        {
            "location": "207/TALK",
            "narrator": "つばめ",
            "text": "あっ…行っちゃった…。\n怒らせちゃったかな？",
            "zh": "啊……走掉了……。\n是不是惹她生气了呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "209/TALK",
            "narrator": "ガブリエラ",
            "text": "照れてるだけよ。\n気にすることないって。",
            "zh": "她只是害羞了而已啦。\n不用在意的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "210/TALK",
            "narrator": "ガブリエラ",
            "text": "今気にしなきゃいけない\nのは…潰れたゴキブリを、\nどうすればいいかよ…。",
            "zh": "现在更该在意的\n是……这只被拍扁的蟑螂，\n该怎么处理才好啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "211/ACT",
            "narrator": "",
            "text": "楽屋にゴキブリが出たよ",
            "zh": "休息室里出现蟑螂了哦",
            "narrator_zh": ""
        },
        {
            "location": "212/TALK",
            "narrator": "アーヤ",
            "text": "へぇ、そんなことまでわかるんだ？",
            "zh": "诶，连这种事你都知道啊？",
            "narrator_zh": "绫水"
        },
        {
            "location": "213/TALK",
            "narrator": "アーヤ",
            "text": "っていうか、さっきから楽屋の方が騒がしいのって、それが原因？",
            "zh": "话说回来，刚才开始休息室那边就吵吵嚷嚷的，就是因为这个？",
            "narrator_zh": "绫水"
        },
        {
            "location": "226/TALK",
            "narrator": "アーヤ",
            "text": "確か、スプレーが\nこの辺に…。",
            "zh": "记得杀虫喷雾\n就在这附近……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "241/TALK",
            "narrator": "ガブリエラ",
            "text": "つばめ、そっち行った！",
            "zh": "燕，朝你那边去了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "243/TALK",
            "narrator": "つばめ",
            "text": "きゃーっ！！\nこ、来ないで来ないでー！",
            "zh": "呀啊——！！\n别、别过来别过来——！",
            "narrator_zh": "燕"
        },
        {
            "location": "244/TALK",
            "narrator": "ガブリエラ",
            "text": "ちゃぶ台！\nちゃぶ台の上に避難して！",
            "zh": "矮脚桌！\n快避难到矮脚桌上去！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "245/TALK",
            "narrator": "つばめ",
            "text": "きゃーっ！！",
            "zh": "呀啊——！！",
            "narrator_zh": "燕"
        },
        {
            "location": "247/TALK",
            "narrator": "アーヤ",
            "text": "ほら、騒がないの。\nゴキブリはどこ？",
            "zh": "好了，别吵了。\n蟑螂在哪儿？",
            "narrator_zh": "绫水"
        },
        {
            "location": "249/TALK",
            "narrator": "つばめ",
            "text": "そ、そこです！\n足元！",
            "zh": "就、就在那里！\n脚边！",
            "narrator_zh": "燕"
        },
        {
            "location": "251/TALK",
            "narrator": "アーヤ",
            "text": "…あ、いたいた。\nそれっ！",
            "zh": "……啊，看到了看到了。\n看招！",
            "narrator_zh": "绫水"
        },
        {
            "location": "260/TALK",
            "narrator": "ガブリエラ",
            "text": "やった！\nさすがねアーヤ！",
            "zh": "太好了！\n真不愧是绫水！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "263/TALK",
            "narrator": "つばめ",
            "text": "ありがとうございます、\nアーヤさん！",
            "zh": "谢谢你，\n绫水！",
            "narrator_zh": "燕"
        },
        {
            "location": "266/TALK",
            "narrator": "アーヤ",
            "text": "まったく…\nゴキブリくらいで\n騒ぎ過ぎよ。",
            "zh": "真是的……\n区区一只蟑螂\n吵得太夸张了啦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "267/TALK",
            "narrator": "アーヤ",
            "text": "さっさと退治しちゃえば\nいいだけなのに…。",
            "zh": "明明赶快消灭掉\n不就好了……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "268/TALK",
            "narrator": "つばめ",
            "text": "そんな…簡単に言われても\nできませんよ…。",
            "zh": "就算你这么轻松地说……\n我们也做不到呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "269/TALK",
            "narrator": "ガブリエラ",
            "text": "怖がらずに退治できる\nアーヤの方が変よ！",
            "zh": "能毫不害怕地消灭它的\n绫水才比较奇怪吧！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "271/TALK",
            "narrator": "アーヤ",
            "text": "変って…そもそも\nあなた達、一人暮らし\nしてるんでしょ？",
            "zh": "奇怪什么的……说起来\n你们两个不都是\n一个人住的吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "272/TALK",
            "narrator": "アーヤ",
            "text": "自分で退治できなくて、\n部屋に出た時はどうする\nつもりなの？",
            "zh": "要是自己消灭不了，\n房间里出现的时候\n打算怎么办啊？",
            "narrator_zh": "绫水"
        },
        {
            "location": "274/TALK",
            "narrator": "ガブリエラ",
            "text": "…い、今まで、\n一度も出たことないし…。",
            "zh": "……以、以前从来\n没有出现过嘛……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "276/TALK",
            "narrator": "つばめ",
            "text": "そうだ…お父さんいない\nから、ゴキブリ退治して\nもらえないんだ…。",
            "zh": "对哦……爸爸不在，\n没人帮我消灭\n蟑螂了呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "277/TALK",
            "narrator": "アーヤ",
            "text": "…今までお父さん\n任せにしてたの？",
            "zh": "……以前都是\n交给爸爸处理的吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "278/TALK",
            "narrator": "つばめ",
            "text": "だ、だって怖いじゃ\nないですか！",
            "zh": "因、因为真的很可怕\n嘛！",
            "narrator_zh": "燕"
        },
        {
            "location": "280/TALK",
            "narrator": "つばめ",
            "text": "そうだ、アーヤさん。\nもし部屋にゴキブリが\n出たら――",
            "zh": "对了，绫水。\n要是房间里出现\n蟑螂的话――",
            "narrator_zh": "燕"
        },
        {
            "location": "281/TALK",
            "narrator": "つばめ",
            "text": "その時はお願いして\nいいですか！？",
            "zh": "到时候可以拜托你\n吗！？",
            "narrator_zh": "燕"
        },
        {
            "location": "283/TALK",
            "narrator": "アーヤ",
            "text": "えっ！？",
            "zh": "咦！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "287/TALK",
            "narrator": "ガブリエラ",
            "text": "ず、ずるい！\nそれならあたしだって\nお願いしたいわ！",
            "zh": "好、好狡猾！\n那样的话我也要\n拜托你！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "289/TALK",
            "narrator": "アーヤ",
            "text": "嫌よ！\n私だってゴキブリは\n見たくもないんだから！",
            "zh": "不要！\n就连我也根本\n不想看到蟑螂啊！",
            "narrator_zh": "绫水"
        },
        {
            "location": "293/TALK",
            "narrator": "ガブリエラ",
            "text": "で、でも！",
            "zh": "可、可是！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "294/TALK",
            "narrator": "ガブリエラ",
            "text": "あたし達じゃ絶対に\nゴキブリの退治なんて\nできないから――",
            "zh": "光靠我们绝对\n没法把蟑螂\n消灭掉的――",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "295/TALK",
            "narrator": "ガブリエラ",
            "text": "逃がしたゴキブリが\n繁殖しちゃうかも\nしれないのよ？",
            "zh": "放跑的蟑螂说不定\n会繁殖起来\n的哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "296/TALK",
            "narrator": "つばめ",
            "text": "い、嫌だ！\n寮がゴキブリだらけに\nなっちゃうよ！",
            "zh": "不、不要！\n宿舍会变得全是\n蟑螂的啦！",
            "narrator_zh": "燕"
        },
        {
            "location": "298/TALK",
            "narrator": "ガブリエラ",
            "text": "でしょ？\nだから、アーヤには\n寮を守るためにも――",
            "zh": "对吧？\n所以，为了保护宿舍，\n绫水你也得――",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "301/TALK",
            "narrator": "ガブリエラ",
            "text": "ゴキブリが出た時には\n退治してほしいの。\nお願い！",
            "zh": "在蟑螂出现的时候\n帮我们消灭掉。\n拜托了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "304/TALK",
            "narrator": "アーヤ",
            "text": "あ、あんたねぇ…。",
            "zh": "你、你真是的……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "307/TALK",
            "narrator": "アーヤ",
            "text": "けど、寮でゴキブリが\n大量発生なんて事態、\n絶対嫌だわ…。",
            "zh": "不过，宿舍里蟑螂\n大量繁殖这种事，\n绝对不要……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "310/TALK",
            "narrator": "アーヤ",
            "text": "はぁ…スプレーだけは\n部屋に常備しておきな\nさいよ？",
            "zh": "哈啊……至少要在\n房间里常备杀虫喷雾\n知道吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "311/TALK",
            "narrator": "アーヤ",
            "text": "雑誌や新聞紙で叩くのは、\nできれば避けたいし…。",
            "zh": "用杂志或报纸拍打什么的，\n能避免还是尽量避免吧……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "314/TALK",
            "narrator": "つばめ",
            "text": "は、はい！\n本当に助かります、\nアーヤさん。",
            "zh": "好、好的！\n真是帮大忙了，\n绫水。",
            "narrator_zh": "燕"
        },
        {
            "location": "317/TALK",
            "narrator": "ガブリエラ",
            "text": "うんうん、やっぱり\nトライナリーのリーダーは\nアーヤしかいないわね。",
            "zh": "嗯嗯，果然\n三重奏的队长\n非绫水莫属呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "319/TALK",
            "narrator": "アーヤ",
            "text": "…これなら、暇な方が\nマシだったわ。",
            "zh": "……这样的话，还是闲着\n比较好啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "320/ACT",
            "narrator": "",
            "text": "平和が一番さ",
            "zh": "和平是最好的啦",
            "narrator_zh": ""
        },
        {
            "location": "321/TALK",
            "narrator": "アーヤ",
            "text": "そっか",
            "zh": "这样啊",
            "narrator_zh": "绫水"
        },
        {
            "location": "322/TALK",
            "narrator": "アーヤ",
            "text": "暇ってことは、平和ってことよね",
            "zh": "很闲，就说明很和平呢",
            "narrator_zh": "绫水"
        },
        {
            "location": "333/TALK",
            "narrator": "アーヤ",
            "text": "私が暇ってことは、\nフェノメノンも発生して\nいないってことだから――",
            "zh": "我很闲，也就意味着\nPhenoMENON没有\n发生――",
            "narrator_zh": "绫水"
        },
        {
            "location": "334/TALK",
            "narrator": "アーヤ",
            "text": "本当に今のところは\n平和な時間、って\n証拠なんだし。",
            "zh": "这正是目前为止\n都处于和平时光的\n证明嘛。",
            "narrator_zh": "绫水"
        },
        {
            "location": "335/TALK",
            "narrator": "アーヤ",
            "text": "…なんだか、暇な時間が\n凄く贅沢に思えてきた\nかも。",
            "zh": "……总觉得，空闲的时间\n似乎变得非常奢侈\n了呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "336/TALK",
            "narrator": "アーヤ",
            "text": "…夕飯の献立でも\n考えよう。",
            "zh": "……来想想晚饭的\n菜单好了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "338/TALK",
            "narrator": "アーヤ",
            "text": "今日は久しぶりに、\n手の込んだものを\n作ってみようかしら？",
            "zh": "今天难得有空，\n要不要试着做点\n费工夫的菜呢？",
            "narrator_zh": "绫水"
        },
        {
            "location": "15/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>7月14日　5:12 PM</color>\nとある平日の放課後、神楽坂トライナリー劇場でのバイト中のこと。",
            "zh": "<color=green>7月14日　5:12 PM</color>\n某天平日放学后，在神乐坂三重奏剧场打工时的事。",
            "narrator_zh": "Dialog_EventData"
        }
    ]
}
