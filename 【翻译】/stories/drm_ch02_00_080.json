{
 "dir": "dramatics/daydra/drm_ch02_00_080.js",
 "type": "Episode",
 "info": {
  "story_id": "2008",
  "cid": "ayami",
  "title": "らぶとーく 第08話",
  "sub_title": "データと解析"
 },
 "entry": [
  {
   "location": "232/SCENARIO",
   "narrator": "",
   "text": "データと解析"
  },
  {
   "location": "245/TALK",
   "narrator": "みやび",
   "text": "はぁ…ネットには何も\n面白い情報は転がってない\nようやなぁ…。",
   "zh": "唉……网上好像\n也没滚着什么\n有趣的信息呢……。",
   "narrator_zh": "雅"
  },
  {
   "location": "247/TALK",
   "narrator": "みやび",
   "text": "…ちっくと早いけんど、\n今日はもう寝るか。"
  },
  {
   "location": "252/TALK",
   "narrator": "みやび",
   "text": "ん？　開いてるがよー。"
  },
  {
   "location": "258/TALK",
   "narrator": "アーヤ",
   "text": "ごめんね。\nこんな遅くに。",
   "zh": "对不起。\n这么晚了。",
   "narrator_zh": "绫水"
  },
  {
   "location": "260/TALK",
   "narrator": "みやび",
   "text": "こんな時間に珍しいな。\nどうかしたが？",
   "zh": "这个时间还真少见咯。\n怎么了？",
   "narrator_zh": "雅"
  },
  {
   "location": "263/TALK",
   "narrator": "アーヤ",
   "text": "うん…これを渡して\nおこうと思って…。"
  },
  {
   "location": "267/TALK",
   "narrator": "みやび",
   "text": "…ＵＳＢのフラッシュ\nメモリ？",
   "zh": "…ＵＳＢ闪存\n盘？",
   "narrator_zh": "雅"
  },
  {
   "location": "268/TALK",
   "narrator": "アーヤ",
   "text": "Ｂｏｔとの会話ログが\n入ってるわ。",
   "zh": "里面存着跟Bot的\n对话记录。",
   "narrator_zh": "绫水"
  },
  {
   "location": "269/TALK",
   "narrator": "アーヤ",
   "text": "みやびも、Ｂｏｔとの\nログは取ってるんでしょ？"
  },
  {
   "location": "270/TALK",
   "narrator": "みやび",
   "text": "…当然や。",
   "zh": "……那是当然咯。",
   "narrator_zh": "雅"
  },
  {
   "location": "271/TALK",
   "narrator": "みやび",
   "text": "あのＢｏｔ、明らかに\n普通やないきね。"
  },
  {
   "location": "272/TALK",
   "narrator": "みやび",
   "text": "分析するためにも、\nログは必要不可欠や。"
  },
  {
   "location": "273/TALK",
   "narrator": "アーヤ",
   "text": "私のログも合わせれば、\n解析できる量が倍になる\nから――"
  },
  {
   "location": "274/TALK",
   "narrator": "アーヤ",
   "text": "大分捗るんじゃない？"
  },
  {
   "location": "276/TALK",
   "narrator": "みやび",
   "text": "…そうやね。",
   "zh": "……是这样咯。",
   "narrator_zh": "雅"
  },
  {
   "location": "277/TALK",
   "narrator": "みやび",
   "text": "提供してもらえるなら、\nありがたく使わせて\nもらうちや。"
  },
  {
   "location": "278/SEL",
   "narrator": "",
   "text": "暇なんだけど",
   "zh": "我现在闲着",
   "narrator_zh": ""
  },
  {
   "location": "279/SEL",
   "narrator": "",
   "text": "元気？"
  },
  {
   "location": "280/SEL",
   "narrator": "",
   "text": "なんか隠し事してない？",
   "zh": "你是不是瞒着什么？",
   "narrator_zh": ""
  },
  {
   "location": "281/ACT",
   "narrator": "",
   "text": "暇なんだけど",
   "zh": "我现在闲着",
   "narrator_zh": ""
  },
  {
   "location": "286/TALK",
   "narrator": "アーヤ",
   "text": "っ！？",
   "zh": "！？",
   "narrator_zh": "绫水"
  },
  {
   "location": "288/TALK",
   "narrator": "みやび",
   "text": "Ｂｏｔか？",
   "zh": "Bot？",
   "narrator_zh": "雅"
  },
  {
   "location": "289/TALK",
   "narrator": "アーヤ",
   "text": "そうみたい…。\nちょっと待ってて。",
   "zh": "好像是这样……。\n你等一下。",
   "narrator_zh": "绫水"
  },
  {
   "location": "303/TALK",
   "narrator": "アーヤ",
   "text": "ごめん",
   "zh": "抱歉",
   "narrator_zh": "绫水"
  },
  {
   "location": "304/TALK",
   "narrator": "アーヤ",
   "text": "悪いけど今忙しいから"
  },
  {
   "location": "315/ACT",
   "narrator": "",
   "text": "元気？"
  },
  {
   "location": "319/TALK",
   "narrator": "アーヤ",
   "text": "っ！？",
   "zh": "！？",
   "narrator_zh": "绫水"
  },
  {
   "location": "320/TALK",
   "narrator": "みやび",
   "text": "Ｂｏｔか？",
   "zh": "Bot？",
   "narrator_zh": "雅"
  },
  {
   "location": "321/TALK",
   "narrator": "アーヤ",
   "text": "そうみたい…。\nちょっと待ってて。",
   "zh": "好像是这样……。\n你等一下。",
   "narrator_zh": "绫水"
  },
  {
   "location": "335/TALK",
   "narrator": "アーヤ",
   "text": "元気だから"
  },
  {
   "location": "336/TALK",
   "narrator": "アーヤ",
   "text": "大丈夫"
  },
  {
   "location": "347/ACT",
   "narrator": "",
   "text": "なんか隠し事してない？",
   "zh": "你是不是瞒着什么？",
   "narrator_zh": ""
  },
  {
   "location": "351/TALK",
   "narrator": "アーヤ",
   "text": "っ！？",
   "zh": "！？",
   "narrator_zh": "绫水"
  },
  {
   "location": "352/TALK",
   "narrator": "みやび",
   "text": "Ｂｏｔか？",
   "zh": "Bot？",
   "narrator_zh": "雅"
  },
  {
   "location": "353/TALK",
   "narrator": "アーヤ",
   "text": "そうみたい…。\nちょっと待ってて。",
   "zh": "好像是这样……。\n你等一下。",
   "narrator_zh": "绫水"
  },
  {
   "location": "367/TALK",
   "narrator": "アーヤ",
   "text": "まさか！",
   "zh": "怎么会！",
   "narrator_zh": "绫水"
  },
  {
   "location": "368/TALK",
   "narrator": "アーヤ",
   "text": "そんなことないわ",
   "zh": "没有那种事哦",
   "narrator_zh": "绫水"
  },
  {
   "location": "380/TALK",
   "narrator": "アーヤ",
   "text": "…気付かれたかしら？",
   "zh": "…被发现了？",
   "narrator_zh": "绫水"
  },
  {
   "location": "382/TALK",
   "narrator": "みやび",
   "text": "それやったらそれで、\n面白い展開やね。",
   "zh": "要是那样，那也挺\n有意思咯。",
   "narrator_zh": "雅"
  },
  {
   "location": "383/TALK",
   "narrator": "みやび",
   "text": "反応によっては、\n正体を突き止めるヒントに\nなるかもしれんきね。",
   "zh": "看反应，\n说不定能成为查清\n真身的线索咯。",
   "narrator_zh": "雅"
  },
  {
   "location": "384/TALK",
   "narrator": "アーヤ",
   "text": "それはまあ、\nそうなんだけど…。",
   "zh": "那倒也是，\n不过……。",
   "narrator_zh": "绫水"
  },
  {
   "location": "387/TALK",
   "narrator": "みやび",
   "text": "…なんや、ハッキリせんな？",
   "zh": "…怎么，说得这么含糊嘛？",
   "narrator_zh": "雅"
  },
  {
   "location": "388/TALK",
   "narrator": "アーヤ",
   "text": "…複雑なのよ。",
   "zh": "…很复杂哦。",
   "narrator_zh": "绫水"
  },
  {
   "location": "389/TALK",
   "narrator": "アーヤ",
   "text": "真相を知りたいのか、\n知りたくないのか、\nハッキリしてなくて…。",
   "zh": "我到底想不想知道\n真相，自己都\n说不清楚了……",
   "narrator_zh": "绫水"
  },
  {
   "location": "390/TALK",
   "narrator": "みやび",
   "text": "…うちにログを渡したのに\nそういうこと言うが？",
   "zh": "…我都把记录交给你了，\n你还要这么说咯？",
   "narrator_zh": "雅"
  },
  {
   "location": "392/TALK",
   "narrator": "アーヤ",
   "text": "だから複雑なのよ。",
   "zh": "所以才复杂啊。",
   "narrator_zh": "绫水"
  },
  {
   "location": "394/TALK",
   "narrator": "アーヤ",
   "text": "何なのかしらね？\nこのモヤモヤした\n気持ちは…。",
   "zh": "究竟是什么呢？\n这种闷闷的\n感觉……",
   "narrator_zh": "绫水"
  },
  {
   "location": "396/TALK",
   "narrator": "みやび",
   "text": "…わからんでも\nないけんど。",
   "zh": "……倒也不是\n不懂咯。",
   "narrator_zh": "雅"
  },
  {
   "location": "398/TALK",
   "narrator": "みやび",
   "text": "もう引き返せん。\n覚悟はできちゅう？"
  },
  {
   "location": "400/TALK",
   "narrator": "アーヤ",
   "text": "…できてるわ。",
   "zh": "…做到了。",
   "narrator_zh": "绫水"
  },
  {
   "location": "403/TALK",
   "narrator": "アーヤ",
   "text": "…たぶんね。"
  },
  {
   "location": "243/DIALOG",
   "narrator": "Dialog_EventData",
   "text": "<color=green>5月某日　9:44 PM</color>\nとある平日の夜、みやびの部屋にて。"
  }
 ]
}
