            "zh": "讨厌！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "438/TALK",
            "narrator": "ガブリエラ",
            "text": "ば、バカバカバカ！！\nどこ触ってるのよ、\nエッチ！！",
            "zh": "笨、笨蛋笨蛋笨蛋！！\n你摸的是哪里啊，\n色狼！！",
            "narrator_zh": "加布里埃拉"
        },
        {
