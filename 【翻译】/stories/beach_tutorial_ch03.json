    },
    "entry": [
        {
            "location": "317/SCENARIO",
            "narrator": "",
            "text": "TGSガブリエラ",
            "zh": "TGS加布里埃拉",
            "narrator_zh": ""
        },
        {
            "location": "337/TALK",
            "narrator": "ガブリエラ",
            "text": "へえ、あたし達以外\n誰もいないなんて、\nちょっと驚いたわ。",
            "zh": "哎呀，除了我们\n一个人都没有，\n有点吃惊呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "338/TALK",
            "narrator": "ガブリエラ",
            "text": "まるでプライベート\nビーチに来てる\n気持ちになるわね。",
            "zh": "简直就像来到了\n私人海滩\n一样呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "339/SEL",
            "narrator": "",
            "text": "二人きりになりたくてね",
            "zh": "想和你独处来着",
            "narrator_zh": ""
        },
        {
            "location": "340/SEL",
            "narrator": "",
            "text": "ガブリエラには静かな砂浜が似合う",
            "zh": "安静的海滩很适合加布里埃拉",
            "narrator_zh": ""
        },
        {
            "location": "341/ACT",
            "narrator": "",
            "text": "二人きりになりたくてね",
            "zh": "想和你独处来着",
            "narrator_zh": ""
        },
        {
            "location": "342/TALK",
            "narrator": "ガブリエラ",
            "text": "きゅ、急になんてこと\n言うのよ！",
            "zh": "突、突然说这种\n话干什么啦！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "343/TALK",
            "narrator": "ガブリエラ",
            "text": "そんな言い方されたら、\n変に意識しちゃう\nじゃない…。",
            "zh": "被你这么一说，\n不就莫名在意起来\n了嘛……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "344/ACT",
            "narrator": "",
            "text": "ガブリエラには静かな砂浜が似合う",
            "zh": "安静的海滩很适合加布里埃拉",
            "narrator_zh": ""
        },
        {
            "location": "345/TALK",
            "narrator": "ガブリエラ",
            "text": "へえ、さすがね。\nあたしの好みを\nよく理解してるじゃない。",
            "zh": "哎呀，真有你的。\n很清楚我的\n喜好嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "346/TALK",
            "narrator": "ガブリエラ",
            "text": "さすがはあたしの\nコイビ――",
            "zh": "不愧是我的\n心上——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "347/TALK",
            "narrator": "ガブリエラ",
            "text": "…なんでもないわ。\nとにかく、褒めてあげる。",
            "zh": "……没什么。\n总之，表扬你一下。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "349/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、こんなに広い\n砂浜にあたし達だけって\nいうのは。",
            "zh": "不过，这么宽的\n沙滩上只有我们\n两个人的话。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "350/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょっとだけ寂しくて、\n寒い感じもするわ。",
            "zh": "总觉得有点寂寞，\n还让人有点冷清呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "351/TALK",
            "narrator": "ガブリエラ",
            "text": "そう思わない？\nそれとも、あたしだけ？",
            "zh": "你不觉得吗？\n还是只有我？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "352/SEL",
            "narrator": "",
            "text": "とても温かく感じてる",
            "zh": "我觉得非常温暖",
            "narrator_zh": ""
        },
        {
            "location": "353/SEL",
            "narrator": "",
            "text": "抱きしめようか？",
            "zh": "要我抱抱你吗？",
            "narrator_zh": ""
        },
        {
            "location": "354/ACT",
            "narrator": "",
            "text": "とても温かく感じてる",
            "zh": "我觉得非常温暖",
            "narrator_zh": ""
        },
        {
            "location": "355/TALK",
            "narrator": "ガブリエラ",
            "text": "まあ、日差しが強いから\nそう感じたとしても\n不思議じゃないけど。",
            "zh": "嘛，阳光这么强，\n就算有这种感觉\n也不奇怪就是了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "356/SEL",
            "narrator": "",
            "text": "好きな子と一緒だからだよ",
            "zh": "因为和喜欢的人在一起呀",
            "narrator_zh": ""
        },
        {
            "location": "357/SEL",
            "narrator": "",
            "text": "ガブリエラの水着姿が過激で…",
            "zh": "加布里埃拉的泳装太火爆了……",
            "narrator_zh": ""
        },
        {
            "location": "358/ACT",
            "narrator": "",
            "text": "好きな子と一緒だからだよ",
            "zh": "因为和喜欢的人在一起呀",
            "narrator_zh": ""
        },
        {
            "location": "359/TALK",
            "narrator": "ガブリエラ",
            "text": "なっ！？",
            "zh": "什！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "360/TALK",
            "narrator": "ガブリエラ",
            "text": "ば、ばか…。\nよくも恥ずかしげもなく\nそんなこと言えるわね？",
            "zh": "笨、笨蛋……\n居然能面不改色地说\n出这种话呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "361/TALK",
            "narrator": "ガブリエラ",
            "text": "…でも、ちょっとだけ\n感謝してあげるわ。",
            "zh": "……不过，稍微\n感谢你一下好了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "362/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしも、あなたと\n一緒で温かい気持ちに\nなってきた感じするし…。",
            "zh": "我也觉得，和你\n在一起心情\n变得温暖了……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "363/ACT",
            "narrator": "",
            "text": "ガブリエラの水着姿が過激で…",
            "zh": "加布里埃拉的泳装太火爆了……",
            "narrator_zh": ""
        },
        {
            "location": "364/TALK",
            "narrator": "ガブリエラ",
            "text": "なっ！？　ば、ばか！！\n変な目で見ないでよ！",
            "zh": "什！？　笨、笨蛋！！\n别用那种眼神看我！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "365/TALK",
            "narrator": "ガブリエラ",
            "text": "あ…、別に見るなって\nわけじゃないし、むしろ\n見てはほしいけど…。",
            "zh": "啊……也不是\n不让你看，倒不如说\n还想让你看……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "366/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、あんまり変な目で\n見るのはダメ！\nそういうのいけないのよ？",
            "zh": "但是，用奇怪的眼神\n看个不停是不行的！\n那种事可不好哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "368/ACT",
            "narrator": "",
            "text": "抱きしめようか？",
            "zh": "要我抱抱你吗？",
            "narrator_zh": ""
        },
        {
            "location": "369/TALK",
            "narrator": "ガブリエラ",
            "text": "は、はぁ！？",
            "zh": "什、什么！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "370/TALK",
            "narrator": "ガブリエラ",
            "text": "いいから！\nイヤじゃないけど、\nそ、外だし…。",
            "zh": "总之先别管！\n倒不是讨厌，\n可、可这是外面……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "371/TALK",
            "narrator": "ガブリエラ",
            "text": "ああもう…あんたが\n変なこと言うから、\n暑くなってきちゃった…。",
            "zh": "真是的……都怪你\n说些奇怪的话，\n都热起来了……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "373/SEL",
            "narrator": "",
            "text": "ごめん、ちょっと触らせて",
            "zh": "抱歉，让我碰一下",
            "narrator_zh": ""
        },
        {
            "location": "374/ACT",
            "narrator": "",
            "text": "ごめん、ちょっと触らせて",
            "zh": "抱歉，让我碰一下",
            "narrator_zh": ""
        },
        {
            "location": "376/TALK",
            "narrator": "ガブリエラ",
            "text": "えぇっ！？",
            "zh": "诶诶！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "377/TALK",
            "narrator": "ガブリエラ",
            "text": "…だ、誰かが来たら、\nすぐやめるわよ？",
            "zh": "……要、要是有人来，\n就马上停下来哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "396/TALK",
            "narrator": "ガブリエラ",
            "text": "むぅ…いつまで経っても\n子供扱いして…。",
            "zh": "呜……不管过多久\n都被当小孩子……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "398/TALK",
            "narrator": "ガブリエラ",
            "text": "…こ、子供っぽく\n思われそうだから…、\nちょっとだけよ？",
            "zh": "……会、会被人\n觉得孩子气，所以……\n只许一下哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "405/TALK",
            "narrator": "ガブリエラ",
            "text": "…絶対故意に\n触ってるでしょ？",
            "zh": "……绝对是故意\n碰我的吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "407/TALK",
            "narrator": "ガブリエラ",
            "text": "イヤッ！？",
            "zh": "讨厌！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "409/TALK",
            "narrator": "ガブリエラ",
            "text": "ば、バカバカバカ！！\nどこ触ってるのよ、\nエッチ！！",
            "zh": "笨、笨蛋笨蛋笨蛋！！\n你摸的是哪里啊，\n色狼！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "415/TALK",
            "narrator": "ガブリエラ",
            "text": "う～っ、どうして\nお腹触るのよぉ…。",
            "zh": "呜——，为什么\n要摸肚子啦……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "418/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょ、ちょっと待って！\nダメだってば！",
            "zh": "等、等一下！\n说了不行嘛！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "419/TALK",
            "narrator": "ガブリエラ",
            "text": "その触り方、ちょっと…、\nえ、エッチっぽかった…。",
            "zh": "那种摸法，有点……\n色、色色的……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "425/TALK",
            "narrator": "ガブリエラ",
            "text": "むぅ…いつまで経っても\n子供扱いして…。",
            "zh": "呜……不管过多久\n都被当小孩子……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "427/TALK",
            "narrator": "ガブリエラ",
            "text": "…こ、子供っぽく\n思われそうだから…、\nちょっとだけよ？",
            "zh": "……会、会被人\n觉得孩子气，所以……\n只许一下哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "434/TALK",
            "narrator": "ガブリエラ",
            "text": "…絶対故意に\n触ってるでしょ？",
            "zh": "……绝对是故意\n碰我的吧？",
