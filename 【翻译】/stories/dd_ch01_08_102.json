{
    "dir": "chap08/daydra/dd_ch01_08_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "8105",
        "cid": "tsubame",
        "title": "005 メインストーリー",
        "sub_title": "大胆勝負～Case1～＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "大胆对决～Case1～＜后篇＞"
    },
    "entry": [
        {
            "location": "387/SCENARIO",
            "narrator": "",
            "text": "大胆勝負",
            "zh": "大胆对决",
            "narrator_zh": ""
        },
        {
            "location": "408/TALK",
            "narrator": "つばめ",
            "text": "わたし、どうして\n卯月さんとなら――",
            "zh": "我为什么觉得，\n和卯月的话——",
            "narrator_zh": "燕"
        },
        {
            "location": "409/TALK",
            "narrator": "つばめ",
            "text": "上手くやっていける、\nって思ったんだろ？",
            "zh": "能好好相处下去\n呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "410/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "412/TALK",
            "narrator": "つばめ",
            "text": "う～ん……。",
            "zh": "嗯——……。",
            "narrator_zh": "燕"
        },
        {
            "location": "413/TALK",
            "narrator": "つばめ",
            "text": "…まあ、いっか。\nそのうちわかるかも\nしれないし。",
            "zh": "……算了，不管了。\n说不定过阵子\n就会明白。",
            "narrator_zh": "燕"
        },
        {
            "location": "414/TALK",
            "narrator": "神楽",
            "text": "じーっ……。",
            "zh": "盯——……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "415/TALK",
            "narrator": "つばめ",
            "text": "って、卯月さん？\nどこ見てるの…？",
            "zh": "诶，卯月？\n你在看哪里……？",
            "narrator_zh": "燕"
        },
        {
            "location": "416/TALK",
            "narrator": "神楽",
            "text": "うーん…やっぱり\n思った通りでした。",
            "zh": "嗯……果然\n和我想的一样。",
            "narrator_zh": "神乐"
        },
        {
            "location": "417/TALK",
            "narrator": "神楽",
            "text": "さっき触った時から、\nもしかして、と\n思ってたんです。",
            "zh": "从刚才碰到的时候起，\n我就在想，\n难道说。",
            "narrator_zh": "神乐"
        },
        {
            "location": "418/TALK",
            "narrator": "神楽",
            "text": "つばめさんって、\n結構胸ありますよね？",
            "zh": "燕，\n胸部还挺有的吧？",
            "narrator_zh": "神乐"
        },
        {
            "location": "421/TALK",
            "narrator": "つばめ",
            "text": "む、胸！？",
            "zh": "胸、胸部！？",
            "narrator_zh": "燕"
        },
        {
            "location": "423/TALK",
            "narrator": "神楽",
            "text": "はい。\nあんなに柔らかいとは\n思わなかったから――",
            "zh": "是的。\n没想到会那么\n软——",
            "narrator_zh": "神乐"
        },
        {
            "location": "425/TALK",
            "narrator": "神楽",
            "text": "つい、たくさん\n揉んじゃいましたー。",
            "zh": "一不小心，\n揉了好多下。",
            "narrator_zh": "神乐"
        },
        {
            "location": "428/TALK",
            "narrator": "つばめ",
            "text": "ひ、酷いよー！",
            "zh": "太、太过分了哦——！",
            "narrator_zh": "燕"
        },
        {
            "location": "430/TALK",
            "narrator": "神楽",
            "text": "ごめんなさい。\nでも、本当にとっても\n柔らかくて…。",
            "zh": "对不起。\n可是，真的非常\n软……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "432/TALK",
            "narrator": "神楽",
            "text": "というわけで、酷い\nついでに、もう一回\nだけお願いします！",
            "zh": "所以说，既然过分了，\n就再拜托\n一次！",
            "narrator_zh": "神乐"
        },
        {
            "location": "436/TALK",
            "narrator": "つばめ",
            "text": "えっ！？",
            "zh": "诶！？",
            "narrator_zh": "燕"
        },
        {
            "location": "437/SEL",
            "narrator": "",
            "text": "卯月さんならいいよ？　と恥ずかしそうに言え！",
            "zh": "害羞地说：卯月的话可以哦？",
            "narrator_zh": ""
        },
        {
            "location": "438/SEL",
            "narrator": "",
            "text": "それじゃあ、って胸を差し出せ",
            "zh": "那就，把胸递出去",
            "narrator_zh": ""
        },
        {
            "location": "440/TALK",
            "narrator": "神楽",
            "text": "もう、さっきから\nえっ、とか、えぇっ、\nとかばかりですね？",
            "zh": "真是的，从刚才起\n就只会诶、或者诶诶\n之类的吧？",
            "narrator_zh": "神乐"
        },
        {
            "location": "442/TALK",
            "narrator": "神楽",
            "text": "ここは、卯月さんなら\nいいよ、って差し出す\nところですよ。",
            "zh": "这里应该是说\n卯月的话可以哦，然后\n递出来才对。",
            "narrator_zh": "神乐"
        },
        {
            "location": "446/TALK",
            "narrator": "つばめ",
            "text": "む、ムリムリ！！\nそんなこと\n言えないよ！",
            "zh": "不、不行不行！！\n那种话\n我说不出口！",
            "narrator_zh": "燕"
        },
        {
            "location": "448/TALK",
            "narrator": "神楽",
            "text": "はぁ…残念。\nお風呂でもっと触って\nおくべきでした…。",
            "zh": "哈啊……遗憾。\n在浴室里就该多摸\n一会儿的……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "449/TALK",
            "narrator": "つばめ",
            "text": "もぅ、恥ずかしくて、\nまたのぼせちゃい\nそうだよ…。",
            "zh": "真是的，羞得\n又要泡晕\n了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "451/ACT",
            "narrator": "",
            "text": "卯月さんならいいよ？　と恥ずかしそうに言え！",
            "zh": "害羞地说：卯月的话可以哦？",
            "narrator_zh": ""
        },
        {
            "location": "484/TALK",
            "narrator": "つばめ",
            "text": "恥ずかしそうにとか\n言われなくても――",
            "zh": "就算不说什么\n害羞地——",
            "narrator_zh": "燕"
        },
        {
            "location": "485/TALK",
            "narrator": "つばめ",
            "text": "そんなこと言うの、\n恥ずかしそうにしか\n言えないよ…。",
            "zh": "说这种话，\n也只能害羞地\n说出口……。",
            "narrator_zh": "燕"
        },
        {
            "location": "486/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "489/TALK",
            "narrator": "神楽",
            "text": "減るもんじゃないん\nですし、もう一回だけ\nお願いします！",
            "zh": "又不会少掉，\n再来一次就好，\n拜托了！",
            "narrator_zh": "神乐"
        },
        {
            "location": "490/TALK",
            "narrator": "つばめ",
            "text": "…わ、わかったよ。",
            "zh": "……知、知道了。",
            "narrator_zh": "燕"
        },
        {
            "location": "491/TALK",
            "narrator": "神楽",
            "text": "え？",
            "zh": "诶？",
            "narrator_zh": "神乐"
        },
        {
            "location": "493/TALK",
            "narrator": "つばめ",
            "text": "卯月さんなら…、\nい、いい、よ…。",
            "zh": "卯月的话……，\n可、可以，哦……。",
            "narrator_zh": "燕"
        },
        {
            "location": "496/TALK",
            "narrator": "神楽",
            "text": "っ！？",
            "zh": "唔！？",
            "narrator_zh": "神乐"
        },
        {
            "location": "498/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "499/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "500/TALK",
            "narrator": "つばめ",
            "text": "…？\n卯月さん？",
            "zh": "……？\n卯月？",
            "narrator_zh": "燕"
        },
        {
            "location": "503/TALK",
            "narrator": "神楽",
            "text": "…だ、ダメじゃない\nですか、つばめさん。",
            "zh": "……这、这可不行\n呀，燕。",
            "narrator_zh": "神乐"
        },
        {
            "location": "505/TALK",
            "narrator": "神楽",
            "text": "そこは、絶対に\n断らなくちゃ\nいけないところです！",
            "zh": "这里是绝对\n必须拒绝的\n地方！",
            "narrator_zh": "神乐"
        },
        {
            "location": "509/TALK",
            "narrator": "つばめ",
            "text": "えぇぇぇぇぇっ！？\nな、なんで！？",
            "zh": "诶诶诶诶诶诶！？\n为、为什么！？",
            "narrator_zh": "燕"
        },
        {
            "location": "510/TALK",
            "narrator": "つばめ",
            "text": "言ってること\nコロコロ変わり過ぎて\nわからないよ！",
            "zh": "你说的话\n变来变去\n我搞不懂呀！",
            "narrator_zh": "燕"
        },
        {
            "location": "512/TALK",
            "narrator": "神楽",
            "text": "ダメなものは\nダメなんです！",
            "zh": "不行的就是\n不行！",
            "narrator_zh": "神乐"
        },
        {
            "location": "514/TALK",
            "narrator": "神楽",
            "text": "っていうか、そんな\nこと言われたら――",
            "zh": "再说，被你\n这么一说——",
            "narrator_zh": "神乐"
        },
        {
            "location": "516/TALK",
            "narrator": "神楽",
            "text": "私…本当に、\nダメな子になっちゃう\nじゃないですか…。",
            "zh": "我……真的会\n变成坏孩子\n的吧……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "518/TALK",
            "narrator": "つばめ",
            "text": "どういうこと？\nどうして卯月さんが\nダメな子に――",
            "zh": "什么意思？\n为什么卯月会\n变成坏孩子——",
            "narrator_zh": "燕"
        },
        {
            "location": "520/TALK",
            "narrator": "神楽",
            "text": "もう、そんなこと\n言ったらダメですよ？",
            "zh": "真是的，那种话\n不能说哦？",
            "narrator_zh": "神乐"
        },
        {
            "location": "524/TALK",
            "narrator": "つばめ",
            "text": "あっ、卯月さん…。",
            "zh": "啊，卯月……。",
            "narrator_zh": "燕"
        },
        {
            "location": "525/TALK",
            "narrator": "つばめ",
            "text": "…行っちゃった。\nどういうことなん\nだろ？",
            "zh": "……走掉了。\n到底是\n怎么回事呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "526/TALK",
            "narrator": "つばめ",
            "text": "もしかしてわたし、\n変なこと言っちゃっ\nたのかな？",
            "zh": "难道是我，\n说了什么\n奇怪的话吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "527/TALK",
            "narrator": "つばめ",
            "text": "…嫌われちゃって\nたら、イヤだな…。",
            "zh": "……要是被讨厌了，\n我不愿意呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "529/TALK",
            "narrator": "つばめ",
            "text": "都会の子の会話って、\n難しいよぉ…。",
            "zh": "大城市的孩子说话，\n好难懂哦……。",
            "narrator_zh": "燕"
        },
        {
            "location": "530/ACT",
            "narrator": "",
            "text": "それじゃあ、って胸を差し出せ",
            "zh": "那就，把胸递出去",
            "narrator_zh": ""
        },
        {
            "location": "563/TALK",
            "narrator": "つばめ",
            "text": "もしかして、女の子\n同士ならこれくらい\n普通なのかな？",
            "zh": "难道，女孩子\n之间这种程度\n很普通吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "564/TALK",
            "narrator": "つばめ",
            "text": "それなら、恥ずかし\nがってるのは\n変だよね。",
            "zh": "那样的话，觉得\n害羞的才是\n奇怪的吧。",
            "narrator_zh": "燕"
        },
        {
            "location": "567/TALK",
            "narrator": "つばめ",
            "text": "それじゃあ…。",
            "zh": "那就……。",
            "narrator_zh": "燕"
        },
        {
            "location": "570/TALK",
            "narrator": "神楽",
            "text": "えっ！？\nちょ、な、何やって\nるんですか！？",
            "zh": "诶！？\n等、你、你在\n干什么！？",
            "narrator_zh": "神乐"
        },
        {
            "location": "571/TALK",
            "narrator": "つばめ",
            "text": "え？　卯月さん、\nまた揉みたいって\n言うから――",
            "zh": "诶？卯月说\n还想再揉\n一次——",
            "narrator_zh": "燕"
        },
        {
            "location": "572/TALK",
            "narrator": "つばめ",
            "text": "まあいいかな、って\n思って…。",
            "zh": "我就想，\n也行吧……。",
            "narrator_zh": "燕"
        },
        {
            "location": "574/TALK",
            "narrator": "神楽",
            "text": "いいかな！？",
            "zh": "也行！？",
            "narrator_zh": "神乐"
        },
        {
            "location": "576/TALK",
            "narrator": "つばめ",
            "text": "うん。\nはい、どうぞ。",
            "zh": "嗯。\n来，请。",
            "narrator_zh": "燕"
        },
        {
            "location": "577/TALK",
            "narrator": "神楽",
            "text": "よ、よくないですよ！\nよくないに決まってる\nじゃないですか！？",
            "zh": "不、不行的！\n当然不行\n呀！？",
            "narrator_zh": "神乐"
        },
        {
            "location": "578/TALK",
            "narrator": "神楽",
            "text": "それに、さっきは\nつばめさんも怒って\nたのに…。",
            "zh": "而且，刚才\n燕也在\n生气……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "580/TALK",
            "narrator": "つばめ",
            "text": "だって、さっきのは\n急だったんだもん。",
            "zh": "因为刚才\n太突然了呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "583/TALK",
            "narrator": "つばめ",
            "text": "でも、今は心の準備\n出来てるから、\n大丈夫だよ。",
            "zh": "可是现在心里\n准备好了，\n不要紧呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "585/TALK",
            "narrator": "神楽",
            "text": "こ、心の準備って…。",
            "zh": "心、心里准备是……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "587/TALK",
            "narrator": "つばめ",
            "text": "えへへ…どうぞ、\n卯月さん。",
            "zh": "诶嘿嘿……请，\n卯月。",
            "narrator_zh": "燕"
        },
        {
            "location": "589/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "591/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "593/TALK",
            "narrator": "つばめ",
            "text": "…？\n卯月さん、\nどうしたの？",
            "zh": "……？\n卯月，\n怎么了？",
            "narrator_zh": "燕"
        },
        {
            "location": "595/TALK",
            "narrator": "神楽",
            "text": "…もー！！",
            "zh": "……真是的！！",
            "narrator_zh": "神乐"
        },
        {
            "location": "597/TALK",
            "narrator": "神楽",
            "text": "つばめさんの、\nばかーーー！！",
            "zh": "燕，\n笨蛋——！！",
            "narrator_zh": "神乐"
        },
        {
            "location": "601/TALK",
            "narrator": "つばめ",
            "text": "あっ、卯月さん！？",
            "zh": "啊，卯月！？",
            "narrator_zh": "燕"
        },
        {
            "location": "602/TALK",
            "narrator": "つばめ",
            "text": "…行っちゃった。\nどうしたんだろう？",
            "zh": "……走掉了。\n怎么回事呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "604/TALK",
            "narrator": "つばめ",
            "text": "…もしかして、\n何か間違ったこと\nしちゃったのかな？",
            "zh": "……难道，\n我做错了什么\n吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "605/TALK",
            "narrator": "つばめ",
            "text": "嫌われてないと\nいいんだけど…。",
            "zh": "希望没有\n被讨厌……。",
            "narrator_zh": "燕"
        },
        {
            "location": "606/TALK",
            "narrator": "つばめ",
            "text": "…都会の子って、\n難しいなぁ…。",
            "zh": "……大城市的孩子，\n好难懂呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "618/DIALOG",
            "narrator": "Dialog_chapter_ch01",
            "text": "【06 史上最愛の作戦】",
            "zh": "【06 史上最爱的作战】",
            "narrator_zh": "Dialog_chapter_ch01"
        }
    ]
}
