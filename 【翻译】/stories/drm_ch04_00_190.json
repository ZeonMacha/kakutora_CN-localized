  "title": "らぶとーく 第19話",
  "sub_title": "裏の裏の春うらら"
 },
 "entry": [
  {
   "location": "7/SCENARIO",
   "narrator": "",
   "text": "裏の裏の春うらら"
  },
  {
   "location": "19/TALK",
   "narrator": "アーヤ",
   "text": "ふう。\n平穏無事に\n一日が終わったわね。"
  },
  {
   "location": "21/TALK",
   "narrator": "つばめ",
   "text": "いつもこうだと\nいいんですけど。"
  },
  {
   "location": "23/TALK",
   "narrator": "ガブリエラ",
   "text": "つばめは本当に\n甘いわね。",
   "zh": "燕真是太\n天真了。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "24/TALK",
   "narrator": "ガブリエラ",
   "text": "いつでも備えて\nおかなきゃダメよ。"
  },
  {
   "location": "26/TALK",
   "narrator": "みやび",
   "text": "そういうガブちゃんは\n常に備えは万全\nなんかね。",
   "zh": "这样的加布\n总是准备得\n万无一失咯。",
   "narrator_zh": "雅"
  },
  {
   "location": "27/TALK",
   "narrator": "ガブリエラ",
   "text": "当然よ。"
  },
  {
   "location": "29/TALK",
   "narrator": "つばめ",
   "text": "さすがガブちゃん！"
  },
  {
   "location": "32/TALK",
   "narrator": "ガブリエラ",
   "text": "…素直に言われると\n調子が狂うわ……。",
   "zh": "……被你直白地说出来，\n我反而乱了阵脚……。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "44/TALK",
   "narrator": "みやび",
   "text": "相棒よ",
   "zh": "是搭档咯",
   "narrator_zh": "雅"
  },
  {
   "location": "45/TALK",
   "narrator": "みやび",
   "text": "なぜガブちゃんの備えが常に万全か知っちゅうか？",
   "zh": "你知道为什么加布的准备总是万全嘛？",
   "narrator_zh": "雅"
  },
  {
   "location": "47/SEL",
   "narrator": "",
   "text": "知らない",
   "zh": "不知道",
   "narrator_zh": ""
  },
  {
   "location": "48/SEL",
   "narrator": "",
   "text": "教えて",
   "zh": "告诉我",
   "narrator_zh": ""
  },
  {
   "location": "49/ACT",
   "narrator": "",
   "text": "知らない",
   "zh": "不知道",
   "narrator_zh": ""
  },
  {
   "location": "50/TALK",
   "narrator": "みやび",
   "text": "即答か"
  },
  {
   "location": "51/ACT",
   "narrator": "",
   "text": "教えて",
   "zh": "告诉我",
   "narrator_zh": ""
  },
  {
   "location": "52/TALK",
   "narrator": "みやび",
   "text": "少しは考えろ"
  },
  {
   "location": "54/TALK",
   "narrator": "みやび",
   "text": "ここだけの話",
   "zh": "只在这里说",
   "narrator_zh": "雅"
  },
  {
   "location": "55/TALK",
   "narrator": "みやび",
   "text": "ガブちゃんはアンドロイドなのだ"
  },
  {
   "location": "58/SEL",
   "narrator": "",
   "text": "ああ、スマホの",
   "zh": "啊，手机上的",
   "narrator_zh": ""
  },
  {
   "location": "59/SEL",
   "narrator": "",
   "text": "またまた",
   "zh": "又来了",
   "narrator_zh": ""
  },
  {
   "location": "60/ACT",
   "narrator": "",
   "text": "ああ、スマホの",
   "zh": "啊，手机上的",
   "narrator_zh": ""
  },
  {
   "location": "61/TALK",
   "narrator": "みやび",
   "text": "そうそう",
   "zh": "对对",
   "narrator_zh": "雅"
  },
  {
   "location": "62/TALK",
   "narrator": "みやび",
   "text": "って",
   "zh": "话说",
   "narrator_zh": "雅"
  },
  {
   "location": "63/TALK",
   "narrator": "みやび",
   "text": "違うわ！！！！"
  },
  {
   "location": "66/ACT",
   "narrator": "",
   "text": "またまた",
   "zh": "又来了",
   "narrator_zh": ""
  },
  {
   "location": "67/TALK",
   "narrator": "みやび",
   "text": "これがこれが",
   "zh": "这个这个",
   "narrator_zh": "雅"
  },
  {
   "location": "68/TALK",
   "narrator": "みやび",
   "text": "本当なのだ"
  },
  {
   "location": "70/TALK",
   "narrator": "みやび",
   "text": "というわけで",
   "zh": "所以说",
   "narrator_zh": "雅"
  },
  {
   "location": "71/TALK",
   "narrator": "みやび",
   "text": "その証拠をつかめ",
   "zh": "抓住那个证据",
   "narrator_zh": "雅"
  },
  {
   "location": "73/SEL",
   "narrator": "",
   "text": "いや、冗談でしょ？",
   "zh": "不是，你开玩笑的吧？",
   "narrator_zh": ""
  },
  {
   "location": "74/SEL",
   "narrator": "",
   "text": "無茶言うなあ",
   "zh": "别强人所难啊",
   "narrator_zh": ""
  },
  {
   "location": "75/ACT",
   "narrator": "",
   "text": "いや、冗談でしょ？",
   "zh": "不是，你开玩笑的吧？",
   "narrator_zh": ""
  },
  {
   "location": "76/TALK",
   "narrator": "みやび",
   "text": "本気ぞね"
  },
  {
   "location": "77/ACT",
   "narrator": "",
   "text": "無茶言うなあ",
   "zh": "别强人所难啊",
   "narrator_zh": ""
  },
  {
   "location": "78/TALK",
   "narrator": "みやび",
   "text": "無茶ではない"
  },
  {
   "location": "80/TALK",
   "narrator": "みやび",
   "text": "仮にもうちの相棒としてやっていくには"
  },
  {
   "location": "81/TALK",
   "narrator": "みやび",
   "text": "このくらいのことは軽くこなしてもらわんとな",
   "zh": "这点程度的事也得轻松办到咯",
   "narrator_zh": "雅"
  },
  {
   "location": "92/TALK",
   "narrator": "アーヤ",
   "text": "今日はこれで\n解散しましょうか。"
  },
  {
   "location": "93/TALK",
   "narrator": "ガブリエラ",
   "text": "そうね。\n明日に備えて。",
   "zh": "是啊。\n为明天做准备。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "94/TALK",
   "narrator": "つばめ",
   "text": "ガブちゃんは本当に\n偉いよね…！"
  },
  {
   "location": "95/TALK",
   "narrator": "ガブリエラ",
   "text": "なんかちょっと\n上から目線な\n感じもするわ…。",
   "zh": "总觉得有点\n居高临下的\n感觉……。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "96/TALK",
   "narrator": "みやび",
   "text": "素直に受け取っとけば\nええぞね。"
  },
  {
   "location": "98/TALK",
   "narrator": "ガブリエラ",
   "text": "……。"
  },
  {
   "location": "100/TALK",
   "narrator": "みやび",
   "text": "ふふ。",
   "zh": "呵呵。",
   "narrator_zh": "雅"
  },
  {
   "location": "102/TALK",
   "narrator": "ガブリエラ",
   "text": "何その笑い？"
  },
  {
   "location": "103/TALK",
   "narrator": "みやび",
   "text": "いや。",
   "zh": "不是。",
   "narrator_zh": "雅"
  },
  {
   "location": "105/TALK",
   "narrator": "みやび",
   "text": "羊の夢を見るのは\n人間だけやねえって\n思っただけぞね。"
  },
  {
   "location": "108/TALK",
   "narrator": "つばめ",
   "text": "羊が一匹、って\nやつですか？"
  },
  {
   "location": "109/TALK",
   "narrator": "つばめ",
   "text": "眠れない時に\n数えるといいって。"
  },
  {
   "location": "110/TALK",
   "narrator": "みやび",
   "text": "ああ、そっちでは\nなくてやね。"
  },
  {
   "location": "111/TALK",
   "narrator": "みやび",
   "text": "感情に基づいて\n行動するのは\n人間だけっちゅう話や。"
  }
 ]
}
