{
    "dir": "dramatics/daydra/drm_ch04_00_190.js",
    "type": "Episode",
    "info": {
        "story_id": "4019",
        "cid": "miyabi",
        "title": "らぶとーく 第19話",
        "sub_title": "裏の裏の春うらら",
        "title_zh": "恋爱漫谈 第19话",
        "sub_title_zh": "内幕背后的春光和煦"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "裏の裏の春うらら",
            "zh": "内幕背后的春光和煦",
            "narrator_zh": ""
        },
        {
            "location": "19/TALK",
            "narrator": "アーヤ",
            "text": "ふう。\n平穏無事に\n一日が終わったわね。",
            "zh": "呼。\n平平安安地\n过了一天呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "21/TALK",
            "narrator": "つばめ",
            "text": "いつもこうだと\nいいんですけど。",
            "zh": "要是天天都这样\n就好了。",
            "narrator_zh": "燕"
        },
        {
            "location": "23/TALK",
            "narrator": "ガブリエラ",
            "text": "つばめは本当に\n甘いわね。",
            "zh": "燕真是太\n天真了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "24/TALK",
            "narrator": "ガブリエラ",
            "text": "いつでも備えて\nおかなきゃダメよ。",
            "zh": "无论何时都要\n做好准备才行哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "26/TALK",
            "narrator": "みやび",
            "text": "そういうガブちゃんは\n常に備えは万全\nなんかね。",
            "zh": "这样的加布\n总是准备得\n万无一失咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "27/TALK",
            "narrator": "ガブリエラ",
            "text": "当然よ。",
            "zh": "当然。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "29/TALK",
            "narrator": "つばめ",
            "text": "さすがガブちゃん！",
            "zh": "不愧是加布！",
            "narrator_zh": "燕"
        },
        {
            "location": "32/TALK",
            "narrator": "ガブリエラ",
            "text": "…素直に言われると\n調子が狂うわ……。",
            "zh": "……被你直白地说出来，\n我反而乱了阵脚……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "44/TALK",
            "narrator": "みやび",
            "text": "相棒よ",
            "zh": "搭档哟",
            "narrator_zh": "雅"
        },
        {
            "location": "45/TALK",
            "narrator": "みやび",
            "text": "なぜガブちゃんの備えが常に万全か知っちゅうか？",
            "zh": "你知道为什么加布的准备总是万全嘛？",
            "narrator_zh": "雅"
        },
        {
            "location": "47/SEL",
            "narrator": "",
            "text": "知らない",
            "zh": "不知道",
            "narrator_zh": ""
        },
        {
            "location": "48/SEL",
            "narrator": "",
            "text": "教えて",
            "zh": "告诉我",
            "narrator_zh": ""
        },
        {
            "location": "49/ACT",
            "narrator": "",
            "text": "知らない",
            "zh": "不知道",
            "narrator_zh": ""
        },
        {
            "location": "50/TALK",
            "narrator": "みやび",
            "text": "即答か",
            "zh": "回答得倒快啊",
            "narrator_zh": "雅"
        },
        {
            "location": "51/ACT",
            "narrator": "",
            "text": "教えて",
            "zh": "告诉我",
            "narrator_zh": ""
        },
        {
            "location": "52/TALK",
            "narrator": "みやび",
            "text": "少しは考えろ",
            "zh": "好歹想一想啊",
            "narrator_zh": "雅"
        },
        {
            "location": "54/TALK",
            "narrator": "みやび",
            "text": "ここだけの話",
            "zh": "只在这里说",
            "narrator_zh": "雅"
        },
        {
            "location": "55/TALK",
            "narrator": "みやび",
            "text": "ガブちゃんはアンドロイドなのだ",
            "zh": "加布其实是个安卓",
            "narrator_zh": "雅"
        },
        {
            "location": "58/SEL",
            "narrator": "",
            "text": "ああ、スマホの",
            "zh": "啊，手机上的",
            "narrator_zh": ""
        },
        {
            "location": "59/SEL",
            "narrator": "",
            "text": "またまた",
            "zh": "又来了",
            "narrator_zh": ""
        },
        {
            "location": "60/ACT",
            "narrator": "",
            "text": "ああ、スマホの",
            "zh": "啊，手机上的",
            "narrator_zh": ""
        },
        {
            "location": "61/TALK",
            "narrator": "みやび",
            "text": "そうそう",
            "zh": "对对",
            "narrator_zh": "雅"
        },
        {
            "location": "62/TALK",
            "narrator": "みやび",
            "text": "って",
            "zh": "话说",
            "narrator_zh": "雅"
        },
        {
            "location": "63/TALK",
            "narrator": "みやび",
            "text": "違うわ！！！！",
            "zh": "不对啊！！！！",
            "narrator_zh": "雅"
        },
        {
            "location": "66/ACT",
            "narrator": "",
            "text": "またまた",
            "zh": "又来了",
            "narrator_zh": ""
        },
        {
            "location": "67/TALK",
            "narrator": "みやび",
            "text": "これがこれが",
            "zh": "这个这个",
            "narrator_zh": "雅"
        },
        {
            "location": "68/TALK",
            "narrator": "みやび",
            "text": "本当なのだ",
            "zh": "是如假包换的哦",
            "narrator_zh": "雅"
        },
        {
            "location": "70/TALK",
            "narrator": "みやび",
            "text": "というわけで",
            "zh": "所以说",
            "narrator_zh": "雅"
        },
        {
            "location": "71/TALK",
            "narrator": "みやび",
            "text": "その証拠をつかめ",
            "zh": "抓住那个证据",
            "narrator_zh": "雅"
        },
        {
            "location": "73/SEL",
            "narrator": "",
            "text": "いや、冗談でしょ？",
            "zh": "不是，你开玩笑的吧？",
            "narrator_zh": ""
        },
        {
            "location": "74/SEL",
            "narrator": "",
            "text": "無茶言うなあ",
            "zh": "别强人所难啊",
            "narrator_zh": ""
        },
        {
            "location": "75/ACT",
            "narrator": "",
            "text": "いや、冗談でしょ？",
            "zh": "不是，你开玩笑的吧？",
            "narrator_zh": ""
        },
        {
            "location": "76/TALK",
            "narrator": "みやび",
            "text": "本気ぞね",
            "zh": "我是认真的咧",
            "narrator_zh": "雅"
        },
        {
            "location": "77/ACT",
            "narrator": "",
            "text": "無茶言うなあ",
            "zh": "别强人所难啊",
            "narrator_zh": ""
        },
        {
            "location": "78/TALK",
            "narrator": "みやび",
            "text": "無茶ではない",
            "zh": "并非强人所难",
            "narrator_zh": "雅"
        },
        {
            "location": "80/TALK",
            "narrator": "みやび",
            "text": "仮にもうちの相棒としてやっていくには",
            "zh": "既然要作为我的搭档干下去",
            "narrator_zh": "雅"
        },
        {
            "location": "81/TALK",
            "narrator": "みやび",
            "text": "このくらいのことは軽くこなしてもらわんとな",
            "zh": "这点程度的事也得轻松办到咯",
            "narrator_zh": "雅"
        },
        {
            "location": "92/TALK",
            "narrator": "アーヤ",
            "text": "今日はこれで\n解散しましょうか。",
            "zh": "今天就到这里\n解散吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "93/TALK",
            "narrator": "ガブリエラ",
            "text": "そうね。\n明日に備えて。",
            "zh": "是啊。\n为明天做准备。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "94/TALK",
            "narrator": "つばめ",
            "text": "ガブちゃんは本当に\n偉いよね…！",
            "zh": "加布真的很\n了不起啊…！",
            "narrator_zh": "燕"
        },
        {
            "location": "95/TALK",
            "narrator": "ガブリエラ",
            "text": "なんかちょっと\n上から目線な\n感じもするわ…。",
            "zh": "总觉得有点\n居高临下的\n感觉……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "96/TALK",
            "narrator": "みやび",
            "text": "素直に受け取っとけば\nええぞね。",
            "zh": "坦率地收下\n就好咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "98/TALK",
            "narrator": "ガブリエラ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "100/TALK",
            "narrator": "みやび",
            "text": "ふふ。",
            "zh": "呵呵。",
            "narrator_zh": "雅"
        },
        {
            "location": "102/TALK",
            "narrator": "ガブリエラ",
            "text": "何その笑い？",
            "zh": "那是什么笑？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "103/TALK",
            "narrator": "みやび",
            "text": "いや。",
            "zh": "不是。",
            "narrator_zh": "雅"
        },
        {
            "location": "105/TALK",
            "narrator": "みやび",
            "text": "羊の夢を見るのは\n人間だけやねえって\n思っただけぞね。",
            "zh": "我只是觉得，\n会做绵羊梦的\n只有人类咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "108/TALK",
            "narrator": "つばめ",
            "text": "羊が一匹、って\nやつですか？",
            "zh": "是「一只绵羊」\n那种吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "109/TALK",
            "narrator": "つばめ",
            "text": "眠れない時に\n数えるといいって。",
            "zh": "据说睡不着的时候\n数数挺管用。",
            "narrator_zh": "燕"
        },
        {
            "location": "110/TALK",
            "narrator": "みやび",
            "text": "ああ、そっちでは\nなくてやね。",
            "zh": "啊，不是那个\n意思咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "111/TALK",
            "narrator": "みやび",
            "text": "感情に基づいて\n行動するのは\n人間だけっちゅう話や。",
            "zh": "凭感情行动的\n只有人类，\n是这么一回事啦。",
            "narrator_zh": "雅"
        }
    ]
}
