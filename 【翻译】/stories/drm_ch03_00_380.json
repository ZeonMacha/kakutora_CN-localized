{
    "dir": "dramatics/daydra/drm_ch03_00_380.js",
    "type": "Episode",
    "info": {
        "story_id": "3038",
        "cid": "gabriella",
        "title": "らぶとーく  第38話",
        "sub_title": "現実感がないの",
        "title_zh": "恋爱漫谈 第38话",
        "sub_title_zh": "没有现实感"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "現実感がないの",
            "zh": "没有现实感"
        },
        {
            "location": "23/TALK",
            "narrator": "つばめ",
            "text": "みやびさん。\nこの煮物、凄く美味しい\nです！",
            "zh": "雅。\n这个炖菜，非常好吃\n！",
            "narrator_zh": "燕"
        },
        {
            "location": "24/TALK",
            "narrator": "みやび",
            "text": "具がちっくと少ない\nけんどね。",
            "zh": "配菜有点少，\n但是呢。",
            "narrator_zh": "雅"
        },
        {
            "location": "26/TALK",
            "narrator": "アーヤ",
            "text": "結構入ってるように\n見えるんだけど…。",
            "zh": "看起来放了\n不少……",
            "narrator_zh": "绫水"
        },
        {
            "location": "27/TALK",
            "narrator": "みやび",
            "text": "里芋がなぁ…。\nうっかり買い忘れ\nちょったき…。",
            "zh": "芋头啊……\n一不小心忘了买\n啵……",
            "narrator_zh": "雅"
        },
        {
            "location": "28/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "31/TALK",
            "narrator": "みやび",
            "text": "それより、アーヤの\nハンバーグ…ちっくと\n薄味やない？",
            "zh": "比起那个，绫水做的\n汉堡肉……是不是\n有点淡咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "32/TALK",
            "narrator": "アーヤ",
            "text": "あっ…き、気付いた？",
            "zh": "啊……你、发现了？",
            "narrator_zh": "绫水"
        },
        {
            "location": "34/TALK",
            "narrator": "アーヤ",
            "text": "実は、塩コショウを\n入れ忘れちゃって…。",
            "zh": "其实，盐和胡椒\n忘了放……",
            "narrator_zh": "绫水"
        },
        {
            "location": "35/TALK",
            "narrator": "みやび",
            "text": "アーヤでもそういう\nミスするんやね。",
            "zh": "连绫水也会\n出这种错咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "38/TALK",
            "narrator": "アーヤ",
            "text": "う、うっかりよ。\n友達と電話しながら\n作ってて…。",
            "zh": "一、一不留神。\n边和朋友打电话\n边做的……",
            "narrator_zh": "绫水"
        },
        {
            "location": "39/TALK",
            "narrator": "つばめ",
            "text": "でも、とっても\n美味しいです。",
            "zh": "不过，非常\n好吃。",
            "narrator_zh": "燕"
        },
        {
            "location": "40/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "44/TALK",
            "narrator": "つばめ",
            "text": "…えっと、ガブちゃん？\nなんか、元気ないみたい\nだけど…。",
            "zh": "……那个，加布？\n好像没什么精神\n……",
            "narrator_zh": "燕"
        },
        {
            "location": "49/TALK",
            "narrator": "みやび",
            "text": "食事も全然進んでない\nようやし、具合でも\n悪いが？",
            "zh": "饭也完全没怎么动，\n是不是身体\n不舒服咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "50/TALK",
            "narrator": "ガブリエラ",
            "text": "…別に。",
            "zh": "……没什么。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "53/TALK",
            "narrator": "アーヤ",
            "text": "だったらちゃんと\n食べなさい。\n身体に悪いわよ？",
            "zh": "那样的话就好好\n吃饭。\n对身体不好哦？",
            "narrator_zh": "绫水"
        },
        {
            "location": "54/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "55/SEL",
            "narrator": "",
            "text": "みんな心配してるんじゃないかな？",
            "zh": "大家是不是都在担心你？",
            "narrator_zh": ""
        },
        {
            "location": "56/SEL",
            "narrator": "",
            "text": "お腹空いてないの？",
            "zh": "你不饿吗？",
            "narrator_zh": ""
        },
        {
            "location": "57/SEL",
            "narrator": "",
            "text": "ゆっくり休め",
            "zh": "好好休息",
            "narrator_zh": ""
        },
        {
            "location": "61/TALK",
            "narrator": "アーヤ",
            "text": "はぁ…何かあったの\nかしら？\nつばめ、知らない？",
            "zh": "唉……出什么\n事了吗？\n燕，你知道吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "63/TALK",
            "narrator": "つばめ",
            "text": "さあ？\nわたしもさっぱりです。",
            "zh": "这个嘛？\n我也完全不知道。",
            "narrator_zh": "燕"
        },
        {
            "location": "64/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "68/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…。",
            "zh": "哈啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "69/TALK",
            "narrator": "ガブリエラ",
            "text": "ごちそうさま。",
            "zh": "多谢款待。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "72/TALK",
            "narrator": "つばめ",
            "text": "あ、ガブちゃん…。",
            "zh": "啊，加布…。",
            "narrator_zh": "燕"
        },
        {
            "location": "75/TALK",
            "narrator": "みやび",
            "text": "…何があったかは\n知らんけんど――",
            "zh": "……发生了什么\n我不知道咯——",
            "narrator_zh": "雅"
        },
        {
            "location": "76/TALK",
            "narrator": "みやび",
            "text": "今は、大人しく見守って\nおくんが一番やね。",
            "zh": "现在，安安静静看着\n才是最好的咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "77/TALK",
            "narrator": "アーヤ",
            "text": "そうね…。\nほら、私達もご飯、\n食べちゃいましょ。",
            "zh": "是啊……。\n来，我们也把饭，\n吃了吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "79/ACT",
            "narrator": "",
            "text": "みんな心配してるんじゃないかな？",
            "zh": "大家是不是都在担心你？",
            "narrator_zh": ""
        },
        {
            "location": "91/TALK",
            "narrator": "ガブリエラ",
            "text": "ふーん",
            "zh": "嗯——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "92/TALK",
            "narrator": "ガブリエラ",
            "text": "心配される筋合いないし",
            "zh": "用不着你担心",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "93/TALK",
            "narrator": "ガブリエラ",
            "text": "$handle$にもそんなこと言われる筋合いないわ",
            "zh": "$handle$也没资格这么说我",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "94/TALK",
            "narrator": "ガブリエラ",
            "text": "放っておいて",
            "zh": "别管我",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "106/ACT",
            "narrator": "",
            "text": "お腹空いてないの？",
            "zh": "你不饿吗？",
            "narrator_zh": ""
        },
        {
            "location": "108/TALK",
            "narrator": "ガブリエラ",
            "text": "食欲ないのよ",
            "zh": "我没有食欲",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "109/TALK",
            "narrator": "ガブリエラ",
            "text": "でも何が起こるかわからないし",
            "zh": "不过不知道会发生什么",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "110/TALK",
            "narrator": "ガブリエラ",
            "text": "食べないわけにはいかないか…",
            "zh": "也不能不吃……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "123/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…。",
            "zh": "哈啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "124/TALK",
            "narrator": "ガブリエラ",
            "text": "味もよくわからないし、\nさっさと食べて、\n部屋に戻ろう…。",
            "zh": "味道也尝不太出来，\n赶快吃完，\n回房间吧……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "125/ACT",
            "narrator": "",
            "text": "ゆっくり休め",
            "zh": "好好休息",
            "narrator_zh": ""
        },
        {
            "location": "127/TALK",
            "narrator": "ガブリエラ",
            "text": "言われなくても休んでるわ",
            "zh": "不用你说我也在休息",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "128/TALK",
            "narrator": "ガブリエラ",
            "text": "っていうか",
            "zh": "话说",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "129/TALK",
            "narrator": "ガブリエラ",
            "text": "食事中にスマホはお行儀悪かったわ",
            "zh": "吃饭的时候看手机不礼貌",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "142/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…。",
            "zh": "哈啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "143/TALK",
            "narrator": "ガブリエラ",
            "text": "なんか、箸が重い…。",
            "zh": "总觉得，筷子好重……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "144/TALK",
            "narrator": "ガブリエラ",
            "text": "食事って、こんなに\n体力いるものだった\nかしら？",
            "zh": "吃饭，原来这么\n费体力\n吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "20/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>某月某日　 19:01 PM</color>\nとある平日の夜、アーヤの部屋にて",
            "zh": "<color=green>某月某日　 19:01 PM</color>\n某个平日的夜里，在绫水的房间。",
            "narrator_zh": "Dialog_EventData"
        }
    ]
}
