{
    "dir": "chap23/daydra/dd_ch03_23_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "23356",
        "cid": "gabriella",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "料理で恩返し",
        "title_zh": "Extra006 额外剧情",
        "sub_title_zh": "以料理报恩"
    },
    "entry": [
        {
            "location": "250/SCENARIO",
            "narrator": "",
            "text": "料理で恩返し",
            "zh": "以料理报恩",
            "narrator_zh": ""
        },
        {
            "location": "263/TALK",
            "narrator": "ガブリエラ",
            "text": "…焼き目も付いたし、\nこんなもんかしら。",
            "zh": "……上色也差不多了，\n就这样吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "265/TALK",
            "narrator": "ガブリエラ",
            "text": "つばめ、\n切ったお野菜持ってきて。",
            "zh": "燕，\n把切好的蔬菜拿过来。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "266/TALK",
            "narrator": "つばめ",
            "text": "ちょ、ちょっと待って。\nもうすぐ終わるから…。",
            "zh": "等、等一下啦。\n马上就切好了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "267/TALK",
            "narrator": "ガブリエラ",
            "text": "まだ終わってないの！？",
            "zh": "还没切好吗！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "269/TALK",
            "narrator": "ガブリエラ",
            "text": "うわっ、ていうかこれ、\n切るの下手過ぎ！",
            "zh": "哇啊，话说你这刀工，\n切得也太差了吧！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "271/TALK",
            "narrator": "つばめ",
            "text": "そ、そうかな？",
            "zh": "有、有吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "272/TALK",
            "narrator": "ガブリエラ",
            "text": "どう見たって下手よ！\n形はいびつだし、\n厚さもバラバラだし…。",
            "zh": "怎么看都很差好吗！\n形状歪七扭八的，\n厚薄也乱七八糟……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "275/TALK",
            "narrator": "つばめ",
            "text": "ご、ごめん…。\nもっと丁寧に、\n早く切るから――",
            "zh": "对、对不起……。\n我会切得更仔细、\n更快一点的——",
            "narrator_zh": "燕"
        },
        {
            "location": "276/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょ、ストップストップ！\nそんな切り方したら\n危ないから！",
            "zh": "喂，停下停下！\n像你那样切菜\n很危险的好不好！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "278/TALK",
            "narrator": "つばめ",
            "text": "でも、この方が\n早く切れるし…。",
            "zh": "可是，这样切\n比较快嘛……。",
            "narrator_zh": "燕"
        },
        {
            "location": "279/TALK",
            "narrator": "ガブリエラ",
            "text": "だからってケガしたら\nダメでしょ！？",
            "zh": "那也不能切伤手\n对吧！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "280/TALK",
            "narrator": "ガブリエラ",
            "text": "それに、これは\nみやびのお母さん達に\n食べてもらう料理よ？",
            "zh": "而且，这可是要端给\n雅的妈妈她们\n吃的料理好吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "281/TALK",
            "narrator": "ガブリエラ",
            "text": "お世話になったお礼の\n食事に、血が付いてたら\nマズいじゃん。",
            "zh": "作为答谢她们照顾的\n饭菜，要是沾上血\n那还得了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "282/TALK",
            "narrator": "つばめ",
            "text": "そ、そうだよね…。",
            "zh": "说、说得也是……。",
            "narrator_zh": "燕"
        },
        {
            "location": "285/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…もういいわ。",
            "zh": "哈啊……算了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "287/TALK",
            "narrator": "ガブリエラ",
            "text": "残りはあたしがやるから、\nつばめはお鍋だけ見てて。",
            "zh": "剩下的我来切，\n燕你只管看着锅就行。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "289/TALK",
            "narrator": "つばめ",
            "text": "だ、大丈夫だよ。\n気を付けてやるから。",
            "zh": "没、没事的啦。\n我会小心的。",
            "narrator_zh": "燕"
        },
        {
            "location": "290/TALK",
            "narrator": "ガブリエラ",
            "text": "あのね…それだと\nどんどん遅くなっちゃう\nでしょ？",
            "zh": "我说你呀……照你那样\n只会越拖越晚\n对吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "291/TALK",
            "narrator": "ガブリエラ",
            "text": "みやびのお母さん達、\nお腹空かせちゃっても\nいいの？",
            "zh": "让雅的妈妈她们\n一直饿着肚子\n也无所谓吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "293/TALK",
            "narrator": "つばめ",
            "text": "そ、それは、\nダメだけど…。",
            "zh": "那、那倒是\n不行啦……。",
            "narrator_zh": "燕"
        },
        {
            "location": "294/TALK",
            "narrator": "ガブリエラ",
            "text": "なら、大人しく鍋だけ\n見てなさい。\nわかった？",
            "zh": "那就乖乖只看着\n锅就行了。\n听懂没？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "296/TALK",
            "narrator": "つばめ",
            "text": "…うん。\nごめんね、邪魔して…。",
            "zh": "……嗯。\n抱歉，净给你添乱……。",
            "narrator_zh": "燕"
        },
        {
            "location": "297/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "299/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょっと、かわいそう\nだったかしら？",
            "zh": "刚才那样，是不是\n有点欺负她了？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "300/TALK",
            "narrator": "ガブリエラ",
            "text": "でも…。",
            "zh": "可是……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "313/TALK",
            "narrator": "ガブリエラ",
            "text": "私は間違ってないわよね？",
            "zh": "我并没有做错吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "314/TALK",
            "narrator": "ガブリエラ",
            "text": "そうと言って",
            "zh": "快这么说啊",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "315/TALK",
            "narrator": "ガブリエラ",
            "text": "マルザンナ",
            "zh": "玛尔赞娜",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "317/SEL",
            "narrator": "",
            "text": "何が間違ってないと思うの？",
            "zh": "你觉得哪方面没错？",
            "narrator_zh": ""
        },
        {
            "location": "318/ACT",
            "narrator": "",
            "text": "何が間違ってないと思うの？",
            "zh": "你觉得哪方面没错？",
            "narrator_zh": ""
        },
        {
            "location": "320/TALK",
            "narrator": "ガブリエラ",
            "text": "つばめに",
            "zh": "就是对燕说",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "321/TALK",
            "narrator": "ガブリエラ",
            "text": "手伝うなって言ったこと",
            "zh": "让她别帮忙这件事",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "322/TALK",
            "narrator": "ガブリエラ",
            "text": "わかってはいるの",
            "zh": "我当然明白",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "323/TALK",
            "narrator": "ガブリエラ",
            "text": "みやびのご両親にお礼をしたい",
            "zh": "想向雅的父母表达谢意",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "324/TALK",
            "narrator": "ガブリエラ",
            "text": "その気持ちは",
            "zh": "这份心情",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "325/TALK",
            "narrator": "ガブリエラ",
            "text": "私もつばめも一緒だって",
            "zh": "我和燕是一样的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "326/TALK",
            "narrator": "ガブリエラ",
            "text": "でも",
            "zh": "但是",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "327/TALK",
            "narrator": "ガブリエラ",
            "text": "つばめは遅いから",
            "zh": "燕实在太慢了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "328/TALK",
            "narrator": "ガブリエラ",
            "text": "どんどん時間が遅くなっちゃう",
            "zh": "时间会越拖越久",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "329/TALK",
            "narrator": "ガブリエラ",
            "text": "それも問題でしょう？",
            "zh": "这不也是个问题吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "331/SEL",
            "narrator": "",
            "text": "間違ってないよ",
            "zh": "你没有错哦",
            "narrator_zh": ""
        },
        {
            "location": "332/SEL",
            "narrator": "",
            "text": "大切なのは気持ちだよ",
            "zh": "重要的是心意哦",
            "narrator_zh": ""
        },
        {
            "location": "333/SEL",
            "narrator": "",
            "text": "簡単な作業を任せようよ",
            "zh": "把简单的活交给她吧",
            "narrator_zh": ""
        },
        {
            "location": "334/ACT",
            "narrator": "",
            "text": "間違ってないよ",
            "zh": "你没有错哦",
            "narrator_zh": ""
        },
        {
            "location": "335/TALK",
            "narrator": "ガブリエラ",
            "text": "そうよね",
            "zh": "对吧",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "337/TALK",
            "narrator": "ガブリエラ",
            "text": "私は間違ってないわよね",
            "zh": "我果然没有做错吧",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "338/TALK",
            "narrator": "ガブリエラ",
            "text": "ありがとう",
            "zh": "谢谢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "339/TALK",
            "narrator": "ガブリエラ",
            "text": "言ってもらえて安心したわ",
            "zh": "听你这么说我就放心了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "352/TALK",
            "narrator": "ガブリエラ",
            "text": "…さてと、残りのも\nちゃっちゃと作らないと。",
            "zh": "……好啦，剩下的菜\n得麻利点做完才行。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "353/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "355/TALK",
            "narrator": "ガブリエラ",
            "text": "ほ、ほらつばめ！\n吹きこぼれないように\nちゃんと見てて！",
            "zh": "喂、喂，燕！\n好好看着别让汤\n溢出来了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "357/TALK",
            "narrator": "つばめ",
            "text": "あ、うん…。",
            "zh": "啊、嗯……。",
            "narrator_zh": "燕"
        },
        {
            "location": "370/TALK",
            "narrator": "ガブリエラ",
            "text": "…もうこんな時間。\nそろそろ寝る準備しよう\nかしら？",
            "zh": "……都这么晚了。\n差不多该准备\n睡觉了吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "372/TALK",
            "narrator": "つばめ",
            "text": "じゃあ、\nお布団の用意するね。",
            "zh": "那，我去铺\n被褥哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "375/TALK",
            "narrator": "ガブリエラ",
            "text": "ん、お願い。",
            "zh": "嗯，拜托了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "378/TALK",
            "narrator": "みやび",
            "text": "おーい、ガブちゃん、\nつばめちゃん。\n起きてる？",
            "zh": "喂—，加布、\n燕。\n还醒着吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "380/TALK",
            "narrator": "ガブリエラ",
            "text": "ええ、そろそろ寝ようと\n思ってたところだけど…。",
            "zh": "嗯，正打算\n睡觉呢……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "381/TALK",
            "narrator": "みやび",
            "text": "すまんすまん。\nうっかりして言いそびれる\nところやった。",
            "zh": "对不住对不住。\n一不留神差点忘了\n跟你们说咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "382/TALK",
            "narrator": "みやび",
            "text": "おかん達が、美味しい食事\n作ってくれてありがとう\n言うてたちや。",
            "zh": "我妈她们说，谢谢你们\n做了这么好吃的饭菜\n咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "383/TALK",
            "narrator": "ガブリエラ",
            "text": "えっ、本当？",
            "zh": "咦，真的吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "385/TALK",
            "narrator": "つばめ",
            "text": "わぁ、やったね！",
            "zh": "哇，太好啦！",
            "narrator_zh": "燕"
        },
        {
            "location": "386/TALK",
            "narrator": "みやび",
            "text": "本当や。\n特にほれ、\nポーランドの料理？",
            "zh": "真的咯。\n特别是那个，\n波兰料理？",
            "narrator_zh": "雅"
        },
        {
            "location": "387/TALK",
            "narrator": "みやび",
            "text": "あれが最高に美味かった\n言うてたぞね。",
            "zh": "她们说那个好吃得\n不得了啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "388/TALK",
            "narrator": "ガブリエラ",
            "text": "そ、そう…。\n口に合ったみたいで\n安心したわ。",
            "zh": "是、是吗……。\n看来合她们的胃口，\n我就放心了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "389/TALK",
            "narrator": "つばめ",
            "text": "すごいよガブちゃん！\nみやびさんのお母さん達、\n美味しかったって！",
            "zh": "好厉害呀加布！\n雅的妈妈她们，\n都夸好吃哦！",
            "narrator_zh": "燕"
        },
        {
            "location": "391/TALK",
            "narrator": "ガブリエラ",
            "text": "い、今聞いたから。\nわかってるわよ。",
            "zh": "我、我刚才听到了。\n我知道啦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "394/TALK",
            "narrator": "つばめ",
            "text": "えへへ…でも、なんだか\n嬉しくて…。",
            "zh": "哎嘿嘿……不过，总觉得\n好开心呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "395/TALK",
            "narrator": "つばめ",
            "text": "やっぱりガブちゃんは\n料理上手なんだなぁ…。",
            "zh": "果然加布做菜\n就是厉害啊……。",
            "narrator_zh": "燕"
        },
        {
            "location": "396/TALK",
            "narrator": "みやび",
            "text": "うちも気になるき、\n東京帰ったら\n食べさせてほしいがよ。",
            "zh": "我也蛮好奇啵，\n等回东京了\n也做给我尝尝咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "398/TALK",
            "narrator": "ガブリエラ",
            "text": "仕方ないわね…。\nその代わり、キッチンは\n貸しなさいよ？",
            "zh": "真拿你没办法……。\n作为交换，厨房\n得借我用哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "400/TALK",
            "narrator": "みやび",
            "text": "しゃあないなぁ…。\nま、そういうことやき、\nおやすみ～。",
            "zh": "那也没办法咯……。\n嘛，就是这么回事啵，\n晚安～。",
            "narrator_zh": "雅"
        },
        {
            "location": "405/TALK",
            "narrator": "ガブリエラ",
            "text": "…よかった。\nちゃんと喜んでもらえて。",
            "zh": "……太好了。\n她们真的很高兴呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "407/TALK",
            "narrator": "つばめ",
            "text": "そうだね。\nやっぱり、ガブちゃんが\n作って正解だったよ。",
            "zh": "是啊。\n果然还是让加布\n来做才对呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "409/TALK",
            "narrator": "ガブリエラ",
            "text": "えっ…。",
            "zh": "咦……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "410/TALK",
            "narrator": "つばめ",
            "text": "わたしも、東京帰ったら\nもっとお料理の練習\nしないと…。",
            "zh": "等我回了东京，\n也得多练习练习\n做菜才行……。",
            "narrator_zh": "燕"
        },
        {
            "location": "411/TALK",
            "narrator": "つばめ",
            "text": "上手になったら、\nまた一緒にお料理してね。",
            "zh": "等我练好了，\n下次再一起做菜哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "412/TALK",
            "narrator": "ガブリエラ",
            "text": "う、うん…。",
            "zh": "嗯、嗯……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "414/TALK",
            "narrator": "ガブリエラ",
            "text": "…何でなのかしら？\n料理、ちゃんと喜んで\nもらえたはずなのに――",
            "zh": "……为什么呢？\n明明大家已经很喜欢\n这顿料理了——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "415/TALK",
            "narrator": "ガブリエラ",
            "text": "どうして、こんなに\nモヤモヤした気持ちに\nなるのかしら…。",
            "zh": "为什么心里却还是\n这么闷闷不乐\n的呢……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "416/ACT",
            "narrator": "",
            "text": "大切なのは気持ちだよ",
            "zh": "重要的是心意哦",
            "narrator_zh": ""
        },
        {
            "location": "417/TALK",
            "narrator": "ガブリエラ",
            "text": "気持ちね",
            "zh": "心意啊",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "418/TALK",
            "narrator": "ガブリエラ",
            "text": "いい言葉だけど",
            "zh": "说得倒是好听",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "419/TALK",
            "narrator": "ガブリエラ",
            "text": "気持ちで食事は美味しくならないわ",
            "zh": "光靠心意可没法让菜变好吃",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "420/TALK",
            "narrator": "ガブリエラ",
            "text": "それが事実なのよ",
            "zh": "这就是事实啊",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "431/TALK",
            "narrator": "ガブリエラ",
            "text": "…料理なんて、\n結局は技術なんだから。",
            "zh": "……做菜这种事，\n归根结底还是靠手艺。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "432/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "434/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "437/TALK",
            "narrator": "ガブリエラ",
            "text": "ああ、もう！\nわかった、わかったわよ！",
            "zh": "啊啊，真是的！\n知道了，我知道了啦！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "438/TALK",
            "narrator": "ガブリエラ",
            "text": "つばめ、鍋はもういいから\nそこにある野菜炒めて！",
            "zh": "燕，锅不用管了，\n去把那边的蔬菜炒一下！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "440/TALK",
            "narrator": "つばめ",
            "text": "えっ…いいの？",
            "zh": "咦……可以吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "442/TALK",
            "narrator": "ガブリエラ",
            "text": "一々聞き返さない！\nあたしの気が変わる前に\nさっさと動く！",
            "zh": "别一句句反问了！\n趁我还没改变主意\n快点动手！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "444/TALK",
            "narrator": "つばめ",
            "text": "う、うん！\nありがと、ガブちゃん。",
            "zh": "嗯、嗯！\n谢谢你，加布。",
            "narrator_zh": "燕"
        },
        {
            "location": "459/TALK",
            "narrator": "つばめ",
            "text": "どうだったかな？\nわたし達の作った料理、\n喜んでもらえたかな？",
            "zh": "怎么样呀？\n我们做的料理，\n她们喜欢吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "461/TALK",
            "narrator": "ガブリエラ",
            "text": "落ち着きなさいよ。\nそんなの期待するなんて\nはしたないわよ。",
            "zh": "给我沉住气。\n那样满怀期待地等着夸奖\n也太难看了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "462/TALK",
            "narrator": "つばめ",
            "text": "でも、ガブちゃんも\n感想気になるでしょ？",
            "zh": "可是，加布你其实也\n很在意感想对吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "463/TALK",
            "narrator": "ガブリエラ",
            "text": "あ、あたしは別に！\nそんなの気にするような\n子供じゃないし…。",
            "zh": "我、我才没有！\n我又不是会在意那种事的\n小孩子……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "466/TALK",
            "narrator": "みやび",
            "text": "おっ、二人とも\nまだ起きちょったか。",
            "zh": "哦，你们俩\n还醒着啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "467/TALK",
            "narrator": "つばめ",
            "text": "あっ、みやびさん。",
            "zh": "啊，雅。",
            "narrator_zh": "燕"
        },
        {
            "location": "468/TALK",
            "narrator": "みやび",
            "text": "うち、今夜も自室で\n遅くまで起きてるき。",
            "zh": "我今晚也在自己屋里\n熬到蛮晚啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "470/TALK",
            "narrator": "みやび",
            "text": "何かあったら、\n呼びに来るなりＷＡＶＥ\n送るなりしてな。",
            "zh": "有么子事的话，\n来叫我也好发ＷＡＶＥ\n也好，尽管找我。",
            "narrator_zh": "雅"
        },
        {
            "location": "471/TALK",
            "narrator": "ガブリエラ",
            "text": "わ、わかったわ…。",
            "zh": "知、知道了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "472/TALK",
            "narrator": "みやび",
            "text": "ん、それじゃ…。",
            "zh": "嗯，那就这样……。",
            "narrator_zh": "雅"
        },
        {
            "location": "474/TALK",
            "narrator": "ガブリエラ",
            "text": "えっ？",
            "zh": "咦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "475/TALK",
            "narrator": "みやび",
            "text": "何？　何か用あるが？",
            "zh": "么子？　有么子事喃？",
            "narrator_zh": "雅"
        },
        {
            "location": "477/TALK",
            "narrator": "ガブリエラ",
            "text": "あ、ううん。\n別に…。",
            "zh": "啊，没有。\n没什么……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "479/TALK",
            "narrator": "つばめ",
            "text": "あ、あの！",
            "zh": "那、那个！",
            "narrator_zh": "燕"
        },
        {
            "location": "480/TALK",
            "narrator": "つばめ",
            "text": "お母さん達、お料理のこと\n何か言ってません\nでしたか？",
            "zh": "阿姨她们，对料理\n有没有说\n什么呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "482/TALK",
            "narrator": "みやび",
            "text": "は？",
            "zh": "哈？",
            "narrator_zh": "雅"
        },
        {
            "location": "485/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょ、つばめ！",
            "zh": "喂、燕！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "488/TALK",
            "narrator": "つばめ",
            "text": "ごめん…でも、やっぱり\n気になるし…。",
            "zh": "抱歉……可我还是\n很在意嘛……。",
            "narrator_zh": "燕"
        },
        {
            "location": "489/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "490/TALK",
            "narrator": "みやび",
            "text": "ああ、食事か。\n二人が料理したん\nやったね。",
            "zh": "啊啊，晚饭啊。\n是你们俩做的\n来着咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "491/TALK",
            "narrator": "つばめ",
            "text": "は、はい…。",
            "zh": "是、是的……。",
            "narrator_zh": "燕"
        },
        {
            "location": "493/TALK",
            "narrator": "みやび",
            "text": "えーっと…ほれ、あれや。",
            "zh": "呃……那个，就是那个咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "496/TALK",
            "narrator": "みやび",
            "text": "ごちそうさま、って\n言うてたぞね。",
            "zh": "她们说，多谢款待\n啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "498/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "500/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "503/TALK",
            "narrator": "みやび",
            "text": "あー…そういうわけやき、\nおやすみー…。",
            "zh": "啊—……就是这么回事啵，\n晚安—……。",
            "narrator_zh": "雅"
        },
        {
            "location": "508/TALK",
            "narrator": "ガブリエラ",
            "text": "気を使われたのに\n違いはないわね。",
            "zh": "她们肯定是在\n顾及我们的面子吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "509/TALK",
            "narrator": "つばめ",
            "text": "うう、ごめんね…。\nやっぱり、ガブちゃんに\n任せておけばよかった…。",
            "zh": "呜呜，对不起……。\n果然，还是全交给加布\n来做就好了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "510/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "511/TALK",
            "narrator": "ガブリエラ",
            "text": "バカね。\n目的はお礼を言われる\nことじゃないでしょ？",
            "zh": "笨蛋。\n我们的目的又不是\n让人家道谢对吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "512/TALK",
            "narrator": "ガブリエラ",
            "text": "お世話になった\n感謝の気持ちで\n作った物なんだから。",
            "zh": "这可是怀着感谢她们\n照顾的心情\n才做的饭菜啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "514/TALK",
            "narrator": "ガブリエラ",
            "text": "その気持ちを、\nお母さん達は受け取って\n食べてくれたのよ？",
            "zh": "阿姨她们领受了那份心意\n把那顿饭\n吃掉了不是吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "515/TALK",
            "narrator": "ガブリエラ",
            "text": "だから、贅沢言わずに\n満足しなさい。",
            "zh": "所以，别不知足了，\n就该心满意足才对。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "516/TALK",
            "narrator": "つばめ",
            "text": "…ガブちゃん…、\n何か、大人だね…。",
            "zh": "……加布……\n总觉得，你好成熟啊……。",
            "narrator_zh": "燕"
        },
        {
            "location": "517/TALK",
            "narrator": "ガブリエラ",
            "text": "な、何よそれ？",
            "zh": "什、什么话嘛那是？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "518/TALK",
            "narrator": "つばめ",
            "text": "何か、見習わないとなぁ、\nって思って…。",
            "zh": "就觉得，我也得\n向你学习才行呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "520/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "521/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…やっぱり、\nあたしが作った方が\nよかったかも…。",
            "zh": "哈啊……果然，还是\n我来做会比较好\n吧……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "522/ACT",
            "narrator": "",
            "text": "簡単な作業を任せようよ",
            "zh": "把简单的活交给她吧",
            "narrator_zh": ""
        },
        {
            "location": "523/TALK",
            "narrator": "ガブリエラ",
            "text": "簡単に言うわね",
            "zh": "说得倒轻巧",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "524/TALK",
            "narrator": "ガブリエラ",
            "text": "そう言うけど",
            "zh": "话是这么说",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "525/TALK",
            "narrator": "ガブリエラ",
            "text": "つばめでもできるような",
            "zh": "连燕也能做到的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "526/TALK",
            "narrator": "ガブリエラ",
            "text": "簡単な作業",
            "zh": "简单活儿",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "527/TALK",
            "narrator": "ガブリエラ",
            "text": "考えるのは難しいのよ？",
            "zh": "想起来也是很难的好吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "528/TALK",
            "narrator": "ガブリエラ",
            "text": "まあ",
            "zh": "算了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "529/TALK",
            "narrator": "ガブリエラ",
            "text": "考えてみるけど",
            "zh": "我想想看就是了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "540/TALK",
            "narrator": "ガブリエラ",
            "text": "…つばめでも問題なく\nできる簡単な作業…。",
            "zh": "……连燕也能顺利\n做好的简单活儿……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "541/TALK",
            "narrator": "ガブリエラ",
            "text": "うーん…。",
            "zh": "唔……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "543/TALK",
            "narrator": "ガブリエラ",
            "text": "…そうだ！\nつばめ、お鍋の味付け\n手伝って！",
            "zh": "……对了！\n燕，你来帮忙给锅里\n调味吧！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "545/TALK",
            "narrator": "つばめ",
            "text": "えっ！？\nあ、味付けって\nすごい重要じゃ…。",
            "zh": "咦！？\n可、可是调味不是\n超级重要的吗……。",
            "narrator_zh": "燕"
        },
        {
            "location": "546/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしはこっちの作業が\nあるんだから、つばめが\nやるしかないでしょ？",
            "zh": "我这边还有别的事要做，\n不交给燕还能交给谁\n对吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "547/TALK",
            "narrator": "ガブリエラ",
            "text": "ちゃんと指示するから、\n言われた通りに入れて。\nＯＫ？",
            "zh": "我会好好指挥你的，\n照我说的放就行了。\nＯＫ？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "548/TALK",
            "narrator": "つばめ",
            "text": "う、うん！\n任せて！",
            "zh": "嗯、嗯！\n交给我吧！",
            "narrator_zh": "燕"
        },
        {
            "location": "549/TALK",
            "narrator": "ガブリエラ",
            "text": "…ちなみに、間違えたら\n台無しになるわよ？",
            "zh": "……顺便一提，放错了\n可就全毁了哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "550/TALK",
            "narrator": "つばめ",
            "text": "ぷ、プレッシャー\nかけないでよぉ！",
            "zh": "别、别给我这么大\n压力啦！",
            "narrator_zh": "燕"
        },
        {
            "location": "552/TALK",
            "narrator": "ガブリエラ",
            "text": "文句言わないの。\nそれじゃ、まずは――",
            "zh": "不许抱怨。\n那么，首先——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "565/TALK",
            "narrator": "ガブリエラ",
            "text": "…もうこんな時間。\nそろそろ寝る準備しよう\nかしら？",
            "zh": "……都这么晚了。\n差不多该准备\n睡觉了吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "567/TALK",
            "narrator": "つばめ",
            "text": "じゃあ、\nお布団の用意するね。",
            "zh": "那，我去铺\n被褥哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "568/TALK",
            "narrator": "ガブリエラ",
            "text": "ん、お願い。",
            "zh": "嗯，拜托了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "571/TALK",
            "narrator": "みやび",
            "text": "おーい、ガブちゃん、\nつばめちゃん。\n起きてる？",
            "zh": "喂—，加布、\n燕。\n还醒着吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "573/TALK",
            "narrator": "ガブリエラ",
            "text": "ええ、そろそろ寝ようと\n思ってたところだけど…。",
            "zh": "嗯，正打算\n睡觉呢……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "574/TALK",
            "narrator": "みやび",
            "text": "すまんすまん。\nうっかりして言いそびれる\nところやった。",
            "zh": "对不住对不住。\n一不留神差点忘了\n跟你们说咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "576/TALK",
            "narrator": "みやび",
            "text": "おかん達が、美味しい食事\n作ってくれてありがとう\n言うてたちや。",
            "zh": "我妈她们说，谢谢你们\n做了这么好吃的饭菜\n咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "577/TALK",
            "narrator": "ガブリエラ",
            "text": "えっ、本当？",
            "zh": "咦，真的吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "579/TALK",
            "narrator": "つばめ",
            "text": "わぁ、やったね！",
            "zh": "哇，太好啦！",
            "narrator_zh": "燕"
        },
        {
            "location": "580/TALK",
            "narrator": "みやび",
            "text": "本当や。\n特にほれ、\nポーランドの料理？",
            "zh": "真的咯。\n特别是那个，\n波兰料理？",
            "narrator_zh": "雅"
        },
        {
            "location": "581/TALK",
            "narrator": "みやび",
            "text": "あれが最高に美味かった\n言うてたぞね。",
            "zh": "她们说那个好吃得\n不得了啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "582/TALK",
            "narrator": "ガブリエラ",
            "text": "そ、そう…。\n口に合ったみたいで\n安心したわ。",
            "zh": "是、是吗……。\n看来合她们的胃口，\n我就放心了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "583/TALK",
            "narrator": "つばめ",
            "text": "すごいよガブちゃん！\nみやびさんのお母さん達、\n美味しかったって！",
            "zh": "好厉害呀加布！\n雅的妈妈她们，\n都夸好吃哦！",
            "narrator_zh": "燕"
        },
        {
            "location": "585/TALK",
            "narrator": "ガブリエラ",
            "text": "い、今聞いたから。\nわかってるわよ。",
            "zh": "我、我刚才听到了。\n我知道啦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "587/TALK",
            "narrator": "つばめ",
            "text": "えへへ…でも、なんだか\n嬉しくて…。",
            "zh": "哎嘿嘿……不过，总觉得\n好开心呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "588/TALK",
            "narrator": "つばめ",
            "text": "やっぱりガブちゃんは\n料理上手なんだなぁ…。",
            "zh": "果然加布做菜\n就是厉害啊……。",
            "narrator_zh": "燕"
        },
        {
            "location": "589/TALK",
            "narrator": "みやび",
            "text": "うちも気になるき、\n東京帰ったら\n食べさせてほしいがよ。",
            "zh": "我也蛮好奇啵，\n等回东京了\n也做给我尝尝咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "591/TALK",
            "narrator": "ガブリエラ",
            "text": "仕方ないわね…。\nその代わり、キッチンは\n貸しなさいよ？",
            "zh": "真拿你没办法……。\n作为交换，厨房\n得借我用哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "593/TALK",
            "narrator": "みやび",
            "text": "しゃあないなぁ…。\nま、そういうことやき、\nおやすみ～。",
            "zh": "那也没办法咯……。\n嘛，就是这么回事啵，\n晚安～。",
            "narrator_zh": "雅"
        },
        {
            "location": "598/TALK",
            "narrator": "ガブリエラ",
            "text": "…そっか。\n喜んでもらえたんだ…。",
            "zh": "……这样啊。\n她们很喜欢呢……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "599/TALK",
            "narrator": "ガブリエラ",
            "text": "よかった…。\nやっぱり作って\n正解だったわ。",
            "zh": "太好了……。\n果然做这顿饭\n是对的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "600/TALK",
            "narrator": "つばめ",
            "text": "…ガブちゃん。\n今日はありがと。",
            "zh": "……加布。\n今天谢谢你。",
            "narrator_zh": "燕"
        },
        {
            "location": "602/TALK",
            "narrator": "ガブリエラ",
            "text": "えっ？",
            "zh": "咦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "604/TALK",
            "narrator": "つばめ",
            "text": "お料理…ガブちゃんの\n指示があったから、\n美味しくなったんだもん。",
            "zh": "做菜……全靠加布的\n指挥，才能做得\n这么好吃呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "605/TALK",
            "narrator": "つばめ",
            "text": "そうじゃなかったら、\nきっと、大変なことに\nなってたと思うし…。",
            "zh": "要是没有你，\n肯定会变得\n一团糟的……。",
            "narrator_zh": "燕"
        },
        {
            "location": "606/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "608/TALK",
            "narrator": "つばめ",
            "text": "でも、ガブちゃんの\nおかげで、わたしも\n協力出来たから。",
            "zh": "而且，多亏了加布，\n我也帮上忙\n了嘛。",
            "narrator_zh": "燕"
        },
        {
            "location": "610/TALK",
            "narrator": "つばめ",
            "text": "だから、ありがと。",
            "zh": "所以，谢谢你。",
            "narrator_zh": "燕"
        },
        {
            "location": "612/TALK",
            "narrator": "ガブリエラ",
            "text": "…べ、別に…、みやびの\nお母さん達に喜んで\nほしかっただけよ…。",
            "zh": "……我、我只是，想让\n雅的妈妈她们\n开心而已……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "613/TALK",
            "narrator": "ガブリエラ",
            "text": "つばめを喜ばそうと\n思ってやったわけじゃ\nないし…。",
            "zh": "才不是为了让你开心\n才这么做的\n好吗……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "615/TALK",
            "narrator": "つばめ",
            "text": "そ、そうだよね。",
            "zh": "说、说得也是。",
            "narrator_zh": "燕"
        },
        {
            "location": "617/TALK",
            "narrator": "つばめ",
            "text": "でも、わたしもとっても\n嬉しいから。\nだから――",
            "zh": "不过，我真的特别\n开心。\n所以——",
            "narrator_zh": "燕"
        },
        {
            "location": "619/TALK",
            "narrator": "ガブリエラ",
            "text": "はいはい、わかったから。\nそう何度もお礼言わなくて\nいいから！",
            "zh": "好好好，我知道了。\n不用一而再再而三地\n道谢啦！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "620/TALK",
            "narrator": "つばめ",
            "text": "あ、うん…えへへ…。",
            "zh": "啊、嗯……哎嘿嘿……。",
            "narrator_zh": "燕"
        },
        {
            "location": "622/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "624/TALK",
            "narrator": "ガブリエラ",
            "text": "本当…二人で作って\nよかった…。",
            "zh": "真的……能两个人一起做\n太好了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "261/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>8月23日　 5:34 PM</color>\n合宿中、みやびの実家でのこと",
            "zh": "<color=green>8月23日　 5:34 PM</color>\n合宿期间，在雅的老家",
            "narrator_zh": "Dialog_EventData"
        }
    ]
