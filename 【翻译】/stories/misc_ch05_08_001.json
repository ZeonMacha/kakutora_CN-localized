            "narrator_zh": "神乐"
        },
        {
            "location": "1528/TALK",
            "narrator": "神楽",
            "text": "という身も蓋もない言葉があるわけだが",
            "zh": "有这么一句不留情面的话",
            "narrator_zh": "神乐"
        },
        {
            "location": "1530/SEL",
            "narrator": "",
            "text": "ぴょんこさんには関係ないでしょ",
            "zh": "跟蹦子没关系吧",
            "narrator_zh": ""
        },
        {
            "location": "1531/SEL",
            "narrator": "",
            "text": "意外と変わるかもよ",
            "zh": "说不定意外会变哦",
            "narrator_zh": ""
        },
        {
            "location": "1532/SEL",
            "narrator": "",
            "text": "耳が痛い…",
            "zh": "说到心坎上了……",
            "narrator_zh": ""
        },
        {
            "location": "1533/ACT",
            "narrator": "",
            "text": "ぴょんこさんには関係ないでしょ",
            "zh": "跟蹦子没关系吧",
            "narrator_zh": ""
        },
        {
            "location": "1534/TALK",
            "narrator": "神楽",
            "text": "$handlek$ったらお上手ですね？",
            "zh": "$handlek$你嘴真甜呢？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1536/TALK",
            "narrator": "神楽",
            "text": "素直に受け取っておくけどね！",
            "zh": "我就老实收下了！",
            "narrator_zh": "神乐"
        },
        {
            "location": "1537/ACT",
            "narrator": "",
            "text": "意外と変わるかもよ",
            "zh": "说不定意外会变哦",
            "narrator_zh": ""
        },
        {
            "location": "1538/TALK",
            "narrator": "神楽",
            "text": "どうかなー",
            "zh": "怎么样呢",
            "narrator_zh": "神乐"
        },
        {
            "location": "1540/TALK",
            "narrator": "神楽",
            "text": "それは",
            "zh": "这个嘛",
            "narrator_zh": "神乐"
        },
        {
            "location": "1541/ACT",
            "narrator": "",
            "text": "耳が痛い…",
            "zh": "说到心坎上了……",
