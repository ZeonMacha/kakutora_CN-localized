        },
        {
            "location": "1544/TALK",
            "narrator": "神楽",
            "text": "意外とそうでもないって",
            "zh": "意外地也不是那样",
            "narrator_zh": "神乐"
        },
        {
            "location": "1546/TALK",
            "narrator": "神楽",
            "text": "ぴょんこはこう見えても異世界転生自体には興味津々なわけで",
