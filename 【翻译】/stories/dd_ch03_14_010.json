{
    "dir": "chap14/daydra/dd_ch03_14_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "14352",
        "cid": "gabriella",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "國政綾水と急接近！",
        "title_zh": "Extra002 额外剧情",
        "sub_title_zh": "与国政绫水急速拉近距离！"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "アーヤＭＶ回１",
            "zh": "绫水MV回1",
            "narrator_zh": ""
        },
        {
            "location": "19/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤ、帰ってる？\n今いいかしら？",
            "zh": "绫水，回来了吗？\n现在方便吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "23/TALK",
            "narrator": "ガブリエラ",
            "text": "…アーヤ？\nねえ、ちょっと。\nいないの？",
            "zh": "……绫水？\n喂，在吗。\n不在屋里吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "27/TALK",
            "narrator": "ガブリエラ",
            "text": "借りてた本、\n返しに来たんだけど？",
            "zh": "我来还之前\n借的书了哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "29/TALK",
            "narrator": "ガブリエラ",
            "text": "…入るわよ？",
            "zh": "……我进来了哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "45/TALK",
            "narrator": "アーヤ",
            "text": "くー…すー…。",
            "zh": "呼……嘶……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "46/TALK",
            "narrator": "ガブリエラ",
            "text": "…入るわよ？",
            "zh": "……我进来了哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "52/TALK",
            "narrator": "ガブリエラ",
            "text": "…何だ。\n寝てたのね。",
            "zh": "……什么嘛。\n原来在睡觉啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "53/TALK",
            "narrator": "ガブリエラ",
            "text": "そういえば、昨日は\nレポートを書くとか\n言ってたっけ。",
            "zh": "说起来，昨天\n她好像说过要写\n报告来着。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "54/TALK",
            "narrator": "ガブリエラ",
            "text": "もしかして、\n徹夜だったのかしら？",
            "zh": "难道说，\n她熬了个通宵吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "56/TALK",
            "narrator": "ガブリエラ",
            "text": "…お疲れ様。\n本、置いとくから。",
            "zh": "……辛苦啦。\n书我放这儿了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "57/TALK",
            "narrator": "アーヤ",
            "text": "…くー。",
            "zh": "……呼。",
            "narrator_zh": "绫水"
        },
        {
            "location": "58/TALK",
            "narrator": "ガブリエラ",
            "text": "ふふっ、\n寝息で返事してる\nみたい。",
            "zh": "呵呵，\n简直像在用呼吸声\n回答我一样。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "59/TALK",
            "narrator": "アーヤ",
            "text": "くー…すー…。",
            "zh": "呼……嘶……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "60/TALK",
            "narrator": "ガブリエラ",
            "text": "…考えてみると、\nアーヤの寝顔って\n超レアかも。",
            "zh": "……仔细想想，\n绫水的睡颜\n说不定超级稀有呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "61/TALK",
            "narrator": "ガブリエラ",
            "text": "出撃の後とか、\nあたし達は車の中で\n寝ちゃうけど――",
            "zh": "出击结束后之类的，\n我们都会在车上\n睡过去——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "62/TALK",
            "narrator": "ガブリエラ",
            "text": "運転してるアーヤは\nいつも起きてるし。",
            "zh": "但负责开车的绫水\n总是醒着的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "63/TALK",
            "narrator": "ガブリエラ",
            "text": "そっか…。\nアーヤってこんな\n顔で眠るのね…。",
            "zh": "这样啊……。\n原来绫水睡觉时是\n这副表情啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "64/TALK",
            "narrator": "アーヤ",
            "text": "くー…。",
            "zh": "呼……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "65/TALK",
            "narrator": "ガブリエラ",
            "text": "…アーヤって――",
            "zh": "……绫水她——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "67/TALK",
            "narrator": "ガブリエラ",
            "text": "やっぱり、美人よね。",
            "zh": "果然，真是个美人啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "72/TALK",
            "narrator": "ガブリエラ",
            "text": "初めてアーヤのこと\n見たのって、かなり\n前だったっけ。",
            "zh": "第一次见到绫水\n是什么时候来着，\n好久以前了吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "73/TALK",
            "narrator": "ガブリエラ",
            "text": "その時も美人だし、\nかっこいいな、って\n思ったけど――",
            "zh": "那时候我就觉得她\n既漂亮又帅气，\n不过——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "76/TALK",
            "narrator": "ガブリエラ",
            "text": "今はそれ以上に\n美人だし…かっこよく\n見えるかも。",
            "zh": "现在看起来比那时候\n还要漂亮……还要帅气\n也说不定。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "77/TALK",
            "narrator": "ガブリエラ",
            "text": "戦ってるとこ、\n間近で見てるから\nかしら？",
            "zh": "是因为平时总能\n在近处看着她\n战斗的缘故吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "78/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "79/TALK",
            "narrator": "ガブリエラ",
            "text": "寝てても美人で\nかっこいいとか、\nズルいわ…。",
            "zh": "连睡着的时候都\n又漂亮又帅气，\n太犯规了吧……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "80/SEL",
            "narrator": "",
            "text": "惚れてるの？",
            "zh": "迷上她了？",
            "narrator_zh": ""
        },
        {
            "location": "81/SEL",
            "narrator": "",
            "text": "イタズラしちゃえ",
            "zh": "恶作剧一下吧",
            "narrator_zh": ""
        },
        {
            "location": "82/ACT",
            "narrator": "",
            "text": "惚れてるの？",
            "zh": "迷上她了？",
            "narrator_zh": ""
        },
        {
            "location": "91/TALK",
            "narrator": "ガブリエラ",
            "text": "それはないから",
            "zh": "那绝对不可能",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "92/TALK",
            "narrator": "ガブリエラ",
            "text": "ありえないでしょ？",
            "zh": "怎么可能有那种事嘛？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "93/TALK",
            "narrator": "ガブリエラ",
            "text": "まあ",
            "zh": "不过呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "94/TALK",
            "narrator": "ガブリエラ",
            "text": "そういう人もいるのはわかるわ",
            "zh": "我也理解有人会这样",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "95/TALK",
            "narrator": "ガブリエラ",
            "text": "女の子同士の",
            "zh": "就是女孩子之间的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "96/TALK",
            "narrator": "ガブリエラ",
            "text": "百合ってやつよね？",
            "zh": "所谓百合对吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "97/TALK",
            "narrator": "ガブリエラ",
            "text": "でも私はノーマルだから！",
            "zh": "但我可是正常向的！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "98/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょっと美人でかっこいいなって",
            "zh": "就只是觉得她",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "99/TALK",
            "narrator": "ガブリエラ",
            "text": "思っただけよ！",
            "zh": "有点漂亮又有点帅气而已啦！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "104/TALK",
            "narrator": "ガブリエラ",
            "text": "…って、これじゃ\nムキになって言い訳\nしてるみたい。",
            "zh": "……不对，这样一来\n岂不是像我在较真地\n找借口一样嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "105/TALK",
            "narrator": "ガブリエラ",
            "text": "それに、いつの間にか\nこんな近くまで\n寄ってるし…。",
            "zh": "而且，不知不觉间\n还凑到这么近的\n距离了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "106/TALK",
            "narrator": "ガブリエラ",
            "text": "…何やってんだろ。\n本は返したんだし、\nもう帰ろ…。",
            "zh": "……我在干什么呀。\n书都已经还完了，\n快点回去吧……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "109/TALK",
            "narrator": "アーヤ",
            "text": "んんっ…誰？",
            "zh": "嗯唔……谁？",
            "narrator_zh": "绫水"
        },
        {
            "location": "110/TALK",
            "narrator": "ガブリエラ",
            "text": "えっ！？\nあっ、きゃぁ！！",
            "zh": "哎！？\n啊，呀啊！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "112/TALK",
            "narrator": "アーヤ",
            "text": "っ！？　危ない！！",
            "zh": "唔！？　危险！！",
            "narrator_zh": "绫水"
        },
        {
            "location": "116/TALK",
            "narrator": "ガブリエラ",
            "text": "むぎゅっ！",
            "zh": "呜啾！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "117/TALK",
            "narrator": "アーヤ",
            "text": "っと…危なかったわ。",
            "zh": "唔……好险。",
            "narrator_zh": "绫水"
        },
        {
            "location": "118/TALK",
            "narrator": "ガブリエラ",
            "text": "えっ…えっ？",
            "zh": "哎……哎？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "146/TALK",
            "narrator": "ガブリエラ",
            "text": "えぇーっ！？",
            "zh": "哎哎——！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "147/TALK",
            "narrator": "アーヤ",
            "text": "ビックリしたわ…。\nギャヴィ、大丈夫？\nケガしてない？",
            "zh": "吓了我一跳……。\n加维，你没事吧？\n没受伤吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "148/TALK",
            "narrator": "ガブリエラ",
            "text": "えっ？　あ、えと…、\nどうなってんの？",
            "zh": "哎？　啊，那个……，\n这、这是什么情况？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "149/TALK",
            "narrator": "アーヤ",
            "text": "ちょっと、大丈夫？\n頭打ったりとか\nしてない？",
            "zh": "喂，没事吧？\n没有撞到头\n什么的吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "150/TALK",
            "narrator": "ガブリエラ",
            "text": "…あ、う、うん。\n大丈夫…ありがと。",
            "zh": "……啊，嗯、嗯。\n没事……谢谢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "151/TALK",
            "narrator": "アーヤ",
            "text": "そう…。",
            "zh": "是吗……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "152/TALK",
            "narrator": "アーヤ",
            "text": "それはそうと――",
            "zh": "话又说回来——",
            "narrator_zh": "绫水"
        },
        {
            "location": "153/TALK",
            "narrator": "アーヤ",
            "text": "寝てる人に\n飛びかかったりしたら\n危ないでしょ！？",
            "zh": "突然往睡着的人\n身上扑过来，\n很危险的好不好！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "155/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょ！？　飛びかかる\nって何よ！？",
            "zh": "等！？　什么叫\n往你身上扑啊！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "156/TALK",
            "narrator": "ガブリエラ",
            "text": "急にアーヤが声かけた\nから、ビックリして\n転んだんじゃない！",
            "zh": "还不是因为绫水突然\n出声，我吓了一跳才\n摔倒的嘛！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "157/TALK",
            "narrator": "アーヤ",
            "text": "それにしたって、\n勝手に入って来るのは\nどうなの？",
            "zh": "就算这样，\n擅自闯进别人房间\n又算怎么回事？",
            "narrator_zh": "绫水"
        },
        {
            "location": "158/TALK",
            "narrator": "ガブリエラ",
            "text": "仕方ないでしょ！？\n大体、明るいうちから\n寝てる方が悪いのよ。",
            "zh": "那也没办法吧！？\n说到底，大白天的\n还在睡觉才是你的错。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "159/TALK",
            "narrator": "アーヤ",
            "text": "いや、全然答えに\nなってないんだけど？",
            "zh": "不，你这根本算不上\n回答吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "160/TALK",
            "narrator": "アーヤ",
            "text": "…っていうか、\nちょっと待って。",
            "zh": "……话说回来，\n等一下。",
            "narrator_zh": "绫水"
        },
        {
            "location": "161/TALK",
            "narrator": "ガブリエラ",
            "text": "どうかし…っ！？",
            "zh": "怎、怎么了……！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "162/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょ、えっ！？\nな、何やってんの、\nアーヤ？",
            "zh": "等、哎！？\n你、你在干什么啊，\n绫水？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "163/TALK",
            "narrator": "アーヤ",
            "text": "動かないで。\nすぐ済むから。",
            "zh": "别动。\n马上就好。",
            "narrator_zh": "绫水"
        },
        {
            "location": "164/TALK",
            "narrator": "ガブリエラ",
            "text": "で、でも…、そんな\nあちこち触られたら、\nその…あっ！",
            "zh": "可、可是……，被这样\n到处乱摸的话，\n那个……啊！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "165/TALK",
            "narrator": "アーヤ",
            "text": "くすぐったかった？\nもう少しだから…。",
            "zh": "觉得痒了吗？\n再忍一下哦……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "167/TALK",
            "narrator": "ガブリエラ",
            "text": "うっ、うぅ…。",
            "zh": "唔、唔唔……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "168/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "169/TALK",
            "narrator": "アーヤ",
            "text": "やっぱり。\nギャヴィ、あなた――",
            "zh": "果然。\n加维，你——",
            "narrator_zh": "绫水"
        },
        {
            "location": "170/TALK",
            "narrator": "アーヤ",
            "text": "ちゃんとご飯\n食べてる？",
            "zh": "平时有好好\n吃饭吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "171/TALK",
            "narrator": "ガブリエラ",
            "text": "…え？",
            "zh": "……哎？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "172/TALK",
            "narrator": "アーヤ",
            "text": "こんなに身体軽いし、\nほら、この辺の\n肉付きとか…。",
            "zh": "身子这么轻，\n你看，这边的\n肉也这么薄……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "173/TALK",
            "narrator": "ガブリエラ",
            "text": "ひゃぅっ！",
            "zh": "呀呜！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "175/TALK",
            "narrator": "アーヤ",
            "text": "太るのも問題だけど、\n痩せ過ぎも毒よ？",
            "zh": "长胖固然不好，\n太瘦也是对身体有害的哦？",
            "narrator_zh": "绫水"
        },
        {
            "location": "176/TALK",
            "narrator": "アーヤ",
            "text": "ケガだってしやすく\nなるんだから。\nわかってるの？",
            "zh": "而且也会更容易\n受伤的。\n你明白吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "177/TALK",
            "narrator": "ガブリエラ",
            "text": "うっ…、\nあ、アーヤの…。",
            "zh": "唔……，\n绫、绫水你……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "179/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤの、バカー！！",
            "zh": "绫水你这个、大笨蛋——！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "195/TALK",
            "narrator": "アーヤ",
            "text": "…？\n何怒ってるのかしら？",
            "zh": "……？\n她怎么生气了？",
            "narrator_zh": "绫水"
        },
        {
            "location": "196/TALK",
            "narrator": "アーヤ",
            "text": "まあ、いっか…。\nもうひと眠りしよ。\nふぁ～…。",
            "zh": "算了，随便吧……。\n再睡一会儿好了。\n呼啊～……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "197/ACT",
            "narrator": "",
            "text": "イタズラしちゃえ",
            "zh": "恶作剧一下吧",
            "narrator_zh": ""
        },
        {
            "location": "206/TALK",
            "narrator": "ガブリエラ",
            "text": "それ、面白そうね",
            "zh": "这主意听起来挺有趣嘛",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "207/TALK",
            "narrator": "ガブリエラ",
            "text": "$handle$がしてくれればだけど",
            "zh": "不过得由$handle$来替我做才行",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "208/TALK",
            "narrator": "ガブリエラ",
            "text": "考えなくてもわかるでしょ？",
            "zh": "不用想也知道吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "209/TALK",
            "narrator": "ガブリエラ",
            "text": "そんなことしたら",
            "zh": "要是真那样做",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "210/TALK",
            "narrator": "ガブリエラ",
            "text": "後で絶対怒られちゃうわ",
            "zh": "事后绝对会被骂惨的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "211/TALK",
            "narrator": "ガブリエラ",
            "text": "私は嫌よ",
            "zh": "我才不要呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "214/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤって、冗談が\nわからないしね。",
            "zh": "毕竟绫水她，\n又开不起玩笑。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "216/TALK",
            "narrator": "アーヤ",
            "text": "んぅー…すー…。",
            "zh": "嗯唔……嘶……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "218/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "219/TALK",
            "narrator": "ガブリエラ",
            "text": "それにしても、\nやっぱアーヤの髪って\nサラサラよね…。",
            "zh": "话说回来，\n绫水的头发果然\n好柔顺啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "220/TALK",
            "narrator": "ガブリエラ",
            "text": "…髪くらいなら、\n触っても起きない\nかな？",
            "zh": "……只是摸摸头发的话，\n她应该不会\n醒过来吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "221/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "222/TALK",
            "narrator": "ガブリエラ",
            "text": "わぁ…、なんか、\n指が気持ちいい…。",
            "zh": "哇……，总觉得，\n手指好舒服……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "223/TALK",
            "narrator": "ガブリエラ",
            "text": "うちで一番の肉体派の\nくせに、女子力まで\n高いなんて――",
            "zh": "明明是咱们当中\n最硬派的武斗派，\n女子力却这么高——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "225/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょっとズルいわ。\nチートも程々に\nしなさいよ…。",
            "zh": "这也太犯规了。\n开挂也要有个\n限度啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "226/TALK",
            "narrator": "アーヤ",
            "text": "くー…んっ…。",
            "zh": "呼……嗯……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "227/TALK",
            "narrator": "ガブリエラ",
            "text": "ぷっ…新発見。\nアーヤのほっぺは\nぷーにぷにー…。",
            "zh": "噗……新发现。\n绫水的脸蛋\n软乎乎的呢……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "230/TALK",
            "narrator": "アーヤ",
            "text": "んっ、んん～っ…。",
            "zh": "嗯，嗯嗯～……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "231/TALK",
            "narrator": "ガブリエラ",
            "text": "やばっ！\n起きちゃった！？",
            "zh": "糟糕！\n要醒过来了吗！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "233/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "234/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "236/TALK",
            "narrator": "アーヤ",
            "text": "くー…。",
            "zh": "呼……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "237/TALK",
            "narrator": "ガブリエラ",
            "text": "ほっ…よかった…。",
            "zh": "呼……太好了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "238/TALK",
            "narrator": "ガブリエラ",
            "text": "…それにしても、\nこういう無防備な\nアーヤも――",
            "zh": "……不过话说回来，\n这样毫无防备的\n绫水——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "240/TALK",
            "narrator": "ガブリエラ",
            "text": "結構カワイイかも。\nふふっ…。",
            "zh": "说不定还挺可爱的。\n呵呵……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "241/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、こんなに\n触られてるのに\n起きないなんて――",
            "zh": "话虽如此，\n被人摸成这样\n竟然还不醒——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "242/TALK",
            "narrator": "ガブリエラ",
            "text": "剣士失格よ。\n気配くらい読めなくて\nどうするのよ？",
            "zh": "简直是剑士失格。\n连这点气息都察觉不到，\n这可怎么行啊？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "246/TALK",
            "narrator": "アーヤ",
            "text": "…気配読むとか、\n普通に無理だから。",
            "zh": "……察觉气息什么的，\n正常来说根本办不到好吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "247/TALK",
            "narrator": "ガブリエラ",
            "text": "きゃぁっ！？",
            "zh": "呀啊！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "250/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょ、何！？\n起きてたの！？",
            "zh": "等、什么！？\n你醒着的吗！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "253/TALK",
            "narrator": "アーヤ",
            "text": "あれだけ遊ばれれば\n誰だって起きるわよ。",
            "zh": "被人那么折腾，\n换作谁都会醒的好吗。",
            "narrator_zh": "绫水"
        },
        {
            "location": "254/TALK",
            "narrator": "アーヤ",
            "text": "すぐにやめると\n思って寝たふり\nしてたけど――",
            "zh": "本来以为你\n很快就会停手\n才装睡的——",
            "narrator_zh": "绫水"
        },
        {
            "location": "255/TALK",
            "narrator": "アーヤ",
            "text": "全然やめようと\nしないんだから…。",
            "zh": "结果你根本就没有\n要停下来的意思……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "256/TALK",
            "narrator": "ガブリエラ",
            "text": "そ、それならさっさと\n起きなさいよ！",
            "zh": "既、既然这样，那你\n就早点醒过来啊！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "257/TALK",
            "narrator": "ガブリエラ",
            "text": "気付かないで遊んでた\nあたしがバカみたい\nじゃない…。",
            "zh": "害得完全没察觉而玩得\n起劲的我像个笨蛋\n一样嘛……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "258/TALK",
            "narrator": "アーヤ",
            "text": "うーん、そう思ったん\nだけどね――",
            "zh": "嗯，我原本也是这么\n打算的啦——",
            "narrator_zh": "绫水"
        },
        {
            "location": "260/TALK",
            "narrator": "アーヤ",
            "text": "珍しくギャヴィが、\nカワイイ、とか言って\n褒めてくれたでしょ？",
            "zh": "可难得听见加维你\n夸我可爱之类的\n好听话，对吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "261/TALK",
            "narrator": "ガブリエラ",
            "text": "っ！？",
            "zh": "唔！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "262/TALK",
            "narrator": "アーヤ",
            "text": "眠ってればもう少し\n褒めてもらえるかな、\nって思ったのよ。",
            "zh": "我就想着，要是再装睡一会儿\n说不定还能多听你\n夸几句呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "264/TALK",
            "narrator": "ガブリエラ",
            "text": "なっ！？\nうっ、うぅぅ…。",
            "zh": "什！？\n唔、唔唔唔……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "265/TALK",
            "narrator": "ガブリエラ",
            "text": "ぬ、盗み聞きとか\n信じらんない！",
            "zh": "偷、偷听什么的\n简直难以置信！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "266/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤのバカ！\nエッチ、スケベー！！",
            "zh": "绫水大笨蛋！\n变态、大色狼！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "275/TALK",
            "narrator": "アーヤ",
            "text": "…寝てる人に好き放題\nした人のセリフ？",
            "zh": "……这话是把睡着的人\n摆弄个够的人该说的吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "278/TALK",
            "narrator": "アーヤ",
            "text": "…まあ、いっか。\nもうひと眠りしよ…。",
            "zh": "……算了，随它去吧。\n再睡一会儿好了……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "15/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>7月9日　5:11 PM</color>\nとある休日の午後、寮「とらいあんぐる」アーヤの部屋前。",
            "zh": "<color=green>7月9日　5:11 PM</color>\n某个假日的午后，宿舍“三角”绫水的房间门前。",
            "narrator_zh": "Dialog_EventData"
        }
    ]
}
