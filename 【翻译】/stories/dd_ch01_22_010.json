{
    "dir": "chap22/daydra/dd_ch01_22_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "22152",
        "cid": "tsubame",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "不機嫌の理由",
        "title_zh": "Extra002 额外剧情",
        "sub_title_zh": "不高兴的理由"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "不機嫌の理由",
            "zh": "不高兴的理由",
            "narrator_zh": ""
        },
        {
            "location": "18/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "20/TALK",
            "narrator": "つばめ",
            "text": "ガブちゃん、なんだか\n凄く機嫌が悪そう。",
            "zh": "加布，看起来\n心情很差。",
            "narrator_zh": "燕"
        },
        {
            "location": "21/TALK",
            "narrator": "つばめ",
            "text": "やっぱり、あの事が\n原因なのかな？",
            "zh": "果然，是那件事\n的原因吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "33/TALK",
            "narrator": "つばめ",
            "text": "ちょっと、ガブちゃんのことで相談があるの",
            "zh": "有点事，想商量一下加布的事",
            "narrator_zh": "燕"
        },
        {
            "location": "35/SEL",
            "narrator": "",
            "text": "何かあったの？",
            "zh": "发生什么了？",
            "narrator_zh": ""
        },
        {
            "location": "36/ACT",
            "narrator": "",
            "text": "何かあったの？",
            "zh": "发生什么了？",
            "narrator_zh": ""
        },
        {
            "location": "38/TALK",
            "narrator": "つばめ",
            "text": "ガブちゃん、少し前から急に機嫌が悪くなっちゃったの",
            "zh": "加布从刚才起，突然心情变差了",
            "narrator_zh": "燕"
        },
        {
            "location": "39/TALK",
            "narrator": "つばめ",
            "text": "多分、原因はスイカじゃないかな？",
            "zh": "原因大概是西瓜吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "41/SEL",
            "narrator": "",
            "text": "順番に説明して",
            "zh": "按顺序说明",
            "narrator_zh": ""
        },
        {
            "location": "42/ACT",
            "narrator": "",
            "text": "順番に説明して",
            "zh": "按顺序说明",
            "narrator_zh": ""
        },
        {
            "location": "44/TALK",
            "narrator": "つばめ",
            "text": "えっと、みやびさんのお母さんにね、丸いスイカをもらったの",
            "zh": "那个呀，雅的妈妈给了我们一个圆西瓜",
            "narrator_zh": "燕"
        },
        {
            "location": "45/TALK",
            "narrator": "つばめ",
            "text": "それでね――",
            "zh": "然后呀——",
            "narrator_zh": "燕"
        },
        {
            "location": "59/TALK",
            "narrator": "ガブリエラ",
            "text": "せっかくこんなに立派な\nスイカがあるなら、\nやることは一つよね？",
            "zh": "难得有这么漂亮的\n西瓜，\n要做的事只有一件吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "61/TALK",
            "narrator": "つばめ",
            "text": "食べる以外に、\n何かあるかな？",
            "zh": "除了吃，\n还有别的吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "63/TALK",
            "narrator": "ガブリエラ",
            "text": "鈍いわね。\n砂浜にスイカとくれば、\nやることは一つ！",
            "zh": "你真迟钝。\n沙滩配上西瓜，\n要做的事只有一件！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "64/TALK",
            "narrator": "ガブリエラ",
            "text": "スイカ割り以外に\nないじゃない。",
            "zh": "除了砸西瓜\n没有别的吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "65/TALK",
            "narrator": "アーヤ",
            "text": "えっ、スイカ割り？",
            "zh": "欸，砸西瓜？",
            "narrator_zh": "绫水"
        },
        {
            "location": "67/TALK",
            "narrator": "ガブリエラ",
            "text": "そう、スイカ割り。\nやってみたいと\n思ってたのよ。",
            "zh": "对，砸西瓜。\n我一直想\n试试。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "69/TALK",
            "narrator": "神楽",
            "text": "あの…スイカ割りは\nやめた方がいいと\n思いますよ？",
            "zh": "那个……砸西瓜\n还是不要做\n比较好。",
            "narrator_zh": "神乐"
        },
        {
            "location": "70/TALK",
            "narrator": "神楽",
            "text": "あれって、割れた時に\nスイカが飛び散るから――",
            "zh": "那个啊，裂开的时候\n西瓜会溅得到处都是——",
            "narrator_zh": "神乐"
        },
        {
            "location": "71/TALK",
            "narrator": "神楽",
            "text": "ちょっとだけ見た目が\n酷いことになっちゃい\nますし…。",
            "zh": "看起来会\n变得有点\n惨……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "72/TALK",
            "narrator": "ガブリエラ",
            "text": "そうなの？",
            "zh": "是这样吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "74/TALK",
            "narrator": "アーヤ",
            "text": "包丁で切るのと違って、\n棒が当たった箇所が――",
            "zh": "和用刀切不一样，\n棒子打到的地方——",
            "narrator_zh": "绫水"
        },
        {
            "location": "75/TALK",
            "narrator": "アーヤ",
            "text": "潰れた感じになるから、\n仕方なくはあるん\nだけどね。",
            "zh": "会变成砸烂的样子，\n这也是\n没办法。",
            "narrator_zh": "绫水"
        },
        {
            "location": "76/TALK",
            "narrator": "ガブリエラ",
            "text": "…そう。",
            "zh": "……这样。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "77/TALK",
            "narrator": "ガブリエラ",
            "text": "まあ、そういうことなら\n仕方ないわね。",
            "zh": "嘛，那样的话\n也没办法。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "78/TALK",
            "narrator": "つばめ",
            "text": "あれ？　ガブちゃん、\nちょっと声に元気ない…。",
            "zh": "咦？加布，\n声音有点没精神……。",
            "narrator_zh": "燕"
        },
        {
            "location": "79/TALK",
            "narrator": "つばめ",
            "text": "…もしかして、\nスイカ割りしたかったの\nかな？",
            "zh": "……难道，\n你很想砸西瓜\n吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "81/TALK",
            "narrator": "つばめ",
            "text": "…あの、すみません。\nわたしも、スイカ割り\nしてみたいです！",
            "zh": "……那个，不好意思。\n我也想\n试试砸西瓜！",
            "narrator_zh": "燕"
        },
        {
            "location": "82/TALK",
            "narrator": "ガブリエラ",
            "text": "えっ？",
            "zh": "欸？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "84/TALK",
            "narrator": "つばめ",
            "text": "砂浜にスイカとくれば\nスイカ割りしかない――",
            "zh": "沙滩配上西瓜\n就只有砸西瓜——",
            "narrator_zh": "燕"
        },
        {
            "location": "86/TALK",
            "narrator": "つばめ",
            "text": "って、ガブちゃん\nさっき言ってたでしょ？",
            "zh": "加布刚才\n是这么说的吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "87/TALK",
            "narrator": "つばめ",
            "text": "それ聞いてたら、\nわたしもやってみたく\nなっちゃったんだ。",
            "zh": "听了那个，\n我也变得\n想试试了。",
            "narrator_zh": "燕"
        },
        {
            "location": "88/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "89/TALK",
            "narrator": "アーヤ",
            "text": "…そんなにスイカ割り\nやりたいの？",
            "zh": "……就那么想\n砸西瓜吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "91/TALK",
            "narrator": "つばめ",
            "text": "はい…ダメですか？",
            "zh": "是……不行吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "93/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "95/TALK",
            "narrator": "アーヤ",
            "text": "…仕方ないわね。\n卯月、スイカ割りって\nことで良いかしら？",
            "zh": "……真没办法。\n卯月，就当是\n砸西瓜，可以吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "96/TALK",
            "narrator": "神楽",
            "text": "…そうですね。",
            "zh": "……是啊。",
            "narrator_zh": "神乐"
        },
        {
            "location": "97/TALK",
            "narrator": "神楽",
            "text": "そこまでやりたいなら、\n私もそれで構いません。",
            "zh": "既然这么想做，\n我也没关系。",
            "narrator_zh": "神乐"
        },
        {
            "location": "98/TALK",
            "narrator": "ガブリエラ",
            "text": "えっ…？",
            "zh": "欸……？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "101/TALK",
            "narrator": "つばめ",
            "text": "やった！\nありがと、神楽ちゃん、\nアーヤさん！",
            "zh": "太好了！\n谢谢，神乐，\n绫水！",
            "narrator_zh": "燕"
        },
        {
            "location": "102/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "103/TALK",
            "narrator": "つばめ",
            "text": "やったね、ガブちゃん。\nこれでスイカ割りが――",
            "zh": "太好了呀，加布。\n这样就能砸西瓜——",
            "narrator_zh": "燕"
        },
        {
            "location": "104/TALK",
            "narrator": "ガブリエラ",
            "text": "…いい。",
            "zh": "……不用了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "105/TALK",
            "narrator": "つばめ",
            "text": "え？",
            "zh": "欸？",
            "narrator_zh": "燕"
        },
        {
            "location": "106/TALK",
            "narrator": "ガブリエラ",
            "text": "やりたくない。",
            "zh": "我不想做。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "107/TALK",
            "narrator": "ガブリエラ",
            "text": "っていうか、やらないって\nことに決まってたじゃん。",
            "zh": "话说，不是已经\n决定不做了吗。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "108/TALK",
            "narrator": "つばめ",
            "text": "そ、そうだけど…。",
            "zh": "是、是这样……。",
            "narrator_zh": "燕"
        },
        {
            "location": "109/TALK",
            "narrator": "アーヤ",
            "text": "何怒ってるのよ？\nスイカ割りやるんだから、\n怒ることないでしょ？",
            "zh": "你在生什么气？\n反正要砸西瓜，\n没什么好气的吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "111/TALK",
            "narrator": "ガブリエラ",
            "text": "怒ってない！\nとにかく、あたしは\nやらないから――",
            "zh": "我没生气！\n总之，我\n不做——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "112/TALK",
            "narrator": "ガブリエラ",
            "text": "やるんだったら、\nあんた達だけで勝手に\nやればいいわ。",
            "zh": "要做的话，\n你们自己\n去做就行了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "115/TALK",
            "narrator": "つばめ",
            "text": "あ、ガブちゃん…。",
            "zh": "啊，加布……。",
            "narrator_zh": "燕"
        },
        {
            "location": "116/TALK",
            "narrator": "神楽",
            "text": "もぅ…何が気に入らないん\nですかね？",
            "zh": "真是……到底哪里\n不顺眼啊？",
            "narrator_zh": "神乐"
        },
        {
            "location": "117/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "139/TALK",
            "narrator": "つばめ",
            "text": "――ってことがあったの",
            "zh": "——就是这么回事",
            "narrator_zh": "燕"
        },
        {
            "location": "140/TALK",
            "narrator": "つばめ",
            "text": "ガブちゃん、どうして怒っちゃったのかな？",
            "zh": "加布，为什么生气了呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "141/TALK",
            "narrator": "つばめ",
            "text": "もしかして、わたし、何かしちゃったのかな？",
            "zh": "难道，我做错了什么吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "144/SEL",
            "narrator": "",
            "text": "ガブリエラの気持ちを考えて",
            "zh": "想想加布里埃拉的心情",
            "narrator_zh": ""
        },
        {
            "location": "145/SEL",
            "narrator": "",
            "text": "ワガママな奴だな！",
            "zh": "真是个任性的家伙！",
            "narrator_zh": ""
        },
        {
            "location": "146/ACT",
            "narrator": "",
            "text": "ガブリエラの気持ちを考えて",
            "zh": "想想加布里埃拉的心情",
            "narrator_zh": ""
        },
        {
            "location": "148/TALK",
            "narrator": "つばめ",
            "text": "ガブちゃんの気持ち？",
            "zh": "加布的心情？",
            "narrator_zh": "燕"
        },
        {
            "location": "149/TALK",
            "narrator": "つばめ",
            "text": "…………",
            "zh": "…………",
            "narrator_zh": "燕"
        },
        {
            "location": "150/TALK",
            "narrator": "つばめ",
            "text": "ありがと、わかった気がするよ",
            "zh": "谢谢，我好像明白了",
            "narrator_zh": "燕"
        },
        {
            "location": "151/TALK",
            "narrator": "つばめ",
            "text": "でも、なんて言えばいいのかな？",
            "zh": "可是，该怎么说才好呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "153/SEL",
            "narrator": "",
            "text": "それはつばめが考えること",
            "zh": "那是燕该想的事",
            "narrator_zh": ""
        },
        {
            "location": "154/ACT",
            "narrator": "",
            "text": "それはつばめが考えること",
            "zh": "那是燕该想的事",
            "narrator_zh": ""
        },
        {
            "location": "156/TALK",
            "narrator": "つばめ",
            "text": "そうだよね",
            "zh": "是呀",
            "narrator_zh": "燕"
        },
        {
            "location": "157/TALK",
            "narrator": "つばめ",
            "text": "頑張ってみる(>_<)",
            "zh": "我试试看(>_<)",
            "narrator_zh": "燕"
        },
        {
            "location": "168/TALK",
            "narrator": "つばめ",
            "text": "…なんでも聞くのは、\nダメだよね？",
            "zh": "……什么都来问，\n是不行的哦？",
            "narrator_zh": "燕"
        },
        {
            "location": "169/TALK",
            "narrator": "つばめ",
            "text": "わたしが自分で\n考えなくちゃ！",
            "zh": "我得自己\n想才行！",
            "narrator_zh": "燕"
        },
        {
            "location": "171/TALK",
            "narrator": "つばめ",
            "text": "…あ、あの、ガブちゃん。",
            "zh": "……那、那个，加布。",
            "narrator_zh": "燕"
        },
        {
            "location": "172/TALK",
            "narrator": "ガブリエラ",
            "text": "…何よ？",
            "zh": "……什么？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "173/TALK",
            "narrator": "つばめ",
            "text": "えっと…。",
            "zh": "那个……。",
            "narrator_zh": "燕"
        },
        {
            "location": "175/TALK",
            "narrator": "つばめ",
            "text": "…ごめんね。",
            "zh": "……对不起。",
            "narrator_zh": "燕"
        },
        {
            "location": "177/TALK",
            "narrator": "ガブリエラ",
            "text": "…は？\n意味わかんないんだけど？",
            "zh": "……哈？\n我听不懂你在说什么？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "178/TALK",
            "narrator": "つばめ",
            "text": "ご、ごめん…。\nでも、何て言えばいいのか\nわからなくて…。",
            "zh": "对、对不起……。\n可是，不知道\n该怎么说……。",
            "narrator_zh": "燕"
        },
        {
            "location": "179/TALK",
            "narrator": "つばめ",
            "text": "その…ガブちゃんが今、\n凄く嫌な気持ちになってる\n理由、わかったの。",
            "zh": "那个……加布现在\n心情变得很糟的\n理由，我明白了。",
            "narrator_zh": "燕"
        },
        {
            "location": "180/TALK",
            "narrator": "つばめ",
            "text": "…面白くないよね？",
            "zh": "……很没意思吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "181/TALK",
            "narrator": "つばめ",
            "text": "自分がやりたいって\n言ったときは拒否された\nのに――",
            "zh": "自己说想做的时候\n被拒绝了\n——",
            "narrator_zh": "燕"
        },
        {
            "location": "182/TALK",
            "narrator": "つばめ",
            "text": "他の人が賛同した途端に、\nやろう、って話になったり\nしたら…。",
            "zh": "别人一赞成，\n马上就变成\n要做了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "183/TALK",
            "narrator": "つばめ",
            "text": "ガブちゃんの立場に\nなって考えて、\nようやく気付けたの。",
            "zh": "站在加布的立场\n想了想，\n这才注意到。",
            "narrator_zh": "燕"
        },
        {
            "location": "185/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "186/TALK",
            "narrator": "つばめ",
            "text": "だから、ごめんね。",
            "zh": "所以，对不起。",
            "narrator_zh": "燕"
        },
        {
            "location": "188/TALK",
            "narrator": "ガブリエラ",
            "text": "…つばめが謝るような\nことじゃないでしょ？",
            "zh": "……这不是燕\n该道歉的事吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "189/TALK",
            "narrator": "ガブリエラ",
            "text": "っていうか、別にもう\n怒ってないし。",
            "zh": "话说，我也\n没在生气了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "191/TALK",
            "narrator": "つばめ",
            "text": "本当？",
            "zh": "真的？",
            "narrator_zh": "燕"
        },
        {
            "location": "192/TALK",
            "narrator": "ガブリエラ",
            "text": "…あたしも、ちょっと\n大人げなかったわ。",
            "zh": "……我也有点\n不够大方。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "193/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "195/TALK",
            "narrator": "ガブリエラ",
            "text": "あーっ、もうやめた！",
            "zh": "啊——，不纠结了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "196/TALK",
            "narrator": "ガブリエラ",
            "text": "いつまでうじうじしてても\nつまらないし――",
            "zh": "一直别别扭扭的\n也没意思——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "197/TALK",
            "narrator": "ガブリエラ",
            "text": "おもいっきり遊んで、\n忘れるわ！",
            "zh": "痛快地玩一场，\n忘掉它！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "198/TALK",
            "narrator": "つばめ",
            "text": "よかった。\nガブちゃん、機嫌直して\nくれて。",
            "zh": "太好了。\n加布心情\n好起来了。",
            "narrator_zh": "燕"
        },
        {
            "location": "199/TALK",
            "narrator": "ガブリエラ",
            "text": "…あっ。\nそういえばあったわ。",
            "zh": "……啊。\n说起来还有一件。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "201/TALK",
            "narrator": "つばめ",
            "text": "なにが？",
            "zh": "什么？",
            "narrator_zh": "燕"
        },
        {
            "location": "202/TALK",
            "narrator": "ガブリエラ",
            "text": "あんたが謝らなくちゃ\nいけない理由よ。",
            "zh": "你该道歉的\n理由。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "203/TALK",
            "narrator": "ガブリエラ",
            "text": "ウソついたでしょ？",
            "zh": "你撒谎了吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "205/TALK",
            "narrator": "つばめ",
            "text": "えっ！？",
            "zh": "欸！？",
            "narrator_zh": "燕"
        },
        {
            "location": "207/TALK",
            "narrator": "ガブリエラ",
            "text": "スイカ割りやりたい、って\n言ってたけど――",
            "zh": "你说想砸西瓜，\n是这么说的——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "208/TALK",
            "narrator": "ガブリエラ",
            "text": "あれ、本当はあたしが\nやりたがってたから、\n賛同したんでしょ？",
            "zh": "其实是因为我想做，\n你才跟着赞成的\n吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "210/TALK",
            "narrator": "つばめ",
            "text": "あ、あはは…\nバレちゃってた？",
            "zh": "啊，啊哈哈……\n被看穿了？",
            "narrator_zh": "燕"
        },
        {
            "location": "212/TALK",
            "narrator": "ガブリエラ",
            "text": "あったりまえじゃない。\nつばめの考えてることは、\n大体わかるわよ。",
            "zh": "那不是当然的吗。\n燕在想什么，\n我大体都知道。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "213/TALK",
            "narrator": "つばめ",
            "text": "えっ？",
            "zh": "欸？",
            "narrator_zh": "燕"
        },
        {
            "location": "215/TALK",
            "narrator": "ガブリエラ",
            "text": "だって、超単純だし。",
            "zh": "因为，你简单得要命。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "216/TALK",
            "narrator": "つばめ",
            "text": "た、単純！？\nもぉー、ひどいよ\nガブちゃん！",
            "zh": "简、简单！？\n真是的，太过分了\n加布！",
            "narrator_zh": "燕"
        },
        {
            "location": "217/TALK",
            "narrator": "ガブリエラ",
            "text": "半分冗談だってば。\nほら、怒ってないで\n早く行くわよ！",
            "zh": "一半是开玩笑的啦。\n好了，别生气，\n快点走了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "218/ACT",
            "narrator": "",
            "text": "ワガママな奴だな！",
            "zh": "真是个任性的家伙！",
            "narrator_zh": ""
        },
        {
            "location": "219/TALK",
            "narrator": "つばめ",
            "text": "そ、そうなのかな？",
            "zh": "是、是这样吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "220/TALK",
            "narrator": "つばめ",
            "text": "なんだか、ただのワガママ、って感じには思えないんだけど…",
            "zh": "总觉得，不像只是任性那么简单……",
            "narrator_zh": "燕"
        },
        {
            "location": "232/TALK",
            "narrator": "つばめ",
            "text": "…う～ん、何が理由なん\nだろ？",
            "zh": "……嗯——，到底是什么\n理由呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "233/TALK",
            "narrator": "つばめ",
            "text": "でも、本当に\n突然だったし…。",
            "zh": "可是，真的是\n突然发生的……。",
            "narrator_zh": "燕"
        },
        {
            "location": "234/TALK",
            "narrator": "つばめ",
            "text": "やりたい、って自分で\n言いだしたスイカ割りを\nすることになった途端――",
            "zh": "自己说想做的\n砸西瓜，一决定\n要做的瞬间——",
            "narrator_zh": "燕"
        },
        {
            "location": "235/TALK",
            "narrator": "つばめ",
            "text": "急に機嫌が悪くなったん\nだから――",
            "zh": "心情就突然\n变差了——",
            "narrator_zh": "燕"
        },
        {
            "location": "236/TALK",
            "narrator": "つばめ",
            "text": "やっぱり、\nワガママなのかな？",
            "zh": "果然，\n是任性吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "237/TALK",
            "narrator": "つばめ",
            "text": "う～ん……。",
            "zh": "嗯——……。",
            "narrator_zh": "燕"
        },
        {
            "location": "240/TALK",
            "narrator": "アーヤ",
            "text": "みんなー！\nそろそろスイカ割り\n始めるわよー！",
            "zh": "大家——！\n差不多该开始\n砸西瓜了——！",
            "narrator_zh": "绫水"
        },
        {
            "location": "243/TALK",
            "narrator": "つばめ",
            "text": "あ、はーい！\nすぐに行きますー！",
            "zh": "啊，来了——！\n马上过去——！",
            "narrator_zh": "燕"
        },
        {
            "location": "245/TALK",
            "narrator": "つばめ",
            "text": "ガブちゃん！\nほら、スイカ割り\nやるって…。",
            "zh": "加布！\n你看，砸西瓜\n要开始了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "246/TALK",
            "narrator": "つばめ",
            "text": "…あれ？\nガブちゃん、どこ？",
            "zh": "……咦？\n加布人呢？",
            "narrator_zh": "燕"
        },
        {
            "location": "247/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "249/TALK",
            "narrator": "つばめ",
            "text": "はぁ…帰っちゃったの\nかな？",
            "zh": "哈啊……回去了\n吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "17/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>8月26日　 2:16 PM</color>\n合宿中、みやびの実家付近の砂浜でのこと",
            "zh": "<color=green>8月26日　 2:16 PM</color>\n合宿期间，雅的老家附近的沙滩上",
            "narrator_zh": "Dialog_EventData"
        }
    ]
}
