        },
        {
            "location": "32/TALK",
            "narrator": "ガブリエラ",
            "text": "ねえマルザンナ",
            "zh": "我说，玛尔赞娜",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "33/TALK",
            "narrator": "ガブリエラ",
            "text": "私、図書館でのことが頭から離れないわ",
            "zh": "图书馆那件事在我脑海里挥之不去",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "34/TALK",
            "narrator": "ガブリエラ",
            "text": "まさかあんな日本のアニメみたいなことが現実にあるなんて",
            "zh": "没想到日本动画里那种桥段居然会在现实中上演",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "35/TALK",
            "narrator": "ガブリエラ",
            "text": "やっぱり日本ってすごいわね",
            "zh": "日本果然了不起呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "37/SEL",
            "narrator": "",
            "text": "いや、滅多にいないよ？",
            "zh": "不，那种事很少见的哦？",
            "narrator_zh": ""
        },
        {
            "location": "38/SEL",
            "narrator": "",
            "text": "ガブリエラもいつかしよう",
            "zh": "加布里埃拉哪天也来一次嘛",
            "narrator_zh": ""
        },
        {
            "location": "39/SEL",
            "narrator": "",
            "text": "どんなアニメ見てるの？",
            "zh": "你都看什么动画呀？",
            "narrator_zh": ""
        },
        {
            "location": "40/ACT",
            "narrator": "",
            "text": "いや、滅多にいないよ？",
            "zh": "不，那种事很少见的哦？",
            "narrator_zh": ""
        },
        {
            "location": "41/TALK",
            "narrator": "ガブリエラ",
            "text": "そうなの？",
            "zh": "是这样吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "42/TALK",
            "narrator": "ガブリエラ",
            "text": "そうなのね",
            "zh": "这样呀",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "43/TALK",
            "narrator": "ガブリエラ",
            "text": "じゃあ貴重なものを見たのね",
            "zh": "那我算是见到了稀有场面呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "44/TALK",
            "narrator": "ガブリエラ",
            "text": "その割にはつばめたちは反応が薄かったけど",
            "zh": "可燕她们反应却很平淡",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "45/TALK",
            "narrator": "ガブリエラ",
            "text": "それが奥ゆかしさってやつなのかしら",
            "zh": "这就是所谓的谦逊吗",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "46/ACT",
            "narrator": "",
            "text": "ガブリエラもいつかしよう",
            "zh": "加布里埃拉哪天也来一次嘛",
            "narrator_zh": ""
        },
        {
            "location": "47/TALK",
            "narrator": "ガブリエラ",
            "text": "無理よ！？！？！？！",
            "zh": "做不到的啦！？！？！？！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "49/TALK",
            "narrator": "ガブリエラ",
            "text": "ああいうのは恥ずかしすぎるわ？？？",
            "zh": "那种事实在太难为情了？？？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "52/TALK",
            "narrator": "ガブリエラ",
            "text": "それに男の人とか苦手だし",
            "zh": "而且我又不擅长应付男生",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "53/TALK",
            "narrator": "ガブリエラ",
            "text": "見るだけでいいわ",
            "zh": "看看就行了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "54/ACT",
            "narrator": "",
            "text": "どんなアニメ見てるの？",
            "zh": "你都看什么动画呀？",
            "narrator_zh": ""
        },
        {
            "location": "56/TALK",
            "narrator": "ガブリエラ",
            "text": "学園ものとかが多いかしら♪",
            "zh": "校园题材之类看得比较多♪",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "58/TALK",
            "narrator": "ガブリエラ",
            "text": "少女漫画が原作のとかね",
            "zh": "少女漫画原作改编的哦",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "59/TALK",
            "narrator": "ガブリエラ",
            "text": "コメディも切ない系もどっちも好きよ",
            "zh": "喜剧系和揪心系我都很喜欢哦",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "60/TALK",
            "narrator": "ガブリエラ",
            "text": "あ",
            "zh": "啊",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "61/TALK",
            "narrator": "ガブリエラ",
            "text": "純粋にアニメとして楽しんでるだけよ",
            "zh": "我只是单纯当动画欣赏而已哦",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "62/TALK",
            "narrator": "ガブリエラ",
            "text": "私が男の子が苦手なのは関係ないから",
            "zh": "和我怕男生这件事没关系啦",
            "narrator_zh": "加布里埃拉"
        }
    ]
