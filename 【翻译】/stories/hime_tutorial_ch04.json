            "narrator_zh": "雅"
        },
        {
            "location": "426/TALK",
            "narrator": "みやび",
            "text": "それに昼ドラには",
            "zh": "而且午间剧里",
            "narrator_zh": "雅"
        },
        {
            "location": "427/TALK",
            "narrator": "みやび",
            "text": "女子高生は滅多に出ん",
            "zh": "女高中生也很少出场",
            "narrator_zh": "雅"
        },
        {
            "location": "428/ACT",
            "narrator": "",
            "text": "ハリウッド映画でしょ！",
            "zh": "是好莱坞电影吧！",
            "narrator_zh": ""
        },
        {
            "location": "429/TALK",
            "narrator": "みやび",
            "text": "全米が色々するアレか",
            "zh": "全美国会怎样怎样的那种吧",
            "narrator_zh": "雅"
        },
        {
            "location": "430/TALK",
            "narrator": "みやび",
            "text": "レッドカーペットを踏む日も近いの",
            "zh": "踏上红毯的日子也不远了",
            "narrator_zh": "雅"
        },
        {
            "location": "431/TALK",
            "narrator": "みやび",
            "text": "セレブリティとして",
            "zh": "以名流的身份",
            "narrator_zh": "雅"
        },
        {
            "location": "432/ACT",
            "narrator": "",
            "text": "日常に忍び寄る狂気",
            "zh": "渗进日常的疯狂",
            "narrator_zh": ""
        },
        {
            "location": "433/TALK",
            "narrator": "みやび",
            "text": "確かにサスペンス",
            "zh": "确实算悬疑",
            "narrator_zh": "雅"
        },
        {
            "location": "439/TALK",
            "narrator": "みやび",
            "text": "そしてうちの危機の際",
            "zh": "然后，我遇到危机的时候",
            "narrator_zh": "雅"
        },
        {
            "location": "440/TALK",
            "narrator": "みやび",
            "text": "$handle$と背中合わせて",
            "zh": "和$handle$背靠背",
            "narrator_zh": "雅"
        },
        {
            "location": "442/TALK",
            "narrator": "みやび",
            "text": "共闘するという熱き展開",
            "zh": "来一段并肩作战的热血展开",
            "narrator_zh": "雅"
        },
        {
            "location": "444/TALK",
            "narrator": "みやび",
            "text": "そうなる前に",
            "zh": "在那之前",
            "narrator_zh": "雅"
        },
        {
            "location": "445/TALK",
            "narrator": "みやび",
            "text": "うちの危機に気づけ",
            "zh": "先察觉我碰上危机",
            "narrator_zh": "雅"
        },
        {
            "location": "446/TALK",
            "narrator": "みやび",
            "text": "$handle$め",
            "zh": "$handle$这家伙",
            "narrator_zh": "雅"
        },
        {
            "location": "448/SEL",
            "narrator": "",
            "text": "がんばる",
            "zh": "我会加油",
            "narrator_zh": ""
        },
        {
            "location": "449/SEL",
            "narrator": "",
            "text": "気づかないわけがない",
            "zh": "不可能发现不了",
            "narrator_zh": ""
        },
        {
            "location": "450/ACT",
            "narrator": "",
            "text": "がんばる",
            "zh": "我会加油",
            "narrator_zh": ""
        },
        {
            "location": "451/TALK",
            "narrator": "みやび",
            "text": "よしよし",
            "zh": "好，好",
            "narrator_zh": "雅"
        },
        {
            "location": "452/ACT",
            "narrator": "",
            "text": "気づかないわけがない",
            "zh": "不可能发现不了",
            "narrator_zh": ""
        },
        {
            "location": "453/TALK",
            "narrator": "みやび",
            "text": "当然だの",
            "zh": "那当然咯",
            "narrator_zh": "雅"
        },
        {
            "location": "455/TALK",
            "narrator": "みやび",
            "text": "$handle$はうちのものだからな",
            "zh": "因为$handle$是我的",
            "narrator_zh": "雅"
        },
        {
            "location": "395/DIALOG",
            "narrator": "Tutorial/Dialog_Tutorial_Candy",
            "text": "彼女たちとの会話では\n<color=red>【ココロキャンディ】</color>という\nものを消費して先へ進む。\n\n足りない場合、ジュエルで買うか、\nバトル等で貯めてからストーリーを\n再挑戦することになるから注意。\n\n<color=green>今回だけは使っても減らないから、\n好きな選択肢を選んでみて。</color>",
            "zh": "和她们聊天时，\n会消耗<color=red>【心之糖果】</color>，\n才能继续往下。\n\n不够的话，就用珠宝买，\n或者靠战斗之类攒够，\n再重打这段剧情。注意。\n\n<color=green>只有这一次，用了也不会减少，\n挑你想选的就行。</color>",
            "narrator_zh": "Tutorial/Dialog_Tutorial_Candy"
        },
        {
            "location": "415/DIALOG",
            "narrator": "Tutorial/Dialog_Tutorial_Love2",
            "text": "<color=red>【親密度】</color>を沢山貯めると\n彼女との関係性が変化していく。\n\n<color=green>【友達】</color>になり<color=orange>【恋人】</color>になり…\n更にその先まで発展するかも。\n頑張ってハートを集めて欲しい。\n\n集めたハートは<color=red>【PROFILE】</color>で\n確認できるわ。",
            "zh": "<color=red>【亲密度】</color>攒得多了，\n和她的关系就会变化。\n\n会变成<color=green>【朋友】</color>，再变成<color=orange>【恋人】</color>……\n也许还能再往前走。\n好好把爱心攒起来吧。\n\n攒下的爱心，在<color=red>【PROFILE】</color>\n里就能看到。",
            "narrator_zh": "Tutorial/Dialog_Tutorial_Love2"
        },
        {
            "location": "437/DIALOG",
            "narrator": "Tutorial/Dialog_Tutorial_Camera",
            "text": "そうそう、ひとつお得情報。\n<color=red>カメラボタンを押すことで、\n彼女を見守る視点を変えられる。</color>\n\n今回はお試しでカメラを５つ\n用意しておいた。\n実際には<color=green>ゴキゲンポイント</color>で\n交換して増やしていくことに\nなるから、今のうちにいっぱい\n堪能しておくといいと思う。",
            "zh": "对了，告诉你一件有用的。\n<color=red>按下相机按钮，\n就能换一个看着她的视角。</color>\n\n这次试用，准备了5个\n相机。\n实际上要用<color=green>心情点数</color>\n来兑换，再慢慢增加。\n所以趁现在，\n多看个够就好。",
            "narrator_zh": "Tutorial/Dialog_Tutorial_Camera"
        }
    ]
