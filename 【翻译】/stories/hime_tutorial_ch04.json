        },
        {
            "location": "404/TALK",
            "narrator": "みやび",
            "text": "ぎりぎりだがの",
            "zh": "擦着边咯",
            "narrator_zh": "雅"
        },
        {
            "location": "405/ACT",
            "narrator": "",
            "text": "日々がサスペンスに満ちてるよね",
            "zh": "每天都满是悬疑吧",
            "narrator_zh": ""
        },
        {
            "location": "417/TALK",
            "narrator": "みやび",
            "text": "左様",
            "zh": "正是",
            "narrator_zh": "雅"
        },
        {
            "location": "418/TALK",
            "narrator": "みやび",
            "text": "しかし",
            "zh": "可是",
            "narrator_zh": "雅"
        },
        {
            "location": "419/TALK",
            "narrator": "みやび",
            "text": "具体的には？",
            "zh": "具体是什么样？",
            "narrator_zh": "雅"
        },
        {
            "location": "421/SEL",
            "narrator": "",
            "text": "昼ドラっぽい？",
            "zh": "像午间剧？",
            "narrator_zh": ""
        },
        {
            "location": "422/SEL",
            "narrator": "",
            "text": "ハリウッド映画でしょ！",
