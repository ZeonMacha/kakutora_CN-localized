        },
        {
            "location": "204/TALK",
            "narrator": "ガブリエラ",
            "text": "貴方と一緒に見られたらいいわねって",
            "zh": "要是能跟你一起看就好了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "205/TALK",
            "narrator": "ガブリエラ",
            "text": "そう思ったの",
            "zh": "我是这么想的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "207/SEL",
            "narrator": "",
            "text": "無理だね",
            "zh": "不可能吧",
            "narrator_zh": ""
        },
        {
            "location": "208/SEL",
            "narrator": "",
            "text": "今見てるよ",
