        },
        {
            "location": "193/TALK",
            "narrator": "ガブリエラ",
            "text": "夕暮れの空にふわふわした雲が出ていたのよ",
            "zh": "傍晚的天空上飘着软绵绵的云哦",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "194/TALK",
            "narrator": "ガブリエラ",
            "text": "まだ青い空に薄いピンクになった雲がかかっていたの",
            "zh": "还泛蓝的天空中，挂着染上淡粉色的云",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "195/TALK",
            "narrator": "ガブリエラ",
            "text": "私、思わず立ち止まって空を眺めたの",
            "zh": "我忍不住停下脚步望着天空",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "196/TALK",
            "narrator": "ガブリエラ",
            "text": "それからね",
            "zh": "还有哦",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "198/SEL",
            "narrator": "",
            "text": "どうしたの",
            "zh": "怎么了",
            "narrator_zh": ""
        },
        {
            "location": "199/SEL",
            "narrator": "",
            "text": "何かあったの",
            "zh": "出什么事了",
            "narrator_zh": ""
        },
        {
            "location": "200/ACT",
