        },
        {
            "location": "186/SEL",
            "narrator": "",
            "text": "そうかな",
            "zh": "是吗",
            "narrator_zh": ""
        },
        {
            "location": "187/SEL",
            "narrator": "",
            "text": "詳しく聞かせて",
            "zh": "详细说来听听",
            "narrator_zh": ""
        },
        {
            "location": "188/SEL",
            "narrator": "",
            "text": "どうだろう",
            "zh": "怎么说呢",
            "narrator_zh": ""
        },
        {
            "location": "189/ACT",
            "narrator": "",
            "text": "そうかな",
