            "text": "どうしたの",
            "zh": "怎么了",
            "narrator_zh": ""
        },
        {
            "location": "201/ACT",
            "narrator": "",
            "text": "何かあったの",
            "zh": "出什么事了",
            "narrator_zh": ""
