    "entry": [
        {
            "location": "350/SCENARIO",
            "narrator": "",
            "text": "じっちゃんはおらんけんど",
            "zh": "虽然爷爷不在就是咯",
            "narrator_zh": ""
        },
        {
            "location": "376/TALK",
            "narrator": "みやび",
            "text": "…いや。\nもしかして…。",
            "zh": "……不对。\n莫非……。",
            "narrator_zh": "雅"
        },
        {
            "location": "382/TALK",
            "narrator": "みやび",
            "text": "…………ふむ。",
            "zh": "…………唔。",
            "narrator_zh": "雅"
        },
        {
            "location": "384/TALK",
            "narrator": "みやび",
            "text": "アーヤに\nひとつ聞きたい。",
            "zh": "想问绫水\n一件事。",
            "narrator_zh": "雅"
        },
        {
            "location": "385/TALK",
            "narrator": "みやび",
            "text": "エリカさんは\n悪ふざけをするタイプの\n人間かどうか。",
            "zh": "领火是不是那种\n会恶作剧的\n人。",
            "narrator_zh": "雅"
        },
        {
            "location": "387/TALK",
            "narrator": "アーヤ",
            "text": "悪ふざけと\nいうか……。",
            "zh": "要说恶作剧\n嘛……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "388/TALK",
            "narrator": "アーヤ",
            "text": "本人はいつも\n真剣なの。",
            "zh": "她本人一直都是\n认真的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "390/TALK",
            "narrator": "アーヤ",
            "text": "それが突拍子もない\n内容だったり\nするものだから。",
            "zh": "只是内容时常\n天马行空，\n才显得那样。",
            "narrator_zh": "绫水"
        },
        {
            "location": "391/TALK",
            "narrator": "アーヤ",
            "text": "まわりにはふざけてる\nように見えたりするの。\nそういう人よ。",
            "zh": "在旁人眼里\n就显得像在胡闹。\n就是这种人哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "392/TALK",
            "narrator": "ガブリエラ",
            "text": "一言でまとめると\n変人ってことかしら？",
            "zh": "一句话总结，\n就是怪人吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "393/TALK",
            "narrator": "みやび",
            "text": "なるほど。",
            "zh": "原来如此。",
            "narrator_zh": "雅"
        },
        {
            "location": "395/TALK",
            "narrator": "みやび",
            "text": "やったらこれも\n本気で用意した\nちうことやね。",
            "zh": "那这个也是\n她认真准备的\n意思咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "397/TALK",
            "narrator": "アーヤ",
            "text": "何を？",
            "zh": "什么东西？",
            "narrator_zh": "绫水"
        },
        {
            "location": "399/TALK",
            "narrator": "みやび",
            "text": "うちのスマホで\n試してみてから\n教える。",
            "zh": "我在自己手机上\n试过之后\n再告诉你。",
            "narrator_zh": "雅"
        },
        {
            "location": "403/TALK",
            "narrator": "みやび",
            "text": "ＰＣに直接スマホを\nつないで、と…。",
            "zh": "把手机直接连到\nＰＣ上，然后……。",
            "narrator_zh": "雅"
        },
        {
            "location": "404/TALK",
            "narrator": "みやび",
            "text": "コピーもインストールも\n正常終了。",
            "zh": "复制和安装都\n正常完成。",
            "narrator_zh": "雅"
        },
        {
            "location": "406/TALK",
            "narrator": "みやび",
            "text": "あとはアプリを\n立ち上げて…\n設定完了ぞね。",
            "zh": "然后就启动\n应用……\n设置完成啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "412/TALK",
            "narrator": "みやび",
            "text": "$handle$よ",
            "zh": "$handle$哟",
            "narrator_zh": "雅"
        },
        {
            "location": "413/TALK",
            "narrator": "みやび",
            "text": "今一度チャンスを与える",
            "zh": "再给你一次机会",
            "narrator_zh": "雅"
        },
        {
            "location": "414/TALK",
            "narrator": "みやび",
            "text": "真面目な話をしてみせろ",
