        "title": "スペシャルエピソード",
        "sub_title": "春眠暁を覚えず",
        "title_zh": "特别篇",
        "sub_title_zh": "春眠不觉晓"
    },
    "entry": [
        {
            "location": "28/TALK",
            "narrator": "透明みやび",
            "text": "ん～、あと五十分…。",
            "zh": "唔～，再睡五十分钟……",
            "narrator_zh": "透明雅"
        },
        {
            "location": "30/TALK",
            "narrator": "透明みやび",
            "text": "くぅ～…。",
            "zh": "呼～……",
            "narrator_zh": "透明雅"
        },
        {
            "location": "38/TALK",
            "narrator": "透明みやび",
            "text": "ん～、あと地球の\n自転五回分…。",
            "zh": "唔～，再等地球\n自转五圈……",
            "narrator_zh": "透明雅"
        },
        {
            "location": "40/TALK",
            "narrator": "透明みやび",
            "text": "くぅ～…。",
            "zh": "呼～……",
            "narrator_zh": "透明雅"
        },
        {
            "location": "41/SEL",
            "narrator": "（選択肢）",
            "text": "みやび、起きなきゃダメだよ",
            "zh": "雅，不起来不行哦",
            "narrator_zh": "（选项）"
        },
        {
            "location": "42/ACT",
            "narrator": "",
            "text": "みやび、起きなきゃダメだよ",
            "zh": "雅，不起来不行哦",
            "narrator_zh": ""
        },
        {
            "location": "44/TALK",
            "narrator": "透明みやび",
            "text": "ん～…、なんやもぅ…。",
            "zh": "唔……，做驷马嘛……",
            "narrator_zh": "透明雅"
        },
        {
            "location": "48/TALK",
            "narrator": "透明みやび",
            "text": "ふぁ～…。\nまた朝が来てしもうた\nかぁ…。",
            "zh": "哈啊～……\n又到早上了\n咩……",
            "narrator_zh": "透明雅"
        },
        {
            "location": "52/TALK",
            "narrator": "みやび",
            "text": "なのか？",
            "zh": "……是咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "53/SEL",
            "narrator": "（選択肢）",
            "text": "え？",
            "zh": "诶？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "54/ACT",
            "narrator": "",
            "text": "え？",
            "zh": "诶？",
            "narrator_zh": ""
        },
        {
            "location": "56/TALK",
            "narrator": "みやび",
            "text": "↑なにか？",
            "zh": "↑上面那句是驷马？",
            "narrator_zh": "雅"
        },
        {
            "location": "58/TALK",
            "narrator": "みやび",
            "text": "寝起きで目が阿寒",
            "zh": "刚睡醒眼晴针不开",
            "narrator_zh": "雅"
        },
        {
            "location": "59/TALK",
            "narrator": "みやび",
            "text": "画面が欲見得ん",
            "zh": "屏幕也堪布清",
            "narrator_zh": "雅"
        },
        {
            "location": "60/SEL",
            "narrator": "（選択肢）",
            "text": "変換間違えまくりだよ",
            "zh": "输入法全选错字了呀",
            "narrator_zh": "（选项）"
        },
        {
            "location": "61/SEL",
            "narrator": "（選択肢）",
            "text": "身体伸ばして目を覚まして",
            "zh": "伸展一下身体清醒清醒",
            "narrator_zh": "（选项）"
        },
        {
            "location": "62/ACT",
            "narrator": "",
            "text": "変換間違えまくりだよ",
            "zh": "输入法全选错字了呀",
            "narrator_zh": ""
        },
        {
            "location": "63/TALK",
            "narrator": "みやび",
            "text": "あ？",
            "zh": "啊？",
            "narrator_zh": "雅"
        },
        {
            "location": "64/TALK",
            "narrator": "みやび",
            "text": "間違え？",
            "zh": "错字？",
            "narrator_zh": "雅"
        },
        {
            "location": "66/TALK",
            "narrator": "みやび",
            "text": "人は間違いを繰り返して生きていく生き物",
            "zh": "人本来就是不断犯错活下去的生物",
            "narrator_zh": "雅"
        },
        {
            "location": "67/TALK",
            "narrator": "みやび",
            "text": "寝起きと同時に人間の証明",
            "zh": "刚睡醒便证明了自己是人类",
            "narrator_zh": "雅"
        },
        {
            "location": "68/TALK",
            "narrator": "みやび",
            "text": "ここまで確実な人間はおらんな",
            "zh": "这么铁板钉钉的人类，怕是没得第二个了咯",
            "narrator_zh": "雅"
        },
        {
            "location": "69/ACT",
            "narrator": "",
            "text": "身体伸ばして目を覚まして",
            "zh": "伸展一下身体清醒清醒",
            "narrator_zh": ""
        },
        {
            "location": "72/TALK",
            "narrator": "みやび",
            "text": "首は伸びない",
            "zh": "脖子伸不长",
            "narrator_zh": "雅"
        },
        {
            "location": "73/TALK",
            "narrator": "みやび",
            "text": "人だから",
            "zh": "因为是人",
            "narrator_zh": "雅"
        },
        {
            "location": "74/TALK",
            "narrator": "みやび",
            "text": "故に悲しく",
            "zh": "因此悲伤",
            "narrator_zh": "雅"
        },
        {
            "location": "76/TALK",
            "narrator": "みやび",
            "text": "そして眠い",
            "zh": "并且好困",
            "narrator_zh": "雅"
        },
        {
            "location": "78/SEL",
            "narrator": "（選択肢）",
            "text": "大丈夫？　起きてる？",
            "zh": "没事吧？　醒着吗？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "79/ACT",
            "narrator": "",
            "text": "大丈夫？　起きてる？",
            "zh": "没事吧？　醒着吗？",
            "narrator_zh": ""
        },
        {
            "location": "81/TALK",
            "narrator": "みやび",
            "text": "身体ダルダル",
            "zh": "浑身软绵绵",
            "narrator_zh": "雅"
        },
        {
            "location": "82/TALK",
            "narrator": "みやび",
            "text": "あたまモヤモヤ",
            "zh": "脑袋昏沉沉",
            "narrator_zh": "雅"
        },
        {
            "location": "83/TALK",
            "narrator": "みやび",
            "text": "目はクラクラ",
            "zh": "眼睛晕乎乎",
            "narrator_zh": "雅"
        },
        {
            "location": "84/TALK",
            "narrator": "みやび",
            "text": "それでも起きて話してる",
            "zh": "即便如此还是爬起来聊天了",
            "narrator_zh": "雅"
        },
        {
            "location": "85/TALK",
            "narrator": "みやび",
            "text": "夜が待ち遠しい",
            "zh": "好盼望天黑啊",
            "narrator_zh": "雅"
        },
        {
            "location": "86/SEL",
            "narrator": "（選択肢）",
            "text": "夜まで頑張ろう",
            "zh": "加油撑到晚上吧",
            "narrator_zh": "（选项）"
        },
        {
            "location": "87/SEL",
            "narrator": "（選択肢）",
            "text": "シャキッとして！",
            "zh": "打起精神来！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "88/SEL",
            "narrator": "（選択肢）",
            "text": "胸元が凄いことになってる",
            "zh": "胸口那里不得了了",
            "narrator_zh": "（选项）"
        },
        {
            "location": "89/ACT",
            "narrator": "",
            "text": "夜まで頑張れる？",
            "zh": "能撑到晚上吗？",
            "narrator_zh": ""
        },
        {
            "location": "92/TALK",
            "narrator": "みやび",
            "text": "むり",
            "zh": "不行",
            "narrator_zh": "雅"
        },
        {
            "location": "94/TALK",
            "narrator": "みやび",
            "text": "よる連れてきて",
            "zh": "把晚上带过来",
            "narrator_zh": "雅"
        },
        {
            "location": "95/TALK",
            "narrator": "みやび",
            "text": "スマホで呼び出し頼む",
            "zh": "用手机帮我呼叫出来，拜托了",
            "narrator_zh": "雅"
        },
        {
            "location": "96/TALK",
            "narrator": "みやび",
            "text": "とモーニング無茶ぶりを言うてみた",
            "zh": "我试着提了个清晨无理要求",
            "narrator_zh": "雅"
        },
        {
            "location": "98/ACT",
            "narrator": "",
            "text": "シャキッとして！",
            "zh": "打起精神来！",
            "narrator_zh": ""
        },
        {
            "location": "102/TALK",
            "narrator": "みやび",
            "text": "しゃきぃん",
            "zh": "精——神——",
            "narrator_zh": "雅"
        },
        {
            "location": "103/TALK",
            "narrator": "みやび",
            "text": "したぞ",
            "zh": "打起来了",
            "narrator_zh": "雅"
        },
        {
            "location": "104/TALK",
            "narrator": "みやび",
            "text": "目覚めた",
            "zh": "醒过来了",
            "narrator_zh": "雅"
        },
        {
            "location": "105/TALK",
            "narrator": "みやび",
            "text": "気持ちだけは",
            "zh": "仅限心情",
            "narrator_zh": "雅"
        },
        {
            "location": "107/ACT",
            "narrator": "",
            "text": "胸元が凄いことになってる",
            "zh": "胸口那里不得了了",
            "narrator_zh": ""
        },
        {
            "location": "112/TALK",
            "narrator": "みやび",
            "text": "ビックリしたか？",
            "zh": "吓一跳咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "114/TALK",
            "narrator": "みやび",
            "text": "大きくて重い",
            "zh": "又大又沉",
            "narrator_zh": "雅"
        },
        {
            "location": "115/TALK",
            "narrator": "みやび",
            "text": "外せば身体が軽くなりパワーアップなバトル漫画展開",
            "zh": "摘下来身子就能变轻、战力提升的那种战斗漫画展开",
            "narrator_zh": "雅"
        },
        {
            "location": "116/TALK",
            "narrator": "みやび",
            "text": "ということにはならん無駄な重り",
            "zh": "并不会发生，纯粹是没用的负重",
            "narrator_zh": "雅"
        },
        {
            "location": "117/SEL",
            "narrator": "（選択肢）",
            "text": "そうじゃなくて見えちゃいそう",
            "zh": "不是那个意思，是快要走光了",
            "narrator_zh": "（选项）"
        },
        {
            "location": "118/ACT",
            "narrator": "",
            "text": "そうじゃなくて見えちゃいそう",
            "zh": "不是那个意思，是快要走光了",
            "narrator_zh": ""
        },
        {
            "location": "122/TALK",
            "narrator": "みやび",
            "text": "ああ",
            "zh": "啊啊",
            "narrator_zh": "雅"
        },
        {
            "location": "123/TALK",
            "narrator": "みやび",
            "text": "その発想はなかった",
            "zh": "倒没想到这一层",
            "narrator_zh": "雅"
        },
        {
            "location": "124/TALK",
            "narrator": "みやび",
            "text": "まあ",
            "zh": "嘛",
            "narrator_zh": "雅"
        },
        {
            "location": "125/TALK",
            "narrator": "みやび",
            "text": "自室だから問題なし",
            "zh": "在自己房间里，没得问题",
            "narrator_zh": "雅"
        },
        {
            "location": "126/SEL",
            "narrator": "（選択肢）",
            "text": "いや、$me$が見てるし",
            "zh": "不是，因为$me$在看着呢",
            "narrator_zh": "（选项）"
        },
        {
            "location": "127/SEL",
            "narrator": "（選択肢）",
            "text": "こっちが心配になる",
            "zh": "会替你捏把汗的",
            "narrator_zh": "（选项）"
        },
        {
            "location": "128/ACT",
            "narrator": "",
            "text": "いや、$me$が見てるし",
            "zh": "不是，因为$me$在看着呢",
            "narrator_zh": ""
        },
        {
            "location": "129/TALK",
            "narrator": "みやび",
            "text": "こういう反応を所望か？",
            "zh": "你想要的是这种反应咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "131/TALK",
            "narrator": "みやび",
            "text": "いやん",
            "zh": "讨厌啦",
            "narrator_zh": "雅"
        },
        {
            "location": "132/TALK",
            "narrator": "みやび",
            "text": "見ないで",
            "zh": "别看嘛",
            "narrator_zh": "雅"
        },
        {
            "location": "134/TALK",
            "narrator": "みやび",
            "text": "ノルマ達成でＯＫ？",
            "zh": "指标达成，ＯＫ？",
            "narrator_zh": "雅"
        },
        {
            "location": "137/ACT",
            "narrator": "",
            "text": "こっちが心配になる",
            "zh": "会替你捏把汗的",
            "narrator_zh": ""
        },
        {
            "location": "138/TALK",
            "narrator": "みやび",
            "text": "安心せよ",
            "zh": "放心吧",
            "narrator_zh": "雅"
        },
        {
            "location": "139/TALK",
            "narrator": "みやび",
            "text": "セキュリティは完璧",
            "zh": "安全防护万无一失",
            "narrator_zh": "雅"
        },
        {
            "location": "140/TALK",
            "narrator": "みやび",
            "text": "まあ",
            "zh": "嘛",
            "narrator_zh": "雅"
        },
        {
            "location": "141/TALK",
            "narrator": "みやび",
            "text": "見るのは相棒だけ",
            "zh": "能看到的只有搭档",
            "narrator_zh": "雅"
        },
        {
            "location": "142/TALK",
            "narrator": "みやび",
            "text": "うちは気にならん",
            "zh": "我倒不在意",
            "narrator_zh": "雅"
        },
        {
            "location": "143/SEL",
            "narrator": "（選択肢）",
            "text": "光栄に思うよ",
            "zh": "我深感荣幸哦",
            "narrator_zh": "（选项）"
        },
        {
            "location": "144/ACT",
            "narrator": "",
            "text": "光栄に思うよ",
            "zh": "我深感荣幸哦",
            "narrator_zh": ""
        },
        {
            "location": "146/TALK",
            "narrator": "みやび",
            "text": "特別扱いされてる思うた？",
            "zh": "你以为自己被特别对待了咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "148/TALK",
            "narrator": "みやび",
            "text": "見られてもどうも感じない",
            "zh": "就算被看也毫无感觉",
            "narrator_zh": "雅"
        },
        {
            "location": "149/TALK",
            "narrator": "みやび",
            "text": "そんな存在の可能性もあるかもしれん",
            "zh": "说不定只是那种存在而已",
            "narrator_zh": "雅"
        },
        {
            "location": "150/TALK",
            "narrator": "みやび",
            "text": "覚えておく",
            "zh": "我记住了",
            "narrator_zh": "雅"
        },
        {
            "location": "156/TALK",
            "narrator": "みやび",
            "text": "目が覚めてきたので",
            "zh": "睡意散得差不多了",
            "narrator_zh": "雅"
        },
        {
            "location": "157/TALK",
            "narrator": "みやび",
            "text": "いい加減起きようと思う",
            "zh": "差不多也该起床了",
            "narrator_zh": "雅"
        },
        {
            "location": "158/TALK",
            "narrator": "みやび",
            "text": "相棒と話したおかげやね",
            "zh": "多亏了跟搭档聊天咯",
            "narrator_zh": "雅"
        },
        {
            "location": "159/TALK",
            "narrator": "みやび",
            "text": "さらば",
            "zh": "告辞",
            "narrator_zh": "雅"
        },
        {
            "location": "165/TALK",
            "narrator": "みやび",
            "text": "とにかく起きる",
            "zh": "总之起床",
            "narrator_zh": "雅"
        },
        {
            "location": "166/TALK",
            "narrator": "みやび",
            "text": "まだ眠いが起きる",
            "zh": "虽然还困但还是起床",
            "narrator_zh": "雅"
        },
        {
            "location": "167/TALK",
            "narrator": "みやび",
            "text": "うちは起きるぞー",
            "zh": "我要起床了——",
            "narrator_zh": "雅"
        },
        {
            "location": "173/TALK",
            "narrator": "透明みやび",
            "text": "…といいつつも、\n二度寝の誘惑に\n勝てるわけもなく――",
            "zh": "……话虽如此，\n终究还是敌不过\n回笼觉的诱惑——",
            "narrator_zh": "透明雅"
        },
        {
            "location": "175/TALK",
            "narrator": "透明みやび",
            "text": "おやすみ…。",
            "zh": "晚安……",
            "narrator_zh": "透明雅"
        },
        {
            "location": "180/TALK",
            "narrator": "透明ガブリエラ",
            "text": "ちょっと、みやび。\nもう学校行く時間\nなんだけど？",
            "zh": "喂，雅。\n已经到去学校的\n时间了吧？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "184/TALK",
            "narrator": "透明ガブリエラ",
            "text": "って、何でまだ\nパジャマなのよ？",
            "zh": "我说，你怎么还\n穿着睡衣啊？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "185/TALK",
            "narrator": "透明みやび",
            "text": "ん、ガブちゃん。\nいってらっしゃい、\nおやすみなさい…。",
            "zh": "嗯，加布。\n路上小心，\n晚安……",
            "narrator_zh": "透明雅"
        },
        {
            "location": "186/TALK",
            "narrator": "透明ガブリエラ",
            "text": "おやすみなさい\nじゃない！",
            "zh": "不是\n晚安的时候吧！",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "187/TALK",
            "narrator": "透明ガブリエラ",
            "text": "ほら、さっさと\n顔洗ってきなさいよ。\nもうギリギリよ？",
            "zh": "快点，赶紧\n去洗把脸。\n时间都快赶不上了哦？",
            "narrator_zh": "透明加布里埃拉"
        },
        {
            "location": "190/TALK",
            "narrator": "透明みやび",
            "text": "…行かんとダメか？",
            "zh": "……非去不可咩？",
            "narrator_zh": "透明雅"
        },
        {
            "location": "191/TALK",
            "narrator": "透明ガブリエラ",
            "text": "サボりは不良の証よ。\nほら、いつまでも\n年頃のレディが――",
            "zh": "逃课是不良少女的作风。\n快点，这么大个\n妙龄淑女了，总不能——",
