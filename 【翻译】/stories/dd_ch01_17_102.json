{
    "dir": "chap17/daydra/dd_ch01_17_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "17105",
        "cid": "tsubame",
        "title": "005 メインストーリー",
        "sub_title": "横縞瑪瑙＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "横纹玛瑙＜后篇＞"
    },
    "entry": [
        {
            "location": "484/TALK",
            "narrator": "つばめ",
            "text": "ぅぅん",
            "zh": "嗯——",
            "narrator_zh": "燕"
        },
        {
            "location": "485/TALK",
            "narrator": "つばめ",
            "text": "やっぱり",
            "zh": "果然",
            "narrator_zh": "燕"
        },
        {
            "location": "486/TALK",
            "narrator": "つばめ",
            "text": "そんなことなぃ",
            "zh": "没有那种事",
            "narrator_zh": "燕"
        },
        {
            "location": "487/TALK",
            "narrator": "つばめ",
            "text": "きっと大丈夫だよ",
            "zh": "一定会没事的",
            "narrator_zh": "燕"
        },
        {
            "location": "489/SEL",
            "narrator": "",
            "text": "$me$の杞憂だったね",
            "zh": "是$me$杞人忧天了呢",
            "narrator_zh": ""
        },
        {
            "location": "490/ACT",
            "narrator": "",
            "text": "$me$の杞憂だったね",
            "zh": "是$me$杞人忧天了呢",
            "narrator_zh": ""
        },
        {
            "location": "492/TALK",
            "narrator": "つばめ",
            "text": "そんなことなぃよ",
            "zh": "不是那样",
            "narrator_zh": "燕"
        },
        {
            "location": "493/TALK",
            "narrator": "つばめ",
            "text": "ちゃんと考えなぃと",
            "zh": "得好好想一想",
            "narrator_zh": "燕"
        },
        {
            "location": "494/TALK",
            "narrator": "つばめ",
            "text": "ぃけなぃことだったし",
            "zh": "是必须想的事",
            "narrator_zh": "燕"
        },
        {
            "location": "495/TALK",
            "narrator": "つばめ",
            "text": "きっかけくれてぁりがと",
            "zh": "谢谢你给了个由头",
            "narrator_zh": "燕"
        },
        {
            "location": "507/TALK",
            "narrator": "つばめ",
            "text": "あの……。",
            "zh": "那个……。",
            "narrator_zh": "燕"
        },
        {
            "location": "508/TALK",
            "narrator": "つばめ",
            "text": "神楽ちゃんは\n神楽ちゃんじゃ\nないんですか？",
            "zh": "神乐\n不是神乐\n了吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "509/TALK",
            "narrator": "つばめ",
            "text": "二人にとっては\nメノウちゃんでしか\nないんですか？",
            "zh": "对你们来说\n就只是MENOW\n吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "512/TALK",
            "narrator": "ガブリエラ",
            "text": "いや、だってメノウ\n本人なんだから、\n当然でしょ？",
            "zh": "不是，因为就是MENOW\n本人，\n当然吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "515/TALK",
            "narrator": "つばめ",
            "text": "ううん、違う。\n全然違うよ。",
            "zh": "不对，不一样。\n完全不一样。",
            "narrator_zh": "燕"
        },
        {
            "location": "518/TALK",
            "narrator": "つばめ",
            "text": "神楽ちゃんは\nメノウちゃんかも\nしれないけどね。",
            "zh": "神乐\n也许是MENOW\n呢。",
            "narrator_zh": "燕"
        },
        {
            "location": "519/TALK",
            "narrator": "つばめ",
            "text": "全然、メノウちゃん\nとは違うの。",
            "zh": "跟MENOW\n完全不一样。",
            "narrator_zh": "燕"
        },
        {
            "location": "522/TALK",
            "narrator": "アーヤ",
            "text": "えーと…\nどういうこと？",
            "zh": "那个……\n什么意思？",
            "narrator_zh": "绫水"
        },
        {
            "location": "523/TALK",
            "narrator": "つばめ",
            "text": "メノウちゃんは、\nあんなに笑ったり\nしないです。",
            "zh": "MENOW\n不会笑成\n那样。",
            "narrator_zh": "燕"
        },
        {
            "location": "524/TALK",
            "narrator": "つばめ",
            "text": "楽しそうにラノベの\n話をしたりとかも\nしないんです。",
            "zh": "也不会开心地\n聊轻小说\n什么的。",
            "narrator_zh": "燕"
        },
        {
            "location": "526/TALK",
            "narrator": "ガブリエラ",
            "text": "いや、それ全然理由に\nなってないから。",
            "zh": "不是，这完全\n不成理由。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "528/TALK",
            "narrator": "つばめ",
            "text": "でも、本当に\n全然違うの。",
            "zh": "可是，真的\n完全不一样。",
            "narrator_zh": "燕"
        },
        {
            "location": "529/TALK",
            "narrator": "つばめ",
            "text": "ガブちゃん達は、\nメノウちゃんのこと\n見たことある？",
            "zh": "加布你们，\n见过MENOW\n吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "533/TALK",
            "narrator": "ガブリエラ",
            "text": "…まあ、ＣＭとかで\n見たことあるけど。",
            "zh": "……嘛，广告里\n见过。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "535/TALK",
            "narrator": "アーヤ",
            "text": "私も雑誌でちょっと\n見たことがあるくらい\nかしら？",
            "zh": "我也只是在杂志上\n稍微见过\n一点？",
            "narrator_zh": "绫水"
        },
        {
            "location": "536/TALK",
            "narrator": "つばめ",
            "text": "なら、一度ちゃんと\n見てください。",
            "zh": "那就好好\n看一次。",
            "narrator_zh": "燕"
        },
        {
            "location": "537/TALK",
            "narrator": "つばめ",
            "text": "そうすれば、\nきっと違うって\nわかるはずだから…。",
            "zh": "那样的话，\n一定能明白\n是不一样的……。",
            "narrator_zh": "燕"
        },
        {
            "location": "539/TALK",
            "narrator": "ガブリエラ",
            "text": "あ～、はいはい。\n別にそんなの興味ない\nからいいわよ。",
            "zh": "啊——，好好。\n我对那个没兴趣，\n不用了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "540/TALK",
            "narrator": "つばめ",
            "text": "えっ？",
            "zh": "诶？",
            "narrator_zh": "燕"
        },
        {
            "location": "543/TALK",
            "narrator": "ガブリエラ",
            "text": "普段とメノウのときで\nキャラが違ってたと\nしても、よ。",
            "zh": "就算平时和当MENOW的时候\n人设不一样，\n那又怎样。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "544/TALK",
            "narrator": "ガブリエラ",
            "text": "メノウであることを\n隠してた事実は\n変わらないでしょ？",
            "zh": "瞒着自己是MENOW\n这件事，\n不会变吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "545/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしはね、\nそれが許せないって\n言ってんのよ。",
            "zh": "我啊，\n就是不能原谅\n这一点。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "548/TALK",
            "narrator": "つばめ",
            "text": "それは…きっと、\n何か理由があったん\nだよ。",
            "zh": "那是……一定\n有什么理由\n的。",
            "narrator_zh": "燕"
        },
        {
            "location": "551/TALK",
            "narrator": "つばめ",
            "text": "ほら、アイドルなのが\nバレたら騒がれるかも\nしれないし…。",
            "zh": "你看，要是偶像身份\n曝光了，也许会被闹\n……。",
            "narrator_zh": "燕"
        },
        {
            "location": "552/TALK",
            "narrator": "ガブリエラ",
            "text": "いや、メノウに\n興味あるのって\nつばめだけでしょ？",
            "zh": "不是，对MENOW\n有兴趣的\n不就只有燕吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "553/TALK",
            "narrator": "ガブリエラ",
            "text": "もし本当に騒がれる\nのが嫌で隠してたと\nしたらだけど。",
            "zh": "假如真是因为\n讨厌被闹才瞒着，\n那倒也是。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "554/TALK",
            "narrator": "ガブリエラ",
            "text": "その原因作ったの、\nつばめってことに\nなるわよ？",
            "zh": "那这个原因，\n不就变成\n是燕造成的了？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "556/TALK",
            "narrator": "つばめ",
            "text": "そ、そんな…。",
            "zh": "怎、怎么会……。",
            "narrator_zh": "燕"
        },
        {
            "location": "557/TALK",
            "narrator": "アーヤ",
            "text": "そこまでよ。",
            "zh": "到此为止。",
            "narrator_zh": "绫水"
        },
        {
            "location": "558/TALK",
            "narrator": "アーヤ",
            "text": "この件は、これ以上\n私たちだけで話しても\n意味がないわ。",
            "zh": "这件事，再只靠\n我们自己说下去\n也没有意义。",
            "narrator_zh": "绫水"
        },
        {
            "location": "559/TALK",
            "narrator": "アーヤ",
            "text": "本人に聞かない限り、\n憶測でしかないん\nだから。",
            "zh": "不问本人的话，\n就只是\n猜测。",
            "narrator_zh": "绫水"
        },
        {
            "location": "561/TALK",
            "narrator": "ガブリエラ",
            "text": "…そうね。",
            "zh": "……也是。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "562/TALK",
            "narrator": "アーヤ",
            "text": "ただ、\n今回卯月は勝手な\n単独行動をした。",
            "zh": "不过，\n这次卯月自作主张\n单独行动了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "563/TALK",
            "narrator": "アーヤ",
            "text": "そして\n私達全員を危険な目に\n遭わせた。",
            "zh": "还让\n我们所有人\n陷入危险。",
            "narrator_zh": "绫水"
        },
        {
            "location": "564/TALK",
            "narrator": "アーヤ",
            "text": "これは明確な\n違反行為よ。",
            "zh": "这是明确的\n违规。",
            "narrator_zh": "绫水"
        },
        {
            "location": "565/TALK",
            "narrator": "アーヤ",
            "text": "しっかりと反省して\nもらわないとね。",
            "zh": "得让她\n好好反省。",
            "narrator_zh": "绫水"
        },
        {
            "location": "567/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "574/TALK",
            "narrator": "透明真幌",
            "text": "待たせたな。\n現場の最終確認が\n終わった。",
            "zh": "让你们久等了。\n现场的最终确认\n结束了。",
            "narrator_zh": "透明真幌"
        },
        {
            "location": "575/TALK",
            "narrator": "透明真幌",
            "text": "全員、直ちに\n帰還せよ。",
            "zh": "全员，立即\n返回。",
            "narrator_zh": "透明真幌"
        },
        {
            "location": "577/TALK",
            "narrator": "アーヤ",
            "text": "了解、直ちに劇場へ\n帰還します。",
            "zh": "了解，立即返回\n剧场。",
            "narrator_zh": "绫水"
        },
        {
            "location": "582/TALK",
            "narrator": "アーヤ",
            "text": "…状況終了ね。\nとりあえず、\nもう帰りましょ。",
            "zh": "……状况结束。\n总之，\n先回去吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "584/TALK",
            "narrator": "ガブリエラ",
            "text": "そうね。\nあ～、疲れた…。",
            "zh": "是啊。\n啊——，累了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "585/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "587/TALK",
            "narrator": "ガブリエラ",
            "text": "ほら、つばめ。\n早く帰るわよ。",
            "zh": "好了，燕。\n快点回去。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "589/TALK",
            "narrator": "つばめ",
            "text": "う、うん…。",
            "zh": "嗯、嗯……。",
            "narrator_zh": "燕"
        },
        {
            "location": "591/TALK",
            "narrator": "つばめ",
            "text": "…神楽ちゃん、\n大丈夫かな？",
            "zh": "……神乐，\n没事吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "602/DIALOG",
            "narrator": "Dialog_chapter_ch01",
            "text": "【14 神楽学校やめるってよ】",
            "zh": "【14 神乐说要退学了】",
            "narrator_zh": "Dialog_chapter_ch01"
        }
    ]
}
