    "entry": [
        {
            "location": "615/SCENARIO",
            "narrator": "",
            "text": "それでも未来を",
            "zh": "即便如此仍望向未来",
            "narrator_zh": ""
        },
        {
            "location": "631/TALK",
            "narrator": "アーヤ",
            "text": "…痛っ…。",
            "zh": "……好痛……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "632/TALK",
            "narrator": "アーヤ",
            "text": "頭が痛いし\n何だか震えが\n止まらないわ…。",
            "zh": "头好痛，\n总觉得浑身发抖\n停不下来……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "634/TALK",
            "narrator": "アーヤ",
            "text": "落ち着かなきゃ\nいけないのに…。",
            "zh": "明明必须\n冷静下来才行……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "638/SEL",
            "narrator": "",
            "text": "元気？",
            "zh": "还好吗？",
            "narrator_zh": ""
        },
        {
            "location": "639/ACT",
            "narrator": "",
            "text": "元気？",
            "zh": "还好吗？",
            "narrator_zh": ""
        },
        {
            "location": "658/TALK",
            "narrator": "アーヤ",
            "text": "げんｋじゃないけど",
            "zh": "一点都不ｈao",
            "narrator_zh": "绫水"
        },
        {
            "location": "659/TALK",
            "narrator": "アーヤ",
            "text": "どこに行ってたの",
            "zh": "你去哪儿了",
            "narrator_zh": "绫水"
        },
        {
            "location": "661/SEL",
            "narrator": "",
            "text": "ごめんごめん",
            "zh": "抱歉抱歉",
            "narrator_zh": ""
        },
        {
            "location": "662/SEL",
            "narrator": "",
            "text": "ちょっとしたバグ",
            "zh": "出了点小Bug",
            "narrator_zh": ""
        },
        {
            "location": "663/SEL",
            "narrator": "",
            "text": "一応解決したから",
            "zh": "姑且已经解决了",
            "narrator_zh": ""
        },
        {
            "location": "664/ACT",
            "narrator": "",
            "text": "ごめんごめん",
            "zh": "抱歉抱歉",
            "narrator_zh": ""
        },
        {
            "location": "665/TALK",
            "narrator": "アーヤ",
            "text": "軽すぎる",
            "zh": "说得太轻巧了",
            "narrator_zh": "绫水"
        },
        {
            "location": "666/ACT",
            "narrator": "",
            "text": "ちょっとしたバグ",
            "zh": "出了点小Bug",
            "narrator_zh": ""
        },
        {
            "location": "667/TALK",
            "narrator": "アーヤ",
            "text": "ちょっとじゃないわ",
            "zh": "才不是一点点呢",
            "narrator_zh": "绫水"
        },
        {
            "location": "668/ACT",
            "narrator": "",
            "text": "一応解決したから",
            "zh": "姑且已经解决了",
            "narrator_zh": ""
        },
        {
            "location": "669/TALK",
            "narrator": "アーヤ",
            "text": "一応って",
            "zh": "什么叫姑且啊",
            "narrator_zh": "绫水"
        },
        {
            "location": "671/TALK",
            "narrator": "アーヤ",
            "text": "説明してよね",
            "zh": "要给我解释清楚哦",
            "narrator_zh": "绫水"
        },
        {
            "location": "672/TALK",
            "narrator": "アーヤ",
            "text": "後で",
            "zh": "等会儿",
            "narrator_zh": "绫水"
        },
        {
            "location": "674/SEL",
            "narrator": "",
            "text": "もちろん",
            "zh": "当然",
            "narrator_zh": ""
        },
        {
            "location": "675/SEL",
            "narrator": "",
            "text": "がんばる",
            "zh": "我会努力的",
            "narrator_zh": ""
        },
        {
            "location": "676/SEL",
            "narrator": "",
            "text": "できるかな…",
            "zh": "能行吗……",
            "narrator_zh": ""
        },
        {
            "location": "677/ACT",
            "narrator": "",
            "text": "もちろん",
            "zh": "当然",
            "narrator_zh": ""
        },
        {
            "location": "678/TALK",
            "narrator": "アーヤ",
            "text": "よろしくね",
            "zh": "拜托你咯",
            "narrator_zh": "绫水"
        },
        {
            "location": "679/ACT",
            "narrator": "",
            "text": "がんばる",
            "zh": "我会努力的",
            "narrator_zh": ""
        },
        {
            "location": "680/TALK",
            "narrator": "アーヤ",
            "text": "色々あったみたいね",
            "zh": "看来发生了很多事呢",
            "narrator_zh": "绫水"
        },
        {
            "location": "681/ACT",
            "narrator": "",
            "text": "できるかな…",
            "zh": "能行吗……",
            "narrator_zh": ""
        },
        {
            "location": "682/TALK",
            "narrator": "アーヤ",
            "text": "そんなに大変なことなの",
            "zh": "有那么严重吗",
            "narrator_zh": "绫水"
        },
        {
            "location": "685/SEL",
            "narrator": "",
            "text": "それよりつばめたちのこと",
            "zh": "比起那个，先管燕她们的事吧",
            "narrator_zh": ""
        },
        {
            "location": "686/SEL",
            "narrator": "",
            "text": "みんなアーヤを頼りにしてるよ",
            "zh": "大家都在指望绫水你哦",
            "narrator_zh": ""
        },
        {
            "location": "687/SEL",
            "narrator": "",
            "text": "つばめと神楽を救ってあげて",
            "zh": "去救救燕和神乐吧",
            "narrator_zh": ""
        },
        {
            "location": "688/ACT",
            "narrator": "",
            "text": "それよりつばめたちのこと",
            "zh": "比起那个，先管燕她们的事吧",
            "narrator_zh": ""
        },
        {
            "location": "689/TALK",
            "narrator": "アーヤ",
            "text": "そうね",
            "zh": "也是",
            "narrator_zh": "绫水"
        },
        {
            "location": "690/TALK",
            "narrator": "アーヤ",
            "text": "今はそれが一番大事",
            "zh": "现在这才是最重要的",
            "narrator_zh": "绫水"
        },
        {
            "location": "691/ACT",
            "narrator": "",
            "text": "みんなアーヤを頼りにしてるよ",
            "zh": "大家都在指望绫水你哦",
            "narrator_zh": ""
        },
        {
            "location": "692/TALK",
            "narrator": "アーヤ",
            "text": "どうかしら",
            "zh": "谁知道呢",
            "narrator_zh": "绫水"
        },
        {
            "location": "693/TALK",
            "narrator": "アーヤ",
            "text": "でもリーダーだもの",
            "zh": "不过毕竟是队长嘛",
            "narrator_zh": "绫水"
        },
        {
            "location": "694/TALK",
            "narrator": "アーヤ",
            "text": "しっかりしなきゃ",
            "zh": "必须振作起来",
            "narrator_zh": "绫水"
        },
        {
            "location": "695/ACT",
            "narrator": "",
            "text": "つばめと神楽を救ってあげて",
            "zh": "去救救燕和神乐吧",
            "narrator_zh": ""
        },
        {
            "location": "696/TALK",
            "narrator": "アーヤ",
            "text": "絶対に",
            "zh": "绝对",
            "narrator_zh": "绫水"
        },
        {
            "location": "697/TALK",
            "narrator": "アーヤ",
            "text": "助けるわ",
            "zh": "我会救出她们的",
            "narrator_zh": "绫水"
        },
        {
            "location": "710/TALK",
            "narrator": "アーヤ",
            "text": "…自分でもびっくり。",
            "zh": "……连我自己都吓了一跳。",
            "narrator_zh": "绫水"
        },
        {
            "location": "711/TALK",
            "narrator": "アーヤ",
            "text": "$handle$さんと\n話しただけで\n気持ちが違う。",
            "zh": "光是和$handle$\n说上几句话，\n心情就完全不一样了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "712/TALK",
            "narrator": "アーヤ",
            "text": "でもそのくらいの\n間柄じゃなきゃ、\n結婚なんてできないわ。",
            "zh": "不过要是不亲近到\n这种程度，\n也没法结婚呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "714/TALK",
            "narrator": "アーヤ",
            "text": "愛って言葉も\n軽すぎる気持ち。",
            "zh": "连“爱”这个词\n都显得太轻飘的心情。",
            "narrator_zh": "绫水"
        },
        {
            "location": "716/TALK",
            "narrator": "アーヤ",
            "text": "$handle$さんと\nまた話せるように\nなってよかった…。",
            "zh": "能再次和$handle$\n说上话，\n真是太好了……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "718/TALK",
            "narrator": "アーヤ",
            "text": "…今はそっちの\nことじゃなく。",
            "zh": "……现在不是想\n那些的时候。",
            "narrator_zh": "绫水"
        },
        {
            "location": "720/TALK",
            "narrator": "アーヤ",
            "text": "みやび。\n聞こえてる？",
            "zh": "雅。\n听得到吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "721/TALK",
            "narrator": "透明みやび",
            "text": "もちろん。",
            "zh": "当然。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "722/TALK",
            "narrator": "アーヤ",
            "text": "残念だけど姉と\n連絡は取れない。",
            "zh": "很遗憾，还是\n联系不上姐姐。",
            "narrator_zh": "绫水"
        },
        {
            "location": "723/TALK",
            "narrator": "アーヤ",
            "text": "だからこちらだけで\n解決できる作戦しか\n立てられないわ。",
            "zh": "所以只能制定\n仅靠我们自己就能\n解决的作战了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "724/TALK",
            "narrator": "透明みやび",
            "text": "そうやろうとは\n思うちょった。",
            "zh": "我也猜到\n会是这样了啵。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "725/TALK",
            "narrator": "アーヤ",
            "text": "でもみやびなら\nどうにかできると\n思ってるわ。",
            "zh": "不过如果是雅的话，\n我相信一定能\n想出办法的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "726/TALK",
            "narrator": "透明みやび",
            "text": "…いつの間にそんなに\n人を乗せるんが\n上手うなったかね。",
            "zh": "……几时\n变得这么会\n捧人了咯。",
            "narrator_zh": "透明雅"
        },
        {
            "location": "727/TALK",
            "narrator": "アーヤ",
            "text": "おだててなんてないわ。\n本心よ。",
            "zh": "我可不是在奉承你。\n是真心话。",
            "narrator_zh": "绫水"
        },
        {
            "location": "728/TALK",
            "narrator": "アーヤ",
            "text": "それで――。",
            "zh": "那么——。",
            "narrator_zh": "绫水"
        },
        {
            "location": "637/DIALOG",
            "narrator": "Dialog_InfoOS",
