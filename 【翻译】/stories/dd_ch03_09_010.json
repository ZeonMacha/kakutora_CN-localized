{
    "dir": "chap09/daydra/dd_ch03_09_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "9352",
        "cid": "gabriella",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "初めての映画",
        "title_zh": "Extra002 额外剧情",
        "sub_title_zh": "第一次看的电影"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "初めての映画",
            "zh": "第一次看的电影",
            "narrator_zh": ""
        },
        {
            "location": "30/TALK",
            "narrator": "つばめ",
            "text": "わぁ……。",
            "zh": "哇啊……。",
            "narrator_zh": "燕"
        },
        {
            "location": "34/TALK",
            "narrator": "ガブリエラ",
            "text": "新人！　放映中に\n劇場の中を覗かない！",
            "zh": "新人！放映的时候\n别往剧场里探头探脑的！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "36/TALK",
            "narrator": "つばめ",
            "text": "せんぱい、今やってる\n映画凄いですよ！\nなんか凄く不思議なの。",
            "zh": "前辈，现在正在放的\n电影好厉害呀！\n总觉得好不可思议哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "37/TALK",
            "narrator": "つばめ",
            "text": "音楽は流れてるのに、\n声が入ってないんです！",
            "zh": "明明放着音乐，\n却没有说话的声音呢！",
            "narrator_zh": "燕"
        },
        {
            "location": "39/TALK",
            "narrator": "ガブリエラ",
            "text": "サイレント映画なんだから\n当然じゃない。",
            "zh": "因为是无声电影，\n这不理所当然吗。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "40/TALK",
            "narrator": "つばめ",
            "text": "…サイレント映画？",
            "zh": "……无声电影？",
            "narrator_zh": "燕"
        },
        {
            "location": "43/TALK",
            "narrator": "真幌",
            "text": "逢瀬、まさかサイレント\n映画を知らんのか？",
            "zh": "逢濑，难道你连无声\n电影都不知道吗？",
            "narrator_zh": "真幌"
        },
        {
            "location": "46/TALK",
            "narrator": "つばめ",
            "text": "は、はい…\n初めて聞きました。",
            "zh": "是、是的……\n还是第一次听说。",
            "narrator_zh": "燕"
        },
        {
            "location": "48/TALK",
            "narrator": "真幌",
            "text": "…信じられん。\n今の世代はみんな\nそうなのか？",
            "zh": "……真是难以置信。\n现在这一代人全都是\n这样吗？",
            "narrator_zh": "真幌"
        },
        {
            "location": "51/TALK",
            "narrator": "アーヤ",
            "text": "私も、知ってはいるけど\n見たことはないです。",
            "zh": "我虽然知道有这种东西，\n但也没看过。",
            "narrator_zh": "绫水"
        },
        {
            "location": "54/TALK",
            "narrator": "ガブリエラ",
            "text": "同じく、見たことないわ。",
            "zh": "同上，没看过。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "56/TALK",
            "narrator": "みやび",
            "text": "白黒映画すら中々見ない\n時代やき、不思議では\nないな。",
            "zh": "这年头连黑白电影都\n难得一看啵，倒也不觉得\n奇怪咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "58/TALK",
            "narrator": "ガブリエラ",
            "text": "っていうか、今更そんな\n昔の映画見たいなんて\n思わないでしょ。",
            "zh": "话说回来，都这年头了，\n也不会想去看那么老的\n电影吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "60/TALK",
            "narrator": "ガブリエラ",
            "text": "そもそも声が無いのに\nどう楽しめっていうのよ？",
            "zh": "本来连台词声音都没有，\n这要人怎么看得下去嘛？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "62/TALK",
            "narrator": "真幌",
            "text": "ギャヴィ、\nそれは大間違いだぞ。",
            "zh": "加维，\n那你可就大错特错了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "63/TALK",
            "narrator": "真幌",
            "text": "声が無くとも役者の演技を\n見ていれば、何をしようと\nしているのか――",
            "zh": "就算没有声音，只要看着\n演员的表演，他们想要\n做什么——",
            "narrator_zh": "真幌"
        },
        {
            "location": "64/TALK",
            "narrator": "真幌",
            "text": "そして何を言っているのか\nまでわかってしまうのが、\nサイレント映画だ。",
            "zh": "甚至连他们正在说什么\n都能看得一清二楚，\n这就是无声电影。",
            "narrator_zh": "真幌"
        },
        {
            "location": "67/TALK",
            "narrator": "つばめ",
            "text": "声が無いのに、そこまで\nわかっちゃうんですか！？",
            "zh": "明明没有声音，竟然能\n看懂到那种地步吗！？",
            "narrator_zh": "燕"
        },
        {
            "location": "68/TALK",
            "narrator": "真幌",
            "text": "信じられないか？\nまあ、見たことがないなら\n仕方がないが…。",
            "zh": "觉得难以置信吗？\n算了，没看过的话\n倒也难怪……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "70/TALK",
            "narrator": "真幌",
            "text": "…よし決めた。",
            "zh": "……好，决定了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "72/TALK",
            "narrator": "真幌",
            "text": "今夜はおまえ等のために、\n特別上映してやろう！",
            "zh": "今晚就为了你们几个，\n来场特别放映吧！",
            "narrator_zh": "真幌"
        },
        {
            "location": "75/TALK",
            "narrator": "つばめ",
            "text": "本当ですか！？\nやったぁ！！",
            "zh": "真的吗！？\n太好啦！！",
            "narrator_zh": "燕"
        },
        {
            "location": "76/TALK",
            "narrator": "ガブリエラ",
            "text": "そこ、喜ぶところ？\n今更サイレント映画とか、\n楽しめるわけないじゃん。",
            "zh": "那有什么好高兴的？\n都这年头了还看无声电影，\n怎么可能好看嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "78/TALK",
            "narrator": "真幌",
            "text": "文句は見てから言え。",
            "zh": "有意见等看完了再提。",
            "narrator_zh": "真幌"
        },
        {
            "location": "80/TALK",
            "narrator": "真幌",
            "text": "とはいえ、今放映してる\n映画は少し難しい映画\nだからな――",
            "zh": "不过话虽如此，现在放的\n这部片子稍微有点晦涩\n难懂——",
            "narrator_zh": "真幌"
        },
        {
            "location": "81/TALK",
            "narrator": "真幌",
            "text": "どういうのが見たいか\nリクエストがあれば\n言ってみろ。",
            "zh": "你们想看什么类型的，\n有要求的话\n尽管提吧。",
            "narrator_zh": "真幌"
        },
        {
            "location": "84/TALK",
            "narrator": "つばめ",
            "text": "リクエストかぁ。\nう～ん……",
            "zh": "要求呀。\n嗯～……",
            "narrator_zh": "燕"
        },
        {
            "location": "85/TALK",
            "narrator": "つばめ",
            "text": "やっぱり、最初は有名な\n映画から見たいかも。",
            "zh": "果然一开始还是想从\n有名的电影看起呢。",
            "narrator_zh": "燕"
        },
        {
            "location": "86/TALK",
            "narrator": "みやび",
            "text": "いや、サイレント映画\nいうたらやっぱホラー\n一択やき。",
            "zh": "不对，要说无声电影，\n那果然还是恐怖片\n唯一解啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "90/TALK",
            "narrator": "アーヤ",
            "text": "っ！？",
            "zh": "唔！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "91/TALK",
            "narrator": "みやび",
            "text": "声付きの映画とは比べ物に\nならんくらい不気味で\n楽しいんよ。",
            "zh": "跟有声电影完全没法比，\n那种阴森森的劲儿\n可带劲咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "94/TALK",
            "narrator": "アーヤ",
            "text": "な、何言ってるの！\nサイレント映画といったら\nほら、あれよ…。",
            "zh": "你、你在说什么呢！\n要说无声电影的话，\n你看，就是那个嘛……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "96/TALK",
            "narrator": "アーヤ",
            "text": "そう、コメディ！\n私はコメディを見て\nみたいわ。",
            "zh": "对，喜剧！\n我想看喜剧\n电影哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "98/TALK",
            "narrator": "みやび",
            "text": "怖いんは苦手か？",
            "zh": "怕恐怖的东西喃？",
            "narrator_zh": "雅"
        },
        {
            "location": "100/TALK",
            "narrator": "つばめ",
            "text": "そうなんですか？",
            "zh": "是这样吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "104/TALK",
            "narrator": "アーヤ",
            "text": "ま、まさか！\n映画程度で怖がるような\n年齢じゃないわ。",
            "zh": "怎、怎么可能！\n我都不是会被区区电影\n吓到的年纪了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "106/TALK",
            "narrator": "真幌",
            "text": "盛り上がるのは構わんが、\n三本も見たら夜中になって\nしまうぞ。",
            "zh": "热闹起来是挺好，\n但连看三部可就要\n熬到半夜了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "108/TALK",
            "narrator": "真幌",
            "text": "ギャヴィ、今の中だったら\nどれを見たい？",
            "zh": "加维，刚才这几个里面\n你想看哪部？",
            "narrator_zh": "真幌"
        },
        {
            "location": "109/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしが決めるの！？",
            "zh": "由我来决定吗！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "110/TALK",
            "narrator": "真幌",
            "text": "最後まで何も言わなかった\nおまえが悪い。\nほら、さっさと言え。",
            "zh": "谁让你到最后一直\n不吭声的。\n来，快点说。",
            "narrator_zh": "真幌"
        },
        {
            "location": "112/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょ、ちょっと待って。\n今、少し調べるから…。",
            "zh": "等、等一下啦。\n我现在先稍微查一下……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "124/TALK",
            "narrator": "ガブリエラ",
            "text": "どうしよう、マルザンナ！",
            "zh": "怎么办呀，玛尔赞娜！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "125/TALK",
            "narrator": "ガブリエラ",
            "text": "どんなサイレント映画を見るかで、話し合っていたんだけど",
            "zh": "大家刚才在商量要看什么无声电影来着",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "126/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしが何を見るかを決めることになっちゃったの",
            "zh": "结果变成由我来决定看什么了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "127/TALK",
            "narrator": "ガブリエラ",
            "text": "見たことないあたしにわかるわけないじゃん！",
            "zh": "我连看都没看过，怎么可能懂嘛！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "128/TALK",
            "narrator": "ガブリエラ",
            "text": "だから、あたしが楽しめそうなのを一緒に考えてほしいの",
            "zh": "所以，我想请你一起帮我想想看哪部比较有意思",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "130/SEL",
            "narrator": "",
            "text": "苦手なジャンルはある？",
            "zh": "有不擅长的类型吗？",
            "narrator_zh": ""
        },
        {
            "location": "131/ACT",
            "narrator": "",
            "text": "苦手なジャンルはある？",
            "zh": "有不擅长的类型吗？",
            "narrator_zh": ""
        },
        {
            "location": "133/TALK",
            "narrator": "ガブリエラ",
            "text": "特にないわ",
            "zh": "倒也没有特别的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "135/SEL",
            "narrator": "",
            "text": "有名なのでいいと思う",
            "zh": "选有名的就好吧",
            "narrator_zh": ""
        },
        {
            "location": "136/SEL",
            "narrator": "",
            "text": "ホラーがいいよ",
            "zh": "恐怖片挺好的",
            "narrator_zh": ""
        },
        {
            "location": "137/SEL",
            "narrator": "",
            "text": "時代劇なんかは？",
            "zh": "时代剧怎么样？",
            "narrator_zh": ""
        },
        {
            "location": "138/ACT",
            "narrator": "",
            "text": "有名なのでいいと思う",
            "zh": "选有名的就好吧",
            "narrator_zh": ""
        },
        {
            "location": "139/TALK",
            "narrator": "ガブリエラ",
            "text": "それだと、新人のリクエストと被るんだけど…",
            "zh": "那样的话，就跟新人的要求撞了……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "140/TALK",
            "narrator": "ガブリエラ",
            "text": "まあいいわ",
            "zh": "不过算了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "151/TALK",
            "narrator": "ガブリエラ",
            "text": "どうせ見るならあたしも\n楽しい方がいいし――",
            "zh": "既然都要看，我也想挑\n自己能乐在其中的——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "152/TALK",
            "narrator": "ガブリエラ",
            "text": "有名どころが一番無難\nかもしれないわね。",
            "zh": "挑有名的作品或许\n才是最稳妥的选择吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "153/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしも新人に賛成。\nやっぱり最初は有名\nなのから見たいわ。",
            "zh": "我也赞成新人的提议。\n果然一开始还是想从\n有名的看起。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "156/TALK",
            "narrator": "つばめ",
            "text": "やった！\nありがと、せんぱい。",
            "zh": "太好了！\n谢谢你，前辈。",
            "narrator_zh": "燕"
        },
        {
            "location": "158/TALK",
            "narrator": "ガブリエラ",
            "text": "あんたに賛成した\nわけじゃないって。",
            "zh": "我可不是专门\n赞成你的意思啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "160/TALK",
            "narrator": "真幌",
            "text": "よし、決まりだな。",
            "zh": "行，那就这么定了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "161/TALK",
            "narrator": "真幌",
            "text": "上映時刻は業務終了の\n十五分後だ。",
            "zh": "放映时间是下班后\n十五分钟。",
            "narrator_zh": "真幌"
        },
        {
            "location": "163/TALK",
            "narrator": "真幌",
            "text": "全員遅れるなよ！",
            "zh": "全员不许迟到！",
            "narrator_zh": "真幌"
        },
        {
            "location": "164/ACT",
            "narrator": "",
            "text": "ホラーがいいよ",
            "zh": "恐怖片挺好的",
            "narrator_zh": ""
        },
        {
            "location": "165/TALK",
            "narrator": "ガブリエラ",
            "text": "ホラーね、わかったわ",
            "zh": "恐怖片是吧，我知道了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "177/TALK",
            "narrator": "ガブリエラ",
            "text": "それじゃホラーで。",
            "zh": "那就看恐怖片吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "184/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィ！？",
            "zh": "加维！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "187/TALK",
            "narrator": "ガブリエラ",
            "text": "閉館後の夜の映画館で\n見るのに、一番ピッタリ\nだと思うし――",
            "zh": "在闭馆后的夜晚电影院里\n观看，我觉得再合适\n不过了——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "190/TALK",
            "narrator": "ガブリエラ",
            "text": "ホラー映画が怖いって人も\nいないみたいだから、\n問題ないでしょ？",
            "zh": "而且好像也没有人\n害怕恐怖片，\n没问题的吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "194/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "206/TALK",
            "narrator": "アーヤ",
            "text": "たすけｒｒ",
            "zh": "救命ｒｒ",
            "narrator_zh": "绫水"
        },
        {
            "location": "208/TALK",
            "narrator": "アーヤ",
            "text": "たすけたえ",
            "zh": "救命啊呀",
            "narrator_zh": "绫水"
        },
        {
            "location": "209/TALK",
            "narrator": "アーヤ",
            "text": "たけすてれえ",
            "zh": "救救我命啊",
            "narrator_zh": "绫水"
        },
        {
            "location": "210/SEL",
            "narrator": "",
            "text": "落ち着け！",
            "zh": "冷静点！",
            "narrator_zh": ""
        },
        {
            "location": "211/ACT",
            "narrator": "",
            "text": "落ち着け！",
            "zh": "冷静点！",
            "narrator_zh": ""
        },
        {
            "location": "214/TALK",
            "narrator": "アーヤ",
            "text": "ホラー映画嫌い！",
            "zh": "我讨厌恐怖片！",
            "narrator_zh": "绫水"
        },
        {
            "location": "216/TALK",
            "narrator": "アーヤ",
            "text": "絶対泣いちゃうよー(；△；)",
            "zh": "绝对会哭出来的呀—(；△；)",
            "narrator_zh": "绫水"
        },
        {
            "location": "218/SEL",
            "narrator": "",
            "text": "声がないから怖くないよ",
            "zh": "没有声音所以不可怕哦",
            "narrator_zh": ""
        },
        {
            "location": "219/SEL",
            "narrator": "",
            "text": "あれれ、怖いの？",
            "zh": "哎呀呀，害怕了吗？",
            "narrator_zh": ""
        },
        {
            "location": "220/SEL",
            "narrator": "",
            "text": "時代劇を提案しよう",
            "zh": "提议看时代剧吧",
            "narrator_zh": ""
        },
        {
            "location": "221/ACT",
            "narrator": "",
            "text": "声がないから怖くないよ",
            "zh": "没有声音所以不可怕哦",
            "narrator_zh": ""
        },
        {
            "location": "222/TALK",
            "narrator": "アーヤ",
            "text": "そうなの？",
            "zh": "是吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "223/TALK",
            "narrator": "アーヤ",
            "text": "みやびは不気味って言ってた",
            "zh": "雅刚才说很阴森的",
            "narrator_zh": "绫水"
        },
        {
            "location": "224/TALK",
            "narrator": "アーヤ",
            "text": "私を怖がらせようとしただけ？",
            "zh": "难道只是想吓唬我而已？",
            "narrator_zh": "绫水"
        },
        {
            "location": "225/TALK",
            "narrator": "アーヤ",
            "text": "不安だよー！！",
            "zh": "好不安啊—！！",
            "narrator_zh": "绫水"
        },
        {
            "location": "237/TALK",
            "narrator": "アーヤ",
            "text": "はぁ…。",
            "zh": "哈啊……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "239/TALK",
            "narrator": "つばめ",
            "text": "アーヤさん、\nどうかしたんですか？",
            "zh": "绫水前辈，\n你怎么了吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "242/TALK",
            "narrator": "アーヤ",
            "text": "う、ううん、別に…。",
            "zh": "没、没什么……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "245/TALK",
            "narrator": "アーヤ",
            "text": "でも、そうよね。\n古いし声も無いんだから、\nそんなに怖くないはずよ。",
            "zh": "不过，说得也是。\n既老旧又没有声音，\n应该没那么可怕才对。",
            "narrator_zh": "绫水"
        },
        {
            "location": "246/TALK",
            "narrator": "真幌",
            "text": "じゃあ、ホラー映画で\n決まりだな。",
            "zh": "那，就决定看\n恐怖片了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "248/TALK",
            "narrator": "みやび",
            "text": "楽しみやな。",
            "zh": "真让人期待咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "249/TALK",
            "narrator": "ガブリエラ",
            "text": "まあ、声の無いホラー映画\nなんて、たかが知れてる\nだろうけど。",
            "zh": "不过嘛，没有声音的\n恐怖片，撑死也就\n那样了吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "252/TALK",
            "narrator": "真幌",
            "text": "ふふっ…甘いなギャヴィ。",
            "zh": "哼哼……太天真了，加维。",
            "narrator_zh": "真幌"
        },
        {
            "location": "255/TALK",
            "narrator": "真幌",
            "text": "サイレント映画のホラーは\nそんなに甘くないぞ。",
            "zh": "无声电影的恐怖片\n可没你想得那么温和。",
            "narrator_zh": "真幌"
        },
        {
            "location": "256/TALK",
            "narrator": "真幌",
            "text": "体調不良はもちろん、\n失神する者まで出すものも\nあるからな。",
            "zh": "身体不适自不必说，\n有些片子甚至能把人\n吓晕过去。",
            "narrator_zh": "真幌"
        },
        {
            "location": "258/TALK",
            "narrator": "ガブリエラ",
            "text": "そんなに怖いの！？",
            "zh": "有那么可怕吗！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "259/TALK",
            "narrator": "真幌",
            "text": "生半可な気持ちで挑むと\nおまえ達もそうなるぞ。\n覚悟しておけ。",
            "zh": "要是抱着半吊子的心态\n去挑战，你们也会落得\n同样下场的。做好觉悟吧。",
            "narrator_zh": "真幌"
        },
        {
            "location": "260/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "264/TALK",
            "narrator": "アーヤ",
            "text": "目を瞑るだけで乗り切る\n自信、なくなってきた…。",
            "zh": "光靠闭上眼睛撑过去的\n自信，快没了……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "265/ACT",
            "narrator": "",
            "text": "あれれ、怖いの？",
            "zh": "哎呀呀，害怕了吗？",
            "narrator_zh": ""
        },
        {
            "location": "267/TALK",
            "narrator": "アーヤ",
            "text": "怖いから助けてほしかったのに",
            "zh": "我是因为害怕才想让你帮我的呀",
            "narrator_zh": "绫水"
        },
        {
            "location": "268/TALK",
            "narrator": "アーヤ",
            "text": "もういい、バカ！",
            "zh": "不管你了，笨蛋！",
            "narrator_zh": "绫水"
        },
        {
            "location": "281/TALK",
            "narrator": "アーヤ",
            "text": "はぁ…。",
            "zh": "哈啊……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "283/TALK",
            "narrator": "つばめ",
            "text": "アーヤさん、\nどうかしたんですか？",
            "zh": "绫水前辈，\n你怎么了吗？",
