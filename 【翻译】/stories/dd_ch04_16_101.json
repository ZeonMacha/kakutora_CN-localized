{
    "dir": "chap16/daydra/dd_ch04_16_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "16402",
        "cid": "miyabi",
        "title": "002 メインストーリー",
        "sub_title": "大混乱の大根役者＜前編＞",
        "title_zh": "002 主线剧情",
        "sub_title_zh": "大混乱的蹩脚演员＜前篇＞"
    },
    "entry": [
        {
            "location": "36/TALK",
            "narrator": "みやび",
            "text": "…なかなか手強い\nシステムやな。",
            "zh": "……这个系统，\n还挺难对付啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "37/TALK",
            "narrator": "みやび",
            "text": "フェノメノンも\nセキュリティ対策\nしちょるとは。",
            "zh": "PhenoMENON居然\n也在做\n安全防护。",
            "narrator_zh": "雅"
        },
        {
            "location": "38/TALK",
            "narrator": "みやび",
            "text": "ちっくとビックリな\n事実やね。",
            "zh": "有点吓人的\n事实咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "39/TALK",
            "narrator": "みやび",
            "text": "…光月さんの方に\n頼めたらえいんや\nけんど。",
            "zh": "……要是能拜托\n光月那边\n就好了，但是。",
            "narrator_zh": "雅"
        },
        {
            "location": "40/TALK",
            "narrator": "みやび",
            "text": "さすがに、これ以上\nディープな作業は\n無理やろうし…。",
            "zh": "毕竟再往深里的活，\n应该是\n做不动了……",
            "narrator_zh": "雅"
        },
        {
            "location": "44/TALK",
            "narrator": "みやび",
            "text": "…みんな、\n上手くやっちょ\nろうかね？",
            "zh": "……大家那边，\n都进行得\n顺利吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "45/TALK",
            "narrator": "みやび",
            "text": "アーヤ、そっちの方\n何か問題は起きちょ\nらん？",
            "zh": "绫水，你那边\n有没有出什么\n问题咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "49/TALK",
            "narrator": "透明アーヤ",
            "text": "こちらアーヤ。\n今のところ順調よ。",
            "zh": "这里是绫水。\n目前还算顺利。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "50/TALK",
            "narrator": "みやび",
            "text": "了解や。",
            "zh": "了解咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "51/TALK",
            "narrator": "透明アーヤ",
            "text": "それで、ハッキングは\n上手くいきそう？",
            "zh": "那么，入侵\n看起来顺利吗？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "52/TALK",
            "narrator": "みやび",
            "text": "…もうちくっと\n時間かかりそうや。",
            "zh": "……看样子\n还得再花点时间咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "53/TALK",
            "narrator": "みやび",
            "text": "思うてた以上に厳重で\nなかなか奥まで\n辿りつかんがよ。",
            "zh": "防护比想象的\n严实得多，\n根本摸不到深处咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "54/TALK",
            "narrator": "透明アーヤ",
            "text": "了解…。\nでも、できれば\n急いで。",
            "zh": "了解……。\n不过如果可以，\n请抓紧。",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "59/TALK",
            "narrator": "みやび",
            "text": "…順調とは\n言うちょったけど。",
            "zh": "……虽然我嘴上\n说着顺利来着。",
            "narrator_zh": "雅"
        },
        {
            "location": "60/TALK",
            "narrator": "みやび",
            "text": "しんどそうな\n声やったな…。",
            "zh": "听着像是\n很吃力的声音啊……",
            "narrator_zh": "雅"
        },
        {
            "location": "61/TALK",
            "narrator": "みやび",
            "text": "…まあ、それは\nこっちも同じや\nけんど…。",
            "zh": "……嘛，不过\n这边也一样\n就是了……",
            "narrator_zh": "雅"
        },
        {
            "location": "65/TALK",
            "narrator": "みやび",
            "text": "…ダメや。\nやはりうちと光月さん\nだけじゃ追いつかん。",
            "zh": "……不行。\n果然光靠我和\n光月根本赶不上。",
            "narrator_zh": "雅"
        },
        {
            "location": "66/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "67/TALK",
            "narrator": "みやび",
            "text": "あいつに頼むしか\nなさそうやなぁ…。",
            "zh": "看样子只能\n拜托那家伙了……",
            "narrator_zh": "雅"
        },
        {
            "location": "82/TALK",
            "narrator": "繭",
            "text": "…予想はしてたけど、\n簡単な作業しか\nもらえない。",
            "zh": "……虽然预料到了，\n但接到的只有\n简单作业。",
            "narrator_zh": "茧"
        },
        {
            "location": "83/TALK",
            "narrator": "繭",
            "text": "やはり、みやび先輩は\nまだ私のこと……。",
            "zh": "果然，雅前辈\n还是把我……",
            "narrator_zh": "茧"
        },
        {
            "location": "84/TALK",
            "narrator": "繭",
            "text": "素人レベルにしか\n思っていない、と\nいうことか…。",
            "zh": "只当成外行\n水平看待，\n是这样吗……",
            "narrator_zh": "茧"
        },
        {
            "location": "88/TALK",
            "narrator": "繭",
            "text": "クイーンからの\n呼び出し？\nこのタイミングで？",
            "zh": "女王\n的召见？\n挑这个时间？",
            "narrator_zh": "茧"
        },
        {
            "location": "89/TALK",
            "narrator": "繭",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "茧"
        },
        {
            "location": "90/TALK",
            "narrator": "繭",
            "text": "現在発生中の\nフェノメノンの解析の\n手伝い…。",
            "zh": "帮忙解析\n目前发生的\nPhenoMENON……",
            "narrator_zh": "茧"
        },
        {
            "location": "91/TALK",
            "narrator": "繭",
            "text": "今、まさにその\n作業をしてるん\nだけどね。",
            "zh": "而我现在\n做的正是\n这个活呢。",
            "narrator_zh": "茧"
        },
        {
            "location": "92/TALK",
            "narrator": "繭",
            "text": "さすがのクイーンも\nわかるわけないか。",
            "zh": "就算是女王也\n不可能知道的吧。",
            "narrator_zh": "茧"
        },
        {
            "location": "93/TALK",
            "narrator": "繭",
            "text": "了解。\n使用する回線を\n教えてください、と。",
            "zh": "了解。\n请告知\n使用的线路，如此回复。",
            "narrator_zh": "茧"
        },
        {
            "location": "100/TALK",
            "narrator": "繭",
            "text": "…えっ？",
            "zh": "……诶？",
            "narrator_zh": "茧"
        },
        {
            "location": "101/TALK",
            "narrator": "繭",
            "text": "この回線って…、\n私とみやび先輩が\n繋げたもの…？",
            "zh": "这条线路……\n是我和雅前辈\n连接起来的……？",
            "narrator_zh": "茧"
        },
        {
            "location": "102/TALK",
            "narrator": "繭",
            "text": "まさか、この短時間で\nこの回線の存在に\n気づいたなんて…。",
            "zh": "没想到这么短的时间，\n她就发现了\n这条线路的存在……",
            "narrator_zh": "茧"
        },
        {
            "location": "103/TALK",
            "narrator": "繭",
            "text": "…さすがですね、\nクイーン。",
            "zh": "……不愧是\n女王。",
            "narrator_zh": "茧"
        },
        {
            "location": "120/TALK",
            "narrator": "みやび",
            "text": "よし…ウサギが\n手伝ってくれるなら\nもう安心や。",
            "zh": "好……兔子肯\n帮忙的话\n就安心咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "121/TALK",
            "narrator": "みやび",
            "text": "これで作業が\n大幅にラクに\nなったがよ…。",
            "zh": "这下作业\n轻省了\n一大截咯……",
            "narrator_zh": "雅"
        },
        {
            "location": "122/SEL",
            "narrator": "",
            "text": "ずいぶん信頼してるね",
            "zh": "很信任她嘛",
            "narrator_zh": ""
        },
        {
            "location": "123/ACT",
            "narrator": "",
            "text": "ずいぶん信頼してるね",
            "zh": "很信任她嘛",
            "narrator_zh": ""
        },
        {
            "location": "130/TALK",
            "narrator": "みやび",
            "text": "当然",
            "zh": "当然",
            "narrator_zh": "雅"
        },
        {
            "location": "131/TALK",
            "narrator": "みやび",
            "text": "一番の理解者だぞ",
            "zh": "是最懂我的啵",
            "narrator_zh": "雅"
        },
        {
            "location": "132/TALK",
            "narrator": "みやび",
            "text": "多分オッサンだが",
            "zh": "虽然多半是个大叔",
            "narrator_zh": "雅"
        },
        {
            "location": "133/TALK",
            "narrator": "みやび",
            "text": "ウサギはな",
            "zh": "兔子啊",
            "narrator_zh": "雅"
        },
        {
            "location": "134/TALK",
            "narrator": "みやび",
            "text": "管理庁に不信感を抱いたうちを",
            "zh": "对管理厅抱起疑心的我",
            "narrator_zh": "雅"
        },
        {
            "location": "135/TALK",
            "narrator": "みやび",
            "text": "初めて理解してくれた存在なのだ",
            "zh": "她就是第一个理解我的存在",
            "narrator_zh": "雅"
        },
        {
            "location": "136/TALK",
            "narrator": "みやび",
            "text": "多分オッサンだが",
            "zh": "虽然多半是个大叔",
            "narrator_zh": "雅"
        },
        {
            "location": "137/TALK",
            "narrator": "みやび",
            "text": "それだけではない",
            "zh": "还不止这些",
            "narrator_zh": "雅"
        },
        {
            "location": "138/TALK",
            "narrator": "みやび",
            "text": "管理庁にバレたら",
            "zh": "就算是被管理厅发现",
            "narrator_zh": "雅"
        },
        {
            "location": "139/TALK",
            "narrator": "みやび",
            "text": "一発逮捕＆国家反逆罪レベルのハッキングでも",
            "zh": "也照样干必被逮捕＋叛国罪级别的黑客活",
            "narrator_zh": "雅"
        },
        {
            "location": "140/TALK",
            "narrator": "みやび",
            "text": "躊躇なく実行する命知らず",
            "zh": "毫不犹豫就执行的亡命徒",
            "narrator_zh": "雅"
        },
        {
            "location": "141/TALK",
            "narrator": "みやび",
            "text": "超頼りになる",
            "zh": "超靠得住",
            "narrator_zh": "雅"
        },
        {
            "location": "142/TALK",
            "narrator": "みやび",
            "text": "あいつがいなかったら",
            "zh": "要是没有那家伙",
            "narrator_zh": "雅"
        },
        {
            "location": "143/TALK",
            "narrator": "みやび",
            "text": "今のうちはないだろう",
            "zh": "就没有现在的我了",
            "narrator_zh": "雅"
        },
        {
            "location": "144/TALK",
            "narrator": "みやび",
            "text": "マジな話",
            "zh": "真的",
            "narrator_zh": "雅"
        },
        {
            "location": "146/SEL",
            "narrator": "",
            "text": "本人聞いたら喜びそう",
            "zh": "本人听了估计会乐开花",
            "narrator_zh": ""
        },
        {
            "location": "147/ACT",
            "narrator": "",
            "text": "本人聞いたら喜びそう",
            "zh": "本人听了估计会乐开花",
            "narrator_zh": ""
        },
        {
            "location": "149/TALK",
            "narrator": "みやび",
            "text": "言う必要はない",
            "zh": "没必要说",
            "narrator_zh": "雅"
        },
        {
            "location": "150/TALK",
            "narrator": "みやび",
            "text": "なぜなら",
            "zh": "因为",
            "narrator_zh": "雅"
        },
        {
            "location": "152/TALK",
            "narrator": "みやび",
            "text": "ツーカーの仲に",
            "zh": "都这么有默契了",
            "narrator_zh": "雅"
        },
        {
            "location": "153/TALK",
            "narrator": "みやび",
            "text": "無駄な会話はいらん",
            "zh": "用不着废话",
            "narrator_zh": "雅"
        },
        {
            "location": "154/TALK",
            "narrator": "みやび",
            "text": "よく覚えておくがよい",
            "zh": "好好记住咯",
            "narrator_zh": "雅"
        },
        {
            "location": "156/TALK",
            "narrator": "みやび",
            "text": "仕事に戻る",
            "zh": "回去干活了",
            "narrator_zh": "雅"
        },
        {
            "location": "161/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "162/TALK",
            "narrator": "みやび",
            "text": "しかし、改めて\n考えてみると\nマズいかねえ？",
            "zh": "不过，重新\n想一想，\n是不是有点糟？",
            "narrator_zh": "雅"
        },
        {
            "location": "163/TALK",
            "narrator": "みやび",
            "text": "ちっくと気を許し\n過ぎかもしれん。",
            "zh": "可能对兔子\n放松过头了。",
            "narrator_zh": "雅"
        },
        {
            "location": "164/TALK",
            "narrator": "みやび",
            "text": "…けんど、うちが\nトライナリーっ\nちゅう事実。",
            "zh": "……但是，我是\n三重奏\n这个事实。",
            "narrator_zh": "雅"
        },
        {
            "location": "165/TALK",
            "narrator": "みやび",
            "text": "これが\nバレるようなヘマは\nしちょらんはずや。",
            "zh": "应该没做过\n会把它泄露出去的\n蠢事咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "166/TALK",
            "narrator": "みやび",
            "text": "自分が管理庁の下で\n働いちょる人間と\nバレるわけにはいかん。",
            "zh": "绝不能被发现自己是\n在管理厅手下\n干活的人。",
            "narrator_zh": "雅"
        },
        {
            "location": "167/TALK",
            "narrator": "みやび",
            "text": "バレたらウサギは\n間違いなくうちから\n去ってしまうちや…。",
            "zh": "一旦暴露，兔子\n绝对会从我\n身边离开滴……",
            "narrator_zh": "雅"
        },
        {
            "location": "168/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "169/TALK",
            "narrator": "みやび",
            "text": "いや、いかん。\n今は任務中やき、\n作業に集中せんと。",
            "zh": "不、不行。\n现在还在任务中嘛，\n得专心干活。",
            "narrator_zh": "雅"
        },
        {
            "location": "170/TALK",
            "narrator": "みやび",
            "text": "…けんど、ウサギは\n勘がえいきね。",
            "zh": "……但是，兔子\n直觉算灵的啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "171/TALK",
            "narrator": "みやび",
            "text": "いずれは自分で\n気づく可能性は\nあるな…。",
            "zh": "迟早有\n自己发现的\n可能啊……",
            "narrator_zh": "雅"
        },
        {
            "location": "172/TALK",
            "narrator": "みやび",
            "text": "なら、そうなる前に、\nうちの方からバラして\nしまうか？",
            "zh": "那不如趁那之前，\n由我自己\n先抖出来？",
            "narrator_zh": "雅"
        },
        {
            "location": "173/TALK",
            "narrator": "みやび",
            "text": "…いや、いやいや、\n身バレはハッカーの\n御法度や！",
            "zh": "……不、不行不行，\n暴露身份是黑客的\n大忌！",
            "narrator_zh": "雅"
        },
        {
            "location": "174/TALK",
            "narrator": "みやび",
            "text": "どうもウサギの\nことになると\n冷静になれんちや。",
            "zh": "一扯到兔子的事，\n就怎么也\n冷静不下来滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "175/TALK",
            "narrator": "みやび",
            "text": "………………。",
            "zh": "………………。",
            "narrator_zh": "雅"
        },
        {
            "location": "177/TALK",
            "narrator": "みやび",
            "text": "…ヤバい。\n作業に集中できん…。",
            "zh": "……糟了。\n没法集中干活了……",
            "narrator_zh": "雅"
        },
        {
            "location": "225/TALK",
            "narrator": "みやび",
            "text": "　",
            "zh": "　",
            "narrator_zh": "雅"
        },
        {
            "location": "241/TALK",
            "narrator": "みやび",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "雅"
        },
        {
            "location": "261/TALK",
            "narrator": "みやび",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "雅"
        },
        {
            "location": "264/TALK",
            "narrator": "みやび",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "雅"
        },
        {
            "location": "267/TALK",
            "narrator": "みやび",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "雅"
        },
        {
            "location": "271/SEL",
            "narrator": "",
            "text": "まだ寝てる！？",
            "zh": "还在睡！？",
            "narrator_zh": ""
        },
        {
            "location": "272/SEL",
            "narrator": "",
            "text": "もしかして死んでる！？",
            "zh": "难道是死了！？",
            "narrator_zh": ""
        },
        {
            "location": "273/ACT",
            "narrator": "",
            "text": "まだ寝てる！？",
            "zh": "还在睡！？",
            "narrator_zh": ""
        },
        {
            "location": "276/TALK",
            "narrator": "みやび",
            "text": "クワッ！！",
            "zh": "哇啊！！",
            "narrator_zh": "雅"
        },
        {
            "location": "277/TALK",
            "narrator": "みやび",
            "text": "やーい\n騙されおった。",
            "zh": "太天真咯，\n被骗到了啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "278/SEL",
            "narrator": "",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": ""
        },
        {
            "location": "279/ACT",
            "narrator": "",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": ""
        },
        {
            "location": "281/ACT",
            "narrator": "",
            "text": "もしかして死んでる！？",
            "zh": "难道是死了！？",
            "narrator_zh": ""
        },
        {
            "location": "282/TALK",
            "narrator": "みやび",
            "text": "ゾンビ～～…。",
            "zh": "僵尸～～……。",
            "narrator_zh": "雅"
        },
        {
            "location": "283/TALK",
            "narrator": "みやび",
            "text": "お前さんを喰わせろ～…",
            "zh": "把你喂给我吃～……",
            "narrator_zh": "雅"
        },
        {
            "location": "284/SEL",
            "narrator": "",
            "text": "何やってるんすか！",
            "zh": "你在搞什么啊！",
            "narrator_zh": ""
        },
        {
            "location": "285/SEL",
            "narrator": "",
            "text": "今から全裸になります！",
            "zh": "我现在就全裸！",
            "narrator_zh": ""
        },
        {
            "location": "286/ACT",
            "narrator": "",
            "text": "何やってるんすか！",
            "zh": "你在搞什么啊！",
            "narrator_zh": ""
        },
        {
            "location": "287/TALK",
            "narrator": "みやび",
            "text": "たまにはこうやって\n遊ばんと、マンネリに\nなるやろ。",
            "zh": "偶尔不这样\n玩一下，关系\n就要腻味了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "288/TALK",
            "narrator": "みやび",
            "text": "というわけで、\nゾンビなのは嘘やよ？",
            "zh": "所以呢，\n僵尸是骗你的哦？",
            "narrator_zh": "雅"
        },
        {
            "location": "289/SEL",
            "narrator": "",
            "text": "わかってますって…",
            "zh": "我早就知道了……",
            "narrator_zh": ""
        },
        {
            "location": "290/ACT",
            "narrator": "",
            "text": "わかってますって…",
            "zh": "我早就知道了……",
            "narrator_zh": ""
        },
        {
            "location": "292/ACT",
            "narrator": "",
            "text": "今から全裸になります！",
            "zh": "我现在就全裸！",
            "narrator_zh": ""
        },
        {
            "location": "293/TALK",
            "narrator": "みやび",
            "text": "しまった…。\n相棒は変態さんやったの\n忘れちょったが。",
            "zh": "失策……。\n忘了搭档是个\n变态了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "295/TALK",
            "narrator": "みやび",
            "text": "忘れんように、これから\n相棒のことは変態って\n呼ぶことにするか。",
            "zh": "为了不忘掉，以后\n就改口把搭档\n叫作变态吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "298/TALK",
            "narrator": "みやび",
            "text": "さて$ht$。\nいよいよ今回から\nMKCCの活動を開始する。",
            "zh": "好了$ht$。\n从这次开始，\nMKCC正式开始活动。",
            "narrator_zh": "雅"
        },
        {
            "location": "299/SEL",
            "narrator": "",
            "text": "何でも略せばいいってモンじゃないよ",
            "zh": "不是什么都能随便缩写的吧",
            "narrator_zh": ""
        },
        {
            "location": "300/SEL",
            "narrator": "",
            "text": "MKCCって？",
            "zh": "MKCC是什么？",
            "narrator_zh": ""
        },
        {
            "location": "301/ACT",
            "narrator": "",
            "text": "何でも略せばいいってモンじゃないよ",
            "zh": "不是什么都能随便缩写的吧",
            "narrator_zh": ""
        },
        {
            "location": "304/TALK",
            "narrator": "みやび",
            "text": "ふむ。\nいきなりお小言か。",
            "zh": "唔。\n上来就发牢骚啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "305/TALK",
            "narrator": "みやび",
            "text": "ならばよい。\n$ht$には何の略かは\n教えてやらん。",
            "zh": "那就随你。\n不告诉$ht$\n是什么的缩写。",
            "narrator_zh": "雅"
        },
        {
            "location": "306/ACT",
            "narrator": "",
            "text": "MKCCって？",
            "zh": "MKCC是什么？",
            "narrator_zh": ""
        },
        {
            "location": "308/TALK",
            "narrator": "みやび",
            "text": "$ht$には教えてやらんと\n言うたはずやけんど？",
            "zh": "不是说过不告诉\n$ht$了吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "309/TALK",
            "narrator": "みやび",
            "text": "けんど、１つだけ\nヒントをやろう。",
            "zh": "但是，给你\n一个提示吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "310/TALK",
            "narrator": "みやび",
            "text": "最後のCは\nカンパニーのCぞね。",
            "zh": "最后的C，\n是公司的C咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "312/TALK",
            "narrator": "みやび",
            "text": "ズバリ！\nみやびココロクラック\nカンパニー。",
            "zh": "谜底就是！\n雅科科罗库拉库\n公司。",
            "narrator_zh": "雅"
        },
        {
            "location": "315/SEL",
            "narrator": "",
            "text": "会社なんだ…",
            "zh": "原来是公司啊……",
            "narrator_zh": ""
        },
        {
            "location": "316/ACT",
            "narrator": "",
            "text": "会社なんだ…",
            "zh": "原来是公司啊……",
            "narrator_zh": ""
        },
        {
            "location": "318/TALK",
            "narrator": "みやび",
            "text": "うむ。\nよって資本金が\n必要である。",
            "zh": "嗯。\n所以需要\n注册资本。",
            "narrator_zh": "雅"
        },
        {
            "location": "319/SEL",
            "narrator": "",
            "text": "出資するよ",
            "zh": "我来出资",
            "narrator_zh": ""
        },
        {
            "location": "320/SEL",
            "narrator": "",
            "text": "出資するよ",
            "zh": "我来出资",
            "narrator_zh": ""
        },
        {
            "location": "321/SEL",
            "narrator": "",
            "text": "出資するよ",
            "zh": "我来出资",
            "narrator_zh": ""
        },
        {
            "location": "322/SEL",
            "narrator": "",
            "text": "出資するよ",
            "zh": "我来出资",
            "narrator_zh": ""
        },
        {
            "location": "323/SEL",
            "narrator": "",
            "text": "出資しない",
            "zh": "我不出资",
            "narrator_zh": ""
        },
        {
            "location": "324/ACT",
            "narrator": "",
            "text": "出資するよ",
            "zh": "我来出资",
            "narrator_zh": ""
        },
        {
            "location": "327/ACT",
            "narrator": "",
            "text": "出資するよ",
            "zh": "我来出资",
            "narrator_zh": ""
        },
        {
            "location": "330/ACT",
            "narrator": "",
            "text": "出資するよ",
            "zh": "我来出资",
            "narrator_zh": ""
        },
        {
            "location": "333/ACT",
            "narrator": "",
            "text": "出資するよ",
            "zh": "我来出资",
            "narrator_zh": ""
        },
        {
            "location": "337/TALK",
            "narrator": "みやび",
            "text": "おお。\nなんという太っ腹。",
            "zh": "哦哦。\n好豪爽啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "338/TALK",
            "narrator": "みやび",
            "text": "$ht$のお陰で\nMKCCは\n活動を続けられる。",
            "zh": "多亏了$ht$，\nMKCC得以\n继续活动。",
            "narrator_zh": "雅"
        },
        {
            "location": "339/ACT",
            "narrator": "",
            "text": "出資しない",
            "zh": "我不出资",
            "narrator_zh": ""
        },
        {
            "location": "340/TALK",
            "narrator": "みやび",
            "text": "なんぞ。\nけちくさい$ht$や。",
            "zh": "做驷马。\n$ht$真小气咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "343/TALK",
            "narrator": "みやび",
            "text": "さて、そんなわけで、\n早速$ht$には\n任務を与えるぞね。",
            "zh": "好了，既然如此，\n马上给$ht$\n布置任务咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "344/SEL",
            "narrator": "",
            "text": "承知しました",
            "zh": "遵命",
            "narrator_zh": ""
        },
        {
            "location": "345/SEL",
            "narrator": "",
            "text": "みやびは何もしないの？",
            "zh": "雅就什么都不做吗？",
            "narrator_zh": ""
        },
        {
            "location": "346/ACT",
            "narrator": "",
            "text": "承知しました",
            "zh": "遵命",
            "narrator_zh": ""
        },
        {
            "location": "347/TALK",
            "narrator": "みやび",
            "text": "うむ。\n「承知しました」とは。\nまっことえい響きやね。",
            "zh": "嗯。\n一句「遵命」。\n听着真是悦耳咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "348/ACT",
            "narrator": "",
            "text": "みやびは何もしないの？",
            "zh": "雅就什么都不做吗？",
            "narrator_zh": ""
        },
        {
            "location": "349/TALK",
            "narrator": "みやび",
            "text": "もちろんやるがね。\nしかし、まずは部下に\n指示出しをせんと。",
            "zh": "我当然要干咯。\n不过，首先得\n给部下下指示。",
            "narrator_zh": "雅"
        },
        {
            "location": "351/TALK",
            "narrator": "みやび",
            "text": "さて$ht$君。\n早速任務の話やけんど、\n君は知っているかね。",
            "zh": "好了$ht$。\n马上就说任务的事，\n你可知道咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "352/TALK",
            "narrator": "みやび",
            "text": "つばめちゃんの\nココロの司書が\n更迭されたそうや。",
            "zh": "听说燕的\n心之司书\n被换掉了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "353/SEL",
            "narrator": "",
            "text": "知ってる",
            "zh": "知道",
            "narrator_zh": ""
        },
        {
            "location": "354/SEL",
            "narrator": "",
            "text": "知らなかった",
            "zh": "不知道",
            "narrator_zh": ""
        },
        {
            "location": "355/ACT",
            "narrator": "",
            "text": "知ってる",
            "zh": "知道",
            "narrator_zh": ""
        },
        {
            "location": "356/TALK",
            "narrator": "みやび",
            "text": "ふむ。\nならば話は早い。",
            "zh": "唔。\n那话就好说了。",
            "narrator_zh": "雅"
        },
        {
            "location": "357/ACT",
            "narrator": "",
            "text": "知らなかった",
            "zh": "不知道",
            "narrator_zh": ""
        },
        {
            "location": "358/TALK",
            "narrator": "みやび",
            "text": "情弱やね。",
            "zh": "消息真不灵通咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "360/TALK",
            "narrator": "みやび",
            "text": "そもそも司書の更迭とは\nどういった事なのか。",
            "zh": "首先，司书的更替\n究竟是怎么一回事。",
            "narrator_zh": "雅"
        },
        {
            "location": "361/TALK",
            "narrator": "みやび",
            "text": "そんな話は\n聞いたことがない。",
            "zh": "这种事我\n从没听说过。",
            "narrator_zh": "雅"
        },
        {
            "location": "362/TALK",
            "narrator": "みやび",
            "text": "だいたいあれよ、\nうちが前に言ったとおり、\n司書は閑職や。",
            "zh": "再说就像我\n之前讲的那样，\n司书就是个闲职。",
            "narrator_zh": "雅"
        },
        {
            "location": "363/TALK",
            "narrator": "みやび",
            "text": "その司書が更迭となれば、\n次はどこへ行く？\n行き場なぞないんよ。",
            "zh": "那司书一旦被换掉，\n接下来去哪里？\n根本没得去处咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "364/SEL",
            "narrator": "",
            "text": "それじゃつばめの司書は…",
            "zh": "那燕的司书就……",
            "narrator_zh": ""
        },
        {
            "location": "365/ACT",
            "narrator": "",
            "text": "それじゃつばめの司書は…",
            "zh": "那燕的司书就……",
            "narrator_zh": ""
        },
        {
            "location": "367/TALK",
            "narrator": "みやび",
            "text": "うむ。\n既にこの世には\nいないかもしれんね。",
            "zh": "嗯。\n搞不好已经\n不在这世上了。",
            "narrator_zh": "雅"
        },
        {
            "location": "368/SEL",
            "narrator": "",
            "text": "そんな…",
            "zh": "怎么会……",
            "narrator_zh": ""
        },
        {
            "location": "369/ACT",
            "narrator": "",
            "text": "そんな…",
            "zh": "怎么会……",
            "narrator_zh": ""
        },
        {
            "location": "371/TALK",
            "narrator": "みやび",
            "text": "まあ実際はどうなったかは\n調べてみん事には\nわからんけんど。",
            "zh": "嘛，实际结果如何，\n不查一查\n是不会懂的，但是。",
            "narrator_zh": "雅"
        },
        {
            "location": "372/TALK",
            "narrator": "みやび",
            "text": "そしてうちは\nクラッカーや。",
            "zh": "而我，\n就是黑客。",
            "narrator_zh": "雅"
        },
        {
            "location": "373/TALK",
            "narrator": "みやび",
            "text": "うちが本気を出せば、\nつばめちゃんの司書の\nその後調査など楽勝。",
            "zh": "只要我认真起来，\n查燕的司书\n后来怎样，轻松得很。",
            "narrator_zh": "雅"
        },
        {
            "location": "374/TALK",
            "narrator": "みやび",
            "text": "そしてそれを調べることは\n本来の目的である、うちの\nココロクラックに役立つ。",
            "zh": "而且查明此事，\n对我本来的目的——\n科科罗库拉库也有用。",
            "narrator_zh": "雅"
        },
        {
            "location": "375/SEL",
            "narrator": "",
            "text": "それじゃ早速調べよう",
            "zh": "那就马上调查吧",
            "narrator_zh": ""
        },
        {
            "location": "376/SEL",
            "narrator": "",
            "text": "なんで役にたつの？",
            "zh": "为什么会有用？",
            "narrator_zh": ""
        },
        {
            "location": "377/ACT",
            "narrator": "",
            "text": "それじゃ早速調べよう",
            "zh": "那就马上调查吧",
            "narrator_zh": ""
        },
        {
            "location": "378/TALK",
            "narrator": "みやび",
            "text": "うむ。",
            "zh": "嗯。",
            "narrator_zh": "雅"
        },
        {
            "location": "379/ACT",
            "narrator": "",
            "text": "なんで役にたつの？",
            "zh": "为什么会有用？",
            "narrator_zh": ""
        },
        {
            "location": "381/TALK",
            "narrator": "みやび",
            "text": "えい質問やね。",
            "zh": "好问题咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "382/TALK",
            "narrator": "みやび",
            "text": "もしつばめちゃんの司書が\n目に見えるところに存在\nしなくなっている場合――",
            "zh": "如果燕的司书已经\n不在看得见的地方\n存在了的话——",
            "narrator_zh": "雅"
        },
        {
            "location": "383/TALK",
            "narrator": "みやび",
            "text": "目に見えないところ、\nすなわち「閉架」された\nココロにいるやもしれん。",
            "zh": "就是待在看不见的地方，\n也就是被「闭架」的\n心里，也说不定。",
            "narrator_zh": "雅"
        },
        {
            "location": "384/TALK",
            "narrator": "みやび",
            "text": "それを見つけるっちゅう\nことは、つまり……。",
            "zh": "而找出她来，\n就等于……",
            "narrator_zh": "雅"
        },
        {
            "location": "385/SEL",
            "narrator": "",
            "text": "閉架書庫のデータが取れる？",
            "zh": "能拿到闭架书库的数据？",
            "narrator_zh": ""
        },
        {
            "location": "386/ACT",
            "narrator": "",
            "text": "閉架書庫のデータが取れる？",
            "zh": "能拿到闭架书库的数据？",
            "narrator_zh": ""
        },
        {
            "location": "388/TALK",
            "narrator": "みやび",
            "text": "その通りや！\n$ht$賢いな。\n惚れてしまいそうや。",
            "zh": "答对了！\n$ht$真聪明。\n都快迷上你了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "390/TALK",
            "narrator": "みやび",
            "text": "けんど、その為には\n１つ材料が必要ぞね。",
            "zh": "但是，为此\n还差一样材料咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "391/TALK",
            "narrator": "みやび",
            "text": "そんで、それを\n$ht$に調達してきて\nもらいたいんよ。",
            "zh": "所以，想让$ht$\n去把它\n弄到手。",
            "narrator_zh": "雅"
        },
        {
            "location": "392/SEL",
            "narrator": "",
            "text": "何でしょう",
            "zh": "是什么呢",
            "narrator_zh": ""
        },
        {
            "location": "393/ACT",
            "narrator": "",
            "text": "何でしょう",
            "zh": "是什么呢",
            "narrator_zh": ""
        },
        {
            "location": "395/TALK",
            "narrator": "みやび",
            "text": "それは、つばめちゃんの\nココロの司書の名前や。",
            "zh": "那就是燕的\n心之司书名字咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "396/SEL",
            "narrator": "",
            "text": "あーそれなら知ってる",
            "zh": "啊那个的话我知道",
            "narrator_zh": ""
        },
        {
            "location": "397/SEL",
            "narrator": "",
            "text": "名前を調べてくればいいの？",
            "zh": "去把名字查来就行了吗？",
            "narrator_zh": ""
        },
        {
            "location": "398/ACT",
            "narrator": "",
            "text": "あーそれなら知ってる",
            "zh": "啊那个的话我知道",
            "narrator_zh": ""
        },
        {
            "location": "400/TALK",
            "narrator": "みやび",
            "text": "待ちぃや！",
            "zh": "等子！",
            "narrator_zh": "雅"
        },
        {
            "location": "401/TALK",
            "narrator": "みやび",
            "text": "その名前が何なのかは\n次回聞くことにする。",
            "zh": "那名字到底是什么，\n就留到下次再问。",
            "narrator_zh": "雅"
        },
        {
            "location": "402/TALK",
            "narrator": "みやび",
            "text": "今その名を聞くことは\nとても危険やきね。",
            "zh": "现在听那个名字\n非常危险嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "403/SEL",
            "narrator": "",
            "text": "なんで！？",
            "zh": "为什么！？",
            "narrator_zh": ""
        },
        {
            "location": "404/ACT",
            "narrator": "",
            "text": "なんで！？",
            "zh": "为什么！？",
            "narrator_zh": ""
        },
        {
            "location": "406/TALK",
            "narrator": "みやび",
            "text": "うむ。それは――",
            "zh": "嗯。那是——",
            "narrator_zh": "雅"
        },
        {
            "location": "407/TALK",
            "narrator": "みやび",
            "text": "たった今、\nMKCCの就業時間が\n終わったからや！",
            "zh": "因为就在刚才，\nMKCC的工作时间\n结束了！",
            "narrator_zh": "雅"
        },
        {
            "location": "408/TALK",
            "narrator": "みやび",
            "text": "これ以上働くと\n残業になってまうぞね！",
            "zh": "再干下去\n就要变加班了咧！",
            "narrator_zh": "雅"
        },
        {
            "location": "409/SEL",
            "narrator": "",
            "text": "残業…ですか",
            "zh": "加班……吗",
            "narrator_zh": ""
        },
        {
            "location": "410/ACT",
            "narrator": "",
            "text": "残業…ですか",
            "zh": "加班……吗",
            "narrator_zh": ""
        },
        {
            "location": "412/TALK",
            "narrator": "みやび",
            "text": "うちは残業は嫌や。\n更に、お前さんにも\n残業代払わんといかん。",
            "zh": "我讨厌加班。\n而且，还得付\n你加班费。",
            "narrator_zh": "雅"
        },
        {
            "location": "413/TALK",
            "narrator": "みやび",
            "text": "よって、おそるべき\nLOSE-LOSE！",
            "zh": "于是，可怕的\nLOSE-LOSE！",
            "narrator_zh": "雅"
        },
        {
            "location": "414/TALK",
            "narrator": "みやび",
            "text": "やき、名前は\n次回聞くことにするぞね。",
            "zh": "所以嘛，名字\n留到下次再问咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "415/SEL",
            "narrator": "",
            "text": "なんてホワイトな活動！",
            "zh": "多么良心的活动！",
            "narrator_zh": ""
        },
        {
            "location": "416/SEL",
            "narrator": "",
            "text": "まだ全然働いてないですよね？",
            "zh": "可我们根本还没干活吧？",
            "narrator_zh": ""
        },
        {
            "location": "417/ACT",
            "narrator": "",
            "text": "なんてホワイトな活動！",
            "zh": "多么良心的活动！",
            "narrator_zh": ""
        },
        {
            "location": "418/TALK",
            "narrator": "みやび",
            "text": "うむ。うちの秘密結社\nMKCCは、法定時間を守る\n優良結社やきね。",
            "zh": "嗯。我的秘密结社\nMKCC可是遵守法定工时的\n优良结社嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "419/TALK",
            "narrator": "みやび",
            "text": "そんなわけで、\n今日はおしまいや。",
            "zh": "所以呢，\n今天就到此为止咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "420/ACT",
            "narrator": "",
            "text": "まだ全然働いてないですよね？",
            "zh": "可我们根本还没干活吧？",
            "narrator_zh": ""
        },
        {
            "location": "421/TALK",
            "narrator": "みやび",
            "text": "そこを批判するとは、\nおのれブラック結社員め！",
            "zh": "连这点都要批判，\n你这黑心结社员！",
            "narrator_zh": "雅"
        },
        {
            "location": "422/SEL",
            "narrator": "",
            "text": "社員がブラックなの！？",
            "zh": "员工才是黑心的！？",
            "narrator_zh": ""
        },
        {
            "location": "423/ACT",
            "narrator": "",
            "text": "社員がブラックなの！？",
            "zh": "员工才是黑心的！？",
            "narrator_zh": ""
        },
        {
            "location": "425/TALK",
            "narrator": "みやび",
            "text": "上司（うち）に\n残業させるとは、\nブラックもいいとこや。",
            "zh": "让上司（我）\n加班，\n这黑心到家了。",
            "narrator_zh": "雅"
        },
        {
            "location": "426/TALK",
            "narrator": "みやび",
            "text": "とにかく、今日は\nもうお終いぞね。",
            "zh": "总之，今天就\n到此为止咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "428/ACT",
            "narrator": "",
            "text": "名前を調べてくればいいの？",
            "zh": "去把名字查来就行了吗？",
            "narrator_zh": ""
        },
        {
            "location": "429/TALK",
            "narrator": "みやび",
            "text": "その通りや。\n簡単なお仕事やろ？",
            "zh": "没错。\n是份简单的工作吧？",
            "narrator_zh": "雅"
        },
        {
            "location": "430/TALK",
            "narrator": "みやび",
            "text": "次回ここに来る時までに\nしっかり調べときや。",
            "zh": "下次来这里之前，\n好好查清楚啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "431/TALK",
            "narrator": "みやび",
            "text": "そんなわけで、\n今日はおしまいや。",
            "zh": "所以呢，\n今天就到此为止咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "433/TALK",
            "narrator": "みやび",
            "text": "ほんだら、またな。",
            "zh": "那就，下次见了啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "434/SEL",
            "narrator": "",
            "text": "ちょっと待て！",
            "zh": "等一下！",
            "narrator_zh": ""
        },
        {
            "location": "435/ACT",
            "narrator": "",
            "text": "ちょっと待て！",
            "zh": "等一下！",
            "narrator_zh": ""
        },
        {
            "location": "437/TALK",
            "narrator": "みやび",
            "text": "なんぞ。\n早速賃上げ要求か？",
            "zh": "做驷马。\n这就开始要求涨薪了咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "438/SEL",
            "narrator": "",
            "text": "クラン倒さなくていいの？",
            "zh": "库兰不用打吗？",
            "narrator_zh": ""
        },
        {
            "location": "439/ACT",
            "narrator": "",
            "text": "クラン倒さなくていいの？",
            "zh": "库兰不用打吗？",
            "narrator_zh": ""
        },
        {
            "location": "441/TALK",
            "narrator": "みやび",
            "text": "クラン…？",
            "zh": "库兰……？",
            "narrator_zh": "雅"
        },
        {
            "location": "442/TALK",
            "narrator": "みやび",
            "text": "おお、そうか！\nつい本業に夢中になって、\n本業を忘れておったぞね。",
            "zh": "哦，对啊！\n光顾着正业，\n把正业给忘了咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "443/TALK",
            "narrator": "みやび",
            "text": "ほんだらサッと\nやってまうか。",
            "zh": "那就麻溜地\n搞定它吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "446/TALK",
            "narrator": "みやび",
            "text": "オープンプロセス、\n0x112番地から\n0xB4F番地へ。",
            "zh": "开放进程，\n从0x112号地址\n转到0xB4F号地址。",
            "narrator_zh": "雅"
        },
        {
            "location": "468/TALK",
            "narrator": "みやび",
            "text": "完了。",
            "zh": "完成。",
            "narrator_zh": "雅"
        },
        {
            "location": "471/TALK",
            "narrator": "みやび",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "雅"
        },
        {
            "location": "472/TALK",
            "narrator": "みやび",
            "text": "うちのココロの\n雑念の元になっちゅう\nクランを倒しや。",
            "zh": "去打倒那群\n成了我心里杂念\n根源的库兰吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "473/TALK",
            "narrator": "みやび",
            "text": "以上！\nほんだらいくぞね！",
            "zh": "完毕！\n那就出发咯！",
            "narrator_zh": "雅"
        },
        {
            "location": "474/SEL",
            "narrator": "",
            "text": "早っ！",
            "zh": "好快！",
            "narrator_zh": ""
        },
        {
            "location": "475/ACT",
            "narrator": "",
            "text": "早っ！",
            "zh": "好快！",
            "narrator_zh": ""
        },
        {
            "location": "477/TALK",
            "narrator": "みやび",
            "text": "それ以上に語ることも\nないきね。",
            "zh": "比这更多的说明，\n就没得咯嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "478/TALK",
            "narrator": "みやび",
            "text": "それより早く切り上げて、\nアフター５を楽しむちや。",
            "zh": "比起这个，早点收工\n享受下班后时光才对滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "480/TALK",
            "narrator": "みやび",
            "text": "うちと$handle$に\nえいココロの旅を。",
            "zh": "愿我和$handle$\n有美好的心之旅程。",
            "narrator_zh": "雅"
        },
