{
    "dir": "chap24/daydra/dd_ch04_24_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "24405",
        "cid": "miyabi",
        "title": "005 メインストーリー",
        "sub_title": "貴方を案ずる手紙＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "挂念你的信＜后篇＞"
    },
    "entry": [
        {
            "location": "542/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "543/TALK",
            "narrator": "みやび",
            "text": "いや、違うな。",
            "zh": "不，不对咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "555/TALK",
            "narrator": "みやび",
            "text": "結論",
            "zh": "结论",
            "narrator_zh": "雅"
        },
        {
            "location": "556/TALK",
            "narrator": "みやび",
            "text": "やはりうちは正しい",
            "zh": "我还是对的",
            "narrator_zh": "雅"
        },
        {
            "location": "557/TALK",
            "narrator": "みやび",
            "text": "うちは卯月に対して怒ってない",
            "zh": "我没有对卯月生气",
            "narrator_zh": "雅"
        },
        {
            "location": "558/TALK",
            "narrator": "みやび",
            "text": "証拠もあるので間違いない",
            "zh": "还有证据，错不了",
            "narrator_zh": "雅"
        },
        {
            "location": "560/SEL",
            "narrator": "",
            "text": "どんな証拠？",
            "zh": "什么样的证据？",
            "narrator_zh": ""
        },
        {
            "location": "561/ACT",
            "narrator": "",
            "text": "どんな証拠？",
            "zh": "什么样的证据？",
            "narrator_zh": ""
        },
        {
            "location": "563/TALK",
            "narrator": "みやび",
            "text": "うちは卯月を責めていない",
            "zh": "我没有责备卯月",
            "narrator_zh": "雅"
        },
        {
            "location": "564/TALK",
            "narrator": "みやび",
            "text": "許さんとも思うてない",
            "zh": "也没想过要原谅她",
            "narrator_zh": "雅"
        },
        {
            "location": "565/TALK",
            "narrator": "みやび",
            "text": "謝って責任を取り",
            "zh": "只要道歉并负责",
            "narrator_zh": "雅"
        },
        {
            "location": "566/TALK",
            "narrator": "みやび",
            "text": "条件さえ整えば再び受け入れる気でいる",
            "zh": "只要条件凑齐，我就有重新接纳的打算",
            "narrator_zh": "雅"
        },
        {
            "location": "567/TALK",
            "narrator": "みやび",
            "text": "これが証拠や",
            "zh": "这就是证据咯",
            "narrator_zh": "雅"
        },
        {
            "location": "569/SEL",
            "narrator": "",
            "text": "謝って責任とるだけじゃダメなの？",
            "zh": "光道歉负责还不够吗？",
            "narrator_zh": ""
        },
        {
            "location": "570/ACT",
            "narrator": "",
            "text": "謝って責任とるだけじゃダメなの？",
            "zh": "光道歉负责还不够吗？",
            "narrator_zh": ""
        },
        {
            "location": "572/TALK",
            "narrator": "みやび",
            "text": "当たり前や",
            "zh": "那是当然咯",
            "narrator_zh": "雅"
        },
        {
            "location": "573/TALK",
            "narrator": "みやび",
            "text": "謝罪と責任程度で済む話か？",
            "zh": "是道歉负责就能了结的事吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "574/TALK",
            "narrator": "みやび",
            "text": "卯月はスパイや",
            "zh": "卯月是间谍咯",
            "narrator_zh": "雅"
        },
        {
            "location": "575/TALK",
            "narrator": "みやび",
            "text": "またうちらをスパイする必要が出れば",
            "zh": "如果又出现需要侦察我们的情况",
            "narrator_zh": "雅"
        },
        {
            "location": "576/TALK",
            "narrator": "みやび",
            "text": "謝罪と責任を取る程度のこと",
            "zh": "道歉负责这种程度的事",
            "narrator_zh": "雅"
        },
        {
            "location": "578/TALK",
            "narrator": "みやび",
            "text": "平然とやるに違いない",
            "zh": "她肯定面不改色地照做",
            "narrator_zh": "雅"
        },
        {
            "location": "579/TALK",
            "narrator": "みやび",
            "text": "いや",
            "zh": "不",
            "narrator_zh": "雅"
        },
        {
            "location": "580/TALK",
            "narrator": "みやび",
            "text": "スパイならやると考えるべき",
            "zh": "是间谍就该认定她会做",
            "narrator_zh": "雅"
        },
        {
            "location": "581/TALK",
            "narrator": "みやび",
            "text": "なので",
            "zh": "所以说",
            "narrator_zh": "雅"
        },
        {
            "location": "582/TALK",
            "narrator": "みやび",
            "text": "卯月神楽が",
            "zh": "卯月神乐",
            "narrator_zh": "雅"
        },
        {
            "location": "583/TALK",
            "narrator": "みやび",
            "text": "スパイであることに何の理由もなくなる状況",
            "zh": "不再是间谍也不需要任何理由的状况",
            "narrator_zh": "雅"
        },
        {
            "location": "584/TALK",
            "narrator": "みやび",
            "text": "それが必要になる",
            "zh": "那就成了必要条件",
            "narrator_zh": "雅"
        },
        {
            "location": "585/TALK",
            "narrator": "みやび",
            "text": "そうなれば",
            "zh": "真到那时候",
            "narrator_zh": "雅"
        },
        {
            "location": "586/TALK",
            "narrator": "みやび",
            "text": "再び受け入れることも可能やね",
            "zh": "重新接纳也有可能咯",
            "narrator_zh": "雅"
        },
        {
            "location": "588/SEL",
            "narrator": "",
            "text": "そんな状況ありえるの？",
            "zh": "有那种状况吗？",
            "narrator_zh": ""
        },
        {
            "location": "589/SEL",
            "narrator": "",
            "text": "それを聞けて安心した",
            "zh": "听到这个我就放心了",
            "narrator_zh": ""
        },
        {
            "location": "590/ACT",
            "narrator": "",
            "text": "そんな状況ありえるの？",
            "zh": "有那种状况吗？",
            "narrator_zh": ""
        },
        {
            "location": "591/TALK",
            "narrator": "みやび",
            "text": "そんなもん知らん",
            "zh": "那种事我哪知道",
            "narrator_zh": "雅"
        },
        {
            "location": "592/TALK",
            "narrator": "みやび",
            "text": "あるかもしれんが",
            "zh": "说不定有咯",
            "narrator_zh": "雅"
        },
        {
            "location": "593/TALK",
            "narrator": "みやび",
            "text": "ないかもしれん",
            "zh": "也可能没得",
            "narrator_zh": "雅"
        },
        {
            "location": "594/TALK",
            "narrator": "みやび",
            "text": "それが具体的にどういう状況なのか",
            "zh": "那具体是什么样的状况",
            "narrator_zh": "雅"
        },
        {
            "location": "595/TALK",
            "narrator": "みやび",
            "text": "それもうちにはわからん",
            "zh": "我也不懂咯",
            "narrator_zh": "雅"
        },
        {
            "location": "596/TALK",
            "narrator": "みやび",
            "text": "けんど",
            "zh": "但是",
            "narrator_zh": "雅"
        },
        {
            "location": "597/TALK",
            "narrator": "みやび",
            "text": "そうやなければ受け入れられん",
            "zh": "不那样的话没法接纳",
            "narrator_zh": "雅"
        },
        {
            "location": "598/TALK",
            "narrator": "みやび",
            "text": "不安が残るきね",
            "zh": "会留下不安嘛",
            "narrator_zh": "雅"
        },
        {
            "location": "599/TALK",
            "narrator": "みやび",
            "text": "それに",
            "zh": "再说",
            "narrator_zh": "雅"
        },
        {
            "location": "600/TALK",
            "narrator": "みやび",
            "text": "卯月も安心して戻れんだろうし",
            "zh": "卯月自己也没法安心回来吧",
            "narrator_zh": "雅"
        },
        {
            "location": "603/TALK",
            "narrator": "みやび",
            "text": "けんどまあ",
            "zh": "但是嘛",
            "narrator_zh": "雅"
        },
        {
            "location": "604/TALK",
            "narrator": "みやび",
            "text": "卯月が戻ってきたいと思っているのか",
            "zh": "卯月到底想不想回来",
            "narrator_zh": "雅"
        },
        {
            "location": "605/TALK",
            "narrator": "みやび",
            "text": "それすら今はわからんのやし",
            "zh": "现在连这个都不懂咯",
            "narrator_zh": "雅"
        },
        {
            "location": "606/TALK",
            "narrator": "みやび",
            "text": "この話題はまだ早すぎるな",
            "zh": "这个话题还太早咯",
            "narrator_zh": "雅"
        },
        {
            "location": "607/ACT",
            "narrator": "",
            "text": "それを聞けて安心した",
            "zh": "听到这个我就放心了",
            "narrator_zh": ""
        },
        {
            "location": "608/TALK",
            "narrator": "みやび",
            "text": "何故安心できるのか？",
            "zh": "为什么能安心？",
            "narrator_zh": "雅"
        },
        {
            "location": "609/TALK",
            "narrator": "みやび",
            "text": "今うちが言うた条件",
            "zh": "我刚才说的条件",
            "narrator_zh": "雅"
        },
        {
            "location": "610/TALK",
            "narrator": "みやび",
            "text": "かなり酷やぞ？",
            "zh": "相当苛刻咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "611/TALK",
            "narrator": "みやび",
            "text": "ぶっちゃけほぼ無理レベルやし",
            "zh": "老实说基本是不可能达成的",
            "narrator_zh": "雅"
        },
        {
            "location": "612/TALK",
            "narrator": "みやび",
            "text": "それわかってる？",
            "zh": "这点你懂吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "614/SEL",
            "narrator": "",
            "text": "条件がわかってるだけでも安心",
            "zh": "至少条件明确，就已经让人安心",
            "narrator_zh": ""
        },
        {
            "location": "615/ACT",
            "narrator": "",
            "text": "条件がわかってるだけでも安心",
            "zh": "至少条件明确，就已经让人安心",
            "narrator_zh": ""
        },
        {
            "location": "617/TALK",
            "narrator": "みやび",
            "text": "そういうもんか？",
            "zh": "是那样咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "618/TALK",
            "narrator": "みやび",
            "text": "まあぶっちゃけ",
            "zh": "嘛，老实说",
            "narrator_zh": "雅"
        },
        {
            "location": "619/TALK",
            "narrator": "みやび",
            "text": "それが一番えい結果なのは確かやね",
            "zh": "那确实是最好的结果咯",
            "narrator_zh": "雅"
        },
        {
            "location": "620/TALK",
            "narrator": "みやび",
            "text": "ゲームで言うならベストエンド",
            "zh": "用游戏来说就是最佳结局",
            "narrator_zh": "雅"
        },
        {
            "location": "621/TALK",
            "narrator": "みやび",
            "text": "超絶難易度を超えた先にある真のエンディングとは！？",
            "zh": "跨越超高难度后所至的真结局！？",
            "narrator_zh": "雅"
        },
        {
            "location": "622/TALK",
            "narrator": "みやび",
            "text": "みたいな？",
            "zh": "诸如此类？",
            "narrator_zh": "雅"
        },
        {
            "location": "623/TALK",
            "narrator": "みやび",
            "text": "しかもセーブもロードもなし",
            "zh": "而且还没有存档和读档",
            "narrator_zh": "雅"
        },
        {
            "location": "624/TALK",
            "narrator": "みやび",
            "text": "現実は厳しい",
            "zh": "现实很残酷",
            "narrator_zh": "雅"
        },
        {
            "location": "625/TALK",
            "narrator": "みやび",
            "text": "あまり期待はせん方がえいよ",
            "zh": "还是别抱太大期待比较好咯",
            "narrator_zh": "雅"
        },
        {
            "location": "627/TALK",
            "narrator": "みやび",
            "text": "まあ結局のとこ",
            "zh": "嘛，说到底",
            "narrator_zh": "雅"
        },
        {
            "location": "628/TALK",
            "narrator": "みやび",
            "text": "卯月が今後どう動くか",
            "zh": "卯月今后会怎么动",
            "narrator_zh": "雅"
        },
        {
            "location": "629/TALK",
            "narrator": "みやび",
            "text": "それを見てからやね",
            "zh": "看到之后再定咯",
            "narrator_zh": "雅"
        },
        {
            "location": "640/TALK",
            "narrator": "みやび",
            "text": "はぁ…。\n小さい画面で長話は\n目に来るなぁ…。",
            "zh": "唉……。\n在小屏幕上长聊，\n伤眼睛咯……",
            "narrator_zh": "雅"
        },
        {
            "location": "646/TALK",
            "narrator": "みやび",
            "text": "…ったく、\n今度は誰や！？",
            "zh": "……真是的，\n这次又是谁！？",
            "narrator_zh": "雅"
        },
        {
            "location": "647/TALK",
            "narrator": "みやび",
            "text": "はい、もしもし？",
            "zh": "喂，你好？",
            "narrator_zh": "雅"
        },
        {
            "location": "648/TALK",
            "narrator": "透明真幌",
            "text": "私だ。",
            "zh": "是我。",
            "narrator_zh": "透明真幌"
        },
        {
            "location": "649/TALK",
            "narrator": "みやび",
            "text": "ああ、まほさん。\n管理庁への申し立ては\nどうなって――",
            "zh": "哦，真幌。\n向管理厅的申诉\n怎么样了——",
            "narrator_zh": "雅"
        },
        {
            "location": "650/TALK",
            "narrator": "透明真幌",
            "text": "その話はあとだ。\nいいか、よく聞け。",
            "zh": "那件事回头再说。\n听好，仔细听。",
            "narrator_zh": "透明真幌"
        },
        {
            "location": "651/TALK",
            "narrator": "透明真幌",
            "text": "今すぐ全員を集めて、\n準備を開始するんだ。",
            "zh": "现在马上把所有人集合，\n开始准备。",
            "narrator_zh": "透明真幌"
        },
        {
            "location": "653/TALK",
            "narrator": "みやび",
            "text": "準備？",
            "zh": "准备？",
            "narrator_zh": "雅"
        },
        {
            "location": "654/TALK",
            "narrator": "透明真幌",
            "text": "そうだ。",
            "zh": "没错。",
            "narrator_zh": "透明真幌"
        },
        {
            "location": "655/TALK",
            "narrator": "透明真幌",
            "text": "現時刻をもって、\n我々は無期限の\nストライキに入る！",
            "zh": "从现在这一刻起，\n我们进入\n无限期罢工！",
            "narrator_zh": "透明真幌"
        },
        {
            "location": "656/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "657/TALK",
            "narrator": "みやび",
            "text": "はい？",
            "zh": "咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "669/DIALOG",
            "narrator": "Dialog_chapter_ch04",
            "text": "【20 ２０１６】",
            "zh": "【20 ２０１６】",
            "narrator_zh": "Dialog_chapter_ch04"
        }
    ]
}
