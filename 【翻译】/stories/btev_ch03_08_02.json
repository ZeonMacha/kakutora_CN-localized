        "title": "015 ココロスフィアストーリー【Lv05】",
        "sub_title": "母とは何たるか＜帰結＞",
        "title_zh": "015 心灵领域故事【Lv05】",
        "sub_title_zh": "母亲究竟是什么＜归结＞"
    },
    "entry": [
        {
            "location": "301/TALK",
            "narrator": "ガブリエラ",
            "text": "……！？",
            "zh": "……！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "302/SEL",
            "narrator": "（選択肢）",
            "text": "どう？落ち着いた？",
            "zh": "怎么样？冷静下来了吗？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "303/ACT",
            "narrator": "",
            "text": "どう？落ち着いた？",
            "zh": "怎么样？冷静下来了吗？",
            "narrator_zh": ""
        },
        {
            "location": "305/TALK",
            "narrator": "ガブリエラ",
            "text": "え、ええ…",
            "zh": "嗯、嗯……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "306/SEL",
            "narrator": "（選択肢）",
            "text": "良かった",
            "zh": "太好了",
            "narrator_zh": "（选项）"
        },
        {
            "location": "307/SEL",
            "narrator": "（選択肢）",
            "text": "すごいことしたね",
            "zh": "刚才真够惊人的呢",
            "narrator_zh": "（选项）"
        },
        {
            "location": "308/ACT",
            "narrator": "",
            "text": "良かった",
            "zh": "太好了",
            "narrator_zh": ""
        },
        {
            "location": "309/TALK",
            "narrator": "ガブリエラ",
            "text": "ありがと…",
            "zh": "谢谢……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "310/ACT",
            "narrator": "",
            "text": "すごいことしたね",
            "zh": "刚才真够惊人的呢",
            "narrator_zh": ""
        },
        {
            "location": "311/TALK",
            "narrator": "ガブリエラ",
            "text": "ご、ごめん…なさい。",
            "zh": "对、对不……起。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "312/SEL",
            "narrator": "（選択肢）",
            "text": "ココロスフィアの中で良かったよ",
            "zh": "还好是在心灵领域里啊",
            "narrator_zh": "（选项）"
        },
        {
            "location": "313/SEL",
            "narrator": "（選択肢）",
            "text": "ガブリエラが素直に謝った！？",
            "zh": "加布里埃拉居然老老实实道歉了！？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "314/ACT",
            "narrator": "",
            "text": "ココロスフィアの中で良かったよ",
            "zh": "还好是在心灵领域里啊",
            "narrator_zh": ""
        },
        {
            "location": "315/TALK",
            "narrator": "ガブリエラ",
            "text": "さすがに現実では\nやらないわよ。",
            "zh": "在现实里我哪可能\n做得出来啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "316/TALK",
            "narrator": "ガブリエラ",
            "text": "ココロの中には\n何十、何百にも重なる\nフィルターがあるもの。",
            "zh": "人的心里\n可是隔着几十层、上百层\n滤网的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "317/TALK",
            "narrator": "ガブリエラ",
            "text": "それが無くなるくらい\nココロが壊れなければ\n１００％やらないわ。",
            "zh": "只要心没有坏到\n连那些全都消失的地步，\n100%不可能这么做。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "318/ACT",
            "narrator": "",
            "text": "ガブリエラが素直に謝った！？",
            "zh": "加布里埃拉居然老老实实道歉了！？",
            "narrator_zh": ""
        },
        {
            "location": "320/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょっ！！\nなによそれ！",
            "zh": "等下！！\n你那是什么话！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "321/TALK",
            "narrator": "ガブリエラ",
            "text": "まるであたしが\nツンデレみたい\nじゃない！",
            "zh": "搞得好像我\n是个傲娇\n一样嘛！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "322/SEL",
            "narrator": "（選択肢）",
            "text": "え？違うと思ってるの！？",
            "zh": "诶？难道你觉得自己不是吗！？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "323/SEL",
            "narrator": "（選択肢）",
            "text": "意味が分かりません",
            "zh": "我听不懂你在说什么",
            "narrator_zh": "（选项）"
        },
        {
            "location": "324/ACT",
            "narrator": "",
            "text": "え？違うと思ってるの！？",
            "zh": "诶？难道你觉得自己不是吗！？",
            "narrator_zh": ""
        },
        {
            "location": "325/TALK",
            "narrator": "ガブリエラ",
            "text": "違うに\n決まってるでしょ！",
            "zh": "那当然\n不是了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "326/SEL",
            "narrator": "（選択肢）",
            "text": "さすがツンデレ。感動した",
            "zh": "不愧是傲娇。感动了",
            "narrator_zh": "（选项）"
        },
        {
            "location": "327/ACT",
            "narrator": "",
            "text": "さすがツンデレ。感動した",
            "zh": "不愧是傲娇。感动了",
            "narrator_zh": ""
        },
        {
            "location": "329/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…もういいわ。\n話が全然\n前に進まないじゃない。",
            "zh": "哈啊……够了。\n这样话题完全\n没法往下聊了好不好。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "330/ACT",
            "narrator": "",
            "text": "意味が分かりません",
            "zh": "我听不懂你在说什么",
            "narrator_zh": ""
        },
        {
            "location": "331/TALK",
            "narrator": "ガブリエラ",
            "text": "頭悪いわね。",
            "zh": "你脑子真笨呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "332/TALK",
            "narrator": "ガブリエラ",
            "text": "素直に謝らないのは\nツンデレでしょ？",
            "zh": "不坦率道歉的才叫\n傲娇吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "333/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしはそんなこと\n無いから、ツンデレじゃ\nないって言ってるのよ。",
            "zh": "我又没有那样，\n所以我才说我不是\n傲娇嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "334/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…もういいわ。\n話が全然\n前に進まないじゃない。",
            "zh": "哈啊……够了。\n这样话题完全\n没法往下聊了好不好。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "338/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、どうして急に\nあんなことを\nしちゃったのかしら。",
            "zh": "不过，为什么我突然\n会做出那种事\n呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "339/SEL",
            "narrator": "（選択肢）",
            "text": "ガブリエラのお母さんって本当はどんな人だったの？",
            "zh": "加布里埃拉的妈妈原本是个什么样的人呀？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "340/SEL",
            "narrator": "（選択肢）",
            "text": "ガブリエラのお母さんって強盗に殺されたんだっけ？",
            "zh": "加布里埃拉的妈妈是被强盗杀害的对吧？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "341/ACT",
            "narrator": "",
            "text": "ガブリエラのお母さんって本当はどんな人だったの？",
            "zh": "加布里埃拉的妈妈原本是个什么样的人呀？",
            "narrator_zh": ""
        },
        {
            "location": "342/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしの\nお母さん……？",
            "zh": "我的\n妈妈……？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "343/TALK",
            "narrator": "ガブリエラ",
            "text": "……正直、\nあまり覚えてないの。",
            "zh": "……说实话，\n不太记得了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "344/TALK",
            "narrator": "ガブリエラ",
            "text": "殺されたの、\n初等部の頃だったし。",
            "zh": "她遇害的时候，\n我还在小学部呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "345/SEL",
            "narrator": "（選択肢）",
            "text": "ショックだったよね",
            "zh": "当时肯定打击很大吧",
            "narrator_zh": "（选项）"
        },
        {
            "location": "346/SEL",
            "narrator": "（選択肢）",
            "text": "初等部の頃だったら普通覚えてるのでは？",
            "zh": "小学部那会儿的话，一般不都还记得吗？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "347/ACT",
            "narrator": "",
            "text": "ショックだったよね",
            "zh": "当时肯定打击很大吧",
            "narrator_zh": ""
        },
        {
            "location": "348/TALK",
            "narrator": "ガブリエラ",
            "text": "…だったと思う。\nそれすらもあまり\n覚えてないから。",
            "zh": "……应该是吧。\n就连那份感受\n我都记不太清了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "349/ACT",
            "narrator": "",
            "text": "初等部の頃だったら普通覚えてるのでは？",
            "zh": "小学部那会儿的话，一般不都还记得吗？",
            "narrator_zh": ""
        },
        {
            "location": "351/TALK",
            "narrator": "ガブリエラ",
            "text": "普通！？\n普通って何よ。",
            "zh": "一般！？\n什么叫一般啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "352/TALK",
            "narrator": "ガブリエラ",
            "text": "そんなの人によって\n全然違うでしょ。",
            "zh": "那种事本来就\n因人而异吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "353/TALK",
            "narrator": "ガブリエラ",
            "text": "憶測で普通とか常識とか\n決めつけないで欲しいわ。\nそういうの嫌い。",
            "zh": "希望你别光凭臆测\n拿什么一般啦常识来框人。\n我最讨厌那样了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "355/ACT",
            "narrator": "",
            "text": "ガブリエラのお母さんって強盗に殺されたんだっけ？",
            "zh": "加布里埃拉的妈妈是被强盗杀害的对吧？",
            "narrator_zh": ""
        },
        {
            "location": "356/TALK",
            "narrator": "ガブリエラ",
            "text": "ええ、そうよ。",
            "zh": "嗯，是啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "357/SEL",
            "narrator": "（選択肢）",
            "text": "なんで殺されたの？身代金拒否したとか？",
            "zh": "为什么会被杀？难道是拒绝交赎金之类的吗？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "358/SEL",
            "narrator": "（選択肢）",
            "text": "どんな風に？",
            "zh": "是怎么出事的？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "359/ACT",
            "narrator": "",
            "text": "なんで殺されたの？身代金拒否したとか？",
            "zh": "为什么会被杀？难道是拒绝交赎金之类的吗？",
            "narrator_zh": ""
        },
        {
            "location": "360/TALK",
            "narrator": "ガブリエラ",
            "text": "まさか。\n命より大切なものなんて\n無いわよ。",
            "zh": "怎么可能。\n没有什么东西\n比性命更重要啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "361/ACT",
            "narrator": "",
            "text": "どんな風に？",
            "zh": "是怎么出事的？",
            "narrator_zh": ""
        },
        {
            "location": "362/TALK",
            "narrator": "ガブリエラ",
            "text": "え？\nそれは……",
            "zh": "诶？\n那个……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "363/TALK",
            "narrator": "ガブリエラ",
            "text": "どんな風だったかしら。\nあまり覚えてないわね。",
            "zh": "当时究竟是怎样的呢。\n我不太记得了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "364/SEL",
            "narrator": "（選択肢）",
            "text": "随分冷静だね",
            "zh": "你还真是冷静呢",
            "narrator_zh": "（选项）"
        },
        {
            "location": "365/SEL",
            "narrator": "（選択肢）",
            "text": "ショックで忘れちゃったんだね",
            "zh": "是因为打击太大忘掉了吧",
            "narrator_zh": "（选项）"
        },
        {
            "location": "366/ACT",
            "narrator": "",
            "text": "随分冷静だね",
            "zh": "你还真是冷静呢",
            "narrator_zh": ""
        },
        {
            "location": "367/TALK",
            "narrator": "ガブリエラ",
            "text": "そんなことないわよ。\nただ、全然実感湧かない\nっていうか――",
            "zh": "才没有呢。\n只是总觉得完全\n没有实感吧——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "368/TALK",
            "narrator": "ガブリエラ",
            "text": "本当に、その時の事を\n覚えていないのよね。",
            "zh": "其实，我真的完全不记得\n那时候的事情了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "369/ACT",
            "narrator": "",
            "text": "ショックで忘れちゃったんだね",
            "zh": "是因为打击太大忘掉了吧",
            "narrator_zh": ""
        },
        {
            "location": "370/TALK",
            "narrator": "ガブリエラ",
            "text": "多分、そうだと思う。\n本当に全然\n覚えていないんだもの。",
            "zh": "大概，是那样吧。\n因为真的完全\n一点都不记得了嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "374/TALK",
            "narrator": "ガブリエラ",
            "text": "とにかく。",
            "zh": "总之。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "375/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしはお母さんのことが\n知りたいのよ。",
            "zh": "我想了解妈妈的\n事情。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "376/TALK",
            "narrator": "ガブリエラ",
            "text": "だから片っ端から\n心当たりを探っていたん\nだけど、みんな違ったわ。",
            "zh": "所以我挨个去试探\n那些有印象的人，\n结果全都不对。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "377/SEL",
            "narrator": "（選択肢）",
            "text": "でも違うからって銃で撃たなくても…",
            "zh": "可就算不对，也不用开枪打人吧……",
            "narrator_zh": "（选项）"
        },
        {
            "location": "378/ACT",
            "narrator": "",
            "text": "でも違うからって銃で撃たなくても…",
            "zh": "可就算不对，也不用开枪打人吧……",
            "narrator_zh": ""
        },
        {
            "location": "380/TALK",
            "narrator": "ガブリエラ",
            "text": "うーん、そうね。\nなんであんな行動に\n出たのかはわからない。",
            "zh": "唔嗯，是啊。\n我自己也不知道\n怎么会做出那种举动。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "381/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、そこにも何か\n理由があるんだと\n思うのよね。",
            "zh": "不过，这当中应该也是\n有什么理由\n才对吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "382/SEL",
            "narrator": "（選択肢）",
            "text": "まあ、ココロの中だしね",
            "zh": "嘛，毕竟是在心里嘛",
            "narrator_zh": "（选项）"
        },
        {
            "location": "383/ACT",
            "narrator": "",
            "text": "まあ、ココロの中だしね",
            "zh": "嘛，毕竟是在心里嘛",
            "narrator_zh": ""
        },
        {
            "location": "385/TALK",
            "narrator": "ガブリエラ",
            "text": "ええ。",
            "zh": "嗯。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "387/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ……。\nあたしのお母さんって\nどんな人だったのかしら。",
            "zh": "哈啊……。\n我的妈妈究竟\n是个怎样的人呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "388/TALK",
            "narrator": "潜在ガブリエラ",
            "text": "その答えは\nあたしが知ってるわよ。",
            "zh": "那个答案\n我可是知道哦。",
            "narrator_zh": "潜在加布里埃拉"
        },
        {
            "location": "407/TALK",
            "narrator": "ガブリエラ",
            "text": "！？\nあんたは？",
            "zh": "！？\n你是？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "408/TALK",
            "narrator": "潜在ガブリエラ",
            "text": "あたしは、\n潜在意識に相当する区域に\n生息するあたし。",
            "zh": "我是栖息在\n相当于潜意识区域里的\n那个我。",
            "narrator_zh": "潜在加布里埃拉"
        },
        {
            "location": "409/TALK",
            "narrator": "潜在ガブリエラ",
            "text": "今あんたが知りたい\n記憶の間近にいる。",
            "zh": "就在你现在想知道的\n那段记忆近旁。",
            "narrator_zh": "潜在加布里埃拉"
        },
        {
            "location": "410/TALK",
            "narrator": "潜在ガブリエラ",
