{
    "dir": "chap05/daydra/dd_ch04_05_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "5457",
        "cid": "miyabi",
        "title": "Extra007 プレミアムストーリー",
        "sub_title": "就職活動",
        "title_zh": "Extra007 额外剧情",
        "sub_title_zh": "求职"
    },
    "entry": [
        {
            "location": "242/SCENARIO",
            "narrator": "",
            "text": "就職活動",
            "zh": "求职",
            "narrator_zh": ""
        },
        {
            "location": "260/TALK",
            "narrator": "男子高校生Ａ",
            "text": "あれ？\nおまえもう帰りか？",
            "zh": "咦？\n你这就回去了？",
            "narrator_zh": "男高中生Ａ"
        },
        {
            "location": "261/TALK",
            "narrator": "男子高校生Ｂ",
            "text": "ああ、午後から会社の\n説明会があるんだよ。",
            "zh": "啊，下午有公司的\n说明会。",
            "narrator_zh": "男高中生Ｂ"
        },
        {
            "location": "262/TALK",
            "narrator": "男子高校生Ａ",
            "text": "そういやおまえ、\n高等部卒業したら\n就職するんだっけか？",
            "zh": "说起来你，\n高中部毕业后\n是要去工作来着？",
            "narrator_zh": "男高中生Ａ"
        },
        {
            "location": "263/TALK",
            "narrator": "男子高校生Ｂ",
            "text": "まあな。",
            "zh": "差不多吧。",
            "narrator_zh": "男高中生Ｂ"
        },
        {
            "location": "264/TALK",
            "narrator": "男子高校生Ａ",
            "text": "就職活動か…\n俺には無理だなぁ。",
            "zh": "求职啊……\n我可做不来。",
            "narrator_zh": "男高中生Ａ"
        },
        {
            "location": "265/TALK",
            "narrator": "男子高校生Ｂ",
            "text": "いずれおまえも\nやることになるんだよ。",
            "zh": "你以后\n也得干这个。",
            "narrator_zh": "男高中生Ｂ"
        },
        {
            "location": "274/TALK",
            "narrator": "みやび",
            "text": "…就職活動、\n大変そうやね。",
            "zh": "……求职，\n看起来好辛苦咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "275/TALK",
            "narrator": "アーヤ",
            "text": "大変だと思うわ。\n特に、高卒ですぐに\n就職なんて…。",
            "zh": "我觉得很辛苦。\n尤其是高中一毕业\n就去工作……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "276/TALK",
            "narrator": "みやび",
            "text": "せっかくここに入学\nしたんやき――",
            "zh": "好不容易才考进\n这里啵——",
            "narrator_zh": "雅"
        },
        {
            "location": "277/TALK",
            "narrator": "みやび",
            "text": "大学まで行かんのは\n勿体ない気もする\nけんどね。",
            "zh": "不去读大学，\n也觉得有点可惜，\n但是呢。",
            "narrator_zh": "雅"
        },
        {
            "location": "280/TALK",
            "narrator": "アーヤ",
            "text": "人それぞれ、色んな\n事情があるものよ。",
            "zh": "每个人，都有\n各自的情况。",
            "narrator_zh": "绫水"
        },
        {
            "location": "282/TALK",
            "narrator": "アーヤ",
            "text": "…そういえば、\n私の地元の友達にも――",
            "zh": "……说起来，\n我老家的朋友里也有——",
            "narrator_zh": "绫水"
        },
        {
            "location": "283/TALK",
            "narrator": "アーヤ",
            "text": "高卒で就職した\n人がいたわ。",
            "zh": "高中毕业就工作的\n人。",
            "narrator_zh": "绫水"
        },
        {
            "location": "286/TALK",
            "narrator": "みやび",
            "text": "やっぱし、あんな感じ\nやったん？",
            "zh": "果然，就是\n那种感觉？",
            "narrator_zh": "雅"
        },
        {
            "location": "287/TALK",
            "narrator": "アーヤ",
            "text": "ええ、学校早退して、\n説明会やら面接やら、\n走り回ってたわ。",
            "zh": "嗯，早退离校，\n说明会啊面试啊，\n跑个不停。",
            "narrator_zh": "绫水"
        },
        {
            "location": "288/TALK",
            "narrator": "アーヤ",
            "text": "登校の時は制服で、\n帰る時はスーツとか、\nしょっちゅうだったし。",
            "zh": "上学时穿校服，\n回去时换西装，\n经常这样。",
            "narrator_zh": "绫水"
        },
        {
            "location": "290/TALK",
            "narrator": "アーヤ",
            "text": "…みやびも、いずれは\n就職活動するのよね？",
            "zh": "……雅以后，\n也要去求职吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "293/TALK",
            "narrator": "みやび",
            "text": "そうなるやろうね。",
            "zh": "大概会这样吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "294/TALK",
            "narrator": "みやび",
            "text": "スーツ着てあっちこっち\n行かんとならんこと\n考えると――",
            "zh": "一想到得穿着西装\n到处跑，\n就——",
            "narrator_zh": "雅"
        },
        {
            "location": "296/TALK",
            "narrator": "みやび",
            "text": "今から憂鬱やけんど…。",
            "zh": "现在就开始发愁了，但是……。",
            "narrator_zh": "雅"
        },
        {
            "location": "297/SEL",
            "narrator": "",
            "text": "意外と似合いそうだよ",
            "zh": "说不定意外地合适",
            "narrator_zh": ""
        },
        {
            "location": "298/SEL",
            "narrator": "",
            "text": "神楽坂トライナリーに就職だ",
            "zh": "去神乐坂三重奏剧场就职",
            "narrator_zh": ""
        },
        {
            "location": "301/TALK",
            "narrator": "アーヤ",
            "text": "でしょうね…制服にも\n文句言ってるくらいだし。",
            "zh": "就是啊……连校服\n都要抱怨。",
            "narrator_zh": "绫水"
        },
        {
            "location": "302/TALK",
            "narrator": "アーヤ",
            "text": "でも、着てみると意外と\n慣れるかもしれないわよ？",
            "zh": "不过，穿上之后\n也许意外地会习惯？",
            "narrator_zh": "绫水"
        },
        {
            "location": "305/TALK",
            "narrator": "みやび",
            "text": "うちがスーツに慣れると、\n本気で思うがか？",
            "zh": "你是真心觉得\n我能习惯西装咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "306/TALK",
            "narrator": "アーヤ",
            "text": "…ありえなさそうね。",
            "zh": "……看起来不可能。",
            "narrator_zh": "绫水"
        },
        {
            "location": "311/TALK",
            "narrator": "みやび",
            "text": "まあ、就職活動いうもん\n自体が、うちにとっては\nあまり興味持てんき――",
            "zh": "嘛，求职这回事\n本身，对我来说\n就提不起兴趣啵——",
            "narrator_zh": "雅"
        },
        {
            "location": "312/TALK",
            "narrator": "みやび",
            "text": "このままトライナリーで\n一生食っていければ、\nそれが一番やねぇ。",
            "zh": "要是能就这样在三重奏\n吃一辈子饭，\n那是最好的咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "314/TALK",
            "narrator": "アーヤ",
            "text": "何てこと言い出すんだか、\nまったく…。",
            "zh": "怎么说出这种话，\n真是的……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "316/TALK",
            "narrator": "アーヤ",
            "text": "…けど、正直まだまだ\nやめられないとは\n思ってるわ。",
            "zh": "……不过，说实话，\n我也觉得还\n停不下来。",
            "narrator_zh": "绫水"
        },
        {
            "location": "317/TALK",
            "narrator": "アーヤ",
            "text": "フェノメノン被害が、\nそう簡単に収束するとは\n思えないし。",
            "zh": "PhenoMENON的受害，\n我不觉得能这么简单\n平息下去。",
            "narrator_zh": "绫水"
        },
        {
            "location": "321/TALK",
            "narrator": "みやび",
            "text": "…そうやね。",
            "zh": "……是咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "322/TALK",
            "narrator": "みやび",
            "text": "まあ、フェノメノン被害が\nなくなって、うちらも\n自由になったら――",
            "zh": "嘛，等PhenoMENON的受害\n没有了，我们也\n自由了的话——",
            "narrator_zh": "雅"
        },
        {
            "location": "323/TALK",
            "narrator": "みやび",
            "text": "自伝でも書いて、\n印税生活で暮らす方法も\n考えちゅうけんどね。",
            "zh": "写本自传，\n靠版税过日子，\n我也在想，但是呢。",
            "narrator_zh": "雅"
        },
        {
            "location": "328/TALK",
            "narrator": "アーヤ",
            "text": "…あんまり、みんなの\nプライベートに関しては\n書かないでよ？",
            "zh": "……大家的私事，\n可别写太多\n啊？",
            "narrator_zh": "绫水"
        },
        {
            "location": "330/ACT",
            "narrator": "",
            "text": "意外と似合いそうだよ",
            "zh": "说不定意外地合适",
            "narrator_zh": ""
        },
        {
            "location": "349/TALK",
            "narrator": "みやび",
            "text": "相棒、寝ぼけちゅうが？",
            "zh": "搭档，你在说梦话咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "350/TALK",
            "narrator": "みやび",
            "text": "どう考えても似合うわけないちや",
            "zh": "怎么想都不合适滴",
            "narrator_zh": "雅"
        },
        {
            "location": "366/TALK",
            "narrator": "みやび",
            "text": "…なあ？",
            "zh": "……是没是？",
            "narrator_zh": "雅"
        },
        {
            "location": "370/TALK",
            "narrator": "アーヤ",
            "text": "いや、なあ、って\n振られても、何の話か\nわからないし…。",
            "zh": "不，你突然问\n对吧，我也\n不知道在说什么……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "371/TALK",
            "narrator": "みやび",
            "text": "うちがスーツ着ても、\n似合わんちゅう話や。",
            "zh": "是说我穿西装\n也不合适。",
            "narrator_zh": "雅"
        },
        {
            "location": "372/TALK",
            "narrator": "みやび",
            "text": "アーヤもそう思うやろ？",
            "zh": "绫水也这么觉得是没是？",
            "narrator_zh": "雅"
        },
        {
            "location": "377/TALK",
            "narrator": "アーヤ",
            "text": "う～ん、そうねぇ…。",
            "zh": "嗯——，这个嘛……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "378/TALK",
            "narrator": "アーヤ",
            "text": "…あら？\nなんか、意外と似合い\nそうかも。",
            "zh": "……哎呀？\n总觉得，说不定\n意外地合适。",
            "narrator_zh": "绫水"
        },
        {
            "location": "381/TALK",
            "narrator": "みやび",
            "text": "ありえんやろ？",
            "zh": "不可能咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "382/TALK",
            "narrator": "アーヤ",
            "text": "ううん、そんなこと\nないって。",
            "zh": "不，没\n那回事。",
            "narrator_zh": "绫水"
        },
        {
            "location": "383/TALK",
            "narrator": "アーヤ",
            "text": "雰囲気的に、秘書とか\n向いてる気がするし。",
            "zh": "感觉气质上，\n挺像能做秘书的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "386/TALK",
            "narrator": "みやび",
            "text": "秘書の仕事が、\nうちに向いてると\n思うんか？",
            "zh": "你觉得秘书的工作\n适合我\n咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "389/TALK",
            "narrator": "アーヤ",
            "text": "ううん、雰囲気的に\n向いてそうに思える\nだけで――",
            "zh": "不，只是气质上\n看起来像适合\n而已——",
            "narrator_zh": "绫水"
        },
        {
            "location": "391/TALK",
            "narrator": "アーヤ",
            "text": "実際に向いてるとは、\n全く思わないわ。",
            "zh": "至于真的适合，\n我完全不觉得。",
            "narrator_zh": "绫水"
        },
        {
            "location": "394/TALK",
            "narrator": "みやび",
            "text": "うちもそう思う。\n息苦しゅうて、ずーっと\nイライラしとるやろうね。",
            "zh": "我也这么觉得。\n闷得慌，会一直\n烦下去吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "395/TALK",
            "narrator": "アーヤ",
            "text": "っていうか、みやびは\n就きたい仕事の希望とか\n条件って、ないの？",
            "zh": "话说，雅\n想做的工作，希望啊\n条件啊，没有吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "396/TALK",
            "narrator": "みやび",
            "text": "服装自由でパソコン\n弄れて、人と会わんで\n済む仕事がえいな。",
            "zh": "衣服自由，能摆弄电脑，\n不用见人\n就行的工作最好。",
            "narrator_zh": "雅"
        },
        {
            "location": "397/TALK",
            "narrator": "アーヤ",
            "text": "…ピッタリだわ、それ。",
            "zh": "……这倒是正好。",
            "narrator_zh": "绫水"
        },
        {
            "location": "400/TALK",
            "narrator": "みやび",
            "text": "うちもそう思うんよ。",
            "zh": "我也这么觉得。",
            "narrator_zh": "雅"
        },
        {
            "location": "401/TALK",
            "narrator": "アーヤ",
            "text": "まあ、それがどんな\n仕事なのかは私には\nわからないけど――",
            "zh": "嘛，那到底是\n什么工作，我\n也不知道——",
            "narrator_zh": "绫水"
        },
        {
            "location": "403/TALK",
            "narrator": "アーヤ",
            "text": "叶うことを祈ってるわ。",
            "zh": "希望你能如愿。",
            "narrator_zh": "绫水"
        },
        {
            "location": "404/ACT",
            "narrator": "",
            "text": "神楽坂トライナリーに就職だ",
            "zh": "去神乐坂三重奏剧场就职",
            "narrator_zh": ""
        },
        {
            "location": "424/TALK",
            "narrator": "みやび",
            "text": "相棒、真面目な話するとな",
            "zh": "搭档，说正经的",
            "narrator_zh": "雅"
        },
        {
            "location": "425/TALK",
            "narrator": "みやび",
            "text": "それ、悪くないぞね",
            "zh": "那个，不坏咧",
            "narrator_zh": "雅"
        },
        {
            "location": "439/TALK",
            "narrator": "みやび",
            "text": "…一度、まほさんに\n相談してみるか。",
            "zh": "……要不要找真幌\n商量一次。",
            "narrator_zh": "雅"
        },
        {
            "location": "442/TALK",
            "narrator": "アーヤ",
            "text": "主語を抜かされたら\n何のことかわからないわ。",
            "zh": "主语被你省掉，\n我就不知道在说什么。",
            "narrator_zh": "绫水"
        },
        {
            "location": "445/TALK",
            "narrator": "みやび",
            "text": "神楽坂トライナリーで\n雇ってもらえないか、\n聞いてみようと思うんよ。",
            "zh": "我想问问，\n神乐坂三重奏剧场\n能不能雇我。",
            "narrator_zh": "雅"
        },
        {
            "location": "448/TALK",
            "narrator": "アーヤ",
            "text": "えっ！？",
            "zh": "诶！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "449/TALK",
            "narrator": "みやび",
            "text": "あそこならスーツとか\n制服もないき、息苦しい\n想いせんですむし――",
            "zh": "那里没有西装\n也没有制服啵，不用\n受那份憋闷——",
            "narrator_zh": "雅"
        },
        {
            "location": "450/TALK",
            "narrator": "みやび",
            "text": "客も少ないき、気楽で\n自由に働いていけると\n思うがよ。",
            "zh": "客人也不多啵，我觉得\n能轻松\n自由地干下去。",
            "narrator_zh": "雅"
        },
        {
            "location": "451/TALK",
            "narrator": "アーヤ",
            "text": "そ、そうかもしれない\nけど…。",
            "zh": "也、也许是这样\n……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "453/TALK",
            "narrator": "アーヤ",
            "text": "でも、そんな理由で\n就職したいなんて\n言ったら――",
            "zh": "可是，用这种理由\n说想去工作\n的话——",
            "narrator_zh": "绫水"
        },
        {
            "location": "454/TALK",
            "narrator": "アーヤ",
            "text": "絶対館長に怒られるわよ？",
            "zh": "绝对会被馆长骂的吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "457/TALK",
            "narrator": "みやび",
            "text": "…まあ、そうやろうね。",
            "zh": "……嘛，大概会吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "461/TALK",
            "narrator": "みやび",
            "text": "けんど、うちはあの\n劇場の雰囲気、\n嫌いやないんよ。",
            "zh": "但是，那座\n剧场的气氛，\n我并不讨厌。",
            "narrator_zh": "雅"
        },
        {
            "location": "462/TALK",
            "narrator": "みやび",
            "text": "ちゅうか、好きちや。\n大好きに近いくらい\n好きなんよ。",
            "zh": "或者说，喜欢滴。\n喜欢到接近\n最喜欢了。",
            "narrator_zh": "雅"
        },
        {
            "location": "463/TALK",
            "narrator": "アーヤ",
            "text": "…初耳だわ。",
            "zh": "……第一次听说。",
            "narrator_zh": "绫水"
        },
        {
            "location": "464/TALK",
            "narrator": "みやび",
            "text": "言う機会も、言う必要も\n今までなかったきね。",
            "zh": "以前既没机会说，\n也没必要说啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "465/TALK",
            "narrator": "みやび",
            "text": "やき、あそこに残れる\nいうんなら、うちとしては\n喜ばしいことながよ。",
            "zh": "所以嘛，要是能留在那里，\n对我来说\n是值得高兴的事咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "467/TALK",
            "narrator": "アーヤ",
            "text": "…なんだ、ちゃんとした\n理由があるんじゃない。",
            "zh": "……什么嘛，你不是\n有正经理由吗。",
            "narrator_zh": "绫水"
        },
        {
            "location": "468/TALK",
            "narrator": "アーヤ",
            "text": "だったら、それを館長に\n言えば――",
            "zh": "那就对馆长\n这么说——",
            "narrator_zh": "绫水"
        },
        {
            "location": "471/TALK",
            "narrator": "みやび",
            "text": "冗談やと思われて、\nそれでおしまいやと\n思うぞね。",
            "zh": "会被当成玩笑，\n然后就完了，\n我是这么觉得咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "472/TALK",
            "narrator": "アーヤ",
            "text": "それは日頃の行いの\nせいよね？",
            "zh": "那是平时的所作所为\n造成的吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "476/TALK",
            "narrator": "みやび",
            "text": "まあ、そういうわけやき、\n冗談と思われん別の理由を\n考えんといかんね。",
            "zh": "嘛，就是这么回事啵，\n得想一个不会被当成玩笑的\n别的理由。",
            "narrator_zh": "雅"
        },
        {
            "location": "478/TALK",
            "narrator": "アーヤ",
            "text": "とりあえず就職までは\n何年もあるんだから――",
            "zh": "反正离求职\n还有好几年——",
            "narrator_zh": "绫水"
        },
        {
            "location": "479/TALK",
            "narrator": "アーヤ",
            "text": "ゆっくり考えれば\nいいんじゃない？",
            "zh": "慢慢想\n不就好了？",
            "narrator_zh": "绫水"
        },
        {
            "location": "490/TALK",
            "narrator": "真幌",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "真幌"
        },
        {
            "location": "491/TALK",
            "narrator": "真幌",
            "text": "あいつ…そんな風に\n思っていてくれてた\nとは…。",
            "zh": "那家伙……原来是\n这么想的\n啊……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "492/TALK",
            "narrator": "真幌",
            "text": "…あの劇場、やはり\n私の代で潰すわけには\nいかないようだな。",
            "zh": "……那座剧场，果然\n不能在我这一代\n关掉啊。",
            "narrator_zh": "真幌"
        },
        {
            "location": "253/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>5月13日　3:35 PM</color>\nとある平日、ホームルーム終了直後に高等部廊下にて。",
            "zh": "<color=green>5月13日　3:35 PM</color>\n某个工作日，班会刚结束，在高中部走廊。",
            "narrator_zh": "Dialog_EventData"
        },
        {
            "location": "503/DIALOG",
            "narrator": "Dialog_GEThimegoto_ch04",
            "text": "【モナルーム？　モナムール！】",
            "zh": "【莫纳鲁姆？　莫纳穆尔！】",
            "narrator_zh": "Dialog_GEThimegoto_ch04"
        }
    ]
}
