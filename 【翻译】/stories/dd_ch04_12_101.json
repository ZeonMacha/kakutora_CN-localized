{
    "dir": "chap12/daydra/dd_ch04_12_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "12402",
        "cid": "miyabi",
        "title": "002 メインストーリー",
        "sub_title": "偶然の出会い＜前編＞",
        "title_zh": "002 主线剧情",
        "sub_title_zh": "偶然的相遇＜前篇＞"
    },
    "entry": [
        {
            "location": "8/SCENARIO",
            "narrator": "",
            "text": "偶然の出会い",
            "zh": "偶然的相遇",
            "narrator_zh": ""
        },
        {
            "location": "33/TALK",
            "narrator": "みやび",
            "text": "…中々えい味やった。",
            "zh": "……味道相当好滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "34/TALK",
            "narrator": "みやび",
            "text": "ネットで見た情報は、\nガセじゃなかったな。",
            "zh": "网上看到的情报，\n不是假的咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "35/SEL",
            "narrator": "",
            "text": "一人でティータイム？",
            "zh": "一个人喝下午茶？",
            "narrator_zh": ""
        },
        {
            "location": "36/ACT",
            "narrator": "",
            "text": "一人でティータイム？",
            "zh": "一个人喝下午茶？",
            "narrator_zh": ""
        },
        {
            "location": "38/TALK",
            "narrator": "みやび",
            "text": "ん？",
            "zh": "嗯？",
            "narrator_zh": "雅"
        },
        {
            "location": "47/TALK",
            "narrator": "みやび",
            "text": "うむ",
            "zh": "嗯",
            "narrator_zh": "雅"
        },
        {
            "location": "48/TALK",
            "narrator": "みやび",
            "text": "ネットで見たんよ",
            "zh": "网上看到的咯",
            "narrator_zh": "雅"
        },
        {
            "location": "49/TALK",
            "narrator": "みやび",
            "text": "ここのメイド喫茶のケーキは絶品やってな",
            "zh": "这家女仆咖啡厅的蛋糕是绝品来的咯",
            "narrator_zh": "雅"
        },
        {
            "location": "51/SEL",
            "narrator": "",
            "text": "メイド喫茶！？",
            "zh": "女仆咖啡厅！？",
            "narrator_zh": ""
        },
        {
            "location": "52/ACT",
            "narrator": "",
            "text": "メイド喫茶！？",
            "zh": "女仆咖啡厅！？",
            "narrator_zh": ""
        },
        {
            "location": "54/TALK",
            "narrator": "みやび",
            "text": "別に驚くことやないやろ？",
            "zh": "又不是什么值得惊讶的事，是没是？",
            "narrator_zh": "雅"
        },
        {
            "location": "55/TALK",
            "narrator": "みやび",
            "text": "ちゅうか、まだ締めの紅茶タイム満喫中やき",
            "zh": "话说，现在还在尽情享受收尾的红茶时间啵",
            "narrator_zh": "雅"
        },
        {
            "location": "56/TALK",
            "narrator": "みやび",
            "text": "話は後や",
            "zh": "话之后再说咯",
            "narrator_zh": "雅"
        },
        {
            "location": "63/TALK",
            "narrator": "みやび",
            "text": "さて…追加するか、\nやめておくか…。",
            "zh": "那么…是追加一份咩，\n还是就此作罢……。",
            "narrator_zh": "雅"
        },
        {
            "location": "70/TALK",
            "narrator": "繭",
            "text": "お疲れ様、お先に。",
            "zh": "辛苦了，我先走一步。",
            "narrator_zh": "茧"
        },
        {
            "location": "72/TALK",
            "narrator": "繭",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "茧"
        },
        {
            "location": "73/TALK",
            "narrator": "繭",
            "text": "っ！？",
            "zh": "唔！？",
            "narrator_zh": "茧"
        },
        {
            "location": "74/TALK",
            "narrator": "みやび",
            "text": "せっかく来たんやし、\nやはり頼んだ方が\nえいかもしれんな。",
            "zh": "难得来一趟，\n果然还是点一份\n可能会比较好咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "76/TALK",
            "narrator": "みやび",
            "text": "あー、すみませーん。",
            "zh": "啊——不好意思——。",
            "narrator_zh": "雅"
        },
        {
            "location": "81/TALK",
            "narrator": "繭",
            "text": "みやび先輩！？",
            "zh": "雅前辈！？",
            "narrator_zh": "茧"
        },
        {
            "location": "84/TALK",
            "narrator": "みやび",
            "text": "んっ？",
            "zh": "嗯？",
            "narrator_zh": "雅"
        },
        {
            "location": "85/TALK",
            "narrator": "みやび",
            "text": "この子は…えーと、\nなんやったっけか…。",
            "zh": "这孩子是…呃，\n叫什么来着……。",
            "narrator_zh": "雅"
        },
        {
            "location": "87/TALK",
            "narrator": "繭",
            "text": "みやび先輩…。\nこんなところで\n何を――",
            "zh": "雅前辈……。\n在这种地方\n做什么——",
            "narrator_zh": "茧"
        },
        {
            "location": "93/TALK",
            "narrator": "ウェイトレス",
            "text": "お待たせしましたー♪",
            "zh": "让您久等了哟♪",
            "narrator_zh": "女服务员"
        },
        {
            "location": "95/TALK",
            "narrator": "ウェイトレス",
            "text": "あら、光月さん？",
            "zh": "哎呀，光月？",
            "narrator_zh": "女服务员"
        },
        {
            "location": "98/TALK",
            "narrator": "みやび",
            "text": "ああ、光月さん。\n奇遇やね。",
            "zh": "哦，是光月。\n真巧咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "102/TALK",
            "narrator": "繭",
            "text": "あ、は、はい！\n本当に奇遇というか、\n何故ここに！？",
            "zh": "啊，是、是的！\n要说真是奇遇嘛，\n你怎么会在这里！？",
            "narrator_zh": "茧"
        },
        {
            "location": "103/TALK",
            "narrator": "みやび",
            "text": "お茶しに来たちや。\nで、光月さんは？",
            "zh": "来喝茶滴。\n那，光月你呢？",
            "narrator_zh": "雅"
        },
        {
            "location": "105/TALK",
            "narrator": "繭",
            "text": "わ、私は…。",
            "zh": "我、我……。",
            "narrator_zh": "茧"
        },
        {
            "location": "106/TALK",
            "narrator": "ウェイトレス",
            "text": "まだいたんだ？\n光月さん、今日の\nシフトは――",
            "zh": "还在呢？\n光月，你今天的\n班次——",
            "narrator_zh": "女服务员"
        },
        {
            "location": "110/TALK",
            "narrator": "繭",
            "text": "シフォンケーキ！！",
            "zh": "戚风蛋糕！！",
            "narrator_zh": "茧"
        },
        {
            "location": "112/TALK",
            "narrator": "ウェイトレス",
            "text": "はい？",
            "zh": "诶？",
            "narrator_zh": "女服务员"
        },
        {
            "location": "113/TALK",
            "narrator": "繭",
            "text": "シフォンケーキと\n紅茶のセット！！",
            "zh": "戚风蛋糕和\n红茶的套餐！！",
            "narrator_zh": "茧"
        },
        {
            "location": "114/TALK",
            "narrator": "ウェイトレス",
            "text": "え、えーっと…。",
            "zh": "呃、那个……。",
            "narrator_zh": "女服务员"
        },
        {
            "location": "117/TALK",
            "narrator": "みやび",
            "text": "あ、うちは紅茶と\n桃のタルトで。",
            "zh": "啊，我要红茶和\n桃子塔。",
            "narrator_zh": "雅"
        },
        {
            "location": "118/TALK",
            "narrator": "繭",
            "text": "今すぐ！　大至急！！",
            "zh": "现在马上！　火速！！",
            "narrator_zh": "茧"
        },
        {
            "location": "120/TALK",
            "narrator": "ウェイトレス",
            "text": "あ、はい！\nかしこまりましたぁ。",
            "zh": "啊，好的！\n遵命哟。",
            "narrator_zh": "女服务员"
        },
        {
            "location": "122/TALK",
            "narrator": "繭",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "茧"
        },
        {
            "location": "125/TALK",
            "narrator": "みやび",
            "text": "…とりあえず、\n座ったらどうや？",
            "zh": "……总之，\n先坐下啵？",
            "narrator_zh": "雅"
        },
        {
            "location": "128/TALK",
            "narrator": "繭",
            "text": "はい…すみません…。",
            "zh": "好……对不起……。",
            "narrator_zh": "茧"
        },
        {
            "location": "155/TALK",
            "narrator": "みやび",
            "text": "…こんなところで\n会うなんて、\n奇遇やね。",
            "zh": "……会在这种地方\n碰上，\n真巧咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "156/TALK",
            "narrator": "繭",
            "text": "あ、はい…。",
            "zh": "啊，是……。",
            "narrator_zh": "茧"
        },
        {
            "location": "158/TALK",
            "narrator": "みやび",
            "text": "光月さんも、\nケーキ食べに来たが？",
            "zh": "光月也是\n来吃蛋糕的咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "159/TALK",
            "narrator": "繭",
            "text": "はい…。",
            "zh": "是……。",
            "narrator_zh": "茧"
        },
        {
            "location": "160/TALK",
            "narrator": "みやび",
            "text": "ん…そう…。",
            "zh": "嗯……这样……。",
            "narrator_zh": "雅"
        },
        {
            "location": "161/TALK",
            "narrator": "繭",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "茧"
        },
        {
            "location": "162/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "164/TALK",
            "narrator": "繭",
            "text": "あ、あの…私が\nここにいたこと、\nみんなには…。",
            "zh": "那个……我\n在这里的事，\n对大家……。",
            "narrator_zh": "茧"
        },
        {
            "location": "165/TALK",
            "narrator": "みやび",
            "text": "ん？\nああ、言わんよ。",
            "zh": "嗯？\n哦，不会说的咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "167/TALK",
            "narrator": "みやび",
            "text": "光月さんが\nメイド喫茶の常連\nっちゅうのは――",
            "zh": "光月是\n女仆咖啡厅常客\n这件事咯——",
            "narrator_zh": "雅"
        },
        {
            "location": "168/TALK",
            "narrator": "みやび",
            "text": "うちと光月さん、\n二人だけの秘密や。",
            "zh": "是我和光月\n两个人之间的秘密滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "170/TALK",
            "narrator": "繭",
            "text": "ふ、二人だけ！？\n光栄です！",
            "zh": "两、两个人！？\n我深感荣幸！",
            "narrator_zh": "茧"
        },
        {
            "location": "172/TALK",
            "narrator": "みやび",
            "text": "？　そう？",
            "zh": "？　是咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "174/TALK",
            "narrator": "繭",
            "text": "…常連と思われたのは\n心外だけど――",
            "zh": "……被当成常客\n虽然很意外——",
            "narrator_zh": "茧"
        },
        {
            "location": "175/TALK",
            "narrator": "繭",
            "text": "バイトしてるのが\nバレるよりはマシだと\n思わなければ。",
            "zh": "但总比打工的事\n被发现要好，\n也只好这么想了。",
            "narrator_zh": "茧"
        },
        {
            "location": "176/TALK",
            "narrator": "みやび",
            "text": "…ここ、\nケーキ美味いね。",
            "zh": "……这里的\n蛋糕真好吃咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "179/TALK",
            "narrator": "繭",
            "text": "そ、そうですね…。",
            "zh": "是、是啊……。",
            "narrator_zh": "茧"
        },
        {
            "location": "180/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "183/TALK",
            "narrator": "繭",
            "text": "…け、ケーキ、\nお好きなんですか？",
            "zh": "……蛋、蛋糕，\n你喜欢吗？",
            "narrator_zh": "茧"
        },
        {
            "location": "184/TALK",
            "narrator": "みやび",
            "text": "いや、実はどっちかと\nいえば苦手な方やき。\nけんど、ここのは美味い。",
            "zh": "不，其实硬要说的话\n我算不太能吃甜的一派啵。\n但是，这家的好吃。",
            "narrator_zh": "雅"
        },
        {
            "location": "186/TALK",
            "narrator": "繭",
            "text": "そうなんですか…。",
            "zh": "这样啊……。",
            "narrator_zh": "茧"
        },
        {
            "location": "188/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "190/TALK",
            "narrator": "みやび",
            "text": "居心地悪いちや…。",
            "zh": "待得好不自在滴……。",
            "narrator_zh": "雅"
        },
        {
            "location": "191/TALK",
            "narrator": "みやび",
            "text": "まあ、よく知らん子\nなんやし、仕方ない。",
            "zh": "嘛，反正是个\n不熟的孩子，没办法。",
            "narrator_zh": "雅"
        },
        {
            "location": "192/TALK",
            "narrator": "みやび",
            "text": "…けんど、せっかく\nこうして同じ席に\n座ってるんやし――",
            "zh": "……但是，难得\n像这样坐在\n同一张桌上——",
            "narrator_zh": "雅"
        },
        {
            "location": "193/TALK",
            "narrator": "みやび",
            "text": "もうちくっと話を\n引き出す努力をして\nみるか…。",
            "zh": "就再多下点功夫，\n试着把话\n套出来好了咧……。",
            "narrator_zh": "雅"
        },
        {
            "location": "194/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "196/TALK",
            "narrator": "みやび",
            "text": "けんど、面倒くさ\nそうやなぁ…。",
            "zh": "但是，感觉\n好麻烦啊……。",
            "narrator_zh": "雅"
        },
        {
            "location": "239/TALK",
            "narrator": "みやび",
            "text": "来よったね。",
            "zh": "来了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "259/TALK",
            "narrator": "みやび",
            "text": "うむ。\n今日も元気で何よりや。",
            "zh": "嗯。\n今天也这么有精神，比什么都好咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "262/TALK",
            "narrator": "みやび",
            "text": "今日もエロいな、\nお前さんは。",
            "zh": "今天也好色啊，\n你啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "265/TALK",
            "narrator": "みやび",
            "text": "今日もフェチ全開やね、\nお前さんは。",
            "zh": "今天也性癖全开咯，\n你啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "269/TALK",
            "narrator": "みやび",
            "text": "みやびさん\n５ポイントゲット。",
            "zh": "雅\n获得５点。",
            "narrator_zh": "雅"
        },
        {
            "location": "271/TALK",
            "narrator": "みやび",
            "text": "ほんで……！",
            "zh": "然后……！",
            "narrator_zh": "雅"
        },
        {
            "location": "276/TALK",
            "narrator": "みやび",
            "text": "１１ポイント貯まった\nことにより、ボーナスが\n発生しました！",
            "zh": "由于攒到了１１点，\n触发了\n奖励！",
            "narrator_zh": "雅"
        },
        {
            "location": "277/SEL",
            "narrator": "",
            "text": "半端すぎる…",
            "zh": "太随便了……",
            "narrator_zh": ""
        },
        {
            "location": "278/SEL",
            "narrator": "",
            "text": "なんでわざわざ素数？",
            "zh": "为什么特意用质数？",
            "narrator_zh": ""
        },
        {
            "location": "279/ACT",
            "narrator": "",
            "text": "半端すぎる…",
            "zh": "太随便了……",
            "narrator_zh": ""
        },
        {
            "location": "280/TALK",
            "narrator": "みやび",
            "text": "そんなの\nうちの勝手やき。",
            "zh": "那种事\n随我高兴啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "281/TALK",
            "narrator": "みやび",
            "text": "うちは素数をこよなく\n愛するんや。",
            "zh": "我啊，\n最爱质数了滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "282/ACT",
            "narrator": "",
            "text": "なんでわざわざ素数？",
            "zh": "为什么特意用质数？",
            "narrator_zh": ""
        },
        {
            "location": "283/TALK",
            "narrator": "みやび",
            "text": "む。\nえいところに気づいたね。",
            "zh": "唔。\n注意到重点了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "285/TALK",
            "narrator": "みやび",
            "text": "うちは素数が大好きやき、\n区切りがえい数字とは\n素数のことぞね。",
            "zh": "我最喜欢质数了啵，\n所谓适合分段的\n好数字，就是质数咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "287/TALK",
            "narrator": "みやび",
            "text": "というわけで、\n早速$handle$から\n賞品をもらうぞね。",
            "zh": "所以呢，\n这就从$handle$那里\n收奖品咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "288/SEL",
            "narrator": "",
            "text": "何をあげればいいの？",
            "zh": "给你什么才好？",
            "narrator_zh": ""
        },
        {
            "location": "289/SEL",
            "narrator": "",
            "text": "ちゅうをあげます！",
            "zh": "献上亲亲！",
            "narrator_zh": ""
        },
        {
            "location": "290/ACT",
            "narrator": "",
            "text": "何をあげればいいの？",
            "zh": "给你什么才好？",
            "narrator_zh": ""
        },
        {
            "location": "291/TALK",
            "narrator": "みやび",
            "text": "うむ。まあ順当に考えれば\n物質的なものが一般的な\n回答になるわけやけんど…",
            "zh": "嗯。嘛，正常考虑的话\n物质性的东西会是\n一般的回答，但是……",
            "narrator_zh": "雅"
        },
        {
            "location": "292/TALK",
            "narrator": "みやび",
            "text": "現状うちの物的欲求は、\n管理庁から貰ったスパコン\nによって満たされちょる。",
            "zh": "眼下我的物质欲望，\n已经由管理厅给的\n超级计算机满足着咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "293/TALK",
            "narrator": "みやび",
            "text": "お前さんにそれを超える\n物的賞品は無理やろうき、\n精神的賞品にしちゃる。",
            "zh": "要你拿出超过它的\n物质奖品是不可能的啵，\n所以奖品给你换成精神的。",
            "narrator_zh": "雅"
        },
        {
            "location": "315/TALK",
            "narrator": "みやび",
            "text": "ほれ、\nうちを撫でて癒すちや。",
            "zh": "来，\n摸摸我治愈我滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "333/TALK",
            "narrator": "みやび",
            "text": "ふぁっ…",
            "zh": "呼啊……",
            "narrator_zh": "雅"
        },
        {
            "location": "336/TALK",
            "narrator": "みやび",
            "text": "いたっ！\nそれで癒やせると\n思うんか？",
            "zh": "好痛！\n你觉得这样\n就能治愈咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "358/TALK",
            "narrator": "みやび",
            "text": "ふむ。\nえい癒しやった。",
            "zh": "呼姆。\n相当治愈咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "359/TALK",
            "narrator": "みやび",
            "text": "次は何を\n賞品として\nもらうことにするかね。",
            "zh": "下次决定\n收什么\n当奖品好呢。",
            "narrator_zh": "雅"
        },
        {
            "location": "360/ACT",
            "narrator": "",
            "text": "ちゅうをあげます！",
            "zh": "献上亲亲！",
            "narrator_zh": ""
        },
        {
            "location": "363/TALK",
            "narrator": "みやび",
            "text": "なんぞ、またちゅーか。",
            "zh": "驷马，又要亲亲啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "364/TALK",
            "narrator": "みやび",
            "text": "前にうちのどこぞの人格と\nちゅーをしちょらんかった\nかね？",
            "zh": "之前不是已经和我\n某个什么人格\n亲过了嘛？",
            "narrator_zh": "雅"
        },
        {
            "location": "365/SEL",
            "narrator": "",
            "text": "バレてたか！",
            "zh": "被发现了啊！",
            "narrator_zh": ""
        },
        {
            "location": "366/ACT",
            "narrator": "",
            "text": "バレてたか！",
            "zh": "被发现了啊！",
            "narrator_zh": ""
        },
        {
            "location": "368/TALK",
            "narrator": "みやび",
            "text": "当然や。\n司書やきね。",
            "zh": "当然咯。\n是司书啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "370/TALK",
            "narrator": "みやび",
            "text": "持て余すヒマをフル活用\nして、興味あることは\n調べ尽くす。",
            "zh": "把闲得发慌的时间\n全部活用，\n有兴趣的事查个彻底。",
            "narrator_zh": "雅"
        },
        {
            "location": "371/SEL",
            "narrator": "",
            "text": "ちゅーに興味有るんだ！",
            "zh": "你是对亲亲有兴趣啊！",
            "narrator_zh": ""
        },
        {
            "location": "372/ACT",
            "narrator": "",
            "text": "ちゅーに興味有るんだ！",
            "zh": "你是对亲亲有兴趣啊！",
            "narrator_zh": ""
        },
        {
            "location": "375/TALK",
            "narrator": "みやび",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "雅"
        },
        {
            "location": "377/TALK",
            "narrator": "みやび",
            "text": "興味あるんは\nちゅーやない！\nお前さんの習性や。",
            "zh": "有兴趣的才不是\n亲亲咧！\n是你的习性。",
            "narrator_zh": "雅"
        },
        {
            "location": "378/TALK",
            "narrator": "みやび",
            "text": "ほんでたった今、\nお前さんは『ちゅーちゅー\n依存症』やと判明した。",
            "zh": "然后就在刚才，\n查明你是『亲亲\n依赖症』了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "381/TALK",
            "narrator": "みやび",
            "text": "…まあ、べつに\nちゅーをもらうこと自体は\nえいけんど――",
            "zh": "……嘛，其实\n收亲亲这件事本身\n倒没什么，但是——",
            "narrator_zh": "雅"
        },
        {
            "location": "382/TALK",
            "narrator": "みやび",
            "text": "こんなバーチャルなうちと\nちゅーしても、何も進展\nせんし、満たされんぞね。",
            "zh": "跟这种虚拟的我\n亲亲，什么都不会\n进展，也不会满足咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "383/SEL",
            "narrator": "",
            "text": "これはみやびへの賞品なので$me$が満たされるかどうかは関係無い！",
            "zh": "这是给雅的奖品，跟$me$满不满足没有关系！",
            "narrator_zh": ""
        },
        {
            "location": "384/ACT",
            "narrator": "",
            "text": "これはみやびへの賞品なので$me$が満たされるかどうかは関係無い！",
            "zh": "这是给雅的奖品，跟$me$满不满足没有关系！",
            "narrator_zh": ""
        },
        {
            "location": "387/TALK",
            "narrator": "みやび",
            "text": "お前さん、それ\n本気でゆうちょるんか？",
            "zh": "你啊，\n这话是认真的咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "388/TALK",
            "narrator": "みやび",
            "text": "もしそうなら\nとんだ自惚れ屋やね……",
            "zh": "要是这样，\n你可真是自恋到家咯……",
            "narrator_zh": "雅"
        },
        {
            "location": "389/TALK",
            "narrator": "みやび",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "雅"
        },
        {
            "location": "390/TALK",
            "narrator": "みやび",
            "text": "…んー、まあ。\nえいか、それで。\nまだ１回目の賞品やしな。",
            "zh": "……嗯——嘛。\n得，就这样。\n毕竟才是第一次的奖品嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "412/TALK",
            "narrator": "みやび",
            "text": "ほれ、\n貰っちゃるき、はよ。",
            "zh": "来，\n我收下咧，快点。",
            "narrator_zh": "雅"
        },
        {
            "location": "430/TALK",
            "narrator": "みやび",
            "text": "ふぁっ…",
            "zh": "呼啊……",
            "narrator_zh": "雅"
        },
        {
            "location": "433/TALK",
            "narrator": "みやび",
            "text": "ふぁっ…",
            "zh": "呼啊……",
            "narrator_zh": "雅"
        },
        {
            "location": "456/TALK",
            "narrator": "みやび",
            "text": "ふむ。\nまあ、ザ・１回目！\nちゅう感じやね。",
            "zh": "呼姆。\n嘛，就是『第一次！』\n那种感觉咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "457/SEL",
            "narrator": "",
            "text": "てことは、２回目の賞品はちゅー以上のことを…",
            "zh": "也就是说，第二次的奖品要做超过亲亲的事……",
            "narrator_zh": ""
        },
        {
            "location": "458/ACT",
            "narrator": "",
            "text": "てことは、２回目の賞品はちゅー以上のことを…",
            "zh": "也就是说，第二次的奖品要做超过亲亲的事……",
            "narrator_zh": ""
        },
        {
            "location": "462/TALK",
            "narrator": "みやび",
            "text": "ないない。\n今度はちゃんと資産価値が\n出るものをもらうき。",
            "zh": "没得没得。\n下次要收的可是\n真有资产价值的东西啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "465/TALK",
            "narrator": "みやび",
            "text": "さて、賞品ももらった\nことやし、真面目に\n仕事でもするか。",
            "zh": "那么，奖品也收了，\n就来认真\n干点活吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "472/TALK",
            "narrator": "みやび",
            "text": "オープンプロセス、\n0x492番地から\n0x559番地へ。",
            "zh": "开放进程，\n从0x492地址\n到0x559地址。",
            "narrator_zh": "雅"
        },
        {
            "location": "487/TALK",
            "narrator": "みやび",
            "text": "完了。",
            "zh": "完成。",
            "narrator_zh": "雅"
        },
        {
            "location": "489/TALK",
            "narrator": "みやび",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "雅"
        },
        {
            "location": "491/TALK",
            "narrator": "みやび",
            "text": "………。",
            "zh": "………。",
            "narrator_zh": "雅"
        },
        {
            "location": "493/TALK",
            "narrator": "みやび",
            "text": "なるほどなぁ。\nうちらしい、\n合理的な悩みやね。",
            "zh": "原来如此啊。\n很有我们风格的，\n合理的烦恼咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "494/SEL",
            "narrator": "",
            "text": "繭に興味があるの？",
            "zh": "你对茧有兴趣？",
            "narrator_zh": ""
        },
        {
            "location": "495/ACT",
            "narrator": "",
            "text": "繭に興味があるの？",
            "zh": "你对茧有兴趣？",
            "narrator_zh": ""
        },
        {
            "location": "497/TALK",
            "narrator": "みやび",
            "text": "いや、ない。",
            "zh": "不，没有。",
            "narrator_zh": "雅"
        },
        {
            "location": "498/TALK",
            "narrator": "みやび",
            "text": "けんど、\nこのまま何も喋らず帰ると\n後悔する気がするちや。",
            "zh": "但是，\n感觉就这样一言不发地回去\n会后悔滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "499/SEL",
            "narrator": "",
            "text": "理由は？",
            "zh": "理由是？",
            "narrator_zh": ""
        },
        {
            "location": "500/ACT",
            "narrator": "",
            "text": "理由は？",
            "zh": "理由是？",
            "narrator_zh": ""
        },
        {
            "location": "502/TALK",
            "narrator": "みやび",
            "text": "色々あるけんど、\n面倒くさいんやね。",
            "zh": "理由有一堆，\n但说到底就是麻烦咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "503/TALK",
            "narrator": "みやび",
            "text": "あの子らが、うちの劇場で\nバイトするように\nなったんはしっちゅうか？",
            "zh": "那几个孩子开始\n在我剧场里打工\n这件事，你知道啵？",
            "narrator_zh": "雅"
        },
        {
            "location": "504/SEL",
            "narrator": "",
            "text": "はい",
            "zh": "是",
            "narrator_zh": ""
        },
        {
            "location": "505/SEL",
            "narrator": "",
            "text": "いいえ",
            "zh": "不是",
            "narrator_zh": ""
        },
        {
            "location": "506/ACT",
            "narrator": "",
            "text": "はい",
            "zh": "是",
            "narrator_zh": ""
        },
        {
            "location": "507/ACT",
            "narrator": "",
            "text": "いいえ",
            "zh": "不是",
            "narrator_zh": ""
        },
        {
            "location": "509/TALK",
            "narrator": "みやび",
            "text": "まあそんなわけやき、\n今後わりと頻繁に顔を\n合わせることになる。",
            "zh": "嘛就是这么回事啵，\n今后会相当频繁地\n碰面。",
            "narrator_zh": "雅"
        },
        {
            "location": "511/TALK",
            "narrator": "みやび",
            "text": "そんな相手をぞんざいに\nして、今後気まずく\nなったら大変ぞね。",
            "zh": "要是怠慢了那种对象，\n以后搞得关系尴尬\n就大事不妙咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "512/TALK",
            "narrator": "みやび",
            "text": "うち、\n出社拒否してまうやも\nしれんよ。",
            "zh": "我啊，\n搞不好会闹起\n拒绝出勤哦。",
            "narrator_zh": "雅"
        },
        {
            "location": "513/TALK",
            "narrator": "みやび",
            "text": "つばめちゃんの友達ちゅう\nこともあるき、逃げ道が\nないしね。",
            "zh": "加上她们是燕的朋友，\n想逃\n也没路逃咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "514/SEL",
            "narrator": "",
            "text": "確かにみやびらしい思考",
            "zh": "确实很像雅会有的想法",
            "narrator_zh": ""
        },
        {
            "location": "515/ACT",
            "narrator": "",
            "text": "確かにみやびらしい思考",
            "zh": "确实很像雅会有的想法",
            "narrator_zh": ""
        },
        {
            "location": "517/TALK",
            "narrator": "みやび",
            "text": "納得してくれて\nなによりや。",
            "zh": "你能认同，\n比什么都好咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "518/TALK",
            "narrator": "みやび",
            "text": "やき、ここで逃げるんは\n簡単やけんど、それは\nいかんちゅう結論や。",
            "zh": "所以啵，在这里逃开\n虽然简单，但结论是\n不能那么干。",
            "narrator_zh": "雅"
        },
        {
            "location": "519/TALK",
            "narrator": "みやび",
            "text": "とはいえ、逃げたいと\n考える自分に荷担しゆう\nクランもおる。",
            "zh": "话虽如此，\n也有库兰在偏袒着\n那个想逃跑的自己。",
            "narrator_zh": "雅"
        },
        {
            "location": "520/TALK",
            "narrator": "みやび",
            "text": "ちゅうわけで、すっと\nソイツを排除しいや。\nよろしく頼んだぞね。",
            "zh": "所以呢，把那家伙\n利落地排除掉。\n就拜托你咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "521/TALK",
            "narrator": "みやび",
            "text": "うちと$handle$に\nえいココロの旅を。",
            "zh": "献给我和$handle$的\n美妙的心灵之旅。",
            "narrator_zh": "雅"
        },
        {
            "location": "31/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>7月9日　2:41 PM</color>\nとある休日の午後、秋葉原にある某メイドカフェにて。",
            "zh": "<color=green>7月9日　2:41 PM</color>\n某个休息日的午后，秋叶原某家女仆咖啡厅。",
            "narrator_zh": "Dialog_EventData"
        },
        {
