{
    "dir": "chap05/daydra/dd_ch02_05_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "5205",
        "cid": "ayami",
        "title": "005 メインストーリー",
        "sub_title": "劇場の日常＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "剧场的日常＜后篇＞"
    },
    "entry": [
        {
            "location": "394/SCENARIO",
            "narrator": "",
            "text": "幽霊の出る指令本部",
            "zh": "闹鬼的指挥部",
            "narrator_zh": ""
        },
        {
            "location": "421/TALK",
            "narrator": "アーヤ",
            "text": "…私ってば、\n何悩んでるのかしら。",
            "zh": "……我到底\n在烦恼什么。",
            "narrator_zh": "绫水"
        },
        {
            "location": "422/TALK",
            "narrator": "アーヤ",
            "text": "嫌われるかもとか、\nそんな理由で言葉に\n詰まるなんて――",
            "zh": "会不会被讨厌，\n就因为这种理由\n说不出话——",
            "narrator_zh": "绫水"
        },
        {
            "location": "423/TALK",
            "narrator": "アーヤ",
            "text": "リーダーとしても、\n先輩としても\n失格よね。",
            "zh": "作为队长，\n作为前辈，\n都不合格。",
            "narrator_zh": "绫水"
        },
        {
            "location": "424/TALK",
            "narrator": "アーヤ",
            "text": "私は、自分が正しいと\n思ったことを貫く。",
            "zh": "我要贯彻自己\n认为正确的事。",
            "narrator_zh": "绫水"
        },
        {
            "location": "425/TALK",
            "narrator": "アーヤ",
            "text": "…うん、もう大丈夫。",
            "zh": "……嗯，已经没事了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "429/TALK",
            "narrator": "アーヤ",
            "text": "ほら、二人とも！\n文句を言うのは\nそこまでよ。",
            "zh": "好了，你们两个！\n抱怨\n到此为止。",
            "narrator_zh": "绫水"
        },
        {
            "location": "434/TALK",
            "narrator": "アーヤ",
            "text": "もう時間だから、\nさっさと仕事始める！",
            "zh": "已经到时间了，\n赶紧开始干活！",
            "narrator_zh": "绫水"
        },
        {
            "location": "435/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "436/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "439/TALK",
            "narrator": "みやび",
            "text": "…ま、そうやね。\nまほさんに怒られ\nたくないし。",
            "zh": "……嘛，是这样咯。\n也不想被真幌\n骂。",
            "narrator_zh": "雅"
        },
        {
            "location": "441/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…わかった。\n働くわよ…。",
            "zh": "哈啊……知道了。\n干活就是了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "442/TALK",
            "narrator": "アーヤ",
            "text": "そ、そう？\nわかってくれれば\nいいのよ。",
            "zh": "是、是吗？\n你们明白\n就好。",
            "narrator_zh": "绫水"
        },
        {
            "location": "446/TALK",
            "narrator": "アーヤ",
            "text": "…なんか、あっさり\n聞いてくれたわね？",
            "zh": "……怎么，这么干脆\n就听了？",
            "narrator_zh": "绫水"
        },
        {
            "location": "448/TALK",
            "narrator": "アーヤ",
            "text": "やっぱり、ガツンと\n言うことも必要、って\nことかしら。",
            "zh": "果然，有时候\n也得狠狠说，\n是吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "452/TALK",
            "narrator": "アーヤ",
            "text": "…心配し過ぎだった\nかしら。",
            "zh": "……是不是\n担心过头了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "453/TALK",
            "narrator": "アーヤ",
            "text": "悪い子達じゃないん\nだから、少しキツく\n言ったって――",
            "zh": "又不是坏孩子，\n稍微说重一点\n——",
            "narrator_zh": "绫水"
        },
        {
            "location": "455/TALK",
            "narrator": "アーヤ",
            "text": "正しいことなら\n嫌われたりなんて\nしないのに…。",
            "zh": "只要是对的，\n也不会被\n讨厌……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "461/TALK",
            "narrator": "アーヤ",
            "text": "それじゃ、急いで\n持ち場について。",
            "zh": "那就快点\n去岗位上。",
            "narrator_zh": "绫水"
        },
        {
            "location": "462/TALK",
            "narrator": "みやび",
            "text": "あいあい。\n労働スタートぞね。",
            "zh": "好，好。\n劳动开始啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "463/TALK",
            "narrator": "ガブリエラ",
            "text": "ま、仕事なんて\n言っても――",
            "zh": "嘛，说是工作\n——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "486/TALK",
            "narrator": "ガブリエラ",
            "text": "――いつも通り、\nお客なんてほとんど\n来やしないんだから。",
            "zh": "——跟往常一样，\n客人几乎\n不会来。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "487/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…退屈…。\nん？",
            "zh": "哈啊……好无聊……。\n嗯？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "491/TALK",
            "narrator": "女子高校生Ａ",
            "text": "ほら、急いで急いで！\n始まっちゃうよ。",
            "zh": "快点，快点！\n要开始了。",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "493/TALK",
            "narrator": "男子高校生Ａ",
            "text": "そんな急がなくても\n平気だって。",
            "zh": "不用那么急\n也没事。",
            "narrator_zh": "男高中生A"
        },
        {
            "location": "495/TALK",
            "narrator": "ガブリエラ",
            "text": "えっ、お客！？",
            "zh": "诶，客人！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "496/TALK",
            "narrator": "ガブリエラ",
            "text": "いらっしゃいませ。",
            "zh": "欢迎光临。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "498/TALK",
            "narrator": "女子高校生Ａ",
            "text": "チケット二枚と\nポップコーン\nください。",
            "zh": "两张票，\n还有\n爆米花。",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "500/TALK",
            "narrator": "ガブリエラ",
            "text": "あ、はい。\nこちらになりますね。",
            "zh": "啊，好。\n是这些。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "502/TALK",
            "narrator": "女子高校生Ａ",
            "text": "ありがと。",
            "zh": "谢谢。",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "504/TALK",
            "narrator": "ガブリエラ",
            "text": "…アーヤが強く言って\nくれて、助かったわ。",
            "zh": "……亏绫水说得重，\n帮了大忙。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "505/TALK",
            "narrator": "ガブリエラ",
            "text": "もし勝手に閉店してて\nクレームが来たら――",
            "zh": "要是擅自关门，\n客人来投诉——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "506/TALK",
            "narrator": "ガブリエラ",
            "text": "まほに大目玉くらう\nとこだったわ…。",
            "zh": "差点被真幌\n狠狠骂一顿……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "508/TALK",
            "narrator": "男子高校生Ａ",
            "text": "ってか、超古い映画\nみたいだけど、\n面白いのか？",
            "zh": "话说，看起来是\n超老的电影，\n好看吗？",
            "narrator_zh": "男高中生A"
        },
        {
            "location": "510/TALK",
            "narrator": "女子高校生Ａ",
            "text": "超名作中の名作よ！\nすっごい泣けるん\nだから！",
            "zh": "超有名的名作！\n会哭得\n很厉害的！",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "512/TALK",
            "narrator": "女子高校生Ａ",
            "text": "ほら、早く行こ！",
            "zh": "来，快走！",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "514/TALK",
            "narrator": "男子高校生Ａ",
            "text": "お、おい、\n引っ張んなって！",
            "zh": "喂、喂，\n别拉我！",
            "narrator_zh": "男高中生A"
        },
        {
            "location": "519/TALK",
            "narrator": "ガブリエラ",
            "text": "…あの二人、\n多分カップルよね？",
            "zh": "……那两个人，\n大概是一对吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "521/TALK",
            "narrator": "ガブリエラ",
            "text": "いいなぁ…。\nあたしも、いつかは\nあんな風に…。",
            "zh": "真好啊……。\n我什么时候\n也能那样……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "525/TALK",
            "narrator": "男子高校生Ｂ",
            "text": "すいません。\nチケット一枚とコーヒー、\nお願いします",
            "zh": "不好意思。\n一张票和咖啡，\n拜托了",
            "narrator_zh": "男高中生B"
        },
        {
            "location": "528/TALK",
            "narrator": "ガブリエラ",
            "text": "っ！？",
            "zh": "唔！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "529/TALK",
            "narrator": "男子高校生Ｂ",
            "text": "？",
            "zh": "？",
            "narrator_zh": "男高中生B"
        },
        {
            "location": "532/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "533/TALK",
            "narrator": "男子高校生Ｂ",
            "text": "あ、ああ、どうも…。",
            "zh": "啊，啊，谢谢……。",
            "narrator_zh": "男高中生B"
        },
        {
            "location": "538/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…。",
            "zh": "哈啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "539/TALK",
            "narrator": "ガブリエラ",
            "text": "男の人とまともに\n喋れないんだし、\nカップルはムリね…。",
            "zh": "跟男生都没法\n正常说话，\n恋爱是不可能了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "541/TALK",
            "narrator": "ガブリエラ",
            "text": "…それにしても、\n相変わらずお客が\n少ないわね。",
            "zh": "……话虽如此，\n客人还是\n那么少。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "542/TALK",
            "narrator": "ガブリエラ",
            "text": "ただでさえ少ないのに\nフェノメノンが\n出現したら――",
            "zh": "本来就少，\nPhenoMENON\n一出现——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "543/TALK",
            "narrator": "ガブリエラ",
            "text": "すぐに上映中止で\n指令室に切り替わるん\nだもの。",
            "zh": "马上停映，\n切换成\n指挥室。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "544/TALK",
            "narrator": "ガブリエラ",
            "text": "指令室兼用じゃ\nなかったら、\n今頃潰れてるわね…。",
            "zh": "要不是兼做指挥室，\n这会儿早就\n倒闭了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "545/TALK",
            "narrator": "ガブリエラ",
            "text": "…暇だし、みやびの\nところにでも\n行ってみようかしら。",
            "zh": "……闲着也是闲着，\n去雅那边\n看看吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "572/TALK",
            "narrator": "みやび",
            "text": "ふぅ…。\nまったく、忙しゅうて\n堪らんなぁ…。",
            "zh": "呼……。\n真是的，忙得很，\n受不了……。",
            "narrator_zh": "雅"
        },
        {
            "location": "575/TALK",
            "narrator": "ガブリエラ",
            "text": "…どの口が言うのよ？\nネットの記事見てる\nだけじゃない。",
            "zh": "……哪张嘴说的？\n不就是在看\n网上的文章。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "578/TALK",
            "narrator": "みやび",
            "text": "おお、ガブちゃん。\n別にさぼっちょる\nわけやないがよ？",
            "zh": "哦，加布。\n才不是在\n偷懒咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "580/TALK",
            "narrator": "みやび",
            "text": "フィルムをデータ\nベースに入れるだけの\n簡単な仕事は――",
            "zh": "把胶片放进\n数据库，\n这么简单的工作——",
            "narrator_zh": "雅"
        },
        {
            "location": "583/TALK",
            "narrator": "みやび",
            "text": "開始五分でミッション\nコンプリートや。",
            "zh": "开始五分钟\n就完成了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "585/TALK",
            "narrator": "ガブリエラ",
            "text": "だから遊んでたの？\nアーヤに見つかったら\nどやされるわよ？",
            "zh": "所以在玩？\n被绫水发现\n要挨骂的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "588/TALK",
            "narrator": "みやび",
            "text": "何言うてるが？\n本当は部屋に戻りたい\nところやけんど――",
            "zh": "你在说什么？\n其实想回房间，\n不过——",
            "narrator_zh": "雅"
        },
        {
            "location": "589/TALK",
            "narrator": "みやび",
            "text": "いなければならんき、\nこうして残っちょる\nがよ。",
            "zh": "人必须在啵，\n所以才这样留着\n咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "590/TALK",
            "narrator": "みやび",
            "text": "空いた時間に\n何しようと、\nうちの自由や。",
            "zh": "空下来的时间\n做什么，\n是我的自由咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "591/TALK",
            "narrator": "ガブリエラ",
            "text": "…まあ、バイト終わり\nまでぼーっとしてる\nわけにもいかないか。",
            "zh": "……嘛，到打工结束\n为止，也不能\n一直发呆。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "592/TALK",
            "narrator": "みやび",
            "text": "そういうことや。",
            "zh": "就是这么回事咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "594/TALK",
            "narrator": "みやび",
            "text": "…しっかし、戦闘後に\nフルタイムのバイト\nさせるなんて――",
            "zh": "……话说，战斗之后\n还让人打全天的工\n——",
            "narrator_zh": "雅"
        },
        {
            "location": "596/TALK",
            "narrator": "みやび",
            "text": "まほさんは鬼やね。",
            "zh": "真幌真狠咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "597/TALK",
            "narrator": "ガブリエラ",
            "text": "五分で終わらせた人の\nセリフじゃないわよ？",
            "zh": "五分钟就干完的人，\n没资格说这话吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "600/TALK",
            "narrator": "ガブリエラ",
            "text": "…でも、暇してるのは\nあたしだけじゃない\nみたいね。",
            "zh": "……不过，闲着的\n好像不只\n我一个。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "603/TALK",
            "narrator": "みやび",
            "text": "なんや、ガブちゃんは\n暇つぶしを所望か？",
            "zh": "怎么，加布\n想找事打发？",
            "narrator_zh": "雅"
        },
        {
            "location": "606/TALK",
            "narrator": "みやび",
            "text": "それなら特別に、\n面白い物を\n見せちゃる。",
            "zh": "那就特别，\n拿个有意思的东西\n给你看。",
            "narrator_zh": "雅"
        },
        {
            "location": "610/TALK",
            "narrator": "みやび",
            "text": "実はこのＰＣ、本庁と\n繋がっちょって――",
            "zh": "其实这台PC，\n和本厅连着——",
            "narrator_zh": "雅"
        },
        {
            "location": "611/TALK",
            "narrator": "みやび",
            "text": "うちらにクランを\n送るサーバーとも\n繋がっちょるんよ。",
            "zh": "也和给我们送库兰的\n服务器\n连着。",
            "narrator_zh": "雅"
        },
        {
            "location": "612/TALK",
            "narrator": "ガブリエラ",
            "text": "え！？",
            "zh": "诶！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "614/TALK",
            "narrator": "みやび",
            "text": "つまり、このＰＣを\nちくっと弄れば――",
            "zh": "就是说，把这台PC\n弄一哈——",
            "narrator_zh": "雅"
        },
        {
            "location": "615/TALK",
            "narrator": "みやび",
            "text": "クラン達とチャットで\n会話することも\n可能っちゅうことや！",
            "zh": "还能和库兰们\n用聊天\n说话咯！",
            "narrator_zh": "雅"
        },
        {
            "location": "617/TALK",
            "narrator": "ガブリエラ",
            "text": "いや、それマズいん\nじゃないの？",
            "zh": "不对，那样\n很糟吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "618/TALK",
            "narrator": "ガブリエラ",
            "text": "それに、劇場で映画\nやってる間って――",
            "zh": "而且，剧场在放电影\n的时候——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "621/TALK",
            "narrator": "ガブリエラ",
            "text": "クラン達も寝てるから\n出てこれないはず\nだけど…。",
            "zh": "库兰们也在睡，\n应该出不来\n……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "623/TALK",
            "narrator": "みやび",
            "text": "まあ、出てこられたら\n大騒ぎになるきね。",
            "zh": "嘛，要是出来了\n可就闹大了啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "624/TALK",
            "narrator": "みやび",
            "text": "けんど裏ではちゃんと\n繋がっちょるき、\n会話くらいは可能や。",
            "zh": "不过背面好好\n连着啵，\n聊几句还是可以咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "629/TALK",
            "narrator": "みやび",
            "text": "よし、ガブちゃん。\nスマホのチャット画面\n開いてみぃ。",
            "zh": "好，加布。\n把手机的聊天画面\n打开看看。",
            "narrator_zh": "雅"
        },
        {
            "location": "642/TALK",
            "narrator": "ガブリエラ",
            "text": "誰かいるの？",
            "zh": "有人在吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "644/TALK",
            "narrator": "コルト",
            "text": "あれ！？",
            "zh": "咦！？",
            "narrator_zh": "柯尔特"
        },
        {
            "location": "645/TALK",
            "narrator": "コルト",
            "text": "ギャヴィ姉さんッスか！？",
            "zh": "是加维吗！？",
            "narrator_zh": "柯尔特"
        },
        {
            "location": "646/TALK",
            "narrator": "ガブリエラ",
            "text": "コルト！？",
            "zh": "柯尔特！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "647/TALK",
            "narrator": "ガブリエラ",
            "text": "スゴい！",
            "zh": "好厉害！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "648/TALK",
            "narrator": "ガブリエラ",
            "text": "まさか、こんな風に話せるなんて思わなかったわ",
            "zh": "没想到还能这样说话",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "649/TALK",
            "narrator": "ガブリエラ",
            "text": "今って、スクリーンの中にいるのよね？",
            "zh": "现在，你在银幕里面吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "650/TALK",
            "narrator": "ガブリエラ",
            "text": "みんな、どんな感じでいるの？",
            "zh": "大家，都是什么状态？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "652/TALK",
            "narrator": "コルト",
            "text": "みんな、のんびりしてるッス",
            "zh": "大家都悠闲着",
            "narrator_zh": "柯尔特"
        },
        {
            "location": "653/TALK",
            "narrator": "コルト",
            "text": "ここが俺達の家ッスからね",
            "zh": "因为这里是我们的家",
            "narrator_zh": "柯尔特"
        },
        {
            "location": "654/TALK",
            "narrator": "ガブリエラ",
            "text": "そうなんだ？",
            "zh": "是这样吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "655/TALK",
            "narrator": "コルト",
            "text": "それじゃ、引き続きバイト頑張ってください",
            "zh": "那就继续加油打工",
            "narrator_zh": "柯尔特"
        },
        {
            "location": "666/TALK",
            "narrator": "ガブリエラ",
            "text": "…凄いわ！\n本当にコルトと\nチャットしちゃった！",
            "zh": "……好厉害！\n真的和柯尔特\n聊上了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "668/TALK",
            "narrator": "みやび",
            "text": "驚くのはまだまだや。\n呼び出せるんは\nコルトだけやない。",
            "zh": "吃惊还早咯。\n能叫出来的\n不只柯尔特。",
            "narrator_zh": "雅"
        },
        {
            "location": "669/TALK",
            "narrator": "みやび",
            "text": "例えば、こうすると\nとうちゃんが――",
            "zh": "比如，这样做的话\n老爸就会——",
            "narrator_zh": "雅"
        },
        {
            "location": "677/TALK",
            "narrator": "みやび",
            "text": "…………あかん。\nやってもうた。",
            "zh": "…………不行。\n搞砸了。",
            "narrator_zh": "雅"
        },
        {
            "location": "679/TALK",
            "narrator": "ガブリエラ",
            "text": "え？",
            "zh": "诶？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "697/TALK",
            "narrator": "アーヤ",
            "text": "ぐすっ…、\nう、ううっ…。",
            "zh": "呜……，\n呜、呜呜……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "698/TALK",
            "narrator": "アーヤ",
            "text": "この映画、やばいわ。\nまさかこんなに泣ける\nなんて…。",
            "zh": "这电影，太厉害了。\n没想到这么\n催泪……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "701/TALK",
            "narrator": "アーヤ",
            "text": "……え？",
            "zh": "……诶？",
            "narrator_zh": "绫水"
        },
        {
            "location": "703/TALK",
            "narrator": "アーヤ",
            "text": "えぇっ！？",
            "zh": "诶诶！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "719/TALK",
            "narrator": "とうちゃん",
            "text": "な、何だこりゃ！？\nまだ上映中じゃ\nねぇか！",
            "zh": "什、什么啊这是！？\n还在放映\n吧！",
            "narrator_zh": "老爸"
        },
        {
            "location": "720/TALK",
            "narrator": "男子高校生Ａ",
            "text": "は？　なんか急に\n３Ｄになったぞ？",
            "zh": "哈？　怎么突然\n变成3D了？",
            "narrator_zh": "男高中生A"
        },
        {
            "location": "721/TALK",
            "narrator": "女子高校生Ａ",
            "text": "うわぁ、カワイイ！\nでも、こんなシーン\nあったかしら？",
            "zh": "哇，好可爱！\n可是，有这种场面\n吗？",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "737/TALK",
            "narrator": "アーヤ",
            "text": "な、何でとうちゃんが\n出てきて――",
            "zh": "为、为什么老爸\n会出来——",
            "narrator_zh": "绫水"
        },
        {
            "location": "738/TALK",
            "narrator": "アーヤ",
            "text": "…まさか！！\nみやびが\n何かやったんじゃ！？",
            "zh": "……难道！！\n是雅\n搞了什么！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "740/TALK",
            "narrator": "アーヤ",
            "text": "みやび！！\nどこなの、みやび！？",
            "zh": "雅！！\n在哪，雅！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "751/TALK",
            "narrator": "男子高校生Ｂ",
            "text": "へぇ、この映画館は\nグラス無しで３Ｄが\n楽しめるんだ…。",
            "zh": "嘿，这家电影院\n不用眼镜就能看\n3D啊……。",
            "narrator_zh": "男高中生B"
        },
        {
            "location": "752/TALK",
            "narrator": "とうちゃん",
            "text": "は？　スリージー？\n何言ってやがんだ\nこいつ？",
            "zh": "哈？　3D？\n这家伙在说\n什么？",
            "narrator_zh": "老爸"
        },
        {
            "location": "753/TALK",
            "narrator": "男子高校生Ｂ",
            "text": "えっ！？　俺の声に\n反応を…いやいや、\nまさか…。",
            "zh": "诶！？　对我的声音\n有反应……不会吧，\n难道……。",
            "narrator_zh": "男高中生B"
        },
        {
            "location": "754/TALK",
            "narrator": "とうちゃん",
            "text": "おいおい、どうなって\nやがんだばーろー！？\n誰か説明しろ！！",
            "zh": "喂喂，这是怎么\n回事啊混蛋！？\n谁来解释！！",
            "narrator_zh": "老爸"
        },
        {
            "location": "782/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょ、みやび！\nどうするのよこれ！？",
            "zh": "等、雅！\n这要怎么办！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "783/TALK",
            "narrator": "みやび",
            "text": "…映画とは、現実とは\n違う夢の世界を見る\nための娯楽や。",
            "zh": "……电影，是用来看\n和现实不同的梦的\n娱乐咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "784/TALK",
            "narrator": "みやび",
            "text": "お客達も、３Ｄ映画\nにしか思わんき、\nそう大事には――",
            "zh": "客人也只会当成\n3D电影啵，\n不会闹成大事——",
            "narrator_zh": "雅"
        },
        {
            "location": "789/TALK",
            "narrator": "アーヤ",
            "text": "ちょっと！\n何やってるの！？",
            "zh": "等等！\n你在干什么！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "792/TALK",
            "narrator": "みやび",
            "text": "…しもた。",
            "zh": "……糟了。",
            "narrator_zh": "雅"
        },
        {
            "location": "825/TALK",
            "narrator": "真幌",
            "text": "おまえ等、一体何を\n考えているんだ！？",
            "zh": "你们到底在\n想什么！？",
            "narrator_zh": "真幌"
        },
        {
            "location": "826/TALK",
            "narrator": "真幌",
            "text": "一歩間違えば、\nここが我々の指令室\nだというのが――",
            "zh": "一步走错，\n这里是我们的指挥室\n这件事——",
            "narrator_zh": "真幌"
        },
        {
            "location": "827/TALK",
            "narrator": "真幌",
            "text": "世間にバレていた\nかもしれないん\nだぞ！？",
            "zh": "也许就会\n暴露到外面\n去了！？",
            "narrator_zh": "真幌"
        },
        {
            "location": "829/TALK",
            "narrator": "ガブリエラ",
            "text": "あ、あの…、あたしは\n関係ないんだけど…。",
            "zh": "那、那个……我\n其实没关系……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "831/TALK",
            "narrator": "真幌",
            "text": "うるさい！\n止めなかったおまえも\n同罪だ！！",
            "zh": "吵死了！\n没拦住的你\n也是同罪！！",
            "narrator_zh": "真幌"
        },
        {
            "location": "833/TALK",
            "narrator": "ガブリエラ",
            "text": "理不尽だわ…。",
            "zh": "太不讲理了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "835/TALK",
            "narrator": "真幌",
            "text": "大体だな、本庁の\nＰＣに不正アクセス\nしただけでも――",
            "zh": "本来，光是非法访问\n本厅的PC\n——",
            "narrator_zh": "真幌"
        },
        {
            "location": "836/TALK",
            "narrator": "真幌",
            "text": "本来なら懲役もんだ！\nわかっているのか！？",
            "zh": "本来就够判刑了！\n明白吗！？",
            "narrator_zh": "真幌"
        },
        {
            "location": "837/TALK",
            "narrator": "みやび",
            "text": "すみません。",
            "zh": "对不起。",
            "narrator_zh": "雅"
        },
        {
            "location": "839/TALK",
            "narrator": "みやび",
            "text": "けんど、本庁があんな\nザルセキュリティとは\n思わなくて…。",
            "zh": "不过，没想到本厅的\n安保这么\n漏洞百出……。",
            "narrator_zh": "雅"
        },
        {
            "location": "842/TALK",
            "narrator": "真幌",
            "text": "そのザルに、どれだけ\n予算が掛けられてるか\nわかってんのか！？",
            "zh": "那个筛子上，\n花了多少预算\n你们知道吗！？",
            "narrator_zh": "真幌"
        },
        {
            "location": "845/TALK",
            "narrator": "真幌",
            "text": "…いや、しかし簡単に\nハックされた本庁にも\n非はあるな。",
            "zh": "……不，不过轻易被攻破的\n本厅也有\n责任。",
            "narrator_zh": "真幌"
        },
        {
            "location": "846/TALK",
            "narrator": "真幌",
            "text": "それに、とりあえず\n大事にはならずに\nすんだようだし…。",
            "zh": "而且，总之\n没闹成大事，\n算是过去了……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "849/TALK",
            "narrator": "アーヤ",
            "text": "お客さんが\n３人だけだったのも\n幸いでした。",
            "zh": "客人\n只有三个，\n也算幸运。",
            "narrator_zh": "绫水"
        },
        {
            "location": "850/TALK",
            "narrator": "アーヤ",
            "text": "幽霊が出た、という\nことにして――",
            "zh": "就说是闹了鬼\n——",
            "narrator_zh": "绫水"
        },
        {
            "location": "851/TALK",
            "narrator": "アーヤ",
            "text": "謝罪と口止め料で\nどうにかなったので。",
            "zh": "道歉加上封口费，\n总算摆平了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "854/TALK",
            "narrator": "真幌",
            "text": "…まあ、それなら\n今回だけは大目に\nみてやるが――",
            "zh": "……嘛，那样的话\n这次就睁只眼\n闭只眼——",
            "narrator_zh": "真幌"
        },
        {
            "location": "857/TALK",
            "narrator": "真幌",
            "text": "今度やったら…、\n本気で殴るからな？",
            "zh": "下次再干……，\n我可真的打人了？",
            "narrator_zh": "真幌"
        },
        {
            "location": "858/TALK",
            "narrator": "みやび",
            "text": "すみません！",
            "zh": "对不起！",
            "narrator_zh": "雅"
        },
        {
            "location": "859/TALK",
            "narrator": "ガブリエラ",
            "text": "ごめんなさい！",
            "zh": "对不起！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "862/TALK",
            "narrator": "真幌",
            "text": "ったく…ただでさえ\n機密性を高めなければ\nならないのに…。",
            "zh": "真是的……本来就得\n提高机密性\n……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "863/TALK",
            "narrator": "アーヤ",
            "text": "やっぱり、本庁には\n連絡するんですか？",
            "zh": "果然，要跟\n本厅联系吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "865/TALK",
            "narrator": "真幌",
            "text": "当然だ。\nパスワードの変更は\nもちろん――",
            "zh": "当然。\n改密码\n是不用说——",
            "narrator_zh": "真幌"
        },
        {
            "location": "866/TALK",
            "narrator": "真幌",
            "text": "セキュリティの強化も\nしなければならなく\nなったからな。",
            "zh": "安保也必须\n加强\n才行。",
            "narrator_zh": "真幌"
        },
        {
            "location": "867/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "870/TALK",
            "narrator": "真幌",
            "text": "とにかく、反省しろ。\nバカ者どもが…。",
            "zh": "总之，反省。\n一群笨蛋……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "876/TALK",
            "narrator": "ガブリエラ",
            "text": "…まったく。\nみやびのせいで\n酷い目にあったわ。",
            "zh": "……真是的。\n都怪雅，\n倒了大霉。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "877/TALK",
            "narrator": "みやび",
            "text": "ふむ…セキュリティを\n上げる事態にさせて\nしもうたか…。",
            "zh": "嗯……让事情变成\n要提高安保了\n……。",
            "narrator_zh": "雅"
        },
        {
            "location": "879/TALK",
            "narrator": "アーヤ",
            "text": "もうお遊びができなく\nなるわね。\nそんなにブルー？",
            "zh": "不能再玩了\n吧。\n这么失落？",
            "narrator_zh": "绫水"
        },
        {
            "location": "882/TALK",
            "narrator": "みやび",
            "text": "まさか。\nどちらかっちゅうと、\nレッドやね。",
            "zh": "哪会。\n要说的话，\n是兴奋咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "883/TALK",
            "narrator": "みやび",
            "text": "うちに対抗して\nセキュリティを上げる\nっちゅうことは――",
            "zh": "对方为了对付我\n提高安保，\n这件事——",
            "narrator_zh": "雅"
        },
        {
            "location": "884/TALK",
            "narrator": "みやび",
            "text": "うちへの挑戦状と\nみなして間違いなし！",
            "zh": "当成给我的挑战书，\n绝对没错！",
            "narrator_zh": "雅"
        },
        {
            "location": "886/TALK",
            "narrator": "ガブリエラ",
            "text": "大間違いよ！！",
            "zh": "大错特错！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "889/TALK",
            "narrator": "みやび",
            "text": "久しぶりに\n燃えてきたぞね！",
            "zh": "好久没有\n这么有干劲了啵！",
            "narrator_zh": "雅"
        },
        {
            "location": "893/TALK",
            "narrator": "みやび",
            "text": "セキュリティ破ったら\nまたガブちゃんに\n教えちゃるきね。",
            "zh": "要是破了安保，\n再教给\n加布啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "895/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしを\n巻き込まないで！",
            "zh": "别把我\n卷进去！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "898/TALK",
            "narrator": "アーヤ",
            "text": "はぁ…、一度本当に\n殴られないと\nダメみたいね…。",
            "zh": "哈啊……，看来不真的\n挨一次打\n是不行了……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "909/DIALOG",
            "narrator": "Dialog_chapter_ch02",
            "text": "【03 赤い髪の転校生】",
            "zh": "【03 红发的转学生】",
            "narrator_zh": "Dialog_chapter_ch02"
        }
    ]
}
