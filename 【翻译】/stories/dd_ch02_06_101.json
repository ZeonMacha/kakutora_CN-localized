{
    "dir": "chap06/daydra/dd_ch02_06_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "6202",
        "cid": "ayami",
        "title": "002 メインストーリー",
        "sub_title": "出陣【Case：アーヤ】＜前編＞",
        "title_zh": "002 主线剧情",
        "sub_title_zh": "出击【Case：绫水】＜前篇＞"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "出陣【アーヤから見たCase】",
            "zh": "出击【从绫水眼中看到的Case】",
            "narrator_zh": ""
        },
        {
            "location": "48/TALK",
            "narrator": "アーヤ",
            "text": "逢瀬さん？",
            "zh": "逢濑？",
            "narrator_zh": "绫水"
        },
        {
            "location": "50/TALK",
            "narrator": "つばめ",
            "text": "は、はいっ！？",
            "zh": "是、是！？",
            "narrator_zh": "燕"
        },
        {
            "location": "51/TALK",
            "narrator": "アーヤ",
            "text": "そんなに緊張しないでも\n平気よ。",
            "zh": "不用那么紧张\n也没事。",
            "narrator_zh": "绫水"
        },
        {
            "location": "53/TALK",
            "narrator": "つばめ",
            "text": "す、すみません…。\nわたし、こういうのって\n初めてで…。",
            "zh": "对、对不起……。\n我，这种事\n是第一次……。",
            "narrator_zh": "燕"
        },
        {
            "location": "57/TALK",
            "narrator": "アーヤ",
            "text": "…まあ、緊張するのは\n当然よね。",
            "zh": "……嘛，紧张\n也是当然的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "58/TALK",
            "narrator": "アーヤ",
            "text": "最年長のリーダーとして、\n私が支えてあげないと\nダメよね。",
            "zh": "作为年纪最大的队长，\n不撑住她们\n不行。",
            "narrator_zh": "绫水"
        },
        {
            "location": "62/TALK",
            "narrator": "アーヤ",
            "text": "ここを抜けるまで\n少し時間ありそうだから、\n今のうちに説明するわ。",
            "zh": "到离开这里\n好像还有点时间，\n趁现在说明一下。",
            "narrator_zh": "绫水"
        },
        {
            "location": "65/TALK",
            "narrator": "アーヤ",
            "text": "今私達の歩いている\nこの場所は、現実と\n非現実との――",
            "zh": "我们现在走的\n这个地方，是现实和\n非现实的——",
            "narrator_zh": "绫水"
        },
        {
            "location": "68/TALK",
            "narrator": "アーヤ",
            "text": "…見た感じ、\n逢瀬さんって\n普通の子よね？",
            "zh": "……看起来，\n逢濑\n是普通的孩子吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "69/TALK",
            "narrator": "アーヤ",
            "text": "少なくとも、命がけの\n戦いに参加するような\n子には思えないし。",
            "zh": "至少，不像会参加\n拼命战斗的\n孩子。",
            "narrator_zh": "绫水"
        },
        {
            "location": "70/TALK",
            "narrator": "アーヤ",
            "text": "…本当に、こんな子を\n戦闘に連れ出して\n大丈夫なのかしら？",
            "zh": "……真的，把这样的孩子\n带去战斗\n没问题吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "74/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…ねえ、アーヤ。\nやっぱあたし達だけで\n行った方が良くない？",
            "zh": "哈啊……喂，绫水。\n果然还是我们自己去\n比较好吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "75/TALK",
            "narrator": "ガブリエラ",
            "text": "何もわかってない子を\n連れてったって、\n足手まといになるだけよ。",
            "zh": "带一个什么都不懂的孩子，\n只会\n拖后腿。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "78/TALK",
            "narrator": "アーヤ",
            "text": "ちょっと、ギャヴィ。\nそういう言い方は…。",
            "zh": "等等，加维。\n那种说法……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "81/TALK",
            "narrator": "ガブリエラ",
            "text": "事実を言ったまでよ。",
            "zh": "我只是说事实。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "83/TALK",
            "narrator": "つばめ",
            "text": "い、いいんです。\n勉強不足なわたしが\n悪いんだし…。",
            "zh": "没、没关系。\n是我学得不够\n不好……。",
            "narrator_zh": "燕"
        },
        {
            "location": "85/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "88/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィ、逢瀬さんが\n気に入らないのかしら？",
            "zh": "加维，是不喜欢\n逢濑吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "90/TALK",
            "narrator": "アーヤ",
            "text": "だとすると、ちょっと\n困ったことになるわね。",
            "zh": "那样的话，\n会有点难办。",
            "narrator_zh": "绫水"
        },
        {
            "location": "94/TALK",
            "narrator": "アーヤ",
            "text": "まったく…まあ、話を\n続けるとね――",
            "zh": "真是的……嘛，话\n接着说——",
            "narrator_zh": "绫水"
        },
        {
            "location": "95/TALK",
            "narrator": "アーヤ",
            "text": "なんで私達だけが\n洗脳されないのか――",
            "zh": "为什么只有我们\n不会被洗脑——",
            "narrator_zh": "绫水"
        },
        {
            "location": "96/TALK",
            "narrator": "アーヤ",
            "text": "それは今もって研究中。\n解明されていないの。",
            "zh": "这件事到现在还在研究。\n没有解明。",
            "narrator_zh": "绫水"
        },
        {
            "location": "99/TALK",
            "narrator": "アーヤ",
            "text": "――とりあえず、説明は\nこんなところかしら。\nどう、わかった？",
            "zh": "——总之，说明\n就到这里。\n怎么样，明白了吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "101/TALK",
            "narrator": "つばめ",
            "text": "え？　あ、は、はい！\nありがとうございます！",
            "zh": "诶？　啊，是、是！\n谢谢！",
            "narrator_zh": "燕"
        },
        {
            "location": "102/TALK",
            "narrator": "アーヤ",
            "text": "…あまり頭に入って\nないみたい。",
            "zh": "……好像没怎么\n听进去。",
            "narrator_zh": "绫水"
        },
        {
            "location": "105/TALK",
            "narrator": "アーヤ",
            "text": "まあ、初日だものね。\n緊張するな、っていうのが\n無理な話か…。",
            "zh": "嘛，第一天。\n叫她别紧张，\n也是强人所难……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "107/TALK",
            "narrator": "アーヤ",
            "text": "…そういえば――",
            "zh": "……这么说——",
            "narrator_zh": "绫水"
        },
        {
            "location": "108/TALK",
            "narrator": "アーヤ",
            "text": "逢瀬さんのあの力の\nことも考えないと\nいけないわね。",
            "zh": "逢濑的那个力量，\n也得考虑\n才行。",
            "narrator_zh": "绫水"
        },
        {
            "location": "109/TALK",
            "narrator": "アーヤ",
            "text": "あの力が何なのか。\nそれがわからない\nことには――",
            "zh": "那个力量是什么。\n在弄清楚之前\n——",
            "narrator_zh": "绫水"
        },
        {
            "location": "110/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィだけじゃ\nなくて、私も怖くて\n堪らないし。",
            "zh": "不只是加维，\n我也害怕得\n不得了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "113/TALK",
            "narrator": "つばめ",
            "text": "あ、あの、その…。",
            "zh": "那、那个，那个……。",
            "narrator_zh": "燕"
        },
        {
            "location": "114/TALK",
            "narrator": "つばめ",
            "text": "大丈夫ですよね？\nだって、皆さんとっても\n強いし…。",
            "zh": "没事的吧？\n因为大家都很\n强……。",
            "narrator_zh": "燕"
        },
        {
            "location": "116/TALK",
            "narrator": "アーヤ",
            "text": "…だといいけど。",
            "zh": "……但愿如此。",
            "narrator_zh": "绫水"
        },
        {
            "location": "117/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "118/TALK",
            "narrator": "アーヤ",
            "text": "…やっぱり、姉に\n連絡するべきかしら？",
            "zh": "……果然，该联系\n姐姐吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "119/TALK",
            "narrator": "アーヤ",
            "text": "あの人なら、きっと\nすぐに答えを出して\nくれると思うし。",
            "zh": "那个人的话，一定\n马上就能给出\n答案。",
            "narrator_zh": "绫水"
        },
        {
            "location": "121/TALK",
            "narrator": "アーヤ",
            "text": "ううん。\nやっぱり無理。",
            "zh": "不。\n还是不行。",
            "narrator_zh": "绫水"
        },
        {
            "location": "122/TALK",
            "narrator": "アーヤ",
            "text": "あの人に連絡なんて、\n絶対に嫌よ！",
            "zh": "联系那个人，\n绝对讨厌！",
            "narrator_zh": "绫水"
        },
        {
            "location": "123/SEL",
            "narrator": "",
            "text": "何でお姉さんのこと、そんな嫌ってるの？",
            "zh": "为什么那么讨厌你的姐姐？",
            "narrator_zh": ""
        },
        {
            "location": "124/ACT",
            "narrator": "",
            "text": "何でお姉さんのこと、そんな嫌ってるの？",
            "zh": "为什么那么讨厌你的姐姐？",
            "narrator_zh": ""
        },
        {
            "location": "135/TALK",
            "narrator": "アーヤ",
            "text": "……",
            "zh": "……",
            "narrator_zh": "绫水"
        },
        {
            "location": "140/TALK",
            "narrator": "アーヤ",
            "text": "…何、今の？",
            "zh": "……什么，刚才？",
            "narrator_zh": "绫水"
        },
        {
            "location": "141/TALK",
            "narrator": "アーヤ",
            "text": "私、姉のこと言葉に\n出してなかったのに、\nどうして？",
            "zh": "我没把姐姐的事\n说出口，\n为什么？",
            "narrator_zh": "绫水"
        },
        {
            "location": "142/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "143/TALK",
            "narrator": "アーヤ",
            "text": "まさか、私の心を\n読んでる！？",
            "zh": "难道，在读\n我的心！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "144/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "145/TALK",
            "narrator": "アーヤ",
            "text": "ううん、偶然よ。\n心を読んだりなんて\nできるはずないもの。",
            "zh": "不，是巧合。\n读心什么的\n不可能。",
            "narrator_zh": "绫水"
        },
        {
            "location": "146/TALK",
            "narrator": "アーヤ",
            "text": "バカなこと考えて\nないで、少し落ち着か\nないと…。",
            "zh": "别想傻事了，\n得冷静一点\n……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "193/TALK",
            "narrator": "アーヤ",
            "text": "ようこそ[ココロゲート]へ。\nいつも悪いわね。",
            "zh": "欢迎来到[心之扉]。\n总是麻烦你。",
            "narrator_zh": "绫水"
        },
        {
            "location": "194/TALK",
            "narrator": "アーヤ",
            "text": "さて、今回の\n【問題の扉】は…っと。",
            "zh": "那么，这次的\n【问题之门】是……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "201/TALK",
            "narrator": "アーヤ",
            "text": "オープンプロセス、\n0x2FC番地から\n0xE5E番地へ。",
            "zh": "开放进程，\n从0x2FC地址\n到0xE5E地址。",
            "narrator_zh": "绫水"
        },
        {
            "location": "216/TALK",
            "narrator": "アーヤ",
            "text": "シーク完了。",
            "zh": "搜索完成。",
            "narrator_zh": "绫水"
        },
        {
            "location": "218/TALK",
            "narrator": "アーヤ",
            "text": "それで？\n今回はどんな理由で…。",
            "zh": "然后？\n这次是什么理由……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "219/TALK",
            "narrator": "アーヤ",
            "text": "…。",
            "zh": "……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "220/TALK",
            "narrator": "アーヤ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "221/TALK",
            "narrator": "アーヤ",
            "text": "ああ、姉のこと……。",
            "zh": "啊，姐姐的事……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "222/SEL",
            "narrator": "",
            "text": "アーヤのお姉さんのこと、教えてくれるの？",
            "zh": "能告诉我绫水的姐姐的事吗？",
            "narrator_zh": ""
        },
        {
            "location": "223/ACT",
            "narrator": "",
            "text": "アーヤのお姉さんのこと、教えてくれるの？",
            "zh": "能告诉我绫水的姐姐的事吗？",
            "narrator_zh": ""
        },
        {
            "location": "225/TALK",
            "narrator": "アーヤ",
            "text": "えーっと……",
            "zh": "那个……",
            "narrator_zh": "绫水"
        },
        {
            "location": "226/TALK",
            "narrator": "アーヤ",
            "text": "残念だけど、ココロの\n司書という立場では、\n教えられないのよね。",
            "zh": "可惜，以心之\n司书的立场，\n不能说。",
            "narrator_zh": "绫水"
        },
        {
            "location": "227/TALK",
            "narrator": "アーヤ",
            "text": "１つだけ言えることは、\n私は姉のことをすごく\n恨んでるってこと。",
            "zh": "只能说一件事，\n我非常\n恨姐姐。",
            "narrator_zh": "绫水"
        },
        {
            "location": "228/TALK",
            "narrator": "アーヤ",
            "text": "そして今、私はその事で\nまた色々思い出して、\n怒りが大きくなってる。",
            "zh": "而现在，我又因为这件事\n想起了好多，\n怒气正在变大。",
            "narrator_zh": "绫水"
        },
        {
            "location": "229/TALK",
            "narrator": "アーヤ",
            "text": "まずはその怒りを鎮め\nないと。今は冷静な判断も\nできない状態だから。",
            "zh": "得先把这股怒气压下去。\n现在冷静的判断\n也做不到。",
            "narrator_zh": "绫水"
        },
        {
            "location": "230/TALK",
            "narrator": "アーヤ",
            "text": "お願い。\n協力してくれる？",
            "zh": "拜托。\n能帮我吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "231/TALK",
            "narrator": "アーヤ",
            "text": "姉と何があったかは、\nきっと近いうちに\n知る機会があると思う。",
            "zh": "和姐姐之间发生了什么，\n我想不久\n就会有机会知道。",
            "narrator_zh": "绫水"
        },
        {
            "location": "232/TALK",
            "narrator": "アーヤ",
            "text": "だから今回は、\n何も聞かずに國政綾水に\n協力してください。",
            "zh": "所以这次，\n什么都别问，请协助\n国政绫水。",
            "narrator_zh": "绫水"
        },
        {
            "location": "233/SEL",
            "narrator": "",
            "text": "もちろん",
            "zh": "当然",
            "narrator_zh": ""
        },
        {
            "location": "234/SEL",
            "narrator": "",
            "text": "遠慮します",
            "zh": "我拒绝",
            "narrator_zh": ""
        },
        {
            "location": "235/ACT",
            "narrator": "",
            "text": "もちろん",
            "zh": "当然",
            "narrator_zh": ""
        },
        {
            "location": "236/TALK",
            "narrator": "アーヤ",
            "text": "ありがとう！",
            "zh": "谢谢！",
            "narrator_zh": "绫水"
        },
        {
            "location": "237/TALK",
            "narrator": "アーヤ",
            "text": "それじゃ、この扉のこと\nよろしくお願いね。",
            "zh": "那么，这扇门\n就拜托了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "239/TALK",
            "narrator": "アーヤ",
            "text": "$handle$さんと\n國政綾水にとって、\n素敵なココロの旅を！",
            "zh": "献给$handle$和\n国政绫水的，\n美妙的心灵之旅！",
            "narrator_zh": "绫水"
        },
        {
            "location": "246/ACT",
            "narrator": "",
            "text": "遠慮します",
            "zh": "我拒绝",
            "narrator_zh": ""
        },
        {
            "location": "247/TALK",
            "narrator": "アーヤ",
            "text": "そう、残念。",
            "zh": "这样啊，可惜。",
            "narrator_zh": "绫水"
        },
        {
            "location": "248/TALK",
            "narrator": "アーヤ",
            "text": "まあでも、無理強いは\nできないものね。",
            "zh": "嘛，也不能\n勉强。",
            "narrator_zh": "绫水"
        },
        {
            "location": "249/TALK",
            "narrator": "アーヤ",
            "text": "また気が向いたら\nつき合ってもらえると\n嬉しいかな。",
            "zh": "哪天有心情了，\n再陪我一次\n就好。",
            "narrator_zh": "绫水"
        },
        {
            "location": "45/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>5月9日　1:45 PM</color>\nWAVE戦フェノメノン内部へ向かう途中、不確定量子の繭の中にて。",
            "zh": "<color=green>5月9日　1:45 PM</color>\n前往WAVE战的PhenoMENON内部途中，在不确定量子的茧里。",
            "narrator_zh": "Dialog_EventData"
        },
        {
            "location": "158/DIALOG",
            "narrator": "BattleInit/Dialog_BATTLE_ch02",
            "text": "<color=black><size=50><b>國政綾水のココロの中で\nバトルが始まりました。</b></size></color>\n\n\n\n\n\n彼女のココロの中に、\n大きな葛藤が生まれています。\n\nココロスフィアにダイブして\n國政綾水の心の葛藤を解消してください。\n\n\n\n",
