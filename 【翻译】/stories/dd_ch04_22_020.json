{
    "dir": "chap22/daydra/dd_ch04_22_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "22456",
        "cid": "miyabi",
        "title": "Extra005 プレミアムストーリー",
        "sub_title": "真幌の相手",
        "title_zh": "Extra005 额外剧情",
        "sub_title_zh": "陪真幌出门"
    },
    "entry": [
        {
            "location": "305/SCENARIO",
            "narrator": "",
            "text": "真幌の相手",
            "zh": "陪真幌出门",
            "narrator_zh": ""
        },
        {
            "location": "318/TALK",
            "narrator": "みやび",
            "text": "いや、何度誘われても\nうちは行かんきね。",
            "zh": "不，你们邀请多少次，\n我都不会去的啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "320/TALK",
            "narrator": "つばめ",
            "text": "でも、こっちに来てから、\nほとんど家にこもりっ\nぱなしじゃないですか。",
            "zh": "可是，你来了这边之后，\n几乎都一直把自己\n关在家里不是吗。",
            "narrator_zh": "燕"
        },
        {
            "location": "321/TALK",
            "narrator": "つばめ",
            "text": "海まですぐなんですし、\nちょっとだけでも\n泳ぎませんか？",
            "zh": "这里离海边很近，\n哪怕只游一小会儿，\n不去吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "323/TALK",
            "narrator": "アーヤ",
            "text": "そうよ、少しは身体を\n動かした方がいいわ。",
            "zh": "是啊，稍微活动一下\n身体才好哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "325/TALK",
            "narrator": "みやび",
            "text": "毎朝まほさんの特訓で、\n汗かくほど動いてるき。",
            "zh": "每天早上的真幌特训，\n都动到出汗啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "326/TALK",
            "narrator": "みやび",
            "text": "これ以上動く気は\nないちや。",
            "zh": "再多动的心思\n是没得滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "329/TALK",
            "narrator": "アーヤ",
            "text": "まったく、本当に\n外出嫌いなんだから…。",
            "zh": "真是的，你是真的\n讨厌出门啊……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "331/TALK",
            "narrator": "アーヤ",
            "text": "まあ、砂浜にいるから\n気が変わったらいつでも\n来てね。",
            "zh": "算了，我们在沙滩上，\n你要改主意了，\n随时可以来哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "332/TALK",
            "narrator": "つばめ",
            "text": "待ってますね。",
            "zh": "我们等你哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "340/TALK",
            "narrator": "みやび",
            "text": "いや、待たれても\n行かんいうてるのに…。",
            "zh": "不是，都说了不去，\n等着也没用……。",
            "narrator_zh": "雅"
        },
        {
            "location": "343/TALK",
            "narrator": "真幌",
            "text": "せっかく目と鼻の先に、\nほとんど誰も来ない\n砂浜があるんだぞ？",
            "zh": "难得眼前就有片\n几乎没人来的\n沙滩，不是吗？",
            "narrator_zh": "真幌"
        },
        {
            "location": "344/TALK",
            "narrator": "真幌",
            "text": "行って、おもいっきり\n泳がないのはもったい\nないんじゃないか？",
            "zh": "去了却不痛痛快快\n游个够，那也太\n可惜了吧？",
            "narrator_zh": "真幌"
        },
        {
            "location": "346/TALK",
            "narrator": "みやび",
            "text": "まほさん…朝の特訓が\n終わってからずっと\nゴロゴロしてますね。",
            "zh": "真幌……早上特训\n结束之后就一直\n瘫着没动呢。",
            "narrator_zh": "雅"
        },
        {
            "location": "347/TALK",
            "narrator": "みやび",
            "text": "まほさんこそ、\nちっくと海で動いた方が\nえいんやないですか？",
            "zh": "真幌才是，\n不也该去海边活动\n一下子才好咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "348/TALK",
            "narrator": "真幌",
            "text": "そうは言うがな、\n早朝から指導する方も\n大変なんだぞ。",
            "zh": "话是这么说，\n一大早就指导人的\n这边也很累啊。",
            "narrator_zh": "真幌"
        },
        {
            "location": "349/TALK",
            "narrator": "真幌",
            "text": "私の生活リズムは、\nみやびもよく知っている\nだろう？",
            "zh": "我的生活节奏，\n雅你也很清楚\n吧？",
            "narrator_zh": "真幌"
        },
        {
            "location": "353/TALK",
            "narrator": "みやび",
            "text": "…確かに、早寝早起きは\n大敵でしたね。",
            "zh": "…确实，早睡早起\n是死敌来着。",
            "narrator_zh": "雅"
        },
        {
            "location": "354/TALK",
            "narrator": "真幌",
            "text": "ああ…本当は夕方からに\n変更したいのだが――",
            "zh": "唉……本来想改成\n傍晚开始的——",
            "narrator_zh": "真幌"
        },
        {
            "location": "355/TALK",
            "narrator": "真幌",
            "text": "それだと、遊び疲れて\n訓練にならない可能性も\n考えられるからな。",
            "zh": "但那样的话，有可能\n玩到累瘫，训练就\n不成样子了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "358/TALK",
            "narrator": "みやび",
            "text": "ありえますね。",
            "zh": "很有可能呢。",
            "narrator_zh": "雅"
        },
        {
            "location": "359/TALK",
            "narrator": "みやび",
            "text": "まあ、早起きした分、\nここで昼寝して\n休んでてください。",
            "zh": "那真幌就当补上\n早起的觉，在这里\n睡个午觉休息吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "360/TALK",
            "narrator": "みやび",
            "text": "うちはそろそろ、\n部屋に戻るんで…。",
            "zh": "我差不多，\n也该回房间了……。",
            "narrator_zh": "雅"
        },
        {
            "location": "361/TALK",
            "narrator": "真幌",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "真幌"
        },
        {
            "location": "363/TALK",
            "narrator": "真幌",
            "text": "いや、やっぱりいかんな。",
            "zh": "不，果然还是不行。",
            "narrator_zh": "真幌"
        },
        {
            "location": "365/TALK",
            "narrator": "みやび",
            "text": "何がですか？",
            "zh": "什么不行？",
            "narrator_zh": "雅"
        },
        {
            "location": "366/TALK",
            "narrator": "真幌",
            "text": "…今気づいたんだが――",
            "zh": "……我刚意识到——",
            "narrator_zh": "真幌"
        },
        {
            "location": "368/TALK",
            "narrator": "真幌",
            "text": "教師が教え子の家に\n上がり込んで、一日中\nゴロゴロしているなど――",
            "zh": "老师跑进学生的家里，\n一整天瘫着\n不动什么的——",
            "narrator_zh": "真幌"
        },
        {
            "location": "369/TALK",
            "narrator": "真幌",
            "text": "許されることでは\nないだろう？",
            "zh": "可不是能被\n原谅的事吧？",
            "narrator_zh": "真幌"
        },
        {
            "location": "371/TALK",
            "narrator": "みやび",
            "text": "…大分ゴロゴロした後で\n言われてもなぁ…。",
            "zh": "…都瘫了大半天了\n才来说这个啊……。",
            "narrator_zh": "雅"
        },
        {
            "location": "372/TALK",
            "narrator": "真幌",
            "text": "よし、出かけるぞ。\nみやびも準備しろ。",
            "zh": "好，出门了。\n雅你也去准备。",
            "narrator_zh": "真幌"
        },
        {
            "location": "373/TALK",
            "narrator": "みやび",
            "text": "は！？　うちもですか？",
            "zh": "哈！？我也去吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "374/TALK",
            "narrator": "真幌",
            "text": "おまえ、こっち来てから\nほとんど家にいっぱなし\nらしいからな。",
            "zh": "你来了这边之后，\n好像几乎都窝在\n家里不动。",
            "narrator_zh": "真幌"
        },
        {
            "location": "375/TALK",
            "narrator": "真幌",
            "text": "少しは外に出ないと、\n本当に体調崩すぞ？",
            "zh": "不稍微出门的话，\n身体真的会垮哦？",
            "narrator_zh": "真幌"
        },
        {
            "location": "377/TALK",
            "narrator": "みやび",
            "text": "いや、面倒ですし…。",
            "zh": "不，太麻烦了……。",
            "narrator_zh": "雅"
        },
        {
            "location": "378/TALK",
            "narrator": "真幌",
            "text": "そう言うな。\n昼飯くらいなら、\n何でも奢ってやるぞ？",
            "zh": "别这么说。\n一顿午饭的话，\n什么都请你哦？",
            "narrator_zh": "真幌"
        },
        {
            "location": "380/TALK",
            "narrator": "みやび",
            "text": "…まほさん。\nもしかして、話し相手が\n欲しいがですか？",
            "zh": "……真幌。\n你该不会，是想要\n有人陪你说话咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "381/TALK",
            "narrator": "真幌",
            "text": "…まあ、一人で出かけても\n面白くはないからな。",
            "zh": "……唉，一个人出门\n确实也没意思。",
            "narrator_zh": "真幌"
        },
        {
            "location": "382/TALK",
            "narrator": "真幌",
            "text": "どうする？",
            "zh": "怎么样？",
            "narrator_zh": "真幌"
        },
        {
            "location": "385/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "387/TALK",
            "narrator": "みやび",
            "text": "ちっくと、部屋のＰＣの\n状態だけ確認させて\nください。",
            "zh": "让我稍微确认一下\n房间电脑的\n状态就好。",
            "narrator_zh": "雅"
        },
        {
            "location": "388/TALK",
            "narrator": "真幌",
            "text": "わかった。\nゆっくりでいいぞ。",
            "zh": "知道了。\n慢慢来就行。",
            "narrator_zh": "真幌"
        },
        {
            "location": "391/TALK",
            "narrator": "みやび",
            "text": "はぁ…さてと、どうした\nもんか…。",
            "zh": "唉……好啦，怎么办\n才好呢……。",
            "narrator_zh": "雅"
        },
        {
            "location": "403/TALK",
            "narrator": "みやび",
            "text": "出掛けたくないー",
            "zh": "不想出门——",
            "narrator_zh": "雅"
        },
        {
            "location": "405/SEL",
            "narrator": "",
            "text": "行きたくないって言えば？",
            "zh": "就说你不想去？",
            "narrator_zh": ""
        },
        {
            "location": "406/ACT",
            "narrator": "",
            "text": "行きたくないって言えば？",
            "zh": "就说你不想去？",
            "narrator_zh": ""
        },
        {
            "location": "408/TALK",
            "narrator": "みやび",
            "text": "いや",
            "zh": "不",
            "narrator_zh": "雅"
        },
        {
            "location": "409/TALK",
            "narrator": "みやび",
            "text": "さすがにまほさん相手に、そこまでハッキリとは言えんよ",
            "zh": "面对真幌，我可没法说得那么直白哦",
            "narrator_zh": "雅"
        },
        {
            "location": "411/TALK",
            "narrator": "みやび",
            "text": "やき、遠回しに行きたくないことを伝えられればえいんやけんど…",
            "zh": "所以呢，只要委婉传达出不想去的意思就好，但是…",
            "narrator_zh": "雅"
        },
        {
            "location": "412/TALK",
            "narrator": "みやび",
            "text": "まほさん、あれで鋭いき",
            "zh": "真幌那人其实很敏锐啵",
            "narrator_zh": "雅"
        },
        {
            "location": "413/TALK",
            "narrator": "みやび",
            "text": "すぐに遠回しに行きたくない言うてるってわかるやろうし",
            "zh": "马上就会听出我在委婉地说不想去",
            "narrator_zh": "雅"
        },
        {
            "location": "415/SEL",
            "narrator": "",
            "text": "何でも奢ってもらえるよ？",
            "zh": "能让她请吃任何东西哦？",
            "narrator_zh": ""
        },
        {
            "location": "416/SEL",
            "narrator": "",
            "text": "どこに行く気なのかな？",
            "zh": "她打算去哪呢？",
            "narrator_zh": ""
        },
        {
            "location": "417/ACT",
            "narrator": "",
            "text": "何でも奢ってもらえるよ？",
            "zh": "能让她请吃任何东西哦？",
            "narrator_zh": ""
        },
        {
            "location": "419/TALK",
            "narrator": "みやび",
            "text": "一食数万する高級店でも行くか？",
            "zh": "要去一顿几万的高级店吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "420/TALK",
            "narrator": "みやび",
            "text": "間違いなく、店ついた途端まほさんにキレられるけんど",
            "zh": "但毫无疑问，一到店就会被真幌骂",
            "narrator_zh": "雅"
        },
        {
            "location": "421/TALK",
            "narrator": "みやび",
            "text": "…いや、それよりも食べたいもんあったわ",
            "zh": "…不对，比起这个，我有更想吃的东西来着",
            "narrator_zh": "雅"
        },
        {
            "location": "442/TALK",
            "narrator": "みやび",
            "text": "まほさん、さっき言うて\nましたが――",
            "zh": "真幌，你刚才\n说过——",
            "narrator_zh": "雅"
        },
        {
            "location": "444/TALK",
            "narrator": "みやび",
            "text": "本当に何でも奢って\nくれるいうなら、\n食事だけ付き合います。",
            "zh": "要是真的什么都\n肯请的话，\n我就只陪吃饭。",
            "narrator_zh": "雅"
        },
        {
            "location": "446/TALK",
            "narrator": "真幌",
            "text": "よし、決まりだ。\nでは行くとしよう。",
            "zh": "好，就这么定了。\n那就出发吧。",
            "narrator_zh": "真幌"
        },
        {
            "location": "464/TALK",
            "narrator": "ウェイトレス",
            "text": "お待たせしましたー。\nチョコレートパフェと\nカルボナーラになります。",
            "zh": "让您久等了——。\n巧克力芭菲和\n培根蛋面来了。",
            "narrator_zh": "女服务员"
        },
        {
            "location": "467/TALK",
            "narrator": "みやび",
            "text": "うちや。",
            "zh": "是我的。",
            "narrator_zh": "雅"
        },
        {
            "location": "468/TALK",
            "narrator": "ウェイトレス",
            "text": "はい…ごゆっくりどうぞ。",
            "zh": "好的……请慢用。",
            "narrator_zh": "女服务员"
        },
        {
            "location": "474/TALK",
            "narrator": "みやび",
            "text": "さてと、いただきます。",
            "zh": "好啦，我开动了。",
            "narrator_zh": "雅"
        },
        {
            "location": "475/TALK",
            "narrator": "真幌",
            "text": "…何故、よりにもよって\nファミレスを選んだ？",
            "zh": "……为什么，偏偏选了\n家庭餐厅？",
            "narrator_zh": "真幌"
        },
        {
            "location": "476/TALK",
            "narrator": "みやび",
            "text": "いや、こっち帰ってきて\nからいうもの――",
            "zh": "不，回到这边之后\n吃的东西——",
            "narrator_zh": "雅"
        },
        {
            "location": "477/TALK",
            "narrator": "みやび",
            "text": "魚中心の和食ばかりで、\nちっくと飽きてきてたが\nですよ。",
            "zh": "全都是鱼类为主的\n和食，稍微有点\n吃腻了。",
            "narrator_zh": "雅"
        },
        {
            "location": "478/TALK",
            "narrator": "みやび",
            "text": "それに、甘い物も\n食べたい思うてたところ\nでしたし…あむっ。",
            "zh": "而且，正好也想吃\n甜的东西\n来着……啊呜。",
            "narrator_zh": "雅"
        },
        {
            "location": "479/TALK",
            "narrator": "みやび",
            "text": "…うん、ファミレスの\nパフェは全国どこでも\n味が一緒で安心ちや。",
            "zh": "……嗯，家庭餐厅的\n芭菲全国哪里都是\n一个味，安心滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "480/TALK",
            "narrator": "真幌",
            "text": "…せっかく三戸浜まで\n来ているのだから――",
            "zh": "……难得都来到\n三户滨了——",
            "narrator_zh": "真幌"
        },
        {
            "location": "481/TALK",
            "narrator": "真幌",
            "text": "美味い魚料理が\n食べたかったのだがな。",
            "zh": "本来是想吃点\n好吃的鱼类料理啊。",
            "narrator_zh": "真幌"
        },
        {
            "location": "482/TALK",
            "narrator": "みやび",
            "text": "魚料理やったら、\n今日も夕飯ででますき。",
            "zh": "鱼类料理的话，\n今天晚饭也会上啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "483/TALK",
            "narrator": "みやび",
            "text": "わざわざ外で食べる\n必要ないですよ。",
            "zh": "没必要特地\n在外面吃哦。",
            "narrator_zh": "雅"
        },
        {
            "location": "484/TALK",
            "narrator": "真幌",
            "text": "…そういうことか。",
            "zh": "……原来是这样。",
            "narrator_zh": "真幌"
        },
        {
            "location": "485/TALK",
            "narrator": "真幌",
            "text": "ここが地元で、更に言えば\nみやびほどの料理の腕が\nあれば――",
            "zh": "这里是你的老家，\n再加上有你这样的\n厨艺的话——",
            "narrator_zh": "真幌"
        },
        {
            "location": "486/TALK",
            "narrator": "真幌",
            "text": "魚料理など、わざわざ外に\n食べに行くものでは\nないのだろうな…。",
            "zh": "鱼类料理之类的，\n确实不用特地\n出门去吃吧……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "487/ACT",
            "narrator": "",
            "text": "どこに行く気なのかな？",
            "zh": "她打算去哪呢？",
            "narrator_zh": ""
        },
        {
            "location": "488/TALK",
            "narrator": "みやび",
            "text": "そういえば、聞いてなかったな",
            "zh": "这么说来，还没问过呢",
            "narrator_zh": "雅"
        },
        {
            "location": "489/TALK",
            "narrator": "みやび",
            "text": "とりあえずそれ聞いてから、もう一度考えるとするか",
            "zh": "先问清楚这个，再重新考虑一下吧",
            "narrator_zh": "雅"
        },
        {
            "location": "514/TALK",
            "narrator": "みやび",
            "text": "まほさん、一つ聞きます\nけんど、どこに行こう\n思うてます？",
            "zh": "真幌，我想问一件事，\n你打算去\n哪里呢？",
            "narrator_zh": "雅"
        },
        {
            "location": "516/TALK",
            "narrator": "真幌",
            "text": "どこかはわからんが、\n美味い物を食べに\n行きたいと思っていてな。",
            "zh": "去哪里还没定，\n只是想去吃点\n好吃的东西。",
            "narrator_zh": "真幌"
        },
        {
            "location": "517/TALK",
            "narrator": "真幌",
            "text": "三崎マグロを使った\n料理を沢山出すような\n店が――",
            "zh": "最好是用三崎金枪鱼\n做菜、能上好多\n菜式的店——",
            "narrator_zh": "真幌"
        },
        {
            "location": "518/TALK",
            "narrator": "真幌",
            "text": "この辺りには色々と\nあるのだろう？",
            "zh": "这附近应该\n有不少吧？",
            "narrator_zh": "真幌"
        },
        {
            "location": "519/TALK",
            "narrator": "みやび",
            "text": "いや、うちに聞かれても\nわからんがですよ。",
            "zh": "不，问我，\n我也不懂哦。",
            "narrator_zh": "雅"
        },
        {
            "location": "520/TALK",
            "narrator": "真幌",
            "text": "…何故だ？\nおまえの地元だろう？",
            "zh": "……为什么？\n这不是你的老家吗？",
            "narrator_zh": "真幌"
        },
        {
            "location": "521/TALK",
            "narrator": "みやび",
            "text": "知ってのとおり、\n母親の料理スキルが\n異様に高いき――",
            "zh": "你知道的，\n我妈的厨艺\n高得离谱啵——",
            "narrator_zh": "雅"
        },
        {
            "location": "522/TALK",
            "narrator": "みやび",
            "text": "実家にいる時は、\n外食なんぞ数えるほどしか\nしたことないがですよ。",
            "zh": "在老家的时候，\n下馆子驷马的也就\n屈指可数次哦。",
            "narrator_zh": "雅"
        },
        {
            "location": "524/TALK",
            "narrator": "真幌",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "真幌"
        },
        {
            "location": "525/TALK",
            "narrator": "みやび",
            "text": "まあ、行くとしても\n外食は洋食だけでしたね。",
            "zh": "要说出门吃，\n也基本只吃西餐而已呢。",
            "narrator_zh": "雅"
        },
        {
            "location": "526/TALK",
            "narrator": "真幌",
            "text": "…納得した。",
            "zh": "……有道理。",
            "narrator_zh": "真幌"
        },
        {
            "location": "528/TALK",
            "narrator": "真幌",
            "text": "おまえの母親の料理は、\n外で食べるよりも\n美味いからな。",
            "zh": "你母亲做的菜，\n比外面卖的\n更好吃啊。",
            "narrator_zh": "真幌"
        },
        {
            "location": "529/TALK",
            "narrator": "みやび",
            "text": "そういうことです。",
            "zh": "就是这么回事。",
            "narrator_zh": "雅"
        },
        {
            "location": "531/TALK",
            "narrator": "みやび",
            "text": "ちゅうか、まほさん。\nそんなに三崎マグロ\n食べたいなら――",
            "zh": "说起来，真幌。\n你那么想吃\n三崎金枪鱼的话——",
            "narrator_zh": "雅"
        },
        {
            "location": "532/TALK",
            "narrator": "みやび",
            "text": "卸売市場行って\n買うてきた方が\nえいですよ。",
            "zh": "去一趟批发市场\n买回来，\n不是更好哦。",
            "narrator_zh": "雅"
        },
        {
            "location": "533/TALK",
            "narrator": "みやび",
            "text": "材料さえあれば、\nうちで色々作れますし。",
            "zh": "只要有材料，\n我可以做很多花样。",
            "narrator_zh": "雅"
        },
        {
            "location": "534/TALK",
            "narrator": "みやび",
            "text": "その方が希望に沿ったもの\n作れますし、なにより、\n財布にも優しいですよ。",
            "zh": "那样做出来的菜\n更合你心意，而且\n对钱包也友好哦。",
            "narrator_zh": "雅"
        },
        {
            "location": "535/TALK",
            "narrator": "真幌",
            "text": "ふむ…いいかもしれんな。\nそっちの方が、美味い物が\n食べられそうだし…。",
            "zh": "唔……或许不错。\n那样的话，确实\n更吃得上好吃的……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "536/TALK",
            "narrator": "みやび",
            "text": "どうします？\nあれなら、作る用意して\n待ってますけんど？",
            "zh": "要怎么办？\n那样的话，我就准备好\n材料等你哦？",
            "narrator_zh": "雅"
        },
        {
            "location": "537/TALK",
            "narrator": "真幌",
            "text": "ああ、そうしてくれ。\nちょっと卸売市場行って、\n材料を買ってくる。",
            "zh": "好，就这么办。\n我去一趟批发市场，\n把材料买回来。",
            "narrator_zh": "真幌"
        },
        {
            "location": "538/TALK",
            "narrator": "真幌",
            "text": "今日の昼は三崎マグロの\nフルコースだ！",
            "zh": "今天的午饭就是\n三崎金枪鱼全席！",
            "narrator_zh": "真幌"
        },
        {
            "location": "542/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "543/TALK",
            "narrator": "みやび",
            "text": "外出はしないで\n済みそうやけんど――",
            "zh": "虽然看来是能\n躲过出门了——",
            "narrator_zh": "雅"
        },
        {
            "location": "545/TALK",
            "narrator": "みやび",
            "text": "なんか、逆に面倒なことに\nなりゆう気がするな…。",
            "zh": "总感觉，反而要变成\n麻烦事了……。",
            "narrator_zh": "雅"
        },
        {
            "location": "316/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>8月25日　 1:42 PM</color>\n合宿中、みやびの実家でのこと",
            "zh": "<color=green>8月25日　 1:42 PM</color>\n合宿期间，在雅的老家发生的事",
            "narrator_zh": "Dialog_EventData"
        }
    ]
}
