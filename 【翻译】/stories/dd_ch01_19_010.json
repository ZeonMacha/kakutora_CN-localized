{
    "dir": "chap19/daydra/dd_ch01_19_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "19152",
        "cid": "tsubame",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "差し入れ",
        "title_zh": "Extra002 额外剧情",
        "sub_title_zh": "慰问品"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "差し入れ",
            "zh": "慰问品",
            "narrator_zh": ""
        },
        {
            "location": "32/TALK",
            "narrator": "ヒカル",
            "text": "ひなこさん。\nアンテナに周辺機器を\n取り付け終わりました。",
            "zh": "小雏。\n天线的外围设备\n已经安装好了。",
            "narrator_zh": "光"
        },
        {
            "location": "34/TALK",
            "narrator": "雛",
            "text": "おおっ、凄い完璧じゃん！\nヒカルくんもこっち系に\n詳しくなってきたねー。",
            "zh": "哦哦，超完美的嘛！\n光也越来越懂\n这方面的东西了呢——。",
            "narrator_zh": "雏"
        },
        {
            "location": "35/TALK",
            "narrator": "ヒカル",
            "text": "説明書と、ひなこさんの\n教えのおかげですよ。",
            "zh": "这都是托了说明书\n和小雏指导的福。",
            "narrator_zh": "光"
        },
        {
            "location": "36/TALK",
            "narrator": "雛",
            "text": "よーし、それじゃあ\nさっさとアンテナを\n設置して――",
            "zh": "好——，那就\n赶紧把天线\n架起来——",
            "narrator_zh": "雏"
        },
        {
            "location": "39/TALK",
            "narrator": "つばめ",
            "text": "みんな、お疲れ様ー。",
            "zh": "大家，辛苦啦——。",
            "narrator_zh": "燕"
        },
        {
            "location": "46/TALK",
            "narrator": "雛",
            "text": "あっ、つばめちゃん！\nガブリエラちゃんも！",
            "zh": "啊，燕！\n加布里埃拉也在！",
            "narrator_zh": "雏"
        },
        {
            "location": "47/TALK",
            "narrator": "ヒカル",
            "text": "こんにちは、\n逢瀬さん、\nガブリエラさん。",
            "zh": "你好，\n逢濑，\n加布里埃拉。",
            "narrator_zh": "光"
        },
        {
            "location": "50/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "51/TALK",
            "narrator": "雛",
            "text": "ガブリエラちゃん、\nどうかしたの？",
            "zh": "加布里埃拉，\n怎么了吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "52/TALK",
            "narrator": "ガブリエラ",
            "text": "鉄塔の上、なんか必死に\n手を振ってるみたい\nだけど…。",
            "zh": "铁塔上面，好像有人\n在拼命招手\n的样子……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "53/TALK",
            "narrator": "ヒカル",
            "text": "え？　あっ！",
            "zh": "诶？ 啊！",
            "narrator_zh": "光"
        },
        {
            "location": "59/TALK",
            "narrator": "ヒカル",
            "text": "ごめん、キリト！\n今すぐ持っていきます！",
            "zh": "抱歉，圣翔！\n我马上拿上去！",
            "narrator_zh": "光"
        },
        {
            "location": "62/TALK",
            "narrator": "雛",
            "text": "あちゃー、キリトのこと\nすっかり忘れてたわー。",
            "zh": "哎呀——，把圣翔的事\n彻底忘光了——。",
            "narrator_zh": "雏"
        },
        {
            "location": "63/TALK",
            "narrator": "雛",
            "text": "ヒカルくん、行ける？\nアンテナ落とさないように\n気を付けてね。",
            "zh": "光，能行吗？\n小心别把天线\n摔下去了哦。",
            "narrator_zh": "雏"
        },
        {
            "location": "66/TALK",
            "narrator": "ヒカル",
            "text": "はい。\nちょっと行ってきます。",
            "zh": "好的。\n我去去就回。",
            "narrator_zh": "光"
        },
        {
            "location": "76/TALK",
            "narrator": "つばめ",
            "text": "わぁ…ヒカルくんって、\n結構力持ちなんだね？",
            "zh": "哇……光，\n力气还挺大的呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "81/TALK",
            "narrator": "雛",
            "text": "あの見た目と性格からは\n想像つかないよねー。",
            "zh": "看他那外表和性格，\n还真想象不到呢——。",
            "narrator_zh": "雏"
        },
        {
            "location": "83/TALK",
            "narrator": "雛",
            "text": "意外と、脱いだら筋肉\nムッキムキだったりして。",
            "zh": "说不定脱了衣服，\n意外地浑身肌肉鼓鼓囊囊的呢。",
            "narrator_zh": "雏"
        },
        {
            "location": "85/TALK",
            "narrator": "ガブリエラ",
            "text": "そ、そうかしら？",
            "zh": "是、是这样吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "87/TALK",
            "narrator": "雛",
            "text": "ふっふっふ…惚れた？",
            "zh": "哼哼哼……迷上了？",
            "narrator_zh": "雏"
        },
        {
            "location": "90/TALK",
            "narrator": "ガブリエラ",
            "text": "だから、どうしてそういう\n話につながるのよ！？",
            "zh": "所以说，怎么就扯到\n那种话题上去了啊！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "93/TALK",
            "narrator": "つばめ",
            "text": "そ、それより！\nひなこちゃん達、\nお昼まだだよね？",
            "zh": "那、先不说这个！\n小雏你们，\n还没吃午饭吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "94/TALK",
            "narrator": "つばめ",
            "text": "差し入れのお弁当\n持ってきたんだけど…。",
            "zh": "我带了慰问用的\n便当过来……。",
            "narrator_zh": "燕"
        },
        {
            "location": "95/SEL",
            "narrator": "",
            "text": "上、良い景色だろうね？",
            "zh": "上面，风景一定很好吧？",
            "narrator_zh": ""
        },
        {
            "location": "96/SEL",
            "narrator": "",
            "text": "早く遊びに行こうよ",
            "zh": "快点去玩吧",
            "narrator_zh": ""
        },
        {
            "location": "99/TALK",
            "narrator": "雛",
            "text": "わぁ、それマジ嬉しいよ！",
            "zh": "哇，这也太开心了吧！",
            "narrator_zh": "雏"
        },
        {
            "location": "100/TALK",
            "narrator": "雛",
            "text": "この辺り、食事のできる\nお店がないから\n困ってたんだー。",
            "zh": "这附近一家能吃饭的店\n都没有，\n正发愁呢——。",
            "narrator_zh": "雏"
        },
        {
            "location": "101/TALK",
            "narrator": "つばめ",
            "text": "いっぱいあるから、\n食べきれないかも\nしれないけど…。",
            "zh": "带了好多呢，\n虽然说不定\n吃不完……。",
            "narrator_zh": "燕"
        },
        {
            "location": "102/TALK",
            "narrator": "雛",
            "text": "う～ん…まあ、大丈夫じゃ\nないかなー？",
            "zh": "嗯～……嘛，应该\n没问题的吧——？",
            "narrator_zh": "雏"
        },
        {
            "location": "103/TALK",
            "narrator": "雛",
            "text": "食べ盛りの男の子が\n二人もいるんだし。",
            "zh": "这儿可还有两个\n正长身体的男生呢。",
            "narrator_zh": "雏"
        },
        {
            "location": "105/TALK",
            "narrator": "ガブリエラ",
            "text": "その言い方だと、\nなんか母親みたいよ？",
            "zh": "你这么一说，\n听起来像当妈的一样哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "108/TALK",
            "narrator": "雛",
            "text": "二人が下りて来たら、\n早速頂くよ。",
            "zh": "等他俩下来，\n我们就立马开吃。",
            "narrator_zh": "雏"
        },
        {
            "location": "109/TALK",
            "narrator": "つばめ",
            "text": "うん。",
            "zh": "嗯。",
            "narrator_zh": "燕"
        },
        {
            "location": "110/TALK",
            "narrator": "ガブリエラ",
            "text": "それじゃ、あたし達は\n戻るから。",
            "zh": "那么，我们就\n先回去了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "111/TALK",
            "narrator": "雛",
            "text": "あらら？\nもう行っちゃうの？",
            "zh": "哎呀？\n这就走啦？",
            "narrator_zh": "雏"
        },
        {
            "location": "112/TALK",
            "narrator": "ガブリエラ",
            "text": "あたし達のお昼、\nまだなのよ。",
            "zh": "我们俩的午饭\n也还没吃呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "113/TALK",
            "narrator": "雛",
            "text": "そうだったんだ。\nお弁当、\n本当にありがとねー。",
            "zh": "这样啊。\n便当，\n真的谢谢啦——。",
            "narrator_zh": "雏"
        },
        {
            "location": "115/ACT",
            "narrator": "",
            "text": "上、良い景色だろうね？",
            "zh": "上面，风景一定很好吧？",
            "narrator_zh": ""
        },
        {
            "location": "136/TALK",
            "narrator": "つばめ",
            "text": "鉄塔の上のこと？",
            "zh": "你是说铁塔上面吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "137/TALK",
            "narrator": "つばめ",
            "text": "そういえば、結構高いもんね",
            "zh": "说起来，确实挺高的呀",
            "narrator_zh": "燕"
        },
        {
            "location": "149/TALK",
            "narrator": "つばめ",
            "text": "ひなこちゃんも、\nこの鉄塔登ったりしたの？",
            "zh": "小雏也爬过\n这座铁塔吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "150/TALK",
            "narrator": "雛",
            "text": "もちろん。",
            "zh": "当然。",
            "narrator_zh": "雏"
        },
        {
            "location": "153/TALK",
            "narrator": "雛",
            "text": "結構上に運ばないと\nいけない物が多くてねー。",
            "zh": "得搬到上面去的东西\n还挺多的呀——。",
            "narrator_zh": "雏"
        },
        {
            "location": "154/TALK",
            "narrator": "雛",
            "text": "それに、後でアンテナの\n角度調整でもう一度\n登らないといけないし。",
            "zh": "而且，待会儿调整\n天线角度的时候，\n还得再爬一次。",
            "narrator_zh": "雏"
        },
        {
            "location": "155/TALK",
            "narrator": "ガブリエラ",
            "text": "こんな高いとこ、\n何度も登り降りしないと\nいけないの！？",
            "zh": "这么高的地方，\n要爬上爬下\n好几次吗！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "159/TALK",
            "narrator": "雛",
            "text": "まあねー。\nでも、鉄塔登るのって\n好きだから――",
            "zh": "嘛，是呀——。\n不过，我很喜欢\n爬铁塔——",
            "narrator_zh": "雏"
        },
        {
            "location": "160/TALK",
            "narrator": "雛",
            "text": "こういう機会をもらえて、\n凄く嬉しいんだ。",
            "zh": "能有这样的机会，\n我超开心的。",
            "narrator_zh": "雏"
        },
        {
            "location": "161/TALK",
            "narrator": "ガブリエラ",
            "text": "鉄塔登るのが好きって…\n変わってるわね。",
            "zh": "喜欢爬铁塔什么的……\n真是个怪人呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "162/TALK",
            "narrator": "つばめ",
            "text": "ねえねえ、ひなこちゃん。\n鉄塔の上からの景色って、\nどんな感じなの？",
            "zh": "呐呐，小雏。\n从铁塔上面看下去的风景，\n是什么感觉呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "163/TALK",
            "narrator": "雛",
            "text": "絶景だよ！\n遠くの方にある山とかも\nすっごいよく見えるし――",
            "zh": "绝景哦！\n连远处的高山什么的\n都看得超清楚——",
            "narrator_zh": "雏"
        },
        {
            "location": "164/TALK",
            "narrator": "雛",
            "text": "風も吹いてるから、\n下にいるより涼しくて\n快適なんだ。",
            "zh": "而且还有风吹着，\n比在下面凉快多了，\n可舒服了。",
            "narrator_zh": "雏"
        },
        {
            "location": "165/TALK",
            "narrator": "つばめ",
            "text": "そっかぁ…。\n気持ちよさそうだなぁ…。",
            "zh": "这样啊……。\n感觉好像很舒服呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "166/TALK",
            "narrator": "雛",
            "text": "もう、さいっこうだよ！",
            "zh": "简直，棒透了！",
            "narrator_zh": "雏"
        },
        {
            "location": "169/TALK",
            "narrator": "雛",
            "text": "…あ、そうだ！\nヒカルくーん、キリトー！",
            "zh": "……啊，对了！\n光——，圣翔——！",
            "narrator_zh": "雏"
        },
        {
            "location": "170/TALK",
            "narrator": "雛",
            "text": "ちょっとお願いがあるん\nだけどー！",
            "zh": "有件事想\n拜托你们——！",
            "narrator_zh": "雏"
        },
        {
            "location": "173/TALK",
            "narrator": "つばめ",
            "text": "…何する気だろ？",
            "zh": "……她想干嘛呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "175/TALK",
            "narrator": "ガブリエラ",
            "text": "…なんか、嫌な予感が\nしてきたわ。",
            "zh": "……总觉得，有种\n不好的预感了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "211/TALK",
            "narrator": "つばめ",
            "text": "わぁ！！",
            "zh": "哇！！",
            "narrator_zh": "燕"
        },
        {
            "location": "213/TALK",
            "narrator": "つばめ",
            "text": "凄い、凄いよぉ！\nあんな遠くの方まで\n見えるなんて！",
            "zh": "好厉害、好厉害哦！\n竟然能看到\n那么远的地方！",
            "narrator_zh": "燕"
        },
        {
            "location": "215/TALK",
            "narrator": "キリト",
            "text": "おいおい、逢瀬。\nあんまはしゃぐと\n落ちちまうぞ？",
            "zh": "喂喂，逢濑。\n别太闹腾了，\n会掉下去的哦？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "218/TALK",
            "narrator": "つばめ",
            "text": "あっ、ごめんなさい。",
            "zh": "啊，对不起。",
            "narrator_zh": "燕"
        },
        {
            "location": "221/TALK",
            "narrator": "つばめ",
            "text": "なんか、想像以上に\n素敵な景色で、夢中に\nなっちゃった。",
            "zh": "总觉得，风景比\n想象中还要漂亮，\n一下子入迷了。",
            "narrator_zh": "燕"
        },
        {
            "location": "225/TALK",
            "narrator": "ヒカル",
            "text": "逢瀬さんは、高いところ\n平気なんですか？",
            "zh": "逢濑，你不怕\n高的地方吗？",
            "narrator_zh": "光"
        },
        {
            "location": "226/TALK",
            "narrator": "ヒカル",
            "text": "特にここは、手すりも\n何もないところですし。",
            "zh": "尤其是这里，连扶手\n什么的都没有。",
            "narrator_zh": "光"
        },
        {
            "location": "228/TALK",
            "narrator": "つばめ",
            "text": "登ってる時は\nちょっと怖かったけど――",
            "zh": "往上爬的时候\n是有点害怕——",
            "narrator_zh": "燕"
        },
        {
            "location": "229/TALK",
            "narrator": "つばめ",
            "text": "この景色見たら、\nそんな気持ち\n消えちゃった。",
            "zh": "一看到这片风景，\n那种心情就\n全消失啦。",
            "narrator_zh": "燕"
        },
        {
            "location": "230/TALK",
            "narrator": "ガブリエラ",
            "text": "んなわけあるかぁ！",
            "zh": "怎么可能啊！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "233/TALK",
            "narrator": "つばめ",
            "text": "あっ、ガブちゃん。\nほらほら、早くここまで\n上がってきなよ！",
            "zh": "啊，加布。\n快点快点，\n也爬到这里来呀！",
            "narrator_zh": "燕"
        },
        {
            "location": "236/TALK",
            "narrator": "ガブリエラ",
            "text": "差し入れ持って来た\nだけなのに――",
            "zh": "明明只是过来送个\n慰问品而已——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "237/TALK",
            "narrator": "ガブリエラ",
            "text": "どうして鉄塔に登らなきゃ\nならないのよ！？",
            "zh": "为什么非得\n爬铁塔不可啊！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "241/TALK",
            "narrator": "雛",
            "text": "大丈夫だよ、\nガブリエラちゃん。",
            "zh": "没关系的，\n加布里埃拉。",
            "narrator_zh": "雏"
        },
        {
            "location": "242/TALK",
            "narrator": "雛",
            "text": "ちゃんと命綱付けてるし、\nあたしも支えてるから\n怖くないよ。",
            "zh": "安全绳绑得好好的，\n我也扶着你呢，\n不用怕哦。",
            "narrator_zh": "雏"
        },
        {
            "location": "245/TALK",
            "narrator": "ガブリエラ",
            "text": "べ、別に怖がってなんか\nないわよ！",
            "zh": "我、我才没有\n害怕呢！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "247/TALK",
            "narrator": "雛",
            "text": "下を見なければ平気だよ。",
            "zh": "不往下看就没事啦。",
            "narrator_zh": "雏"
        },
        {
            "location": "250/TALK",
            "narrator": "雛",
            "text": "ほら、向こうを見て。",
            "zh": "你看，看那边。",
            "narrator_zh": "雏"
        },
        {
            "location": "251/TALK",
            "narrator": "雛",
            "text": "三崎口駅を出発した\n電車が見えるでしょ？",
            "zh": "能看到从三崎口站\n出发的电车吧？",
            "narrator_zh": "雏"
        },
        {
            "location": "253/TALK",
            "narrator": "ガブリエラ",
            "text": "う、うん…。",
            "zh": "嗯、嗯……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "255/TALK",
            "narrator": "雛",
            "text": "ここからだと、隣の\n三浦海岸駅のホームで――",
            "zh": "从这里的话，能看到\n隔壁三浦海岸站的站台上——",
            "narrator_zh": "雏"
        },
        {
            "location": "256/TALK",
            "narrator": "雛",
            "text": "電車が止まるのが\n見えるんだよ！",
            "zh": "电车停靠的\n样子哦！",
            "narrator_zh": "雏"
        },
        {
            "location": "257/TALK",
            "narrator": "ガブリエラ",
            "text": "知らないわよ！\nっていうか、ここまで来て\nやっぱり電車なの！？",
            "zh": "鬼知道啊！\n话说回来，都爬到这儿了\n你还是只看电车吗！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "261/TALK",
            "narrator": "雛",
            "text": "ここまで来て？\nノンノン、違うよ\nガブリエラちゃん。",
            "zh": "“都爬到这儿了”？\nNon non，不对哦，\n加布里埃拉。",
            "narrator_zh": "雏"
        },
        {
            "location": "264/TALK",
            "narrator": "雛",
            "text": "ここからじゃなきゃ\n見られないんだよ！",
            "zh": "正是只有从这里\n才能看到呀！",
            "narrator_zh": "雏"
        },
        {
            "location": "265/TALK",
            "narrator": "ガブリエラ",
            "text": "力説されても\nわからないってば！",
            "zh": "再怎么使劲吹\n我也听不懂啦！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "267/TALK",
            "narrator": "つばめ",
            "text": "ガブちゃん、ほら。\nわたしの、隣に来て。",
            "zh": "加布，来。\n站到我旁边来。",
            "narrator_zh": "燕"
        },
        {
            "location": "268/TALK",
            "narrator": "ガブリエラ",
            "text": "そ、そう言われても…。",
            "zh": "就、就算你这么说……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "269/TALK",
            "narrator": "ヒカル",
            "text": "命綱はしっかり固定して\nあるから、大丈夫ですよ。",
            "zh": "安全绳固定得\n很牢固，没问题的。",
            "narrator_zh": "光"
        },
        {
            "location": "271/TALK",
            "narrator": "キリト",
            "text": "逢瀬、大丈夫だから\n引っ張ってやれ。",
            "zh": "逢濑，没事的，\n你拉她一把吧。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "274/TALK",
            "narrator": "つばめ",
            "text": "うん。",
            "zh": "嗯。",
            "narrator_zh": "燕"
        },
        {
            "location": "277/TALK",
            "narrator": "つばめ",
            "text": "ほら、ガブちゃん。",
            "zh": "来，加布。",
            "narrator_zh": "燕"
        },
        {
            "location": "278/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょ、きゃぁ！？",
            "zh": "等、呀啊！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "317/TALK",
            "narrator": "つばめ",
            "text": "ほら、ガブちゃん。\nもう大丈夫だよ。",
            "zh": "你看，加布。\n已经没事啦。",
            "narrator_zh": "燕"
        },
        {
            "location": "320/TALK",
            "narrator": "ガブリエラ",
            "text": "あ、あんたねぇ！\nちょっと無茶し過ぎよ！",
            "zh": "你、你呀！\n未免太乱来了吧！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "322/TALK",
            "narrator": "つばめ",
            "text": "えへへ…それより、ほら。\n下じゃなくて前を見て。",
            "zh": "诶嘿嘿……不说这个，你看。\n别往下看，看前面。",
            "narrator_zh": "燕"
        },
        {
            "location": "324/TALK",
            "narrator": "ガブリエラ",
            "text": "ま、前って…っ！？",
            "zh": "前、前面……！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "326/TALK",
            "narrator": "ガブリエラ",
            "text": "す、凄い…。\n何、この景色！？",
            "zh": "好、好厉害……。\n这是什么风景！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "329/TALK",
            "narrator": "つばめ",
            "text": "ビックリだよね？\nこんなに素敵だなんて、\nわたしも思わなかったよ。",
            "zh": "很惊人吧？\n我也没想到\n会这么漂亮哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "330/TALK",
            "narrator": "雛",
            "text": "ここまで登った人しか\n見れない、特別な景色\nだからねー。",
            "zh": "这可是只有爬到这儿的人\n才能看到的特别风景\n呢——。",
            "narrator_zh": "雏"
        },
        {
            "location": "331/TALK",
            "narrator": "雛",
            "text": "あたしなんか、何枚も\n写真撮っちゃったし。",
            "zh": "我呀，都忍不住\n拍了好几张照片呢。",
            "narrator_zh": "雏"
        },
        {
            "location": "332/TALK",
            "narrator": "キリト",
            "text": "電車のな。",
            "zh": "拍的是电车吧。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "335/TALK",
            "narrator": "雛",
            "text": "ここからしか撮れない\n写真に変わりないもん。",
            "zh": "反正是只有从这里才能拍到的\n照片，没差啦。",
            "narrator_zh": "雏"
        },
        {
            "location": "339/TALK",
            "narrator": "ヒカル",
            "text": "午前中は富士山も\n見えていたんですよ。",
            "zh": "上午的时候连富士山\n都能看见呢。",
            "narrator_zh": "光"
        },
        {
            "location": "340/TALK",
            "narrator": "つばめ",
            "text": "わぁ、いいなぁ。\nわたしも見たかったよ。",
            "zh": "哇，真好呀。\n我也好想看看哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "348/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "352/TALK",
            "narrator": "つばめ",
            "text": "あっ…ガブちゃん、\nちょっと震えてる？",
            "zh": "啊……加布，\n你有点在发抖吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "358/TALK",
            "narrator": "つばめ",
            "text": "…ガブちゃん。\nもう少しこっち来て。",
            "zh": "……加布。\n再往这边靠一点。",
            "narrator_zh": "燕"
        },
        {
            "location": "359/TALK",
            "narrator": "ガブリエラ",
            "text": "えっ？　きゃっ！",
            "zh": "诶？ 呀！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "367/TALK",
            "narrator": "つばめ",
            "text": "どう？　こうやって\nぎゅーってしてれば、\n寒くないでしょ？",
            "zh": "怎么样？像这样\n紧紧抱住的话，\n就不冷了吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "370/TALK",
            "narrator": "ガブリエラ",
            "text": "は？　え？\nさ、寒い？",
            "zh": "哈？ 诶？\n冷、冷？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "371/TALK",
            "narrator": "つばめ",
            "text": "だって、ガブちゃん\n震えてるみたいだし。",
            "zh": "因为加布\n好像在发抖嘛。",
            "narrator_zh": "燕"
        },
        {
            "location": "374/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "375/TALK",
            "narrator": "つばめ",
            "text": "ガブちゃん？",
            "zh": "加布？",
            "narrator_zh": "燕"
        },
        {
            "location": "379/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…本当、つばめって\n天然よね？",
            "zh": "唉……真是的，燕你可真是\n天然呆呀？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "380/TALK",
            "narrator": "つばめ",
            "text": "え…あ、身体の震え、\n止まったみたいだね。",
            "zh": "诶……啊，身体好像\n不抖了呢。",
            "narrator_zh": "燕"
        },
        {
            "location": "381/TALK",
            "narrator": "ガブリエラ",
            "text": "あんたの天然っぷりを\n見てたら、怖い気持ちも\n吹っ飛んだわ。",
            "zh": "看着你这么天然呆的样子，\n害怕的心情都\n飞到九霄云外了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "382/TALK",
            "narrator": "つばめ",
            "text": "え？　怖かったの？",
            "zh": "诶？你刚才害怕吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "383/TALK",
            "narrator": "ガブリエラ",
            "text": "あっ、ち、違う！\n寒かっただけよ！",
            "zh": "啊，不、不是！\n只是有点冷罢了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "386/TALK",
            "narrator": "ガブリエラ",
            "text": "…今は、つばめの身体が\n温かいから平気だけど。",
            "zh": "……现在因为燕身上\n暖呼呼的，所以没事了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "387/TALK",
            "narrator": "つばめ",
            "text": "じゃあ、もっとギューッて\nした方が良いかな？",
            "zh": "那，再紧紧抱住一点\n比较好吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "388/TALK",
            "narrator": "ガブリエラ",
            "text": "それだと暑いから、\n今くらいでいいってば。",
            "zh": "那样太热了，\n保持现在这样就够了啦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "389/TALK",
            "narrator": "つばめ",
            "text": "ん、わかった。",
            "zh": "嗯，知道了。",
            "narrator_zh": "燕"
        },
        {
            "location": "391/TALK",
            "narrator": "つばめ",
            "text": "でも、本当にここから\n見える景色、素敵だね。",
            "zh": "不过，从这里看到的风景\n真的好美呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "392/TALK",
            "narrator": "つばめ",
            "text": "多分、合宿で一番の\n思い出になりそうだよ。",
            "zh": "大概会成为这次合宿\n最棒的回忆吧。",
            "narrator_zh": "燕"
        },
        {
            "location": "394/TALK",
            "narrator": "ガブリエラ",
            "text": "…うん。\nあたしもそう思う。",
            "zh": "……嗯。\n我也这么觉得。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "395/ACT",
            "narrator": "",
            "text": "早く遊びに行こうよ",
            "zh": "快点去玩吧",
            "narrator_zh": ""
        },
        {
            "location": "415/TALK",
            "narrator": "つばめ",
            "text": "ダメだよ",
            "zh": "不行哦",
            "narrator_zh": "燕"
        },
        {
            "location": "416/TALK",
            "narrator": "つばめ",
            "text": "頑張ってるひなこちゃん達の前で、そんなこと言ったら",
            "zh": "在那么努力的小雏她们面前，不能说这种话啦",
            "narrator_zh": "燕"
        },
        {
            "location": "428/TALK",
            "narrator": "雛",
            "text": "つばめちゃん達、\nこれから遊びに行くの？",
            "zh": "燕你们，\n待会儿要去玩吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "431/TALK",
            "narrator": "つばめ",
            "text": "えっ！？",
            "zh": "诶！？",
            "narrator_zh": "燕"
        },
        {
            "location": "433/TALK",
            "narrator": "雛",
            "text": "ごめん、チラッとだけど\nスマホ画面見えちゃった！",
            "zh": "抱歉，虽然只瞄到一眼，\n不小心看见手机屏幕了！",
            "narrator_zh": "雏"
        },
        {
            "location": "435/TALK",
            "narrator": "ガブリエラ",
            "text": "何で仕事してる\nひなこの前で、遊びに行く\n話なんてしてるのよ？",
            "zh": "干嘛要在干活的\n小雏面前，聊什么\n去玩的话题啊？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "436/TALK",
            "narrator": "つばめ",
            "text": "ご、ごめんね。\nひなこちゃん達は\nまだお仕事してるのに…。",
            "zh": "对、对不起哦。\n明明小雏你们\n还在工作……。",
            "narrator_zh": "燕"
        },
        {
            "location": "437/TALK",
            "narrator": "雛",
            "text": "あー、いいのいいの。\n大変だけど、この作業って\n結構楽しいし。",
            "zh": "啊——，没事没事。\n虽然挺累的，但这活儿\n其实还挺有意思的。",
            "narrator_zh": "雏"
        },
        {
            "location": "438/TALK",
            "narrator": "雛",
            "text": "それに、今の調子だと\n夕方前には終わりそう\nだから――",
            "zh": "而且，照现在的势头，\n傍晚前应该就能\n结束了——",
            "narrator_zh": "雏"
        },
        {
            "location": "439/TALK",
            "narrator": "雛",
            "text": "よかったら、その後で\nあたしも合流して\nいいかな？",
            "zh": "不介意的话，待会儿\n我也能去和你们\n汇合吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "440/TALK",
            "narrator": "つばめ",
            "text": "うん、もちろん。",
            "zh": "嗯，当然。",
            "narrator_zh": "燕"
        },
        {
            "location": "441/TALK",
            "narrator": "つばめ",
            "text": "っていうか、わたしも\n手伝った方が、もっと\n早く終わるのかな？",
            "zh": "话说回来，要是\n我也来帮忙的话，\n是不是能结束得更快？",
            "narrator_zh": "燕"
        },
        {
            "location": "443/TALK",
            "narrator": "雛",
            "text": "う～ん…。\n一つ聞くけど、\nつばめちゃんはさ――",
            "zh": "嗯～……。\n问你一件事哦，\n燕——",
            "narrator_zh": "雏"
        },
        {
            "location": "446/TALK",
            "narrator": "雛",
            "text": "ここの鉄塔、一人で重い\n荷物持って登り降りする\nことできる？",
            "zh": "这里的铁塔，你能一个人\n扛着重物爬上爬下\n吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "447/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "449/TALK",
            "narrator": "つばめ",
            "text": "やっぱり、\n終わるの待ってるよ。",
            "zh": "我还是\n等你们忙完吧。",
            "narrator_zh": "燕"
        },
        {
            "location": "450/TALK",
            "narrator": "雛",
            "text": "うん、それがいいよ。\nなるべく早く終わらせて\n合流するね。",
            "zh": "嗯，那样最好啦。\n我尽量早点忙完\n过去汇合。",
            "narrator_zh": "雏"
        },
        {
            "location": "460/TALK",
            "narrator": "つばめ",
            "text": "そうだよね…。\n一人で鉄塔登れなきゃ、\nお手伝いにならないよね？",
            "zh": "也是呢……。\n一个人爬不上铁塔的话，\n根本算不上帮忙吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "461/TALK",
            "narrator": "ガブリエラ",
            "text": "最初に気付きなさいよ、\nまったく…。",
            "zh": "你早点意识到呀，\n真是的……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "462/TALK",
            "narrator": "ガブリエラ",
            "text": "…でも、ひなこが普通に\n登れるっていうのも、\n驚きだけどね。",
            "zh": "……不过，小雏竟然能\n面不改色地爬上去，\n也挺让人吃惊的呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "31/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>8月19日　 3:21 PM</color>\n合宿中、みやびの実家付近にて",
            "zh": "<color=green>8月19日　 3:21 PM</color>\n合宿期间，雅的老家附近",
            "narrator_zh": "Dialog_EventData"
        }
    ]
}
