        "title": "005 メインストーリー",
        "sub_title": "邦画のような一幕＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "像日本电影的一幕＜后篇＞"
    },
    "entry": [
        {
            "location": "530/TALK",
            "narrator": "つばめ",
            "text": "やっぱり",
            "zh": "果然",
            "narrator_zh": "燕"
        },
        {
            "location": "531/TALK",
            "narrator": "つばめ",
            "text": "決めた",
            "zh": "决定了",
            "narrator_zh": "燕"
        },
        {
            "location": "532/TALK",
            "narrator": "つばめ",
            "text": "わたし",
            "zh": "我",
            "narrator_zh": "燕"
        },
        {
            "location": "533/TALK",
            "narrator": "つばめ",
            "text": "ひなこちゃん達見送りに行く(๑･ㅂ･)و☆",
            "zh": "我去送小雏她们(๑･ㅂ･)و☆",
            "narrator_zh": "燕"
        },
        {
            "location": "535/SEL",
            "narrator": "",
            "text": "じゃあ急いで！",
            "zh": "那就快点！",
            "narrator_zh": ""
        },
        {
            "location": "536/SEL",
            "narrator": "",
            "text": "気をつけて行くんだよ",
            "zh": "去的时候要小心",
            "narrator_zh": ""
        },
        {
            "location": "537/SEL",
            "narrator": "",
            "text": "間に合うといいけど",
            "zh": "希望来得及",
            "narrator_zh": ""
        },
        {
            "location": "538/ACT",
            "narrator": "",
            "text": "じゃあ急いで！",
            "zh": "那就快点！",
            "narrator_zh": ""
        },
        {
            "location": "539/TALK",
            "narrator": "つばめ",
            "text": "ヽ(･ω･ )ゝ☆",
            "zh": "ヽ(･ω･ )ゝ☆",
            "narrator_zh": "燕"
        },
        {
            "location": "540/ACT",
            "narrator": "",
            "text": "気をつけて行くんだよ",
            "zh": "去的时候要小心",
            "narrator_zh": ""
        },
        {
            "location": "541/TALK",
            "narrator": "つばめ",
            "text": "(´ｪ｀；)三(；´ｪ｀)",
            "zh": "(´ｪ｀；)三(；´ｪ｀)",
            "narrator_zh": "燕"
        },
        {
            "location": "542/ACT",
            "narrator": "",
            "text": "間に合うといいけど",
            "zh": "希望来得及",
            "narrator_zh": ""
        },
        {
            "location": "556/TALK",
            "narrator": "つばめ",
            "text": "…午後の訓練、\n遅刻しちゃうかも\nしれないけど…。",
            "zh": "……下午的训练，\n也许会\n迟到……。",
            "narrator_zh": "燕"
        },
        {
            "location": "557/TALK",
            "narrator": "つばめ",
            "text": "その時は\nごめんなさい！",
            "zh": "到时候\n对不起！",
            "narrator_zh": "燕"
        },
        {
            "location": "603/TALK",
            "narrator": "雛",
            "text": "あーあ、なんか\nあっという間だった\nねー。",
            "zh": "啊——，总觉得\n一眨眼就\n过去了呀。",
            "narrator_zh": "雏"
        },
        {
            "location": "605/TALK",
            "narrator": "キリト",
            "text": "本当だな。\nもう数日こっちに\n残りたかったな。",
            "zh": "真的啊。\n还想在这边\n再待几天。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "606/TALK",
            "narrator": "キリト",
            "text": "美味いもの食ったり\n遊んだりさあ…。",
            "zh": "好吃的东西，\n玩玩什么的……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "608/TALK",
            "narrator": "ヒカル",
            "text": "美味しいものなら\n東雲教官に沢山奢って\nもらったでしょ？",
            "zh": "说到好吃的，\n东云教官不是请了\n不少吗？",
            "narrator_zh": "光"
        },
        {
            "location": "610/TALK",
            "narrator": "キリト",
            "text": "全然食い足りねぇよ。",
            "zh": "完全没吃够啊。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "611/TALK",
            "narrator": "雛",
            "text": "あたしもあたしも！\nもっとマグロ食べた\nかった！",
            "zh": "我也我也！\n还想再吃\n金枪鱼！",
            "narrator_zh": "雏"
        },
        {
            "location": "613/TALK",
            "narrator": "繭",
            "text": "数日もすれば\n飽きたとか言うに\n決まってる。",
            "zh": "再过几天\n肯定又要说\n吃腻了。",
            "narrator_zh": "茧"
        },
        {
            "location": "614/TALK",
            "narrator": "ヒカル",
            "text": "あはは…でも、\nとっても美味しかった\nですよね？",
            "zh": "啊哈哈……不过，\n非常好吃\n对吧？",
            "narrator_zh": "光"
        },
        {
            "location": "616/TALK",
            "narrator": "繭",
            "text": "…そうね。",
            "zh": "……是啊。",
            "narrator_zh": "茧"
        },
        {
            "location": "618/TALK",
            "narrator": "キリト",
            "text": "…そういや、そろそろ\n午後の訓練が始まる\n時間じゃねぇか？",
            "zh": "……说起来，\n下午的训练差不多\n该开始了吧？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "619/TALK",
            "narrator": "キリト",
            "text": "今頃逢瀬達、教官に\nめっちゃしごかれて\nいるんだろうなぁ。",
            "zh": "这会儿逢濑他们，\n正被教官\n狠狠操练吧。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "621/TALK",
            "narrator": "雛",
            "text": "うん…お別れくらい、\n顔見て言いたかった\nなぁ…。",
            "zh": "嗯……道别的话，\n真想当面\n说啊……。",
            "narrator_zh": "雏"
        },
        {
            "location": "622/TALK",
            "narrator": "繭",
            "text": "どうせすぐ会えるし。",
            "zh": "反正马上又能见面。",
            "narrator_zh": "茧"
        },
        {
            "location": "623/TALK",
            "narrator": "雛",
            "text": "…だよねー。",
            "zh": "……对吧。",
            "narrator_zh": "雏"
        },
        {
            "location": "624/TALK",
            "narrator": "雛",
            "text": "…そんなのは\nわかってる。\n………けど…。",
            "zh": "……那种事\n我知道。\n………可是……。",
            "narrator_zh": "雏"
        },
        {
            "location": "625/TALK",
            "narrator": "雛",
            "text": "やっぱし、ちょっと\n寂しいなぁ…。",
            "zh": "果然还是有点\n寂寞啊……。",
            "narrator_zh": "雏"
        },
        {
            "location": "626/TALK",
            "narrator": "雛",
            "text": "はぁ…。",
            "zh": "哈啊……。",
            "narrator_zh": "雏"
        },
        {
            "location": "628/TALK",
            "narrator": "ヒカル",
            "text": "元気出してください、\nひなこさん。",
            "zh": "打起精神来，\n小雏。",
            "narrator_zh": "光"
        },
        {
            "location": "630/TALK",
            "narrator": "キリト",
            "text": "よっしゃ！　帰りに\n横須賀寄って三笠\n見に行こうぜ！",
            "zh": "好！　回去路上\n绕去横须贺\n看三笠吧！",
            "narrator_zh": "圣翔"
        },
        {
            "location": "631/TALK",
            "narrator": "キリト",
            "text": "あれを見れば誰でも\n元気になるからな！",
            "zh": "看到那个，谁都会\n打起精神的！",
            "narrator_zh": "圣翔"
        },
        {
            "location": "633/TALK",
            "narrator": "繭",
            "text": "おまえだけだ。",
            "zh": "只有你。",
            "narrator_zh": "茧"
        },
        {
            "location": "634/TALK",
            "narrator": "ヒカル",
            "text": "あはは…。",
            "zh": "啊哈哈……。",
            "narrator_zh": "光"
        },
        {
            "location": "636/TALK",
            "narrator": "ヒカル",
            "text": "…あれ？",
            "zh": "……咦？",
            "narrator_zh": "光"
        },
        {
            "location": "643/TALK",
            "narrator": "つばめ",
            "text": "はぁ、はぁ…。",
            "zh": "哈啊，哈啊……。",
            "narrator_zh": "燕"
        },
        {
            "location": "645/TALK",
            "narrator": "ヒカル",
            "text": "お、逢瀬さん！？",
            "zh": "逢、逢濑！？",
            "narrator_zh": "光"
        },
        {
            "location": "646/TALK",
            "narrator": "雛",
            "text": "つばめちゃん！\nどうしたの、\nそんな走って！？",
            "zh": "燕！\n怎么了，\n跑成这样！？",
            "narrator_zh": "雏"
        },
        {
            "location": "649/TALK",
            "narrator": "つばめ",
            "text": "よ、よかったぁ…。\n間に合わないかと\n思ったよぉ…。",
            "zh": "太、太好了……。\n我还以为\n赶不上了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "651/TALK",
            "narrator": "繭",
            "text": "…走ってきたの？\nみやび先輩の家から？",
            "zh": "……跑过来的？\n从雅前辈家里？",
            "narrator_zh": "茧"
        },
        {
            "location": "652/TALK",
            "narrator": "つばめ",
            "text": "うん…みんな、\n今日帰っちゃうん\nでしょ？",
            "zh": "嗯……大家，\n今天就要\n回去了吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "653/TALK",
            "narrator": "つばめ",
            "text": "だから、その前に\n顔見たくて…。",
            "zh": "所以，在那之前\n想见一面……。",
            "narrator_zh": "燕"
        },
        {
            "location": "655/TALK",
            "narrator": "キリト",
            "text": "あ、アホか！？\nおまえもう午後の訓練\n始まる時間だろ！",
            "zh": "你、你傻吗！？\n下午的训练\n都要开始了吧！",
            "narrator_zh": "圣翔"
        },
        {
            "location": "656/TALK",
            "narrator": "キリト",
            "text": "東雲教官、\nぜってー怒ってるぞ？",
            "zh": "东云教官，\n绝对在生气了吧？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "658/TALK",
            "narrator": "雛",
            "text": "そうだよ！\n急いで戻った方が…。",
            "zh": "就是啊！\n还是快点回去……。",
            "narrator_zh": "雏"
        },
        {
            "location": "660/TALK",
            "narrator": "つばめ",
            "text": "ううん、平気だよ。",
            "zh": "不，没关系呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "661/TALK",
            "narrator": "つばめ",
            "text": "怒られるの、\n覚悟してきてるし。",
            "zh": "被骂这件事，\n我有心理准备。",
            "narrator_zh": "燕"
        },
        {
            "location": "662/TALK",
            "narrator": "繭",
            "text": "…そういう問題？",
            "zh": "……是这个问题吗？",
            "narrator_zh": "茧"
        },
        {
            "location": "663/TALK",
            "narrator": "ヒカル",
            "text": "それは大丈夫とは\n言わないんじゃ…。",
            "zh": "这可不能说\n没关系吧……。",
            "narrator_zh": "光"
        },
        {
            "location": "665/TALK",
            "narrator": "つばめ",
            "text": "でも、どうしても\n会いたかったの！",
            "zh": "可是，我无论如何\n都想见你们！",
            "narrator_zh": "燕"
        },
        {
            "location": "666/TALK",
            "narrator": "つばめ",
            "text": "みんなは…わたしに\n初めてできたお友達\nだったから…。",
            "zh": "大家是……我\n第一次交到的朋友\n……。",
            "narrator_zh": "燕"
        },
        {
            "location": "667/TALK",
            "narrator": "キリト",
            "text": "いやいや、大げさだろ\nそれは。",
            "zh": "不不，这说得\n也太夸张了。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "669/TALK",
            "narrator": "つばめ",
            "text": "ううん、本当なの。",
            "zh": "不，是真的。",
            "narrator_zh": "燕"
        },
        {
            "location": "670/TALK",
            "narrator": "つばめ",
            "text": "わたし…わたしね…。",
            "zh": "我……我呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "671/TALK",
            "narrator": "つばめ",
            "text": "東京に来る前…、\nずっと、独りぼっち\nだったから。",
            "zh": "来东京之前……，\n一直都是\n一个人。",
            "narrator_zh": "燕"
        },
        {
            "location": "673/TALK",
            "narrator": "キリト",
            "text": "…なに？",
            "zh": "……什么？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "674/TALK",
            "narrator": "ヒカル",
            "text": "独りぼっち…ですか？",
            "zh": "一个人……吗？",
            "narrator_zh": "光"
        },
        {
            "location": "675/TALK",
            "narrator": "繭",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "茧"
        },
        {
            "location": "676/TALK",
            "narrator": "雛",
            "text": "…お友達、\n一人もいなかったの？",
            "zh": "……朋友，\n一个都没有吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "677/TALK",
            "narrator": "つばめ",
            "text": "あ、あはは…、\nまあ、ずっと入院してたし\n話しかけるの苦手だから。",
            "zh": "啊，啊哈哈……，\n反正一直在住院，\n也不擅长跟人说话。",
            "narrator_zh": "燕"
        },
        {
            "location": "678/TALK",
            "narrator": "つばめ",
            "text": "あと、お友達できても\nすぐに引かれちゃうのか、\n疎遠になっちゃったり…。",
            "zh": "而且，就算交到朋友\n也会马上被疏远，\n关系就淡了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "679/TALK",
            "narrator": "雛",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雏"
        },
        {
            "location": "682/TALK",
            "narrator": "つばめ",
            "text": "だから…ね。\nみんなのことは\nこう思ってるの。",
            "zh": "所以……呀。\n大家的事，\n我是这么想的。",
            "narrator_zh": "燕"
        },
        {
            "location": "683/TALK",
            "narrator": "つばめ",
            "text": "本当に大切な\nお友達だって。",
            "zh": "是真正重要的\n朋友。",
            "narrator_zh": "燕"
        },
        {
            "location": "684/TALK",
            "narrator": "つばめ",
            "text": "…本当だよ？",
            "zh": "……是真的哦？",
            "narrator_zh": "燕"
        },
        {
            "location": "685/TALK",
            "narrator": "繭",
            "text": "…疑ってないから。",
            "zh": "……我没在怀疑。",
            "narrator_zh": "茧"
        },
        {
            "location": "686/TALK",
            "narrator": "つばめ",
            "text": "…うん。",
            "zh": "……嗯。",
            "narrator_zh": "燕"
        },
        {
            "location": "687/TALK",
            "narrator": "つばめ",
            "text": "だからね…。",
            "zh": "所以呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "688/TALK",
            "narrator": "つばめ",
            "text": "みんなのこと\nちゃんと見送りたいな\nって思ったんだ。",
            "zh": "我想好好\n送大家\n一程。",
            "narrator_zh": "燕"
        },
        {
            "location": "689/TALK",
            "narrator": "つばめ",
            "text": "東京戻ったら\nまた会おうね、って\n約束できたら――",
            "zh": "回到东京之后\n「再见面吧」，要是能\n这样约定——",
            "narrator_zh": "燕"
        },
        {
            "location": "690/TALK",
            "narrator": "つばめ",
            "text": "残りの合宿の間も、\n不安にならないで\n頑張れるから…。",
            "zh": "剩下的合宿里，\n我也能不那么不安地\n加油……。",
            "narrator_zh": "燕"
        },
        {
            "location": "692/TALK",
            "narrator": "雛",
            "text": "…つばめちゃん。",
            "zh": "……燕。",
            "narrator_zh": "雏"
        },
        {
            "location": "693/TALK",
            "narrator": "つばめ",
            "text": "うん？",
            "zh": "嗯？",
            "narrator_zh": "燕"
        },
        {
            "location": "695/TALK",
            "narrator": "雛",
            "text": "つばめちゃんって…、\nほんと、天然だよね。",
            "zh": "燕你啊……，\n真是太天然了。",
            "narrator_zh": "雏"
        },
        {
            "location": "697/TALK",
            "narrator": "つばめ",
            "text": "うん…え！？",
            "zh": "嗯……欸！？",
            "narrator_zh": "燕"
        },
        {
            "location": "700/TALK",
            "narrator": "雛",
            "text": "いや、だってさ、\n今更すぎるじゃん。",
            "zh": "不是，你看，\n这也太晚了吧。",
            "narrator_zh": "雏"
        },
        {
            "location": "701/TALK",
            "narrator": "雛",
            "text": "だって\nそんなこと。",
            "zh": "因为\n那种事。",
            "narrator_zh": "雏"
        },
        {
            "location": "702/TALK",
            "narrator": "雛",
            "text": "とーっくの昔に\nわかってること\nなんだから。",
            "zh": "老早以前\n就知道的\n事情啊。",
            "narrator_zh": "雏"
        },
        {
            "location": "703/TALK",
            "narrator": "キリト",
            "text": "だよなぁ…。\nおまえ、マジで\n今更過ぎるだろ？",
            "zh": "就是说啊……。\n你这，真的\n也太晚了吧？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "704/TALK",
            "narrator": "ヒカル",
            "text": "そうだよね。\nさすがにちょっと、\n呆れちゃったよ。",
            "zh": "对啊。\n这也有点，\n让人无语了。",
            "narrator_zh": "光"
        },
        {
            "location": "706/TALK",
            "narrator": "繭",
            "text": "…抜けてる。",
            "zh": "……迟钝。",
            "narrator_zh": "茧"
        },
        {
            "location": "708/TALK",
            "narrator": "つばめ",
            "text": "そ、そんなぁ…。",
            "zh": "怎、怎么这样……。",
            "narrator_zh": "燕"
        },
        {
            "location": "709/TALK",
            "narrator": "雛",
            "text": "仕方ないなあ。",
            "zh": "真没办法啊。",
            "narrator_zh": "雏"
        },
        {
            "location": "710/TALK",
            "narrator": "雛",
            "text": "コホン。\n改めて言うね。",
            "zh": "咳咳。\n再说一次哦。",
            "narrator_zh": "雏"
        },
        {
            "location": "712/TALK",
            "narrator": "雛",
            "text": "あたし達にとって、\nつばめちゃんは\n大切なお友達。",
            "zh": "对我们来说，\n燕是\n重要的朋友。",
            "narrator_zh": "雏"
        },
        {
            "location": "714/TALK",
            "narrator": "雛",
            "text": "今までもそうだし\nこれからもそう。\n特別な友達だよ。",
            "zh": "以前是，\n以后也是。\n特别的朋友。",
            "narrator_zh": "雏"
        },
        {
            "location": "715/TALK",
            "narrator": "雛",
            "text": "…でしょ？\nみんな。",
            "zh": "……对吧？\n大家。",
            "narrator_zh": "雏"
        },
        {
            "location": "716/TALK",
            "narrator": "ヒカル",
            "text": "ですね。\nもしかして逢瀬さん、\n知りませんでした？",
            "zh": "是的。\n难道逢濑，\n不知道吗？",
            "narrator_zh": "光"
        },
        {
            "location": "718/TALK",
            "narrator": "つばめ",
            "text": "あ、う…それは…、\nわかってたけど…。",
            "zh": "啊，唔……那个……，\n我知道的……。",
            "narrator_zh": "燕"
        },
        {
            "location": "719/TALK",
            "narrator": "キリト",
            "text": "本当かぁ？\nちょっと疑わしいぞ。",
            "zh": "真的吗？\n有点可疑啊。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "721/TALK",
            "narrator": "つばめ",
            "text": "ほ、本当だよ！",
            "zh": "是、是真的呀！",
            "narrator_zh": "燕"
        },
        {
            "location": "722/TALK",
            "narrator": "つばめ",
            "text": "みんな、会った日から\nずっと仲良くして\nくれてるし…。",
            "zh": "大家从见面那天起\n就一直对我\n很好……。",
            "narrator_zh": "燕"
        },
        {
            "location": "723/TALK",
            "narrator": "雛",
            "text": "なら、こんなとこに\nいちゃダメでしょ？",
            "zh": "那你就不该\n待在这里吧？",
            "narrator_zh": "雏"
        },
        {
            "location": "724/TALK",
            "narrator": "雛",
            "text": "あたし達を見送った\nせいで怒られたり\nなんかしたら。",
            "zh": "要是因为送我们\n结果被骂了\n什么的。",
            "narrator_zh": "雏"
        },
        {
            "location": "725/TALK",
            "narrator": "雛",
            "text": "あたし達\n落ち込んじゃう。",
            "zh": "我们\n会难过的。",
            "narrator_zh": "雏"
        },
        {
            "location": "726/TALK",
            "narrator": "ヒカル",
            "text": "そういうことです。\nだから、早く戻って\nください。",
            "zh": "就是这个意思。\n所以，请快点\n回去。",
            "narrator_zh": "光"
        },
        {
            "location": "727/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "728/TALK",
            "narrator": "キリト",
            "text": "また東京戻ってきたら\n遊びに行こうな。",
            "zh": "回到东京之后\n再一起玩啊。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "731/TALK",
            "narrator": "つばめ",
            "text": "…うん！",
            "zh": "……嗯！",
            "narrator_zh": "燕"
        },
        {
            "location": "732/TALK",
            "narrator": "繭",
            "text": "…ほら、行って。\nダッシュで。",
            "zh": "……走吧。\n用跑的。",
            "narrator_zh": "茧"
        },
        {
            "location": "734/TALK",
            "narrator": "つばめ",
            "text": "うん…みんなも、\n気を付けて帰ってね。",
            "zh": "嗯……大家也，\n回去小心哦。",
            "narrator_zh": "燕"
        },
        {
            "location": "735/TALK",
            "narrator": "つばめ",
            "text": "あとでＷＡＶＥ\n送るから！",
            "zh": "回头我发\nWAVE！",
            "narrator_zh": "燕"
        },
        {
            "location": "742/TALK",
            "narrator": "雛",
            "text": "楽しみにしてるー！\n訓練頑張ってねー！！",
            "zh": "我会期待的！\n训练加油！！",
            "narrator_zh": "雏"
        },
        {
            "location": "746/TALK",
            "narrator": "雛",
            "text": "…行っちゃったね。",
            "zh": "……走掉了呀。",
            "narrator_zh": "雏"
        },
        {
            "location": "748/TALK",
            "narrator": "キリト",
            "text": "ああ……。\nそれにしても……。",
            "zh": "啊啊……。\n不过话说回来……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "749/TALK",
            "narrator": "キリト",
            "text": "よくもまあ、\nあんなこっ恥ずかしい\nこと言えるもんだ。",
            "zh": "亏她说得出\n那么\n难为情的话。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "750/TALK",
            "narrator": "キリト",
            "text": "聞いてるこっちまで\n恥ずかしくなって\nきちまったぜ。",
            "zh": "听的这边\n都跟着\n不好意思了。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "752/TALK",
            "narrator": "ヒカル",
            "text": "あはは…僕もちょっと\nそう思ったよ。",
            "zh": "啊哈哈……我也有点\n这么想。",
            "narrator_zh": "光"
        },
        {
            "location": "753/TALK",
            "narrator": "ヒカル",
            "text": "でもさ、その方が\n逢瀬さんらしいよね。",
            "zh": "不过，那样才\n更像逢濑。",
            "narrator_zh": "光"
        },
        {
            "location": "755/TALK",
            "narrator": "繭",
            "text": "天然にプラスして、\n純粋な子だから。",
            "zh": "天然之上，\n还是个纯粹的孩子。",
            "narrator_zh": "茧"
        },
        {
            "location": "757/TALK",
            "narrator": "雛",
            "text": "……うん…\nそうだよね…。",
            "zh": "……嗯……\n对啊……。",
            "narrator_zh": "雏"
        },
        {
            "location": "759/TALK",
            "narrator": "雛",
            "text": "グスッ…。",
            "zh": "抽泣……。",
            "narrator_zh": "雏"
        },
        {
            "location": "761/TALK",
            "narrator": "キリト",
            "text": "…ん、ひなこ？",
            "zh": "……嗯，小雏？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "763/TALK",
            "narrator": "雛",
            "text": "うぅ…あー、もー！！",
            "zh": "呜……啊，真是！！",
            "narrator_zh": "雏"
        },
        {
            "location": "764/TALK",
            "narrator": "雛",
            "text": "本当、つばめちゃんは\n超天然なんだから…！",
            "zh": "真的，燕\n也太天然了……！",
            "narrator_zh": "雏"
        },
        {
            "location": "766/TALK",
            "narrator": "キリト",
            "text": "……ったく、\nどっちがだよ…。",
            "zh": "……真是的，\n到底谁才是啊……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "768/TALK",
            "narrator": "繭",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "茧"
        },
        {
            "location": "769/TALK",
            "narrator": "繭",
            "text": "またすぐ会える。\nそれに、ＷＡＶＥで\n話せるから。",
            "zh": "马上又能见面。\n而且，用WAVE\n也能说话。",
            "narrator_zh": "茧"
        },
        {
            "location": "770/TALK",
            "narrator": "雛",
            "text": "…うん。",
            "zh": "……嗯。",
            "narrator_zh": "雏"
        },
        {
            "location": "772/TALK",
            "narrator": "雛",
            "text": "…よし、行こ！\nもう電車来ちゃうし！",
            "zh": "……好，走吧！\n电车要来了！",
            "narrator_zh": "雏"
        },
        {
            "location": "773/TALK",
            "narrator": "雛",
            "text": "急がないと\n乗り遅れちゃう！",
            "zh": "不快点\n要赶不上了！",
            "narrator_zh": "雏"
        },
        {
            "location": "779/TALK",
            "narrator": "キリト",
            "text": "あ、待てよひなこ！",
            "zh": "啊，等一下小雏！",
            "narrator_zh": "圣翔"
        },
        {
            "location": "781/TALK",
            "narrator": "ヒカル",
            "text": "走らなくても\n間に合いますよー。",
            "zh": "不跑也\n来得及的——。",
            "narrator_zh": "光"
        },
        {
            "location": "790/TALK",
            "narrator": "繭",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "茧"
        },
        {
            "location": "791/TALK",
            "narrator": "繭",
            "text": "まったく、寂しがり屋\nなんだから…。",
            "zh": "真是，就是个\n怕寂寞的人……。",
            "narrator_zh": "茧"
        },
        {
            "location": "804/DIALOG",
            "narrator": "Dialog_chapter_ch01",
            "text": "【17 告白】",
            "zh": "【17 告白】",
            "narrator_zh": "Dialog_chapter_ch01"
        }
    ]
}
