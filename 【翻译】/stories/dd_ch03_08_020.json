{
    "dir": "chap08/daydra/dd_ch03_08_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "8356",
        "cid": "gabriella",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "図書室でのこと",
        "title_zh": "Extra006 额外剧情",
        "sub_title_zh": "图书馆里的事"
    },
    "entry": [
        {
            "location": "202/SCENARIO",
            "narrator": "",
            "text": "図書室でのこと",
            "zh": "图书馆里的事",
            "narrator_zh": ""
        },
        {
            "location": "219/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…中々ピンとくる\n本が見つからないわ…。",
            "zh": "唉……怎么都找不到\n对胃口的书呢……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "220/TALK",
            "narrator": "ガブリエラ",
            "text": "この辺りの棚で間違いは\nないはずなんだけど…。",
            "zh": "应该就在这一带的\n书架上才对啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "223/TALK",
            "narrator": "みやび",
            "text": "何ば探しちゅう？",
            "zh": "你在找么子喃？",
            "narrator_zh": "雅"
        },
        {
            "location": "227/TALK",
            "narrator": "ガブリエラ",
            "text": "うわっ、みやび！\nいきなり出てこないでよ！",
            "zh": "哇啊，雅！\n别突然冒出来啊！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "228/TALK",
            "narrator": "みやび",
            "text": "シッ！",
            "zh": "嘘！",
            "narrator_zh": "雅"
        },
        {
            "location": "229/TALK",
            "narrator": "みやび",
            "text": "図書室で大声は厳禁やき。",
            "zh": "图书馆里严禁大声喧哗啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "232/TALK",
            "narrator": "ガブリエラ",
            "text": "…誰のせいよ、まったく。",
            "zh": "……还不是怪谁啊，真是的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "234/TALK",
            "narrator": "ガブリエラ",
            "text": "まあ、いいわ。\nていうか、結構\nナイスタイミングだし。",
            "zh": "算了，无所谓了。\n说起来，你来得\n还挺巧的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "236/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょっと聞きたいことが\nあるの。",
            "zh": "我有点事情\n想问你。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "237/TALK",
            "narrator": "ガブリエラ",
            "text": "今ね、日本の文化を学べる\nよさそうな本を探してるん\nだけど――",
            "zh": "我现在呢，在找能学习\n日本文化的好书，\n可是——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "238/TALK",
            "narrator": "ガブリエラ",
            "text": "中々ピンとくるものが\nなくて困ってるの。",
            "zh": "一直找不到合心意的，\n正犯愁呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "240/TALK",
            "narrator": "みやび",
            "text": "日本の文化かぁ…。",
            "zh": "日本文化啊……。",
            "narrator_zh": "雅"
        },
        {
            "location": "242/TALK",
            "narrator": "みやび",
            "text": "なら、そっちの棚にある、\nこの本なんかどうや？",
            "zh": "那，那边架子上的\n这本书怎么样咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "244/TALK",
            "narrator": "ガブリエラ",
            "text": "ありがと。\nえっと…………。",
            "zh": "谢啦。\n我看看…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "247/TALK",
            "narrator": "ガブリエラ",
            "text": "って、これラノベの\n棚じゃない…。",
            "zh": "喂，这不就是轻小说的\n书架吗……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "249/TALK",
            "narrator": "みやび",
            "text": "今の日本において、\nラノベは一つの文化として\n確立してるき。",
            "zh": "在如今的日本，\n轻小说已经作为一种文化\n站稳脚跟了啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "250/TALK",
            "narrator": "みやび",
            "text": "古いだけやなくて、\n新しい文化にも目を\n向けんといかんきな。",
            "zh": "不能只盯着老东西，\n新的文化也得\n看一哈才行啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "252/TALK",
            "narrator": "ガブリエラ",
            "text": "そ、それはそうだけど、\nう～ん…。",
            "zh": "话、话是这么说没错，\n唔～……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "254/TALK",
            "narrator": "ガブリエラ",
            "text": "今学びたいのは、日本の\n昔の文化だったんだけど\nなぁ…。",
            "zh": "我眼下想学的，其实是\n日本古代的文化\n来着……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "255/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、みやびの言うとおり\n今の文化を学ぶことも\n大切な気がするし…。",
            "zh": "不过，就像雅说的，\n学习现在的文化好像也\n挺重要的……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "256/TALK",
            "narrator": "ガブリエラ",
            "text": "…仕方ないわね。",
            "zh": "……真拿你没办法。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "268/TALK",
            "narrator": "ガブリエラ",
            "text": "ねえ、マルザンナ",
            "zh": "我说，玛尔赞娜",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "269/TALK",
            "narrator": "ガブリエラ",
            "text": "日本の文化を勉強したくて本をさがしてたら",
            "zh": "我为了学习日本文化在找书",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "270/TALK",
            "narrator": "ガブリエラ",
            "text": "ラノベも文化の一つ、って言われたの",
            "zh": "结果有人跟我说轻小说也是文化的一种",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "271/TALK",
            "narrator": "ガブリエラ",
            "text": "これって本当かしら？",
            "zh": "这是真的吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "273/SEL",
            "narrator": "",
            "text": "ラノベも面白いよ",
            "zh": "轻小说也很有意思哦",
            "narrator_zh": ""
        },
        {
            "location": "274/SEL",
            "narrator": "",
            "text": "からかわれてるだけ",
            "zh": "她只是在逗你玩",
            "narrator_zh": ""
        },
        {
            "location": "275/SEL",
            "narrator": "",
            "text": "童話を読んだ方がいい",
            "zh": "还是读童话比较好",
            "narrator_zh": ""
        },
        {
            "location": "276/ACT",
            "narrator": "",
            "text": "ラノベも面白いよ",
            "zh": "轻小说也很有意思哦",
            "narrator_zh": ""
        },
        {
            "location": "277/TALK",
            "narrator": "ガブリエラ",
            "text": "面白さを求めているわけじゃないのよ、もう…",
            "zh": "我又不是图它好不好看，真是的……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "289/TALK",
            "narrator": "ガブリエラ",
            "text": "ま、まあ、一応薦めてもら\nったから読みはするけど…。",
            "zh": "好、好吧，既然人家都推荐了，\n我姑且还是会读一读的……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "290/TALK",
            "narrator": "みやび",
            "text": "そう言ってもらえると、\nうちも薦めた甲斐があるっ\nてもんよ。",
            "zh": "听你这么讲，\n我也不算白\n推荐这一回咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "291/TALK",
            "narrator": "ガブリエラ",
            "text": "でも！",
            "zh": "但是！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "292/TALK",
            "narrator": "ガブリエラ",
            "text": "昔の文化を学べる本も\n教えてもらうわ。",
            "zh": "能学习古代文化的书，\n你也得给我介绍一下。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "293/TALK",
            "narrator": "みやび",
            "text": "えいよ。\nなら向こうの棚に移動や。",
            "zh": "要得。\n那就挪步去那边书架咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "296/TALK",
            "narrator": "ガブリエラ",
            "text": "始めっからそっちのを\n薦めてほしかったなぁ…。",
            "zh": "真希望你一开始就\n推荐那边的书啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "297/ACT",
            "narrator": "",
            "text": "からかわれてるだけ",
            "zh": "她只是在逗你玩",
            "narrator_zh": ""
        },
        {
            "location": "298/TALK",
            "narrator": "ガブリエラ",
            "text": "やっぱりそうよね",
            "zh": "果然是这样呢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "310/TALK",
            "narrator": "ガブリエラ",
            "text": "ラノベが今の文化だって\nいうのはよくわかったわ。",
            "zh": "轻小说属于现代文化这点\n我倒是完全明白了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "311/TALK",
            "narrator": "ガブリエラ",
            "text": "けど、今知りたいのは\n昔の日本の文化だから。",
            "zh": "不过，我现在想知道的是\n古代的日本文化。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "313/TALK",
            "narrator": "みやび",
            "text": "…ラノベはえいのか？",
            "zh": "……轻小说不看咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "314/TALK",
            "narrator": "ガブリエラ",
            "text": "ラノベ自体は文化でも、\n内容は日本文化とは関係\nないじゃない。",
            "zh": "轻小说本身虽说是文化，\n可内容和日本文化根本\n没关系吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "315/TALK",
            "narrator": "ガブリエラ",
            "text": "この本なんて、舞台が地球\nじゃないみたいだし。",
            "zh": "像这本书，舞台好像连\n地球都不是呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "317/TALK",
            "narrator": "みやび",
            "text": "…仕方ない。",
            "zh": "……没办法咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "319/TALK",
            "narrator": "みやび",
            "text": "ちっくとマジメにお薦めの\nえい本を教えちゃるよ。",
            "zh": "那我正经一哈，给你\n挑几本好书啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "321/TALK",
            "narrator": "ガブリエラ",
            "text": "最初からマジメに紹介して\nよ…。",
            "zh": "从一开始就给我正经\n介绍啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "322/ACT",
            "narrator": "",
            "text": "童話を読んだ方がいい",
            "zh": "还是读童话比较好",
            "narrator_zh": ""
        },
        {
            "location": "325/TALK",
            "narrator": "ガブリエラ",
            "text": "さすがねマルザンナ",
            "zh": "真不愧是你啊玛尔赞娜",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "326/TALK",
            "narrator": "ガブリエラ",
            "text": "私も、そっちの方がいいわ",
            "zh": "我也觉得，那样更好",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "338/TALK",
            "narrator": "ガブリエラ",
            "text": "みやび、ラノベはいいから\nお薦めの童話を教えて。",
            "zh": "雅，轻小说就免了，\n给我推荐几本童话吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "339/TALK",
            "narrator": "みやび",
            "text": "童話って、昔話の絵本で\nえいの？",
            "zh": "童话啊，民间故事的绘本\n行不行咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "340/TALK",
            "narrator": "ガブリエラ",
            "text": "童話なら何だって構わない\nわ。",
            "zh": "只要是童话，什么都\n无所谓。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "341/TALK",
            "narrator": "ガブリエラ",
            "text": "あ、でも最初だから楽しく\n読めるのがいいかも。",
            "zh": "啊，不过因为是头一回，\n读起来轻松有趣的比较好。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "342/TALK",
            "narrator": "みやび",
            "text": "童話は大抵楽しいき、\n心配はないちや。",
            "zh": "童话大都蛮有趣的啵，\n不用操心咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "344/TALK",
            "narrator": "みやび",
            "text": "しっかし、ガブちゃんが\n気に入りそうな童話…\nどれがいいか迷うなぁ。",
            "zh": "不过呢，加布会喜欢的\n童话……到底哪本好，\n还真有点难选啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "346/TALK",
            "narrator": "ガブリエラ",
            "text": "有名どころでいいから早く\n教えてってば…。",
            "zh": "挑个有名的不就行了，\n快点告诉我啦……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "210/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>5月10日　3:34 PM</color>\nある日の放課後、学園内図書館にて。",
            "zh": "<color=green>5月10日　3:34 PM</color>\n某天放学后，在学园内图书馆。",
            "narrator_zh": "Dialog_EventData"
        },
        {
            "location": "357/DIALOG",
            "narrator": "Dialog_GEThimegoto_ch03",
            "text": "【新約童話もございます】",
            "zh": "【也有新约童话哦】",
            "narrator_zh": "Dialog_GEThimegoto_ch03"
        }
    ]
}
