            "text": "011_海の色",
            "zh": "011_海的颜色",
            "narrator_zh": ""
        },
        {
            "location": "120/TALK",
            "narrator": "みやび",
            "text": "みやびは東京に海が無いといふ。",
            "zh": "雅说，东京没有海。",
            "narrator_zh": "雅"
        },
        {
            "location": "121/TALK",
            "narrator": "みやび",
            "text": "ほんとの海が見たいといふ。",
            "zh": "说想看真正的海。",
            "narrator_zh": "雅"
        },
        {
            "location": "124/SEL",
            "narrator": "",
            "text": "え…何それ…",
            "zh": "诶……这是什么……",
            "narrator_zh": ""
        },
        {
            "location": "125/SEL",
            "narrator": "",
            "text": "$me$は驚いて海を見る。",
            "zh": "$me$吃惊地看着海。",
            "narrator_zh": ""
        },
        {
            "location": "126/SEL",
            "narrator": "",
            "text": "土佐の海を見に行きたいな",
            "zh": "想去看土佐的海",
            "narrator_zh": ""
        },
        {
            "location": "130/ACT",
            "narrator": "",
            "text": "え…何それ…",
            "zh": "诶……这是什么……",
            "narrator_zh": ""
        },
        {
            "location": "132/TALK",
            "narrator": "みやび",
            "text": "さあ…",
            "zh": "这个嘛……",
            "narrator_zh": "雅"
        },
        {
            "location": "133/TALK",
            "narrator": "みやび",
            "text": "何かな…",
            "zh": "是什么呢……",
            "narrator_zh": "雅"
        },
        {
            "location": "134/ACT",
            "narrator": "",
            "text": "$me$は驚いて海を見る。",
            "zh": "$me$吃惊地看着海。",
            "narrator_zh": ""
        },
        {
            "location": "135/TALK",
            "narrator": "みやび",
            "text": "桜若葉の間に在るのは、",
            "zh": "在樱树嫩叶之间的，是",
            "narrator_zh": "雅"
        },
        {
            "location": "136/TALK",
            "narrator": "みやび",
            "text": "って",
            "zh": "这个",
            "narrator_zh": "雅"
        },
        {
            "location": "137/TALK",
            "narrator": "みやび",
            "text": "立ち位置がおかしいぞね",
            "zh": "站的位置不对咧",
            "narrator_zh": "雅"
        },
        {
            "location": "138/TALK",
            "narrator": "みやび",
            "text": "海が空にあることになっちゅう",
            "zh": "这样一来海就在天上了",
            "narrator_zh": "雅"
        },
        {
            "location": "139/ACT",
            "narrator": "",
            "text": "土佐の海を見に行きたいな",
            "zh": "想去看土佐的海",
            "narrator_zh": ""
        },
        {
            "location": "141/TALK",
            "narrator": "みやび",
            "text": "そこは",
            "zh": "那里",
            "narrator_zh": "雅"
        },
        {
            "location": "142/TALK",
            "narrator": "みやび",
            "text": "$handle$が桂浜に連れて行くぜよ",
            "zh": "该由$handle$带去桂滨才对咧",
            "narrator_zh": "雅"
        },
        {
            "location": "143/TALK",
            "narrator": "みやび",
            "text": "と",
            "zh": "这样",
            "narrator_zh": "雅"
        },
        {
            "location": "144/TALK",
            "narrator": "みやび",
            "text": "いうべきであろう",
            "zh": "才该这么说吧",
            "narrator_zh": "雅"
        },
        {
            "location": "145/TALK",
            "narrator": "みやび",
            "text": "わからんちん",
            "zh": "没懂啊你",
            "narrator_zh": "雅"
        },
        {
            "location": "148/TALK",
            "narrator": "みやび",
            "text": "まあみやびさんは智恵子抄ごっこをしていたわけだが",
            "zh": "雅刚才是在玩《智惠子抄》的过家家",
            "narrator_zh": "雅"
        },
        {
            "location": "150/SEL",
            "narrator": "",
            "text": "$me$のことは光太郎と呼び給え",
            "zh": "请把$me$称作光太郎",
            "narrator_zh": ""
        },
        {
            "location": "151/SEL",
            "narrator": "",
            "text": "よし、続きやろうぜ",
            "zh": "好，接着来吧",
            "narrator_zh": ""
        },
        {
            "location": "152/SEL",
            "narrator": "",
            "text": "何なのそれ…？",
            "zh": "那是什么啊……？",
            "narrator_zh": ""
        },
        {
            "location": "153/ACT",
            "narrator": "",
            "text": "$me$のことは光太郎と呼び給え",
            "zh": "请把$me$称作光太郎",
            "narrator_zh": ""
        },
        {
            "location": "155/TALK",
            "narrator": "みやび",
            "text": "了解した",
            "zh": "知道了",
            "narrator_zh": "雅"
        },
        {
            "location": "156/TALK",
            "narrator": "みやび",
            "text": "ハンドルを変更せよ",
            "zh": "把称呼改掉",
            "narrator_zh": "雅"
        },
        {
            "location": "158/SEL",
            "narrator": "",
            "text": "それはちょっと",
            "zh": "这个有点",
            "narrator_zh": ""
        },
        {
            "location": "159/SEL",
            "narrator": "",
            "text": "いいよー",
            "zh": "可以呀——",
            "narrator_zh": ""
        },
        {
            "location": "160/ACT",
            "narrator": "",
            "text": "それはちょっと",
            "zh": "这个有点",
            "narrator_zh": ""
        },
        {
            "location": "161/TALK",
            "narrator": "みやび",
            "text": "光太郎のくせに",
            "zh": "明明是光太郎",
            "narrator_zh": "雅"
        },
        {
            "location": "162/TALK",
            "narrator": "みやび",
            "text": "光太郎じゃないということか",
            "zh": "意思是你不是光太郎？",
            "narrator_zh": "雅"
        },
        {
            "location": "163/ACT",
            "narrator": "",
            "text": "いいよー",
            "zh": "可以呀——",
            "narrator_zh": ""
        },
        {
            "location": "164/TALK",
            "narrator": "みやび",
            "text": "軽すぎる",
            "zh": "太轻飘了",
            "narrator_zh": "雅"
        },
        {
            "location": "165/TALK",
            "narrator": "みやび",
            "text": "もっと光太郎っぽく！",
            "zh": "再有光太郎的样子一点！",
            "narrator_zh": "雅"
        },
        {
            "location": "167/ACT",
            "narrator": "",
            "text": "よし、続きやろうぜ",
            "zh": "好，接着来吧",
            "narrator_zh": ""
        },
        {
            "location": "168/TALK",
            "narrator": "みやび",
            "text": "いや",
            "zh": "不",
            "narrator_zh": "雅"
        },
        {
            "location": "169/TALK",
            "narrator": "みやび",
            "text": "遊びは終わりだ",
            "zh": "玩到此为止",
            "narrator_zh": "雅"
        },
        {
            "location": "170/ACT",
            "narrator": "",
            "text": "何なのそれ…？",
            "zh": "那是什么啊……？",
            "narrator_zh": ""
        },
        {
            "location": "171/TALK",
            "narrator": "みやび",
            "text": "この説明では不足か",
            "zh": "这么解释还不够吗",
            "narrator_zh": "雅"
        },
        {
            "location": "173/TALK",
            "narrator": "みやび",
            "text": "海の側に育ったもんには",
            "zh": "在海边长大的人",
            "narrator_zh": "雅"
        },
        {
            "location": "174/TALK",
            "narrator": "みやび",
            "text": "それぞれの海の色があるっちゅーことぞね",
            "zh": "各自的海有各自的颜色，就是这么回事咧",
            "narrator_zh": "雅"
        }
    ]
