{
    "dir": "chap06/daydra/dd_ch02_06_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "6252",
        "cid": "ayami",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "ゲームの発売日",
        "title_zh": "Extra002 额外剧情",
        "sub_title_zh": "游戏发售日"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "ゲームの発売日",
            "zh": "游戏发售日",
            "narrator_zh": ""
        },
        {
            "location": "21/TALK",
            "narrator": "アーヤ",
            "text": "…話は聞いてたけど、\n実際に見ると驚きね。",
            "zh": "……话是听说了，\n亲眼看见还是吓一跳。",
            "narrator_zh": "绫水"
        },
        {
            "location": "23/TALK",
            "narrator": "みやび",
            "text": "何がや？",
            "zh": "什么？",
            "narrator_zh": "雅"
        },
        {
            "location": "26/TALK",
            "narrator": "アーヤ",
            "text": "ゲームの早朝販売よ。\nまさか、平日の朝でも\nこんなに並ぶなんて…。",
            "zh": "游戏的清晨发售。\n没想到工作日早上\n也排这么多人……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "30/TALK",
            "narrator": "ガブリエラ",
            "text": "ファンなら一分一秒でも\n早く手に入れたいって\n思うのが普通でしょ？",
            "zh": "粉丝的话，哪怕早一分一秒\n也想拿到手，\n这不是很正常吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "31/TALK",
            "narrator": "アーヤ",
            "text": "…まあ、わからなくは\nないわね。",
            "zh": "……嘛，也不是\n不能理解。",
            "narrator_zh": "绫水"
        },
        {
            "location": "32/TALK",
            "narrator": "アーヤ",
            "text": "並んでる人達見てると、\nみんなゲーム好きって\nいうのはよくわかる…。",
            "zh": "看着排队的人，\n能看出来大家都\n很喜欢游戏……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "35/TALK",
            "narrator": "みやび",
            "text": "スマホがあれば、\nどこでも\nゲームできるきね。",
            "zh": "有手机的话，\n在哪都能\n玩游戏啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "40/TALK",
            "narrator": "ガブリエラ",
            "text": "あ、みやび死にそう。\n回復薬使うわ。",
            "zh": "啊，雅快死了。\n我用恢复药。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "43/TALK",
            "narrator": "みやび",
            "text": "ナイスやガブちゃん！\n物理防御張るき、\n特攻任せるちや！",
            "zh": "漂亮，加布！\n我来上物理防御啵，\n特攻交给你咯！",
            "narrator_zh": "雅"
        },
        {
            "location": "45/TALK",
            "narrator": "ガブリエラ",
            "text": "任せて。\n一気に畳みかけるわ！",
            "zh": "交给我。\n一口气压上去！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "47/TALK",
            "narrator": "アーヤ",
            "text": "はぁ…並んでる時間も、\nそれなら暇せずに\nすみそうね。",
            "zh": "哈啊……排队的时间，\n这样也不会\n无聊了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "51/TALK",
            "narrator": "ガブリエラ",
            "text": "っていうか、アーヤが\n一緒にいるのが驚きよ。",
            "zh": "话说，绫水\n会一起来才让人吃惊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "52/TALK",
            "narrator": "ガブリエラ",
            "text": "これを機に、ゲーム機\n買うつもりなの？",
            "zh": "趁这个机会，\n打算买游戏机吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "53/TALK",
            "narrator": "アーヤ",
            "text": "遠くに住んでる大学の\n友達に頼まれたのよ。\n昼食を条件にね。",
            "zh": "住得远的大学朋友\n拜托我的。\n条件是请午饭。",
            "narrator_zh": "绫水"
        },
        {
            "location": "56/TALK",
            "narrator": "アーヤ",
            "text": "…ついでに、館長からも\n貴方たちの監視を頼まれ\nてるし。",
            "zh": "……顺便，馆长也拜托我\n看着你们\n两个。",
            "narrator_zh": "绫水"
        },
        {
            "location": "58/TALK",
            "narrator": "アーヤ",
            "text": "二人が学校サボらない\nか、しっかり見てろ、\nって。",
            "zh": "看紧点，别让她们\n逃课，\n他说。",
            "narrator_zh": "绫水"
        },
        {
            "location": "60/TALK",
            "narrator": "ガブリエラ",
            "text": "わかってない友達ね。\n自分で並んで買うから\nこそ達成感あるのに。",
            "zh": "你那朋友不懂。\n自己排队买，\n才有成就感。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "62/TALK",
            "narrator": "アーヤ",
            "text": "並んで買ったって、\nどうせ遊べるのは\n帰ってからでしょ？",
            "zh": "排着队买了，\n反正也是回去\n才能玩吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "63/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィ達だって、\n学校終わるまでは\n遊べないんだし…。",
            "zh": "加维你们也是，\n放学之前\n玩不了……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "64/TALK",
            "narrator": "アーヤ",
            "text": "…っていうか、\n放課後まで\n我慢できるの？",
            "zh": "……话说，\n能忍到\n放学吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "70/TALK",
            "narrator": "ガブリエラ",
            "text": "…それは、まあ…ねぇ？",
            "zh": "……这个，嘛……呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "74/TALK",
            "narrator": "みやび",
            "text": "学校にゲーム機\n持ち込むわけには\nいかんしね…。",
            "zh": "游戏机没法\n带进学校\n……。",
            "narrator_zh": "雅"
        },
        {
            "location": "76/TALK",
            "narrator": "アーヤ",
            "text": "？",
            "zh": "？",
            "narrator_zh": "绫水"
        },
        {
            "location": "78/TALK",
            "narrator": "ガブリエラ",
            "text": "まあ、学校に行くなら\n我慢しないといけない\nわよね？",
            "zh": "嘛，要去学校的话\n就得忍着\n吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "81/TALK",
            "narrator": "アーヤ",
            "text": "…怪しい。",
            "zh": "……可疑。",
            "narrator_zh": "绫水"
        },
        {
            "location": "83/TALK",
            "narrator": "みやび",
            "text": "うちらはどこも怪しく\nないぞね。",
            "zh": "我们哪都不\n奇怪啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "85/TALK",
            "narrator": "ガブリエラ",
            "text": "そうよ。\nあんまり疑うのは\n良くないんじゃない？",
            "zh": "就是。\n太怀疑人\n不好吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "86/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "87/TALK",
            "narrator": "アーヤ",
            "text": "凄く怪しいわ…この子\n達なら本当にサボり\nかねないし…。",
            "zh": "可疑得很……这些孩子\n真的可能\n会逃课……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "88/TALK",
            "narrator": "アーヤ",
            "text": "でも、本当にサボる\nつもりがなかったと\nしたら――",
            "zh": "可是，要是她们真的\n没打算逃课\n——",
            "narrator_zh": "绫水"
        },
        {
            "location": "89/TALK",
            "narrator": "アーヤ",
            "text": "二人とも、凄く気分が\n悪くなると思うし…。",
            "zh": "两个人都会\n很不高兴……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "90/TALK",
            "narrator": "アーヤ",
            "text": "…少し信じたフリして、\n様子を見た方が良いかも。",
            "zh": "……先装相信，\n观察一下也许更好。",
            "narrator_zh": "绫水"
        },
        {
            "location": "92/TALK",
            "narrator": "アーヤ",
            "text": "…疑って悪かったわ。\n私の考え過ぎだった\nみたい。",
            "zh": "……怀疑你们，抱歉。\n是我想多了\n的样子。",
            "narrator_zh": "绫水"
        },
        {
            "location": "96/TALK",
            "narrator": "ガブリエラ",
            "text": "あ、謝るようなことじゃ\nないって。\n気にしてないし…ね？",
            "zh": "啊，不用道歉。\n我没在意……\n对吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "99/TALK",
            "narrator": "みやび",
            "text": "アーヤはリーダーやき、\n考え過ぎるくらいが\n丁度えいんよ。",
            "zh": "绫水是队长啵，\n想得多一点\n正好要得。",
            "narrator_zh": "雅"
        },
        {
            "location": "100/TALK",
            "narrator": "アーヤ",
            "text": "それでも、一応謝りは\nしておくわ。",
            "zh": "即便如此，道歉\n还是要道的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "102/TALK",
            "narrator": "アーヤ",
            "text": "あまり疑われるのって、\n息苦しい感じがして\nいい気分しないし。",
            "zh": "被人怀疑，\n会觉得喘不过气，\n心情也不好。",
            "narrator_zh": "绫水"
        },
        {
            "location": "103/SEL",
            "narrator": "",
            "text": "信じる心は素晴らしい",
            "zh": "相信别人的心很了不起",
            "narrator_zh": ""
        },
        {
            "location": "104/SEL",
            "narrator": "",
            "text": "二人の服装に注目",
            "zh": "注意她们的衣服",
            "narrator_zh": ""
        },
        {
            "location": "109/TALK",
            "narrator": "みやび",
            "text": "…もっと疑われると\n思うてたけんど、\n意外やね。",
            "zh": "……我还以为会\n被怀疑得更厉害，不过\n意外咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "112/TALK",
            "narrator": "ガブリエラ",
            "text": "そうね。\nまあ、結果オーライ\nじゃない？",
            "zh": "是啊。\n嘛，结果好\n就行吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "116/TALK",
            "narrator": "アーヤ",
            "text": "二人とも、どうしたの？",
            "zh": "你们两个，怎么了？",
            "narrator_zh": "绫水"
        },
        {
            "location": "119/TALK",
            "narrator": "ガブリエラ",
            "text": "な、何でもないわ。\nちょっとゲーム攻略の\n相談をしてただけよ。",
            "zh": "没、没什么。\n只是在商量\n游戏攻略。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "122/TALK",
            "narrator": "みやび",
            "text": "本当にそれだけやき。\nアーヤも、販売始まるまで\n本でも読んでてえいよ。",
            "zh": "真的就这些啵。\n绫水也在开卖之前\n看看书，要得。",
            "narrator_zh": "雅"
        },
        {
            "location": "125/TALK",
            "narrator": "アーヤ",
            "text": "やっぱり怪しいわ。\nこの子達、絶対に…。",
            "zh": "果然可疑。\n这些孩子，绝对……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "127/TALK",
            "narrator": "アーヤ",
            "text": "あっ、そうだ！",
            "zh": "啊，对了！",
            "narrator_zh": "绫水"
        },
        {
            "location": "129/TALK",
            "narrator": "アーヤ",
            "text": "…そういえば今日って\n私も朝一から講義が\n入ってるから――",
            "zh": "……这么说，今天\n我从一早也有课\n——",
            "narrator_zh": "绫水"
        },
        {
            "location": "130/TALK",
            "narrator": "アーヤ",
            "text": "学校には貴方たちと\n一緒に行けるわね。",
            "zh": "可以和你们\n一起去学校。",
            "narrator_zh": "绫水"
        },
        {
            "location": "131/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ！？",
            "zh": "哈！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "132/TALK",
            "narrator": "みやび",
            "text": "いや、アーヤ…\nうちらは買ったら一度、\n寮に戻るき…。",
            "zh": "不对，绫水……\n我们买完要先\n回一次宿舍啵……。",
            "narrator_zh": "雅"
        },
        {
            "location": "134/TALK",
            "narrator": "アーヤ",
            "text": "私も教科書とか取りに\n戻らないといけないから、\n問題ないわ。",
            "zh": "我也得回去拿\n课本什么的，\n没问题。",
            "narrator_zh": "绫水"
        },
        {
            "location": "138/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "141/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "143/TALK",
            "narrator": "アーヤ",
            "text": "何か不都合でもある？",
            "zh": "有什么不方便吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "146/TALK",
            "narrator": "ガブリエラ",
            "text": "…ないわよ。\nもう諦めたわ。",
            "zh": "……没有。\n我放弃了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "149/TALK",
            "narrator": "みやび",
            "text": "はぁ…悪いことはできん\nもんやね…。",
            "zh": "哈啊……坏事做不成\n咯……。",
            "narrator_zh": "雅"
        },
        {
            "location": "153/TALK",
            "narrator": "アーヤ",
            "text": "…やっぱりサボるつもり\nだったのね？\nまったく…。",
            "zh": "……果然打算\n逃课吧？\n真是的……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "155/ACT",
            "narrator": "",
            "text": "信じる心は素晴らしい",
            "zh": "相信别人的心很了不起",
            "narrator_zh": ""
        },
        {
            "location": "176/TALK",
            "narrator": "アーヤ",
            "text": "もしかして、疑い過ぎだったかしら？(-.-;)",
            "zh": "难道是我怀疑过头了(-.-;)",
            "narrator_zh": "绫水"
        },
        {
            "location": "177/TALK",
            "narrator": "アーヤ",
            "text": "仲間を疑い過ぎるのはいけなかったわね",
            "zh": "太怀疑同伴，是我不对",
            "narrator_zh": "绫水"
        },
        {
            "location": "190/TALK",
            "narrator": "アーヤ",
            "text": "放課後まで我慢しなきゃ\nいけないって、ちゃんと\nわかってるんだから――",
            "zh": "要忍到放学，\n她们是明白的\n——",
            "narrator_zh": "绫水"
        },
        {
            "location": "191/TALK",
            "narrator": "アーヤ",
            "text": "怪しまないで、\n信じなくちゃね。",
            "zh": "别怀疑，\n得相信才行。",
            "narrator_zh": "绫水"
        },
        {
            "location": "192/TALK",
            "narrator": "アーヤ",
            "text": "仲間なんだし。",
            "zh": "都是同伴。",
            "narrator_zh": "绫水"
        },
        {
            "location": "196/TALK",
            "narrator": "ガブリエラ",
            "text": "うっ！",
            "zh": "唔！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "199/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "201/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィ、どうかしたの？",
            "zh": "加维，怎么了？",
            "narrator_zh": "绫水"
        },
        {
            "location": "204/TALK",
            "narrator": "ガブリエラ",
            "text": "…な、何でもないわ。",
            "zh": "……没、没什么。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "208/TALK",
            "narrator": "みやび",
            "text": "…ガブちゃん、大丈夫？\n何に苦しんでるかは\n察しがつくけんど…。",
            "zh": "……加布，没事吧？\n在苦恼什么，\n我看得出来，不过……。",
            "narrator_zh": "雅"
        },
        {
            "location": "211/TALK",
            "narrator": "ガブリエラ",
            "text": "…なんだかあたし、\n凄く後ろめたい気持ちに\nなってきてるんだけど。",
            "zh": "……总觉得我，\n心里越来越\n愧疚。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "212/TALK",
            "narrator": "みやび",
            "text": "うちもや…。まさか、\n純粋に信じられるとは\n思うてなかったちや。",
            "zh": "我也是……。没想到\n会被这么单纯地相信\n咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "215/TALK",
            "narrator": "ガブリエラ",
            "text": "これじゃサボッて\nゲームしても――",
            "zh": "这样的话，逃课\n去玩游戏——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "216/TALK",
            "narrator": "ガブリエラ",
            "text": "モヤモヤした気持ちが\n残って楽しめないわ。",
            "zh": "心里发闷，\n也玩不开心。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "217/TALK",
            "narrator": "みやび",
            "text": "…そうやね。",
            "zh": "……是这样咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "219/TALK",
            "narrator": "みやび",
            "text": "信じる心は時として\n裏切られる、いうんを\n思い知らせる気は――",
            "zh": "相信别人的心有时\n会被背叛，我本想\n让她见识一下——",
            "narrator_zh": "雅"
        },
        {
            "location": "220/TALK",
            "narrator": "みやび",
            "text": "さすがのうちにも\nないき、どうする\nこともできん。",
            "zh": "连我都做不出\n这种事啵，也\n没办法。",
            "narrator_zh": "雅"
        },
        {
            "location": "222/TALK",
            "narrator": "みやび",
            "text": "…学校、行かんと\nならんようやね。",
            "zh": "……看来不去学校\n不行咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "224/TALK",
            "narrator": "ガブリエラ",
            "text": "そうね…。ゲームを\n楽しむためにも、大人\nしく学校行こっか…。",
            "zh": "是啊……。为了能\n开心地玩游戏，还是\n乖乖去学校吧……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "225/ACT",
            "narrator": "",
            "text": "二人の服装に注目",
            "zh": "注意她们的衣服",
            "narrator_zh": ""
        },
        {
            "location": "247/TALK",
            "narrator": "アーヤ",
            "text": "え？　別にいつもの服でしょ？",
            "zh": "诶？　不就是平时的衣服吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "265/TALK",
            "narrator": "アーヤ",
            "text": "って、私服！？\nこれから学校でしょ！？",
            "zh": "等，便服！？\n接下来不是要上学！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "268/TALK",
            "narrator": "ガブリエラ",
            "text": "やばっ、バレた！！",
            "zh": "糟了，被发现了！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "270/TALK",
            "narrator": "アーヤ",
            "text": "貴方たち、やっぱり\n最初から学校サボる気\n満々だったんじゃない！",
            "zh": "你们果然\n从一开始就\n满心想逃课！",
            "narrator_zh": "绫水"
        },
        {
            "location": "274/TALK",
            "narrator": "みやび",
            "text": "違うぞね。",
            "zh": "不是啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "275/TALK",
            "narrator": "みやび",
            "text": "うちらが制服じゃない\nのには、ちゃんとした\n理由があるんよ。",
            "zh": "我们没穿制服，\n是有正经\n理由的。",
            "narrator_zh": "雅"
        },
        {
            "location": "276/TALK",
            "narrator": "アーヤ",
            "text": "どんな理由よ？",
            "zh": "什么理由？",
            "narrator_zh": "绫水"
        },
        {
            "location": "277/TALK",
            "narrator": "みやび",
            "text": "平日の朝っぱらから、\n制服姿の女子高生が\n並んでたら――",
            "zh": "工作日一大清早，\n女高中生穿着制服\n排队的话——",
            "narrator_zh": "雅"
        },
        {
            "location": "278/TALK",
            "narrator": "みやび",
            "text": "学校はどうした、朝から\nこんなところで何をして\nいるんだ――",
            "zh": "学校怎么办，一大早就\n在这种地方干什么\n——",
            "narrator_zh": "雅"
        },
        {
            "location": "279/TALK",
            "narrator": "みやび",
            "text": "とか言うてくる大人に、\n絡まれるかもしれんきね。",
            "zh": "这样说的大人，\n可能会来纠缠啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "280/TALK",
            "narrator": "みやび",
            "text": "そうならんように、\nわざわざ私服で並んだ\nだけちや。",
            "zh": "为了不变成那样，\n才特意穿便服\n排队咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "281/TALK",
            "narrator": "アーヤ",
            "text": "…まあ、無くはない\n話だけど…本当なの？",
            "zh": "……嘛，也不是\n没可能……是真的吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "284/TALK",
            "narrator": "みやび",
            "text": "まっことの話や。\nな、ガブちゃん？",
            "zh": "是真的。\n对吧，加布？",
            "narrator_zh": "雅"
        },
        {
            "location": "289/TALK",
            "narrator": "ガブリエラ",
            "text": "そ、そうよ。\n変なオッサンに絡まれて\nトラブルになったら――",
            "zh": "对、对。\n被奇怪的大叔缠上，\n闹出麻烦——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "290/TALK",
            "narrator": "ガブリエラ",
            "text": "色々と面倒でしょ？",
            "zh": "会很麻烦吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "291/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "294/TALK",
            "narrator": "みやび",
            "text": "それに、買うてから\n一度寮に戻って着替え\nたとしても――",
            "zh": "而且，买完之后\n回一次宿舍换衣服\n——",
            "narrator_zh": "雅"
        },
        {
            "location": "295/TALK",
            "narrator": "みやび",
            "text": "登校時間には十分過ぎる\nくらい間に合うきね。",
            "zh": "到上学时间也绰绰有余\n啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "296/TALK",
            "narrator": "アーヤ",
            "text": "…確かに、時間は\nたっぷりあるわね。",
            "zh": "……确实，时间\n很充裕。",
            "narrator_zh": "绫水"
        },
        {
            "location": "297/TALK",
            "narrator": "みやび",
            "text": "やき、私服で並んでた。\nそれだけぞね。",
            "zh": "所以才穿便服排的队。\n就这些啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "298/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "299/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "300/TALK",
            "narrator": "アーヤ",
            "text": "…一応、ちゃんとした\n理由になってるし…\nう～ん…。",
            "zh": "……姑且，也算\n有个正经理由……\n唔——嗯……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "301/TALK",
            "narrator": "アーヤ",
            "text": "…本当に、ちゃんと\n学校には行きなさいよ？",
            "zh": "……真的，要好好\n去学校哦？",
            "narrator_zh": "绫水"
        },
        {
            "location": "303/TALK",
            "narrator": "ガブリエラ",
            "text": "やった！",
            "zh": "太好了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "304/TALK",
            "narrator": "アーヤ",
            "text": "え？",
            "zh": "诶？",
            "narrator_zh": "绫水"
        },
        {
            "location": "305/TALK",
            "narrator": "ガブリエラ",
            "text": "う、ううん！　信じて\nもらえて嬉しいな、\nって思っただけだって。",
            "zh": "没、没有！　被相信\n很高兴，\n只是这么想。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "309/TALK",
            "narrator": "みやび",
            "text": "かなり疑われては\nいるけんど、どうにか\nなったようやね。",
            "zh": "虽然被怀疑得\n挺厉害，不过\n总算过去了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "313/TALK",
            "narrator": "ガブリエラ",
            "text": "ふふっ、今日は一日中\nゲーム三昧よ！",
            "zh": "呵呵，今天一整天\n都打游戏！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "20/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>5月23日　7:11 AM</color>\nとある朝、秋葉原の某ゲームショップ前にて。",
            "zh": "<color=green>5月23日　7:11 AM</color>\n某个早晨，秋叶原某游戏店门前。",
            "narrator_zh": "Dialog_EventData"
        }
    ]
}
