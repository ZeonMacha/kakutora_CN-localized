{
    "dir": "chap22/daydra/dd_ch04_22_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "22402",
        "cid": "miyabi",
        "title": "002 メインストーリー",
        "sub_title": "勇気＜前編＞",
        "title_zh": "002 主线剧情",
        "sub_title_zh": "勇气＜前篇＞"
    },
    "entry": [
        {
            "location": "18/TALK",
            "narrator": "つばめ",
            "text": "…ありがとう\nございました。\n話聞いてくれて…。",
            "zh": "……谢谢你\n听我把\n话说完……。",
            "narrator_zh": "燕"
        },
        {
            "location": "19/TALK",
            "narrator": "みやび",
            "text": "気にせんでえいよ。\nじゃあ、おやすみ。",
            "zh": "不用放心上咯。\n那就，晚安。",
            "narrator_zh": "雅"
        },
        {
            "location": "20/TALK",
            "narrator": "つばめ",
            "text": "おやすみなさい。",
            "zh": "晚安。",
            "narrator_zh": "燕"
        },
        {
            "location": "24/TALK",
            "narrator": "みやび",
            "text": "…気を付けるよう\n言うてはおいた\nけんど…。",
            "zh": "……话我已经\n交代过要她\n当心了……。",
            "narrator_zh": "雅"
        },
        {
            "location": "25/TALK",
            "narrator": "みやび",
            "text": "つばめちゃんの\n性格を考えると、\n無駄かもしれんなぁ。",
            "zh": "不过想到燕那个\n性子，说不定\n也是白费咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "27/TALK",
            "narrator": "みやび",
            "text": "はぁ…。",
            "zh": "唉……。",
            "narrator_zh": "雅"
        },
        {
            "location": "32/TALK",
            "narrator": "みやび",
            "text": "おっと、うさぎか。",
            "zh": "哦呀，是兔子啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "50/TALK",
            "narrator": "みやび",
            "text": "おー、うさぎ。\nお疲れさん。",
            "zh": "哦——兔子。\n辛苦了。",
            "narrator_zh": "雅"
        },
        {
            "location": "51/TALK",
            "narrator": "繭",
            "text": "お疲れ様です…。\nお邪魔でしたか？",
            "zh": "辛苦了……。\n我打扰到你了吗？",
            "narrator_zh": "茧"
        },
        {
            "location": "52/TALK",
            "narrator": "みやび",
            "text": "いや、平気や。",
            "zh": "不，没事咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "53/TALK",
            "narrator": "みやび",
            "text": "それより、ようやく\n管理庁の本質が\nわかってきたなぁ。",
            "zh": "比起这个，总算\n摸到管理厅的\n本质了啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "54/TALK",
            "narrator": "繭",
            "text": "そうですね。\nここまで来るのに、\n長い道のりでした…。",
            "zh": "是啊。\n走到这一步，\n路很长……。",
            "narrator_zh": "茧"
        },
        {
            "location": "55/TALK",
            "narrator": "みやび",
            "text": "そうやね…。",
            "zh": "是咯……。",
            "narrator_zh": "雅"
        },
        {
            "location": "56/TALK",
            "narrator": "みやび",
            "text": "とりあえず、現状を\n一度整理しよう\n思うがよ。",
            "zh": "总之，我想先把\n现状梳理\n一遍咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "57/TALK",
            "narrator": "繭",
            "text": "賛成です。",
            "zh": "赞成。",
            "narrator_zh": "茧"
        },
        {
            "location": "58/TALK",
            "narrator": "みやび",
            "text": "うん…ではまず、\nフェノメノンに\nついてや。",
            "zh": "嗯……那么首先，\n从PhenoMENON\n说起吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "60/TALK",
            "narrator": "みやび",
            "text": "フェノメノンが\n起こる原因は、\n当然わかるな？",
            "zh": "PhenoMENON\n发生的原因，\n你当然懂吧？",
            "narrator_zh": "雅"
        },
        {
            "location": "61/TALK",
            "narrator": "繭",
            "text": "もちろんです。\nクランの発症が\n発生原因です。",
            "zh": "当然。\n库兰的发病\n就是起因。",
            "narrator_zh": "茧"
        },
        {
            "location": "62/TALK",
            "narrator": "みやび",
            "text": "そうや。\nクランの発症が\n発端や。",
            "zh": "没错。\n库兰的发病\n就是开端。",
            "narrator_zh": "雅"
        },
        {
            "location": "63/TALK",
            "narrator": "みやび",
            "text": "クランを発症する\nとは自分の心の一部が\n具現化するということ。",
            "zh": "库兰发病，说的\n是自己的一部分心\n具现化出来。",
            "narrator_zh": "雅"
        },
        {
            "location": "64/TALK",
            "narrator": "みやび",
            "text": "…別の言い方を\nしてみようかね。",
            "zh": "……换个说法\n试试吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "65/TALK",
            "narrator": "みやび",
            "text": "肉体から魂の一部を\n抽出する、っちゅう\nことぞね。",
            "zh": "就是从肉体中\n抽出一部分灵魂，\n这么回事咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "66/TALK",
            "narrator": "みやび",
            "text": "…どう思う？",
            "zh": "……你怎么看？",
            "narrator_zh": "雅"
        },
        {
            "location": "67/TALK",
            "narrator": "繭",
            "text": "…改めて考えると、\nファンタジーですね。",
            "zh": "……重新一想，\n还真像幻想故事呢。",
            "narrator_zh": "茧"
        },
        {
            "location": "68/TALK",
            "narrator": "みやび",
            "text": "そうやね。",
            "zh": "是咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "69/TALK",
            "narrator": "みやび",
            "text": "けんど、そう思うんは\nこの現象が近年\n起き始めたからやき。",
            "zh": "但是，会这么想，\n是因为这现象是\n近年才开始啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "70/TALK",
            "narrator": "みやび",
            "text": "もし有史以前から\n起きちょったら\nただの日常現象。",
            "zh": "要是有史以前就\n发生着，那不过是\n日常现象。",
            "narrator_zh": "雅"
        },
        {
            "location": "71/TALK",
            "narrator": "みやび",
            "text": "誰もファンタジーな\n現象なんて思わん\nやろねえ。",
            "zh": "谁也不会觉得那是\n幻想一样的\n现象咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "72/TALK",
            "narrator": "繭",
            "text": "同感です。",
            "zh": "同感。",
            "narrator_zh": "茧"
        },
        {
            "location": "73/TALK",
            "narrator": "繭",
            "text": "しかし今回の話と\nどうつながりますか？",
            "zh": "但是这和这次的\n事有什么关系呢？",
            "narrator_zh": "茧"
        },
        {
            "location": "74/TALK",
            "narrator": "みやび",
            "text": "うむ。要は\nフェノメノンは\n魔法ではない。",
            "zh": "嗯。重点就是，\nPhenoMENON\n不是魔法。",
            "narrator_zh": "雅"
        },
        {
            "location": "75/TALK",
            "narrator": "みやび",
            "text": "人為的なものと\n考えた方がえいと\nいう話ぞね。",
            "zh": "往人为制造的方向\n去想才好，\n就是这么回事咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "76/TALK",
            "narrator": "みやび",
            "text": "それに…前回の\n出撃の時に取った\nデータや。",
            "zh": "还有……上次\n出击时拿到的\n数据。",
            "narrator_zh": "雅"
        },
        {
            "location": "77/TALK",
            "narrator": "繭",
            "text": "フェノメノン内部で\n展開された世界の、\n量子状態ですね。",
            "zh": "是PhenoMENON\n内部展开世界的，\n量子态呢。",
            "narrator_zh": "茧"
        },
        {
            "location": "78/TALK",
            "narrator": "みやび",
            "text": "トライガジェットで\n超簡単に取得できる\nとはなあ。",
            "zh": "用Tri-Gadget就能\n超简单地拿到手，\n真是没料到啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "79/TALK",
            "narrator": "みやび",
            "text": "しょうまっこと、\nうちも思わん\nかったぞね。",
            "zh": "讲真，\n我也没有\n想到咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "80/TALK",
            "narrator": "繭",
            "text": "その機能、先輩も\n把握していなかったん\nですよね？",
            "zh": "那个功能，前辈\n之前也没\n掌握对吧？",
            "narrator_zh": "茧"
        },
        {
            "location": "82/TALK",
            "narrator": "みやび",
            "text": "うむ…ぶっちゃけ、\nうちらにとっても\n謎アイテムやきね。",
            "zh": "嗯……坦白讲，\n对我们来说它也是\n谜之道具啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "83/TALK",
            "narrator": "繭",
            "text": "…わかる限りですが、\nその他の機能を\n調べました。",
            "zh": "……在我能查的\n范围内，其他\n功能我调查了。",
            "narrator_zh": "茧"
        },
        {
            "location": "84/TALK",
            "narrator": "繭",
            "text": "不明なＡＰＩが多数\n確認できました。",
            "zh": "确认到了大量\n不明ＡＰＩ。",
            "narrator_zh": "茧"
        },
        {
            "location": "85/TALK",
            "narrator": "繭",
            "text": "…内容まではまだ\nわかりませんが。",
            "zh": "……具体内容\n还不清楚。",
            "narrator_zh": "茧"
        },
        {
            "location": "86/TALK",
            "narrator": "みやび",
            "text": "後で調べるき、\n今はとりあえず\n謎機能でえいよ。",
            "zh": "之后再查啵，\n现在暂时当它是\n谜之功能就得咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "87/TALK",
            "narrator": "みやび",
            "text": "まあ……\nこいつのおかげで\nはっきりした。",
            "zh": "嘛……\n多亏这东西，\n事情清楚了。",
            "narrator_zh": "雅"
        },
        {
            "location": "88/TALK",
            "narrator": "みやび",
            "text": "フェノメノン内部は\n物理的にも\n現実と不干渉。",
            "zh": "PhenoMENON内部\n在物理上也\n与现实不干涉。",
            "narrator_zh": "雅"
        },
        {
            "location": "89/TALK",
            "narrator": "繭",
            "text": "…つまり、現実とは\n何の関係もない世界、\nということですね。",
            "zh": "……也就是说，\n是一个与现实毫无\n关系的世界呢。",
            "narrator_zh": "茧"
        },
        {
            "location": "91/TALK",
            "narrator": "みやび",
            "text": "大正解。",
            "zh": "完全正确。",
            "narrator_zh": "雅"
        },
        {
            "location": "92/TALK",
            "narrator": "みやび",
            "text": "そして本来なら\nギャップラインを\n作ることは不可能。",
            "zh": "而且按理说，\n制造间隙线\n是不可能的。",
            "narrator_zh": "雅"
        },
        {
            "location": "93/TALK",
            "narrator": "みやび",
            "text": "計算上は地球全体の\nエネルギーを\n束にしても足らんはず。",
            "zh": "按计算，就算把\n整个地球的能量\n捆一起也不够。",
            "narrator_zh": "雅"
        },
        {
            "location": "94/TALK",
            "narrator": "みやび",
            "text": "けんど、現に\nフェノメノンは\n存在する。",
            "zh": "但是，现实里\nPhenoMENON\n就是存在。",
            "narrator_zh": "雅"
        },
        {
            "location": "95/TALK",
            "narrator": "みやび",
            "text": "これは何を\n意味しちゅう？",
            "zh": "这意味着\n驷马？",
            "narrator_zh": "雅"
        },
        {
            "location": "96/TALK",
            "narrator": "繭",
            "text": "…何者かが、莫大な\nエネルギーを\n調達している。",
            "zh": "……有谁，正在\n调集庞大的\n能量。",
            "narrator_zh": "茧"
        },
        {
            "location": "97/TALK",
            "narrator": "繭",
            "text": "そしてその何者かが、\n作為的に境界線を\n作り、改変している。",
            "zh": "而那个谁，还在\n人为地制造边界线，\n并进行改写。",
            "narrator_zh": "茧"
        },
        {
            "location": "98/TALK",
            "narrator": "繭",
            "text": "…同時に、管理庁も\nこの件を把握している\nということですね。",
            "zh": "……同时，这也说明\n管理厅已经掌握了\n这件事呢。",
            "narrator_zh": "茧"
        },
        {
            "location": "99/TALK",
            "narrator": "繭",
            "text": "個人でこんなこと\nできるわけが\nありませんからね。",
            "zh": "毕竟个人不可能\n做得到\n这种事。",
            "narrator_zh": "茧"
        },
        {
            "location": "100/TALK",
            "narrator": "みやび",
            "text": "……やね。",
            "zh": "……是咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "101/TALK",
            "narrator": "みやび",
            "text": "フェノメノンに対抗\nするための\nトライガジェット。",
            "zh": "为了对抗PhenoMENON\n而造的\nTri-Gadget。",
            "narrator_zh": "雅"
        },
        {
            "location": "102/TALK",
            "narrator": "みやび",
            "text": "現実じゃない場所に\nリンクする時点で\nどうかしとる。",
            "zh": "能跟非现实的地方\n链接，这一点本身\n就不对劲。",
            "narrator_zh": "雅"
        },
        {
            "location": "103/TALK",
            "narrator": "みやび",
            "text": "しかもそれを使うて\nサーバーとリンク。",
            "zh": "而且还用它\n和服务器链接。",
            "narrator_zh": "雅"
        },
        {
            "location": "104/TALK",
            "narrator": "みやび",
            "text": "劇場で\nクランを管理して\n操作する。",
            "zh": "在剧场\n管理库兰、\n进行操作。",
            "narrator_zh": "雅"
        },
        {
            "location": "105/TALK",
            "narrator": "みやび",
            "text": "…そんな芸当、\n全てを把握せんで\nできるわけなかろ。",
            "zh": "……这种绝活，\n不把一切尽在掌握\n根本做不到吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "106/TALK",
            "narrator": "繭",
            "text": "…ですよね。",
            "zh": "……就是说啊。",
            "narrator_zh": "茧"
        },
        {
            "location": "107/TALK",
            "narrator": "繭",
            "text": "…まあ、予想はして\nいましたが。",
            "zh": "……嘛，虽然是\n预料之中。",
            "narrator_zh": "茧"
        },
        {
            "location": "108/TALK",
            "narrator": "みやび",
            "text": "さすがは情報管理庁、\n期待を裏切らんね。",
            "zh": "不愧是情报管理厅，\n从不辜负期待呢。",
            "narrator_zh": "雅"
        },
        {
            "location": "109/TALK",
            "narrator": "繭",
            "text": "…ですが、管理庁が\n黒だとわかった今――",
            "zh": "……可是，如今已经\n查明管理厅是黑的了——",
            "narrator_zh": "茧"
        },
        {
            "location": "110/TALK",
            "narrator": "繭",
            "text": "みやび先輩達は\nどう動くおつもり\nなのですか？",
            "zh": "雅前辈打算\n怎么\n行动呢？",
            "narrator_zh": "茧"
        },
        {
            "location": "111/TALK",
            "narrator": "みやび",
            "text": "ん～…、それが\nちっくと悩みどころ\nながよ…。",
            "zh": "嗯～……这正是\n让人有点头疼\n的地方咯……。",
            "narrator_zh": "雅"
        },
        {
            "location": "112/TALK",
            "narrator": "みやび",
            "text": "極論やとは\n思うけんど……。",
            "zh": "虽然知道是\n极端的想法……。",
            "narrator_zh": "雅"
        },
        {
            "location": "113/TALK",
            "narrator": "みやび",
            "text": "全員でトライナリーを\nやめた方がえいとも\n思うたぞね。",
            "zh": "我想过，大家\n一起退出三重奏\n才好咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "114/TALK",
            "narrator": "みやび",
            "text": "けんど、そうなると\nフェノメノンを放置\nすることになる。",
            "zh": "但是，那样一来\n就变成放着\nPhenoMENON不管了。",
            "narrator_zh": "雅"
        },
        {
            "location": "116/TALK",
            "narrator": "みやび",
            "text": "そういうわけにも\nいかんしなぁ…。",
            "zh": "也不能那么\n干啊……。",
            "narrator_zh": "雅"
        },
        {
            "location": "117/TALK",
            "narrator": "繭",
            "text": "…管理庁へ真実を\n問いただしに行く\nこともできませんし。",
            "zh": "……也不可能跑进\n管理厅去当面\n质问真相呢。",
            "narrator_zh": "茧"
        },
        {
            "location": "118/TALK",
            "narrator": "みやび",
            "text": "敵である以上、\n何してくるか\nわからんきね。",
            "zh": "既然是敌人，\n下一步搞驷马\n没人晓得啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "119/TALK",
            "narrator": "繭",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "茧"
        },
        {
            "location": "120/TALK",
            "narrator": "繭",
            "text": "まずは皆さんに\n事実を話しては\nいかがでしょうか。",
            "zh": "首先，把事实\n告诉大家，\n怎么样呢？",
            "narrator_zh": "茧"
        },
        {
            "location": "121/TALK",
            "narrator": "繭",
            "text": "今後の方針について\n話し合うのも手かと\n思いますよ？",
            "zh": "一起商量今后的\n方针，也是个\n办法哦？",
            "narrator_zh": "茧"
        },
        {
            "location": "122/TALK",
            "narrator": "みやび",
            "text": "…そうやなぁ。",
            "zh": "……也是啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "123/TALK",
            "narrator": "みやび",
            "text": "うちだけで\n抱え込むには\n重い問題やけんど…。",
