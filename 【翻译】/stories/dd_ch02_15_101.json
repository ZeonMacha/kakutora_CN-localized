{
    "dir": "chap15/daydra/dd_ch02_15_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "15202",
        "cid": "ayami",
        "title": "002 メインストーリー",
        "sub_title": "ここは横須賀＜前編＞",
        "title_zh": "002 主线剧情",
        "sub_title_zh": "这里是横须贺＜前篇＞"
    },
    "entry": [
        {
            "location": "27/TALK",
            "narrator": "雛",
            "text": "お疲れ様でした、\n綾水様！！",
            "zh": "辛苦了，\n绫水大人！！",
            "narrator_zh": "雏"
        },
        {
            "location": "29/TALK",
            "narrator": "雛",
            "text": "ここが目的地の\n横須賀ですよー！",
            "zh": "这里就是目的地\n横须贺哦——！",
            "narrator_zh": "雏"
        },
        {
            "location": "33/TALK",
            "narrator": "アーヤ",
            "text": "ひ、日向さん。\n元気がいいのは\nわかったから、その……",
            "zh": "日、日向。\n我知道你很有精神，\n不过那个……",
            "narrator_zh": "绫水"
        },
        {
            "location": "34/TALK",
            "narrator": "アーヤ",
            "text": "もう少しだけ声を\n抑えてもらえるかしら？",
            "zh": "能不能稍微把声音\n放小一点呢？",
            "narrator_zh": "绫水"
        },
        {
            "location": "36/TALK",
            "narrator": "雛",
            "text": "あはは、すみません。\nちょっとテンション\n上がっちゃってて。",
            "zh": "啊哈哈，不好意思。\n一不小心就\n兴奋过头了。",
            "narrator_zh": "雏"
        },
        {
            "location": "37/TALK",
            "narrator": "アーヤ",
            "text": "あはは…。",
            "zh": "啊哈哈……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "40/TALK",
            "narrator": "アーヤ",
            "text": "でも、日向さんの\n言う通り、電車の旅も\nなかなかいいものね。",
            "zh": "不过，确实如日向\n所说，坐电车旅行也\n挺不错的呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "41/TALK",
            "narrator": "雛",
            "text": "本当ですか！？",
            "zh": "真的吗！？",
            "narrator_zh": "雏"
        },
        {
            "location": "42/TALK",
            "narrator": "アーヤ",
            "text": "ええ。バイク旅だと\n運転してるからあまり\n景色を楽しめないもの。",
            "zh": "嗯。要是骑摩托旅行，\n因为要开车，不太能\n好好欣赏风景呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "45/TALK",
            "narrator": "雛",
            "text": "あ～…、なるほどー。\n綾水様は、電車旅は景色を\n楽しむ派なんですね！",
            "zh": "啊～……这样啊——。\n原来绫水大人坐电车旅行，\n是享受风景那一派的呀！",
            "narrator_zh": "雏"
        },
        {
            "location": "47/TALK",
            "narrator": "アーヤ",
            "text": "え？　日向さんは\nそうじゃないの？",
            "zh": "哎？日向\n不是这样的吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "50/TALK",
            "narrator": "雛",
            "text": "あたしは景色よりも\n電車が目当ての女です\nからねー。",
            "zh": "我可是比起风景，\n更冲着电车本身\n去的女人哦——。",
            "narrator_zh": "雏"
        },
        {
            "location": "51/TALK",
            "narrator": "雛",
            "text": "景色よりも車両を\n重要視するタイプ\nなんですよー。",
            "zh": "我是比起风景，\n更看重车厢本身的\n类型啦——。",
            "narrator_zh": "雏"
        },
        {
            "location": "52/TALK",
            "narrator": "アーヤ",
            "text": "あはは、本当に\n電車が好きなのね。",
            "zh": "啊哈哈，你还真是\n打从心底喜欢电车呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "53/TALK",
            "narrator": "雛",
            "text": "はい！",
            "zh": "是的！",
            "narrator_zh": "雏"
        },
        {
            "location": "54/TALK",
            "narrator": "雛",
            "text": "東京２３区内を丸一日\nかけて、色んな路線を\n渡り歩くのが最高です！",
            "zh": "花一整天在东京23区内\n换乘各种各样的线路\n四处穿梭，简直太棒了！",
            "narrator_zh": "雏"
        },
        {
            "location": "57/TALK",
            "narrator": "アーヤ",
            "text": "渡り歩くって、\nえ？　それだけ？",
            "zh": "四处穿梭，\n哎？就只是坐车吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "58/TALK",
            "narrator": "雛",
            "text": "何言ってるんですか！",
            "zh": "您怎么能这么说呢！",
            "narrator_zh": "雏"
        },
        {
            "location": "59/TALK",
            "narrator": "雛",
            "text": "１日中電車に乗って\nいられるなんて、すごい\n贅沢旅だと思いませんか？",
            "zh": "能够整整一天都待在\n电车上，您不觉得这是\n超级奢侈的旅行吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "63/TALK",
            "narrator": "アーヤ",
            "text": "うーん…でもそれ、\n旅って言っても\nいいのかしら…？",
            "zh": "唔……可那样的话，\n还能算得上是\n旅行吗……？",
            "narrator_zh": "绫水"
        },
        {
            "location": "65/TALK",
            "narrator": "雛",
            "text": "距離的には凄いことに\nなりますからねー。",
            "zh": "光是按里程算就\n相当惊人了哦——。",
            "narrator_zh": "雏"
        },
        {
            "location": "66/TALK",
            "narrator": "雛",
            "text": "都区内パスがあれば\n１０００円以内で、都内の\n隅から隅まで行けますし。",
            "zh": "只要有都区内通票，\n1000日元以内就能把\n东京都内逛个遍。",
            "narrator_zh": "雏"
        },
        {
            "location": "68/TALK",
            "narrator": "雛",
            "text": "超お得なんですよ！",
            "zh": "超级划算的哦！",
            "narrator_zh": "雏"
        },
        {
            "location": "70/TALK",
            "narrator": "アーヤ",
            "text": "そうなんだ…。\n本当、電車のことに\n詳しいのね。",
            "zh": "这样啊……。\n你对电车的事情\n还真是了如指掌呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "71/TALK",
            "narrator": "雛",
            "text": "えへへ…、そう言って\nもらえると、とっても\n嬉しいです…。",
            "zh": "哎嘿嘿……能被您这么\n夸奖，我真的\n好开心……。",
            "narrator_zh": "雏"
        },
        {
            "location": "72/TALK",
            "narrator": "アーヤ",
            "text": "ふふっ…。",
            "zh": "呵呵……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "74/TALK",
            "narrator": "アーヤ",
            "text": "さてと、せっかく横須賀\nまで来たんだし、名所的な\n所に行きたいわね。",
            "zh": "好啦，难得都来横须贺\n一趟了，我想去像名胜\n一样的地方逛逛呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "76/TALK",
            "narrator": "雛",
            "text": "う～ん、横須賀の\n名所ですか…。",
            "zh": "唔～横须贺的\n名胜吗……。",
            "narrator_zh": "雏"
        },
        {
            "location": "77/TALK",
            "narrator": "雛",
            "text": "横須賀といえば\nやっぱり――",
            "zh": "说到横须贺，\n果然还是——",
            "narrator_zh": "雏"
        },
        {
            "location": "79/TALK",
            "narrator": "アーヤ",
            "text": "花火大会、かしら？",
            "zh": "烟花大会，对吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "81/TALK",
            "narrator": "雛",
            "text": "有名ですよねー。\nでもあれがやるの、\n夏休みなんです…。",
            "zh": "确实很有名呢——。\n不过那个要到\n暑假才办……。",
            "narrator_zh": "雏"
        },
        {
            "location": "82/TALK",
            "narrator": "アーヤ",
            "text": "ごめんなさい。\nそれくらいしか\n知らなくて…。",
            "zh": "不好意思。\n我就只知道\n这么多了……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "83/TALK",
            "narrator": "雛",
            "text": "いえ、あたしも\n詳しいわけじゃ\nないんです。",
            "zh": "不不，我也\n算不上多了解\n啦。",
            "narrator_zh": "雏"
        },
        {
            "location": "84/TALK",
            "narrator": "雛",
            "text": "…綾水様の趣味に\n合うかわからないん\nですけど――",
            "zh": "……虽然不知道合不合\n绫水大人的胃口\n——",
            "narrator_zh": "雏"
        },
        {
            "location": "85/TALK",
            "narrator": "雛",
            "text": "名所を一つだけ\n知ってます。\n…どうしますか？",
            "zh": "我倒是只知道一个\n名胜。\n……您看怎么样？",
            "narrator_zh": "雏"
        },
        {
            "location": "87/TALK",
            "narrator": "アーヤ",
            "text": "構わないわ。\nせっかく来たんだし、\n行ってみましょ。",
            "zh": "我不介意。\n难得来一趟，\n去看看吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "88/TALK",
            "narrator": "雛",
            "text": "わかりました。\nでは、こちらですー。",
            "zh": "明白了。\n那么，请往这边走——。",
            "narrator_zh": "雏"
        },
        {
            "location": "107/TALK",
            "narrator": "アーヤ",
            "text": "わぁ、すごい！",
            "zh": "哇，好厉害！",
            "narrator_zh": "绫水"
        },
        {
            "location": "108/TALK",
            "narrator": "アーヤ",
            "text": "これ、本物の戦艦？",
            "zh": "这个，是真正的战舰吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "110/TALK",
            "narrator": "雛",
            "text": "はい…。",
            "zh": "是的……。",
            "narrator_zh": "雏"
        },
        {
            "location": "112/TALK",
            "narrator": "雛",
            "text": "日露戦争で連合艦隊\n旗艦を務め、東郷平八郎も\n座乗した、戦艦三笠です。",
            "zh": "这就是在日俄战争中担任\n联合舰队旗舰、东乡平八郎\n也曾乘坐过的战舰三笠。",
            "narrator_zh": "雏"
        },
        {
            "location": "115/TALK",
            "narrator": "アーヤ",
            "text": "随分詳しいのね？",
            "zh": "你懂得真不少呢？",
            "narrator_zh": "绫水"
        },
        {
            "location": "117/TALK",
            "narrator": "雛",
            "text": "キリトに何十回と\n聞かされましたから…。",
            "zh": "因为圣翔在我耳边\n念叨过几十遍了……。",
            "narrator_zh": "雏"
        },
        {
            "location": "118/TALK",
            "narrator": "アーヤ",
            "text": "そっか…。",
            "zh": "这样啊……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "121/TALK",
            "narrator": "アーヤ",
            "text": "…この船が、本当に\n戦争で戦ってたのね。",
            "zh": "……这艘船，曾经真的\n在战争中战斗过呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "123/TALK",
            "narrator": "雛",
            "text": "…わかってはいても、\nあんまり実感が\nわきませんよね？",
            "zh": "……就算心里明白，\n但还是不太有\n实感对吧？",
            "narrator_zh": "雏"
        },
        {
            "location": "124/TALK",
            "narrator": "アーヤ",
            "text": "ええ…戦艦なんて、\n映画の中でしか\n見ないからかも。",
            "zh": "是啊……毕竟战舰这种东西，\n平时也只在电影里\n见过嘛。",
            "narrator_zh": "绫水"
        },
        {
            "location": "126/TALK",
            "narrator": "雛",
            "text": "でも、トライナリーは\n戦艦くらい持ってるん\nじゃないですか？",
            "zh": "不过，三重奏应该\n也有战舰之类的\n装备吧？",
            "narrator_zh": "雏"
        },
        {
            "location": "129/TALK",
            "narrator": "アーヤ",
            "text": "ないない。\nさすがにそんなの\n持ってないわ。",
            "zh": "没有没有。\n再怎么说也不可能有\n那种东西的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "130/TALK",
            "narrator": "雛",
            "text": "本当ですかぁ？\n実は秘密兵器として\nあるんじゃ…。",
            "zh": "真的吗——？\n说不定其实作为秘密武器\n藏着一艘呢……。",
            "narrator_zh": "雏"
        },
        {
            "location": "133/TALK",
            "narrator": "アーヤ",
            "text": "そりゃ、そんなのが\nあれば心強いとは\n思うけど――",
            "zh": "话是这么说，要真有\n那种东西虽然会觉得\n很可靠——",
            "narrator_zh": "绫水"
        },
        {
            "location": "134/TALK",
            "narrator": "アーヤ",
            "text": "強力過ぎるから、\nちょっと使うのが\n怖いわね。",
            "zh": "可威力太强了，\n用起来反而有点\n吓人呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "137/TALK",
            "narrator": "アーヤ",
            "text": "それに、使える場所も\n限定されるし。",
            "zh": "而且能派上用场的\n地方也有限。",
            "narrator_zh": "绫水"
        },
        {
            "location": "139/TALK",
            "narrator": "雛",
            "text": "そっかー。\n戦艦だと海辺以外じゃ\n使えませんからねー。",
            "zh": "也是哦——。\n战舰的话除了海边\n也没法用嘛——。",
            "narrator_zh": "雏"
        },
        {
            "location": "140/TALK",
            "narrator": "アーヤ",
            "text": "そういうこと。",
            "zh": "就是这么回事。",
            "narrator_zh": "绫水"
        },
        {
            "location": "143/TALK",
            "narrator": "雛",
            "text": "…さてと、これから\nどうしましょうか？",
            "zh": "……那么，接下来\n要怎么办呢？",
            "narrator_zh": "雏"
        },
        {
            "location": "144/TALK",
            "narrator": "雛",
            "text": "あたしが案内できる\n場所は、これくらい\nですし…。",
            "zh": "我能带路介绍的\n地方，也就这么\n一处了……。",
            "narrator_zh": "雏"
        },
        {
            "location": "145/TALK",
            "narrator": "アーヤ",
            "text": "う～ん、そうね…。",
            "zh": "唔……是啊……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "146/TALK",
            "narrator": "アーヤ",
            "text": "凄い戦艦も見れたし、\n電車旅の楽しさも\nわかったから……",
            "zh": "既看到了厉害的战舰，\n也体会到电车旅行的\n乐趣了……",
            "narrator_zh": "绫水"
        },
        {
            "location": "147/TALK",
            "narrator": "アーヤ",
            "text": "そろそろ帰って、\n部屋でのんびり\nしようかしら？",
            "zh": "差不多该回去了，\n在房间里悠闲地\n休息一下吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "148/TALK",
            "narrator": "アーヤ",
            "text": "サークルで使う\n新しい人形も\n作りたいし…。",
            "zh": "社团要用的新人偶\n我也想开始\n做了……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "149/SEL",
            "narrator": "",
            "text": "まさか帰ろうとしてる？",
            "zh": "你该不会打算这就回去了吧？",
            "narrator_zh": ""
        },
        {
            "location": "150/ACT",
            "narrator": "",
            "text": "まさか帰ろうとしてる？",
            "zh": "你该不会打算这就回去了吧？",
            "narrator_zh": ""
        },
        {
            "location": "168/TALK",
            "narrator": "アーヤ",
            "text": "だって",
            "zh": "因为",
            "narrator_zh": "绫水"
        },
        {
            "location": "169/TALK",
            "narrator": "アーヤ",
            "text": "目的が済んだから",
            "zh": "目的已经达成了",
            "narrator_zh": "绫水"
        },
        {
            "location": "170/TALK",
            "narrator": "アーヤ",
            "text": "これ以上",
            "zh": "再继续待下去",
            "narrator_zh": "绫水"
        },
        {
            "location": "171/TALK",
            "narrator": "アーヤ",
            "text": "いる意味ないし",
            "zh": "也没有意义",
            "narrator_zh": "绫水"
        },
        {
            "location": "172/TALK",
            "narrator": "アーヤ",
            "text": "日向さんも",
            "zh": "而且让日向",
            "narrator_zh": "绫水"
        },
        {
            "location": "173/TALK",
            "narrator": "アーヤ",
            "text": "あまり長い時間",
            "zh": "陪我太长时间",
            "narrator_zh": "绫水"
        },
        {
            "location": "174/TALK",
            "narrator": "アーヤ",
            "text": "付き合わせたら悪いわ",
            "zh": "也挺过意不去的",
            "narrator_zh": "绫水"
        },
        {
            "location": "176/SEL",
            "narrator": "",
            "text": "雛はアーヤに憧れてるから大丈夫",
            "zh": "雏很崇拜绫水所以没关系的",
            "narrator_zh": ""
        },
        {
            "location": "177/ACT",
            "narrator": "",
            "text": "雛はアーヤに憧れてるから大丈夫",
            "zh": "雏很崇拜绫水所以没关系的",
            "narrator_zh": ""
        },
        {
            "location": "179/TALK",
            "narrator": "アーヤ",
            "text": "でも",
            "zh": "可是",
            "narrator_zh": "绫水"
        },
        {
            "location": "180/TALK",
            "narrator": "アーヤ",
            "text": "これ以上",
            "zh": "再待下去",
            "narrator_zh": "绫水"
        },
        {
            "location": "181/TALK",
            "narrator": "アーヤ",
            "text": "話すこともないし",
            "zh": "也没有什么可聊的了",
            "narrator_zh": "绫水"
        },
        {
            "location": "184/TALK",
            "narrator": "アーヤ",
            "text": "嫌いってわけじゃなくて",
            "zh": "倒不是讨厌她",
            "narrator_zh": "绫水"
        },
        {
            "location": "185/TALK",
            "narrator": "アーヤ",
            "text": "まだ",
            "zh": "只是现在还",
            "narrator_zh": "绫水"
        },
        {
            "location": "186/TALK",
            "narrator": "アーヤ",
            "text": "共通の話題？",
            "zh": "不太清楚彼此",
            "narrator_zh": "绫水"
        },
        {
            "location": "187/TALK",
            "narrator": "アーヤ",
            "text": "そういうのわからないから",
            "zh": "有什么共同话题",
            "narrator_zh": "绫水"
        },
        {
            "location": "188/TALK",
            "narrator": "アーヤ",
            "text": "目的が無いと",
            "zh": "没有明确目的的话",
            "narrator_zh": "绫水"
        },
        {
            "location": "190/TALK",
            "narrator": "アーヤ",
            "text": "間が持たないと思う",
            "zh": "怕是会冷场",
            "narrator_zh": "绫水"
        },
        {
            "location": "192/SEL",
            "narrator": "",
            "text": "二人とも旅好きじゃん",
            "zh": "你们俩不都喜欢旅行嘛",
            "narrator_zh": ""
        },
        {
            "location": "193/ACT",
            "narrator": "",
            "text": "二人とも旅好きじゃん",
            "zh": "你们俩不都喜欢旅行嘛",
            "narrator_zh": ""
        },
        {
            "location": "195/TALK",
            "narrator": "アーヤ",
            "text": "でも",
            "zh": "话是这么说",
            "narrator_zh": "绫水"
        },
        {
            "location": "196/TALK",
            "narrator": "アーヤ",
            "text": "微妙に食い違ってるし",
            "zh": "但侧重点微妙地对不上",
            "narrator_zh": "绫水"
        },
        {
            "location": "199/TALK",
            "narrator": "アーヤ",
            "text": "やっぱり",
            "zh": "果然还是",
            "narrator_zh": "绫水"
        },
        {
            "location": "200/TALK",
            "narrator": "アーヤ",
            "text": "今日は帰るわ",
            "zh": "今天就先回去了",
            "narrator_zh": "绫水"
        },
        {
            "location": "211/TALK",
            "narrator": "アーヤ",
            "text": "…それがいいわね。\n結構気を使わせ\nちゃってもいるし。",
            "zh": "……这样比较好呢。\n我也确实让她\n费了不少心。",
            "narrator_zh": "绫水"
        },
        {
            "location": "212/TALK",
            "narrator": "アーヤ",
            "text": "もう少し劇場で一緒に\nバイトすれば、共通の\n話題も増えるだろうから。",
            "zh": "以后在剧场一起多打几次\n工，共同话题自然也就\n多起来了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "213/TALK",
            "narrator": "アーヤ",
            "text": "今日はもう帰ろう。",
            "zh": "今天就先回去吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "217/TALK",
            "narrator": "アーヤ",
            "text": "さてと、日向さん。\nそろそろ――",
            "zh": "那么，日向。\n差不多该——",
            "narrator_zh": "绫水"
        },
        {
            "location": "287/TALK",
            "narrator": "アーヤ",
            "text": "[ココロゲート]へ\nいらっしゃい。\n$handle$さん。",
            "zh": "欢迎来到\n[心之扉]。\n$handle$。",
            "narrator_zh": "绫水"
        },
        {
            "location": "289/TALK",
            "narrator": "アーヤ",
            "text": "今日も早速\n何を悩んでるのか\n検索するわね。",
            "zh": "今天也马上来\n搜索一下她正在\n烦恼什么吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "294/TALK",
            "narrator": "アーヤ",
            "text": "オープンプロセス、\n0xF28番地から\n0x331番地へ。",
            "zh": "开放进程，\n从0xF28号地址前往\n0x331号地址。",
            "narrator_zh": "绫水"
        },
        {
            "location": "309/TALK",
            "narrator": "アーヤ",
            "text": "シーク完了。",
            "zh": "搜索完成。",
            "narrator_zh": "绫水"
        },
        {
            "location": "312/TALK",
            "narrator": "アーヤ",
            "text": "さて、と。\n今回は……",
            "zh": "那么，\n这次是……",
            "narrator_zh": "绫水"
        },
        {
            "location": "314/TALK",
            "narrator": "アーヤ",
            "text": "あー……。",
            "zh": "啊——……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "315/SEL",
            "narrator": "",
            "text": "また恥ずかしいこと？",
            "zh": "又是让人难为情的事？",
            "narrator_zh": ""
        },
        {
            "location": "316/SEL",
            "narrator": "",
            "text": "また平和な悩み？",
            "zh": "又是和平的烦恼？",
            "narrator_zh": ""
        },
        {
            "location": "317/ACT",
            "narrator": "",
            "text": "また恥ずかしいこと？",
            "zh": "又是让人难为情的事？",
            "narrator_zh": ""
        },
        {
            "location": "319/TALK",
            "narrator": "アーヤ",
            "text": "また…って！\n私は一度も恥ずかしい姿\n晒した事なんてないわよ！",
            "zh": "什么叫“又”……！\n我可一次都没有出过\n丑好不好！",
            "narrator_zh": "绫水"
        },
        {
            "location": "320/SEL",
            "narrator": "",
            "text": "え？でも前回「恥ずかしい女」だ、って自分で…",
            "zh": "哎？可是上次你自己说“是个丢人的女人”来着……",
            "narrator_zh": ""
        },
        {
            "location": "321/ACT",
            "narrator": "",
            "text": "え？でも前回「恥ずかしい女」だ、って自分で…",
            "zh": "哎？可是上次你自己说“是个丢人的女人”来着……",
            "narrator_zh": ""
        },
        {
            "location": "323/TALK",
            "narrator": "アーヤ",
            "text": "え？",
            "zh": "哎？",
            "narrator_zh": "绫水"
        },
        {
            "location": "324/TALK",
            "narrator": "アーヤ",
            "text": "あ、ああ、\nそっちの意味の\n恥ずかしいだったのね。",
            "zh": "啊、啊啊，\n你说的“丢人”\n是那个意思啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "325/SEL",
            "narrator": "",
            "text": "アーヤはどっちの「恥ずかしい」だと思ってたの？",
            "zh": "那绫水你刚才以为是哪种“丢人”？",
            "narrator_zh": ""
        },
        {
            "location": "326/ACT",
            "narrator": "",
            "text": "アーヤはどっちの「恥ずかしい」だと思ってたの？",
            "zh": "那绫水你刚才以为是哪种“丢人”？",
            "narrator_zh": ""
        },
        {
            "location": "328/TALK",
            "narrator": "アーヤ",
            "text": "な、なんだって\nいいでしょう？",
            "zh": "哪、哪种都\n无所谓吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "329/SEL",
            "narrator": "",
            "text": "勘違いするってことは、つまり……",
            "zh": "会想歪的话，也就是说……",
            "narrator_zh": ""
        },
        {
            "location": "330/SEL",
            "narrator": "",
            "text": "アーヤかわいいのでこの辺で許してあげる",
            "zh": "既然绫水这么可爱，这次就饶了你吧",
            "narrator_zh": ""
        },
        {
            "location": "331/ACT",
            "narrator": "",
            "text": "勘違いするってことは、つまり……",
            "zh": "会想歪的话，也就是说……",
            "narrator_zh": ""
        },
        {
            "location": "332/TALK",
            "narrator": "アーヤ",
            "text": "いや、そうじゃなくて！",
            "zh": "才、才不是那样！",
            "narrator_zh": "绫水"
        },
        {
            "location": "333/TALK",
            "narrator": "アーヤ",
            "text": "つまりもハマリも\nありませんから。",
            "zh": "没有什么\n“也就是说”啦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "334/TALK",
            "narrator": "アーヤ",
            "text": "ま、まあ、心当たりは\nないわけじゃないけど……",
            "zh": "虽、虽然也算不上\n完全没有头绪……",
            "narrator_zh": "绫水"
        },
        {
            "location": "335/ACT",
            "narrator": "",
            "text": "アーヤかわいいのでこの辺で許してあげる",
            "zh": "既然绫水这么可爱，这次就饶了你吧",
            "narrator_zh": ""
        },
        {
            "location": "336/TALK",
            "narrator": "アーヤ",
            "text": "はいはい。\n許してくれてありがと。",
            "zh": "好好好。\n谢谢你原谅我咯。",
            "narrator_zh": "绫水"
        },
        {
            "location": "339/TALK",
            "narrator": "アーヤ",
            "text": "ふぅ……。",
            "zh": "呼……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "340/TALK",
            "narrator": "アーヤ",
            "text": "話、戻していい？",
            "zh": "可以把话题转回来了吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "341/ACT",
            "narrator": "",
            "text": "また平和な悩み？",
            "zh": "又是和平的烦恼？",
            "narrator_zh": ""
        },
        {
            "location": "342/TALK",
            "narrator": "アーヤ",
            "text": "え？\n平和な悩みっていうのは？",
            "zh": "哎？\n和平的烦恼是指？",
            "narrator_zh": "绫水"
        },
        {
            "location": "343/SEL",
            "narrator": "",
            "text": "アーヤの悩みは他の子に比べて重くない気がするから",
            "zh": "因为总觉得绫水的烦恼比起其他女孩子来说没那么沉重",
            "narrator_zh": ""
        },
        {
            "location": "344/ACT",
            "narrator": "",
            "text": "アーヤの悩みは他の子に比べて重くない気がするから",
            "zh": "因为总觉得绫水的烦恼比起其他女孩子来说没那么沉重",
            "narrator_zh": ""
        },
        {
            "location": "346/TALK",
            "narrator": "アーヤ",
            "text": "あー、そうね。\n自分でもそんなこと\n言ったかもしれない。",
            "zh": "啊——，确实呢。\n我自己好像也\n说过类似的话。",
            "narrator_zh": "绫水"
        },
        {
            "location": "347/TALK",
            "narrator": "アーヤ",
            "text": "でも……本当に、\nどうしてなのかしらね。",
            "zh": "不过……真的，\n到底是为什么呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "348/TALK",
            "narrator": "アーヤ",
            "text": "なんて考えていても\nわかるものでもなし。\n話を戻すわね。",
            "zh": "不过光这么想也\n想不出个所以然。\n说回正题吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "350/TALK",
            "narrator": "アーヤ",
            "text": "ココロファイルナンバー\n02-331-59によると――",
            "zh": "根据心灵档案编号\n02-331-59——",
            "narrator_zh": "绫水"
        },
        {
            "location": "351/TALK",
            "narrator": "アーヤ",
            "text": "日向さんと一緒にいるのが\n気まずいから、帰ろうか\nどうしようか悩んでる。",
            "zh": "她正纠结着和日向待在一起\n很尴尬，不知道该不该\n干脆回去。",
            "narrator_zh": "绫水"
        },
        {
            "location": "352/TALK",
            "narrator": "アーヤ",
            "text": "でも、総意としては\n日向さんともっと親睦を\n深めたいから――",
            "zh": "不过，从总体意志来看，\n她其实是想和日向\n更加亲近的——",
            "narrator_zh": "绫水"
        },
        {
            "location": "353/TALK",
            "narrator": "アーヤ",
            "text": "もうちょっと一緒に\nいたいって思ってるわね。",
            "zh": "所以心里还是希望\n能再多待一会儿呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "354/SEL",
            "narrator": "",
            "text": "いればいいじゃん",
            "zh": "那多待一会儿不就好了",
            "narrator_zh": ""
        },
        {
            "location": "355/SEL",
            "narrator": "",
            "text": "やっぱり平和な悩みだねえ",
            "zh": "果然是很和平的烦恼呢",
            "narrator_zh": ""
        },
        {
            "location": "356/ACT",
            "narrator": "",
            "text": "いればいいじゃん",
            "zh": "那多待一会儿不就好了",
            "narrator_zh": ""
        },
        {
            "location": "357/TALK",
            "narrator": "アーヤ",
            "text": "そうなんだけど、\nどっちかというと、気に\nしてるのは日向さんの方。",
            "zh": "话是这么说，\n但她真正在意的其实是\n日向那边的感受。",
            "narrator_zh": "绫水"
        },
        {
            "location": "358/TALK",
            "narrator": "アーヤ",
            "text": "本当はつまらなくて、\nでも年長者だから仕方なく\nつき合ってるのかもって。",
            "zh": "她担心对方其实觉得很无聊，\n只是因为自己是前辈才勉强\n陪着自己。",
            "narrator_zh": "绫水"
        },
        {
            "location": "359/SEL",
            "narrator": "",
            "text": "それはないと思う",
            "zh": "我觉得不会有这种事",
            "narrator_zh": ""
        },
        {
            "location": "360/ACT",
            "narrator": "",
            "text": "それはないと思う",
            "zh": "我觉得不会有这种事",
            "narrator_zh": ""
        },
        {
            "location": "362/TALK",
            "narrator": "アーヤ",
            "text": "そうなの？",
            "zh": "是吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "363/TALK",
            "narrator": "アーヤ",
            "text": "でも貴方がそう言うなら\nそうなんでしょうね。",
            "zh": "不过既然你都这么说了，\n那大概就是这样吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "364/TALK",
            "narrator": "アーヤ",
            "text": "結構びっくりするような\n事を知ってたりするから、\n今回もそうなんでしょ？",
            "zh": "你平时就经常知道些\n令人吃惊的事，\n这次肯定也一样吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "365/TALK",
            "narrator": "アーヤ",
            "text": "なんにせよ、貴方の言葉で\n少しだけクランが\n弱体化したかも。",
            "zh": "总之，托你的话的福，\n库兰说不定稍微\n削弱了一点呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "366/ACT",
            "narrator": "",
            "text": "やっぱり平和な悩みだねえ",
            "zh": "果然是很和平的烦恼呢",
            "narrator_zh": ""
        },
        {
            "location": "368/TALK",
            "narrator": "アーヤ",
            "text": "まあ、そう…なのかも\nしれないわね。",
            "zh": "嘛，或许……\n确实是这样也说不定呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "369/TALK",
            "narrator": "アーヤ",
            "text": "でも、あれよ？",
            "zh": "不过，那个哦？",
            "narrator_zh": "绫水"
        },
        {
            "location": "370/TALK",
            "narrator": "アーヤ",
            "text": "悩みの重さは人それぞれ。",
            "zh": "烦恼的分量因人而异。",
            "narrator_zh": "绫水"
        },
        {
            "location": "371/TALK",
            "narrator": "アーヤ",
            "text": "他人から見たら\n些細なことでも当人には\n重大な事ってあるから。",
            "zh": "旁人看起来微不足道的事，\n对当事人而言有时也是\n天大的事哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "372/SEL",
            "narrator": "",
            "text": "他にもっと深刻な悩みはないの？",
            "zh": "难道就没有其他更沉重的烦恼了吗？",
            "narrator_zh": ""
        },
        {
            "location": "373/ACT",
            "narrator": "",
            "text": "他にもっと深刻な悩みはないの？",
            "zh": "难道就没有其他更沉重的烦恼了吗？",
            "narrator_zh": ""
        },
        {
            "location": "375/TALK",
            "narrator": "アーヤ",
            "text": "え？\nなにそれ。",
            "zh": "哎？\n你这话什么意思。",
            "narrator_zh": "绫水"
        },
        {
            "location": "376/TALK",
            "narrator": "アーヤ",
            "text": "まるで、深刻な悩みが\nあるのが当たり前みたいな\n言い方ね？",
            "zh": "说得好像人必须得有\n什么沉重烦恼才正常\n似的呢？",
            "narrator_zh": "绫水"
        },
        {
            "location": "377/SEL",
            "narrator": "",
            "text": "普通あるし",
            "zh": "一般人都会有的吧",
            "narrator_zh": ""
        },
        {
            "location": "378/SEL",
            "narrator": "",
            "text": "本当は隠してない？",
            "zh": "你是不是其实藏着没说？",
            "narrator_zh": ""
        },
        {
            "location": "379/ACT",
            "narrator": "",
            "text": "普通あるし",
            "zh": "一般人都会有的吧",
            "narrator_zh": ""
        },
        {
            "location": "380/TALK",
            "narrator": "アーヤ",
            "text": "普通なんて\n人それぞれでしょ？",
            "zh": "什么叫一般，\n那也是因人而异吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "381/ACT",
            "narrator": "",
            "text": "本当は隠してない？",
            "zh": "你是不是其实藏着没说？",
            "narrator_zh": ""
        },
        {
            "location": "384/TALK",
            "narrator": "アーヤ",
            "text": "私はいつも\n本当の事しか\n言わないから。",
            "zh": "我向来只说\n真实的事情\n哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "386/TALK",
            "narrator": "アーヤ",
            "text": "前にも言ったけど、\n司書は本当の事だけを\n伝えるのよ。",
            "zh": "之前也说过了，\n司书只会传达\n真实的事情哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "389/TALK",
            "narrator": "アーヤ",
            "text": "貴方は知らないと思うけど\n司書は本当の事しか\n言わないの。",
            "zh": "虽然你可能不知道，\n但司书只会说\n真话的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "391/TALK",
            "narrator": "アーヤ",
            "text": "ま、そういうわけだから、\nこの話はこれでおしまい。\nね？",
            "zh": "嘛，既然如此，\n这个话题就到此为止。\n好吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "394/TALK",
            "narrator": "アーヤ",
            "text": "それじゃ今回も\nよろしくお願いね。",
            "zh": "那么这次也\n拜托你了哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "396/TALK",
            "narrator": "アーヤ",
            "text": "いつも協力してくれて\nありがとう。",
            "zh": "一直谢谢你的\n协助。",
            "narrator_zh": "绫水"
        },
        {
            "location": "397/TALK",
            "narrator": "アーヤ",
            "text": "$handle$さんと\n國政綾水にとって、\n素敵なココロの旅を！",
            "zh": "祝愿$handle$与\n国政绫水，\n拥有一段美妙的心灵之旅！",
            "narrator_zh": "绫水"
        },
        {
