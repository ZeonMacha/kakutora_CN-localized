{
    "dir": "chap10/daydra/dd_ch04_10_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "10456",
        "cid": "miyabi",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "洋菓子初心者",
        "title_zh": "Extra006 额外剧情",
        "sub_title_zh": "西点新手"
    },
    "entry": [
        {
            "location": "233/SCENARIO",
            "narrator": "",
            "text": "洋菓子初心者",
            "zh": "西点新手",
            "narrator_zh": ""
        },
        {
            "location": "246/TALK",
            "narrator": "神楽",
            "text": "――っていうことが\nあったんですよ。",
            "zh": "——就是这么\n一回事哦。",
            "narrator_zh": "神乐"
        },
        {
            "location": "248/TALK",
            "narrator": "つばめ",
            "text": "えっ、それ本当！？",
            "zh": "诶，那是真的！？",
            "narrator_zh": "燕"
        },
        {
            "location": "249/TALK",
            "narrator": "神楽",
            "text": "はい。そうだ、今度は\nつばめさんも一緒に\n行ってみませんか？",
            "zh": "是的。对了，下次\n要不要燕也\n一起去？",
            "narrator_zh": "神乐"
        },
        {
            "location": "251/TALK",
            "narrator": "つばめ",
            "text": "わぁ、楽しそう！\n絶対行くよ。",
            "zh": "哇，听起来好有趣！\n我绝对要去！",
            "narrator_zh": "燕"
        },
        {
            "location": "252/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "253/TALK",
            "narrator": "みやび",
            "text": "信じられん。",
            "zh": "真是没法相信。",
            "narrator_zh": "雅"
        },
        {
            "location": "255/TALK",
            "narrator": "つばめ",
            "text": "はい？",
            "zh": "咦？",
            "narrator_zh": "燕"
        },
        {
            "location": "257/TALK",
            "narrator": "神楽",
            "text": "ウソなんかついて\nませんよ。",
            "zh": "我可没有\n撒谎哦。",
            "narrator_zh": "神乐"
        },
        {
            "location": "260/TALK",
            "narrator": "みやび",
            "text": "そうやなくて、\n放課後にこんな洒落た\nカフェで――",
            "zh": "不是那个问题，\n放学后跑到这种\n时髦的咖啡厅——",
            "narrator_zh": "雅"
        },
        {
            "location": "261/TALK",
            "narrator": "みやび",
            "text": "うちがガールズトークに\n花咲かせちゅうことがや。",
            "zh": "我居然把女孩闲聊\n聊得热火朝天这件事啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "262/TALK",
            "narrator": "神楽",
            "text": "みやびさんは\nトークしてないじゃ\nないですか。",
            "zh": "雅根本就\n没有在聊，\n不是嘛。",
            "narrator_zh": "神乐"
        },
        {
            "location": "263/TALK",
            "narrator": "つばめ",
            "text": "さっきからずっと\nパフェを食べてます。",
            "zh": "从刚才开始就\n一直在吃芭菲。",
            "narrator_zh": "燕"
        },
        {
            "location": "265/TALK",
            "narrator": "みやび",
            "text": "そうやったか？",
            "zh": "是这样咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "267/TALK",
            "narrator": "みやび",
            "text": "まあ、ここのパフェが\n美味いのが悪い。",
            "zh": "嘛，都怪这里的\n芭菲太好吃。",
            "narrator_zh": "雅"
        },
        {
            "location": "269/TALK",
            "narrator": "みやび",
            "text": "ほれ、卯月。\nあーん…。",
            "zh": "来，卯月。\n啊——张嘴……",
            "narrator_zh": "雅"
        },
        {
            "location": "270/TALK",
            "narrator": "神楽",
            "text": "あーん…",
            "zh": "啊——…",
            "narrator_zh": "神乐"
        },
        {
            "location": "271/TALK",
            "narrator": "神楽",
            "text": "んんっ！\n甘いです！",
            "zh": "嗯嗯！\n好甜！",
            "narrator_zh": "神乐"
        },
        {
            "location": "273/TALK",
            "narrator": "みやび",
            "text": "つばめちゃんも、\nあーんしいや。",
            "zh": "燕也来一个，\n啊——张嘴咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "274/TALK",
            "narrator": "つばめ",
            "text": "あ、あーん…\n",
            "zh": "啊、啊——…\n",
            "narrator_zh": "燕"
        },
        {
            "location": "275/TALK",
            "narrator": "つばめ",
            "text": "んっ、美味しい！！",
            "zh": "嗯，好吃！！",
            "narrator_zh": "燕"
        },
        {
            "location": "277/TALK",
            "narrator": "つばめ",
            "text": "卯月さん、わたし達も\nパフェ頼もう。",
            "zh": "卯月，我们也\n点芭菲吧。",
            "narrator_zh": "燕"
        },
        {
            "location": "279/TALK",
            "narrator": "神楽",
            "text": "賛成です。",
            "zh": "赞成。",
            "narrator_zh": "神乐"
        },
        {
            "location": "281/TALK",
            "narrator": "神楽",
            "text": "あ、すみません。\n追加の注文で――",
            "zh": "啊，不好意思。\n我们要加点单——",
            "narrator_zh": "神乐"
        },
        {
            "location": "284/TALK",
            "narrator": "みやび",
            "text": "あむっ…んっ、んん…\nえいねえいね、ここの\nパフェは最高ちや。",
            "zh": "啊呜……嗯、嗯嗯……\n好好吃好好吃，这里\n的芭菲是最棒滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "285/TALK",
            "narrator": "みやび",
            "text": "シリアルが入っとらんき、\n誤魔化された気にならん\n完璧なパフェや。",
            "zh": "没塞谷物脆，\n不会让人觉得\n被糊弄，完美的芭菲咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "287/TALK",
            "narrator": "つばめ",
            "text": "でも、みやびさんだったら\nこういう洋菓子も、自分で\n作れちゃうんじゃ…。",
            "zh": "不过雅的话，这种\n西点应该也能\n自己做出来吧……",
            "narrator_zh": "燕"
        },
        {
            "location": "290/TALK",
            "narrator": "みやび",
            "text": "うち、洋菓子は\n作ったことないき、\nあんまし自信ないがよ。",
            "zh": "我西点\n从来没做过啵，\n不太有自信哦。",
            "narrator_zh": "雅"
        },
        {
            "location": "292/TALK",
            "narrator": "神楽",
            "text": "みやびさんでも\n作ったことのない\n料理ってあるんですか？",
            "zh": "雅这样的人，\n也会有没做过的菜，\n是这样吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "294/TALK",
            "narrator": "みやび",
            "text": "うちは基本、和食しか\n作らんきね。",
            "zh": "我基本上，\n只做日式菜啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "295/TALK",
            "narrator": "つばめ",
            "text": "そうだったんですか…。",
            "zh": "原来是这样啊……",
            "narrator_zh": "燕"
        },
        {
            "location": "298/TALK",
            "narrator": "みやび",
            "text": "それに、洋菓子はうちの\n好物の一つやき。",
            "zh": "再说，西点可是我\n喜欢的东西之一啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "299/TALK",
            "narrator": "みやび",
            "text": "自分で作った物より、\nプロが作った物を\n食べたいんよ。",
            "zh": "比起自己做的东西，\n我更想吃专业的\n人做的东西咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "300/SEL",
            "narrator": "",
            "text": "練習くらいはしておけば？",
            "zh": "多少先练一练不就好了？",
            "narrator_zh": ""
        },
        {
            "location": "301/SEL",
            "narrator": "",
            "text": "その気持ちわかるかも",
            "zh": "这种心情我好像能懂",
            "narrator_zh": ""
        },
        {
            "location": "303/TALK",
            "narrator": "神楽",
            "text": "みやびさんだって\nプロ級の腕を持ってる\nじゃないですか。",
            "zh": "雅明明就\n有一手专业级的\n本领，不是嘛。",
            "narrator_zh": "神乐"
        },
        {
            "location": "305/TALK",
            "narrator": "みやび",
            "text": "和食は作り慣れちょるき、\nあんだけできるがよ。",
            "zh": "日式菜做惯了啵，\n才做得到那种程度哦。",
            "narrator_zh": "雅"
        },
        {
            "location": "310/TALK",
            "narrator": "みやび",
            "text": "けんど、ケーキは美味しく\n作れるかわからんちや。",
            "zh": "但是，蛋糕能不能\n做得好吃，就不懂了滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "311/TALK",
            "narrator": "みやび",
            "text": "失敗して、ガッカリな\n結果になるんも嫌ながよ。",
            "zh": "要是失败，落得个\n扫兴的结果，也讨厌哦。",
            "narrator_zh": "雅"
        },
        {
            "location": "313/TALK",
            "narrator": "つばめ",
            "text": "そうですか…。",
            "zh": "这样啊……",
            "narrator_zh": "燕"
        },
        {
            "location": "315/TALK",
            "narrator": "つばめ",
            "text": "みやびさんの作った\nケーキ、食べてみた\nかったなぁ…。",
            "zh": "雅做的蛋糕，\n本来还想\n尝一尝的……",
            "narrator_zh": "燕"
        },
        {
            "location": "317/ACT",
            "narrator": "",
            "text": "練習くらいはしておけば？",
            "zh": "多少先练一练不就好了？",
            "narrator_zh": ""
        },
        {
            "location": "332/TALK",
            "narrator": "みやび",
            "text": "相棒はそう思うがか？",
            "zh": "搭档是这么想的咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "333/TALK",
            "narrator": "みやび",
            "text": "ん～…まあ、作れるようになっておくんは、悪くない考えやけんど",
            "zh": "嗯～…嘛，学会做这件事，不是个坏主意，但是",
            "narrator_zh": "雅"
        },
        {
            "location": "340/TALK",
            "narrator": "みやび",
            "text": "…自分で作る練習は、\nやっぱし不安があるなぁ。",
            "zh": "……自己动手练，\n果然还是有点没底啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "342/TALK",
            "narrator": "神楽",
            "text": "そんなに自信ないん\nですか？",
            "zh": "有那么\n没自信吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "345/TALK",
            "narrator": "みやび",
            "text": "いや、レシピ見ながら\nやるき――",
            "zh": "不，照着食谱\n做的话——",
            "narrator_zh": "雅"
        },
        {
            "location": "346/TALK",
            "narrator": "みやび",
            "text": "失敗せん限りは、\n不味いもんはできんと\n思うがよ。",
            "zh": "只要不失败，\n就不至于做出\n难吃的东西哦。",
            "narrator_zh": "雅"
        },
        {
            "location": "348/TALK",
            "narrator": "みやび",
            "text": "けんど、予想より美味く\n出来た時のことを思うと\n不安ちや。",
            "zh": "但是，一想到做出来\n比预想还好吃时的\n情形，就不安滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "350/TALK",
            "narrator": "つばめ",
            "text": "…どうしてですか？",
            "zh": "……为什么呢？",
            "narrator_zh": "燕"
        },
        {
            "location": "352/TALK",
            "narrator": "みやび",
            "text": "作り過ぎて、太ってしまう\n可能性があるがよ。",
            "zh": "做多了的话，\n有长胖的可能性哦。",
            "narrator_zh": "雅"
        },
        {
            "location": "355/TALK",
            "narrator": "神楽",
            "text": "…凄くありそうですね。",
            "zh": "……感觉太有可能了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "356/TALK",
            "narrator": "つばめ",
            "text": "みやびさん、絶対に\n美味しいケーキ作るもん。",
            "zh": "雅绝对\n会做出好吃的蛋糕的。",
            "narrator_zh": "燕"
        },
        {
            "location": "358/TALK",
            "narrator": "みやび",
            "text": "うち、あんまし運動とか\nせんき、そんなことしたら\n間違いなく太るきね。",
            "zh": "我平时就不怎么运动，\n真那样的话，\n铁定要胖的啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "359/TALK",
            "narrator": "みやび",
            "text": "そういうこともあって、\n洋菓子は自分で作らん\nようにしてるちや。",
            "zh": "也是因为这个，\n西点我都刻意\n不自己做滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "361/TALK",
            "narrator": "つばめ",
            "text": "…わたしも、ケーキは\n作らないようにしよう。",
            "zh": "……我也决定\n不去做蛋糕好了。",
            "narrator_zh": "燕"
        },
        {
            "location": "363/TALK",
            "narrator": "つばめ",
            "text": "美味しいのができたら、\nみやびさんが言った\nみたいになりそうだし…。",
            "zh": "万一做得很好吃，\n就会变得跟雅说的\n那样了……",
            "narrator_zh": "燕"
        },
        {
            "location": "366/TALK",
            "narrator": "神楽",
            "text": "そうですね。\n私も同じです。",
            "zh": "是啊。\n我也一样。",
            "narrator_zh": "神乐"
        },
        {
            "location": "384/ACT",
            "narrator": "",
            "text": "その気持ちわかるかも",
            "zh": "这种心情我好像能懂",
            "narrator_zh": ""
        },
        {
            "location": "398/TALK",
            "narrator": "みやび",
            "text": "さすがは相棒、わかっちゅうね",
            "zh": "不愧是搭档，就是懂咯",
            "narrator_zh": "雅"
        },
        {
            "location": "399/TALK",
            "narrator": "みやび",
            "text": "じゃあ、うちの代わりに、うちが食べるケーキ作ってくれるか？",
            "zh": "那要不，代替我把我要吃的蛋糕做出来咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "401/SEL",
            "narrator": "",
            "text": "え！？",
            "zh": "诶！？",
            "narrator_zh": ""
        },
        {
            "location": "402/ACT",
            "narrator": "",
            "text": "え！？",
            "zh": "诶！？",
            "narrator_zh": ""
        },
        {
            "location": "404/TALK",
            "narrator": "みやび",
            "text": "冗談やき、驚かせてすまん",
            "zh": "开玩笑的啵，吓到你，没好意思",
            "narrator_zh": "雅"
        },
        {
            "location": "412/TALK",
            "narrator": "ウェイトレス",
            "text": "お待たせいたしました。\nフルーツパフェ\n二点になります。",
            "zh": "让您久等了。\n水果芭菲\n两份。",
            "narrator_zh": "女服务员"
        },
        {
            "location": "414/TALK",
            "narrator": "神楽",
            "text": "あ、どうも。",
            "zh": "啊，谢谢。",
            "narrator_zh": "神乐"
        },
        {
            "location": "415/TALK",
            "narrator": "ウェイトレス",
            "text": "ごゆっくりどうぞ。",
            "zh": "请慢用。",
            "narrator_zh": "女服务员"
        },
        {
            "location": "421/TALK",
            "narrator": "つばめ",
            "text": "わぁ、来た来た！",
            "zh": "哇，来了来了！",
            "narrator_zh": "燕"
        },
        {
            "location": "423/TALK",
            "narrator": "神楽",
            "text": "ふふっ…まあ、近所に\nこういう美味しい\nお店があれば――",
            "zh": "呵呵……嘛，只要\n附近有这种\n好吃的店——",
            "narrator_zh": "神乐"
        },
        {
            "location": "424/TALK",
            "narrator": "神楽",
            "text": "自分で作らなくても\n困らないですしね。",
            "zh": "就算自己不做\n也不用发愁呢。",
            "narrator_zh": "神乐"
        },
        {
            "location": "426/TALK",
            "narrator": "つばめ",
            "text": "だね。",
            "zh": "对呢。",
            "narrator_zh": "燕"
        },
        {
            "location": "428/TALK",
            "narrator": "つばめ",
            "text": "はい、みやびさん。\nあーん。",
            "zh": "来，雅。\n啊——张嘴。",
            "narrator_zh": "燕"
        },
        {
            "location": "430/TALK",
            "narrator": "みやび",
            "text": "は？",
            "zh": "哈？",
            "narrator_zh": "雅"
        },
        {
            "location": "432/TALK",
            "narrator": "神楽",
            "text": "さっき一口くれた\nお礼です。\nあーん…。",
            "zh": "这是刚才那一口的\n回礼。\n啊——张嘴……",
            "narrator_zh": "神乐"
        },
        {
            "location": "436/TALK",
            "narrator": "みやび",
            "text": "…いや、うちはえいき。\n気持ちだけもらうちや。",
            "zh": "……不，我就好咯。\n心意我领了滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "437/TALK",
            "narrator": "つばめ",
            "text": "でも、貰ったらお返し\nしないと…ね？",
            "zh": "可是，收了礼就要\n回礼才行……对吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "438/TALK",
            "narrator": "神楽",
            "text": "そうですよ。\n早く食べてくれないと、\nパフェが溶けちゃいます。",
            "zh": "就是哦。\n你不快点吃的话，\n芭菲要化掉了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "439/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "442/TALK",
            "narrator": "みやび",
            "text": "あーん…んむっ…。",
            "zh": "啊——张嘴……嗯唔……",
            "narrator_zh": "雅"
        },
        {
            "location": "444/TALK",
            "narrator": "神楽",
            "text": "さ、次はこっちです。",
            "zh": "来，下一口是这边。",
            "narrator_zh": "神乐"
        },
        {
            "location": "446/TALK",
            "narrator": "みやび",
            "text": "…あーん…あむっ…。",
            "zh": "……啊——张嘴……啊呜……",
