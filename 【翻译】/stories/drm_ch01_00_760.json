  "sub_title": "父、さらに父"
 },
 "entry": [
  {
   "location": "7/SCENARIO",
   "narrator": "",
   "text": "父、さらに父"
  },
  {
   "location": "17/TALK",
   "narrator": "啓介",
   "text": "つばめの父だ",
   "zh": "是燕的父亲。",
   "narrator_zh": "启介"
  },
  {
   "location": "18/TALK",
   "narrator": "啓介",
   "text": "娘から聞いたことがあるかもしれない"
  },
  {
   "location": "19/TALK",
   "narrator": "啓介",
   "text": "言っておきたいことがある"
  },
  {
   "location": "21/SEL",
   "narrator": "",
   "text": "こんばんは",
   "zh": "晚上好",
   "narrator_zh": ""
  },
  {
   "location": "22/SEL",
   "narrator": "",
   "text": "ご無沙汰してます",
   "zh": "好久不见",
   "narrator_zh": ""
  },
  {
   "location": "23/SEL",
   "narrator": "",
   "text": "ぜひ聞かせてください",
   "zh": "请务必讲给我听",
   "narrator_zh": ""
  },
  {
   "location": "24/ACT",
   "narrator": "",
   "text": "こんばんは",
   "zh": "晚上好",
   "narrator_zh": ""
  },
  {
   "location": "26/TALK",
   "narrator": "啓介",
   "text": "おっと",
   "zh": "哎哟",
   "narrator_zh": "启介"
  },
  {
   "location": "27/TALK",
   "narrator": "啓介",
   "text": "こんばんは",
   "zh": "晚上好",
   "narrator_zh": "启介"
  },
  {
   "location": "28/ACT",
   "narrator": "",
   "text": "ご無沙汰してます",
   "zh": "好久不见",
   "narrator_zh": ""
  },
  {
   "location": "30/TALK",
   "narrator": "啓介",
   "text": "いや",
   "zh": "不对",
   "narrator_zh": "启介"
  },
  {
   "location": "31/TALK",
   "narrator": "啓介",
   "text": "そこまででもない",
   "zh": "也不至于到那地步",
   "narrator_zh": "启介"
  },
  {
   "location": "32/ACT",
   "narrator": "",
   "text": "ぜひ聞かせてください",
   "zh": "请务必讲给我听",
   "narrator_zh": ""
  },
  {
   "location": "43/TALK",
   "narrator": "啓介",
   "text": "うむ",
   "zh": "嗯",
   "narrator_zh": "启介"
  },
  {
   "location": "44/TALK",
   "narrator": "啓介",
   "text": "いい返事だ"
  },
  {
   "location": "47/TALK",
   "narrator": "啓介",
   "text": "つばめは体が弱くてずっと入院していた",
   "zh": "燕身体弱，一直在住院",
   "narrator_zh": "启介"
  },
  {
   "location": "48/TALK",
   "narrator": "啓介",
   "text": "私もなかなか手が回らなくて"
  },
  {
   "location": "49/TALK",
   "narrator": "啓介",
   "text": "さみしい思いもさせてしまった"
  },
  {
   "location": "50/SEL",
   "narrator": "",
   "text": "はい",
   "zh": "是",
   "narrator_zh": ""
  },
  {
   "location": "51/SEL",
   "narrator": "",
   "text": "ご苦労されたんですね",
   "zh": "你真是受苦了",
   "narrator_zh": ""
  },
  {
   "location": "52/SEL",
   "narrator": "",
   "text": "娘さんはお父さんのことが好きですよ",
   "zh": "令爱是喜欢爸爸的哦",
   "narrator_zh": ""
  },
  {
   "location": "53/ACT",
   "narrator": "",
   "text": "はい",
   "zh": "是",
   "narrator_zh": ""
  },
  {
   "location": "54/TALK",
   "narrator": "啓介",
   "text": "知ってるな"
  },
  {
   "location": "55/ACT",
   "narrator": "",
   "text": "ご苦労されたんですね",
   "zh": "你真是受苦了",
   "narrator_zh": ""
  },
  {
   "location": "56/TALK",
   "narrator": "啓介",
   "text": "苦労をしたのは"
  },
  {
   "location": "57/TALK",
   "narrator": "啓介",
   "text": "つばめの方だ",
   "zh": "是燕。",
   "narrator_zh": "启介"
  },
  {
   "location": "58/ACT",
   "narrator": "",
   "text": "娘さんはお父さんのことが好きですよ",
   "zh": "令爱是喜欢爸爸的哦",
   "narrator_zh": ""
  },
  {
   "location": "69/TALK",
   "narrator": "啓介",
   "text": "そんなことは",
   "zh": "那种事",
   "narrator_zh": "启介"
  },
  {
   "location": "70/TALK",
   "narrator": "啓介",
   "text": "知っている"
  },
  {
   "location": "72/TALK",
   "narrator": "啓介",
   "text": "君に改めて言われることではない"
  },
  {
   "location": "74/TALK",
   "narrator": "啓介",
   "text": "だからこれ以上の苦労をつばめにさせたくはない",
   "zh": "所以我不想再让燕吃更多苦",
   "narrator_zh": "启介"
  },
  {
   "location": "75/TALK",
   "narrator": "啓介",
   "text": "そう思っていた",
   "zh": "我是这么想的",
   "narrator_zh": "启介"
  },
  {
   "location": "76/TALK",
   "narrator": "啓介",
   "text": "しかし君と話せなくなったつばめは落ち込んでしまった"
  },
  {
   "location": "77/TALK",
   "narrator": "啓介",
   "text": "だからだ",
   "zh": "所以就是这样",
   "narrator_zh": "启介"
  },
  {
   "location": "78/TALK",
   "narrator": "啓介",
   "text": "仕方ないが君と話すことを許す"
  },
  {
   "location": "79/TALK",
   "narrator": "啓介",
   "text": "仕方なくだ"
  },
  {
   "location": "80/SEL",
   "narrator": "",
   "text": "ありがとうございます",
   "zh": "谢谢",
   "narrator_zh": ""
  },
  {
   "location": "81/SEL",
   "narrator": "",
   "text": "$me$もつばめのことが大事です",
   "zh": "$me$也很看重燕",
   "narrator_zh": ""
  },
  {
   "location": "82/SEL",
   "narrator": "",
   "text": "意外とツンデレなんですね",
   "zh": "意外地还挺傲娇的呢",
   "narrator_zh": ""
  },
  {
   "location": "83/ACT",
   "narrator": "",
   "text": "ありがとうございます",
   "zh": "谢谢",
   "narrator_zh": ""
  },
  {
   "location": "84/TALK",
   "narrator": "啓介",
   "text": "うむ",
   "zh": "嗯",
   "narrator_zh": "启介"
  },
  {
   "location": "85/ACT",
   "narrator": "",
   "text": "$me$もつばめのことが大事です",
   "zh": "$me$也很看重燕",
   "narrator_zh": ""
  },
  {
   "location": "86/TALK",
   "narrator": "啓介",
   "text": "そうだろう",
   "zh": "就是这样",
   "narrator_zh": "启介"
  },
  {
   "location": "87/ACT",
   "narrator": "",
   "text": "意外とツンデレなんですね",
   "zh": "意外地还挺傲娇的呢",
   "narrator_zh": ""
  },
  {
   "location": "90/TALK",
   "narrator": "啓介",
   "text": "大人をからかうな"
  },
