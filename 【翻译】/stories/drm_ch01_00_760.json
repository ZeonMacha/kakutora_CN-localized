    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "父、さらに父",
            "zh": "父亲，更是父亲",
            "narrator_zh": ""
        },
        {
            "location": "17/TALK",
            "narrator": "啓介",
            "text": "つばめの父だ",
            "zh": "是燕的父亲。",
            "narrator_zh": "启介"
        },
        {
            "location": "18/TALK",
            "narrator": "啓介",
            "text": "娘から聞いたことがあるかもしれない",
            "zh": "你或许从我女儿那儿听说过",
            "narrator_zh": "启介"
        },
        {
            "location": "19/TALK",
            "narrator": "啓介",
            "text": "言っておきたいことがある",
            "zh": "有件事我得提前跟你说清楚",
            "narrator_zh": "启介"
        },
        {
            "location": "21/SEL",
            "narrator": "",
            "text": "こんばんは",
            "zh": "晚上好",
            "narrator_zh": ""
        },
        {
            "location": "22/SEL",
            "narrator": "",
            "text": "ご無沙汰してます",
            "zh": "好久不见",
            "narrator_zh": ""
        },
        {
            "location": "23/SEL",
            "narrator": "",
            "text": "ぜひ聞かせてください",
            "zh": "请务必讲给我听",
            "narrator_zh": ""
        },
        {
            "location": "24/ACT",
            "narrator": "",
            "text": "こんばんは",
            "zh": "晚上好",
            "narrator_zh": ""
        },
        {
            "location": "26/TALK",
            "narrator": "啓介",
            "text": "おっと",
            "zh": "哎哟",
            "narrator_zh": "启介"
        },
        {
            "location": "27/TALK",
            "narrator": "啓介",
            "text": "こんばんは",
            "zh": "晚上好",
            "narrator_zh": "启介"
        },
        {
            "location": "28/ACT",
            "narrator": "",
            "text": "ご無沙汰してます",
            "zh": "好久不见",
            "narrator_zh": ""
        },
        {
            "location": "30/TALK",
            "narrator": "啓介",
            "text": "いや",
            "zh": "不对",
            "narrator_zh": "启介"
        },
        {
            "location": "31/TALK",
            "narrator": "啓介",
            "text": "そこまででもない",
            "zh": "也不至于到那地步",
            "narrator_zh": "启介"
        },
        {
            "location": "32/ACT",
            "narrator": "",
            "text": "ぜひ聞かせてください",
            "zh": "请务必讲给我听",
            "narrator_zh": ""
        },
        {
            "location": "43/TALK",
            "narrator": "啓介",
            "text": "うむ",
            "zh": "嗯",
            "narrator_zh": "启介"
        },
        {
            "location": "44/TALK",
            "narrator": "啓介",
            "text": "いい返事だ",
            "zh": "回答得不错",
            "narrator_zh": "启介"
        },
        {
            "location": "47/TALK",
            "narrator": "啓介",
            "text": "つばめは体が弱くてずっと入院していた",
            "zh": "燕身体弱，一直在住院",
            "narrator_zh": "启介"
        },
        {
            "location": "48/TALK",
            "narrator": "啓介",
            "text": "私もなかなか手が回らなくて",
            "zh": "我也经常分身乏术",
            "narrator_zh": "启介"
        },
        {
            "location": "49/TALK",
            "narrator": "啓介",
            "text": "さみしい思いもさせてしまった",
            "zh": "让她感到寂寞了",
            "narrator_zh": "启介"
        },
        {
            "location": "50/SEL",
            "narrator": "",
            "text": "はい",
            "zh": "是",
            "narrator_zh": ""
        },
        {
            "location": "51/SEL",
            "narrator": "",
            "text": "ご苦労されたんですね",
            "zh": "你真是受苦了",
            "narrator_zh": ""
        },
        {
            "location": "52/SEL",
            "narrator": "",
            "text": "娘さんはお父さんのことが好きですよ",
            "zh": "令爱是喜欢爸爸的哦",
            "narrator_zh": ""
        },
        {
            "location": "53/ACT",
            "narrator": "",
            "text": "はい",
            "zh": "是",
            "narrator_zh": ""
        },
        {
            "location": "54/TALK",
            "narrator": "啓介",
            "text": "知ってるな",
            "zh": "我知道",
            "narrator_zh": "启介"
        },
        {
            "location": "55/ACT",
            "narrator": "",
            "text": "ご苦労されたんですね",
            "zh": "你真是受苦了",
            "narrator_zh": ""
        },
        {
            "location": "56/TALK",
            "narrator": "啓介",
            "text": "苦労をしたのは",
            "zh": "真正受苦的",
            "narrator_zh": "启介"
        },
        {
            "location": "57/TALK",
            "narrator": "啓介",
            "text": "つばめの方だ",
            "zh": "是燕。",
            "narrator_zh": "启介"
        },
        {
            "location": "58/ACT",
            "narrator": "",
            "text": "娘さんはお父さんのことが好きですよ",
            "zh": "令爱是喜欢爸爸的哦",
            "narrator_zh": ""
        },
        {
            "location": "69/TALK",
            "narrator": "啓介",
            "text": "そんなことは",
            "zh": "那种事",
            "narrator_zh": "启介"
        },
        {
            "location": "70/TALK",
            "narrator": "啓介",
            "text": "知っている",
            "zh": "我知道",
            "narrator_zh": "启介"
        },
        {
            "location": "72/TALK",
            "narrator": "啓介",
            "text": "君に改めて言われることではない",
            "zh": "用不着你特意提醒我",
            "narrator_zh": "启介"
        },
        {
            "location": "74/TALK",
            "narrator": "啓介",
            "text": "だからこれ以上の苦労をつばめにさせたくはない",
            "zh": "所以我不想再让燕吃更多苦",
            "narrator_zh": "启介"
        },
        {
            "location": "75/TALK",
            "narrator": "啓介",
            "text": "そう思っていた",
            "zh": "我是这么想的",
            "narrator_zh": "启介"
        },
        {
            "location": "76/TALK",
            "narrator": "啓介",
            "text": "しかし君と話せなくなったつばめは落ち込んでしまった",
            "zh": "但是不能和你说话之后，燕消沉了下去",
            "narrator_zh": "启介"
        },
        {
            "location": "77/TALK",
            "narrator": "啓介",
            "text": "だからだ",
            "zh": "所以就是这样",
            "narrator_zh": "启介"
        },
        {
            "location": "78/TALK",
            "narrator": "啓介",
            "text": "仕方ないが君と話すことを許す",
            "zh": "没办法，我允许你和她说话",
            "narrator_zh": "启介"
        },
        {
            "location": "79/TALK",
            "narrator": "啓介",
            "text": "仕方なくだ",
            "zh": "只是不得已而已",
            "narrator_zh": "启介"
        },
        {
            "location": "80/SEL",
            "narrator": "",
            "text": "ありがとうございます",
            "zh": "谢谢",
            "narrator_zh": ""
        },
        {
            "location": "81/SEL",
            "narrator": "",
            "text": "$me$もつばめのことが大事です",
