            "narrator_zh": "绫水"
        },
        {
            "location": "460/TALK",
            "narrator": "アーヤ",
            "text": "そういうのよ",
            "zh": "就是那种说法啊",
            "narrator_zh": "绫水"
        },
        {
            "location": "461/ACT",
            "narrator": "",
            "text": "お互い気をつけたいよね",
            "zh": "彼此都想多注意呢",
            "narrator_zh": ""
