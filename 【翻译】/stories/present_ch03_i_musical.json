            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "97/TALK",
            "narrator": "ガブリエラ",
            "text": "ありがとう、凄く見たかったのよ！",
            "zh": "谢谢你，我特别想看的哦！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "100/SEL",
            "narrator": "",
            "text": "喜んでもらえて嬉しいよ",
            "zh": "你能喜欢我也很高兴",
