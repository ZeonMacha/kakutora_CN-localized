            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "106/TALK",
            "narrator": "ガブリエラ",
            "text": "バイトのシフトが入ってる日だわ",
            "zh": "正好是排了打工班次的日子",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "107/TALK",
            "narrator": "ガブリエラ",
            "text": "もしかしたら、行けないかも",
            "zh": "搞不好去不成了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "110/SEL",
            "narrator": "",
            "text": "変わってもらえば？",
            "zh": "找人换个班不就好了？",
            "narrator_zh": ""
        },
        {
            "location": "111/ACT",
            "narrator": "",
            "text": "変わってもらえば？",
            "zh": "找人换个班不就好了？",
            "narrator_zh": ""
        },
        {
            "location": "114/TALK",
            "narrator": "ガブリエラ",
            "text": "それしかないわね",
            "zh": "也只好这样了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "115/TALK",
            "narrator": "ガブリエラ",
            "text": "私も、クラスの子達みたいに",
            "zh": "我也想像班上的同学那样",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "116/TALK",
            "narrator": "ガブリエラ",
            "text": "バイトなんかしないで、好きなことできる時間が",
            "zh": "不用打工、能把时间花在喜欢的事上",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "117/TALK",
            "narrator": "ガブリエラ",
            "text": "せめてもう少しだけ欲しいわ",
