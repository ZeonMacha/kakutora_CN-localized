        },
        {
            "location": "101/ACT",
            "narrator": "",
            "text": "喜んでもらえて嬉しいよ",
            "zh": "你能喜欢我也很高兴",
            "narrator_zh": ""
        },
        {
            "location": "104/TALK",
            "narrator": "ガブリエラ",
            "text": "あっ",
            "zh": "啊",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "105/TALK",
            "narrator": "ガブリエラ",
            "text": "でもこのチケットの指定日",
