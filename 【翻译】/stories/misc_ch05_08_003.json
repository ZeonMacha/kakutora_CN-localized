        {
            "location": "1677/TALK",
            "narrator": "神楽",
            "text": "あーもー電車とか乗りたくないー！",
            "zh": "啊——真是的，电车什么的我不想坐——！",
            "narrator_zh": "神乐"
        },
        {
            "location": "1679/SEL",
            "narrator": "",
            "text": "神楽はリムジンじゃないの？",
            "zh": "神乐不是有豪华轿车吗？",
            "narrator_zh": ""
        },
        {
            "location": "1680/SEL",
            "narrator": "",
            "text": "もしかして痴漢……？",
            "zh": "难道是色狼……？",
            "narrator_zh": ""
        },
        {
            "location": "1681/SEL",
            "narrator": "",
            "text": "移動自体が面倒くさいよねー",
            "zh": "移动本身就麻烦吧——",
            "narrator_zh": ""
        },
        {
            "location": "1682/ACT",
            "narrator": "",
            "text": "神楽はリムジンじゃないの？",
            "zh": "神乐不是有豪华轿车吗？",
            "narrator_zh": ""
        },
        {
            "location": "1684/TALK",
            "narrator": "神楽",
            "text": "まあそうなんだけどね！",
            "zh": "嘛，是这样没错！",
            "narrator_zh": "神乐"
        },
        {
            "location": "1685/TALK",
            "narrator": "神楽",
            "text": "って",
            "zh": "等等",
            "narrator_zh": "神乐"
        },
        {
            "location": "1686/TALK",
            "narrator": "神楽",
            "text": "そんなだったら電車乗らないしー",
            "zh": "那样的话我就不坐电车了——",
            "narrator_zh": "神乐"
        },
        {
            "location": "1687/ACT",
            "narrator": "",
            "text": "もしかして痴漢……？",
            "zh": "难道是色狼……？",
            "narrator_zh": ""
        },
        {
            "location": "1688/TALK",
            "narrator": "神楽",
            "text": "迷惑行為はやめて欲しいですね、、、",
            "zh": "麻烦行为还是希望不要有……",
            "narrator_zh": "神乐"
        },
        {
            "location": "1689/ACT",
            "narrator": "",
            "text": "移動自体が面倒くさいよねー",
            "zh": "移动本身就麻烦吧——",
            "narrator_zh": ""
        },
        {
            "location": "1690/TALK",
            "narrator": "神楽",
            "text": "それはある",
            "zh": "这倒是",
            "narrator_zh": "神乐"
        },
        {
            "location": "1692/TALK",
            "narrator": "神楽",
            "text": "ほんとある",
            "zh": "真的有",
            "narrator_zh": "神乐"
        },
        {
            "location": "1694/TALK",
            "narrator": "神楽",
            "text": "特に雨の日の電車嫌すぎて暴れ出すレベル",
            "zh": "特别是下雨天的电车，讨厌到想闹起来",
            "narrator_zh": "神乐"
        },
        {
            "location": "1696/SEL",
            "narrator": "",
            "text": "落ち着いて",
            "zh": "冷静点",
            "narrator_zh": ""
        },
        {
            "location": "1697/SEL",
            "narrator": "",
            "text": "雨の日は外出をやめよう",
            "zh": "下雨天就别出门了",
            "narrator_zh": ""
        },
        {
            "location": "1698/SEL",
            "narrator": "",
            "text": "神楽のために貸切にするから！",
            "zh": "为了神乐我包场！",
            "narrator_zh": ""
        },
        {
            "location": "1699/ACT",
            "narrator": "",
            "text": "落ち着いて",
            "zh": "冷静点",
            "narrator_zh": ""
        },
        {
            "location": "1700/TALK",
            "narrator": "神楽",
            "text": "落ち着いてないのかな？",
            "zh": "我没冷静吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "1701/ACT",
            "narrator": "",
            "text": "雨の日は外出をやめよう",
            "zh": "下雨天就别出门了",
            "narrator_zh": ""
        },
        {
            "location": "1702/TALK",
            "narrator": "神楽",
            "text": "ダヨネー",
            "zh": "就是说啊——",
            "narrator_zh": "神乐"
        },
        {
            "location": "1703/TALK",
            "narrator": "神楽",
            "text": "それができたらどんなにいいか",
            "zh": "要是能做到，该有多好",
            "narrator_zh": "神乐"
        },
        {
            "location": "1704/ACT",
            "narrator": "",
            "text": "神楽のために貸切にするから！",
            "zh": "为了神乐我包场！",
            "narrator_zh": ""
        },
        {
            "location": "1706/TALK",
            "narrator": "神楽",
            "text": "やだ素敵",
            "zh": "讨厌，好棒",
            "narrator_zh": "神乐"
        },
        {
            "location": "1708/TALK",
            "narrator": "神楽",
            "text": "それｲｲﾈ！",
            "zh": "这个不错！",
            "narrator_zh": "神乐"
        },
        {
            "location": "1709/TALK",
            "narrator": "神楽",
            "text": "楽しみにしてるね♪",
            "zh": "我很期待哦♪",
            "narrator_zh": "神乐"
        },
        {
            "location": "1711/TALK",
            "narrator": "神楽",
            "text": "混んでなくてボックス席とかで移動じゃなくて旅行だったら全然いいんだけどね電車",
            "zh": "电车要是不挤、是包厢座位、不是赶路而是旅行，那完全没问题",
            "narrator_zh": "神乐"
        },
        {
            "location": "1712/TALK",
            "narrator": "神楽",
            "text": "移動のための電車で雨降りはちょっと辛いかなって",
            "zh": "为了赶路的电车再碰上雨，就有点难受了",
            "narrator_zh": "神乐"
        },
        {
            "location": "1713/TALK",
            "narrator": "神楽",
            "text": "なんてね",
            "zh": "开玩笑的",
            "narrator_zh": "神乐"
        },
        {
            "location": "1714/TALK",
            "narrator": "神楽",
            "text": "騒いだら気が済んだ",
            "zh": "闹一闹，心情就顺了",
            "narrator_zh": "神乐"
        },
        {
            "location": "1716/TALK",
