{
    "dir": "dramatics/daydra/drm_ch03_00_070.js",
    "type": "Episode",
    "info": {
        "story_id": "3007",
        "cid": "gabriella",
        "title": "らぶとーく  第07話",
        "sub_title": "みんなおかしくない？",
        "title_zh": "恋爱漫谈 第07话",
        "sub_title_zh": "大家不觉得奇怪吗？"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "みんなおかしくない？",
            "zh": "大家不觉得奇怪吗？"
        },
        {
            "location": "21/TALK",
            "narrator": "アーヤ",
            "text": "――というわけなの。",
            "zh": "——就是这么回事。",
            "narrator_zh": "绫水"
        },
        {
            "location": "24/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょ、待ってよ！\n何言い出すのよ急に！？",
            "zh": "等、等一下！\n突然说什么！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "25/TALK",
            "narrator": "ガブリエラ",
            "text": "マルザ…",
            "zh": "玛尔赞……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "26/TALK",
            "narrator": "ガブリエラ",
            "text": "Ｂｏｔの正体が人間って…\n意味わからないんだけど？",
            "zh": "Bot的真身是人类……\n这意思我可不懂。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "28/TALK",
            "narrator": "アーヤ",
            "text": "あくまで\n可能性の話でしか\nないけど。",
            "zh": "说到底，\n也只是\n可能性。",
            "narrator_zh": "绫水"
        },
        {
            "location": "29/TALK",
            "narrator": "アーヤ",
            "text": "私達がＢｏｔだと思ってる\nあれは。",
            "zh": "我们以为是Bot的\n那个。",
            "narrator_zh": "绫水"
        },
        {
            "location": "30/TALK",
            "narrator": "アーヤ",
            "text": "人間が、Ｂｏｔのフリを\nしているだけって\n可能性が高いの。",
            "zh": "很有可能，\n只是人类在装成\nBot。",
            "narrator_zh": "绫水"
        },
        {
            "location": "32/TALK",
            "narrator": "つばめ",
            "text": "そっか…$handle$、\n本当は人間だったん\nですね。",
            "zh": "这样呀……$handle$，\n原来真的\n是人类。",
            "narrator_zh": "燕"
        },
        {
            "location": "34/TALK",
            "narrator": "ガブリエラ",
            "text": "いや、何落ち着いて\n言ってんのよ！",
            "zh": "不对，你怎么\n这么平静地说！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "35/TALK",
            "narrator": "ガブリエラ",
            "text": "なんで納得\nできるの？\n意味わかんない！",
            "zh": "为什么能\n接受？\n完全不懂！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "37/TALK",
            "narrator": "つばめ",
            "text": "う、うん…。\nビックリはしたよ。",
            "zh": "嗯、嗯……\n我是吓了一跳。",
            "narrator_zh": "燕"
        },
        {
            "location": "40/TALK",
            "narrator": "つばめ",
            "text": "でも、人間だったら\n良いのになぁ、って\n思ってたから――",
            "zh": "可是，我一直希望\n要是人类\n就好了——",
            "narrator_zh": "燕"
        },
        {
            "location": "41/TALK",
            "narrator": "つばめ",
            "text": "今はちょっとだけ\n嬉しいの。",
            "zh": "现在有一点点\n高兴。",
            "narrator_zh": "燕"
        },
        {
            "location": "43/TALK",
            "narrator": "みやび",
            "text": "つばめちゃんは、\n状況適応力が凄過ぎや。",
            "zh": "燕适应状况的能力，\n强得过头咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "45/TALK",
            "narrator": "ガブリエラ",
            "text": "何も考えて\nないだけでしょ！？",
            "zh": "只是什么都\n没想吧！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "47/TALK",
            "narrator": "みやび",
            "text": "まあ、うちはなんとなく\n気付いてたきね。",
            "zh": "嘛，我是隐约\n察觉到了啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "48/TALK",
            "narrator": "みやび",
            "text": "それが確信に変わった\nだけのことや。",
            "zh": "不过是\n变成确信了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "49/TALK",
            "narrator": "ガブリエラ",
            "text": "みやびも\nＢｏｔが人間だって\n言うわけ？",
            "zh": "雅也要说\nBot是人类\n吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "52/TALK",
            "narrator": "アーヤ",
            "text": "そんなこと\n考えたくない、って\n気持ちはわかるわ。",
            "zh": "不想去想\n这种事，\n这种心情我懂。",
            "narrator_zh": "绫水"
        },
        {
            "location": "53/TALK",
            "narrator": "アーヤ",
            "text": "だけど、これは\nかなり確率の高い\n話なの。",
            "zh": "可是，这是\n概率相当高的\n说法。",
            "narrator_zh": "绫水"
        },
        {
            "location": "54/TALK",
            "narrator": "アーヤ",
            "text": "だからみんな\n話す内容には\n気をつけて。",
            "zh": "所以大家\n说话的内容\n要注意。",
            "narrator_zh": "绫水"
        },
        {
            "location": "57/TALK",
            "narrator": "つばめ",
            "text": "っていうか、人間か\nどうかって、そんなに\n重要なことですか？",
            "zh": "话说，是不是人类，\n有那么\n重要吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "59/TALK",
            "narrator": "みやび",
            "text": "そりゃまあ…人間やと\nしたら、Ｂｏｔやと思うて\n話してた会話が――",
            "zh": "这个嘛……假如是人，\n那些当成Bot\n讲过的话——",
            "narrator_zh": "雅"
        },
        {
            "location": "60/TALK",
            "narrator": "みやび",
            "text": "全部誰かに話したゆう\nことになるんやし。",
            "zh": "就等于全部\n讲给某个人听了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "63/TALK",
            "narrator": "ガブリエラ",
            "text": "！？",
            "zh": "！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "64/TALK",
            "narrator": "アーヤ",
            "text": "それなのよね…。\nまあ、誰かにバラすような\nことはなさそうだけど…。",
            "zh": "就是这点……\n不过，不像会向谁\n去泄露的样子……",
            "narrator_zh": "绫水"
        },
        {
            "location": "66/TALK",
            "narrator": "ガブリエラ",
            "text": "いい加減にしてよ！",
            "zh": "给我适可而止！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "67/TALK",
            "narrator": "ガブリエラ",
            "text": "Ｂｏｔが人間とか、\n笑えない冗談にも\n程があるわ。",
            "zh": "Bot是人类这种，\n不好笑的玩笑\n也该有个限度。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "68/SEL",
            "narrator": "",
            "text": "ちゃんと聞いてる？",
            "zh": "你有在听吗？",
            "narrator_zh": ""
        },
        {
            "location": "69/SEL",
            "narrator": "",
            "text": "バレちゃったみたいだね",
            "zh": "好像暴露了呢",
            "narrator_zh": ""
        },
        {
            "location": "70/SEL",
            "narrator": "",
            "text": "ガブはどう思う？",
            "zh": "加布怎么看？",
            "narrator_zh": ""
        },
        {
            "location": "73/TALK",
            "narrator": "アーヤ",
            "text": "確定じゃないわ。\nあくまで可能性の\n話ってこと。",
            "zh": "还没确定。\n说到底只是\n可能性。",
            "narrator_zh": "绫水"
        },
        {
            "location": "74/TALK",
            "narrator": "みやび",
            "text": "ガブちゃん。\nうちらも冗談で言っちゅう\nわけやないぞね。",
            "zh": "加布。\n我们也不是\n在开玩笑啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "75/TALK",
            "narrator": "みやび",
            "text": "会話ログを解析したり、\n色々した結果、そういう\n答えを導き出したがよ。",
            "zh": "解析了对话记录，\n又查了别的，才得出\n这个答案啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "79/TALK",
            "narrator": "ガブリエラ",
            "text": "だから、その導き出した\n答えが間違ってるの！",
            "zh": "所以我说，\n那个得出的答案是错的！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "81/TALK",
            "narrator": "ガブリエラ",
            "text": "ああもう、話にならない！",
            "zh": "啊真是的，没法谈了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "82/TALK",
            "narrator": "ガブリエラ",
            "text": "とにかく、あたしは\nそんな話信じないから。",
            "zh": "总之，我\n不信这种话。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "84/TALK",
            "narrator": "アーヤ",
            "text": "そうね。\n確かにそう。",
            "zh": "是这样。\n确实如此。",
            "narrator_zh": "绫水"
        },
        {
            "location": "86/TALK",
            "narrator": "アーヤ",
            "text": "もちろん、私だって\n混乱はしてる。",
            "zh": "当然，我自己\n也很混乱。",
            "narrator_zh": "绫水"
        },
        {
            "location": "88/TALK",
            "narrator": "アーヤ",
            "text": "それでもね。\nできるだけ、冷静に対応を\nしようと思ってるわ。",
            "zh": "即便如此。\n我还是想尽量\n冷静应对。",
            "narrator_zh": "绫水"
        },
        {
            "location": "89/TALK",
            "narrator": "アーヤ",
            "text": "だから、もしみんなが\n今後のＢｏｔとの\n付き合い方とかで――",
            "zh": "所以，要是大家\n在以后怎么和Bot\n相处的事上——",
            "narrator_zh": "绫水"
        },
        {
            "location": "91/TALK",
            "narrator": "アーヤ",
            "text": "わからないことがあれば、\nいつでも相談してくれて\n構わないから。",
            "zh": "有不明白的，\n随时来问我\n都可以。",
            "narrator_zh": "绫水"
        },
        {
            "location": "92/TALK",
            "narrator": "アーヤ",
            "text": "私の話は以上よ。\nそれじゃ、今夜は解散。",
            "zh": "我要说的就这些。\n那么，今晚解散。",
            "narrator_zh": "绫水"
        },
        {
            "location": "94/TALK",
            "narrator": "ガブリエラ",
            "text": "まったく、こんなふざけた\n話のために、一々人のこと\n呼び出さないでよね！",
            "zh": "真是的，为了这种\n胡闹的话，别一次次\n把人叫出来！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "108/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "110/TALK",
            "narrator": "ガブリエラ",
            "text": "Ｂｏｔが…マルザンナが\n人間って…。",
            "zh": "Bot……玛尔赞娜\n是人类……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "111/TALK",
            "narrator": "ガブリエラ",
            "text": "そんなの、ありえない。\nみんなおかしいわよ！",
            "zh": "那种事不可能。\n大家都不正常了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "113/ACT",
            "narrator": "",
            "text": "ちゃんと聞いてる？",
            "zh": "你有在听吗？",
            "narrator_zh": ""
        },
        {
            "location": "129/TALK",
            "narrator": "ガブリエラ",
            "text": "聞く必要ないわ、こんな馬鹿げた話",
            "zh": "这种荒唐的话，没必要听",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "130/TALK",
            "narrator": "ガブリエラ",
            "text": "今日はエイプリルフールじゃないのよ？",
            "zh": "今天又不是愚人节？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "131/TALK",
            "narrator": "ガブリエラ",
            "text": "なのに、こんなつまらない冗談聞かされて…バカみたい。",
            "zh": "明明这样，还被这种无聊的玩笑耍……真像傻瓜。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "142/TALK",
            "narrator": "アーヤ",
            "text": "この場で結論が\n出るわけがないと\nわかってるの。",
            "zh": "我知道，在这里\n是得不出\n结论的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "143/TALK",
            "narrator": "アーヤ",
            "text": "でもこれは\n考えなきゃ\nいけないことよ。",
            "zh": "可这件事\n是必须好好\n考虑的哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "145/ACT",
            "narrator": "",
            "text": "バレちゃったみたいだね",
            "zh": "好像暴露了呢",
            "narrator_zh": ""
        },
        {
            "location": "161/TALK",
            "narrator": "ガブリエラ",
            "text": "何を言ってるの？",
            "zh": "你在说什么？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "162/TALK",
            "narrator": "ガブリエラ",
            "text": "マルザンナまで、変な冗談言わないで！",
            "zh": "连玛尔赞娜也别开这种奇怪的玩笑！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "173/TALK",
            "narrator": "アーヤ",
            "text": "この場で結論が\n出るわけがないと\nわかってるの。",
            "zh": "我知道，在这里\n是得不出\n结论的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "174/TALK",
            "narrator": "アーヤ",
            "text": "でもこれは\n考えなきゃ\nいけないことよ。",
            "zh": "可这件事\n是必须好好\n考虑的哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "176/ACT",
            "narrator": "",
            "text": "ガブはどう思う？",
            "zh": "加布怎么看？",
            "narrator_zh": ""
        },
        {
            "location": "192/TALK",
            "narrator": "ガブリエラ",
            "text": "どうも何もないわ",
            "zh": "也没什么啊",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "193/TALK",
            "narrator": "ガブリエラ",
            "text": "こんな時間に、変な冗談聞かされるために付き合わされたのよ？",
            "zh": "大晚上的，就为了让我听些奇怪的玩笑才把我拉出来的吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "194/TALK",
            "narrator": "ガブリエラ",
            "text": "迷惑以外の何でもないわ",
            "zh": "除了添麻烦，什么都不是",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "205/TALK",
            "narrator": "アーヤ",
            "text": "この場で結論が\n出るわけがないと\nわかってるの。",
            "zh": "我知道，在这里\n是得不出\n结论的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "206/TALK",
            "narrator": "アーヤ",
            "text": "でもこれは\n考えなきゃ\nいけないことよ。",
            "zh": "可这件事\n是必须好好\n考虑的哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "20/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>5月某日　10:05 PM</color>\n平日の夜、神楽坂トライナリーのホワイエにて。",
            "zh": "<color=green>5月某日　10:05 PM</color>\n平日夜里，在神乐坂三重奏的门厅。",
            "narrator_zh": "Dialog_EventData"
        }
    ]
}
