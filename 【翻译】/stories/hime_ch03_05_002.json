    "entry": [
        {
            "location": "152/SCENARIO",
            "narrator": "",
            "text": "05-02_学校の悩み",
            "zh": "05-02_学校的烦恼",
            "narrator_zh": ""
        },
        {
            "location": "177/TALK",
            "narrator": "ガブリエラ",
            "text": "聞いてマルザンナ",
            "zh": "给我听着，玛尔赞娜",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "178/TALK",
            "narrator": "ガブリエラ",
            "text": "私ね",
            "zh": "我啊",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "179/TALK",
            "narrator": "ガブリエラ",
            "text": "学校にお友達がいないの",
            "zh": "在学校没有朋友",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "180/TALK",
            "narrator": "ガブリエラ",
            "text": "あ、",
            "zh": "啊，",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "181/TALK",
            "narrator": "ガブリエラ",
            "text": "今の日本のってことね",
            "zh": "是说现在这个日本",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "183/TALK",
            "narrator": "ガブリエラ",
            "text": "でもいいの",
            "zh": "不过没关系",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "184/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤたちもいるし",
            "zh": "还有绫水她们",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "185/TALK",
            "narrator": "ガブリエラ",
            "text": "マルザンナだっていてくれるもの",
            "zh": "玛尔赞娜也在我身边",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "187/SEL",
            "narrator": "",
            "text": "そうなの？",
            "zh": "是吗？",
            "narrator_zh": ""
        },
        {
            "location": "188/SEL",
            "narrator": "",
            "text": "そのうちできるよ",
            "zh": "以后会有的",
            "narrator_zh": ""
        },
        {
            "location": "189/SEL",
            "narrator": "",
            "text": "やせ我慢しなくても",
            "zh": "不用硬撑",
            "narrator_zh": ""
        },
        {
            "location": "190/ACT",
            "narrator": "",
            "text": "そうなの？",
            "zh": "是吗？",
            "narrator_zh": ""
        },
        {
            "location": "192/TALK",
            "narrator": "ガブリエラ",
            "text": "そうよ",
            "zh": "是啊",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "193/TALK",
            "narrator": "ガブリエラ",
            "text": "だから平気",
            "zh": "所以没关系",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "195/TALK",
            "narrator": "ガブリエラ",
            "text": "平気なんだから",
            "zh": "没关系的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "196/ACT",
            "narrator": "",
            "text": "そのうちできるよ",
            "zh": "以后会有的",
            "narrator_zh": ""
        },
        {
            "location": "197/TALK",
            "narrator": "ガブリエラ",
            "text": "そうね",
            "zh": "是啊",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "198/TALK",
            "narrator": "ガブリエラ",
            "text": "そうかもしれないわ",
            "zh": "也许是这样",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "199/TALK",
            "narrator": "ガブリエラ",
            "text": "ありがとう",
            "zh": "谢谢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "200/ACT",
            "narrator": "",
            "text": "やせ我慢しなくても",
            "zh": "不用硬撑",
            "narrator_zh": ""
        },
        {
            "location": "214/TALK",
            "narrator": "ガブリエラ",
            "text": "やっぱり",
            "zh": "果然",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "216/TALK",
            "narrator": "ガブリエラ",
            "text": "そういうのって",
            "zh": "这种事",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "217/TALK",
            "narrator": "ガブリエラ",
            "text": "わかっちゃうのね・・・",
            "zh": "你一下就看出来了……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "218/TALK",
            "narrator": "ガブリエラ",
            "text": "本当はね",
            "zh": "其实啊",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "219/TALK",
            "narrator": "ガブリエラ",
            "text": "わかっているの",
            "zh": "我知道的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "220/TALK",
            "narrator": "ガブリエラ",
            "text": "お友達ができない理由",
            "zh": "交不到朋友的理由",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "223/TALK",
            "narrator": "ガブリエラ",
            "text": "私ちょっと",
            "zh": "我有一点",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "224/TALK",
            "narrator": "ガブリエラ",
            "text": "警戒心が強すぎるのよね・・・",
            "zh": "戒心太强了……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "226/TALK",
            "narrator": "ガブリエラ",
            "text": "日本は平和なんだし",
            "zh": "日本明明很和平",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "227/TALK",
            "narrator": "ガブリエラ",
            "text": "まわりは同い年の子ばっかりなんだから",
            "zh": "周围又都是同龄的孩子",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "228/TALK",
            "narrator": "ガブリエラ",
            "text": "そんなに警戒する必要ないんだってわかっているつもりなの",
            "zh": "我以为自己明白，没必要那么戒备",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "234/TALK",
            "narrator": "ガブリエラ",
            "text": "でも",
            "zh": "可是",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "235/TALK",
            "narrator": "ガブリエラ",
            "text": "なんだか色々と",
            "zh": "总觉得各种各样",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "236/TALK",
            "narrator": "ガブリエラ",
            "text": "難しくって",
            "zh": "很难",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "238/SEL",
            "narrator": "",
            "text": "そっか……",
            "zh": "这样啊……",
            "narrator_zh": ""
        },
        {
            "location": "239/SEL",
            "narrator": "",
            "text": "難しいことってあるよね",
            "zh": "是有很难的事",
            "narrator_zh": ""
        },
        {
            "location": "240/SEL",
            "narrator": "",
            "text": "マルザンナが友達だよ",
            "zh": "玛尔赞娜就是朋友",
            "narrator_zh": ""
        },
        {
            "location": "241/ACT",
            "narrator": "",
            "text": "そっか……",
            "zh": "这样啊……",
            "narrator_zh": ""
        },
        {
            "location": "242/TALK",
            "narrator": "ガブリエラ",
            "text": "他の子たちは",
            "zh": "其他孩子",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "244/TALK",
            "narrator": "ガブリエラ",
            "text": "こんなことで悩んだりしないわよね・・・",
            "zh": "不会为这种事烦恼吧……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "245/ACT",
            "narrator": "",
            "text": "難しいことってあるよね",
            "zh": "是有很难的事",
            "narrator_zh": ""
        },
        {
            "location": "246/TALK",
            "narrator": "ガブリエラ",
            "text": "変よね",
            "zh": "很奇怪吧",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "248/TALK",
            "narrator": "ガブリエラ",
            "text": "みんなは普通にできることなのに",
            "zh": "明明是大家都能平常做到的事",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "249/ACT",
            "narrator": "",
            "text": "マルザンナが友達だよ",
            "zh": "玛尔赞娜就是朋友",
            "narrator_zh": ""
        },
        {
            "location": "260/TALK",
            "narrator": "ガブリエラ",
            "text": "そうね",
            "zh": "是啊",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "262/TALK",
            "narrator": "ガブリエラ",
            "text": "ありがとう",
            "zh": "谢谢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "264/TALK",
            "narrator": "ガブリエラ",
            "text": "素敵なお友達でいてくれて",
            "zh": "愿意当我这么好的朋友",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "266/TALK",
            "narrator": "ガブリエラ",
            "text": "学校で一人でいるのは",
            "zh": "一个人待在学校",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "267/TALK",
            "narrator": "ガブリエラ",
            "text": "やっぱりさみしいわ",
            "zh": "果然还是寂寞",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "268/TALK",
            "narrator": "ガブリエラ",
            "text": "できたら行きたくないって思ってしまうの",
            "zh": "可能的话，我会觉得不想去",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "269/TALK",
            "narrator": "ガブリエラ",
            "text": "それで",
            "zh": "所以",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "270/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤと朝からずっといられたらいいのにって思ったりするの",
            "zh": "我会想，要是能从早上起就一直和绫水在一起就好了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "272/SEL",
            "narrator": "",
            "text": "そう",
            "zh": "是啊",
            "narrator_zh": ""
        },
        {
            "location": "273/ACT",
            "narrator": "",
            "text": "そう",
            "zh": "是啊",
            "narrator_zh": ""
        },
        {
            "location": "274/TALK",
            "narrator": "ガブリエラ",
            "text": "でもでも",
            "zh": "可是可是",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "276/TALK",
            "narrator": "ガブリエラ",
            "text": "マルザンナもお友達だものね",
            "zh": "玛尔赞娜也是朋友啊",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "277/TALK",
            "narrator": "ガブリエラ",
            "text": "さみしいなんて変よね",
            "zh": "觉得寂寞，很奇怪吧",
            "narrator_zh": "加布里埃拉"
        },
