{
    "dir": "chap08/battle/btev_ch04_08_00.js",
    "type": "",
    "info": {
        "story_id": "24013",
        "cid": "",
        "title": "013 ココロスフィアストーリー【Lv05】",
        "sub_title": "巧妙な罠＜提起＞",
        "title_zh": "013 心灵领域故事【Lv05】",
        "sub_title_zh": "巧妙的陷阱＜提起＞"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "巧妙な罠",
            "zh": "巧妙的陷阱",
            "narrator_zh": ""
        },
        {
            "location": "14/DIALOG",
            "narrator": "",
            "text": "<size=40>KOKORO-Lv. 05</size>\nMIYABI - KOIGASAKI\n\n<size=45>巧妙な罠</size>\n<size=35>～濡れ衣をかけた少女～</size>",
            "zh": "<size=40>KOKORO-Lv. 05</size>\n恋之崎雅\n\n<size=45>巧妙的陷阱</size>\n<size=35>～强加冤屈的少女～</size>[?]",
            "narrator_zh": ""
        },
        {
            "location": "30/TALK",
            "narrator": "つばめ",
            "text": "ち、違います！\nわたしじゃないです！",
            "zh": "不、不是的！\n真的不是我！",
            "narrator_zh": "燕"
        },
        {
            "location": "31/TALK",
            "narrator": "ガブリエラ",
            "text": "ウソつかないでよ。\nあんた以外に\nいないでしょ？",
            "zh": "别撒谎了。\n除了你以外\n还能有谁？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "32/TALK",
            "narrator": "ガブリエラ",
            "text": "あたし達がいた時は、\n確かに売店に置いて\nあったのに――",
            "zh": "我们刚才在的时候，\n明明还好好放在\n小卖部那儿的——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "33/TALK",
            "narrator": "ガブリエラ",
            "text": "あんたが店番した\n後でなくなったのよ？",
            "zh": "你值完班之后\n就不见了哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "35/TALK",
            "narrator": "つばめ",
            "text": "で、でも…本当に\nわたしじゃないし…。",
            "zh": "可、可是……真的\n不是我呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "36/TALK",
            "narrator": "アーヤ",
            "text": "つばめ、私たちは\n怒ってるわけじゃ\nないのよ？",
            "zh": "燕，我们并不是\n在生你的气\n哦？",
            "narrator_zh": "绫水"
        },
        {
            "location": "37/TALK",
            "narrator": "アーヤ",
            "text": "正直に出してくれれば\nそれで話はおしまい。",
            "zh": "只要你老实拿出来，\n这件事就算了结了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "38/TALK",
            "narrator": "アーヤ",
            "text": "今日のことは\nなかったことに\nするから…。",
            "zh": "今天的事\n就当没发生过\n行吧……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "39/TALK",
            "narrator": "神楽",
            "text": "そうですよ。",
            "zh": "就是啊。",
            "narrator_zh": "神乐"
        },
        {
            "location": "40/TALK",
            "narrator": "神楽",
            "text": "それに、誰にだって\nつい魔が差しちゃう\nことはあります。",
            "zh": "再说，谁都会有\n一时鬼迷心窍的\n时候嘛。",
            "narrator_zh": "神乐"
        },
        {
            "location": "41/TALK",
            "narrator": "つばめ",
            "text": "そ、そんな…。",
            "zh": "怎、怎么这样……。",
            "narrator_zh": "燕"
        },
        {
            "location": "56/TALK",
            "narrator": "潜在みやび",
            "text": "…みやびさん、\n事件です。",
            "zh": "……雅小姐，\n出案子了。",
            "narrator_zh": "潜在雅"
        },
        {
            "location": "59/TALK",
            "narrator": "表層みやび",
            "text": "うむ、事件なうやな。",
            "zh": "嗯，正撞上案子咯。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "62/TALK",
            "narrator": "潜在みやび",
            "text": "容疑者逢瀬つばめは、\n容疑を否認している\n模様。",
            "zh": "嫌疑人逢濑燕\n似乎否认\n指控。",
            "narrator_zh": "潜在雅"
        },
        {
            "location": "64/TALK",
            "narrator": "表層みやび",
            "text": "素直に罪を認める\n犯人ばかりやない\nがよ。",
            "zh": "哪有那么多乖乖认罪\n的犯人\n咯。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "65/SEL",
            "narrator": "（選択肢）",
            "text": "一体、何があったの？",
            "zh": "到底发生了什么？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "66/ACT",
            "narrator": "",
            "text": "一体、何があったの？",
            "zh": "到底发生了什么？",
            "narrator_zh": ""
        },
        {
            "location": "72/TALK",
            "narrator": "表層みやび",
            "text": "中での話聞けば、\n大体わかるやろ？",
            "zh": "听里面的对话，\n大概也懂了吧？",
            "narrator_zh": "表层雅"
        },
        {
            "location": "73/TALK",
            "narrator": "表層みやび",
            "text": "劇場の売店で\n盗難があったがよ。",
            "zh": "剧场的小卖部\n闹失窃咯。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "74/TALK",
            "narrator": "潜在みやび",
            "text": "売店に、忘れ物の\n財布が置いてあったん\nやけんど――",
            "zh": "小卖部本来放着\n一个别人落下的钱包，\n但是——",
            "narrator_zh": "潜在雅"
        },
        {
            "location": "75/TALK",
            "narrator": "潜在みやび",
            "text": "それがいつの間にか、\n綺麗さっぱり消えて\nしもうたがよ。",
            "zh": "不知不觉间，\n那钱包就干干净净\n没了踪影咯。",
            "narrator_zh": "潜在雅"
        },
        {
            "location": "76/TALK",
            "narrator": "表層みやび",
            "text": "いつの間にっちゅうか\nつばめちゃんが店番\nしちゅう間にな。",
            "zh": "与其说不知不觉，\n其实是在燕值班的\n这段空档。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "78/TALK",
            "narrator": "表層みやび",
            "text": "その間に来たお客の\n人数は…、\nさあ、何人！？",
            "zh": "这期间上门的客人\n人数是……，\n猜猜，有几个！？",
            "narrator_zh": "表层雅"
        },
        {
            "location": "79/SEL",
            "narrator": "（選択肢）",
            "text": "ゼロじゃない？",
            "zh": "不是零吗？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "80/ACT",
            "narrator": "",
            "text": "ゼロじゃない？",
            "zh": "不是零吗？",
            "narrator_zh": ""
        },
        {
            "location": "83/TALK",
            "narrator": "潜在みやび",
            "text": "正解や。\n…$handle$は\n頭がえいな。",
            "zh": "答对了。\n……$handle$\n算聪明了。",
            "narrator_zh": "潜在雅"
        },
        {
            "location": "85/TALK",
            "narrator": "表層みやび",
            "text": "当然やろ、うち。\n$handle$を舐めたら\nいかんぞ、うち。",
            "zh": "那还用说，我。\n可不能小看\n$handle$咧，我。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "88/TALK",
            "narrator": "潜在みやび",
            "text": "しっかし…、\nつばめちゃんが\n盗難なぁ…。",
            "zh": "不过……，\n燕会干出盗窃\n这种事吗……。",
            "narrator_zh": "潜在雅"
        },
        {
            "location": "91/TALK",
            "narrator": "潜在みやび",
            "text": "はい、みやび先生。\n質問ちや。",
            "zh": "报告，雅老师。\n我有问题滴。",
            "narrator_zh": "潜在雅"
        },
        {
            "location": "92/TALK",
            "narrator": "表層みやび",
            "text": "ほい、なんやうち？",
            "zh": "哎，有驷马事啊，我？",
            "narrator_zh": "表层雅"
        },
        {
            "location": "93/TALK",
            "narrator": "潜在みやび",
            "text": "つばめちゃん、\n盗みなんぞする子に\n思えんのやけんど…。",
            "zh": "燕她，\n怎么想都不像是会做\n小偷的孩子，但是……。",
            "narrator_zh": "潜在雅"
        },
        {
            "location": "96/TALK",
            "narrator": "表層みやび",
            "text": "あ～、いかんいかん。\nそれはいかんぞね。",
            "zh": "啊～，不行不行。\n这种想法可不行咧。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "99/TALK",
            "narrator": "表層みやび",
            "text": "うちはつばめちゃんの\nこと、どれくらい\n知っちょるが？",
            "zh": "我对燕的事，\n又了解多少\n呢？",
            "narrator_zh": "表层雅"
        },
        {
            "location": "100/TALK",
            "narrator": "潜在みやび",
            "text": "ほぼ知らんに等しい。\n謎の存在や。",
            "zh": "几乎等同于一无所知。\n她就是个谜一样的存在。",
            "narrator_zh": "潜在雅"
        },
        {
            "location": "101/TALK",
            "narrator": "表層みやび",
            "text": "なら、わかるやろ？\nやらんと決めつける\n根拠はどこにもない。",
            "zh": "那就明白了吧？\n断定她绝对没做的\n根据，哪里都没得。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "102/TALK",
            "narrator": "表層みやび",
            "text": "疑わしければ、\n責められるのは\n仕方ないがよ。",
            "zh": "既然惹人怀疑，\n受到指责也是\n没办法的事咯。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "105/TALK",
            "narrator": "潜在みやび",
            "text": "…責められる、\nちゅうてもなぁ…。",
            "zh": "……话是这么说，\n可这也算指责过头了……。",
            "narrator_zh": "潜在雅"
        },
        {
            "location": "126/TALK",
            "narrator": "つばめ",
            "text": "ほ、本当なんです。\nお財布なんて\n盗んでないです…。",
            "zh": "真、真的不是我。\n什么钱包，\n我真的没偷……。",
            "narrator_zh": "燕"
        },
        {
            "location": "128/TALK",
            "narrator": "ガブリエラ",
            "text": "じゃあどうして\nなくなったのよ？",
            "zh": "那为什么\n会凭空不见了啊？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "129/TALK",
            "narrator": "ガブリエラ",
            "text": "財布に足が生えて\n一人で逃げ出した\nとでも言うの？",
            "zh": "难道你还要说钱包\n自己长脚\n溜出去不成？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "131/TALK",
            "narrator": "つばめ",
            "text": "ち、違うよ！\nでも、他の人が\n持ってったのかも…。",
            "zh": "不、不是的！\n可说不定是别的什么人\n顺手拿走了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "133/TALK",
            "narrator": "ガブリエラ",
            "text": "…何それ？\nあたし達を泥棒扱い\nするわけ？",
            "zh": "……你这话什么意思？\n把我们当成小偷\n了吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "135/TALK",
            "narrator": "神楽",
            "text": "そんな…つばめさん、\n酷いです…。",
            "zh": "怎么这样……燕，\n你太过分了……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "136/TALK",
            "narrator": "つばめ",
            "text": "そ、そういうこと\nじゃなくて…。",
            "zh": "不、不是那个意思\n……。",
            "narrator_zh": "燕"
        },
        {
            "location": "137/TALK",
            "narrator": "つばめ",
            "text": "アーヤさん、\n信じてください。\nわたし、本当に…。",
            "zh": "绫水，\n请你相信我。\n我真的……。",
            "narrator_zh": "燕"
        },
        {
            "location": "139/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "154/TALK",
            "narrator": "潜在みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "潜在雅"
        },
        {
            "location": "155/TALK",
            "narrator": "表層みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "158/TALK",
            "narrator": "潜在みやび",
            "text": "先生、うち、何だか\n気分悪いちや。",
            "zh": "老师，我总觉得\n心里很不舒服滴。",
            "narrator_zh": "潜在雅"
        },
        {
            "location": "160/TALK",
            "narrator": "表層みやび",
            "text": "…まあ、確かに\nそうやな。",
            "zh": "……嘛，确实\n如此啊。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "163/TALK",
            "narrator": "表層みやび",
            "text": "けんど、どう考えても\n一番疑わしいのは\nつばめちゃんや。",
            "zh": "但是，怎么想\n最可疑的都还是\n燕吧。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "165/TALK",
            "narrator": "潜在みやび",
            "text": "異議あり！\n証拠が無いちや！",
            "zh": "我反对！\n没有证据滴！",
            "narrator_zh": "潜在雅"
        },
        {
            "location": "166/TALK",
            "narrator": "表層みやび",
            "text": "状況証拠的には、\nつばめちゃんが\n犯人としか思えん。",
            "zh": "从间接证据来看，\n除了燕以外\n想不出别人是犯人。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "167/TALK",
            "narrator": "表層みやび",
            "text": "それだけでも、\nとりあえず疑う\n理由としては十分や。",
            "zh": "光凭这一点，\n也足够作为暂且怀疑的\n理由了。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "168/SEL",
            "narrator": "（選択肢）",
            "text": "疑わしきは罰せよ、ってこと？",
            "zh": "你是说，疑罪从有？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "169/ACT",
            "narrator": "",
            "text": "疑わしきは罰せよ、ってこと？",
            "zh": "你是说，疑罪从有？",
            "narrator_zh": ""
        },
        {
            "location": "172/TALK",
            "narrator": "表層みやび",
            "text": "そこまでは言うて\nないけんど…。",
            "zh": "倒也没说到\n那种地步，但是……。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "175/TALK",
            "narrator": "潜在みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "潜在雅"
        },
        {
            "location": "178/TALK",
            "narrator": "潜在みやび",
            "text": "まあ、みんなも\nちくっと熱が上がっ\nちょるき――",
            "zh": "嘛，大家现在也\n稍微有点上头\n了啵——",
            "narrator_zh": "潜在雅"
        },
        {
            "location": "180/TALK",
            "narrator": "潜在みやび",
            "text": "頭冷やすよう\n言うた方がえいかも\nしれんな。",
            "zh": "劝她们冷静一下\n或许比较好\n呢。",
            "narrator_zh": "潜在雅"
        },
        {
            "location": "181/TALK",
            "narrator": "表層みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "182/TALK",
            "narrator": "表層みやび",
            "text": "けんど、あの子には\nスパイ容疑もある\nちや。",
            "zh": "但是，那孩子身上\n还有间谍嫌疑\n滴。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "183/TALK",
            "narrator": "表層みやび",
            "text": "色んなところで\n疑わしい点がある\nあの子を――",
            "zh": "在那么多地方\n都透着可疑的\n那孩子——",
            "narrator_zh": "表层雅"
        },
        {
            "location": "185/TALK",
            "narrator": "表層みやび",
            "text": "証拠もなしに庇う\nっちゅうのは、\nどうもな…。",
            "zh": "连证据都没得\n就去包庇她，\n总觉得不太对啊……。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "186/TALK",
            "narrator": "潜在みやび",
            "text": "気が乗らんか？",
            "zh": "你不乐意咩？",
            "narrator_zh": "潜在雅"
        },
        {
            "location": "188/TALK",
            "narrator": "表層みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "189/TALK",
            "narrator": "潜在みやび",
            "text": "そうか…。\nよし、わかった。",
            "zh": "这样啊……。\n好，我明白了。",
            "narrator_zh": "潜在雅"
        },
        {
            "location": "192/TALK",
            "narrator": "潜在みやび",
            "text": "おい、$handle$。\n$handle$はどっちの\n意見に賛成や？",
            "zh": "喂，$handle$。\n$handle$你赞成\n哪一边的意见？",
            "narrator_zh": "潜在雅"
        },
        {
            "location": "193/SEL",
            "narrator": "（選択肢）",
            "text": "つばめを助けよう",
            "zh": "去帮燕吧",
            "narrator_zh": "（选项）"
        },
        {
            "location": "194/SEL",
            "narrator": "（選択肢）",
            "text": "やっぱりつばめは疑わしい",
            "zh": "果然燕还是很可疑",
            "narrator_zh": "（选项）"
        },
        {
            "location": "195/ACT",
            "narrator": "",
            "text": "つばめを助けよう",
            "zh": "去帮燕吧",
            "narrator_zh": ""
        },
        {
            "location": "198/TALK",
            "narrator": "潜在みやび",
            "text": "ちゅうわけやき――",
            "zh": "既然如此啵——",
            "narrator_zh": "潜在雅"
        },
        {
            "location": "199/TALK",
            "narrator": "潜在みやび",
            "text": "準備はえいか？\n強情なうち。",
            "zh": "准备好了咩？\n顽固的我。",
            "narrator_zh": "潜在雅"
        },
        {
            "location": "202/TALK",
            "narrator": "表層みやび",
            "text": "そう来ると思うた\nぞね、強硬なうち。",
            "zh": "我就猜到你会这么来\n咧，强硬的我。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "203/TALK",
            "narrator": "潜在みやび",
            "text": "本人同士で意見が\n合わんかったら――",
            "zh": "既然连自己跟自己都\n意见不合——",
            "narrator_zh": "潜在雅"
        },
        {
            "location": "204/TALK",
            "narrator": "潜在みやび",
            "text": "もうこうするしか、\n方法はないやろ。",
            "zh": "那就只剩这一个\n法子能解决了。",
            "narrator_zh": "潜在雅"
        },
        {
            "location": "205/TALK",
            "narrator": "潜在みやび",
            "text": "じゃ、行くぞね！",
            "zh": "那么，上咧！",
            "narrator_zh": "潜在雅"
        },
        {
            "location": "217/DIALOG",
            "narrator": "",
            "text": "<color=black><size=50><b>つばめを無理矢理罪人に\nしたがるみやびを倒せ！</b></size></color>\n\n\n\nなんの根拠も見つからないまま\n逢瀬つばめを黒であると判断するみやび。\n彼女はもはや、疲れてしまったのだ。\nあまりにつばめが尻尾を出さないことに。\n\nしかし、警戒を怠りたくないみやびは\nあの手この手でつばめを黒に仕立て上げる。\n\nそんなことはさせてはならない！\nつばめとみやびのココロを守れるのは、貴方だけだ。",
            "zh": "<color=black><size=50><b>打倒硬想把燕\n定为罪人的雅吧！</b></size></color>\n\n\n\n在毫无根据的情况下，\n就把逢濑燕断定为有罪之人的雅。\n她早已感到疲惫不堪——\n只因燕实在太久没有露出马脚。\n\n然而，不想松懈戒备的雅\n千方百计地要把燕坐实成罪人。\n\n绝不能让那种事发生！\n能守护燕与雅的心灵的，只有你。",
            "narrator_zh": ""
        },
        {
            "location": "219/ACT",
            "narrator": "",
            "text": "やっぱりつばめは疑わしい",
            "zh": "果然燕还是很可疑",
            "narrator_zh": ""
        },
        {
            "location": "221/TALK",
            "narrator": "潜在みやび",
            "text": "うわ、マジか。",
            "zh": "哇，真的假的。",
            "narrator_zh": "潜在雅"
        },
        {
            "location": "224/TALK",
            "narrator": "表層みやび",
            "text": "意外と冷たい奴\nなんやね？",
            "zh": "意外地是个冷酷的\n家伙咯？",
            "narrator_zh": "表层雅"
        },
        {
            "location": "225/SEL",
            "narrator": "（選択肢）",
            "text": "えっ！？　疑ってたんでしょ？",
            "zh": "诶！？　你之前不也在怀疑吗？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "226/ACT",
            "narrator": "",
            "text": "えっ！？　疑ってたんでしょ？",
            "zh": "诶！？　你之前不也在怀疑吗？",
            "narrator_zh": ""
        },
        {
            "location": "228/TALK",
            "narrator": "表層みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "表层雅"
        },
        {
            "location": "229/TALK",
            "narrator": "潜在みやび",
            "text": "まあ、そう思うてる\n時点でここにおる\n資格はないな。",
            "zh": "嘛，你抱有这种想法\n就已经没资格\n待在这里了。",
            "narrator_zh": "潜在雅"
        },
        {
            "location": "230/TALK",
            "narrator": "潜在みやび",
            "text": "一度帰って、\n頭冷やしてきぃ。",
            "zh": "先回去一趟，\n冷静冷静再来吧。",
            "narrator_zh": "潜在雅"
        }
    ]
}
