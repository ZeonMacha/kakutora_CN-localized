{
 "dir": "dramatics/daydra/drm_ch05_00_100.js",
 "type": "Episode",
 "info": {
  "story_id": "5010",
  "cid": "kagura",
  "title": "らぶとーく 第10話",
  "sub_title": "ささやかな日常のシーン"
 },
 "entry": [
  {
   "location": "366/SCENARIO",
   "narrator": "",
   "text": "ささやかな日常のシーン",
   "zh": "小小的日常场景",
   "narrator_zh": ""
  },
  {
   "location": "393/TALK",
   "narrator": "つばめ",
   "text": "いただきまーす！"
  },
  {
   "location": "395/TALK",
   "narrator": "雛",
   "text": "つばめちゃんは\n元気だねー。",
   "zh": "燕真\n精神呢——",
   "narrator_zh": "雏"
  },
  {
   "location": "396/TALK",
   "narrator": "神楽",
   "text": "そこがつばめさんの\nいいところじゃ\nないですか。",
   "zh": "那不正是燕的\n优点\n吗。",
   "narrator_zh": "神乐"
  },
  {
   "location": "397/TALK",
   "narrator": "繭",
   "text": "…おいしそうに\n食べるところも\nいいところだと思う。"
  },
  {
   "location": "399/TALK",
   "narrator": "雛",
   "text": "そうだね。\nたとえ学食の\nおそばでも。",
   "zh": "是啊。\n哪怕是食堂的\n荞麦面。",
   "narrator_zh": "雏"
  },
  {
   "location": "400/TALK",
   "narrator": "雛",
   "text": "なんかおいしそうに\n食べるよね、\nつばめちゃんって。",
   "zh": "你吃东西\n看起来真香呢，\n燕。",
   "narrator_zh": "雏"
  },
  {
   "location": "402/TALK",
   "narrator": "つばめ",
   "text": "あれ？\nみんなはおいしく\nないの？"
  },
  {
   "location": "404/TALK",
   "narrator": "雛",
   "text": "おいしいとか\nおいしくないとか\nよりも。",
   "zh": "比好吃\n还是不好吃\n更重要的是。",
   "narrator_zh": "雏"
  },
  {
   "location": "405/TALK",
   "narrator": "雛",
   "text": "もう飽きちゃってるん\nだよねー。"
  },
  {
   "location": "407/TALK",
   "narrator": "繭",
   "text": "そう。",
   "zh": "是的。",
   "narrator_zh": "茧"
  },
  {
   "location": "408/TALK",
   "narrator": "神楽",
   "text": "確かに毎日同じものを\n食べてると飽きますよね。"
  },
  {
   "location": "409/TALK",
   "narrator": "雛",
   "text": "そうそう。\n味わう意味が\nなくなるっていうか。",
   "zh": "对对。\n要说的话就是\n失去品尝的意义。",
   "narrator_zh": "雏"
  },
  {
   "location": "411/TALK",
   "narrator": "つばめ",
   "text": "そっかー。",
   "zh": "这样啊。",
   "narrator_zh": "燕"
  },
  {
   "location": "412/TALK",
   "narrator": "つばめ",
   "text": "わたしまだ転校してきた\nばっかりだから\nピンとこないけど。"
  },
  {
   "location": "413/TALK",
   "narrator": "つばめ",
   "text": "そのうち飽きたって\nなっちゃうのかな。",
   "zh": "会不会变成\n以后就腻了。",
   "narrator_zh": "燕"
  },
  {
   "location": "415/TALK",
   "narrator": "雛",
   "text": "そう考えるとさ。\n自作のお弁当とか\n大変だよね。",
   "zh": "这么一想，\n自己做的便当\n很辛苦呢。",
   "narrator_zh": "雏"
  },
  {
   "location": "416/TALK",
   "narrator": "雛",
   "text": "遠足の時くらいだけ\nだったらいいけど\n毎日はね。"
  },
  {
   "location": "419/TALK",
   "narrator": "つばめ",
   "text": "…そうかも。"
  },
  {
   "location": "421/TALK",
   "narrator": "神楽",
   "text": "たまに作ってもらうの\nうれしかったですよね。",
   "zh": "偶尔让你做给我吃，\n我很开心呢。",
   "narrator_zh": "神乐"
  },
  {
   "location": "422/TALK",
   "narrator": "神楽",
   "text": "うちの母はあんまり\n器用じゃないんですけど。"
  },
  {
   "location": "423/TALK",
   "narrator": "神楽",
   "text": "それでもやっぱり\nうれしかったです。",
   "zh": "不过果然\n我很开心。",
   "narrator_zh": "神乐"
  },
  {
   "location": "424/SEL",
   "narrator": "",
   "text": "もっと聞かせてよ",
   "zh": "再多讲给我听",
   "narrator_zh": ""
  },
  {
   "location": "425/ACT",
   "narrator": "",
   "text": "もっと聞かせてよ",
   "zh": "再多讲给我听",
   "narrator_zh": ""
  },
  {
   "location": "440/SEL",
   "narrator": "",
   "text": "他に何がある？",
   "zh": "还有什么？",
   "narrator_zh": ""
  },
  {
   "location": "441/SEL",
   "narrator": "",
   "text": "神楽の話でもいいよ",
   "zh": "聊神乐的事也行哦",
   "narrator_zh": ""
  },
  {
   "location": "442/SEL",
   "narrator": "",
   "text": "神楽はお弁当作らないの？",
   "zh": "神乐不做便当吗？",
   "narrator_zh": ""
  },
  {
   "location": "443/ACT",
   "narrator": "",
   "text": "他に何がある？",
   "zh": "还有什么？",
   "narrator_zh": ""
  },
  {
   "location": "444/TALK",
   "narrator": "神楽",
   "text": "そうですね♪",
   "zh": "是啊♪",
   "narrator_zh": "神乐"
  },
  {
   "location": "445/TALK",
   "narrator": "神楽",
   "text": "でも今はみんなと話してますからまたの機会に♪",
   "zh": "不过现在正和大家说话，下次有机会♪",
   "narrator_zh": "神乐"
  },
  {
   "location": "446/ACT",
   "narrator": "",
   "text": "神楽の話でもいいよ",
   "zh": "聊神乐的事也行哦",
   "narrator_zh": ""
  },
  {
   "location": "447/TALK",
   "narrator": "神楽",
   "text": "いつもしてるじゃないですか\nﾔﾀﾞｰ"
  },
  {
   "location": "448/ACT",
   "narrator": "",
   "text": "神楽はお弁当作らないの？",
   "zh": "神乐不做便当吗？",
   "narrator_zh": ""
  },
  {
   "location": "449/TALK",
   "narrator": "神楽",
   "text": "ぴょんこはあんまり作らないですね～"
  },
  {
   "location": "450/TALK",
   "narrator": "神楽",
   "text": "気が向いたら作るかも♪"
  },
  {
   "location": "459/TALK",
   "narrator": "雛",
   "text": "うちは言えば\n作ってくれるとは\n思うけど。"
  },
  {
   "location": "461/TALK",
   "narrator": "繭",
   "text": "うちは自分で作れって\n言われる。\n確実に。"
  },
  {
   "location": "463/TALK",
   "narrator": "雛",
   "text": "神楽ちゃんのところは？"
  },
  {
   "location": "465/TALK",
   "narrator": "神楽",
   "text": "うちもちょっと\n無理だと思います。"
  },
  {
   "location": "466/TALK",
   "narrator": "雛",
   "text": "そっかー。\n高校生だとそう\nなっちゃうのかな。",
   "zh": "这样啊。\n高中生就会变成\n那样吗。",
   "narrator_zh": "雏"
  },
  {
   "location": "467/TALK",
   "narrator": "雛",
   "text": "うちはちょっと\n過保護なのかな？"
  },
  {
   "location": "468/TALK",
   "narrator": "神楽",
   "text": "…別にそういうことじゃ\nないと思いますよ。",
   "zh": "……我觉得并不是\n那个意思哦。",
   "narrator_zh": "神乐"
  },
  {
   "location": "469/TALK",
   "narrator": "雛",
   "text": "だよね！",
   "zh": "对吧！",
   "narrator_zh": "雏"
  },
  {
   "location": "471/TALK",
   "narrator": "つばめ",
   "text": "お父さんのお弁当、\nちょっと食べたく\nなっちゃったな…。",
   "zh": "爸爸做的便当，\n我有点想\n吃了呢……。",
   "narrator_zh": "燕"
  },
  {
   "location": "473/TALK",
   "narrator": "雛",
   "text": "あれ？\nホームシックに\nさせちゃったかな…。"
  },
  {
   "location": "475/TALK",
   "narrator": "神楽",
   "text": "……………。"
  },
  {
   "location": "476/TALK",
   "narrator": "神楽",
   "text": "ママのお弁当、か…。"
  },
  {
   "location": "376/DIALOG",
   "narrator": "Dialog_EventData",
   "text": "<color=green>某月某日　0:14 PM</color>\nとある平日の昼休み、付属学園食堂にて"
  }
 ]
}
