            "location": "438/TALK",
            "narrator": "千羽鶴",
            "text": "國政綾水が卯月神楽\nたちを倒せないと\n思っている内は――",
            "zh": "只要国政绫水还认为\n打不赢卯月神乐\n她们——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "439/TALK",
            "narrator": "千羽鶴",
            "text": "絶対に倒す事は\nできない。",
            "zh": "就绝对\n不可能打倒。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "440/SEL",
            "narrator": "（選択肢）",
            "text": "何故倒せないと思ってるの？",
            "zh": "为什么她会觉得打不赢？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "441/ACT",
            "narrator": "",
            "text": "何故倒せないと思ってるの？",
            "zh": "为什么她会觉得打不赢？",
            "narrator_zh": ""
        },
        {
            "location": "443/TALK",
            "narrator": "千羽鶴",
            "text": "さあ？\nそれは國政綾水本人に\n聞いてみたら？",
            "zh": "谁知道？\n这种事去问国政绫水\n本人不就好了？",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "444/TALK",
            "narrator": "千羽鶴",
            "text": "もう一度、\n挑戦してみるといい。",
            "zh": "再去试着\n挑战一次吧。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "480/ACT",
            "narrator": "",
            "text": "それは無理だと思う",
            "zh": "我觉得这办不到",
            "narrator_zh": ""
        },
        {
            "location": "484/TALK",
            "narrator": "アーヤ",
            "text": "どうして！？",
            "zh": "为什么！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "485/SEL",
            "narrator": "（選択肢）",
            "text": "えっと、ここって心の中だよね？",
            "zh": "那个，这里是你心里对吧？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "486/ACT",
            "narrator": "",
            "text": "えっと、ここって心の中だよね？",
            "zh": "那个，这里是你心里对吧？",
            "narrator_zh": ""
        },
        {
            "location": "488/TALK",
            "narrator": "アーヤ",
            "text": "だから何！？",
            "zh": "那又怎样！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "489/SEL",
            "narrator": "（選択肢）",
            "text": "あの二人はアーヤの妄想だよね？",
            "zh": "那两个人是绫水的妄想对吧？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "490/ACT",
            "narrator": "",
            "text": "あの二人はアーヤの妄想だよね？",
            "zh": "那两个人是绫水的妄想对吧？",
            "narrator_zh": ""
        },
        {
            "location": "492/TALK",
            "narrator": "アーヤ",
            "text": "それで！？",
            "zh": "然后呢！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "493/SEL",
            "narrator": "（選択肢）",
            "text": "アーヤが無理だと思ってるものは覆せないのでは？",
            "zh": "绫水自己都觉得不可能的事，岂不是没法推翻吗？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "494/ACT",
            "narrator": "",
            "text": "アーヤが無理だと思ってるものは覆せないのでは？",
            "zh": "绫水自己都觉得不可能的事，岂不是没法推翻吗？",
            "narrator_zh": ""
        },
        {
            "location": "497/TALK",
            "narrator": "アーヤ",
            "text": "そんなこと――",
            "zh": "那种事——",
            "narrator_zh": "绫水"
        },
        {
            "location": "498/TALK",
            "narrator": "分身アーヤ",
            "text": "そのとおり。\n$handle$が正解。",
            "zh": "说得没错。\n$handle$答对了。",
            "narrator_zh": "分身绫水"
        },
        {
            "location": "501/TALK",
            "narrator": "アーヤ",
            "text": "誰！？",
            "zh": "谁！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "518/TALK",
            "narrator": "分身アーヤ",
            "text": "やっと出てこれた。",
            "zh": "总算能出来了。",
            "narrator_zh": "分身绫水"
        },
        {
            "location": "520/TALK",
            "narrator": "分身アーヤ",
            "text": "ありがとう、\n$handle$。\n貴方のお陰。",
            "zh": "谢谢，\n$handle$。\n多亏了你。",
            "narrator_zh": "分身绫水"
        },
        {
            "location": "521/TALK",
            "narrator": "分身アーヤ",
            "text": "貴方が彼女に僅かな\n気の迷いを起こさせて\nくれたから。",
            "zh": "因为你让她\n产生了\n一丝动摇。",
            "narrator_zh": "分身绫水"
        },
        {
            "location": "522/SEL",
            "narrator": "（選択肢）",
            "text": "どういたしまして",
            "zh": "不客气",
            "narrator_zh": "（选项）"
        },
        {
            "location": "523/ACT",
            "narrator": "",
            "text": "どういたしまして",
            "zh": "不客气",
            "narrator_zh": ""
        },
        {
            "location": "525/TALK",
            "narrator": "アーヤ",
            "text": "気の迷いなんて\n全く無いわよ。",
            "zh": "我才没有\n什么动摇呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "529/TALK",
            "narrator": "アーヤ",
            "text": "貴方も見てたでしょ？\nこの前のチャット世界\nでのフェノメノン戦。",
            "zh": "你不也看到了吗？\n前阵子在聊天世界\n的那场PhenoMENON战。",
            "narrator_zh": "绫水"
        },
        {
            "location": "530/TALK",
            "narrator": "アーヤ",
            "text": "卯月は初参戦なのに、\nあんなにしっかりと\n立ち回れたり――",
            "zh": "卯月明明是初次参战，\n却能发挥得\n那么稳当——",
            "narrator_zh": "绫水"
        },
        {
            "location": "531/TALK",
            "narrator": "アーヤ",
            "text": "つばめなんてクランを\n一発で壊せる力を\n持っていたりする。",
            "zh": "至于燕，甚至拥有\n一击击溃库兰的\n力量。",
            "narrator_zh": "绫水"
        },
        {
            "location": "533/TALK",
            "narrator": "アーヤ",
            "text": "慣れてくれば、今より\nもっと活躍するように\nなってくる。",
            "zh": "等她们习惯之后，\n肯定会比现在\n更加活跃。",
            "narrator_zh": "绫水"
        },
        {
            "location": "534/TALK",
            "narrator": "アーヤ",
            "text": "そうなったら私なんて\nお払い箱よ！？",
            "zh": "真到那时候，我岂不是\n要被踢出局了！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "535/TALK",
            "narrator": "分身アーヤ",
            "text": "まだそんなの\nわからないでしょ？",
            "zh": "那种事现在\n还说不准吧？",
            "narrator_zh": "分身绫水"
        },
        {
            "location": "536/TALK",
            "narrator": "アーヤ",
            "text": "分かるわよ！\nいずれリーダーだって\n二人に奪われちゃう。",
            "zh": "怎么说不准！\n迟早连队长的位置\n也会被她们抢走的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "537/TALK",
            "narrator": "アーヤ",
            "text": "私なんて、いても\nいなくても変わらない\n存在になるから。",
            "zh": "像我这种人，\n就会变成在不在都一样的\n存在了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "540/TALK",
            "narrator": "分身アーヤ",
            "text": "はぁ……。",
            "zh": "唉……。",
            "narrator_zh": "分身绫水"
        },
        {
            "location": "542/TALK",
            "narrator": "分身アーヤ",
            "text": "$handle$、\n申し訳無いけど、\n手伝ってくれる？",
            "zh": "$handle$，\n不好意思，\n能帮个忙吗？",
            "narrator_zh": "分身绫水"
        },
        {
            "location": "543/TALK",
            "narrator": "分身アーヤ",
            "text": "この子を追い出すの。",
            "zh": "把这个孩子赶出去。",
            "narrator_zh": "分身绫水"
        },
        {
            "location": "544/SEL",
            "narrator": "（選択肢）",
            "text": "いいよ",
            "zh": "好啊",
            "narrator_zh": "（选项）"
        },
        {
            "location": "545/ACT",
            "narrator": "",
            "text": "いいよ",
            "zh": "好啊",
            "narrator_zh": ""
        },
        {
            "location": "549/TALK",
            "narrator": "アーヤ",
            "text": "追い出される\nもんですか！",
            "zh": "我才不会\n被赶出去呢！",
            "narrator_zh": "绫水"
        },
        {
            "location": "550/TALK",
            "narrator": "アーヤ",
            "text": "貴方のような脳天気な\n私の方が、私にとって\n有害な存在よ！",
            "zh": "像你这样没心没肺的\n我，才更是对我而言\n有害的存在吧！",
            "narrator_zh": "绫水"
        },
        {
            "location": "551/TALK",
            "narrator": "分身アーヤ",
            "text": "悲観的過ぎる方が\nよっぽど有害。",
            "zh": "太过悲观的这边\n才更有害得多。",
            "narrator_zh": "分身绫水"
        },
        {
            "location": "552/TALK",
            "narrator": "アーヤ",
            "text": "もういいわ。\nどっちがより有害か、\n戦えばすぐにわかる。",
            "zh": "够了。\n哪边更有害，\n打过就立刻见分晓。",
            "narrator_zh": "绫水"
        },
        {
            "location": "553/TALK",
            "narrator": "分身アーヤ",
            "text": "そうね。\n私もそう思ってた\nところよ。",
            "zh": "是啊。\n我正有此意\n呢。",
            "narrator_zh": "分身绫水"
        },
        {
            "location": "554/TALK",
            "narrator": "アーヤ",
            "text": "意見が一致して\n良かった。\nそれじゃ、いくわよ！",
            "zh": "意见能一致\n再好不过了。\n那就，来吧！",
            "narrator_zh": "绫水"
        },
        {
            "location": "555/TALK",
            "narrator": "分身アーヤ",
            "text": "臨むところよ！",
            "zh": "求之不得！",
            "narrator_zh": "分身绫水"
        },
        {
            "location": "567/DIALOG",
            "narrator": "",
            "text": "<color=black><size=50><b>自分を卑下する\n悲観的なアーヤを倒せ！</b></size></color>\n\n\n\n\n確かに新人たちはとても能力が高い。\nでもだからといって、\n今までの蓄積が全て無くなるわけじゃない。\n\n悲観的になりすぎている\nアーヤを倒して、\n彼女の自信を取り戻させよう。",
            "zh": "<color=black><size=50><b>打倒妄自菲薄的\n悲观绫水！</b></size></color>\n\n\n\n\n新人们确实能力很强。\n但即便如此，\n也不代表过去的积累就会化为乌有。\n\n打倒过于悲观的\n绫水，\n让她找回自信吧。",
            "narrator_zh": ""
        },
        {
            "location": "570/ACT",
            "narrator": "",
            "text": "アーヤのダイナミックな揺れで話に集中できません",
            "zh": "因为绫水这充满动感的晃动，没法集中精神听你说话",
            "narrator_zh": ""
        },
        {
            "location": "574/TALK",
            "narrator": "アーヤ",
            "text": "は！？",
            "zh": "哈！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "575/TALK",
            "narrator": "アーヤ",
            "text": "人が真面目に\n悩んでるのに\n何言ってるの！？",
            "zh": "我这边正认真\n烦恼呢，\n你在说什么啊！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "576/TALK",
            "narrator": "アーヤ",
            "text": "もういいです！\n出ていって！",
            "zh": "够了！\n请出去！",
            "narrator_zh": "绫水"
        },
        {
            "location": "590/TALK",
            "narrator": "千羽鶴",
            "text": "…強者ね。",
            "zh": "……真是强者啊。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "591/SEL",
            "narrator": "（選択肢）",
            "text": "眼福でした",
            "zh": "大饱眼福了",
            "narrator_zh": "（选项）"
        },
        {
            "location": "592/SEL",
            "narrator": "（選択肢）",
            "text": "息抜きも大切",
            "zh": "放松一下也很重要",
            "narrator_zh": "（选项）"
        },
        {
            "location": "593/ACT",
            "narrator": "",
            "text": "眼福でした",
            "zh": "大饱眼福了",
            "narrator_zh": ""
        },
        {
            "location": "594/ACT",
            "narrator": "",
            "text": "息抜きも大切",
            "zh": "放松一下也很重要",
            "narrator_zh": ""
        },
        {
            "location": "596/TALK",
            "narrator": "千羽鶴",
            "text": "そうね。",
            "zh": "是啊。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "597/TALK",
            "narrator": "千羽鶴",
            "text": "まあ、何度でも\nやり直せるし。",
            "zh": "反正，无论多少次\n都能重来。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "598/TALK",
            "narrator": "千羽鶴",
            "text": "$handle$が\nヒマなら何度\nやっても大丈夫。",
            "zh": "要是$handle$\n很闲的话，重来多少次\n都行。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "599/TALK",
            "narrator": "千羽鶴",
            "text": "けど、國政綾水と\nより強い絆を育みたい\nのなら――",
            "zh": "不过，如果你想和\n国政绫水培养\n更深的羁绊——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "600/TALK",
            "narrator": "千羽鶴",
            "text": "TPOをわきまえた\n選択もまた重要。",
            "zh": "懂得看场合做选择\n同样很重要。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "601/TALK",
            "narrator": "千羽鶴",
            "text": "まあ、小姑の説教は\nこれくらいにしておく。",
            "zh": "算了，婆婆妈妈的说教\n就到此为止。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "602/TALK",
            "narrator": "千羽鶴",
            "text": "最終的な判断は\n貴方がすることだから。",
            "zh": "毕竟最终做判断的人，\n是你。",
            "narrator_zh": "千羽鹤"
        }
    ]
}
