{
    "dir": "chap08/battle/btev_ch02_08_00.js",
    "type": "",
    "info": {
        "story_id": "22013",
        "cid": "",
        "title": "013 ココロスフィアストーリー【Lv05】",
        "sub_title": "転落人生＜提起＞",
        "title_zh": "013 心灵领域故事【Lv05】",
        "sub_title_zh": "坠落的人生＜提起＞"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "転落人生",
            "zh": "坠落的人生",
            "narrator_zh": ""
        },
        {
            "location": "13/DIALOG",
            "narrator": "",
            "text": "<size=40>KOKORO-Lv. 05</size>\nAYAMI - KUNIMASA\n\n<size=45>転落人生</size>\n<size=30>～私が地の底まで落ちる予定の経緯～</size>",
            "zh": "<size=40>KOKORO-Lv. 05</size>\n国政绫水\n\n<size=45>坠落的人生</size>\n<size=30>～我预定跌落谷底的原委～</size>",
            "narrator_zh": ""
        },
        {
            "location": "31/SEL",
            "narrator": "（選択肢）",
            "text": "！？",
            "zh": "！？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "32/ACT",
            "narrator": "",
            "text": "！？",
            "zh": "！？",
            "narrator_zh": ""
        },
        {
            "location": "37/TALK",
            "narrator": "つばめ",
            "text": "おはようー！",
            "zh": "早上好——！",
            "narrator_zh": "燕"
        },
        {
            "location": "38/TALK",
            "narrator": "つばめ",
            "text": "ふー。\n今日は遅刻しないで\n来れたよ！",
            "zh": "呼——。\n今天没迟到，\n赶上了呀！",
            "narrator_zh": "燕"
        },
        {
            "location": "39/SEL",
            "narrator": "（選択肢）",
            "text": "お、おう……",
            "zh": "哦、哦……",
            "narrator_zh": "（选项）"
        },
        {
            "location": "40/SEL",
            "narrator": "（選択肢）",
            "text": "えらいえらい",
            "zh": "真棒真棒",
            "narrator_zh": "（选项）"
        },
        {
            "location": "41/ACT",
            "narrator": "",
            "text": "お、おう……",
            "zh": "哦、哦……",
            "narrator_zh": ""
        },
        {
            "location": "42/TALK",
            "narrator": "つばめ",
            "text": "…？\nどうしたの？",
            "zh": "……？\n怎么了呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "43/ACT",
            "narrator": "",
            "text": "えらいえらい",
            "zh": "真棒真棒",
            "narrator_zh": ""
        },
        {
            "location": "45/TALK",
            "narrator": "つばめ",
            "text": "えへへ。\n$handle$に\n褒められちゃった。",
            "zh": "诶嘿嘿。\n被$handle$\n夸奖了。",
            "narrator_zh": "燕"
        },
        {
            "location": "52/TALK",
            "narrator": "神楽",
            "text": "つばめさん、\n$handle$さん、\nおはようございます！",
            "zh": "燕，\n$handle$，\n早上好！",
            "narrator_zh": "神乐"
        },
        {
            "location": "54/TALK",
            "narrator": "つばめ",
            "text": "おはよう、\n卯月さん！",
            "zh": "早上好，\n卯月！",
            "narrator_zh": "燕"
        },
        {
            "location": "59/TALK",
            "narrator": "高校生アーヤ",
            "text": "おはよう、\n３人とも。",
            "zh": "早上好，\n你们三个。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "62/TALK",
            "narrator": "つばめ",
            "text": "あ、アーヤちん\nおはよう！",
            "zh": "啊，小绫水\n早上好！",
            "narrator_zh": "燕"
        },
        {
            "location": "64/TALK",
            "narrator": "神楽",
            "text": "アーヤちゃん\nおはようございます！",
            "zh": "绫水\n早上好！",
            "narrator_zh": "神乐"
        },
        {
            "location": "65/SEL",
            "narrator": "（選択肢）",
            "text": "アーヤちん！？",
            "zh": "小绫水！？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "66/ACT",
            "narrator": "",
            "text": "アーヤちん！？",
            "zh": "小绫水！？",
            "narrator_zh": ""
        },
        {
            "location": "73/TALK",
            "narrator": "つばめ",
            "text": "えっ！？\nわたし、何か\n変な事言った？",
            "zh": "诶！？\n我说了什么\n奇怪的话吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "74/TALK",
            "narrator": "高校生アーヤ",
            "text": "どうしたの？\n$handle$、まだ\n寝ぼけてるでしょ。",
            "zh": "怎么了？\n$handle$，你还没\n睡醒吧。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "75/TALK",
            "narrator": "高校生アーヤ",
            "text": "もう１時間早く起きて\n走り込みすると、朝の\n調子が良くなるわよ？",
            "zh": "早起一小时去跑步，\n早上的状态\n会变好哦？",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "82/TALK",
            "narrator": "高校生アーヤ",
            "text": "それよりみんな、\nもう貼り出されてる\nみたいよ。",
            "zh": "不说那个，大家，\n好像已经\n张贴出来了哦。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "83/TALK",
            "narrator": "高校生アーヤ",
            "text": "先週の期末テストの\n順位。",
            "zh": "上周期末考试的\n排名。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "85/TALK",
            "narrator": "つばめ",
            "text": "ええええええっ！！\nもう結果\n出ちゃってるの？",
            "zh": "诶诶诶诶诶！！\n结果已经\n出来了吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "86/TALK",
            "narrator": "高校生アーヤ",
            "text": "逢瀬さん、\n今回のテストの\n自信のほどは？",
            "zh": "逢濑，\n这次考试\n有几成把握？",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "88/TALK",
            "narrator": "つばめ",
            "text": "うーん…\nあんま無いかな。",
            "zh": "嗯——……\n大概没什么把握呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "90/TALK",
            "narrator": "つばめ",
            "text": "転校して初めてのテスト\nだったけど、前の学校\nより難しかったし…。",
            "zh": "毕竟是转学后的第一次\n考试，而且也比\n以前的学校难……。",
            "narrator_zh": "燕"
        },
        {
            "location": "91/TALK",
            "narrator": "つばめ",
            "text": "結構わかんないとこ\n多くて、勘でマーク\nしたりしてたよ…。",
            "zh": "好多地方我都不会，\n涂答题卡都是靠蒙的\n呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "92/TALK",
            "narrator": "高校生アーヤ",
            "text": "卯月さんは\nどうだった？",
            "zh": "卯月\n考得怎么样？",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "93/TALK",
            "narrator": "神楽",
            "text": "私も…どうでしょう。",
            "zh": "我也……不好说呢。",
            "narrator_zh": "神乐"
        },
        {
            "location": "94/TALK",
            "narrator": "神楽",
            "text": "つばめさんと同じく、\n転校して初めてなので\n何とも言えませんけど。",
            "zh": "我也和燕一样，\n毕竟是转学后头一次，\n不好说呢。",
            "narrator_zh": "神乐"
        },
        {
            "location": "95/TALK",
            "narrator": "神楽",
            "text": "正直なところ、\nつばめさんと同じで\nかなり苦戦しました。",
            "zh": "说实话，\n我和燕一样，\n考得相当吃力。",
            "narrator_zh": "神乐"
        },
        {
            "location": "97/TALK",
            "narrator": "つばめ",
            "text": "アーヤちゃんは\nいつも１０番以内\nなんでしょ？",
            "zh": "绫水\n每次都是前10名\n对吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "98/TALK",
            "narrator": "神楽",
            "text": "そうですよ！\n噂聞きましたよ？\n羨ましいです！",
            "zh": "就是说呀！\n我听说传闻了哦？\n好羡慕啊！",
            "narrator_zh": "神乐"
        },
        {
            "location": "100/TALK",
            "narrator": "高校生アーヤ",
            "text": "そ、それは\n言い過ぎよ？",
            "zh": "这、这就\n说得太夸张了吧？",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "102/TALK",
            "narrator": "高校生アーヤ",
            "text": "まあ、身を削って勉強\nしてるし、そうでないと\n困るんだけど……。",
            "zh": "不过，我确实是拼命在\n学习，要是不在前列\n也说不过去就是了……。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "104/TALK",
            "narrator": "高校生アーヤ",
            "text": "さあ、空いてる今の\nうちに見に行きましょ。",
            "zh": "好了，趁现在人少，\n我们过去看看吧。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "107/TALK",
            "narrator": "つばめ",
            "text": "あっ、待って\nアーヤちゃん！",
            "zh": "啊，等等，\n绫水！",
            "narrator_zh": "燕"
        },
        {
            "location": "114/TALK",
            "narrator": "千羽鶴",
            "text": "さあ、早く行かないと\n彼女達を見失うわよ。",
            "zh": "快点，再不走\n就要跟丢她们了。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "133/TALK",
            "narrator": "高校生アーヤ",
            "text": "え……うそ……",
            "zh": "诶……不会吧……",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "136/TALK",
            "narrator": "つばめ",
            "text": "すごーい！！\n卯月さん１番だよ！",
            "zh": "好厉害——！！\n卯月是第1名呀！",
            "narrator_zh": "燕"
        },
        {
            "location": "139/TALK",
            "narrator": "神楽",
            "text": "始めてでしたし、何を\n勉強すればいいかわかり\nませんでしたけど――",
            "zh": "因为是第一次，\n也不知道该复习\n什么才好——",
            "narrator_zh": "神乐"
        },
        {
            "location": "140/TALK",
            "narrator": "神楽",
            "text": "良い結果がでて\n良かったです！",
            "zh": "能考出好成绩，\n真是太好了！",
            "narrator_zh": "神乐"
        },
        {
            "location": "142/TALK",
            "narrator": "つばめ",
            "text": "卯月さんって、すごい\n頭よかったんだね！\nびっくりだよ。",
            "zh": "原来卯月这么\n聪明呀！\n吓了一跳呢。",
            "narrator_zh": "燕"
        },
        {
            "location": "144/TALK",
            "narrator": "神楽",
            "text": "つばめさんこそ、\n３位なんて\nすごいじゃないですか。",
            "zh": "燕才是，\n考到第3名\n不是很厉害吗。",
            "narrator_zh": "神乐"
        },
        {
            "location": "146/TALK",
            "narrator": "つばめ",
            "text": "わ、わたしは本当に\nマークシートを適当に\n埋めただけだし……",
            "zh": "我、我真的只是\n把答题卡随便\n涂满而已……",
            "narrator_zh": "燕"
        },
        {
            "location": "147/TALK",
            "narrator": "つばめ",
            "text": "卯月さんとは\n全然ちがうよ……。",
            "zh": "和卯月\n完全不一样呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "149/TALK",
            "narrator": "神楽",
            "text": "そんなこと\nありません！",
            "zh": "才没有\n这种事！",
            "narrator_zh": "神乐"
        },
        {
            "location": "150/TALK",
            "narrator": "神楽",
            "text": "適当にやって３位なら\n頑張ったら1位余裕\nですよ？",
            "zh": "随便做做就能第3名，\n要是认真起来，\n拿第1还不是轻轻松松？",
            "narrator_zh": "神乐"
        },
        {
            "location": "151/TALK",
            "narrator": "つばめ",
            "text": "えへへ。\nそうかなぁ。",
            "zh": "诶嘿嘿。\n是这样吗。",
            "narrator_zh": "燕"
        },
        {
            "location": "153/TALK",
            "narrator": "高校生アーヤ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "155/TALK",
            "narrator": "つばめ",
            "text": "アーヤちゃんも\n９番なんてすごいね！",
            "zh": "绫水也\n拿了第9名，好厉害呀！",
            "narrator_zh": "燕"
        },
        {
            "location": "157/TALK",
            "narrator": "高校生アーヤ",
            "text": "…え？\nあ、ああ、ありがと…",
            "zh": "……诶？\n啊、啊啊，谢谢……",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "168/TALK",
            "narrator": "真幌",
            "text": "卯月、逢瀬。\n今回は頑張ったな。",
            "zh": "卯月、逢濑。\n这次表现不错啊。",
            "narrator_zh": "真幌"
        },
        {
            "location": "169/TALK",
            "narrator": "つばめ",
            "text": "あ、先生！\nおはようございます！",
            "zh": "啊，老师！\n早上好！",
            "narrator_zh": "燕"
        },
        {
            "location": "170/TALK",
            "narrator": "神楽",
            "text": "おはようございます！",
            "zh": "早上好！",
            "narrator_zh": "神乐"
        },
        {
            "location": "172/TALK",
            "narrator": "真幌",
            "text": "まさか転校早々、\n学年トップになるとは\n思いもしなかったよ。",
            "zh": "真没想到刚转学过来，\n就拿了\n年级第一名啊。",
            "narrator_zh": "真幌"
        },
        {
            "location": "173/TALK",
            "narrator": "真幌",
            "text": "これは今後に\n期待大だな。",
            "zh": "这下可让人\n对你们今后大为期待了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "175/TALK",
            "narrator": "神楽",
            "text": "ありがとう\nございます！",
            "zh": "谢谢\n老师！",
            "narrator_zh": "神乐"
        },
        {
            "location": "176/TALK",
            "narrator": "真幌",
            "text": "ゆくゆくは生徒会長に\nなって、この学校を\nリードしてくれ。",
            "zh": "将来就由你们当上\n学生会长，来带领\n这所学校吧。",
            "narrator_zh": "真幌"
        },
        {
            "location": "178/TALK",
            "narrator": "高校生アーヤ",
            "text": "えっ！？！？",
            "zh": "诶！？！？",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "179/TALK",
            "narrator": "神楽",
            "text": "はいっ！\nがんばりますっ！",
            "zh": "是！\n我会加油的！",
            "narrator_zh": "神乐"
        },
        {
            "location": "181/TALK",
            "narrator": "真幌",
            "text": "さて、お前たち。\nそろそろ１時間目の\n体育が始まるぞ。",
            "zh": "好了，你们几个。\n第一节课的体育\n快开始了哦。",
            "narrator_zh": "真幌"
        },
        {
            "location": "182/TALK",
            "narrator": "真幌",
            "text": "遅れずに校庭に\n集合しろよ。",
            "zh": "别迟到，去操场\n集合啊。",
            "narrator_zh": "真幌"
        },
        {
            "location": "183/TALK",
            "narrator": "つばめ",
            "text": "は、はいっ！",
            "zh": "好、好的！",
            "narrator_zh": "燕"
        },
        {
            "location": "185/TALK",
            "narrator": "高校生アーヤ",
            "text": "卯月さんと逢瀬さんが\n生徒会長候補！？",
            "zh": "卯月和逢濑\n成了学生会长候选人！？",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "187/TALK",
            "narrator": "高校生アーヤ",
            "text": "そんな……\n私は！？\n今までの努力は？？",
            "zh": "怎么这样……\n那我呢！？\n我迄今为止的努力算什么？？",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "190/TALK",
            "narrator": "神楽",
            "text": "今日は長距離走\nだそうですよ？\nとっても憂鬱です…。",
            "zh": "听说今天要跑\n长跑哦？\n好郁闷啊……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "192/TALK",
            "narrator": "つばめ",
            "text": "えー…\nわたしも長距離走は\n苦手だよ。",
            "zh": "诶——……\n我也不擅长\n长跑呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "198/TALK",
            "narrator": "神楽",
            "text": "アーヤさんは何年も\n長距離走の代表選手\nだったんですよね？",
            "zh": "绫水你连续好几年\n都是长跑的代表选手，\n对吧？",
            "narrator_zh": "神乐"
        },
        {
            "location": "200/TALK",
            "narrator": "高校生アーヤ",
            "text": "えっ！？",
            "zh": "诶！？",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "203/TALK",
            "narrator": "高校生アーヤ",
            "text": "え、ええ、そうね。\n県大会とかにも出た\nことあるくらいには。",
            "zh": "啊、嗯，算是吧。\n好歹也是参加过\n县大赛之类的水平。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "204/TALK",
            "narrator": "つばめ",
            "text": "すごーい！！\nいいなぁ……。",
            "zh": "好厉害——！！\n真好呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "206/TALK",
            "narrator": "高校生アーヤ",
            "text": "そ、そうよね。\n勉強では負けても、\nスポーツなら……",
            "zh": "也、也是呢。\n就算学习输了，\n只要在体育上……",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "207/TALK",
            "narrator": "高校生アーヤ",
            "text": "剣道だって世界選手権\nに出場したりしてるん\nだから……。",
            "zh": "毕竟我连剑道\n世界锦标赛都\n参加过……。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "210/TALK",
            "narrator": "高校生アーヤ",
            "text": "さあ、早く着替えて\n行きましょ。",
            "zh": "好了，快点去换衣服\n出发吧。",
            "narrator_zh": "高中生绫水"
        },
        {
            "location": "249/TALK",
            "narrator": "透明つばめ",
            "text": "はぁ……はぁ…\nもうだめー…限界！",
            "zh": "哈啊……哈啊……\n不行了——……到极限了！",
            "narrator_zh": "透明燕"
        },
        {
            "location": "250/TALK",
            "narrator": "透明神楽",
            "text": "あともう少しですよっ！\n頑張りましょう！",
            "zh": "就差一点点了！\n加油吧！",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "252/TALK",
            "narrator": "透明つばめ",
            "text": "卯月さんすごいよ。\n速すぎー！",
            "zh": "卯月好厉害呀。\n跑太快了——！",
            "narrator_zh": "透明燕"
        },
        {
            "location": "254/TALK",
            "narrator": "透明神楽",
            "text": "つばめさんこそ\n十分速いですよ？",
            "zh": "燕你才\n已经够快了呢？",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "256/TALK",
            "narrator": "透明神楽",
            "text": "途中迷子になったときは\nどうしようかと\n思いましたけど。",
            "zh": "中途你迷路的时候，\n我还想着\n这下可怎么办呢。",
            "narrator_zh": "透明神乐"
        },
        {
            "location": "258/TALK",
            "narrator": "透明つばめ",
            "text": "わたしももう、\n戻って来れないかと\n思ってたよ……",
            "zh": "我也以为自己\n再也回不来了\n呀……",
            "narrator_zh": "透明燕"
        },
        {
            "location": "260/TALK",
            "narrator": "透明アーヤ",
            "text": "う、うそでしょ！？",
            "zh": "不、不会吧！？",
            "narrator_zh": "透明绫水"
        },
        {
            "location": "261/TALK",
            "narrator": "透明アーヤ",
            "text": "なんであの二人の方が\n私より速いわけ！？",
