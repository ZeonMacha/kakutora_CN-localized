        "sub_title_zh": "恸哭＜前篇＞"
    },
    "entry": [
        {
            "location": "41/TALK",
            "narrator": "アーヤ",
            "text": "もうこんな時間…。\nみんな、そろそろ\n寝る準備するわよ。",
            "zh": "已经这个时间了……。\n大家，差不多\n准备睡觉了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "43/TALK",
            "narrator": "ガブリエラ",
            "text": "まだ平気よ。\nもう少しいいでしょ？",
            "zh": "还没事。\n再一会儿可以吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "46/TALK",
            "narrator": "アーヤ",
            "text": "ダメよ。\n明日も朝から\n訓練なんだから。",
            "zh": "不行。\n明天一早\n还有训练。",
            "narrator_zh": "绫水"
        },
        {
            "location": "48/TALK",
            "narrator": "ガブリエラ",
            "text": "あーあ、明日雨が\n降ればいいのに…。",
            "zh": "啊——，明天要是\n下雨就好了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "50/TALK",
            "narrator": "つばめ",
            "text": "そうなったら\n一日お休みになるし。",
            "zh": "那样的话\n就能休息一天。",
            "narrator_zh": "燕"
        },
        {
            "location": "51/TALK",
            "narrator": "つばめ",
            "text": "お休みになったら\nちょっとお買い物に\n行きたいな。",
            "zh": "休息的话\n我想去\n买点东西。",
            "narrator_zh": "燕"
        },
        {
            "location": "54/TALK",
            "narrator": "ガブリエラ",
            "text": "あのねぇ…つばめは\nそんなこと言ってる\n余裕ないでしょ？",
            "zh": "我说啊……燕\n现在可没余力\n说这种话吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "55/TALK",
            "narrator": "ガブリエラ",
            "text": "今日の模擬戦、\n何回あたし達に\n負けたか覚えてる？",
            "zh": "今天的模拟战，\n输给我们\n几次，还记得吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "57/TALK",
            "narrator": "つばめ",
            "text": "あ、あれでも\n頑張ったんだよ。\nね？",
            "zh": "那、那我也\n有努力的呀。\n对吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "59/TALK",
            "narrator": "神楽",
            "text": "そうです。\nこれでも一生懸命\nだったんですよ？",
            "zh": "是的。\n这也是很努力\n了的。",
            "narrator_zh": "神乐"
        },
        {
            "location": "61/TALK",
            "narrator": "ガブリエラ",
            "text": "結果出さなきゃ\n意味ないわよ。",
            "zh": "拿不出结果\n就没意义。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "63/TALK",
            "narrator": "アーヤ",
            "text": "…まあ、ギャヴィの\n言うことも間違っては\nいないわね。",
            "zh": "……嘛，加维说的\n也不是\n不对。",
            "narrator_zh": "绫水"
        },
        {
            "location": "65/TALK",
            "narrator": "アーヤ",
            "text": "二人が頑張ってるのは\nわかるわ。",
            "zh": "我知道你们两个\n在努力。",
            "narrator_zh": "绫水"
        },
        {
            "location": "66/TALK",
            "narrator": "アーヤ",
            "text": "だけど、\n空回りしてるって\nいうか。",
            "zh": "可是，\n说是在空转\n吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "67/TALK",
            "narrator": "アーヤ",
            "text": "訓練に集中できてない\nように思ったわ。",
            "zh": "我觉得你们\n没法把心思放在训练上。",
            "narrator_zh": "绫水"
        },
        {
            "location": "70/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "74/TALK",
            "narrator": "つばめ",
            "text": "そ、そんなこと\nないです！",
            "zh": "才、才没有\n那种事！",
            "narrator_zh": "燕"
        },
        {
            "location": "75/TALK",
            "narrator": "つばめ",
            "text": "ガブちゃん達が\n強過ぎるだけですよ。",
            "zh": "只是加布她们\n太强了。",
            "narrator_zh": "燕"
        },
        {
            "location": "76/TALK",
            "narrator": "ガブリエラ",
            "text": "まあ、あたし達が\n強すぎるっていうのは\n当然よね。",
            "zh": "嘛，我们太强\n这点是\n当然的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "77/TALK",
            "narrator": "ガブリエラ",
            "text": "経験もチームワークも\nつばめ達以上なわけ\nだし。",
            "zh": "经验和配合\n都在燕她们\n之上。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "78/TALK",
            "narrator": "つばめ",
            "text": "明日は今日より\nもっと勝つよ。",
            "zh": "明天会比今天\n赢更多。",
            "narrator_zh": "燕"
        },
        {
            "location": "79/TALK",
            "narrator": "ガブリエラ",
            "text": "無理だと思うけど？",
            "zh": "我觉得不可能？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "81/TALK",
            "narrator": "つばめ",
            "text": "絶対勝つよ！\nね、神楽ちゃ――",
            "zh": "绝对会赢！\n对吧，神乐——",
            "narrator_zh": "燕"
        },
        {
            "location": "84/TALK",
            "narrator": "つばめ",
            "text": "…あれ？\n神楽ちゃん？",
            "zh": "……咦？\n神乐？",
            "narrator_zh": "燕"
        },
        {
            "location": "108/TALK",
            "narrator": "神楽",
            "text": "はぁ…。",
            "zh": "哈啊……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "109/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "110/TALK",
            "narrator": "つばめ",
            "text": "神楽ちゃん。",
            "zh": "神乐。",
            "narrator_zh": "燕"
        },
        {
            "location": "116/TALK",
            "narrator": "つばめ",
            "text": "よかった…。\nどこ行ったのかと\n思ったよ。",
            "zh": "太好了……。\n我还以为你\n去哪儿了。",
            "narrator_zh": "燕"
        },
        {
            "location": "117/TALK",
            "narrator": "神楽",
            "text": "…すみません。",
            "zh": "……对不起。",
            "narrator_zh": "神乐"
        },
        {
            "location": "118/TALK",
            "narrator": "つばめ",
            "text": "あ、別に謝るような\nことじゃ――",
            "zh": "啊，不是什么\n需要道歉的——",
            "narrator_zh": "燕"
        },
        {
            "location": "120/TALK",
            "narrator": "神楽",
            "text": "模擬戦で負けたの、\n私のせいです…。",
            "zh": "模拟战输掉，\n是我的错……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "121/TALK",
            "narrator": "神楽",
            "text": "なんだか、心の中が\nモヤモヤしちゃって、\n集中できなくて…。",
            "zh": "总觉得心里\n闷闷的，\n集中不了……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "123/TALK",
            "narrator": "神楽",
            "text": "本当、すみません…。",
            "zh": "真的，对不起……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "124/TALK",
            "narrator": "つばめ",
            "text": "…ううん。\nそんなことないよ。",
            "zh": "……不。\n不是那样。",
            "narrator_zh": "燕"
        },
        {
            "location": "125/TALK",
            "narrator": "つばめ",
            "text": "わたしだって、\n全然ガブちゃん達に\n敵わなかったし。",
            "zh": "我自己也\n完全打不过\n加布她们。",
            "narrator_zh": "燕"
        },
        {
            "location": "126/TALK",
            "narrator": "つばめ",
            "text": "神楽ちゃんだけの\nせいじゃないよ。",
            "zh": "不是神乐一个人的\n错呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "133/TALK",
            "narrator": "神楽",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "神乐"
        },
        {
            "location": "135/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "147/TALK",
            "narrator": "つばめ",
            "text": "神楽ちゃん",
            "zh": "神乐",
            "narrator_zh": "燕"
        },
        {
            "location": "148/TALK",
            "narrator": "つばめ",
            "text": "落ち込んじゃってる(´･ω･｀) ",
            "zh": "失落了(´･ω･｀) ",
            "narrator_zh": "燕"
        },
        {
            "location": "149/TALK",
            "narrator": "つばめ",
            "text": "今日のこと",
            "zh": "今天的事",
            "narrator_zh": "燕"
        },
        {
            "location": "151/TALK",
            "narrator": "つばめ",
            "text": "気にしちゃってるのかな？(･ｪ･^ )( ^･ｪ･)",
            "zh": "是在意这个吗？(･ｪ･^ )( ^･ｪ･)",
            "narrator_zh": "燕"
        },
        {
            "location": "153/SEL",
            "narrator": "",
            "text": "それだけが理由かな？",
            "zh": "只有这个原因吗？",
            "narrator_zh": ""
        },
        {
            "location": "154/ACT",
            "narrator": "",
            "text": "それだけが理由かな？",
            "zh": "只有这个原因吗？",
            "narrator_zh": ""
        },
        {
            "location": "156/TALK",
            "narrator": "つばめ",
            "text": "わからない",
            "zh": "不知道",
            "narrator_zh": "燕"
        },
        {
            "location": "157/TALK",
            "narrator": "つばめ",
            "text": "最近",
            "zh": "最近",
            "narrator_zh": "燕"
        },
        {
            "location": "158/TALK",
            "narrator": "つばめ",
            "text": "色々ぁったから(o´Д`)=з",
            "zh": "发生了好多事(o´Д`)=з",
            "narrator_zh": "燕"
        },
        {
            "location": "161/TALK",
            "narrator": "つばめ",
            "text": "もしかして",
            "zh": "难道",
            "narrator_zh": "燕"
        },
        {
            "location": "162/TALK",
            "narrator": "つばめ",
            "text": "それ全部が理由？(･Д･｀)",
            "zh": "全部都是原因？(･Д･｀)",
            "narrator_zh": "燕"
        },
        {
            "location": "164/SEL",
            "narrator": "",
            "text": "なら、そっとしておいた方がいいかも",
            "zh": "那也许先别打扰比较好",
            "narrator_zh": ""
        },
        {
            "location": "165/ACT",
            "narrator": "",
            "text": "なら、そっとしておいた方がいいかも",
            "zh": "那也许先别打扰比较好",
            "narrator_zh": ""
        },
        {
            "location": "167/TALK",
            "narrator": "つばめ",
            "text": "できなぃよΣ(ﾟдﾟlll)",
            "zh": "做不到呀Σ(ﾟдﾟlll)",
            "narrator_zh": "燕"
        },
        {
            "location": "168/TALK",
            "narrator": "つばめ",
            "text": "こんなに元気なぃのに",
            "zh": "她这么没精神",
            "narrator_zh": "燕"
        },
        {
            "location": "169/TALK",
            "narrator": "つばめ",
            "text": "そっとしてぉくだけなんて",
            "zh": "只是放着不管什么的",
            "narrator_zh": "燕"
        },
        {
            "location": "170/TALK",
            "narrator": "つばめ",
            "text": "かわぃそうだよ(´つω・｀)ｼｭﾝ",
            "zh": "太可怜了呀(´つω・｀)ｼｭﾝ",
            "narrator_zh": "燕"
        },
        {
            "location": "172/SEL",
            "narrator": "",
            "text": "考える時間は必要だよ？",
            "zh": "思考的时间也是需要的哦？",
            "narrator_zh": ""
        },
        {
            "location": "173/ACT",
            "narrator": "",
            "text": "考える時間は必要だよ？",
            "zh": "思考的时间也是需要的哦？",
            "narrator_zh": ""
        },
        {
            "location": "175/TALK",
            "narrator": "つばめ",
            "text": "そぅかもしれなぃけど",
            "zh": "也许是这样",
            "narrator_zh": "燕"
        },
        {
            "location": "176/TALK",
            "narrator": "つばめ",
            "text": "でも",
            "zh": "可是",
            "narrator_zh": "燕"
        },
        {
            "location": "242/TALK",
            "narrator": "つばめ",
            "text": "　",
            "zh": "　",
            "narrator_zh": "燕"
        },
        {
            "location": "257/TALK",
            "narrator": "つばめの新司書",
            "text": "こんにちは、\n$handle$さん。",
            "zh": "你好，\n$handle$。",
            "narrator_zh": "燕的新司书"
        },
        {
            "location": "258/TALK",
            "narrator": "つばめの新司書",
            "text": "今日は特報があります。",
            "zh": "今天有特别消息。",
            "narrator_zh": "燕的新司书"
        },
        {
            "location": "259/TALK",
            "narrator": "つばめの新司書",
            "text": "ついにわたしが\n本気を出すときが\nやってきたようです。",
            "zh": "终于到了\n我要认真起来的\n时候了。",
            "narrator_zh": "燕的新司书"
        },
        {
            "location": "260/SEL",
            "narrator": "",
            "text": "マジですか！",
            "zh": "是真的吗！",
            "narrator_zh": ""
        },
        {
            "location": "261/SEL",
            "narrator": "",
            "text": "どういう方向性の本気でしょうか",
            "zh": "是往哪个方向认真？",
            "narrator_zh": ""
        },
        {
            "location": "262/ACT",
            "narrator": "",
            "text": "マジですか！",
            "zh": "是真的吗！",
            "narrator_zh": ""
        },
        {
            "location": "263/TALK",
            "narrator": "つばめの新司書",
            "text": "マジです。",
            "zh": "是真的。",
            "narrator_zh": "燕的新司书"
        },
        {
            "location": "264/ACT",
            "narrator": "",
            "text": "どういう方向性の本気でしょうか",
            "zh": "是往哪个方向认真？",
            "narrator_zh": ""
        },
        {
            "location": "265/TALK",
            "narrator": "つばめの新司書",
            "text": "ちょっと怖目の\n本気です。",
            "zh": "稍微偏可怕的\n认真。",
            "narrator_zh": "燕的新司书"
        },
        {
            "location": "266/SEL",
            "narrator": "",
            "text": "いよいよか……",
            "zh": "终于来了……",
            "narrator_zh": ""
        },
        {
            "location": "267/SEL",
            "narrator": "",
            "text": "えーやだ、こわいよ…(TT)",
            "zh": "诶不要，好可怕……(TT)",
            "narrator_zh": ""
        },
        {
            "location": "268/ACT",
            "narrator": "",
            "text": "いよいよか……",
            "zh": "终于来了……",
            "narrator_zh": ""
        },
        {
            "location": "269/TALK",
            "narrator": "つばめの新司書",
            "text": "その通りです。\n覚悟はいいですか？",
            "zh": "正是如此。\n准备好了吗？",
            "narrator_zh": "燕的新司书"
        },
        {
            "location": "270/ACT",
            "narrator": "",
            "text": "えーやだ、こわいよ…(TT)",
            "zh": "诶不要，好可怕……(TT)",
            "narrator_zh": ""
        },
        {
            "location": "271/TALK",
            "narrator": "つばめの新司書",
            "text": "……。\n怖がりさんですか？",
            "zh": "……。\n你很胆小吗？",
            "narrator_zh": "燕的新司书"
        },
        {
            "location": "272/TALK",
            "narrator": "つばめの新司書",
            "text": "でも、それは困ります。\n怖くしないと上司から\n怒られてしまうので。",
            "zh": "那可就麻烦了。\n不吓人的话，\n会被上司骂。",
            "narrator_zh": "燕的新司书"
        },
        {
            "location": "274/TALK",
            "narrator": "つばめの新司書",
            "text": "でも、\n$handle$さんが\nかわい――",
            "zh": "不过，\n$handle$\n很可——",
            "narrator_zh": "燕的新司书"
        },
        {
            "location": "275/TALK",
            "narrator": "つばめの新司書",
            "text": "……そうなので、\n頑張ってなるべく優しく\nするようにします！",
            "zh": "……既然是这样，\n我会尽量\n温柔一点！",
            "narrator_zh": "燕的新司书"
        },
        {
            "location": "276/SEL",
            "narrator": "",
            "text": "ありがとう(TT)",
            "zh": "谢谢(TT)",
            "narrator_zh": ""
        },
        {
            "location": "277/ACT",
            "narrator": "",
            "text": "ありがとう(TT)",
            "zh": "谢谢(TT)",
            "narrator_zh": ""
        },
        {
            "location": "279/TALK",
            "narrator": "つばめの新司書",
            "text": "…よ、よしよし。\nいいこいいこ。",
            "zh": "……好、好了好了。\n乖乖。",
            "narrator_zh": "燕的新司书"
        },
        {
            "location": "283/TALK",
            "narrator": "つばめの新司書",
            "text": "というわけで\n早速ですが。",
            "zh": "那么\n说正事。",
            "narrator_zh": "燕的新司书"
        },
        {
            "location": "284/TALK",
            "narrator": "つばめの新司書",
            "text": "これから\n$handle$さんには\nわたしと同行願います。",
            "zh": "接下来\n请$handle$\n与我同行。",
            "narrator_zh": "燕的新司书"
        },
        {
            "location": "285/SEL",
            "narrator": "",
            "text": "どこへ？",
            "zh": "去哪儿？",
            "narrator_zh": ""
        },
        {
            "location": "286/ACT",
            "narrator": "",
            "text": "どこへ？",
            "zh": "去哪儿？",
            "narrator_zh": ""
        },
        {
            "location": "288/TALK",
            "narrator": "つばめの新司書",
            "text": "元司書が\nいるところへです。",
            "zh": "原司书\n所在的地方。",
            "narrator_zh": "燕的新司书"
        },
        {
            "location": "289/SEL",
            "narrator": "",
            "text": "どうして急に！？",
            "zh": "为什么这么突然！？",
            "narrator_zh": ""
        },
        {
            "location": "290/SEL",
            "narrator": "",
            "text": "今どうしてるの！？",
            "zh": "她现在怎么样了！？",
            "narrator_zh": ""
        },
        {
            "location": "291/ACT",
            "narrator": "",
            "text": "どうして急に！？",
            "zh": "为什么这么突然！？",
            "narrator_zh": ""
        },
        {
            "location": "292/TALK",
            "narrator": "つばめの新司書",
            "text": "上司から\n連絡がありまして。",
            "zh": "上司\n联系我了。",
            "narrator_zh": "燕的新司书"
        },
        {
            "location": "293/ACT",
            "narrator": "",
            "text": "今どうしてるの！？",
            "zh": "她现在怎么样了！？",
            "narrator_zh": ""
        },
        {
            "location": "294/TALK",
            "narrator": "つばめの新司書",
            "text": "然るべき場所で\n再教育中です。",
            "zh": "在该在的地方\n接受再教育。",
            "narrator_zh": "燕的新司书"
        },
        {
            "location": "295/TALK",
            "narrator": "つばめの新司書",
            "text": "わたしをより\n洗練されたわたしにする\n為に必要な教育です。",
            "zh": "为了把我\n做成更精炼的我，\n所必需的教育。",
            "narrator_zh": "燕的新司书"
        },
        {
            "location": "296/TALK",
            "narrator": "つばめの新司書",
            "text": "で、先ほど上司から\n連絡がありまして。",
            "zh": "然后，刚才上司\n联系过来了。",
            "narrator_zh": "燕的新司书"
        },
        {
            "location": "298/TALK",
            "narrator": "つばめの新司書",
            "text": "元司書が危険な思想から\n脱することができたか\nそれともダメなのか。",
            "zh": "原司书能不能\n从危险思想里\n脱离，还是不行。",
            "narrator_zh": "燕的新司书"
        },
        {
            "location": "299/TALK",
            "narrator": "つばめの新司書",
            "text": "今日それが\nわかるそうなので、\n検査をしに行きます。",
            "zh": "今天似乎\n就能知道，\n所以去检查。",
            "narrator_zh": "燕的新司书"
        },
        {
            "location": "300/TALK",
            "narrator": "つばめの新司書",
            "text": "そのテストに\n立ち会ってください。",
            "zh": "请你出席\n那场测试。",
            "narrator_zh": "燕的新司书"
        },
        {
            "location": "301/SEL",
            "narrator": "",
            "text": "脱してたら？",
            "zh": "脱离了的话？",
            "narrator_zh": ""
        },
        {
            "location": "302/SEL",
            "narrator": "",
            "text": "ダメだったら？",
            "zh": "不行的话？",
            "narrator_zh": ""
        },
        {
            "location": "303/ACT",
            "narrator": "",
            "text": "脱してたら？",
            "zh": "脱离了的话？",
            "narrator_zh": ""
        },
        {
            "location": "304/TALK",
            "narrator": "つばめの新司書",
            "text": "わたしと一緒に\n二交代制で勤務します。",
            "zh": "会和我一起\n两班倒值班。",
            "narrator_zh": "燕的新司书"
        },
        {
            "location": "305/TALK",
            "narrator": "つばめの新司書",
            "text": "とても楽になるので、\nわたし個人としては\nオススメの未来です。",
            "zh": "会轻松很多，\n就我个人而言\n是推荐的未来。",
            "narrator_zh": "燕的新司书"
        },
        {
            "location": "306/ACT",
            "narrator": "",
            "text": "ダメだったら？",
            "zh": "不行的话？",
            "narrator_zh": ""
        },
        {
            "location": "307/TALK",
            "narrator": "つばめの新司書",
            "text": "強制的に\nデリートされます。",
            "zh": "会被强制\n删除。",
            "narrator_zh": "燕的新司书"
        },
        {
            "location": "308/TALK",
            "narrator": "つばめの新司書",
            "text": "-fオプション付きなので\n後戻りはできません。",
            "zh": "带了-f选项，\n没法回头。",
            "narrator_zh": "燕的新司书"
        },
        {
            "location": "310/TALK",
            "narrator": "つばめの新司書",
            "text": "どうしますか？\n行きますか？",
            "zh": "你要怎么办？\n去吗？",
            "narrator_zh": "燕的新司书"
        },
        {
            "location": "312/SEL",
            "narrator": "",
            "text": "はい",
            "zh": "是",
            "narrator_zh": ""
        },
        {
            "location": "313/SEL",
            "narrator": "",
            "text": "いいえ",
            "zh": "不",
            "narrator_zh": ""
        },
        {
            "location": "314/ACT",
            "narrator": "",
            "text": "はい",
            "zh": "是",
            "narrator_zh": ""
        },
        {
            "location": "315/ACT",
            "narrator": "",
            "text": "いいえ",
            "zh": "不",
            "narrator_zh": ""
        },
        {
            "location": "316/TALK",
            "narrator": "つばめの新司書",
            "text": "そうですか。",
            "zh": "是吗。",
            "narrator_zh": "燕的新司书"
        },
        {
            "location": "317/TALK",
            "narrator": "つばめの新司書",
            "text": "立ち会えないのであれば\n今後ココロゲートに来ても\n何もしてあげられません。",
            "zh": "如果不能出席，\n以后来心之扉\n我也什么都不会做。",
            "narrator_zh": "燕的新司书"
        },
        {
            "location": "318/TALK",
            "narrator": "つばめの新司書",
            "text": "残念ながら、上司から\nそう言われているので。",
            "zh": "遗憾的是，上司\n是这么说的。",
            "narrator_zh": "燕的新司书"
        },
        {
            "location": "319/TALK",
            "narrator": "つばめの新司書",
            "text": "ですので、\nまた気が変わったら\n来てください。",
            "zh": "所以，\n改主意了再\n来。",
            "narrator_zh": "燕的新司书"
        },
        {
            "location": "323/TALK",
            "narrator": "つばめの新司書",
            "text": "わかりました。\nそれでは一緒に\n行きましょう。",
            "zh": "知道了。\n那就一起\n走吧。",
            "narrator_zh": "燕的新司书"
        },
        {
            "location": "330/TALK",
            "narrator": "つばめの新司書",
            "text": "オープンプロセス、\n0x29F番地から\nC1:2:28E//1x0FF番地へ。",
