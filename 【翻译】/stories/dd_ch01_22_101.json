            "narrator_zh": "燕的新司书"
        },
        {
            "location": "467/TALK",
            "narrator": "つばめの新司書",
            "text": "オープンプロセス、\n0x29F番地から\n0x674番地へ。",
            "zh": "开放进程，\n从0x29F地址\n到0x674地址。",
            "narrator_zh": "燕的新司书"
        },
        {
            "location": "489/TALK",
            "narrator": "つばめの新司書",
            "text": "シーク完了しました。",
            "zh": "搜索完成。",
            "narrator_zh": "燕的新司书"
        },
