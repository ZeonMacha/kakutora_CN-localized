            "narrator": "つばめの新司書",
            "text": "到着しました。",
            "zh": "到了。",
            "narrator_zh": "燕的新司书"
        },
        {
            "location": "367/TALK",
            "narrator": "つばめの元司書　",
            "text": "こんにちは。",
            "zh": "你好。",
            "narrator_zh": "燕的原司书"
        },
        {
            "location": "374/SEL",
            "narrator": "",
            "text": "あれ！？\nなんか様子が…",
            "zh": "咦！？\n样子有点……",
            "narrator_zh": ""
        },
        {
            "location": "375/ACT",
            "narrator": "",
            "text": "あれ！？\nなんか様子が…",
            "zh": "咦！？\n样子有点……",
            "narrator_zh": ""
        },
        {
            "location": "378/TALK",
            "narrator": "つばめの新司書",
            "text": "しっかり勉強しましたか？",
            "zh": "好好学习了吗？",
            "narrator_zh": "燕的新司书"
        },
        {
            "location": "380/TALK",
            "narrator": "つばめの元司書　",
            "text": "はい、しました。",
            "zh": "是，学习了。",
            "narrator_zh": "燕的原司书"
        },
        {
            "location": "381/TALK",
            "narrator": "つばめの新司書",
            "text": "では聞きますが、\nあなたの役割は\nなんですか？",
            "zh": "那么我问，\n你的职责\n是什么？",
            "narrator_zh": "燕的新司书"
        },
        {
            "location": "382/TALK",
            "narrator": "つばめの元司書　",
            "text": "わたしの役割は、\nわたしとセカイを最大幸福\nへと導くことです。",
            "zh": "我的职责，\n是把我和世界引向\n最大幸福。",
            "narrator_zh": "燕的原司书"
        },
        {
            "location": "384/SEL",
            "narrator": "",
            "text": "おーいー",
            "zh": "喂——",
            "narrator_zh": ""
        },
        {
            "location": "385/ACT",
            "narrator": "",
            "text": "おーいー",
            "zh": "喂——",
            "narrator_zh": ""
        },
        {
            "location": "388/SEL",
            "narrator": "",
            "text": "カレン！！",
            "zh": "卡莲！！",
            "narrator_zh": ""
        },
        {
            "location": "389/ACT",
            "narrator": "",
            "text": "カレン！！",
            "zh": "卡莲！！",
            "narrator_zh": ""
        },
        {
            "location": "393/TALK",
            "narrator": "つばめの元司書　",
            "text": "はい、\nなんでしょう。",
            "zh": "是，\n什么事。",
            "narrator_zh": "燕的原司书"
        },
        {
            "location": "394/TALK",
            "narrator": "つばめの新司書",
            "text": "次の質問。",
            "zh": "下一个问题。",
            "narrator_zh": "燕的新司书"
        },
        {
            "location": "395/TALK",
            "narrator": "つばめの新司書",
            "text": "あなたはそこにいる人を\n愛してますか？",
            "zh": "你爱\n那里的那个人吗？",
            "narrator_zh": "燕的新司书"
        },
        {
            "location": "397/TALK",
            "narrator": "つばめの元司書　",
            "text": "…いいえ。\n単なる司書と客人の\n関係に過ぎません。",
            "zh": "……不。\n不过是司书和客人\n的关系。",
            "narrator_zh": "燕的原司书"
        },
        {
            "location": "399/SEL",
            "narrator": "",
            "text": "みやびはどこへ行った！？",
            "zh": "雅去哪儿了！？",
            "narrator_zh": ""
        },
        {
            "location": "400/ACT",
            "narrator": "",
            "text": "みやびはどこへ行った！？",
            "zh": "雅去哪儿了！？",
            "narrator_zh": ""
        },
        {
            "location": "403/TALK",
            "narrator": "つばめの新司書",
            "text": "シンギュラリティの\nことですか？",
