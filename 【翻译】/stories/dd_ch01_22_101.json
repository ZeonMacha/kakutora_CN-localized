            "narrator_zh": "燕的新司书"
        },
        {
            "location": "448/TALK",
            "narrator": "つばめの新司書",
            "text": "わたしの本気を\n出すところが無かったのが\n残念ではありました。",
            "zh": "我没有地方\n拿出认真，\n有点遗憾。",
            "narrator_zh": "燕的新司书"
        },
        {
            "location": "449/SEL",
            "narrator": "",
            "text": "見たかったよ！",
            "zh": "我倒是想看！",
            "narrator_zh": ""
        },
        {
            "location": "450/SEL",
            "narrator": "",
            "text": "残念だったね！",
            "zh": "真遗憾啊！",
            "narrator_zh": ""
        },
        {
            "location": "451/ACT",
            "narrator": "",
            "text": "見たかったよ！",
            "zh": "我倒是想看！",
            "narrator_zh": ""
        },
        {
            "location": "452/TALK",
            "narrator": "つばめの新司書",
            "text": "結果論的強がりですね。",
            "zh": "事后逞强。",
            "narrator_zh": "燕的新司书"
        },
        {
            "location": "453/ACT",
            "narrator": "",
            "text": "残念だったね！",
            "zh": "真遗憾啊！",
            "narrator_zh": ""
        },
        {
            "location": "454/TALK",
            "narrator": "つばめの新司書",
            "text": "ええ、ほんとに。",
            "zh": "是啊，真的。",
            "narrator_zh": "燕的新司书"
        },
        {
            "location": "456/TALK",
            "narrator": "つばめの新司書",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "燕的新司书"
        },
        {
            "location": "457/TALK",
            "narrator": "つばめの新司書",
            "text": "それとですね。",
            "zh": "还有。",
            "narrator_zh": "燕的新司书"
        },
        {
            "location": "458/TALK",
            "narrator": "つばめの新司書",
            "text": "元司書と\nいい雰囲気になるのは\n禁止です。",
            "zh": "和原司书\n搞出好气氛\n是禁止的。",
            "narrator_zh": "燕的新司书"
        },
        {
            "location": "459/TALK",
            "narrator": "つばめの新司書",
            "text": "とはいえ、\n今の状況を見るに、恐らく\nもう無理だと思いますが。",
