            "location": "494/TALK",
            "narrator": "つばめの新司書",
            "text": "もちろん、\n元気づけちゃって\nください。",
            "zh": "当然，\n请去给她\n打气。",
            "narrator_zh": "燕的新司书"
        },
        {
            "location": "495/TALK",
            "narrator": "つばめの新司書",
            "text": "粘り強く！\nイラッとするくらいに\nしつこく！",
