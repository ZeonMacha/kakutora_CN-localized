{
    "dir": "chap21/battle/btev_sp05_01_00.js",
    "type": "EventQuest",
    "info": {
        "story_id": "10603",
        "cid": "all",
        "title": "【期間限定】夏は短しハジけよ乙女♪",
        "sub_title": "夏は短しハジけよ乙女♪＜訓練編＞",
        "title_zh": "【期间限定】夏日苦短，绽放吧少女♪",
        "sub_title_zh": "夏日苦短，绽放吧少女♪＜训练篇＞"
    },
    "entry": [
        {
            "location": "8/SCENARIO",
            "narrator": "",
            "text": "夏は短しハジけよ乙女♪＜訓練編＞",
            "zh": "夏日苦短，绽放吧少女♪＜训练篇＞",
            "narrator_zh": ""
        },
        {
            "location": "24/TALK",
            "narrator": "アーヤ",
            "text": "ほら、ギャヴィ。\n早く走りなさいよ。",
            "zh": "好啦，加维。\n快跑起来哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "25/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ、はぁ…、\nも、もうダメ…。",
            "zh": "哈啊、哈啊……，\n已、已经不行了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "26/TALK",
            "narrator": "アーヤ",
            "text": "だらしないわね。\nまだ砂浜十往復しか\nしてないでしょ？",
            "zh": "真没出息。\n不是才在沙滩上\n跑了十个来回吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "27/TALK",
            "narrator": "ガブリエラ",
            "text": "しか！？\n十往復もすれば\n十分よ！",
            "zh": "“才”！？\n跑十个来回都\n已经够了啦！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "28/TALK",
            "narrator": "ガブリエラ",
            "text": "まったく…アーヤって、\n本当スポ根好きよね…。",
            "zh": "真是的……绫水你啊，\n还真喜欢热血特训那一套……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "29/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしには\n付いてけないわ。",
            "zh": "我可跟不上\n你这套哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "30/SEL",
            "narrator": "",
            "text": "そんなアーヤが素敵",
            "zh": "那样的绫水很迷人哦",
            "narrator_zh": ""
        },
        {
            "location": "31/SEL",
            "narrator": "",
            "text": "訓練は大事だよね",
            "zh": "训练确实很重要嘛",
            "narrator_zh": ""
        },
        {
            "location": "32/ACT",
            "narrator": "",
            "text": "そんなアーヤが素敵",
            "zh": "那样的绫水很迷人哦",
            "narrator_zh": ""
        },
        {
            "location": "33/TALK",
            "narrator": "アーヤ",
            "text": "ほら、$handle$も\nこう言ってるわ。",
            "zh": "你看，连$handle$都\n这么说了哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "34/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょ、なによそれ！\nあたしは素敵じゃない\nっていうの！？",
            "zh": "喂、什么意思嘛！\n难道你是说我不够\n迷人吗！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "35/SEL",
            "narrator": "",
            "text": "いや、そういうわけでは…",
            "zh": "不，我不是那个意思……",
            "narrator_zh": ""
        },
        {
            "location": "36/SEL",
            "narrator": "",
            "text": "大人の魅力で負けてるし",
            "zh": "在成熟魅力上也输了嘛",
            "narrator_zh": ""
        },
        {
            "location": "37/ACT",
            "narrator": "",
            "text": "いや、そういうわけでは…",
            "zh": "不，我不是那个意思……",
            "narrator_zh": ""
        },
        {
            "location": "38/TALK",
            "narrator": "ガブリエラ",
            "text": "信じられないわ。",
            "zh": "真让人难以置信。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "39/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィは素敵って\nいうよりかは、\n可愛い、よね？",
            "zh": "加维与其说是\n迷人，不如说是\n可爱，对吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "40/TALK",
            "narrator": "ガブリエラ",
            "text": "…なんか、誤魔化されて\nる\n気がするんだけど？",
            "zh": "……怎么感觉\n好像被你\n敷衍过去了？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "41/TALK",
            "narrator": "アーヤ",
            "text": "本当よ。\nギャヴィのこと、\n可愛いと思うわ。",
            "zh": "是真的哦。\n我觉得加维\n挺可爱的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "42/TALK",
            "narrator": "ガブリエラ",
            "text": "…まあ、そこまで言うな\nら\n信じなくはないけど。",
            "zh": "……好吧，既然都\n这么说了，倒也不是\n不能相信啦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "43/ACT",
            "narrator": "",
            "text": "大人の魅力で負けてるし",
            "zh": "在成熟魅力上也输了嘛",
            "narrator_zh": ""
        },
        {
            "location": "45/ACT",
            "narrator": "",
            "text": "訓練は大事だよね",
            "zh": "训练确实很重要嘛",
            "narrator_zh": ""
        },
        {
            "location": "46/TALK",
            "narrator": "ガブリエラ",
            "text": "別に大事じゃないとは\n言ってないけど？",
            "zh": "我也没说它\n不重要就是了？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "47/TALK",
            "narrator": "ガブリエラ",
            "text": "ただ、アーヤの場合は\n度を越してるのよ。",
            "zh": "只不过绫水的话，\n简直是做得太过头了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "48/TALK",
            "narrator": "アーヤ",
            "text": "訓練って聞くと、\nなんだかテンション\n上がっちゃって…。",
            "zh": "一听到“训练”两个字，\n总觉得莫名就\n兴致高涨起来了……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "49/TALK",
            "narrator": "ガブリエラ",
            "text": "…リアルのアーヤも、\n内心こんなこと思いなが\nら",
            "zh": "……现实里的绫水，\n该不会内心也一边\n想着这种事",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "50/TALK",
            "narrator": "ガブリエラ",
            "text": "参加してるのかしら？",
            "zh": "一边参加训练的吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "52/TALK",
            "narrator": "ガブリエラ",
            "text": "っていうか、アーヤが\n飛ばし過ぎると\n迷惑なのよ。",
            "zh": "话说回来，绫水要是\n这么猛冲的话，\n真的很让人困扰耶。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "53/TALK",
            "narrator": "ガブリエラ",
            "text": "真面目にやってる\nあたし達が、サボッてる\nように見えちゃうでしょ？",
            "zh": "搞得老老实实训练的\n我们，好像在偷懒\n一样嘛，对吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "54/TALK",
            "narrator": "アーヤ",
            "text": "そんなことないわ。",
            "zh": "没那回事哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "55/TALK",
            "narrator": "アーヤ",
            "text": "自分にできる、無理のな\nい\n範囲で訓練すればいい",
            "zh": "只要在自己能力所及、\n不会勉强的\n范围内训练就",
            "narrator_zh": "绫水"
        },
        {
            "location": "56/TALK",
            "narrator": "アーヤ",
            "text": "だけなんだから。",
            "zh": "可以了嘛。",
            "narrator_zh": "绫水"
        },
        {
            "location": "57/TALK",
            "narrator": "ガブリエラ",
            "text": "…一番飛ばしてる人に\n言われても、あんまり\n説得力感じないんだけど？",
            "zh": "……这话从冲得最猛的\n人嘴里说出来，可一点\n说服力都没有啊？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "58/TALK",
            "narrator": "ガブリエラ",
            "text": "まあ、今更もう\n何も言わないわよ。",
            "zh": "算了，事到如今\n我也懒得再说了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "59/SEL",
            "narrator": "",
            "text": "訓練もいいけど、遊べば？",
            "zh": "训练固然好，也玩一玩呗？",
            "narrator_zh": ""
        },
        {
            "location": "60/ACT",
            "narrator": "",
            "text": "訓練もいいけど、遊べば？",
            "zh": "训练固然好，也玩一玩呗？",
            "narrator_zh": ""
        },
        {
            "location": "62/TALK",
            "narrator": "ガブリエラ",
            "text": "さすがね、マルサンナ。\nとてもいいことを\n言うじゃない。",
            "zh": "真不愧是玛尔赞娜。\n说的话就是\n深得我心嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "63/TALK",
            "narrator": "アーヤ",
            "text": "合宿で来てるのに、\n遊ぶっていうのは\nどうかと思うけど…。",
            "zh": "明明是为了合宿来的，\n光顾着玩\n恐怕不太好吧……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "64/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…本当、アーヤって\nお堅いんだから…。",
            "zh": "唉……真是的，绫水\n你还真是一板一眼……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "65/TALK",
            "narrator": "ガブリエラ",
            "text": "マルサンナ、\nなんとかして。",
            "zh": "玛尔赞娜，\n快想想办法呀。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "66/SEL",
            "narrator": "",
            "text": "海デートには最高のシチュだよ",
            "zh": "这可是海边约会的绝佳场景哦",
            "narrator_zh": ""
        },
        {
            "location": "67/SEL",
            "narrator": "",
            "text": "メンタルケアも大切",
            "zh": "心理放松同样很重要啊",
            "narrator_zh": ""
        },
        {
            "location": "68/ACT",
            "narrator": "",
            "text": "海デートには最高のシチュだよ",
            "zh": "这可是海边约会的绝佳场景哦",
            "narrator_zh": ""
        },
        {
            "location": "69/TALK",
            "narrator": "アーヤ",
            "text": "…え？\nつまり、ギャヴィを\nデートに誘えと？",
            "zh": "……诶？\n也就是说，让我约加维\n去约会吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "70/TALK",
            "narrator": "ガブリエラ",
            "text": "えっ！？",
            "zh": "诶！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "71/SEL",
            "narrator": "",
            "text": "いや、僕とだよ",
            "zh": "不，是和我才对",
            "narrator_zh": ""
        },
        {
            "location": "72/SEL",
            "narrator": "",
            "text": "その通りだ",
            "zh": "正是如此",
            "narrator_zh": ""
        },
        {
            "location": "73/SEL",
            "narrator": "",
            "text": "僕とガブリエラでだよ",
            "zh": "是我和加布里埃拉啦",
            "narrator_zh": ""
        },
        {
            "location": "74/ACT",
            "narrator": "",
            "text": "いや、僕とだよ",
            "zh": "不，是和我才对",
            "narrator_zh": ""
        },
        {
            "location": "75/ACT",
            "narrator": "",
            "text": "その通りだ",
            "zh": "正是如此",
            "narrator_zh": ""
        },
        {
            "location": "76/TALK",
            "narrator": "アーヤ",
            "text": "…ということらしいけど、\nデートする？",
            "zh": "……话是这么说，\n要约会吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "77/TALK",
            "narrator": "ガブリエラ",
            "text": "え、えっと…。",
            "zh": "那、那个……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "78/TALK",
            "narrator": "ガブリエラ",
            "text": "…い、いいわ。",
            "zh": "……可、可以哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "79/TALK",
            "narrator": "アーヤ",
            "text": "するってこと？",
            "zh": "意思是同意了吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "80/TALK",
            "narrator": "ガブリエラ",
            "text": "ノー、ってこと！",
            "zh": "意思是“No”！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "81/TALK",
            "narrator": "ガブリエラ",
            "text": "したくないわけじゃ\nないけど…マルサンナを\n独りにさせちゃうし。",
            "zh": "倒也不是不想去……\n可这样会把玛尔赞娜\n一个人撇下的呀。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "82/TALK",
            "narrator": "ガブリエラ",
            "text": "それに…。",
            "zh": "而且……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "83/TALK",
            "narrator": "アーヤ",
            "text": "それに…？",
            "zh": "而且……？",
            "narrator_zh": "绫水"
        },
        {
            "location": "84/TALK",
            "narrator": "ガブリエラ",
            "text": "（…アーヤが自分から\n言ってきてくれないと、\n嬉しくないし…。）",
            "zh": "（……要不是绫水你\n自己主动约我的话，\n我可高兴不起来……。）",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "85/TALK",
            "narrator": "ガブリエラ",
            "text": "…なんでもない。\nとにかく、しないわ。",
            "zh": "……没什么。\n总之，我不去。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "86/ACT",
            "narrator": "",
            "text": "僕とガブリエラでだよ",
            "zh": "是我和加布里埃拉啦",
            "narrator_zh": ""
        },
        {
            "location": "88/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、せっかくの海だし、\n楽しむことも必要だと\n思うわ。",
            "zh": "不过，难得来一趟海边，\n我觉得适度玩一玩\n也是很有必要的哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "89/TALK",
            "narrator": "ガブリエラ",
            "text": "だから、アーヤも\nちょっとは海を\n楽しんだら？",
            "zh": "所以，绫水也\n稍微享受一下大海\n怎么样嘛？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "90/ACT",
            "narrator": "",
            "text": "メンタルケアも大切",
            "zh": "心理放松同样很重要啊",
            "narrator_zh": ""
        },
        {
            "location": "91/TALK",
            "narrator": "ガブリエラ",
            "text": "そうそう、マルサンナの\n言う通りよ。",
            "zh": "对对，正如玛尔赞娜\n所说的那样哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "92/TALK",
            "narrator": "ガブリエラ",
            "text": "心の中まで鍛えてたら、\n脳筋になっちゃうわよ？",
            "zh": "要是连心里面都绷着锻炼，\n可是会变成肌肉脑的哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "93/TALK",
            "narrator": "アーヤ",
            "text": "の、脳筋！？\nそれは…イヤかも…。",
            "zh": "肌、肌肉脑！？\n那样……可不太好……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "94/TALK",
            "narrator": "ガブリエラ",
            "text": "でしょ？\nだから、ちょっとくらい\n海を楽しみましょ。",
            "zh": "对吧？\n所以，我们就稍微\n享受一下大海吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "96/TALK",
            "narrator": "アーヤ",
            "text": "…そうね。\nそれも悪くないかも\nしれないわね。",
            "zh": "……也是呢。\n那样说不定\n也不坏。",
            "narrator_zh": "绫水"
        },
        {
            "location": "97/TALK",
            "narrator": "アーヤ",
            "text": "正直言うと、私も少し\n疲れてきてたところ\nだったし…。",
            "zh": "说实话，我也确实\n稍微有点累了\n就是了……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "98/TALK",
            "narrator": "ガブリエラ",
            "text": "す、少しね…。\nさすがだわ…。",
            "zh": "才、“稍微”啊……。\n真不愧是你……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "99/TALK",
            "narrator": "アーヤ",
            "text": "でも…楽しむにしても、\nどう過ごしたらいいもの\nかしら？",
            "zh": "不过……就算说要放松，\n到底怎么消遣\n才好呢？",
            "narrator_zh": "绫水"
        },
        {
            "location": "100/TALK",
            "narrator": "アーヤ",
            "text": "泳いだりとかだと、\n多分そのまま遠泳とか\nしちゃいそうだし…。",
            "zh": "要是去游泳之类的话，\n大概不知不觉又会\n游成远距离拉练了……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "101/TALK",
            "narrator": "ガブリエラ",
            "text": "のんびりと\n楽しむ方法、か…。",
            "zh": "悠闲放松的\n消遣方式，吗……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "102/TALK",
            "narrator": "ガブリエラ",
            "text": "うーん…なにか浮かべば\nいいんだけど…。",
            "zh": "唔——……要是能想到\n什么好点子就好了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "103/TALK",
            "narrator": "アーヤ",
            "text": "…やっぱりここは。",
            "zh": "……果然这时候还是。",
            "narrator_zh": "绫水"
        },
        {
            "location": "104/TALK",
            "narrator": "ガブリエラ",
            "text": "マルサンナに\n協力してもらうのが\n一番よね。",
