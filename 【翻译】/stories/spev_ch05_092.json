{
    "dir": "chap00/daydra/spev_ch05_092.js",
    "type": "",
    "info": {
        "story_id": "91036",
        "cid": "",
        "title": "ぴょんこのサマー大作戦♪",
        "sub_title": "ぴょんこのサマー大作戦♪⑤【神楽編】",
        "title_zh": "蹦子的夏日大作战♪",
        "sub_title_zh": "蹦子的夏日大作战♪⑤【神乐篇】"
    },
    "entry": [
        {
            "location": "20/DIALOG",
            "narrator": "",
            "text": "<color=green>本イベントは\n<color=red>2017年7月12日～8月16日</color>に\n配信されたものです。</color>\n\nイベント内で告知されている内容、表示されるリンク先のページなどは配信当時のものとなっています。",
            "zh": "<color=green>本活动为\n<color=red>2017年7月12日～8月16日</color>期间\n发布的内容。</color>\n\n活动内告知的内容以及所显示的链接页面等，均为发布当时的信息。",
            "narrator_zh": ""
        },
        {
            "location": "21/DIALOG",
            "narrator": "",
            "text": "<color=green>8月4日　1:21 PM</color>\nとある金曜日の午後、シャッツキステ店内にて。",
            "zh": "<color=green>8月4日　1:21 PM</color>\n某个星期五的下午，在schatz-kiste店内。",
            "narrator_zh": ""
        },
        {
            "location": "22/TALK",
            "narrator": "神楽",
            "text": "…？",
            "zh": "……？",
            "narrator_zh": "神乐"
        },
        {
            "location": "23/TALK",
            "narrator": "神楽",
            "text": "あっ！\n$handle$――",
            "zh": "啊！\n$handle$——",
            "narrator_zh": "神乐"
        },
        {
            "location": "25/TALK",
            "narrator": "神楽",
            "text": "さん…ですね、まだ。",
            "zh": "……现在，还得用敬称呢。",
            "narrator_zh": "神乐"
        },
        {
            "location": "26/TALK",
            "narrator": "神楽",
            "text": "お久し振りです。\nお元気でしたか？",
            "zh": "好久不见。\n近来可好？",
            "narrator_zh": "神乐"
        },
        {
            "location": "27/TALK",
            "narrator": "神楽",
            "text": "って、そっちからだと\n久し振りっていう程でも\nありませんよね。",
            "zh": "不过，从你那边来看，\n好像也算不上\n好久不见吧。",
            "narrator_zh": "神乐"
        },
        {
            "location": "28/SEL",
            "narrator": "（選択肢）",
            "text": "？？",
            "zh": "？？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "29/ACT",
            "narrator": "",
            "text": "？？",
            "zh": "？？",
            "narrator_zh": ""
        },
        {
            "location": "31/TALK",
            "narrator": "神楽",
            "text": "いえ、いいんです！\n独り言ですから。",
            "zh": "不，没什么！\n只是自言自语而已。",
            "narrator_zh": "神乐"
        },
        {
            "location": "32/TALK",
            "narrator": "神楽",
            "text": "それより、今日はとても\n嬉しいことがあったから、\n貴方と共有したくて。",
            "zh": "不说那个了，今天有件\n非常开心的事，\n我想和你分享一下。",
            "narrator_zh": "神乐"
        },
        {
            "location": "33/TALK",
            "narrator": "神楽",
            "text": "前に私、薄い本を\n書いてましたよね。",
            "zh": "之前我不是写过\n一本薄本嘛。",
            "narrator_zh": "神乐"
        },
        {
            "location": "34/TALK",
            "narrator": "神楽",
            "text": "あの本、結局\nイベントには\n出さなかったんです。",
            "zh": "那本书，结果\n还是没拿去\n活动上出。",
            "narrator_zh": "神乐"
        },
        {
            "location": "35/SEL",
            "narrator": "（選択肢）",
            "text": "どうして！？",
            "zh": "为什么！？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "36/SEL",
            "narrator": "（選択肢）",
            "text": "ああ…お察しします",
            "zh": "啊……我懂的",
            "narrator_zh": "（选项）"
        },
        {
            "location": "37/ACT",
            "narrator": "",
            "text": "どうして！？",
            "zh": "为什么！？",
            "narrator_zh": ""
        },
        {
            "location": "38/TALK",
            "narrator": "神楽",
            "text": "2016年の夏。",
            "zh": "2016年的夏天。",
            "narrator_zh": "神乐"
        },
        {
            "location": "39/TALK",
            "narrator": "神楽",
            "text": "つばめさんとこのお店に\n来た後、何があったか\n覚えてますか？",
            "zh": "还记得我和燕\n来过这家店之后，\n发生了什么吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "41/TALK",
            "narrator": "神楽",
            "text": "とてもそんなことを\nできる状況では\nなかったですよね。",
            "zh": "当时实在不是\n能做那种事的\n处境吧。",
            "narrator_zh": "神乐"
        },
        {
            "location": "42/TALK",
            "narrator": "神楽",
            "text": "ぴょんこ、\nさすがにそこまで\n精神図太くないので！",
            "zh": "蹦子再怎么说，\n神经也没粗到\n那种程度呀！",
            "narrator_zh": "神乐"
        },
        {
            "location": "43/ACT",
            "narrator": "",
            "text": "ああ…お察しします",
            "zh": "啊……我懂的",
            "narrator_zh": ""
        },
        {
            "location": "45/TALK",
            "narrator": "神楽",
            "text": "ふふ、さすがですね。",
            "zh": "呵呵，真不愧是你。",
            "narrator_zh": "神乐"
        },
        {
            "location": "46/TALK",
            "narrator": "神楽",
            "text": "それでこそ、\n将来の――",
            "zh": "这才配得上，\n将来的——",
            "narrator_zh": "神乐"
        },
        {
            "location": "48/TALK",
            "narrator": "神楽",
            "text": "って、そんなことは\nどうでもいいんです。",
            "zh": "哎呀，这种事\n先放一边吧。",
            "narrator_zh": "神乐"
        },
        {
            "location": "49/TALK",
            "narrator": "神楽",
            "text": "それでですね、\n色々考えたんですけど。",
            "zh": "然后呢，\n我想了很多。",
            "narrator_zh": "神乐"
        },
        {
            "location": "50/TALK",
            "narrator": "神楽",
            "text": "あの時の本を、やっぱり\nイベントで頒布することに\nしたんです。",
            "zh": "当时那本书，我还是\n决定拿到活动上\n去配布了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "51/SEL",
            "narrator": "（選択肢）",
            "text": "おめでとう！",
            "zh": "恭喜！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "52/ACT",
            "narrator": "",
            "text": "おめでとう！",
            "zh": "恭喜！",
            "narrator_zh": ""
        },
        {
            "location": "54/TALK",
            "narrator": "神楽",
            "text": "ふふ。\nありがとうございます！",
            "zh": "呵呵。\n谢谢你！",
            "narrator_zh": "神乐"
        },
        {
            "location": "55/TALK",
            "narrator": "神楽",
            "text": "で、せっかくだから、\n貴方にも見てもらえたら、\nって思っていて…",
            "zh": "而且，难得有这机会，\n我也想过要是能让\n你也看看就好了……",
            "narrator_zh": "神乐"
        },
        {
            "location": "56/TALK",
            "narrator": "神楽",
            "text": "色々方法を模索して\nいたんですけど！",
            "zh": "我一直都在摸索\n各种办法呢！",
            "narrator_zh": "神乐"
        },
        {
            "location": "57/TALK",
            "narrator": "神楽",
            "text": "みやびさんや、とある人が\n協力してくれて、それが\n叶っちゃいました！",
            "zh": "雅还有某位朋友\n帮了我一把，这下\n竟然真的实现了！",
            "narrator_zh": "神乐"
        },
        {
            "location": "58/SEL",
            "narrator": "（選択肢）",
            "text": "どういうこと！？",
            "zh": "什么意思！？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "59/ACT",
            "narrator": "",
            "text": "どういうこと！？",
            "zh": "什么意思！？",
            "narrator_zh": ""
        },
        {
            "location": "61/TALK",
            "narrator": "神楽",
            "text": "$handle$さんの\n世界のコミックイベントで\n委託頒布しちゃいます！",
            "zh": "我要拿到$handle$\n那边的漫画展上\n去寄售了哦！",
            "narrator_zh": "神乐"
        },
        {
            "location": "62/SEL",
            "narrator": "（選択肢）",
            "text": "えーー！！",
            "zh": "诶——！！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "63/SEL",
            "narrator": "（選択肢）",
            "text": "想像はしてた",
            "zh": "我倒是有猜到过",
            "narrator_zh": "（选项）"
        },
        {
            "location": "64/ACT",
            "narrator": "",
            "text": "えーー！！",
            "zh": "诶——！！",
            "narrator_zh": ""
        },
        {
            "location": "65/TALK",
            "narrator": "神楽",
            "text": "ふふっ！\n驚いてくれて嬉しいです！",
            "zh": "呵呵！\n看你这么吃惊我好开心！",
            "narrator_zh": "神乐"
        },
        {
            "location": "66/TALK",
            "narrator": "神楽",
            "text": "私もとっても\nビックリしましたから。",
            "zh": "因为我自己也\n吓了好大一跳呢。",
            "narrator_zh": "神乐"
        },
        {
            "location": "67/ACT",
            "narrator": "",
            "text": "想像はしてた",
            "zh": "我倒是有猜到过",
            "narrator_zh": ""
        },
        {
            "location": "68/TALK",
            "narrator": "神楽",
            "text": "え？\nそうなんですか？",
            "zh": "诶？\n是这样吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "69/TALK",
            "narrator": "神楽",
            "text": "もしかして\n$handle$さんって\nエスパーですか？",
            "zh": "难道说\n$handle$其实是\n超能力者吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "70/TALK",
            "narrator": "神楽",
            "text": "それとも、\nアカシックレコーダー\nだったりしません？",
            "zh": "还是说，\n你其实是阿卡夏\n记录者之类的吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "71/SEL",
            "narrator": "（選択肢）",
            "text": "じ、実は…",
            "zh": "其、其实……",
            "narrator_zh": "（选项）"
        },
        {
            "location": "72/ACT",
            "narrator": "",
            "text": "じ、実は…",
            "zh": "其、其实……",
            "narrator_zh": ""
        },
        {
            "location": "74/TALK",
            "narrator": "神楽",
            "text": "なーんちゃって！\n単なるマグレですよね。",
            "zh": "逗你玩的！\n只是巧合蒙对了吧。",
            "narrator_zh": "神乐"
        },
        {
            "location": "76/TALK",
            "narrator": "神楽",
            "text": "とにかく！\nそういうわけですので！",
            "zh": "总之！\n情况就是这样啦！",
            "narrator_zh": "神乐"
        },
        {
            "location": "77/TALK",
            "narrator": "神楽",
            "text": "もし興味あれば、\nイベントでお手にとって\nみてください！",
            "zh": "如果感兴趣的话，\n请在活动上拿起来\n翻翻看哦！",
            "narrator_zh": "神乐"
        },
        {
            "location": "79/TALK",
            "narrator": "神楽",
            "text": "当時の事なので、\n今見返すと、ちょっと\n恥ずかしいですけど……",
            "zh": "毕竟是那时候的作品，\n现在回头再看，有点\n不好意思呢……",
            "narrator_zh": "神乐"
        },
        {
            "location": "80/TALK",
            "narrator": "神楽",
            "text": "でも、あの時の精一杯の\n全力だったことには\n間違いないので！",
            "zh": "不过，那绝对是\n当时的我拼尽全力的\n成果，这点毫无疑问！",
            "narrator_zh": "神乐"
        },
        {
            "location": "83/DIALOG",
            "narrator": "",
            "text": "チラ見せ①",
            "zh": "抢先试看①",
            "narrator_zh": ""
        },
        {
            "location": "84/TALK",
            "narrator": "神楽",
            "text": "内容は、\n４コマとか――",
            "zh": "内容呢，\n有四格漫画呀——",
            "narrator_zh": "神乐"
        },
        {
            "location": "86/DIALOG",
            "narrator": "",
            "text": "チラ見せ②",
            "zh": "抢先试看②",
            "narrator_zh": ""
        },
        {
            "location": "87/TALK",
            "narrator": "神楽",
            "text": "みんなに協力してもらった\nショートストーリーとか。",
            "zh": "还有请大家帮忙写的\n短篇小故事之类的。",
            "narrator_zh": "神乐"
        },
        {
            "location": "89/DIALOG",
            "narrator": "",
            "text": "チラ見せ③",
            "zh": "抢先试看③",
            "narrator_zh": ""
        },
        {
            "location": "91/TALK",
            "narrator": "神楽",
            "text": "あとは、寄せ書きなんかも\nあったりしますよ！",
            "zh": "另外，还有大家的\n寄语留言哦！",
            "narrator_zh": "神乐"
        },
        {
            "location": "94/TALK",
            "narrator": "神楽",
            "text": "興味あったら、\n是非ぴょんこの黒歴史を\n堪能しちゃってください！",
            "zh": "有兴趣的话，\n请务必好好品鉴一番\n蹦子的黑历史哦！",
            "narrator_zh": "神乐"
        },
        {
            "location": "95/SEL",
            "narrator": "（選択肢）",
            "text": "自分で黒歴史言うんだ",
            "zh": "自己就先说是黑历史了啊",
            "narrator_zh": "（选项）"
        },
        {
            "location": "96/ACT",
            "narrator": "",
            "text": "自分で黒歴史言うんだ",
            "zh": "自己就先说是黑历史了啊",
            "narrator_zh": ""
        },
        {
            "location": "98/TALK",
            "narrator": "神楽",
            "text": "まあ実際、あと10年も\nすれば完璧に黒歴史です。",
            "zh": "嘛，实际上再过个10年，\n就妥妥变成黑历史了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "99/TALK",
            "narrator": "神楽",
            "text": "でもいいじゃないですか。\n今楽しくて\nやめられないならそれで。",
            "zh": "不过这不也挺好嘛。\n只要现在画得开心\n停不下来，那就足够了。",
            "narrator_zh": "神乐"
        },
        {
            "location": "100/TALK",
            "narrator": "神楽",
            "text": "それに――",
            "zh": "而且——",
            "narrator_zh": "神乐"
        },
        {
            "location": "101/TALK",
            "narrator": "神楽",
            "text": "手に取りたいと\n思った貴方は、\n同じ穴の狢ですよ？",
            "zh": "动了念头想拿起来\n翻看的你，可也是\n一丘之貉哦？",
            "narrator_zh": "神乐"
        },
        {
            "location": "102/TALK",
            "narrator": "神楽",
            "text": "そこは覚悟しておいた方が\nいいと思います♪",
            "zh": "这一点，我觉得你还是\n先做好觉悟比较好♪",
            "narrator_zh": "神乐"
        },
        {
            "location": "103/TALK",
            "narrator": "神楽",
            "text": "あとですね、\nもし読む機会があれば、\n是非感想もお願いします♪",
            "zh": "还有呀，\n要是有机会读到的话，\n请务必告诉我感想哦♪",
            "narrator_zh": "神乐"
        },
        {
            "location": "104/TALK",
            "narrator": "神楽",
            "text": "同人作家にとっては、\n感想こそが次へのカテ\nですからね！",
            "zh": "因为对同人作者来说，\n读后感想才是迈向\n下一部的食粮嘛！",
            "narrator_zh": "神乐"
        },
        {
            "location": "106/TALK",
            "narrator": "神楽",
            "text": "…っと。\nだいぶ長話を\nしちゃいましたね！",
            "zh": "……哎呀。\n一不小心扯了\n这么久呢！",
            "narrator_zh": "神乐"
        },
        {
            "location": "107/TALK",
            "narrator": "神楽",
            "text": "それじゃ、今回は\nこの辺で。",
            "zh": "那么，这次就\n先聊到这里吧。",
            "narrator_zh": "神乐"
        },
        {
            "location": "108/TALK",
            "narrator": "神楽",
            "text": "委託本を取りに行って\nくれる時は、熱中症に\n気をつけてくださいね！",
            "zh": "去现场取这本\n寄售本的时候，一定要\n小心别中暑哦！",
            "narrator_zh": "神乐"
        },
        {
            "location": "109/DIALOG",
            "narrator": "",
            "text": "神楽の同人誌の\n詳細情報を見ますか？",
            "zh": "要查看神乐同人志的\n详细信息吗？",
            "narrator_zh": ""
        }
    ]
}
