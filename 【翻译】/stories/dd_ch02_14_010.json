{
    "dir": "chap14/daydra/dd_ch02_14_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "14252",
        "cid": "ayami",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "國政綾水とひなこさん",
        "title_zh": "Extra002 额外剧情",
        "sub_title_zh": "国政绫水与小雏"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "アーヤＭＶ回１",
            "zh": "绫水MV回1",
            "narrator_zh": ""
        },
        {
            "location": "21/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ、お腹空いた…。",
            "zh": "呼，好饿啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "23/TALK",
            "narrator": "アーヤ",
            "text": "ふふっ、大丈夫？",
            "zh": "呵呵，没事吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "25/TALK",
            "narrator": "ガブリエラ",
            "text": "ええ…でも、午前中に\n体育があると、\nお腹空いて困るわ…。",
            "zh": "嗯……不过，上午\n要是排了体育课，\n饿得真让人受不了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "26/TALK",
            "narrator": "アーヤ",
            "text": "じゃあ、早いとこ\n学食行きましょ。",
            "zh": "那我们赶紧\n去食堂吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "27/TALK",
            "narrator": "雛",
            "text": "あっ！",
            "zh": "啊！",
            "narrator_zh": "雏"
        },
        {
            "location": "30/TALK",
            "narrator": "雛",
            "text": "こんにちは、綾水様。\nガブリエラちゃん。",
            "zh": "你好，绫水大人。\n加布里埃拉。",
            "narrator_zh": "雏"
        },
        {
            "location": "32/TALK",
            "narrator": "アーヤ",
            "text": "あら、日向さん。",
            "zh": "哎呀，日向。",
            "narrator_zh": "绫水"
        },
        {
            "location": "34/TALK",
            "narrator": "ガブリエラ",
            "text": "ん…どうしたの？\nお弁当は？",
            "zh": "嗯……怎么了？\n便当呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "35/TALK",
            "narrator": "雛",
            "text": "えへへ…実は家に\n忘れてきちゃった\nから――",
            "zh": "嘿嘿……其实我忘在\n家里没带来\n所以——",
            "narrator_zh": "雏"
        },
        {
            "location": "36/TALK",
            "narrator": "雛",
            "text": "今日はあたしだけ、\n学食でお昼なんだー。",
            "zh": "今天只有我一个人，\n要在食堂吃午饭呢——。",
            "narrator_zh": "雏"
        },
        {
            "location": "37/TALK",
            "narrator": "ガブリエラ",
            "text": "抜けてるわねぇ。",
            "zh": "真够迷糊的啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "38/TALK",
            "narrator": "雛",
            "text": "いやー、ちゃんと\nカバン入れたと\n思ったんだけどねー。",
            "zh": "哎呀，我明明觉得\n确实放进书包里\n了嘛——。",
            "narrator_zh": "雏"
        },
        {
            "location": "39/TALK",
            "narrator": "アーヤ",
            "text": "災難だったわね。",
            "zh": "那可真是倒霉了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "40/TALK",
            "narrator": "アーヤ",
            "text": "私たちも、これから\n学食でお昼にするとこ\nなんだけど――",
            "zh": "我们俩也正打算\n去食堂\n吃午饭呢——",
            "narrator_zh": "绫水"
        },
        {
            "location": "41/TALK",
            "narrator": "アーヤ",
            "text": "よかったら、\n日向さんも一緒に\nどう？",
            "zh": "如果不嫌弃的话，\n日向也一起来\n怎么样？",
            "narrator_zh": "绫水"
        },
        {
            "location": "42/TALK",
            "narrator": "雛",
            "text": "いいんですか！？",
            "zh": "可以吗！？",
            "narrator_zh": "雏"
        },
        {
            "location": "44/TALK",
            "narrator": "アーヤ",
            "text": "もちろん。\nね、ギャヴィ？",
            "zh": "当然。\n对吧，加维？",
            "narrator_zh": "绫水"
        },
        {
            "location": "46/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…仕方ないわね。",
            "zh": "唉……真拿你没办法。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "47/TALK",
            "narrator": "ガブリエラ",
            "text": "本当は、アーヤと\nお話しながら\n食べたかったのに…。",
            "zh": "明明原本想和\n绫水一边聊天\n一边吃的……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "48/TALK",
            "narrator": "雛",
            "text": "やったー！\nお弁当忘れて\n幸運でしたよー！",
            "zh": "太棒了！\n忘带便当反而\n走运了呢——！",
            "narrator_zh": "雏"
        },
        {
            "location": "49/TALK",
            "narrator": "雛",
            "text": "っていうか、一人で\n食べるの寂しいな、\nって思ってたから――",
            "zh": "其实我刚才还在想，\n一个人吃饭\n好寂寞呢——",
            "narrator_zh": "雏"
        },
        {
            "location": "50/TALK",
            "narrator": "雛",
            "text": "本当嬉しいです！",
            "zh": "真的好开心！",
            "narrator_zh": "雏"
        },
        {
            "location": "52/TALK",
            "narrator": "ガブリエラ",
            "text": "はいはい、そういうの\nいいから行くわよ。",
            "zh": "好好好，别说这些了\n赶紧走吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "70/TALK",
            "narrator": "雛",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雏"
        },
        {
            "location": "73/TALK",
            "narrator": "アーヤ",
            "text": "日向さん。\n早く食べないと\n冷めちゃうわよ？",
            "zh": "日向。\n不快点吃的话\n要凉了哦？",
            "narrator_zh": "绫水"
        },
        {
            "location": "76/TALK",
            "narrator": "雛",
            "text": "あ、はい！\nすぐに食べ――",
            "zh": "啊，好！\n我马上吃——",
            "narrator_zh": "雏"
        },
        {
            "location": "77/TALK",
            "narrator": "雛",
            "text": "熱っ！？",
            "zh": "好烫！？",
            "narrator_zh": "雏"
        },
        {
            "location": "79/TALK",
            "narrator": "ガブリエラ",
            "text": "何やってんのよ。\nってか、もしかして\n緊張してない？",
            "zh": "你在干嘛呀。\n话说，你该不会是\n在紧张吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "82/TALK",
            "narrator": "雛",
            "text": "あ、あはは…。\nちょっとねー。",
            "zh": "啊、啊哈哈……。\n有一点点呢——。",
            "narrator_zh": "雏"
        },
        {
            "location": "83/TALK",
            "narrator": "アーヤ",
            "text": "そんな知らない仲でも\nないのに。",
            "zh": "明明大家也不是\n不熟的关系。",
            "narrator_zh": "绫水"
        },
        {
            "location": "85/TALK",
            "narrator": "雛",
            "text": "そ、そうなんです\nけど、その…。",
            "zh": "话、话是这么说\n没错，不过那个……。",
            "narrator_zh": "雏"
        },
        {
            "location": "87/TALK",
            "narrator": "ガブリエラ",
            "text": "…本当、こういうとこ\n鈍感よね。",
            "zh": "……真是的，在这种地方\n还真迟钝啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "88/TALK",
            "narrator": "ガブリエラ",
            "text": "ひなこが緊張してる\n理由なんて――",
            "zh": "小雏之所以会\n这么紧张——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "89/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤと話してるから\n以外にないじゃない。",
            "zh": "除了在和绫水说话\n还能有什么别的原因。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "90/TALK",
            "narrator": "ガブリエラ",
            "text": "…でも、さっきまでは\n平気じゃなかった？",
            "zh": "……不过，直到刚才\n不是还挺正常的吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "92/TALK",
            "narrator": "雛",
            "text": "うーん…ほら、\nこういう時って\nいつもは――",
            "zh": "嗯……你看，\n平时这种时候\n一般都有——",
            "narrator_zh": "雏"
        },
        {
            "location": "93/TALK",
            "narrator": "雛",
            "text": "つばめちゃんや\nまゆちん達も\n一緒だし。",
            "zh": "燕还有\n小茧她们\n一起在嘛。",
            "narrator_zh": "雏"
        },
        {
            "location": "94/TALK",
            "narrator": "雛",
            "text": "それに、今日のは\n不意打ちだった\nから…。",
            "zh": "而且今天这也算是\n突如其来\n所以……。",
            "narrator_zh": "雏"
        },
        {
            "location": "96/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "104/TALK",
            "narrator": "アーヤ",
            "text": "ちょっといい？(￣Д￣ )",
            "zh": "现在方便聊一下吗？(￣Д￣ )",
            "narrator_zh": "绫水"
        },
        {
            "location": "106/SEL",
            "narrator": "",
            "text": "ひなこのこと？",
            "zh": "是说小雏的事？",
            "narrator_zh": ""
        },
        {
            "location": "107/ACT",
            "narrator": "",
            "text": "ひなこのこと？",
            "zh": "是说小雏的事？",
            "narrator_zh": ""
        },
        {
            "location": "109/TALK",
            "narrator": "アーヤ",
            "text": "そう(￣∇￣)",
            "zh": "对(￣∇￣)",
            "narrator_zh": "绫水"
        },
        {
            "location": "110/TALK",
            "narrator": "アーヤ",
            "text": "日向さん",
            "zh": "日向她",
            "narrator_zh": "绫水"
        },
        {
            "location": "111/TALK",
            "narrator": "アーヤ",
            "text": "バイトも一緒だし",
            "zh": "打工也在一起",
            "narrator_zh": "绫水"
        },
        {
            "location": "112/TALK",
            "narrator": "アーヤ",
            "text": "慣れてくれたと思ったけど（；￢＿￢）",
            "zh": "我以为她已经习惯了（；￢＿￢）",
            "narrator_zh": "绫水"
        },
        {
            "location": "113/TALK",
            "narrator": "アーヤ",
            "text": "やっぱり",
            "zh": "果然",
            "narrator_zh": "绫水"
        },
        {
            "location": "114/TALK",
            "narrator": "アーヤ",
            "text": "上級生の私とは",
            "zh": "跟我这个高年级生在一起",
            "narrator_zh": "绫水"
        },
        {
            "location": "115/TALK",
            "narrator": "アーヤ",
            "text": "緊張するのかしら？(-ω-;)",
            "zh": "还是会紧张吗？(-ω-;)",
            "narrator_zh": "绫水"
        },
        {
            "location": "117/SEL",
            "narrator": "",
            "text": "いや、そういう理由じゃなくて…",
            "zh": "不，应该不是那个原因……",
            "narrator_zh": ""
        },
        {
            "location": "118/ACT",
            "narrator": "",
            "text": "いや、そういう理由じゃなくて…",
            "zh": "不，应该不是那个原因……",
            "narrator_zh": ""
        },
        {
            "location": "120/TALK",
            "narrator": "アーヤ",
            "text": "え？(￣Д￣ )",
            "zh": "咦？(￣Д￣ )",
            "narrator_zh": "绫水"
        },
        {
            "location": "122/TALK",
            "narrator": "アーヤ",
            "text": "どういうこと？",
            "zh": "什么意思？",
            "narrator_zh": "绫水"
        },
        {
            "location": "124/SEL",
            "narrator": "",
            "text": "気づいてないの！？",
            "zh": "你没发现吗！？",
            "narrator_zh": ""
        },
        {
            "location": "125/ACT",
            "narrator": "",
            "text": "気づいてないの！？",
            "zh": "你没发现吗！？",
            "narrator_zh": ""
        },
        {
            "location": "127/TALK",
            "narrator": "アーヤ",
            "text": "意味が分からないんだけど（￣ー￣？）",
            "zh": "我完全没听懂你在说什么（￣ー￣？）",
            "narrator_zh": "绫水"
        },
        {
            "location": "128/TALK",
            "narrator": "アーヤ",
            "text": "とにかく今は",
            "zh": "总之现在",
            "narrator_zh": "绫水"
        },
        {
            "location": "129/TALK",
            "narrator": "アーヤ",
            "text": "日向さんの緊張",
            "zh": "得先帮日向",
            "narrator_zh": "绫水"
        },
        {
            "location": "130/TALK",
            "narrator": "アーヤ",
            "text": "ほぐす方が先だから(｡-_-｡)",
            "zh": "缓解一下紧张才行(｡-_-｡)",
            "narrator_zh": "绫水"
        },
        {
            "location": "131/TALK",
            "narrator": "アーヤ",
            "text": "何かいい方法ある？",
            "zh": "有什么好办法吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "133/SEL",
            "narrator": "",
            "text": "会話するしかないと思う",
            "zh": "我觉得只能靠聊天了",
            "narrator_zh": ""
        },
        {
            "location": "134/SEL",
            "narrator": "",
            "text": "それ、本当に緊張なのかな？",
            "zh": "那真的是在紧张吗？",
            "narrator_zh": ""
        },
        {
            "location": "135/ACT",
            "narrator": "",
            "text": "会話するしかないと思う",
            "zh": "我觉得只能靠聊天了",
            "narrator_zh": ""
        },
        {
            "location": "136/TALK",
            "narrator": "アーヤ",
            "text": "どんな会話？(￣Д￣ )",
            "zh": "聊什么好？(￣Д￣ )",
            "narrator_zh": "绫水"
        },
        {
            "location": "138/SEL",
            "narrator": "",
            "text": "何でもいいから、とにかく話そう",
            "zh": "聊什么都行，总之先搭话吧",
            "narrator_zh": ""
        },
        {
            "location": "139/ACT",
            "narrator": "",
            "text": "何でもいいから、とにかく話そう",
            "zh": "聊什么都行，总之先搭话吧",
            "narrator_zh": ""
        },
        {
            "location": "141/TALK",
            "narrator": "アーヤ",
            "text": "逆に難しいけど",
            "zh": "这样反而更难啊",
            "narrator_zh": "绫水"
        },
        {
            "location": "142/TALK",
            "narrator": "アーヤ",
            "text": "まあ",
            "zh": "算了",
            "narrator_zh": "绫水"
        },
        {
            "location": "143/TALK",
            "narrator": "アーヤ",
            "text": "とにかくやってみる(>_<)",
            "zh": "总之我先试试看(>_<)",
            "narrator_zh": "绫水"
        },
        {
            "location": "150/TALK",
            "narrator": "アーヤ",
            "text": "…何でもいいとは\nいっても――",
            "zh": "……虽说聊什么\n都行——",
            "narrator_zh": "绫水"
        },
        {
            "location": "151/TALK",
            "narrator": "アーヤ",
            "text": "日向さんに関係が\nありそうな話題が\nいいから…。",
            "zh": "还是找个跟日向\n有关的话题\n比较好……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "153/TALK",
            "narrator": "アーヤ",
            "text": "あっ、そういえば、\n気になってたことが\nあったの。",
            "zh": "啊，对了，\n我有件事一直\n挺在意的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "154/TALK",
            "narrator": "アーヤ",
            "text": "日向さんは確か、\nフェノメノンに\n巻き込まれた時に――",
            "zh": "日向你之前好像说过，\n被卷进\nPhenoMENON的时候——",
            "narrator_zh": "绫水"
        },
        {
            "location": "155/TALK",
            "narrator": "アーヤ",
            "text": "私に助けられたことが\nある、って言ってた\nわね？",
            "zh": "曾经被我\n救过一次，\n对吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "157/TALK",
            "narrator": "雛",
            "text": "あ、はい。\nあの日のことは今でも\nよく覚えてます！",
            "zh": "啊，是的。\n那一天的事我至今\n都记得清清楚楚！",
            "narrator_zh": "雏"
        },
        {
            "location": "159/TALK",
            "narrator": "アーヤ",
            "text": "ごめんなさい。\n私、その時のこと\n覚えてなくて…。",
            "zh": "抱歉。\n我当时不太\n记得了……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "160/TALK",
            "narrator": "雛",
            "text": "あー、そりゃそう\nですよー。",
            "zh": "啊——那也是当然的\n啦——。",
            "narrator_zh": "雏"
        },
        {
            "location": "161/TALK",
            "narrator": "雛",
            "text": "あたしが綾水様を\n見たのだって――",
            "zh": "我见到绫水大人\n的时候也——",
            "narrator_zh": "雏"
        },
        {
            "location": "162/TALK",
            "narrator": "雛",
            "text": "フェノメノンが収束\nした直後の、ちょっと\nだけでしたし。",
            "zh": "只是PhenoMENON\n收敛之后的那一小会儿\n而已嘛。",
            "narrator_zh": "雏"
        },
        {
            "location": "164/TALK",
            "narrator": "ガブリエラ",
            "text": "正体隠さなきゃ\nいけないのに――",
            "zh": "明明必须隐藏\n身份才行——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "165/TALK",
            "narrator": "ガブリエラ",
            "text": "おもいっきり姿\n見られちゃってる\nじゃない。",
            "zh": "这不是让人家\n把样子看了个\n一清二楚嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "167/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤも気が緩むこと\nあるのね？",
            "zh": "绫水原来也会有\n松懈的时候啊？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "169/TALK",
            "narrator": "アーヤ",
            "text": "…面目ないわ。",
            "zh": "……真惭愧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "170/TALK",
            "narrator": "雛",
            "text": "でも、あの時の\n綾水様、本当に\nかっこよかったです。",
            "zh": "不过，那时候的\n绫水大人，真的\n超级帅气。",
            "narrator_zh": "雏"
        },
        {
            "location": "171/TALK",
            "narrator": "雛",
            "text": "ほとんど背中しか\n見えなかったけど――",
            "zh": "虽然几乎只看到了\n背影——",
            "narrator_zh": "雏"
        },
        {
            "location": "172/TALK",
            "narrator": "雛",
            "text": "なんか、大きくて\n頼りがいがあって、\nとっても綺麗で…。",
            "zh": "总觉得又高大\n又可靠，\n而且特别漂亮……。",
            "narrator_zh": "雏"
        },
        {
            "location": "174/TALK",
            "narrator": "アーヤ",
            "text": "あ、ありがとう…。",
            "zh": "谢、谢谢……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "175/TALK",
            "narrator": "ガブリエラ",
            "text": "それって確か、\nアーヤ一人だけの\n時だっけ？",
            "zh": "那时候好像还是\n只有绫水一个人\n出战的时候吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "177/TALK",
            "narrator": "アーヤ",
            "text": "時期的に多分ね。",
            "zh": "按时间推算大概是吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "178/TALK",
            "narrator": "雛",
            "text": "やっぱり、一人で\nフェノメノンを\n収束させるのって――",
            "zh": "果然，一个人\n收敛PhenoMENON\n这件事——",
            "narrator_zh": "雏"
        },
        {
            "location": "179/TALK",
            "narrator": "雛",
            "text": "超凄いことなん\nでしょ？",
            "zh": "是超级厉害的\n对吧？",
            "narrator_zh": "雏"
        },
        {
            "location": "181/TALK",
            "narrator": "アーヤ",
            "text": "どうかしら？\nモノにもよると\n思うけど。",
            "zh": "谁知道呢？\n我觉得也得看\n具体是什么东西。",
            "narrator_zh": "绫水"
        },
        {
            "location": "182/TALK",
            "narrator": "ガブリエラ",
            "text": "いや、普通に考えて\nバケモノだし。",
            "zh": "不，正常来想\n就是怪物级别了吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "183/TALK",
            "narrator": "アーヤ",
            "text": "も、もう少し違う\n言い方ないの？",
            "zh": "就、就不能换个\n好听点的说法吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "185/TALK",
            "narrator": "雛",
            "text": "同じトライナリーの\nガブリエラちゃんが\nそう言うんだから――",
            "zh": "同为三重奏的\n加布里埃拉\n都这么说了——",
            "narrator_zh": "雏"
        },
        {
            "location": "187/TALK",
            "narrator": "雛",
            "text": "やっぱり綾水様は\n凄い人です！",
            "zh": "果然绫水大人就是\n超厉害的人！",
            "narrator_zh": "雏"
        },
        {
            "location": "188/TALK",
            "narrator": "雛",
            "text": "あ、でももちろん\nあたしは化け物とか\n思ってませんよ？",
            "zh": "啊，不过我当然\n没有把你想成\n怪物哦？",
            "narrator_zh": "雏"
        },
        {
            "location": "189/TALK",
            "narrator": "雛",
            "text": "あたしにとっては\n英雄的存在ですから！",
            "zh": "对我来说，你可是\n英雄一般的存在呢！",
            "narrator_zh": "雏"
        },
        {
            "location": "192/TALK",
            "narrator": "ガブリエラ",
            "text": "ぷっ…、さすがに\n言い過ぎじゃない？",
            "zh": "噗……，这未免\n吹得太过了吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "195/TALK",
            "narrator": "アーヤ",
            "text": "そ、そうね…。\n私はやるべきことを\nしただけなんだし…。",
            "zh": "就、就是说啊……。\n我只是做了\n分内之事而已……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "197/TALK",
            "narrator": "ガブリエラ",
            "text": "とか言いつつ、\n満更でもなさそうな\n顔してるけど？",
            "zh": "嘴上这么说着，\n脸上倒是一副\n挺受用的表情嘛？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "199/TALK",
            "narrator": "アーヤ",
            "text": "してないから！",
            "zh": "才没有！",
            "narrator_zh": "绫水"
        },
        {
            "location": "200/TALK",
            "narrator": "雛",
            "text": "本当、綾水様は\nあたしにとっての\n英雄で、勇者様です。",
            "zh": "真的，绫水大人\n对我来说就是\n英雄，是勇者大人。",
            "narrator_zh": "雏"
        },
        {
            "location": "201/TALK",
            "narrator": "雛",
            "text": "もしまたあたしが\nフェノメノンに\n巻き込まれた際は――",
            "zh": "要是我以后再被\n卷进PhenoMENON\n的时候——",
            "narrator_zh": "雏"
        },
        {
            "location": "202/TALK",
            "narrator": "雛",
            "text": "助けに来て\nくれますか？",
            "zh": "你会来\n救我吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "206/TALK",
            "narrator": "アーヤ",
            "text": "もちろんよ。\nギャヴィも一緒にね。",
            "zh": "当然了。\n加维也会一起去。",
            "narrator_zh": "绫水"
        },
        {
            "location": "207/TALK",
            "narrator": "ガブリエラ",
            "text": "ま、それがあたし達の\n仕事だしね。",
            "zh": "嘛，那本来就是\n我们的工作嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "208/TALK",
            "narrator": "雛",
            "text": "じゃあ、その時には\n綾水様――",
            "zh": "那到时候\n绫水大人——",
            "narrator_zh": "雏"
        },
        {
            "location": "209/TALK",
            "narrator": "雛",
            "text": "あたしをお姫様抱っこ\nして助けてください！",
            "zh": "请用公主抱\n把我救出去吧！",
            "narrator_zh": "雏"
        },
        {
            "location": "210/TALK",
            "narrator": "アーヤ",
            "text": "はい？",
            "zh": "啊？",
            "narrator_zh": "绫水"
        },
        {
            "location": "211/TALK",
            "narrator": "ガブリエラ　",
            "text": "はぁ！？",
            "zh": "哈啊！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "212/TALK",
            "narrator": "雛",
            "text": "フェノメノンから\n解放された後って――",
            "zh": "从PhenoMENON里\n解放出来之后——",
            "narrator_zh": "雏"
        },
        {
            "location": "213/TALK",
            "narrator": "雛",
            "text": "なんかこう、頭の中が\nぼーっとした感じに\nなるんですよー。",
            "zh": "总觉得脑子里\n会变得昏昏沉沉的\n这样子——。",
            "narrator_zh": "雏"
        },
        {
            "location": "214/TALK",
            "narrator": "雛",
            "text": "だから、あの時も\nまたすぐに意識を\n失っちゃって…。",
            "zh": "所以那时候我也\n很快又失去意识了\n……。",
            "narrator_zh": "雏"
        },
        {
            "location": "216/TALK",
            "narrator": "ガブリエラ",
            "text": "それとお姫様抱っこに\n何の関係があるのよ？",
            "zh": "那跟公主抱\n有什么关系啊？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "217/TALK",
            "narrator": "雛",
            "text": "だから、その時は\n綾水様に介抱されたい\nってことだよー。",
            "zh": "所以说，那时候\n我想让绫水大人\n来照顾我嘛——。",
            "narrator_zh": "雏"
        },
        {
            "location": "219/TALK",
            "narrator": "雛",
            "text": "もちろん、綾水様に\nだったらお持ち帰り\nされても――",
            "zh": "当然，如果是绫水大人的话\n直接把我带回家\n我也——",
            "narrator_zh": "雏"
        },
        {
            "location": "220/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしが蹴っ飛ばして\n起こしてやるわよ。",
            "zh": "我直接一脚踹醒你\n信不信啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "222/TALK",
            "narrator": "雛",
            "text": "ちょ！？\nガブリエラちゃん\n暴力的だよー。",
            "zh": "喂！？\n加布里埃拉\n你好暴力啊——。",
            "narrator_zh": "雏"
        },
        {
            "location": "223/TALK",
            "narrator": "ガブリエラ",
            "text": "あんたにアーヤの\nお姫様抱っこなんて\n一兆年早いわ！",
            "zh": "想要绫水的\n公主抱，你这家伙\n还早了一兆年呢！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "224/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしだって、\nまだ一度も…。",
            "zh": "连我都还\n一次都没……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "225/TALK",
            "narrator": "雛",
            "text": "ん？　なになに？",
            "zh": "嗯？　什么什么？",
            "narrator_zh": "雏"
        },
        {
            "location": "226/TALK",
            "narrator": "ガブリエラ",
            "text": "な、何でもない！",
            "zh": "没、没什么！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "227/TALK",
            "narrator": "ガブリエラ",
            "text": "とにかく、その時は\nあたしが蹴っ飛ばして\n起こすから――",
            "zh": "总之，到时候\n我会直接一脚\n把你踹醒的——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "228/TALK",
            "narrator": "ガブリエラ",
            "text": "ひなこは安心して\n気を失っていいわよ。",
            "zh": "小雏你就放心\n晕过去好了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "229/TALK",
            "narrator": "雛",
            "text": "ぶー、ダメでーす。\n綾水様のキスじゃ\nなきゃ起きませーん。",
            "zh": "嘘——，才不要——。\n不是绫水大人的吻\n我可醒不过来——。",
            "narrator_zh": "雏"
        },
        {
            "location": "230/TALK",
            "narrator": "ガブリエラ",
            "text": "何でキスになるのよ！",
            "zh": "怎么就变成吻了啊！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "232/TALK",
            "narrator": "アーヤ",
            "text": "…ふふっ。",
            "zh": "……呵呵。",
            "narrator_zh": "绫水"
        },
        {
            "location": "234/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィってば、\nいつの間に\n日向さんと――",
            "zh": "加维这孩子，\n不知不觉间\n跟日向——",
            "narrator_zh": "绫水"
        },
        {
            "location": "235/TALK",
            "narrator": "アーヤ",
            "text": "こんな仲良しに\nなったのかしら？",
            "zh": "变得这么\n要好了吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "236/ACT",
            "narrator": "",
            "text": "それ、本当に緊張なのかな？",
            "zh": "那真的是在紧张吗？",
            "narrator_zh": ""
        },
        {
            "location": "237/TALK",
            "narrator": "アーヤ",
            "text": "どういうこと？(￣Д￣ )",
            "zh": "什么意思？(￣Д￣ )",
            "narrator_zh": "绫水"
        },
        {
            "location": "239/SEL",
            "narrator": "",
            "text": "そわそわしてる別の理由といえば？",
            "zh": "坐立不安还有什么别的原因吗？",
            "narrator_zh": ""
        },
        {
            "location": "240/ACT",
            "narrator": "",
            "text": "そわそわしてる別の理由といえば？",
            "zh": "坐立不安还有什么别的原因吗？",
            "narrator_zh": ""
        },
        {
            "location": "244/TALK",
            "narrator": "アーヤ",
            "text": "そういうことね(>_<)",
            "zh": "原来如此(>_<)",
            "narrator_zh": "绫水"
        },
        {
            "location": "245/TALK",
            "narrator": "アーヤ",
            "text": "わかった",
            "zh": "我知道了",
            "narrator_zh": "绫水"
        },
        {
            "location": "246/TALK",
            "narrator": "アーヤ",
            "text": "ありがとう(￣∇￣)",
            "zh": "谢谢(￣∇￣)",
            "narrator_zh": "绫水"
        },
        {
            "location": "254/TALK",
            "narrator": "アーヤ",
            "text": "ごめんなさい、\n気づけなかったわ。",
            "zh": "抱歉，\n我没注意到。",
            "narrator_zh": "绫水"
        },
        {
            "location": "256/TALK",
            "narrator": "雛",
            "text": "え？　何がですか？",
            "zh": "咦？　什么事啊？",
            "narrator_zh": "雏"
        },
        {
            "location": "258/TALK",
            "narrator": "アーヤ",
            "text": "日向さん、\n学食の前に――",
            "zh": "日向，你本来\n在来食堂之前——",
            "narrator_zh": "绫水"
        },
        {
            "location": "259/TALK",
            "narrator": "アーヤ",
            "text": "お手洗い行くつもり\nだったんじゃない？",
            "zh": "是不是打算\n先去趟洗手间的？",
            "narrator_zh": "绫水"
        },
        {
            "location": "262/TALK",
            "narrator": "雛",
            "text": "はい！？",
            "zh": "啊！？",
            "narrator_zh": "雏"
        },
        {
            "location": "265/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…どうしてそう\nなっちゃうのよ？",
            "zh": "唉……怎么会\n联想到那儿去啊？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "266/TALK",
            "narrator": "雛",
            "text": "いや、違いますから！\nそれ、綾水様の\n誤解ですよ！",
            "zh": "不是，才不是呢！\n那是绫水大人\n误会了啦！",
            "narrator_zh": "雏"
        },
        {
            "location": "267/TALK",
            "narrator": "アーヤ",
            "text": "本当？",
            "zh": "真的？",
            "narrator_zh": "绫水"
        },
        {
            "location": "268/TALK",
            "narrator": "雛",
            "text": "本当ですよー！",
            "zh": "是真的啦——！",
            "narrator_zh": "雏"
        },
        {
            "location": "270/TALK",
            "narrator": "アーヤ",
            "text": "そっか…。\nでも、我慢はしないで\nいいからね？",
            "zh": "这样啊……。\n不过，不用忍着\n也没关系哦？",
            "narrator_zh": "绫水"
        },
        {
            "location": "271/TALK",
            "narrator": "雛",
            "text": "だから、\n違いますってー！",
            "zh": "都说了\n不是那样啦——！",
            "narrator_zh": "雏"
        },
        {
            "location": "273/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤ、ひなこは\n最初から緊張してる\nって言ってるでしょ？",
            "zh": "绫水，小雏从刚才\n就一直说自己是\n紧张对吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "274/TALK",
            "narrator": "アーヤ",
            "text": "でも、それにしては\n緊張し過ぎてる\n気がするし…。",
            "zh": "话虽如此，\n总觉得未免也\n紧张过头了……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "275/TALK",
            "narrator": "ガブリエラ",
            "text": "だからって、\nよりにもよって\nトイレと間違える？",
            "zh": "就算这样，\n偏偏搞错成\n想去厕所吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "276/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤって、\n本当変なところで\n抜けてるわよね。",
            "zh": "绫水真是的，\n老是在奇怪的地方\n少根筋呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "278/TALK",
            "narrator": "アーヤ",
            "text": "そ、そうかしら…？",
            "zh": "是、是这样吗……？",
            "narrator_zh": "绫水"
        },
        {
            "location": "279/TALK",
            "narrator": "ガブリエラ",
            "text": "じゃなきゃこんな\n間違いしないって。",
            "zh": "不然谁会犯这种\n错误啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "281/TALK",
            "narrator": "ガブリエラ",
            "text": "そういうことだから、\nひなこも無駄に緊張\nする必要ないわよ。",
            "zh": "事情就是这样，\n小雏也没必要\n白白紧张了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "283/TALK",
            "narrator": "雛",
            "text": "うん…綾水様って、\nかっこいい人だと\n思ってたけど――",
            "zh": "嗯……我一直以为\n绫水大人是个\n超帅气的人——",
            "narrator_zh": "雏"
        },
        {
            "location": "284/TALK",
            "narrator": "雛",
            "text": "こういう\n超可愛い一面も\nあるんですねー。",
            "zh": "原来还有这么\n超级可爱的一面\n呀——。",
            "narrator_zh": "雏"
        },
        {
            "location": "286/TALK",
            "narrator": "アーヤ",
            "text": "え？　そ、そう？",
            "zh": "咦？　是、是吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "288/TALK",
            "narrator": "ガブリエラ",
            "text": "…わからないわ。",
            "zh": "……真搞不懂。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "289/TALK",
            "narrator": "ガブリエラ",
            "text": "今のやり取りの、\nどこに可愛いとこが\nあったわけ？",
            "zh": "刚才那段对话里，\n到底哪里有\n可爱的地方了？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "290/TALK",
            "narrator": "雛",
            "text": "ギャップ萌えだよ、\nギャップ萌え！！",
            "zh": "是反差萌啦，\n反差萌！！",
            "narrator_zh": "雏"
        },
        {
            "location": "291/TALK",
            "narrator": "雛",
            "text": "普段キリッとしてる\n綾水様の――",
            "zh": "平时那么干练的\n绫水大人——",
            "narrator_zh": "雏"
        },
        {
            "location": "292/TALK",
            "narrator": "雛",
            "text": "意外なところで\n抜けてる一面！",
            "zh": "在意想不到的地方\n犯迷糊的一面！",
            "narrator_zh": "雏"
        },
        {
            "location": "293/TALK",
            "narrator": "雛",
            "text": "超可愛いと思わない？",
            "zh": "你不觉得超级可爱吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "294/TALK",
            "narrator": "ガブリエラ",
            "text": "…結局、アーヤなら\n何だっていい、って\nことじゃないの？",
            "zh": "……说到底，只要是绫水\n无论怎样你都觉得好\n对吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "295/TALK",
            "narrator": "雛",
            "text": "そうとも言うねー。",
            "zh": "也可以这么说呢——。",
            "narrator_zh": "雏"
        },
        {
            "location": "297/TALK",
            "narrator": "雛",
            "text": "というわけで、\n今まで以上に綾水様に\n惚れちゃいました！",
            "zh": "所以说，\n我比以前更加迷上\n绫水大人了！",
            "narrator_zh": "雏"
        },
        {
            "location": "298/TALK",
            "narrator": "雛",
            "text": "これからも、綾水様の\n色んなギャップを\n見せてくださいねー。",
            "zh": "今后也请让我多看看\n绫水大人的各种反差\n吧——。",
            "narrator_zh": "雏"
        },
        {
            "location": "301/TALK",
            "narrator": "アーヤ",
            "text": "あ、あはは…、\n見せてるつもりは\nないんだけど…。",
            "zh": "啊、啊哈哈……，\n我也不是故意\n要展示给你看的……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "303/TALK",
            "narrator": "ガブリエラ",
            "text": "っていうか、ひなこ！\nちょっとアーヤに\n近づき過ぎ！",
            "zh": "话说回来，小雏！\n你离绫水\n靠得太近了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "304/TALK",
            "narrator": "雛",
            "text": "いやー、綾水様の\nギャップに胸キュン\nしちゃって――",
            "zh": "哎呀，因为绫水大人的\n反差实在太让人心动了\n嘛——",
            "narrator_zh": "雏"
        },
        {
            "location": "306/TALK",
            "narrator": "雛",
            "text": "ちょーっと、\n抱き着きたいなぁ、\nなんて…。",
            "zh": "稍微有点\n想抱上去蹭蹭，\n什么的……。",
            "narrator_zh": "雏"
        },
        {
            "location": "307/TALK",
            "narrator": "ガブリエラ",
            "text": "却下！！\nアーヤが許しても\nあたしが許さないわ！",
            "zh": "驳回！！\n就算绫水允许\n我也绝不允许！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "309/TALK",
            "narrator": "アーヤ",
            "text": "…ふふっ。",
            "zh": "……呵呵。",
            "narrator_zh": "绫水"
        },
        {
            "location": "310/TALK",
            "narrator": "アーヤ",
            "text": "この二人、いつの間に\nこんなに仲良く\nなったのかしら？",
            "zh": "这两个人，不知不觉间\n关系已经变得\n这么好了吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "18/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>7月15日　0:04 PM</color>\nとある昼休み、学園の廊下にて。",
            "zh": "<color=green>7月15日　0:04 PM</color>\n某个午休时间，在学园的走廊里。",
            "narrator_zh": "Dialog_EventData"
        }
    ]
}
