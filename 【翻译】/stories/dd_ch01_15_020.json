{
    "dir": "chap15/daydra/dd_ch01_15_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "15156",
        "cid": "tsubame",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "ファンクラブ",
        "title_zh": "Extra006 额外剧情",
        "sub_title_zh": "粉丝团"
    },
    "entry": [
        {
            "location": "245/SCENARIO",
            "narrator": "",
            "text": "ファンクラブ",
            "zh": "粉丝团",
            "narrator_zh": ""
        },
        {
            "location": "260/TALK",
            "narrator": "雛",
            "text": "うわぁ、つばめちゃんの\nお弁当、凄い豪華ー！",
            "zh": "哇，燕的\n便当，好豪华——！",
            "narrator_zh": "雏"
        },
        {
            "location": "262/TALK",
            "narrator": "キリト",
            "text": "うぉ、本当だ！\n手が込んでるな…。",
            "zh": "喔，真的！\n做得挺讲究……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "264/TALK",
            "narrator": "繭",
            "text": "これ、全部手作り？\n冷凍食品が一つも入って\nないようだけど…。",
            "zh": "这全是亲手做的？\n冷冻食品一个都\n没放进去……。",
            "narrator_zh": "茧"
        },
        {
            "location": "266/TALK",
            "narrator": "つばめ",
            "text": "そうみたいだね。",
            "zh": "好像是呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "267/TALK",
            "narrator": "繭",
            "text": "？　逢瀬さんが\n作ったんじゃないの？",
            "zh": "？　逢濑\n不是你做的吗？",
            "narrator_zh": "茧"
        },
        {
            "location": "270/TALK",
            "narrator": "つばめ",
            "text": "実はこのお弁当、\n中等部の女の子に\n貰ったものなの。",
            "zh": "其实这个便当，\n是初中部的女孩子\n送给我的。",
            "narrator_zh": "燕"
        },
        {
            "location": "271/TALK",
            "narrator": "雛",
            "text": "ガブリエラちゃん以外に、\n中等部のお友達がいるの？",
            "zh": "除了加布里埃拉，\n初中部还有朋友吗？",
            "narrator_zh": "雏"
        },
        {
            "location": "274/TALK",
            "narrator": "つばめ",
            "text": "お友達じゃないんだけど、\nその――",
            "zh": "不是朋友，\n那个——",
            "narrator_zh": "燕"
        },
        {
            "location": "275/TALK",
            "narrator": "つばめ",
            "text": "中等部にね、特別攻撃隊の\nファンクラブがあるん\nだって。",
            "zh": "初中部呀，听说有\n特别攻击队的\n粉丝团。",
            "narrator_zh": "燕"
        },
        {
            "location": "276/TALK",
            "narrator": "繭",
            "text": "ああ…そういうこと。",
            "zh": "啊……是这么回事。",
            "narrator_zh": "茧"
        },
        {
            "location": "278/TALK",
            "narrator": "キリト",
            "text": "へぇ…けど、新人なのに\nもう弁当くれるような\nファンがいるなんて――",
            "zh": "嘿……不过，才是新人，\n就有会送便当的\n粉丝——",
            "narrator_zh": "圣翔"
        },
        {
            "location": "279/TALK",
            "narrator": "キリト",
            "text": "逢瀬、凄ぇじゃん！\nさすがは特別攻撃隊\n期待の新星！！",
            "zh": "逢濑，很厉害嘛！\n不愧是特别攻击队\n期待的新星！！",
            "narrator_zh": "圣翔"
        },
        {
            "location": "283/TALK",
            "narrator": "つばめ",
            "text": "も、もぉ、\nからかわないでよぉ…。",
            "zh": "别、别这样，\n别取笑我呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "284/TALK",
            "narrator": "ガブリエラ",
            "text": "いや、実際のとこ、\nあんたって結構人気ある\nみたいよ？",
            "zh": "不，实际上，\n你好像还挺有人气\n的哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "296/TALK",
            "narrator": "雛",
            "text": "あ、ガブリエラちゃん。",
            "zh": "啊，加布里埃拉。",
            "narrator_zh": "雏"
        },
        {
            "location": "299/TALK",
            "narrator": "つばめ",
            "text": "人気って…どの辺りが？",
            "zh": "人气……是哪方面？",
            "narrator_zh": "燕"
        },
        {
            "location": "301/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしが知るわけ\nないじゃん。",
            "zh": "我怎么会\n知道。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "304/TALK",
            "narrator": "ガブリエラ",
            "text": "けど、教室でもあんたの\n話してる子、よく見るわ。",
            "zh": "不过，教室里聊你的\n孩子，我经常看到。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "306/TALK",
            "narrator": "雛",
            "text": "…まあ、つばめちゃんは\n特別攻撃隊の人の中だと、\n一番近づきやすいし――",
            "zh": "……嘛，燕在\n特别攻击队里，\n是最好接近的——",
            "narrator_zh": "雏"
        },
        {
            "location": "307/TALK",
            "narrator": "雛",
            "text": "性格的にも、年下から\n人気が出るのは\nわからなくもないかな？",
            "zh": "性格上，会受\n年纪小的人欢迎，\n也不是不能理解？",
            "narrator_zh": "雏"
        },
        {
            "location": "310/TALK",
            "narrator": "キリト",
            "text": "天然だしな。",
            "zh": "而且还是天然。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "313/TALK",
            "narrator": "繭",
            "text": "押しにも弱い。",
            "zh": "而且一劝就松口。",
            "narrator_zh": "茧"
        },
        {
            "location": "314/TALK",
            "narrator": "つばめ",
            "text": "あ、あのー、本人の前で\n言うのはどうかと思うよ？",
            "zh": "啊、那个，当着本人\n这么说不太好吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "316/TALK",
            "narrator": "ガブリエラ",
            "text": "でもまあ、実際それが\n人気の理由じゃないの？",
            "zh": "不过嘛，实际上那不就是\n受欢迎的理由吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "319/TALK",
            "narrator": "つばめ",
            "text": "そっか…。",
            "zh": "是这样呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "320/TALK",
            "narrator": "つばめ",
            "text": "なんか、嬉しいな。\nそんな風にわたしのこと、\n好きでいてくれるなんて。",
            "zh": "总觉得，好高兴呀。\n会这样喜欢着我，\n真没想到。",
            "narrator_zh": "燕"
        },
        {
            "location": "321/TALK",
            "narrator": "つばめ",
            "text": "…でも、お弁当貰うのは\n今回で最後にしないと…。",
            "zh": "……不过，收便当\n这次得是最后一次了……。",
            "narrator_zh": "燕"
        },
        {
            "location": "322/SEL",
            "narrator": "",
            "text": "貰っておけばいいじゃん",
            "zh": "收下不就好了",
            "narrator_zh": ""
        },
        {
            "location": "323/SEL",
            "narrator": "",
            "text": "悲しまれると思う",
            "zh": "我觉得会让人难过",
            "narrator_zh": ""
        },
        {
            "location": "324/SEL",
            "narrator": "",
            "text": "ていうか、お礼しなきゃ",
            "zh": "话说，得道谢才行",
            "narrator_zh": ""
        },
        {
            "location": "326/TALK",
            "narrator": "ガブリエラ",
            "text": "不味かったの？",
            "zh": "不好吃吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "330/TALK",
            "narrator": "つばめ",
            "text": "ううん、凄く美味しいよ！",
            "zh": "不，特别好吃呀！",
            "narrator_zh": "燕"
        },
        {
            "location": "331/TALK",
            "narrator": "つばめ",
            "text": "けど、やっぱり物を\n貰うのは良くないもん。",
            "zh": "可是，收别人的东西\n果然还是不好呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "334/TALK",
            "narrator": "キリト",
            "text": "それくらいいいじゃん。\n向こうが勝手に作って\nくれてるんだし。",
            "zh": "这种程度没关系吧。\n又是对方自己\n做来的。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "337/TALK",
            "narrator": "つばめ",
            "text": "そういうわけには\nいかないよ。",
            "zh": "那样\n可不行呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "340/TALK",
            "narrator": "つばめ",
            "text": "気持ちは凄く嬉しいし、\n本当に善意でしてくれてる\nくのはわかるけど――",
            "zh": "心意我很高兴，\n也明白是真心\n出于好意——",
            "narrator_zh": "燕"
        },
        {
            "location": "341/TALK",
            "narrator": "つばめ",
            "text": "だからって、毎日お弁当を\nもらっていい理由には\nならないもん。",
            "zh": "可那也不能成为\n每天收便当的\n理由呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "342/TALK",
            "narrator": "つばめ",
            "text": "それに、こんなに凄い\nお弁当だと、作るのに\n時間が掛かると思うし。",
            "zh": "而且，这么厉害的\n便当，做起来\n也要花时间。",
            "narrator_zh": "燕"
        },
        {
            "location": "343/TALK",
            "narrator": "つばめ",
            "text": "お弁当箱を返すとき、\nこれだけはしっかりと\n伝えておくつもりだよ。",
            "zh": "还便当盒的时候，\n这件事我打算\n好好说清楚呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "345/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…そういうところも、\nあんたが人気の理由\nなんじゃないの？",
            "zh": "唉……这种地方，\n不也是你受欢迎的\n理由吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "346/TALK",
            "narrator": "雛",
            "text": "ああ、確かに。",
            "zh": "啊，确实。",
            "narrator_zh": "雏"
        },
        {
            "location": "347/TALK",
            "narrator": "つばめ",
            "text": "どういうこと？",
            "zh": "什么意思？",
            "narrator_zh": "燕"
        },
        {
            "location": "349/TALK",
            "narrator": "雛",
            "text": "天然娘に見えるけど、\nしっかりしてるところは\nしっかりしてるところ。",
            "zh": "看着像天然，\n该稳的地方\n是稳的。",
            "narrator_zh": "雏"
        },
        {
            "location": "350/TALK",
            "narrator": "つばめ",
            "text": "だ、だから、天然天然って\n言わないでよぉ！",
            "zh": "所、所以，别一个劲\n天然天然的呀！",
            "narrator_zh": "燕"
        },
        {
            "location": "352/ACT",
            "narrator": "",
            "text": "貰っておけばいいじゃん",
            "zh": "收下不就好了",
            "narrator_zh": ""
        },
        {
            "location": "373/TALK",
            "narrator": "つばめ",
            "text": "ううん、ダメだよ",
            "zh": "不，不行呀",
            "narrator_zh": "燕"
        },
        {
            "location": "374/TALK",
            "narrator": "つばめ",
            "text": "こういうことはきちんとしておかないと",
            "zh": "这种事不说清楚不行",
            "narrator_zh": "燕"
        },
        {
            "location": "386/TALK",
            "narrator": "キリト",
            "text": "もったいねぇなぁ。\nせっかく作ってもらえる\nってのに…。",
            "zh": "太可惜了啊。\n好不容易有人\n愿意做……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "389/TALK",
            "narrator": "つばめ",
            "text": "気持ちは凄く嬉しいし、\n本当に善意でしてくれてる\nくのはわかるけど――",
            "zh": "心意我很高兴，\n也明白是真心\n出于好意——",
            "narrator_zh": "燕"
        },
        {
            "location": "392/TALK",
            "narrator": "つばめ",
            "text": "だからって、毎日お弁当を\nもらっていい理由には\nならないもん。",
            "zh": "可那也不能成为\n每天收便当的\n理由呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "393/TALK",
            "narrator": "つばめ",
            "text": "それに、こんなに凄い\nお弁当だと、作るのにも\n時間が掛かると思うし。",
            "zh": "而且，这么厉害的\n便当，做起来也\n要花时间。",
            "narrator_zh": "燕"
        },
        {
            "location": "394/TALK",
            "narrator": "つばめ",
            "text": "お弁当箱を返すとき、\nこれだけはしっかりと\n伝えておくつもりだよ。",
            "zh": "还便当盒的时候，\n这件事我打算\n好好说清楚呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "396/TALK",
            "narrator": "ガブリエラ",
            "text": "はぁ…そういうところも、\nあんたが人気の理由\nなんじゃないの？",
            "zh": "唉……这种地方，\n不也是你受欢迎的\n理由吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "397/TALK",
            "narrator": "雛",
            "text": "ああ、確かに。",
            "zh": "啊，确实。",
            "narrator_zh": "雏"
        },
        {
            "location": "398/TALK",
            "narrator": "つばめ",
            "text": "どういうこと？",
            "zh": "什么意思？",
            "narrator_zh": "燕"
        },
        {
            "location": "399/TALK",
            "narrator": "雛",
            "text": "天然娘に見えるけど、\nしっかりしてるところは\nしっかりしてるところ。",
            "zh": "看着像天然，\n该稳的地方\n是稳的。",
            "narrator_zh": "雏"
        },
        {
            "location": "400/TALK",
            "narrator": "つばめ",
            "text": "だ、だから、天然天然って\n言わないでよぉ！",
            "zh": "所、所以，别一个劲\n天然天然的呀！",
            "narrator_zh": "燕"
        },
        {
            "location": "401/ACT",
            "narrator": "",
            "text": "悲しまれると思う",
            "zh": "我觉得会让人难过",
            "narrator_zh": ""
        },
        {
            "location": "423/TALK",
            "narrator": "つばめ",
            "text": "そうかな？",
            "zh": "是吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "424/TALK",
            "narrator": "つばめ",
            "text": "さすがに、悲しまれたりはしないと思うけど…",
            "zh": "总不至于会让人难过吧……",
            "narrator_zh": "燕"
        },
        {
            "location": "435/TALK",
            "narrator": "つばめ",
            "text": "…わたしがお弁当を\n受け取らないって\n言ったら――",
            "zh": "……要是我说\n不收便当\n的话——",
            "narrator_zh": "燕"
        },
        {
            "location": "436/TALK",
            "narrator": "つばめ",
            "text": "もしかして、悲しまれ\nたりするかな？",
            "zh": "会不会\n让人难过呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "437/TALK",
            "narrator": "雛",
            "text": "その子、つばめちゃんの\n大ファンなんでしょ？",
            "zh": "那孩子，是燕的\n大粉丝吧？",
            "narrator_zh": "雏"
        },
        {
            "location": "438/TALK",
            "narrator": "雛",
            "text": "応援してるつばめちゃんに\n食べてもらいたくて、\nお弁当作ったのに――",
            "zh": "想让自己支持的燕\n吃到，\n才做了便当——",
            "narrator_zh": "雏"
        },
        {
            "location": "439/TALK",
            "narrator": "雛",
            "text": "受け取れません、って\n言われたらねー…。",
            "zh": "要是被说\n不能收，那就……。",
            "narrator_zh": "雏"
        },
        {
            "location": "440/TALK",
            "narrator": "キリト",
            "text": "悲しまないわけねぇよな。",
            "zh": "怎么可能不难过啊。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "442/TALK",
            "narrator": "つばめ",
            "text": "うっ…そ、そっか…。",
            "zh": "呜……是、是这样呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "443/TALK",
            "narrator": "繭",
            "text": "けど、逢瀬さんが困るなら\n受け取らない方がいいと\n思う。",
            "zh": "不过，要是逢濑为难，\n我觉得还是\n别收比较好。",
            "narrator_zh": "茧"
        },
        {
            "location": "444/TALK",
            "narrator": "繭",
            "text": "そんな風に受け取られてる\nって後で知ったら――",
            "zh": "要是事后知道\n被人这么理解——",
            "narrator_zh": "茧"
        },
        {
            "location": "445/TALK",
            "narrator": "繭",
            "text": "そっちの方がショック\n大きいと思うし。",
            "zh": "那边的打击\n我觉得更大。",
            "narrator_zh": "茧"
        },
        {
            "location": "448/TALK",
            "narrator": "つばめ",
            "text": "じゃ、じゃあ、やっぱり\n断った方がいいのかな？",
            "zh": "那、那么，果然\n还是拒绝比较好吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "449/TALK",
            "narrator": "繭",
            "text": "その方がいいと思う。\n悲しまれはすると\n思うけど。",
            "zh": "我觉得那样比较好。\n虽然会让人\n难过。",
            "narrator_zh": "茧"
        },
        {
            "location": "452/TALK",
            "narrator": "つばめ",
            "text": "うう…なんだか、\n断り難い気持ちになって\nきちゃったよぉ…。",
            "zh": "呜呜……总觉得，\n越来越说不出口\n呀……。",
            "narrator_zh": "燕"
        },
        {
            "location": "453/ACT",
            "narrator": "",
            "text": "ていうか、お礼しなきゃ",
            "zh": "话说，得道谢才行",
            "narrator_zh": ""
        },
        {
            "location": "475/TALK",
            "narrator": "つばめ",
            "text": "いけない、すっかり忘れてた！",
            "zh": "不好，完全忘了！",
            "narrator_zh": "燕"
        },
        {
            "location": "476/TALK",
            "narrator": "つばめ",
            "text": "教えてくれてありがと",
            "zh": "谢谢你告诉我",
            "narrator_zh": "燕"
        },
        {
            "location": "487/TALK",
            "narrator": "つばめ",
            "text": "…お弁当のお礼には、\nやっぱりお弁当で返すのが\n一番かな？",
            "zh": "……谢便当的话，\n果然还是回一份便当\n最好吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "489/TALK",
            "narrator": "ガブリエラ",
            "text": "それ、おもいっきり\n逆効果だから。",
            "zh": "那个，完全\n会起反效果。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "492/TALK",
            "narrator": "キリト",
            "text": "弁当渡せば、逢瀬から\nお礼に弁当貰える、って\n思う奴らが出てくるぞ？",
            "zh": "把便当给出去的话，\n就会有人想从逢濑这儿\n收到回礼便当哦？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "496/TALK",
            "narrator": "つばめ",
            "text": "えっ！？",
            "zh": "诶！？",
            "narrator_zh": "燕"
        },
        {
            "location": "497/TALK",
            "narrator": "つばめ",
            "text": "で、でも、返すときに\nもうこれっきりにして、\nってお願いするし…。",
            "zh": "可、可是，还的时候\n我会拜托就这一次，\n……。",
            "narrator_zh": "燕"
        },
        {
            "location": "498/TALK",
            "narrator": "繭",
            "text": "その子はわかっても、\n他の子達はそうじゃない。",
            "zh": "那个孩子明白了，\n其他孩子可不一样。",
            "narrator_zh": "茧"
        },
        {
            "location": "499/TALK",
            "narrator": "繭",
            "text": "きっとみんな真似して、\n一度はお弁当を渡そう、\nって思うはず。",
            "zh": "大家肯定会学，\n觉得至少送一次\n便当。",
            "narrator_zh": "茧"
        },
        {
            "location": "502/TALK",
            "narrator": "つばめ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "燕"
        },
        {
            "location": "503/TALK",
            "narrator": "つばめ",
            "text": "普通に断った方が、\nよさそうだね。",
            "zh": "还是平常地拒绝，\n似乎比较好呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "504/TALK",
            "narrator": "雛",
            "text": "…けど、困った子達が\nいるんだなぁ。",
            "zh": "……不过，还真有\n让人为难的孩子呀。",
            "narrator_zh": "雏"
        },
        {
            "location": "505/TALK",
            "narrator": "雛",
            "text": "ファンクラブ作るなら、\n事前に本人に確認を取って\nからにしてほしいよね？",
            "zh": "要做粉丝团的话，\n希望先跟本人\n确认过再做呀？",
            "narrator_zh": "雏"
        },
        {
            "location": "508/TALK",
            "narrator": "繭",
            "text": "おまえが言うな！",
            "zh": "轮不到你说！",
            "narrator_zh": "茧"
        },
        {
            "location": "511/TALK",
            "narrator": "キリト",
            "text": "トライナリー応援団とか\n作ったの誰だったっけか？",
            "zh": "三重奏应援团什么的，\n是谁做的来着？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "513/TALK",
            "narrator": "雛",
            "text": "ファンクラブと応援団は、\n似て非なるものなの！",
            "zh": "粉丝团和应援团，\n看着像，其实不一样！",
            "narrator_zh": "雏"
        },
        {
            "location": "514/TALK",
            "narrator": "ガブリエラ",
            "text": "…人気者って、大変ね。",
            "zh": "……有人气，还挺累的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "517/TALK",
            "narrator": "つばめ",
            "text": "あはは…でも、嬉しいよ。",
            "zh": "啊哈哈……不过，我高兴呀。",
            "narrator_zh": "燕"
        },
        {
            "location": "258/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>7月19日　0:06 PM</color>\nとある平日の昼休み、附属学園つばめの教室にて。",
            "zh": "<color=green>7月19日　0:06 PM</color>\n某个工作日的午休，在附属学园燕的教室。",
            "narrator_zh": "Dialog_EventData"
        },
        {
            "location": "529/DIALOG",
            "narrator": "Dialog_GEThimegoto_ch01",
            "text": "【言葉足らず、気持ち知らず】",
            "zh": "【话没说够，心也没懂】",
            "narrator_zh": "Dialog_GEThimegoto_ch01"
        }
    ]
}
