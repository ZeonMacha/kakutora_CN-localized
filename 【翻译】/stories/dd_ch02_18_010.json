{
    "dir": "chap18/daydra/dd_ch02_18_010.js",
    "type": "MainStory",
    "info": {
        "story_id": "18252",
        "cid": "ayami",
        "title": "Extra002 プレミアムストーリー",
        "sub_title": "ゲーセン",
        "title_zh": "Extra002 额外剧情",
        "sub_title_zh": "电玩城"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "ゲーセン",
            "zh": "电玩城",
            "narrator_zh": ""
        },
        {
            "location": "18/TALK",
            "narrator": "アーヤ",
            "text": "…久しぶりに来たけど、\nあまり変わってないわね。",
            "zh": "……好久没来了，\n倒也没怎么变呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "19/TALK",
            "narrator": "アーヤ",
            "text": "…時間潰しになるような\nゲーム、あるかしら？",
            "zh": "……有没有什么能\n打发时间的游戏呢？",
            "narrator_zh": "绫水"
        },
        {
            "location": "21/TALK",
            "narrator": "アーヤ",
            "text": "音ゲーは、隣の小学生に、\n倍以上のスコア出された\nことあったし…。",
            "zh": "音游的话，以前还被\n旁边的小学生打出过\n两倍以上的分数……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "23/TALK",
            "narrator": "アーヤ",
            "text": "シューティングは、\nどれだけ狙っても\n弾が外れるし…。",
            "zh": "射击游戏的话，\n不管怎么瞄准\n子弹都会打偏……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "24/TALK",
            "narrator": "アーヤ",
            "text": "竹刀型コントローラーの\n剣道ゲームとか、\nどこか作らないかしら？",
            "zh": "不知道哪家会不会做\n竹刀型控制器的\n剑道游戏呢？",
            "narrator_zh": "绫水"
        },
        {
            "location": "28/TALK",
            "narrator": "アーヤ",
            "text": "…あっ。",
            "zh": "……啊。",
            "narrator_zh": "绫水"
        },
        {
            "location": "29/TALK",
            "narrator": "アーヤ",
            "text": "何、あのクレーンゲームの\nぬいぐるみ！？",
            "zh": "那台抓娃娃机里的\n玩偶是什么呀！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "31/TALK",
            "narrator": "アーヤ",
            "text": "凄く可愛い！\n何かしらこれ？\nゲームのキャラ？",
            "zh": "好可爱！\n这是什么呀？\n游戏角色吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "33/TALK",
            "narrator": "アーヤ",
            "text": "…でも、クレーンゲームは\n一番苦手だし…。",
            "zh": "……可是，抓娃娃机\n我最不擅长了……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "34/TALK",
            "narrator": "アーヤ",
            "text": "100円くらいなら…。",
            "zh": "投个100日元的话……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "35/TALK",
            "narrator": "アーヤ",
            "text": "いや、ダメダメ！\n100円でなんて\n絶対無理だから！",
            "zh": "不对，不行不行！\n区区100日元\n绝对抓不到的！",
            "narrator_zh": "绫水"
        },
        {
            "location": "37/TALK",
            "narrator": "アーヤ",
            "text": "でも…欲しいなぁ…。",
            "zh": "可是……好想要啊……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "52/TALK",
            "narrator": "アーヤ",
            "text": "悩み中(-ω-;)",
            "zh": "纠结中(-ω-;)",
            "narrator_zh": "绫水"
        },
        {
            "location": "54/SEL",
            "narrator": "",
            "text": "大学はどうしたの？",
            "zh": "大学那边怎么了？",
            "narrator_zh": ""
        },
        {
            "location": "55/ACT",
            "narrator": "",
            "text": "大学はどうしたの？",
            "zh": "大学那边怎么了？",
            "narrator_zh": ""
        },
        {
            "location": "57/TALK",
            "narrator": "アーヤ",
            "text": "次の講義まで時間あるから",
            "zh": "离下节课还有时间",
            "narrator_zh": "绫水"
        },
        {
            "location": "58/TALK",
            "narrator": "アーヤ",
            "text": "時間潰し中",
            "zh": "正在打发时间",
            "narrator_zh": "绫水"
        },
        {
            "location": "59/TALK",
            "narrator": "アーヤ",
            "text": "久しぶりにゲームセンター(^^",
            "zh": "好久没来电玩城(^^",
            "narrator_zh": "绫水"
        },
        {
            "location": "60/TALK",
            "narrator": "アーヤ",
            "text": "可愛いぬいぐるみを見つけたけど",
            "zh": "发现了很可爱的玩偶，可是",
            "narrator_zh": "绫水"
        },
        {
            "location": "61/TALK",
            "narrator": "アーヤ",
            "text": "取る自信なくて…",
            "zh": "没信心抓到……",
            "narrator_zh": "绫水"
        },
        {
            "location": "63/SEL",
            "narrator": "",
            "text": "腕前の方は？",
            "zh": "技术怎么样？",
            "narrator_zh": ""
        },
        {
            "location": "64/ACT",
            "narrator": "",
            "text": "腕前の方は？",
            "zh": "技术怎么样？",
            "narrator_zh": ""
        },
        {
            "location": "66/TALK",
            "narrator": "アーヤ",
            "text": "取ったことはある",
            "zh": "倒是有抓到过",
            "narrator_zh": "绫水"
        },
        {
            "location": "67/TALK",
            "narrator": "アーヤ",
            "text": "けど、沢山お金使うし、取れないこともあるから",
            "zh": "不过，花好多钱，也有抓不到的时候",
            "narrator_zh": "绫水"
        },
        {
            "location": "68/TALK",
            "narrator": "アーヤ",
            "text": "多分下手かも…(; ;)",
            "zh": "大概很菜吧……(; ;)",
            "narrator_zh": "绫水"
        },
        {
            "location": "80/TALK",
            "narrator": "アーヤ",
            "text": "…そうよ。\n下手なんだから、\nやるだけ無駄よね？",
            "zh": "……就是说啊。\n既然这么菜，\n试了也是白费吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "81/TALK",
            "narrator": "アーヤ",
            "text": "諦めて、オークションで\n探した方が安上がりだと\n思うし…。",
            "zh": "还是放弃吧，去拍卖\n网站找找说不定\n还更划算些……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "84/TALK",
            "narrator": "キリト",
            "text": "へぇ、綾水先輩も\nそういうのに\n興味あるんすね。",
            "zh": "哦，绫水前辈也对\n这种东西\n感兴趣啊。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "86/TALK",
            "narrator": "アーヤ",
            "text": "えっ…キリト君！？",
            "zh": "咦……圣翔！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "87/TALK",
            "narrator": "キリト",
            "text": "代わりに取りますよ。\n俺、ゲーム全般は\n得意なんで。",
            "zh": "我替你抓吧。\n我游戏方面\n全都很拿手的。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "88/TALK",
            "narrator": "アーヤ",
            "text": "そうじゃなくて、\n学校はどうしたの？",
            "zh": "不是说这个，\n你学校那边怎么了？",
            "narrator_zh": "绫水"
        },
        {
            "location": "89/TALK",
            "narrator": "キリト",
            "text": "いや、今日は格闘\nゲームの最新作が\n稼働する日だから――",
            "zh": "哎呀，今天是格斗\n游戏最新作\n上线运营的日子——",
            "narrator_zh": "圣翔"
        },
        {
            "location": "90/TALK",
            "narrator": "キリト",
            "text": "とりあえず、ちょっと\n触ってから学校に\n行こうかな、と…。",
            "zh": "我就想着先稍微\n摸两把再去学校\n来着……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "93/TALK",
            "narrator": "アーヤ",
            "text": "格闘ゲームかぁ…\nコマンド入力とか、\n絶対無理だわ。",
            "zh": "格斗游戏啊……\n搓招输入什么的，\n我绝对办不到。",
            "narrator_zh": "绫水"
        },
        {
            "location": "94/TALK",
            "narrator": "アーヤ",
            "text": "でも、そういうのが\n好きだなんて、やっぱり\n男の子だなぁ…。",
            "zh": "不过，会喜欢\n这种东西，果然还是\n男孩子呀……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "96/TALK",
            "narrator": "アーヤ",
            "text": "理由はわかったけど、\n午前中からゲームセンター\nなんて、よくないわ。",
            "zh": "理由是明白了，但\n一大早就泡在电玩城\n可不好哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "97/TALK",
            "narrator": "アーヤ",
            "text": "運が悪いと\n補導されちゃうわよ？",
            "zh": "运气不好的话\n会被训导带走的哦？",
            "narrator_zh": "绫水"
        },
        {
            "location": "98/TALK",
            "narrator": "キリト",
            "text": "じゃあ、急がねぇと！\nどのぬいぐるみが\n欲しいんすか？",
            "zh": "那得赶紧了！\n你想要哪个\n玩偶啊？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "99/TALK",
            "narrator": "アーヤ",
            "text": "いいわよ。\nそんな簡単に取れないし。",
            "zh": "算了吧。\n哪有那么容易抓到。",
            "narrator_zh": "绫水"
        },
        {
            "location": "100/TALK",
            "narrator": "キリト",
            "text": "へへっ、俺を誰だと\n思ってるんすか？",
            "zh": "嘿嘿，你以为\n我是谁啊？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "101/TALK",
            "narrator": "キリト",
            "text": "狙った獲物は３００円で\n必ずゲットする男っすよ？",
            "zh": "我可是瞄准的猎物\n300日元必拿下的男人哦？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "102/TALK",
            "narrator": "キリト",
            "text": "それで、どれっすか？\n教えてくれなきゃ、\n適当に取っちゃいますよ？",
            "zh": "所以，是哪个啊？\n不告诉我的话，\n我就随便抓一个了哦？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "104/TALK",
            "narrator": "アーヤ",
            "text": "…あそこのコウモリ。\nタキシード着て、\n赤い蝶ネクタイ付けたの。",
            "zh": "……那边的蝙蝠。\n穿着燕尾服，\n戴红色领结的那个。",
            "narrator_zh": "绫水"
        },
        {
            "location": "106/TALK",
            "narrator": "キリト",
            "text": "おっ、あれって確か、\n何かのアニメキャラ\nっすよね？",
            "zh": "哦，那个我记得\n好像是什么动画\n角色吧？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "108/TALK",
            "narrator": "アーヤ",
            "text": "そうなの？",
            "zh": "是吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "110/TALK",
            "narrator": "キリト",
            "text": "知らなかったんすか？\nまあいいけど…。",
            "zh": "你不知道吗？\n算了倒也无所谓……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "114/TALK",
            "narrator": "キリト",
            "text": "じゃあ、行きますよ。\n真剣になるんで、\n声掛け厳禁で！",
            "zh": "那我上了哦。\n我要认真了，\n严禁出声打扰！",
            "narrator_zh": "圣翔"
        },
        {
            "location": "117/TALK",
            "narrator": "アーヤ",
            "text": "そんなこと言っても、\nそう簡単に取れるわけ…。",
            "zh": "话是这么说，\n哪有那么容易就抓到……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "120/TALK",
            "narrator": "キリト",
            "text": "おっ、ラッキー！\n一発で掴んだぜ。",
            "zh": "哦，走运！\n一发就抓住了。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "123/TALK",
            "narrator": "アーヤ",
            "text": "はぁ！？",
            "zh": "哈！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "125/TALK",
            "narrator": "キリト",
            "text": "邪魔な周りのをどかそうと\n思ってたけど――",
            "zh": "我本来还想先把周围\n碍事的拨开呢——",
            "narrator_zh": "圣翔"
        },
        {
            "location": "126/TALK",
            "narrator": "キリト",
            "text": "運よく蝶ネクタイに\n引っかかったんすよ。",
            "zh": "运气好刚好钩在\n领结上了。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "128/TALK",
            "narrator": "キリト",
            "text": "よーし、そのまま穴まで\n持っていって…。",
            "zh": "好嘞，就这样一路\n带到洞口……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "132/TALK",
            "narrator": "キリト",
            "text": "よっしゃー！！\nどうだ、一発ゲットだぜ！",
            "zh": "好耶——！！\n怎么样，一发拿下！",
            "narrator_zh": "圣翔"
        },
        {
            "location": "133/TALK",
            "narrator": "アーヤ",
            "text": "す、凄いわ！\n一回で取るところ、\n初めて見た！",
            "zh": "好、好厉害！\n一次就抓到的场面，\n我还是头一回见！",
            "narrator_zh": "绫水"
        },
        {
            "location": "136/TALK",
            "narrator": "キリト",
            "text": "いやー、ラッキーだった\nだけっすよ。",
            "zh": "哪里哪里，只是\n运气好罢了。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "139/TALK",
            "narrator": "キリト",
            "text": "はい、プレゼント。\n大事にしてやって\nくださいね。",
            "zh": "来，送给你。\n请好好珍惜\n它哦。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "140/TALK",
            "narrator": "アーヤ",
            "text": "本当にいいの？",
            "zh": "真的可以吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "142/TALK",
            "narrator": "キリト",
            "text": "もちろんっすよ。\n俺が持ってるより、\nそいつも喜びますって。",
            "zh": "当然啦。\n比起归我所有，\n它也肯定更乐意跟你走。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "144/TALK",
            "narrator": "アーヤ",
            "text": "嬉しい！\n大切にするわ。",
            "zh": "好开心！\n我会好好珍惜的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "146/TALK",
            "narrator": "アーヤ",
            "text": "ふふっ、実際に手に取って\n見ると、可愛さ倍増ね。",
            "zh": "呵呵，实际拿在\n手里看，可爱度倍增呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "147/TALK",
            "narrator": "アーヤ",
            "text": "どこに置こうかしら？\nタンスの上…ううん、\n枕元とかでもいいかも。",
            "zh": "放哪里好呢？\n柜子上面……嗯，\n放枕边好像也不错。",
            "narrator_zh": "绫水"
        },
        {
            "location": "148/TALK",
            "narrator": "キリト",
            "text": "…なんか、綾水先輩の\nレアな姿見ちまった\n気がするな。",
            "zh": "……总觉得，好像\n看到了绫水前辈\n罕见的一面啊。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "149/TALK",
            "narrator": "キリト",
            "text": "ひなこに知れたら大騒ぎに\nなりそうだし、俺だけの\n胸に仕舞っとくか…。",
            "zh": "要是被雏知道了肯定\n会闹翻天，还是就\n藏在我自己心里吧……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "152/TALK",
            "narrator": "キリト",
            "text": "…って、やべぇ！\n格ゲーコーナー、\n人が集まってきてる！",
            "zh": "……哎呀，糟了！\n格斗游戏区那儿，\n人多起来了！",
            "narrator_zh": "圣翔"
        },
        {
            "location": "153/SEL",
            "narrator": "",
            "text": "お礼言わないと",
            "zh": "得道个谢才行",
            "narrator_zh": ""
        },
        {
            "location": "154/SEL",
            "narrator": "",
            "text": "止めなくていいの？",
            "zh": "不用拦住他吗？",
            "narrator_zh": ""
        },
        {
            "location": "158/TALK",
            "narrator": "キリト",
            "text": "じゃあ、綾水先輩。\n俺は戻りますね。",
            "zh": "那，绫水前辈。\n我先回那边了。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "159/TALK",
            "narrator": "アーヤ",
            "text": "わかったわ。\n頑張って勝ってね。",
            "zh": "知道了。\n加油赢下来哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "160/TALK",
            "narrator": "キリト",
            "text": "へへっ、余裕っすよ！",
            "zh": "嘿嘿，小菜一碟！",
            "narrator_zh": "圣翔"
        },
        {
            "location": "164/TALK",
            "narrator": "アーヤ",
            "text": "あっ、ちょっと待って！",
            "zh": "啊，等一下！",
            "narrator_zh": "绫水"
        },
        {
            "location": "167/TALK",
            "narrator": "キリト",
            "text": "は、はい！？",
            "zh": "是、是！？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "168/TALK",
            "narrator": "アーヤ",
            "text": "言い忘れてたわ。\n取ってくれてありがと。",
            "zh": "差点忘了说。\n谢谢你帮我抓到。",
            "narrator_zh": "绫水"
        },
        {
            "location": "169/TALK",
            "narrator": "キリト",
            "text": "あ、ああ、いいっすよ。\nお安い御用っすから。",
            "zh": "啊、哦，没事的。\n举手之劳而已。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "170/TALK",
            "narrator": "アーヤ",
            "text": "ふふっ…それじゃあ、\nまた劇場でね。",
            "zh": "呵呵……那，\n剧场见啦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "173/TALK",
            "narrator": "キリト",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "174/TALK",
            "narrator": "キリト",
            "text": "綾水先輩って、\n変なところで\n抜けてるよなぁ…。",
            "zh": "绫水前辈啊，\n总在一些奇怪的地方\n迷糊呢……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "175/TALK",
            "narrator": "キリト",
            "text": "まあ、いいか。\nとりあえずもう一戦だ！",
            "zh": "算了，无所谓。\n总之再来一局！",
            "narrator_zh": "圣翔"
        },
        {
            "location": "177/ACT",
            "narrator": "",
            "text": "お礼言わないと",
            "zh": "得道个谢才行",
            "narrator_zh": ""
        },
        {
            "location": "198/TALK",
            "narrator": "アーヤ",
            "text": "忘れてた！",
            "zh": "忘了！",
            "narrator_zh": "绫水"
        },
        {
            "location": "210/TALK",
            "narrator": "アーヤ",
            "text": "待って、キリト君！",
            "zh": "等等，圣翔！",
            "narrator_zh": "绫水"
        },
        {
            "location": "212/TALK",
            "narrator": "キリト",
            "text": "は、はい！？",
            "zh": "是、是！？",
            "narrator_zh": "圣翔"
        },
        {
            "location": "213/TALK",
            "narrator": "アーヤ",
            "text": "嬉しくて言い忘れてたわ。",
            "zh": "太开心了都忘了说。",
            "narrator_zh": "绫水"
        },
        {
            "location": "215/TALK",
            "narrator": "アーヤ",
            "text": "これ、取ってくれて\nありがとう。",
            "zh": "谢谢你帮我\n抓到这个。",
            "narrator_zh": "绫水"
        },
        {
            "location": "216/TALK",
            "narrator": "キリト",
            "text": "あ、ああ、いいっすよ。\nお安い御用っすから。",
            "zh": "啊、哦，没事的。\n举手之劳而已。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "217/TALK",
            "narrator": "アーヤ",
            "text": "ふふっ…それじゃあ、\nまた劇場でね。",
            "zh": "呵呵……那，\n剧场见啦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "220/TALK",
            "narrator": "キリト",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "221/TALK",
            "narrator": "キリト",
            "text": "綾水先輩って、\n変なところで\n抜けてるよなぁ…。",
            "zh": "绫水前辈啊，\n总在一些奇怪的地方\n迷糊呢……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "222/TALK",
            "narrator": "キリト",
            "text": "まあ、いいか。\nとりあえずもう一戦だ！",
            "zh": "算了，无所谓。\n总之再来一局！",
            "narrator_zh": "圣翔"
        },
        {
            "location": "223/ACT",
            "narrator": "",
            "text": "止めなくていいの？",
            "zh": "不用拦住他吗？",
            "narrator_zh": ""
        },
        {
            "location": "245/TALK",
            "narrator": "アーヤ",
            "text": "止めるって、何を？",
            "zh": "拦住他，拦什么？",
            "narrator_zh": "绫水"
        },
        {
            "location": "256/TALK",
            "narrator": "アーヤ",
            "text": "…あっ！！",
            "zh": "……啊！！",
            "narrator_zh": "绫水"
        },
        {
            "location": "259/TALK",
            "narrator": "アーヤ",
            "text": "キリト君！\n学校行かなきゃダメよ！",
            "zh": "圣翔！\n你必须去上学才行！",
            "narrator_zh": "绫水"
        },
        {
            "location": "260/TALK",
            "narrator": "キリト",
            "text": "げっ…覚えてましたか…。",
            "zh": "呃……你还记得啊……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "261/TALK",
            "narrator": "アーヤ",
            "text": "当たり前じゃない。",
            "zh": "那不是当然的吗。",
            "narrator_zh": "绫水"
        },
        {
            "location": "262/TALK",
            "narrator": "アーヤ",
            "text": "本当はすっかり忘れて\nたんだけど…。",
            "zh": "其实本来早就\n忘得一干二净了……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "263/TALK",
            "narrator": "アーヤ",
            "text": "さあ、学園に戻りましょ。",
            "zh": "好了，回学园吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "264/TALK",
            "narrator": "キリト",
            "text": "いや、でもゲームが…。",
            "zh": "不是，可是游戏还……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "265/TALK",
            "narrator": "アーヤ",
            "text": "放課後にまた来れば\nいいでしょ？",
            "zh": "放学后再来\n不就好了？",
            "narrator_zh": "绫水"
        },
        {
            "location": "266/TALK",
            "narrator": "アーヤ",
            "text": "それなら補導される\n心配もないし。",
            "zh": "那样也不用担心\n被训导带走了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "267/TALK",
            "narrator": "キリト",
            "text": "せ、せめてあと一回！\nあと一回だけ…。",
            "zh": "至、至少再来一局！\n就一局……。",
            "narrator_zh": "圣翔"
        },
        {
            "location": "268/TALK",
            "narrator": "アーヤ",
            "text": "行列出来てるから、\n並んでたら午後の授業に\n間に合わなくなるわ。",
            "zh": "那边都排起长队了，\n排下去的话下午的课\n可就赶不上了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "269/TALK",
            "narrator": "アーヤ",
            "text": "さあ、行きましょ。",
            "zh": "好了，走吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "270/TALK",
            "narrator": "キリト",
            "text": "あ、あと一回だけー！",
            "zh": "就、就再来一局嘛——！",
            "narrator_zh": "圣翔"
        },
