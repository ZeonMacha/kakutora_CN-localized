    "entry": [
        {
            "location": "1499/SCENARIO",
            "narrator": "",
            "text": "AW落とし物（ガブのこけし）",
            "zh": "AW遗失物（加布的木芥子）",
            "narrator_zh": ""
        },
        {
            "location": "1504/TALK",
            "narrator": "千羽鶴",
            "text": "ここには、\nガブリエラの大好きな\nこけしが落ちていた。",
            "zh": "这里，\n掉着加布里埃拉\n最喜欢的木芥子。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1505/TALK",
            "narrator": "千羽鶴",
            "text": "彼女がこけしを\nどうしてあれほどまでに、\nこよなく愛するのか。",
            "zh": "她到底为什么，\n会对木芥子爱到\n那种地步。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1506/TALK",
            "narrator": "千羽鶴",
            "text": "それは――",
            "zh": "那就是——",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1509/TALK",
            "narrator": "千羽鶴",
            "text": "<size=40>彼女の神秘！</size>",
            "zh": "<size=40>她的神秘！</size>",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1511/TALK",
            "narrator": "千羽鶴",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1512/TALK",
            "narrator": "千羽鶴",
            "text": "実は良く知らない。",
            "zh": "其实我也不太清楚。",
            "narrator_zh": "千羽鹤"
        }
    ]
}
