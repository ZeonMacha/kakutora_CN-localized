        {
            "location": "138/TALK",
            "narrator": "みやび",
            "text": "実はいい子なんじゃがの",
            "zh": "其实是个好孩子",
            "narrator_zh": "雅"
        },
        {
            "location": "140/SEL",
            "narrator": "",
            "text": "ギャップ萌えだ",
