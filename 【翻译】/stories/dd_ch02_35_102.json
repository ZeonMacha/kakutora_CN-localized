    "entry": [
        {
            "location": "853/SCENARIO",
            "narrator": "",
            "text": "役割と義務",
            "zh": "职责与义务",
            "narrator_zh": ""
        },
        {
            "location": "872/TALK",
            "narrator": "アーヤ",
            "text": "…これは…！？",
            "zh": "……这是……！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "873/TALK",
            "narrator": "アーヤ",
            "text": "…逢瀬つばめの中の\n私の記憶が…\n流れ込んで来る…！",
            "zh": "……逢濑燕体内的\n我的记忆……\n涌过来了……！",
            "narrator_zh": "绫水"
        },
        {
            "location": "874/TALK",
            "narrator": "アーヤ",
            "text": "$handle$が\n言ってた内容が\nわかったわ…！",
            "zh": "我明白$handle$\n刚才说的内容\n是什么意思了……！",
            "narrator_zh": "绫水"
        },
        {
            "location": "876/TALK",
            "narrator": "アーヤ",
            "text": "でもこれってよくない\n事態だわ…。",
            "zh": "但这可不是什么\n好兆头啊……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "877/TALK",
            "narrator": "アーヤ",
            "text": "早くこの状態を\n解決しなきゃ…。",
            "zh": "必须尽快解决\n这种状态才行……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "878/TALK",
            "narrator": "アーヤ",
            "text": "つばめの世界を\n蒸着させて\nセカイを開く。",
            "zh": "让燕的世界\n蒸着\n打开外面的世界。[?]",
            "narrator_zh": "绫水"
        },
        {
            "location": "879/TALK",
            "narrator": "アーヤ",
            "text": "早くしなきゃ…！",
            "zh": "必须快点……！",
            "narrator_zh": "绫水"
        },
        {
            "location": "880/TALK",
            "narrator": "アーヤ",
            "text": "$handle$\n手伝って！",
            "zh": "$handle$\n帮帮我！",
            "narrator_zh": "绫水"
        },
        {
            "location": "881/SEL",
            "narrator": "",
            "text": "ちょっと待って",
            "zh": "等一下",
            "narrator_zh": ""
        },
        {
            "location": "882/SEL",
            "narrator": "",
            "text": "今はそれよりすることが",
            "zh": "现在比起那个还有更该做的事",
            "narrator_zh": ""
        },
        {
            "location": "883/ACT",
            "narrator": "",
            "text": "ちょっと待って",
            "zh": "等一下",
            "narrator_zh": ""
        },
        {
            "location": "884/TALK",
            "narrator": "アーヤ",
            "text": "待てないわ！",
            "zh": "等不了了！",
            "narrator_zh": "绫水"
        },
        {
            "location": "885/ACT",
            "narrator": "",
            "text": "今はそれよりすることが",
            "zh": "现在比起那个还有更该做的事",
            "narrator_zh": ""
        },
        {
            "location": "886/TALK",
            "narrator": "アーヤ",
            "text": "最優先なのはこっちよ！",
            "zh": "最优先的应该是这边才对！",
            "narrator_zh": "绫水"
        },
        {
            "location": "888/TALK",
            "narrator": "アーヤ",
            "text": "この状態が長く\n続くのはまずいのよ。",
            "zh": "这种状态持续太久\n会很糟糕的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "889/TALK",
            "narrator": "アーヤ",
            "text": "すぐにでも日本を覆う\n繭を取り払って\n外と中を繋げないと…！",
            "zh": "必须立刻扯掉\n覆盖日本的茧，\n把外侧和内侧连起来……！",
            "narrator_zh": "绫水"
        },
        {
            "location": "904/TALK",
            "narrator": "アーヤ",
            "text": "うわっ！",
            "zh": "呜哇！",
            "narrator_zh": "绫水"
        },
        {
            "location": "905/TALK",
            "narrator": "アーヤ",
            "text": "ちょっとあなた\n何をしたの！？",
            "zh": "等下，你\n做了什么！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "906/SEL",
            "narrator": "",
            "text": "$me$は何もしていない",
            "zh": "$me$什么都没做",
            "narrator_zh": ""
        },
        {
            "location": "907/SEL",
            "narrator": "",
            "text": "濡れ衣だ",
            "zh": "冤枉啊",
            "narrator_zh": ""
        },
        {
            "location": "908/SEL",
            "narrator": "",
            "text": "$me$にもわからない",
            "zh": "$me$也不清楚",
            "narrator_zh": ""
        },
        {
            "location": "909/ACT",
            "narrator": "",
            "text": "$me$は何もしていない",
            "zh": "$me$什么都没做",
            "narrator_zh": ""
        },
        {
            "location": "910/TALK",
            "narrator": "アーヤ",
            "text": "直接じゃなくても\n心当たりはないの？",
            "zh": "就算不是直接动的手，\n你也没什么头绪吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "911/ACT",
            "narrator": "",
            "text": "濡れ衣だ",
            "zh": "冤枉啊",
            "narrator_zh": ""
        },
        {
            "location": "912/TALK",
            "narrator": "アーヤ",
            "text": "何もしてないの？",
            "zh": "什么都没做吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "913/ACT",
            "narrator": "",
            "text": "$me$にもわからない",
            "zh": "$me$也不清楚",
            "narrator_zh": ""
        },
        {
            "location": "914/TALK",
            "narrator": "アーヤ",
            "text": "思いつくことはないの？",
