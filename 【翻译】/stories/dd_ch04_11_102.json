{
    "dir": "chap11/daydra/dd_ch04_11_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "11405",
        "cid": "miyabi",
        "title": "005 メインストーリー",
        "sub_title": "ガブちゃんの真実は＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "加布的真相是＜后篇＞"
    },
    "entry": [
        {
            "location": "392/SCENARIO",
            "narrator": "",
            "text": "ガブちゃんの真実は",
            "zh": "加布的真相是",
            "narrator_zh": ""
        },
        {
            "location": "409/TALK",
            "narrator": "みやび",
            "text": "…ガブちゃんの中で\n引っかかっちょる\nこと…。",
            "zh": "……加布那边\n一直让我在意的\n事……。",
            "narrator_zh": "雅"
        },
        {
            "location": "410/TALK",
            "narrator": "みやび",
            "text": "うーん…。",
            "zh": "唔……。",
            "narrator_zh": "雅"
        },
        {
            "location": "412/TALK",
            "narrator": "繭",
            "text": "…あの、みやび先輩。",
            "zh": "……那个，雅前辈。",
            "narrator_zh": "茧"
        },
        {
            "location": "413/TALK",
            "narrator": "繭",
            "text": "本当に大丈夫ですか？\nかなり深刻な悩みを\nお抱えのようですが。",
            "zh": "真的不要紧吗？\n感觉前辈抱着\n相当严重的烦恼。",
            "narrator_zh": "茧"
        },
        {
            "location": "415/TALK",
            "narrator": "みやび",
            "text": "悩みっちゅうほどの\nことでもないんや\nけんど…。",
            "zh": "倒也不算什么\n了不得的烦恼，\n不过……。",
            "narrator_zh": "雅"
        },
        {
            "location": "416/TALK",
            "narrator": "みやび",
            "text": "…そうや。\nこの子達にも一緒に\n考えてもらえば――",
            "zh": "……对了。\n不如让这俩孩子\n也一起想想――",
            "narrator_zh": "雅"
        },
        {
            "location": "417/TALK",
            "narrator": "みやび",
            "text": "何かしら答えが\n見えてくるかも\nしれんな。",
            "zh": "说不定就能\n看到些\n头绪咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "418/TALK",
            "narrator": "みやび",
            "text": "…せっかくや。\nもし迷惑じゃ\nなかったら――",
            "zh": "……机会难得。\n要是不嫌\n麻烦的话――",
            "narrator_zh": "雅"
        },
        {
            "location": "419/TALK",
            "narrator": "みやび",
            "text": "ちくっと、\n知恵を貸して\nもらえんか？",
            "zh": "能不能等子\n帮我出出\n主意得咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "420/TALK",
            "narrator": "繭",
            "text": "構いませんが…、\n私で力になれるので\nしょうか？",
            "zh": "我可以……，\n但我真能帮上\n忙吗？",
            "narrator_zh": "茧"
        },
        {
            "location": "423/TALK",
            "narrator": "雛",
            "text": "私『たち』でしょ！？",
            "zh": "是『我们』才对吧！？",
            "narrator_zh": "雏"
        },
        {
            "location": "424/TALK",
            "narrator": "みやび",
            "text": "力強い仲間になって\nくれる思うちょるよ。",
            "zh": "我相信你们会成为\n可靠的伙伴的。",
            "narrator_zh": "雅"
        },
        {
            "location": "425/TALK",
            "narrator": "みやび",
            "text": "…一応、名前は\n伏せとかんとな。",
            "zh": "……总之，名字\n先保密才行咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "427/TALK",
            "narrator": "みやび",
            "text": "じゃあ、早速やが\n聞いてもらうぞね。\n実は昨日――",
            "zh": "那就马上开始，\n说给你们听咧。\n其实是昨天――",
            "narrator_zh": "雅"
        },
        {
            "location": "447/TALK",
            "narrator": "みやび",
            "text": "――っちゅうことが\nあったんよ。",
            "zh": "――就是发生了\n这么回事咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "448/TALK",
            "narrator": "雛",
            "text": "なるほどぉ…。",
            "zh": "原来如此哦……。",
            "narrator_zh": "雏"
        },
        {
            "location": "449/TALK",
            "narrator": "雛",
            "text": "そのツンデレの\nＡ子ちゃんって\nいうのが――",
            "zh": "那个傲娇的\nＡ子，\n她——",
            "narrator_zh": "雏"
        },
        {
            "location": "450/TALK",
            "narrator": "雛",
            "text": "好きな子のことを\n好きと認めない、と。",
            "zh": "就是不肯承认\n喜欢那个女孩，对吧。",
            "narrator_zh": "雏"
        },
        {
            "location": "451/TALK",
            "narrator": "みやび",
            "text": "そう。\nまあ、認めんのは\nいつものことやが。",
            "zh": "对。\n嘛，死不承认\n是家常便饭咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "452/TALK",
            "narrator": "みやび",
            "text": "けんど、どうにも\nいつもの反応とは\n違ったきね――",
            "zh": "但是，总觉得\n和往常的反应\n不太一样嘛――",
            "narrator_zh": "雅"
        },
        {
            "location": "453/TALK",
            "narrator": "みやび",
            "text": "何か、深い理由が\nあると思うがよ。",
            "zh": "我觉得背后\n有什么更深层的原因咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "454/TALK",
            "narrator": "繭",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "茧"
        },
        {
            "location": "455/TALK",
            "narrator": "雛",
            "text": "うーん…ただ単に\n超恥ずかしがり屋な\nだけなんじゃ？",
            "zh": "唔……会不会\n单纯就是\n超害羞而已呀？",
            "narrator_zh": "雏"
        },
        {
            "location": "456/TALK",
            "narrator": "みやび",
            "text": "それなら、いつもと\n同じ反応のはずや。",
            "zh": "那样的话，反应应该\n和平时一样才对。",
            "narrator_zh": "雅"
        },
        {
            "location": "457/TALK",
            "narrator": "みやび",
            "text": "やけんど、あの時は\nそんなに怒って否定\nせんかったきね。",
            "zh": "但是那时她没有\n那么大火气去\n否定嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "458/TALK",
            "narrator": "雛",
            "text": "うーん…、\nそれじゃあ…。",
            "zh": "唔……，\n那这样……。",
            "narrator_zh": "雏"
        },
        {
            "location": "460/TALK",
            "narrator": "雛",
            "text": "あっ、わかった！\n立場の違いじゃ\nないですかー？",
            "zh": "啊，我知道了！\n是不是身份\n差距的问题——？",
            "narrator_zh": "雏"
        },
        {
            "location": "462/TALK",
            "narrator": "雛",
            "text": "ほら、王子様と\n平民の女の子的な\n感じの！",
            "zh": "就像王子大人\n和平民\n少女那种的！",
            "narrator_zh": "雏"
        },
        {
            "location": "464/TALK",
            "narrator": "みやび",
            "text": "…残念ながら、\n二人とも一般市民の\nはずや。",
            "zh": "……遗憾得很，\n她们俩应该都是\n普通市民。",
            "narrator_zh": "雅"
        },
        {
            "location": "465/TALK",
            "narrator": "みやび",
            "text": "どちらかが某国の\n貴族とかいう話、\n聞いたことないちや。",
            "zh": "谁是某国贵族\n这种事，我可\n没听说过滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "466/TALK",
            "narrator": "雛",
            "text": "あらら…。",
            "zh": "哎呀呀……。",
            "narrator_zh": "雏"
        },
        {
            "location": "467/TALK",
            "narrator": "雛",
            "text": "だとしたらもう、\n本当に好きじゃない\nとかは？",
            "zh": "那再不然，\n会不会其实是\n根本不喜欢？",
            "narrator_zh": "雏"
        },
        {
            "location": "468/TALK",
            "narrator": "みやび",
            "text": "んー…、それはないと\n思うんやけんどなぁ。",
            "zh": "唔……我倒觉得\n不会是这样哟。",
            "narrator_zh": "雅"
        },
        {
            "location": "469/TALK",
            "narrator": "雛",
            "text": "う～ん…。",
            "zh": "唔～……。",
            "narrator_zh": "雏"
        },
        {
            "location": "470/TALK",
            "narrator": "繭",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "茧"
        },
        {
            "location": "472/TALK",
            "narrator": "雛",
            "text": "って、まゆちん！？\nボーッとしてないで\n一緒に考えてよー。",
            "zh": "喂，小茧！？\n别发呆啦，\n一起来想嘛——。",
            "narrator_zh": "雏"
        },
        {
            "location": "474/TALK",
            "narrator": "繭",
            "text": "…はっ！？",
            "zh": "……哈！？",
            "narrator_zh": "茧"
        },
        {
            "location": "475/TALK",
            "narrator": "みやび",
            "text": "すまんね。\n光月さんには\n退屈な話題やったか？",
            "zh": "没好意思。\n对光月你来说，\n是无聊的话题咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "478/TALK",
            "narrator": "繭",
            "text": "す、すみません…。\nそういうわけでは\nないのですが…。",
            "zh": "对、对不起……。\n不是那样的\n意思……。",
            "narrator_zh": "茧"
        },
        {
            "location": "480/TALK",
            "narrator": "雛",
            "text": "まあ、まゆちんは\n興味なさそうな\n話ではあるよねー。",
            "zh": "嘛，这话题\n小茧看起来\n确实没兴趣呢——。",
            "narrator_zh": "雏"
        },
        {
            "location": "482/TALK",
            "narrator": "繭",
            "text": "そうじゃない！\nただ、私は――",
            "zh": "不是的！\n只是，我——",
            "narrator_zh": "茧"
        },
        {
            "location": "483/TALK",
            "narrator": "繭",
            "text": "想定外のことだった\nから、驚いて思考が\n止まってただけ。",
            "zh": "只是事情出乎预料，\n我吃惊得\n大脑停机了而已。",
            "narrator_zh": "茧"
        },
        {
            "location": "484/TALK",
            "narrator": "みやび",
            "text": "…想定外？",
            "zh": "……出乎预料？",
            "narrator_zh": "雅"
        },
        {
            "location": "486/TALK",
            "narrator": "繭",
            "text": "はい…無礼を承知で\n言わせていただき\nます。",
            "zh": "是……请恕我\n无礼，容我\n直说。",
            "narrator_zh": "茧"
        },
        {
            "location": "488/TALK",
            "narrator": "繭",
            "text": "みやび先輩が\n恋愛に対して――",
            "zh": "雅前辈\n对恋爱——",
            "narrator_zh": "茧"
        },
        {
            "location": "489/TALK",
            "narrator": "繭",
            "text": "そこまで積極的に\n考えるタイプとは\n知らなかったので。",
            "zh": "没想到原来是对恋爱\n考虑得这么积极\n的类型。",
            "narrator_zh": "茧"
        },
        {
            "location": "490/TALK",
            "narrator": "みやび",
            "text": "そうなが？",
            "zh": "是这么回事咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "492/TALK",
            "narrator": "繭",
            "text": "…正確にいうなら、\n他者の恋愛に対して、\nでしょうか？",
            "zh": "……准确来说，\n是对『别人的恋爱』\n积极？",
            "narrator_zh": "茧"
        },
        {
            "location": "494/TALK",
            "narrator": "みやび",
            "text": "っ！？",
            "zh": "——！？",
            "narrator_zh": "雅"
        },
        {
            "location": "496/TALK",
            "narrator": "雛",
            "text": "え？　何それ？\nどういうことー？",
            "zh": "诶？什么意思？\n怎么回事——？",
            "narrator_zh": "雏"
        },
        {
            "location": "498/TALK",
            "narrator": "繭",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "茧"
        },
        {
            "location": "499/TALK",
            "narrator": "みやび",
            "text": "…そ、そうやね。",
            "zh": "……是、是啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "501/TALK",
            "narrator": "みやび",
            "text": "ちくっと、らしくない\n話をしてしもうた\nようや。",
            "zh": "好像说了些\n不太像我的\n话咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "502/TALK",
            "narrator": "みやび",
            "text": "…この前みたいに、\n相談されたわけでも\nないっちゅうに――",
            "zh": "……又不像上次那样，\n是被人找上门\n来商量――",
            "narrator_zh": "雅"
        },
        {
            "location": "503/TALK",
            "narrator": "みやび",
            "text": "自分からこんなこと\n考えるとか…。",
            "zh": "自己居然主动去想\n这种事……。",
            "narrator_zh": "雅"
        },
        {
            "location": "504/TALK",
            "narrator": "みやび",
            "text": "あー、いかんいかん。\nらしくないことして\nしもうたぁ…。",
            "zh": "啊——不行不行。\n做了不像我\n会做的事了……。",
            "narrator_zh": "雅"
        },
        {
            "location": "506/TALK",
            "narrator": "みやび",
            "text": "途中ですまんが、\nこの話おしまいな。",
            "zh": "没好意思讲到一半，\n这个话题到此为止。",
            "narrator_zh": "雅"
        },
        {
            "location": "507/TALK",
            "narrator": "雛",
            "text": "えぇっ！？\nせっかく楽しくなって\nきたのに…。",
            "zh": "诶！？\n好不容易\n才聊上头了……。",
            "narrator_zh": "雏"
        },
        {
            "location": "508/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "522/TALK",
            "narrator": "みやび",
            "text": "うわがががががあああああああああ！！！",
            "zh": "呜哇嘎嘎嘎嘎嘎啊啊啊啊啊啊啊！！！",
            "narrator_zh": "雅"
        },
        {
            "location": "523/TALK",
            "narrator": "みやび",
            "text": "大恥かいた！！",
            "zh": "出大糗了！！",
            "narrator_zh": "雅"
        },
        {
            "location": "524/TALK",
            "narrator": "みやび",
            "text": "赤っ恥や！！",
            "zh": "丢死人了！！",
            "narrator_zh": "雅"
        },
        {
            "location": "526/SEL",
            "narrator": "",
            "text": "とにかく落ち着いて",
            "zh": "总之先冷静下来",
            "narrator_zh": ""
        },
        {
            "location": "527/ACT",
            "narrator": "",
            "text": "とにかく落ち着いて",
            "zh": "总之先冷静下来",
            "narrator_zh": ""
        },
        {
            "location": "530/TALK",
            "narrator": "みやび",
            "text": "ここでも赤っ恥かくとこやった",
            "zh": "差点连在这里也丢死人了。",
            "narrator_zh": "雅"
        },
        {
            "location": "532/TALK",
            "narrator": "みやび",
            "text": "それにしても失態",
            "zh": "说起来真是失态",
            "narrator_zh": "雅"
        },
        {
            "location": "533/TALK",
            "narrator": "みやび",
            "text": "うちらしくない",
            "zh": "太不像我们了",
            "narrator_zh": "雅"
        },
        {
            "location": "534/TALK",
            "narrator": "みやび",
            "text": "ちくっと前まで",
            "zh": "不久之前，",
            "narrator_zh": "雅"
        },
        {
            "location": "535/TALK",
            "narrator": "みやび",
            "text": "みんなを完全に信じ切ってない",
            "zh": "完全没信任大家",
            "narrator_zh": "雅"
        },
        {
            "location": "536/TALK",
            "narrator": "みやび",
            "text": "とかクールに言うた癖に",
            "zh": "这种装酷的话，",
            "narrator_zh": "雅"
        },
        {
            "location": "537/TALK",
            "narrator": "みやび",
            "text": "仲間の恋バナなんぞするとか",
            "zh": "居然搞起驷马同伴的恋爱话题来",
            "narrator_zh": "雅"
        },
        {
            "location": "539/SEL",
            "narrator": "",
            "text": "丸くなったね",
            "zh": "你变温顺了呀",
            "narrator_zh": ""
        },
        {
            "location": "540/ACT",
            "narrator": "",
            "text": "丸くなったね",
            "zh": "你变温顺了呀",
            "narrator_zh": ""
        },
        {
            "location": "542/TALK",
            "narrator": "みやび",
            "text": "そうではない",
            "zh": "不是那么回事",
            "narrator_zh": "雅"
        },
        {
            "location": "543/TALK",
            "narrator": "みやび",
            "text": "そうなら恥ずかしがらん",
            "zh": "真那样就不会羞了",
            "narrator_zh": "雅"
        },
        {
            "location": "544/TALK",
            "narrator": "みやび",
            "text": "これは不測の事態や",
            "zh": "这是难以预料的事态",
            "narrator_zh": "雅"
        },
        {
            "location": "545/TALK",
            "narrator": "みやび",
            "text": "呑気過ぎた",
            "zh": "是我太松懈了",
            "narrator_zh": "雅"
        },
        {
            "location": "546/TALK",
            "narrator": "みやび",
            "text": "まあ、気付けてよかったけんどな",
            "zh": "嘛，能察觉到还是算万幸咯",
            "narrator_zh": "雅"
        },
        {
            "location": "548/SEL",
            "narrator": "",
            "text": "繭がみやびのことよく知ってたおかげだ",
            "zh": "多亏茧很了解雅",
            "narrator_zh": ""
        },
        {
            "location": "549/ACT",
            "narrator": "",
            "text": "繭がみやびのことよく知ってたおかげだ",
            "zh": "多亏茧很了解雅",
            "narrator_zh": ""
        },
        {
            "location": "552/TALK",
            "narrator": "みやび",
            "text": "それな",
            "zh": "确实。",
            "narrator_zh": "雅"
        },
        {
            "location": "553/TALK",
            "narrator": "みやび",
            "text": "しかし驚きや",
            "zh": "不过真是吓一跳",
            "narrator_zh": "雅"
        },
        {
            "location": "554/TALK",
            "narrator": "みやび",
            "text": "うちが他人にあんまし興味がないこと",
            "zh": "我对别人没多大兴趣这事",
            "narrator_zh": "雅"
        },
        {
            "location": "555/TALK",
            "narrator": "みやび",
            "text": "指摘されたんは初めてのことや",
            "zh": "被人指出来还是头一回",
            "narrator_zh": "雅"
        },
        {
            "location": "556/TALK",
            "narrator": "みやび",
            "text": "あの子",
            "zh": "那孩子",
            "narrator_zh": "雅"
        },
        {
            "location": "557/TALK",
            "narrator": "みやび",
            "text": "いつうちのそれに気づいた？",
            "zh": "到底什么时候察觉到我这点的？",
            "narrator_zh": "雅"
        },
        {
            "location": "559/TALK",
            "narrator": "みやび",
            "text": "ただの変わった子やないみたいやね",
            "zh": "看来她不只是个怪孩子咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "560/TALK",
            "narrator": "みやび",
            "text": "警戒が必要かもしれん",
            "zh": "或许得警戒一下",
            "narrator_zh": "雅"
        },
        {
            "location": "573/TALK",
            "narrator": "みやび",
            "text": "…まあ、らしくない\n自分に気付かせて\nくれたんやき――",
            "zh": "……嘛，是她让我\n注意到了不像我\n的自己嘛――",
            "narrator_zh": "雅"
        },
        {
            "location": "574/TALK",
            "narrator": "みやび",
            "text": "ちくっと感謝は\nしちょるけんどね。",
            "zh": "不过多少\n还是有点感谢的咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "576/TALK",
            "narrator": "繭",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "茧"
        },
        {
            "location": "577/TALK",
            "narrator": "繭",
            "text": "…よかった。\nいつものみやび先輩に\n戻って…。",
            "zh": "……太好了。\n雅前辈变回\n平时的样子了……。",
            "narrator_zh": "茧"
        },
        {
            "location": "579/TALK",
            "narrator": "繭",
            "text": "でも…さっきまでの\n恋バナに必死になる\nみやび先輩も――",
            "zh": "不过……刚才那个\n为恋爱话题拼命的\n雅前辈——",
            "narrator_zh": "茧"
        },
        {
            "location": "580/TALK",
            "narrator": "繭",
            "text": "ちょっと可愛くて、\nレアだったかも…。",
            "zh": "说不定有点可爱，\n算得上稀有了……。",
            "narrator_zh": "茧"
        },
        {
            "location": "591/DIALOG",
            "narrator": "Dialog_chapter_ch04",
            "text": "【09 パーフェクトイエロー】",
            "zh": "【09 完美之黄】",
            "narrator_zh": "Dialog_chapter_ch04"
        }
    ]
}
