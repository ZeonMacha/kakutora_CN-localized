{
    "dir": "chap13/daydra/dd_ch03_13_101.js",
    "type": "MainStory",
    "info": {
        "story_id": "13302",
        "cid": "gabriella",
        "title": "002 メインストーリー",
        "sub_title": "チェイス？＜前編＞",
        "title_zh": "002 主线剧情",
        "sub_title_zh": "追踪？＜前篇＞"
    },
    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "アーヤを追え",
            "zh": "追踪绫水",
            "narrator_zh": ""
        },
        {
            "location": "31/TALK",
            "narrator": "ガブリエラ",
            "text": "じゃあ駅まで\n乗せてって。",
            "zh": "那顺便载我\n到车站吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "32/TALK",
            "narrator": "ガブリエラ",
            "text": "そんなに遠回りに\nならないでしょ？",
            "zh": "反正也没绕多少路\n对吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "33/TALK",
            "narrator": "アーヤ",
            "text": "構わないけど…、\nギャヴィもどこか\nお出かけなの？",
            "zh": "我是无所谓啦……，\n加维你也是要\n去哪里逛逛吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "34/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょっとねー。",
            "zh": "算是吧—。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "36/TALK",
            "narrator": "アーヤ",
            "text": "ふふっ…もしかして、\nデート？",
            "zh": "呼呼……难道说，\n是要去约会？",
            "narrator_zh": "绫水"
        },
        {
            "location": "37/TALK",
            "narrator": "ガブリエラ",
            "text": "ば、バカ！\nそんなわけない\nでしょ！？",
            "zh": "蠢、蠢货！\n怎么可能\n是约会嘛！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "38/TALK",
            "narrator": "ガブリエラ",
            "text": "一人で展示会に\n行くだけよ。",
            "zh": "我只是自己一个人\n去看展览会而已。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "39/TALK",
            "narrator": "アーヤ",
            "text": "また日本画か何かの\n展示会？",
            "zh": "又是日本画之类的\n展览会吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "40/TALK",
            "narrator": "ガブリエラ",
            "text": "そんなとこ。\nうっかりしてたけど、\n今日が最終日なのよ。",
            "zh": "差不多吧。\n差点给忘了，\n今天可是最后一天了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "42/TALK",
            "narrator": "アーヤ",
            "text": "ふふっ、ギャヴィって\nそういうの好きよね。",
            "zh": "呼呼，加维你\n真的很喜欢这类东西呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "44/TALK",
            "narrator": "ガブリエラ",
            "text": "あら、何か文句でも？",
            "zh": "哎呀，你有什么意见吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "45/TALK",
            "narrator": "アーヤ",
            "text": "ううん。\nなんて言えば\nいいのかしら？",
            "zh": "没有哦。\n该怎么说\n才好呢？",
            "narrator_zh": "绫水"
        },
        {
            "location": "46/TALK",
            "narrator": "アーヤ",
            "text": "見てるとね、本当に\n好きなのが伝わってきて、\nこっちまで楽しくなるの。",
            "zh": "看着你那样，能感受到\n你是真的发自内心喜欢，\n连带着我也开心起来了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "47/TALK",
            "narrator": "ガブリエラ",
            "text": "…そんなつもりは\nないんだけどね。",
            "zh": "……我可没打算\n表现得那么明显。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "48/TALK",
            "narrator": "アーヤ",
            "text": "でも伝わってるの。",
            "zh": "但我还是感受到了哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "49/TALK",
            "narrator": "アーヤ",
            "text": "そういえば、そういう\n展示会って行ったこと\nなかったなぁ…。",
            "zh": "说起来，那种\n展览会我好像一次也\n没去过呢……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "50/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "51/TALK",
            "narrator": "ガブリエラ",
            "text": "そんなに楽しそうに\n見えるなら、\n一緒に来る？",
            "zh": "既然看着觉得\n那么有意思，\n要不要一起来？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "52/TALK",
            "narrator": "ガブリエラ",
            "text": "結構有名な絵もある\nみたいだから、\n退屈はしないはずよ。",
            "zh": "好像还有不少相当\n有名的画作展出，\n应该不会无聊的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "53/TALK",
            "narrator": "アーヤ",
            "text": "うーん…興味は\nあるんだけど――",
            "zh": "嗯—……我是挺有\n兴趣的啦——",
            "narrator_zh": "绫水"
        },
        {
            "location": "55/TALK",
            "narrator": "アーヤ",
            "text": "今日はごめん。\n私も外せない予定が\n入ってるのよ。",
            "zh": "今天不好意思。\n我这边也有推不开的\n安排呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "56/TALK",
            "narrator": "ガブリエラ",
            "text": "…ま、そうよね。\nさすがに今誘うのは\n無茶ぶりだったわ。",
            "zh": "……嘛，也是哦。\n临时起意才来约你，\n确实太勉强人了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "57/TALK",
            "narrator": "アーヤ",
            "text": "今度やった時は\n連れてってもらうわ。",
            "zh": "下次再办的时候\n带我去吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "58/TALK",
            "narrator": "ガブリエラ",
            "text": "ええ…ところで――",
            "zh": "好啊……不过话说回来——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "59/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤの外せない\n用事って、何なの？",
            "zh": "绫水你推不开的\n事情，是指什么呀？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "60/TALK",
            "narrator": "アーヤ",
            "text": "えっ？",
            "zh": "哎？",
            "narrator_zh": "绫水"
        },
        {
            "location": "61/TALK",
            "narrator": "ガブリエラ",
            "text": "まさかとは思うけど、\nアーヤの方こそ\nデートだったりして。",
            "zh": "虽然觉得不太可能，\n难道说绫水你才是\n要去约会吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "63/TALK",
            "narrator": "アーヤ",
            "text": "あはは、ないない。\nデートじゃないわ。",
            "zh": "啊哈哈，没有没有。\n才不是约会。",
            "narrator_zh": "绫水"
        },
        {
            "location": "64/TALK",
            "narrator": "ガブリエラ",
            "text": "じゃあ、何なの？",
            "zh": "那是什么呀？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "65/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "66/TALK",
            "narrator": "ガブリエラ",
            "text": "…ちょ、まさか\n本当に！！",
            "zh": "……等、难道\n真的是！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "67/TALK",
            "narrator": "アーヤ",
            "text": "デートじゃないから！\n小夜たちと勉強会の\n約束をしてるのよ。",
            "zh": "都说了不是约会啦！\n我和小夜她们约好了\n一起开学习会哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "68/TALK",
            "narrator": "ガブリエラ",
            "text": "たちってことは――",
            "zh": "既然说“她们”那就是——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "69/TALK",
            "narrator": "アーヤ",
            "text": "男の子は一人も\n来ないわよ？",
            "zh": "一个男生也\n不会来的哦？",
            "narrator_zh": "绫水"
        },
        {
            "location": "70/TALK",
            "narrator": "ガブリエラ",
            "text": "ほっ…よかったぁ…。",
            "zh": "呼……太好了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "71/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしより先に\n彼氏作られたかと\n思って、焦ったわ。",
            "zh": "我还以为你比我先\n交到男朋友了，\n吓了一大跳呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "72/TALK",
            "narrator": "アーヤ",
            "text": "…ギャヴィより\n私の方が早く作れると\n思うんだけど…。",
            "zh": "……我觉得怎么看\n都是我能比加维\n更快交到男朋友才对……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "74/TALK",
            "narrator": "ガブリエラ",
            "text": "…何よ？",
            "zh": "……你说什么？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "75/TALK",
            "narrator": "アーヤ",
            "text": "あ、ううん。\n何でもないわ。",
            "zh": "啊，没有。\n什么也没说。",
            "narrator_zh": "绫水"
        },
        {
            "location": "76/TALK",
            "narrator": "アーヤ",
            "text": "それより、\n早く行きましょ。",
            "zh": "不说这个了，\n咱们快走吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "77/TALK",
            "narrator": "ガブリエラ",
            "text": "ん、よろしくね。",
            "zh": "嗯，拜托啦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "100/TALK",
            "narrator": "ガブリエラ",
            "text": "送ってくれて\nありがと。",
            "zh": "谢谢你\n送我过来。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "102/TALK",
            "narrator": "アーヤ",
            "text": "どういたしまして。",
            "zh": "不客气。",
            "narrator_zh": "绫水"
        },
        {
            "location": "103/TALK",
            "narrator": "アーヤ",
            "text": "それじゃ、\n気を付けてね。",
            "zh": "那，\n路上小心哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "108/TALK",
            "narrator": "ガブリエラ",
            "text": "…なんか怪しいわね。",
            "zh": "……总觉得有点可疑呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "109/TALK",
            "narrator": "ガブリエラ",
            "text": "勉強会って言ってた\nけど、その割には\nワクワクしてたし。",
            "zh": "嘴上说着去开学习会，\n可看她的样子却那么\n雀跃期待。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "110/TALK",
            "narrator": "ガブリエラ",
            "text": "…まあ、カレシは\nまず考えられない\nとして――",
            "zh": "……嘛，有男朋友\n这种事基本可以\n排除掉——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "111/TALK",
            "narrator": "ガブリエラ",
            "text": "だとすると…、\nうーん…。",
            "zh": "这么说来的话……，\n嗯—……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "112/TALK",
            "narrator": "ガブリエラ",
            "text": "…尾行してみよう\nかしら？",
            "zh": "……要不跟踪看看\n好了？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "113/TALK",
            "narrator": "ガブリエラ",
            "text": "って、さすがに\nそれはマズい気も\nするけど――",
            "zh": "虽说这么干\n确实有点不太妙的\n感觉——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "114/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、気になるし…。",
            "zh": "可我实在很在意嘛……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "158/TALK",
            "narrator": "ガブリエラ",
            "text": "あら、$handle$。\nいらっしゃい。",
            "zh": "哎呀，$handle$。\n欢迎光临。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "159/TALK",
            "narrator": "ガブリエラ",
            "text": "今回もまた何か\n悩みが出ちゃったのね。",
            "zh": "这次又冒出什么\n烦恼来了呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "166/TALK",
            "narrator": "ガブリエラ",
            "text": "オープンプロセス、\n0x993番地から\n0xFEC番地へ。",
            "zh": "开放进程，\n从0x993号地址\n前往0xFEC号地址。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "181/TALK",
            "narrator": "ガブリエラ",
            "text": "シーク完了っ♪",
            "zh": "搜索完成♪",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "185/TALK",
            "narrator": "ガブリエラ",
            "text": "それで、\n今回のあたしの\n総意は……っと。",
            "zh": "那么，\n这次我的\n总意是……我看看。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "186/TALK",
            "narrator": "ガブリエラ",
            "text": "ああ、アーヤのことね。",
            "zh": "啊，是关于绫水的事呀。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "187/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤの行き先が\n気になるみたい。",
            "zh": "似乎很在意绫水\n究竟去了哪里呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "188/TALK",
            "narrator": "ガブリエラ",
            "text": "それじゃ、よろしく。",
            "zh": "那么，就拜托你咯。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "189/SEL",
            "narrator": "",
            "text": "任せといて！",
            "zh": "交给我吧！",
            "narrator_zh": ""
        },
        {
            "location": "190/SEL",
            "narrator": "",
            "text": "なんか投げやりじゃない？",
            "zh": "总觉得有点敷衍啊？",
            "narrator_zh": ""
        },
        {
            "location": "191/ACT",
            "narrator": "",
            "text": "任せといて！",
            "zh": "交给我吧！",
            "narrator_zh": ""
        },
        {
            "location": "192/TALK",
            "narrator": "ガブリエラ",
            "text": "ありがと。\nとっても心強いわ。",
            "zh": "谢谢。\n有你这句话我可放心多了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "193/ACT",
            "narrator": "",
            "text": "なんか投げやりじゃない？",
            "zh": "总觉得有点敷衍啊？",
            "narrator_zh": ""
        },
        {
            "location": "194/TALK",
            "narrator": "ガブリエラ",
            "text": "え？\nそうかしら？\nいつもと同じだけど？",
            "zh": "哎？\n有吗？\n我明明和平时一样呀？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "195/SEL",
            "narrator": "",
            "text": "つばめの時はめっちゃテンション高いのに",
            "zh": "燕的时候明明兴致高得不得了",
            "narrator_zh": ""
        },
        {
            "location": "196/ACT",
            "narrator": "",
            "text": "つばめの時はめっちゃテンション高いのに",
            "zh": "燕的时候明明兴致高得不得了",
            "narrator_zh": ""
        },
        {
            "location": "198/TALK",
            "narrator": "ガブリエラ",
            "text": "あぁ、だって\nつばめのことは\n別格だもの！",
            "zh": "啊啊，那是因为\n燕对她来说\n是特别的嘛！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "199/SEL",
            "narrator": "",
            "text": "もしかして、アーヤのことは好きじゃないの？",
            "zh": "难道说，你不喜欢绫水吗？",
            "narrator_zh": ""
        },
        {
            "location": "200/SEL",
            "narrator": "",
            "text": "もしかして、ツンデレ特有の照れ隠し？",
            "zh": "难道说，是傲娇特有的害羞掩饰？",
            "narrator_zh": ""
        },
        {
            "location": "201/ACT",
            "narrator": "",
            "text": "もしかして、アーヤのことは好きじゃないの？",
            "zh": "难道说，你不喜欢绫水吗？",
            "narrator_zh": ""
        },
        {
            "location": "202/TALK",
            "narrator": "ガブリエラ",
            "text": "え？\nそんなことないけど？",
            "zh": "哎？\n才没有这回事呢？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "203/ACT",
            "narrator": "",
            "text": "もしかして、ツンデレ特有の照れ隠し？",
            "zh": "难道说，是傲娇特有的害羞掩饰？",
            "narrator_zh": ""
        },
        {
            "location": "204/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしは\nツンデレじゃないわよ？",
            "zh": "我才不是\n傲娇哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "205/TALK",
            "narrator": "ガブリエラ",
            "text": "あ、ツンデレだから\nツンデレじゃないって\n言ってるんじゃないから。",
            "zh": "啊，我可不是因为\n自己是傲娇才硬说\n自己不是傲娇的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "206/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしはツンデレ成分\nゼロの人格だし。",
            "zh": "我可是傲娇成分\n为零的人格嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "208/SEL",
            "narrator": "",
            "text": "じゃあなんでウキウキしたりしないの？",
            "zh": "那为什么不兴高采烈一点呢？",
            "narrator_zh": ""
        },
        {
            "location": "209/ACT",
            "narrator": "",
            "text": "じゃあなんでウキウキしたりしないの？",
            "zh": "那为什么不兴高采烈一点呢？",
            "narrator_zh": ""
        },
        {
            "location": "211/TALK",
            "narrator": "ガブリエラ",
            "text": "うーん、そうね。",
            "zh": "嗯—，这个嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "213/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤに対しては\n色々複雑なのよ。",
            "zh": "对绫水的感情\n还挺复杂的呀。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "214/TALK",
            "narrator": "ガブリエラ",
            "text": "あたし自身、\n今の付き合い方で本当に\nいいのかわからないし。",
            "zh": "就连我自己，也不确定\n现在这样相处下去\n到底好不好。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "215/SEL",
            "narrator": "",
            "text": "トライナリーメンバーとしての悩み？",
            "zh": "是作为三重奏成员的烦恼？",
            "narrator_zh": ""
        },
        {
            "location": "216/SEL",
            "narrator": "",
            "text": "ひとりの女性としての悩み？",
            "zh": "是作为一名女性的烦恼？",
            "narrator_zh": ""
        },
        {
            "location": "217/ACT",
            "narrator": "",
            "text": "トライナリーメンバーとしての悩み？",
            "zh": "是作为三重奏成员的烦恼？",
            "narrator_zh": ""
        },
        {
            "location": "218/TALK",
            "narrator": "ガブリエラ",
            "text": "それもあるけど、\n今回はそれとは\nちょっと違うわね。",
            "zh": "虽然也有那方面的原因，\n不过这次稍微\n有点不太一样呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "219/ACT",
            "narrator": "",
            "text": "ひとりの女性としての悩み？",
            "zh": "是作为一名女性的烦恼？",
            "narrator_zh": ""
        },
        {
            "location": "220/TALK",
            "narrator": "ガブリエラ",
            "text": "あら、その言い方\nとっても素敵ね！\n大人の女って感じで。",
            "zh": "哎呀，你这个说法\n真是太妙了！\n很有成熟女人的味道呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "221/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、そういうのとは\nちょっと違うわね。",
            "zh": "不过，和那种烦恼\n也有点不太一样呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "223/SEL",
            "narrator": "",
            "text": "教えて",
            "zh": "告诉我吧",
            "narrator_zh": ""
        },
        {
            "location": "224/ACT",
            "narrator": "",
            "text": "教えて",
            "zh": "告诉我吧",
            "narrator_zh": ""
        },
        {
            "location": "226/TALK",
            "narrator": "ガブリエラ",
            "text": "うーん、そうね。",
            "zh": "嗯—，好吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "227/TALK",
            "narrator": "ガブリエラ",
            "text": "アーヤの事は\n大好きなのよ。",
            "zh": "我其实非常喜欢\n绫水哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "228/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、好きじゃない\n一面もある。",
            "zh": "可是，也有我不喜欢的\n一面。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "229/TALK",
            "narrator": "ガブリエラ",
            "text": "だって、今のアーヤは\n抜け殻だもの。",
            "zh": "因为，现在的绫水\n只是一具空壳啊。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "230/SEL",
            "narrator": "",
            "text": "どういう意味？",
            "zh": "什么意思？",
            "narrator_zh": ""
        },
        {
            "location": "231/ACT",
            "narrator": "",
            "text": "どういう意味？",
            "zh": "什么意思？",
            "narrator_zh": ""
        },
        {
            "location": "233/TALK",
            "narrator": "ガブリエラ",
            "text": "その言葉の通り、\n中身が無いってこと。",
            "zh": "就是字面上的意思，\n里面是空的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "234/TALK",
            "narrator": "ガブリエラ",
            "text": "現実のあたしは、\nその事に気づいてるようで\n気づいてないんだけど。",
            "zh": "现实中的我，\n好像察觉到了这件事，\n又好像还没察觉到。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "235/TALK",
            "narrator": "ガブリエラ",
            "text": "もやっとしつつも、\n理由のわからない欲求に\nよって依存してるのよ。",
            "zh": "虽然心里隐隐有些闷堵，\n却还是被某种说不清的\n欲求驱使着去依赖她。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "236/TALK",
            "narrator": "ガブリエラ",
            "text": "このままだとあまり\nいいことにはならない\nような気もするけどね。",
            "zh": "不过再这样下去，\n总觉得不会有什么\n好结果就是了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "237/TALK",
            "narrator": "ガブリエラ",
            "text": "だから今は、色んなことを\nクリアにして、アーヤを\nもっと知るべきなのよ。",
            "zh": "所以现在，应该把\n各种事情都理清楚，\n更深入地了解绫水才行。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "238/TALK",
            "narrator": "ガブリエラ",
            "text": "そういう意味でも、\n今回はアーヤの行動を\n追う必要があるわ。",
            "zh": "从这个意义上讲，\n这次也有必要追踪\n绫水的动向呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "240/TALK",
            "narrator": "ガブリエラ",
            "text": "というわけで、\nよろしくお願いね。",
            "zh": "就是这样，\n那就拜托你了哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "242/TALK",
            "narrator": "ガブリエラ",
            "text": "あたしと\n$handle$にとって\n素敵なココロの旅を！",
            "zh": "祝我和\n$handle$\n有一段美妙的心灵之旅！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "30/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>6月21日　11:25 AM</color>\n休日の昼前、神楽坂トライナリー劇場前にて。",
            "zh": "<color=green>6月21日　11:25 AM</color>\n假日的午前，在神乐坂三重奏剧场前。",
            "narrator_zh": "Dialog_EventData"
        },
        {
