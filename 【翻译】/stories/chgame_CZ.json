    "entry": [
        {
            "location": "1027/SCENARIO",
            "narrator": "",
            "text": "CZジャンプ台（みやび）",
            "zh": "CZ跳跃台（雅）",
            "narrator_zh": ""
        },
        {
            "location": "1031/SEL",
            "narrator": "",
            "text": "入る",
            "zh": "进去",
            "narrator_zh": ""
        },
        {
            "location": "1032/SEL",
            "narrator": "",
            "text": "入らない",
            "zh": "不进去",
            "narrator_zh": ""
        },
        {
            "location": "1033/ACT",
            "narrator": "",
            "text": "入る",
            "zh": "进去",
            "narrator_zh": ""
        },
        {
            "location": "1034/ACT",
            "narrator": "",
            "text": "入らない",
            "zh": "不进去",
            "narrator_zh": ""
        },
        {
            "location": "1051/TALK",
            "narrator": "みやび",
            "text": "おお、お前さんらか。",
            "zh": "哦哦，是你们咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "1052/TALK",
            "narrator": "みやび",
            "text": "またジャンプ台を\n使っていくかね？",
            "zh": "这次又要\n用跳跃台咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "1053/SEL",
            "narrator": "",
            "text": "はい",
            "zh": "好",
            "narrator_zh": ""
        },
        {
            "location": "1054/SEL",
            "narrator": "",
            "text": "いいえ",
            "zh": "不用",
            "narrator_zh": ""
        },
        {
            "location": "1055/ACT",
            "narrator": "",
            "text": "はい",
            "zh": "好",
            "narrator_zh": ""
        },
        {
            "location": "1057/ACT",
            "narrator": "",
            "text": "いいえ",
            "zh": "不用",
            "narrator_zh": ""
        },
        {
            "location": "1058/TALK",
            "narrator": "みやび",
            "text": "必要なら\nいつでも来いや。",
            "zh": "有需要的话，\n随时来咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "1062/TALK",
            "narrator": "みやび",
            "text": "うーん、\nまっこと\n困ったぞね。",
            "zh": "唔——，\n这下是\n蛮伤脑筋的咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "1064/TALK",
            "narrator": "千羽鶴",
            "text": "あの人は、\n奇天烈発明家\nコイガサコ博士。",
            "zh": "那位是，\n奇天烈发明家\n恋之崎博士。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1066/TALK",
            "narrator": "千羽鶴",
            "text": "何か困ってるみたい。",
            "zh": "好像在为什么发愁。",
            "narrator_zh": "千羽鹤"
        },
        {
            "location": "1067/TALK",
            "narrator": "みやび",
            "text": "おっ。\nお前さんたち\n旅の人かね。",
            "zh": "哦。\n两位是\n旅人咩。",
            "narrator_zh": "雅"
        },
        {
            "location": "1068/SEL",
            "narrator": "",
            "text": "まあ、そんなとこです",
            "zh": "差不多算吧",
            "narrator_zh": ""
        },
        {
            "location": "1069/ACT",
            "narrator": "",
            "text": "まあ、そんなとこです",
            "zh": "差不多算吧",
            "narrator_zh": ""
        },
        {
            "location": "1071/TALK",
            "narrator": "みやび",
            "text": "それは丁度えい！",
            "zh": "那可刚好得！",
            "narrator_zh": "雅"
        },
        {
            "location": "1072/TALK",
            "narrator": "みやび",
            "text": "お前さんたち、\nリモコンを\n持っちょらんが？",
            "zh": "你们身上，\n遥控器\n没带嘛？",
            "narrator_zh": "雅"
        },
        {
            "location": "1073/TALK",
            "narrator": "みやび",
            "text": "448MHzで出力４Wの\nやつなんやけんど。",
            "zh": "448MHz、输出４W\n的那种咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "1074/TALK",
            "narrator": "みやび",
            "text": "実はなぁ、\nせっかくうちの\n世紀の大発明――",
            "zh": "其实呀，\n好不容易我这\n世纪大发明——",
            "narrator_zh": "雅"
        },
        {
            "location": "1075/TALK",
            "narrator": "みやび",
            "text": "『大陸間弾道ジャンプ台』\nが完成したんやけんど、\nリモコン無くしてなぁ。",
            "zh": "『洲际弹道跳跃台』\n总算完成了咯，但是\n遥控器给弄丢了啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "1076/TALK",
            "narrator": "みやび",
            "text": "発射試験も出来ずに\n困っちょったが。",
            "zh": "连发射试验都做不了，\n愁死我了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "1077/TALK",
            "narrator": "みやび",
            "text": "まあでも、\nリモコンなんぞ、普通\n持って歩かんよなぁ。",
            "zh": "不过啊，\n遥控器驷马的东西，\n谁会揣着走路嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "1079/SEL",
            "narrator": "",
            "text": "なんか『ジャンプリモコン』ってのならもらったけど…",
            "zh": "有什么『跳跃遥控器』倒是收过……",
            "narrator_zh": ""
        },
        {
            "location": "1080/ACT",
            "narrator": "",
            "text": "なんか『ジャンプリモコン』ってのならもらったけど…",
            "zh": "有什么『跳跃遥控器』倒是收过……",
            "narrator_zh": ""
        },
        {
            "location": "1084/TALK",
            "narrator": "みやび",
            "text": "おお！\nそれやそれ！\nまさにそれぞね！",
            "zh": "哦哦！\n就是它！\n正是它咧！",
            "narrator_zh": "雅"
        },
        {
            "location": "1085/TALK",
            "narrator": "みやび",
            "text": "これを使えば、\n『大陸間弾道ジャンプ台』\nが使えるちや！",
            "zh": "用上这个，\n『洲际弹道跳跃台』\n就能用了滴！",
            "narrator_zh": "雅"
        },
        {
            "location": "1086/TALK",
            "narrator": "みやび",
            "text": "ありがとう！\nありがとう！",
            "zh": "谢谢！\n谢谢！",
            "narrator_zh": "雅"
        },
        {
            "location": "1087/TALK",
            "narrator": "みやび",
            "text": "せっかくやし、\n一発やってくか？",
            "zh": "难得嘛，\n来一发啵？",
            "narrator_zh": "雅"
        },
        {
            "location": "1089/SEL",
            "narrator": "",
            "text": "やってく！！",
            "zh": "来一发！！",
            "narrator_zh": ""
        },
        {
            "location": "1090/SEL",
            "narrator": "",
            "text": "遠慮します",
            "zh": "还是算了",
            "narrator_zh": ""
        },
        {
            "location": "1091/ACT",
            "narrator": "",
            "text": "やってく！！",
            "zh": "来一发！！",
            "narrator_zh": ""
        },
        {
            "location": "1092/TALK",
            "narrator": "みやび",
            "text": "うむ。\nほんだら、\nこっちへ来いや。",
            "zh": "嗯。\n那就，\n到这边来咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "1093/TALK",
            "narrator": "みやび",
            "text": "飛ばしちゃるきね！",
            "zh": "这就把你发射出去啵！",
            "narrator_zh": "雅"
        },
        {
            "location": "1120/ACT",
            "narrator": "",
            "text": "遠慮します",
            "zh": "还是算了",
            "narrator_zh": ""
        },
        {
            "location": "1121/TALK",
            "narrator": "みやび",
            "text": "うむ。\nわかったぞね。",
            "zh": "嗯。\n知道了咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "1122/TALK",
            "narrator": "みやび",
            "text": "必要なら\nいつでも来いや。",
            "zh": "有需要的话，\n随时来咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "1126/SEL",
            "narrator": "",
            "text": "持ってないですね…",
            "zh": "没有带呢……",
            "narrator_zh": ""
        },
        {
            "location": "1127/ACT",
            "narrator": "",
            "text": "持ってないですね…",
            "zh": "没有带呢……",
            "narrator_zh": ""
        },
        {
            "location": "1129/TALK",
            "narrator": "みやび",
            "text": "よなぁ……。",
            "zh": "是吧……。",
            "narrator_zh": "雅"
        },
        {
            "location": "1130/TALK",
            "narrator": "みやび",
            "text": "仕方ない、\nジャンプ台は\nお蔵入りやね。",
            "zh": "没办法，\n跳跃台只好\n入库吃灰咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "1131/TALK",
            "narrator": "みやび",
            "text": "とほほ……。",
            "zh": "唉唉唉……。",
            "narrator_zh": "雅"
        },
        {
            "location": "1030/DIALOG",
            "narrator": "INFO",
            "text": "ジャンプ台に\n到着した！",
            "zh": "已抵达\n跳跃台！",
            "narrator_zh": "INFO"
        },
        {
            "location": "1083/DIALOG",
            "narrator": "INFO",
            "text": "コイガサコ博士に\n『ジャンプリモコン』を\n渡した！",
            "zh": "把『跳跃遥控器』\n交给了\n恋之崎博士！",
            "narrator_zh": "INFO"
        }
    ]
}
