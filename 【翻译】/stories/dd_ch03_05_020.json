{
    "dir": "chap05/daydra/dd_ch03_05_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "5356",
        "cid": "gabriella",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "料理教室",
        "title_zh": "Extra006 额外剧情",
        "sub_title_zh": "烹饪教室"
    },
    "entry": [
        {
            "location": "212/SCENARIO",
            "narrator": "",
            "text": "料理教室",
            "zh": "烹饪教室",
            "narrator_zh": ""
        },
        {
            "location": "227/TALK",
            "narrator": "みやび",
            "text": "…ふむ。\n和食の作り方を\n教えてほしいが？",
            "zh": "……嗯。\n日式菜的做法，\n想让我教你？",
            "narrator_zh": "雅"
        },
        {
            "location": "229/TALK",
            "narrator": "ガブリエラ",
            "text": "うん。",
            "zh": "嗯。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "230/TALK",
            "narrator": "ガブリエラ",
            "text": "和食って、レシピ\n見たり創作したり\nだったから――",
            "zh": "日式菜的话，都是看着食谱\n或者自己创着做\n过来的——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "231/TALK",
            "narrator": "ガブリエラ",
            "text": "ちゃんと\n習ったことって\n一度もないのよ。",
            "zh": "正经\n学过一次\n都没有。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "232/TALK",
            "narrator": "みやび",
            "text": "別に、教わる必要は\nないと思うけんど？",
            "zh": "我觉得倒也\n不必专门学，不过？",
            "narrator_zh": "雅"
        },
        {
            "location": "233/TALK",
            "narrator": "みやび",
            "text": "ガブちゃんの料理、\n普通に美味いと思うし。",
            "zh": "加布做的菜，\n我觉得本来就好吃。",
            "narrator_zh": "雅"
        },
        {
            "location": "234/TALK",
            "narrator": "ガブリエラ",
            "text": "けど、一度しっかりと\n習っておきたいの。",
            "zh": "可是，我想正经地\n学一次。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "235/TALK",
            "narrator": "みやび",
            "text": "…勉強熱心やねぇ。",
            "zh": "……学习倒热心得很咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "236/TALK",
            "narrator": "みやび",
            "text": "わかったちや。\nうちでえいなら\n力になるぞね！",
            "zh": "要得咯。\n我来就行的话，\n我会帮忙啵！",
            "narrator_zh": "雅"
        },
        {
            "location": "237/TALK",
            "narrator": "ガブリエラ",
            "text": "ありがと。\nそれじゃあ早速教えて\nもらえるかしら？",
            "zh": "谢谢。\n那就马上\n教我好吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "238/TALK",
            "narrator": "みやび",
            "text": "ああ、えいよ。",
            "zh": "啊，要得。",
            "narrator_zh": "雅"
        },
        {
            "location": "239/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "240/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "241/TALK",
            "narrator": "みやび",
            "text": "…一応言っておく\nけんど――",
            "zh": "……我先说一句，\n不过——",
            "narrator_zh": "雅"
        },
        {
            "location": "242/TALK",
            "narrator": "みやび",
            "text": "ただ教えてくれ\n言われても、\nうちも困るき。",
            "zh": "只叫我教你，\n我也不好办\n啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "243/TALK",
            "narrator": "みやび",
            "text": "何か作りたい料理を\n言ってほしいんやけんど。",
            "zh": "想做哪道菜，\n跟我说一声咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "245/TALK",
            "narrator": "ガブリエラ",
            "text": "えっ！？\nえ、えっと…。",
            "zh": "诶！？\n那、那个……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "247/TALK",
            "narrator": "みやび",
            "text": "…考えてなかったが？",
            "zh": "……没想过？",
            "narrator_zh": "雅"
        },
        {
            "location": "249/TALK",
            "narrator": "ガブリエラ",
            "text": "ちょ、ちょっと\n調べるから待ってて！",
            "zh": "等、等一下，\n我查一查你等着！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "262/TALK",
            "narrator": "ガブリエラ",
            "text": "マルザンナ、協力して！",
            "zh": "玛尔赞娜，帮我！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "264/SEL",
            "narrator": "",
            "text": "何を作るかの相談だね？",
            "zh": "是在商量做什么吧？",
            "narrator_zh": ""
        },
        {
            "location": "265/ACT",
            "narrator": "",
            "text": "何を作るかの相談だね？",
            "zh": "是在商量做什么吧？",
            "narrator_zh": ""
        },
        {
            "location": "267/TALK",
            "narrator": "ガブリエラ",
            "text": "本当、話が早くて助かるわ",
            "zh": "真是的，说话这么快帮大忙了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "268/TALK",
            "narrator": "ガブリエラ",
            "text": "マルザンナは、何を教えてもらったらいいと思う？",
            "zh": "玛尔赞娜觉得，让我学哪样好？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "270/SEL",
            "narrator": "",
            "text": "豚汁",
            "zh": "猪肉味噌汤",
            "narrator_zh": ""
        },
        {
            "location": "271/SEL",
            "narrator": "",
            "text": "ハンバーグ",
            "zh": "汉堡排",
            "narrator_zh": ""
        },
        {
            "location": "272/SEL",
            "narrator": "",
            "text": "刺身の盛り付け",
            "zh": "生鱼片摆盘",
            "narrator_zh": ""
        },
        {
            "location": "273/ACT",
            "narrator": "",
            "text": "豚汁",
            "zh": "猪肉味噌汤",
            "narrator_zh": ""
        },
        {
            "location": "284/TALK",
            "narrator": "ガブリエラ",
            "text": "なんだか、マルザンナが豚汁って言うの、ちょっとおかしいかも",
            "zh": "总觉得玛尔赞娜说出猪肉味噌汤，有点奇怪",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "286/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、豚汁って意見には賛成よ",
            "zh": "不过，猪肉味噌汤这个意见我赞成",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "299/TALK",
            "narrator": "ガブリエラ",
            "text": "うん、豚汁が良いわ。\nあれって具が多いから、\n結構難しいのよね。",
            "zh": "嗯，猪肉味噌汤好。\n那个配料多，\n挺难的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "300/TALK",
            "narrator": "ガブリエラ",
            "text": "前に作った時は、\n微妙に美味しく\nなかったし…。",
            "zh": "以前做的时候，\n味道微妙地\n不怎么好吃……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "301/TALK",
            "narrator": "みやび",
            "text": "豚汁…。",
            "zh": "猪肉味噌汤……。",
            "narrator_zh": "雅"
        },
        {
            "location": "302/TALK",
            "narrator": "みやび",
            "text": "まさかとは思うけんど、\n材料湯の中に入れて\n温めちょらんよな？",
            "zh": "我想不至于，不过\n你没把材料丢进汤里\n热一下就完事吧？",
            "narrator_zh": "雅"
        },
        {
            "location": "303/TALK",
            "narrator": "ガブリエラ",
            "text": "えっ、違うの？\nお味噌汁と同じ感じで\n作ってたわ。",
            "zh": "诶，不是吗？\n我是按味噌汤\n那种感觉做的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "304/TALK",
            "narrator": "みやび",
            "text": "…なるほど。\nまあ、初心者には\nよくある間違いやね。",
            "zh": "……原来如此。\n嘛，新手\n常犯这个错咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "305/TALK",
            "narrator": "みやび",
            "text": "じゃあ、豚汁の\n作り方を教えるちや。\n準備はえいか？",
            "zh": "那我就教\n猪肉味噌汤的做法咯。\n准备好了没？",
            "narrator_zh": "雅"
        },
        {
            "location": "309/TALK",
            "narrator": "ガブリエラ",
            "text": "ええ、\nいつでもＯＫよ！",
            "zh": "嗯，\n随时OK哦！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "321/TALK",
            "narrator": "真幌",
            "text": "…ほう、豚汁か。\n私が試食していいのか？",
            "zh": "……哦，猪肉味噌汤啊。\n我可以试吃吗？",
            "narrator_zh": "真幌"
        },
        {
            "location": "324/TALK",
            "narrator": "ガブリエラ",
            "text": "うん…まほなら\n遠慮なく感想言って\nくれそうだし。",
            "zh": "嗯……真幌的话，\n应该会毫不客气地\n说出感想。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "325/TALK",
            "narrator": "真幌",
            "text": "言っておくが、\n不味かったらはっきり\nそう言うぞ？",
            "zh": "我先说好，\n不好吃的话我会\n直说的。",
            "narrator_zh": "真幌"
        },
        {
            "location": "327/TALK",
            "narrator": "みやび",
            "text": "その心配はないき、\nグイッといくちや。",
            "zh": "不用担心那个啵，\n大口喝下去咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "328/TALK",
            "narrator": "真幌",
            "text": "火傷するだろうが。\nでは、いただこう…。",
            "zh": "会烫着吧。\n那么，我吃了……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "330/TALK",
            "narrator": "真幌",
            "text": "ズズッ…。",
            "zh": "吸溜……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "331/TALK",
            "narrator": "真幌",
            "text": "……むっ？",
            "zh": "……嗯？",
            "narrator_zh": "真幌"
        },
        {
            "location": "332/TALK",
            "narrator": "ガブリエラ",
            "text": "……ど、どう？",
            "zh": "……怎、怎么样？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "334/TALK",
            "narrator": "真幌",
            "text": "…これ、美味いな。",
            "zh": "……这个，好吃。",
            "narrator_zh": "真幌"
        },
        {
            "location": "336/TALK",
            "narrator": "ガブリエラ",
            "text": "ほ、本当！？",
            "zh": "真、真的！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "338/TALK",
            "narrator": "真幌",
            "text": "ああ…お世辞抜きに、\n驚くほどの美味さだ。",
            "zh": "啊……不是客套，\n好吃得让人吃惊。",
            "narrator_zh": "真幌"
        },
        {
            "location": "339/TALK",
            "narrator": "真幌",
            "text": "これをみやびではなく、\nギャヴィが作ったのか？",
            "zh": "这不是雅做的，\n是加维做的？",
            "narrator_zh": "真幌"
        },
        {
            "location": "340/TALK",
            "narrator": "ガブリエラ",
            "text": "教わりながらだけどね。",
            "zh": "是边学边做的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "341/TALK",
            "narrator": "みやび",
            "text": "けんど、うちは一切\n手を加えてないがよ。",
            "zh": "不过，我完全\n没动手咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "342/TALK",
            "narrator": "みやび",
            "text": "全部、ガブちゃんが\n一人で作ったちや。",
            "zh": "全是加布\n一个人做的咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "343/TALK",
            "narrator": "真幌",
            "text": "大したものだ。",
            "zh": "真厉害。",
            "narrator_zh": "真幌"
        },
        {
            "location": "344/TALK",
            "narrator": "真幌",
            "text": "ギャヴィ、おかわりの\n準備をしておけ。\nあと三杯はもらうぞ。",
            "zh": "加维，把添上的\n准备好。\n我还要三碗。",
            "narrator_zh": "真幌"
        },
        {
            "location": "348/TALK",
            "narrator": "みやび",
            "text": "良かったな、ガブちゃん。\n大成功やね。",
            "zh": "太好了，加布。\n大成功咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "351/TALK",
            "narrator": "ガブリエラ",
            "text": "みやびのおかげよ。\nまた今度、違う料理を\n教えてね。",
            "zh": "多亏了雅。\n下次再教我\n别的菜。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "352/TALK",
            "narrator": "みやび",
            "text": "…難しいのは面倒やき、\n簡単なのやったら\nえいなぁ。",
            "zh": "……难的太麻烦啵，\n简单的话\n要得就好。",
            "narrator_zh": "雅"
        },
        {
            "location": "353/ACT",
            "narrator": "",
            "text": "ハンバーグ",
            "zh": "汉堡排",
            "narrator_zh": ""
        },
        {
            "location": "354/TALK",
            "narrator": "ガブリエラ",
            "text": "それは洋食よ！",
            "zh": "那是西餐！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "355/TALK",
            "narrator": "ガブリエラ",
            "text": "洋食と和食の違い、マルザンナにはわからないのかしら？",
            "zh": "西餐和日式菜的区别，玛尔赞娜分不清吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "368/TALK",
            "narrator": "ガブリエラ",
            "text": "…でも和食って洋食を\n和風にしたものも、\n結構あるわよね。",
            "zh": "……不过日式菜里，把西餐\n做成和风的\n也挺多的吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "369/TALK",
            "narrator": "ガブリエラ",
            "text": "聞くだけ\n聞いてみようかしら？",
            "zh": "只是问问，\n要不要问一下？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "371/TALK",
            "narrator": "ガブリエラ",
            "text": "ハンバーグみたいな\n感じの和食って…\nやっぱりないわよね？",
            "zh": "像汉堡排那种\n感觉的日式菜……\n果然没有吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "372/TALK",
            "narrator": "みやび",
            "text": "あるよ。",
            "zh": "有的。",
            "narrator_zh": "雅"
        },
        {
            "location": "375/TALK",
            "narrator": "ガブリエラ",
            "text": "あるの！？",
            "zh": "有吗！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "376/TALK",
            "narrator": "みやび",
            "text": "豆腐ハンバーグちゅう、\nヘルシーなのが\nあるちや。",
            "zh": "有种叫豆腐汉堡排、\n比较健康的\n那种咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "378/TALK",
            "narrator": "ガブリエラ",
            "text": "それ、面白そう！\nその作り方教えて。",
            "zh": "那个好像很有意思！\n教我做法。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "380/TALK",
            "narrator": "みやび",
            "text": "わかったちや。\nそれじゃあ、野菜と\n豆腐を用意するぞね。",
            "zh": "要得咯。\n那么，把蔬菜和\n豆腐准备好啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "391/TALK",
            "narrator": "真幌",
            "text": "…なるほど。\nそれで、私に試食して\nほしいというのだな？",
            "zh": "……原来如此。\n所以是想让我\n试吃，对吧？",
            "narrator_zh": "真幌"
        },
        {
            "location": "393/TALK",
            "narrator": "ガブリエラ",
            "text": "そういうこと。\n率直な感想を\n聞きたいの。",
            "zh": "就是这样。\n我想听\n坦率的感想。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "394/TALK",
            "narrator": "みやび",
            "text": "冷めたら不味くなるき、\n熱いうちに食べるんが\nえいですよ。",
            "zh": "凉了就不好吃啵，\n趁热吃\n比较好。",
            "narrator_zh": "雅"
        },
        {
            "location": "395/TALK",
            "narrator": "真幌",
            "text": "そうだな。\nでは、いただく。",
            "zh": "也是。\n那么，我吃了。",
            "narrator_zh": "真幌"
        },
        {
            "location": "397/TALK",
            "narrator": "真幌",
            "text": "あむっ……。",
            "zh": "啊呜……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "398/TALK",
            "narrator": "ガブリエラ",
            "text": "……ど、どう？",
            "zh": "……怎、怎么样？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "399/TALK",
            "narrator": "真幌",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "真幌"
        },
        {
            "location": "401/TALK",
            "narrator": "真幌",
            "text": "…美味いな。",
            "zh": "……好吃。",
            "narrator_zh": "真幌"
        },
        {
            "location": "403/TALK",
            "narrator": "ガブリエラ",
            "text": "…なんか、不満そうに\n見えるけど…。",
            "zh": "……总觉得，你看起来\n不太满意……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "404/TALK",
            "narrator": "真幌",
            "text": "味に文句があるわけ\nではないんだ。",
            "zh": "不是对味道\n有意见。",
            "narrator_zh": "真幌"
        },
        {
            "location": "406/TALK",
            "narrator": "真幌",
            "text": "ただ、ハンバーグと\n思って食べると――",
            "zh": "只是，当成汉堡排\n吃下去的话——",
            "narrator_zh": "真幌"
        },
        {
            "location": "407/TALK",
            "narrator": "真幌",
            "text": "この味はヘルシーで、\n少々物足りなさを\n感じてしまってな…。",
            "zh": "这个味道很健康，\n就稍微觉得\n有点不够……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "408/TALK",
            "narrator": "みやび",
            "text": "肉は一切使ってない\n豆腐ハンバーグやき、\n当然やね。",
            "zh": "一点肉都没用的\n豆腐汉堡排啵，\n当然咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "410/TALK",
            "narrator": "真幌",
            "text": "本当にこれは\nハンバーグと言って\nいいのだろうか。",
            "zh": "这东西真的\n能叫做汉堡排\n吗。",
            "narrator_zh": "真幌"
        },
        {
            "location": "411/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、美味しいとは\n思ってくれてるのよね？",
            "zh": "不过，你觉得\n好吃，对吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "412/TALK",
            "narrator": "真幌",
            "text": "…ああ、美味い。\n本当に美味いぞ。",
            "zh": "……啊，好吃。\n真的很好吃。",
            "narrator_zh": "真幌"
        },
        {
            "location": "413/TALK",
            "narrator": "ガブリエラ",
            "text": "それが聞ければ満足よ。\n新しい和食のレパー\nトリーが増えたわ。",
            "zh": "能听到这个我就满足了。\n新的日式菜\nrepertoire又增加了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "414/ACT",
            "narrator": "",
            "text": "刺身の盛り付け",
            "zh": "生鱼片摆盘",
            "narrator_zh": ""
        },
        {
            "location": "424/TALK",
            "narrator": "ガブリエラ",
            "text": "盛り付けって、料理なのかしら？",
            "zh": "摆盘算料理吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "425/TALK",
            "narrator": "ガブリエラ",
            "text": "でも、お刺身を綺麗に盛り付けるやり方",
            "zh": "不过，把生鱼片摆得很漂亮的方法",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "426/TALK",
            "narrator": "ガブリエラ",
            "text": "あれができるようになったらかっこいいかも！",
            "zh": "要是学会了那个，也许会很酷！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "439/TALK",
            "narrator": "ガブリエラ",
            "text": "みやび、\nお刺身が良いわ。",
            "zh": "雅，\n生鱼片好。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "440/TALK",
            "narrator": "ガブリエラ",
            "text": "お刺身を綺麗に\n盛り付けるやり方、\n教えて！",
            "zh": "把生鱼片摆漂亮的\n方法，\n教我！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "441/TALK",
            "narrator": "みやび",
            "text": "あ～…\nお造りのことやね。",
            "zh": "啊……\n你说的是生鱼片拼盘咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "442/TALK",
            "narrator": "ガブリエラ",
            "text": "そう！\n…難しいかしら？",
            "zh": "对！\n……难吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "443/TALK",
            "narrator": "みやび",
            "text": "いや、そんなことは\nないぞね。",
            "zh": "不，没\n那么难啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "445/TALK",
            "narrator": "みやび",
            "text": "コツさえ掴めば、\nとりあえずそれっぽくは\nできるちや。",
            "zh": "抓住诀窍的话，\n先做出个样子\n是可以的咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "447/TALK",
            "narrator": "ガブリエラ",
            "text": "それじゃお願い\nするわ。まずは\n何をすればいい？",
            "zh": "那就拜托了。\n首先\n该做什么？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "448/TALK",
            "narrator": "みやび",
            "text": "盛り付けをするには、\nとにかく刺身が必要に\nなるき――",
            "zh": "要摆盘的话，\n反正都得有生鱼片\n啵——",
            "narrator_zh": "雅"
        },
        {
            "location": "449/TALK",
            "narrator": "みやび",
            "text": "せっかくやし、\n魚をさばくところから\n始めるちや。",
            "zh": "既然如此，\n就从处理鱼\n开始咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "459/TALK",
            "narrator": "真幌",
            "text": "…随分と高級そうな\n刺身のようだが――",
            "zh": "……看起来相当\n高级的生鱼片——",
            "narrator_zh": "真幌"
        },
        {
            "location": "461/TALK",
            "narrator": "真幌",
            "text": "本当に私が食べて\nしまっていいのか？",
            "zh": "真的可以\n让我吃掉吗？",
            "narrator_zh": "真幌"
        },
        {
            "location": "464/TALK",
            "narrator": "ガブリエラ",
            "text": "ふふっ…\nそう見えるでしょ？",
            "zh": "呵呵……\n看起来是那样吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "465/TALK",
            "narrator": "みやび",
            "text": "まほさん、\n安心してえいよ。",
            "zh": "真幌，\n放心，要得。",
            "narrator_zh": "雅"
        },
        {
            "location": "466/TALK",
            "narrator": "みやび",
            "text": "盛り付けで豪華に\n見えるけんど、魚は\nスーパーの安物やき。",
            "zh": "摆盘看起来豪华，\n不过鱼是\n超市的便宜货啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "467/TALK",
            "narrator": "ガブリエラ",
            "text": "そういうこと。\nほら、早く食べてみて。",
            "zh": "就是这样。\n来，快吃吃看。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "469/TALK",
            "narrator": "真幌",
            "text": "あ、ああ…あむっ…。",
            "zh": "啊、啊……啊呜……。",
            "narrator_zh": "真幌"
        },
        {
            "location": "471/TALK",
            "narrator": "真幌",
            "text": "…凄いな。\nとても安い魚とは\n思えん美味さだ。",
            "zh": "……厉害。\n完全吃不出\n是便宜鱼的味道。",
            "narrator_zh": "真幌"
        },
        {
            "location": "473/TALK",
            "narrator": "ガブリエラ",
            "text": "本当！？",
            "zh": "真的！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "475/TALK",
            "narrator": "真幌",
            "text": "ああ、見た目が\n素晴らしいからだと\n思うが――",
            "zh": "啊，我想是因为\n卖相\n太好了——",
            "narrator_zh": "真幌"
        },
        {
            "location": "476/TALK",
            "narrator": "真幌",
            "text": "まるで料亭の刺身を\n食べているような\n気分だ。",
            "zh": "简直像在吃\n日式料理店的\n生鱼片。",
            "narrator_zh": "真幌"
        },
        {
            "location": "477/TALK",
            "narrator": "真幌",
            "text": "まさか劇場でこんなに\n素晴らしい物が食べれる\nとは…感動したぞ。",
            "zh": "没想到在剧场能吃到\n这么好的东西……\n我很感动。",
            "narrator_zh": "真幌"
        },
        {
            "location": "481/TALK",
            "narrator": "みやび",
            "text": "べた褒めやな。\n相当美味しかった\nようやね。",
            "zh": "夸得真够劲。\n看来是相当\n好吃咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "484/TALK",
            "narrator": "ガブリエラ",
            "text": "みやびのおかげよ。\nまた得意料理が一つ…。",
            "zh": "多亏了雅。\n又多了一道拿手菜……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "485/TALK",
            "narrator": "ガブリエラ",
            "text": "って、そうだ。\n一つ疑問に思ってた\nことがあるんだけど――",
            "zh": "等等，对了。\n有一件事我一直\n觉得奇怪——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "486/TALK",
            "narrator": "ガブリエラ",
            "text": "盛り付けっていうのは、\n料理の内に入るの？",
            "zh": "所谓摆盘，\n算在料理里面吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "488/TALK",
            "narrator": "みやび",
            "text": "…そんなの知らんぞね。",
            "zh": "……那种事我可不晓得啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "220/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>5月17日　4:33 PM</color>\nとある平日の午後、神楽坂トライナリーのバイト中にて。",
            "zh": "<color=green>5月17日　4:33 PM</color>\n某个工作日的下午，在神乐坂三重奏打工时。",
            "narrator_zh": "Dialog_EventData"
        },
        {
