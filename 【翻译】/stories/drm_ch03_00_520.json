   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "57/TALK",
   "narrator": "ガブリエラ",
   "text": "いつもは何を使っているかってところなのよね"
  },
  {
   "location": "59/SEL",
   "narrator": "",
   "text": "教えたほうがいい？",
   "zh": "该告诉你吗？",
   "narrator_zh": ""
  },
  {
   "location": "60/SEL",
   "narrator": "",
   "text": "その気持ちが嬉しい",
   "zh": "你有这份心我就很高兴",
   "narrator_zh": ""
  },
  {
   "location": "61/SEL",
   "narrator": "",
   "text": "何もいらないよ",
   "zh": "我什么都不要",
   "narrator_zh": ""
  },
  {
   "location": "62/ACT",
   "narrator": "",
   "text": "教えたほうがいい？",
   "zh": "该告诉你吗？",
   "narrator_zh": ""
  },
