   "text": "540_ウィンドウショッピング"
  },
  {
   "location": "32/TALK",
   "narrator": "ガブリエラ",
   "text": "ねえ聞いて",
   "zh": "喂，听我说",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "33/TALK",
   "narrator": "ガブリエラ",
   "text": "アーヤったら",
   "zh": "绫水你真是的",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "34/TALK",
   "narrator": "ガブリエラ",
   "text": "プレゼントは手作りが一番よろこんでもらえるって言うの"
  },
  {
   "location": "35/TALK",
   "narrator": "ガブリエラ",
   "text": "どう思う？",
   "zh": "你觉得呢？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "37/SEL",
   "narrator": "",
   "text": "いいんじゃない",
   "zh": "不是挺好",
   "narrator_zh": ""
  },
  {
   "location": "38/SEL",
   "narrator": "",
   "text": "ちょっと重いかな",
   "zh": "会不会有点重",
   "narrator_zh": ""
  },
  {
   "location": "39/TALK",
   "narrator": "ガブリエラ",
   "text": "まあ",
   "zh": "嗯",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "40/TALK",
   "narrator": "ガブリエラ",
   "text": "どのくらいの手作りかにもよるとは思うのよ？",
   "zh": "我觉得也看有多少是手工的哦？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "41/TALK",
   "narrator": "ガブリエラ",
   "text": "さすがにアーヤだってセーターとかまでは作らないと思うのよね",
   "zh": "我觉得就算是绫水也不会做到织毛衣的地步",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "42/TALK",
   "narrator": "ガブリエラ",
   "text": "でも",
   "zh": "不过",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "43/TALK",
   "narrator": "ガブリエラ",
   "text": "意外と簡単とか言い出すのかしらね・・・"
  },
  {
   "location": "44/ACT",
   "narrator": "",
   "text": "いいんじゃない",
   "zh": "不是挺好",
   "narrator_zh": ""
  },
  {
   "location": "45/TALK",
   "narrator": "ガブリエラ",
   "text": "えっ",
   "zh": "诶",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "46/TALK",
   "narrator": "ガブリエラ",
   "text": "$handle$は手作りのほうが嬉しい人なの",
   "zh": "$handle$是那种更喜欢手工制作的人",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "47/TALK",
   "narrator": "ガブリエラ",
   "text": "そうなのね・・・",
   "zh": "原来是这样・・・",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "48/ACT",
   "narrator": "",
   "text": "ちょっと重いかな",
   "zh": "会不会有点重",
   "narrator_zh": ""
  },
  {
   "location": "49/TALK",
   "narrator": "ガブリエラ",
   "text": "やっぱりそうよね"
  },
  {
   "location": "50/TALK",
   "narrator": "ガブリエラ",
   "text": "よかったわ、、、、"
  },
  {
   "location": "52/TALK",
   "narrator": "ガブリエラ",
   "text": "私だったら"
  },
  {
   "location": "54/TALK",
   "narrator": "ガブリエラ",
   "text": "いつでも使えるものとかをプレゼントするわ"
