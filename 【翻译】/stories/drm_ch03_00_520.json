   "location": "55/TALK",
   "narrator": "ガブリエラ",
   "text": "でも",
   "zh": "不过",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "56/TALK",
   "narrator": "ガブリエラ",
   "text": "問題は",
