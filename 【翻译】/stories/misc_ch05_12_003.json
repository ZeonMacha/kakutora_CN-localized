            "narrator_zh": ""
        },
        {
            "location": "3526/TALK",
            "narrator": "神楽",
            "text": "アキバの名物と言えば",
            "zh": "说到秋叶原的名物",
            "narrator_zh": "神乐"
        },
        {
            "location": "3527/TALK",
            "narrator": "神楽",
            "text": "おでん缶だと思うのだけれども",
            "zh": "我觉得是关东煮罐头",
            "narrator_zh": "神乐"
        },
        {
            "location": "3529/SEL",
            "narrator": "",
            "text": "そうなんだ？",
            "zh": "是这样吗？",
            "narrator_zh": ""
        },
        {
            "location": "3530/SEL",
            "narrator": "",
            "text": "そうだよね！",
            "zh": "就是这样吧！",
            "narrator_zh": ""
        },
        {
            "location": "3531/SEL",
            "narrator": "",
            "text": "そういうことにしとく",
            "zh": "就先这么算",
            "narrator_zh": ""
        },
        {
            "location": "3532/ACT",
            "narrator": "",
            "text": "そうなんだ？",
            "zh": "是这样吗？",
            "narrator_zh": ""
        },
        {
            "location": "3533/TALK",
            "narrator": "神楽",
            "text": "そうだから",
            "zh": "因为是这样",
            "narrator_zh": "神乐"
        },
        {
            "location": "3534/ACT",
            "narrator": "",
            "text": "そうだよね！",
            "zh": "就是这样吧！",
            "narrator_zh": ""
        },
        {
            "location": "3536/TALK",
            "narrator": "神楽",
            "text": "でしょでしょ！！！",
            "zh": "对吧对吧！！！",
            "narrator_zh": "神乐"
        },
        {
            "location": "3538/TALK",
            "narrator": "神楽",
            "text": "偉いぞ$handlek$",
            "zh": "真棒$handlek$",
            "narrator_zh": "神乐"
        },
        {
            "location": "3539/TALK",
            "narrator": "神楽",
            "text": "わかってる！",
            "zh": "你懂！",
            "narrator_zh": "神乐"
        },
        {
            "location": "3540/ACT",
            "narrator": "",
            "text": "そういうことにしとく",
            "zh": "就先这么算",
            "narrator_zh": ""
        },
        {
            "location": "3541/TALK",
            "narrator": "神楽",
            "text": "感じ悪いなー",
            "zh": "感觉真差啊",
            "narrator_zh": "神乐"
        },
        {
            "location": "3543/TALK",
            "narrator": "神楽",
            "text": "おでん缶はやっぱり自販機で！",
            "zh": "关东煮罐头果然要在自动售货机！",
            "narrator_zh": "神乐"
        },
        {
            "location": "3544/TALK",
            "narrator": "神楽",
            "text": "ナウでヤングなアキバキッズはこれ一択ダヨネー",
            "zh": "又潮又年轻的秋叶原小孩，只选这个啊",
            "narrator_zh": "神乐"
        },
        {
            "location": "3546/SEL",
            "narrator": "",
            "text": "いやナウでもヤングでもないから…",
            "zh": "不，既不潮也不年轻……",
            "narrator_zh": ""
        },
        {
            "location": "3547/SEL",
            "narrator": "",
            "text": "お、おう",
            "zh": "哦、哦",
            "narrator_zh": ""
        },
        {
            "location": "3548/SEL",
            "narrator": "",
            "text": "神楽のために買い占めるよ！",
            "zh": "为了神乐我买断！",
            "narrator_zh": ""
        },
        {
            "location": "3549/ACT",
            "narrator": "",
            "text": "いやナウでもヤングでもないから…",
            "zh": "不，既不潮也不年轻……",
            "narrator_zh": ""
        },
        {
            "location": "3550/TALK",
            "narrator": "神楽",
            "text": "そっかー",
            "zh": "这样啊——",
            "narrator_zh": "神乐"
        },
        {
            "location": "3552/TALK",
            "narrator": "神楽",
            "text": "なら仕方ないねー",
            "zh": "那就没办法了——",
            "narrator_zh": "神乐"
        },
        {
            "location": "3553/ACT",
            "narrator": "",
            "text": "お、おう",
            "zh": "哦、哦",
            "narrator_zh": ""
        },
        {
            "location": "3554/TALK",
            "narrator": "神楽",
            "text": "反応悪いね？",
            "zh": "反应真差呢？",
            "narrator_zh": "神乐"
        },
        {
            "location": "3555/ACT",
            "narrator": "",
            "text": "神楽のために買い占めるよ！",
            "zh": "为了神乐我买断！",
            "narrator_zh": ""
        },
        {
            "location": "3557/TALK",
            "narrator": "神楽",
            "text": "やだ素敵",
            "zh": "讨厌，好棒",
            "narrator_zh": "神乐"
        },
        {
            "location": "3558/TALK",
            "narrator": "神楽",
            "text": "よーしぴょんこおでん缶でマンション建てちゃうぞー！",
            "zh": "好，蹦子要用关东煮罐头盖公寓了——！",
            "narrator_zh": "神乐"
        },
        {
            "location": "3559/TALK",
            "narrator": "神楽",
            "text": "非常時には食べちゃうぞー！",
            "zh": "紧急的时候就吃掉——！",
            "narrator_zh": "神乐"
        },
        {
            "location": "3561/TALK",
            "narrator": "神楽",
            "text": "だからといってぴょんこがおでん好きかというと全くそうではないぴょん",
            "zh": "可要说蹦子喜不喜欢关东煮，完全不是pyon",
            "narrator_zh": "神乐"
        },
        {
            "location": "3562/TALK",
            "narrator": "神楽",
            "text": "そこんとこよろしくね！",
            "zh": "这一点请多关照！",
            "narrator_zh": "神乐"
        }
    ]
