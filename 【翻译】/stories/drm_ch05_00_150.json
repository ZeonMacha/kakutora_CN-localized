  "title": "らぶとーく 第15話",
  "sub_title": "現実はかくあるべし"
 },
 "entry": [
  {
   "location": "556/SCENARIO",
   "narrator": "",
   "text": "現実はかくあるべし"
  },
  {
   "location": "572/TALK",
   "narrator": "神楽",
   "text": "あそこ新しいお店\nできたんですね。"
  },
  {
   "location": "573/TALK",
   "narrator": "つばめ",
   "text": "本当だね。開店は\n来週だって。"
  },
  {
   "location": "574/TALK",
   "narrator": "神楽",
   "text": "開店したら一緒に\n行ってみませんか？"
  },
  {
   "location": "575/TALK",
   "narrator": "つばめ",
   "text": "うんうん！\n絶対行こうね！"
  },
  {
   "location": "576/TALK",
   "narrator": "つばめ",
   "text": "…そういえば。\nこの前卯月さん\n言ってたよね。"
  },
  {
   "location": "578/TALK",
   "narrator": "つばめ",
   "text": "この坂には卯月さんの\nパワーが満ちてるって。",
   "zh": "说是这座斜坡上充满了\n卯月的力量。",
   "narrator_zh": "燕"
  },
  {
   "location": "579/SEL",
   "narrator": "",
   "text": "まだ覚えてるみたいだよ？",
   "zh": "好像还记得呢？",
   "narrator_zh": ""
  },
  {
   "location": "580/ACT",
   "narrator": "",
   "text": "まだ覚えてるみたいだよ？",
   "zh": "好像还记得呢？",
   "narrator_zh": ""
  },
  {
   "location": "598/TALK",
   "narrator": "神楽",
   "text": "忘れててくれればよかったんですけど、、、"
  },
  {
   "location": "600/SEL",
   "narrator": "",
   "text": "せっかくだから嘘をつきとおそう",
   "zh": "难得一次，就把谎撒到底",
   "narrator_zh": ""
  },
  {
   "location": "601/SEL",
   "narrator": "",
   "text": "頭がいいんだか悪いんだか",
   "zh": "不知道是聪明还是笨",
   "narrator_zh": ""
  },
  {
   "location": "602/SEL",
   "narrator": "",
   "text": "素直すぎない？",
   "zh": "是不是太坦率了？",
   "narrator_zh": ""
  },
  {
   "location": "603/ACT",
   "narrator": "",
   "text": "せっかくだから嘘をつきとおそう",
   "zh": "难得一次，就把谎撒到底",
   "narrator_zh": ""
  },
  {
   "location": "604/TALK",
   "narrator": "神楽",
   "text": "その手もありますけど",
   "zh": "也有那种办法",
   "narrator_zh": "神乐"
  },
  {
   "location": "605/TALK",
   "narrator": "神楽",
   "text": "この先が面倒くさいですね、、、",
   "zh": "今后真是麻烦呢、、、",
   "narrator_zh": "神乐"
  },
  {
   "location": "606/ACT",
   "narrator": "",
   "text": "頭がいいんだか悪いんだか",
   "zh": "不知道是聪明还是笨",
   "narrator_zh": ""
  },
  {
   "location": "607/TALK",
   "narrator": "神楽",
   "text": "覚えてたからいいってことですか？"
  },
  {
   "location": "608/TALK",
   "narrator": "神楽",
   "text": "うーん、、、",
   "zh": "嗯……",
   "narrator_zh": "神乐"
  },
  {
   "location": "609/ACT",
   "narrator": "",
   "text": "素直すぎない？",
   "zh": "是不是太坦率了？",
   "narrator_zh": ""
  },
  {
   "location": "610/TALK",
   "narrator": "神楽",
   "text": "そうなんですよねー",
   "zh": "就是这样呢——",
   "narrator_zh": "神乐"
  },
  {
   "location": "612/TALK",
   "narrator": "神楽",
   "text": "ここまでだとは思いませんでした、、、",
   "zh": "没想到会到此为止、、、",
   "narrator_zh": "神乐"
  },
  {
   "location": "625/TALK",
   "narrator": "神楽",
   "text": "…つばめさん。\nその話は…。"
  },
  {
   "location": "627/TALK",
   "narrator": "つばめ",
   "text": "え？\nあ、もしかして！",
   "zh": "诶？\n啊，难道说！",
   "narrator_zh": "燕"
  },
  {
   "location": "628/TALK",
   "narrator": "つばめ",
   "text": "秘密にしなきゃ\nいけないことだった？"
  },
  {
   "location": "629/TALK",
   "narrator": "神楽",
   "text": "…ええと。\nそうじゃなくて。"
  },
  {
   "location": "630/TALK",
   "narrator": "神楽",
   "text": "そんなパワーは\n実在しないんです。",
   "zh": "那种力量\n并不存在。",
   "narrator_zh": "神乐"
  },
  {
   "location": "632/TALK",
   "narrator": "つばめ",
   "text": "え？",
   "zh": "诶？",
   "narrator_zh": "燕"
  },
  {
   "location": "633/SEL",
   "narrator": "",
   "text": "そうだったの！？",
   "zh": "是这样的吗！？",
   "narrator_zh": ""
  },
  {
   "location": "634/ACT",
   "narrator": "",
   "text": "そうだったの！？",
   "zh": "是这样的吗！？",
   "narrator_zh": ""
  },
  {
   "location": "651/TALK",
   "narrator": "神楽",
   "text": "知ってましたよね、、、"
  },
  {
   "location": "653/SEL",
   "narrator": "",
   "text": "ばれてた？",
   "zh": "暴露了吗？",
   "narrator_zh": ""
  },
  {
   "location": "654/SEL",
   "narrator": "",
   "text": "ここはこう言うべきかなって",
   "zh": "我想这里该这么说吧",
   "narrator_zh": ""
  },
  {
   "location": "655/SEL",
   "narrator": "",
   "text": "いや初耳",
   "zh": "第一次听说",
   "narrator_zh": ""
  },
  {
   "location": "656/ACT",
   "narrator": "",
   "text": "ばれてた？",
   "zh": "暴露了吗？",
   "narrator_zh": ""
  },
  {
   "location": "657/TALK",
   "narrator": "神楽",
   "text": "バレるわｳﾞｫｹ"
  },
  {
   "location": "658/ACT",
   "narrator": "",
   "text": "ここはこう言うべきかなって",
   "zh": "我想这里该这么说吧",
   "narrator_zh": ""
  },
  {
   "location": "659/TALK",
   "narrator": "神楽",
   "text": "そんなわけﾈｰﾖ",
   "zh": "不可能啦",
   "narrator_zh": "神乐"
  },
  {
   "location": "660/ACT",
   "narrator": "",
   "text": "いや初耳",
   "zh": "第一次听说",
   "narrator_zh": ""
  },
  {
   "location": "661/TALK",
   "narrator": "神楽",
   "text": "嘘つくな頃す"
  },
  {
   "location": "673/SEL",
   "narrator": "",
   "text": "口調違くない！？",
   "zh": "语气不一样了吧！？",
   "narrator_zh": ""
  },
  {
   "location": "674/SEL",
   "narrator": "",
   "text": "本性ｷﾀｰ！！！",
   "zh": "本性暴露啦！！！",
   "narrator_zh": ""
  },
  {
   "location": "675/SEL",
   "narrator": "",
   "text": "神楽怒ったの？",
   "zh": "神乐生气了？",
   "narrator_zh": ""
  },
  {
   "location": "676/ACT",
   "narrator": "",
   "text": "口調違くない！？",
   "zh": "语气不一样了吧！？",
   "narrator_zh": ""
  },
  {
   "location": "677/ACT",
   "narrator": "",
   "text": "本性ｷﾀｰ！！！",
   "zh": "本性暴露啦！！！",
   "narrator_zh": ""
  },
  {
   "location": "678/ACT",
   "narrator": "",
   "text": "神楽怒ったの？",
   "zh": "神乐生气了？",
   "narrator_zh": ""
  },
  {
   "location": "683/TALK",
   "narrator": "神楽",
   "text": "そういうことなので…。",
   "zh": "就是这么回事……。",
   "narrator_zh": "神乐"
  },
  {
   "location": "685/TALK",
   "narrator": "つばめ",
   "text": "そ、そうなんだ。",
   "zh": "是、是这样啊。",
   "narrator_zh": "燕"
  },
  {
   "location": "686/TALK",
   "narrator": "神楽",
   "text": "ごめんなさい。\n嘘をつくつもりは\nなくて。",
   "zh": "对不起。\n我不是想\n撒谎。",
   "narrator_zh": "神乐"
  },
  {
   "location": "688/TALK",
   "narrator": "神楽",
   "text": "冗談で言った\nつもりだったんです。"
  },
  {
   "location": "689/TALK",
   "narrator": "つばめ",
   "text": "あ、ううん。\n気にしないで。"
  },
  {
   "location": "690/TALK",
   "narrator": "つばめ",
   "text": "そっか……。\n冗談だったんだ…。",
   "zh": "这样啊……。\n原来是开玩笑啊……。",
   "narrator_zh": "燕"
  },
  {
   "location": "691/TALK",
   "narrator": "神楽",
   "text": "新しいお店に\n一緒に行きましょうは\n本当ですからね？"
  },
  {
   "location": "693/TALK",
   "narrator": "つばめ",
   "text": "うん！\n絶対だよ！"
  },
  {
   "location": "694/TALK",
   "narrator": "神楽",
   "text": "やれやれ……。"
  },
  {
   "location": "570/DIALOG",
   "narrator": "Dialog_EventData",
   "text": "<color=green>某月某日　7:16 PM</color>\nとある平日、神楽坂でのこと"
