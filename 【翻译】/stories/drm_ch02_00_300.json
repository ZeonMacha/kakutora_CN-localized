        "title": "らぶとーく 第30話",
        "sub_title": "かわいいあのこ",
        "title_zh": "恋爱漫谈 第30话",
        "sub_title_zh": "那个可爱的孩子"
    },
    "entry": [
        {
            "location": "269/SCENARIO",
            "narrator": "",
            "text": "かわいいあのこ",
            "zh": "那个可爱的孩子",
            "narrator_zh": ""
        },
        {
            "location": "280/TALK",
            "narrator": "アーヤ",
            "text": "…あら？\nあそこにいるのって…。",
            "zh": "…哎呀？\n站在那边的不是…。",
            "narrator_zh": "绫水"
        },
        {
            "location": "281/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィ。",
            "zh": "加维。",
            "narrator_zh": "绫水"
        },
        {
            "location": "284/TALK",
            "narrator": "ガブリエラ",
            "text": "…なんだ、アーヤか。\n何の用？",
            "zh": "……什么啊，是绫水呀。\n有什么事？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "285/TALK",
            "narrator": "アーヤ",
            "text": "気分転換にちょっとね。",
            "zh": "出来换换心情。",
            "narrator_zh": "绫水"
        },
        {
            "location": "286/TALK",
            "narrator": "アーヤ",
            "text": "…お弁当食べてたの？",
            "zh": "……在吃便当吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "289/TALK",
            "narrator": "ガブリエラ",
            "text": "ええ…ここって日当たり\n良いし、静かに食べれる\nから好きなのよ。",
            "zh": "嗯……这里日照\n好，又能安静地吃，\n所以我喜欢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "290/TALK",
            "narrator": "アーヤ",
            "text": "そう…。",
            "zh": "这样啊……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "291/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "293/TALK",
            "narrator": "ガブリエラ",
            "text": "何よ？\nまだ何か用事あるの？",
            "zh": "什么啊？\n还有什么事吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "295/TALK",
            "narrator": "アーヤ",
            "text": "あ、ううん。\nそれじゃ、劇場でね。",
            "zh": "啊，没有。\n那就剧场见。",
            "narrator_zh": "绫水"
        },
        {
            "location": "297/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "307/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "308/TALK",
            "narrator": "アーヤ",
            "text": "やっぱり、気になるわ。",
            "zh": "果然还是在意。",
            "narrator_zh": "绫水"
        },
        {
            "location": "320/TALK",
            "narrator": "アーヤ",
            "text": "心配なことがあるの",
            "zh": "有件担心的事",
            "narrator_zh": "绫水"
        },
        {
            "location": "321/TALK",
            "narrator": "アーヤ",
            "text": "相談に乗ってヽ(´o｀；",
            "zh": "帮我参谋一下ヽ(´o｀；",
            "narrator_zh": "绫水"
        },
        {
            "location": "323/SEL",
            "narrator": "",
            "text": "ガブリエラのこと？",
            "zh": "加布里埃拉的事？",
            "narrator_zh": ""
        },
        {
            "location": "324/ACT",
            "narrator": "",
            "text": "ガブリエラのこと？",
            "zh": "加布里埃拉的事？",
            "narrator_zh": ""
        },
        {
            "location": "326/TALK",
            "narrator": "アーヤ",
            "text": "そう！(>_<)",
            "zh": "对！(>_<)",
            "narrator_zh": "绫水"
        },
        {
            "location": "327/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィってば",
            "zh": "加维这个人",
            "narrator_zh": "绫水"
        },
        {
            "location": "328/TALK",
            "narrator": "アーヤ",
            "text": "裏庭で一人でお弁当食べてたの",
            "zh": "在后院一个人吃便当",
            "narrator_zh": "绫水"
        },
        {
            "location": "330/TALK",
            "narrator": "アーヤ",
            "text": "静かで良い、って言ってたけど",
            "zh": "她说安静很好，但是",
            "narrator_zh": "绫水"
        },
        {
            "location": "331/TALK",
            "narrator": "アーヤ",
            "text": "やっぱり",
            "zh": "果然",
            "narrator_zh": "绫水"
        },
        {
            "location": "332/TALK",
            "narrator": "アーヤ",
            "text": "クラスの子達と上手くいってないのかしら？",
            "zh": "是不是和班上的人处不好？",
            "narrator_zh": "绫水"
        },
        {
            "location": "333/TALK",
            "narrator": "アーヤ",
            "text": "心配で堪らないわ(; ;)",
            "zh": "担心得不得了(; ;)",
            "narrator_zh": "绫水"
        },
        {
            "location": "335/SEL",
            "narrator": "",
            "text": "心配し過ぎ",
            "zh": "担心过头了",
            "narrator_zh": ""
        },
        {
            "location": "336/SEL",
            "narrator": "",
            "text": "おかん目線だね",
            "zh": "这是当妈的眼神呢",
            "narrator_zh": ""
        },
        {
            "location": "337/SEL",
            "narrator": "",
            "text": "大丈夫、大丈夫",
            "zh": "没事，没事",
            "narrator_zh": ""
        },
        {
            "location": "338/ACT",
            "narrator": "",
            "text": "心配し過ぎ",
            "zh": "担心过头了",
            "narrator_zh": ""
        },
        {
            "location": "339/TALK",
            "narrator": "アーヤ",
            "text": "そうかしら？",
            "zh": "是吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "340/TALK",
            "narrator": "アーヤ",
            "text": "私、心配し過ぎ？(´o｀；",
            "zh": "是我太担心了吗？(´o｀；",
            "narrator_zh": "绫水"
        },
        {
            "location": "341/TALK",
            "narrator": "アーヤ",
            "text": "でも",
            "zh": "不过",
            "narrator_zh": "绫水"
        },
        {
            "location": "342/TALK",
            "narrator": "アーヤ",
            "text": "ギャヴィはちょっとキツいとこあるけど",
            "zh": "加维是有点严厉",
            "narrator_zh": "绫水"
        },
        {
            "location": "343/TALK",
            "narrator": "アーヤ",
            "text": "凄く良い子なのよ？(>_<)",
            "zh": "但是是个很好的孩子哦？(>_<)",
            "narrator_zh": "绫水"
        },
        {
            "location": "346/SEL",
            "narrator": "",
            "text": "みんなも気付いてるよ",
            "zh": "大家也都察觉到了哦",
            "narrator_zh": ""
        },
        {
            "location": "347/ACT",
            "narrator": "",
            "text": "みんなも気付いてるよ",
            "zh": "大家也都察觉到了哦",
            "narrator_zh": ""
        },
        {
            "location": "349/TALK",
            "narrator": "アーヤ",
            "text": "だといいんだけど",
            "zh": "那样就好了",
            "narrator_zh": "绫水"
        },
        {
            "location": "350/TALK",
            "narrator": "アーヤ",
            "text": "じゃなきゃ",
            "zh": "不然的话",
            "narrator_zh": "绫水"
        },
        {
            "location": "351/TALK",
            "narrator": "アーヤ",
            "text": "悲しいわ(ノД`)",
            "zh": "我会难过的(ノД`)",
            "narrator_zh": "绫水"
        },
        {
            "location": "352/ACT",
            "narrator": "",
            "text": "おかん目線だね",
            "zh": "这是当妈的眼神呢",
            "narrator_zh": ""
        },
        {
            "location": "355/TALK",
            "narrator": "アーヤ",
            "text": "失礼な！(--#)",
            "zh": "真失礼！(--#)",
            "narrator_zh": "绫水"
        },
        {
            "location": "356/TALK",
            "narrator": "アーヤ",
            "text": "そんなに老けてないし！",
            "zh": "我又没那么老！",
            "narrator_zh": "绫水"
        },
        {
            "location": "359/SEL",
            "narrator": "",
            "text": "アーヤがあのくらいの年の頃、覚えてる？",
            "zh": "绫水那个年纪的事，你还记得吗？",
            "narrator_zh": ""
        },
        {
            "location": "360/ACT",
            "narrator": "",
            "text": "アーヤがあのくらいの年の頃、覚えてる？",
            "zh": "绫水那个年纪的事，你还记得吗？",
            "narrator_zh": ""
        },
        {
            "location": "363/TALK",
            "narrator": "アーヤ",
            "text": "覚えてはいるけど",
            "zh": "记得是记得",
            "narrator_zh": "绫水"
        },
        {
            "location": "365/TALK",
            "narrator": "アーヤ",
            "text": "それがどうかしたの？",
            "zh": "那个怎么了？",
            "narrator_zh": "绫水"
        },
        {
            "location": "368/SEL",
            "narrator": "",
            "text": "だったらあんまり心配しなくても大丈夫だってわかるでしょ",
            "zh": "那你就该明白不用那么担心了吧",
            "narrator_zh": ""
        },
        {
            "location": "369/ACT",
            "narrator": "",
            "text": "だったらあんまり心配しなくても大丈夫だってわかるでしょ",
            "zh": "那你就该明白不用那么担心了吧",
            "narrator_zh": ""
        },
        {
            "location": "371/TALK",
            "narrator": "アーヤ",
            "text": "どうかしら？",
            "zh": "会不会呢？",
            "narrator_zh": "绫水"
        },
        {
            "location": "372/TALK",
            "narrator": "アーヤ",
            "text": "私は結構友達いた方だと思うし",
            "zh": "我觉得我朋友还算不少",
            "narrator_zh": "绫水"
        },
        {
            "location": "373/TALK",
            "narrator": "アーヤ",
            "text": "お弁当はいつもみんなと食べてたから",
            "zh": "因为便当总是跟大家一起吃",
            "narrator_zh": "绫水"
        },
        {
            "location": "374/TALK",
            "narrator": "アーヤ",
            "text": "なんか",
            "zh": "总觉得",
            "narrator_zh": "绫水"
        },
        {
            "location": "376/ACT",
            "narrator": "",
            "text": "大丈夫、大丈夫",
            "zh": "没事，没事",
            "narrator_zh": ""
        },
        {
            "location": "377/TALK",
            "narrator": "アーヤ",
            "text": "そうなのかしら？",
            "zh": "是这样吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "378/TALK",
            "narrator": "アーヤ",
            "text": "そうだったらいいんだけど…(-.-;)",
            "zh": "要是那样就好了……(-.-;)",
            "narrator_zh": "绫水"
        },
        {
            "location": "380/SEL",
            "narrator": "",
            "text": "今だってなんだかんだ言ってみんなとそこそこうまくいってるでしょ",
            "zh": "现在说起来，跟大家都还算处得不错吧",
            "narrator_zh": ""
        },
        {
            "location": "381/ACT",
            "narrator": "",
            "text": "今だってなんだかんだ言ってみんなとそこそこうまくいってるでしょ",
            "zh": "现在说起来，跟大家都还算处得不错吧",
            "narrator_zh": ""
        },
        {
            "location": "383/TALK",
            "narrator": "アーヤ",
            "text": "まあ",
            "zh": "嗯",
            "narrator_zh": "绫水"
        },
        {
            "location": "384/TALK",
            "narrator": "アーヤ",
            "text": "トライナリーの中ではそうかもね",
            "zh": "在三重奏里也许是这样",
            "narrator_zh": "绫水"
        },
        {
            "location": "385/TALK",
            "narrator": "アーヤ",
            "text": "私が知らないだけで",
            "zh": "只是我不知道",
            "narrator_zh": "绫水"
        },
        {
            "location": "386/TALK",
            "narrator": "アーヤ",
            "text": "クラスでもそうだったら良いんだけど…(-ω-;)",
            "zh": "要是班上也这样就好了……(-ω-;)",
            "narrator_zh": "绫水"
        },
        {
            "location": "389/SEL",
            "narrator": "",
            "text": "アーヤは優しいね",
            "zh": "绫水真温柔",
            "narrator_zh": ""
        },
        {
            "location": "390/ACT",
            "narrator": "",
            "text": "アーヤは優しいね",
            "zh": "绫水真温柔",
            "narrator_zh": ""
        },
        {
            "location": "392/TALK",
            "narrator": "アーヤ",
            "text": "心配性なだけよ",
            "zh": "只是爱担心而已",
            "narrator_zh": "绫水"
        },
        {
            "location": "393/TALK",
            "narrator": "アーヤ",
            "text": "お節介なのかもしれないけど(・・。)ゞ",
            "zh": "也许是我多管闲事(^^;)",
            "narrator_zh": "绫水"
        },
        {
            "location": "394/TALK",
            "narrator": "アーヤ",
            "text": "優しいなんて言ってくれるのは",
            "zh": "会说我温柔的人",
            "narrator_zh": "绫水"
        },
        {
            "location": "395/TALK",
            "narrator": "アーヤ",
            "text": "$handle$さんくらいよ",
            "zh": "也就只有$handle$了",
            "narrator_zh": "绫水"
        },
        {
            "location": "408/TALK",
            "narrator": "アーヤ",
            "text": "…私も、大学戻らないと。",
            "zh": "……我也得回大学去了。",
            "narrator_zh": "绫水"
        }
    ]
