    "entry": [
        {
            "location": "2033/SCENARIO",
            "narrator": "",
            "text": "どうにかしてよ",
            "zh": "你想想办法啊",
            "narrator_zh": ""
        },
        {
            "location": "2058/TALK",
            "narrator": "神楽",
            "text": "女子ってなんでみんな一緒が好きなんだろ",
            "zh": "女孩子为什么都喜欢待在一起啊",
            "narrator_zh": "神乐"
        },
        {
            "location": "2059/TALK",
            "narrator": "神楽",
            "text": "そういうの小学校で卒業して欲しい",
            "zh": "那种事希望在小学就毕业",
            "narrator_zh": "神乐"
        },
        {
            "location": "2061/SEL",
            "narrator": "",
            "text": "手厳しいね",
            "zh": "你还挺严厉的",
            "narrator_zh": ""
        },
        {
            "location": "2062/SEL",
            "narrator": "",
            "text": "でもつばめは好きなんでしょ",
            "zh": "可你喜欢燕吧",
            "narrator_zh": ""
        },
        {
            "location": "2063/SEL",
            "narrator": "",
            "text": "神楽は自立してるから…",
            "zh": "因为神乐是独立的……",
            "narrator_zh": ""
        },
        {
            "location": "2064/ACT",
            "narrator": "",
            "text": "手厳しいね",
            "zh": "你还挺严厉的",
            "narrator_zh": ""
        },
        {
            "location": "2065/TALK",
            "narrator": "神楽",
            "text": "いや普通全然普通",
            "zh": "不，普通，完全普通",
            "narrator_zh": "神乐"
        },
        {
            "location": "2066/ACT",
            "narrator": "",
            "text": "でもつばめは好きなんでしょ",
            "zh": "可你喜欢燕吧",
            "narrator_zh": ""
        },
        {
            "location": "2067/TALK",
            "narrator": "神楽",
            "text": "それはどうでしょうね？",
            "zh": "这可不好说呢？",
            "narrator_zh": "神乐"
        },
        {
            "location": "2068/TALK",
            "narrator": "神楽",
            "text": "ていうかぴょんこはちょっと反省したのです",
            "zh": "话说，蹦子稍微反省了一下",
            "narrator_zh": "神乐"
        },
        {
            "location": "2069/TALK",
            "narrator": "神楽",
            "text": "現実逃避とはいえ破壊対象の子をナチュラルにかわいいとか言ってﾊｽﾊｽしちゃったりして",
            "zh": "虽说是逃避现实，却把破坏对象的孩子自然说成可爱，还呼呼心动了",
            "narrator_zh": "神乐"
        },
        {
            "location": "2071/SEL",
            "narrator": "",
            "text": "本心じゃなかったの！？",
            "zh": "不是真心的！？",
            "narrator_zh": ""
        },
        {
            "location": "2072/ACT",
            "narrator": "",
            "text": "本心じゃなかったの！？",
            "zh": "不是真心的！？",
            "narrator_zh": ""
        },
        {
            "location": "2074/TALK",
            "narrator": "神楽",
            "text": "んーと",
            "zh": "嗯——",
            "narrator_zh": "神乐"
        },
        {
            "location": "2075/TALK",
            "narrator": "神楽",
            "text": "そういうわけでもないけど",
            "zh": "也不是那个意思",
            "narrator_zh": "神乐"
        },
        {
            "location": "2076/TALK",
            "narrator": "神楽",
            "text": "そりゃね、ぴょんこの大好物ですよ、ああいう小動物系",
            "zh": "那个啊，是蹦子的最爱，那种小动物系",
            "narrator_zh": "神乐"
        },
        {
            "location": "2077/TALK",
            "narrator": "神楽",
            "text": "ていうかわかってて聞いてない？",
            "zh": "话说你是知道了才问的吧？",
            "narrator_zh": "神乐"
        },
        {
            "location": "2078/TALK",
            "narrator": "神楽",
            "text": "揺れる乙女心がわからない$handlek$はｲｯﾃﾖｼ",
            "zh": "不懂动摇的少女心的$handlek$，可以离开了",
            "narrator_zh": "神乐"
        },
        {
            "location": "2079/TALK",
            "narrator": "神楽",
            "text": "まあそれはもういいんだけど",
            "zh": "嘛，那个就到此为止",
            "narrator_zh": "神乐"
        },
        {
            "location": "2080/ACT",
            "narrator": "",
            "text": "神楽は自立してるから…",
            "zh": "因为神乐是独立的……",
            "narrator_zh": ""
        },
        {
            "location": "2082/TALK",
            "narrator": "神楽",
            "text": "そういうわけじゃないですー！",
            "zh": "不是那样的——！",
            "narrator_zh": "神乐"
        },
        {
            "location": "2083/TALK",
            "narrator": "神楽",
            "text": "ちょっと人より大人なだけなんですー！",
            "zh": "只是比别人稍微大人一点——！",
            "narrator_zh": "神乐"
        },
        {
            "location": "2085/TALK",
            "narrator": "神楽",
            "text": "なんだかんだでね？",
            "zh": "说来说去呢？",
            "narrator_zh": "神乐"
        },
        {
            "location": "2086/TALK",
            "narrator": "神楽",
            "text": "トライナリーはね？",
            "zh": "三重奏呢？",
            "narrator_zh": "神乐"
        },
        {
            "location": "2087/TALK",
            "narrator": "神楽",
            "text": "べったり仲良しって感じじゃないけどね？",
            "zh": "不是黏在一起那种好朋友的感觉呢？",
            "narrator_zh": "神乐"
        },
        {
            "location": "2088/TALK",
            "narrator": "神楽",
            "text": "それでもうーんちょっとさーって時はあるんですよこれが",
            "zh": "即便如此，还是会有「嗯有点那个啊」的时候",
            "narrator_zh": "神乐"
        },
        {
            "location": "2091/SEL",
            "narrator": "",
            "text": "あるだろうねえ…",
            "zh": "那是会有的吧……",
            "narrator_zh": ""
        },
        {
            "location": "2092/SEL",
            "narrator": "",
            "text": "$me$はいつでも神楽の味方",
            "zh": "$me$随时都是神乐的盟友",
            "narrator_zh": ""
        },
        {
            "location": "2093/SEL",
            "narrator": "",
            "text": "群れない俺ｶｺｲｲ宣言？",
            "zh": "不合群的我很帅宣言？",
            "narrator_zh": ""
        },
        {
            "location": "2094/ACT",
            "narrator": "",
            "text": "あるだろうねえ…",
            "zh": "那是会有的吧……",
            "narrator_zh": ""
        },
        {
            "location": "2095/TALK",
            "narrator": "神楽",
            "text": "ありますよそりゃー",
            "zh": "那当然有",
            "narrator_zh": "神乐"
        },
        {
            "location": "2096/ACT",
            "narrator": "",
            "text": "$me$はいつでも神楽の味方",
            "zh": "$me$随时都是神乐的盟友",
            "narrator_zh": ""
        },
        {
            "location": "2098/TALK",
            "narrator": "神楽",
            "text": "ははん？",
            "zh": "哈嗯？",
            "narrator_zh": "神乐"
        },
        {
            "location": "2099/TALK",
            "narrator": "神楽",
            "text": "よく言ったよく言った",
            "zh": "说得好，说得好",
            "narrator_zh": "神乐"
        },
        {
            "location": "2100/TALK",
            "narrator": "神楽",
            "text": "$handlek$の言質取ったどー！！！！",
            "zh": "拿到$handlek$的话柄了——！！！！",
            "narrator_zh": "神乐"
        },
        {
            "location": "2102/TALK",
            "narrator": "神楽",
            "text": "これでぴょんこと$handlek$は死が二人を分かつまで一緒だからね！",
            "zh": "这样蹦子和$handlek$就要到死亡把两人分开为止都在一起了！",
            "narrator_zh": "神乐"
        },
        {
            "location": "2103/ACT",
            "narrator": "",
            "text": "群れない俺ｶｺｲｲ宣言？",
            "zh": "不合群的我很帅宣言？",
            "narrator_zh": ""
        },
        {
            "location": "2104/TALK",
            "narrator": "神楽",
            "text": "そう思っとけ",
            "zh": "你就这么想着吧",
            "narrator_zh": "神乐"
        },
        {
            "location": "2106/TALK",
            "narrator": "神楽",
            "text": "ぴょんこは団体戦しかできないアイドルグループなんてお断りなんですー",
            "zh": "蹦子可拒绝那种只会团体战的偶像组合——",
            "narrator_zh": "神乐"
        },
        {
            "location": "2107/TALK",
            "narrator": "神楽",
            "text": "なんて気分だったわけ☆彡",
            "zh": "就是这种心情☆彡",
            "narrator_zh": "神乐"
        },
        {
            "location": "2108/TALK",
            "narrator": "神楽",
            "text": "でも話したらちょっと気が晴れたかもー",
            "zh": "不过说出来，心情好像痛快一点了——",
            "narrator_zh": "神乐"
        },
        {
            "location": "2109/TALK",
            "narrator": "神楽",
            "text": "ばいばーい",
            "zh": "拜拜——",
            "narrator_zh": "神乐"
        }
    ]
}
