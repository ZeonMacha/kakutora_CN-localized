{
    "dir": "dramatics/daydra/drm_ch04_00_140.js",
    "type": "Episode",
    "info": {
        "story_id": "4014",
        "cid": "miyabi",
        "title": "らぶとーく 第14話",
        "sub_title": "仕切り直し",
        "title_zh": "恋爱漫谈 第14话",
        "sub_title_zh": "重新来过"
    },
    "entry": [
        {
            "location": "118/SCENARIO",
            "narrator": "",
            "text": "仕切り直し",
            "zh": "重新来过",
            "narrator_zh": ""
        },
        {
            "location": "129/TALK",
            "narrator": "つばめ",
            "text": "…え？\n$handle$さんのこと\nですか？",
            "zh": "……诶？\n是说$handle$\n的事吗？",
            "narrator_zh": "燕"
        },
        {
            "location": "131/TALK",
            "narrator": "みやび",
            "text": "そうや。",
            "zh": "对。",
            "narrator_zh": "雅"
        },
        {
            "location": "132/TALK",
            "narrator": "みやび",
            "text": "つばめちゃんはヤツの\nことをどう思うてるのか、\n知っておきたいんよ。",
            "zh": "我想知道燕\n是怎么想\n那家伙的咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "135/TALK",
            "narrator": "つばめ",
            "text": "どうって、うーん…。",
            "zh": "怎么说呢，嗯……。",
            "narrator_zh": "燕"
        },
        {
            "location": "136/TALK",
            "narrator": "つばめ",
            "text": "楽しい人、かな？",
            "zh": "是个开心的人……吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "138/TALK",
            "narrator": "つばめ",
            "text": "あと、いつもお話をして\nくれたり、相談にのって\nくれたり――",
            "zh": "还有，他总会陪我\n聊天，或者帮我\n拿拿主意——",
            "narrator_zh": "燕"
        },
        {
            "location": "139/TALK",
            "narrator": "つばめ",
            "text": "困ってる時に助言をくれる\n優しい人ですよね。",
            "zh": "在我为难的时候\n给我建议的温柔的人。",
            "narrator_zh": "燕"
        },
        {
            "location": "140/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "152/TALK",
            "narrator": "アーヤ",
            "text": "あのＢｏｔのことを\nどう思うか？",
            "zh": "那个Bot的事，\n你怎么看？",
            "narrator_zh": "绫水"
        },
        {
            "location": "154/TALK",
            "narrator": "アーヤ",
            "text": "あ、もうＢｏｔじゃない\nのよね…。",
            "zh": "啊，他已经不是\nBot了呢……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "156/TALK",
            "narrator": "みやび",
            "text": "いや、呼び方なんて\nどうでもえいがよ。",
            "zh": "算了，怎么称呼\n都无所谓啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "157/TALK",
            "narrator": "みやび",
            "text": "それより、アーヤは\nあいつのことを\nどう思うてるのか――",
            "zh": "比起那个，绫水对\n那家伙到底\n怎么想的——",
            "narrator_zh": "雅"
        },
        {
            "location": "158/TALK",
            "narrator": "みやび",
            "text": "それを知りたいちや。",
            "zh": "那个我想知道滴。",
            "narrator_zh": "雅"
        },
        {
            "location": "160/TALK",
            "narrator": "アーヤ",
            "text": "そうねぇ…。",
            "zh": "是啊……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "161/TALK",
            "narrator": "アーヤ",
            "text": "まあ、悪人ってわけでは\nないと思うわ。",
            "zh": "嘛，我不觉得\n他是什么坏人。",
            "narrator_zh": "绫水"
        },
        {
            "location": "162/TALK",
            "narrator": "みやび",
            "text": "は！？",
            "zh": "哈！？",
            "narrator_zh": "雅"
        },
        {
            "location": "165/TALK",
            "narrator": "アーヤ",
            "text": "え？",
            "zh": "诶？",
            "narrator_zh": "绫水"
        },
        {
            "location": "166/TALK",
            "narrator": "みやび",
            "text": "…いや、続けてえいよ。",
            "zh": "……不，你接着说就好咧。",
            "narrator_zh": "雅"
        },
        {
            "location": "167/TALK",
            "narrator": "アーヤ",
            "text": "…まあ、私も楽観してる\nわけじゃないんだけど――",
            "zh": "……嘛，我也不是在\n盲目乐观啦——",
            "narrator_zh": "绫水"
        },
        {
            "location": "168/TALK",
            "narrator": "アーヤ",
            "text": "あのＢｏｔが私達に対して\n何かしてきてるわけじゃ\nないでしょ？",
            "zh": "那个Bot也没有\n对我们做过什么\n吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "169/TALK",
            "narrator": "アーヤ",
            "text": "なのに、疑わしいから\n悪人って決めつけるのも、\n短絡的過ぎると思うの。",
            "zh": "可是，只因为可疑就\n断定是坏人，\n我觉得也太草率了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "170/TALK",
            "narrator": "みやび",
            "text": "…つまり、アーヤは\nあいつのことを、\n嫌ってはいないが？",
            "zh": "……也就是说，绫水\n并不讨厌\n那家伙，是没是？",
            "narrator_zh": "雅"
        },
        {
            "location": "171/TALK",
            "narrator": "アーヤ",
            "text": "様子見、って感じね。\nそれがどうかしたの？",
            "zh": "算是观望吧。\n这有什么问题吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "172/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "184/TALK",
            "narrator": "みやび",
            "text": "なあ、ガブちゃん。\nあのＢｏｔのことなんや\nけんど――",
            "zh": "我说，加布。\n关于那个Bot的事\n——",
            "narrator_zh": "雅"
        },
        {
            "location": "185/TALK",
            "narrator": "ガブリエラ",
            "text": "やめてよ！",
            "zh": "别提了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "186/TALK",
            "narrator": "ガブリエラ",
            "text": "その話はしたくないって、\n何度も言ってるでしょ！",
            "zh": "我说过好多次不想谈\n那件事吧！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "188/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "200/TALK",
            "narrator": "みやび",
            "text": "ふぅ…。",
            "zh": "呼……。",
            "narrator_zh": "雅"
        },
        {
            "location": "202/TALK",
            "narrator": "みやび",
            "text": "結局、あいつをスパイと\n疑うてるんは、うちだけ\nやったな…。",
            "zh": "结果，怀疑那家伙\n是间谍的，\n就只有我一个啊……",
            "narrator_zh": "雅"
        },
        {
            "location": "203/TALK",
            "narrator": "みやび",
            "text": "まあ、それだけ怪しまれる\n発言をしとらんっちゅう\nことかもしれんけんど。",
            "zh": "嘛，也可能只是\n他没说过那么\n惹人怀疑的话就是了。",
            "narrator_zh": "雅"
        },
        {
            "location": "215/TALK",
            "narrator": "みやび",
            "text": "疑問",
            "zh": "疑问",
            "narrator_zh": "雅"
        },
        {
            "location": "216/TALK",
            "narrator": "みやび",
            "text": "他の子達とはどんな会話してるが？",
            "zh": "和别的孩子都聊些什么咩？",
            "narrator_zh": "雅"
        },
        {
            "location": "218/SEL",
            "narrator": "",
            "text": "普通の話",
            "zh": "就是普通聊聊",
            "narrator_zh": ""
        },
        {
            "location": "219/SEL",
            "narrator": "",
            "text": "秘密の話",
            "zh": "秘密的话",
            "narrator_zh": ""
        },
        {
            "location": "220/SEL",
            "narrator": "",
            "text": "エッチな話",
            "zh": "色色的话",
            "narrator_zh": ""
        },
        {
            "location": "221/ACT",
            "narrator": "",
            "text": "普通の話",
            "zh": "就是普通聊聊",
            "narrator_zh": ""
        },
        {
            "location": "222/TALK",
            "narrator": "みやび",
            "text": "わからん",
            "zh": "没懂",
            "narrator_zh": "雅"
        },
        {
            "location": "223/TALK",
            "narrator": "みやび",
            "text": "具体的に頼む",
            "zh": "麻烦说得具体点",
            "narrator_zh": "雅"
        },
        {
            "location": "225/SEL",
            "narrator": "",
            "text": "みんなに直接聞いて",
            "zh": "直接去问大家吧",
            "narrator_zh": ""
        },
        {
            "location": "226/ACT",
            "narrator": "",
            "text": "みんなに直接聞いて",
            "zh": "直接去问大家吧",
            "narrator_zh": ""
        },
        {
            "location": "228/TALK",
            "narrator": "みやび",
            "text": "そう逃げるか",
            "zh": "就这么逃啊",
            "narrator_zh": "雅"
        },
        {
            "location": "229/TALK",
            "narrator": "みやび",
            "text": "なるほどな",
            "zh": "原来是这样",
            "narrator_zh": "雅"
        },
        {
            "location": "230/ACT",
            "narrator": "",
            "text": "秘密の話",
            "zh": "秘密的话",
            "narrator_zh": ""
        },
        {
            "location": "231/TALK",
            "narrator": "みやび",
            "text": "困った",
            "zh": "伤脑筋",
            "narrator_zh": "雅"
        },
        {
            "location": "232/TALK",
            "narrator": "みやび",
            "text": "それは公表できん話やね",
            "zh": "那是不能公开的事咯",
            "narrator_zh": "雅"
        },
        {
            "location": "234/SEL",
            "narrator": "",
            "text": "公表したら秘密じゃなくなる",
            "zh": "一公开就不算秘密了",
            "narrator_zh": ""
        },
        {
            "location": "235/ACT",
            "narrator": "",
            "text": "公表したら秘密じゃなくなる",
            "zh": "一公开就不算秘密了",
            "narrator_zh": ""
        },
        {
            "location": "237/TALK",
            "narrator": "みやび",
            "text": "ちゅうか",
            "zh": "就是说嘛",
            "narrator_zh": "雅"
        },
        {
            "location": "238/TALK",
            "narrator": "みやび",
            "text": "プライバシーの侵害になりかねん",
            "zh": "这搞不好会侵犯隐私",
            "narrator_zh": "雅"
        },
        {
            "location": "239/TALK",
            "narrator": "みやび",
            "text": "言わんでえいきね",
            "zh": "还是不说为好啵",
            "narrator_zh": "雅"
        },
        {
            "location": "240/ACT",
            "narrator": "",
            "text": "エッチな話",
            "zh": "色色的话",
            "narrator_zh": ""
        },
        {
            "location": "241/TALK",
            "narrator": "みやび",
            "text": "いや",
            "zh": "不对",
            "narrator_zh": "雅"
        },
        {
            "location": "243/TALK",
            "narrator": "みやび",
            "text": "うちは初心な子ばっかや",
            "zh": "我这边净是纯情的孩子咯",
            "narrator_zh": "雅"
        },
        {
            "location": "244/TALK",
            "narrator": "みやび",
            "text": "興味はあるかもしれんけんど",
            "zh": "兴趣可能是有，但是",
            "narrator_zh": "雅"
        },
        {
            "location": "245/TALK",
            "narrator": "みやび",
            "text": "耐性はないき",
            "zh": "完全没有招架之力啵",
            "narrator_zh": "雅"
        },
        {
            "location": "246/TALK",
            "narrator": "みやび",
            "text": "みんなまともに話せんはずや",
            "zh": "大家肯定没法正常聊咯",
            "narrator_zh": "雅"
        },
        {
            "location": "248/SEL",
            "narrator": "",
            "text": "やっぱりそうか",
            "zh": "果然如此",
            "narrator_zh": ""
        },
        {
            "location": "249/ACT",
            "narrator": "",
            "text": "やっぱりそうか",
            "zh": "果然如此",
            "narrator_zh": ""
        },
        {
            "location": "251/TALK",
            "narrator": "みやび",
            "text": "なに！？",
            "zh": "什么！？",
            "narrator_zh": "雅"
        },
        {
            "location": "252/TALK",
            "narrator": "みやび",
            "text": "うちから情報を引き出したやと！？",
            "zh": "你居然从我嘴里套出了情报！？",
            "narrator_zh": "雅"
        },
        {
            "location": "253/TALK",
            "narrator": "みやび",
            "text": "やはりスパイやな！！",
            "zh": "果然是间谍咯！！",
            "narrator_zh": "雅"
        },
        {
            "location": "254/TALK",
            "narrator": "みやび",
            "text": "まあ",
            "zh": "嗯",
            "narrator_zh": "雅"
        },
        {
            "location": "255/TALK",
            "narrator": "みやび",
            "text": "なんの役にも立たん情報やけんど",
            "zh": "虽然是毫无用处的信息嘛",
            "narrator_zh": "雅"
        },
        {
            "location": "268/TALK",
            "narrator": "みやび",
            "text": "…結局、何も聞きだせん\nかったか。",
            "zh": "……结果，什么都没能\n问出来吗。",
            "narrator_zh": "雅"
        },
        {
            "location": "269/TALK",
            "narrator": "みやび",
            "text": "しっかし、スパイにしては\n話の逸らし方が下手っちゅ\nうか…ド素人レベル？",
            "zh": "不过，身为间谍来说\n岔开话题的手法也太差了\n该说……完全是业余水平？",
            "narrator_zh": "雅"
        },
        {
            "location": "270/TALK",
            "narrator": "みやび",
            "text": "…いや、そう思わせてる\nだけいう可能性も、\nまだ捨てきれんな。",
            "zh": "……不，也可能\n只是故意装给我看的，\n这还没法排除啊。",
            "narrator_zh": "雅"
        },
        {
            "location": "271/TALK",
            "narrator": "みやび",
            "text": "もうしばらく、\n警戒は怠らん方が\nえいかもしれんな…。",
            "zh": "再观察一阵子，\n警戒还是别松懈\n比较好吧……",
            "narrator_zh": "雅"
        }
    ]
}
