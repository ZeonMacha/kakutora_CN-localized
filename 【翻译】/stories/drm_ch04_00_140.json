{
 "dir": "dramatics/daydra/drm_ch04_00_140.js",
 "type": "Episode",
 "info": {
  "story_id": "4014",
  "cid": "miyabi",
  "title": "らぶとーく 第14話",
  "sub_title": "仕切り直し"
 },
 "entry": [
  {
   "location": "118/SCENARIO",
   "narrator": "",
   "text": "仕切り直し"
  },
  {
   "location": "129/TALK",
   "narrator": "つばめ",
   "text": "…え？\n$handle$さんのこと\nですか？"
  },
  {
   "location": "131/TALK",
   "narrator": "みやび",
   "text": "そうや。",
   "zh": "对。",
   "narrator_zh": "雅"
  },
  {
   "location": "132/TALK",
   "narrator": "みやび",
   "text": "つばめちゃんはヤツの\nことをどう思うてるのか、\n知っておきたいんよ。",
   "zh": "我想知道燕\n是怎么想\n那家伙的咯。",
   "narrator_zh": "雅"
  },
  {
   "location": "135/TALK",
   "narrator": "つばめ",
   "text": "どうって、うーん…。",
   "zh": "怎么说呢，嗯……。",
   "narrator_zh": "燕"
  },
  {
   "location": "136/TALK",
   "narrator": "つばめ",
   "text": "楽しい人、かな？"
  },
  {
   "location": "138/TALK",
   "narrator": "つばめ",
   "text": "あと、いつもお話をして\nくれたり、相談にのって\nくれたり――"
  },
  {
   "location": "139/TALK",
   "narrator": "つばめ",
   "text": "困ってる時に助言をくれる\n優しい人ですよね。"
  },
  {
   "location": "140/TALK",
   "narrator": "みやび",
   "text": "…………。"
  },
  {
   "location": "152/TALK",
   "narrator": "アーヤ",
   "text": "あのＢｏｔのことを\nどう思うか？"
  },
  {
   "location": "154/TALK",
   "narrator": "アーヤ",
   "text": "あ、もうＢｏｔじゃない\nのよね…。"
  },
  {
   "location": "156/TALK",
   "narrator": "みやび",
   "text": "いや、呼び方なんて\nどうでもえいがよ。"
  },
  {
   "location": "157/TALK",
   "narrator": "みやび",
   "text": "それより、アーヤは\nあいつのことを\nどう思うてるのか――",
   "zh": "比起那个，绫水对\n那家伙到底\n怎么想的——",
   "narrator_zh": "雅"
  },
  {
   "location": "158/TALK",
   "narrator": "みやび",
   "text": "それを知りたいちや。",
   "zh": "那个我想知道咯。",
   "narrator_zh": "雅"
  },
  {
   "location": "160/TALK",
   "narrator": "アーヤ",
   "text": "そうねぇ…。",
   "zh": "是啊……。",
   "narrator_zh": "绫水"
  },
  {
   "location": "161/TALK",
   "narrator": "アーヤ",
   "text": "まあ、悪人ってわけでは\nないと思うわ。"
  },
  {
   "location": "162/TALK",
   "narrator": "みやび",
   "text": "は！？",
   "zh": "哈！？",
   "narrator_zh": "雅"
  },
  {
   "location": "165/TALK",
   "narrator": "アーヤ",
   "text": "え？",
   "zh": "诶？",
   "narrator_zh": "绫水"
  },
  {
   "location": "166/TALK",
   "narrator": "みやび",
   "text": "…いや、続けてえいよ。"
  },
  {
   "location": "167/TALK",
   "narrator": "アーヤ",
   "text": "…まあ、私も楽観してる\nわけじゃないんだけど――",
   "zh": "……嘛，我也不是在\n盲目乐观啦——",
   "narrator_zh": "绫水"
  },
  {
   "location": "168/TALK",
   "narrator": "アーヤ",
   "text": "あのＢｏｔが私達に対して\n何かしてきてるわけじゃ\nないでしょ？"
  },
  {
   "location": "169/TALK",
   "narrator": "アーヤ",
   "text": "なのに、疑わしいから\n悪人って決めつけるのも、\n短絡的過ぎると思うの。",
   "zh": "可是，只因为可疑就\n断定是坏人，\n我觉得也太草率了。",
   "narrator_zh": "绫水"
  },
  {
   "location": "170/TALK",
   "narrator": "みやび",
   "text": "…つまり、アーヤは\nあいつのことを、\n嫌ってはいないが？"
  },
  {
   "location": "171/TALK",
   "narrator": "アーヤ",
   "text": "様子見、って感じね。\nそれがどうかしたの？"
  },
  {
   "location": "172/TALK",
   "narrator": "みやび",
   "text": "…………。"
  },
  {
   "location": "184/TALK",
   "narrator": "みやび",
   "text": "なあ、ガブちゃん。\nあのＢｏｔのことなんや\nけんど――",
   "zh": "我说，加布。\n那个Bot的事\n咯——",
   "narrator_zh": "雅"
  },
  {
   "location": "185/TALK",
   "narrator": "ガブリエラ",
   "text": "やめてよ！"
  },
  {
   "location": "186/TALK",
   "narrator": "ガブリエラ",
   "text": "その話はしたくないって、\n何度も言ってるでしょ！",
   "zh": "我说过好多次不想谈\n那件事吧！",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "188/TALK",
   "narrator": "みやび",
   "text": "…………。"
  },
  {
   "location": "200/TALK",
   "narrator": "みやび",
   "text": "ふぅ…。",
   "zh": "呼……。",
   "narrator_zh": "雅"
  },
  {
   "location": "202/TALK",
   "narrator": "みやび",
   "text": "結局、あいつをスパイと\n疑うてるんは、うちだけ\nやったな…。"
  },
  {
   "location": "203/TALK",
   "narrator": "みやび",
   "text": "まあ、それだけ怪しまれる\n発言をしとらんっちゅう\nことかもしれんけんど。"
  },
  {
   "location": "215/TALK",
   "narrator": "みやび",
   "text": "疑問"
  },
  {
   "location": "216/TALK",
   "narrator": "みやび",
   "text": "他の子達とはどんな会話してるが？"
  },
  {
   "location": "218/SEL",
   "narrator": "",
   "text": "普通の話",
   "zh": "就是普通聊聊",
   "narrator_zh": ""
  },
  {
   "location": "219/SEL",
   "narrator": "",
   "text": "秘密の話",
   "zh": "秘密的话",
   "narrator_zh": ""
  },
  {
   "location": "220/SEL",
   "narrator": "",
   "text": "エッチな話",
   "zh": "色色的话",
   "narrator_zh": ""
  },
  {
   "location": "221/ACT",
   "narrator": "",
   "text": "普通の話",
   "zh": "就是普通聊聊",
   "narrator_zh": ""
  },
  {
   "location": "222/TALK",
   "narrator": "みやび",
   "text": "わからん",
   "zh": "不懂咯",
   "narrator_zh": "雅"
  },
  {
   "location": "223/TALK",
   "narrator": "みやび",
   "text": "具体的に頼む"
  },
  {
   "location": "225/SEL",
   "narrator": "",
   "text": "みんなに直接聞いて",
   "zh": "直接去问大家吧",
   "narrator_zh": ""
  },
  {
   "location": "226/ACT",
   "narrator": "",
   "text": "みんなに直接聞いて",
   "zh": "直接去问大家吧",
   "narrator_zh": ""
  },
  {
   "location": "228/TALK",
   "narrator": "みやび",
   "text": "そう逃げるか",
   "zh": "就这么逃啊",
   "narrator_zh": "雅"
  },
  {
   "location": "229/TALK",
   "narrator": "みやび",
   "text": "なるほどな",
   "zh": "原来是这样",
   "narrator_zh": "雅"
  },
  {
   "location": "230/ACT",
   "narrator": "",
   "text": "秘密の話",
   "zh": "秘密的话",
   "narrator_zh": ""
  },
  {
   "location": "231/TALK",
   "narrator": "みやび",
   "text": "困った"
  },
  {
   "location": "232/TALK",
   "narrator": "みやび",
   "text": "それは公表できん話やね",
   "zh": "那是不能公开的事呢",
   "narrator_zh": "雅"
  },
  {
   "location": "234/SEL",
   "narrator": "",
   "text": "公表したら秘密じゃなくなる",
   "zh": "一公开就不算秘密了",
   "narrator_zh": ""
  },
  {
   "location": "235/ACT",
   "narrator": "",
   "text": "公表したら秘密じゃなくなる",
   "zh": "一公开就不算秘密了",
   "narrator_zh": ""
  },
  {
   "location": "237/TALK",
   "narrator": "みやび",
   "text": "ちゅうか",
   "zh": "就是说嘛",
   "narrator_zh": "雅"
  },
  {
   "location": "238/TALK",
   "narrator": "みやび",
   "text": "プライバシーの侵害になりかねん"
  },
  {
   "location": "239/TALK",
   "narrator": "みやび",
   "text": "言わんでえいきね"
  },
  {
   "location": "240/ACT",
   "narrator": "",
   "text": "エッチな話",
   "zh": "色色的话",
   "narrator_zh": ""
  },
  {
   "location": "241/TALK",
   "narrator": "みやび",
   "text": "いや",
   "zh": "不对",
   "narrator_zh": "雅"
  },
  {
   "location": "243/TALK",
   "narrator": "みやび",
   "text": "うちは初心な子ばっかや"
  },
  {
   "location": "244/TALK",
   "narrator": "みやび",
   "text": "興味はあるかもしれんけんど"
  },
  {
   "location": "245/TALK",
   "narrator": "みやび",
   "text": "耐性はないき"
  },
  {
   "location": "246/TALK",
   "narrator": "みやび",
   "text": "みんなまともに話せんはずや"
  },
  {
   "location": "248/SEL",
   "narrator": "",
   "text": "やっぱりそうか",
   "zh": "果然如此",
   "narrator_zh": ""
  },
  {
   "location": "249/ACT",
   "narrator": "",
   "text": "やっぱりそうか",
   "zh": "果然如此",
   "narrator_zh": ""
  },
  {
   "location": "251/TALK",
   "narrator": "みやび",
   "text": "なに！？",
   "zh": "什么！？",
   "narrator_zh": "雅"
  },
  {
   "location": "252/TALK",
   "narrator": "みやび",
   "text": "うちから情報を引き出したやと！？"
  },
  {
   "location": "253/TALK",
   "narrator": "みやび",
   "text": "やはりスパイやな！！"
  },
  {
   "location": "254/TALK",
   "narrator": "みやび",
   "text": "まあ",
   "zh": "嗯",
   "narrator_zh": "雅"
  },
  {
   "location": "255/TALK",
   "narrator": "みやび",
   "text": "なんの役にも立たん情報やけんど",
   "zh": "虽然是毫无用处的信息嘛",
   "narrator_zh": "雅"
  },
  {
   "location": "268/TALK",
   "narrator": "みやび",
   "text": "…結局、何も聞きだせん\nかったか。",
   "zh": "……结果，什么都没能\n问出来吗。",
   "narrator_zh": "雅"
  },
  {
   "location": "269/TALK",
   "narrator": "みやび",
   "text": "しっかし、スパイにしては\n話の逸らし方が下手っちゅ\nうか…ド素人レベル？"
  },
  {
   "location": "270/TALK",
   "narrator": "みやび",
   "text": "…いや、そう思わせてる\nだけいう可能性も、\nまだ捨てきれんな。"
  },
  {
   "location": "271/TALK",
   "narrator": "みやび",
   "text": "もうしばらく、\n警戒は怠らん方が\nえいかもしれんな…。"
  }
 ]
}
