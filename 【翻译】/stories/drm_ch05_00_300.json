  "title": "らぶとーく 第30話",
  "sub_title": "通信不能"
 },
 "entry": [
  {
   "location": "192/SCENARIO",
   "narrator": "",
   "text": "通信不能"
  },
  {
   "location": "202/TALK",
   "narrator": "神楽",
   "text": "今って何の授業の\n時間だっけ……。"
  },
  {
   "location": "203/TALK",
   "narrator": "神楽",
   "text": "……まあ\nどうでもいいけど…。"
  },
  {
   "location": "204/SEL",
   "narrator": "",
   "text": "サボり？",
   "zh": "偷懒？",
   "narrator_zh": ""
  },
  {
   "location": "205/ACT",
   "narrator": "",
   "text": "サボり？",
   "zh": "偷懒？",
   "narrator_zh": ""
  },
  {
   "location": "222/TALK",
   "narrator": "神楽",
   "text": "そうですね",
   "zh": "是啊",
   "narrator_zh": "神乐"
  },
  {
   "location": "223/TALK",
   "narrator": "神楽",
   "text": "もしかして巫女ですか？いいですよ巫女しても"
  },
  {
   "location": "225/SEL",
   "narrator": "",
   "text": "巫女！？！？"
  },
  {
   "location": "226/SEL",
   "narrator": "",
   "text": "学校に連絡しろってこと？",
   "zh": "是要我联系学校？",
   "narrator_zh": ""
  },
  {
   "location": "227/SEL",
   "narrator": "",
   "text": "補導されてみたいの？",
   "zh": "你想被警察叫去辅导吗？",
   "narrator_zh": ""
  },
  {
   "location": "228/ACT",
   "narrator": "",
   "text": "巫女！？！？"
  },
  {
   "location": "229/TALK",
   "narrator": "神楽",
   "text": "あーえっと"
  },
  {
   "location": "231/TALK",
   "narrator": "神楽",
   "text": "密告のことです。まだ使われてないんですね。"
  },
  {
   "location": "232/ACT",
   "narrator": "",
   "text": "学校に連絡しろってこと？",
   "zh": "是要我联系学校？",
   "narrator_zh": ""
  },
  {
   "location": "233/TALK",
   "narrator": "神楽",
   "text": "そうしてください",
   "zh": "请那样做",
   "narrator_zh": "神乐"
  },
  {
   "location": "234/TALK",
   "narrator": "神楽",
   "text": "卯月は体調不良で欠席です"
  },
  {
   "location": "235/ACT",
   "narrator": "",
   "text": "補導されてみたいの？",
   "zh": "你想被警察叫去辅导吗？",
   "narrator_zh": ""
  },
  {
   "location": "236/TALK",
   "narrator": "神楽",
   "text": "そういうのもちょっといいですね",
   "zh": "那种也还不错呢",
   "narrator_zh": "神乐"
  },
  {
   "location": "237/TALK",
   "narrator": "神楽",
   "text": "イキリって言うんでしたっけ？？？"
  },
  {
   "location": "249/TALK",
   "narrator": "神楽",
   "text": "映画でも観ようかな…。"
  },
  {
   "location": "250/TALK",
   "narrator": "神楽",
   "text": "でも学生証見せたら\n学校は？　とか\n聞かれるかも…。",
   "zh": "不过要是出示学生证，\n也许会被问\n学校之类……。",
   "narrator_zh": "神乐"
  },
  {
   "location": "253/TALK",
   "narrator": "神楽",
   "text": "あとは美術館とか\nプラネタリウムとか…。"
  },
  {
   "location": "255/TALK",
   "narrator": "神楽",
   "text": "…大人料金で\n入ればいいか…。",
   "zh": "……按成人票\n进去就行了吧……。",
   "narrator_zh": "神乐"
  },
  {
   "location": "256/SEL",
   "narrator": "",
   "text": "デートしようよ",
   "zh": "来约会吧",
   "narrator_zh": ""
  },
  {
   "location": "257/ACT",
   "narrator": "",
   "text": "デートしようよ",
   "zh": "来约会吧",
   "narrator_zh": ""
  },
  {
   "location": "274/TALK",
   "narrator": "神楽",
   "text": "ある意味デートですよ"
  },
  {
   "location": "275/TALK",
   "narrator": "神楽",
   "text": "今の状態って"
  },
  {
   "location": "277/SEL",
   "narrator": "",
   "text": "ただ歩くんじゃなくてさー",
   "zh": "不是单纯走路啦——",
   "narrator_zh": ""
  },
  {
   "location": "278/SEL",
   "narrator": "",
   "text": "デート！　デート！",
   "zh": "约会！　约会！",
   "narrator_zh": ""
  },
  {
   "location": "279/SEL",
   "narrator": "",
   "text": "もっとキュンってする会話がしたい",
   "zh": "想聊点更让人心动的话",
   "narrator_zh": ""
  },
  {
   "location": "280/ACT",
   "narrator": "",
   "text": "ただ歩くんじゃなくてさー",
   "zh": "不是单纯走路啦——",
   "narrator_zh": ""
  },
  {
   "location": "281/TALK",
   "narrator": "神楽",
   "text": "じゃあ走りましょうか"
  },
  {
   "location": "283/TALK",
   "narrator": "神楽",
   "text": "それともコンビニ前にしゃがみますか",
   "zh": "还是说要在便利店门口蹲着",
   "narrator_zh": "神乐"
  },
  {
   "location": "284/ACT",
   "narrator": "",
   "text": "デート！　デート！",
   "zh": "约会！　约会！",
   "narrator_zh": ""
  },
  {
   "location": "285/TALK",
   "narrator": "神楽",
   "text": "チートみたいな響きですね"
  },
  {
   "location": "286/TALK",
   "narrator": "神楽",
   "text": "チート！チート！"
  },
  {
   "location": "287/ACT",
   "narrator": "",
   "text": "もっとキュンってする会話がしたい",
   "zh": "想聊点更让人心动的话",
   "narrator_zh": ""
  },
  {
   "location": "289/TALK",
   "narrator": "神楽",
   "text": "いかがでしょうか？？？"
  },
  {
   "location": "292/SEL",
   "narrator": "",
   "text": "疲れちゃったんだよね…",
   "zh": "你是不是累了……",
   "narrator_zh": ""
  },
  {
   "location": "293/SEL",
   "narrator": "",
   "text": "神楽、今大変だもんね",
   "zh": "神乐现在也很辛苦呢",
   "narrator_zh": ""
  },
  {
   "location": "294/SEL",
   "narrator": "",
   "text": "とことん付き合うよ",
   "zh": "我陪你到底",
   "narrator_zh": ""
  },
  {
   "location": "295/ACT",
   "narrator": "",
   "text": "疲れちゃったんだよね…",
   "zh": "你是不是累了……",
   "narrator_zh": ""
  },
  {
   "location": "296/TALK",
   "narrator": "神楽",
   "text": "そうですね",
   "zh": "是啊",
   "narrator_zh": "神乐"
  },
  {
   "location": "297/TALK",
   "narrator": "神楽",
   "text": "そうかもしれません",
   "zh": "也许是这样",
   "narrator_zh": "神乐"
  },
  {
   "location": "298/ACT",
   "narrator": "",
   "text": "神楽、今大変だもんね",
   "zh": "神乐现在也很辛苦呢",
   "narrator_zh": ""
  },
  {
   "location": "299/TALK",
   "narrator": "神楽",
   "text": "今だけじゃなくて"
  },
  {
   "location": "300/TALK",
   "narrator": "神楽",
   "text": "ずっと大変なんですよ"
  },
  {
   "location": "301/ACT",
   "narrator": "",
   "text": "とことん付き合うよ",
   "zh": "我陪你到底",
   "narrator_zh": ""
  },
  {
   "location": "302/TALK",
   "narrator": "神楽",
   "text": "本当にあなたは"
  },
  {
   "location": "303/TALK",
   "narrator": "神楽",
   "text": "暇な人ですね"
  },
  {
   "location": "315/TALK",
   "narrator": "神楽",
   "text": "あ……！\nあの看板……！"
  },
  {
   "location": "316/TALK",
   "narrator": "神楽",
   "text": "イメージ以上の\n仕上がり。"
  },
  {
   "location": "317/TALK",
   "narrator": "神楽",
   "text": "やっぱり\nあのカメラマン\nセンスある……。"
  },
  {
   "location": "318/TALK",
   "narrator": "神楽",
   "text": "……。"
  },
  {
   "location": "330/TALK",
   "narrator": "神楽",
   "text": "ぴょんこは午後からボーカルレッスンがあるから"
  },
  {
   "location": "331/TALK",
   "narrator": "神楽",
   "text": "このまま直行します",
   "zh": "就这样直接过去",
   "narrator_zh": "神乐"
  },
  {
   "location": "333/SEL",
   "narrator": "",
   "text": "そっちはちゃんと行くんだ"
  },
  {
   "location": "334/SEL",
   "narrator": "",
   "text": "偉い偉い",
   "zh": "真乖真乖",
   "narrator_zh": ""
  },
  {
   "location": "335/SEL",
   "narrator": "",
   "text": "そっちもサボっていいんだよ"
  },
  {
   "location": "336/ACT",
   "narrator": "",
   "text": "そっちはちゃんと行くんだ"
  },
  {
   "location": "337/TALK",
   "narrator": "神楽",
   "text": "FreyMENOWの代わりはいないですから"
  },
  {
   "location": "338/ACT",
   "narrator": "",
   "text": "偉い偉い",
   "zh": "真乖真乖",
   "narrator_zh": ""
  },
  {
   "location": "339/TALK",
   "narrator": "神楽",
   "text": "偉いわけじゃなくて"
  },
  {
   "location": "340/TALK",
   "narrator": "神楽",
   "text": "当たり前のことです"
  },
  {
   "location": "343/ACT",
   "narrator": "",
   "text": "そっちもサボっていいんだよ"
  },
  {
   "location": "344/TALK",
   "narrator": "神楽",
   "text": "は？何イッｔやってんの？"
  },
  {
   "location": "345/TALK",
   "narrator": "神楽",
   "text": "サボるわけないし"
  },
  {
   "location": "356/TALK",
   "narrator": "神楽",
   "text": "……。"
  },
  {
   "location": "357/TALK",
   "narrator": "神楽",
   "text": "仕方ないか、\nあっちも仕事なんだろうし。"
  },
  {
   "location": "358/TALK",
   "narrator": "神楽",
   "text": "……。"
  },
  {
   "location": "360/TALK",
   "narrator": "神楽",
   "text": "あーやだやだ。\n期待しちゃって、\n私バカみたい。"
  },
  {
   "location": "373/TALK",
   "narrator": "神楽",
   "text": "…私の名前は\n卯月神楽。",
   "zh": "……我的名字是\n卯月神乐。",
   "narrator_zh": "神乐"
  },
  {
   "location": "374/TALK",
   "narrator": "神楽",
   "text": "そして活動名は\nFreyMENOW。",
   "zh": "然后活动名是\nFreyMENOW。",
   "narrator_zh": "神乐"
  },
  {
   "location": "375/TALK",
   "narrator": "神楽",
   "text": "それはどの世界でも\n変わらない。",
   "zh": "那在任何世界都\n不会变。",
   "narrator_zh": "神乐"
  },
  {
   "location": "376/TALK",
   "narrator": "神楽",
   "text": "変えたくない……。"
  },
  {
   "location": "201/DIALOG",
   "narrator": "Dialog_EventData",
