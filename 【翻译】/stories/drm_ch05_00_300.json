    "type": "Episode",
    "info": {
        "story_id": "5030",
        "cid": "kagura",
        "title": "らぶとーく 第30話",
        "sub_title": "通信不能",
        "title_zh": "恋爱漫谈 第30话",
        "sub_title_zh": "无法通信"
    },
    "entry": [
        {
            "location": "192/SCENARIO",
            "narrator": "",
            "text": "通信不能",
            "zh": "无法通信",
            "narrator_zh": ""
        },
        {
            "location": "202/TALK",
            "narrator": "神楽",
            "text": "今って何の授業の\n時間だっけ……。",
            "zh": "现在是什么课的\n时间来着……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "203/TALK",
            "narrator": "神楽",
            "text": "……まあ\nどうでもいいけど…。",
            "zh": "……算了，\n怎样都无所谓……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "204/SEL",
            "narrator": "",
            "text": "サボり？",
            "zh": "偷懒？",
            "narrator_zh": ""
        },
        {
            "location": "205/ACT",
            "narrator": "",
            "text": "サボり？",
            "zh": "偷懒？",
            "narrator_zh": ""
        },
        {
            "location": "222/TALK",
            "narrator": "神楽",
            "text": "そうですね",
            "zh": "是啊",
            "narrator_zh": "神乐"
        },
        {
            "location": "223/TALK",
            "narrator": "神楽",
            "text": "もしかして巫女ですか？いいですよ巫女しても",
            "zh": "难道是“巫女”吗？当巫女也可以哦",
            "narrator_zh": "神乐"
        },
        {
            "location": "225/SEL",
            "narrator": "",
            "text": "巫女！？！？",
            "zh": "巫女！？！？",
            "narrator_zh": ""
        },
        {
            "location": "226/SEL",
            "narrator": "",
            "text": "学校に連絡しろってこと？",
            "zh": "是要我联系学校？",
            "narrator_zh": ""
        },
        {
            "location": "227/SEL",
            "narrator": "",
            "text": "補導されてみたいの？",
            "zh": "你想被警察叫去辅导吗？",
            "narrator_zh": ""
        },
        {
            "location": "228/ACT",
            "narrator": "",
            "text": "巫女！？！？",
            "zh": "巫女！？！？",
            "narrator_zh": ""
        },
        {
            "location": "229/TALK",
            "narrator": "神楽",
            "text": "あーえっと",
            "zh": "啊—那个",
            "narrator_zh": "神乐"
        },
        {
            "location": "231/TALK",
            "narrator": "神楽",
            "text": "密告のことです。まだ使われてないんですね。",
            "zh": "我说的是“密告”啦。原来现在还没用上这词呢。",
            "narrator_zh": "神乐"
        },
        {
            "location": "232/ACT",
            "narrator": "",
            "text": "学校に連絡しろってこと？",
            "zh": "是要我联系学校？",
            "narrator_zh": ""
        },
        {
            "location": "233/TALK",
            "narrator": "神楽",
            "text": "そうしてください",
            "zh": "请那样做",
            "narrator_zh": "神乐"
        },
        {
            "location": "234/TALK",
            "narrator": "神楽",
            "text": "卯月は体調不良で欠席です",
            "zh": "卯月身体不适，今天请假",
            "narrator_zh": "神乐"
        },
        {
            "location": "235/ACT",
            "narrator": "",
            "text": "補導されてみたいの？",
            "zh": "你想被警察叫去辅导吗？",
            "narrator_zh": ""
        },
        {
            "location": "236/TALK",
            "narrator": "神楽",
            "text": "そういうのもちょっといいですね",
            "zh": "那种也还不错呢",
            "narrator_zh": "神乐"
        },
        {
            "location": "237/TALK",
            "narrator": "神楽",
            "text": "イキリって言うんでしたっけ？？？",
            "zh": "这种好像叫“耍狠”来着？？？",
            "narrator_zh": "神乐"
        },
        {
            "location": "249/TALK",
            "narrator": "神楽",
            "text": "映画でも観ようかな…。",
            "zh": "要不去看场电影什么的吧……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "250/TALK",
            "narrator": "神楽",
            "text": "でも学生証見せたら\n学校は？　とか\n聞かれるかも…。",
            "zh": "不过要是出示学生证，\n也许会被问\n学校之类……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "253/TALK",
            "narrator": "神楽",
            "text": "あとは美術館とか\nプラネタリウムとか…。",
            "zh": "或者去美术馆呀、\n天文馆之类的……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "255/TALK",
            "narrator": "神楽",
            "text": "…大人料金で\n入ればいいか…。",
            "zh": "……按成人票\n进去就行了吧……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "256/SEL",
            "narrator": "",
            "text": "デートしようよ",
            "zh": "来约会吧",
            "narrator_zh": ""
        },
        {
            "location": "257/ACT",
            "narrator": "",
            "text": "デートしようよ",
            "zh": "来约会吧",
            "narrator_zh": ""
        },
        {
            "location": "274/TALK",
            "narrator": "神楽",
            "text": "ある意味デートですよ",
            "zh": "某种意义上也算约会了呢",
            "narrator_zh": "神乐"
        },
        {
            "location": "275/TALK",
            "narrator": "神楽",
            "text": "今の状態って",
            "zh": "现在这状态",
            "narrator_zh": "神乐"
        },
        {
            "location": "277/SEL",
            "narrator": "",
            "text": "ただ歩くんじゃなくてさー",
            "zh": "不是单纯走路啦——",
            "narrator_zh": ""
        },
        {
            "location": "278/SEL",
            "narrator": "",
            "text": "デート！　デート！",
            "zh": "约会！　约会！",
            "narrator_zh": ""
        },
        {
            "location": "279/SEL",
            "narrator": "",
            "text": "もっとキュンってする会話がしたい",
            "zh": "想聊点更让人心动的话",
            "narrator_zh": ""
        },
        {
            "location": "280/ACT",
            "narrator": "",
            "text": "ただ歩くんじゃなくてさー",
            "zh": "不是单纯走路啦——",
            "narrator_zh": ""
        },
        {
            "location": "281/TALK",
            "narrator": "神楽",
            "text": "じゃあ走りましょうか",
            "zh": "那我们来跑着走吧",
            "narrator_zh": "神乐"
        },
        {
            "location": "283/TALK",
            "narrator": "神楽",
            "text": "それともコンビニ前にしゃがみますか",
            "zh": "还是说要在便利店门口蹲着",
            "narrator_zh": "神乐"
        },
        {
            "location": "284/ACT",
            "narrator": "",
            "text": "デート！　デート！",
            "zh": "约会！　约会！",
            "narrator_zh": ""
        },
        {
            "location": "285/TALK",
            "narrator": "神楽",
            "text": "チートみたいな響きですね",
            "zh": "听起来简直像开挂一样呢",
            "narrator_zh": "神乐"
        },
        {
            "location": "286/TALK",
            "narrator": "神楽",
            "text": "チート！チート！",
            "zh": "开挂！开挂！",
            "narrator_zh": "神乐"
        },
        {
            "location": "287/ACT",
            "narrator": "",
            "text": "もっとキュンってする会話がしたい",
            "zh": "想聊点更让人心动的话",
            "narrator_zh": ""
        },
        {
            "location": "289/TALK",
            "narrator": "神楽",
            "text": "いかがでしょうか？？？",
            "zh": "觉得怎么样？？？",
            "narrator_zh": "神乐"
        },
        {
            "location": "292/SEL",
            "narrator": "",
            "text": "疲れちゃったんだよね…",
            "zh": "你是不是累了……",
            "narrator_zh": ""
        },
        {
            "location": "293/SEL",
            "narrator": "",
            "text": "神楽、今大変だもんね",
            "zh": "神乐现在也很辛苦呢",
            "narrator_zh": ""
        },
        {
            "location": "294/SEL",
            "narrator": "",
            "text": "とことん付き合うよ",
            "zh": "我陪你到底",
            "narrator_zh": ""
        },
        {
            "location": "295/ACT",
            "narrator": "",
            "text": "疲れちゃったんだよね…",
            "zh": "你是不是累了……",
            "narrator_zh": ""
        },
        {
            "location": "296/TALK",
            "narrator": "神楽",
            "text": "そうですね",
            "zh": "是啊",
            "narrator_zh": "神乐"
        },
        {
            "location": "297/TALK",
            "narrator": "神楽",
            "text": "そうかもしれません",
            "zh": "也许是这样",
            "narrator_zh": "神乐"
        },
        {
            "location": "298/ACT",
            "narrator": "",
            "text": "神楽、今大変だもんね",
            "zh": "神乐现在也很辛苦呢",
            "narrator_zh": ""
        },
        {
            "location": "299/TALK",
            "narrator": "神楽",
            "text": "今だけじゃなくて",
            "zh": "不只是现在",
            "narrator_zh": "神乐"
        },
        {
            "location": "300/TALK",
            "narrator": "神楽",
            "text": "ずっと大変なんですよ",
            "zh": "我一直都很辛苦呢",
            "narrator_zh": "神乐"
        },
        {
            "location": "301/ACT",
            "narrator": "",
            "text": "とことん付き合うよ",
            "zh": "我陪你到底",
            "narrator_zh": ""
        },
        {
            "location": "302/TALK",
            "narrator": "神楽",
            "text": "本当にあなたは",
            "zh": "你这个人真是",
            "narrator_zh": "神乐"
        },
        {
            "location": "303/TALK",
            "narrator": "神楽",
            "text": "暇な人ですね",
            "zh": "真是个闲人呢",
            "narrator_zh": "神乐"
        },
        {
            "location": "315/TALK",
            "narrator": "神楽",
            "text": "あ……！\nあの看板……！",
            "zh": "啊……！\n那个广告牌……！",
            "narrator_zh": "神乐"
        },
        {
            "location": "316/TALK",
            "narrator": "神楽",
            "text": "イメージ以上の\n仕上がり。",
            "zh": "成品效果\n比想象中还要好。",
            "narrator_zh": "神乐"
        },
        {
            "location": "317/TALK",
            "narrator": "神楽",
            "text": "やっぱり\nあのカメラマン\nセンスある……。",
            "zh": "那位摄影师\n果然还是\n很有品位……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "318/TALK",
            "narrator": "神楽",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "330/TALK",
            "narrator": "神楽",
            "text": "ぴょんこは午後からボーカルレッスンがあるから",
            "zh": "蹦子下午还有声乐课",
            "narrator_zh": "神乐"
        },
        {
            "location": "331/TALK",
            "narrator": "神楽",
            "text": "このまま直行します",
            "zh": "就这样直接过去",
            "narrator_zh": "神乐"
        },
        {
            "location": "333/SEL",
            "narrator": "",
            "text": "そっちはちゃんと行くんだ",
            "zh": "那个倒是会乖乖去啊",
            "narrator_zh": ""
        },
        {
            "location": "334/SEL",
            "narrator": "",
            "text": "偉い偉い",
            "zh": "真乖真乖",
            "narrator_zh": ""
        },
        {
            "location": "335/SEL",
            "narrator": "",
            "text": "そっちもサボっていいんだよ",
            "zh": "那个也可以翘掉哦",
            "narrator_zh": ""
        },
        {
            "location": "336/ACT",
            "narrator": "",
            "text": "そっちはちゃんと行くんだ",
            "zh": "那个倒是会乖乖去啊",
            "narrator_zh": ""
        },
        {
            "location": "337/TALK",
            "narrator": "神楽",
            "text": "FreyMENOWの代わりはいないですから",
            "zh": "毕竟FreyMENOW可是无人可替的呀",
            "narrator_zh": "神乐"
        },
        {
            "location": "338/ACT",
            "narrator": "",
            "text": "偉い偉い",
            "zh": "真乖真乖",
            "narrator_zh": ""
        },
        {
            "location": "339/TALK",
            "narrator": "神楽",
            "text": "偉いわけじゃなくて",
            "zh": "才不是什么乖不乖的",
            "narrator_zh": "神乐"
        },
        {
            "location": "340/TALK",
            "narrator": "神楽",
            "text": "当たり前のことです",
            "zh": "那是理所当然的事",
            "narrator_zh": "神乐"
        },
        {
            "location": "343/ACT",
            "narrator": "",
            "text": "そっちもサボっていいんだよ",
            "zh": "那个也可以翘掉哦",
            "narrator_zh": ""
        },
        {
            "location": "344/TALK",
            "narrator": "神楽",
            "text": "は？何イッｔやってんの？",
            "zh": "哈？你在说什m啊？",
            "narrator_zh": "神乐"
        },
        {
            "location": "345/TALK",
            "narrator": "神楽",
            "text": "サボるわけないし",
            "zh": "怎么可能翘掉嘛",
            "narrator_zh": "神乐"
        },
        {
            "location": "356/TALK",
            "narrator": "神楽",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "357/TALK",
            "narrator": "神楽",
            "text": "仕方ないか、\nあっちも仕事なんだろうし。",
            "zh": "也没办法吧，\n对方大概也在忙工作。",
            "narrator_zh": "神乐"
        },
        {
            "location": "358/TALK",
            "narrator": "神楽",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "360/TALK",
            "narrator": "神楽",
            "text": "あーやだやだ。\n期待しちゃって、\n私バカみたい。",
            "zh": "啊——讨厌讨厌。\n居然还抱着期待，\n我真像个笨蛋。",
            "narrator_zh": "神乐"
        },
        {
            "location": "373/TALK",
            "narrator": "神楽",
            "text": "…私の名前は\n卯月神楽。",
            "zh": "……我的名字是\n卯月神乐。",
            "narrator_zh": "神乐"
        },
        {
            "location": "374/TALK",
            "narrator": "神楽",
            "text": "そして活動名は\nFreyMENOW。",
            "zh": "然后活动名是\nFreyMENOW。",
            "narrator_zh": "神乐"
        },
        {
            "location": "375/TALK",
            "narrator": "神楽",
            "text": "それはどの世界でも\n変わらない。",
            "zh": "那在任何世界都\n不会变。",
            "narrator_zh": "神乐"
        },
        {
            "location": "376/TALK",
            "narrator": "神楽",
            "text": "変えたくない……。",
            "zh": "我不想改变……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "201/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>某月某日　1:26 PM</color>\nとある平日、都内でのこと",
            "zh": "<color=green>某月某日　1:26 PM</color>\n某个平日，在东京都内的事",
            "narrator_zh": "Dialog_EventData"
        }
    ]
}
