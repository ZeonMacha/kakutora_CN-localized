{
 "dir": "dramatics/daydra/drm_ch03_00_650.js",
 "type": "Episode",
 "info": {
  "story_id": "3065",
  "cid": "gabriella",
  "title": "らぶとーく  第66話",
  "sub_title": "小さな一歩"
 },
 "entry": [
  {
   "location": "164/SCENARIO",
   "narrator": "",
   "text": "小さな一歩"
  },
  {
   "location": "187/TALK",
   "narrator": "先生",
   "text": "えー、このように、\n平方根とは２乗を\n逆にしたもので――",
   "zh": "来，就像这样，\n平方根就是平方的\n逆运算——",
   "narrator_zh": "老师"
  },
  {
   "location": "188/TALK",
   "narrator": "ガブリエラ",
   "text": "…………。"
  },
  {
   "location": "190/TALK",
   "narrator": "ガブリエラ",
   "text": "緊張して来たわ…。"
  },
  {
   "location": "196/TALK",
   "narrator": "ガブリエラ",
   "text": "$handle$、いる？",
   "zh": "$handle$，在吗？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "197/TALK",
   "narrator": "ガブリエラ",
   "text": "今、凄く緊張してるの"
  },
  {
   "location": "199/SEL",
   "narrator": "",
   "text": "どうかしたの？",
   "zh": "怎么了？",
   "narrator_zh": ""
  },
  {
   "location": "200/ACT",
   "narrator": "",
   "text": "どうかしたの？",
   "zh": "怎么了？",
   "narrator_zh": ""
  },
  {
   "location": "202/TALK",
   "narrator": "ガブリエラ",
   "text": "私ね",
   "zh": "我啊",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "203/TALK",
   "narrator": "ガブリエラ",
   "text": "この授業中に",
   "zh": "就在这堂课中",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "205/TALK",
   "narrator": "ガブリエラ",
   "text": "手を挙げてみようと思うの"
  },
  {
   "location": "207/SEL",
   "narrator": "",
   "text": "大丈夫なの？",
   "zh": "没事吗？",
   "narrator_zh": ""
  },
  {
   "location": "208/ACT",
   "narrator": "",
   "text": "大丈夫なの？",
   "zh": "没事吗？",
   "narrator_zh": ""
  },
  {
   "location": "210/TALK",
   "narrator": "ガブリエラ",
   "text": "平気に決まってるでしょ！"
  },
  {
   "location": "211/TALK",
   "narrator": "ガブリエラ",
   "text": "あ",
   "zh": "啊",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "212/TALK",
   "narrator": "ガブリエラ",
   "text": "ううん、平気じゃないかも"
  },
  {
   "location": "213/TALK",
   "narrator": "ガブリエラ",
   "text": "さっきまで平気だったけど"
  },
  {
   "location": "214/TALK",
   "narrator": "ガブリエラ",
   "text": "段々緊張してきて…"
  },
  {
   "location": "216/SEL",
   "narrator": "",
   "text": "無理しなくていいよ",
   "zh": "不用勉强自己哦",
   "narrator_zh": ""
  },
  {
   "location": "217/SEL",
   "narrator": "",
   "text": "見ててあげるから",
   "zh": "我会看着你的",
   "narrator_zh": ""
  },
  {
   "location": "218/SEL",
   "narrator": "",
   "text": "応援してる",
   "zh": "我支持你",
   "narrator_zh": ""
  },
  {
   "location": "219/ACT",
   "narrator": "",
   "text": "無理しなくていいよ",
   "zh": "不用勉强自己哦",
   "narrator_zh": ""
  },
  {
   "location": "220/TALK",
   "narrator": "ガブリエラ",
   "text": "無理じゃない！"
  },
  {
   "location": "221/TALK",
   "narrator": "ガブリエラ",
   "text": "私、決めたから！"
  },
  {
   "location": "222/ACT",
   "narrator": "",
   "text": "見ててあげるから",
   "zh": "我会看着你的",
   "narrator_zh": ""
  },
  {
   "location": "223/TALK",
   "narrator": "ガブリエラ",
   "text": "子供扱いしてない？"
  },
  {
   "location": "224/TALK",
   "narrator": "ガブリエラ",
   "text": "お父さんみたいな言い方しないで！",
   "zh": "别用爸爸那种口气说话！",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "225/TALK",
   "narrator": "ガブリエラ",
   "text": "まったく…"
  },
  {
   "location": "226/ACT",
   "narrator": "",
   "text": "応援してる",
   "zh": "我支持你",
   "narrator_zh": ""
  },
  {
   "location": "227/TALK",
   "narrator": "ガブリエラ",
   "text": "ありがと",
   "zh": "谢谢",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "228/TALK",
   "narrator": "ガブリエラ",
   "text": "頑張るから！"
  },
  {
   "location": "236/TALK",
   "narrator": "ガブリエラ",
   "text": "…大丈夫。\nあたしにはできるわ。",
   "zh": "……没事。\n我做得到。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "237/TALK",
   "narrator": "ガブリエラ",
   "text": "小学生でもできる\nことなんだから、\nこれくらい…。"
  },
  {
   "location": "238/TALK",
   "narrator": "先生",
   "text": "では、簡単な問題を\n出しますね。",
   "zh": "那么，我出一道\n简单的问题。",
   "narrator_zh": "老师"
  },
  {
   "location": "239/TALK",
   "narrator": "先生",
   "text": "１００の平方根は\nいくつになるか――"
  },
  {
   "location": "240/TALK",
   "narrator": "先生",
   "text": "わかる人はいますか？"
  },
  {
   "location": "242/TALK",
   "narrator": "ガブリエラ",
   "text": "っ！！",
   "zh": "唔！！",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "243/TALK",
   "narrator": "先生",
   "text": "じゃあ、えっと…。"
  },
  {
   "location": "247/TALK",
   "narrator": "先生",
   "text": "はい、大山さん。"
  },
  {
   "location": "248/TALK",
   "narrator": "ガブリエラ",
   "text": "っ！？",
   "zh": "！？",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "249/TALK",
   "narrator": "女子高校生Ａ",
   "text": "えーっと…\n１００００ですか？",
   "zh": "那个……\n是一万吗？",
   "narrator_zh": "女高中生A"
  },
  {
   "location": "250/TALK",
   "narrator": "先生",
   "text": "それは２乗でしょう？\n平方根はその逆です。",
   "zh": "那是平方吧？\n平方根是它的逆运算。",
   "narrator_zh": "老师"
  },
  {
   "location": "251/TALK",
   "narrator": "女子高校生Ａ",
   "text": "あ、そっか…。"
  },
  {
   "location": "252/TALK",
   "narrator": "先生",
   "text": "えっと、それじゃあ…。"
  },
  {
   "location": "254/TALK",
   "narrator": "ガブリエラ",
   "text": "…………。"
  },
  {
   "location": "255/TALK",
   "narrator": "先生",
   "text": "…いないですか？\nでは、解説しながら\n答えを教えますね。"
  },
  {
   "location": "256/TALK",
   "narrator": "ガブリエラ",
   "text": "…まさか、他の人が\n当てられるなんて…。",
   "zh": "……没想到，居然会被\n别人猜中……。",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "257/TALK",
   "narrator": "ガブリエラ",
   "text": "何でこういう時に限って\n誰か手を上げるのよ！？"
  },
  {
   "location": "258/TALK",
   "narrator": "ガブリエラ",
   "text": "普段は誰もあげない\nくせに！！"
  },
  {
   "location": "259/SEL",
   "narrator": "",
   "text": "残念だったね",
   "zh": "真是遗憾呢",
   "narrator_zh": ""
  },
  {
   "location": "260/ACT",
   "narrator": "",
   "text": "残念だったね",
   "zh": "真是遗憾呢",
   "narrator_zh": ""
  },
  {
   "location": "272/TALK",
   "narrator": "ガブリエラ",
   "text": "最低よ"
  },
  {
   "location": "273/TALK",
   "narrator": "ガブリエラ",
   "text": "せっかく勇気を出して手を上げようとしたのに"
  },
  {
   "location": "274/TALK",
   "narrator": "ガブリエラ",
   "text": "先に他の人が当たるなんて"
  },
  {
   "location": "277/SEL",
   "narrator": "",
   "text": "それでも偉かったよ",
   "zh": "就算这样也很了不起了",
   "narrator_zh": ""
  },
  {
   "location": "278/ACT",
   "narrator": "",
   "text": "それでも偉かったよ",
   "zh": "就算这样也很了不起了",
   "narrator_zh": ""
  },
  {
   "location": "280/TALK",
   "narrator": "ガブリエラ",
   "text": "本当にそう思ってくれてる？"
  },
  {
   "location": "281/TALK",
   "narrator": "ガブリエラ",
   "text": "本当に頑張ったんだから"
  },
  {
   "location": "282/TALK",
   "narrator": "ガブリエラ",
   "text": "褒めてくれて"
  },
  {
   "location": "283/TALK",
   "narrator": "ガブリエラ",
   "text": "ううん",
   "zh": "不是的",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "284/TALK",
   "narrator": "ガブリエラ",
   "text": "なんでもない",
   "zh": "没什么",
   "narrator_zh": "加布里埃拉"
  },
  {
   "location": "289/TALK",
   "narrator": "ガブリエラ",
   "text": "…………。"
  },
  {
   "location": "290/TALK",
   "narrator": "ガブリエラ",
   "text": "ありがと、$handle$。"
  },
  {
   "location": "173/DIALOG",
   "narrator": "Dialog_EventData",
   "text": "<color=green>某月某日　 1:31 PM</color>\nとある平日、付属学園中等部ガブリエラの教室でのこと"
  }
 ]
}
