{
    "dir": "dramatics/daydra/drm_ch03_00_650.js",
    "type": "Episode",
    "info": {
        "story_id": "3065",
        "cid": "gabriella",
        "title": "らぶとーく  第66話",
        "sub_title": "小さな一歩",
        "title_zh": "恋爱漫谈 第66话",
        "sub_title_zh": "小小的一步"
    },
    "entry": [
        {
            "location": "164/SCENARIO",
            "narrator": "",
            "text": "小さな一歩",
            "zh": "小小的一步",
            "narrator_zh": ""
        },
        {
            "location": "187/TALK",
            "narrator": "先生",
            "text": "えー、このように、\n平方根とは２乗を\n逆にしたもので――",
            "zh": "来，就像这样，\n平方根就是平方的\n逆运算——",
            "narrator_zh": "老师"
        },
        {
            "location": "188/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "190/TALK",
            "narrator": "ガブリエラ",
            "text": "緊張して来たわ…。",
            "zh": "开始紧张起来了……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "196/TALK",
            "narrator": "ガブリエラ",
            "text": "$handle$、いる？",
            "zh": "$handle$，在吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "197/TALK",
            "narrator": "ガブリエラ",
            "text": "今、凄く緊張してるの",
            "zh": "我现在超级紧张",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "199/SEL",
            "narrator": "",
            "text": "どうかしたの？",
            "zh": "怎么了？",
            "narrator_zh": ""
        },
        {
            "location": "200/ACT",
            "narrator": "",
            "text": "どうかしたの？",
            "zh": "怎么了？",
            "narrator_zh": ""
        },
        {
            "location": "202/TALK",
            "narrator": "ガブリエラ",
            "text": "私ね",
            "zh": "我啊",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "203/TALK",
            "narrator": "ガブリエラ",
            "text": "この授業中に",
            "zh": "就在这堂课中",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "205/TALK",
            "narrator": "ガブリエラ",
            "text": "手を挙げてみようと思うの",
            "zh": "想试着举一次手",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "207/SEL",
            "narrator": "",
            "text": "大丈夫なの？",
            "zh": "没事吗？",
            "narrator_zh": ""
        },
        {
            "location": "208/ACT",
            "narrator": "",
            "text": "大丈夫なの？",
            "zh": "没事吗？",
            "narrator_zh": ""
        },
        {
            "location": "210/TALK",
            "narrator": "ガブリエラ",
            "text": "平気に決まってるでしょ！",
            "zh": "肯定没事的啦！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "211/TALK",
            "narrator": "ガブリエラ",
            "text": "あ",
            "zh": "啊",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "212/TALK",
            "narrator": "ガブリエラ",
            "text": "ううん、平気じゃないかも",
            "zh": "不，说不定会紧张",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "213/TALK",
            "narrator": "ガブリエラ",
            "text": "さっきまで平気だったけど",
            "zh": "刚才还很镇定来着",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "214/TALK",
            "narrator": "ガブリエラ",
            "text": "段々緊張してきて…",
            "zh": "可渐渐紧张起来了……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "216/SEL",
            "narrator": "",
            "text": "無理しなくていいよ",
            "zh": "不用勉强自己哦",
            "narrator_zh": ""
        },
        {
            "location": "217/SEL",
            "narrator": "",
            "text": "見ててあげるから",
            "zh": "我会看着你的",
            "narrator_zh": ""
        },
        {
            "location": "218/SEL",
            "narrator": "",
            "text": "応援してる",
            "zh": "我支持你",
            "narrator_zh": ""
        },
        {
            "location": "219/ACT",
            "narrator": "",
            "text": "無理しなくていいよ",
            "zh": "不用勉强自己哦",
            "narrator_zh": ""
        },
        {
            "location": "220/TALK",
            "narrator": "ガブリエラ",
            "text": "無理じゃない！",
            "zh": "才不是勉强！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "221/TALK",
            "narrator": "ガブリエラ",
            "text": "私、決めたから！",
            "zh": "我已经决定了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "222/ACT",
            "narrator": "",
            "text": "見ててあげるから",
            "zh": "我会看着你的",
            "narrator_zh": ""
        },
        {
            "location": "223/TALK",
            "narrator": "ガブリエラ",
            "text": "子供扱いしてない？",
            "zh": "你是不是把我当小孩了？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "224/TALK",
            "narrator": "ガブリエラ",
            "text": "お父さんみたいな言い方しないで！",
            "zh": "别用爸爸那种口气说话！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "225/TALK",
            "narrator": "ガブリエラ",
            "text": "まったく…",
            "zh": "真是的……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "226/ACT",
            "narrator": "",
            "text": "応援してる",
            "zh": "我支持你",
            "narrator_zh": ""
        },
        {
            "location": "227/TALK",
            "narrator": "ガブリエラ",
            "text": "ありがと",
            "zh": "谢谢",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "228/TALK",
            "narrator": "ガブリエラ",
            "text": "頑張るから！",
            "zh": "我会加油的！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "236/TALK",
            "narrator": "ガブリエラ",
            "text": "…大丈夫。\nあたしにはできるわ。",
            "zh": "……没事。\n我做得到。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "237/TALK",
            "narrator": "ガブリエラ",
            "text": "小学生でもできる\nことなんだから、\nこれくらい…。",
            "zh": "明明是小学生\n都会做的东西，\n这点程度……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "238/TALK",
            "narrator": "先生",
            "text": "では、簡単な問題を\n出しますね。",
            "zh": "那么，我出一道\n简单的问题。",
            "narrator_zh": "老师"
        },
        {
            "location": "239/TALK",
            "narrator": "先生",
            "text": "１００の平方根は\nいくつになるか――",
            "zh": "一百的平方根是\n多少呢——",
            "narrator_zh": "老师"
        },
        {
            "location": "240/TALK",
            "narrator": "先生",
            "text": "わかる人はいますか？",
            "zh": "有人知道吗？",
            "narrator_zh": "老师"
        },
        {
            "location": "242/TALK",
            "narrator": "ガブリエラ",
            "text": "っ！！",
            "zh": "唔！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "243/TALK",
            "narrator": "先生",
            "text": "じゃあ、えっと…。",
            "zh": "那么，那个……。",
            "narrator_zh": "老师"
        },
        {
            "location": "247/TALK",
            "narrator": "先生",
            "text": "はい、大山さん。",
            "zh": "好，大山同学。",
            "narrator_zh": "老师"
        },
        {
            "location": "248/TALK",
            "narrator": "ガブリエラ",
            "text": "っ！？",
            "zh": "！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "249/TALK",
            "narrator": "女子高校生Ａ",
            "text": "えーっと…\n１００００ですか？",
            "zh": "那个……\n是一万吗？",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "250/TALK",
            "narrator": "先生",
            "text": "それは２乗でしょう？\n平方根はその逆です。",
            "zh": "那是平方吧？\n平方根是它的逆运算。",
            "narrator_zh": "老师"
        },
        {
            "location": "251/TALK",
            "narrator": "女子高校生Ａ",
            "text": "あ、そっか…。",
            "zh": "啊，对哦……。",
            "narrator_zh": "女高中生A"
        },
        {
            "location": "252/TALK",
            "narrator": "先生",
            "text": "えっと、それじゃあ…。",
            "zh": "那个，那么……。",
            "narrator_zh": "老师"
        },
        {
            "location": "254/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "255/TALK",
            "narrator": "先生",
            "text": "…いないですか？\nでは、解説しながら\n答えを教えますね。",
            "zh": "……没有人吗？\n那我就边讲解\n边公布答案了。",
            "narrator_zh": "老师"
        },
        {
            "location": "256/TALK",
            "narrator": "ガブリエラ",
            "text": "…まさか、他の人が\n当てられるなんて…。",
            "zh": "……没想到，居然会被\n别人猜中……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "257/TALK",
            "narrator": "ガブリエラ",
            "text": "何でこういう時に限って\n誰か手を上げるのよ！？",
            "zh": "为什么偏偏这种时候\n就有人举手啊！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "258/TALK",
            "narrator": "ガブリエラ",
            "text": "普段は誰もあげない\nくせに！！",
            "zh": "平时明明没人举手\n的！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "259/SEL",
            "narrator": "",
            "text": "残念だったね",
            "zh": "真是遗憾呢",
            "narrator_zh": ""
        },
        {
            "location": "260/ACT",
            "narrator": "",
            "text": "残念だったね",
            "zh": "真是遗憾呢",
            "narrator_zh": ""
        },
        {
            "location": "272/TALK",
            "narrator": "ガブリエラ",
            "text": "最低よ",
            "zh": "糟透了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "273/TALK",
            "narrator": "ガブリエラ",
            "text": "せっかく勇気を出して手を上げようとしたのに",
            "zh": "好不容易鼓起勇气想举手来着",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "274/TALK",
            "narrator": "ガブリエラ",
            "text": "先に他の人が当たるなんて",
            "zh": "结果被别人抢先答了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "277/SEL",
            "narrator": "",
            "text": "それでも偉かったよ",
            "zh": "就算这样也很了不起了",
            "narrator_zh": ""
        },
        {
            "location": "278/ACT",
            "narrator": "",
            "text": "それでも偉かったよ",
            "zh": "就算这样也很了不起了",
            "narrator_zh": ""
        },
        {
            "location": "280/TALK",
            "narrator": "ガブリエラ",
            "text": "本当にそう思ってくれてる？",
            "zh": "你真这么觉得？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "281/TALK",
            "narrator": "ガブリエラ",
            "text": "本当に頑張ったんだから",
            "zh": "我真的是很努力了的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "282/TALK",
            "narrator": "ガブリエラ",
            "text": "褒めてくれて",
            "zh": "还夸了我一下",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "283/TALK",
            "narrator": "ガブリエラ",
            "text": "ううん",
            "zh": "不是的",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "284/TALK",
            "narrator": "ガブリエラ",
            "text": "なんでもない",
            "zh": "没什么",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "289/TALK",
            "narrator": "ガブリエラ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "290/TALK",
            "narrator": "ガブリエラ",
            "text": "ありがと、$handle$。",
            "zh": "谢谢，$handle$。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "173/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>某月某日　 1:31 PM</color>\nとある平日、付属学園中等部ガブリエラの教室でのこと",
            "zh": "<color=green>某月某日　 1:31 PM</color>\n某个平日，发生在附属学园中等部加布里埃拉的教室",
            "narrator_zh": "Dialog_EventData"
        }
    ]
}
