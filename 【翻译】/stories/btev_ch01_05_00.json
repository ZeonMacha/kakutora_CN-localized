    "entry": [
        {
            "location": "7/SCENARIO",
            "narrator": "",
            "text": "綺麗すぎる湖１",
            "zh": "漂亮过头的湖1",
            "narrator_zh": ""
        },
        {
            "location": "13/DIALOG",
            "narrator": "",
            "text": "<size=40>KOKORO-Lv. 02</size>\nTSUBAME - OHSE\n\n<size=45>綺麗すぎる湖Ⅰ</size>\n<size=35>～源～</size>",
            "zh": "<size=40>KOKORO-Lv. 02</size>\n逢濑燕\n\n<size=45>漂亮过头的湖Ⅰ</size>\n<size=35>～源～</size>",
            "narrator_zh": ""
        },
        {
            "location": "25/TALK",
            "narrator": "表層つばめ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "表层燕"
        },
        {
            "location": "27/TALK",
            "narrator": "表層つばめ",
            "text": "………。",
            "zh": "………。",
            "narrator_zh": "表层燕"
        },
        {
            "location": "30/TALK",
            "narrator": "表層つばめ",
            "text": "…。",
            "zh": "…。",
            "narrator_zh": "表层燕"
        },
        {
            "location": "32/SEL",
            "narrator": "（選択肢）",
            "text": "また悩んでるの？",
            "zh": "又在烦恼吗？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "33/ACT",
            "narrator": "",
            "text": "こんにちは",
            "zh": "你好",
            "narrator_zh": ""
        },
        {
            "location": "36/TALK",
            "narrator": "表層つばめ",
            "text": "あ…あなたは……",
            "zh": "啊……你是……",
            "narrator_zh": "表层燕"
        },
        {
            "location": "37/SEL",
            "narrator": "（選択肢）",
            "text": "そうです、私が$handle$です",
            "zh": "对，我就是$handle$",
            "narrator_zh": "（选项）"
        },
        {
            "location": "38/ACT",
            "narrator": "",
            "text": "そうです、私が$handle$です",
            "zh": "对，我就是$handle$",
            "narrator_zh": ""
        },
        {
            "location": "40/TALK",
            "narrator": "表層つばめ",
            "text": "そう、$handle$。\nココロレベル０１でも\n助けてくれたよね。",
            "zh": "是的，$handle$。\n心灵等级01的时候\n你也帮过我呀。",
            "narrator_zh": "表层燕"
        },
        {
            "location": "41/SEL",
            "narrator": "（選択肢）",
            "text": "今度はどうしたの？",
            "zh": "这次怎么了？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "42/ACT",
            "narrator": "",
            "text": "今度はどうしたの？",
            "zh": "这次怎么了？",
            "narrator_zh": ""
        },
        {
            "location": "44/TALK",
            "narrator": "表層つばめ",
            "text": "うん、実は……その、",
            "zh": "嗯，其实……那个，",
            "narrator_zh": "表层燕"
        },
        {
            "location": "45/TALK",
            "narrator": "表層つばめ",
            "text": "わたし多分、\n他のみんなとは上手く\nやっていけないと思う。",
            "zh": "我大概，\n和其他人没法\n好好相处。",
            "narrator_zh": "表层燕"
        },
        {
            "location": "46/SEL",
            "narrator": "（選択肢）",
            "text": "他のみんなって、トライナリーのメンバーのこと？",
            "zh": "其他大家，是说三重奏的成员吗？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "47/ACT",
            "narrator": "",
            "text": "他のみんなって、トライナリーのメンバーのこと？",
            "zh": "其他大家，是说三重奏的成员吗？",
            "narrator_zh": ""
        },
        {
            "location": "49/TALK",
            "narrator": "表層つばめ",
            "text": "うん。",
            "zh": "嗯。",
            "narrator_zh": "表层燕"
        },
        {
            "location": "50/TALK",
            "narrator": "表層つばめ",
            "text": "一緒の教室にいるだけ\nの人と違うでしょ、\n任務あるし。",
            "zh": "和只是待在同一间教室\n的人不一样吧，\n还有任务。",
            "narrator_zh": "表层燕"
        },
        {
            "location": "51/TALK",
            "narrator": "表層つばめ",
            "text": "これからもその度に\n気まずくなると思うと\n憂鬱で。",
            "zh": "一想到以后每次\n都会变得尴尬，\n就很郁闷。",
            "narrator_zh": "表层燕"
        },
        {
            "location": "52/SEL",
            "narrator": "（選択肢）",
            "text": "普通に友達になれると思うけど？",
            "zh": "我觉得正常就能成为朋友呀？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "53/SEL",
            "narrator": "（選択肢）",
            "text": "トライナリーは変人揃いだから大丈夫！",
            "zh": "三重奏全是怪人，所以没问题！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "54/ACT",
            "narrator": "",
            "text": "普通に友達になれると思うけど？",
            "zh": "我觉得正常就能成为朋友呀？",
            "narrator_zh": ""
        },
        {
            "location": "55/TALK",
            "narrator": "表層つばめ",
            "text": "無理だよ。\n今までだって\nそうだったもん。",
            "zh": "不行的。\n到现在为止\n都是这样。",
            "narrator_zh": "表层燕"
        },
        {
            "location": "56/ACT",
            "narrator": "",
            "text": "トライナリーは変人揃いだから大丈夫！",
            "zh": "三重奏全是怪人，所以没问题！",
            "narrator_zh": ""
        },
        {
            "location": "57/TALK",
            "narrator": "表層つばめ",
            "text": "え、ええええっ！\nそうか……な…",
            "zh": "诶、诶诶诶！\n是这样……吗……",
            "narrator_zh": "表层燕"
        },
        {
            "location": "58/TALK",
            "narrator": "表層つばめ",
            "text": "……あ、うん…\n確かにそうかも……。",
            "zh": "……啊，嗯……\n确实也许是这样……。",
            "narrator_zh": "表层燕"
        },
        {
            "location": "59/TALK",
            "narrator": "表層つばめ",
            "text": "でもやっぱり、\nきっと友達には\nなれないよ。",
            "zh": "可是果然，\n一定没法和人\n成为朋友。",
            "narrator_zh": "表层燕"
        },
        {
            "location": "60/TALK",
            "narrator": "表層つばめ",
            "text": "今までだって\nそうだったもん。",
            "zh": "到现在为止\n都是这样。",
            "narrator_zh": "表层燕"
        },
        {
            "location": "62/TALK",
            "narrator": "表層つばめ",
            "text": "最初は話しかけて\nくれるけど、段々\n遠くなっちゃって…",
            "zh": "一开始会跟我说话，\n可是渐渐\n就疏远了……",
            "narrator_zh": "表层燕"
        },
        {
            "location": "63/SEL",
            "narrator": "（選択肢）",
            "text": "なんでだろうね",
            "zh": "为什么呢",
            "narrator_zh": "（选项）"
        },
        {
            "location": "64/ACT",
            "narrator": "",
            "text": "なんでだろうね",
            "zh": "为什么呢",
            "narrator_zh": ""
        },
        {
            "location": "66/TALK",
            "narrator": "表層つばめ",
            "text": "わからない。",
            "zh": "不明白。",
            "narrator_zh": "表层燕"
        },
        {
            "location": "67/TALK",
            "narrator": "表層つばめ",
            "text": "いつの間にか、\nみんな話してくれなく\nなっちゃうから……",
            "zh": "不知不觉，\n大家就不跟我\n说话了……",
            "narrator_zh": "表层燕"
        },
        {
            "location": "68/SEL",
            "narrator": "（選択肢）",
            "text": "ココロの奥に答えがあるかも",
            "zh": "答案也许在心的深处",
            "narrator_zh": "（选项）"
        },
        {
            "location": "69/ACT",
            "narrator": "",
            "text": "ココロの奥に答えがあるかも",
            "zh": "答案也许在心的深处",
            "narrator_zh": ""
        },
        {
            "location": "71/TALK",
            "narrator": "表層つばめ",
            "text": "そうかもしれないけど\nどこにあるのか\nわからないし……",
            "zh": "也许是这样，\n可是在哪里\n我也不知道……",
            "narrator_zh": "表层燕"
        },
        {
            "location": "72/SEL",
            "narrator": "（選択肢）",
            "text": "一緒に探そう",
            "zh": "一起找吧",
            "narrator_zh": "（选项）"
        },
        {
            "location": "73/ACT",
            "narrator": "",
            "text": "一緒に探そう",
            "zh": "一起找吧",
            "narrator_zh": ""
        },
        {
            "location": "75/TALK",
            "narrator": "表層つばめ",
            "text": "え、でも……\n悪いよ。",
            "zh": "诶，可是……\n不好意思。",
            "narrator_zh": "表层燕"
        },
        {
            "location": "76/SEL",
            "narrator": "（選択肢）",
            "text": "大丈夫。経験則上、本気で探そうと思えば、すぐに手がかりがやってくる",
            "zh": "没事。按经验，只要真心去找，线索马上就会来。",
            "narrator_zh": "（选项）"
        },
        {
            "location": "77/ACT",
            "narrator": "",
            "text": "大丈夫。経験則上、本気で探そうと思えば、すぐに手がかりがやってくる",
            "zh": "没事。按经验，只要真心去找，线索马上就会来。",
            "narrator_zh": ""
        },
        {
            "location": "79/TALK",
            "narrator": "表層つばめ",
            "text": "そ、そうなの！？",
            "zh": "是、是这样吗！？",
            "narrator_zh": "表层燕"
        },
        {
            "location": "81/TALK",
            "narrator": "表層つばめ",
            "text": "も、もちろん\nそれが分かるなら\n本気で探すよ！！",
            "zh": "当、当然，\n要是能弄明白，\n我会认真找的！！",
            "narrator_zh": "表层燕"
        },
        {
            "location": "83/TALK",
            "narrator": "潜在つばめ",
            "text": "そうはいかない。",
            "zh": "那可不行。",
            "narrator_zh": "潜在燕"
        },
        {
            "location": "90/TALK",
            "narrator": "表層つばめ",
            "text": "え！？\nあなたは？",
            "zh": "诶！？\n你是？",
            "narrator_zh": "表层燕"
        },
        {
            "location": "92/TALK",
            "narrator": "潜在つばめ",
            "text": "記憶の鍵番をしている\nわたしだよ。",
            "zh": "我是担任记忆的\n钥匙看守的我哦。",
            "narrator_zh": "潜在燕"
        },
        {
            "location": "93/SEL",
            "narrator": "（選択肢）",
            "text": "ほら、出てきた！",
            "zh": "看，出来了！",
            "narrator_zh": "（选项）"
        },
        {
            "location": "94/ACT",
            "narrator": "",
            "text": "ほら、出てきた！",
            "zh": "看，出来了！",
            "narrator_zh": ""
        },
        {
            "location": "96/TALK",
            "narrator": "潜在つばめ",
            "text": "$handle$だっけ？\nあなた、余計なこと\nしないで。",
            "zh": "你是$handle$来着？\n你别\n多管闲事。",
            "narrator_zh": "潜在燕"
        },
        {
            "location": "97/TALK",
            "narrator": "潜在つばめ",
            "text": "ココロの中には\n忘れてしまった方が\nいいこともある。",
            "zh": "心里有些事，\n还是忘掉\n比较好。",
            "narrator_zh": "潜在燕"
        },
        {
            "location": "98/TALK",
            "narrator": "潜在つばめ",
            "text": "それを封印するのが\nわたしの仕事。\nだから――",
            "zh": "封印那些，\n是我的工作。\n所以——",
            "narrator_zh": "潜在燕"
        },
        {
            "location": "99/TALK",
            "narrator": "潜在つばめ",
            "text": "それを妨害するなら\n実力をもって\n排除する。",
            "zh": "你要是妨碍，\n我就用实力\n把你排除。",
            "narrator_zh": "潜在燕"
        },
        {
            "location": "100/TALK",
            "narrator": "表層つばめ",
            "text": "えええっ！！",
            "zh": "诶诶诶！！",
            "narrator_zh": "表层燕"
        },
        {
            "location": "104/TALK",
            "narrator": "表層つばめ",
            "text": "$handle$、\nどどどどうしよう……",
            "zh": "$handle$，\n怎怎怎么办……",
            "narrator_zh": "表层燕"
        },
        {
            "location": "105/SEL",
            "narrator": "（選択肢）",
            "text": "戦おう。$me$も手伝うから",
            "zh": "来战斗吧。$me$也会帮忙",
            "narrator_zh": "（选项）"
        },
        {
            "location": "106/ACT",
            "narrator": "",
            "text": "戦おう。$me$も手伝うから",
            "zh": "来战斗吧。$me$也会帮忙",
            "narrator_zh": ""
        },
        {
            "location": "108/TALK",
            "narrator": "表層つばめ",
            "text": "で、でも……",
            "zh": "可、可是……",
            "narrator_zh": "表层燕"
        },
        {
            "location": "109/SEL",
            "narrator": "（選択肢）",
            "text": "友達作りたいんでしょ？",
            "zh": "你想交朋友吧？",
            "narrator_zh": "（选项）"
        },
        {
            "location": "110/ACT",
            "narrator": "",
            "text": "友達作りたいんでしょ？",
            "zh": "你想交朋友吧？",
            "narrator_zh": ""
        },
        {
            "location": "112/TALK",
            "narrator": "表層つばめ",
            "text": "う、うん……",
            "zh": "嗯、嗯……",
            "narrator_zh": "表层燕"
        },
        {
            "location": "113/SEL",
            "narrator": "（選択肢）",
            "text": "じゃあ、ヒントを見つけなきゃ",
            "zh": "那就得找到线索",
            "narrator_zh": "（选项）"
        },
        {
            "location": "114/ACT",
            "narrator": "",
            "text": "じゃあ、ヒントを見つけなきゃ",
            "zh": "那就得找到线索",
            "narrator_zh": ""
        },
        {
            "location": "116/TALK",
            "narrator": "表層つばめ",
            "text": "そう……だね。",
            "zh": "……是呀。",
            "narrator_zh": "表层燕"
        },
        {
            "location": "117/TALK",
            "narrator": "表層つばめ",
            "text": "……。",
            "zh": "……。",
            "narrator_zh": "表层燕"
        },
        {
            "location": "121/TALK",
            "narrator": "表層つばめ",
            "text": "鍵番さん、\nごめんなさい。",
            "zh": "钥匙看守，\n对不起。",
            "narrator_zh": "表层燕"
        },
        {
            "location": "122/TALK",
            "narrator": "表層つばめ",
            "text": "邪魔するなら、\nわたしも戦うよ。",
            "zh": "你要是妨碍，\n我也会战斗。",
            "narrator_zh": "表层燕"
        },
        {
            "location": "123/TALK",
            "narrator": "潜在つばめ",
            "text": "そう。残念だよ。",
            "zh": "是吗。真遗憾。",
            "narrator_zh": "潜在燕"
        },
        {
            "location": "124/TALK",
            "narrator": "潜在つばめ",
            "text": "わたしの眷属の\nクランを見たら\nきっと後悔するよ？",
            "zh": "看到我的眷属\n库兰的话，\n你一定会后悔的哦？",
            "narrator_zh": "潜在燕"
        },
        {
            "location": "125/TALK",
            "narrator": "表層つばめ",
            "text": "そ、そんなこと\nないよ！！",
            "zh": "才、才没有\n那种事！！",
            "narrator_zh": "表层燕"
        },
        {
            "location": "126/TALK",
            "narrator": "潜在つばめ",
            "text": "わかった。\nそれじゃ戦おう。",
            "zh": "好。\n那就来战斗吧。",
            "narrator_zh": "潜在燕"
        },
        {
            "location": "127/TALK",
            "narrator": "潜在つばめ",
            "text": "あなたが勝ったら、\n貴方の見たい記憶を\n１つあげる。",
            "zh": "你要是赢了，\n就给你一份\n你想看的记忆。",
            "narrator_zh": "潜在燕"
        },
        {
            "location": "128/TALK",
            "narrator": "潜在つばめ",
            "text": "見る場合は\n自己責任で。\nいい？",
            "zh": "要看的话，\n后果自负。\n可以吗？",
            "narrator_zh": "潜在燕"
        },
        {
            "location": "129/TALK",
            "narrator": "表層つばめ",
            "text": "もちろんだよ。",
            "zh": "当然可以。",
            "narrator_zh": "表层燕"
        },
        {
            "location": "130/TALK",
            "narrator": "潜在つばめ",
            "text": "わかった。\nそれじゃあ――",
            "zh": "好。\n那么——",
            "narrator_zh": "潜在燕"
        },
        {
            "location": "131/TALK",
            "narrator": "潜在つばめ",
            "text": "いくよ！　　　",
            "zh": "上了！",
            "narrator_zh": "潜在燕"
        },
        {
            "location": "143/DIALOG",
            "narrator": "",
            "text": "<color=black><size=50><b>記憶を封印する鍵番を倒し\n過去の記憶を蘇らせよ！</b></size></color>\n\n\n\nなぜか、友達が離れていってしまうという\n悩みを抱えるつばめ。\n理由がわからないのは、\n鍵番がその原因を隠しているから！？\n\nつばめが成長する為にも、記憶の封印を解くのだ！\n\n\n\n\n",
            "zh": "<color=black><size=50><b>打倒封印记忆的钥匙看守\n唤醒过去的记忆！</b></size></color>\n\n\n\n不知为什么，朋友会离开自己，\n燕怀着这样的烦恼。\n弄不清理由，\n是因为钥匙看守把原因藏起来了！？\n\n为了让燕成长，也要解开记忆的封印！\n\n\n\n\n",
            "narrator_zh": ""
        }
    ]
}
