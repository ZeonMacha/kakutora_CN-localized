    "entry": [
        {
            "location": "80/TALK",
            "narrator": "プレイヤー",
            "text": "今日はいつもと違う雰囲気でコーデしてみませんか？",
            "zh": "今天要不要用和平时不一样的感觉来搭配？",
            "narrator_zh": "玩家"
        },
        {
            "location": "82/TALK",
            "narrator": "プレイヤー",
            "text": "お姫様、お召し替えのお時間ですよ",
            "zh": "公主殿下，到更衣的时间了",
            "narrator_zh": "玩家"
        },
        {
            "location": "84/TALK",
            "narrator": "プレイヤー",
            "text": "違う服のガブリエラが見たいよ",
            "zh": "想看穿别的衣服的加布里埃拉",
            "narrator_zh": "玩家"
        },
        {
            "location": "90/TALK",
            "narrator": "プレイヤー",
            "text": "やあ",
            "zh": "嗨",
            "narrator_zh": "玩家"
        },
        {
            "location": "92/TALK",
            "narrator": "プレイヤー",
            "text": "こんにちは",
            "zh": "你好",
            "narrator_zh": "玩家"
        },
        {
            "location": "94/TALK",
            "narrator": "プレイヤー",
            "text": "げんき？",
            "zh": "还好吗？",
            "narrator_zh": "玩家"
        },
        {
            "location": "97/TALK",
            "narrator": "ガブリエラ",
            "text": "あら",
            "zh": "哎呀",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "98/TALK",
            "narrator": "ガブリエラ",
            "text": "なにかしらこれ",
            "zh": "这是什么呀",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "100/SEL",
            "narrator": "",
            "text": "あなたの$handle$です",
            "zh": "是你的$handle$",
            "narrator_zh": ""
        },
        {
            "location": "101/ACT",
            "narrator": "",
            "text": "あなたの$handle$です",
            "zh": "是你的$handle$",
            "narrator_zh": ""
        },
        {
            "location": "103/TALK",
            "narrator": "ガブリエラ",
            "text": "いや、わかるわよ",
            "zh": "不，我知道",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "104/TALK",
            "narrator": "ガブリエラ",
            "text": "メンテのお知らせとかかしら？",
            "zh": "是维护通知之类的吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "106/SEL",
            "narrator": "",
            "text": "気分転換に着替えてみませんか？",
            "zh": "要不要换身衣服换换心情？",
            "narrator_zh": ""
        },
        {
            "location": "107/ACT",
            "narrator": "",
            "text": "気分転換に着替えてみませんか？",
            "zh": "要不要换身衣服换换心情？",
            "narrator_zh": ""
        },
        {
            "location": "117/TALK",
            "narrator": "ガブリエラ",
            "text": "え？　それって要するに着替えてってこと？",
            "zh": "诶？　说白了就是让我换衣服？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "118/TALK",
            "narrator": "ガブリエラ",
            "text": "まあ、良いけど…どれにしようかしら？",
            "zh": "嗯，倒也可以……选哪件好？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "120/TALK",
            "narrator": "ガブリエラ",
            "text": "うーん///",
            "zh": "嗯——///",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "121/TALK",
            "narrator": "ガブリエラ",
            "text": "まあ、ちょっとだけなら…",
            "zh": "嗯，就一会儿的话……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "124/SEL",
            "narrator": "",
            "text": "コーデするよ",
            "zh": "我来搭配",
            "narrator_zh": ""
        },
        {
            "location": "125/SEL",
            "narrator": "",
            "text": "やっぱやめる",
            "zh": "还是算了",
            "narrator_zh": ""
        },
        {
            "location": "127/TALK",
            "narrator": "ガブリエラ",
            "text": "そうねぇ…",
            "zh": "这个嘛……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "130/TALK",
            "narrator": "ガブリエラ",
            "text": "やっぱり、今のままで良いわ",
            "zh": "果然，还是现在这样就好",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "131/ACT",
            "narrator": "",
            "text": "コーデするよ",
            "zh": "我来搭配",
            "narrator_zh": ""
        },
        {
            "location": "132/TALK",
            "narrator": "ガブリエラ",
            "text": "あらそう？",
            "zh": "是吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "133/TALK",
            "narrator": "ガブリエラ",
            "text": "それじゃあ、お任せするわ",
            "zh": "那就交给你了",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "139/ACT",
            "narrator": "",
            "text": "やっぱやめる",
            "zh": "还是算了",
            "narrator_zh": ""
        },
        {
            "location": "140/TALK",
            "narrator": "ガブリエラ",
            "text": "だったら着替えてほしいとか言わないで",
            "zh": "那你就别说什么想让我换衣服",
            "narrator_zh": "加布里埃拉"
        }
