{
    "dir": "chap23/daydra/dd_ch02_23_102.js",
    "type": "MainStory",
    "info": {
        "story_id": "23205",
        "cid": "ayami",
        "title": "005 メインストーリー",
        "sub_title": "迷いは＜後編＞",
        "title_zh": "005 主线剧情",
        "sub_title_zh": "迷茫＜后篇＞"
    },
    "entry": [
        {
            "location": "577/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "578/TALK",
            "narrator": "小夜",
            "text": "…よかった。",
            "zh": "……太好了。",
            "narrator_zh": "小夜"
        },
        {
            "location": "579/TALK",
            "narrator": "小夜",
            "text": "やっぱり、迷いがない\nわけないよね。",
            "zh": "果然，你不可能\n毫无迷茫嘛。",
            "narrator_zh": "小夜"
        },
        {
            "location": "581/TALK",
            "narrator": "アーヤ",
            "text": "…よくないわよ。",
            "zh": "……才不好呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "582/TALK",
            "narrator": "小夜",
            "text": "そうかしら？\nあたしはそれ聞いて\n安心したわ。",
            "zh": "是吗？\n我听你这么一说\n反倒安心了呢。",
            "narrator_zh": "小夜"
        },
        {
            "location": "583/TALK",
            "narrator": "小夜",
            "text": "だって、アーヤは\n優しい子だもの。",
            "zh": "因为，绫水你本来就是个\n温柔的女孩子嘛。",
            "narrator_zh": "小夜"
        },
        {
            "location": "584/TALK",
            "narrator": "小夜",
            "text": "仲間だった子を\n簡単に殺せたり\nするはずないわ。",
            "zh": "曾经当成同伴的孩子，\n你怎么可能说杀\n就轻易杀掉呢。",
            "narrator_zh": "小夜"
        },
        {
            "location": "586/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "587/TALK",
            "narrator": "小夜",
            "text": "…その顔からすると、\n不満そうだね？",
            "zh": "……看你那表情，\n好像很不满嘛？",
            "narrator_zh": "小夜"
        },
        {
            "location": "588/TALK",
            "narrator": "アーヤ",
            "text": "…私はリーダーで、\nみんなを護らなきゃ\nいけない立場なの。",
            "zh": "……我是队长，\n肩负着必须保护大家的\n立场。",
            "narrator_zh": "绫水"
        },
        {
            "location": "589/TALK",
            "narrator": "アーヤ",
            "text": "だから、敵に対して\n迷ったりしたら\nいけないの。",
            "zh": "所以，面对敌人时\n绝对不能\n有所迷茫。",
            "narrator_zh": "绫水"
        },
        {
            "location": "591/TALK",
            "narrator": "アーヤ",
            "text": "なのに…、\n私、迷ってる…。",
            "zh": "可是……，\n我却在迷茫……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "592/TALK",
            "narrator": "アーヤ",
            "text": "裏切者なのに…。\n敵なのに…。",
            "zh": "明明她是叛徒……。\n明明她是敌人……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "593/TALK",
            "narrator": "アーヤ",
            "text": "私…あの子たちの\nリーダー失格なのかも…。",
            "zh": "我……说不定根本没有资格\n当她们的队长……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "594/TALK",
            "narrator": "小夜",
            "text": "バカなこと\n言わないでよ。",
            "zh": "别说这种\n傻话啦。",
            "narrator_zh": "小夜"
        },
        {
            "location": "595/TALK",
            "narrator": "小夜",
            "text": "アーヤはみんなのことを、\n一生懸命護ってきたん\nでしょ？",
            "zh": "绫水你一直都在拼尽全力\n保护大家，\n不是吗？",
            "narrator_zh": "小夜"
        },
        {
            "location": "596/TALK",
            "narrator": "小夜",
            "text": "そんな子の一人を、\n突然迷いもなく\n敵と思えるはずないわよ。",
            "zh": "那样的一名同伴，\n怎么可能说翻脸就毫无迷茫地\n把她当成敌人嘛。",
            "narrator_zh": "小夜"
        },
        {
            "location": "598/TALK",
            "narrator": "アーヤ",
            "text": "でも、トライナリーの\nリーダーとして――",
            "zh": "可是，作为三重奏的\n队长——",
            "narrator_zh": "绫水"
        },
        {
            "location": "599/TALK",
            "narrator": "小夜",
            "text": "トライナリーとか\nリーダーとかは\n関係ない。",
            "zh": "跟什么三重奏、\n什么队长都\n没有关系。",
            "narrator_zh": "小夜"
        },
        {
            "location": "600/TALK",
            "narrator": "小夜",
            "text": "アーヤが迷ってるのは、\n人として、何も間違って\nないから。",
            "zh": "绫水你会迷茫，\n只是因为作为一个普通人，\n你并没有做错任何事。",
            "narrator_zh": "小夜"
        },
        {
            "location": "601/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "602/TALK",
            "narrator": "小夜",
            "text": "もしかしたら、\nみんなからは甘いって\n言われるかもしれない。",
            "zh": "说不定，\n大家会觉得你\n太天真心软。",
            "narrator_zh": "小夜"
        },
        {
            "location": "603/TALK",
            "narrator": "小夜",
            "text": "それでも、\nあたしは今のアーヤを\n肯定するわ。",
            "zh": "即便如此，\n我也会肯定\n现在的绫水哦。",
            "narrator_zh": "小夜"
        },
        {
            "location": "604/TALK",
            "narrator": "小夜",
            "text": "みんなを護るために、\n必死に頑張ってるの\n見てるから。",
            "zh": "因为我一直看着你为了保护大家\n有多么拼命努力\n嘛。",
            "narrator_zh": "小夜"
        },
        {
            "location": "605/TALK",
            "narrator": "小夜",
            "text": "何があっても、\nアーヤのこと応援するわ。",
            "zh": "无论发生什么，\n我都会支持绫水的。",
            "narrator_zh": "小夜"
        },
        {
            "location": "606/TALK",
            "narrator": "アーヤ",
            "text": "…小夜。",
            "zh": "……小夜。",
            "narrator_zh": "绫水"
        },
        {
            "location": "607/TALK",
            "narrator": "小夜",
            "text": "ま、だからさ。",
            "zh": "嘛，所以说呀。",
            "narrator_zh": "小夜"
        },
        {
            "location": "608/TALK",
            "narrator": "小夜",
            "text": "アーヤ自身が\nどうしたいか、\n考えてみなよ。",
            "zh": "绫水你自己\n到底想怎么做，\n好好想想吧。",
            "narrator_zh": "小夜"
        },
        {
            "location": "610/TALK",
            "narrator": "アーヤ",
            "text": "…うん…うん。\nありがとう…。\nありがとう、小夜…。",
            "zh": "……嗯……嗯。\n谢谢你……。\n谢谢你，小夜……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "629/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "632/TALK",
            "narrator": "アーヤ",
            "text": "ごめん…。",
            "zh": "抱歉……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "634/TALK",
            "narrator": "小夜",
            "text": "何がよ？",
            "zh": "怎么了啦？",
            "narrator_zh": "小夜"
        },
        {
            "location": "637/TALK",
            "narrator": "アーヤ",
            "text": "みっともないところ\n見せちゃったわ…。",
            "zh": "让你看到这么丢脸的一面\n真不好意思……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "638/TALK",
            "narrator": "小夜",
            "text": "気にしてないわよ、\nこのくらいのこと。",
            "zh": "我才不会在意\n这点小事呢。",
            "narrator_zh": "小夜"
        },
        {
            "location": "639/TALK",
            "narrator": "小夜",
            "text": "それより、ちょっとは\nスッキリできた？",
            "zh": "比起那个，心里有没有\n稍微痛快一点？",
            "narrator_zh": "小夜"
        },
        {
            "location": "640/TALK",
            "narrator": "アーヤ",
            "text": "…ええ。\nおかげさまでね。",
            "zh": "……嗯。\n多亏了你呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "641/TALK",
            "narrator": "小夜",
            "text": "そ、よかった。",
            "zh": "是嘛，那就好。",
            "narrator_zh": "小夜"
        },
        {
            "location": "642/TALK",
            "narrator": "アーヤ",
            "text": "…小夜のおかげで、\nやっと自分の気持ちに\n気づけたわ。",
            "zh": "……多亏了小夜，\n我才终于看清了\n自己的心意。",
            "narrator_zh": "绫水"
        },
        {
            "location": "643/TALK",
            "narrator": "アーヤ",
            "text": "やっぱり私…、\n卯月のこと、\n信じてみたい…。",
            "zh": "果然我还是……，\n想试着去相信\n卯月……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "644/TALK",
            "narrator": "小夜",
            "text": "そっか…。",
            "zh": "这样啊……。",
            "narrator_zh": "小夜"
        },
        {
            "location": "646/TALK",
            "narrator": "アーヤ",
            "text": "みんなからは、\n甘いって言われるかも\nしれないけど。",
            "zh": "虽然大家，\n可能会说我太天真\n太心软吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "647/TALK",
            "narrator": "小夜",
            "text": "自分を誤魔化すより\nいいんじゃない？",
            "zh": "总比欺骗自己\n来得好吧？",
            "narrator_zh": "小夜"
        },
        {
            "location": "648/TALK",
            "narrator": "小夜",
            "text": "それに、甘いところが\nアーヤの数少ない\nチャームポイントでしょ？",
            "zh": "而且，有点心软这一点\n不正是绫水屈指可数的\n魅力之一嘛？",
            "narrator_zh": "小夜"
        },
        {
            "location": "650/TALK",
            "narrator": "アーヤ",
            "text": "少ない、ってのが\n引っかかるんだけど？",
            "zh": "“屈指可数”这个词\n挺让我在意的哦？",
            "narrator_zh": "绫水"
        },
        {
            "location": "651/TALK",
            "narrator": "小夜",
            "text": "いいじゃん、別に。",
            "zh": "没关系啦，别在意。",
            "narrator_zh": "小夜"
        },
        {
            "location": "652/TALK",
            "narrator": "小夜",
            "text": "それにあたし、\nアーヤのそういうとこ\n好きよ。",
            "zh": "而且我啊，\n就是喜欢绫水\n这一点哦。",
            "narrator_zh": "小夜"
        },
        {
            "location": "653/TALK",
            "narrator": "アーヤ",
            "text": "誤解を生みそうな\nこと言わないの。",
            "zh": "别说这种容易让人误会的\n话啦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "654/TALK",
            "narrator": "小夜",
            "text": "えへへ。",
            "zh": "哎嘿嘿。",
            "narrator_zh": "小夜"
        },
        {
            "location": "656/TALK",
            "narrator": "アーヤ",
            "text": "…でもまあ、\n私も友達として\n小夜のこと好きよ。",
            "zh": "……不过嘛，\n作为朋友，\n我也喜欢小夜哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "657/TALK",
            "narrator": "アーヤ",
            "text": "本当、\n心から信頼してるわ。",
            "zh": "真的，\n发自内心地信赖着你。",
            "narrator_zh": "绫水"
        },
        {
            "location": "658/TALK",
            "narrator": "小夜",
            "text": "あはは、アーヤだって\n同じようなこと\n言ってるし。",
            "zh": "啊哈哈，绫水你不也\n在说差不多的\n话嘛。",
            "narrator_zh": "小夜"
        },
        {
            "location": "659/TALK",
            "narrator": "アーヤ",
            "text": "友達としてだってば。",
            "zh": "都说了是作为朋友啦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "660/TALK",
            "narrator": "小夜",
            "text": "本当かしら？",
            "zh": "真的吗？",
            "narrator_zh": "小夜"
        },
        {
            "location": "661/TALK",
            "narrator": "アーヤ",
            "text": "何よ、期待してるの？",
            "zh": "干嘛，你在期待什么吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "662/TALK",
            "narrator": "小夜",
            "text": "なわけないじゃん。",
            "zh": "怎么可能嘛。",
            "narrator_zh": "小夜"
        },
        {
            "location": "664/TALK",
            "narrator": "小夜",
            "text": "…まあさ、甘いのは\n別にいいんだけど、\nこれだけは間違えないで。",
            "zh": "……嘛，心软倒也\n无所谓啦，\n但唯独这件事别搞错了。",
            "narrator_zh": "小夜"
        },
        {
            "location": "665/TALK",
            "narrator": "小夜",
            "text": "神楽ちゃんのこと、\n簡単に許すのはダメよ？",
            "zh": "神乐做过的事，\n可不能轻易原谅哦？",
            "narrator_zh": "小夜"
        },
        {
            "location": "666/TALK",
            "narrator": "小夜",
            "text": "つばめちゃんに\n酷いことをしたのは\n間違いないんだし。",
            "zh": "她对燕做出了\n那么过分的事\n是毋庸置疑的。",
            "narrator_zh": "小夜"
        },
        {
            "location": "667/TALK",
            "narrator": "小夜",
            "text": "そこのところは、\nきっちりケジメを\nつけさせなきゃね。",
            "zh": "这笔账，\n必须让她老老实实\n承担责任才行。",
            "narrator_zh": "小夜"
        },
        {
            "location": "668/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "673/TALK",
            "narrator": "小夜",
            "text": "あ、始まった！",
            "zh": "啊，开始了！",
            "narrator_zh": "小夜"
        },
        {
            "location": "675/TALK",
            "narrator": "アーヤ",
            "text": "…ええ。",
            "zh": "……嗯。",
            "narrator_zh": "绫水"
        },
        {
            "location": "680/TALK",
            "narrator": "アーヤ",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "绫水"
        },
        {
            "location": "693/TALK",
            "narrator": "アーヤ",
            "text": "聞いてもらえる？",
            "zh": "能听我说几句吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "695/SEL",
            "narrator": "",
            "text": "どうしたの？",
            "zh": "怎么了？",
            "narrator_zh": ""
        },
        {
            "location": "696/ACT",
            "narrator": "",
            "text": "どうしたの？",
            "zh": "怎么了？",
            "narrator_zh": ""
        },
        {
            "location": "698/TALK",
            "narrator": "アーヤ",
            "text": "私ね",
            "zh": "我啊",
            "narrator_zh": "绫水"
        },
        {
            "location": "699/TALK",
            "narrator": "アーヤ",
            "text": "決めたわ",
            "zh": "决定了哦",
            "narrator_zh": "绫水"
        },
        {
            "location": "700/TALK",
            "narrator": "アーヤ",
            "text": "卯月がしたこと",
            "zh": "卯月做过的事",
            "narrator_zh": "绫水"
        },
        {
            "location": "701/TALK",
            "narrator": "アーヤ",
            "text": "不問にはできない",
            "zh": "不能不追究",
            "narrator_zh": "绫水"
        },
        {
            "location": "704/TALK",
            "narrator": "アーヤ",
            "text": "けど",
            "zh": "但是",
            "narrator_zh": "绫水"
        },
        {
            "location": "705/TALK",
            "narrator": "アーヤ",
            "text": "つばめが言ってたけど",
            "zh": "就像燕说的那样",
            "narrator_zh": "绫水"
        },
        {
            "location": "706/TALK",
            "narrator": "アーヤ",
            "text": "卯月も被害者かもしれない",
            "zh": "卯月说不定也是受害者",
            "narrator_zh": "绫水"
        },
        {
            "location": "707/TALK",
            "narrator": "アーヤ",
            "text": "何か理由があって",
            "zh": "说不定有什么苦衷",
            "narrator_zh": "绫水"
        },
        {
            "location": "708/TALK",
            "narrator": "アーヤ",
            "text": "仕方なくスパイしたかもしれない",
            "zh": "才迫不得已当了间谍",
            "narrator_zh": "绫水"
        },
        {
            "location": "709/TALK",
            "narrator": "アーヤ",
            "text": "だから卯月には",
            "zh": "所以对卯月",
            "narrator_zh": "绫水"
        },
        {
            "location": "710/TALK",
            "narrator": "アーヤ",
            "text": "気を許さない",
            "zh": "我不会掉以轻心",
            "narrator_zh": "绫水"
        },
        {
            "location": "711/TALK",
            "narrator": "アーヤ",
            "text": "真相がわかるまで",
            "zh": "在查明真相之前",
            "narrator_zh": "绫水"
        },
        {
            "location": "712/TALK",
            "narrator": "アーヤ",
            "text": "気を許さないでいくから",
            "zh": "我绝对不会对她放松警惕",
            "narrator_zh": "绫水"
        },
        {
            "location": "713/TALK",
            "narrator": "アーヤ",
            "text": "それが",
            "zh": "这就是",
            "narrator_zh": "绫水"
        },
        {
            "location": "715/TALK",
            "narrator": "アーヤ",
            "text": "私の出した答え",
            "zh": "我得出的答案",
            "narrator_zh": "绫水"
        },
        {
            "location": "718/TALK",
            "narrator": "アーヤ",
            "text": "甘いと思う？",
            "zh": "觉得太天真了吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "720/SEL",
            "narrator": "",
            "text": "みんなの安全には気を付けてね",
            "zh": "要注意大家的安全哦",
            "narrator_zh": ""
        },
        {
            "location": "721/SEL",
            "narrator": "",
            "text": "厳しいと思う",
            "zh": "我觉得很严厉了",
            "narrator_zh": ""
        },
        {
            "location": "722/SEL",
            "narrator": "",
            "text": "チャームポイントだよ",
            "zh": "这是你的魅力所在哦",
            "narrator_zh": ""
        },
        {
            "location": "723/ACT",
            "narrator": "",
            "text": "みんなの安全には気を付けてね",
            "zh": "要注意大家的安全哦",
            "narrator_zh": ""
        },
        {
            "location": "724/TALK",
            "narrator": "アーヤ",
            "text": "もちろん",
            "zh": "那是当然",
            "narrator_zh": "绫水"
        },
        {
            "location": "725/TALK",
            "narrator": "アーヤ",
            "text": "だから気は許さない",
            "zh": "所以我才不会放松警惕",
            "narrator_zh": "绫水"
        },
        {
            "location": "726/TALK",
            "narrator": "アーヤ",
            "text": "そう決めたの",
            "zh": "我已经这么决定了",
            "narrator_zh": "绫水"
        },
        {
            "location": "727/TALK",
            "narrator": "アーヤ",
            "text": "みんなに",
            "zh": "绝不让她",
            "narrator_zh": "绫水"
        },
        {
            "location": "728/TALK",
            "narrator": "アーヤ",
            "text": "危害を加えたりさせない",
            "zh": "伤害到大家",
            "narrator_zh": "绫水"
        },
        {
            "location": "729/TALK",
            "narrator": "アーヤ",
            "text": "今の卯月が敵だってことに",
            "zh": "毕竟现在的卯月是敌人这一点",
            "narrator_zh": "绫水"
        },
        {
            "location": "730/TALK",
            "narrator": "アーヤ",
            "text": "揺るぎはないんだしね",
            "zh": "是毫无疑问的嘛",
            "narrator_zh": "绫水"
        },
        {
            "location": "731/ACT",
            "narrator": "",
            "text": "厳しいと思う",
            "zh": "我觉得很严厉了",
            "narrator_zh": ""
        },
        {
            "location": "732/TALK",
            "narrator": "アーヤ",
            "text": "そうかしら？",
            "zh": "是吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "733/TALK",
            "narrator": "アーヤ",
            "text": "これくらいはしなきゃ",
            "zh": "我觉得至少得做到这种程度",
            "narrator_zh": "绫水"
        },
        {
            "location": "734/TALK",
            "narrator": "アーヤ",
            "text": "ダメだと思うけど？",
            "zh": "才行吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "735/TALK",
            "narrator": "アーヤ",
            "text": "あれだけのことして",
            "zh": "做了那种事",
            "narrator_zh": "绫水"
        },
        {
            "location": "736/TALK",
            "narrator": "アーヤ",
            "text": "軽く済ませるなんて",
            "zh": "还想轻易揭过什么的",
            "narrator_zh": "绫水"
        },
        {
            "location": "737/TALK",
            "narrator": "アーヤ",
            "text": "絶対ダメ",
            "zh": "绝对不行",
            "narrator_zh": "绫水"
        },
        {
            "location": "738/TALK",
            "narrator": "アーヤ",
            "text": "$handle2$は",
            "zh": "$handle2$或许",
            "narrator_zh": "绫水"
        },
        {
            "location": "739/TALK",
            "narrator": "アーヤ",
            "text": "私より甘いのかも",
            "zh": "比我还要心软呢",
            "narrator_zh": "绫水"
        },
        {
            "location": "741/TALK",
            "narrator": "アーヤ",
            "text": "じゃなくて",
            "zh": "不对",
            "narrator_zh": "绫水"
        },
        {
            "location": "742/TALK",
            "narrator": "アーヤ",
            "text": "優しいのかも",
            "zh": "或许是比我更温柔吧",
            "narrator_zh": "绫水"
        },
        {
            "location": "743/ACT",
            "narrator": "",
            "text": "チャームポイントだよ",
            "zh": "这是你的魅力所在哦",
            "narrator_zh": ""
        },
        {
            "location": "744/TALK",
            "narrator": "アーヤ",
            "text": "それ",
            "zh": "那句话",
            "narrator_zh": "绫水"
        },
        {
            "location": "745/TALK",
            "narrator": "アーヤ",
            "text": "小夜の言ったことでしょ！",
            "zh": "是小夜说过的吧！",
            "narrator_zh": "绫水"
        },
        {
            "location": "746/TALK",
            "narrator": "アーヤ",
            "text": "もう",
            "zh": "真是的",
            "narrator_zh": "绫水"
        },
        {
            "location": "747/TALK",
            "narrator": "アーヤ",
            "text": "からかわないの！",
            "zh": "别拿我打趣啦！",
            "narrator_zh": "绫水"
        },
        {
            "location": "769/DIALOG",
            "narrator": "Dialog_chapter_ch02",
            "text": "【19 三戸浜からの手紙】",
            "zh": "【19 来自三户滨的信】",
            "narrator_zh": "Dialog_chapter_ch02"
        }
    ]
}
