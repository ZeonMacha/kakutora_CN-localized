{
    "dir": "chap23/daydra/dd_ch02_23_020.js",
    "type": "MainStory",
    "info": {
        "story_id": "23256",
        "cid": "ayami",
        "title": "Extra006 プレミアムストーリー",
        "sub_title": "合宿の記念",
        "title_zh": "Extra006 额外剧情",
        "sub_title_zh": "集训纪念"
    },
    "entry": [
        {
            "location": "240/SCENARIO",
            "narrator": "",
            "text": "合宿の記念",
            "zh": "集训纪念",
            "narrator_zh": ""
        },
        {
            "location": "255/TALK",
            "narrator": "アーヤ",
            "text": "…もう一枚。",
            "zh": "……再来一张。",
            "narrator_zh": "绫水"
        },
        {
            "location": "260/TALK",
            "narrator": "アーヤ",
            "text": "…ん、ＯＫ。\n綺麗に撮れたわ。",
            "zh": "……嗯，OK。\n拍得很漂亮哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "263/TALK",
            "narrator": "みやび",
            "text": "よかったね。\nじゃ、そろそろ帰るか。",
            "zh": "那就好。\n那差不多该回去了吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "266/TALK",
            "narrator": "アーヤ",
            "text": "何言ってるのよ。\nまだ一枚目でしょ？",
            "zh": "你说什么呢。\n这才第一张吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "269/TALK",
            "narrator": "みやび",
            "text": "一枚とれば十分やろ？",
            "zh": "拍一张不就够了吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "270/TALK",
            "narrator": "みやび",
            "text": "っちゅうか、こんなとこの\n写真撮る必要あるか？",
            "zh": "话说回来，这种地方\n有啥必要拍照喃？",
            "narrator_zh": "雅"
        },
        {
            "location": "271/TALK",
            "narrator": "アーヤ",
            "text": "東京に戻る前に、\n記念に撮っておきたいのよ。",
            "zh": "回东京之前，\n我想拍下来留个纪念嘛。",
            "narrator_zh": "绫水"
        },
        {
            "location": "272/TALK",
            "narrator": "みやび",
            "text": "今の時代、地図アプリで\nいくらでも写真なんぞ\n見れるやろ？",
            "zh": "都啥年代了，地图软件上\n这种照片想看多少张\n都有得看咯？",
            "narrator_zh": "雅"
        },
        {
            "location": "273/TALK",
            "narrator": "アーヤ",
            "text": "自分で撮る写真は\nそういうのとは違うの。",
            "zh": "自己亲手拍的照片\n跟那种可不一样。",
            "narrator_zh": "绫水"
        },
        {
            "location": "275/TALK",
            "narrator": "アーヤ",
            "text": "それに、案内してくれる\n約束なんだから、\n文句言わないの。",
            "zh": "而且，你可是答应了\n要给我带路的，\n别发牢骚。",
            "narrator_zh": "绫水"
        },
        {
            "location": "277/TALK",
            "narrator": "みやび",
            "text": "とほほ…。\nじゃあ、次は見飽きた\n砂浜に行くぞね。",
            "zh": "唉……。\n那下一个就去那片\n早看腻了的沙滩啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "278/TALK",
            "narrator": "アーヤ",
            "text": "見飽きた、は余計でしょ？",
            "zh": "“早看腻了”这句多余了吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "292/TALK",
            "narrator": "みやび",
            "text": "…海なんぞ撮っても、\n何も楽しくないやろ？",
            "zh": "……大海这种东西拍了，\n也没啥好玩的吧？",
            "narrator_zh": "雅"
        },
        {
            "location": "294/TALK",
            "narrator": "アーヤ",
            "text": "そんなことないわ。\n特に今日は波も穏やかで、\n綺麗に撮れるし。",
            "zh": "不会呀。\n特别是今天风平浪静的，\n拍出来可好看了。",
            "narrator_zh": "绫水"
        },
        {
            "location": "295/TALK",
            "narrator": "みやび",
            "text": "南国の透き通った海の方が\n綺麗やと思うけんどなぁ。",
            "zh": "我觉得还是南国那种清澈见底的海\n更漂亮咯，不过算了。",
            "narrator_zh": "雅"
        },
        {
            "location": "297/TALK",
            "narrator": "アーヤ",
            "text": "思い出なんだからいいのよ。\nほら、みやびもついでに\nポーズ付けて。",
            "zh": "这是留作回忆的，挺好的嘛。\n来，雅也顺便\n摆个姿势吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "298/TALK",
            "narrator": "みやび",
            "text": "…いやん。",
            "zh": "……讨厌啦。",
            "narrator_zh": "雅"
        },
        {
            "location": "304/TALK",
            "narrator": "みやび",
            "text": "撮ったが！？",
            "zh": "你真拍了啊！？",
            "narrator_zh": "雅"
        },
        {
            "location": "305/TALK",
            "narrator": "アーヤ",
            "text": "撮るって言ったでしょ。\n次は港に行きたいわ。",
            "zh": "我不是说了要拍嘛。\n接下来我想去港口。",
            "narrator_zh": "绫水"
        },
        {
            "location": "306/TALK",
            "narrator": "みやび",
            "text": "…今日のアーヤは、\n一味違う気がするちや。",
            "zh": "……今天的绫水，\n感觉和平时不太一样咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "318/TALK",
            "narrator": "アーヤ",
            "text": "うーん…、\nちょっと暗いかしら？",
            "zh": "唔……，\n是不是稍微有点暗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "322/TALK",
            "narrator": "アーヤ",
            "text": "みやびも一緒に入って。\n最高の笑顔でね。",
            "zh": "雅也一起进来。\n露出最棒的笑容哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "324/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "329/TALK",
            "narrator": "アーヤ",
            "text": "ん、完璧！\nありがとう、いい写真\n沢山撮れたわ。",
            "zh": "嗯，完美！\n谢谢，拍到了好多\n很棒的照片呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "330/TALK",
            "narrator": "みやび",
            "text": "五十八枚や。\n沢山どころの騒ぎやない。",
            "zh": "五十八张了。\n这已经不是“好多”的程度了吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "332/TALK",
            "narrator": "みやび",
            "text": "ちゅうか、いつから\n写真なんぞ趣味にしたが？",
            "zh": "话说回来，你什么时候\n把拍照这种事当成爱好了喃？",
            "narrator_zh": "雅"
        },
        {
            "location": "334/TALK",
            "narrator": "アーヤ",
            "text": "前から風景写真を\n撮るのは好きだったのよ。",
            "zh": "我以前就挺喜欢\n拍风景照的哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "335/TALK",
            "narrator": "アーヤ",
            "text": "ま、スマホのカメラで\nばっかりだったけど。",
            "zh": "嘛，不过以前基本都是\n用手机随便拍拍。",
            "narrator_zh": "绫水"
        },
        {
            "location": "337/TALK",
            "narrator": "みやび",
            "text": "それが、そんな立派な\nカメラ持つまでに\n進化したゆうわけか。",
            "zh": "现在居然都进化到\n拿着这么高级的相机\n到处拍了吗。",
            "narrator_zh": "雅"
        },
        {
            "location": "338/TALK",
            "narrator": "アーヤ",
            "text": "みやびもやってみたら？\nスマホのカメラから\n初めてみるといいわ。",
            "zh": "雅也试试看怎么样？\n可以先从手机相机\n开始拍拍看哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "339/TALK",
            "narrator": "みやび",
            "text": "そんなもんに\n大切な容量使いたく\nないちや。",
            "zh": "我才不想把\n宝贵的内存\n浪费在那种东西上面咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "340/TALK",
            "narrator": "アーヤ",
            "text": "そう言うと思った。",
            "zh": "我就知道你会这么说。",
            "narrator_zh": "绫水"
        },
        {
            "location": "341/TALK",
            "narrator": "アーヤ",
            "text": "じゃ、次行きましょ。",
            "zh": "那，我们去下一个地方吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "343/TALK",
            "narrator": "みやび",
            "text": "そう言うと思うたがよ。",
            "zh": "我就知道你会这么说咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "354/TALK",
            "narrator": "アーヤ",
            "text": "いい写真沢山撮れたわ。\nありがとう、みやび。",
            "zh": "拍到了好多好照片。\n谢谢你，雅。",
            "narrator_zh": "绫水"
        },
        {
            "location": "355/TALK",
            "narrator": "みやび",
            "text": "…うん。",
            "zh": "……嗯。",
            "narrator_zh": "雅"
        },
        {
            "location": "356/TALK",
            "narrator": "アーヤ",
            "text": "元気ないわね。\n大丈夫？",
            "zh": "你看起来没精打采的。\n没事吧？",
            "narrator_zh": "绫水"
        },
        {
            "location": "357/TALK",
            "narrator": "みやび",
            "text": "あれだけ歩かされれば、\nうちじゃなくても\nヘロヘロになるがよ。",
            "zh": "被拉着走这么多路，\n换谁都会累得\n趴下的咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "360/TALK",
            "narrator": "アーヤ",
            "text": "あ、あはは…。",
            "zh": "啊，啊哈哈……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "361/TALK",
            "narrator": "みやび",
            "text": "…まあ、えい写真撮れて\n満足したゆうなら、\nそれでえいけんど。",
            "zh": "……嘛，能拍到好照片\n让你满意了，\n那也就行咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "363/TALK",
            "narrator": "アーヤ",
            "text": "ええ、大満足よ。\n容量いっぱいに撮ったから、\n整理するのが楽しみ。",
            "zh": "嗯，超级满意。\n内存都快拍满了，\n好期待回去整理。",
            "narrator_zh": "绫水"
        },
        {
            "location": "364/TALK",
            "narrator": "アーヤ",
            "text": "そうだ、東京帰ったら\nデータ渡す？",
            "zh": "对了，回东京之后\n要我把照片传给你吗？",
            "narrator_zh": "绫水"
        },
        {
            "location": "365/TALK",
            "narrator": "みやび",
            "text": "あのなぁ…忘れちょるかも\nしれんけんど、\nここはうちの地元やぞ？",
            "zh": "那个啊……你可能忘了\n不过我提醒一哈，\n这儿可是我老家啵？",
            "narrator_zh": "雅"
        },
        {
            "location": "366/TALK",
            "narrator": "みやび",
            "text": "地元の写真なんぞもらっても\n仕方ないやろ。",
            "zh": "拿些自己老家的照片\n也没得啥用吧。",
            "narrator_zh": "雅"
        },
        {
            "location": "367/TALK",
            "narrator": "アーヤ",
            "text": "逆じゃない？\n地元だからこそ\n撮らなきゃダメでしょ。",
            "zh": "恰恰相反吧？\n正因为是老家，\n才更得拍下来呀。",
            "narrator_zh": "绫水"
        },
        {
            "location": "368/TALK",
            "narrator": "アーヤ",
            "text": "時が経てば、景色なんて\nどんどん変わっていくのよ？",
            "zh": "时间一长，风景可是会\n不断变化的哦？",
            "narrator_zh": "绫水"
        },
        {
            "location": "370/TALK",
            "narrator": "アーヤ",
            "text": "だから、今見ている光景を\n写真にして、思い出として\n残すんじゃない。",
            "zh": "所以，才要把现在眼前的景象\n拍成照片，作为回忆\n留下来嘛。",
            "narrator_zh": "绫水"
        },
        {
            "location": "371/TALK",
            "narrator": "みやび",
            "text": "あ～、無駄や無駄。\nちくっと考えてみぃ。",
            "zh": "啊～，白费劲白费劲。\n你用脑壳想一哈嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "372/TALK",
            "narrator": "みやび",
            "text": "うちが地元の写真なんぞ\n見返しながら、思い出を\n楽しむタイプに見えるか？",
            "zh": "我看上去像是那种\n会一边翻看老家照片，\n一边回味往事的人喃？",
            "narrator_zh": "雅"
        },
        {
            "location": "373/TALK",
            "narrator": "アーヤ",
            "text": "それを言われると…、\nうーん…。",
            "zh": "被你这么一说……，\n唔……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "374/SEL",
            "narrator": "",
            "text": "見直したくなる写真を撮ろう",
            "zh": "拍些以后会想翻出来看的照片吧",
            "narrator_zh": ""
        },
        {
            "location": "376/TALK",
            "narrator": "みやび",
            "text": "写真を見返しながら、\nセンチメンタル気分に浸る\nうちを想像してみぃ。",
            "zh": "你想象一哈我一边翻看照片，\n一边沉浸在多愁善感里的\n样子嘛。",
            "narrator_zh": "雅"
        },
        {
            "location": "378/TALK",
            "narrator": "みやび",
            "text": "ちくっとホラーな\n光景やと思うぞ？",
            "zh": "那画面多少有点\n恐怖片的感觉啵？",
            "narrator_zh": "雅"
        },
        {
            "location": "379/TALK",
            "narrator": "アーヤ",
            "text": "ホラーはさすがに\n言い過ぎでしょ。",
            "zh": "说是恐怖片\n也太夸张了吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "380/TALK",
            "narrator": "みやび",
            "text": "けんど、世にも不可思議\nアメイジングな姿なのは\n間違いない。",
            "zh": "不过，绝对是世间罕见\n不可思议的奇观，\n这点没跑咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "384/TALK",
            "narrator": "みやび",
            "text": "ちゅうわけやき、\n周囲のためにも\n写真は必要ないがよ。",
            "zh": "所以说嘛，\n为了周围人的心理健康，\n照片就免了咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "385/TALK",
            "narrator": "アーヤ",
            "text": "はいはい…。",
            "zh": "好好好……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "386/TALK",
            "narrator": "アーヤ",
            "text": "でも、気が変わった時は\nいつでも言ってね。",
            "zh": "不过，要是哪天改变主意了，\n随时跟我说哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "388/ACT",
            "narrator": "",
            "text": "見直したくなる写真を撮ろう",
            "zh": "拍些以后会想翻出来看的照片吧",
            "narrator_zh": ""
        },
        {
            "location": "402/TALK",
            "narrator": "アーヤ",
            "text": "簡単に言わないで(-ω-;)",
            "zh": "别说得那么轻松(-ω-;)",
            "narrator_zh": "绫水"
        },
        {
            "location": "403/TALK",
            "narrator": "アーヤ",
            "text": "そんなの",
            "zh": "那种照片",
            "narrator_zh": "绫水"
        },
        {
            "location": "404/TALK",
            "narrator": "アーヤ",
            "text": "簡単に撮れないから(￣Д￣ )",
            "zh": "哪有那么容易拍出来(￣Д￣ )",
            "narrator_zh": "绫水"
        },
        {
            "location": "406/SEL",
            "narrator": "",
            "text": "記念写真なら大丈夫",
            "zh": "拍纪念照的话就没问题",
            "narrator_zh": ""
        },
        {
            "location": "407/ACT",
            "narrator": "",
            "text": "記念写真なら大丈夫",
            "zh": "拍纪念照的话就没问题",
            "narrator_zh": ""
        },
        {
            "location": "409/TALK",
            "narrator": "アーヤ",
            "text": "記念写真ね",
            "zh": "纪念照啊",
            "narrator_zh": "绫水"
        },
        {
            "location": "410/TALK",
            "narrator": "アーヤ",
            "text": "あ(☆｡☆)",
            "zh": "啊(☆｡☆)",
            "narrator_zh": "绫水"
        },
        {
            "location": "411/TALK",
            "narrator": "アーヤ",
            "text": "いいこと思いついた(*^o^*)",
            "zh": "想到个好主意(*^o^*)",
            "narrator_zh": "绫水"
        },
        {
            "location": "416/TALK",
            "narrator": "アーヤ",
            "text": "みやび、予定変更よ。\nこの後もう一度港に\n行きましょ。",
            "zh": "雅，计划有变。\n等会儿我们再回港口\n一趟吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "418/TALK",
            "narrator": "みやび",
            "text": "はぁ！？　まだ撮るんか？",
            "zh": "啥！？　还要拍喃？",
            "narrator_zh": "雅"
        },
        {
            "location": "420/TALK",
            "narrator": "アーヤ",
            "text": "うん。\nでも、今度はちょっと\n特別なのをね。",
            "zh": "嗯。\n不过，这次要拍一张\n有点特别的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "421/TALK",
            "narrator": "みやび",
            "text": "…？",
            "zh": "……？",
            "narrator_zh": "雅"
        },
        {
            "location": "438/TALK",
            "narrator": "アーヤ",
            "text": "卯月、もうちょっとだけ\nつばめに近寄った方が\nいいかも。",
            "zh": "卯月，稍微再往\n燕那边靠一点\n比较好哦。",
            "narrator_zh": "绫水"
        },
        {
            "location": "440/TALK",
            "narrator": "神楽",
            "text": "いいんですか？\nそれじゃあ遠慮なく\n抱きしめちゃいますね。",
            "zh": "可以吗？\n那我就不客气地\n抱上去咯。",
            "narrator_zh": "神乐"
        },
        {
            "location": "443/TALK",
            "narrator": "つばめ",
            "text": "そ、そこまでしなくても\n大丈夫じゃないかな？",
            "zh": "倒、倒也不用抱得那么紧\n应该也行吧？",
            "narrator_zh": "燕"
        },
        {
            "location": "444/TALK",
            "narrator": "神楽",
            "text": "でも、そんなこと言って\n見切れちゃったら、\n悲しいです…。",
            "zh": "可是，万一没靠紧\n被截在画面外面，\n我会难过的……。",
            "narrator_zh": "神乐"
        },
        {
            "location": "449/TALK",
            "narrator": "アーヤ",
            "text": "近寄るのはちょっとで\nいいんだけど…。",
            "zh": "其实稍微靠过来一点\n就够了……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "450/TALK",
            "narrator": "ガブリエラ",
            "text": "ポーズはどうする？\nみんな同じポーズ？\nそれとも各自自由？",
            "zh": "姿势要怎么摆？\n大家摆一样的？\n还是各自自由发挥？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "451/TALK",
            "narrator": "アーヤ",
            "text": "自由でいいと思うわ。\n今からポーズ決めるのも\n面倒だし。",
            "zh": "我觉得自由发挥就行。\n现在再统一动作\n也挺麻烦的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "453/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "454/TALK",
            "narrator": "アーヤ",
            "text": "ほら、みやび。\nもっと楽しそうな顔\nしなさいよ。",
            "zh": "喂，雅。\n摆出更开心的表情\n来嘛。",
            "narrator_zh": "绫水"
        },
        {
            "location": "455/TALK",
            "narrator": "みやび",
            "text": "そう言われてもなぁ…。\nこれ、合宿記念の写真やろ？",
            "zh": "你这么说我也……。\n这可是集训纪念照吧？",
            "narrator_zh": "雅"
        },
        {
            "location": "456/TALK",
            "narrator": "みやび",
            "text": "合宿ゆうてもうちには\n帰省と変わらんのやし、\n記念感ゼロやし…。",
            "zh": "话虽说是集训，对我来说\n跟回家省亲也没差，\n完全没得纪念感啊……。",
            "narrator_zh": "雅"
        },
        {
            "location": "457/TALK",
            "narrator": "アーヤ",
            "text": "そんなことないわ。\nいい思い出になるはずよ。",
            "zh": "才没有那回事。\n一定会成为很好的回忆的。",
            "narrator_zh": "绫水"
        },
        {
            "location": "458/TALK",
            "narrator": "みやび",
            "text": "そうやろか？",
            "zh": "是那样吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "459/TALK",
            "narrator": "アーヤ",
            "text": "そうよ。",
            "zh": "就是那样。",
            "narrator_zh": "绫水"
        },
        {
            "location": "460/TALK",
            "narrator": "アーヤ",
            "text": "全員揃って三戸浜に来れる\nようなことが、またある\n保証もないんだし。",
            "zh": "以后大家全员一起到三户滨来，\n也不一定还有\n这样的机会了嘛。",
            "narrator_zh": "绫水"
        },
        {
            "location": "461/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "463/TALK",
            "narrator": "ガブリエラ",
            "text": "まあ、そうよね…。\n基本的にフェノメノンは\n都内にしか出ないんだし。",
            "zh": "嘛，倒也是呢……。\n基本上PhenoMENON也\n只会在东京都内出现。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "465/TALK",
            "narrator": "ガブリエラ",
            "text": "そんな頻繁に全員で\n東京離れるわけには\nいかないものね。",
            "zh": "我们也没法那么频繁地\n全员一起离开\n东京呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "466/TALK",
            "narrator": "アーヤ",
            "text": "そういうこと。",
            "zh": "就是这么回事。",
            "narrator_zh": "绫水"
        },
        {
            "location": "467/TALK",
            "narrator": "みやび",
            "text": "ふぅむ…。",
            "zh": "嗯唔……。",
            "narrator_zh": "雅"
        },
        {
            "location": "468/TALK",
            "narrator": "アーヤ",
            "text": "まあ、撮ったからって\nすぐ見直す写真になるとは\n限らないわ。",
            "zh": "嘛，也不是说\n拍了照片\n就马上会拿出来翻看。",
            "narrator_zh": "绫水"
        },
        {
            "location": "469/TALK",
            "narrator": "アーヤ",
            "text": "何年、何十年も後に、\n思い出として楽しむのが\n記念写真なんだし。",
            "zh": "隔了好几年、甚至几十年后再拿出来\n当成回忆慢慢回味，\n这才是纪念照嘛。",
            "narrator_zh": "绫水"
        },
        {
            "location": "470/TALK",
            "narrator": "みやび",
            "text": "そういうもんなが？",
            "zh": "是那样的吗？",
            "narrator_zh": "雅"
        },
        {
            "location": "471/TALK",
            "narrator": "アーヤ",
            "text": "そういうもんよ、\n多分ね。",
            "zh": "就是那样的，\n大概吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "473/TALK",
            "narrator": "ガブリエラ",
            "text": "ねえ、いい加減そろそろ\n撮っちゃわない？\n待ってるの退屈なんだけど？",
            "zh": "我说，差不多该\n拍了吧？\n干等着很无聊的哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "474/TALK",
            "narrator": "アーヤ",
            "text": "はいはい。\nそういうわけだから、\nみやびも笑顔でね。",
            "zh": "好好好。\n就是这样啦，\n雅也笑一个吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "475/TALK",
            "narrator": "みやび",
            "text": "…………。",
            "zh": "…………。",
            "narrator_zh": "雅"
        },
        {
            "location": "477/TALK",
            "narrator": "神楽",
            "text": "つばめさん。\nほら、ポーズ撮って\nください。",
            "zh": "燕。\n来，快摆好\n姿势吧。",
            "narrator_zh": "神乐"
        },
        {
            "location": "479/TALK",
            "narrator": "つばめ",
            "text": "う、うん。",
            "zh": "嗯、嗯。",
            "narrator_zh": "燕"
        },
        {
            "location": "481/TALK",
            "narrator": "ガブリエラ",
            "text": "オッケー。\nいつでもいいわよ。",
            "zh": "OK。\n随时都可以拍了哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "482/TALK",
            "narrator": "アーヤ",
            "text": "それじゃ撮るわよー。\n３・２・１…。",
            "zh": "那我要按下快门了哦—。\n３・２・１……。",
            "narrator_zh": "绫水"
        },
        {
            "location": "487/TALK",
            "narrator": "みやび",
            "text": "ちーず、ぞね。",
            "zh": "茄子，啵。",
            "narrator_zh": "雅"
        },
        {
            "location": "492/TALK",
            "narrator": "アーヤ",
            "text": "は！？",
            "zh": "哈！？",
            "narrator_zh": "绫水"
        },
        {
            "location": "493/TALK",
            "narrator": "みやび",
            "text": "どうや？\n上手に撮れた？",
            "zh": "咋样？\n拍得还不错吧？",
            "narrator_zh": "雅"
        },
        {
            "location": "496/TALK",
            "narrator": "つばめ",
            "text": "あの、みやびさんって\n写真にあまり興味が\nなかったんじゃ…？",
            "zh": "那个，雅不是说\n对拍照不太感\n兴趣的吗……？",
            "narrator_zh": "燕"
        },
        {
            "location": "498/TALK",
            "narrator": "みやび",
            "text": "うむ、ぶっちゃけないな。",
            "zh": "唔姆，老实说确实不感兴趣。",
            "narrator_zh": "雅"
        },
        {
            "location": "500/TALK",
            "narrator": "ガブリエラ",
            "text": "いや、説得力ないから。\n一番ノリノリでポーズ\n決めてたじゃない。",
            "zh": "喂，这话一点说服力都没有啊。\n刚才数你摆姿势摆得\n最起劲了好吗。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "501/TALK",
            "narrator": "神楽",
            "text": "もしかしてみやびさん、\n本当は撮りたかったん\nですか？",
            "zh": "难道说雅，\n其实心里还是想拍的\n吗？",
            "narrator_zh": "神乐"
        },
        {
            "location": "503/TALK",
            "narrator": "みやび",
            "text": "いつか思い出になる日が\n来るかもしれんのやろ？",
            "zh": "以后总有一天可能会变成\n拿出来回味的回忆，对吧？",
            "narrator_zh": "雅"
        },
        {
            "location": "504/TALK",
            "narrator": "みやび",
            "text": "なら、見返した時に\n笑える写真にした方が\nえいと思うたがよ。",
            "zh": "既然这样，还不如拍成以后翻看时\n能让人笑出来的照片\n更好咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "505/TALK",
            "narrator": "みやび",
            "text": "何でこんなノリノリで\n写真撮っちょるんかって、\n笑えると思うし。",
            "zh": "到时候肯定会笑话自己\n怎么拍个照\n还这么起劲咯。",
            "narrator_zh": "雅"
        },
        {
            "location": "507/TALK",
            "narrator": "ガブリエラ",
            "text": "何もそんなネタ\n仕込まなくてもいいのに…。",
            "zh": "也不用特意整这么个梗\n出来吧……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "509/TALK",
            "narrator": "つばめ",
            "text": "う～ん…わたしも何か、\n見返した時に楽しめること\nすればよかったかな？",
            "zh": "唔～……我是不是也该\n做点什么以后翻看时\n会觉得好玩的动作呀？",
            "narrator_zh": "燕"
        },
        {
            "location": "511/TALK",
            "narrator": "神楽",
            "text": "下手をすると恥ずかしい\n思い出になっちゃうから、\nオススメはしませんよ？",
            "zh": "弄不好会变成\n社死黑历史的，\n我可不推荐哦？",
            "narrator_zh": "神乐"
        },
        {
            "location": "513/TALK",
            "narrator": "アーヤ",
            "text": "まったく…。\nまあ、素敵な写真に\nなったからいいわよ。",
            "zh": "真是的……。\n算了，拍出来的照片很棒，\n这样就挺好。",
            "narrator_zh": "绫水"
        },
        {
            "location": "515/TALK",
            "narrator": "アーヤ",
            "text": "…それに、みやびも少しは\n見返そうって気持ちになって\nくれたみたいだし。",
            "zh": "……而且，雅好像也稍微\n有了点以后想翻出来\n看看的意思呢。",
            "narrator_zh": "绫水"
        },
        {
            "location": "516/TALK",
            "narrator": "アーヤ",
            "text": "…私にとっては、\nこれも一つの思い出に\nなったかも。",
            "zh": "……对我来说，\n这也算是多了一份\n美好的回忆吧。",
            "narrator_zh": "绫水"
        },
        {
            "location": "251/DIALOG",
            "narrator": "Dialog_EventData",
            "text": "<color=green>8月19日　 5:34 PM</color>\n合宿中、みやびの実家近くでのこと",
            "zh": "<color=green>8月19日　 5:34 PM</color>\n集训期间、雅的老家附近的事",
            "narrator_zh": "Dialog_EventData"
        },
        {
            "location": "527/DIALOG",
            "narrator": "Dialog_GEThimegoto_ch02",
            "text": "【セピア色には早すぎて】",
            "zh": "【泛黄褪色还为时尚早】",
            "narrator_zh": "Dialog_GEThimegoto_ch02"
        }
    ]
}
