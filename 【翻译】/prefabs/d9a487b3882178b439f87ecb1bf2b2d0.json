        {
            "location": "15/UI",
            "narrator": "CB_Main_Canvas/Panel/InfoWindow/CuranFlow/FlowGraphic/Text0",
            "text": "解決可能な\nクラン所有数？",
            "zh": "可解决的\n库兰持有数？",
            "narrator_zh": "CB_Main_Canvas/Panel/InfoWindow/CuranFlow/FlowGraphic/Text0"
        },
        {
            "location": "17/UI",
            "narrator": "CB_Main_Canvas/Panel/InfoWindow/CuranFlow/FlowGraphic/Text1",
            "text": "体以上所持",
            "zh": "只以上持有",
            "narrator_zh": "CB_Main_Canvas/Panel/InfoWindow/CuranFlow/FlowGraphic/Text1"
        },
        {
            "location": "19/UI",
            "narrator": "CB_Main_Canvas/Panel/InfoWindow/CuranFlow/FlowGraphic/Text2",
            "text": "全て所持",
            "zh": "全部持有",
            "narrator_zh": "CB_Main_Canvas/Panel/InfoWindow/CuranFlow/FlowGraphic/Text2"
        },
        {
            "location": "21/UI",
            "narrator": "CB_Main_Canvas/Panel/InfoWindow/CuranFlow/InfoText1/Text",
            "text": "以下のクランをゲットすることにより、「不安」や「辛い思い出」なら緩和され、「希望」や\n「やる気」なら、より強固なものになります。",
            "zh": "获得以下库兰后，若是“不安”或“痛苦的回忆”便会缓解，若是“希望”或\n“干劲”则会变得更加牢固。",
            "narrator_zh": "CB_Main_Canvas/Panel/InfoWindow/CuranFlow/InfoText1/Text"
        },
        {
            "location": "22/UI",
            "narrator": "CB_Main_Canvas/Panel/InfoWindow/CuranFlow/InfoText1/Text",
            "text": "体存在する。",
            "zh": "个。",
            "narrator_zh": "CB_Main_Canvas/Panel/InfoWindow/CuranFlow/InfoText1/Text"
        },
        {
            "location": "25/UI",
            "narrator": "CB_Main_Canvas/Panel/InfoWindow/EventInfo/C_Text_Info",
            "text": "全て所持で、クランとーく解禁",
            "zh": "全部持有后，解锁库兰闲聊",
