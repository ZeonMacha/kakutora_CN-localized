{
 "dir": "curantalk",
 "type": "curan_talk",
 "info": {
  "id": "curantalk_ch01_05_015"
 },
 "entry": [
  {
   "location": "1/BGM",
   "narrator": "",
   "text": "M09"
  },
  {
   "location": "2/TALK",
   "narrator": "らんちゅうさん",
   "text": "今日も朝からゆったりおさんぽ……",
   "zh": "今天也是从早上开始慢悠悠地散步……",
   "narrator_zh": "兰寿小姐"
  },
  {
   "location": "3/TALK",
   "narrator": "らんちゅうさん",
   "text": "ん……何か居る……？",
   "zh": "嗯……有什么东西在……？",
   "narrator_zh": "兰寿小姐"
  },
  {
   "location": "4/TALK",
   "narrator": "らんちゅうさん",
   "text": "…………"
  },
  {
   "location": "5/TALK",
   "narrator": "らんちゅうさん",
   "text": "あぁぁぁぁぁ！！　猫だァァァァ！！",
   "zh": "啊啊啊啊啊！！　是猫啊啊啊啊！！",
   "narrator_zh": "兰寿小姐"
  },
  {
   "location": "6/TALK",
   "narrator": "らんちゅうさん",
   "text": "猫が……ッ！　寝転んでいる……ッ！！",
   "zh": "猫……！　躺在那儿……！！",
   "narrator_zh": "兰寿小姐"
  },
  {
   "location": "7/TALK",
   "narrator": "らんちゅうさん",
   "text": "こ、殺されるっ……！",
   "zh": "要、要没命了……！",
   "narrator_zh": "兰寿小姐"
  },
  {
   "location": "8/TALK",
   "narrator": "大豊＠ちー太",
   "text": "何か大きな声が聞こえたけどどうし……",
   "zh": "听见好大的声音，怎么……",
   "narrator_zh": "大丰@千太"
  },
  {
   "location": "9/TALK",
   "narrator": "大豊＠ちー太",
   "text": "チューーーー！！　猫でチューーーっ！！",
   "zh": "喵———！！　竟然是猫———！！",
   "narrator_zh": "大丰@千太"
  },
  {
   "location": "10/TALK",
   "narrator": "らんちゅうさん",
   "text": "ひ、ひぃぃぃ……",
   "zh": "咿、咿呀呀呀……",
   "narrator_zh": "兰寿小姐"
  },
  {
   "location": "11/TALK",
   "narrator": "大豊＠ちー太",
   "text": "も、もう駄目でチュ……おしまいでチュ……",
   "zh": "已、已经不行了喵……完蛋了喵……",
   "narrator_zh": "大丰@千太"
  },
  {
   "location": "12/TALK",
   "narrator": "かおりん",
   "text": "何か大きな声が聞こえましたがどうしましたの？",
   "zh": "听见好大的声音，发生什么事了吗？",
   "narrator_zh": "香琳"
  },
  {
   "location": "13/TALK",
   "narrator": "かおりん",
   "text": "あら、可愛い猫ですわね",
   "zh": "哎呀，真是可爱的猫呢",
   "narrator_zh": "香琳"
  },
  {
   "location": "14/TALK",
   "narrator": "らんちゅうさん",
   "text": "か、可愛い……？",
   "zh": "可、可爱……？",
   "narrator_zh": "兰寿小姐"
  },
  {
   "location": "15/TALK",
   "narrator": "大豊＠ちー太",
   "text": "猫を可愛いと……？　狂気……！　狂気でチュ……！",
   "zh": "说猫可爱……？　疯了……！　这是疯了喵……！",
   "narrator_zh": "大丰@千太"
  },
  {
   "location": "16/TALK",
   "narrator": "かおりん",
   "text": "ふふ、ごろーんってしてる姿に癒されますわ",
   "zh": "呵呵，那样打滚的样子真让人治愈呢",
   "narrator_zh": "香琳"
  },
  {
   "location": "17/TALK",
   "narrator": "らんちゅうさん",
   "text": "手を出しちゃ……危ない……",
   "zh": "伸手过去会……很危险的……",
   "narrator_zh": "兰寿小姐"
  },
  {
   "location": "18/TALK",
   "narrator": "大豊＠ちー太",
   "text": "あれは罠でチュ。　だらけてるように見せて油断させる気でチュ",
   "zh": "那是陷阱喵。　是装成懒洋洋的样子让人大意的喵",
   "narrator_zh": "大丰@千太"
  },
  {
   "location": "19/TALK",
   "narrator": "かおりん",
   "text": "罠だなんて、そんなことないですわ",
   "zh": "说什么陷阱，不会那样的吧",
   "narrator_zh": "香琳"
  },
  {
   "location": "20/TALK",
   "narrator": "らんちゅうさん",
   "text": "猫を抱え上げた……！",
   "zh": "她把猫抱起来了……！",
   "narrator_zh": "兰寿小姐"
  },
  {
   "location": "21/TALK",
   "narrator": "大豊＠ちー太",
   "text": "あの猛獣を……！？　恐るべしでチュ……",
   "zh": "那头猛兽……！？　真是可怕喵……",
   "narrator_zh": "大丰@千太"
  },
  {
   "location": "22/TALK",
   "narrator": "かおりん",
   "text": "ふふ、ゴロゴロ言ってますわ",
   "zh": "呵呵，在咕噜咕噜叫呢",
   "narrator_zh": "香琳"
  },
  {
   "location": "23/TALK",
   "narrator": "かおりん",
   "text": "頭を撫でちゃいましょう",
   "zh": "来摸摸它的头吧",
   "narrator_zh": "香琳"
  },
  {
   "location": "24/TALK",
   "narrator": "かおりん",
   "text": "あらっ",
   "zh": "哎呀",
   "narrator_zh": "香琳"
  },
  {
   "location": "25/TALK",
   "narrator": "大豊＠ちー太",
   "text": "ああっ！　猫がかおりんの手を",
   "zh": "啊！　猫咬住了薰的手",
   "narrator_zh": "大丰@千太"
  },
  {
   "location": "26/TALK",
   "narrator": "らんちゅうさん",
   "text": "噛んだ……！",
   "zh": "咬……！",
   "narrator_zh": "兰寿小姐"
  },
  {
   "location": "27/TALK",
   "narrator": "かおりん",
   "text": "甘噛みですわ。　痛くありませんのよ",
   "zh": "是轻轻咬的。　一点都不疼哦",
   "narrator_zh": "香琳"
  },
  {
   "location": "28/TALK",
   "narrator": "らんちゅうさん",
   "text": "やっぱり……恐ろしい生き物……！",
   "zh": "果然……可怕的生物……！",
   "narrator_zh": "兰寿小姐"
  },
  {
   "location": "29/TALK",
   "narrator": "大豊＠ちー太",
   "text": "全ては相手を油断させるための演技だったでチュ！",
   "zh": "一切都是为了让人大意在演戏喵！",
   "narrator_zh": "大丰@千太"
  },
  {
   "location": "30/TALK",
   "narrator": "らんちゅうさん",
   "text": "やっぱり猫にはかかわるべきじゃない……！",
   "zh": "果然不该跟猫扯上关系……！",
   "narrator_zh": "兰寿小姐"
  },
  {
   "location": "31/TALK",
   "narrator": "かおりん",
   "text": "二人ともおおげさですわね",
   "zh": "你们两个都太夸张了呢",
   "narrator_zh": "香琳"
  },
  {
   "location": "32/TALK",
   "narrator": "らんちゅうさん",
   "text": "手を噛まれてなお、この余裕……",
   "zh": "被咬了手还这么从容……",
   "narrator_zh": "兰寿小姐"
  },
  {
   "location": "33/TALK",
   "narrator": "らんちゅうさん",
   "text": "かおりんは……地上最強の存在かも……",
   "zh": "薰……说不定是地表最强的存在……",
   "narrator_zh": "兰寿小姐"
  },
  {
   "location": "34/TALK",
   "narrator": "大豊＠ちー太",
   "text": "か、かおりんには逆らえないでチュね",
   "zh": "绝、绝对逆不了薰喵",
   "narrator_zh": "大丰@千太"
  },
  {
   "location": "35/TALK",
   "narrator": "かおりん",
   "text": "二人とも触ってみるといいですわ",
   "zh": "你们两个也来摸摸看就好了",
   "narrator_zh": "香琳"
  },
  {
   "location": "36/TALK",
   "narrator": "らんちゅうさん",
   "text": "わああ、近づけないで～",
   "zh": "哇啊啊，别靠过来～",
   "narrator_zh": "兰寿小姐"
  },
  {
   "location": "37/TALK",
   "narrator": "大豊＠ちー太",
   "text": "ぎゃあああ",
   "zh": "呀啊啊啊",
   "narrator_zh": "大丰@千太"
  },
  {
   "location": "38/TALK",
   "narrator": "かおりん",
   "text": "きっと猫の良さがわかりますのよ",
   "zh": "一定能明白猫的好处哦",
   "narrator_zh": "香琳"
  },
  {
   "location": "39/TALK",
   "narrator": "らんちゅうさん",
   "text": "あ……ああ……",
   "zh": "啊……啊啊……",
   "narrator_zh": "兰寿小姐"
  },
  {
   "location": "40/TALK",
   "narrator": "大豊＠ちー太",
   "text": "ら、らんちゅうさんが気絶したでチュ！",
   "zh": "兰、兰寿小姐昏过去了喵！",
   "narrator_zh": "大丰@千太"
  }
 ]
}
