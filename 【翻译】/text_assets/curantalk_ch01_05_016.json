{
    "dir": "curantalk",
    "type": "curan_talk",
    "info": {
        "id": "curantalk_ch01_05_016"
    },
    "entry": [
        {
            "location": "1/BGM",
            "narrator": "",
            "text": "M09",
            "zh": "M09",
            "narrator_zh": ""
        },
        {
            "location": "2/TALK",
            "narrator": "ピオナ",
            "text": "あのクラン、どう見ても悪霊よね……",
            "zh": "那个库兰，怎么看都是恶灵吧……",
            "narrator_zh": "皮欧娜"
        },
        {
            "location": "3/TALK",
            "narrator": "ピオナ",
            "text": "悪霊を見過ごすわけにはいかない。私が祓ってみせるわ",
            "zh": "不能对恶灵视而不见。　我来把它祓除给你看",
            "narrator_zh": "皮欧娜"
        },
        {
            "location": "4/TALK",
            "narrator": "ピオナ",
            "text": "そこのあなた！　おとなしく成仏しなさい！",
            "zh": "那边的你！　乖乖成佛吧！",
            "narrator_zh": "皮欧娜"
        },
        {
            "location": "5/TALK",
            "narrator": "月影らせん",
            "text": "え……？　急になんなの……",
            "zh": "诶……？　突然怎么了……",
            "narrator_zh": "月影螺旋"
        },
        {
            "location": "6/TALK",
            "narrator": "ピオナ",
            "text": "覚悟ッ！！",
            "zh": "觉悟吧！！",
            "narrator_zh": "皮欧娜"
        },
        {
            "location": "7/TALK",
            "narrator": "月影らせん",
            "text": "ひ、ひぃっ……",
            "zh": "咿、咿呀……",
            "narrator_zh": "月影螺旋"
        },
        {
            "location": "8/TALK",
            "narrator": "ピオナ",
            "text": "…………",
            "zh": "…………",
            "narrator_zh": "皮欧娜"
        },
        {
            "location": "9/TALK",
            "narrator": "月影らせん",
            "text": "…………？",
            "zh": "…………？",
            "narrator_zh": "月影螺旋"
        },
        {
            "location": "10/TALK",
            "narrator": "ピオナ",
            "text": "私は洋風な退魔師だから",
            "zh": "我是西式的驱魔师",
            "narrator_zh": "皮欧娜"
        },
        {
            "location": "11/TALK",
            "narrator": "ピオナ",
            "text": "和風タイプの霊の祓い方がわからないわ……",
            "zh": "不知道日式鬼灵的祓除方法……",
            "narrator_zh": "皮欧娜"
        },
        {
            "location": "12/TALK",
            "narrator": "月影らせん",
            "text": "そう言われても……",
            "zh": "你这么说我也……",
            "narrator_zh": "月影螺旋"
        },
        {
            "location": "13/TALK",
            "narrator": "戸隠ダンゾウ",
            "text": "何の騒ぎかとおもってきてみれば……何してるの",
            "zh": "我还在想是什么吵嚷，过来一看……在干什么呢",
            "narrator_zh": "户隐断藏"
        },
        {
            "location": "14/TALK",
            "narrator": "戸隠ダンゾウ",
            "text": "っていうか霊じゃなくてクランだし……",
            "zh": "再说那不是鬼，是库兰吧……",
            "narrator_zh": "户隐断藏"
        },
        {
            "location": "15/TALK",
            "narrator": "戸隠ダンゾウ",
            "text": "お祓いはできないんじゃない？",
            "zh": "祓除不了吧？",
            "narrator_zh": "户隐断藏"
        },
        {
            "location": "16/TALK",
            "narrator": "ピオナ",
            "text": "でもどう見ても霊だし……霊が近くにいるのは落ち着かないわ",
            "zh": "可怎么看都是鬼……身边有鬼总让人静不下来",
            "narrator_zh": "皮欧娜"
        },
        {
            "location": "17/TALK",
            "narrator": "戸隠ダンゾウ",
            "text": "あなたはあなたでどう見ても退魔師だしね",
            "zh": "你那边也是怎么看都是驱魔师呢",
            "narrator_zh": "户隐断藏"
        },
        {
            "location": "18/TALK",
            "narrator": "ピオナ",
            "text": "そう、私は退魔師……だからこそ霊や悪魔には負けられないの",
            "zh": "对，我是驱魔师……正因为如此，才不能在鬼和恶魔面前输",
            "narrator_zh": "皮欧娜"
        },
        {
            "location": "19/TALK",
            "narrator": "ピオナ",
            "text": "和風な除霊といえば――",
            "zh": "说到日式的除灵——",
            "narrator_zh": "皮欧娜"
        },
        {
            "location": "20/TALK",
            "narrator": "ピオナ",
            "text": "そうだ、塩！　塩があった！",
            "zh": "对了，盐！　有盐！",
            "narrator_zh": "皮欧娜"
        },
        {
            "location": "21/TALK",
            "narrator": "システム",
            "text": "～１時間後～",
            "zh": "～1小时后～",
            "narrator_zh": "系统"
        },
        {
            "location": "22/TALK",
            "narrator": "ピオナ",
            "text": "よし、大量の塩を用意したわ！",
            "zh": "好，准备了大量的盐！",
            "narrator_zh": "皮欧娜"
        },
        {
            "location": "23/TALK",
            "narrator": "戸隠ダンゾウ",
            "text": "やめといたほうがいいよ",
            "zh": "还是别了吧",
            "narrator_zh": "户隐断藏"
        },
        {
            "location": "24/TALK",
            "narrator": "ピオナ",
            "text": "この私に退治出来ない霊や悪魔はいないの！",
            "zh": "没有我治不了的鬼和恶魔！",
            "narrator_zh": "皮欧娜"
        },
        {
            "location": "25/TALK",
            "narrator": "戸隠ダンゾウ",
            "text": "どうなっても知らないわよ",
            "zh": "要是出了什么事我可不管",
            "narrator_zh": "户隐断藏"
        },
        {
            "location": "26/TALK",
            "narrator": "ピオナ",
            "text": "大丈夫、これだけあれば、反撃の余裕もあたえないわ",
            "zh": "没事，有这么多，连反击的时间都不给她",
            "narrator_zh": "皮欧娜"
        },
        {
            "location": "27/TALK",
            "narrator": "ピオナ",
            "text": "これで一撃よッ！",
            "zh": "就这一下！",
            "narrator_zh": "皮欧娜"
        },
        {
            "location": "28/TALK",
            "narrator": "月影らせん",
            "text": "ちょ……！",
            "zh": "等……！",
            "narrator_zh": "月影螺旋"
        },
        {
            "location": "29/TALK",
            "narrator": "月影らせん",
            "text": "…………",
            "zh": "…………",
            "narrator_zh": "月影螺旋"
        },
        {
            "location": "30/TALK",
            "narrator": "ピオナ",
            "text": "あ、あれ……？　効いてない？",
            "zh": "啊、咦……？　没效？",
            "narrator_zh": "皮欧娜"
        },
        {
            "location": "31/TALK",
            "narrator": "月影らせん",
            "text": "私は霊じゃなくてクランなの……！",
            "zh": "我不是鬼，是库兰……！",
            "narrator_zh": "月影螺旋"
        },
        {
            "location": "32/TALK",
            "narrator": "月影らせん",
            "text": "さすがにここまでされちゃ、そのまま返すわけにはいかないわ……！",
            "zh": "被做到这个程度，可不能就这么算了……！",
            "narrator_zh": "月影螺旋"
        },
        {
            "location": "33/TALK",
            "narrator": "ピオナ",
            "text": "あ、あー……やっぱ怒ってる？",
            "zh": "啊、啊——……果然生气了吧？",
            "narrator_zh": "皮欧娜"
        },
        {
            "location": "34/TALK",
            "narrator": "戸隠ダンゾウ",
            "text": "そりゃ誰だって怒るよ……いきなり塩まみれにされたら",
            "zh": "那谁都会生气的吧……突然被人撒一身盐",
            "narrator_zh": "户隐断藏"
        },
        {
            "location": "35/TALK",
            "narrator": "月影らせん",
            "text": "吹っ飛びなさい……！",
            "zh": "飞走吧……！",
            "narrator_zh": "月影螺旋"
        },
        {
            "location": "36/TALK",
            "narrator": "ピオナ",
            "text": "きゃああぁぁぁぁ～～～！！",
            "zh": "呀啊啊啊啊～～～！！",
            "narrator_zh": "皮欧娜"
        },
        {
            "location": "37/TALK",
            "narrator": "戸隠ダンゾウ",
            "text": "うわあ、すごい勢いで吹っ飛ばされていく……",
            "zh": "哇啊，以惊人的气势被吹飞了……",
            "narrator_zh": "户隐断藏"
        },
        {
            "location": "38/TALK",
            "narrator": "月影らせん",
            "text": "ポルターガイスト現象よ……！",
            "zh": "这是骚灵现象哦……！",
            "narrator_zh": "月影螺旋"
        },
        {
            "location": "39/TALK",
            "narrator": "戸隠ダンゾウ",
            "text": "見た目和風なのにやることは洋風なのね",
            "zh": "看着明明是和风，做的事倒是西式呢",
            "narrator_zh": "户隐断藏"
        },
        {
            "location": "40/TALK",
            "narrator": "システム",
            "text": "一方、吹っ飛んだピオナは……",
            "zh": "另一边，被吹飞的皮奥娜……",
            "narrator_zh": "系统"
        },
        {
            "location": "41/TALK",
            "narrator": "ピオナ",
            "text": "……ぐぬぬ",
            "zh": "……咕唔唔",
            "narrator_zh": "皮欧娜"
        },
        {
            "location": "42/TALK",
            "narrator": "ピオナ",
            "text": "絶対にいつの日か成仏させてみせるわ……！",
            "zh": "总有一天一定要让你成佛……！",
            "narrator_zh": "皮欧娜"
        }
    ]
}
