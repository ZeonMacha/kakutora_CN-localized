{
    "dir": "curantalk",
    "type": "curan_talk",
    "info": {
        "id": "curantalk_ch01_05_010"
    },
    "entry": [
        {
            "location": "1/BGM",
            "narrator": "",
            "text": "M09",
            "zh": "M09",
            "narrator_zh": ""
        },
        {
            "location": "2/TALK",
            "narrator": "シャムシニア",
            "text": "……ふう、今日はこれくらいでいいかしら",
            "zh": "……呼，今天就练到这里吧",
            "narrator_zh": "莎姆希尼亚"
        },
        {
            "location": "3/TALK",
            "narrator": "ミーア・フリム",
            "text": "すごいすごい！",
            "zh": "好厉害好厉害！",
            "narrator_zh": "ミーア・フリム"
        },
        {
            "location": "4/TALK",
            "narrator": "ミーア・フリム",
            "text": "私もそれくらい剣がうまく使えたらなぁ",
            "zh": "我要是也能把剑使得那么好就好了",
            "narrator_zh": "ミーア・フリム"
        },
        {
            "location": "5/TALK",
            "narrator": "シャムシニア",
            "text": "あら、見ていたのね",
            "zh": "哎呀，你一直在看啊",
            "narrator_zh": "莎姆希尼亚"
        },
        {
            "location": "6/TALK",
            "narrator": "ミーア・フリム",
            "text": "すっごくかっこよかったよ！　まるでダンスみたいな華麗な動きだね！",
            "zh": "特别帅！　动作华丽得就像在跳舞！",
            "narrator_zh": "ミーア・フリム"
        },
        {
            "location": "7/TALK",
            "narrator": "ミーア・フリム",
            "text": "私も剣を持ってるんだけど、全然うまく使えなくて……",
            "zh": "我也有剑，可是完全使不好……",
            "narrator_zh": "ミーア・フリム"
        },
        {
            "location": "8/TALK",
            "narrator": "シャムシニア",
            "text": "あなたも剣を使えるようになりたいのね",
            "zh": "你也想会用剑吧",
            "narrator_zh": "莎姆希尼亚"
        },
        {
            "location": "9/TALK",
            "narrator": "シャムシニア",
            "text": "もしよければ、私がすこしなら教えてあげるわよ",
            "zh": "如果愿意的话，我可以稍微教你一点",
            "narrator_zh": "莎姆希尼亚"
        },
        {
            "location": "10/TALK",
            "narrator": "ミーア・フリム",
            "text": "え！？　いいの！？",
            "zh": "诶！？　可以吗！？",
            "narrator_zh": "ミーア・フリム"
        },
        {
            "location": "11/TALK",
            "narrator": "シャムシニア",
            "text": "基礎的な動きならすぐに出来る様になるはずよ",
            "zh": "基础的动作应该很快就能学会哦",
            "narrator_zh": "莎姆希尼亚"
        },
        {
            "location": "12/TALK",
            "narrator": "ミーア・フリム",
            "text": "やったー！　ぜひお願いするよ！",
            "zh": "太好了！　那就拜托你啦！",
            "narrator_zh": "ミーア・フリム"
        },
        {
            "location": "13/TALK",
            "narrator": "シャムシニア",
            "text": "それじゃ、さっそく始めるわね",
            "zh": "那我们就马上开始吧",
            "narrator_zh": "莎姆希尼亚"
        },
        {
            "location": "14/TALK",
            "narrator": "ミーア・フリム",
            "text": "よーし、頑張るぞ！",
            "zh": "好——，我要努力！",
            "narrator_zh": "ミーア・フリム"
        },
        {
            "location": "15/TALK",
            "narrator": "シャムシニア",
            "text": "ではまずこう動いて――",
            "zh": "首先这样动——",
            "narrator_zh": "莎姆希尼亚"
        },
        {
            "location": "16/TALK",
            "narrator": "シャムシニア",
            "text": "そして、剣を振るッ！",
            "zh": "然后，挥剑！",
            "narrator_zh": "莎姆希尼亚"
        },
        {
            "location": "17/TALK",
            "narrator": "ミーア・フリム",
            "text": "おお……",
            "zh": "哦哦……",
            "narrator_zh": "ミーア・フリム"
        },
        {
            "location": "18/TALK",
            "narrator": "シャムシニア",
            "text": "さぁ、やってみて",
            "zh": "来，你试试看",
            "narrator_zh": "莎姆希尼亚"
        },
        {
            "location": "19/TALK",
            "narrator": "ミーア・フリム",
            "text": "こう動いて……",
            "zh": "这样动……",
            "narrator_zh": "ミーア・フリム"
        },
        {
            "location": "20/BGM",
            "narrator": "",
            "text": "▼SE：剣が飛んでいく音",
            "zh": "▼SE：剑飞出去的声音",
            "narrator_zh": ""
        },
        {
            "location": "21/TALK",
            "narrator": "シャムシニア",
            "text": "きゃあ！",
            "zh": "呀啊！",
            "narrator_zh": "莎姆希尼亚"
        },
        {
            "location": "22/TALK",
            "narrator": "ミーア・フリム",
            "text": "わわっ、手が滑っちゃった！",
            "zh": "哇哇，手滑了！",
            "narrator_zh": "ミーア・フリム"
        },
        {
            "location": "23/TALK",
            "narrator": "シャムシニア",
            "text": "危うく突き刺さるところだったわ",
            "zh": "差一点就扎上了呢",
            "narrator_zh": "莎姆希尼亚"
        },
        {
            "location": "24/TALK",
            "narrator": "ミーア・フリム",
            "text": "ごめんなさい……もう一回やるね",
            "zh": "对不起……我再试一次",
            "narrator_zh": "ミーア・フリム"
        },
        {
            "location": "25/TALK",
            "narrator": "ミーア・フリム",
            "text": "こう動いて――",
            "zh": "这样动——",
            "narrator_zh": "ミーア・フリム"
        },
        {
            "location": "26/BGM",
            "narrator": "",
            "text": "▼SE：剣が飛んでいく音",
            "zh": "▼SE：剑飞出去的声音",
            "narrator_zh": ""
        },
        {
            "location": "27/TALK",
            "narrator": "シャムシニア",
            "text": "さっきとは違うタイミングで飛ばしてくるとは……やるわね",
            "zh": "跟刚才完全不同的时机飞过来啊……你还挺有一套",
            "narrator_zh": "莎姆希尼亚"
        },
        {
            "location": "28/TALK",
            "narrator": "ミーア・フリム",
            "text": "ご、ごめんなさい",
            "zh": "对、对不起",
            "narrator_zh": "ミーア・フリム"
        },
        {
            "location": "29/TALK",
            "narrator": "シャムシニア",
            "text": "あなたはまだ剣を持つには早いわね",
            "zh": "你拿剑还太早了呢",
            "narrator_zh": "莎姆希尼亚"
        },
        {
            "location": "30/TALK",
            "narrator": "ミーア・フリム",
            "text": "そ、そんな～",
            "zh": "怎、怎么会～",
            "narrator_zh": "ミーア・フリム"
        },
        {
            "location": "31/TALK",
            "narrator": "シャムシニア",
            "text": "まずは体を動かすことに慣れるために",
            "zh": "首先要让身体习惯动起来",
            "narrator_zh": "莎姆希尼亚"
        },
        {
            "location": "32/TALK",
            "narrator": "シャムシニア",
            "text": "あなたにダンスを教えてあげる！",
            "zh": "我来教你跳舞！",
            "narrator_zh": "莎姆希尼亚"
        },
        {
            "location": "33/TALK",
            "narrator": "ミーア・フリム",
            "text": "え～、私は剣が上手くなりたいのに",
            "zh": "诶——，我明明是想练好剑法的",
            "narrator_zh": "ミーア・フリム"
        },
        {
            "location": "34/TALK",
            "narrator": "シャムシニア",
            "text": "急がば回れ、よ。　さぁ、始めましょう",
            "zh": "欲速则不达哦。　来，开始吧",
            "narrator_zh": "莎姆希尼亚"
        },
        {
            "location": "35/TALK",
            "narrator": "システム",
            "text": "～一週間後～",
            "zh": "～一周后～",
            "narrator_zh": "系统"
        },
        {
            "location": "36/TALK",
            "narrator": "ミーア・フリム",
            "text": "はっ！　せいっ！　やっ！",
            "zh": "哈！　嘿！　呀！",
            "narrator_zh": "ミーア・フリム"
        },
        {
            "location": "37/TALK",
            "narrator": "九条カルレ",
            "text": "なんて美しいダンスなの！",
            "zh": "多么美的舞姿！",
            "narrator_zh": "九条可露丽"
        },
        {
            "location": "38/TALK",
            "narrator": "頑固親父",
            "text": "ミーアちゃんのダンスはたまんねぇな！",
            "zh": "米亚的舞真是让人受不了啊！",
            "narrator_zh": "顽固老爸"
        },
        {
            "location": "39/TALK",
            "narrator": "シャムシニア",
            "text": "あなたは立派なダンサーになったわ……頑張ったわね",
            "zh": "你已经成了出色的舞者……真努力了呢",
            "narrator_zh": "莎姆希尼亚"
        },
        {
            "location": "40/TALK",
            "narrator": "ミーア・フリム",
            "text": "はい！　先生！",
            "zh": "是的！　老师！",
            "narrator_zh": "ミーア・フリム"
        },
        {
            "location": "41/TALK",
            "narrator": "ミーア・フリム",
            "text": "（あれ～？　何か忘れてる気がする……）",
            "zh": "（咦——？　好像忘了点什么……）",
            "narrator_zh": "ミーア・フリム"
        }
    ]
}
