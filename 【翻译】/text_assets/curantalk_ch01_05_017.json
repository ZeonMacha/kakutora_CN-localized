{
    "dir": "curantalk",
    "type": "curan_talk",
    "info": {
        "id": "curantalk_ch01_05_017"
    },
    "entry": [
        {
            "location": "1/BGM",
            "narrator": "",
            "text": "M09",
            "zh": "M09",
            "narrator_zh": ""
        },
        {
            "location": "2/TALK",
            "narrator": "ＮＮＭ４５",
            "text": "なんだなんだ！？",
            "zh": "怎么了怎么了！？",
            "narrator_zh": "ＮＮＭ４５"
        },
        {
            "location": "3/TALK",
            "narrator": "ドロップノッカー",
            "text": "爆発！？",
            "zh": "爆炸！？",
            "narrator_zh": "掉落敲击者"
        },
        {
            "location": "4/TALK",
            "narrator": "りりえった",
            "text": "調合をしてたら失敗しちゃった～！",
            "zh": "调配的时候搞砸了～！",
            "narrator_zh": "莉莉艾塔"
        },
        {
            "location": "5/TALK",
            "narrator": "ＮＮＭ４５",
            "text": "すごい煙が出てる！　やばいぞ！",
            "zh": "好大的烟！　糟了！",
            "narrator_zh": "ＮＮＭ４５"
        },
        {
            "location": "6/TALK",
            "narrator": "ドロップノッカー",
            "text": "これ吸うと絶対にヤバイやつだよー！",
            "zh": "吸了这个绝对要完蛋啊——！",
            "narrator_zh": "掉落敲击者"
        },
        {
            "location": "7/TALK",
            "narrator": "ＮＮＭ４５",
            "text": "りりえった、早くなんとかしろ！",
            "zh": "莉莉艾塔，快想想办法！",
            "narrator_zh": "ＮＮＭ４５"
        },
        {
            "location": "8/TALK",
            "narrator": "りりえった",
            "text": "危険な煙が出ているので近づくことができないの～！",
            "zh": "冒出危险的烟，靠不过去呀～！",
            "narrator_zh": "莉莉艾塔"
        },
        {
            "location": "9/TALK",
            "narrator": "ドロップノッカー",
            "text": "もう駄目だ、ここに居るみんなおしまいだ～！",
            "zh": "已经不行了，这里的大家全完了——！",
            "narrator_zh": "掉落敲击者"
        },
        {
            "location": "10/TALK",
            "narrator": "ＮＮＭ４５",
            "text": "ん？　あそこにいるのは……",
            "zh": "嗯？　那边的是……",
            "narrator_zh": "ＮＮＭ４５"
        },
        {
            "location": "11/TALK",
            "narrator": "exec・cord",
            "text": "…………",
            "zh": "…………",
            "narrator_zh": "exec・cord"
        },
        {
            "location": "12/TALK",
            "narrator": "ドロップノッカー",
            "text": "あのガスマスクなら……",
            "zh": "那个防毒面具的话……",
            "narrator_zh": "掉落敲击者"
        },
        {
            "location": "13/TALK",
            "narrator": "りりえった",
            "text": "あの薬品の放つ煙にも耐えられるかも！",
            "zh": "也许能扛得住那种药放出的烟！",
            "narrator_zh": "莉莉艾塔"
        },
        {
            "location": "14/TALK",
            "narrator": "りりえった",
            "text": "おねがい！　あの薬品を処理してきて！",
            "zh": "拜托！　去把那个药处理掉！",
            "narrator_zh": "莉莉艾塔"
        },
        {
            "location": "15/TALK",
            "narrator": "exec・cord",
            "text": "なんで私が……",
            "zh": "为什么是我……",
            "narrator_zh": "exec・cord"
        },
        {
            "location": "16/TALK",
            "narrator": "ＮＮＭ４５",
            "text": "今近くにいるガスマスクをつけたクランはあんたしかいないんだ！",
            "zh": "现在附近戴着防毒面具的库兰就只有你啊！",
            "narrator_zh": "ＮＮＭ４５"
        },
        {
            "location": "17/TALK",
            "narrator": "ドロップノッカー",
            "text": "そもそもガスマスクつけてる人がそんなにいないよ",
            "zh": "本来就没人会戴防毒面具吧",
            "narrator_zh": "掉落敲击者"
        },
        {
            "location": "18/TALK",
            "narrator": "りりえった",
            "text": "このままじゃここにいるみんなが危険なの！",
            "zh": "再这样下去，这里的大家都有危险！",
            "narrator_zh": "莉莉艾塔"
        },
        {
            "location": "19/TALK",
            "narrator": "exec・cord",
            "text": "仕方がない……今回は特別にいってあげる",
            "zh": "没办法……这次就特别跑一趟",
            "narrator_zh": "exec・cord"
        },
        {
            "location": "20/TALK",
            "narrator": "りりえった",
            "text": "ありがとう！",
            "zh": "谢谢！",
            "narrator_zh": "莉莉艾塔"
        },
        {
            "location": "21/TALK",
            "narrator": "ＮＮＭ４５",
            "text": "今回は特別っていうか、二度とこんな事態があってほしくないよ",
            "zh": "与其说这次特别，倒不如说别再出这种事了",
            "narrator_zh": "ＮＮＭ４５"
        },
        {
            "location": "22/TALK",
            "narrator": "ドロップノッカー",
            "text": "確かにそうだね……",
            "zh": "确实是这样……",
            "narrator_zh": "掉落敲击者"
        },
        {
            "location": "23/TALK",
            "narrator": "exec・cord",
            "text": "じゃあ、行ってくる……",
            "zh": "那，我去了……",
            "narrator_zh": "exec・cord"
        },
        {
            "location": "24/TALK",
            "narrator": "exec・cord",
            "text": "…………",
            "zh": "…………",
            "narrator_zh": "exec・cord"
        },
        {
            "location": "25/TALK",
            "narrator": "exec・cord",
            "text": "まったく、人騒がせなやつだ……バラバラにしてやろうか",
            "zh": "真是的，净给人添乱……要不要把他拆成碎片",
            "narrator_zh": "exec・cord"
        },
        {
            "location": "26/TALK",
            "narrator": "exec・cord",
            "text": "ん……・あそこで煙を出しているのが問題の薬品か",
            "zh": "嗯……那边冒烟的就是问题的药吗",
            "narrator_zh": "exec・cord"
        },
        {
            "location": "27/TALK",
            "narrator": "exec・cord",
            "text": "……来たのはいいけど、肝心の処理の仕方を聞いていない",
            "zh": "……来了是来了，可最重要怎么处理却没问",
            "narrator_zh": "exec・cord"
        },
        {
            "location": "28/TALK",
            "narrator": "exec・cord",
            "text": "一度戻るか、いや、またあいつらと話すのも面倒だ",
            "zh": "回去一趟吗，不，再跟那群家伙说话也麻烦",
            "narrator_zh": "exec・cord"
        },
        {
            "location": "29/TALK",
            "narrator": "exec・cord",
            "text": "さっと何かにつっこんでしまおう",
            "zh": "随便塞进哪里算了",
            "narrator_zh": "exec・cord"
        },
        {
            "location": "30/TALK",
            "narrator": "exec・cord",
            "text": "よし、持ちあげる……",
            "zh": "好，抱起来……",
            "narrator_zh": "exec・cord"
        },
        {
            "location": "31/TALK",
            "narrator": "exec・cord",
            "text": "きゃああぁぁっ！！",
            "zh": "呀啊啊啊！！",
            "narrator_zh": "exec・cord"
        },
        {
            "location": "32/TALK",
            "narrator": "りりえった",
            "text": "ん？今の声は……",
            "zh": "嗯？刚才的声音是……",
            "narrator_zh": "莉莉艾塔"
        },
        {
            "location": "33/TALK",
            "narrator": "ＮＮＭ４５",
            "text": "もしかして……exec・cord？",
            "zh": "难道是……exec・cord？",
            "narrator_zh": "ＮＮＭ４５"
        },
        {
            "location": "34/TALK",
            "narrator": "ドロップノッカー",
            "text": "すごいかわいい声だったよ？",
            "zh": "是特别好听的声音哦？",
            "narrator_zh": "掉落敲击者"
        },
        {
            "location": "35/TALK",
            "narrator": "ＮＮＭ４５",
            "text": "あんな恰好してるのに、なんか意外だな",
            "zh": "明明打扮成那样，还真意外啊",
            "narrator_zh": "ＮＮＭ４５"
        },
        {
            "location": "36/TALK",
            "narrator": "ドロップノッカー",
            "text": "かわいいところあるんだね～",
            "zh": "原来也有可爱的地方呢～",
            "narrator_zh": "掉落敲击者"
        },
        {
            "location": "37/TALK",
            "narrator": "りりえった",
            "text": "新発見だね～！",
            "zh": "新发现呢～！",
            "narrator_zh": "莉莉艾塔"
        },
        {
            "location": "38/TALK",
            "narrator": "exec・cord",
            "text": "お前達……人をあんな目に遭わせておいて随分楽しそうだな？",
            "zh": "你们……把我害成那样，倒挺开心是吧？",
            "narrator_zh": "exec・cord"
        },
        {
            "location": "39/TALK",
            "narrator": "りりえった",
            "text": "ひ、ひええ～！　いつの間に！",
            "zh": "咿、咿呀——！　什么时候来的！",
            "narrator_zh": "莉莉艾塔"
        },
        {
            "location": "40/TALK",
            "narrator": "ＮＮＭ４５",
            "text": "あ、いやその……",
            "zh": "啊，不，那个……",
            "narrator_zh": "ＮＮＭ４５"
        },
        {
            "location": "41/TALK",
            "narrator": "ドロップノッカー",
            "text": "逃げろ～！！",
            "zh": "快逃——！！",
            "narrator_zh": "掉落敲击者"
        },
        {
            "location": "42/TALK",
            "narrator": "exec・cord",
            "text": "全員、八つ裂きにしてやる……ッ！",
            "zh": "所有人，我全给你们撕成八块……！",
            "narrator_zh": "exec・cord"
        }
    ]
}
