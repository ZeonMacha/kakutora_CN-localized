{
    "dir": "curantalk",
    "type": "curan_talk",
    "info": {
        "id": "curantalk_ch02_05_001"
    },
    "entry": [
        {
            "location": "1/TALK",
            "narrator": "プレイヤー",
            "text": "<color=red>β2用のサンプルイベントです</color>",
            "zh": "<color=red>这是β2版用的示例事件</color>",
            "narrator_zh": "玩家"
        },
        {
            "location": "2/TALK",
            "narrator": "プレイヤー",
            "text": "<color=red>同一チャプターでは全て同じイベントが発生します</color>",
            "zh": "<color=red>同一章节内发生的事件都一样</color>",
            "narrator_zh": "玩家"
        },
        {
            "location": "3/TALK",
            "narrator": "プレイヤー",
            "text": "<color=red>予めご了承ください</color>",
            "zh": "<color=red>请事先谅解</color>",
            "narrator_zh": "玩家"
        },
        {
            "location": "4/TALK",
            "narrator": "ヴィルベルヴィンド",
            "text": "ひえー！　聞きたくないって！",
            "zh": "呜哇——！　我说了不想听！",
            "narrator_zh": "旋风"
        },
        {
            "location": "5/TALK",
            "narrator": "シルキーちゃん",
            "text": "え～？　他にもたくさんあるよ～",
            "zh": "诶～？　还有很多哦～",
            "narrator_zh": "小丝"
        },
        {
            "location": "6/TALK",
            "narrator": "ガネーシャ",
            "text": "何の話をしているの？",
            "zh": "你们在聊什么？",
            "narrator_zh": "ガネーシャ"
        },
        {
            "location": "7/TALK",
            "narrator": "シルキーちゃん",
            "text": "あれ～？　ガネーシャちゃん、何でこんなところに？",
            "zh": "咦～？　伽内什，你怎么会在这儿？",
            "narrator_zh": "小丝"
        },
        {
            "location": "8/TALK",
            "narrator": "ガネーシャ",
            "text": "ヴィルベルヴィンドに借りていた戦車の本を返しに来たのよ",
            "zh": "我来把借维尔的坦克书还给他",
            "narrator_zh": "ガネーシャ"
        },
        {
            "location": "9/TALK",
            "narrator": "ヴィルベルヴィンド",
            "text": "読み終わったのね。どうだった？",
            "zh": "看完了呢。怎么样？",
            "narrator_zh": "旋风"
        },
        {
            "location": "10/TALK",
            "narrator": "ガネーシャ",
            "text": "色々な戦車の逸話が載っていて興味深かったわ",
            "zh": "里面写了好多坦克的轶事，很有意思",
            "narrator_zh": "ガネーシャ"
        },
        {
            "location": "11/TALK",
            "narrator": "シルキーちゃん",
            "text": "虫にも色々な話があるんだよ～",
            "zh": "虫子也有很多有趣的故事哦～",
            "narrator_zh": "小丝"
        },
        {
            "location": "12/TALK",
            "narrator": "ヴィルベルヴィンド",
            "text": "だから聞きたくないって！",
            "zh": "所以我说不想听啊！",
            "narrator_zh": "旋风"
        },
        {
            "location": "13/TALK",
            "narrator": "ガネーシャ",
            "text": "虫のことも知りたいわ。良かったら聞かせてくれるかしら",
            "zh": "我也想知道虫子的事。　可以的话能不能说给我听",
            "narrator_zh": "ガネーシャ"
        },
        {
            "location": "14/TALK",
            "narrator": "ヴィルベルヴィンド",
            "text": "やめておいた方がいいのに……",
            "zh": "劝你还是别听……",
            "narrator_zh": "旋风"
        },
        {
            "location": "15/TALK",
            "narrator": "シルキーちゃん",
            "text": "そうこなくっちゃ～",
            "zh": "这才对嘛～",
            "narrator_zh": "小丝"
        },
        {
            "location": "16/TALK",
            "narrator": "ヴィルベルヴィンド",
            "text": "絶対後悔することになるから……",
            "zh": "你绝对会后悔的……",
            "narrator_zh": "旋风"
        },
        {
            "location": "17/TALK",
            "narrator": "ガネーシャ",
            "text": "何故ヴィルベルヴィンドは話を聞いていたの？",
            "zh": "维尔为什么也一直在听？",
            "narrator_zh": "ガネーシャ"
        },
        {
            "location": "18/TALK",
            "narrator": "ヴィルベルヴィンド",
            "text": "聞きたくないのにずっと話しかけてくるのよ！",
            "zh": "我不想听，可她一直搭话过来啊！",
            "narrator_zh": "旋风"
        },
        {
            "location": "19/TALK",
            "narrator": "シルキーちゃん",
            "text": "虫の素晴らしさを知ってもらおうと思ってね～",
            "zh": "我是想让你们知道虫子有多棒嘛～",
            "narrator_zh": "小丝"
        },
        {
            "location": "20/TALK",
            "narrator": "シルキーちゃん",
            "text": "意外なところで色々な虫が大活躍してるんだよ～",
            "zh": "各种虫子在意想不到的地方大显身手呢～",
            "narrator_zh": "小丝"
        },
        {
            "location": "21/TALK",
            "narrator": "ガネーシャ",
            "text": "そう……是非知っておきたいわ",
            "zh": "这样……我真想听听",
            "narrator_zh": "ガネーシャ"
        },
        {
            "location": "22/TALK",
            "narrator": "ヴィルベルヴィンド",
            "text": "大体知らなきゃ良かったことばっかりよ……",
            "zh": "全是些要是不知道就好了的事……",
            "narrator_zh": "旋风"
        },
        {
            "location": "23/TALK",
            "narrator": "シルキーちゃん",
            "text": "ガネーシャちゃんは勉強熱心だね～",
            "zh": "伽内什真是个爱学习的好孩子呢～",
            "narrator_zh": "小丝"
        },
        {
            "location": "24/TALK",
            "narrator": "シルキーちゃん",
            "text": "まあ、これでも飲みながらゆっくり聞いてよ～",
            "zh": "来，一边喝着这个一边慢慢听吧～",
            "narrator_zh": "小丝"
        },
        {
            "location": "25/TALK",
            "narrator": "ガネーシャ",
            "text": "……イチゴミルクね",
            "zh": "……是草莓牛奶啊",
            "narrator_zh": "ガネーシャ"
        },
        {
            "location": "26/TALK",
            "narrator": "ヴィルベルヴィンド",
            "text": "イチゴは嫌いじゃないし、頂くわ",
            "zh": "我不讨厌草莓，那就喝了",
            "narrator_zh": "旋风"
        },
        {
            "location": "27/TALK",
            "narrator": "シルキーちゃん",
            "text": "イチゴミルクの赤い色は",
            "zh": "草莓牛奶那红色",
            "narrator_zh": "小丝"
        },
        {
            "location": "28/TALK",
            "narrator": "シルキーちゃん",
            "text": "虫から作られた色素なのよ～",
            "zh": "是用虫子做出来的色素哦～",
            "narrator_zh": "小丝"
        },
        {
            "location": "29/TALK",
            "narrator": "ヴィルベルヴィンド",
            "text": "ぶへっ！",
            "zh": "噗嘿！",
            "narrator_zh": "旋风"
        },
        {
            "location": "30/TALK",
            "narrator": "ヴィルベルヴィンド",
            "text": "何なの！？　嫌がらせなの！？",
            "zh": "什么呀！？　你是在整人吗！？",
            "narrator_zh": "旋风"
        },
        {
            "location": "31/TALK",
            "narrator": "ガネーシャ",
            "text": "…………",
            "zh": "…………",
            "narrator_zh": "ガネーシャ"
        },
        {
            "location": "32/TALK",
            "narrator": "シルキーちゃん",
            "text": "実際に見てもらった方がわかりやすいかと思って～",
            "zh": "我想让你们实际看一看会更好懂～",
            "narrator_zh": "小丝"
        },
        {
            "location": "33/TALK",
            "narrator": "ヴィルベルヴィンド",
            "text": "も、もう飲めない……",
            "zh": "已、已经喝不下去了……",
            "narrator_zh": "旋风"
        },
        {
            "location": "34/TALK",
            "narrator": "ガネーシャ",
            "text": "世の中には、知らなければ良かったという事もあることを知ったわ……",
            "zh": "我知道了，这世上也有最好一辈子都不知道的事……",
            "narrator_zh": "ガネーシャ"
        }
    ]
}
