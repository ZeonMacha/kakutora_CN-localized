{
 "dir": "curantalk",
 "type": "curan_talk",
 "info": {
  "id": "curantalk_ch01_05_011"
 },
 "entry": [
  {
   "location": "1/BGM",
   "narrator": "",
   "text": "M09"
  },
  {
   "location": "2/TALK",
   "narrator": "ハンドレッドアイズ",
   "text": "…………"
  },
  {
   "location": "3/TALK",
   "narrator": "D　・　H　・　A",
   "text": "あのマスクの下の素顔が気になる……",
   "zh": "真想知道那面具底下是什么样子……",
   "narrator_zh": "D　・　H　・　A"
  },
  {
   "location": "4/TALK",
   "narrator": "ディオーネ",
   "text": "確かにどんな顔なのか気になりますね",
   "zh": "确实很在意是怎样的脸呢",
   "narrator_zh": "狄俄涅"
  },
  {
   "location": "5/TALK",
   "narrator": "D　・　H　・　A",
   "text": "何とかして見ることが出来ないかしら……",
   "zh": "能不能想个办法看一看……",
   "narrator_zh": "D　・　H　・　A"
  },
  {
   "location": "6/TALK",
   "narrator": "ディオーネ",
   "text": "奇襲して無理矢理剥がすというのはどうでしょう",
   "zh": "奇袭一下强行扒下来怎么样",
   "narrator_zh": "狄俄涅"
  },
  {
   "location": "7/TALK",
   "narrator": "D　・　H　・　A",
   "text": "うーん……難しそうだけど……",
   "zh": "唔嗯……听着挺难的……",
   "narrator_zh": "D　・　H　・　A"
  },
  {
   "location": "8/TALK",
   "narrator": "ドロップノッカー",
   "text": "あたしがハンマーであいつの仮面を吹っ飛ばしてあげるよ！！",
   "zh": "我用锤子把那家伙的面具砸飞！",
   "narrator_zh": "掉落敲击者"
  },
  {
   "location": "9/TALK",
   "narrator": "D　・　H　・　A",
   "text": "あっ、まずは策を練らないと……！",
   "zh": "啊，得先想好计策……！",
   "narrator_zh": "D　・　H　・　A"
  },
  {
   "location": "10/TALK",
   "narrator": "ドロップノッカー",
   "text": "そりゃあぁぁぁ～～～！！",
   "zh": "那——就——来——啦～～！",
   "narrator_zh": "掉落敲击者"
  },
  {
   "location": "11/TALK",
   "narrator": "ハンドレッドアイズ",
   "text": "……何奴！"
  },
  {
   "location": "12/TALK",
   "narrator": "ドロップノッカー",
   "text": "があぁぁぁっ！",
   "zh": "嘎啊啊啊！",
   "narrator_zh": "掉落敲击者"
  },
  {
   "location": "13/TALK",
   "narrator": "D　・　H　・　A",
   "text": "頭をわしづかみにっ！？",
   "zh": "脑袋被一把抓住了！？",
   "narrator_zh": "D　・　H　・　A"
  },
  {
   "location": "14/TALK",
   "narrator": "ハンドレッドアイズ",
   "text": "……ふんっ！！",
   "zh": "……哼！！",
   "narrator_zh": "百眼"
  },
  {
   "location": "15/TALK",
   "narrator": "ドロップノッカー",
   "text": "ギャアアァァァ！",
   "zh": "呀啊啊啊啊！",
   "narrator_zh": "掉落敲击者"
  },
  {
   "location": "16/TALK",
   "narrator": "D　・　H　・　A",
   "text": "……なんということなの",
   "zh": "……怎么会这样",
   "narrator_zh": "D　・　H　・　A"
  },
  {
   "location": "17/TALK",
   "narrator": "D　・　H　・　A",
   "text": "ドロップノッカーが地面に埋められてしまった……",
   "zh": "敲击被埋进地里了……",
   "narrator_zh": "D　・　H　・　A"
  },
  {
   "location": "18/TALK",
   "narrator": "ディオーネ",
   "text": "恐ろしいパワーです……",
   "zh": "好可怕的力量……",
   "narrator_zh": "狄俄涅"
  },
  {
   "location": "19/TALK",
   "narrator": "D　・　H　・　A",
   "text": "無理矢理に剥がそうとするのは自分たちの命が危ないわね",
   "zh": "硬扒的话，我们的命会不保呢",
   "narrator_zh": "D　・　H　・　A"
  },
  {
   "location": "20/TALK",
   "narrator": "パティスリア",
   "text": "じゃあ美味しいお菓子を渡して、食べる為に外させるというのはどうかしら！",
   "zh": "那拿好吃的点心过去，让她为了吃摘下面具怎么样！",
   "narrator_zh": "帕蒂斯莉亚"
  },
  {
   "location": "21/TALK",
   "narrator": "D　・　H　・　A",
   "text": "それは良い作戦ね！",
   "zh": "那是个好计策呢！",
   "narrator_zh": "D　・　H　・　A"
  },
  {
   "location": "22/TALK",
   "narrator": "パティスリア",
   "text": "よーし、私の一番の自信作を持って行くよ",
   "zh": "好——，那就带上我最得意的作品",
   "narrator_zh": "帕蒂斯莉亚"
  },
  {
   "location": "23/TALK",
   "narrator": "D　・　H　・　A",
   "text": "あのお菓子を食べる時に素顔が見れるはず……",
   "zh": "吃那个点心的时候应该能看到真面目……",
   "narrator_zh": "D　・　H　・　A"
  },
  {
   "location": "24/TALK",
   "narrator": "パティスリア",
   "text": "ハンドレッドアイズさん～、お茶の時間にしましょう～",
   "zh": "百眼小姐～，来喝个茶吧～",
   "narrator_zh": "帕蒂斯莉亚"
  },
  {
   "location": "25/TALK",
   "narrator": "ハンドレッドアイズ",
   "text": "不要だ",
   "zh": "不必",
   "narrator_zh": "百眼"
  },
  {
   "location": "26/TALK",
   "narrator": "パティスリア",
   "text": "えー、美味しいのに",
   "zh": "诶——，明明很好吃",
   "narrator_zh": "帕蒂斯莉亚"
  },
  {
   "location": "27/TALK",
   "narrator": "ハンドレッドアイズ",
   "text": "私はそんなものに興味はない",
   "zh": "我对那种东西没兴趣",
   "narrator_zh": "百眼"
  },
  {
   "location": "28/TALK",
   "narrator": "ハンドレッドアイズ",
   "text": "私が求めるのは圧倒的な力のみ……",
   "zh": "我追求的只有压倒性的力量……",
   "narrator_zh": "百眼"
  },
  {
   "location": "29/TALK",
   "narrator": "パティスリア",
   "text": "むむむ……",
   "zh": "唔唔唔……",
   "narrator_zh": "帕蒂斯莉亚"
  },
  {
   "location": "30/TALK",
   "narrator": "D　・　H　・　A",
   "text": "やはり一筋縄ではいかないわね",
   "zh": "果然不是那么容易啊",
   "narrator_zh": "D　・　H　・　A"
  },
  {
   "location": "31/TALK",
   "narrator": "パティスリア",
   "text": "（こうなったらやはり強硬手段ね）",
   "zh": "（既然如此，果然还是得用强硬手段）",
   "narrator_zh": "帕蒂斯莉亚"
  },
  {
   "location": "32/TALK",
   "narrator": "パティスリア",
   "text": "あ！？　あれは何！？",
   "zh": "啊！？　那是什么！？",
   "narrator_zh": "帕蒂斯莉亚"
  },
  {
   "location": "33/TALK",
   "narrator": "ハンドレッドアイズ",
   "text": "む……？",
   "zh": "嗯……？",
   "narrator_zh": "百眼"
  },
  {
   "location": "34/TALK",
   "narrator": "パティスリア",
   "text": "今だっ！　仮面を取るわ！",
   "zh": "就是现在！　我要摘面具！",
   "narrator_zh": "帕蒂斯莉亚"
  },
  {
   "location": "35/TALK",
   "narrator": "ハンドレッドアイズ",
   "text": "くっ、お前も仮面を狙ってくるか！",
   "zh": "唔，你也冲着面具来的吗！",
   "narrator_zh": "百眼"
  },
  {
   "location": "36/TALK",
   "narrator": "パティスリア",
   "text": "あぁぁれぇぇぇぇ～～……",
   "zh": "啊——啦咦咦咦咦～～……",
   "narrator_zh": "帕蒂斯莉亚"
  },
  {
   "location": "37/TALK",
   "narrator": "ハンドレッドアイズ",
   "text": "……何なのだあいつらは……",
   "zh": "……那些家伙到底是什么……",
   "narrator_zh": "百眼"
  },
  {
   "location": "38/TALK",
   "narrator": "D　・　H　・　A",
   "text": "素顔を見るのはあきらめた方がよさそうね……",
   "zh": "看来还是放弃看真面目比较好……",
   "narrator_zh": "D　・　H　・　A"
  },
  {
   "location": "39/TALK",
   "narrator": "ドロップノッカー",
   "text": "（誰か引っ張り出して……）",
   "zh": "（谁来把我拽出来……）",
   "narrator_zh": "掉落敲击者"
  }
 ]
}
