{
    "dir": "curantalk",
    "type": "curan_talk",
    "info": {
        "id": "curantalk_ch01_05_013"
    },
    "entry": [
        {
            "location": "1/BGM",
            "narrator": "",
            "text": "M09",
            "zh": "M09",
            "narrator_zh": ""
        },
        {
            "location": "2/TALK",
            "narrator": "ファイアリリー",
            "text": "新しい花火がアイデアが思い浮かばないねぇ",
            "zh": "新烟花的点子想不出来啊",
            "narrator_zh": "烈焰百合"
        },
        {
            "location": "3/TALK",
            "narrator": "りりえった",
            "text": "何をしてるんですか？",
            "zh": "你在做什么呢？",
            "narrator_zh": "莉莉艾塔"
        },
        {
            "location": "4/TALK",
            "narrator": "ファイアリリー",
            "text": "おや、りりえったかい。　新作の花火を考えているんだよ",
            "zh": "哦，是莉莉艾塔啊。　我在想新作的烟花",
            "narrator_zh": "烈焰百合"
        },
        {
            "location": "5/TALK",
            "narrator": "りりえった",
            "text": "へー、何か思いつきそうですか？",
            "zh": "嚯——，有想到什么吗？",
            "narrator_zh": "莉莉艾塔"
        },
        {
            "location": "6/TALK",
            "narrator": "ファイアリリー",
            "text": "んー、それがうまくいかないんだよねぇ",
            "zh": "嗯——，这个就是不太顺",
            "narrator_zh": "烈焰百合"
        },
        {
            "location": "7/TALK",
            "narrator": "ファイアリリー",
            "text": "変わった色や形の花火とかが作れればいいんだけどねぇ",
            "zh": "要是能做出颜色和形状都特别的烟花就好了",
            "narrator_zh": "烈焰百合"
        },
        {
            "location": "8/TALK",
            "narrator": "りりえった",
            "text": "それなら私の調合品を試してみますか？",
            "zh": "那要不要试试我调配的东西？",
            "narrator_zh": "莉莉艾塔"
        },
        {
            "location": "9/TALK",
            "narrator": "りりえった",
            "text": "不思議な光を出す薬品などもありますよ",
            "zh": "我也有能发出奇妙光芒的药品哦",
            "narrator_zh": "莉莉艾塔"
        },
        {
            "location": "10/TALK",
            "narrator": "ファイアリリー",
            "text": "おお、それは興味深いね",
            "zh": "哦哦，那倒有意思",
            "narrator_zh": "烈焰百合"
        },
        {
            "location": "11/TALK",
            "narrator": "ファイアリリー",
            "text": "是非お願いしようかね",
            "zh": "那就拜托你了",
            "narrator_zh": "烈焰百合"
        },
        {
            "location": "12/TALK",
            "narrator": "りりえった",
            "text": "わかりました！　それじゃあ作ってきますね！",
            "zh": "明白了！　那我去做！",
            "narrator_zh": "莉莉艾塔"
        },
        {
            "location": "13/TALK",
            "narrator": "ファイアリリー",
            "text": "ふふ、どんな花火が出来るか楽しみだな",
            "zh": "呵呵，会做出什么样的烟花呢，真期待",
            "narrator_zh": "烈焰百合"
        },
        {
            "location": "14/TALK",
            "narrator": "システム",
            "text": "～翌日～",
            "zh": "～次日～",
            "narrator_zh": "系统"
        },
        {
            "location": "15/TALK",
            "narrator": "りりえった",
            "text": "出来ました！",
            "zh": "做好了！",
            "narrator_zh": "莉莉艾塔"
        },
        {
            "location": "16/TALK",
            "narrator": "ファイアリリー",
            "text": "おお、さっそく試してみよう",
            "zh": "哦哦，马上来试试",
            "narrator_zh": "烈焰百合"
        },
        {
            "location": "17/TALK",
            "narrator": "りりえった",
            "text": "では花火玉の中にこの薬品を入れてください",
            "zh": "请把这个药品放进烟花筒里",
            "narrator_zh": "莉莉艾塔"
        },
        {
            "location": "18/TALK",
            "narrator": "ファイアリリー",
            "text": "わかったよ！",
            "zh": "知道了！",
            "narrator_zh": "烈焰百合"
        },
        {
            "location": "19/TALK",
            "narrator": "ファイアリリー",
            "text": "よーし、新作の完成だ―！",
            "zh": "好——，新作完成——！",
            "narrator_zh": "烈焰百合"
        },
        {
            "location": "20/TALK",
            "narrator": "りりえった",
            "text": "さあ、飛ばしてみましょう",
            "zh": "来，放上去试试吧",
            "narrator_zh": "莉莉艾塔"
        },
        {
            "location": "21/TALK",
            "narrator": "ファイアリリー",
            "text": "いくぞー、それっ！！",
            "zh": "走——，来！",
            "narrator_zh": "烈焰百合"
        },
        {
            "location": "22/TALK",
            "narrator": "りりえった",
            "text": "…………",
            "zh": "…………",
            "narrator_zh": "莉莉艾塔"
        },
        {
            "location": "23/TALK",
            "narrator": "りりえった",
            "text": "あれ？　飛ばない？",
            "zh": "咦？　不飞？",
            "narrator_zh": "莉莉艾塔"
        },
        {
            "location": "24/TALK",
            "narrator": "ファイアリリー",
            "text": "おかしいな……ちょっと様子を見てみよ――",
            "zh": "奇怪啊……稍微看看情况——",
            "narrator_zh": "烈焰百合"
        },
        {
            "location": "25/TALK",
            "narrator": "ファイアリリー",
            "text": "わああぁぁ！！",
            "zh": "哇啊啊啊！！",
            "narrator_zh": "烈焰百合"
        },
        {
            "location": "26/TALK",
            "narrator": "りりえった",
            "text": "ぼ、暴発！？",
            "zh": "炸、炸膛了！？",
            "narrator_zh": "莉莉艾塔"
        },
        {
            "location": "27/TALK",
            "narrator": "ファイアリリー",
            "text": "なんか妙な液体が飛び散った！！",
            "zh": "有什么奇怪的液体溅出来了！！",
            "narrator_zh": "烈焰百合"
        },
        {
            "location": "28/TALK",
            "narrator": "ファイアリリー",
            "text": "ひぇっ、当たった所が溶けてるよ",
            "zh": "咿！　溅到的地方在化掉！",
            "narrator_zh": "烈焰百合"
        },
        {
            "location": "29/TALK",
            "narrator": "ファイアリリー",
            "text": "いったいどんな薬品を使ったんだい！？",
            "zh": "你到底用的什么药啊！？",
            "narrator_zh": "烈焰百合"
        },
        {
            "location": "30/TALK",
            "narrator": "りりえった",
            "text": "え、えへへー……",
            "zh": "诶、诶嘿嘿——……",
            "narrator_zh": "莉莉艾塔"
        },
        {
            "location": "31/TALK",
            "narrator": "りりえった",
            "text": "実はまだ試したことがなかった調合品なの……",
            "zh": "其实那是还没试过的调配品……",
            "narrator_zh": "莉莉艾塔"
        },
        {
            "location": "32/TALK",
            "narrator": "ファイアリリー",
            "text": "そんなものを使わせるんじゃないよ……",
            "zh": "别让人用那种东西啊……",
            "narrator_zh": "烈焰百合"
        },
        {
            "location": "33/TALK",
            "narrator": "シルキーちゃん",
            "text": "ちょっと～！　羽が焦げちゃったじゃない。　何してるの！",
            "zh": "喂——！　我的翅膀都被烧焦了。　你在干什么！",
            "narrator_zh": "小丝"
        },
        {
            "location": "34/TALK",
            "narrator": "ファイアリリー",
            "text": "ちょっと新作の花火を試していただけで……",
            "zh": "只是试了一下新作的烟花……",
            "narrator_zh": "烈焰百合"
        },
        {
            "location": "35/TALK",
            "narrator": "シルキーちゃん",
            "text": "危ないからもう花火禁止！！",
            "zh": "太危险了，以后禁止放烟花！！",
            "narrator_zh": "小丝"
        },
        {
            "location": "36/TALK",
            "narrator": "ファイアリリー",
            "text": "ええ～……これから何を生きがいに生きればいいんだ～！",
            "zh": "诶——……那我以后靠什么活啊——！",
            "narrator_zh": "烈焰百合"
        }
    ]
}
