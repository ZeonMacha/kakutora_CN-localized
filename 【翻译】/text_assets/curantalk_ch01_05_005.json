{
    "dir": "curantalk",
    "type": "curan_talk",
    "info": {
        "id": "curantalk_ch01_05_005"
    },
    "entry": [
        {
            "location": "1/BGM",
            "narrator": "",
            "text": "M09",
            "zh": "M09",
            "narrator_zh": ""
        },
        {
            "location": "2/TALK",
            "narrator": "劇団ボッチ",
            "text": "いいよー、なにしてあそぶ？",
            "zh": "好啊——，玩什么？",
            "narrator_zh": "剧团独行"
        },
        {
            "location": "3/TALK",
            "narrator": "グランドブロウ",
            "text": "オイラの怪獣を使って何かやろうよ",
            "zh": "用我的怪兽来玩点什么吧",
            "narrator_zh": "巨力打击"
        },
        {
            "location": "4/TALK",
            "narrator": "劇団ボッチ",
            "text": "わぁ！　それたのしそう！",
            "zh": "哇！　那好像很好玩！",
            "narrator_zh": "剧团独行"
        },
        {
            "location": "5/TALK",
            "narrator": "劇団ボッチ",
            "text": "かいじゅうでだれかをおそっちゃおう！",
            "zh": "用怪兽去袭击谁吧！",
            "narrator_zh": "剧团独行"
        },
        {
            "location": "6/TALK",
            "narrator": "グランドブロウ",
            "text": "んー、襲うのはさすがにマズイから驚かせたりしようよ",
            "zh": "嗯——袭击还是不太好，就吓一吓吧",
            "narrator_zh": "巨力打击"
        },
        {
            "location": "7/TALK",
            "narrator": "劇団ボッチ",
            "text": "じゃあそうしよう！",
            "zh": "那就这么办！",
            "narrator_zh": "剧团独行"
        },
        {
            "location": "8/TALK",
            "narrator": "グランドブロウ",
            "text": "誰かが通りがかったら、劇団ボッチが声をかけて",
            "zh": "要是有人路过，剧团孤零零你去搭话",
            "narrator_zh": "巨力打击"
        },
        {
            "location": "9/TALK",
            "narrator": "グランドブロウ",
            "text": "その隙にオイラが後ろから驚かせるよ",
            "zh": "趁那会儿我从后面吓他",
            "narrator_zh": "巨力打击"
        },
        {
            "location": "10/TALK",
            "narrator": "劇団ボッチ",
            "text": "わかったー！",
            "zh": "知道了——！",
            "narrator_zh": "剧团独行"
        },
        {
            "location": "11/TALK",
            "narrator": "グランドブロウ",
            "text": "お、ちょうど誰か来たぞー",
            "zh": "哦，正好有人来了——",
            "narrator_zh": "巨力打击"
        },
        {
            "location": "12/TALK",
            "narrator": "劇団ボッチ",
            "text": "さくせんかいしだー",
            "zh": "作战开始——",
            "narrator_zh": "剧团独行"
        },
        {
            "location": "13/TALK",
            "narrator": "黒松林キョウ",
            "text": "この盆栽は最高の自信作だ……",
            "zh": "这盆盆栽是我最得意的作品……",
            "narrator_zh": "黑松林京"
        },
        {
            "location": "14/TALK",
            "narrator": "黒松林キョウ",
            "text": "これは皆に自慢しにいかないと！",
            "zh": "这个得拿去向大家炫耀一下！",
            "narrator_zh": "黑松林京"
        },
        {
            "location": "15/TALK",
            "narrator": "劇団ボッチ",
            "text": "ねーねー、それなーに？",
            "zh": "喂——喂——，那个是什么？",
            "narrator_zh": "剧团独行"
        },
        {
            "location": "16/TALK",
            "narrator": "黒松林キョウ",
            "text": "これは盆栽といってね、それはそれは素晴らしい物なんだよ",
            "zh": "这个叫盆栽，是那可真是了不得的东西哦",
            "narrator_zh": "黑松林京"
        },
        {
            "location": "17/TALK",
            "narrator": "劇団ボッチ",
            "text": "へー、おもしろいねー",
            "zh": "嚯——，真有意思——",
            "narrator_zh": "剧团独行"
        },
        {
            "location": "18/TALK",
            "narrator": "グランドブロウ",
            "text": "がおーーーーー！！",
            "zh": "嗷————！！",
            "narrator_zh": "巨力打击"
        },
        {
            "location": "19/TALK",
            "narrator": "黒松林キョウ",
            "text": "わあああああ！！　バケモノだーーー！！",
            "zh": "哇啊啊啊啊！！　怪物——！！",
            "narrator_zh": "黑松林京"
        },
        {
            "location": "20/TALK",
            "narrator": "グランドブロウ",
            "text": "わははははは！",
            "zh": "哇哈哈哈哈！",
            "narrator_zh": "巨力打击"
        },
        {
            "location": "21/TALK",
            "narrator": "劇団ボッチ",
            "text": "わーいわーい！",
            "zh": "好呀好呀！",
            "narrator_zh": "剧团独行"
        },
        {
            "location": "22/TALK",
            "narrator": "黒松林キョウ",
            "text": "あああ……僕の……自信作が……",
            "zh": "啊啊啊……我的……得意之作……",
            "narrator_zh": "黑松林京"
        },
        {
            "location": "23/TALK",
            "narrator": "黒松林キョウ",
            "text": "…………",
            "zh": "…………",
            "narrator_zh": "黑松林京"
        },
        {
            "location": "24/TALK",
            "narrator": "グランドブロウ",
            "text": "ビックリ大成功だー！",
            "zh": "吓人作战大成功——！",
            "narrator_zh": "巨力打击"
        },
        {
            "location": "25/TALK",
            "narrator": "劇団ボッチ",
            "text": "やったやったー！",
            "zh": "干得好干得好——！",
            "narrator_zh": "剧团独行"
        },
        {
            "location": "26/TALK",
            "narrator": "黒松林キョウ",
            "text": "ゆ……許さん",
            "zh": "我……我可饶不了你们",
            "narrator_zh": "黑松林京"
        },
        {
            "location": "27/TALK",
            "narrator": "黒松林キョウ",
            "text": "許さんぞぉぉぉ！　子供のしたこととはいえこれは許さん！",
            "zh": "饶不了你们啊啊啊！　就算是小孩子干的，这个也饶不了！",
            "narrator_zh": "黑松林京"
        },
        {
            "location": "28/TALK",
            "narrator": "黒松林キョウ",
            "text": "お、お前達をBONSAIにシテヤル……！",
            "zh": "你、你们，我要把你们做成ＢＯＮＳＡＩ……！",
            "narrator_zh": "黑松林京"
        },
        {
            "location": "29/TALK",
            "narrator": "劇団ボッチ",
            "text": "ひ、ひえーー！",
            "zh": "咿、咿呀——！",
            "narrator_zh": "剧团独行"
        },
        {
            "location": "30/TALK",
            "narrator": "グランドブロウ",
            "text": "めちゃくちゃ怒ってる！",
            "zh": "他气得不得了！",
            "narrator_zh": "巨力打击"
        },
        {
            "location": "31/TALK",
            "narrator": "劇団ボッチ",
            "text": "こ、これはあやまったほうがいいよ！　ぼんさいにされちゃうよ",
            "zh": "这、这个还是道歉比较好！　不然要被做成盆栽了！",
            "narrator_zh": "剧团独行"
        },
        {
            "location": "32/TALK",
            "narrator": "グランドブロウ",
            "text": "ご、ごめんよ！　まさかそんなに大事な物を持ってたとは……",
            "zh": "对、对不起！　没想到你拿着那么重要的东西……",
            "narrator_zh": "巨力打击"
        },
        {
            "location": "33/TALK",
            "narrator": "劇団ボッチ",
            "text": "ごめんなさい……",
            "zh": "对不起……",
            "narrator_zh": "剧团独行"
        },
        {
            "location": "34/TALK",
            "narrator": "黒松林キョウ",
            "text": "僕の盆栽をどうしてくれるんだい……",
            "zh": "我的盆栽你打算怎么办……",
            "narrator_zh": "黑松林京"
        },
        {
            "location": "35/TALK",
            "narrator": "グランドブロウ",
            "text": "そ、そうだ！　オイラが怪獣を使ってすごく大きな盆栽を作ってあげるよ！",
            "zh": "对、对了！　我用怪兽给你做一个特别大的盆栽！",
            "narrator_zh": "巨力打击"
        },
        {
            "location": "36/TALK",
            "narrator": "黒松林キョウ",
            "text": "巨大盆栽……？それは新しい！　新たなジャンルを切り開けるぞ！",
            "zh": "巨大盆栽……？那倒是新鲜！　能开拓新的门类了！",
            "narrator_zh": "黑松林京"
        },
        {
            "location": "37/TALK",
            "narrator": "黒松林キョウ",
            "text": "では、さっそく作業に取り掛かるぞ！",
            "zh": "那么，马上开工！",
            "narrator_zh": "黑松林京"
        },
        {
            "location": "38/TALK",
            "narrator": "グランドブロウ",
            "text": "（これからは怪獣を悪いことに使うのはやめよう……）",
            "zh": "（以后不能再把怪兽用在坏事上了……）",
            "narrator_zh": "巨力打击"
        },
        {
            "location": "39/TALK",
            "narrator": "劇団ボッチ",
            "text": "（……あれ？　おっきいぼんさいってただの き じゃない？）",
            "zh": "（……咦？　大盆栽不就是一棵大树吗？）",
            "narrator_zh": "剧团独行"
        }
    ]
}
