{
    "dir": "curantalk",
    "type": "curan_talk",
    "info": {
        "id": "curantalk_ch01_05_020"
    },
    "entry": [
        {
            "location": "1/BGM",
            "narrator": "",
            "text": "M09",
            "zh": "M09",
            "narrator_zh": ""
        },
        {
            "location": "2/TALK",
            "narrator": "緋之十鳥・程悠",
            "text": "今日は！　金曜日！",
            "zh": "今天是！　星期五！",
            "narrator_zh": "绯之十鸟·程悠"
        },
        {
            "location": "3/TALK",
            "narrator": "緋之十鳥・程悠",
            "text": "明日は土曜日！　明後日は日曜日！",
            "zh": "明天是星期六！　后天是星期日！",
            "narrator_zh": "绯之十鸟·程悠"
        },
        {
            "location": "4/TALK",
            "narrator": "緋之十鳥・程悠",
            "text": "さあ今から楽しい花金タイムだよー！！",
            "zh": "来，现在开始就是开心的花金时光——！！",
            "narrator_zh": "绯之十鸟·程悠"
        },
        {
            "location": "5/TALK",
            "narrator": "緋之十鳥・程悠",
            "text": "この時のために月曜日から頑張ってきたようなものだよ～",
            "zh": "简直像是从周一起就为了这一刻在努力呢～",
            "narrator_zh": "绯之十鸟·程悠"
        },
        {
            "location": "6/TALK",
            "narrator": "緋之十鳥・程悠",
            "text": "さて、一緒に盛り上がるクランを探そうかな～",
            "zh": "那么，去找能一起热闹起来的库兰吧～",
            "narrator_zh": "绯之十鸟·程悠"
        },
        {
            "location": "7/TALK",
            "narrator": "緋之十鳥・程悠",
            "text": "パーッといっちゃうよ～！",
            "zh": "放开了嗨起来——！",
            "narrator_zh": "绯之十鸟·程悠"
        },
        {
            "location": "8/TALK",
            "narrator": "チュートリエル",
            "text": "そこのお前っ！",
            "zh": "那边的你！",
            "narrator_zh": "图里尔"
        },
        {
            "location": "9/TALK",
            "narrator": "緋之十鳥・程悠",
            "text": "なにやつっ！？",
            "zh": "什么人！？",
            "narrator_zh": "绯之十鸟·程悠"
        },
        {
            "location": "10/TALK",
            "narrator": "チュートリエル",
            "text": "週末だからといって浮かれるのは許さんっ！！",
            "zh": "别以为到了周末就能得意忘形！！",
            "narrator_zh": "图里尔"
        },
        {
            "location": "11/TALK",
            "narrator": "チュートリエル",
            "text": "そうやってハメを外すやつがいると風紀が乱れ――",
            "zh": "有人像那样放飞自我，风气就会乱——",
            "narrator_zh": "图里尔"
        },
        {
            "location": "12/TALK",
            "narrator": "チュートリエル",
            "text": "やがては学級崩壊に繋がるんだ！",
            "zh": "早晚会闹到班级崩坏的！",
            "narrator_zh": "图里尔"
        },
        {
            "location": "13/TALK",
            "narrator": "緋之十鳥・程悠",
            "text": "べつにここ、学級じゃないよ！",
            "zh": "可这里又不是班级！",
            "narrator_zh": "绯之十鸟·程悠"
        },
        {
            "location": "14/TALK",
            "narrator": "チュートリエル",
            "text": "集団行動という点では同じだ",
            "zh": "在集体行动这一点上是一样的",
            "narrator_zh": "图里尔"
        },
        {
            "location": "15/TALK",
            "narrator": "緋之十鳥・程悠",
            "text": "休みのときはゆっくり休むことも――",
            "zh": "休息的时候好好休息，也是——",
            "narrator_zh": "绯之十鸟·程悠"
        },
        {
            "location": "16/TALK",
            "narrator": "緋之十鳥・程悠",
            "text": "日々を頑張るうえで大事なことだよ！",
            "zh": "为了平时努力下去很重要的事！",
            "narrator_zh": "绯之十鸟·程悠"
        },
        {
            "location": "17/TALK",
            "narrator": "チュートリエル",
            "text": "いいや！　そういうときにこそ",
            "zh": "不对！　正因为是那种时候",
            "narrator_zh": "图里尔"
        },
        {
            "location": "18/TALK",
            "narrator": "チュートリエル",
            "text": "気を引き締めて普段の生活を振り返るべきだ！",
            "zh": "才该绷紧精神，回顾平时的生活！",
            "narrator_zh": "图里尔"
        },
        {
            "location": "19/TALK",
            "narrator": "緋之十鳥・程悠",
            "text": "そんな風に気を張り詰めっぱなしだと",
            "zh": "一直那样绷着精神",
            "narrator_zh": "绯之十鸟·程悠"
        },
        {
            "location": "20/TALK",
            "narrator": "緋之十鳥・程悠",
            "text": "疲れちゃって実力も発揮出来なくなっちゃうよ",
            "zh": "会累得发挥不出实力的哦",
            "narrator_zh": "绯之十鸟·程悠"
        },
        {
            "location": "21/TALK",
            "narrator": "緋之十鳥・程悠",
            "text": "だからこうやって、金曜の夜から日曜の夜までの間に",
            "zh": "所以就要像这样，从周五晚上到周日晚上",
            "narrator_zh": "绯之十鸟·程悠"
        },
        {
            "location": "22/TALK",
            "narrator": "緋之十鳥・程悠",
            "text": "月曜日から頑張れるだけのエネルギーを蓄えるんだよ！",
            "zh": "把从周一能好好努把力的能量攒起来呀！",
            "narrator_zh": "绯之十鸟·程悠"
        },
        {
            "location": "23/TALK",
            "narrator": "チュートリエル",
            "text": "ええい……屁理屈を！",
            "zh": "唔嗯……尽是歪理！",
            "narrator_zh": "图里尔"
        },
        {
            "location": "24/TALK",
            "narrator": "チュートリエル",
            "text": "とにかく！　風紀を乱す可能性をある行為を",
            "zh": "总之！　对可能扰乱风气的行为",
            "narrator_zh": "图里尔"
        },
        {
            "location": "25/TALK",
            "narrator": "チュートリエル",
            "text": "認めるわけにはいかない！",
            "zh": "我可不能认可！",
            "narrator_zh": "图里尔"
        },
        {
            "location": "26/TALK",
            "narrator": "緋之十鳥・程悠",
            "text": "むう～！　このわからず屋め！",
            "zh": "唔唔——！　你这个死脑筋！",
            "narrator_zh": "绯之十鸟·程悠"
        },
        {
            "location": "27/TALK",
            "narrator": "白騎士さん",
            "text": "あのー、盛り上がっているところ失礼しますが……",
            "zh": "那个，打扰你们兴致了，不过……",
            "narrator_zh": "白骑士小姐"
        },
        {
            "location": "28/TALK",
            "narrator": "白騎士さん",
            "text": "私たちはクランなので仕事も学校もないですし",
            "zh": "我们是库兰，既没有工作也没有学校",
            "narrator_zh": "白骑士小姐"
        },
        {
            "location": "29/TALK",
            "narrator": "白騎士さん",
            "text": "曜日を気にする必要はないのでは？",
            "zh": "好像没必要在意星期几吧？",
            "narrator_zh": "白骑士小姐"
        },
        {
            "location": "30/TALK",
            "narrator": "緋之十鳥・程悠",
            "text": "た、確かに……！",
            "zh": "确、确实……！",
            "narrator_zh": "绯之十鸟·程悠"
        },
        {
            "location": "31/TALK",
            "narrator": "緋之十鳥・程悠",
            "text": "土日というだけで浮かれた気分になっていたけど",
            "zh": "光是周末就莫名兴奋起来，可其实",
            "narrator_zh": "绯之十鸟·程悠"
        },
        {
            "location": "32/TALK",
            "narrator": "緋之十鳥・程悠",
            "text": "普段と何も変わることないや……",
            "zh": "跟平时什么都没变呢……",
            "narrator_zh": "绯之十鸟·程悠"
        },
        {
            "location": "33/TALK",
            "narrator": "チュートリエル",
            "text": "そうだな……戦闘のときは",
            "zh": "是啊……战斗的时候",
            "narrator_zh": "图里尔"
        },
        {
            "location": "34/TALK",
            "narrator": "チュートリエル",
            "text": "土日でも関係なく戦うことになるしな……",
            "zh": "就算是周末也照样要打……",
            "narrator_zh": "图里尔"
        },
        {
            "location": "35/TALK",
            "narrator": "チュートリエル",
            "text": "確かに我々に曜日は関係ない",
            "zh": "确实星期几跟我们没关系",
            "narrator_zh": "图里尔"
        },
        {
            "location": "36/TALK",
            "narrator": "緋之十鳥・程悠",
            "text": "んー、それはそれでメリハリがなくて楽しみがないなあ",
            "zh": "嗯——，那这样一来没个张弛，也没乐趣了啊",
            "narrator_zh": "绯之十鸟·程悠"
        },
        {
            "location": "37/TALK",
            "narrator": "チュートリエル",
            "text": "曜日が曖昧だからこそ常に気を引き締めなければ！",
            "zh": "正因为星期几暧昧，才得时刻提着精神！",
            "narrator_zh": "图里尔"
        },
        {
            "location": "38/TALK",
            "narrator": "緋之十鳥・程悠",
            "text": "いや、ハッキリと土日みたいなパーッとする日を設けるべきだよ！",
            "zh": "不，就该明确设一个像周末那样放开了嗨的日子！",
            "narrator_zh": "绯之十鸟·程悠"
        },
        {
            "location": "39/TALK",
            "narrator": "白騎士さん",
            "text": "あらら……結局言い争いは終わらないのですね",
            "zh": "哎呀呀……结果还是吵不完呢",
            "narrator_zh": "白骑士小姐"
        }
    ]
}
