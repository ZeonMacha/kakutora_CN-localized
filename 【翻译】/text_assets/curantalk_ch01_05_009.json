    "dir": "curantalk",
    "type": "curan_talk",
    "info": {
        "id": "curantalk_ch01_05_009"
    },
    "entry": [
        {
            "location": "1/BGM",
            "narrator": "",
            "text": "M09",
            "zh": "M09",
            "narrator_zh": ""
        },
        {
            "location": "2/TALK",
            "narrator": "霊幻坊",
            "text": "喝！　喝！　かぁーつ！",
            "zh": "喝！　喝！　哈——！",
            "narrator_zh": "灵幻坊"
        },
        {
            "location": "3/TALK",
            "narrator": "サナトリウム",
            "text": "…………",
            "zh": "…………",
            "narrator_zh": "疗养院"
        },
        {
            "location": "4/TALK",
            "narrator": "黒騎士さん",
            "text": "アンタよりアタシの方が絶対強いね！",
            "zh": "我绝对比你强！",
            "narrator_zh": "黑骑士"
        },
        {
            "location": "5/TALK",
            "narrator": "呂なんとか",
            "text": "なんだと！？　俺より強い奴なんているはずがねぇ！",
            "zh": "你说什么！？　怎么可能有比我强的家伙！",
            "narrator_zh": "吕某"
        },
        {
            "location": "6/TALK",
            "narrator": "黒騎士さん",
            "text": "やるか！？　この！！",
            "zh": "要来吗！？　你这！",
            "narrator_zh": "黑骑士"
        },
        {
            "location": "7/TALK",
            "narrator": "サナトリウム",
            "text": "…………騒がしい",
            "zh": "…………真吵",
            "narrator_zh": "疗养院"
        },
        {
            "location": "8/TALK",
            "narrator": "サナトリウム",
            "text": "どうしてこうも、うるさいクランが多いのかしら……",
            "zh": "怎么会有这么多吵闹的库兰呢……",
            "narrator_zh": "疗养院"
        },
        {
            "location": "9/TALK",
            "narrator": "サナトリウム",
            "text": "私はもう少し静かに暮らしたいのだけど……",
            "zh": "我只想安安静静地过日子……",
            "narrator_zh": "疗养院"
        },
        {
            "location": "10/TALK",
            "narrator": "呂なんとか",
            "text": "よし！　勝負だ！！　どっちが強いか決めるぜ！",
            "zh": "好！　决胜负！！　来比比谁更强！",
            "narrator_zh": "吕某"
        },
        {
            "location": "11/TALK",
            "narrator": "黒騎士さん",
            "text": "望むところだよ！　うおぉぉぉぉぉ！！",
            "zh": "正合我意！　噢噢噢噢！！",
            "narrator_zh": "黑骑士"
        },
        {
            "location": "12/TALK",
            "narrator": "サナトリウム",
            "text": "あなた達、もっと静かにしてもらえないかしら",
            "zh": "你们能不能安静一点",
            "narrator_zh": "疗养院"
        },
        {
            "location": "13/TALK",
            "narrator": "呂なんとか",
            "text": "お？　なんだよ！",
            "zh": "哦？　怎么了！",
            "narrator_zh": "吕某"
        },
        {
            "location": "14/TALK",
            "narrator": "黒騎士さん",
            "text": "邪魔しようってのかい！？",
            "zh": "想来碍事吗！？",
            "narrator_zh": "黑骑士"
        },
        {
            "location": "15/TALK",
            "narrator": "サナトリウム",
            "text": "あなた達のどっちが強いかなんてどうでもいいから、静かにしなさい",
            "zh": "你们俩谁更强我都无所谓，安静点",
            "narrator_zh": "疗养院"
        },
        {
            "location": "16/TALK",
            "narrator": "呂なんとか",
            "text": "どうでもいいとはなんだ！",
            "zh": "什么叫无所谓！",
            "narrator_zh": "吕某"
        },
        {
            "location": "17/TALK",
            "narrator": "黒騎士さん",
            "text": "むしろアンタが少し静かすぎるんじゃないかい？",
            "zh": "倒不如说你安静过头了吧？",
            "narrator_zh": "黑骑士"
        },
        {
            "location": "18/TALK",
            "narrator": "呂なんとか",
            "text": "そうだぜ。　もっと熱くならねぇとつまんねぇぜ！？",
            "zh": "就是啊。　不更热血一点就没意思了！？",
            "narrator_zh": "吕某"
        },
        {
            "location": "19/TALK",
            "narrator": "サナトリウム",
            "text": "別につまらなくてもいいから私はゆっくり静かに過ごしたいの",
            "zh": "有没有意思都无所谓，我只想安安静静地过",
            "narrator_zh": "疗养院"
        },
        {
            "location": "20/TALK",
            "narrator": "サナトリウム",
            "text": "……そういうわけだから、もう少し落ち着いて頂戴",
            "zh": "……就是这样，麻烦你们再收敛一点",
            "narrator_zh": "疗养院"
        },
        {
            "location": "21/TALK",
            "narrator": "呂なんとか",
            "text": "なんだよ……まったく",
            "zh": "什么嘛……真是的",
            "narrator_zh": "吕某"
        },
        {
            "location": "22/TALK",
            "narrator": "黒騎士さん",
            "text": "ほっとけばいいさ。　さあ、勝負の続きだよ",
            "zh": "别管她了。　来，接着打",
            "narrator_zh": "黑骑士"
        },
        {
            "location": "23/TALK",
            "narrator": "呂なんとか",
            "text": "おう、気を取り直して行くぜ！",
            "zh": "好，重新打起精神来！",
            "narrator_zh": "吕某"
        },
        {
            "location": "24/TALK",
            "narrator": "黒騎士さん",
            "text": "おりゃあぁぁぁぁ！！",
            "zh": "噢啦啦啦啦！！",
            "narrator_zh": "黑骑士"
        },
        {
            "location": "25/TALK",
            "narrator": "呂なんとか",
            "text": "せやあぁぁぁぁ！！",
            "zh": "嘿呀啊啊啊啊！！",
            "narrator_zh": "吕某"
        },
        {
            "location": "26/TALK",
            "narrator": "サナトリウム",
            "text": "…………！",
            "zh": "…………！",
            "narrator_zh": "疗养院"
        },
        {
            "location": "27/TALK",
            "narrator": "サナトリウム",
            "text": "ええーい！　うるさぁぁぁぁぁぁぁい！！！",
            "zh": "够——了！　吵——死——了——！！！",
            "narrator_zh": "疗养院"
        },
        {
            "location": "28/TALK",
            "narrator": "サナトリウム",
            "text": "ホントなんなの！？騒がないと死ぬの！？",
            "zh": "到底是怎么回事！？不吵就会死吗！？",
            "narrator_zh": "疗养院"
        },
        {
            "location": "29/TALK",
            "narrator": "サナトリウム",
            "text": "いい加減にしないとこの鎌で頭を斬り落とすわよ！？",
            "zh": "再不收敛，我就用这把镰刀把头砍下来哦！？",
            "narrator_zh": "疗养院"
        },
        {
            "location": "30/TALK",
            "narrator": "黒騎士さん",
            "text": "ひ、ひぃ",
            "zh": "咿、咿呀",
            "narrator_zh": "黑骑士"
        },
        {
            "location": "31/TALK",
            "narrator": "呂なんとか",
            "text": "サ、サナトリウムがブチ切れた……！？",
            "zh": "疗、疗养院发飙了……！？",
            "narrator_zh": "吕某"
        },
        {
            "location": "32/TALK",
            "narrator": "サナトリウム",
            "text": "そうね、首を斬ってしまえば静かになるわね……！",
            "zh": "是啊，把头砍掉就安静了呢……！",
            "narrator_zh": "疗养院"
        },
        {
            "location": "33/TALK",
            "narrator": "呂なんとか",
            "text": "お、落ち着けよ……悪かった、少し騒ぎ過ぎたぜ",
            "zh": "冷、冷静点……对不起，我们吵得太过了",
            "narrator_zh": "吕某"
        },
        {
            "location": "34/TALK",
            "narrator": "黒騎士さん",
            "text": "これからは迷惑にならないようにするよ……",
            "zh": "以后我们会注意不添麻烦的……",
            "narrator_zh": "黑骑士"
        },
        {
            "location": "35/TALK",
            "narrator": "サナトリウム",
            "text": "またうるさくしたら頭と体が離れることになるわ……覚えておきなさい",
            "zh": "再吵起来，头和身子就会分家……记住了",
            "narrator_zh": "疗养院"
        },
        {
            "location": "36/TALK",
            "narrator": "黒騎士さん",
            "text": "は、はい……",
            "zh": "是、是……",
            "narrator_zh": "黑骑士"
        },
        {
            "location": "37/TALK",
            "narrator": "呂なんとか",
            "text": "行っちまった……",
            "zh": "走了……",
            "narrator_zh": "吕某"
        },
        {
            "location": "38/TALK",
            "narrator": "黒騎士さん",
            "text": "今後サナトリウムの前では静かにしような……",
            "zh": "以后在疗养院面前还是安静点吧……",
            "narrator_zh": "黑骑士"
        },
        {
            "location": "39/TALK",
            "narrator": "呂なんとか",
            "text": "まさかキレるとあんなことになるとは……",
            "zh": "没想到她一发作会变成那样……",
            "narrator_zh": "吕某"
        },
        {
            "location": "40/TALK",
            "narrator": "サナトリウム",
            "text": "（さて……これで静かに過ごせるわね）",
            "zh": "（好了……这样就能安静地过了）",
            "narrator_zh": "疗养院"
        }
    ]
}
