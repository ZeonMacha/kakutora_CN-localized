{
 "dir": "curantalk",
 "type": "curan_talk",
 "info": {
  "id": "curantalk_ch01_05_012"
 },
 "entry": [
  {
   "location": "1/BGM",
   "narrator": "",
   "text": "M09"
  },
  {
   "location": "2/TALK",
   "narrator": "マリン・ザ・リード",
   "text": "やっぱり魔法使いはこうじゃなきゃ",
   "zh": "魔法师果然就得是这样",
   "narrator_zh": "玛琳·泽·里德"
  },
  {
   "location": "3/TALK",
   "narrator": "劇団ボッチ",
   "text": "わー、まほうつかいだー",
   "zh": "哇——，是魔法师——",
   "narrator_zh": "剧团独行"
  },
  {
   "location": "4/TALK",
   "narrator": "劇団ボッチ",
   "text": "ねーねー、まほうつかってー！",
   "zh": "喂——喂——，施个魔法嘛——！",
   "narrator_zh": "剧团独行"
  },
  {
   "location": "5/TALK",
   "narrator": "マリン・ザ・リード",
   "text": "……えーとね、これは魔法使いのかっこうをしているだけで",
   "zh": "……那个呀，这只是魔法师的打扮",
   "narrator_zh": "玛琳·泽·里德"
  },
  {
   "location": "6/TALK",
   "narrator": "マリン・ザ・リード",
   "text": "お姉ちゃんは本当は魔法使いじゃないの",
   "zh": "姐姐其实不是魔法师哦",
   "narrator_zh": "玛琳·泽·里德"
  },
  {
   "location": "7/TALK",
   "narrator": "劇団ボッチ",
   "text": "えー……まほうつかいのぼうしかぶってるのに……",
   "zh": "诶——……明明戴着魔法师的帽子……",
   "narrator_zh": "剧团独行"
  },
  {
   "location": "8/TALK",
   "narrator": "マリン・ザ・リード",
   "text": "（すごく残念そう……)",
   "zh": "（好失望的样子……）",
   "narrator_zh": "玛琳·泽·里德"
  },
  {
   "location": "9/TALK",
   "narrator": "マリン・ザ・リード",
   "text": "…………"
  },
  {
   "location": "10/TALK",
   "narrator": "マリン・ザ・リード",
   "text": "というのは世を忍ぶ仮の姿！！",
   "zh": "那只是为掩人耳目的伪装！！",
   "narrator_zh": "玛琳·泽·里德"
  },
  {
   "location": "11/TALK",
   "narrator": "マリン・ザ・リード",
   "text": "本当は世界中に名を馳せるすっごい魔法使いなのよ！",
   "zh": "其实我是名扬全世界的超厉害魔法师哦！",
   "narrator_zh": "玛琳·泽·里德"
  },
  {
   "location": "12/TALK",
   "narrator": "劇団ボッチ",
   "text": "ほんとう！？",
   "zh": "真的！？",
   "narrator_zh": "剧团独行"
  },
  {
   "location": "13/TALK",
   "narrator": "劇団ボッチ",
   "text": "じゃあまほうみせてみせてー！",
   "zh": "那就施个魔法给我看看嘛——！",
   "narrator_zh": "剧团独行"
  },
  {
   "location": "14/TALK",
   "narrator": "マリン・ザ・リード",
   "text": "（とは言ったものの、どうしよう……)",
   "zh": "（话虽这么说，怎么办……）",
   "narrator_zh": "玛琳·泽·里德"
  },
  {
   "location": "15/TALK",
   "narrator": "マリン・ザ・リード",
   "text": "そうね、それじゃあ魔法の準備をするから",
   "zh": "这样吧，我去准备魔法",
   "narrator_zh": "玛琳·泽·里德"
  },
  {
   "location": "16/TALK",
   "narrator": "マリン・ザ・リード",
   "text": "１時間くらい待ってもらえるかしら？",
   "zh": "能等一个小时左右吗？",
   "narrator_zh": "玛琳·泽·里德"
  },
  {
   "location": "17/TALK",
   "narrator": "劇団ボッチ",
   "text": "わかったー！",
   "zh": "知道了——！",
   "narrator_zh": "剧团独行"
  },
  {
   "location": "18/TALK",
   "narrator": "システム",
   "text": "～１時間後～"
  },
  {
   "location": "19/TALK",
   "narrator": "リーヴィア・プラト",
   "text": "……で、本物の魔法使いの私に手伝わせようっていうのね",
   "zh": "……所以，你是要让真正的魔法师我来帮忙？",
   "narrator_zh": "リーヴィア・プラト"
  },
  {
   "location": "20/TALK",
   "narrator": "マリン・ザ・リード",
   "text": "あとで何かあげるからお願い！",
   "zh": "之后我会给你点什么的，拜托啦！",
   "narrator_zh": "玛琳·泽·里德"
  },
  {
   "location": "21/TALK",
   "narrator": "リーヴィア・プラト",
   "text": "仕方ないわね……",
   "zh": "真拿你没办法……",
   "narrator_zh": "リーヴィア・プラト"
  },
  {
   "location": "22/TALK",
   "narrator": "リーヴィア・プラト",
   "text": "私が炎を出すから、それに合わせて魔法を使うフリをするのよ",
   "zh": "我放火，你就配合着装成在施魔法",
   "narrator_zh": "リーヴィア・プラト"
  },
  {
   "location": "23/TALK",
   "narrator": "マリン・ザ・リード",
   "text": "ありがとう！",
   "zh": "谢谢！",
   "narrator_zh": "玛琳·泽·里德"
  },
  {
   "location": "24/TALK",
   "narrator": "マリン・ザ・リード",
   "text": "よーし、それじゃあ始めるよ",
   "zh": "好——，那就开始啰",
   "narrator_zh": "玛琳·泽·里德"
  },
  {
   "location": "25/TALK",
   "narrator": "劇団ボッチ",
   "text": "わーい！",
   "zh": "好耶——！",
   "narrator_zh": "剧团独行"
  },
  {
   "location": "26/TALK",
   "narrator": "マリン・ザ・リード",
   "text": "それ、炎よ出ろ～！",
   "zh": "来，火焰，出来～！",
   "narrator_zh": "玛琳·泽·里德"
  },
  {
   "location": "27/TALK",
   "narrator": "リーヴィア・プラト",
   "text": "（もうちょっと格好いい出し方しなさいよ）",
   "zh": "（麻烦放得再帅一点啊）",
   "narrator_zh": "リーヴィア・プラト"
  },
  {
   "location": "28/TALK",
   "narrator": "劇団ボッチ",
   "text": "すごいすごい！",
   "zh": "好厉害好厉害！",
   "narrator_zh": "剧团独行"
  },
  {
   "location": "29/TALK",
   "narrator": "マリン・ザ・リード",
   "text": "（いい感じね、楽しくなってきたわ！)",
   "zh": "（不错呢，越玩越开心了！）",
   "narrator_zh": "玛琳·泽·里德"
  },
  {
   "location": "30/TALK",
   "narrator": "マリン・ザ・リード",
   "text": "よし、次は炎で渦を描くよ！",
   "zh": "好，接下来用火焰画个漩涡！",
   "narrator_zh": "玛琳·泽·里德"
  },
  {
   "location": "31/TALK",
   "narrator": "リーヴィア・プラト",
   "text": "（ちょっと、勝手なこと言わないで！）",
   "zh": "（喂，别自作主张乱说！）",
   "narrator_zh": "リーヴィア・プラト"
  },
  {
   "location": "32/TALK",
   "narrator": "マリン・ザ・リード",
   "text": "それ～！　さらに４方向に同時に出すよー！",
   "zh": "来～！　再同时朝四个方向放——！",
   "narrator_zh": "玛琳·泽·里德"
  },
  {
   "location": "33/TALK",
   "narrator": "リーヴィア・プラト",
   "text": "（仕方ない……合わせるしかないわね）",
   "zh": "（没办法……只能配合了）",
   "narrator_zh": "リーヴィア・プラト"
  },
  {
   "location": "34/TALK",
   "narrator": "マリン・ザ・リード",
   "text": "次は……って、ん？",
   "zh": "接下来是……唔，嗯？",
   "narrator_zh": "玛琳·泽·里德"
  },
  {
   "location": "35/TALK",
   "narrator": "マリン・ザ・リード",
   "text": "わぁぁぁ！　壁に燃え移ってる！！",
   "zh": "哇啊啊！　墙烧起来了！！",
   "narrator_zh": "玛琳·泽·里德"
  },
  {
   "location": "36/TALK",
   "narrator": "リーヴィア・プラト",
   "text": "しまった！　制御しきれなかったわ！",
   "zh": "糟了！　没能控制住！",
   "narrator_zh": "リーヴィア・プラト"
  },
  {
   "location": "37/TALK",
   "narrator": "劇団ボッチ",
   "text": "かじだー！！",
   "zh": "着火了——！！",
   "narrator_zh": "剧团独行"
  },
  {
   "location": "38/TALK",
   "narrator": "リーヴィア・プラト",
   "text": "水の魔法で消火するわ！！",
   "zh": "我用水的魔法来灭火！！",
   "narrator_zh": "リーヴィア・プラト"
  },
  {
   "location": "39/TALK",
   "narrator": "劇団ボッチ",
   "text": "わ、わぁ。　まほうつかいがもうひとり……",
   "zh": "哇、哇啊。　还有一个魔法师……",
   "narrator_zh": "剧团独行"
  },
  {
   "location": "40/TALK",
   "narrator": "マリン・ザ・リード",
   "text": "あー……実はさっきのはウソで、本当の魔法使いはこの人なの……",
   "zh": "啊——……其实刚才那是骗人的，真正的魔法师是这个人……",
   "narrator_zh": "玛琳·泽·里德"
  },
  {
   "location": "41/TALK",
   "narrator": "劇団ボッチ",
   "text": "えぇ～……",
   "zh": "诶——……",
   "narrator_zh": "剧团独行"
  },
  {
   "location": "42/TALK",
   "narrator": "リーヴィア・プラト",
   "text": "出来ないことは無理するべきじゃないわね",
   "zh": "做不到的事，还是不该勉强呢",
   "narrator_zh": "リーヴィア・プラト"
  },
  {
   "location": "43/TALK",
   "narrator": "マリン・ザ・リード",
   "text": "そうだね……",
   "zh": "是啊……",
   "narrator_zh": "玛琳·泽·里德"
  }
 ]
}
