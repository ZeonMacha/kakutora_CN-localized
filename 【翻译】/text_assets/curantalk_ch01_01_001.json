{
 "dir": "curantalk",
 "type": "curan_talk",
 "info": {
  "id": "curantalk_ch01_01_001"
 },
 "entry": [
  {
   "location": "1/BGM",
   "narrator": "",
   "text": "M09"
  },
  {
   "location": "2/TALK",
   "narrator": "前衛教育委員会",
   "text": "大事なのは個性だ！",
   "zh": "重要的是个性！",
   "narrator_zh": "前卫教育委员会"
  },
  {
   "location": "3/TALK",
   "narrator": "前衛教育委員会",
   "text": "そして、きみたちは個性がかぶっている！",
   "zh": "而且，你们的个性撞车了！",
   "narrator_zh": "前卫教育委员会"
  },
  {
   "location": "4/TALK",
   "narrator": "ルビィマセマティカ",
   "text": "なんだって？",
   "zh": "你说什么？",
   "narrator_zh": "红玉算法"
  },
  {
   "location": "5/TALK",
   "narrator": "雷帝ディアナ",
   "text": "どこがかぶっているというのかしら",
   "zh": "哪里撞车了？",
   "narrator_zh": "雷帝狄安娜"
  },
  {
   "location": "6/TALK",
   "narrator": "前衛教育委員会",
   "text": "雷を出すところだよ！",
   "zh": "就是放电这一点！",
   "narrator_zh": "前卫教育委员会"
  },
  {
   "location": "7/TALK",
   "narrator": "前衛教育委員会",
   "text": "両方とも雷系クランとしてキャラがかぶっているんだ！",
   "zh": "两个人都是雷系库兰，角色撞款了！",
   "narrator_zh": "前卫教育委员会"
  },
  {
   "location": "8/TALK",
   "narrator": "前衛教育委員会",
   "text": "だから、二人ともプラスアルファで何か個性がほしいよね",
   "zh": "所以你们两个都得再加点个性才行",
   "narrator_zh": "前卫教育委员会"
  },
  {
   "location": "9/TALK",
   "narrator": "前衛教育委員会",
   "text": "さあ、新たな個性を見つけよう！",
   "zh": "来吧，去找出新的个性！",
   "narrator_zh": "前卫教育委员会"
  },
  {
   "location": "10/TALK",
   "narrator": "ルビィマセマティカ",
   "text": "いや、雷といってもいろいろあるしさ",
   "zh": "不是，雷也分很多种啊",
   "narrator_zh": "红玉算法"
  },
  {
   "location": "11/TALK",
   "narrator": "雷帝ディアナ",
   "text": "そうだよ、一概に一緒というわけではないんだよ",
   "zh": "对啊，不能一概而论说是一样的",
   "narrator_zh": "雷帝狄安娜"
  },
  {
   "location": "12/TALK",
   "narrator": "前衛教育委員会",
   "text": "どう違うのさ？",
   "zh": "怎么个不一样法？",
   "narrator_zh": "前卫教育委员会"
  },
  {
   "location": "13/TALK",
   "narrator": "雷帝ディアナ",
   "text": "電流が流れたときの感覚とかだね",
   "zh": "比如电流流过时的感觉吧",
   "narrator_zh": "雷帝狄安娜"
  },
  {
   "location": "14/TALK",
   "narrator": "ルビィマセマティカ",
   "text": "そうそう、雷を落とす人によって結構違うんだよ",
   "zh": "对对，落雷的人不同，差别挺大的",
   "narrator_zh": "红玉算法"
  },
  {
   "location": "15/TALK",
   "narrator": "ルビィマセマティカ",
   "text": "ためしに雷をくらってみるかい？",
   "zh": "要不要试试挨一下雷？",
   "narrator_zh": "红玉算法"
  },
  {
   "location": "16/TALK",
   "narrator": "雷帝ディアナ",
   "text": "それがいいね。　二人の雷をくらべてみよう",
   "zh": "那不错。来比一比两个人的雷吧",
   "narrator_zh": "雷帝狄安娜"
  },
  {
   "location": "17/TALK",
   "narrator": "前衛教育委員会",
   "text": "え？　え？",
   "zh": "啊？啊？",
   "narrator_zh": "前卫教育委员会"
  },
  {
   "location": "18/TALK",
   "narrator": "雷帝ディアナ",
   "text": "よーし、それーっ！",
   "zh": "好——那就，来！",
   "narrator_zh": "雷帝狄安娜"
  },
  {
   "location": "19/TALK",
   "narrator": "前衛教育委員会",
   "text": "ぐ、ぐえぇぇぇぇぇ！！！",
   "zh": "咕、咕哇啊啊啊啊啊！！！",
   "narrator_zh": "前卫教育委员会"
  },
  {
   "location": "20/TALK",
   "narrator": "ルビィマセマティカ",
   "text": "よし、次はアタシだよ！",
   "zh": "好，接下来是我了！",
   "narrator_zh": "红玉算法"
  },
  {
   "location": "21/TALK",
   "narrator": "前衛教育委員会",
   "text": "オ、オアァァァァ！！",
   "zh": "哦、哦哇啊啊啊啊！！",
   "narrator_zh": "前卫教育委员会"
  },
  {
   "location": "22/TALK",
   "narrator": "ルビィマセマティカ",
   "text": "どうだい？　違いがわかったかい？",
   "zh": "怎么样？分出区别了吗？",
   "narrator_zh": "红玉算法"
  },
  {
   "location": "23/TALK",
   "narrator": "前衛教育委員会",
   "text": "い、いや……まったく……",
   "zh": "没、没有……完全……",
   "narrator_zh": "前卫教育委员会"
  },
  {
   "location": "24/TALK",
   "narrator": "雷帝ディアナ",
   "text": "それじゃあもういっかい……",
   "zh": "那就再来一次……",
   "narrator_zh": "雷帝狄安娜"
  },
  {
   "location": "25/TALK",
   "narrator": "前衛教育委員会",
   "text": "ストーップ！　ストーップ！",
   "zh": "停！停！",
   "narrator_zh": "前卫教育委员会"
  },
  {
   "location": "26/TALK",
   "narrator": "前衛教育委員会",
   "text": "わかったわかった！　雷にもいろいろあるんだね！",
   "zh": "知道了知道了！雷也分很多种呢！",
   "narrator_zh": "前卫教育委员会"
  },
  {
   "location": "27/TALK",
   "narrator": "前衛教育委員会",
   "text": "きみたちはそれぞれ違う個性がある……！",
   "zh": "你们各自有不同的个性……！",
   "narrator_zh": "前卫教育委员会"
  },
  {
   "location": "28/TALK",
   "narrator": "ルビィマセマティカ",
   "text": "そういうことさ",
   "zh": "就是这么回事",
   "narrator_zh": "红玉算法"
  },
  {
   "location": "29/TALK",
   "narrator": "雷帝ディアナ",
   "text": "で、どっちのほうがいい雷だった？",
   "zh": "那么，哪边的雷更好？",
   "narrator_zh": "雷帝狄安娜"
  },
  {
   "location": "30/TALK",
   "narrator": "前衛教育委員会",
   "text": "え……？　いやどっちも、ただただシビれるだけで……",
   "zh": "诶……？都、都只是麻得不行……",
   "narrator_zh": "前卫教育委员会"
  },
  {
   "location": "31/TALK",
   "narrator": "雷帝ディアナ",
   "text": "そんなはずはないわ！　私の雷のほうが強いに決まってる！",
   "zh": "不可能！当然是我的雷更强！",
   "narrator_zh": "雷帝狄安娜"
  },
  {
   "location": "32/TALK",
   "narrator": "ルビィマセマティカ",
   "text": "いや、アタシの雷のほうがビリビリするに決まってるよ！",
   "zh": "不，我的雷肯定更刺啦刺啦！",
   "narrator_zh": "红玉算法"
  },
  {
   "location": "33/TALK",
   "narrator": "ルビィマセマティカ",
   "text": "よし、もう一回受けてみな！",
   "zh": "好，再受一次看看！",
   "narrator_zh": "红玉算法"
  },
  {
   "location": "34/TALK",
   "narrator": "前衛教育委員会",
   "text": "え、ちょっと……",
   "zh": "诶，等一下……",
   "narrator_zh": "前卫教育委员会"
  },
  {
   "location": "35/TALK",
   "narrator": "前衛教育委員会",
   "text": "ギャアァァァァーー！",
   "zh": "啊啊啊啊啊啊——！",
   "narrator_zh": "前卫教育委员会"
  },
  {
   "location": "36/TALK",
   "narrator": "雷帝ディアナ",
   "text": "私も行くわ！　えい！",
   "zh": "我也来！嘿！",
   "narrator_zh": "雷帝狄安娜"
  },
  {
   "location": "37/TALK",
   "narrator": "前衛教育委員会",
   "text": "あばばばばばば！！",
   "zh": "阿巴巴巴巴巴！！",
   "narrator_zh": "前卫教育委员会"
  },
  {
   "location": "38/TALK",
   "narrator": "前衛教育委員会",
   "text": "（や、やっぱり二人とも似てるよ……）",
   "zh": "（果、果然两个人都差不多……）",
   "narrator_zh": "前卫教育委员会"
  }
 ]
}
