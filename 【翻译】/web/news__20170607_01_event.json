    "entry": [
        {
            "location": "1/chrome",
            "narrator": "",
            "text": "拡張少女系トライナリー",
            "zh": "扩张少女系三重奏",
            "narrator_zh": ""
        },
        {
            "location": "2/article",
            "narrator": "",
            "text": "『拡張少女系トライナリー』TVCFの放送をはじめ、アーヤMV回配信やノベライズの発売、さらにつばめの誕生日を記念して様々なキャンペーンを開催！",
            "zh": "以《扩张少女系三重奏》TVCF的播出为始，配信绫水MV回、发售小说版，更纪念燕的生日举办各种活动！",
            "narrator_zh": ""
        },
        {
            "location": "3/article",
            "narrator": "",
            "text": "期間中は豪華ログインボーナスでコスチュームの獲得や、今だけしか見られない特別なシナリオ",
            "zh": "活动期间可通过豪华登录奖励获得服装，还将配信仅限现在才能看到的特别剧情",
            "narrator_zh": ""
        },
        {
            "location": "4/article",
            "narrator": "",
            "text": "を配信します。",
            "zh": "。",
            "narrator_zh": ""
        },
        {
            "location": "5/article",
            "narrator": "",
            "text": "この機会に様々な豪華報酬をGETしましょう！",
            "zh": "请借此机会GET各种豪华报酬吧！",
            "narrator_zh": ""
        },
        {
            "location": "6/article",
            "narrator": "",
            "text": "6/7～7/5までの期間中、ログインボーナスで新規コスチューム「体操服」の他、ジュエルやココロキャンディ",
            "zh": "在6/7～7/5的期间内，登录奖励中除了新服装「体操服」之外，还可获得珠宝和心之糖果",
            "narrator_zh": ""
        },
        {
            "location": "7/article",
            "narrator": "",
            "text": "を獲得できます。",
            "zh": "。",
            "narrator_zh": ""
        },
        {
            "location": "8/article",
            "narrator": "",
            "text": "さらに、全ヒロインを対象にメインシナリオのバトルに必要な消費ACTが通常の半分",
            "zh": "此外，全部女主角的主线剧情战斗所需消耗ACT将变为通常的",
            "narrator_zh": ""
        },
        {
            "location": "9/article",
            "narrator": "",
            "text": "になります！",
            "zh": "一半！",
            "narrator_zh": ""
        },
        {
            "location": "10/article",
            "narrator": "",
            "text": "※EXバトルのACTには適用されません",
            "zh": "※不适用于EX战斗的ACT",
            "narrator_zh": ""
        },
        {
            "location": "11/article",
            "narrator": "",
            "text": "2017/7/5（水）定期メンテナンスまで",
            "zh": "至2017/7/5（周三）定期维护为止",
            "narrator_zh": ""
