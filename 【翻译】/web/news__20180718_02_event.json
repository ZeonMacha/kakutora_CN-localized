    "info": {
        "title": "拡張少女系トライナリー",
        "title_zh": "扩张少女系三重奏"
    },
    "entry": [
        {
            "location": "1/chrome",
            "narrator": "",
            "text": "拡張少女系トライナリー",
            "zh": "扩张少女系三重奏",
            "narrator_zh": ""
        },
        {
            "location": "2/article",
            "narrator": "",
            "text": "季節は夏！ 夏休み突入直前！ みんなのココロが騒ぎ始めるこの季節、なんだかがすとちゃんの様子がおかしいみたい！？",
            "zh": "季节正值夏天！马上就要进入暑假！在这个大家的内心都开始骚动的季节，GUST酱的样子似乎有点奇怪！？",
            "narrator_zh": ""
        },
        {
            "location": "3/article",
            "narrator": "",
            "text": "4週連続で開催される【がすとちゃんの夏の商品プレゼンテーション♪】にアクセスし、がすとちゃんの企む（？）楽しい企画に参加してみませんか？",
            "zh": "要不要访问连续4周举办的【GUST酱的夏日商品发布会♪】，来参加GUST酱密谋（？）的有趣企划呢？",
            "narrator_zh": ""
        },
        {
            "location": "4/article",
            "narrator": "",
            "text": "7/18～8/8にかけて、がすとちゃん主催の特別なイベントシナリオ「がすとちゃんのサマー大作戦♪」が配信されます。",
            "zh": "7/18～8/8期间，将配信GUST酱主办的特别活动剧情「GUST酱的夏日大作战♪」。",
            "narrator_zh": ""
        },
        {
            "location": "5/article",
            "narrator": "",
            "text": "イベントシナリオは毎週更新されます。",
            "zh": "活动剧情将每周更新。",
            "narrator_zh": ""
        },
        {
            "location": "6/article",
            "narrator": "",
            "text": "2018/8/31(金) サービス終了まで",
            "zh": "2018/8/31(周五) 直至服务结束",
            "narrator_zh": ""
        },
        {
            "location": "7/chrome",
            "narrator": "",
            "text": "エピソード01を解禁する。",
            "zh": "解锁第01话。",
            "narrator_zh": ""
        },
        {
            "location": "8/chrome",
            "narrator": "",
            "text": "※特別シナリオはSTORYの「イベントクエスト」内から見ることが可能です。",
            "zh": "※特别剧情可从STORY的“活动任务”中查看。",
            "narrator_zh": ""
        }
    ]
}
