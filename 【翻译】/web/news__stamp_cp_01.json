    "info": {
        "title": "拡張少女系トライナリー",
        "title_zh": "扩张少女系三重奏"
    },
    "entry": [
        {
            "location": "1/chrome",
            "narrator": "",
            "text": "拡張少女系トライナリー",
            "zh": "扩张少女系三重奏",
            "narrator_zh": ""
        },
        {
            "location": "2/article",
            "narrator": "",
            "text": "『拡張少女系トライナリー』のLINEスタンプが、12/20より配信開始！",
            "zh": "《扩张少女系三重奏》的LINE贴纸将于12/20起开始配信！",
            "narrator_zh": ""
        },
        {
            "location": "3/article",
            "narrator": "",
            "text": "ヒロインがWAVEで愛用しているスタンプや、「デイトラ！」のイラストをあしらったスタンプなどが、LINE STORE（スタンプショップ）にて「クリエイターズスタンプ」としてリリースされました。",
            "zh": "女主角们在WAVE中爱用的贴纸，以及绘有「每日三重奏！」插画的贴纸等，已在LINE STORE（贴纸商店）作为“创作者贴纸”发布。",
            "narrator_zh": ""
        },
        {
            "location": "4/article",
            "narrator": "",
            "text": "これを記念して、仲よくスタンプを駆使する彼女たちの様子を、アナザークエスト「トライナリースタンプ配信記念」でお届けします。",
            "zh": "为纪念此事，将以其他任务「三重奏贴纸配信纪念」为各位呈现她们亲密无间、灵活运用贴纸的模样。",
            "narrator_zh": ""
        },
        {
            "location": "5/article",
            "narrator": "",
            "text": "皆さんもLINEをお使いの際は、こんな風にどしどしスタンプを活用してくださいね！",
            "zh": "大家使用LINE时，也请像这样大大方方地活用贴纸哦！",
            "narrator_zh": ""
        },
        {
            "location": "6/article",
            "narrator": "",
            "text": "12/20（水）より下記の7セットを配信開始。各120円。",
            "zh": "自12/20（周三）起开始配信以下7套。每套120日元。",
            "narrator_zh": ""
        },
        {
            "location": "7/article",
            "narrator": "",
            "text": "●トライナリー・つばめの愛用スタンプ",
            "zh": "●三重奏·燕的常用贴纸",
            "narrator_zh": ""
        },
        {
            "location": "8/article",
            "narrator": "",
            "text": "●トライナリー・アーヤの愛用スタンプ",
            "zh": "●三重奏·绫水的常用贴纸",
            "narrator_zh": ""
        },
        {
            "location": "9/article",
            "narrator": "",
            "text": "●トライナリー・ガブリエラの愛用スタンプ",
            "zh": "●三重奏·加布里埃拉的常用贴纸",
            "narrator_zh": ""
        },
        {
            "location": "10/article",
            "narrator": "",
            "text": "●トライナリー・みやびの愛用スタンプ",
            "zh": "●三重奏·雅的常用贴纸",
            "narrator_zh": ""
        },
        {
            "location": "11/article",
            "narrator": "",
            "text": "●トライナリー・千羽鶴＆エリカのスタンプ",
            "zh": "●三重奏·千羽鹤＆领火贴纸",
            "narrator_zh": ""
        },
        {
            "location": "12/article",
            "narrator": "",
            "text": "●トライナリー・デイトラ！スタンプ その1",
            "zh": "●三重奏·每日三重奏！贴纸 第1弹",
            "narrator_zh": ""
        },
        {
            "location": "13/article",
            "narrator": "",
            "text": "●トライナリー・デイトラ！スタンプ その2",
            "zh": "●三重奏·每日三重奏！贴纸 第2弹",
            "narrator_zh": ""
        },
        {
            "location": "14/article",
            "narrator": "",
            "text": "※LINE STORE（スタンプショップ）で「トライナリー」と検索のうえ、お求めください。",
            "zh": "※请在LINE STORE（贴纸商店）中搜索“三重奏”后购买。",
            "narrator_zh": ""
        },
        {
            "location": "15/article",
            "narrator": "",
            "text": "無期限での公開となります",
            "zh": "将无限期公开",
            "narrator_zh": ""
        },
        {
