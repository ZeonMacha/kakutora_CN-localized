{
    "dir": "BattleSerif",
    "type": "ui_dll",
    "info": {},
    "entry": [
        {
            "location": "342/DLL",
            "narrator": "",
            "text": "お母さんのこと\n心配じゃないの？",
            "zh": "妈妈的事\n你不担心吗？",
            "narrator_zh": ""
        },
        {
            "location": "343/DLL",
            "narrator": "",
            "text": "心配だよ！\nだから悩んでるの！",
            "zh": "我担心啊！\n所以才在烦恼！",
            "narrator_zh": ""
        },
        {
            "location": "344/DLL",
            "narrator": "",
            "text": "ひどい娘ね。\n自分のことばっかり",
            "zh": "真是个坏女儿。\n净想着自己",
            "narrator_zh": ""
        },
        {
            "location": "345/DLL",
            "narrator": "",
            "text": "そんなこと…\nないもん…！",
            "zh": "才没有……\n那种事……！",
            "narrator_zh": ""
        },
        {
            "location": "346/DLL",
            "narrator": "",
            "text": "心配している\nフリかしら？",
            "zh": "该不会是在\n装担心吧？",
            "narrator_zh": ""
        },
        {
            "location": "347/DLL",
            "narrator": "",
            "text": "違うもん…！",
            "zh": "才不是……！",
            "narrator_zh": ""
        },
        {
            "location": "348/DLL",
            "narrator": "",
            "text": "これだけ言っても\n行くんだ…",
            "zh": "说了这么多\n你还是要走……",
            "narrator_zh": ""
        },
        {
            "location": "349/DLL",
            "narrator": "",
            "text": "行かなきゃいけない\n理由があるの！",
            "zh": "我有不得不去的\n理由！",
            "narrator_zh": ""
        },
        {
            "location": "350/DLL",
            "narrator": "",
            "text": "大丈夫！\n私を信じて！！",
            "zh": "没事的！\n相信我！！",
            "narrator_zh": ""
        },
        {
            "location": "351/DLL",
            "narrator": "",
            "text": "私がついてるよ！",
            "zh": "有我在呢！",
            "narrator_zh": ""
        },
        {
            "location": "352/DLL",
            "narrator": "",
            "text": "そんなわけ\nないでしょ！",
            "zh": "怎么可能\n是那样！",
            "narrator_zh": ""
        },
        {
            "location": "353/DLL",
            "narrator": "",
            "text": "止まってたら\n何も変わらない！",
            "zh": "停在原地的话\n什么都不会变！",
            "narrator_zh": ""
        },
        {
            "location": "354/DLL",
            "narrator": "",
            "text": "大丈夫\nゆっくり進も？",
            "zh": "没事的\n慢慢前进吧？",
            "narrator_zh": ""
        },
        {
            "location": "355/DLL",
            "narrator": "",
            "text": "私のこと嫌いなの？",
            "zh": "你讨厌我吗？",
            "narrator_zh": ""
        },
        {
            "location": "356/DLL",
            "narrator": "",
            "text": "みんな\nわかってくれない！",
            "zh": "大家\n都不理解我！",
            "narrator_zh": ""
        },
        {
            "location": "357/DLL",
            "narrator": "",
            "text": "怖くても\n負けたりしない！",
            "zh": "就算害怕\n我也不会输！",
            "narrator_zh": ""
        },
        {
            "location": "358/DLL",
            "narrator": "",
            "text": "もっとみんなのこと\n信じてよ！！",
            "zh": "再多相信\n大家一点嘛！！",
            "narrator_zh": ""
        },
        {
            "location": "359/DLL",
            "narrator": "",
            "text": "そんなことない。\nきっと楽しいよ",
            "zh": "不会的。\n一定很好玩",
            "narrator_zh": ""
        },
        {
            "location": "360/DLL",
            "narrator": "",
            "text": "みんな一緒だから\n大丈夫だよ！",
            "zh": "大家都在一起\n所以没事的！",
            "narrator_zh": ""
        },
        {
            "location": "361/DLL",
            "narrator": "",
            "text": "ちょっとくらい\n怖くても頑張れるよ！",
            "zh": "就算有一点害怕\n也能加油的！",
            "narrator_zh": ""
        },
        {
            "location": "362/DLL",
            "narrator": "",
            "text": "決め付けないで！\n怖くなんてない！",
            "zh": "别乱下定论！\n我才不怕！",
            "narrator_zh": ""
        },
        {
            "location": "363/DLL",
            "narrator": "",
            "text": "寮の周りは安全だよ",
            "zh": "宿舍周围很安全哦",
            "narrator_zh": ""
        },
        {
            "location": "364/DLL",
            "narrator": "",
            "text": "少しずつ知っていけば\nいいんだよ",
            "zh": "一点一点去了解\n就好了",
            "narrator_zh": ""
        },
        {
            "location": "365/DLL",
            "narrator": "",
            "text": "みんなで\n不安を吹っ飛ばせ～！",
            "zh": "大家一起\n把不安吹跑～！",
            "narrator_zh": ""
        },
        {
            "location": "366/DLL",
            "narrator": "",
            "text": "みんな\n大変でも頑張ってるし",
            "zh": "大家\n再难也在努力啊",
            "narrator_zh": ""
        },
        {
            "location": "367/DLL",
            "narrator": "",
            "text": "正直、帰りたいって、\nよく思うよ",
            "zh": "说实话，想回去，\n我也经常这么想",
            "narrator_zh": ""
        },
        {
            "location": "368/DLL",
            "narrator": "",
            "text": "みんなで過ごせば\n絶対楽しいよ！",
            "zh": "大家一起度过的话\n绝对很好玩！",
            "narrator_zh": ""
        },
        {
            "location": "369/DLL",
            "narrator": "",
            "text": "自由気ままに\n暮らせるよ！",
            "zh": "可以自由自在地\n生活哦！",
            "narrator_zh": ""
        },
        {
            "location": "370/DLL",
            "narrator": "",
            "text": "もういい大人\nじゃない！",
            "zh": "你还不算\n大人！",
            "narrator_zh": ""
        },
        {
            "location": "371/DLL",
            "narrator": "",
            "text": "不安なのは\nわかるけど…",
            "zh": "会不安\n我明白，可是……",
            "narrator_zh": ""
        },
        {
            "location": "372/DLL",
            "narrator": "",
            "text": "同じ日本の中だし\n大丈夫よ",
            "zh": "反正都在日本\n没事的",
            "narrator_zh": ""
        },
        {
            "location": "373/DLL",
            "narrator": "",
            "text": "寂しいよ。\nけど、自分で決めたの！",
            "zh": "是寂寞。\n可这是我自己决定的！",
            "narrator_zh": ""
        },
        {
            "location": "374/DLL",
            "narrator": "",
            "text": "甘えたこと\n言わないでよ！",
            "zh": "别说那些\n撒娇的话！",
            "narrator_zh": ""
        },
        {
            "location": "375/DLL",
            "narrator": "",
            "text": "わかるよ…でも、\nそれじゃダメなの",
            "zh": "我明白……可是，\n那样是不行的",
            "narrator_zh": ""
        },
        {
            "location": "376/DLL",
            "narrator": "",
            "text": "もっと新しいこと\n探してみようよ",
            "zh": "试着去找\n更多新的事物吧",
            "narrator_zh": ""
        },
        {
            "location": "377/DLL",
            "narrator": "",
            "text": "私たちと一緒じゃ…\nダメ？",
            "zh": "和我们在一起……\n不行吗？",
            "narrator_zh": ""
        },
        {
            "location": "378/DLL",
            "narrator": "",
            "text": "仲良しごっこ\nなんかじゃない！",
            "zh": "才不是什么\n假装要好！",
            "narrator_zh": ""
        },
        {
            "location": "379/DLL",
            "narrator": "",
            "text": "みんなのこと\nもっと信じようよ",
            "zh": "试着再多\n相信大家一点吧",
            "narrator_zh": ""
        },
        {
            "location": "380/DLL",
            "narrator": "",
            "text": "そんな寂しいこと\n思ってない！",
            "zh": "我才没有\n那么寂寞的想法！",
            "narrator_zh": ""
        },
        {
            "location": "381/DLL",
            "narrator": "",
            "text": "やってみなきゃ\n分からないよ",
            "zh": "不试试\n怎么知道",
            "narrator_zh": ""
        },
        {
            "location": "382/DLL",
            "narrator": "",
            "text": "いまだけじゃない！\nもっと楽しくするの！",
            "zh": "不只是现在！\n会让它更开心的！",
            "narrator_zh": ""
        },
        {
            "location": "383/DLL",
            "narrator": "",
            "text": "そうだね。でも、\n大切なことだと思う",
            "zh": "是啊。不过，\n我觉得这很重要",
            "narrator_zh": ""
        },
        {
            "location": "384/DLL",
            "narrator": "",
            "text": "そうかもしれないね。\nでもそれは悪いこと？",
            "zh": "也许是这样。\n可那是坏事吗？",
            "narrator_zh": ""
        },
        {
            "location": "385/DLL",
            "narrator": "",
            "text": "楽しい事\n一杯できるよ！",
            "zh": "开心的事\n能做一大堆哦！",
            "narrator_zh": ""
        },
        {
            "location": "386/DLL",
            "narrator": "",
            "text": "意味なんて関係ない！\n一緒にいたいの！",
            "zh": "意义什么的无所谓！\n我想在一起！",
            "narrator_zh": ""
        },
        {
            "location": "387/DLL",
            "narrator": "",
            "text": "そんな悲しいこと\n言わないで！",
            "zh": "别说那么\n悲伤的话！",
            "narrator_zh": ""
        },
        {
            "location": "388/DLL",
            "narrator": "",
            "text": "みんなとだと楽しい。\n意味なんてそれで十分",
            "zh": "和大家在一起就开心。\n有这个意义就够了",
            "narrator_zh": ""
        },
        {
            "location": "389/DLL",
            "narrator": "",
            "text": "辛いときもあるよ…。\nでも乗り越えなきゃ！",
            "zh": "也有难受的时候……\n但必须跨过去！",
            "narrator_zh": ""
        },
        {
            "location": "390/DLL",
            "narrator": "",
            "text": "そろそろ\n独り立ちしないと！",
            "zh": "也该\n独立了！",
            "narrator_zh": ""
        },
        {
            "location": "391/DLL",
            "narrator": "",
            "text": "辛いことから\n逃げたくない…",
            "zh": "我不想逃避\n难受的事……",
            "narrator_zh": ""
        },
        {
            "location": "392/DLL",
            "narrator": "",
            "text": "辛いのなんて\nいまだけだよ",
            "zh": "难受什么的\n只有现在而已",
            "narrator_zh": ""
        },
        {
            "location": "393/DLL",
            "narrator": "",
            "text": "みんなだって家族だよ！",
            "zh": "大家也是家人啊！",
            "narrator_zh": ""
        },
        {
            "location": "394/DLL",
            "narrator": "",
            "text": "もう親離れしないと！",
            "zh": "也该离开父母了！",
            "narrator_zh": ""
        },
        {
            "location": "395/DLL",
            "narrator": "",
            "text": "親元を離れるのは\n辛いよね…",
            "zh": "离开父母身边\n是很难受的……",
            "narrator_zh": ""
        },
        {
            "location": "396/DLL",
            "narrator": "",
            "text": "みんなと離れて\n平気なの？",
            "zh": "和大家分开\n你受得了吗？",
            "narrator_zh": ""
        },
        {
            "location": "397/DLL",
            "narrator": "",
            "text": "寂しいなら\n一緒にいようよ！",
            "zh": "寂寞的话\n就待在一起吧！",
            "narrator_zh": ""
        },
        {
            "location": "398/DLL",
            "narrator": "",
            "text": "誰だって寂しくて…\n大変でも頑張ってる！",
            "zh": "谁都会寂寞……\n再难也在努力！",
            "narrator_zh": ""
        },
        {
            "location": "399/DLL",
            "narrator": "",
            "text": "不安だろうけどいまは\n楽しい事考えよう？",
            "zh": "虽然会不安，现在\n先想想开心的事吧？",
            "narrator_zh": ""
        },
        {
            "location": "400/DLL",
            "narrator": "",
            "text": "わたしはでも、\nみんなと離れたくない",
            "zh": "可是我啊，\n不想和大家分开",
            "narrator_zh": ""
        },
        {
            "location": "401/DLL",
            "narrator": "",
            "text": "少しずつでも自分の\n世界を広げてみたい！",
            "zh": "哪怕一点点，也想\n拓宽自己的世界！",
            "narrator_zh": ""
        },
        {
            "location": "402/DLL",
            "narrator": "",
            "text": "嫌なことから逃げて\nいるだけじゃない！",
            "zh": "才不只是在逃避\n讨厌的事！",
            "narrator_zh": ""
        },
        {
            "location": "403/DLL",
            "narrator": "",
            "text": "わかるよ。お父さんと\n離れたくなんてない…",
            "zh": "我明白。我也不想\n和爸爸分开……",
            "narrator_zh": ""
        },
        {
            "location": "404/DLL",
            "narrator": "",
            "text": "逃げてたら\n前に進めない！",
            "zh": "一直逃的话\n就没法前进！",
            "narrator_zh": ""
        },
        {
            "location": "405/DLL",
            "narrator": "",
            "text": "大丈夫。それは\nわたしが保証するよ！",
            "zh": "没事的。这点\n我来保证！",
            "narrator_zh": ""
        },
        {
            "location": "406/DLL",
            "narrator": "",
            "text": "いまだって\nすごく楽しいよ！",
            "zh": "就算是现在\n也非常开心哦！",
            "narrator_zh": ""
        },
        {
            "location": "407/DLL",
            "narrator": "",
            "text": "それだけじゃないかも\nでも負けたくない",
            "zh": "也许不止如此\n但我不想输",
            "narrator_zh": ""
        },
        {
            "location": "408/DLL",
            "narrator": "",
            "text": "みんなといれば\n楽しいよ！",
            "zh": "和大家在一起\n就开心！",
            "narrator_zh": ""
        },
        {
            "location": "409/DLL",
            "narrator": "",
            "text": "みんなと一緒なら\nきっと頑張れるよ",
            "zh": "和大家在一起的话\n一定能坚持下去",
            "narrator_zh": ""
        },
        {
            "location": "410/DLL",
            "narrator": "",
            "text": "絶対大丈夫！\nきっと何とかなるよ！",
            "zh": "绝对没事！\n一定会有办法的！",
            "narrator_zh": ""
        },
        {
            "location": "411/DLL",
            "narrator": "",
            "text": "辛くても悲しくても\n一緒に頑張ろうよ",
            "zh": "就算难受，就算悲伤\n也一起加油吧",
            "narrator_zh": ""
        },
        {
            "location": "412/DLL",
            "narrator": "",
            "text": "そう。難しく考える\n必要なんてないの",
            "zh": "是的。没必要\n想得那么复杂",
            "narrator_zh": ""
        },
        {
            "location": "413/DLL",
            "narrator": "",
            "text": "楽しいこと、\nもっともっと探そう",
            "zh": "开心的事，\n再多找一些吧",
            "narrator_zh": ""
        },
        {
            "location": "414/DLL",
            "narrator": "",
            "text": "ちょっとじゃない！\nすっごく楽しいんだから！",
            "zh": "才不是一点点！\n是非常非常开心的！",
            "narrator_zh": ""
        },
        {
            "location": "415/DLL",
            "narrator": "",
            "text": "楽しい思い出を\nたくさん作りたいね",
            "zh": "想一起留下\n很多开心的回忆",
            "narrator_zh": ""
        },
        {
            "location": "416/DLL",
            "narrator": "",
            "text": "みんなといれば\n絶対楽しいよ！",
            "zh": "和大家在一起\n绝对开心！",
            "narrator_zh": ""
        },
        {
            "location": "417/DLL",
            "narrator": "",
            "text": "お父さんなら\nわかってくれる！",
            "zh": "爸爸的话\n会理解的！",
            "narrator_zh": ""
        },
        {
            "location": "418/DLL",
            "narrator": "",
            "text": "お父さんを理由にして\n逃げてない？",
            "zh": "你该不会拿爸爸\n当理由在逃避吧？",
            "narrator_zh": ""
        },
        {
            "location": "419/DLL",
            "narrator": "",
            "text": "心配させちゃうと思う\nでも…！",
            "zh": "我觉得会让人担心\n可是……！",
            "narrator_zh": ""
        },
        {
            "location": "420/DLL",
            "narrator": "",
            "text": "離れてたって\n大切な家族だよ！",
            "zh": "就算分开\n也是重要的家人！",
            "narrator_zh": ""
        },
        {
            "location": "421/DLL",
            "narrator": "",
            "text": "そうやって\nみんな敵になるんだ！",
            "zh": "就是这样\n大家才会变成敌人！",
            "narrator_zh": ""
        },
        {
            "location": "422/DLL",
            "narrator": "",
            "text": "こないで！\n放っておいて！",
            "zh": "别过来！\n别管我！",
            "narrator_zh": ""
        },
        {
            "location": "423/DLL",
            "narrator": "",
            "text": "大丈夫だって！",
            "zh": "说了没事的！",
            "narrator_zh": ""
        },
        {
            "location": "424/DLL",
            "narrator": "",
            "text": "気にしすぎだよ！",
            "zh": "你想太多了！",
            "narrator_zh": ""
        },
        {
            "location": "425/DLL",
            "narrator": "",
            "text": "気楽にいこう？",
            "zh": "轻松一点吧？",
            "narrator_zh": ""
        },
        {
            "location": "426/DLL",
            "narrator": "",
            "text": "みんながついてる！",
            "zh": "大家都在你这边！",
            "narrator_zh": ""
        },
        {
            "location": "427/DLL",
            "narrator": "",
            "text": "助け合おうよ",
            "zh": "互相帮忙吧",
            "narrator_zh": ""
        },
        {
            "location": "428/DLL",
            "narrator": "",
            "text": "へっちゃらだって～",
            "zh": "完全没关系啦～",
            "narrator_zh": ""
        },
        {
            "location": "429/DLL",
            "narrator": "",
            "text": "問題ないっス",
            "zh": "没问题的说",
            "narrator_zh": ""
        },
        {
            "location": "430/DLL",
            "narrator": "",
            "text": "楽しんでいこう？",
            "zh": "好好享受吧？",
            "narrator_zh": ""
        },
        {
            "location": "431/DLL",
            "narrator": "",
            "text": "気張りなさい！",
            "zh": "打起精神！",
            "narrator_zh": ""
        },
        {
            "location": "432/DLL",
            "narrator": "",
            "text": "シャキッとする！",
            "zh": "挺起精神！",
            "narrator_zh": ""
        },
        {
            "location": "433/DLL",
            "narrator": "",
            "text": "まだまだだね",
            "zh": "还早着呢",
            "narrator_zh": ""
        },
        {
            "location": "434/DLL",
            "narrator": "",
            "text": "そんなんじゃダメよ",
            "zh": "那样可不行",
            "narrator_zh": ""
        },
        {
            "location": "435/DLL",
            "narrator": "",
            "text": "無理は禁物だぜ",
            "zh": "别硬撑啊",
            "narrator_zh": ""
        },
        {
            "location": "436/DLL",
            "narrator": "",
            "text": "俺がついてるよ",
            "zh": "有我罩着你",
            "narrator_zh": ""
        },
        {
            "location": "437/DLL",
            "narrator": "",
            "text": "それがどうした！",
            "zh": "那又怎样！",
            "narrator_zh": ""
        },
        {
            "location": "438/DLL",
            "narrator": "",
            "text": "頭なでなでしよか？",
            "zh": "要不要摸摸头啵？",
            "narrator_zh": ""
        },
        {
