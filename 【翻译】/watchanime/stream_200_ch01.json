{
    "dir": "stream_200_ch01.json",
    "type": "watchanime",
    "info": {},
    "entry": [
        {
            "location": "4026/Talk",
            "narrator": "ガブリエラ",
            "text": "え！？\nあ、ああ、これ…？",
            "zh": "诶！？\n啊、啊啊，这个……？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4027/Talk",
            "narrator": "ガブリエラ",
            "text": "これはその、あれよ…\n$handle$が\n喜ぶかなと思って……",
            "zh": "这个是那个，就是那个啦…\n我想着$handle$会不会\n高兴就……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4028/Talk",
            "narrator": "ガブリエラ",
            "text": "せっかくだし、\nちょっとだけ羽目\n外しちゃおうかなって！",
            "zh": "难得有机会，\n就想稍微放纵\n一下嘛！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4029/Talk",
            "narrator": "ガブリエラ",
            "text": "ていうか、こんな事\nやったなんて、絶対\nみんなに内緒だからね？",
            "zh": "话说，做了这种事，\n绝对要跟\n大家保密的哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4030/Talk",
            "narrator": "ガブリエラ",
            "text": "いい？\nわかった！？",
            "zh": "懂了吗？\n明白了吗！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4031/Talk",
            "narrator": "ガブリエラ",
            "text": "まあいいわ。\nそんなことより、\n映像見るんでしょ？",
            "zh": "算了。\n比起那个，\n不是要看视频吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4032/Talk",
            "narrator": "ガブリエラ",
            "text": "まったく、\n$handle$のせいで\n全然進まないんだから。",
            "zh": "真是的，\n都怪$handle$，\n一点都进行不下去。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4033/Talk",
            "narrator": "ガブリエラ",
            "text": "ふふ、よかった。",
            "zh": "呵呵，太好了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4034/Talk",
            "narrator": "ガブリエラ",
            "text": "はぁ！？",
            "zh": "哈！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4035/Talk",
            "narrator": "ガブリエラ",
            "text": "わけわからないこと\n言わないの！",
            "zh": "别说这些\n莫名其妙的话！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4036/Talk",
            "narrator": "ガブリエラ",
            "text": "そ、そうね！\n二人だけの秘密！",
            "zh": "是、是啊！\n就我们两个的秘密！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4037/Talk",
            "narrator": "ガブリエラ",
            "text": "だから絶対秘密よ！？",
            "zh": "所以绝对要保密哦！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4038/Talk",
            "narrator": "ガブリエラ",
            "text": "ちょ、ちょっとやめてよ！",
            "zh": "等、等一下，别这样！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4039/Talk",
            "narrator": "ガブリエラ",
            "text": "言ったらホントに\n許さないんだからぁっ！",
            "zh": "说出来的话\n我真的不原谅你哦！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4040/Talk",
            "narrator": "ガブリエラ",
            "text": "…ホントにもう。",
            "zh": "…真是的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4041/Talk",
            "narrator": "ガブリエラ",
            "text": "あら。なんか\nパッとしない返事ね。",
            "zh": "哎呀。怎么是\n这么没劲的回答呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4042/Talk",
            "narrator": "ガブリエラ",
            "text": "まあいいわ。",
            "zh": "算了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4043/Talk",
            "narrator": "ガブリエラ",
            "text": "あんたがどう思おうとも、\n今回は他の子たちは\n来ないんだし。",
            "zh": "不管你怎么想，\n这次别的孩子\n都不会来的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4044/Talk",
            "narrator": "ガブリエラ",
            "text": "ま、観念して\nあたしと二人で\n見ることになさい。",
            "zh": "嘛，死心吧，\n就跟我两个人\n一起看。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4045/Talk",
            "narrator": "ガブリエラ",
            "text": "ちょっと違うかしら。",
            "zh": "可能有点不一样吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4046/Talk",
            "narrator": "ガブリエラ",
            "text": "まあ、自分でバラすのも\n恥ずかしいし、気になる\nなら映像見返してみれば？",
            "zh": "嘛，自己说出来\n也怪丢人的，在意\n就回去再看一遍视频？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4047/Talk",
            "narrator": "ガブリエラ",
            "text": "うっ……。\n鋭いわね。",
            "zh": "呜……。\n真敏锐呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4048/Talk",
            "narrator": "ガブリエラ",
            "text": "まったく、つばめったら\n本当にデリカシー\n無い子よね。",
            "zh": "真是的，燕这孩子\n实在是太不懂\n体贴了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4049/Talk",
            "narrator": "ガブリエラ",
            "text": "あたしがみっちり\n教えてあげなくちゃ\nだわよ。",
            "zh": "得让我好好\n教教你\n才行呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4050/Talk",
            "narrator": "ガブリエラ",
            "text": "え？\nあー、それはね……",
            "zh": "诶？\n啊——那个啊……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4051/Talk",
            "narrator": "ガブリエラ",
            "text": "はあっ？",
            "zh": "哈？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4052/Talk",
            "narrator": "ガブリエラ",
            "text": "そんなのが\n可愛いわけないじゃん…。",
            "zh": "那种东西\n怎么可能可爱嘛…。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4053/Talk",
            "narrator": "ガブリエラ",
            "text": "第一、この悩みは\nあたしの中ではすごく\n重大な悩みなのよ。",
            "zh": "再说，这个烦恼\n对我来说是非常\n重大的烦恼。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4054/Talk",
            "narrator": "ガブリエラ",
            "text": "そ、そうかしら？",
            "zh": "是、是吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4055/Talk",
            "narrator": "ガブリエラ",
            "text": "これくらいの表現\n別に誰だって出来るわよ。",
            "zh": "这种程度的表达，\n换谁都能做得到哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4056/Talk",
            "narrator": "ガブリエラ",
            "text": "なんでも可愛いで\n済ませようとするの、\nどうかと思うのよ。",
            "zh": "什么事都想用可爱\n糊弄过去，我觉得\n这很有问题。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4057/Talk",
            "narrator": "ガブリエラ",
            "text": "なっ！！",
            "zh": "什么！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4058/Talk",
            "narrator": "ガブリエラ",
            "text": "なんでも可愛いで\n済まされると思ったら\n大間違いなんだから！",
            "zh": "你以为光靠可爱\n就能糊弄过去，\n那可是大错特错！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4059/Talk",
            "narrator": "ガブリエラ",
            "text": "っていうか、\n何よこの映像！",
            "zh": "话说，\n这什么影像啊！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4060/Talk",
            "narrator": "ガブリエラ",
            "text": "勝手に人の寝姿を\n撮影するなんて！\n盗撮じゃない盗撮！",
            "zh": "居然擅自拍别人\n睡觉的样子！\n这不是偷拍是什么！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4061/Talk",
            "narrator": "ガブリエラ",
            "text": "全くもう！\n……まあ。",
            "zh": "真是的！\n……算了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4062/Talk",
            "narrator": "ガブリエラ",
            "text": "$handle$が\n可愛いって言ってるし\n別にいいんだけど！",
            "zh": "既然$handle$\n都说可爱了，\n我也就算了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4063/Talk",
            "narrator": "ガブリエラ",
            "text": "そ、そうかしら！？",
            "zh": "是、是吗！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4064/Talk",
            "narrator": "ガブリエラ",
            "text": "ま、別にこんなの、\n何の変哲もない日常の\n姿でしかないんだけど。",
            "zh": "嘛，这也没什么，\n不过是再普通不过\n的日常样子。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4065/Talk",
            "narrator": "ガブリエラ",
            "text": "もっとレディな姿だって\nいっぱいあるのに、なんで\nこのシーンなのかしらね。",
            "zh": "明明还有一大堆\n更淑女的画面，为什么\n偏偏是这一幕呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4066/Talk",
            "narrator": "ガブリエラ",
            "text": "あっ、そっか。\n$handle$にとって\n刺激が強すぎるからよね。",
            "zh": "啊，对啊。\n因为对$handle$来说\n刺激太强了嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4067/Talk",
            "narrator": "ガブリエラ",
            "text": "ほんと、\n$handle$ったら\nお子ちゃまなんだから。",
            "zh": "真是的，\n$handle$还真是\n个小孩子。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4068/Talk",
            "narrator": "ガブリエラ",
            "text": "ちょ、ちょっと！",
            "zh": "等、等一下！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4069/Talk",
            "narrator": "ガブリエラ",
            "text": "お子ちゃまなのは\nあたしじゃなくて\n$handle$の方よ！",
            "zh": "小孩子气的\n不是我，\n是$handle$那边！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4070/Talk",
            "narrator": "ガブリエラ",
            "text": "まったく、\n失礼しちゃうわね。",
            "zh": "真是的，\n太失礼了吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4071/Talk",
            "narrator": "ガブリエラ",
            "text": "え……えええっ！？",
            "zh": "诶……诶诶诶！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4072/Talk",
            "narrator": "ガブリエラ",
            "text": "じゃなくて…",
            "zh": "不是那样…",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4073/Talk",
            "narrator": "ガブリエラ",
            "text": "そ、そうね！\nあたしは全然\n構わないわよ？",
            "zh": "是、是啊！\n我完全\n不介意哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4074/Talk",
            "narrator": "ガブリエラ",
            "text": "でも、\n$handle$にはまだ\n刺激が強すぎると思うの。",
            "zh": "不过，\n我觉得对$handle$\n来说还太刺激了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4075/Talk",
            "narrator": "ガブリエラ",
            "text": "だから、また\nいずれ時期が来たら\n見せてあげるわ。",
            "zh": "所以，等哪一天\n时机到了，\n我会给你看的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4076/Talk",
            "narrator": "ガブリエラ",
            "text": "ああ、この辺の\nポーランド語？",
            "zh": "啊啊，这一带是\n波兰语？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4077/Talk",
            "narrator": "ガブリエラ",
            "text": "ここは全然大した事\n言ってないんだけど……",
            "zh": "这里根本没说\n什么了不得的事啊……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4078/Talk",
            "narrator": "ガブリエラ",
            "text": "『美しい白は\n炊きたてご飯の白』って\n言ってるのよ。",
            "zh": "‘最美的白\n是刚煮好的米饭的白’\n她是这么说的哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4079/Talk",
            "narrator": "ガブリエラ",
            "text": "はい、ここまで！",
            "zh": "好，到这里！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4080/Talk",
            "narrator": "ガブリエラ",
            "text": "正解は、日本と\nポーランドの国旗。",
            "zh": "正确答案是，日本和\n波兰的国旗。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4081/Talk",
            "narrator": "ガブリエラ",
            "text": "両方とも赤と白だけで\n作られてるでしょ？",
            "zh": "两个都只用红色\n和白色做的吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4082/Talk",
            "narrator": "ガブリエラ",
            "text": "だから、ふたつの国が\n使ってる白と赤って、\n素敵よね♪　って歌なの。",
            "zh": "所以，那是一首唱\n两个国家用的白色和红色，\n“真好看♪”　的歌。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4083/Talk",
            "narrator": "ガブリエラ",
            "text": "教えてあげてもいいけど、\nまずはクイズにして\nみようかしら。",
            "zh": "告诉你也行，\n不过先出个题\n考考你好了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4084/Talk",
            "narrator": "ガブリエラ",
            "text": "ここから先の歌詞を\n聴いて、ある共通の\n法則を見いだしてみて？",
            "zh": "听听接下来\n的歌词，试着找出\n某个共同的法则？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4085/Talk",
            "narrator": "ガブリエラ",
            "text": "白と言えば！？",
            "zh": "说到白色！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4086/Talk",
            "narrator": "ガブリエラ",
            "text": "ヒントはここから先の\n歌詞にあるわよ。",
            "zh": "提示就在接下来的\n歌词里哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4087/Talk",
            "narrator": "ガブリエラ",
            "text": "もう少し聴いて、\nある共通の法則を\n見いだしてみて？",
            "zh": "再听一会儿，\n试着找出其中\n共同的规律？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4088/Talk",
            "narrator": "ガブリエラ",
            "text": "あらら……。",
            "zh": "哎呀……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4089/Talk",
            "narrator": "ガブリエラ",
            "text": "もうっ！\nそういうのはいいから！",
            "zh": "真是的！\n那种事先别管了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4090/Talk",
            "narrator": "ガブリエラ",
            "text": "ちょっ！！\nいきなり何を\n言い出すのよ！",
            "zh": "喂！！\n突然在说\n什么啊！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4091/Talk",
            "narrator": "ガブリエラ",
            "text": "あたしなんて、全然\n純白なんかじゃないし…。",
            "zh": "我啊，哪是什么纯白\n啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4092/Talk",
            "narrator": "ガブリエラ",
            "text": "……って、そんなこと\nどうでもいいのよ。\nとにかくハズレよ。",
            "zh": "……不对，那种事\n怎样都好啦。\n总之你猜错了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4093/Talk",
            "narrator": "ガブリエラ",
            "text": "残念！\nワインは関係ないわね。",
            "zh": "错了！\n跟葡萄酒没关系呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4094/Talk",
            "narrator": "ガブリエラ",
            "text": "あたり！\nすごいわね！",
            "zh": "猜对了！\n好厉害呢！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4095/Talk",
            "narrator": "ガブリエラ",
            "text": "ちょ、ちょっと！\nあまりそういう所に\n目を向けないの！",
            "zh": "等、等一下！\n别老往那种\n地方看！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4096/Talk",
            "narrator": "ガブリエラ",
            "text": "乙女の私生活を見られる\nだけでも素晴らしい\nことなのよ？",
            "zh": "光是能看到少女的\n私生活，就已经\n很了不起了哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4097/Talk",
            "narrator": "ガブリエラ",
            "text": "だから、こういう時は\n感謝しつつ黙って\n見るものなの。いい？",
            "zh": "所以，这种时候\n要一边感谢一边\n安静地看。懂吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4098/Talk",
            "narrator": "ガブリエラ",
            "text": "素直で素敵ね。",
            "zh": "真是坦率又美好呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4099/Talk",
            "narrator": "ガブリエラ",
            "text": "え！？\nご褒美！？",
            "zh": "诶！？\n奖励！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4100/Talk",
            "narrator": "ガブリエラ",
            "text": "正直、喜ばれるとは\n思わなかったわね。",
            "zh": "老实说，我没想到\n你们会这么高兴呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4101/Talk",
            "narrator": "ガブリエラ",
            "text": "あ、あら、そう？",
            "zh": "啊，哎呀，是吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4102/Talk",
            "narrator": "ガブリエラ",
            "text": "まったく、\n$handle$ったら！",
            "zh": "真是的，\n$handle$这家伙！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4103/Talk",
            "narrator": "ガブリエラ",
            "text": "にしてもこの映像、もっと\nレディな姿を選りすぐって\n欲しかったわね……。",
            "zh": "话说这个影像，\n真希望能多挑些\n淑女的样子呢……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4104/Talk",
            "narrator": "ガブリエラ",
            "text": "まったくもう。\n油断も隙も無いんだから。",
            "zh": "真是的。\n一点空子都不留呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4105/Talk",
            "narrator": "ガブリエラ",
            "text": "な、なによもーーっ！！",
            "zh": "什、什么啊——！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4106/Talk",
            "narrator": "ガブリエラ",
            "text": "悪い！？\nいいじゃない別に！！",
            "zh": "坏！？\n有什么不可以的！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4107/Talk",
            "narrator": "ガブリエラ",
            "text": "な、なによーーっ！！",
            "zh": "什、什么啊——！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4108/Talk",
            "narrator": "ガブリエラ",
            "text": "そんな言い方されたら\n怒るに怒れないじゃない…\nもうっ！！",
            "zh": "被这么说，\n我都没法\n生气了…真是的！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4109/Talk",
            "narrator": "ガブリエラ",
            "text": "あら、意見が合うわね。",
            "zh": "哎呀，意见一致呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4110/Talk",
            "narrator": "ガブリエラ",
            "text": "いろんな味があって\n全然飽きないのよね。",
            "zh": "味道种类多，\n怎么吃都不会腻呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4111/Talk",
            "narrator": "ガブリエラ",
            "text": "あたしが一番好きなのは\nツナマヨなのよ。面白みが\n無いって言われるけど。",
            "zh": "我最喜欢的是\n金枪鱼蛋黄酱。虽然别人说\n我没意思。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4112/Talk",
            "narrator": "ガブリエラ",
            "text": "ああっ！\nわかってくれる？\nお仲間ね♪",
            "zh": "啊啊！\n你懂我啊？\n我们是同伴呢♪",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4113/Talk",
            "narrator": "ガブリエラ",
            "text": "ご飯とツナって本当に\nよく合うわよね！",
            "zh": "米饭和金枪鱼\n真的特别搭呢！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4114/Talk",
            "narrator": "ガブリエラ",
            "text": "ええっ！？\n$handle$も\n邪道派なの！？",
            "zh": "诶！？\n$handle$姐也是\n邪道派！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4115/Talk",
            "narrator": "ガブリエラ",
            "text": "前にみやびにも\n同じ事を言われたわ。",
            "zh": "之前雅也\n说过一样的话。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4116/Talk",
            "narrator": "ガブリエラ",
            "text": "おにぎりと言えば\n梅干しか昆布か\nおかかだって。",
            "zh": "说到饭团，\n就是梅干、海带\n或者木鱼花。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4117/Talk",
            "narrator": "ガブリエラ",
            "text": "梅干しとかも、\n別に嫌いじゃないのよ？",
            "zh": "腌梅子什么的，\n我也并不是讨厌哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4118/Talk",
            "narrator": "ガブリエラ",
            "text": "でも、美味しいんだから\n正道も邪道も\n無いと思うの！",
            "zh": "不过，既然好吃，\n我觉得就不分\n正道邪道了！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4119/Talk",
            "narrator": "ガブリエラ",
            "text": "…なによ、その\n無理矢理な公式は。",
            "zh": "…什么啊，那个\n牵强的公式。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4120/Talk",
            "narrator": "ガブリエラ",
            "text": "やっぱり「かわいい」って\n言いたいだけなんじゃ\nないの？",
            "zh": "果然你只是想说\n“好可爱”\n而已吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4121/Talk",
            "narrator": "ガブリエラ",
            "text": "そりゃ、かわいいって\n言われたら……嬉しく\nなくはないけど――",
            "zh": "被说可爱的话，\n倒也不是\n不开心啦——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4122/Talk",
            "narrator": "ガブリエラ",
            "text": "でも、たまには\n他の言葉も欲しいわね…。",
            "zh": "不过，偶尔也想听点\n别的话呢……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4123/Talk",
            "narrator": "ガブリエラ",
            "text": "あ、それ\nちょっといい……",
            "zh": "啊，那个\n挺不错的……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4124/Talk",
            "narrator": "ガブリエラ",
            "text": "って、やっぱり\nカワイイって\nことじゃない！",
            "zh": "话说，果然\n还是很可爱\n不是吗！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4125/Talk",
            "narrator": "ガブリエラ",
            "text": "撃つわよ！",
            "zh": "我会开枪的哦！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4126/Talk",
            "narrator": "ガブリエラ",
            "text": "「みたい」じゃなくて\nあたしは\nソルジャーだから！",
            "zh": "不是“像”！\n我可是\n正牌战士啊！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4127/Talk",
            "narrator": "ガブリエラ",
            "text": "まったく、\n失礼しちゃうわね。",
            "zh": "真是的，\n太失礼了吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4128/Talk",
            "narrator": "ガブリエラ",
            "text": "いいこと？\nこれが普段のあたしなの。\nわかったかしら？",
            "zh": "听好了？\n这才是平时的我。\n明白了吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4129/Talk",
            "narrator": "ガブリエラ",
            "text": "ち、ちがうわ――",
            "zh": "不、不是的——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4130/Talk",
            "narrator": "ガブリエラ",
            "text": "……そうよ？\nビターでしょ？",
            "zh": "……对吧？\n很苦吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4131/Talk",
            "narrator": "ガブリエラ",
            "text": "ちょっ…やめてよ！\nただのお菓子よ！！",
            "zh": "等……别这样！\n只是点心而已！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4132/Talk",
            "narrator": "ガブリエラ",
            "text": "あ、いけない…。",
            "zh": "啊，糟了…。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4133/Talk",
            "narrator": "ガブリエラ",
            "text": "もーっ！\n$handle$ってば\n意地悪すぎよ！！",
            "zh": "真是的！\n$handle$你\n也太坏心眼了！！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4134/Talk",
            "narrator": "ガブリエラ",
            "text": "ち、違うわよ！\n失礼しちゃうわね！",
            "zh": "不、不是啦！\n真没礼貌！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4135/Talk",
            "narrator": "ガブリエラ",
            "text": "こうして見ると\nなかなかオトナな感じが\nしてこないかしら？",
            "zh": "这么一看，\n是不是挺有\n大人味道的？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4136/Talk",
            "narrator": "ガブリエラ",
            "text": "はぁ、もういいわ。",
            "zh": "唉，算了吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4137/Talk",
            "narrator": "ガブリエラ",
            "text": "な、なあに？\nそのぎこちない返事は？",
            "zh": "什、什么？\n那个别扭的回答是？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4138/Talk",
            "narrator": "ガブリエラ",
            "text": "なんでそうなるのよ……。",
            "zh": "怎么会变成这样啊……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4139/Talk",
            "narrator": "ガブリエラ",
            "text": "は！？",
            "zh": "哈！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4140/Talk",
            "narrator": "ガブリエラ",
            "text": "いつもじゃないから！\nたまたまよ、たまたま！",
            "zh": "不是每次都这样！\n只是碰巧，碰巧啦！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4141/Talk",
            "narrator": "ガブリエラ",
            "text": "そ、そう？",
            "zh": "是、是吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4142/Talk",
            "narrator": "ガブリエラ",
            "text": "…って、そんな所ばかり\n見て、ちょっと\n不埒なんじゃないかしら！",
            "zh": "…话说，你光盯着\n那种地方，\n是不是有点不正经！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4143/Talk",
            "narrator": "ガブリエラ",
            "text": "えっ？\nな、なんか\n素直すぎじゃない？",
            "zh": "诶？\n你、你也未免\n太老实了吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4144/Talk",
            "narrator": "ガブリエラ",
            "text": "ま、まあ別にいいのよ？\nエッチな気持ちで見ている\nのでなければ全然。",
            "zh": "嘛，其实也没什么哦？\n只要不是带着色情\n的心思看就完全没问题。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4145/Talk",
            "narrator": "ガブリエラ",
            "text": "ええええっ！？",
            "zh": "诶诶诶诶！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4146/Talk",
            "narrator": "ガブリエラ",
            "text": "ちょ、ちょっと何よ！\nなんでここでそんな\n大胆発言！？",
            "zh": "等、等一下，干嘛啊！\n为什么在这里说\n这么大胆的话！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4147/Talk",
            "narrator": "ガブリエラ",
            "text": "そんなこと言われたら\n怒れなくなっちゃうし…\nず、ずるいわよ！？",
            "zh": "被这么说，\n我都没法\n生气了…太、太狡猾了吧！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4148/Talk",
            "narrator": "ガブリエラ",
            "text": "あ、そうね。\n確かにちょっとわからない\nかもしれないわよね。",
            "zh": "啊，是啊。\n确实可能会\n有点难懂呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4149/Talk",
            "narrator": "ガブリエラ",
            "text": "いいわ、教えてあげる。",
            "zh": "行吧，我告诉你。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4150/Talk",
            "narrator": "ガブリエラ",
            "text": "今のここまでの\nポーランド語は――",
            "zh": "到目前为止\n听到的波兰语——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4151/Talk",
            "narrator": "ガブリエラ",
            "text": "『プラツキとドラヤキ\n　どっちが美味しいか\n　なんて愚問よ』ね。",
            "zh": "‘圆饼和豆沙饼\n　哪个好吃\n　这种问题太蠢了’是吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4152/Talk",
            "narrator": "ガブリエラ",
            "text": "次のセンテンスからは\n聴きながら翻訳して\nいくわね。",
            "zh": "从下一句开始，\n我就边听\n边翻给你听哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4153/Talk",
            "narrator": "ガブリエラ",
            "text": "『どっちにもキュートな\n　エッセンスが盛り\n　込まれているもの』",
            "zh": "‘无论哪边都盛满了\n　可爱的\n　精华’",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4154/Talk",
            "narrator": "ガブリエラ",
            "text": "『そう、恋と同じで\n　個性も魅力も十人十色』",
            "zh": "‘是啊，就像爱情一样，\n　个性和魅力也都因人而异’",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4155/Talk",
            "narrator": "ガブリエラ",
            "text": "『どっちもあたしの\n　一番好きなモノ』",
            "zh": "‘两边都属于我\n　最喜欢的东西’",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4156/Talk",
            "narrator": "ガブリエラ",
            "text": "…とまあ、\nこんな感じかしらね。",
            "zh": "…总之，\n大概就是这种感觉吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4157/Talk",
            "narrator": "ガブリエラ",
            "text": "はいはい、ありがと。",
            "zh": "好，好，谢谢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4158/Talk",
            "narrator": "ガブリエラ",
            "text": "でも、実はちょっと\nここの振り付け\n気に入ってるのよね。",
            "zh": "不过，其实我有点\n喜欢这里的\n编舞呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4159/Talk",
            "narrator": "ガブリエラ",
            "text": "だから嬉しいかも。",
            "zh": "所以，说不定还挺开心的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4160/Talk",
            "narrator": "ガブリエラ",
            "text": "今度一緒に\n踊ってみない？",
            "zh": "下次一起\n跳个舞怎么样？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4161/Talk",
            "narrator": "ガブリエラ",
            "text": "ふふ。そうね！",
            "zh": "呵呵。是啊！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4162/Talk",
            "narrator": "ガブリエラ",
            "text": "$handle$と\n一緒に踊れたら\nちょっと素敵かも。",
            "zh": "要是能和$handle$\n一起跳舞，\n好像挺美好的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4163/Talk",
            "narrator": "ガブリエラ",
            "text": "あーあ、\n早くそんな日が\n来ればいいのになぁ。",
            "zh": "啊——，\n这种日子能早点\n来就好了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4164/Talk",
            "narrator": "ガブリエラ",
            "text": "あ、ここはね、",
            "zh": "啊，这里呢，",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4165/Talk",
            "narrator": "ガブリエラ",
            "text": "『両国の末永い\n　繁栄と友好を願って』\nって言ってるのよ。",
            "zh": "‘祝愿两国长久\n　繁荣与友好’\n她是这么说的哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4166/Talk",
            "narrator": "ガブリエラ",
            "text": "あたし、\n日本もポーランドも\nどっちも好き。",
            "zh": "我啊，\n日本和波兰\n两边都喜欢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4167/Talk",
            "narrator": "ガブリエラ",
            "text": "だから、ちょっと\n入れてみたかったのよ。",
            "zh": "所以，就想稍微\n放进去试试看嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4168/Talk",
            "narrator": "ガブリエラ",
            "text": "ええっ！？\nそ、そこなの？",
            "zh": "诶！？\n你、你在意的是那里？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4169/Talk",
            "narrator": "ガブリエラ",
            "text": "別に誰でもないわよ。\n知らない人だってば。",
            "zh": "不是什么人哦。\n就是不认识的人。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4170/Talk",
            "narrator": "ガブリエラ",
            "text": "……もう。",
            "zh": "……真是的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4171/Talk",
            "narrator": "ガブリエラ",
            "text": "あたしが男の人と\nマトモに喋れないの\n知ってるくせに。",
            "zh": "你明明知道\n我没法跟男人\n正常讲话的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4172/Talk",
            "narrator": "ガブリエラ",
            "text": "えへへ、良かった♪",
            "zh": "嘿嘿，太好了♪",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4173/Talk",
            "narrator": "ガブリエラ",
            "text": "もう！\nまたそれ！？",
            "zh": "真是的！\n又是这个！？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4174/Talk",
            "narrator": "ガブリエラ",
            "text": "まあでも……別に\n嫌とかじゃないけど……",
            "zh": "不过嘛……也不是\n讨厌就是了……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4175/Talk",
            "narrator": "ガブリエラ",
            "text": "ふわっ。",
            "zh": "呼哇。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4176/Talk",
            "narrator": "ガブリエラ",
            "text": "ふふ。よかった。\nあたしもよ？",
            "zh": "呵呵。太好了。\n我也是哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4177/Talk",
            "narrator": "ガブリエラ",
            "text": "ちょ、ちょっと！\nなんかだんだん大げさに\nなってない？",
            "zh": "等、等一下！\n是不是越来越\n夸张了？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4178/Talk",
            "narrator": "ガブリエラ",
            "text": "嬉しいけど、天使って\nあたしにとってはすごく\n威厳があるものなのよ。",
            "zh": "我是很开心，不过天使\n对我来说是很有\n威严的东西哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4179/Talk",
            "narrator": "ガブリエラ",
            "text": "だから、ちょっと\nあたしには似合わない\nってうか……",
            "zh": "所以，总觉得\n这不太适合我，\n该怎么说呢……",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4180/Talk",
            "narrator": "ガブリエラ",
            "text": "役者不足なんじゃ\nないかしらね…なんて。",
            "zh": "是不是有点演员不够的感觉呢……\n开个玩笑。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4181/Stay",
            "narrator": "",
            "text": "ピュアホワイトサマー",
            "zh": "纯白之夏",
            "narrator_zh": ""
        },
        {
            "location": "4182/Talk",
            "narrator": "ガブリエラ",
            "text": "こんにちは、\n$handle$。",
            "zh": "你好，\n$handle$。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4183/Talk",
            "narrator": "ガブリエラ",
            "text": "今回はなんか、\nあたしとあんただけ\nみたいなのよね。",
            "zh": "这次总感觉，\n好像只有我跟\n你两个人。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4184/Talk",
            "narrator": "ガブリエラ",
            "text": "別に、あたしは\n他のみんながいても\n全然よかったんだけど。",
            "zh": "其实，就算其他\n大家也在，\n我也完全无所谓。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4185/Talk",
            "narrator": "ガブリエラ",
            "text": "なんかみんな遠慮するし？\n仕方ないからあたし一人で\nつき合うことにするわ。",
            "zh": "大家都客气得很嘛？\n没办法，就我一个人\n陪着你好了。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4186/Talk",
            "narrator": "ガブリエラ",
            "text": "それじゃ、\n始めるわよ？",
            "zh": "那么，\n要开始了哦？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4187/Talk",
            "narrator": "ガブリエラ",
            "text": "ああ……\nまさかこの日の記録を\n使われるなんて。",
            "zh": "啊啊……\n没想到会用上\n那一天录像。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4188/Talk",
            "narrator": "ガブリエラ",
            "text": "まあ、そんなことは\nどうでもいいんだけど。\n大事なのはこのお店よ！",
            "zh": "嘛，那种事\n怎么样都无所谓。\n重要的是这家店哦！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4189/Talk",
            "narrator": "ガブリエラ",
            "text": "ここ、あたしの\n一番のお気に入りの\n隠れ家なの。",
            "zh": "这里是我\n最喜欢\n的藏身处。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4190/Talk",
            "narrator": "ガブリエラ",
            "text": "おまんじうと日本家屋の\n２つを一気に楽しめる\n素敵な場所なのよね。",
            "zh": "既能吃到馒头又能看老屋，\n一次享受两样，\n真是个好地方呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4191/Talk",
            "narrator": "ガブリエラ",
            "text": "なんて言ってるうちに、\n歌が始まっちゃったわね。",
            "zh": "正说着，\n歌已经开始了呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4192/Talk",
            "narrator": "ガブリエラ",
            "text": "ちょっとレトロな感じが\n素敵でしょ？",
            "zh": "有点复古的感觉，\n挺好吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4193/Talk",
            "narrator": "ガブリエラ",
            "text": "って、あたし実は\nレコードって実物は殆ど\n見たこと無かったのよね。",
            "zh": "话说，我其实\n几乎没怎么\n见过真正的唱片。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4194/Talk",
            "narrator": "ガブリエラ",
            "text": "だからすごい\n新鮮だったわ。",
            "zh": "所以觉得\n特别新鲜。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4195/Talk",
            "narrator": "ガブリエラ",
            "text": "トースターっていうのは\nポーランドの主食パンを\n焼くものでしょ？",
            "zh": "吐司机不就是\n用来烤波兰那种\n主食面包的吗？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4196/Talk",
            "narrator": "ガブリエラ",
            "text": "炊飯器はご飯を炊く\n日本人の魂よね。",
            "zh": "电饭锅是煮饭的，\n是日本人的灵魂呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4197/Talk",
            "narrator": "ガブリエラ",
            "text": "だから、\n恋しい故郷の思い出を\n大切にしながら暮らすか―",
            "zh": "所以，\n是要珍惜思念故乡的回忆\n生活下去呢——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4198/Talk",
            "narrator": "ガブリエラ",
            "text": "大好きな日本の文化を\n存分に味わって暮らすか。",
            "zh": "就好好享受最爱的\n日本文化过日子吧。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4199/Talk",
            "narrator": "ガブリエラ",
            "text": "どっちの方が幸せなの\nかしらね？　っていうのを\nモノで表現してみたのよ。",
            "zh": "哪一种才更幸福呢？\n我想用东西把\n这个表达出来。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4200/Talk",
            "narrator": "ガブリエラ",
            "text": "この辺はパッパッって\n言ってるだけだから、\n特に話すこと無いわね。",
            "zh": "这一段只是飞快地\n在说话而已，\n没什么特别要讲的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4201/Talk",
            "narrator": "ガブリエラ",
            "text": "…なんて。",
            "zh": "…什么的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4202/Talk",
            "narrator": "ガブリエラ",
            "text": "でも、$handle$と\n一緒にいろんなこと\nしたいのは本当。",
            "zh": "不过，想跟$handle$\n一起做\n很多事，这是真的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4203/Talk",
            "narrator": "ガブリエラ",
            "text": "そのときは、日本と\nポーランドを一緒に\n旅して回りたいな。",
            "zh": "那时候，我想把\n日本和波兰\n一起逛个遍。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4204/Talk",
            "narrator": "ガブリエラ",
            "text": "ポーランドに来たら\n素敵なところを沢山\n紹介してあげるわね。",
            "zh": "要是来波兰，\n我给你介绍\n很多好地方哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4205/Talk",
            "narrator": "ガブリエラ",
            "text": "と、こんな感じで\n歌はこれでおしまい。",
            "zh": "就、就这样，\n歌到这里结束。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4206/Talk",
            "narrator": "ガブリエラ",
            "text": "どうだった？\n上手に…\n歌えてた…かしらね？",
            "zh": "怎么样？\n唱得…\n还算好吗…大概？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4207/Talk",
            "narrator": "ガブリエラ",
            "text": "あ、ちなみに。\nここの独り言は\n聞かなくていいから。",
            "zh": "啊，顺便说一下。\n这里的自言自语\n不用听哦。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4208/Talk",
            "narrator": "ガブリエラ",
            "text": "まあ、あれよね。\n早く普通に男の子と\n喋れるようになりたい。",
            "zh": "唉，就是那个嘛。\n真想早点能跟男孩子\n正常聊天。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4209/Talk",
            "narrator": "ガブリエラ",
            "text": "でもきっと出来るように\nなるって信じてるわ。",
            "zh": "不过我相信一定\n会变得能做到的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4210/Talk",
            "narrator": "ガブリエラ",
            "text": "だって、\n$handle$が\nいるもん。",
            "zh": "因为，\n有$handle$\n在嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4211/Talk",
            "narrator": "ガブリエラ",
            "text": "$handle$だったら\nきっと何とかしてくれる。",
            "zh": "如果是$handle$的话\n一定会想办法的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4212/Talk",
            "narrator": "ガブリエラ",
            "text": "だって、\n$handle$は\nあたしの魔法使いだもん。",
            "zh": "因为，\n$handle$是\n我的魔法使嘛。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4213/Talk",
            "narrator": "ガブリエラ",
            "text": "…あのね。\n今、ちょっとナデナデして\n欲しいなって思ってるの。",
            "zh": "…那个，我现在\n有点想被\n摸摸头。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4214/Talk",
            "narrator": "ガブリエラ",
            "text": "らしくないかも\nしれないけど、なんか今\n甘えたい気分なのよね…。",
            "zh": "可能不太像我，\n但不知怎么，现在\n就想撒个娇……。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4215/Talk",
            "narrator": "ガブリエラ",
            "text": "……ねえ、\nはやくー…。",
            "zh": "……喂，\n快点——…。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4216/Talk",
            "narrator": "ガブリエラ",
            "text": "…ふふ、ありがと。\n嬉しいかも。",
            "zh": "…呵呵，谢谢。\n可能很开心。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4217/Talk",
            "narrator": "ガブリエラ",
            "text": "二人きりだと、\nちょっとだけ素直に\nなれるから、好き。",
            "zh": "两个人独处时，\n能稍微坦率\n一点，所以我喜欢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4218/Talk",
            "narrator": "ガブリエラ",
            "text": "いつも意地ばっかり\n張ってると、やっぱり\n疲れちゃうから。",
            "zh": "老是那么逞强，\n到头来果然\n还是会累的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4219/Talk",
            "narrator": "ガブリエラ",
            "text": "…映像、\n終わっちゃったわね。",
            "zh": "…影像\n结束了呢。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4220/Talk",
            "narrator": "ガブリエラ",
            "text": "$handle$とは\nもう随分長い付き合いの\nような気がするの。",
            "zh": "感觉和$handle$已经\n认识很久很久\n了似的。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4221/Talk",
            "narrator": "ガブリエラ",
            "text": "まだまだ、\nお互いを知るのは\nこれからだけど――",
            "zh": "不过，\n彼此互相了解\n还在后头呢——",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4222/Talk",
            "narrator": "ガブリエラ",
            "text": "でも、今は無理でも\nいつかあたしの全部を\n見せられそうな気がする。",
            "zh": "不过，虽然现在不行，\n我总觉得总有一天\n能让你看到我的全部。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4223/Talk",
            "narrator": "ガブリエラ",
            "text": "その時は\n$handle$に、\nあたしの全部をあげるから",
            "zh": "到那时候，\n我就把一切都\n交给$handle$。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4224/Talk",
            "narrator": "ガブリエラ",
            "text": "だから、\nずっと一緒にいてよね？",
            "zh": "所以，\n你要一直陪着我吧？",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4225/Talk",
            "narrator": "ガブリエラ",
            "text": "なんてね！",
            "zh": "骗你的！",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4226/Talk",
            "narrator": "ガブリエラ",
            "text": "というわけで、\n今日はこれでお終い。",
            "zh": "那么，\n今天就到这里。",
            "narrator_zh": "加布里埃拉"
        },
        {
            "location": "4227/Talk",
            "narrator": "ガブリエラ",
            "text": "最後まで\n一緒に見てくれて\nありがと！",
            "zh": "陪我一起看到\n最后，\n谢啦！",
            "narrator_zh": "加布里埃拉"
        }
    ]
}
